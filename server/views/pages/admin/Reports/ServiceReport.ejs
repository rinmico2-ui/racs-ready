  <div class="row g-4 mt-1">
    <% [
      { title: 'Most Booked Core Services', icon: 'bi-gear-fill', color: '#06b6d4', rows: analytics ? analytics.topCoreServices : [] },
      { title: 'Most Booked Repair Services', icon: 'bi-tools', color: '#8b5cf6', rows: analytics ? analytics.topRepairServices : [] },
      { title: 'Most Booked Brands', icon: 'bi-award-fill', color: '#f59e0b', rows: analytics ? analytics.topBrands : [] }
    ].forEach(function(group) { %>
      <div class="col-lg-4">
        <div class="dash-card h-100">
          <div class="dash-card-header"><h6><i class="bi <%= group.icon %> me-1" style="color:<%= group.color %>;"></i><%= group.title %></h6></div>
          <div class="dash-card-body">
            <% if (group.rows && group.rows.length) { group.rows.forEach(function(row, index) { %>
              <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                <div><span class="me-2" style="font-weight:700;color:#94a3b8;">#<%= index + 1 %></span><span style="font-weight:600;"><%= row.name %></span></div>
                <span class="kpi-enterprise-badge blue"><%= row.bookings %> bookings · <%= row.units || row.bookings %> units</span>
              </div>
            <% }); } else { %><div class="dash-empty">No matching booking data</div><% } %>
          </div>
        </div>
      </div>
    <% }); %>
