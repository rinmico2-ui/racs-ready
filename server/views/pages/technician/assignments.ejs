              }, 500);
            }
          }
          loadAssignments(currentFilter, currentPage, document.getElementById('searchInput').value);
          if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
            showDetail(window._currentDetailId);
          }
        } else {
          showNotification({ type: 'error', title: 'Failed', message: data.error || 'Could not start en route', duration: 5000 });
        }
      } catch (e) { showNotification({ type: 'error', title: 'Network Error', message: 'Please try again', duration: 5000 }); }
