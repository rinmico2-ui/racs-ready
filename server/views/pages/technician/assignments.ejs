          </div>
          <div class="assign-card-actions">
            <button class="btn btn-sm btn-success" onclick="event.stopPropagation();acceptAvailableJob('${b._id}','${(b.customerName || '').replace(/'/g, "\\'")}',this)">
              <i class="bi bi-check-lg me-1"></i>Accept Job
