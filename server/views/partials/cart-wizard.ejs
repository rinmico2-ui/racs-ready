                  <i class="bi bi-shop fs-2"></i></div>
                <div class="fulfill-title fs-6">Customer Pickup</div>
                <div class="fulfill-desc small mb-3">Pick up securely at our main branch.</div>
              </div>
            </div>
          </div>
        </div>

