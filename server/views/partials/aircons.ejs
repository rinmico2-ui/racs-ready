                </div>
                <div class="mt-3 px-1" style="font-size: 0.78rem; color: #64748b; line-height: 1.6; font-weight: 500;" id="wizardProductDesc"></div>
              </div>
              <div class="col-md-7">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <span style="font-size: 0.55rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1.2px;">Product</span>
                  <span style="width: 16px; height: 2px; background: #e2e8f0; display: inline-block;"></span>
                  <span class="badge" id="wizardProductBadge" style="font-size:0.55rem; font-weight:700; background:#dbeafe; color:#1d4ed8; letter-spacing:0.5px; display:none;">Inverter</span>
