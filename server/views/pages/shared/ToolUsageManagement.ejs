  <script>
    // Sidebar toggle functionality
    function toggleSidebar() {
      const sidebar = document.querySelector('.admin-sidebar');
      const topbar = document.querySelector('.admin-topbar');
      const content = document.querySelector('.admin-content');
      
      if (sidebar && topbar && content) {
        // Toggle body class
        document.body.classList.toggle('sidebar-collapsed');
        
        // Toggle individual classes as fallback
        sidebar.classList.toggle('collapsed');
        topbar.classList.toggle('sidebar-collapsed');
        content.classList.toggle('sidebar-collapsed');
      }
    }
    
    // Add keyboard shortcut (Ctrl+B) to toggle sidebar
    document.addEventListener('keydown', function(e) {
      if (e.ctrlKey && e.key === 'b') {
        e.preventDefault();
        toggleSidebar();
      }
    });
    
    // Add click event listener for existing sidebar toggle buttons
    document.addEventListener('DOMContentLoaded', function() {
      // Check for any existing sidebar toggle buttons
      const existingToggleBtns = document.querySelectorAll('[data-sidebar-toggle], .sidebar-toggle, .menu-toggle, .toggle-sidebar, .nav-toggle, .arrow-toggle');
      existingToggleBtns.forEach(btn => {
        btn.onclick = function(e) {
          e.preventDefault();
          toggleSidebar();
        };
      });
      
      // Also check for buttons with common icons that might be toggle buttons
      const iconToggleBtns = document.querySelectorAll('button .bi-arrow-left, button .bi-arrow-right, button .bi-chevron-left, button .bi-chevron-right');
      iconToggleBtns.forEach(icon => {
        const btn = icon.closest('button');
        if (btn && !btn.hasAttribute('data-sidebar-connected')) {
          btn.onclick = function(e) {
            e.preventDefault();
            toggleSidebar();
          };
          btn.setAttribute('data-sidebar-connected', 'true');
        }
      });
    });
  </script>

