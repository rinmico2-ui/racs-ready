    document.getElementById('partSpec').value = p.specification || '';
    document.getElementById('partSupplier').value = p.supplier || '';
    document.getElementById('partSerialNumber').value = p.serialNumber || '';
    document.getElementById('partDesc').value = p.description || '';
    
    // Pricing & Stock
    document.getElementById('partUnit').value = p.unit || 'pcs';
