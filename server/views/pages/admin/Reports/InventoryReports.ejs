      </div>
      
      <!-- Stock Turnover Analysis -->
      <div class="col-lg-6" data-aos="fade-up" data-aos-delay="300">
        <div class="dash-card bg-white h-100">
          <div class="card-header-custom border-0 pb-0 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold" style="color: #1d4ed8; font-size: 1.1rem;">
              <i class="bi bi-arrow-repeat me-2"></i>Stock Turnover Analysis
            </h6>
            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">High Velocity Items</span>
          </div>
          <div class="card-body px-4 pb-4">
            <% if (analytics && analytics.stockTurnover && analytics.stockTurnover.length > 0) { %>
              <div style="height: 220px;">
                <canvas id="stockTurnoverChart"></canvas>
              </div>
              <div class="mt-2">
                <small class="text-muted">
                  <i class="bi bi-lightning-charge me-1 text-warning"></i>
                  Top mover: <strong><%= analytics.stockTurnover[0].name %></strong> 
                  (<%= analytics.stockTurnover[0].turnoverRate.toFixed(2) %>x turnover)
                </small>
              </div>
            <% } else { %>
              <div class="text-center py-4 text-muted">
                <i class="bi bi-graph-down fs-1"></i>
                <p class="mt-2">Insufficient data for turnover analysis</p>
              </div>
            <% } %>
          </div>
        </div>
