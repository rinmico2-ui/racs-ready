          </tr>
        </thead>
        <tbody>${itemsHtml}</tbody>
      </table>
      <hr class="pos-receipt-divider">
      <div style="display:flex;justify-content:space-between;font-size:0.82rem;margin-bottom:4px;">
        <span style="color:#64748b;">Subtotal</span>
        <span style="font-weight:600;">₱${Number(sale.subtotal).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</span>
      </div>
      ${sale.discount > 0 ? `<div style="display:flex;justify-content:space-between;font-size:0.82rem;margin-bottom:4px;color:#ef4444;">
        <span>Discount</span><span style="font-weight:600;">-₱${Number(sale.discount).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</span>
      </div>` : ""}
      ${sale.installationFee > 0 ? `<div style="display:flex;justify-content:space-between;font-size:0.82rem;margin-bottom:4px;"><span style="color:#64748b;">Installation</span><span>₱${Number(sale.installationFee).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</span></div>` : ""}
      ${sale.transportationFee > 0 ? `<div style="display:flex;justify-content:space-between;font-size:0.82rem;margin-bottom:4px;"><span style="color:#64748b;">Transportation</span><span>₱${Number(sale.transportationFee).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</span></div>` : ""}
