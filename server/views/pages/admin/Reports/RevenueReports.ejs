<script>
(()=>{
  const A=<%- JSON.stringify(analytics||{}).replace(/</g,'\\u003c') %>;
  const labels=Object.keys(A.monthlyRevenue||{}).reverse();
  const months=Object.values(A.monthlyRevenue||{}).reverse();
  const costs=Object.values(A.monthlyPartsCost||{}).reverse();
  document.getElementById('exportRevenue')?.addEventListener('click',()=>{
    const q=v=>'"'+String(v??'').replaceAll('"','""')+'"';
    const rows=[['Month','Booked Service Value','Booked Order Value','POS Revenue','Total Booked Value','Recognized Net Revenue','Gross Collections','Refunds','Net Collections','Known Direct Cost'],
      ...months.map((m,i)=>[labels[i],m.service||0,m.orders||0,m.pos||0,m.total||0,m.recognized||0,(m.collections||0)+(m.refunds||0),m.refunds||0,m.collections||0,costs[i]||0])];
    const b=new Blob([rows.map(r=>r.map(q).join(',')).join('\n')],{type:'text/csv;charset=utf-8'});
    const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='revenue-intelligence.csv';a.click();URL.revokeObjectURL(a.href);
  });
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(() => {
  const pageSize = 10;
  let rows = Array.from(document.querySelectorAll('.profitability-modal-row'));
  const pagination = document.getElementById('profitabilityPagination');
  const pageInfo = document.getElementById('profitabilityPageInfo');
  let currentPage = 1;
  function showProfitabilityPage(page) {
    rows = Array.from(document.querySelectorAll('.profitability-modal-row'));
    const totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
    currentPage = Math.min(Math.max(1, page), totalPages);
    rows.forEach((row, index) => { row.style.display = Math.floor(index / pageSize) + 1 === currentPage ? '' : 'none'; });
    const first = rows.length ? ((currentPage - 1) * pageSize) + 1 : 0;
    const last = Math.min(currentPage * pageSize, rows.length);
    pageInfo.textContent = `Showing ${first}–${last} of ${rows.length} completed services`;
    pagination.innerHTML = '';
    const addButton = (label, page, disabled, active) => {
      const item = document.createElement('li'); item.className = `page-item${disabled ? ' disabled' : ''}${active ? ' active' : ''}`;
      const button = document.createElement('button'); button.className = 'page-link'; button.type = 'button'; button.innerHTML = label;
      button.disabled = disabled; button.addEventListener('click', () => showProfitabilityPage(page)); item.appendChild(button); pagination.appendChild(item);
    };
    addButton('<i class="bi bi-chevron-left"></i>', currentPage - 1, currentPage === 1, false);
    for (let pageNumber = 1; pageNumber <= totalPages; pageNumber += 1) addButton(String(pageNumber), pageNumber, false, pageNumber === currentPage);
    addButton('<i class="bi bi-chevron-right"></i>', currentPage + 1, currentPage === totalPages, false);
  }
  document.getElementById('serviceProfitabilityModal')?.addEventListener('show.bs.modal', () => showProfitabilityPage(1));
  showProfitabilityPage(1);
  window.refreshProfitabilityPagination = () => showProfitabilityPage(1);
})();
</script>

<!-- ═══ REVENUE FILTER LOGIC ═══ -->
<script>
(() => {
  const peso = n => '\u20B1' + Math.round(Number(n || 0)).toLocaleString('en-PH');
  const pct = n => Number(n || 0).toFixed(1) + '%';
  const esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  let charts = {};

  // ── Populate technician dropdown from initial analytics ──
  const initA = <%- JSON.stringify(analytics || {}).replace(/</g, '\\u003c') %>;
  if (initA.topTechnicians) {
    const techSelect = document.getElementById('filterTechnician');
    initA.topTechnicians.forEach(t => {
      const opt = document.createElement('option');
      opt.value = t.id; opt.textContent = t.name;
      techSelect.appendChild(opt);
    });
  }

  // ── Show/hide custom date range ──
  document.getElementById('filterPeriod').addEventListener('change', function() {
    const el = document.getElementById('customDateRange');
    el.style.display = this.value === 'custom' ? 'flex' : 'none';
  });

  // ── Apply filters ──
  document.getElementById('applyFilters').addEventListener('click', applyFilters);
  document.getElementById('resetFilters').addEventListener('click', resetFilters);

  async function applyFilters() {
    const btn = document.getElementById('applyFilters');
    btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Loading...';

    const params = new URLSearchParams();
    const period = document.getElementById('filterPeriod').value;
    if (period !== 'custom' && period !== 'last_12_months') params.set('period', period);
    if (period === 'custom') {
      const from = document.getElementById('filterFrom').value;
      const to = document.getElementById('filterTo').value;
      if (from) params.set('from', from);
      if (to) params.set('to', to);
    }
    const source = document.getElementById('filterSource').value;
    const serviceType = document.getElementById('filterServiceType').value;
    const payment = document.getElementById('filterPayment').value;
    const status = document.getElementById('filterStatus').value;
    const tech = document.getElementById('filterTechnician').value;

    if (source !== 'all') params.set('source', source);
    if (serviceType !== 'all') params.set('serviceType', serviceType);
    if (payment !== 'all') params.set('paymentMethod', payment);
    if (status !== 'all') params.set('paymentStatus', status);
    if (tech !== 'all') params.set('technician', tech);

    try {
      const resp = await fetch(`/api/admin/reports/revenue?${params.toString()}`, { credentials: 'same-origin' });
      const data = await resp.json();
      if (resp.ok && data.success) {
        updateDashboard(data.analytics, data.technicians);
        showFilterStatus(data.filters);
      } else {
        alert('Failed to load filtered data.');
      }
    } catch (e) {
      console.error('Filter error:', e);
      alert('Network error.');
    }

    btn.disabled = false; btn.innerHTML = '<i class="bi bi-funnel me-1"></i> Apply';
  }

  function resetFilters() {
    document.getElementById('filterPeriod').value = 'last_12_months';
    document.getElementById('filterSource').value = 'all';
    document.getElementById('filterServiceType').value = 'all';
    document.getElementById('filterPayment').value = 'all';
    document.getElementById('filterStatus').value = 'all';
    document.getElementById('filterTechnician').value = 'all';
    document.getElementById('customDateRange').style.display = 'none';
    document.getElementById('filterStatusBadge').style.display = 'none';
    applyFilters();
  }

  function showFilterStatus(filters) {
    const badge = document.getElementById('filterStatusBadge');
    const text = document.getElementById('filterStatusText');
    const parts = [];
    if (filters.startDate) parts.push(new Date(filters.startDate).toLocaleDateString('en-PH', { month: 'short', year: 'numeric' }) + ' – ' + new Date(filters.endDate).toLocaleDateString('en-PH', { month: 'short', year: 'numeric' }));
    if (filters.source !== 'all') parts.push('Source: ' + filters.source);
    if (filters.serviceType !== 'all') parts.push('Type: ' + filters.serviceType);
    if (filters.paymentMethod !== 'all') parts.push('Payment: ' + filters.paymentMethod);
    if (filters.paymentStatus !== 'all') parts.push('Status: ' + filters.paymentStatus);
    if (filters.technician !== 'all') parts.push('Technician filtered');
    text.textContent = parts.length ? 'Active filters: ' + parts.join(' · ') : 'Showing all data (rolling 12 months)';
    badge.style.display = 'block';
  }

  // ── Update dashboard with new data ──
  function updateDashboard(A, technicians) {
    currentA = A;
    // Update KPIs — enterprise card style matching Service Report
    const kpiHtml = `
      <div class="kpi-enterprise" data-accent="blue" data-aos="fade-up" data-aos-delay="0">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon blue"><i class="bi bi-cash-stack"></i></div>
          <span class="kpi-enterprise-badge blue">${A.totalTransactions||0} txns</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Approved Booked Value</p>
          <div class="kpi-enterprise-value"><span id="kpiTotalRevenue">${peso(A.totalRevenue)}</span></div>
          <small style="color:#64748b;">Approved services/projects + active orders + completed POS</small>
        </div>
        <div class="kpi-enterprise-sparkline"><canvas id="kpiSparkRevenue"></canvas></div>
      </div>
      <div class="kpi-enterprise" data-accent="cyan" data-aos="fade-up" data-aos-delay="50">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon cyan"><i class="bi bi-clipboard-check"></i></div>
          <span class="kpi-enterprise-badge cyan">${A.recognizedTransactions||0} completed</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Recognized Revenue</p>
          <div class="kpi-enterprise-value"><span>${peso(A.recognizedRevenue)}</span></div>
          <small style="color:#64748b;">Completed work net of period refunds</small>
        </div>
      </div>
      <div class="kpi-enterprise" data-accent="amber" data-aos="fade-up" data-aos-delay="100">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon amber"><i class="bi bi-bank"></i></div>
          <span class="kpi-enterprise-badge amber">${peso(A.refunds)} refunds</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Net Collections</p>
          <div class="kpi-enterprise-value"><span>${peso(A.netCollections)}</span></div>
          <small style="color:#64748b;">Gross collections less period refunds</small>
        </div>
