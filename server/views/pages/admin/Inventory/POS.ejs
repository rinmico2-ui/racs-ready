      <div id="barcodeNotice" style="display:none;background:#f59e0b10;border:1px solid #f59e0b40;color:#f59e0b;padding:8px 16px;font-size:0.8rem;border-radius:8px;margin:0 16px 8px 16px;align-items:center;"></div>
      <div class="pos-tabs">
        <button class="pos-tab active" onclick="switchTab('tools', this)"><i class="bi bi-box-seam"></i> Parts &amp; Tools</button>
        <button class="pos-tab" onclick="switchTab('aircons', this)"><i class="bi bi-snow"></i> Aircons</button>
      </div>
