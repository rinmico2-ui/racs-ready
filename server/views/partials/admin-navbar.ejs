          <div class="avatar profile-toggle-avatar me-2">
            <% if (typeof user !== 'undefined' && user && user.profileImage) { %>
              <img src="<%= user.profileImage %>" alt="Profile" />
            <% } else { %>
              <span>
                <%= typeof user !== 'undefined' && user && (user.name || user.email) ? (user.name || user.email).charAt(0).toUpperCase() : 'A' %>
              </span>
            <% } %>
          </div>
          <div class="profile-toggle-details d-none d-sm-flex flex-column">
            <span class="name">
              <%= (typeof user !== 'undefined' && user && (user.name || user.fullName)) ? (user.name || user.fullName) : 'Administrator' %>
            </span>
            <span class="role">Admin</span>
          </div>
          <i class="bi bi-chevron-down ms-2 chevron"></i>
        </a>
        <ul
          class="dropdown-menu dropdown-menu-end profile-dropdown-menu"
          aria-labelledby="profileDropdown"
        >
          <li class="profile-dropdown-header">
            <div class="profile-dropdown-avatar">
              <div class="initial">
                <% if (typeof user !== 'undefined' && user && user.profileImage) { %>
                  <img src="<%= user.profileImage %>" alt="Profile" />
                <% } else { %>
                  <%= typeof user !== 'undefined' && user && (user.name || user.email) ? (user.name || user.email).charAt(0).toUpperCase() : 'A' %>
                <% } %>
              </div>
            </div>
            <div class="details">
              <p class="name">
                <%= (typeof user !== 'undefined' && user && (user.name || user.fullName)) ? (user.name || user.fullName) : 'Administrator' %>
