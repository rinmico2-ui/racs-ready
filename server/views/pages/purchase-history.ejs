  <!-- Flatpickr for Premium Date Pickers -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <style>
    /* Flatpickr Premium Overrides */
    .flatpickr-calendar { border-radius: 1rem !important; border: none !important; box-shadow: 0 20px 40px rgba(15,36,96,0.1) !important; font-family: inherit !important; padding: 0.5rem !important; z-index: 1060 !important; }
    .flatpickr-day.selected { background: #2563eb !important; border-color: #2563eb !important; box-shadow: 0 4px 10px rgba(37,99,235,0.3) !important; font-weight: 700 !important; color: #fff !important; }
    .flatpickr-day:hover { background: #f0f7ff !important; border-color: transparent !important; color: #2563eb !important; }
    .flatpickr-current-month { font-weight: 800 !important; color: #0a1628 !important; }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

  <!-- Rating Interaction Script -->
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // Modal rating variables
      let currentOrderId = null;
      let currentOrderRef = null;
      let currentRating = 0;
      
      // Wire up Open Modal Buttons
      document.querySelectorAll('.ph-rate-order-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          currentOrderId = this.getAttribute('data-id');
          currentOrderRef = this.getAttribute('data-ref');
          const techName = this.getAttribute('data-tech');
          
          document.getElementById('phModalTechName').textContent = techName || 'Technician';
          document.getElementById('phModalComment').value = '';
          currentRating = 0;
          updateModalStars(document.querySelectorAll('#phModalRating .ph-star-big'), 0);
          document.getElementById('phModalRatingLabel').textContent = 'Tap a star to rate';
          
          const modal = new bootstrap.Modal(document.getElementById('phRatingModal'));
          modal.show();
        });
      });

      // Modal rating interaction
      const modalRating = document.getElementById('phModalRating');
      const modalLabel = document.getElementById('phModalRatingLabel');
      const labels = ['Poor', 'Fair', 'Good', 'Very Good', 'Excellent'];
      
      if (modalRating) {
        const stars = modalRating.querySelectorAll('.ph-star-big');
        stars.forEach((star, index) => {
          star.addEventListener('mouseenter', () => {
             updateModalStars(stars, index + 1);
             modalLabel.textContent = labels[index];
          });
          star.addEventListener('click', () => {
             currentRating = index + 1;
             updateModalStars(stars, currentRating);
             modalLabel.textContent = labels[index];
          });
        });
        
        modalRating.addEventListener('mouseleave', () => {
          updateModalStars(stars, currentRating);
          modalLabel.textContent = currentRating > 0 ? labels[currentRating - 1] : 'Tap a star to rate';
        });
      }
      
      function updateModalStars(stars, value) {
        stars.forEach((star, index) => {
          if (index < value) {
            star.classList.add('active');
            star.querySelector('i').classList.remove('bi-star');
            star.querySelector('i').classList.add('bi-star-fill');
          } else {
            star.classList.remove('active');
            star.querySelector('i').classList.remove('bi-star-fill');
            star.querySelector('i').classList.add('bi-star');
          }
        });
      }

      // Submit Rating
      const submitBtn = document.getElementById('phSubmitOrderRating');
      if (submitBtn) {
        submitBtn.addEventListener('click', async () => {
          if (!currentRating) {
            alert('Please select a star rating.');
            return;
          }
          
          const comment = document.getElementById('phModalComment').value.trim();
          const originalText = submitBtn.innerHTML;
          submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Submitting...';
          submitBtn.disabled = true;
          
          try {
            const res = await fetch(`/api/rating/order/${encodeURIComponent(currentOrderId)}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ score: currentRating, comment })
            });
            const data = await res.json();
            
            if (res.ok) {
               // success: close modal and reload to show new rating
               const modalEl = document.getElementById('phRatingModal');
               const modalInst = bootstrap.Modal.getInstance(modalEl);
               if (modalInst) modalInst.hide();
               window.location.reload();
            } else {
               alert(data.error || 'Failed to submit rating.');
               submitBtn.innerHTML = originalText;
               submitBtn.disabled = false;
            }
          } catch(e) {
             console.error(e);
             alert('Network error submitting rating.');
             submitBtn.innerHTML = originalText;
             submitBtn.disabled = false;
          }
        });
      }

      // Premium Flatpickr Initialization
      if (typeof flatpickr !== 'undefined') {
        const menu = document.querySelector('.ph-dropdown-menu');
        const fpConfig = {
          dateFormat: "Y-m-d",
          disableMobile: "true",
          appendTo: menu,
          onChange: function(selectedDates, dateStr, instance) {
            instance.element.value = dateStr;
            instance.element.dispatchEvent(new Event('change', { bubbles: true }));
          }
        };
        flatpickr("#phDateFrom", fpConfig);
        flatpickr("#phDateTo", fpConfig);

        if (menu) {
          menu.addEventListener('click', function(e) {
            e.stopPropagation();
          });
        }
      }

      // Cancel order button handlers
      document.querySelectorAll('.ph-cancel-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const orderId = this.getAttribute('data-id');
          const orderRef = this.getAttribute('data-ref');
          const reason = prompt(`Please provide a reason for cancelling order ${orderRef}:`);
          if (reason === null) return; // User clicked cancel
          if (reason.trim() === "") {
            alert("Please provide a reason for cancellation.");
            return;
          }
          if (confirm(`Are you sure you want to cancel order ${orderRef}?`)) {
            cancelOrder(orderId, reason.trim());
          }
        });
      });

      // Reschedule order button handlers
      document.querySelectorAll('.ph-reschedule-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const orderId = this.getAttribute('data-id');
          const orderRef = this.getAttribute('data-ref');
          const technicianId = this.getAttribute('data-technician-id');
          const technicianName = this.getAttribute('data-technician-name');
          const isProject = this.getAttribute('data-is-project') === 'true';

          // Create order object
          const order = {
            _id: orderId,
            orderReference: orderRef,
            technicianId: technicianId,
            technician: technicianName ? { name: technicianName } : null,
            technicianName: technicianName,
            isProject: isProject
          };

          openRescheduleModal(order);
        });
      });

      // Reschedule modal state
      let currentRescheduleOrder = null;
      let currentRescheduleTechnicianId = null;
      let selectedRescheduleDate = null;
      let selectedRescheduleTime = null;
      let rescheduleCalendarState = {
        currentMonth: new Date().getMonth(),
        currentYear: new Date().getFullYear(),
        availableDates: []
      };

      // Open reschedule modal for orders
      function openRescheduleModal(order) {
        currentRescheduleOrder = order;
        currentRescheduleTechnicianId = order.technicianId || order.technician?._id;
        selectedRescheduleDate = null;
        selectedRescheduleTime = null;

        // Show loading state
        document.getElementById('phRescheduleLoading').classList.remove('d-none');
        document.getElementById('phRescheduleError').classList.add('d-none');
        document.getElementById('phRescheduleCalendarContent').classList.add('d-none');
        document.getElementById('phSubmitReschedule').disabled = true;

        // Set technician name
        const techName = order.technicianName || order.technician?.name || 'Not assigned';
        document.getElementById('phRescheduleTechName').textContent = techName;

        // Open modal
        const modal = new bootstrap.Modal(document.getElementById('phRescheduleModal'));
        modal.show();

        // If no technician assigned, show error
        if (!currentRescheduleTechnicianId) {
          document.getElementById('phRescheduleLoading').classList.add('d-none');
          document.getElementById('phRescheduleError').textContent = 'No technician assigned to this order. Please contact customer support.';
          document.getElementById('phRescheduleError').classList.remove('d-none');
          return;
        }

        // Fetch available slots for this technician
        fetchAvailableSlotsForOrder();
      }

      // Fetch available slots for the technician (orders)
      async function fetchAvailableSlotsForOrder() {
        try {
          const response = await fetch(`/api/schedule/technician/${encodeURIComponent(currentRescheduleTechnicianId)}/available-slots`);
          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.error || 'Failed to fetch available slots');
          }

          rescheduleCalendarState.availableDates = data.availableDates || [];

          // Initialize calendar
          rescheduleCalendarState.currentMonth = new Date().getMonth();
          rescheduleCalendarState.currentYear = new Date().getFullYear();

          // Show calendar content
          document.getElementById('phRescheduleLoading').classList.add('d-none');
          document.getElementById('phRescheduleCalendarContent').classList.remove('d-none');

          renderRescheduleCalendarForOrder();
        } catch (error) {
          console.error('Error fetching available slots:', error);
          document.getElementById('phRescheduleLoading').classList.add('d-none');
          document.getElementById('phRescheduleError').textContent = error.message || 'Failed to load available slots. Please try again.';
          document.getElementById('phRescheduleError').classList.remove('d-none');
        }
      }

      // Render reschedule calendar for orders
      function renderRescheduleCalendarForOrder() {
        const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        document.getElementById('phCalendarTitle').textContent = `${monthNames[rescheduleCalendarState.currentMonth]} ${rescheduleCalendarState.currentYear}`;

        const grid = document.getElementById('phCalendarGrid');
        grid.innerHTML = '';

        const firstDay = new Date(rescheduleCalendarState.currentYear, rescheduleCalendarState.currentMonth, 1);
        const lastDay = new Date(rescheduleCalendarState.currentYear, rescheduleCalendarState.currentMonth + 1, 0);
        const startingDay = firstDay.getDay();
        const totalDays = lastDay.getDate();

        // Add empty cells for days before the first day of the month
        for (let i = 0; i < startingDay; i++) {
          const emptyCell = document.createElement('div');
          emptyCell.className = 'calendar-cell disabled';
          grid.appendChild(emptyCell);
        }

        // Add days of the month
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        for (let day = 1; day <= totalDays; day++) {
          const date = new Date(rescheduleCalendarState.currentYear, rescheduleCalendarState.currentMonth, day);
          const dateStr = date.toISOString().split('T')[0];

          const cell = document.createElement('button');
          cell.className = 'calendar-cell';
          cell.innerHTML = `<span class="date-num">${day}</span>`;

          // Check if date is available
          const isAvailable = rescheduleCalendarState.availableDates.some(availableDate =>
            availableDate.date === dateStr && availableDate.available
          );

          // Check if date is in the past
          const isPast = date < today;

          if (isAvailable && !isPast) {
            cell.setAttribute('data-status', 'available');
            cell.onclick = function() {
              selectRescheduleDateForOrder(date, dateStr, this);
            };
          } else if (isPast) {
            cell.classList.add('disabled');
            cell.setAttribute('data-status', 'blocked');
          } else {
            cell.setAttribute('data-status', 'blocked');
            cell.classList.add('disabled');
          }

          // Check if this date is selected
          if (selectedRescheduleDate === dateStr) {
            cell.classList.add('is-selected');
          }

          grid.appendChild(cell);
        }
      }

      // Select reschedule date for orders
      function selectRescheduleDateForOrder(date, dateStr, cellElement) {
        selectedRescheduleDate = dateStr;
        selectedRescheduleTime = null;

        // Update calendar selection
        document.querySelectorAll('#phCalendarGrid .calendar-cell').forEach(cell => {
          cell.classList.remove('is-selected');
        });
        cellElement.classList.add('is-selected');

        // For project bookings, hide time slots — date only is sufficient
        const container = document.getElementById('phTimeSlotsContainer');
        const isProject = currentRescheduleOrder && currentRescheduleOrder.isProject;
        if (isProject) {
          if (container) {
            container.classList.remove('d-none');
            container.innerHTML = `
              <div class="alert alert-info mb-0">
                <i class="bi bi-kanban me-2"></i>
                <strong>Project Booking</strong> — Only a new start date is needed. The Operations Team will prepare the multi-day schedule.
              </div>`;
          }
          const reason = document.getElementById('phRescheduleReason').value.trim();
          document.getElementById('phSubmitReschedule').disabled = !reason;
          return;
        }

        // Find available time slots for this date
        const availableDate = rescheduleCalendarState.availableDates.find(ad => ad.date === dateStr);
        const timeSlots = availableDate ? availableDate.timeSlots : [];

        // Render time slots
        renderTimeSlotsForOrder(timeSlots);
      }

      // Render time slots for orders
      function renderTimeSlotsForOrder(timeSlots) {
        const container = document.getElementById('phTimeSlotsContainer');
        const slotsContainer = document.getElementById('phTimeSlots');

        if (timeSlots.length === 0) {
          container.classList.add('d-none');
          document.getElementById('phSubmitReschedule').disabled = true;
          return;
        }

        container.classList.remove('d-none');
        slotsContainer.innerHTML = '';

        timeSlots.forEach(slot => {
          const slotBtn = document.createElement('button');
          slotBtn.className = 'time-slot';
          slotBtn.innerHTML = `
            <div class="time-slot-time">${slot.time}</div>
            <div class="text-muted small">${slot.duration || '60 min'}</div>
          `;
          slotBtn.onclick = () => selectRescheduleTimeForOrder(slot.time, slotBtn);
          slotsContainer.appendChild(slotBtn);
        });

        document.getElementById('phSubmitReschedule').disabled = true;
      }

      // Select reschedule time for orders
      function selectRescheduleTimeForOrder(time, btnElement) {
        selectedRescheduleTime = time;

        // Update selection
        document.querySelectorAll('#phTimeSlots .time-slot').forEach(btn => {
          btn.classList.remove('active');
        });
        btnElement.classList.add('active');

        // Enable submit button if reason is provided
        const reason = document.getElementById('phRescheduleReason').value.trim();
        document.getElementById('phSubmitReschedule').disabled = !reason;
      }

      // Setup calendar navigation for orders
      document.getElementById('phPrevMonth').addEventListener('click', () => {
        rescheduleCalendarState.currentMonth--;
        if (rescheduleCalendarState.currentMonth < 0) {
          rescheduleCalendarState.currentMonth = 11;
          rescheduleCalendarState.currentYear--;
        }
        renderRescheduleCalendarForOrder();
      });

      document.getElementById('phNextMonth').addEventListener('click', () => {
        rescheduleCalendarState.currentMonth++;
        if (rescheduleCalendarState.currentMonth > 11) {
          rescheduleCalendarState.currentMonth = 0;
          rescheduleCalendarState.currentYear++;
        }
        renderRescheduleCalendarForOrder();
      });

      // Handle reason input change for orders
      document.getElementById('phRescheduleReason').addEventListener('input', function() {
        const reason = this.value.trim();
        document.getElementById('phSubmitReschedule').disabled = !reason || !selectedRescheduleDate || !selectedRescheduleTime;
      });

      // Submit reschedule request for orders
      document.getElementById('phSubmitReschedule').addEventListener('click', async function() {
        const reason = document.getElementById('phRescheduleReason').value.trim();
        const isProject = currentRescheduleOrder && currentRescheduleOrder.isProject;

        if (!reason || !selectedRescheduleDate) {
          alert('Please select a date and provide a reason for rescheduling.');
          return;
        }

        if (!isProject && !selectedRescheduleTime) {
          alert('Please select a preferred time.');
          return;
        }

        try {
          const response = await fetch(`/api/orders/${encodeURIComponent(currentRescheduleOrder._id)}/reschedule-request`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              requestedDate: selectedRescheduleDate,
              requestedTime: selectedRescheduleTime || null,
              reason: reason,
              isProject: isProject
            })
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.error || 'Failed to submit reschedule request');
          }

          // Close modal
          const modal = bootstrap.Modal.getInstance(document.getElementById('phRescheduleModal'));
          modal.hide();

          alert('Reschedule request submitted successfully! The secretary will review your request and you will be notified once it is approved.');
          window.location.reload();
        } catch (error) {
          console.error('Error submitting reschedule request:', error);
          alert('Failed to submit reschedule request: ' + error.message);
        }
      });
    });

    // Cancel order function
    async function cancelOrder(orderId, reason) {
      try {
        const res = await fetch(`/api/orders/${encodeURIComponent(orderId)}/cancel`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason: reason })
        });
        const data = await res.json();

        if (res.ok) {
          alert('Order cancelled successfully');
          window.location.reload();
        } else {
          alert(data.error || 'Failed to cancel order');
        }
      } catch(e) {
        console.error(e);
        alert('Network error cancelling order');
      }
    }
  </script>
