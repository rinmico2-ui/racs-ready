<div class="container-fluid py-4">
  <%- include('../../../partials/dashboard-styles') %>
  <link rel="stylesheet" href="/css/analytics.css">
  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-person-workspace"></i></div>
        <div>
          <h1>Technician Ratings</h1>
          <p>Performance reviews and ratings for service technicians</p>
        </div>
      </div>
      <div class="au-hero-actions">
        <button class="btn btn-outline-success" onclick="generatePerformanceReport()">
          <i class="bi bi-file-earmark-bar-graph me-2"></i>Performance Report
        </button>
        <button class="btn btn-primary" onclick="refreshTechnicianRatings()">
          <i class="bi bi-arrow-clockwise me-2"></i>Refresh
        </button>
      </div>
    </div>
  </div>

  <!-- Technician Performance Overview -->
  <div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1">
              <h6 class="text-muted mb-2">Total Technicians</h6>
              <h3 class="mb-0" id="totalTechnicians">0</h3>
              <small class="text-muted">Active staff</small>
            </div>
            <div class="ms-3">
              <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                <i class="bi bi-people-fill text-primary fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1">
              <h6 class="text-muted mb-2">Avg Rating</h6>
              <h3 class="mb-0" id="avgTechnicianRating">0.0</h3>
              <div class="text-warning">
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-half"></i>
              </div>
            </div>
            <div class="ms-3">
              <div class="bg-success bg-opacity-10 rounded-circle p-3">
                <i class="bi bi-trophy text-success fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1">
              <h6 class="text-muted mb-2">Total Reviews</h6>
              <h3 class="mb-0" id="totalReviews">0</h3>
              <small class="text-success">
                <i class="bi bi-arrow-up"></i> 15% this month
              </small>
            </div>
            <div class="ms-3">
              <div class="bg-info bg-opacity-10 rounded-circle p-3">
                <i class="bi bi-chat-dots text-info fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1">
              <h6 class="text-muted mb-2">Top Performers</h6>
              <h3 class="mb-0" id="topPerformers">0</h3>
              <small class="text-muted">4.5+ rating</small>
            </div>
            <div class="ms-3">
              <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                <i class="bi bi-award text-warning fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Performance Metrics -->
  <div class="row mb-4">
    <div class="col-lg-4 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Rating Distribution</h5>
        </div>
        <div class="card-body">
          <canvas id="ratingDistributionChart" height="250"></canvas>
        </div>
      </div>
    </div>
    
    <div class="col-lg-4 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Performance Trends</h5>
        </div>
        <div class="card-body">
          <canvas id="performanceTrendsChart" height="250"></canvas>
        </div>
      </div>
    </div>

    <div class="col-lg-4 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Top Performers</h5>
        </div>
        <div class="card-body">
          <canvas id="topPerformersChart" height="250"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters and Search -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-2">
          <label class="form-label">Department</label>
          <select class="form-select" id="departmentFilter">
            <option value="">All Departments</option>
            <option value="installation">Installation</option>
            <option value="repair">Repair</option>
            <option value="maintenance">Maintenance</option>
            <option value="inspection">Inspection</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Rating</label>
          <select class="form-select" id="ratingFilter">
            <option value="">All Ratings</option>
            <option value="5">5 Stars</option>
            <option value="4">4+ Stars</option>
            <option value="3">3+ Stars</option>
            <option value="2">Below 3 Stars</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Status</label>
          <select class="form-select" id="statusFilter">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="on-leave">On Leave</option>
            <option value="inactive">Inactive</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Experience</label>
          <select class="form-select" id="experienceFilter">
            <option value="">All Levels</option>
            <option value="junior">Junior (0-2 years)</option>
            <option value="mid">Mid (2-5 years)</option>
            <option value="senior">Senior (5+ years)</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Sort By</label>
          <select class="form-select" id="sortBy">
            <option value="rating">Highest Rated</option>
            <option value="reviews">Most Reviews</option>
            <option value="experience">Most Experience</option>
            <option value="name">Name A-Z</option>
            <option value="recent">Recently Rated</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">&nbsp;</label>
          <div class="d-grid">
            <button class="btn btn-primary" onclick="applyFilters()">
              <i class="bi bi-funnel me-2"></i>Apply Filters
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Technician Ratings Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0">
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Technician Performance</h5>
        <div class="d-flex gap-2">
          <span class="text-muted" id="technicianCount">Showing 0 technicians</span>
        </div>
      </div>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Technician</th>
              <th>Department</th>
              <th>Rating</th>
              <th>Reviews</th>
              <th>Jobs Completed</th>
              <th>Experience</th>
              <th>Status</th>
              <th>Performance</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="technicianRatingsTable">
            <tr>
              <td colspan="9" class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2">Loading technician ratings...</div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <nav aria-label="Technician ratings pagination" class="mt-3">
        <ul class="pagination justify-content-center" id="pagination">
        </ul>
      </nav>
    </div>
  </div>

  <%- include('../../../partials/chart-drilldown-modal') %>
</div>

<!-- Technician Details Modal -->
<div class="modal fade" id="technicianModal" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Technician Performance Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="technicianModalBody">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-info" onclick="viewFullProfile()">Full Profile</button>
        <button type="button" class="btn btn-warning" onclick="scheduleReview()">Schedule Review</button>
      </div>
    </div>
  </div>
</div>

<!-- Styles -->
<style>
  .rating-stars {
    color: #ffc107;
  }
  .technician-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #e9ecef;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: #6c757d;
  }
  .technician-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .performance-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
  }
  .status-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
  }
  .experience-level {
    font-size: 0.875rem;
    color: #6c757d;
  }
  .rating-count {
    font-size: 0.75rem;
    color: #6c757d;
  }
</style>

<!-- JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/chart-drilldown.js"></script>
<script>
  // @ts-nocheck
  let technicianRatings = [];
  let filteredTechnicians = [];
  let currentPage = 1;
  let perPage = 10;
  let totalPages = 1;
  let techCharts = {};

  function openDrill(title, subtitle, chartCfg, details, filters, ff, summary) {
    if (typeof ChartDrilldown === 'undefined') return;
    ChartDrilldown.open({ title: title, subtitle: subtitle || 'Click any element to filter the details below', chartConfig: chartCfg, details: details, filters: filters || [], filterField: ff || 'category', summary: summary || {} });
  }

  document.addEventListener('DOMContentLoaded', function() {
    loadTechnicianRatings();
  });

  async function loadTechnicianRatings() {
    try {
      showLoadingState();
      const response = await fetch('/api/admin/ratings/technicians');
      if (response.ok) {
        const data = await response.json();
        technicianRatings = data.technicians || [];
        filteredTechnicians = technicianRatings.slice();
        currentPage = 1;
        totalPages = Math.max(1, Math.ceil(filteredTechnicians.length / perPage));
        updateOverviewStats(data.stats || {});
        applyFilters();
        try { initializeTechCharts(data); } catch (e) { console.error('Chart init error:', e); }
      } else {
        showErrorState();
      }
    } catch (error) {
      console.error('Error loading technician ratings:', error);
      showErrorState();
    }
  }

  function updateOverviewStats(stats) {
    document.getElementById('totalTechnicians').textContent = stats.totalTechnicians || 0;
    document.getElementById('avgTechnicianRating').textContent = (stats.avgRating || 0).toFixed(1);
    document.getElementById('totalReviews').textContent = stats.totalReviews || 0;
    document.getElementById('topPerformers').textContent = stats.topPerformers || 0;
  }

  function initializeTechCharts(data) {
    // Destroy existing charts before recreating
    Object.keys(techCharts).forEach(function(key) {
      if (techCharts[key]) {
        techCharts[key].destroy();
        techCharts[key] = null;
      }
    });

    var ratingDistribution = data.ratingDistribution
      ? [5, 4, 3, 2, 1].map(function(s) { return data.ratingDistribution[s] || 0; })
      : [0, 0, 0, 0, 0];
    var performanceTrends = data.performanceTrends || {};
    var trendLabels = performanceTrends.labels || ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
    var trendRating = performanceTrends.avgRatings || performanceTrends.rating || [0, 0, 0, 0, 0, 0];
    var trendJobs = performanceTrends.jobCounts || performanceTrends.jobs || [0, 0, 0, 0, 0, 0];

    var topPerformersList = (data.technicians || [])
      .slice()
      .sort(function(a, b) { return (b.avgRating || 0) - (a.avgRating || 0); })
      .slice(0, 10);

    var tpLabels = topPerformersList.map(function(t) { return t.name || 'Tech'; });
    var tpValues = topPerformersList.map(function(t) { return t.avgRating || 0; });
    if (tpLabels.length === 0) { tpLabels = ['No data']; tpValues = [0]; }

    var starLabels = ['5 Stars', '4 Stars', '3 Stars', '2 Stars', '1 Star'];
    var starColors = ['#198754', '#0d6efd', '#ffc107', '#fd7e14', '#dc3545'];

    // Rating Distribution Doughnut
    var distCtx = document.getElementById('ratingDistributionChart').getContext('2d');
    var ratingDistCfg = {
      type: 'doughnut',
      data: {
        labels: starLabels,
        datasets: [{
          data: ratingDistribution,
          backgroundColor: starColors
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' }
        }
      }
    };
    techCharts.ratingDist = new Chart(distCtx, ratingDistCfg);

    // Performance Trends Line
    var trendsCtx = document.getElementById('performanceTrendsChart').getContext('2d');
    var perfTrendsCfg = {
      type: 'line',
      data: {
        labels: trendLabels,
        datasets: [{
          label: 'Average Rating',
          data: trendRating,
          borderColor: '#0d6efd',
          backgroundColor: 'rgba(13, 110, 253, 0.1)',
          tension: 0.4
        }, {
          label: 'Jobs Completed',
          data: trendJobs,
          borderColor: '#198754',
          backgroundColor: 'rgba(25, 135, 84, 0.1)',
          tension: 0.4,
          yAxisID: 'y1'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: {
            beginAtZero: false,
            min: 0,
            max: 5,
            position: 'left'
          },
          y1: {
            beginAtZero: true,
            position: 'right',
            grid: { drawOnChartArea: false }
          }
        }
      }
    };
    techCharts.performanceTrends = new Chart(trendsCtx, perfTrendsCfg);

    // Top Performers Bar Chart
    var tpCtx = document.getElementById('topPerformersChart').getContext('2d');
    var topPerformersCfg = {
      type: 'bar',
      data: {
        labels: tpLabels,
        datasets: [{
          label: 'Average Rating',
          data: tpValues,
          backgroundColor: tpValues.map(function(v) {
            if (v >= 4.5) return 'rgba(25, 135, 84, 0.8)';
            if (v >= 4.0) return 'rgba(13, 110, 253, 0.8)';
            if (v >= 3.5) return 'rgba(255, 193, 7, 0.8)';
            return 'rgba(220, 53, 69, 0.8)';
          })
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        indexAxis: 'y',
        scales: {
          x: { beginAtZero: false, min: 0, max: 5 },
          y: { type: 'category', grid: { display: false } }
        }
      }
    };
    techCharts.topPerformers = new Chart(tpCtx, topPerformersCfg);
  }

  // ── Filtering & Pagination ───────────────────────────────────────────
  function applyFilters() {
    var dept = (document.getElementById('departmentFilter') || {}).value || '';
    var rating = (document.getElementById('ratingFilter') || {}).value || '';
    var status = (document.getElementById('statusFilter') || {}).value || '';
    var experience = (document.getElementById('experienceFilter') || {}).value || '';
    var sortBy = (document.getElementById('sortBy') || {}).value || 'rating';

    filteredTechnicians = technicianRatings.filter(function(t) {
      if (dept && t.department && t.department !== dept) return false;
      if (rating) {
        var minRating = parseInt(rating);
        if (minRating === 2) { if (t.avgRating >= 3) return false; }
        else if (t.avgRating < minRating) return false;
      }
      if (status) {
        var s = (t.status || '').toLowerCase();
        if (status === 'active' && s !== 'active' && s !== 'available') return false;
        if (status === 'on-leave' && s !== 'on-leave' && s !== 'unavailable') return false;
        if (status === 'inactive' && s !== 'inactive' && s !== 'offline') return false;
      }
      if (experience) {
        if (experience === 'junior' && t.experience >= 2) return false;
        if (experience === 'mid' && (t.experience < 2 || t.experience >= 5)) return false;
        if (experience === 'senior' && t.experience < 5) return false;
      }
      return true;
    });

    // Sort
    filteredTechnicians.sort(function(a, b) {
      if (sortBy === 'rating') return (b.avgRating || 0) - (a.avgRating || 0);
      if (sortBy === 'reviews') return (b.reviewCount || 0) - (a.reviewCount || 0);
      if (sortBy === 'experience') return (b.experience || 0) - (a.experience || 0);
      if (sortBy === 'name') return (a.name || '').localeCompare(b.name || '');
      return 0;
    });

    currentPage = 1;
    totalPages = Math.max(1, Math.ceil(filteredTechnicians.length / perPage));
    renderTechnicianTable();
    renderPagination();
    updateTechnicianCount();
  }

  function renderTechnicianTable() {
    var tbody = document.getElementById('technicianRatingsTable');
    var start = (currentPage - 1) * perPage;
    var pageItems = filteredTechnicians.slice(start, start + perPage);

    if (pageItems.length === 0) {
      tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4"><div class="text-muted"><i class="bi bi-person-workspace fs-1 d-block mb-2"></i>No technicians match the filters</div></td></tr>';
      return;
    }

    tbody.innerHTML = pageItems.map(function(tech) {
      return '<tr>' +
        '<td><div class="d-flex align-items-center">' +
          '<div class="technician-avatar me-3">' + (tech.avatar ? '<img src="'+tech.avatar+'" alt="'+tech.name+'">' : getInitials(tech.name)) + '</div>' +
          '<div><div class="fw-medium">' + tech.name + '</div><small class="text-muted">' + (tech.email || '') + '</small>' +
          '<div class="experience-level">' + getExperienceLevel(tech.experience) + '</div></div>' +
        '</div></td>' +
        '<td><span class="badge bg-secondary">' + (tech.department || 'General') + '</span></td>' +
        '<td><div class="d-flex align-items-center"><div class="rating-stars">' + generateStars(tech.avgRating) + '</div><span class="ms-2 fw-bold">' + tech.avgRating.toFixed(1) + '</span></div><div class="rating-count">' + tech.reviewCount + ' reviews</div></td>' +
        '<td><div class="text-center"><div class="fw-bold">' + tech.reviewCount + '</div><small class="text-muted">total</small></div></td>' +
        '<td><div class="text-center"><div class="fw-bold">' + tech.jobsCompleted + '</div><small class="text-muted">jobs</small></div></td>' +
        '<td><span class="badge bg-' + getExperienceBadgeColor(tech.experience) + '">' + tech.experience + ' year' + (tech.experience !== 1 ? 's' : '') + '</span></td>' +
        '<td><span class="status-badge bg-' + getStatusColor(tech.status) + '">' + formatStatus(tech.status) + '</span></td>' +
        '<td><div class="text-center">' + getPerformanceIndicator(tech.avgRating) + '</div></td>' +
        '<td><div class="btn-group btn-group-sm">' +
          '<button class="btn btn-outline-primary" onclick="viewTechnicianDetails(\'' + tech.id + '\')" title="View Details"><i class="bi bi-eye"></i></button>' +
          '<button class="btn btn-outline-info" onclick="viewReviews(\'' + tech.id + '\')" title="View Reviews"><i class="bi bi-chat-dots"></i></button>' +
          '<button class="btn btn-outline-success" onclick="sendFeedback(\'' + tech.id + '\')" title="Send Feedback"><i class="bi bi-envelope"></i></button>' +
        '</div></td></tr>';
    }).join('');
  }

  function renderPagination() {
    var pag = document.getElementById('pagination');
    if (!pag) return;
    if (totalPages <= 1) { pag.innerHTML = ''; return; }

    var h = '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '"><a class="page-link" href="#" onclick="changePage(' + (currentPage - 1) + ');return false;">&laquo;</a></li>';
    var blockSize = 5;
    var start = Math.floor((currentPage - 1) / blockSize) * blockSize + 1;
    var end = Math.min(start + blockSize - 1, totalPages);
    for (var i = start; i <= end; i++) {
      h += '<li class="page-item ' + (i === currentPage ? 'active' : '') + '"><a class="page-link" href="#" onclick="changePage(' + i + ');return false;">' + i + '</a></li>';
    }
    h += '<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '"><a class="page-link" href="#" onclick="changePage(' + (currentPage + 1) + ');return false;">&raquo;</a></li>';
    pag.innerHTML = h;
  }

  function changePage(page) {
    if (page < 1 || page > totalPages) return;
    currentPage = page;
    renderTechnicianTable();
    renderPagination();
    window.scrollTo({ top: document.getElementById('technicianRatingsTable').offsetTop - 80, behavior: 'smooth' });
  }

  function updateTechnicianCount() {
    var count = filteredTechnicians.length;
    document.getElementById('technicianCount').textContent = 'Showing ' + count + ' technician' + (count !== 1 ? 's' : '');
  }

  // ── Helpers ──────────────────────────────────────────────────────────
  function showLoadingState() {
    var tbody = document.getElementById('technicianRatingsTable');
    tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div><div class="mt-2">Loading technician ratings...</div></td></tr>';
  }

  function showErrorState() {
    var tbody = document.getElementById('technicianRatingsTable');
    tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4"><div class="text-danger"><i class="bi bi-exclamation-triangle fs-1 d-block mb-2"></i>Error loading technician ratings. <button class="btn btn-sm btn-outline-danger mt-2" onclick="loadTechnicianRatings()">Retry</button></div></td></tr>';
  }

  function refreshTechnicianRatings() { loadTechnicianRatings(); }

  function getInitials(name) {
    return (name || '').split(' ').map(function(n) { return n[0]; }).join('').toUpperCase().slice(0, 2);
  }

  function generateStars(rating) {
    var stars = '';
    for (var i = 1; i <= 5; i++) {
      if (i <= rating) stars += '<i class="bi bi-star-fill"></i>';
      else if (i - 0.5 <= rating) stars += '<i class="bi bi-star-half"></i>';
      else stars += '<i class="bi bi-star"></i>';
    }
    return stars;
  }

  function getExperienceLevel(years) {
    if (years < 2) return 'Junior Technician';
    if (years < 5) return 'Mid-level Technician';
    return 'Senior Technician';
  }

  function getExperienceBadgeColor(years) {
    if (years < 2) return 'info';
    if (years < 5) return 'warning';
    return 'success';
  }

  function getStatusColor(status) {
    var s = (status || '').toLowerCase();
    if (s === 'active' || s === 'available') return 'success';
    if (s === 'on-leave' || s === 'unavailable') return 'warning';
    if (s === 'inactive' || s === 'offline') return 'secondary';
    if (s === 'assigned' || s === 'on the way' || s === 'in progress') return 'primary';
    return 'secondary';
  }

  function formatStatus(status) {
    var s = (status || '').toLowerCase();
    if (s === 'available') return 'Active';
    if (s === 'on the way') return 'On The Way';
    if (s === 'in progress') return 'In Progress';
    if (s === 'assigned') return 'Assigned';
    return status || 'Unknown';
  }

  function getPerformanceIndicator(rating) {
    if (rating >= 4.5) return '<i class="bi bi-trophy-fill text-warning" title="Top Performer"></i>';
    if (rating >= 4.0) return '<i class="bi bi-star-fill text-success" title="Good Performance"></i>';
    if (rating >= 3.5) return '<i class="bi bi-circle-fill text-info" title="Average Performance"></i>';
    return '<i class="bi bi-exclamation-triangle-fill text-danger" title="Needs Improvement"></i>';
  }

  // ── Detail Modal ─────────────────────────────────────────────────────
  function viewTechnicianDetails(technicianId) {
    var technician = technicianRatings.find(function(t) { return t.id === technicianId; });
    if (!technician) return;

    var modalBody = document.getElementById('technicianModalBody');
    modalBody.innerHTML =
      '<div class="row">' +
        '<div class="col-md-4 text-center">' +
          '<div class="technician-avatar mx-auto mb-3" style="width:120px;height:120px;font-size:2rem;">' +
            (technician.avatar ? '<img src="'+technician.avatar+'" alt="'+technician.name+'">' : getInitials(technician.name)) +
          '</div>' +
          '<h5>' + technician.name + '</h5>' +
          '<p class="text-muted">' + (technician.email || 'No email') + '</p>' +
          '<span class="status-badge bg-' + getStatusColor(technician.status) + '">' + formatStatus(technician.status) + '</span>' +
          '<div class="rating-stars fs-4 mt-2">' + generateStars(technician.avgRating) + '</div>' +
          '<div class="fw-bold">' + technician.avgRating.toFixed(1) + ' / 5.0</div>' +
          '<div class="text-muted">' + technician.reviewCount + ' reviews</div>' +
        '</div>' +
        '<div class="col-md-8">' +
          '<h6>Performance Metrics</h6>' +
          '<div class="row mb-3">' +
            '<div class="col-md-3 text-center"><div class="h4 text-primary">' + technician.jobsCompleted + '</div><small class="text-muted">Jobs Completed</small></div>' +
            '<div class="col-md-3 text-center"><div class="h4 text-success">' + technician.reviewCount + '</div><small class="text-muted">Total Reviews</small></div>' +
            '<div class="col-md-3 text-center"><div class="h4 text-info">' + technician.experience + ' yr' + (technician.experience !== 1 ? 's' : '') + '</div><small class="text-muted">Experience</small></div>' +
            '<div class="col-md-3 text-center"><div class="h4 text-warning">' + getPerformanceIndicator(technician.avgRating) + '</div><small class="text-muted">Rating Tier</small></div>' +
          '</div>' +
        '</div>' +
      '</div>';

    new bootstrap.Modal(document.getElementById('technicianModal')).show();
  }

  function viewReviews(technicianId) {
    var tech = technicianRatings.find(function(t) { return t.id === technicianId; });
    if (!tech) return;
    var modalBody = document.getElementById('technicianModalBody');
    modalBody.innerHTML =
      '<h5>' + tech.name + ' — Reviews (' + tech.reviewCount + ')</h5>' +
      '<div class="rating-stars fs-4 mb-3">' + generateStars(tech.avgRating) + ' <span class="fw-bold">' + tech.avgRating.toFixed(1) + '</span></div>' +
      '<p class="text-muted">Detailed review history for this technician. Reviews are sourced from customer feedback after completed jobs.</p>' +
      '<div class="text-center py-3"><i class="bi bi-chat-dots text-muted" style="font-size:2rem;"></i><p class="text-muted mt-2">Review details are available in the full booking records.</p></div>';
    new bootstrap.Modal(document.getElementById('technicianModal')).show();
  }

  function sendFeedback(technicianId) {
    var tech = technicianRatings.find(function(t) { return t.id === technicianId; });
    if (!tech) return;
    alert('Feedback email form for ' + tech.name + ' would open here.');
  }

  function viewFullProfile() {
    alert('Full technician profile view would open here.');
  }

  function scheduleReview() {
    alert('Performance review scheduler would open here.');
  }

  function generatePerformanceReport() {
    alert('Report generation would start here.');
  }

  function formatDate(dateString) {
    if (!dateString) return '--';
    return new Date(dateString).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  }
</script>
