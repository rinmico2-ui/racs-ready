<script>
const escR=v=>String(v??'—').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const safeRHref=value=>/^\/uploads\/[A-Za-z0-9_./-]+$/.test(String(value||''))||/^https:\/\//i.test(String(value||''))?escR(value):'';
const remStatusColor=s=>({waiting_for_remittance:'warning',remitted:'info',verified:'success',rejected:'secondary',unaccounted:'danger'}[s]||'secondary');
const remStatusLabel=p=>p.status==='unaccounted'&&p.resolvedAt?'Exception resolved':({waiting_for_remittance:'Technician handover',remitted:'Admin review',verified:'Verified',rejected:'Correction required',unaccounted:'Escalated exception'}[p.status]||p.status);
const remitMoney=value=>'₱'+Number(value||0).toLocaleString('en-PH',{minimumFractionDigits:2,maximumFractionDigits:2});
const remAge=value=>{if(!value)return '';const hours=Math.max(0,Math.floor((Date.now()-new Date(value).getTime())/3600000));return hours<24?`${hours}h in custody`:`${Math.floor(hours/24)}d in custody`;};
let currentPayments=[];
let currentPage=1;
const pageSize=10;
let remFiltered=[];
const remFooter=document.getElementById('remittanceFooter');
let _overrideId=null;
let _flagId=null;
let _resolveId=null;
let _resolveType=null;

async function loadRemittances(){
  const s=document.getElementById('statusFilter').value;
  document.getElementById('remittanceRows').innerHTML='<tr><td colspan="8" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Loading the reconciliation queue…</td></tr>';
  const r=await fetch('/api/admin/remittances?limit=200&status='+encodeURIComponent(s));
  const d=await r.json();
  if(!r.ok){document.getElementById('remittanceRows').innerHTML=`<tr><td colspan="8" class="text-center text-danger py-5">${escR(d.error||'Unable to load remittances.')}</td></tr>`;return;}
  currentPayments=d.payments||[];
  updateKPIs(d.summary||{});
  renderPayments(currentPayments);
}

function updateKPIs(summary){
  const row=key=>summary[key]||{count:0,amount:0};
  const pending=row('waiting_for_remittance'),submitted=row('remitted'),verified=row('verified'),rejected=row('rejected'),unaccounted=row('unaccounted');
  const activeCount=pending.count+submitted.count+rejected.count+unaccounted.count;
  const activeAmount=pending.amount+submitted.amount+rejected.amount+unaccounted.amount;
  document.getElementById('kpiTotal').textContent=activeCount.toLocaleString();
  document.getElementById('kpiExposure').textContent=remitMoney(activeAmount);
  document.getElementById('kpiPending').textContent=pending.count.toLocaleString();
  document.getElementById('kpiPendingAmount').textContent=remitMoney(pending.amount)+' awaiting handover';
  document.getElementById('kpiSubmitted').textContent=submitted.count.toLocaleString();
  document.getElementById('kpiSubmittedAmount').textContent=remitMoney(submitted.amount)+' to reconcile';
  document.getElementById('kpiVerified').textContent=verified.count.toLocaleString();
  document.getElementById('kpiVerifiedAmount').textContent=remitMoney(verified.amount)+' reconciled';
  document.getElementById('kpiExceptions').textContent=(rejected.count+unaccounted.count).toLocaleString();
  document.getElementById('kpiExceptionBreakdown').textContent=`${rejected.count} corrections · ${unaccounted.count} escalated`;
}

function renderPayments(payments){
  const q=(document.getElementById('remSearch')?.value||'').toLowerCase();
  const rows=q?payments.filter(p=>{
    const ref=String(p.bookingId?.bookingReference||p.orderId?.orderReference||p.projectId?.projectReference||'').toLowerCase();
    const subject=p.bookingId||p.orderId||p.projectId||{};
    const c=String(subject.customer?.name||'').toLowerCase();
    const t=String(p.collectedByName||p.collectedBy?.name||'').toLowerCase();
    return ref.includes(q)||c.includes(q)||t.includes(q);
  }):payments;
  document.getElementById('tableCount').textContent=rows.length.toLocaleString();
  remFiltered=rows;
  currentPage=1;
  renderPage(1, rows);
}

function renderPage(page, items){
  const start=(page-1)*pageSize;
  const slice=items.slice(start, start+pageSize);
  if(!slice.length){
    document.getElementById('remittanceRows').innerHTML='<tr><td colspan="8" class="text-center text-muted py-5">No remittance records found.</td></tr>';
    remFooter.innerHTML='<nav aria-label="Remittance pagination"><ul class="inv-pagination justify-content-end mb-0"><li class="page-item disabled"><a class="page-link" href="javascript:void(0)">Prev</a></li><li class="page-item active"><span class="page-link">1 / 1</span></li><li class="page-item disabled"><a class="page-link" href="javascript:void(0)">Next</a></li></ul></nav>';
    return;
  }
  document.getElementById('remittanceRows').innerHTML=slice.map(p=>{
    const subject=p.bookingId||p.orderId||p.projectId||{};
    const ref=p.bookingId?.bookingReference||p.orderId?.orderReference||p.projectId?.projectReference||String(p._id).slice(-8);
    const color=remStatusColor(p.status);
    const actions=`<button class="btn btn-sm btn-outline-primary fw-semibold" onclick="openDetail('${p._id}')"><i class="bi bi-clipboard-check me-1"></i>Review</button>`;
    return `<tr>
      <td class="fw-semibold">${escR(ref)}</td>
      <td>${escR(subject.customer?.name)}</td>
      <td>${escR(p.collectedByName||p.collectedBy?.name)}</td>
      <td class="fw-bold">₱${Number(p.amount||0).toLocaleString()}</td>
      <td>${escR(p.method).toUpperCase()}<div class="small text-muted">${escR(p.reference)}</div></td>
      <td class="small">${p.collectedAt?new Date(p.collectedAt).toLocaleString('en-PH'):'—'}${!['verified'].includes(p.status)&&p.collectedAt?`<div class="${(Date.now()-new Date(p.collectedAt).getTime())>86400000?'text-danger':'text-muted'} fw-semibold mt-1">${escR(remAge(p.collectedAt))}</div>`:''}</td>
      <td><span class="badge bg-${color}-subtle text-${color}">${remStatusLabel(p)}</span>${p.overrideBy?'<div class="small text-muted mt-1">Admin handover</div>':''}${p.flaggedBy&&!p.resolvedAt?'<div class="small text-danger mt-1">Resolution required</div>':''}</td>
      <td>${actions}</td>
    </tr>`;
  }).join('');
  renderPagination(page, Math.ceil(items.length/pageSize)||1, items.length);
}

function renderPagination(page, pages, total){
  const disabled=total===0;
  remFooter.innerHTML=`<nav aria-label="Remittance pagination"><ul class="inv-pagination justify-content-end mb-0"><li class="page-item ${page<=1||disabled?'disabled':''}"><a class="page-link" href="javascript:void(0)" data-page="${page-1}">Prev</a></li><li class="page-item active"><span class="page-link">${disabled?'1 / 1':page+' / '+pages}</span></li><li class="page-item ${page>=pages||disabled?'disabled':''}"><a class="page-link" href="javascript:void(0)" data-page="${page+1}">Next</a></li></ul></nav>`;
  remFooter.querySelectorAll('.page-link[data-page]').forEach(el=>{
    el.addEventListener('click',e=>{
      e.preventDefault();
      const target=e.target.closest('.page-link');
      const newPage=parseInt(target?.dataset.page);
      if(!target?.closest('.page-item.disabled')&&newPage>=1&&newPage<=pages){currentPage=newPage;renderPage(currentPage,remFiltered);}
    });
  });
}

function filterRemittanceRows(){renderPayments(currentPayments);}

function findPayment(id){return currentPayments.find(p=>p._id===id);}

async function openDetail(id){
  const p=findPayment(id);
  if(!p) return;
  const subject=p.bookingId||p.orderId||p.projectId||{};
  const ref=p.bookingId?.bookingReference||p.orderId?.orderReference||p.projectId?.projectReference||String(p._id).slice(-8);
  document.getElementById('detailTitle').textContent='Payment Details';
  document.getElementById('detailRef').textContent=ref;
  const color=remStatusColor(p.status);
  const rows=[
    ['Reference',ref],
    ['Customer',subject.customer?.name||'—'],
    ['Technician',p.collectedByName||p.collectedBy?.name||'—'],
    ['Amount','₱'+Number(p.amount||0).toLocaleString()],
    ['Payment Method',(p.method||'').toUpperCase()],
    ['Transaction Ref',p.reference||'—'],
    ['Type',p.type||'final'],
    ['Status',`<span class="badge bg-${color}-subtle text-${color}">${escR(remStatusLabel(p))}</span>`,true],
    ['Collected At',p.collectedAt?new Date(p.collectedAt).toLocaleString('en-PH'):'—'],
    ['Remitted At',p.remittedAt?new Date(p.remittedAt).toLocaleString('en-PH'):'—'],
    ['Handover Channel',p.remittanceMethod?String(p.remittanceMethod).replace(/_/g,' '):null],
    ['Handover Reference',p.remittanceReference||null],
    ['Verified At',p.verifiedAt?new Date(p.verifiedAt).toLocaleString('en-PH'):'—'],
    ['Override At',p.overrideAt?new Date(p.overrideAt).toLocaleString('en-PH'):null],
    ['Flagged At',p.flaggedAt?new Date(p.flaggedAt).toLocaleString('en-PH'):null],
    ['Override Notes',p.overrideNotes||null],
    ['Flag Reason',p.flagReason||null],
    ['Rejection Reason',p.rejectionReason||null],
    ['Remittance Notes',p.remittanceNotes||null],
    ['Resolution Type',p.resolutionType?p.resolutionType.replace(/_/g,' '):null],
    ['Resolved At',p.resolvedAt?new Date(p.resolvedAt).toLocaleString('en-PH'):null],
    ['Resolution Notes',p.resolutionNotes||null],
    ['Recovery Follow-Up',p.recoveryFollowUpDate?new Date(p.recoveryFollowUpDate).toLocaleDateString('en-PH',{weekday:'long',year:'numeric',month:'long',day:'numeric'}):null],
  ].filter(r=>r[1]!==null);
  document.getElementById('detailGrid').innerHTML=rows.map(r=>`<div class="rem-detail-row"><span class="label">${escR(r[0])}</span><span class="value">${r[2]?r[1]:escR(r[1])}</span></div>`).join('');
  const evidence=[];
  const customerProof=safeRHref(p.proofUrl),remittanceProof=safeRHref(p.remittanceProofUrl);
  if(customerProof)evidence.push(`<a class="btn btn-sm btn-outline-primary" href="${customerProof}" target="_blank" rel="noopener"><i class="bi bi-receipt me-1"></i>Customer payment proof</a>`);
  if(remittanceProof)evidence.push(`<a class="btn btn-sm btn-outline-success" href="${remittanceProof}" target="_blank" rel="noopener"><i class="bi bi-paperclip me-1"></i>Handover proof</a>`);
  if(p.customerSignature)evidence.push('<span class="badge bg-success-subtle text-success"><i class="bi bi-pen me-1"></i>Customer signature recorded</span>');
  document.getElementById('detailEvidence').innerHTML='<h6>Evidence & custody record</h6>'+(evidence.length?`<div class="d-flex flex-wrap align-items-center gap-2">${evidence.join('')}</div>`:'<div class="small text-danger"><i class="bi bi-exclamation-triangle me-1"></i>No supporting evidence is attached.</div>');

  // Timeline
  const tl=document.getElementById('detailTimeline');
  let events=[];
  if(p.collectedAt) events.push({cls:'tl-collected',title:'Payment Collected',at:p.collectedAt,note:'By '+(p.collectedByName||p.collectedBy?.name||'Technician')});
  if(p.remittedAt) events.push({cls:'tl-remitted',title:'Remittance Submitted',at:p.remittanceAt||p.remittedAt,note:p.remittanceNotes||'Submitted by technician'});
  if(p.overrideAt) events.push({cls:'tl-override',title:'Admin Override',at:p.overrideAt,note:p.overrideNotes||'Admin confirmed in-person handover'});
  if(p.verifiedAt&&!p.overrideAt) events.push({cls:'tl-verified',title:'Payment Verified',at:p.verifiedAt,note:'Verified by admin'});
  if(p.rejectedAt) events.push({cls:'tl-rejected',title:'Payment Rejected',at:p.rejectedAt,note:p.rejectionReason||'Rejected by admin'});
  if(p.flaggedAt) events.push({cls:'tl-flagged',title:'Flagged Unaccounted',at:p.flaggedAt,note:p.flagReason||'Violation issued to technician'});
  if(p.resolvedAt) events.push({cls:'tl-verified',title:'Resolved: '+(p.resolutionType||'').replace(/_/g,' '),at:p.resolvedAt,note:p.resolutionNotes||'Payment resolved by admin'});
  (p.events||[]).forEach(e=>{
    if(!events.find(ev=>ev.title.toLowerCase().includes(String(e.status||'')))){
      const cls=e.status==='collected'?'tl-collected':e.status==='remitted'?'tl-remitted':e.status==='verified'?'tl-verified':e.status==='rejected'?'tl-rejected':e.status==='override'?'tl-override':'tl-flagged';
      events.push({cls,title:e.status?.replace(/_/g,' ')||'Event',at:e.at,note:e.note||(e.actorName?'By '+e.actorName:'')});
    }
  });
  events.sort((a,b)=>new Date(b.at||0)-new Date(a.at||0));
  tl.innerHTML=events.length?events.map(e=>`<div class="rem-timeline-item ${e.cls}"><div class="tl-title">${escR(e.title)}</div><div class="tl-meta">${e.at?new Date(e.at).toLocaleString('en-PH'):''}</div>${e.note?'<div class="tl-note">'+escR(e.note)+'</div>':''}</div>`).join(''):'<div class="text-muted small">No events recorded.</div>';

  // Action buttons
  const actionsEl=document.getElementById('detailActions');
  let acts='';
  if(p.status==='waiting_for_remittance'){
    acts+=`<button class="btn btn-warning text-white fw-semibold" onclick="openOverride('${p._id}')"><i class="bi bi-check-circle me-1"></i>Record In-Person Handover</button>`;
    acts+=`<button class="btn btn-outline-danger fw-semibold" onclick="openFlag('${p._id}')"><i class="bi bi-flag me-1"></i>Escalate Exception</button>`;
  }
  if(p.status==='remitted'){
    acts+=`<button class="btn btn-success fw-semibold" onclick="actR('${p._id}','verify')"><i class="bi bi-shield-check me-1"></i>Verify & Clear</button>`;
    acts+=`<button class="btn btn-outline-warning fw-semibold" onclick="actR('${p._id}','reject')">Request Correction</button>`;
    acts+=`<button class="btn btn-outline-danger fw-semibold" onclick="openFlag('${p._id}')"><i class="bi bi-flag me-1"></i>Escalate</button>`;
  }
  if(p.status==='rejected'){
    acts+=`<span class="text-muted small me-auto"><i class="bi bi-person-gear me-1"></i>Waiting for technician correction</span>`;
    acts+=`<button class="btn btn-warning text-white fw-semibold" onclick="openOverride('${p._id}')">Record Handover</button>`;
    acts+=`<button class="btn btn-outline-danger fw-semibold" onclick="openFlag('${p._id}')">Escalate</button>`;
  }
  if(p.status==='unaccounted' && !p.resolvedAt){
    acts+=`<button class="btn btn-dark fw-semibold" onclick="openResolve('${p._id}')"><i class="bi bi-check2-all me-1"></i>Resolve</button>`;
  }
  if(p.status==='unaccounted' && p.resolvedAt){
    const rLabel={write_off:'Written Off',deduct_from_payroll:'Payroll Deducted',recovery:'Recovery'}[p.resolutionType]||p.resolutionType;
    acts+=`<span class="badge bg-dark-subtle text-dark fs-6"><i class="bi bi-check2-all me-1"></i>${rLabel}</span>`;
  }
  actionsEl.innerHTML=acts||'<span class="text-muted">No actions available for this status.</span>';
  actionsEl.innerHTML+='<button class="btn btn-outline-secondary ms-auto" data-bs-dismiss="modal">Close</button>';
  actionsEl.style.display='flex';
  actionsEl.style.gap='0.5rem';

  new bootstrap.Modal(document.getElementById('remDetailModal')).show();
}

function openOverride(id){
  const p=findPayment(id);if(!p) return;
  _overrideId=id;
  document.getElementById('overrideAmount').textContent='₱'+Number(p.amount||0).toLocaleString();
  document.getElementById('overrideNotes').value='';
  bootstrap.Modal.getInstance(document.getElementById('remDetailModal'))?.hide();
  setTimeout(()=>new bootstrap.Modal(document.getElementById('overrideModal')).show(),300);
}

async function confirmOverride(){
  if(!_overrideId) return;
  const notes=document.getElementById('overrideNotes').value.trim();
  if(notes.length<10){return Swal.fire('More detail required','Document who received the funds, where, and when.','warning');}
  const confirmation=await Swal.fire({title:'Record exceptional handover?',text:'This bypasses technician self-submission and immediately verifies the funds. The action is audit logged.',icon:'warning',showCancelButton:true,confirmButtonText:'Record and verify',confirmButtonColor:'#d97706'});
  if(!confirmation.isConfirmed)return;
  const r=await fetch('/api/admin/remittances/'+_overrideId+'/status',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'override',notes})});
  const d=await r.json();
  if(!r.ok){return Swal.fire('Handover not recorded',d.error||'Override failed','error');}
  bootstrap.Modal.getInstance(document.getElementById('overrideModal'))?.hide();
  _overrideId=null;
  await Swal.fire('Funds verified','The in-person handover was recorded in the audit trail.','success');
  loadRemittances();
}

function openFlag(id){
  const p=findPayment(id);if(!p) return;
  _flagId=id;
  document.getElementById('flagAmount').textContent='₱'+Number(p.amount||0).toLocaleString();
  document.getElementById('flagTechnician').textContent=p.collectedByName||p.collectedBy?.name||'Unknown';
  document.getElementById('flagReason').value='';
  bootstrap.Modal.getInstance(document.getElementById('remDetailModal'))?.hide();
  setTimeout(()=>new bootstrap.Modal(document.getElementById('flagModal')).show(),300);
}

async function confirmFlag(){
  if(!_flagId) return;
  const reason=document.getElementById('flagReason').value.trim();
  if(reason.length<10){return Swal.fire('More detail required','State the custody discrepancy in at least 10 characters.','warning');}
  const confirmation=await Swal.fire({title:'Escalate as unaccounted?',text:'This opens a formal cash-custody exception and records a technician violation. Use this only after checking the evidence and handover history.',icon:'warning',showCancelButton:true,confirmButtonText:'Open exception',confirmButtonColor:'#dc2626'});
  if(!confirmation.isConfirmed)return;
  const r=await fetch('/api/admin/remittances/'+_flagId+'/status',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'flag',reason})});
  const d=await r.json();
  if(!r.ok){return Swal.fire('Exception not opened',d.error||'Escalation failed','error');}
  bootstrap.Modal.getInstance(document.getElementById('flagModal'))?.hide();
  _flagId=null;
  await Swal.fire('Exception opened','The case now requires a documented recovery, payroll, or write-off resolution.','success');
  loadRemittances();
}

function openResolve(id){
  const p=findPayment(id);if(!p) return;
  _resolveId=id;
  _resolveType=null;
  document.getElementById('resolveAmount').textContent='₱'+Number(p.amount||0).toLocaleString();
  document.getElementById('resolveTechnician').textContent=p.collectedByName||p.collectedBy?.name||'Unknown';
  document.getElementById('resolveNotes').value='';
  document.querySelectorAll('input[name=resolveType]').forEach(r=>r.checked=false);
  document.querySelectorAll('.resolve-option').forEach(o=>o.style.borderColor='#e2e8f0');
  document.getElementById('followUpGroup').style.display='none';
  document.getElementById('resolveFollowUp').value='';
  const tomorrow=new Date();tomorrow.setDate(tomorrow.getDate()+1);
  document.getElementById('resolveFollowUp').min=`${tomorrow.getFullYear()}-${String(tomorrow.getMonth()+1).padStart(2,'0')}-${String(tomorrow.getDate()).padStart(2,'0')}`;
  bootstrap.Modal.getInstance(document.getElementById('remDetailModal'))?.hide();
  setTimeout(()=>new bootstrap.Modal(document.getElementById('resolveModal')).show(),300);
}

function selectResolveType(type){
  _resolveType=type;
  document.querySelectorAll('input[name=resolveType]').forEach(r=>r.checked=(r.value===type));
  document.querySelectorAll('.resolve-option').forEach(o=>{o.style.borderColor=o.querySelector('input').value===type?'#0f172a':'#e2e8f0';});
  document.getElementById('followUpGroup').style.display=type==='recovery'?'block':'none';
}

async function confirmResolve(){
  if(!_resolveId) return;
  if(!_resolveType){return Swal.fire('Choose a resolution','Select recovery, payroll deduction, or write-off.','warning');}
  const notes=document.getElementById('resolveNotes').value.trim();
  const followUpDate=_resolveType==='recovery'?document.getElementById('resolveFollowUp').value:null;
  if(notes.length<10){return Swal.fire('More detail required','Document the decision in at least 10 characters.','warning');}
  if(_resolveType==='recovery' && !followUpDate){return Swal.fire('Follow-up required','Set a future recovery deadline.','warning');}
  let msg='';
  if(_resolveType==='write_off') msg='This will write off the payment as a company loss. Continue?';
  if(_resolveType==='deduct_from_payroll') msg='This will create a deduction on the technician\'s payroll. Continue?';
  if(_resolveType==='recovery') msg='This will send the payment back to the technician for resubmission. Continue?';
  const confirmation=await Swal.fire({title:'Confirm exception resolution?',text:msg,icon:'warning',showCancelButton:true,confirmButtonText:'Confirm resolution',confirmButtonColor:'#0f172a'});
  if(!confirmation.isConfirmed)return;
  const payload={resolutionType:_resolveType,notes};
  if(followUpDate) payload.followUpDate=followUpDate;
  const r=await fetch('/api/admin/remittances/'+_resolveId+'/resolve',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
  const d=await r.json();
  if(!r.ok){return Swal.fire('Resolution not saved',d.error||'Resolution failed','error');}
  bootstrap.Modal.getInstance(document.getElementById('resolveModal'))?.hide();
  _resolveId=null;
  _resolveType=null;
  await Swal.fire('Resolution recorded',d.message||'The exception workflow was updated.','success');
  loadRemittances();
}

async function actR(id,action){
  let reason='';
  if(action==='reject'){
    const correction=await Swal.fire({title:'Request technician correction',input:'textarea',inputLabel:'What must be corrected?',inputPlaceholder:'Identify the missing, inconsistent, or unreadable evidence…',inputAttributes:{maxlength:'1000'},showCancelButton:true,confirmButtonText:'Send correction request',confirmButtonColor:'#d97706',inputValidator:value=>String(value||'').trim().length<10?'Enter a specific reason of at least 10 characters.':undefined});
    if(!correction.isConfirmed)return;
    reason=String(correction.value||'').trim();
  }else{
    const confirmation=await Swal.fire({title:'Verify this remittance?',text:'Confirm that the handover evidence and amount match the payment ledger.',icon:'question',showCancelButton:true,confirmButtonText:'Verify and clear',confirmButtonColor:'#16a34a'});
    if(!confirmation.isConfirmed)return;
  }
  const r=await fetch('/api/admin/remittances/'+id+'/status',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({action,reason})});
  const d=await r.json();
  if(!r.ok)return Swal.fire('Action not completed',d.error||'The record changed. Refresh and try again.','error');
  bootstrap.Modal.getInstance(document.getElementById('remDetailModal'))?.hide();
  await Swal.fire(action==='verify'?'Remittance verified':'Correction requested',d.message||'The workflow was updated.','success');
  loadRemittances();
}

const initialStatus=new URLSearchParams(location.search).get('status');
if(initialStatus&&[...document.getElementById('statusFilter').options].some(option=>option.value===initialStatus))document.getElementById('statusFilter').value=initialStatus;
loadRemittances();
</script>
