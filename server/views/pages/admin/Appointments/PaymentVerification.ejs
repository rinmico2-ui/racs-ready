<div class="main-content">
  <div class="container-fluid py-4">
    <div class="au-hero mb-4">
      <div class="au-hero-inner">
        <div class="au-hero-left">
          <div class="au-hero-icon"><i class="bi bi-credit-card"></i></div>
          <div>
            <h1>Payment Verification</h1>
            <p>Review and verify customer payments before assignment</p>
          </div>
        </div>
        <div class="au-hero-actions">
          <input type="text" class="form-control form-control-sm" placeholder="Search..."
            id="searchInput" style="width: 250px;">
          <button class="btn btn-sm btn-outline-secondary" onclick="loadList()"><i class="bi bi-arrow-clockwise"></i></button>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold">Awaiting Payment Verification</h6>
        <span class="badge bg-primary" id="resultCount">0</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr>
                <th>Reference</th>
                <th>Customer</th>
                <th>Service</th>
                <th>Date</th>
                <th>Amount</th>
                <th>Payment Method</th>
                <th>Proof</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody id="tableBody">
              <tr><td colspan="8" class="text-center py-5 text-muted"><div class="spinner-border text-primary"></div></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  async function loadList(page = 1) {
    try {
      const search = document.getElementById('searchInput')?.value || '';
      const res = await fetch(`/api/admin/appointments/list?stage=payment_verification&page=${page}&limit=15&search=${encodeURIComponent(search)}`);
      const data = await res.json();
      renderTable(data.bookings);
    } catch (e) { console.error(e); }
  }

  function renderTable(bookings) {
    const tbody = document.getElementById('tableBody');
    document.getElementById('resultCount').textContent = bookings.length;
    if (!bookings.length) {
      tbody.innerHTML = `<tr><td colspan="8" class="text-center py-5 text-muted"><i class="bi bi-inbox" style="font-size:2.5rem;"></i><div class="mt-2">No bookings awaiting verification</div></td></tr>`;
      return;
    }
    tbody.innerHTML = bookings.map(b => {
      const date = new Date(b.bookingDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      return `<tr>
        <td><code class="small">${b.bookingReference || 'N/A'}</code></td>
        <td><div class="fw-semibold small">${b.customer?.name || 'N/A'}</div><div class="text-muted" style="font-size:0.7rem;">${b.customer?.phone || ''}</div></td>
        <td class="small">${b.service?.name || (b.services?.[0]?.name) || 'N/A'}</td>
        <td class="small">${date}</td>
        <td class="fw-semibold">₱${(b.totalPrice || b.estimatedFee || 0).toLocaleString()}</td>
        <td><span class="badge bg-secondary">${(b.paymentMethod || 'cod').toUpperCase()}</span></td>
        <td>${b.paymentProof ? '<a href="' + b.paymentProof + '" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-image"></i></a>' : '<span class="text-muted small">N/A</span>'}</td>
        <td class="text-center">
          <div class="d-flex gap-1 justify-content-center">
            <button class="btn btn-sm btn-outline-success" onclick="verifyAndQueue('${b._id}')" title="Verify & Move to Queue"><i class="bi bi-check-lg"></i> Verify</button>
            <button class="btn btn-sm btn-outline-danger" onclick="rejectBooking('${b._id}')" title="Reject"><i class="bi bi-x-lg"></i></button>
          </div>
        </td>
      </tr>`;
    }).join('');
  }

  async function verifyAndQueue(id) {
    if (!confirm('Verify payment and move to assignment queue?')) return;
    try {
      await fetch(`/api/admin/appointments/${id}/verify-payment`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ notes: 'Verified' }) });
      await fetch(`/api/admin/appointments/${id}/move-to-queue`, { method: 'POST' });
      showToast('Payment verified and moved to queue');
      loadList();
    } catch (e) { showToast('Error', 'error'); }
  }

  async function rejectBooking(id) {
    const reason = prompt('Rejection reason:');
    if (!reason) return;
    try {
      await fetch(`/api/admin/appointments/${id}/reject`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason: 'other', note: reason }) });
      showToast('Booking rejected');
      loadList();
    } catch (e) { showToast('Error', 'error'); }
  }

  function showToast(msg, type = 'success') {
    const t = document.createElement('div');
    t.className = `toast align-items-center text-white bg-${type === 'error' ? 'danger' : 'success'} border-0`;
    t.innerHTML = `<div class="d-flex"><div class="toast-body">${msg}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>`;
    document.body.appendChild(t); new bootstrap.Toast(t).show(); setTimeout(() => t.remove(), 4000);
  }

  loadList();
  let st; document.getElementById('searchInput')?.addEventListener('input', () => { clearTimeout(st); st = setTimeout(() => loadList(), 400); });
</script>
