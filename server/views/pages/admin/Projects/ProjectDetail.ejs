            <div class="sd-item"><div class="sd-k">Name</div><div class="sd-v">${p.customer?.name || '—'}</div></div>
            <div class="sd-item"><div class="sd-k">Contact</div><div class="sd-v">${p.customer?.phone || p.customer?.email || '—'}</div></div>
            <div class="sd-item"><div class="sd-k">Start Date</div><div class="sd-v">${p.preferredStartDate ? new Date(p.preferredStartDate).toLocaleDateString('en-PH') : '—'}</div></div>
            <div class="sd-item"><div class="sd-k">Approved Completion</div><div class="sd-v">${approvedCompletionDate(p) ? new Date(approvedCompletionDate(p)).toLocaleDateString('en-PH') : '—'}</div></div>
            <div class="sd-item"><div class="sd-k">Address</div><div class="sd-v">${p.customer?.address || p.location?.address || '—'}</div></div>
            <div class="sd-item"><div class="sd-k">Working Days</div><div class="sd-v">${(p.preferredWorkingDays||[]).join(', ') || '—'}</div></div>
            <div class="sd-item"><div class="sd-k">Service</div><div class="sd-v">${p.service?.name || (p.repair?.serviceType === 'repair' ? 'Repair — ' + [p.repair?.unitInfo?.unitType, p.repair?.unitInfo?.brand, p.repair?.unitInfo?.model].filter(Boolean).join(' ') : '—')} ${p.service?.category ? '(' + p.service.category + ')' : ''}</div></div>
            <div class="sd-item"><div class="sd-k">Hours</div><div class="sd-v">${p.preferredWorkingHours?.start ? p.preferredWorkingHours.start + '–' + p.preferredWorkingHours.end : '—'}</div></div>
          </div>
          ${(p.notes || p.adminNotes) ? `<div class="mt-2 pt-2 border-top"><div class="sd-k mb-1">Notes</div><div class="sd-v">${p.notes || ''}${p.adminNotes ? (p.notes ? '<br>' : '') + p.adminNotes : ''}</div></div>` : ''}
          <div class="mt-3">
            <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Admin Notes</label>
            <textarea id="adminNotesInput" class="form-control form-control-sm mt-1" rows="2" style="font-size:0.82rem;border-radius:8px;">${p.adminNotes || ''}</textarea>
            <button class="pd-btn primary mt-2" onclick="saveAdminNotes(this)" style="font-size:0.72rem;"><i class="bi bi-floppy"></i> Save</button>
          </div>
        </div>
      </details>

      <!-- ══ 9. TIMELINE ══ -->
      <div class="pd-card" data-stage="planning ready active completed" style="border:1.5px solid #e2e8f0;">
        <div class="pd-head"><h3><i class="bi bi-signpost-2 me-2" style="color:#6366f1;"></i>Project Timeline</h3></div>
        <div class="pd-body">
          ${(() => {
            const milestones = [
              { label: 'Planning', done: stageOf(p) !== 'review' && stageOf(p) !== null, icon: 'bi-kanban' },
              { label: 'Ready', done: ['ready','in_progress','completed','closed'].includes(p.status), icon: 'bi-flag' },
              { label: 'Active', done: ['in_progress','completed','closed'].includes(p.status), icon: 'bi-play-fill' },
              { label: 'Completed', done: ['completed','closed'].includes(p.status), icon: 'bi-check2-all' },
            ];
            return `<div class="tl-milestones">
              ${milestones.map((m, i) => `
                <div class="tl-milestone ${m.done ? 'done' : ''}">
                  <span class="tl-m-dot">${m.done ? '<i class="bi bi-check-lg"></i>' : '<i class="bi bi-circle"></i>'}</span>
                  <span class="tl-m-label">${m.label}</span>
                </div>
                ${i < milestones.length - 1 ? '<div class="tl-m-line"></div>' : ''}
              `).join('')}
            </div>
            <div class="tl-footer">
              <div><strong>Expected Finish:</strong> ${fmtDate(dm.estCompletionDate)}</div>
            </div>`;
          })()}
          ${workOrders.filter(w => w.scheduledDate).length > 0 ? `
            <div class="mt-2 pt-2 border-top">
              <div style="font-size:0.65rem;font-weight:700;text-transform:uppercase;color:#94a3b8;margin-bottom:0.3rem;">Scheduled</div>
              ${(() => {
                const byDay = {};
                workOrders.filter(w => w.scheduledDate).forEach(w => {
                  const d = fmtDate(w.scheduledDate);
                  (byDay[d] = byDay[d] || []).push(w);
                });
                return Object.entries(byDay).map(([day, list]) => `
                  <div class="tl-day">${day}</div>
                  ${list.map(w => `<div class="tl-row"><span class="tl-dot"></span><span style="font-size:0.82rem;">${w.title || w.section || 'WO'}</span><span class="wo-mini ms-auto">${(w.assignedTechnicians||[]).map(t=>t.name).join(', ') || 'Unassigned'}</span></div>`).join('')}
                `).join('');
              })()}
            </div>` : ''}
        </div>
      </div>

      <!-- ══ SECONDARY: Live Status / Issues / Expenses ══ -->
      <div class="row g-3" data-stage-host>
        <div class="col-lg-4">
          <div class="pd-card" data-stage="active">
            <div class="pd-head"><h3 style="font-size:0.82rem;">Live Field</h3><span class="cap-pill" id="liveCount"></span></div>
            <div class="pd-body" id="liveStatusContainer">
              <div class="text-center py-3 text-muted" style="font-size:0.82rem;">No active work orders.</div>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="pd-card" data-stage="active completed">
            <div class="pd-head"><h3 style="font-size:0.82rem;">Issues (${window.__projectIssues?.length || 0})</h3></div>
            <div class="pd-body" id="issuesContainer">
              ${(window.__projectIssues && window.__projectIssues.length)
                ? window.__projectIssues.map(i => `
                  <div class="d-flex justify-content-between align-items-start py-1" style="border-bottom:1px solid #f1f5f9;font-size:0.8rem;">
                    <div><span class="wo-tag" style="font-size:0.6rem;">${(i.category||'').toUpperCase()}</span> ${i.title || i.description || ''}</div>
                    <span class="wo-status ${i.status}" style="font-size:0.6rem;">${i.status}</span>
                  </div>`).join('')
                : '<div class="text-muted" style="font-size:0.78rem;">None</div>'}
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="pd-card" data-stage="active completed">
            <div class="pd-head"><h3 style="font-size:0.82rem;">Expenses</h3><span class="cap-pill">₱${(window.__projectExpenseSummary?.pendingTotal || 0).toLocaleString()} pending</span></div>
            <div class="pd-body" id="expensesContainer">
              ${(window.__projectExpenses && window.__projectExpenses.length)
                ? window.__projectExpenses.map(e => `
                  <div class="d-flex justify-content-between align-items-center py-1" style="border-bottom:1px solid #f1f5f9;font-size:0.78rem;">
                    <span>${e.typeLabel || e.type}: ₱${Number(e.amount).toLocaleString()}</span>
                    <span class="wo-status ${e.status}" style="font-size:0.6rem;">${e.status}</span>
                  </div>`).join('')
                : '<div class="text-muted" style="font-size:0.78rem;">None</div>'}
