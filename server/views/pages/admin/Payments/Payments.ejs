<%
  const resolvedPaymentsApiBase = typeof paymentsApiBase === "string" ? paymentsApiBase : "/api/admin/payments";
  const resolvedPaymentsCanManage = typeof paymentsCanManage === "boolean" ? paymentsCanManage : true;
%>
<link rel="stylesheet" href="/css/admin-payments.css?v=20260929-receipt-table">
<div class="admin-dashboard container-fluid py-4 payments-page">
  <%- include('../../../partials/dashboard-styles') %>

  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-credit-card-2-front-fill"></i></div>
        <div>
          <h1>Payments Overview</h1>
          <p>Monitor transactions, reconciliation status, and collection performance</p>
        </div>
      </div>
    </div>
  </div>

  <style>
    .payments-page .dash-card { background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%); border-radius: 20px; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04), 0 4px 16px rgba(15, 23, 42, 0.04); border: 1px solid rgba(226, 232, 240, 0.6); transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); padding: 1.25rem; }
    .payments-page .dash-card:hover { transform: translateY(-4px); box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12), 0 8px 20px rgba(15, 23, 42, 0.06); }
    .payments-page .dash-card-header { padding: 0 0 12px 0; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .payments-page .dash-card-header h6 { font-size: 0.9rem; font-weight: 700; margin: 0; color: #0f172a; display: flex; align-items: center; }
    .payments-page .dash-card-header .meta { font-size: 0.7rem; color: #94a3b8; font-weight: 500; }
    .payments-page .dash-card-body { padding: 0; }
    .payments-page .kpi-icon { width: 48px; height: 48px; min-width: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3); }
    .payments-page .kpi-icon i { color: #fff !important; }
    .payments-page .kpi-trend { display: inline-flex; align-items: center; gap: 2px; font-size: 0.65rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
    .payments-page .kpi-trend.up { background: rgba(16,185,129,0.12); color: #059669; }
    .payments-page .kpi-trend.down { background: rgba(239,68,68,0.12); color: #dc2626; }
    .payments-page .kpi-trend.neutral { background: rgba(100,116,139,0.12); color: #64748b; }
    .payments-page .chart-container { position: relative; height: 240px; }
    .payments-page .chart-container canvas { width: 100% !important; height: 100% !important; }
    .payments-page .stat-metric { display: flex; justify-content: space-around; margin-top: 12px; padding-top: 12px; border-top: 1px solid #f1f5f9; font-size: 0.75rem; }
    .payments-page .stat-metric-item { text-align: center; }
    .payments-page .stat-metric-val { color: #0f172a; font-weight: 600; }
    .payments-page .stat-metric-lbl { color: #94a3b8; }
    .payments-page .payment-status-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 0.65rem; font-weight: 600; padding: 4px 10px; border-radius: 999px; }
    .payments-page .status-paid { background: rgba(16,185,129,0.12); color: #059669; }
    .payments-page .status-pending { background: rgba(245,158,11,0.12); color: #d97706; }
    .payments-page .status-failed { background: rgba(239,68,68,0.12); color: #dc2626; }
    .payments-page .status-partial { background: rgba(59,130,246,0.12); color: #2563eb; }
    .payments-page .table-hover tbody tr:hover { background: #f8fafc; }
    .payments-page .table td { padding: 12px 16px; vertical-align: middle; border-bottom: 1px solid #f1f5f9; }
    .payments-page .text-micro { font-size: 0.72rem; }
  </style>

  <div class="alert alert-light border small mb-3"><p id="paymentsLedgerBasis" class="mb-2">Loading payment ledger...</p><strong>Completed refunds:</strong> <span id="paymentsRefundTotal">—</span> · <strong>Payments after refunds:</strong> <span id="paymentsNetTotal">—</span></div>
  <!-- Executive KPI Summary -->
  <div class="row g-3 mb-4">
    <!-- Total Revenue -->
    <div class="col-lg-3 col-md-6">
      <div class="dash-card h-100">
        <div class="d-flex justify-content-between align-items-start">
          <div style="flex:1;">
            <h6 class="text-muted mb-2" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Payments received</h6>
            <div class="d-flex align-items-baseline gap-2 mb-2">
              <span class="h2 mb-0 fw-bold text-dark" id="kpiTotalRevenue">--</span>
            </div>
            <small class="text-muted">Includes money still held by technicians</small>
            <div style="margin-top:8px;padding-top:8px;border-top:1px solid #f1f5f9;">
              <div style="font-size:0.75rem;color:#94a3b8;">Monthly: <span id="kpiMonthlyRevenue" style="color:#0f172a;font-weight:600;">--</span></div>
            </div>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #10b981, #059669); margin-left: 12px;">
            <i class="bi bi-cash-stack text-white"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Collection Rate -->
    <div class="col-lg-3 col-md-6">
      <div class="dash-card h-100">
        <div class="d-flex justify-content-between align-items-start">
          <div style="flex:1;">
            <h6 class="text-muted mb-2" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Collected records</h6>
            <div class="d-flex align-items-baseline gap-2 mb-2">
              <span class="h2 mb-0 fw-bold text-dark" id="kpiCollectionRate">--</span>
              <span style="font-size:0.8rem;color:#059669;font-weight:600;">%</span>
            </div>
            <small class="text-muted">Collected payment records / filtered records</small>
            <div style="margin-top:8px;padding-top:8px;border-top:1px solid #f1f5f9;">
              <div style="font-size:0.75rem;color:#94a3b8;">Pending: <span id="kpiPendingAmount" style="color:#0f172a;font-weight:600;">--</span></div>
            </div>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #3b82f6, #2563eb); margin-left: 12px;">
            <i class="bi bi-percent text-white"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Payment Success Rate -->
    <div class="col-lg-3 col-md-6">
      <div class="dash-card h-100">
        <div class="d-flex justify-content-between align-items-start">
          <div style="flex:1;">
            <h6 class="text-muted mb-2" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Confirmed records</h6>
            <div class="d-flex align-items-baseline gap-2 mb-2">
              <span class="h2 mb-0 fw-bold text-dark" id="kpiSuccessRate">--</span>
              <span style="font-size:0.8rem;color:#059669;font-weight:600;">%</span>
            </div>
            <small class="text-muted">Paid or verified / filtered records</small>
            <div style="margin-top:8px;padding-top:8px;border-top:1px solid #f1f5f9;">
              <div style="font-size:0.75rem;color:#94a3b8;">Failed: <span id="kpiFailedCount" style="color:#dc2626;font-weight:600;">--</span></div>
            </div>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed); margin-left: 12px;">
            <i class="bi bi-check-circle text-white"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Average Transaction Value -->
    <div class="col-lg-3 col-md-6">
      <div class="dash-card h-100">
        <div class="d-flex justify-content-between align-items-start">
          <div style="flex:1;">
            <h6 class="text-muted mb-2" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Avg Transaction</h6>
            <div class="d-flex align-items-baseline gap-2 mb-2">
              <span class="h2 mb-0 fw-bold text-dark" id="kpiAvgTransaction">--</span>
            </div>
            <small class="text-muted">Per payment</small>
            <div style="margin-top:8px;padding-top:8px;border-top:1px solid #f1f5f9;">
              <div style="font-size:0.75rem;color:#94a3b8;">Total Txns: <span id="kpiTotalTransactions" style="color:#0f172a;font-weight:600;">--</span></div>
            </div>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706); margin-left: 12px;">
            <i class="bi bi-graph-up text-white"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Secondary KPIs Row -->
  <div class="row g-3 mb-4">
    <!-- Payment Methods Breakdown -->
    <div class="col-lg-4 col-md-6">
      <div class="dash-card h-100">
        <div style="margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #f1f5f9;">
          <h6 style="font-size:0.85rem;font-weight:700;margin:0;color:#0f172a;"><i class="bi bi-credit-card me-1" style="color:#2563eb;"></i>Payment Methods</h6>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.8rem;color:#64748b;font-weight:500;">GCash</span>
            <div style="display:flex;align-items:center;gap:8px;">
              <span style="font-size:0.9rem;font-weight:600;color:#0f172a;" id="kpiGcashCount">--</span>
              <span style="font-size:0.7rem;color:#94a3b8;" id="kpiGcashPercent">0%</span>
            </div>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.8rem;color:#64748b;font-weight:500;">Cash (COD)</span>
            <div style="display:flex;align-items:center;gap:8px;">
              <span style="font-size:0.9rem;font-weight:600;color:#0f172a;" id="kpiCashCount">--</span>
              <span style="font-size:0.7rem;color:#94a3b8;" id="kpiCashPercent">0%</span>
            </div>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.8rem;color:#64748b;font-weight:500;">Bank Transfer</span>
            <div style="display:flex;align-items:center;gap:8px;">
              <span style="font-size:0.9rem;font-weight:600;color:#0f172a;" id="kpiBankCount">--</span>
              <span style="font-size:0.7rem;color:#94a3b8;" id="kpiBankPercent">0%</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Outstanding Amounts -->
    <div class="col-lg-4 col-md-6">
      <div class="dash-card h-100">
        <div style="margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #f1f5f9;">
          <h6 style="font-size:0.85rem;font-weight:700;margin:0;color:#0f172a;"><i class="bi bi-exclamation-circle me-1" style="color:#f59e0b;"></i>Outstanding</h6>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.8rem;color:#64748b;font-weight:500;">Pending</span>
            <div style="display:flex;flex-direction:column;align-items:flex-end;">
              <span style="font-size:0.9rem;font-weight:600;color:#f59e0b;" id="kpiPendingCount">--</span>
              <span style="font-size:0.7rem;color:#94a3b8;" id="kpiPendingValue">--</span>
            </div>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.8rem;color:#64748b;font-weight:500;">Technician collections awaiting review</span>
            <div style="display:flex;flex-direction:column;align-items:flex-end;">
              <span style="font-size:0.9rem;font-weight:600;color:#3b82f6;" id="kpiPartialCount">--</span>
              <span style="font-size:0.7rem;color:#94a3b8;" id="kpiPartialValue">--</span>
            </div>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.8rem;color:#64748b;font-weight:500;">Failed</span>
            <div style="display:flex;flex-direction:column;align-items:flex-end;">
              <span style="font-size:0.9rem;font-weight:600;color:#dc2626;" id="kpiFailedCountDetail">--</span>
              <span style="font-size:0.7rem;color:#94a3b8;" id="kpiFailedValue">--</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Performance Metrics -->
    <div class="col-lg-4 col-md-6">
      <div class="dash-card h-100">
        <div style="margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #f1f5f9;">
          <h6 style="font-size:0.85rem;font-weight:700;margin:0;color:#0f172a;"><i class="bi bi-speedometer2 me-1" style="color:#059669;"></i>Performance</h6>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.8rem;color:#64748b;font-weight:500;">Last 30 days · daily collections</span>
            <span style="font-size:0.9rem;font-weight:600;color:#0f172a;" id="kpiAvgDailyRevenue">--</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.8rem;color:#64748b;font-weight:500;">Highest Single Txn</span>
            <span style="font-size:0.9rem;font-weight:600;color:#0f172a;" id="kpiHighestTxn">--</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.8rem;color:#64748b;font-weight:500;">Lowest Single Txn</span>
            <span style="font-size:0.9rem;font-weight:600;color:#0f172a;" id="kpiLowestTxn">--</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="row g-4 mb-4">
    <div class="col-lg-6">
      <div class="dash-card h-100">
        <div class="dash-card-header">
          <h6><i class="bi bi-graph-up-arrow me-1" style="color:#2563eb;"></i>Payment Trend</h6>
          <span class="meta">Last 30 days</span>
        </div>
        <div class="dash-card-body">
          <div class="chart-container">
            <canvas id="chartPaymentTrend"></canvas>
          </div>
          <div class="stat-metric">
            <div class="stat-metric-item">
              <div class="stat-metric-val" id="paymentAvg">--</div>
              <div class="stat-metric-lbl">Daily Avg</div>
            </div>
            <div class="stat-metric-item">
              <div class="stat-metric-val" id="paymentPeak">--</div>
              <div class="stat-metric-lbl">Peak Day</div>
            </div>
            <div class="stat-metric-item">
              <div class="stat-metric-val" id="paymentGrowth">--</div>
              <div class="stat-metric-lbl">Growth</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="dash-card h-100">
        <div class="dash-card-header">
          <h6><i class="bi bi-pie-chart-fill me-1" style="color:#8b5cf6;"></i>Payment Method Distribution</h6>
          <span class="meta">All time</span>
        </div>
        <div class="dash-card-body">
          <div class="chart-container">
            <canvas id="chartPaymentMethod"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Payment Status Overview -->
  <div class="dash-card mb-4">
    <div class="dash-card-header">
      <h6><i class="bi bi-check2-circle me-1" style="color:#059669;"></i>Payment Status Overview</h6>
      <span class="meta">This month</span>
    </div>
    <div class="dash-card-body">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;">
        <div>
          <div style="display:flex;justify-content:space-between;margin-bottom:8px;font-size:0.8rem;">
            <span style="color:#0f172a;font-weight:600;">Confirmed</span>
            <span style="color:#059669;font-weight:600;" id="paidPercent">--</span>
          </div>
          <div style="height:10px;background:#f1f5f9;border-radius:5px;overflow:hidden;">
            <div id="paidBar" style="height:100%;background:linear-gradient(90deg,#10b981,#059669);width:0%;transition:width 0.6s ease;"></div>
          </div>
          <div style="font-size:0.7rem;color:#94a3b8;margin-top:6px;" id="paidCount">0 transactions</div>
        </div>
        <div>
          <div style="display:flex;justify-content:space-between;margin-bottom:8px;font-size:0.8rem;">
            <span style="color:#0f172a;font-weight:600;">Pending</span>
            <span style="color:#f59e0b;font-weight:600;" id="pendingPercent">--</span>
          </div>
          <div style="height:10px;background:#f1f5f9;border-radius:5px;overflow:hidden;">
            <div id="pendingBar" style="height:100%;background:linear-gradient(90deg,#fbbf24,#f59e0b);width:0%;transition:width 0.6s ease;"></div>
          </div>
          <div style="font-size:0.7rem;color:#94a3b8;margin-top:6px;" id="pendingCount">0 transactions</div>
        </div>
        <div>
          <div style="display:flex;justify-content:space-between;margin-bottom:8px;font-size:0.8rem;">
            <span style="color:#0f172a;font-weight:600;">Partial</span>
            <span style="color:#3b82f6;font-weight:600;" id="partialPercent">--</span>
          </div>
          <div style="height:10px;background:#f1f5f9;border-radius:5px;overflow:hidden;">
            <div id="partialBar" style="height:100%;background:linear-gradient(90deg,#60a5fa,#3b82f6);width:0%;transition:width 0.6s ease;"></div>
          </div>
          <div style="font-size:0.7rem;color:#94a3b8;margin-top:6px;" id="partialCount">0 transactions</div>
        </div>
        <div>
          <div style="display:flex;justify-content:space-between;margin-bottom:8px;font-size:0.8rem;">
            <span style="color:#0f172a;font-weight:600;">Failed</span>
            <span style="color:#ef4444;font-weight:600;" id="failedPercent">--</span>
          </div>
          <div style="height:10px;background:#f1f5f9;border-radius:5px;overflow:hidden;">
            <div id="failedBar" style="height:100%;background:linear-gradient(90deg,#f87171,#ef4444);width:0%;transition:width 0.6s ease;"></div>
          </div>
          <div style="font-size:0.7rem;color:#94a3b8;margin-top:6px;" id="failedCount">0 transactions</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Toolbar -->
  <div class="dash-card mb-4">
    <div class="dash-card-header">
      <h6><i class="bi bi-funnel-fill me-1" style="color:#64748b;"></i>Filter & Search</h6>
    </div>
    <div class="dash-card-body">
      <div class="row g-3">
        <div class="col-lg-4">
          <label class="form-label small text-uppercase text-muted fw-bold">Search</label>
          <div class="input-group" style="border-radius:10px;overflow:hidden;">
            <span class="input-group-text" style="background:#f8fafc;border-color:#e2e8f0;"><i class="bi bi-search text-muted"></i></span>
            <input id="paymentsSearch" type="text" maxlength="100" class="form-control" style="border-color:#e2e8f0;background:#f8fafc;" placeholder="Booking ref, transaction ID, customer..." />
          </div>
        </div>
        <div class="col-lg-2">
          <label class="form-label small text-uppercase text-muted fw-bold">Status</label>
          <select class="form-select" id="paymentsStatusFilter" style="border-color:#e2e8f0;background:#f8fafc;">
            <option>All</option>
            <option>Paid</option>
            <option>Partial</option><option value="payment_collected">Collected by technician</option><option value="waiting_for_remittance">Awaiting remittance</option><option value="remitted">Remitted</option><option value="verified">Verified</option><option value="unaccounted">Unaccounted</option><option value="rejected">Rejected</option><option value="refunded">Refunded</option>
            <option>Pending</option>
            <option>Failed</option>
          </select>
        </div>
        <div class="col-lg-2">
          <label class="form-label small text-uppercase text-muted fw-bold">Method</label>
          <select class="form-select" id="paymentsMethodFilter" style="border-color:#e2e8f0;background:#f8fafc;">
            <option>All</option>
            <option>GCash</option>
            <option value="cash">Cash / COD</option>
            <option value="bank">Bank</option><option value="maya">Maya</option><option value="card">Card</option><option value="paymongo">PayMongo</option>
            <option>Other</option>
          </select>
        </div>
        <div class="col-lg-2">
          <label class="form-label small text-uppercase text-muted fw-bold">Gateway</label>
          <select class="form-select" id="paymentsGatewayFilter" style="border-color:#e2e8f0;background:#f8fafc;">
            <option>All</option>
            <option>GCash</option>
            <option>COD</option>
            <option>Other</option>
          </select>
        </div>
        <div class="col-sm-6 col-lg-3"><label for="paymentsFromDate" class="form-label small text-uppercase text-muted fw-bold">From</label><input id="paymentsFromDate" type="date" class="form-control"></div>
        <div class="col-sm-6 col-lg-3"><label for="paymentsToDate" class="form-label small text-uppercase text-muted fw-bold">To</label><input id="paymentsToDate" type="date" class="form-control"></div>
        <div class="col-lg-2 d-flex align-items-end">
          <button class="btn w-100" id="paymentsFilterBtn" style="background:#f1f5f9;border:1px solid #e2e8f0;color:#0f172a;font-weight:600;border-radius:10px;transition:all 0.25s ease;">
            <i class="bi bi-funnel me-2"></i>Filter
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Payment Transactions Table -->
  <div class="dash-card">
    <div class="dash-card-header">
      <h6><i class="bi bi-table me-1" style="color:#2563eb;"></i>Payment Transactions</h6>
      <span class="meta">All records</span>
    </div>
    <div class="dash-card-body" style="padding:0;">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 payment-transactions-table">
          <thead style="background:#f8fafc;border-bottom:1px solid #f1f5f9;">
            <tr>
