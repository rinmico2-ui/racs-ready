<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(async function() {
  const qs = (s) => document.querySelector(s);
  const qsa = (s) => [...document.querySelectorAll(s)];

  function spark(ctx, data, color) {
    if (!ctx || !window.Chart) return null;
    const h = ctx.canvas.height || ctx.canvas.offsetHeight || 30;
    const g = ctx.createLinearGradient(0, 0, 0, h);
    g.addColorStop(0, color);
    g.addColorStop(1, 'rgba(255,255,255,0)');
    return new Chart(ctx, {
      type: 'line',
      data: {
        labels: data.map((_, i) => i + 1),
        datasets: [{
          data: data, borderColor: color, backgroundColor: g,
          fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2,
        }],
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        animation: { duration: 600 },
        plugins: { legend: { display: false }, tooltip: { enabled: false } },
        scales: { x: { display: false }, y: { display: false } },
      },
    });
  }

  function makeSparkData(count) {
    const c = Math.max(0, count || 0);
    if (c === 0) return [0,0,0,0,0,0,0];
    return [Math.max(0, c-3), Math.max(0, c-2), Math.max(0, c-1), c-1, c, c, Math.max(0, c-1)];
  }

  const statusConfig = {
    pending_project_scheduling: { label: 'Pending Scheduling', cls: 'pl-status-pending' },
    accepted: { label: 'Accepted', cls: 'pl-status-accepted' },
    planning: { label: 'Planning', cls: 'pl-status-planning' },
    ready: { label: 'Ready', cls: 'pl-status-ready' },
    in_progress: { label: 'In Progress', cls: 'pl-status-in_progress' },
    completed: { label: 'Completed', cls: 'pl-status-completed' },
    closed: { label: 'Closed', cls: 'pl-status-closed' },
    cancelled: { label: 'Cancelled', cls: 'pl-status-cancelled' },
    on_hold: { label: 'On Hold', cls: 'pl-status-on_hold' },
  };

  const healthConfig = {
    past_due: { label: 'Past Due', cls: 'pl-health-critical', cardCls: 'health-critical', icon: 'bi-calendar-x-fill' },
    behind_schedule: { label: 'Behind Schedule', cls: 'pl-health-critical', cardCls: 'health-critical', icon: 'bi-graph-down-arrow' },
    at_risk: { label: 'At Risk', cls: 'pl-health-warning', cardCls: 'health-warning', icon: 'bi-exclamation-triangle-fill' },
    on_track: { label: 'On Track', cls: 'pl-health-healthy', cardCls: '', icon: 'bi-check-circle-fill' },
    unscheduled: { label: 'Unscheduled', cls: 'pl-health-warning', cardCls: 'health-warning', icon: 'bi-calendar2-minus' },
    not_started: { label: 'Not Started', cls: 'pl-health-neutral', cardCls: '', icon: 'bi-clock' },
    completed: { label: 'Completed', cls: 'pl-health-neutral', cardCls: '', icon: 'bi-check2-all' },
    cancelled: { label: 'Cancelled', cls: 'pl-health-neutral', cardCls: '', icon: 'bi-slash-circle' },
  };

  function shortDate(value) {
    if (!value) return '—';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '—';
    return date.toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  let currentFilter = '';
  let currentSearch = '';
  let currentServiceFilter = '';
  let currentHealthFilter = '';
  let currentPage = 1;
  let currentView = 'grid';
  let allProjects = [];
  let statusCounts = {};

  function setTrend(id, trend) {
    const el = qs(id);
    if (!el) return;
    const pct = (trend && trend.percent) || 0;
    const cls = pct > 0 ? 'up' : (pct < 0 ? 'down' : 'neutral');
    const icon = pct > 0 ? 'arrow-up' : (pct < 0 ? 'arrow-down' : 'dash');
    el.className = 'kpi-trend ' + cls;
    el.innerHTML = '<i class="bi bi-' + icon + '"></i> ' + Math.abs(pct) + '%';
  }

  async function loadStats() {
    try {
      const r = await fetch('/api/projects/dashboard');
      if (!r.ok) return;
      const data = await r.json();
      const s = data.stats || {};
      const tr = s.trends || {};
      qs('#statPending').textContent = s.pendingScheduling ?? 0;
      qs('#statPlanning').textContent = s.planning ?? 0;
      qs('#statInProgress').textContent = s.inProgress ?? 0;
      qs('#statCompleted').textContent = s.completed ?? 0;

      statusCounts = s;
      qs('#filterCountPending').textContent = s.pendingScheduling ?? 0;
      qs('#filterCountAccepted').textContent = s.accepted ?? 0;
      qs('#filterCountPlanning').textContent = s.planning ?? 0;
      qs('#filterCountReady').textContent = s.ready ?? 0;
      qs('#filterCountActive').textContent = s.inProgress ?? 0;
      qs('#filterCountCompleted').textContent = s.completed ?? 0;
      qs('#filterCountOnHold').textContent = s.onHold ?? 0;
      qs('#filterCountClosed').textContent = s.closed ?? 0;
      const health = s.scheduleHealth || {};
      qs('#healthCountPastDue').textContent = health.past_due ?? 0;
      qs('#healthCountBehind').textContent = health.behind_schedule ?? 0;
      qs('#healthCountAtRisk').textContent = health.at_risk ?? 0;
      qs('#healthCountOnTrack').textContent = health.on_track ?? 0;
      qs('#healthCountUnscheduled').textContent = health.unscheduled ?? 0;
      qs('#healthCountNotStarted').textContent = health.not_started ?? 0;
      setTrend('#trendPending', tr.pendingScheduling);
      setTrend('#trendPlanning', tr.planning);
      setTrend('#trendInProgress', tr.inProgress);
      setTrend('#trendCompleted', tr.completed);

      const total = (s.pendingScheduling || 0) + (s.accepted || 0) + (s.planning || 0) + (s.ready || 0) + (s.inProgress || 0) + (s.completed || 0) + (s.closed || 0) + (s.onHold || 0) + (s.cancelled || 0);
      const pct = (val) => total ? Math.round((val || 0) / total * 100) + '%' : '0%';
      qs('#pctPending').textContent = pct(s.pendingScheduling);
      qs('#pctPlanning').textContent = pct(s.planning);
      qs('#pctInProgress').textContent = pct(s.inProgress);
      qs('#pctCompleted').textContent = pct(s.completed);

      spark(qs('#sparkPending')?.getContext('2d'), makeSparkData(s.pendingScheduling), '#f59e0b');
      spark(qs('#sparkPlanning')?.getContext('2d'), makeSparkData(s.planning), '#8b5cf6');
      spark(qs('#sparkInProgress')?.getContext('2d'), makeSparkData(s.inProgress), '#10b981');
      spark(qs('#sparkCompleted')?.getContext('2d'), makeSparkData(s.completed), '#2563eb');
    } catch(e) {}
  }

  function renderSkeletons(count) {
    const grid = qs('#projectGrid');
    let html = '';
    for (let i = 0; i < count; i++) {
      html += `
        <div class="pl-skeleton-card">
          <div style="display:flex;justify-content:space-between;margin-bottom:0.75rem;">
            <div class="pl-skeleton-line" style="width:40%;height:18px;"></div>
            <div class="pl-skeleton-line" style="width:80px;height:22px;border-radius:999px;"></div>
          </div>
          <div class="pl-skeleton-line w-60" style="height:12px;"></div>
          <div class="pl-skeleton-line h-8" style="margin-top:1rem;"></div>
          <div class="pl-skeleton-row">
            <div class="pl-skeleton-line" style="width:70px;height:12px;"></div>
            <div class="pl-skeleton-line" style="width:70px;height:12px;"></div>
            <div class="pl-skeleton-line" style="width:70px;height:12px;"></div>
          </div>
        </div>`;
    }
    grid.innerHTML = html;
  }

  async function loadProjects(page = 1) {
    renderSkeletons(4);
    const params = new URLSearchParams({ page, limit: 20, sort: '-createdAt' });
    if (currentFilter) params.set('status', currentFilter);
    if (currentSearch) params.set('search', currentSearch);
    if (currentServiceFilter) params.set('serviceType', currentServiceFilter);
    if (currentHealthFilter) params.set('scheduleHealth', currentHealthFilter);

    try {
      const r = await fetch(`/api/projects?${params}`);
      if (!r.ok) throw new Error('Failed to load');
      const data = await r.json();
      let projects = data.projects || [];
      allProjects = projects;
      renderProjects(projects, data.pagination);
    } catch(e) {
      qs('#projectGrid').innerHTML = `
        <div class="pl-empty">
          <div class="pl-empty-icon"><i class="bi bi-exclamation-triangle"></i></div>
          <h3>Failed to load projects</h3>
          <p>Please check your connection and try again.</p>
        </div>`;
    }
  }

  function renderProjects(projects, pagination) {
    const grid = qs('#projectGrid');
    const tableBody = qs('#projectTableBody');
    const tableWrap = qs('#projectTableWrap');

    if (!projects || projects.length === 0) {
      const emptyHtml = `
        <div class="pl-empty">
          <div class="pl-empty-icon"><i class="bi bi-folder2-open"></i></div>
          <h3>No projects found</h3>
          <p>${currentFilter || currentSearch || currentServiceFilter || currentHealthFilter ? 'Try adjusting your filters or search terms.' : 'Projects will appear here once large-scale bookings are created.'}</p>
        </div>`;
      grid.innerHTML = emptyHtml;
      tableBody.innerHTML = `<tr><td colspan="10" style="text-align:center;padding:2rem;color:#94a3b8;">No projects found</td></tr>`;
      qs('#pagination').style.display = 'none';
      return;
    }

    // Grid view
    let gridHtml = '';
    for (const p of projects) {
      const st = statusConfig[p.status] || { label: p.status, cls: '' };
      const progress = p.totalUnits > 0 ? Math.round((p.completedUnits / p.totalUnits) * 100) : 0;
      const isRepair = p.repair?.serviceType === 'repair';
      const health = p.scheduleHealth || { code: 'unscheduled', label: 'Unscheduled', severity: 'warning', detail: 'No approved schedule is available.' };
      const hc = healthConfig[health.code] || healthConfig.unscheduled;

      gridHtml += `
        <a href="/admin/projects/${p._id}" class="pl-card ${hc.cardCls}">
          <div class="pl-card-inner">
            <div class="pl-card-top">
              <div>
                <div class="pl-card-customer">
                  ${escapeHtml(p.customer?.name || 'Unknown Customer')}
                  ${isRepair ? '<span class="pl-card-repair-badge"><i class="bi bi-tools"></i> Repair</span>' : ''}
                </div>
                <div class="pl-card-service">${escapeHtml(p.service?.name || '')}${p.totalUnits ? ' &middot; ' + p.totalUnits + ' units' : ''}${p.estimatedTotalHours ? ' &middot; ' + p.estimatedTotalHours.toFixed(1) + ' hrs' : ''}</div>
              </div>
              <div class="pl-card-status-stack">
                <span class="pl-card-status ${st.cls}">${st.label}</span>
                <span class="pl-health-badge ${hc.cls}"><i class="bi ${hc.icon}"></i>${hc.label}</span>
              </div>
            </div>
            <div class="pl-schedule-signal">
              <div class="pl-schedule-copy">
                <div style="font-size:.69rem;font-weight:800;color:#334155;">${hc.label}</div>
                <div class="pl-schedule-detail">${escapeHtml(health.detail || '')}</div>
              </div>
              <div class="pl-schedule-dates"><div>Approved <strong>${shortDate(health.approvedCompletionDate)}</strong></div><div>Forecast <strong>${shortDate(health.forecastCompletionDate)}</strong></div></div>
            </div>
            <div class="pl-card-progress">
              <div class="pl-progress-header">
                <span class="pl-progress-label">Progress</span>
                <span class="pl-progress-value">${p.completedUnits || 0} / ${p.totalUnits || 0} units (${progress}%)</span>
              </div>
              <div class="pl-progress-bar">
                <div class="pl-progress-fill" style="width:${progress}%"></div>
              </div>
            </div>
            <div class="pl-card-stats">
              <div class="pl-card-stat">
                <span class="pl-card-stat-label">Work Orders</span>
                <span class="pl-card-stat-value">${p.totalWorkOrders || 0}</span>
              </div>
              <div class="pl-card-stat">
                <span class="pl-card-stat-label">Team</span>
                <span class="pl-card-stat-value">${p.totalAssignedTechnicians || 0}</span>
              </div>
              <div class="pl-card-stat">
                <span class="pl-card-stat-label">Remaining</span>
                <span class="pl-card-stat-value">${Math.max(0, Number(p.totalUnits || 0) - Number(p.completedUnits || 0))}</span>
              </div>
            </div>
          </div>
        </a>`;
    }
    grid.innerHTML = gridHtml;

    // Table view
    let tableHtml = '';
    for (const p of projects) {
      const st = statusConfig[p.status] || { label: p.status, cls: '' };
      const progress = p.totalUnits > 0 ? Math.round((p.completedUnits / p.totalUnits) * 100) : 0;
      const isRepair = p.repair?.serviceType === 'repair';
      const health = p.scheduleHealth || { code: 'unscheduled', label: 'Unscheduled', detail: 'No approved schedule is available.' };
      const hc = healthConfig[health.code] || healthConfig.unscheduled;

      tableHtml += `
        <tr onclick="window.location='/admin/projects/${p._id}'">
          <td>
            <div class="customer-cell">${escapeHtml(p.customer?.name || 'Unknown')}</div>
            ${isRepair ? '<span class="pl-card-repair-badge" style="margin-top:2px;"><i class="bi bi-tools"></i> Repair</span>' : ''}
          </td>
          <td><div class="service-cell">${escapeHtml(p.service?.name || '—')}</div></td>
          <td style="font-size:0.78rem;color:#475569;">${(p.assignedTechnicians || []).map(t => escapeHtml(t.name || 'Technician')).join(', ') || 'Not assigned'}</td>
          <td style="font-weight:600;">${p.totalWorkOrders || 0}</td>
          <td style="font-weight:600;">${p.totalUnits || 0}</td>
          <td style="font-weight:600;color:#059669;">${p.completedUnits || 0}</td>
          <td style="font-weight:600;color:#d97706;">${Math.max(0, Number(p.totalUnits || 0) - Number(p.completedUnits || 0))}</td>
          <td style="font-size:.74rem;font-weight:600;white-space:nowrap;">${shortDate(health.approvedCompletionDate)}</td>
          <td><span class="pl-health-badge ${hc.cls}" title="${escapeHtml(health.detail || '')}"><i class="bi ${hc.icon}"></i>${hc.label}</span></td>
          <td><span class="pl-card-status ${st.cls}">${st.label}</span></td>
        </tr>`;
    }
    tableBody.innerHTML = tableHtml;

    // Toggle view
    if (currentView === 'table') {
      grid.style.display = 'none';
      tableWrap.classList.add('active');
    } else {
      grid.style.display = 'grid';
      tableWrap.classList.remove('active');
    }

    // Pagination
    const pag = qs('#pagination');
    const pagInfo = qs('#paginationInfo');
    const pagBtns = qs('#paginationBtns');
    if (pagination && pagination.pages > 1) {
      pag.style.display = 'flex';
      pagInfo.textContent = `Page ${pagination.page} of ${pagination.pages} (${pagination.total || '?'} projects)`;
      pagBtns.innerHTML = '';
      for (let i = 1; i <= pagination.pages; i++) {
        const btn = document.createElement('button');
        btn.className = `pl-pag-btn ${i === pagination.page ? 'active' : ''}`;
        btn.textContent = i;
        btn.addEventListener('click', () => { currentPage = i; loadProjects(i); });
        pagBtns.appendChild(btn);
      }
    } else {
      pag.style.display = 'none';
    }
  }

  // Filter clicks
  qsa('.pl-filter-pill[data-filter]').forEach(btn => {
    btn.addEventListener('click', function() {
      qsa('.pl-filter-pill[data-filter]').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      currentFilter = this.getAttribute('data-filter');
      currentPage = 1;
      loadProjects();
    });
  });

  qsa('.pl-filter-pill.service-filter').forEach(btn => {
    btn.addEventListener('click', function() {
      qsa('.pl-filter-pill.service-filter').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      currentServiceFilter = this.getAttribute('data-svc');
      currentPage = 1;
      loadProjects();
    });
  });

  qsa('.pl-filter-pill.health-filter').forEach(btn => {
    btn.addEventListener('click', function() {
      qsa('.pl-filter-pill.health-filter').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      currentHealthFilter = this.getAttribute('data-health');
      currentPage = 1;
      loadProjects();
    });
  });

  // View toggle
  qsa('.pl-view-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      qsa('.pl-view-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      currentView = this.getAttribute('data-view');
      if (currentView === 'table') {
        qs('#projectGrid').style.display = 'none';
        qs('#projectTableWrap').classList.add('active');
      } else {
        qs('#projectGrid').style.display = 'grid';
        qs('#projectTableWrap').classList.remove('active');
      }
    });
  });

  // Search
  let searchTimer;
  qs('#searchInput').addEventListener('input', function() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      currentSearch = this.value.trim();
      currentPage = 1;
      loadProjects();
    }, 400);
  });

  // ── Calendar ──
  const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const DOWS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  let projCalMonth = new Date(); projCalMonth.setDate(1);

  function fmtKey(d) {
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  }
  function sameDay(a, b) {
    return a.getFullYear()===b.getFullYear() && a.getMonth()===b.getMonth() && a.getDate()===b.getDate();
  }
  function escapeHtml(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  async function loadProjectCalendar() {
    const grid = qs('#projCalGrid');
    const monthLbl = qs('#projCalMonth');
    const capEl = qs('#projCalCapacity');
    if (!grid) return;
    const y = projCalMonth.getFullYear();
    const m = projCalMonth.getMonth();
    monthLbl.textContent = `${MONTHS[m]} ${y}`;
    grid.innerHTML = '<div class="text-center text-muted py-4"><div class="spinner-border text-primary"></div> Loading...</div>';
    capEl.innerHTML = '';

    let projects = [];
    try {
      const r = await fetch(`/api/schedule/projects?month=${y}-${String(m+1).padStart(2,'0')}`);
      if (r.ok) { const data = await r.json(); projects = data.projects || []; }
    } catch (e) {}

    const reservedByDate = {};
    projects.forEach(p => {
      const r = p.reservedByDate || {};
      Object.keys(r).forEach(k => { reservedByDate[k] = (reservedByDate[k]||0) + (r[k]||0); });
    });

    let capHtml = '';
    try {
      const cr = await fetch('/api/schedule/booking-policy');
      if (cr.ok) {
        const policy = await cr.json();
        const ad = await fetch('/api/schedule/available-dates?duration=60&mode=manual');
        let totalTech = null;
        if (ad.ok) { const adata = await ad.json(); totalTech = adata.totalTechnicians != null ? adata.totalTechnicians : null; }
        const maxReserved = Object.values(reservedByDate).reduce((a,b)=>Math.max(a,b), 0);
        const remaining = (totalTech != null) ? Math.max(0, totalTech - maxReserved) : null;
        capHtml = `Active commercial projects: <strong>${projects.length}</strong>` +
          (totalTech != null ? ` &middot; Company technicians: <strong>${totalTech}</strong>` : '') +
          ` &middot; Peak reserved: <strong>${maxReserved}</strong>` +
          (remaining != null ? ` &middot; Remaining: <span class="proj-cap-pill" style="background:${remaining>0?'#d1fae5;color:#065f46':'#fee2e2;color:#991b1b;'}">${remaining} tech${remaining!==1?'s':''} free</span>` : '');
      }
    } catch (e) {}
    capEl.innerHTML = capHtml;

    const first = new Date(y, m, 1);
    const startDow = first.getDay();
    const daysInMonth = new Date(y, m+1, 0).getDate();
    const today = new Date();
    let html = '<div class="proj-cal-grid">';
    html += '<div></div>';
    DOWS.forEach(d => { html += `<div class="proj-cal-dow">${d}</div>`; });
    for (let i=0; i<startDow+1; i++) html += '<div></div>';
    for (let d=1; d<=daysInMonth; d++) {
      const date = new Date(y, m, d);
      const dow = date.getDay();
      const isWeekend = (dow===0 || dow===6);
      const key = fmtKey(date);
      const reserved = reservedByDate[key] || 0;
      let cls = 'proj-cal-cell' + (isWeekend?' weekend':'') + (sameDay(date,today)?' today':'') + (reserved>0?' reserved':'');
      html += `<div class="${cls}"><div class="dnum">${d}</div>`;
      if (reserved>0) html += `<span class="restag">${reserved} tech${reserved!==1?'s':''}</span>`;
      html += '</div>';
    }
    html += '</div>';

    if (projects.length > 0) {
      projects.forEach(p => {
        const start = new Date(p.start);
        const end = new Date(p.end);
        const startStr = start.toLocaleDateString('en-PH', {month:'short', day:'numeric', year:'numeric'});
        const endStr = end.toLocaleDateString('en-PH', {month:'short', day:'numeric', year:'numeric'});
        const rowLabel = (p.name && p.name.length>16 ? p.name.substring(0,16)+'...' : p.name);
        const days = (p.preferredWorkingDays || []).map(d => d.substring(0,3)).join(', ') || 'Any';
        const wh = p.preferredWorkingHours || {};
        let shift = 'Not set';
        if (wh.start) {
          const [h] = wh.start.split(':').map(Number);
          shift = (h < 12 ? 'Morning' : 'Afternoon') + (wh.end ? ' (' + wh.start + '-' + wh.end + ')' : '');
        }
        html += `<div class='proj-row'>`;
        html += `<div class='proj-row-label' title='${String(p.name).replace(/'/g,'&apos;')}'>${escapeHtml(rowLabel)}</div>`;
        html += `<div class='proj-row-info'><span><i class='bi bi-calendar3 me-1'></i><strong>${startStr}</strong> - <strong>${endStr}</strong></span>`;
        html += `<span class='proj-info-pill'><i class='bi bi-calendar-week me-1'></i>${days}</span>`;
        html += `<span class='proj-info-pill'><i class='bi bi-clock me-1'></i>${shift}</span></div>`;
        html += `</div>`;
      });
    }
    grid.innerHTML = html;
  }

  qs('#projCalPrev')?.addEventListener('click', () => { projCalMonth.setMonth(projCalMonth.getMonth()-1); loadProjectCalendar(); });
  qs('#projCalNext')?.addEventListener('click', () => { projCalMonth.setMonth(projCalMonth.getMonth()+1); loadProjectCalendar(); });
  loadProjectCalendar();

  loadStats();
  loadProjects();
})();
</script>
