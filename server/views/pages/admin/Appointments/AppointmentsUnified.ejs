  var _qCurrentBookingId=null,_qSelectedTechId=null,_qRecommendedTechId=null,_qPage=1,_qEquipment=[],_qEquipmentCache=[],_qRescheduleBookingId=null,_qRecommendations={},_qBulkPlan=[];

