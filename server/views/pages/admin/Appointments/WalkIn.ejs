        <div class="ent-trust-badges">
          <span class="ent-trust-item"><i class="bi bi-check-circle-fill"></i> Multi-service support</span>
          <span class="ent-trust-divider"></span>
          <span class="ent-trust-item"><i class="bi bi-check-circle-fill"></i> Consent-based account linking</span>
          <span class="ent-trust-divider"></span>
          <span class="ent-trust-item"><i class="bi bi-check-circle-fill"></i> Smart scheduling</span>
        </div>
      </div>
