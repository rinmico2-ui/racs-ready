<div class="service-rating-report container-fluid px-0 py-4">
  <%- include('../../../partials/dashboard-styles') %>
  <style>
    .sr-card{background:#fff;border:1px solid #e5eaf1;border-radius:14px;box-shadow:0 3px 16px rgba(15,23,42,.045)}
    .sr-tabs{display:flex;gap:6px;padding:5px;background:#eef2f7;border-radius:10px;width:max-content}.sr-tabs a{padding:8px 13px;border-radius:7px;color:#64748b;font-size:.76rem;font-weight:700;text-decoration:none}.sr-tabs a.active{background:#fff;color:#1d4ed8;box-shadow:0 1px 4px rgba(15,23,42,.1)}
    .sr-filter{overflow:hidden}.sr-filter-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 18px;background:#f8fafc;border-bottom:1px solid #e5eaf1}.sr-filter-title{font-size:.82rem;font-weight:800;color:#1e293b}.sr-filter-subtitle{font-size:.68rem;color:#64748b;margin-top:2px}.sr-filter-count{font-size:.65rem;font-weight:800;color:#1d4ed8;background:#dbeafe;border-radius:999px;padding:5px 9px}.sr-filter-body{padding:16px 18px}.sr-filter-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.sr-field{display:flex;flex-direction:column;gap:5px;min-width:0}.sr-field label{font-size:.62rem;font-weight:800;color:#64748b;text-transform:uppercase;letter-spacing:.055em}.sr-field input,.sr-field select{height:38px;width:100%;border:1px solid #dbe3ee;border-radius:8px;background:#fff;color:#334155;padding:7px 10px;font-size:.76rem;outline:none}.sr-field input:focus,.sr-field select:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1)}.sr-search{grid-column:span 2}.sr-custom{display:flex;gap:8px;grid-column:span 2}.sr-custom .sr-field{flex:1}.sr-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:14px;padding-top:14px;border-top:1px solid #eef2f7}.sr-btn{border:0;border-radius:8px;padding:9px 13px;background:#2563eb;color:#fff;font-size:.75rem;font-weight:700;text-decoration:none}.sr-btn.light{background:#fff;color:#475569;border:1px solid #dbe3ee}.sr-btn:disabled{opacity:.55;cursor:not-allowed}
    .sr-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.sr-kpi{padding:17px 18px;position:relative;overflow:hidden}.sr-kpi:before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:var(--accent)}.sr-kpi-top{display:flex;justify-content:space-between;align-items:center}.sr-icon{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;color:var(--accent);background:color-mix(in srgb,var(--accent) 11%,white)}.sr-delta{font-size:.65rem;font-weight:800;border-radius:999px;padding:4px 7px}.sr-delta.up{color:#047857;background:#ecfdf5}.sr-delta.down{color:#b91c1c;background:#fef2f2}.sr-delta.flat{color:#64748b;background:#f1f5f9}.sr-label{font-size:.65rem;color:#64748b;font-weight:800;text-transform:uppercase;letter-spacing:.05em;margin-top:12px}.sr-value{font:700 1.52rem/1.2 Outfit,Inter,sans-serif;color:#0f172a;margin-top:3px}.sr-meta{font-size:.68rem;color:#94a3b8;margin-top:4px}
    .sr-section{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:26px 0 11px}.sr-section h2{font:800 .84rem Inter,sans-serif;color:#334155;text-transform:uppercase;letter-spacing:.065em;margin:0;border-left:4px solid #2563eb;padding-left:9px}.sr-section span{font-size:.68rem;color:#94a3b8}.sr-insights{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.sr-insight{display:flex;gap:10px;padding:14px}.sr-insight-icon{width:35px;height:35px;flex:none;border-radius:9px;display:grid;place-items:center;background:#eff6ff;color:#2563eb}.sr-insight.warning .sr-insight-icon{background:#fffbeb;color:#d97706}.sr-insight.danger .sr-insight-icon{background:#fef2f2;color:#dc2626}.sr-insight.success .sr-insight-icon{background:#ecfdf5;color:#059669}.sr-insight h3{font-size:.75rem;font-weight:800;color:#1e293b;margin:1px 0 3px}.sr-insight p{font-size:.67rem;line-height:1.42;color:#64748b;margin:0}.sr-charts{display:grid;grid-template-columns:1fr 1.45fr 1.2fr;gap:14px}.sr-card-head{display:flex;justify-content:space-between;align-items:center;padding:13px 16px;border-bottom:1px solid #eef2f7}.sr-card-head h3{font-size:.78rem;font-weight:800;color:#1e293b;margin:0}.sr-chart{height:270px;padding:15px}.sr-click{font-size:.62rem;color:#64748b;background:#f1f5f9;border-radius:999px;padding:4px 7px}
    .sr-quality{display:grid;grid-template-columns:1fr 1fr;gap:14px}.sr-table{width:100%;border-collapse:collapse;font-size:.74rem}.sr-table th{padding:9px 10px;border-bottom:1px solid #e2e8f0;color:#94a3b8;font-size:.61rem;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}.sr-table td{padding:10px;border-bottom:1px solid #f1f5f9;color:#475569;vertical-align:middle}.sr-table tbody tr:last-child td{border:0}.sr-stars{color:#f59e0b;white-space:nowrap}.sr-badge{display:inline-flex;align-items:center;border-radius:999px;padding:4px 7px;font-size:.61rem;font-weight:800;text-transform:capitalize;white-space:nowrap}.sr-badge.requires_attention{background:#fef2f2;color:#b91c1c}.sr-badge.monitor{background:#fffbeb;color:#a16207}.sr-badge.positive{background:#ecfdf5;color:#047857}.sr-source{background:#f1f5f9;color:#64748b}.sr-empty{text-align:center;padding:28px 12px!important;color:#94a3b8!important}.sr-comment{max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sr-pagination{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;border-top:1px solid #eef2f7}.sr-pages{display:flex;gap:4px;align-items:center}.sr-page{min-width:32px;height:32px;border:1px solid #dbe3ee;border-radius:7px;background:#fff;color:#475569;font-size:.7rem;font-weight:700}.sr-page.active{background:#2563eb;color:#fff;border-color:#2563eb}.sr-page:disabled{opacity:.45}.sr-loading{display:inline-flex;align-items:center;gap:8px}.sr-spinner{width:18px;height:18px;border:2px solid #dbeafe;border-top-color:#2563eb;border-radius:50%;animation:sr-spin .7s linear infinite}@keyframes sr-spin{to{transform:rotate(360deg)}}
    @media(max-width:1200px){.sr-filter-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.sr-kpis{grid-template-columns:repeat(2,1fr)}.sr-insights{grid-template-columns:repeat(2,1fr)}.sr-charts{grid-template-columns:1fr 1fr}.sr-charts>.sr-card:last-child{grid-column:span 2}.sr-quality{grid-template-columns:1fr}}
    @media(max-width:760px){.sr-filter-grid{grid-template-columns:1fr 1fr}.sr-search,.sr-custom{grid-column:span 2}.sr-charts{grid-template-columns:1fr}.sr-charts>.sr-card:last-child{grid-column:auto}.sr-pagination{align-items:flex-start;flex-direction:column}.sr-pages{flex-wrap:wrap}}
    @media(max-width:520px){.sr-filter-grid{grid-template-columns:1fr}.sr-search,.sr-custom{grid-column:auto}.sr-custom{flex-direction:column}.sr-kpis,.sr-insights{grid-template-columns:1fr}.sr-actions{flex-wrap:wrap}.sr-actions .sr-btn{flex:1;white-space:nowrap}}
  </style>

  <div class="au-hero mb-4"><div class="au-hero-inner"><div class="au-hero-left"><div class="au-hero-icon"><i class="bi bi-star-fill"></i></div><div><h1>Service Rating Intelligence</h1><p>Customer satisfaction, service quality, and recovery priorities</p></div></div><div class="au-hero-actions"><button class="btn btn-outline-light btn-sm" id="exportRatings"><i class="bi bi-download me-1"></i> Export CSV</button><button class="btn btn-light btn-sm" id="refreshRatings"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</button></div></div></div>
  <nav class="sr-tabs mb-4" aria-label="Customer rating reports"><a class="active" href="/admin/ratings/service"><i class="bi bi-wrench-adjustable me-1"></i> Services</a><a href="/admin/ratings/aircons"><i class="bi bi-snow2 me-1"></i> Products</a></nav>

  <form class="sr-card sr-filter mb-4" id="ratingFilters">
    <div class="sr-filter-head"><div><div class="sr-filter-title"><i class="bi bi-sliders2 me-2 text-primary"></i>Report controls</div><div class="sr-filter-subtitle">Every KPI, chart, ranking, table row, and export follows these filters.</div></div><span class="sr-filter-count" id="activeFilterCount" hidden></span></div>
    <div class="sr-filter-body"><div class="sr-filter-grid">
      <div class="sr-field"><label for="ratingRange">Reporting window</label><select name="range" id="ratingRange"><option value="today">Today</option><option value="7">Last 7 days</option><option value="30" selected>Last 30 days</option><option value="mtd">Month to date</option><option value="qtd">Quarter to date</option><option value="ytd">Year to date</option><option value="90">Last 90 days</option><option value="365">Last 12 months</option><option value="all">All time</option><option value="custom">Custom range</option></select></div>
      <div class="sr-field sr-search"><label for="ratingSearch">Search reviews</label><input id="ratingSearch" name="q" maxlength="80" placeholder="Reference, customer, service, technician, or comment"></div>
      <div class="sr-field"><label for="ratingScore">Rating</label><select id="ratingScore" name="rating"><option value="">All ratings</option><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option></select></div>
      <div class="sr-custom" id="customRatingDates" hidden><div class="sr-field"><label for="ratingFrom">From</label><input id="ratingFrom" name="from" type="date"></div><div class="sr-field"><label for="ratingTo">To</label><input id="ratingTo" name="to" type="date"></div></div>
      <div class="sr-field"><label for="serviceClass">Service class</label><select id="serviceClass" name="serviceClass"><option value="">All classes</option><option value="core">Core service</option><option value="repair">Repair</option><option value="mixed">Mixed booking</option><option value="unknown">Unlinked / unknown</option></select></div>
      <div class="sr-field"><label for="serviceName">Service</label><select id="serviceName" name="service"><option value="">All services</option></select></div>
      <div class="sr-field"><label for="ratingTechnician">Technician</label><select id="ratingTechnician" name="technician"><option value="">All technicians</option><option value="unassigned">Unassigned</option></select></div>
      <div class="sr-field"><label for="attentionFilter">Quality status</label><select id="attentionFilter" name="attention"><option value="">All quality statuses</option><option value="requires_attention">Requires attention (1–2)</option><option value="monitor">Monitor (3)</option><option value="positive">Positive (4–5)</option></select></div>
      <div class="sr-field"><label for="commentFilter">Written feedback</label><select id="commentFilter" name="comment"><option value="">With or without comment</option><option value="with_comment">With comment</option><option value="without_comment">Without comment</option></select></div>
      <div class="sr-field"><label for="ratingSort">Sort</label><select id="ratingSort" name="sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="highest">Highest rating</option><option value="lowest">Lowest rating</option></select></div>
      <div class="sr-field"><label for="ratingPageSize">Rows per page</label><select id="ratingPageSize" name="perPage"><option value="10">10 rows</option><option value="25" selected>25 rows</option><option value="50">50 rows</option><option value="100">100 rows</option></select></div>
    </div><div class="sr-actions"><button class="sr-btn light" type="button" id="resetRatingFilters"><i class="bi bi-x-circle me-1"></i> Reset</button><button class="sr-btn" type="submit"><i class="bi bi-funnel me-1"></i> Apply filters</button></div></div>
  </form>

  <div class="sr-kpis" id="ratingKpis">
    <article class="sr-card sr-kpi" style="--accent:#2563eb"><div class="sr-kpi-top"><span class="sr-icon"><i class="bi bi-star-fill"></i></span><span class="sr-delta flat" id="overallDelta">—</span></div><div class="sr-label">Average rating</div><div class="sr-value" id="overallRating">—</div><div class="sr-meta">Out of 5.00 stars</div></article>
    <article class="sr-card sr-kpi" style="--accent:#059669"><div class="sr-kpi-top"><span class="sr-icon"><i class="bi bi-emoji-smile"></i></span><span class="sr-delta flat" id="satisfactionDelta">—</span></div><div class="sr-label">Satisfaction rate</div><div class="sr-value" id="satisfactionRate">—</div><div class="sr-meta">Reviews rated 4 or 5 stars</div></article>
    <article class="sr-card sr-kpi" style="--accent:#d97706"><div class="sr-kpi-top"><span class="sr-icon"><i class="bi bi-trophy"></i></span><span class="sr-delta flat" id="fiveStarDelta">—</span></div><div class="sr-label">Five-star reviews</div><div class="sr-value" id="fiveStarCount">—</div><div class="sr-meta" id="fiveStarMeta">Share of selected reviews</div></article>
    <article class="sr-card sr-kpi" style="--accent:#7c3aed"><div class="sr-kpi-top"><span class="sr-icon"><i class="bi bi-chat-square-text"></i></span><span class="sr-delta flat" id="totalDelta">—</span></div><div class="sr-label">Reviews received</div><div class="sr-value" id="totalReviews">—</div><div class="sr-meta" id="commentCoverage">Written feedback coverage</div></article>
  </div>

  <div class="sr-section"><h2>Management insights</h2><span>Compared with the immediately preceding period</span></div><div class="sr-insights" id="ratingInsights"><article class="sr-card sr-insight"><div class="sr-insight-icon"><span class="sr-spinner"></span></div><div><h3>Loading insights</h3><p>Analyzing the selected reviews.</p></div></article></div>
  <div class="sr-section"><h2>Quality trends</h2><span>Click chart elements to filter the report</span></div><div class="sr-charts"><article class="sr-card"><div class="sr-card-head"><h3>Rating distribution</h3><span class="sr-click">Click a rating</span></div><div class="sr-chart"><canvas id="ratingDistribution"></canvas></div></article><article class="sr-card"><div class="sr-card-head"><h3>Rating and review volume</h3><span class="sr-click">Click a period</span></div><div class="sr-chart"><canvas id="ratingTrend"></canvas></div></article><article class="sr-card"><div class="sr-card-head"><h3>Service performance</h3><span class="sr-click">Click a service</span></div><div class="sr-chart"><canvas id="servicePerformance"></canvas></div></article></div>
  <div class="sr-section"><h2>Quality accountability</h2><span>Sample size is shown with each score</span></div><div class="sr-quality"><article class="sr-card"><div class="sr-card-head"><h3>Service quality</h3><span class="sr-click">Selected period</span></div><div class="table-responsive"><table class="sr-table"><thead><tr><th>Service</th><th class="text-center">Reviews</th><th class="text-center">Low</th><th class="text-end">Average</th></tr></thead><tbody id="serviceQualityRows"></tbody></table></div></article><article class="sr-card"><div class="sr-card-head"><h3>Technician quality</h3><span class="sr-click">Assigned reviews</span></div><div class="table-responsive"><table class="sr-table"><thead><tr><th>Technician</th><th class="text-center">Reviews</th><th class="text-center">Low</th><th class="text-end">Average</th></tr></thead><tbody id="technicianQualityRows"></tbody></table></div></article></div>
  <div class="sr-section"><h2>Review detail</h2><span id="resultCount">Loading reviews…</span></div><article class="sr-card"><div class="table-responsive"><table class="sr-table"><thead><tr><th>Date</th><th>Reference / Customer</th><th>Service</th><th>Technician</th><th>Rating</th><th>Comment</th><th>Quality status</th><th>Source</th><th></th></tr></thead><tbody id="serviceRatingsTable"><tr><td colspan="9" class="sr-empty"><span class="sr-loading"><span class="sr-spinner"></span> Loading service reviews…</span></td></tr></tbody></table></div><div class="sr-pagination"><span class="sr-meta" id="paginationSummary"></span><div class="sr-pages" id="ratingPagination"></div></div></article>
</div>

<div class="modal fade" id="ratingModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0"><div class="modal-header"><div><h5 class="modal-title">Service review detail</h5><div class="small text-muted" id="ratingModalReference"></div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body" id="ratingModalBody"></div><div class="modal-footer"><button type="button" class="btn btn-light border" data-bs-dismiss="modal">Close</button></div></div></div></div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(() => {
  const form=document.getElementById('ratingFilters');
  const range=document.getElementById('ratingRange');
  const customDates=document.getElementById('customRatingDates');
  const customInputs=[document.getElementById('ratingFrom'),document.getElementById('ratingTo')];
  const serviceSelect=document.getElementById('serviceName');
  const technicianSelect=document.getElementById('ratingTechnician');
  let currentPage=1,latestData=null,charts={};
  const requested=new URLSearchParams(window.location.search);
  const esc=value=>String(value??'').replace(/[&<>'"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
  const nice=value=>String(value||'').replaceAll('_',' ').replace(/\b\w/g,char=>char.toUpperCase());
  const dateLabel=value=>{const date=new Date(value);return Number.isNaN(date.getTime())?'—':date.toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'});};
  const stars=score=>Array.from({length:5},(_,index)=>`<i class="bi ${index<Math.round(score)?'bi-star-fill':'bi-star'}"></i>`).join('');
  function syncCustomDates(){const custom=range.value==='custom';customDates.hidden=!custom;customInputs.forEach(input=>{input.disabled=!custom;input.required=custom;});}
  function hydrateStaticFilters(){for(const [key,value] of requested){const field=form.elements.namedItem(key);if(!field)continue;if(field.tagName==='SELECT'&&![...field.options].some(option=>option.value===value)&&['service','technician'].includes(key))field.add(new Option(value,value));if(field.tagName!=='SELECT'||[...field.options].some(option=>option.value===value))field.value=value;}currentPage=Math.max(1,Number(requested.get('page'))||1);syncCustomDates();}
  function paramsFor(page=currentPage){const params=new URLSearchParams(new FormData(form));params.set('page',String(page));for(const [key,value] of [...params])if(value==='')params.delete(key);return params;}
  function populateSelect(select,items,placeholder,selected){select.innerHTML=`<option value="">${esc(placeholder)}</option>`+(select===technicianSelect?'<option value="unassigned">Unassigned</option>':'')+items.map(item=>`<option value="${esc(item.id??item)}">${esc(item.name??item)}</option>`).join('');select.value=selected||'';}
  async function loadRatings(options={}){if(!options.preservePage)currentPage=1;showLoading();const params=paramsFor(currentPage);try{const response=await fetch('/api/admin/ratings/service?'+params.toString(),{credentials:'same-origin',headers:{Accept:'application/json'}});if(response.status===401)throw new Error('Your admin session has expired. Sign in again and retry.');const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Unable to load service ratings.');latestData=data;currentPage=data.pagination.page;populateSelect(serviceSelect,data.filterOptions.services,'All services',data.filters.service);populateSelect(technicianSelect,data.filterOptions.technicians,'All technicians',data.filters.technician);render(data);const publicParams=paramsFor(currentPage);history.replaceState(null,'',window.location.pathname+(publicParams.toString()?'?'+publicParams.toString():''));}catch(error){showError(error.message);}}
  function showLoading(){document.getElementById('serviceRatingsTable').innerHTML='<tr><td colspan="9" class="sr-empty"><span class="sr-loading"><span class="sr-spinner"></span> Loading service reviews…</span></td></tr>';document.getElementById('resultCount').textContent='Loading reviews…';}
  function showError(message){document.getElementById('serviceRatingsTable').innerHTML=`<tr><td colspan="9" class="sr-empty text-danger"><i class="bi bi-exclamation-triangle me-2"></i>${esc(message)}</td></tr>`;document.getElementById('resultCount').textContent='Report unavailable';}
  function setDelta(id,value,suffix,precision=1){const element=document.getElementById(id),numeric=Number(value)||0;element.className='sr-delta '+(numeric>0?'up':numeric<0?'down':'flat');element.innerHTML=`<i class="bi ${numeric>0?'bi-arrow-up':numeric<0?'bi-arrow-down':'bi-dash'}"></i> ${Math.abs(numeric).toFixed(precision)}${suffix}`;}
  function render(data){const stats=data.analytics.stats;document.getElementById('overallRating').textContent=stats.overallRating.toFixed(2);document.getElementById('satisfactionRate').textContent=stats.satisfactionRate.toFixed(1)+'%';document.getElementById('fiveStarCount').textContent=stats.fiveStarCount.toLocaleString();document.getElementById('totalReviews').textContent=stats.totalReviews.toLocaleString();document.getElementById('fiveStarMeta').textContent=stats.fiveStarRate.toFixed(1)+'% of selected reviews';document.getElementById('commentCoverage').textContent=stats.commentRate.toFixed(1)+'% include written feedback';if(data.analytics.comparisonAvailable){setDelta('overallDelta',data.analytics.changes.overallRating,' stars',2);setDelta('satisfactionDelta',data.analytics.changes.satisfactionRate,' pp');setDelta('fiveStarDelta',data.analytics.changes.fiveStarCount,'%');setDelta('totalDelta',data.analytics.changes.totalReviews,'%');}else{['overallDelta','satisfactionDelta','fiveStarDelta','totalDelta'].forEach(id=>{const el=document.getElementById(id);el.className='sr-delta flat';el.textContent='No baseline';});}const count=[data.filters.q,data.filters.rating,data.filters.service,data.filters.serviceClass,data.filters.technician,data.filters.comment,data.filters.attention].filter(value=>value!==''&&value!==null).length,countBadge=document.getElementById('activeFilterCount');countBadge.hidden=!count;countBadge.textContent=count+' active filter'+(count===1?'':'s');renderInsights(data.analytics.insights);renderCharts(data.analytics);renderQuality('serviceQualityRows',data.analytics.services,'No service ratings in this period.');renderQuality('technicianQualityRows',data.analytics.technicians,'No technician-assigned ratings in this period.');renderRows(data.ratings);renderPagination(data.pagination);}
  function renderInsights(insights){document.getElementById('ratingInsights').innerHTML=(insights||[]).map(item=>`<article class="sr-card sr-insight ${esc(item.tone)}"><div class="sr-insight-icon"><i class="bi ${esc(item.icon)}"></i></div><div><h3>${esc(item.title)}</h3><p>${esc(item.text)}</p></div></article>`).join('');}
  function pointer(event,elements){if(event.native&&event.native.target)event.native.target.style.cursor=elements.length?'pointer':'default';}
  function renderCharts(analytics){Object.values(charts).forEach(chart=>chart&&chart.destroy());charts={};Chart.defaults.font.family='Inter, sans-serif';Chart.defaults.color='#64748b';const starKeys=['5','4','3','2','1'];charts.distribution=new Chart(document.getElementById('ratingDistribution'),{type:'doughnut',data:{labels:starKeys.map(key=>key+' Stars'),datasets:[{data:starKeys.map(key=>analytics.starBreakdown[key]||0),backgroundColor:['#059669','#2563eb','#f59e0b','#f97316','#dc2626'],borderColor:'#fff',borderWidth:3}]},options:{responsive:true,maintainAspectRatio:false,cutout:'66%',onHover:pointer,onClick:(_event,elements)=>{if(!elements.length)return;document.getElementById('ratingScore').value=starKeys[elements[0].index];loadRatings();},plugins:{legend:{position:'bottom',labels:{usePointStyle:true,boxWidth:7,font:{size:10}}}}}});const trend=analytics.trend||[];charts.trend=new Chart(document.getElementById('ratingTrend'),{type:'line',data:{labels:trend.map(row=>row.label),datasets:[{label:'Average rating',data:trend.map(row=>row.rating),borderColor:'#2563eb',backgroundColor:'rgba(37,99,235,.08)',fill:true,tension:.3,yAxisID:'y'},{label:'Review volume',data:trend.map(row=>row.count),borderColor:'#8b5cf6',backgroundColor:'#8b5cf6',tension:.25,yAxisID:'r'}]},options:{responsive:true,maintainAspectRatio:false,onHover:pointer,onClick:(_event,elements)=>{if(!elements.length)return;const row=trend[elements[0].index];range.value='custom';document.getElementById('ratingFrom').value=row.start;document.getElementById('ratingTo').value=row.end;syncCustomDates();loadRatings();},plugins:{legend:{position:'bottom',labels:{usePointStyle:true,boxWidth:7,font:{size:10}}}},scales:{x:{grid:{display:false},ticks:{font:{size:9}}},y:{min:0,max:5,grid:{color:'#f1f5f9'},ticks:{stepSize:1}},r:{position:'right',beginAtZero:true,grid:{display:false},ticks:{precision:0}}}}});const services=(analytics.services||[]).slice(0,10);charts.services=new Chart(document.getElementById('servicePerformance'),{type:'bar',data:{labels:services.map(row=>row.name),datasets:[{label:'Average rating',data:services.map(row=>row.rating),backgroundColor:services.map(row=>row.rating<3?'#dc2626':row.rating<4?'#f59e0b':'#10b981'),borderRadius:5}]},options:{responsive:true,maintainAspectRatio:false,indexAxis:'y',onHover:pointer,onClick:(_event,elements)=>{if(!elements.length)return;serviceSelect.value=services[elements[0].index].id;loadRatings();},plugins:{legend:{display:false}},scales:{x:{min:0,max:5,grid:{color:'#f1f5f9'}},y:{grid:{display:false},ticks:{font:{size:9}}}}}});}
  function renderQuality(id,rows,empty){const target=document.getElementById(id);if(!rows.length){target.innerHTML=`<tr><td colspan="4" class="sr-empty">${esc(empty)}</td></tr>`;return;}target.innerHTML=rows.slice(0,10).map(row=>`<tr><td><strong>${esc(row.name)}</strong></td><td class="text-center">${Number(row.count).toLocaleString()}</td><td class="text-center"><span class="sr-badge ${row.lowRatings?'requires_attention':'positive'}">${Number(row.lowRatings)}</span></td><td class="text-end"><span class="sr-stars"><i class="bi bi-star-fill"></i></span> <strong>${Number(row.rating).toFixed(2)}</strong></td></tr>`).join('');}
  function renderRows(rows){const target=document.getElementById('serviceRatingsTable');if(!rows.length){target.innerHTML='<tr><td colspan="9" class="sr-empty"><i class="bi bi-chat-square-text d-block fs-3 mb-2"></i>No reviews match the selected filters.</td></tr>';return;}target.innerHTML=rows.map((row,index)=>`<tr><td class="text-nowrap">${esc(dateLabel(row.date))}</td><td><strong>${esc(row.reference)}</strong><div class="sr-meta">${esc(row.customer)}${row.email?' · '+esc(row.email):''}</div></td><td><strong>${esc(row.serviceName)}</strong><div class="sr-meta">${esc(nice(row.serviceType))}</div></td><td>${esc(row.technician)}</td><td><span class="sr-stars">${stars(row.rating)}</span><div class="sr-meta">${Number(row.rating).toFixed(1)} / 5</div></td><td><div class="sr-comment" title="${esc(row.comment)}">${esc(row.comment||'No written feedback')}</div></td><td><span class="sr-badge ${esc(row.attention)}">${esc(nice(row.attention))}</span></td><td><span class="sr-badge sr-source" title="Normalized ratings are canonical; legacy ratings are booking snapshots.">${esc(nice(row.source))}</span></td><td><button class="btn btn-sm btn-outline-primary sr-view" type="button" data-index="${index}" aria-label="View review"><i class="bi bi-eye"></i></button></td></tr>`).join('');}
  function renderPagination(pagination){const start=pagination.totalRows?(pagination.page-1)*pagination.perPage+1:0,end=Math.min(pagination.totalRows,pagination.page*pagination.perPage);document.getElementById('resultCount').textContent=`Showing ${start.toLocaleString()}–${end.toLocaleString()} of ${pagination.totalRows.toLocaleString()} reviews`;document.getElementById('paginationSummary').textContent=`Page ${pagination.page.toLocaleString()} of ${pagination.totalPages.toLocaleString()}`;const pages=new Set([1,pagination.totalPages,pagination.page-2,pagination.page-1,pagination.page,pagination.page+1,pagination.page+2]),valid=[...pages].filter(page=>page>=1&&page<=pagination.totalPages).sort((a,b)=>a-b);let previous=0,html=`<button class="sr-page" data-page="${pagination.page-1}" ${pagination.page===1?'disabled':''} aria-label="Previous page"><i class="bi bi-chevron-left"></i></button>`;valid.forEach(page=>{if(previous&&page-previous>1)html+='<span class="px-1 text-muted">…</span>';html+=`<button class="sr-page ${page===pagination.page?'active':''}" data-page="${page}">${page}</button>`;previous=page;});html+=`<button class="sr-page" data-page="${pagination.page+1}" ${pagination.page===pagination.totalPages?'disabled':''} aria-label="Next page"><i class="bi bi-chevron-right"></i></button>`;document.getElementById('ratingPagination').innerHTML=html;}
  function openDetail(index){const row=latestData?.ratings?.[index];if(!row)return;document.getElementById('ratingModalReference').textContent=row.reference+' · '+dateLabel(row.date);document.getElementById('ratingModalBody').innerHTML=`<div class="row g-4"><div class="col-md-6"><div class="sr-label mb-2">Customer</div><h6>${esc(row.customer)}</h6><div class="text-muted small">${esc(row.email||'No email recorded')}</div></div><div class="col-md-6"><div class="sr-label mb-2">Service delivery</div><h6>${esc(row.serviceName)}</h6><div class="text-muted small">${esc(row.technician)} · ${esc(nice(row.serviceType))}</div></div><div class="col-md-6"><div class="sr-label mb-2">Rating</div><div class="sr-stars fs-5">${stars(row.rating)}</div><div class="small text-muted mt-1">${Number(row.rating).toFixed(1)} out of 5 · ${esc(nice(row.attention))}</div></div><div class="col-md-6"><div class="sr-label mb-2">Record provenance</div><div><span class="sr-badge sr-source">${esc(nice(row.source))}</span></div><div class="text-muted small mt-2">${row.source==='normalized'?'Canonical rating record':'Legacy booking feedback snapshot'}</div></div><div class="col-12"><hr><div class="sr-label mb-2">Customer feedback</div><p class="mb-0" style="white-space:pre-wrap">${esc(row.comment||'No written feedback was provided.')}</p></div></div>`;bootstrap.Modal.getOrCreateInstance(document.getElementById('ratingModal')).show();}
  form.addEventListener('submit',event=>{event.preventDefault();loadRatings();});range.addEventListener('change',syncCustomDates);document.getElementById('refreshRatings').addEventListener('click',()=>loadRatings({preservePage:true}));document.getElementById('resetRatingFilters').addEventListener('click',()=>{form.reset();currentPage=1;syncCustomDates();loadRatings();});document.getElementById('exportRatings').addEventListener('click',()=>{const params=paramsFor(1);params.delete('page');params.delete('perPage');window.location.href='/api/admin/ratings/service/export?'+params.toString();});document.getElementById('ratingPagination').addEventListener('click',event=>{const button=event.target.closest('[data-page]');if(!button||button.disabled)return;currentPage=Number(button.dataset.page);loadRatings({preservePage:true});});document.getElementById('serviceRatingsTable').addEventListener('click',event=>{const button=event.target.closest('.sr-view');if(button)openDetail(Number(button.dataset.index));});hydrateStaticFilters();loadRatings({preservePage:true});
})();
</script>
