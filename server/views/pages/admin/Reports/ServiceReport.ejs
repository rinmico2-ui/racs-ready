    </div>
    <div class="dash-card-body">
      <% if (analytics && analytics.topTechnicians && analytics.topTechnicians.length > 0) { %>
        <div class="table-responsive">
          <table class="table-dash">
            <thead>
              <tr>
                <th style="width:50px;">Rank</th>
                <th>Technician</th>
                <th style="text-align:center;">Bookings</th>
                <th style="text-align:center;">Completed</th>
                <th style="text-align:center;">Cancelled</th>
                <th style="text-align:center;">Rate</th>
                <th style="text-align:center;">Rating</th>
                <th style="text-align:right;">Assigned Booked Value</th>
              </tr>
            </thead>
            <tbody>
              <% analytics.topTechnicians.forEach(function(tech, index) { %>
                <tr>
                  <td>
                    <% if (index === 0) { %><span style="color:#f59e0b;font-size:1rem;"><i class="bi bi-trophy-fill"></i></span>
                    <% } else if (index === 1) { %><span style="color:#94a3b8;font-size:1rem;"><i class="bi bi-trophy-fill"></i></span>
                    <% } else if (index === 2) { %><span style="color:#cd7f32;font-size:1rem;"><i class="bi bi-trophy-fill"></i></span>
                    <% } else { %><span class="kpi-enterprise-badge blue">#<%= index + 1 %></span><% } %>
                  </td>
                  <td style="font-weight:700;"><%= tech.name %></td>
                  <td style="text-align:center;"><%= tech.totalBookings %></td>
                  <td style="text-align:center;"><span class="badge-status success"><%= tech.completedBookings %></span></td>
                  <td style="text-align:center;"><span class="badge-status danger"><%= tech.cancelledBookings %></span></td>
                  <td style="text-align:center;">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                      <div class="pipeline-bar" style="width:50px;">
                        <div class="pipeline-bar-fill" data-completion="<%= (tech.completionRate * 100).toFixed(0) %>" style="background:#3b82f6;"></div>
                      </div>
                      <span style="font-size:0.75rem;font-weight:600;color:#475569;"><%= (tech.completionRate * 100).toFixed(0) %>%</span>
                    </div>
                  </td>
                  <td style="text-align:center;">
                    <% if (tech.avgRating > 0) { %>
                      <span class="badge-status warning"><i class="bi bi-star-fill me-1"></i><%= tech.avgRating.toFixed(1) %></span>
                    <% } else { %>
                      <span style="font-size:0.7rem;color:#94a3b8;">No ratings</span>
                    <% } %>
                  </td>
                  <td style="text-align:right;font-weight:700;color:#059669;">&#8369;<%= tech.revenue.toLocaleString() %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="dash-empty"><i class="bi bi-people" style="font-size:1.5rem;display:block;margin-bottom:8px;"></i>No technician performance data available</div>
      <% } %>
