<!-- Resolve Prep Issue Modal -->
<div class="modal fade" id="resolvePrepIssueModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:16px;border:none;box-shadow:0 20px 60px rgba(0,0,0,0.15);">
      <div class="modal-header" style="background:#fef3c7;border-bottom:1px solid #fcd34d;padding:16px 20px;">
        <div>
          <h6 class="modal-title fw-bold" style="color:#92400e;"><i class="bi bi-exclamation-triangle me-2"></i>Resolve Preparation Issue</h6>
          <small style="color:#a16207;" id="resolveIssueSub">Select how to resolve this missing item</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter:brightness(0) saturate(100%) invert(39%) sepia(49%) saturate(1000%) hue-rotate(346deg);"></button>
      </div>
      <div class="modal-body" style="padding:20px;">
        <!-- Item Info -->
        <div style="background:#f8fafc;border-radius:10px;padding:12px 16px;margin-bottom:16px;">
          <div style="font-size:0.85rem;font-weight:600;color:#1e293b;" id="resolveItemName">—</div>
          <div style="font-size:0.75rem;color:#64748b;margin-top:4px;" id="resolveItemDetails">—</div>
          <div style="font-size:0.75rem;color:#64748b;margin-top:2px;" id="resolveItemRequiredBy">—</div>
        </div>

        <!-- Resolution Options -->
        <div class="d-flex flex-column gap-2" id="resolveOptions">
          <button class="btn btn-outline-success text-start p-3" onclick="resolveIssue('assigned_from_stock')" style="border-radius:10px;border:1px solid #86efac;">
            <div style="font-weight:600;font-size:0.85rem;"><i class="bi bi-box-seam me-2"></i>Assign Available Equipment</div>
            <div style="font-size:0.72rem;color:#64748b;margin-top:2px;">Link an existing inventory item to the technician's kit</div>
          </button>
          <button class="btn btn-outline-primary text-start p-3" onclick="resolveIssue('procured')" style="border-radius:10px;border:1px solid #93c5fd;">
            <div style="font-weight:600;font-size:0.85rem;"><i class="bi bi-cart-plus me-2"></i>Add / Procure Item</div>
            <div style="font-size:0.72rem;color:#64748b;margin-top:2px;">Add to inventory first, then assign to kit</div>
          </button>
          <button class="btn btn-outline-secondary text-start p-3" onclick="resolveIssue('not_required')" style="border-radius:10px;border:1px solid #d1d5db;">
            <div style="font-weight:600;font-size:0.85rem;"><i class="bi bi-x-circle me-2"></i>Mark as Not Required</div>
            <div style="font-size:0.72rem;color:#64748b;margin-top:2px;">Item is not essential for this job</div>
          </button>
          <button class="btn btn-outline-warning text-start p-3" onclick="resolveIssue('rescheduled')" style="border-radius:10px;border:1px solid #fcd34d;">
            <div style="font-weight:600;font-size:0.85rem;"><i class="bi bi-calendar-x me-2"></i>Reschedule Job</div>
            <div style="font-size:0.72rem;color:#64748b;margin-top:2px;">Item is critical — reschedule until available</div>
          </button>
        </div>

        <!-- Equipment Search (hidden by default) -->
        <div id="resolveEquipSearch" style="display:none;margin-top:16px;">
          <label style="font-size:0.8rem;font-weight:600;color:#374151;">Search Available Equipment</label>
          <input type="text" class="form-control form-control-sm" id="resolveEquipInput" placeholder="Type to search..." style="border-radius:8px;margin-top:4px;" oninput="searchEquipForResolve()">
          <div id="resolveEquipResults" style="max-height:200px;overflow-y:auto;margin-top:8px;"></div>
        </div>

        <!-- Note (for not_required / rescheduled) -->
        <div id="resolveNoteWrap" style="display:none;margin-top:12px;">
          <label style="font-size:0.8rem;font-weight:600;color:#374151;">Note (optional)</label>
          <textarea class="form-control form-control-sm" id="resolveNote" rows="2" placeholder="Why is this not required? Or details about reschedule..." style="border-radius:8px;margin-top:4px;"></textarea>
        </div>
      </div>
      <div class="modal-footer" style="border-top:1px solid #f1f5f9;padding:12px 20px;">
        <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal" style="border-radius:8px;">Cancel</button>
        <button type="button" class="btn btn-sm btn-success fw-semibold" id="resolveConfirmBtn" onclick="confirmResolveIssue()" style="border-radius:8px;display:none;">
          <i class="bi bi-check-lg me-1"></i>Confirm Resolution
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  let _currentIssue = null;
  let _selectedToolId = null;
  let _selectedResolution = null;

  window.openResolveModal = function(issue) {
    _currentIssue = issue;
    _selectedToolId = null;
    _selectedResolution = null;
    document.getElementById('resolveItemName').textContent = issue.itemName;
    document.getElementById('resolveItemDetails').textContent = `Type: ${issue.category} | Qty: ${issue.quantity}`;
    const jobInfo = issue.bookings.map(b => `${b.reference} — ${b.service}`).join(', ');
    document.getElementById('resolveItemRequiredBy').textContent = `Required by: ${jobInfo}`;
    document.getElementById('resolveIssueSub').textContent = `Reported by ${issue.technicianName}`;
    document.getElementById('resolveEquipSearch').style.display = 'none';
    document.getElementById('resolveNoteWrap').style.display = 'none';
    document.getElementById('resolveConfirmBtn').style.display = 'none';
    document.getElementById('resolveOptions').style.display = '';
    new bootstrap.Modal(document.getElementById('resolvePrepIssueModal')).show();
  };

  window.resolveIssue = function(resolution) {
    _selectedResolution = resolution;
    _selectedToolId = null;
    document.getElementById('resolveConfirmBtn').style.display = '';
    document.getElementById('resolveOptions').style.display = 'none';

    if (resolution === 'assigned_from_stock') {
      document.getElementById('resolveEquipSearch').style.display = '';
      document.getElementById('resolveNoteWrap').style.display = 'none';
      document.getElementById('resolveEquipInput').value = _currentIssue.itemName;
      document.getElementById('resolveEquipInput').focus();
      searchEquipForResolve();
    } else if (resolution === 'procured') {
      window.location.href = '/admin/inventory/repair-parts?prefillName=' + encodeURIComponent(_currentIssue.itemName) + '&prefillType=' + encodeURIComponent(_currentIssue.category) + '&prefillQty=' + _currentIssue.quantity;
    } else {
      document.getElementById('resolveEquipSearch').style.display = 'none';
      document.getElementById('resolveNoteWrap').style.display = '';
      document.getElementById('resolveNote').focus();
    }
  };

  window.searchEquipForResolve = async function() {
    const q = document.getElementById('resolveEquipInput').value.trim();
    const resultsEl = document.getElementById('resolveEquipResults');
    if (!q) { resultsEl.innerHTML = ''; return; }
    try {
      const res = await fetch('/api/admin/daily-kit/available-equipment?q=' + encodeURIComponent(q));
      const data = await res.json();
      if (!data.items || data.items.length === 0) {
        resultsEl.innerHTML = '<div style="font-size:0.78rem;color:#64748b;padding:8px;">No matching equipment found</div>';
        return;
      }
      resultsEl.innerHTML = data.items.map(item => `
        <div class="p-2 mb-1" style="background:#f8fafc;border-radius:8px;border:1px solid #e2e8f0;cursor:pointer;" onclick="selectEquipForResolve('${item._id}', '${item.itemName}', ${item.quantity})">
          <div style="font-size:0.8rem;font-weight:600;color:#1e293b;">${item.itemName}</div>
          <div style="font-size:0.72rem;color:#64748b;">Qty: ${item.quantity} | Code: ${item.toolCode || '—'} | ${item.assetStatus || 'available'}</div>
        </div>
      `).join('');
    } catch (e) {
      resultsEl.innerHTML = '<div style="font-size:0.78rem;color:#dc2626;padding:8px;">Search failed</div>';
    }
  };

  window.selectEquipForResolve = function(toolId, name, qty) {
    _selectedToolId = toolId;
    document.getElementById('resolveEquipResults').innerHTML = `<div class="p-2" style="background:#d1fae5;border-radius:8px;border:1px solid #86efac;"><strong style="font-size:0.8rem;color:#065f46;">✓ Selected: ${name} (Qty: ${qty})</strong></div>`;
  };

  window.confirmResolveIssue = async function() {
    if (!_currentIssue || !_selectedResolution) return;
    const note = document.getElementById('resolveNote')?.value || '';
    if ((_selectedResolution === 'assigned_from_stock') && !_selectedToolId) {
      alert('Please select an equipment item from inventory');
      return;
    }
    const btn = document.getElementById('resolveConfirmBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Resolving...';
    try {
      const res = await fetch('/api/admin/daily-kit/resolve-item', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          kitId: _currentIssue.kitId,
          itemName: _currentIssue.itemName,
          resolution: _selectedResolution,
          note,
          toolId: _selectedToolId,
        }),
      });
      const data = await res.json();
      if (data.success) {
        bootstrap.Modal.getInstance(document.getElementById('resolvePrepIssueModal')).hide();
        loadPrepIssues();
      } else {
        alert(data.error || 'Failed to resolve issue');
      }
    } catch (e) {
      alert('Network error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Confirm Resolution';
    }
  };

  // Load preparation issues
  window.loadPrepIssues = async function() {
    const body = document.getElementById('prepIssuesBody');
    const badge = document.getElementById('prepIssuesBadge');
    if (!body) return;
    try {
      const res = await fetch('/api/admin/daily-kit/pending-issues');
      const data = await res.json();
      const issues = data.issues || [];
      badge.textContent = issues.length;
      badge.style.display = issues.length > 0 ? '' : 'none';
      if (issues.length === 0) {
        body.innerHTML = '<div class="dash-empty" style="color:#64748b;font-size:0.8rem;">No pending issues</div>';
        return;
      }
      body.innerHTML = issues.map(issue => {
        const jobRef = issue.bookings.map(b => b.reference).join(', ');
        const jobSvc = issue.bookings.map(b => b.service).join(', ');
        return `<div style="padding:10px;margin-bottom:8px;background:#fffbeb;border-radius:8px;border:1px solid #fcd34d;cursor:pointer;" onclick='openResolveModal(${JSON.stringify(issue).replace(/'/g, "&#39;")})'>
          <div style="display:flex;align-items:center;gap:6px;">
            <i class="bi bi-exclamation-triangle" style="color:#d97706;font-size:0.85rem;"></i>
            <strong style="font-size:0.8rem;color:#92400e;">${issue.itemName}</strong>
          </div>
          <div style="font-size:0.72rem;color:#92400e;margin-top:4px;">
            ${issue.category} | Qty: ${issue.quantity}
          </div>
          <div style="font-size:0.68rem;color:#a16207;margin-top:2px;">
            <i class="bi bi-person me-1"></i>${issue.technicianName} | <i class="bi bi-link-45deg me-1"></i>${jobRef}
          </div>
          <div style="font-size:0.65rem;color:#a16207;margin-top:2px;">${jobSvc}</div>
          <button class="btn btn-sm btn-warning mt-2 fw-semibold" style="font-size:0.72rem;padding:3px 10px;border-radius:6px;">
            <i class="bi bi-gear me-1"></i>Resolve
          </button>
        </div>`;
      }).join('');
    } catch (e) {
      body.innerHTML = '<div class="dash-empty" style="color:#dc2626;font-size:0.8rem;">Failed to load issues</div>';
    }
  };

  // Initial load
  loadPrepIssues();
  setInterval(loadPrepIssues, 30000);
})();
</script>
