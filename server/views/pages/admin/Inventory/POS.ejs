        <button onclick="toggleSalesHistory()" style="background:none;border:none;color:#fff;font-size:1.2rem;cursor:pointer;"><i class="bi bi-x-lg"></i></button>
      </div>
      <div style="padding:20px 24px;overflow-y:auto;max-height:calc(85vh - 80px);" id="historyList">
        <p class="text-muted text-center">Loading...</p>
      </div>
