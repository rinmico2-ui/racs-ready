      try { await api('/api/issues', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ projectId, workOrderId: woId, category, title, description: desc || title }) }); toast('Sent to admin'); overlay.remove(); }
      catch (e) { toast(e.message, 'error'); }
