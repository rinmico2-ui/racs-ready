    width: auto !important;
    margin: 0;
    padding: 0;
  }
  .pickup-panel .flatpickr-days { width: 100% !important; min-width: 0 !important; }
  .pickup-panel .flatpickr-rContainer {
    display: block;
    width: 100% !important;
    min-width: 0 !important;
    padding: 0.75rem;
    box-sizing: border-box;
