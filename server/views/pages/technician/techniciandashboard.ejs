      font-size: 0.9rem;
    }
    .td-active-detail {
      font-size: 0.78rem;
    }
    .td-active-actions {
      gap: 0.5rem;
    }
    .td-quick-actions {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    .td-qa-btn {
