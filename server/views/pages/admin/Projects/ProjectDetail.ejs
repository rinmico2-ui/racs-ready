  // Mark the project Ready: server validates the planning gate (team + schedule + work orders).
  window.markReady = async function(btn) {
    const p = window.__projectData;
    if (!p) return;
    // Client-side guard — buttons are disabled but double-check in case of stale state.
    const workOrders = window.__lastWorkOrders || [];
    const materials = window.__lastMaterials || [];
    const teamOk = (p.assignedTechnicians?.length || p.totalAssignedTechnicians || 0) > 0;
    // Team acceptance gate — all assigned technicians must accept
    const teamStatusArr = p.teamStatus || [];
    const allAssignedTechs = p.assignedTechnicians || [];
    const allTeamAccepted = !teamOk || allAssignedTechs.length === 0 || allAssignedTechs.every(t => {
      const ts = teamStatusArr.find(s => s._id && s._id.toString() === (t._id || '').toString());
      return ts && ts.status === 'acknowledged';
    });
    const matOk = (materials.length || 0) > 0;
    const schedOk = workOrders.length > 0 && workOrders.every(wo => wo.scheduledDate);
    const woOk = workOrders.length > 0;
    let covered = 0, total = 0, unassignedWos = 0;
    workOrders.forEach(wo => {
      total += (wo.unitCount || 0);
      const techs = (wo.assignedTechnicians || []).filter(t => t && (t._id || t.id));
      if (techs.length === 0) { unassignedWos++; return; }
      const wc = techs.reduce((s, t) => s + (t.assignedUnits || 0), 0);
      covered += wc > 0 ? wc : (wo.unitCount || 0);
    });
    const coverOk = workOrders.length > 0 && unassignedWos === 0 && covered >= total;
    if (!allTeamAccepted) {
      toast('All team members must accept the assignment before marking the project ready', 'error');
      return;
    }
    if (!teamOk || !matOk || !schedOk || !woOk || !coverOk) {
      toast('Complete all planning steps before marking the project ready', 'error');
      return;
    }
    if (!confirm('Mark this project as ready? Technicians will receive their work order assignments.')) return;
    const action = async () => {
      try {
        const r = await fetch(`/api/projects/${projectId}/status`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: 'ready' }),
        });
        if (r.ok) { toast('Project marked ready — technicians will receive assignments'); loadProject(); }
        else {
          const e = await r.json().catch(() => ({}));
          toast(e.error || 'Cannot mark ready yet', 'error');
        }
      } catch(e) { toast('Failed to update status', 'error'); }
    };
    if (btn) await withBtnLoading(btn, 'Saving…', action);
    else await action();
  };

