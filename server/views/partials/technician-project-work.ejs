    return `
      <div class="pw-d-section">
        <h6><i class="bi bi-info-circle"></i> Your Role</h6>
        <div class="pw-d-list">
          <div class="row"><i class="bi bi-person-check"></i><span class="muted">You are a team member — follow the lead's mobilization.</span></div>
          <div class="row"><i class="bi bi-box-seam"></i><span class="muted">Request materials anytime from the action bar below.</span></div>
