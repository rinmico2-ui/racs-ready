  window.pwOpenSubmitUnits = function (pid, trigger) {
    const assignment = PW_ASSIGNMENTS.find(x => String(x.project?._id) === String(pid))
      || (window.__pwData || []).find(x => String(x.project?._id) === String(pid));
    if (!assignment) return toast('Project data is still loading. Please try again.', 'error');

    const p = assignment.project || {};
    const serviceName = p.service?.name || assignment.serviceName || 'Commercial Service';
    const siteAddress = p.location?.address || p.customer?.address || (assignment.customer || {}).address || '';
    const overallDone = Number(assignment.projectUnits?.done || 0);
    const overallTotal = Number(assignment.projectUnits?.total || 0);
    const overallPct = overallTotal > 0 ? Math.round((overallDone / overallTotal) * 100) : 0;

    const executableStatuses = ['assigned', 'accepted', 'en_route', 'arrived', 'in_progress', 'partially_completed'];
    const availableOrders = (assignment.workOrderDetails || [])
      .filter(wo => Number(wo.remaining || 0) > 0
        && executableStatuses.includes(wo.status))
      .sort((a, b) => Number(b.isScheduledToday) - Number(a.isScheduledToday)
        || new Date(a.scheduledDate || 0) - new Date(b.scheduledDate || 0));
    if (!availableOrders.length) {
      return toast('No unfinished field-work units are available to submit.', 'warning');
    }
    const projectRemaining = availableOrders.reduce((sum, wo) => sum + Number(wo.remaining || 0), 0);

    const overlay = document.createElement('div');
    overlay.className = 'pw-modal-overlay';
    overlay.innerHTML = `
      <div class="pw-modal pw-submit-modal">
        <div class="pw-submit-header">
          <h5><i class="bi bi-check2-square" style="color:#22c55e;"></i>Submit Done Units</h5>
          <p>Enter the units physically completed now. Today’s target is only a planning goal. You may work ahead across available work orders, up to the project’s ${projectRemaining} actual unfinished units.</p>
        </div>
        <div class="pw-submit-summary">
          <div class="job">${esc(serviceName)} — ${esc(siteAddress)}</div>
          <div class="site"><i class="bi bi-geo-alt-fill" style="color:#64748b;flex-shrink:0;margin-top:2px;"></i>${esc(siteAddress)}</div>
          <div class="overall">
            <span class="overall-label">Overall progress</span>
            <span class="overall-value">${overallDone} / ${overallTotal} done</span>
          </div>
          <div class="pw-submit-progress"><div class="bar" style="width:${overallPct}%;"></div></div>
        </div>
        <div class="pw-submit-body">
          <div class="pw-submit-wo" style="border-color:#86efac;background:#f0fdf4;">
            <div class="pw-submit-wo-head">
              <div>
                <div class="pw-submit-wo-title">Total done now</div>
                <div class="pw-submit-wo-sub">Automatically applied to today’s batch first, then the next available work orders.</div>
              </div>
              <span class="pw-submit-wo-remaining">${projectRemaining} available</span>
            </div>
            <div class="pw-submit-input-wrap">
              <span class="pw-submit-label">Units completed</span>
              <div class="pw-submit-stepper">
                <button type="button" data-total-step="-1" aria-label="Decrease total">&minus;</button>
                <input id="pwProjectDoneUnits" type="number" inputmode="numeric" min="0" max="${projectRemaining}" value="0" aria-label="Total done units">
                <button type="button" data-total-step="1" aria-label="Increase total">+</button>
              </div>
            </div>
            <div style="margin-top:.25rem;font-size:.6rem;color:#64748b;text-align:right;">Maximum: ${projectRemaining} actual unfinished project unit${projectRemaining === 1 ? '' : 's'}</div>
          </div>
          ${availableOrders.map(wo => {
            const woDone = Number(wo.completedUnitCount || 0);
            const woTotal = Number(wo.unitCount || 0);
            const actualRemaining = Math.max(0, woTotal - woDone);
            const woPct = woTotal > 0 ? Math.round((woDone / woTotal) * 100) : 0;
            return `
            <div class="pw-submit-wo">
              <div class="pw-submit-wo-head">
                <div>
                  <div class="pw-submit-wo-title">${esc(wo.title || wo.section || 'Work Order')}</div>
                  <div class="pw-submit-wo-sub">${esc(wo.section || (wo.isScheduledToday ? 'Today’s scheduled work' : 'Available project work'))}</div>
                </div>
                <span class="pw-submit-wo-remaining">${actualRemaining} left</span>
              </div>
              <div class="pw-submit-wo-stats">
                <span>${wo.isScheduledToday ? `Today’s target <b>${Number(wo.todayTarget || 0)}</b>` : '<b style="color:#2563eb;">Working ahead</b>'}</span>
                <span>Completed <b>${woDone}</b> / ${woTotal}</span>
              </div>
              <div class="pw-submit-wo-progress"><div class="bar" style="width:${woPct}%;"></div></div>
              <div class="pw-submit-input-wrap">
                <span class="pw-submit-label">Allocated now</span>
                <div class="pw-submit-stepper">
                  <input class="pw-submit-units-input" type="number" min="0" max="${actualRemaining}" value="0" data-wo="${wo._id}" data-max="${actualRemaining}" aria-label="Allocated done units for ${esc(wo.title || 'work order')}" readonly>
                </div>
              </div>
              <div style="margin-top:.25rem;font-size:.6rem;color:#94a3b8;text-align:right;">${actualRemaining} actual unit${actualRemaining === 1 ? '' : 's'} remaining in this batch</div>
            </div>`;
          }).join('')}
        </div>
        <div class="pw-submit-note">
          <label for="pwDoneUnitsNote"><i class="bi bi-pencil-square" style="color:#22c55e;margin-right:.3rem;"></i>Work note <span style="font-weight:500;color:#94a3b8;">(optional)</span></label>
          <textarea id="pwDoneUnitsNote" rows="2" maxlength="1000" placeholder="Example: Units tested and cooling normally"></textarea>
        </div>
        <div id="pwDoneUnitsError" style="display:none;padding:.65rem 1.5rem;background:#fef2f2;border-top:1px solid #fecaca;font-size:.68rem;color:#dc2626;"></div>
        <div class="pw-submit-footer">
          <button class="pw-btn" type="button" data-action="cancel">Cancel</button>
          <button class="pw-btn success" type="button" data-action="submit"><i class="bi bi-send-check" style="margin-right:.35rem;"></i> Submit Done Units</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);
    overlay.addEventListener('click', event => { if (event.target === overlay) overlay.remove(); });
    overlay.querySelector('[data-action="cancel"]').addEventListener('click', () => overlay.remove());
    const totalInput = overlay.querySelector('#pwProjectDoneUnits');
    const allocateTotal = () => {
      let total = Number(totalInput.value || 0);
      if (!Number.isFinite(total)) total = 0;
      total = Math.max(0, Math.min(projectRemaining, Math.trunc(total)));
      totalInput.value = String(total);
      let left = total;
      overlay.querySelectorAll('.pw-submit-units-input').forEach(input => {
        const take = Math.min(left, Number(input.dataset.max || 0));
        input.value = String(take);
        left -= take;
      });
    };
    totalInput.addEventListener('input', allocateTotal);
    totalInput.addEventListener('blur', allocateTotal);
    overlay.querySelectorAll('[data-total-step]').forEach(button => {
      button.addEventListener('click', () => {
        totalInput.value = String(Number(totalInput.value || 0) + Number(button.dataset.totalStep));
        allocateTotal();
      });
    });
    totalInput.focus();

    overlay.querySelector('[data-action="submit"]').addEventListener('click', async event => {
      const submitButton = event.currentTarget;
      const errorBox = overlay.querySelector('#pwDoneUnitsError');
      const rows = Array.from(overlay.querySelectorAll('.pw-submit-units-input')).map(input => ({
        workOrderId: input.dataset.wo,
        units: Number(input.value),
        max: Number(input.dataset.max),
        input,
      }));
      const invalid = rows.find(row => !Number.isInteger(row.units) || row.units < 0 || row.units > row.max);
      if (invalid) {
        errorBox.textContent = `Enter a whole number from 0 to ${invalid.max}.`;
        errorBox.style.display = 'block';
        return;
      }
      const submissions = rows.filter(row => row.units > 0);
      if (!submissions.length) {
        errorBox.textContent = 'Enter at least one completed unit.';
        errorBox.style.display = 'block';
        return;
      }

      errorBox.style.display = 'none';
      submitButton.disabled = true;
      submitButton.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Submitting…';
      const notes = overlay.querySelector('#pwDoneUnitsNote').value.trim();
      try {
        for (const row of submissions) {
          await api(`/api/work-orders/${row.workOrderId}/submit-units`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ completedUnits: row.units, notes }),
          });
          // If a later work order fails, a retry must not resubmit rows that
          // the server has already accepted.
          row.input.value = '0';
          row.input.dataset.max = String(Math.max(0, row.max - row.units));
          row.input.max = row.input.dataset.max;
        }
        const total = submissions.reduce((sum, row) => sum + row.units, 0);
        overlay.remove();
        toast(`${total} done unit${total === 1 ? '' : 's'} submitted`);
        await window.__loadProjectWork();
      } catch (error) {
        totalInput.value = String(Array.from(overlay.querySelectorAll('.pw-submit-units-input'))
          .reduce((sum, input) => sum + Number(input.value || 0), 0));
        errorBox.textContent = `${error.message || 'Unable to submit units.'} Accepted rows were cleared; review the remaining values and try again.`;
        errorBox.style.display = 'block';
        submitButton.disabled = false;
        submitButton.innerHTML = '<i class="bi bi-send-check"></i> Submit Done Units';
      }
    });
  };

  window.pwSubmitReadyWorkOrders = async (pid) => {
    try {
      const assignment = (await api(API)).assignments.find(x => String(x.project._id) === String(pid));
      const ready = (assignment?.workOrderDetails || []).filter(wo => wo.status === 'awaiting_review');
      if (!ready.length) return toast('No work order is ready for lead review', 'warning');
      if (!confirm(`Review and submit ${ready.length} completed work order(s)?`)) return;
      for (const wo of ready) {
        await api(`/api/work-orders/${wo._id}/submit`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ notes: 'Reviewed and submitted by project lead' }),
        });
      }
      toast(`${ready.length} work order(s) submitted`);
      window.__loadProjectWork();
    } catch (e) { toast(e.message, 'error'); }
  };

  window.pwLeadSubmit = async (pid) => {
    try {
      const r = await api(`/api/projects/${pid}/payment-summary`);
      if (r.allDone) { await api(`/api/projects/${pid}/mobilize/end-day`, { method:'PUT' }); toast('All units done — finalize payment'); window.__loadProjectWork(); return; }
      const remaining = Math.max(0, r.totalUnits - r.completedUnits);
      const dailyQuota = r.crewSize * (r.unitsPerTechPerDay || 5);
      openSubmitModal({
        title: 'Submit Units Finished (Crew)',
        subtitleHtml: `${remaining} unit(s) remain on the project. Your crew's daily quota is <strong>${dailyQuota} unit(s)</strong> (${r.crewSize} tech × ${r.unitsPerTechPerDay || 5} units/day).`,
        max: remaining,
        suggest: Math.min(remaining, dailyQuota),
        onConfirm: async (units) => {
          // Record the crew's finished units across the active work orders.
          const a = (await api(API)).assignments.find(x => x.project._id.toString() === pid.toString());
          const wos = a?.workOrders || a?.myWorkOrders || [];
          const active = wos.filter(w => (w.unitCount||0) - (w.completedUnitCount||0) > 0);
          let left = units;
          for (const w of active) {
            if (left <= 0) break;
            const room = (w.unitCount||0) - (w.completedUnitCount||0);
            const take = Math.min(left, room);
            await api(`/api/work-orders/${w._id}/daily-complete`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ completedUnits: (w.completedUnitCount||0) + take, notes:'Submitted by lead' }) });
            left -= take;
          }
          const confirmEnd = window.confirm('End today\'s on-site work for the crew? Remaining units carry to the next working day.');
          if (confirmEnd) await api(`/api/projects/${pid}/mobilize/end-day`, { method:'PUT' });
          toast(confirmEnd ? 'Units submitted — day ended' : 'Units submitted for today');
          window.__loadProjectWork();
        },
      });
    } catch (e) { toast(e.message, 'error'); }
  };

  // Member submits finished units (updates their own daily assignment).
  window.pwMemberSubmit = async (pid) => {
    try {
      const a = (await api(API)).assignments.find(x => x.project._id.toString() === pid.toString());
      const myWos = a?.myWorkOrders || [];
      if (!myWos.length) { toast('No assignment for you today', 'error'); return; }
      const lines = [];
      for (const w of myWos) {
        const plan = await api(`/api/work-orders/${w._id}/daily-plan`).catch(()=>({ today:null }));
        const remaining = (w.unitCount||0) - (w.completedUnitCount||0);
        const todayDone = plan.today ? (plan.today.completedUnits||0) : 0;
        const myTarget = plan.today ? (plan.today.assignedUnits || plan.today.targetUnits||0) : 0;
        lines.push({ woId: w._id, section: w.section || w.title || 'Assignment', target: myTarget, remaining, todayDone });
      }
      const totalTarget = lines.reduce((s, l) => s + l.target, 0);
      const totalRemaining = lines.reduce((s, l) => s + l.remaining, 0);
      openSubmitModal({
        title: 'Submit Units Finished',
        subtitleHtml: `Your daily target is <strong>${totalTarget} unit(s)</strong>. ${totalRemaining} unit(s) remain across your assignments.`,
        multi: lines,
        onConfirm: async (perWo) => {
          for (const item of lines) {
            const units = perWo[item.woId] || 0;
            if (units > 0) {
              // daily-complete wants the day's absolute completed count.
              const dayTotal = Math.min(item.todayDone + units, item.target || item.todayDone + units);
              await api(`/api/work-orders/${item.woId}/daily-complete`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ completedUnits: dayTotal, notes:'Submitted by technician' }) });
            }
          }
          toast('Units submitted for today'); window.__loadProjectWork();
        },
      });
    } catch (e) { toast(e.message, 'error'); }
  };

  // Shared "submit units" modal builder.
  function openSubmitModal(opts) {
    const overlay = document.createElement('div'); overlay.className = 'pw-modal-overlay';
    let body;
    if (opts.multi) {
      const rows = opts.multi.map((l, i) => `
        <div class="sm-wo-row">
          <div class="sm-wo-head">
            <div class="sm-wo-name">${esc(l.section)}</div>
            <div class="sm-wo-pill"><i class="bi bi-bullseye"></i> Target: ${l.target}</div>
          </div>
          <div class="sm-wo-stats">
            <span class="sm-wo-stat"><span class="k">Remaining</span><span class="v">${l.remaining}</span></span>
          </div>
          <div class="sm-stepper">
            <button type="button" class="sm-step-btn sm-step-minus" data-idx="${i}" data-dir="-1"><i class="bi bi-dash-lg"></i></button>
            <input type="number" min="0" max="${l.remaining}" value="0" class="sm-unit-input pw-unit-input" data-wo="${l.woId}" data-idx="${i}" data-max="${l.remaining}">
            <button type="button" class="sm-step-btn sm-step-plus" data-idx="${i}" data-dir="1"><i class="bi bi-plus-lg"></i></button>
          </div>
        </div>`).join('');
      body = `<div class="sm-wo-list">${rows}</div>`;
    } else {
      body = `
        <div class="sm-big-input">
          <button type="button" class="sm-step-btn sm-step-minus" id="smMainMinus"><i class="bi bi-dash-lg"></i></button>
          <div class="sm-big-num-wrap">
            <input type="number" min="0" max="${opts.max}" value="${opts.suggest||0}" id="pwSubmitUnits" class="sm-big-num">
            <span class="sm-big-label">units</span>
          </div>
          <button type="button" class="sm-step-btn sm-step-plus" id="smMainPlus"><i class="bi bi-plus-lg"></i></button>
        </div>
        <div class="sm-bar-wrap">
          <div class="sm-bar"><div class="sm-bar-fill" id="smBarFill" style="width:${opts.max > 0 ? Math.round(((opts.suggest||0) / opts.max) * 100) : 0}%;"></div></div>
          <div class="sm-bar-labels"><span>0</span><span>${opts.max} max</span></div>
        </div>`;
    }
    overlay.innerHTML = `
      <div class="pw-modal" style="padding:0;overflow:hidden;">
        <div class="sm-header">
          <div class="sm-header-icon"><i class="bi bi-clipboard2-check"></i></div>
          <div>
            <div class="sm-header-title">${esc(opts.title)}</div>
            <div class="sm-header-sub">${opts.subtitleHtml || esc(opts.subtitle)}</div>
          </div>
        </div>
        <div class="sm-body">${body}</div>
        <div class="sm-footer">
          <button class="pw-btn" onclick="this.closest('.pw-modal-overlay').remove()">Cancel</button>
          <button class="pw-btn success" id="pwSubmitSave"><i class="bi bi-check-lg"></i> Submit</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);
    overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });

    // Stepper +/- logic
    overlay.querySelectorAll('.sm-step-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = btn.dataset.idx;
        const dir = parseInt(btn.dataset.dir);
        if (idx !== undefined) {
          const inp = overlay.querySelector(`.sm-unit-input[data-idx="${idx}"]`);
          if (inp) { inp.value = Math.max(0, Math.min(parseInt(inp.dataset.max)||0, (parseInt(inp.value)||0) + dir)); }
        } else if (btn.id === 'smMainMinus' || btn.id === 'smMainPlus') {
          const inp = overlay.querySelector('#pwSubmitUnits');
          if (inp) {
            const max = parseInt(inp.max)||0;
            inp.value = Math.max(0, Math.min(max, (parseInt(inp.value)||0) + dir));
            const bar = overlay.querySelector('#smBarFill');
            if (bar) bar.style.width = max > 0 ? Math.round((inp.value / max) * 100) + '%' : '0%';
          }
        }
      });
    });
    // Sync bar on direct input + clamp to max
    const mainInp = overlay.querySelector('#pwSubmitUnits');
    if (mainInp) {
      const clampMain = () => {
        const max = parseInt(mainInp.max)||0;
        const v = Math.max(0, Math.min(max, parseInt(mainInp.value)||0));
        if (mainInp.value !== String(v)) mainInp.value = v;
        const bar = overlay.querySelector('#smBarFill');
        if (bar) bar.style.width = max > 0 ? Math.round((v / max) * 100) + '%' : '0%';
      };
      mainInp.addEventListener('input', clampMain);
      mainInp.addEventListener('blur', clampMain);
    }
    // Clamp multi-wo inputs too
    overlay.querySelectorAll('.sm-unit-input').forEach(inp => {
      const clampWo = () => {
        const max = parseInt(inp.dataset.max)||0;
        const v = Math.max(0, Math.min(max, parseInt(inp.value)||0));
        if (inp.value !== String(v)) inp.value = v;
      };
      inp.addEventListener('input', clampWo);
      inp.addEventListener('blur', clampWo);
    });

    overlay.querySelector('#pwSubmitSave').addEventListener('click', async () => {
      try {
        if (opts.multi) {
          const perWo = {};
          overlay.querySelectorAll('.pw-unit-input').forEach(inp => { perWo[inp.dataset.wo] = Math.max(0, parseInt(inp.value)||0); });
          await opts.onConfirm(perWo);
        } else {
          const units = Math.max(0, parseInt(overlay.querySelector('#pwSubmitUnits').value)||0);
          await opts.onConfirm(units);
        }
        overlay.remove();
      } catch (e) { toast(e.message, 'error'); }
    });
  }

  // ════════════════════ DETAILS DRAWER (e-commerce style) ════════════════════
  function initials(name){ const p=(name||'').trim().split(/\s+/); return ((p[0]?.[0]||'')+(p[1]?.[0]||'')).toUpperCase() || '?'; }
  function phasePillClass(phase){ return { assessment:'assessment', quotation_review:'quotation_review', execution:'execution', ready:'assigned', en_route:'en_route', arrived:'arrived', in_progress:'in_progress', daily_acceptance:'daily_acceptance', completed:'completed' }[phase] || 'assigned'; }

