            <div class="col-md-6">
              <label class="inv-field-label text-small">Stock Qty</label>
              <input type="number" class="form-control form-control-sm" data-field="quantity" data-variant-id="${variantId}" placeholder="0" min="0" />
            </div>
            <div class="col-md-6">
              <label class="inv-field-label text-small">Reorder Level</label>
              <input type="number" class="form-control form-control-sm" data-field="minStockLevel" data-variant-id="${variantId}" placeholder="3" min="0" />
            </div>
          </div>
        </div>
      `;
      
      container.appendChild(variantRow);
      
      // Populate data if provided
      if (variantData) {
        const capacitySelect = variantRow.querySelector(`[data-field="capacity"]`);
        const btuInput = variantRow.querySelector(`[data-field="btu"]`);
        const sellingPriceInput = variantRow.querySelector(`[data-field="sellingPrice"]`);
        const costPriceInput = variantRow.querySelector(`[data-field="costPrice"]`);
        const quantityInput = variantRow.querySelector(`[data-field="quantity"]`);
        const minStockLevelInput = variantRow.querySelector(`[data-field="minStockLevel"]`);
        
        if (capacitySelect) capacitySelect.value = variantData.capacity || '';
        if (btuInput) btuInput.value = variantData.btu || '';
        if (sellingPriceInput) sellingPriceInput.value = variantData.sellingPrice || '';
        if (costPriceInput) costPriceInput.value = variantData.costPrice || '';
        if (quantityInput) quantityInput.value = variantData.quantity || '';
        if (minStockLevelInput) minStockLevelInput.value = variantData.minStockLevel || '';
      }
      
      // Store variant data
      variantsData2.push({ variantId, data: variantData || {} });
    }

    // Event delegation for variants modal
    document.body.addEventListener('click', function(e) {
      // Save variant in variants modal
      if (e.target.matches('.save-variant2') || e.target.closest('.save-variant2')) {
        const btn = e.target.matches('.save-variant2') ? e.target : e.target.closest('.save-variant2');
        const variantId = btn.dataset.variantId;
        saveIndividualVariant2(variantId);
      }
      
      // Remove variant in variants modal
      if (e.target.matches('.remove-variant2') || e.target.closest('.remove-variant2')) {
        const btn = e.target.matches('.remove-variant2') ? e.target : e.target.closest('.remove-variant2');
        const variantId = btn.dataset.variantId;
        if (confirm('Remove this variant?')) {
          removeVariantRow2(variantId);
        }
      }
    });

    // Save individual variant function
    async function saveIndividualVariant2(variantId) {
      try {
        const variantRow = document.getElementById(`variant2_${variantId}`);
        if (!variantRow) return;
        
        // Get variant data from form fields
        const variantData = { _id: variantId };
        variantRow.querySelectorAll('[data-field]').forEach(input => {
          const field = input.dataset.field;
          variantData[field] = input.type === 'number' ? 
            (parseFloat(input.value) || 0) : input.value;
        });
        
        // Find the product
        const product = inventoryData.find(i => i._id === currentEditingProduct);
        if (!product) {
          alert('Product not found');
          return;
        }
        
        // Combine with product-level data for API
        const data = {
          modelLine: product.modelLine,
          brand: (product.brand && product.brand.name) || product.brand,
          type: product.type,
          inverter: product.inverter,
          warranty: product.warranty,
          description: product.description,
          imageUrl: product.imageUrl,
          variant: variantData // Send variant data separately
        };
        
        // Determine if this is a new variant or existing
        const isNewVariant = variantId.startsWith('variant_');
        const url = isNewVariant ? '/api/admin/hvac/' + currentEditingProduct + '/variants' : '/api/admin/hvac/' + currentEditingProduct + '/variants/' + variantId;
        const method = isNewVariant ? 'POST' : 'PATCH';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        if (response.ok) {
          alert('Variant saved successfully!');
          loadInventory(); // Reload inventory data
          // Close modal
          const modal = bootstrap.Modal.getInstance(document.getElementById('variantsModal'));
          modal && modal.hide();
        } else {
          const error = await response.json();
          alert('Failed to save variant: ' + (error.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error saving variant:', error);
        alert('Error saving variant: ' + error.message);
      }
    }

    // Remove variant row function
    function removeVariantRow2(variantId) {
      const variantRow = document.getElementById(`variant2_${variantId}`);
      if (variantRow) {
        variantRow.remove();
        // Update variant numbers
        const container = document.getElementById('variantsContainer2');
        Array.from(container.children).forEach((row, index) => {
          const titleElement = row.querySelector('h6');
          if (titleElement) {
            titleElement.innerHTML = `<i class="bi bi-box me-1"></i>Variant ${index + 1}`;
          }
        });
      }
    }

    // ── Event Delegation for Main Inventory ────────────────────────────────────────
    document.body.addEventListener('click', function (e) {
      // Edit individual item
      if (e.target.matches('.edit-inventory')) {
        const id = e.target.dataset.id;
        const item = inventoryData.find((i) => i._id === id);
        if (item) openModal(item);
      }

      // Edit individual variant
      if (e.target.matches('.edit-variant') || e.target.closest('.edit-variant')) {
        const btn = e.target.matches('.edit-variant') ? e.target : e.target.closest('.edit-variant');
        const id = btn.dataset.id;
        const item = inventoryData.find((i) => i._id === id);
        if (item) openModal(item);
      }

      // Edit grouped item - show first variant for now
      if (e.target.matches('.edit-grouped') || e.target.closest('.edit-grouped')) {
        const btn = e.target.matches('.edit-grouped') ? e.target : e.target.closest('.edit-grouped');
        const modelName = btn.dataset.model;
        const brandName = btn.dataset.brand;
        const item = inventoryData.find((i) => 
          i.modelLine === modelName && 
          ((i.brand && i.brand.name) || i.brand || 'Unknown') === brandName
        );
        if (item && item.variants && item.variants.length > 0) {
          // Pass the first variant for editing
          const firstVariant = {
            ...item,
            capacity: item.variants[0].capacity,
            btu: item.variants[0].btu,
            sellingPrice: item.variants[0].sellingPrice,
            costPrice: item.variants[0].costPrice,
            quantity: item.variants[0].quantity,
            minStockLevel: item.variants[0].minStockLevel,
            variantId: item.variants[0]._id
          };
          openModal(firstVariant);
        }
      }

      // Manage variants for grouped item
      if (e.target.matches('.manage-variants') || e.target.closest('.manage-variants')) {
        const btn = e.target.matches('.manage-variants') ? e.target : e.target.closest('.manage-variants');
        const modelName = btn.dataset.model;
        const brandName = btn.dataset.brand;
        const item = inventoryData.find((i) => 
          i.modelLine === modelName && 
          ((i.brand && i.brand.name) || i.brand || 'Unknown') === brandName
        );
        if (item) {
          editingId = item._id;
          openVariantsModal();
        }
      }

      // Rate individual item
      if (e.target.matches('.rate-inventory')) {
        window._ratingItemId = e.target.dataset.id;
        // reset rating modal
        document.querySelectorAll('#invModalRating .inv-star-big').forEach(s => s.classList.remove('active'));
        document.getElementById('invModalRatingLabel').textContent = 'Tap a star to rate';
        document.getElementById('invRatingComment').value = '';
        window._ratingScore = 0;
        const ratingModal = new bootstrap.Modal(document.getElementById('invRatingModal'));
        ratingModal.show();
      }

      // Rate individual variant
      if (e.target.matches('.rate-variant') || e.target.closest('.rate-variant')) {
        const btn = e.target.matches('.rate-variant') ? e.target : e.target.closest('.rate-variant');
        const id = btn.dataset.id;
        window._ratingItemId = id;
        // reset rating modal
        document.querySelectorAll('#invModalRating .inv-star-big').forEach(s => s.classList.remove('active'));
        document.getElementById('invModalRatingLabel').textContent = 'Tap a star to rate';
        document.getElementById('invRatingComment').value = '';
        window._ratingScore = 0;
        const ratingModal = new bootstrap.Modal(document.getElementById('invRatingModal'));
        ratingModal.show();
      }

      // Rate grouped item - rate first variant for now
      if (e.target.matches('.rate-grouped') || e.target.closest('.rate-grouped')) {
        const btn = e.target.matches('.rate-grouped') ? e.target : e.target.closest('.rate-grouped');
        const modelName = btn.dataset.model;
        const brandName = btn.dataset.brand;
        const item = inventoryData.find((i) => 
          i.modelLine === modelName && 
          ((i.brand && i.brand.name) || i.brand || 'Unknown') === brandName
        );
        if (item && item.variants && item.variants.length > 0) {
          window._ratingItemId = item.variants[0]._id; // Rate first variant
          // reset rating modal
          document.querySelectorAll('#invModalRating .inv-star-big').forEach(s => s.classList.remove('active'));
          document.getElementById('invModalRatingLabel').textContent = 'Tap a star to rate';
          document.getElementById('invRatingComment').value = '';
          window._ratingScore = 0;
          const ratingModal = new bootstrap.Modal(document.getElementById('invRatingModal'));
          ratingModal.show();
        }
      }

      // Delete
      if (e.target.matches('.delete-inventory') || e.target.closest('.delete-inventory')) {
        const btn = e.target.matches('.delete-inventory') ? e.target : e.target.closest('.delete-inventory');
        const id = btn.dataset.id;
        if (!id) return;
        if (!confirm('Archive this product? It will be hidden from active inventory.')) return;
        fetch(`/api/admin/hvac/${encodeURIComponent(id)}`, { method: 'DELETE' })
          .then(async (r) => {
            if (!r.ok) { const j = await r.json().catch(() => ({})); throw new Error(j.error || 'Delete failed'); }
            return r.json();
          })
          .then(() => loadInventory())
          .catch((err) => alert(err.message || 'Delete failed'));
      }
    });

    // ── Save Product Handler ──────────────────────────────────────────────────
    const saveBtn = document.getElementById('saveInventoryBtn');
    saveBtn && saveBtn.addEventListener('click', async () => {
      hideFormAlert();

      const modelLine = document.getElementById('invModelLine').value.trim();
      const brand = document.getElementById('invBrand').value;
      const category = document.getElementById('invCategory').value;
      const type = document.getElementById('invType').value;
      const inverter = document.getElementById('invInverter').checked;
      const status = document.getElementById('invStatus').value || undefined;
      const warranty = document.getElementById('invWarranty').value.trim();
      const description = document.getElementById('invDescription').value.trim();

      // Validation
      if (!modelLine) return showFormAlert('warning', 'Model Line is required.');
      if (!brand) return showFormAlert('warning', 'Brand is required.');
      if (!category) return showFormAlert('warning', 'Category is required.');
      if (!type) return showFormAlert('warning', 'Type is required.');
      
      // Get variants data
      const variants = getVariantsData();
      if (variants.length === 0) {
        return showFormAlert('warning', 'At least one variant with capacity and selling price is required.');
      }
      
      const data = {
        modelLine, brand, category, type, inverter,
        status, warranty, description,
        salesChannel: 'both',
        variants: variants
      };

      // Handle image upload
      if (uploadedImageData) {
        // Convert base64 to blob and create FormData
        const response = await fetch(uploadedImageData);
        const blob = await response.blob();
        const formData = new FormData();
        
        // Add all fields to FormData
        Object.keys(data).forEach(key => {
          if (typeof data[key] === 'object' && data[key] !== null) {
            formData.append(key, JSON.stringify(data[key]));
          } else {
            formData.append(key, data[key]);
          }
        });
        formData.append('image', blob, 'product.jpg');
        
        try {
          let url = '/api/admin/hvac';
          let method = 'POST';
          if (editingId) { url += '/' + editingId; method = 'PATCH'; }

          const r = await fetch(url, {
            method,
            body: formData, // Don't set Content-Type header for FormData
          });
          if (r.ok) {
            const m = bootstrap.Modal.getInstance(document.getElementById('addItemModal'));
            m && m.hide();
            editingId = null;
            uploadedImageData = null;
            loadInventory();
          } else {
            const j = await r.json();
            showFormAlert('danger', j.error || 'Failed to save HVAC product.');
          }
        } catch (e) {
          showFormAlert('danger', 'Network error: ' + e.message);
        }
      } else {
        // Save without image
        try {
          let url = '/api/admin/hvac';
          let method = 'POST';
          if (editingId) { url += '/' + editingId; method = 'PATCH'; }

          const r = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          if (r.ok) {
            const m = bootstrap.Modal.getInstance(document.getElementById('addItemModal'));
            m && m.hide();
            editingId = null;
            loadInventory();
          } else {
            const j = await r.json();
            showFormAlert('danger', j.error || 'Failed to save HVAC product.');
          }
        } catch (e) {
          showFormAlert('danger', 'Network error: ' + e.message);
        }
      }
    });
  })();

  // ─── Helper Functions ────────────────────────────────────────────────────────
  function showFormAlert(type, message) {
    const alertEl = document.getElementById('inventoryFormAlert');
    if (!alertEl) return;
    alertEl.className = `alert alert-${type} mb-3`;
    alertEl.textContent = message;
    alertEl.classList.remove('d-none');
  }

  function hideFormAlert() {
    const alertEl = document.getElementById('inventoryFormAlert');
    if (!alertEl) return;
    alertEl.classList.add('d-none');
  }

  function showImagePreview(imageSrc) {
    const previewEl = document.getElementById('invImagePreview');
    const placeholderEl = document.getElementById('invImagePlaceholder');
    const imgEl = previewEl?.querySelector('img');
    
    if (previewEl && placeholderEl && imgEl) {
      imgEl.src = imageSrc;
      previewEl.style.display = 'block';
      placeholderEl.style.display = 'none';
    }
  }

  function hideImagePreview() {
    const previewEl = document.getElementById('invImagePreview');
    const placeholderEl = document.getElementById('invImagePlaceholder');
    
    if (previewEl && placeholderEl) {
      previewEl.style.display = 'none';
      placeholderEl.style.display = 'flex';
    }
  }

  function fmtPrice(num) {
    return '₱' + (num || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
</script>

