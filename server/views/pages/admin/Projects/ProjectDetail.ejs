    .recovery-notify { display:flex; align-items:flex-start; gap:.65rem; margin-top:.8rem; padding:.7rem .75rem; border:1px solid #bfdbfe; border-radius:10px; background:#eff6ff; color:#1e3a8a; font-size:.72rem; }
    .recovery-notify input { margin-top:.15rem; accent-color:#2563eb; }
    .recovery-notify small { display:block; margin-top:.08rem; color:#64748b; font-size:.65rem; line-height:1.45; }
    .recovery-check-empty { padding:.78rem; border:1px dashed #94a3b8; border-radius:10px; background:#f8fafc; color:#64748b; font-size:.7rem; line-height:1.5; }
    .recovery-check-result { padding:.82rem; border:1px solid; border-radius:11px; }
    .recovery-check-result.is-ready { border-color:#86efac; background:#f0fdf4; }
    .recovery-check-result.is-blocked { border-color:#fca5a5; background:#fef2f2; }
