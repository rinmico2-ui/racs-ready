      const safe = value => String(value ?? '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
      const localDate = value => { if (!value) return ''; const d=new Date(value); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; };
      const fmtPH = value => { if (!value) return '—'; const d=new Date(value); return isNaN(d.getTime()) ? safe(value) : d.toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}); };
      const dayLabels = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
      const dayNumber = value => { const names={sun:0,sunday:0,mon:1,monday:1,tue:2,tues:2,tuesday:2,wed:3,wednesday:3,thu:4,thur:4,thurs:4,thursday:4,fri:5,friday:5,sat:6,saturday:6}; const text=String(value??'').trim().toLowerCase(); return Object.prototype.hasOwnProperty.call(names,text)?names[text]:Number(text); };
      const selectedDays = (plan.workingDays?.length ? plan.workingDays : (p.preferredWorkingDays?.length ? p.preferredWorkingDays : [1,2,3,4,5])).map(dayNumber).filter(Number.isInteger);
      const assignments = data.assignments || [], orders = data.workOrders || [];
      const ordersById = Object.fromEntries(orders.map(order => [String(order._id), order]));
      const techs = p.assignedTechnicians || [];
      const techName = id => techs.find(t => String(t._id) === String(id))?.name || 'Technician';
      // Technician accent colors for at-a-glance timeline reading.
      const TECH_COLORS = ['#2563eb','#16a34a','#d97706','#9333ea','#dc2626','#0891b2'];
      const techColor = id => { const idx = techs.findIndex(t => String(t._id) === String(id)); return TECH_COLORS[(idx < 0 ? 0 : idx) % TECH_COLORS.length]; };
      const dailyByDate = Object.fromEntries((plan.dailySummary || []).map(day => [localDate(day.date), day]));
      const groups = {};
      assignments.forEach(row => { const key = localDate(row.date); (groups[key] ||= []).push(row); });
      const to12h = t => { const m = /^(\d{1,2}):(\d{2})/.exec(String(t||'')); if (!m) return safe(t||''); let h=Number(m[1]); const min=m[2]; const ap=h>=12?'PM':'AM'; h=h%12||12; return `${h}:${min} ${ap}`; };
      const timeline = Object.keys(groups).sort().map(date => {
        const capPills = Object.values(dailyByDate[date]?.technicians||{}).map(t=>`<span class="es-pill">${safe(t.name)} · ${Math.round(Number(t.assignedMinutes||0)/60*10)/10}h assigned / ${Math.round(Number(t.freeMinutes||0)/60*10)/10}h free</span>`).join('');
        const external=(dailyByDate[date]?.externalEvents||[]).map(event=>{
          const evColor = techColor(event.technicianId);
          return `<div class="es-row es-blocked">
            <span class="es-time" style="background:#fef3c7;color:#b45309;"><i class="bi bi-clock-history"></i> ${safe(event.startTime)}–${safe(event.endTime)}</span>
