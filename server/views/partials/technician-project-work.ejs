    try { s = await api(`/api/projects/${pid}/payment-summary`); } catch (e) { toast(e.message,'error'); return; }
    const overlay = document.createElement('div'); overlay.className = 'pw-modal-overlay';
    overlay.innerHTML = `
      <div class="pw-modal pw-pay-modal">
        <div class="pw-pay-header">
          <h5><i class="bi bi-cash-coin me-2" style="color:var(--pw-ok);"></i>Project Completion — Collect Payment</h5>
          <p>${esc(s.customerName)} · ${s.completedUnits}/${s.totalUnits} units completed. Review the locked customer balance, then record only the amount actually received.</p>
        </div>
        <div class="pw-pay-body">
          <div style="padding:.65rem .75rem;margin-bottom:.65rem;border-radius:8px;background:${s.pricingReady ? '#f0fdf4' : '#fff7ed'};color:${s.pricingReady ? '#166534' : '#9a3412'};font-size:.7rem;">
            <i class="bi ${s.pricingReady ? 'bi-lock-fill' : 'bi-exclamation-triangle-fill'} me-1"></i>${esc(s.pricingMessage)}
          </div>
          <div class="pw-pay-row"><span>Pricing source</span><strong>${esc(s.pricingSource || 'Not configured')}</strong></div>
          <div class="pw-pay-row"><span>Approved service/project charge</span><strong>${money(s.serviceCharge || 0)}</strong></div>
          <div class="pw-pay-row"><span>Travel (${money(s.travelFarePerDay || 0)} × ${s.daysWorked} productive day${s.daysWorked === 1 ? '' : 's'})</span><strong>${money(s.travelFare || 0)}</strong></div>
          <div class="pw-pay-row" style="border:none;"><span class="pw-pay-total">Approved total</span><span class="pw-pay-total" id="ppTotal">${money(s.total)}</span></div>
          <div style="font-size:.64rem;color:var(--pw-muted);margin:-.25rem 0 .55rem;">Operational record: ${s.daysWorked} working day(s) · ${s.crewSize} crew member(s). This does not change the customer price.</div>
          <div class="pw-pay-row" style="border:none;color:var(--pw-muted);"><span>Already collected</span><span>${money(s.alreadyPaid)}</span></div>
          <div class="pw-pay-row" style="border:none;font-weight:800;"><span>Balance due</span><span id="ppBalance">${money(s.balance)}</span></div>
          <label style="font-size:.75rem;font-weight:600;color:var(--pw-muted);margin-top:0.5rem;">Amount collected now</label>
          <input id="ppAmount" type="number" class="form-control form-control-sm mt-1" min="0" max="${s.balance}" data-max="${s.balance}" value="${s.pricingReady ? s.balance : 0}" ${s.pricingReady && s.balance > 0 ? '' : 'disabled'}>
          <div class="pw-meta-row" style="margin-top:0.6rem;">
            <div><b>Method</b><select id="ppMethod" class="form-control form-control-sm" style="width:150px;display:inline;"><option value="cash">Cash</option><option value="gcash">GCash</option><option value="bank">Bank Transfer</option></select></div>
          </div>
          <label style="font-size:.75rem;font-weight:600;color:var(--pw-muted);margin-top:0.4rem;">Reference Number (GCash / Bank)</label><input id="ppReference" class="form-control form-control-sm mt-1">
          <label style="font-size:.75rem;font-weight:600;color:var(--pw-muted);margin-top:0.4rem;">Receipt Screenshot (GCash / Bank)</label><input id="ppProof" type="file" accept="image/*" class="form-control form-control-sm mt-1">
          <label style="font-size:.75rem;font-weight:600;color:var(--pw-muted);margin-top:0.4rem;">Customer Signature *</label><input id="ppSignature" class="form-control form-control-sm mt-1" placeholder="Customer full name">
          <label style="font-size:.75rem;font-weight:600;color:var(--pw-muted);margin-top:0.4rem;">Remarks</label><textarea id="ppRemarks" class="form-control form-control-sm mt-1" rows="2"></textarea>
        </div>
        <div class="pw-pay-footer">
          <button class="pw-btn" onclick="this.closest('.pw-modal-overlay').remove()">Cancel</button>
          <button class="pw-btn success" id="ppSave" ${s.pricingReady && s.balance > 0 ? '' : 'disabled'}><i class="bi bi-check-lg"></i> Record Payment</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);
    overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
    document.getElementById('ppAmount').addEventListener('input', e => {
      e.target.dataset.touched = '1';
      const max = Number(e.target.dataset.max || e.target.max || 0);
      const v = Number(e.target.value);
      if (Number.isNaN(v) || v < 0) e.target.value = '0';
      else if (v > max) e.target.value = String(max);
    });
    document.getElementById('ppAmount').addEventListener('blur', e => {
      const max = Number(e.target.dataset.max || e.target.max || 0);
      const v = Number(e.target.value);
      if (Number.isNaN(v) || v < 0) e.target.value = '0';
      else if (v > max) e.target.value = String(max);
    });
    overlay.querySelector('#ppSave').addEventListener('click', async event => {
      const saveButton = event.currentTarget;
      const method = document.getElementById('ppMethod').value, reference = document.getElementById('ppReference').value.trim(), customerSignature = document.getElementById('ppSignature').value.trim(), proofFile = document.getElementById('ppProof').files[0];
      if (!customerSignature || ((method === 'gcash' || method === 'bank') && (!reference || !proofFile))) { toast('Signature and required transfer evidence are missing.','error'); return; }
      saveButton.disabled = true;
      saveButton.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Recording…';
      const proofUrl = proofFile ? await new Promise((ok,bad)=>{const f=new FileReader();f.onload=()=>ok(f.result);f.onerror=bad;f.readAsDataURL(proofFile);}) : null;
      const payload = {
        amount: +document.getElementById('ppAmount').value,
        paymentMethod: method, reference, proofUrl, customerSignature,
        remarks: document.getElementById('ppRemarks').value,
      };
      try {
        await api(`/api/projects/${pid}/collect-payment`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
        overlay.remove();
        pwOpenCompletionProof(pid);
      } catch (e) {
        toast(e.message, 'error');
        saveButton.disabled = false;
        saveButton.innerHTML = '<i class="bi bi-check-lg"></i> Record Payment';
      }
    });
  };

  // ── Record Parts Used Modal (repair projects) ──
  window.pwOpenPartsModal = async function (pid) {
    let repairData;
    try {
      const r = await fetch(`/api/projects/${pid}/repair-summary`, { credentials: 'same-origin' });
      if (!r.ok) throw new Error('Not a repair project');
      repairData = (await r.json()).repair || {};
    } catch (e) { toast(e.message, 'error'); return; }
    const quotedParts = repairData.quotation?.parts || [];
    const overlay = document.createElement('div'); overlay.className = 'pw-modal-overlay';
    overlay.innerHTML = `
      <div class="pw-modal">
        <h5><i class="bi bi-box-seam me-2" style="color:var(--pw-brand);"></i>Record Parts Used</h5>
        <p style="font-size:.78rem;color:var(--pw-muted);margin-bottom:0.75rem;">Log which parts were installed during this repair session. These will be deducted from inventory.</p>
        <div id="partsRows">
          ${quotedParts.length ? quotedParts.map((pt, i) => `
          <div class="pw-pay-row" style="align-items:center;">
            <div style="flex:1;">
              <input type="text" class="form-control form-control-sm pw-part-name" value="${esc(pt.name)}" placeholder="Part name" style="font-size:.82rem;">
              <input type="hidden" class="pw-part-toolid" value="${pt.toolId || ''}">
              <input type="hidden" class="pw-part-cost" value="${pt.cost || 0}">
            </div>
            <div style="width:70px;">
              <input type="number" class="form-control form-control-sm pw-part-qty" min="1" max="${pt.quantity || 99}" value="1" placeholder="Qty">
            </div>
            <button class="pw-btn danger" style="padding:.2rem .5rem;font-size:.7rem;" onclick="this.closest('.pw-pay-row').remove()"><i class="bi bi-x"></i></button>
          </div>`).join('') : '<div class="text-muted" style="font-size:.82rem;padding:.5rem 0;">No quoted parts. Add a part below.</div>'}
        </div>
        <button class="pw-btn mt-2" style="font-size:.78rem;" onclick="pwAddPartRow('${pid}')"><i class="bi bi-plus-lg"></i> Add Part</button>
        <div class="d-flex gap-2 justify-content-end mt-3">
          <button class="pw-btn" onclick="this.closest('.pw-modal-overlay').remove()">Cancel</button>
          <button class="pw-btn success" id="ppPartsSave"><i class="bi bi-check-lg"></i> Save Parts</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);
    overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
    overlay.querySelector('#ppPartsSave').addEventListener('click', async () => {
      const rows = overlay.querySelectorAll('#partsRows .pw-pay-row');
      const parts = [];
      rows.forEach(row => {
        const name = row.querySelector('.pw-part-name')?.value?.trim();
        const qty = +(row.querySelector('.pw-part-qty')?.value) || 1;
        const cost = +(row.querySelector('.pw-part-cost')?.value) || 0;
        const toolId = row.querySelector('.pw-part-toolid')?.value || undefined;
        if (name) parts.push({ name, quantity: qty, unitCost: cost, toolId });
      });
      if (!parts.length) { toast('Add at least one part', 'error'); return; }
      try {
        const r = await fetch(`/api/projects/${pid}/record-parts-used`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ parts }),
        });
        const data = await r.json();
        if (r.ok) { toast('Parts recorded'); overlay.remove(); }
        else toast(data.error || 'Failed', 'error');
      } catch (e) { toast('Failed to record parts', 'error'); }
    });
  };

