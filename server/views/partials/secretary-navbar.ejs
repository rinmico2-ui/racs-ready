<nav id="adminNavbar" class="navbar navbar-expand-lg border-bottom px-4 py-2 bg-white" style="border-color: rgba(226, 232, 240, 0.8) !important; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03); z-index: 70; position: relative;">
  <div class="container-fluid d-flex align-items-center">
    <a class="navbar-brand fw-bold d-flex align-items-center" href="/secretary" style="font-family: 'Outfit', sans-serif;">
      <img
        src="/images/LOGO/RACS.png"
        alt="CALIDRO RACS"
        class="navbar-brand-logo me-0"
      />
      <span class="brand-text" style="color: #0f172a; font-weight: 400; letter-spacing: 0.3px; font-size: 1.1rem; margin-left: -6px;">CALIDRO RACS</span>
    </a>

    <div class="ms-auto d-flex align-items-center">
      <div class="nav-item me-3">
        <button
          class="btn btn-ghost position-relative d-flex align-items-center justify-content-center"
          id="notifBtn"
          aria-label="Notifications"
          style="width: 34px; height: 34px; border-radius: 8px; color: #64748b; background: transparent; transition: background 0.2s;"
          onmouseover="this.style.background='#f1f5f9';"
          onmouseout="this.style.background='transparent';"
        >
          <i class="bi bi-bell" style="font-size: 1.1rem;"></i>
        </button>
      </div>
      <div class="nav-item dropdown profile-dropdown">
        <a
          class="profile-dropdown-toggle d-flex align-items-center text-decoration-none"
          href="#"
          id="profileDropdown"
          data-bs-toggle="dropdown"
          aria-expanded="false"
        >
          <div class="avatar profile-toggle-avatar me-2">
            <% if (typeof user !== 'undefined' && user && user.profileImage) { %>
              <img src="<%= user.profileImage %>" alt="Profile" />
            <% } else { %>
              <span>
                <%= typeof user !== 'undefined' && user && (user.name || user.email) ? (user.name || user.email).charAt(0).toUpperCase() : 'S' %>
              </span>
            <% } %>
          </div>
          <div class="profile-toggle-details d-none d-sm-flex flex-column">
            <span class="name">
              <%= (typeof user !== 'undefined' && user && (user.name || user.fullName)) ? (user.name || user.fullName) : 'Secretary' %>
            </span>
            <span class="role">Secretary</span>
          </div>
          <i class="bi bi-chevron-down ms-2 chevron"></i>
        </a>
        <ul
          class="dropdown-menu dropdown-menu-end"
          aria-labelledby="profileDropdown"
          style="border-radius: 12px; border: 1px solid rgba(226, 232, 240, 0.8); box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08); padding: 8px; min-width: 200px; margin-top: 8px;"
        >
          <li>
            <a class="dropdown-item d-flex align-items-center" href="/secretary/profile" style="border-radius: 8px; padding: 10px 12px; font-size: 0.875rem; color: #475569; transition: all 0.2s;" onmouseover="this.style.background='#f8fafc'; this.style.color='#0f172a';" onmouseout="this.style.background='transparent'; this.style.color='#475569';">
              <i class="bi bi-person me-2" style="font-size: 0.9rem;"></i>
              Profile
            </a>
          </li>
          <li>
            <hr class="dropdown-divider" style="margin: 8px 0; border-color: rgba(226, 232, 240, 0.8);" />
          </li>
          <li>
            <a class="dropdown-item d-flex align-items-center" href="/logout" style="border-radius: 8px; padding: 10px 12px; font-size: 0.875rem; color: #dc2626; transition: all 0.2s;" onmouseover="this.style.background='#fef2f2'; this.style.color='#b91c1c';" onmouseout="this.style.background='transparent'; this.style.color='#dc2626';">
              <i class="bi bi-box-arrow-right me-2" style="font-size: 0.9rem;"></i>
              Logout
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>
