  window.showTeamModal = async function() {
    try {
      const [tr, cr] = await Promise.all([
        fetch(`/api/projects/${projectId}/eligible-technicians`),
        fetch(`/api/projects/${projectId}/allocation-calendar`),
      ]);
      const td = await tr.json();
      const cal = cr.ok ? await cr.json() : { days: [], conflicts: [], technicians: [] };
      const techs = td.technicians || [];

      const assignedIds = new Set((window.__projectData?.assignedTechnicians || []).map(t => (t._id || '').toString()));
      const currentLead = (window.__projectData?.leadTechnicianId || '').toString();
      const techName = (id) => {
        const t = techs.find(x => (x._id || '').toString() === String(id));
        return t ? (t.name || t.email || 'Unknown') : 'Technician';
      };
      let listHtml = techs.map(t => {
        const checked = assignedIds.has((t._id || '').toString()) ? 'checked' : '';
        const isLead = (t._id || '').toString() === currentLead;
        const avail = t.availableDuringProject !== false;
        const avBadge = avail
          ? `<span class="badge" style="font-size:0.62rem;background:#dcfce7;color:#15803d;"><i class="bi bi-check-circle-fill"></i> Available</span>`
          : `<span class="badge" style="font-size:0.62rem;background:#fee2e2;color:#b91c1c;" title="${t.conflictReason || ''}"><i class="bi bi-exclamation-triangle-fill"></i> Conflict</span>`;
        const avTitle = avail ? '' : ` title="${t.conflictReason || 'Unavailable during project dates'}"`;
        return `<div class="d-flex align-items-center gap-2 py-1" style="border-bottom:1px solid #f1f5f9;"${avTitle}>
          <input type="checkbox" class="tech-checkbox" value="${t._id}" ${checked}>
          <span style="font-size:0.85rem;flex:1;">${t.name || t.email || 'Unknown'}</span>
          ${avBadge}
          <label style="font-size:0.72rem;font-weight:600;color:#4f46e5;cursor:pointer;margin:0;">
            <input type="radio" name="leadTech" value="${t._id}" ${isLead || (!currentLead && checked) ? 'checked' : ''}> Lead
          </label>
        </div>`;
      }).join('') || '<div class="text-muted" style="font-size:0.82rem;">No technicians available</div>';

      const spanNote = td.projectSpan
        ? `<p style="font-size:0.72rem;color:#64748b;margin-bottom:0.5rem;"><i class="bi bi-calendar-check"></i> Project span: <strong>${new Date(td.projectSpan.start).toLocaleDateString('en-PH')}</strong> – <strong>${new Date(td.projectSpan.end).toLocaleDateString('en-PH')}</strong> · ${td.projectSpan.workingDays} working day(s).</p>`
        : '<p style="font-size:0.72rem;color:#94748b;margin-bottom:0.5rem;">No planned start/completion dates set — daily capacity can\'t be assessed.</p>';

      // ── Daily allocation calendar (build schedule around commitments) ──
      let allocHtml = '';
      if (Array.isArray(cal.days) && cal.days.length) {
        const rows = cal.days.map(d => {
          const cells = (cal.technicians || []).map(t => {
            const m = (d.matrix || []).find(x => x._id === t._id);
            if (!m) return `<td style="font-size:0.6rem;color:#94a3b8;text-align:center;">–</td>`;
            const cls = m.status === 'free'
              ? 'background:#dcfce7;color:#15803d;'
              : 'background:#fee2e2;color:#b91c1c;';
            const icon = m.status === 'free' ? '✓' : '✕';
            return `<td style="font-size:0.6rem;${cls}text-align:center;" title="${m.detail || m.status}">${icon}</td>`;
          }).join('');
          const cap = d.remaining < d.required
            ? `<span style="color:#b91c1c;font-weight:700;">${d.remaining}/${d.required}</span>`
            : `${d.remaining}/${d.required}`;
          return `<tr>
            <td style="font-size:0.68rem;font-weight:600;white-space:nowrap;">${d.display}</td>
            <td style="font-size:0.68rem;text-align:center;">${d.totalTechs}</td>
            <td style="font-size:0.68rem;text-align:center;">${d.reservedByOthers}</td>
            <td style="font-size:0.68rem;text-align:center;">${d.onLeave}</td>
            <td style="font-size:0.68rem;text-align:center;">${cap}</td>
            ${cells}
          </tr>`;
        }).join('');
        const headCells = (cal.technicians || []).map(t => `<th style="font-size:0.58rem;padding:2px 4px;">${techName(t._id).split(' ')[0]}</th>`).join('');
        allocHtml = `
          <p style="font-size:0.72rem;font-weight:700;margin:0.25rem 0 0.35rem;color:#334155;">Daily Capacity & Allocation</p>
          <div style="overflow-x:auto;margin-bottom:0.75rem;">
            <table style="width:100%;border-collapse:collapse;">
              <thead>
                <tr style="background:#f8fafc;">
                  <th style="font-size:0.58rem;padding:2px 4px;text-align:left;">Day</th>
                  <th style="font-size:0.58rem;padding:2px 4px;">Total</th>
                  <th style="font-size:0.58rem;padding:2px 4px;">Oth.Proj</th>
                  <th style="font-size:0.58rem;padding:2px 4px;">Leave</th>
                  <th style="font-size:0.58rem;padding:2px 4px;">Free/Req</th>
                  ${headCells}
                </tr>
              </thead>
              <tbody>${rows}</tbody>
            </table>
          </div>
          <p style="font-size:0.6rem;color:#94a3b8;margin:0;">✓ free · ✕ busy (booking / leave / other project). Standard bookings keep priority — the project uses only remaining capacity.</p>`;
      }

      // ── Conflict suggestions (rule-based, no auto-changes) ──
      let conflictHtml = '';
      if (Array.isArray(cal.conflicts) && cal.conflicts.length) {
        const items = cal.conflicts.map(c => {
          const sugg = (c.suggestions || []).map(s => `<span class="badge" style="font-size:0.6rem;background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;margin:2px 2px 0 0;">${s.label}</span>`).join('');
          return `<div style="border:1px solid #fecaca;background:#fffbeb;border-radius:10px;padding:0.6rem 0.75rem;margin-bottom:0.5rem;">
            <div style="font-size:0.74rem;font-weight:700;color:#b45309;"><i class="bi bi-exclamation-triangle-fill"></i> ${c.date}: needs ${c.required}, only ${c.available} free (short ${c.missing})</div>
            <div style="margin-top:0.3rem;">${sugg}</div>
          </div>`;
        }).join('');
        conflictHtml = `<p style="font-size:0.72rem;font-weight:700;margin:0.5rem 0 0.35rem;color:#b45309;">Scheduling Conflicts</p>${items}
          <p style="font-size:0.6rem;color:#94a3b8;margin:0.25rem 0 0;">Existing bookings are protected — resolve with a suggestion above. The team still saves; you can adjust later.</p>`;
      }

      const modal = document.createElement('div');
      modal.className = 'pd-modal-overlay';
      modal.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);z-index:9999;display:flex;align-items:center;justify-content:center;';
      modal.innerHTML = `
        <div style="background:#fff;border-radius:16px;padding:1.5rem;width:680px;max-width:94vw;max-height:85vh;overflow-y:auto;">
          <h4 style="font-size:1rem;font-weight:700;margin-bottom:0.35rem;">Assign Project Team</h4>
          <p style="font-size:0.8rem;color:#64748b;margin-bottom:0.5rem;">Select team members and choose one as <strong>Lead Technician</strong>. The schedule is built around each technician's existing bookings.</p>
          ${spanNote}
          <p style="font-size:0.72rem;font-weight:700;margin:0 0 0.35rem;color:#334155;">Team Members</p>
          <div style="margin-bottom:0.5rem;max-height:160px;overflow-y:auto;">${listHtml}</div>
          ${allocHtml}
          ${conflictHtml}
          <div class="d-flex gap-2 justify-content-end" style="margin-top:0.75rem;">
            <button class="pd-btn" onclick="closeModal(this)">Cancel</button>
            <button class="pd-btn primary" id="saveTeamBtn">Save Team</button>
          </div>
        </div>
      `;
      document.body.appendChild(modal);
      modal.querySelector('#saveTeamBtn').addEventListener('click', async function() {
        const selected = [...modal.querySelectorAll('.tech-checkbox:checked')].map(c => c.value);
        if (selected.length === 0) { toast('Select at least one technician', 'error'); return; }
        const lead = modal.querySelector('input[name="leadTech"]:checked');
        const leadId = lead ? lead.value : selected[0];
        await withBtnLoading(this, 'Saving…', async () => {
          try {
            const r = await fetch(`/api/projects/${projectId}/team`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ technicianIds: selected, leadTechnicianId: leadId }),
            });
            if (r.ok) { toast('Team assigned'); modal.remove(); loadProject(); }
            else {
              const e = await r.json();
              if (e.conflict) {
                toast('Saved with conflicts — see allocation calendar', 'error');
                modal.remove(); loadProject();
              } else { toast(e.error || 'Failed', 'error'); }
            }
          } catch(e) { toast('Failed', 'error'); }
        });
      });
      modal.addEventListener('click', function(e) { if (e.target === this) this.remove(); });
    } catch(e) { toast('Failed to load technicians', 'error'); }
  };

