     HERO â€” Light Enterprise Blue Gradient
     â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
  body {
    background: linear-gradient(180deg, #f3f7fd 0%, #edf3fc 30%, #f8fafc 100%);
    min-height: 100vh;
  }

  /* ------------------------------------------------------------------ */
  /*  ENTERPRISE HERO                                                    */
  /* ------------------------------------------------------------------ */
  .ent-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 5rem 0 6.5rem;
    background: linear-gradient(160deg, #e0f2fe 0%, #f0fdf4 35%, #e0e7ff 70%, #ede9fe 100%);
    border-bottom: 1px solid rgba(59, 130, 246, 0.08);
  }

  .ent-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 900px 600px at 70% 10%, rgba(59, 130, 246, 0.1) 0%, transparent 55%),
      radial-gradient(ellipse 500px 400px at 20% 90%, rgba(6, 182, 212, 0.08) 0%, transparent 55%),
      radial-gradient(ellipse 300px 300px at 50% 50%, rgba(99, 102, 241, 0.06) 0%, transparent 50%);
    pointer-events: none;
  }

  .ent-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(59, 130, 246, 0.05) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }

  .ent-hero .container {
    position: relative;
    z-index: 2;
  }

  .ent-hero .ent-hero-orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    filter: blur(50px);
  }
  .ent-hero-orb-1 {
    width: 350px; height: 350px;
    background: radial-gradient(circle, rgba(59,130,246,0.12) 0%, transparent 70%);
    top: -100px; right: -50px;
    animation: orbFloat1 10s ease-in-out infinite;
  }
  .ent-hero-orb-2 {
    width: 250px; height: 250px;
    background: radial-gradient(circle, rgba(6,182,212,0.1) 0%, transparent 70%);
    bottom: -60px; left: 15%;
    animation: orbFloat2 12s ease-in-out infinite;
  }
  .ent-hero-orb-3 {
    width: 180px; height: 180px;
    background: radial-gradient(circle, rgba(99,102,241,0.08) 0%, transparent 70%);
    top: 25%; left: -60px;
    animation: orbFloat3 14s ease-in-out infinite;
  }
  .ent-hero-orb-4 {
    width: 120px; height: 120px;
    background: radial-gradient(circle, rgba(59,130,246,0.08) 0%, transparent 70%);
    bottom: 15%; right: 10%;
    animation: orbFloat4 11s ease-in-out infinite;
  }

  @keyframes orbFloat1 { 0%,100% { transform: translate(0,0) scale(1); } 33% { transform: translate(-20px,30px) scale(1.05); } 66% { transform: translate(15px,-20px) scale(0.95); } }
  @keyframes orbFloat2 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(30px,-25px) scale(1.08); } }
  @keyframes orbFloat3 { 0%,100% { transform: translate(0,0) scale(1); } 33% { transform: translate(15px,20px) scale(1.03); } 66% { transform: translate(-10px,-15px) scale(0.97); } }
  @keyframes orbFloat4 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-20px,15px) scale(1.06); } }

