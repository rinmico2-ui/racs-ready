        '<i class="bi bi-check-circle-fill text-success" style="font-size:1.5rem;"></i>'+
        '<div><div style="font-weight:700;font-size:0.9rem;color:#065f46;">Completed</div>'+
        '<div style="font-size:0.8rem;color:#166534;">'+(b.updatedAt?new Date(b.updatedAt).toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}):'')+'</div></div></div>';
