        <script>
          (function () {
            const btns = document.querySelectorAll('.mw-mode-btn');
            function setMode(mode) {
              const isProj = mode === 'projects';
              document.querySelectorAll('.mw-mode-btn').forEach(b => {
                const active = b.dataset.mode === mode;
                b.classList.toggle('active', active);
                b.style.background = active ? 'linear-gradient(135deg,#2563eb,#3b82f6)' : 'transparent';
                b.style.color = active ? '#fff' : '#64748b';
                b.style.fontWeight = active ? '700' : '600';
                b.style.boxShadow = active ? '0 2px 8px rgba(37,99,235,0.25)' : 'none';
              });
              // Two mutually-exclusive left-column views: bookings list vs project pane
              const leftPanel = document.getElementById('leftPanel');
              const proj = document.getElementById('projectPane');
              const rightPanel = document.getElementById('rightPanel');
              const sbHero = document.getElementById('sbHero');
              const assignTabs = document.getElementById('assignTabs');
              const mwSplitLayout = document.getElementById('mwSplitLayout');
              if (isProj) {
                if (leftPanel) leftPanel.style.display = 'none';
                if (sbHero) sbHero.style.display = 'none';
                if (assignTabs) assignTabs.style.display = 'none';
                if (mwSplitLayout) { mwSplitLayout.style.display = 'block'; mwSplitLayout.style.flex = '1 1 100%'; }
                if (rightPanel) { rightPanel.style.display = 'none'; rightPanel.classList.remove('open'); }
                if (proj) {
                  proj.style.display = 'block';
                  proj.style.flex = '1 1 100%';
                  proj.style.width = '100%';
                  proj.style.maxWidth = '100%';
                  if (window.__loadProjectWork) window.__loadProjectWork();
                }
              } else {
                if (leftPanel) leftPanel.style.display = '';
                if (sbHero) sbHero.style.display = '';
                if (assignTabs) assignTabs.style.display = '';
                if (mwSplitLayout) { mwSplitLayout.style.display = ''; mwSplitLayout.style.flex = ''; }
                if (rightPanel) rightPanel.style.display = '';
                if (proj) { proj.style.display = 'none'; proj.style.flex = ''; proj.style.width = ''; proj.style.maxWidth = ''; }
              }
            }
            btns.forEach(b => b.addEventListener('click', () => setMode(b.dataset.mode)));
          })();
        </script>

