                <i class="bi bi-tools text-white fs-5"></i>
              </div>
            </div>
            <div class="kpi-sparkline-container">
              <canvas id="kpiSparkActiveJobs" height="40"></canvas>
            </div>
          </div>
        </div>

        <!-- Completed KPI -->
        <div class="col-lg-2 col-md-4 col-sm-6">
          <div class="dash-card h-100" data-aos="fade-up" data-aos-duration="600" data-aos-delay="200">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
