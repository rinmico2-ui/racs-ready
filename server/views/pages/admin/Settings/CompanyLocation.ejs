<div class="admin-dashboard container-fluid py-4 company-location-settings-page inventory-premium">
  <%- include('../../../partials/dashboard-styles') %>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@700&display=swap');

    .company-location-settings-page {
      font-family: 'Inter', sans-serif;
      --ss-primary: #0ea5e9;
      --ss-primary-dark: #0284c7;
      --ss-accent: #38bdf8;
      --ss-surface: #ffffff;
      --ss-surface-soft: #f0f9ff;
      --ss-line: rgba(15, 23, 42, 0.08);
      --ss-line-strong: rgba(15, 23, 42, 0.14);
      --ss-muted: #64748b;
      --ss-text: #0c4a6e;
      --ss-radius: 1rem;
      --ss-shadow: 0 10px 28px rgba(15, 23, 42, 0.05);
      --ss-shadow-hover: 0 14px 34px rgba(15, 23, 42, 0.08);
    }

    .company-location-settings-page .page-title {
      font-family: 'Outfit', sans-serif;
      font-size: 1.5rem;
      font-weight: 700;
      color: #ffffff;
    }

    .company-location-settings-page .hero-sub {
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.85);
    }

    .company-location-settings-page .au-hero {
      background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 50%, #2563eb 100%);
      border-radius: var(--ss-radius);
      padding: 1.5rem 1.75rem;
      color: #fff;
    }

    .company-location-settings-page .au-hero-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.2);
      color: #fff;
      font-size: 1.4rem;
      flex-shrink: 0;
    }

    .company-location-settings-page .fw-600 {
      font-weight: 600 !important;
    }

    .company-location-settings-page .card {
      border-radius: var(--ss-radius);
      background: #ffffff;
      box-shadow: var(--ss-shadow);
      overflow: hidden;
    }

    .company-location-settings-page .card:hover {
      box-shadow: var(--ss-shadow-hover);
      transform: translateY(-2px);
      transition: transform 0.22s ease, box-shadow 0.22s ease;
    }

    .company-location-settings-page .card-header {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--ss-line);
      background: #fff;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .company-location-settings-page .head-icon {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      flex-shrink: 0;
      background: linear-gradient(135deg, var(--ss-primary), var(--ss-accent));
      box-shadow: 0 10px 26px rgba(14,165,233,0.25);
    }

    .company-location-settings-page .form-label {
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--ss-text);
      margin-bottom: 0.35rem;
    }

    .company-location-settings-page .form-control,
    .company-location-settings-page .form-select {
      border-radius: 10px;
      border-color: var(--ss-line-strong);
      font-size: 0.9rem;
      font-weight: 400;
    }

    .company-location-settings-page .form-control:focus,
    .company-location-settings-page .form-select:focus {
      border-color: rgba(14,165,233,0.45);
      box-shadow: 0 0 0 0.15rem rgba(14,165,233,0.16);
    }

    .company-location-settings-page .input-group-text {
      background: var(--ss-surface-soft);
      border-color: var(--ss-line-strong);
      color: var(--ss-muted);
      border-radius: 10px 0 0 10px;
    }

    .company-location-settings-page .input-group .form-control {
      border-radius: 0 10px 10px 0;
    }

    .company-location-settings-page .btn {
      padding: 0.6rem 1.1rem;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.86rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
      text-decoration: none;
      justify-content: center;
    }

    .company-location-settings-page .btn-primary {
      background: linear-gradient(135deg, var(--ss-primary), var(--ss-accent));
      border: none;
      color: #fff;
      box-shadow: 0 8px 22px rgba(14,165,233,0.25);
    }

    .company-location-settings-page .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 12px 28px rgba(14,165,233,0.32);
    }

    .company-location-settings-page .btn-outline-secondary {
      background: #fff;
      border: 1.5px solid var(--ss-line-strong);
      color: var(--ss-text);
    }

    .company-location-settings-page .btn-outline-secondary:hover {
      border-color: rgba(14,165,233,0.55);
      color: var(--ss-primary-dark);
    }

    .company-location-settings-page .help {
      color: var(--ss-muted);
      font-size: 0.86rem;
      line-height: 1.4;
      font-weight: 400;
    }

    .company-location-settings-page .coord-preview {
      background: var(--ss-surface-soft);
      border: 1px solid var(--ss-line);
      border-radius: 12px;
      padding: 0.9rem 1rem;
    }

    .company-location-settings-page .coord-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    @media (min-width: 992px) {
      .company-location-settings-page .coord-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    .company-location-settings-page .kv {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .company-location-settings-page .kv small {
      color: var(--ss-muted);
      font-weight: 500;
      font-size: 0.75rem;
    }

    .company-location-settings-page .kv div {
      font-weight: 400;
      color: var(--ss-text);
      word-break: break-word;
    }

    .company-location-settings-page .dash-card {
      padding: 1rem;
      min-height: 122px;
      height: 100%;
    }
    .company-location-settings-page .dash-card > .d-flex {
      flex: 1;
      justify-content: space-between;
      align-items: flex-start;
    }

    .company-location-settings-page .kpi-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1rem;
      flex-shrink: 0;
    }

    .company-location-settings-page .kpi-title {
      font-size: 0.68rem;
      font-weight: 600;
      color: var(--ss-muted);
      margin-bottom: 0.25rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .company-location-settings-page .inv-kpi-value {
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--ss-text);
      word-break: break-word;
    }
    .company-location-settings-page #kpiAddress {
      font-size: 0.8rem;
      line-height: 1.45;
    }

    .company-location-settings-page .inv-kpi-sub {
      font-size: 0.75rem;
      font-weight: 400;
      color: var(--ss-muted);
    }

    .company-location-settings-page .alert {
      border-radius: 12px;
    }

    #companyLocationMap {
      width: 100%;
      height: 420px;
      position: relative;
      border-radius: 0.75rem;
      overflow: hidden;
      background: #f8fafc;
    }

    .company-map-toolgroup {
      background: rgba(255,255,255,.95);
      border: 2px solid #fff;
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 2px 6px rgba(0,0,0,.25);
      width: 36px;
      align-items: center;
    }

    .company-map-toolgroup button {
      background: transparent;
      border: none;
      width: 100%;
      padding: 6px 0;
      font-size: 1.1rem;
      color: #0f172a;
      font-weight: 600;
      cursor: pointer;
      line-height: 1;
    }

    .company-map-toolgroup .divider {
      width: 80%;
      height: 1px;
      background: rgba(0,0,0,.12);
    }

    .company-compass {
      background: rgba(255,255,255,.95);
      border: 2px solid #fff;
      border-radius: 50%;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 6px rgba(0,0,0,.35);
      cursor: default;
    }

    .company-layer-bar {
      position: absolute;
      bottom: 12px;
      left: 12px;
      z-index: 1000;
      background: rgba(15,23,42,0.88);
      backdrop-filter: blur(4px);
      border-radius: 14px;
      padding: 6px 10px;
      display: flex;
      gap: 10px;
      box-shadow: 0 4px 12px rgba(0,0,0,.35);
    }

    .company-layer-btn {
      background: transparent;
      border: none;
      color: #94a3b8;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      padding: 3px;
      font-size: 0.62rem;
      font-weight: 600;
      min-width: 44px;
      cursor: pointer;
    }

    .company-layer-btn.active { color: #fff; }

    .company-layer-thumb {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      border: 2px solid transparent;
      overflow: hidden;
      transition: all .2s;
    }

    .company-layer-btn.active .company-layer-thumb { border-color: #2b7de9; }

    .thumb-standard {
      background: #e0f2fe;
      background-image: repeating-linear-gradient(0deg, #fff 0, #fff 1px, transparent 1px, transparent 7px), repeating-linear-gradient(90deg, #fff 0, #fff 1px, transparent 1px, transparent 7px);
    }

    .thumb-hybrid {
      background: #14532d;
      background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.2) 0, rgba(255,255,255,.2) 1px, transparent 1px, transparent 7px), repeating-linear-gradient(90deg, rgba(255,255,255,.2) 0, rgba(255,255,255,.2) 1px, transparent 1px, transparent 7px);
    }

    .company-marker-pin {
      filter: drop-shadow(0 3px 5px rgba(0,0,0,.45));
    }
  </style>

  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-building"></i></div>
        <div>
          <h1 class="page-title m-0">Company Locations</h1>
          <p class="hero-sub m-0">Manage office and branch location details for the platform</p>
        </div>
      </div>
    </div>
  </div>

  <div class="main-content">
    <div id="companyLocationAlert" class="alert d-none" role="alert"></div>

    <div class="row g-3 mb-4">
      <div class="col-lg-4 col-md-6">
        <div class="card border-0 shadow-sm dash-card h-100" data-aos="fade-up" data-aos-delay="0">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="kpi-title">Company Address</div>
              <div class="inv-kpi-value" id="kpiAddress">—</div>
              <div class="inv-kpi-sub mt-1">Primary office address</div>
            </div>
            <div class="kpi-icon" style="background: linear-gradient(135deg, #2563eb, #1d4ed8);">
              <i class="bi bi-geo-alt"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="card border-0 shadow-sm dash-card h-100" data-aos="fade-up" data-aos-delay="100">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="kpi-title">Latitude</div>
              <div class="inv-kpi-value" id="kpiLat">—</div>
              <div class="inv-kpi-sub mt-1">Coordinate value</div>
            </div>
            <div class="kpi-icon" style="background: linear-gradient(135deg, #22c55e, #16a34a);">
              <i class="bi bi-compass"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="card border-0 shadow-sm dash-card h-100" data-aos="fade-up" data-aos-delay="200">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="kpi-title">Longitude</div>
              <div class="inv-kpi-value" id="kpiLng">—</div>
              <div class="inv-kpi-sub mt-1">Coordinate value</div>
            </div>
            <div class="kpi-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
              <i class="bi bi-globe"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
      <div class="card-header bg-white">
        <div class="head-icon"><i class="bi bi-map"></i></div>
        <h4 class="m-0 fw-600 text-dark">Company Location Map</h4>
      </div>
      <div class="card-body p-2 position-relative">
        <div id="companyLocationMap" data-lat="14.676049" data-lng="121.043731">
          <div id="companyMapOverlay" class="w-100 h-100 d-flex justify-content-center align-items-center text-muted" style="position:absolute;top:0;left:0;z-index:2;background:#f8fafc;">
            Loading map…
          </div>
        </div>

        <div style="position:absolute;top:12px;left:12px;z-index:1000;">
          <div class="company-map-toolgroup">
            <button id="btnZoomIn" title="Zoom in">+</button>
            <div class="divider"></div>
            <button id="btnZoomOut" title="Zoom out">−</button>
          </div>
        </div>

        <div style="position:absolute;top:12px;right:12px;z-index:1000;">
          <div class="company-compass" id="companyCompass" title="North">
            <svg width="24" height="24" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:block;">
              <circle cx="20" cy="20" r="18" fill="#0f172a" stroke="#334155" stroke-width="2"/>
              <text x="20" y="11" text-anchor="middle" font-size="7" fill="#ef4444" font-family="Arial, sans-serif" font-weight="600">N</text>
              <text x="20" y="32" text-anchor="middle" font-size="7" fill="#94a3b8" font-family="Arial, sans-serif" font-weight="600">S</text>
              <text x="10" y="21.5" text-anchor="middle" font-size="6" fill="#64748b" font-family="Arial, sans-serif" font-weight="600">W</text>
              <text x="30" y="21.5" text-anchor="middle" font-size="6" fill="#64748b" font-family="Arial, sans-serif" font-weight="600">E</text>
              <path d="M20 6 L23 20 L20 18 L17 20 Z" fill="#ef4444"/>
              <path d="M20 34 L17 20 L20 22 L23 20 Z" fill="#cbd5e1"/>
              <circle cx="20" cy="20" r="2" fill="#fff"/>
            </svg>
          </div>
        </div>

        <div class="company-layer-bar">
          <button class="company-layer-btn active" data-layer="standard">
            <div class="company-layer-thumb thumb-standard"></div>
            Standard
          </button>
          <button class="company-layer-btn" data-layer="hybrid">
            <div class="company-layer-thumb thumb-hybrid"></div>
            Hybrid
          </button>
        </div>
      </div>
      <div class="card-footer bg-white p-3 border-top">
        <h5 class="mb-3 fw-600 text-dark" style="font-size:1rem;"><i class="bi bi-geo-alt me-2 text-primary"></i>Set Company / Base Coordinates</h5>
        <div class="row g-3">
          <div class="col-12">
            <label for="companyAddress" class="form-label">Company Address</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
              <input id="companyAddress" type="text" class="form-control" placeholder="e.g., 123 Main St, Metro Manila" />
            </div>
            <div class="help mt-2">
              Used only for display/autocomplete. Distance calculations use Lat/Lng.
            </div>
          </div>

          <div class="col-md-6">
            <label for="companyLat" class="form-label">Latitude</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-compass"></i></span>
              <input id="companyLat" type="number" class="form-control" step="any" placeholder="e.g., 14.676049" />
            </div>
          </div>

          <div class="col-md-6">
            <label for="companyLng" class="form-label">Longitude</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-globe"></i></span>
              <input id="companyLng" type="number" class="form-control" step="any" placeholder="e.g., 121.043731" />
            </div>
          </div>

          <div class="col-12 d-flex gap-2 flex-wrap">
            <button type="button" id="saveCompanyLocationBtn" class="btn btn-primary fw-600">
              <i class="bi bi-floppy"></i> Save Company Location
            </button>

            <button type="button" id="useMyLocationBtn" class="btn btn-outline-secondary fw-600">
              <i class="bi bi-crosshair"></i> Use My Location (optional)
            </button>
          </div>

          <div class="col-12">
            <div class="coord-preview">
              <div class="help mb-2"><i class="bi bi-info-circle me-2 text-primary"></i>Current baseline preview</div>
              <div class="coord-grid">
                <div class="kv">
                  <small>Address</small>
                  <div id="baselineAddressPreview">—</div>
                </div>
                <div class="kv">
                  <small>Coordinates</small>
                  <div id="baselineCoordsPreview">—</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const alertEl = document.getElementById('companyLocationAlert');
      const setAlert = (msg, type) => {
        alertEl.className = 'alert alert-' + (type || 'info');
        alertEl.textContent = msg;
        alertEl.classList.remove('d-none');
        setTimeout(() => alertEl.classList.add('d-none'), 5000);
      };

      const addressInput = document.getElementById('companyAddress');
      const latInput = document.getElementById('companyLat');
      const lngInput = document.getElementById('companyLng');

      const addrPreview = document.getElementById('baselineAddressPreview');
      const coordsPreview = document.getElementById('baselineCoordsPreview');

      const kpiAddress = document.getElementById('kpiAddress');
      const kpiLat = document.getElementById('kpiLat');
      const kpiLng = document.getElementById('kpiLng');

      const companyMapState = {
        map: null,
        marker: null,
        standardLayer: null,
        hybridGroup: null,
        activeLayer: null,
        activeLayerName: 'standard'
      };

      function renderPreview(payload) {
        addressInput.value = payload.address || '';
        latInput.value = payload.lat ?? '';
        lngInput.value = payload.lng ?? '';

        addrPreview.textContent = payload.address || '—';
        coordsPreview.textContent =
          (Number.isFinite(payload.lat) ? payload.lat : '—') + ', ' + (Number.isFinite(payload.lng) ? payload.lng : '—');

        if (kpiAddress) kpiAddress.textContent = payload.address || '—';
        if (kpiLat) kpiLat.textContent = Number.isFinite(payload.lat) ? payload.lat : '—';
        if (kpiLng) kpiLng.textContent = Number.isFinite(payload.lng) ? payload.lng : '—';

        const mapBox = document.getElementById('companyLocationMap');
        if (mapBox) {
          mapBox.dataset.lat = payload.lat ?? mapBox.dataset.lat;
          mapBox.dataset.lng = payload.lng ?? mapBox.dataset.lng;
        }
      }

      // Lazy Leaflet loading (if not already loaded on admin layout)
      function ensureLeaflet() {
        return new Promise((resolve) => {
          if (window.L && window.L.map) return resolve(true);
          const css = document.createElement('link');
          css.rel = 'stylesheet';
          css.href = 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css';
          document.head.appendChild(css);

          const script = document.createElement('script');
          script.src = 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js';
          script.onload = () => resolve(true);
          script.onerror = () => resolve(false);
          document.head.appendChild(script);
        });
      }

      const companyPinIcon = window.L ? window.L.divIcon({
        className: '',
        html: '<div class="company-marker-pin">' +
          '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="40" viewBox="0 0 28 40">' +
          '<path d="M14 0C6.3 0 0 6.3 0 14c0 10.5 14 26 14 26s14-15.5 14-26C28 6.3 21.7 0 14 0z" fill="#2563eb"/>' +
          '<circle cx="14" cy="14" r="5" fill="#fff"/>' +
          '</svg></div>',
        iconSize: [28, 40],
        iconAnchor: [14, 40],
        popupAnchor: [0, -36]
      }) : null;

      async function initMapIfNeeded() {
        const mapEl = document.getElementById('companyLocationMap');
        if (!mapEl) return;

        const ok = await ensureLeaflet();
        if (!ok) return;

        const lat = parseFloat(mapEl.dataset.lat);
        const lng = parseFloat(mapEl.dataset.lng);
        const center = [Number.isFinite(lat) ? lat : 14.676049, Number.isFinite(lng) ? lng : 121.043731];

        if (companyMapState.map) {
          companyMapState.map.setView(center, 14);
          if (companyMapState.marker) companyMapState.marker.setLatLng(center);
          return;
        }

        companyMapState.map = window.L.map(mapEl, { zoomControl: false }).setView(center, 14);

        companyMapState.standardLayer = window.L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
          subdomains: 'abcd',
          maxZoom: 19
        });

        const hybridBase = window.L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
          attribution: 'Tiles &copy; Esri — Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community',
          maxZoom: 18
        });
        const hybridLabels = window.L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Transportation/MapServer/tile/{z}/{y}/{x}', {
          attribution: '&copy; Esri',
          maxZoom: 18
        });
        companyMapState.hybridGroup = window.L.layerGroup([hybridBase, hybridLabels]);

        companyMapState.activeLayer = companyMapState.standardLayer;
        companyMapState.activeLayerName = 'standard';
        companyMapState.activeLayer.addTo(companyMapState.map);

        const icon = window.L.divIcon({
          className: '',
          html: '<div class="company-marker-pin">' +
            '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="40" viewBox="0 0 28 40">' +
            '<path d="M14 0C6.3 0 0 6.3 0 14c0 10.5 14 26 14 26s14-15.5 14-26C28 6.3 21.7 0 14 0z" fill="#2563eb"/>' +
            '<circle cx="14" cy="14" r="5" fill="#fff"/>' +
            '</svg></div>',
          iconSize: [28, 40],
          iconAnchor: [14, 40],
          popupAnchor: [0, -36]
        });

        companyMapState.marker = window.L.marker(center, { icon }).addTo(companyMapState.map);

        const ol = document.getElementById('companyMapOverlay');
        if (ol) { ol.classList.add('d-none'); }
      }

      async function loadCurrent() {
        try {
          const resp = await fetch('/api/public/company/location', { credentials: 'same-origin' });
          const data = await resp.json();

          renderPreview(data);
          await initMapIfNeeded();

          // Drop marker into map with latest coords
          const mapEl = document.getElementById('companyLocationMap');
          if (companyMapState.marker && mapEl) {
            companyMapState.marker.setLatLng([
              parseFloat(mapEl.dataset.lat),
              parseFloat(mapEl.dataset.lng)
            ]);
          }
        } catch (e) {
          setAlert('Failed to load current company location.', 'danger');
        }
      }

      async function save() {
        const address = (addressInput.value || '').trim();
        const lat = Number(latInput.value);
        const lng = Number(lngInput.value);

        if (!address) {
          setAlert('Company address is required.', 'warning');
          return;
        }
        if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
          setAlert('Latitude and Longitude must be valid numbers.', 'warning');
          return;
        }

        const btn = document.getElementById('saveCompanyLocationBtn');
        btn.disabled = true;
        const prev = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving…';

        try {
          const resp = await fetch('/api/admin/settings/company-location', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              address,
              lat,
              lng
            })
          });

          const data = await resp.json();
          if (!resp.ok) throw new Error(data.error || 'Save failed');

          setAlert('Company location saved successfully.', 'success');

          // Update map preview if initialized
          await initMapIfNeeded();
          if (companyMapState.marker) companyMapState.marker.setLatLng([lat, lng]);
          if (companyMapState.map) companyMapState.map.setView([lat, lng], 14);

        } catch (e) {
          setAlert('Save failed: ' + (e.message || e), 'danger');
        } finally {
          btn.disabled = false;
          btn.innerHTML = prev;
        }
      }

      async function useMyLocation() {
        if (!navigator.geolocation) {
          setAlert('Geolocation is not supported by this browser.', 'warning');
          return;
        }

        const btn = document.getElementById('useMyLocationBtn');
        const prev = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Getting location…';

        navigator.geolocation.getCurrentPosition(async (pos) => {
          const lat = pos.coords.latitude;
          const lng = pos.coords.longitude;

          // Try reverse geocode via existing API
          try {
            const r = await fetch(`/api/geocoding/reverse?lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lng)}`);
            const j = await r.json();
            const address = j && j.display_name ? j.display_name : 'Lat/Lng saved (address not resolved)';

            renderPreview({ address, lat, lng });
            setAlert('Location captured from your device. Click save to persist.', 'info');

            await initMapIfNeeded();
            if (companyMapState.marker) companyMapState.marker.setLatLng([lat, lng]);
            if (companyMapState.map) companyMapState.map.setView([lat, lng], 14);
          } catch (e) {
            renderPreview({ address: 'Lat/Lng saved (address not resolved)', lat, lng });
          }

        }, (err) => {
          setAlert('Failed to get your location.', 'danger');
        }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 });

        setTimeout(() => {
          btn.disabled = false;
          btn.innerHTML = prev;
        }, 12000);
      }

      document.getElementById('saveCompanyLocationBtn').addEventListener('click', save);
      document.getElementById('useMyLocationBtn').addEventListener('click', useMyLocation);

      // Custom zoom controls
      const btnZoomIn = document.getElementById('btnZoomIn');
      const btnZoomOut = document.getElementById('btnZoomOut');
      if (btnZoomIn) {
        btnZoomIn.addEventListener('click', function () {
          if (companyMapState.map) companyMapState.map.setZoom(companyMapState.map.getZoom() + 1);
        });
      }
      if (btnZoomOut) {
        btnZoomOut.addEventListener('click', function () {
          if (companyMapState.map) companyMapState.map.setZoom(companyMapState.map.getZoom() - 1);
        });
      }

      // Layer selector
      document.querySelectorAll('.company-layer-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const layer = btn.dataset.layer;
          if (!layer || !companyMapState.map || layer === companyMapState.activeLayerName) return;
          if (companyMapState.activeLayer) companyMapState.map.removeLayer(companyMapState.activeLayer);
          if (layer === 'standard') {
            companyMapState.activeLayer = companyMapState.standardLayer;
            companyMapState.activeLayerName = 'standard';
          } else if (layer === 'hybrid') {
            companyMapState.activeLayer = companyMapState.hybridGroup;
            companyMapState.activeLayerName = 'hybrid';
          }
          companyMapState.activeLayer.addTo(companyMapState.map);
          document.querySelectorAll('.company-layer-btn').forEach(function (b) {
            b.classList.toggle('active', b.dataset.layer === layer);
          });
        });
      });

      loadCurrent();
      // Attempt to initialize map right after load
      setTimeout(initMapIfNeeded, 500);
    })();
  </script>
</div>
