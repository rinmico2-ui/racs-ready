<!-- --- Enterprise Chart Drilldown Modal --- -->
<%- include('../../../partials/chart-drilldown-modal') %>

<script>
var serviceAnalytics = {
  weeklyData: <%- JSON.stringify(analytics && analytics.weeklyData ? Object.entries(analytics.weeklyData).map(([key, val]) => ({ week: key, bookings: val.bookings, revenue: val.revenue, completed: val.completed })) : []) %>,
  ratingDistribution: <%- JSON.stringify(analytics && analytics.ratingDistribution ? [analytics.ratingDistribution[5], analytics.ratingDistribution[4], analytics.ratingDistribution[3], analytics.ratingDistribution[2], analytics.ratingDistribution[1]] : [0,0,0,0,0]) %>,
  statusBreakdown: <%- JSON.stringify(analytics && analytics.statusBreakdown ? Object.entries(analytics.statusBreakdown).map(([status, count]) => ({ status: status, count: count })) : []) %>,
  dailyTrend: <%- JSON.stringify(analytics && analytics.dailyTrend ? analytics.dailyTrend : []) %>,
  topServices: <%- JSON.stringify(analytics && analytics.topServices ? analytics.topServices : []) %>,
  techUtilization: <%- JSON.stringify(analytics && analytics.techUtilization ? analytics.techUtilization : []) %>,
  weeklyCsat: <%- JSON.stringify(analytics && analytics.weeklyCsat ? analytics.weeklyCsat : []) %>,
  totalBookings: <%= analytics ? analytics.totalBookings : 0 %>,
  completedBookings: <%= analytics ? analytics.completedBookings : 0 %>,
  pendingBookings: <%= analytics ? analytics.pendingBookings : 0 %>,
  cancelledBookings: <%= analytics ? analytics.cancelledBookings : 0 %>,
  inProgressBookings: <%= analytics ? analytics.inProgressBookings : 0 %>,
  avgRating: <%= analytics ? analytics.avgRating : 0 %>,
  totalRevenue: <%= analytics ? analytics.totalRevenue : 0 %>,
  avgBookingValue: <%= analytics ? analytics.avgBookingValue : 0 %>,
  gcashBookings: <%= analytics ? analytics.gcashBookings : 0 %>,
  codBookings: <%= analytics ? analytics.codBookings : 0 %>,
  otherPaymentBookings: <%= analytics ? analytics.otherPaymentBookings : 0 %>,
  coreServiceBookings: <%= analytics ? analytics.coreServiceBookings : 0 %>,
  repairBookings: <%= analytics ? analytics.repairBookings : 0 %>,
  multiServiceBookings: <%= analytics ? analytics.multiServiceBookings : 0 %>,
  technicians: <%- JSON.stringify(analytics && analytics.technicians ? analytics.technicians : []) %>,
  technicianStats: <%- JSON.stringify(analytics && analytics.technicianStats ? analytics.technicianStats : {}) %>,
  topTechnicians: <%- JSON.stringify(analytics && analytics.topTechnicians ? analytics.topTechnicians : []) %>
};

function initCharts() {
  if (typeof Chart === "undefined" || typeof ChartDrilldown === "undefined") { return; }
  Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
  Chart.defaults.font.size = 11;
  Chart.defaults.color = '#64748b';
  Chart.defaults.elements.line.borderWidth = 2.5;

  var SA = serviceAnalytics;
  var total = SA.totalBookings || 1;
  var colors = ChartDrilldown.palette(8);

  /* -- Helper: open drilldown -- */
  function openDrill(title, subtitle, chartCfg, details, filters, filterField, summary) {
    ChartDrilldown.open({ title: title, subtitle: subtitle || 'Click any element to filter the details below', chartConfig: chartCfg, details: details, filters: filters || [], filterField: filterField || 'category', summary: summary || {} });
  }

  /* -- Booking Trend -- */
  var ctx1 = document.getElementById("serviceBookingTrendChart");
  if (ctx1) {
    var g1 = ctx1.getContext('2d').createLinearGradient(0,0,0,300); g1.addColorStop(0,'rgba(6,182,212,0.35)'); g1.addColorStop(1,'rgba(6,182,212,0.02)');
    var g2 = ctx1.getContext('2d').createLinearGradient(0,0,0,300); g2.addColorStop(0,'rgba(139,92,246,0.35)'); g2.addColorStop(1,'rgba(139,92,246,0.02)');
    var trendLabels = SA.dailyTrend.length > 0 ? SA.dailyTrend.map(function(d) { return d.day; }) : ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
    var trendBookings = SA.dailyTrend.length > 0 ? SA.dailyTrend.map(function(d) { return d.bookings; }) : [42,51,49,58,64,72,60];
    var trendCompleted = SA.dailyTrend.length > 0 ? SA.dailyTrend.map(function(d) { return d.completed; }) : [38,47,45,53,59,66,56];
