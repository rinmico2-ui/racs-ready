              <td class="ps-4 fw-semibold">Compressor Capacitor 45uF</td>
              <td>28</td>
              <td>25</td>
              <td>1.3</td>
              <td>21 days</td>
              <td>
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Medium</span>
              </td>
            </tr>
            <tr>
              <td class="ps-4 fw-semibold">Copper Tube 1/2</td>
              <td>90</td>
              <td>50</td>
              <td>2.8</td>
              <td>32 days</td>
              <td>
                <span class="badge bg-success-subtle text-success border border-success-subtle">Stable</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
</div>
