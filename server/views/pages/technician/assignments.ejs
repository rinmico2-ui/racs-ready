  function localPurchaseEscapeHtml(value) {
    return String(value == null ? '' : value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
  }

  function _renderReplacementPartsChoice() {
    const required = Boolean(window._inspReplacementPartsRequired);
    const yes = document.getElementById('replacementPartsYes');
    const no = document.getElementById('replacementPartsNo');
    const fields = document.getElementById('replacementPartsFields');
    const message = document.getElementById('noReplacementPartsMessage');
    if (yes) yes.checked = required;
    if (no) no.checked = !required;
    if (fields) fields.style.display = required ? '' : 'none';
    if (message) message.style.display = required ? 'none' : '';
  }

  window.setReplacementPartsRequired = function(required) {
    window._inspReplacementPartsRequired = Boolean(required);
    if (!required) (window._inspParts || []).forEach(part => { part.checked = false; });
    _renderReplacementPartsChoice();
    _renderPartsList();
    _updatePartsInventoryStatus();
    _saveInspectionState(_repairBookingId);
  };

  async function handleLocalPurchaseRepair(bookingId, outOfStockParts, notInInventoryParts, checkedParts, currentAssignment) {
    // Gather missing parts with their quoted prices from the assignment's quotation
    const allMissingNames = [...outOfStockParts, ...notInInventoryParts];
    const quotation = currentAssignment?.bookingId?.quotation || {};
    const qParts = quotation.parts || [];

    const missingPartsData = allMissingNames.map(name => {
      const qp = qParts.find(p => String(p.name || '').trim().toLowerCase() === String(name || '').trim().toLowerCase())
        || (checkedParts || []).find(p => String(p.name || '').trim().toLowerCase() === String(name || '').trim().toLowerCase());
      const quotedUnitPrice = Number(qp?.cost ?? qp?.sellingPrice ?? qp?.quotedCustomerPrice) || 0;
      return {
        partName: name,
        quotedCustomerPrice: quotedUnitPrice * (Number(qp?.quantity) || 1),
        toolId: qp?.toolId || null,
        quantity: qp?.quantity || 1,
      };
    });

    // Build confirmation modal HTML
    let html = `<div style="text-align:left;font-size:0.88rem;">`;

    // Technician info
    html += `<div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px;padding:12px 16px;margin-bottom:12px;">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
        <i class="bi bi-person-badge" style="color:#0369a1;font-size:1rem;"></i>
        <strong style="color:#0c4a6e;font-size:0.85rem;">Technician: ${localPurchaseEscapeHtml(window._technicianName || 'Unknown')}</strong>
      </div>`;

    // Time info
    if (currentAssignment?.startTime) {
      const now = new Date();
      const nowMin = now.getHours() * 60 + now.getMinutes();
      let nextBookingTime = '';
      let hasNext = false;
      if (currentAssignment.startTime) {
        const curStart = currentAssignment.startTime.split(':').map(Number);
        const curStartMin = curStart[0] * 60 + (curStart[1] || 0);
        const todayStr = now.toISOString().slice(0, 10);
        const todayBookings = (window._allAssignments || [])
          .filter(a => {
            const bd = new Date(a.bookingDate).toISOString().slice(0, 10);
            return bd === todayStr && a._id !== currentAssignment._id && a.status !== 'completed' && a.status !== 'cancelled';
          })
          .sort((a, b) => {
            const ta = (a.startTime || '99:99').split(':').map(Number);
            const tb = (b.startTime || '99:99').split(':').map(Number);
            return (ta[0]*60+ta[1]) - (tb[0]*60+tb[1]);
          });
        for (const nb of todayBookings) {
          if (nb.startTime) {
            const nbMin = nb.startTime.split(':').map(Number);
            const nbMinTotal = nbMin[0] * 60 + nbMin[1];
            if (nbMinTotal > curStartMin) {
              nextBookingTime = nb.startTime;
              hasNext = true;
              break;
            }
          }
        }
      }
      if (hasNext) {
        const nextMin = nextBookingTime.split(':').map(Number);
        const remaining = (nextMin[0] * 60 + nextMin[1]) - nowMin;
        const rh = Math.floor(remaining / 60);
        const rm = remaining % 60;
        html += `<div style="font-size:0.8rem;color:#0c4a6e;margin-top:4px;">
          <strong>Available repair time:</strong> ${rh}h ${rm}m<br>
          <strong>Next scheduled booking:</strong> ${nextBookingTime}
        </div>`;
      }
    }
    html += `</div>`;

    const supplierSearchAddress = currentAssignment?.address || currentAssignment?.bookingId?.location?.address || '';
    const supplierSearchQuery = encodeURIComponent(`repair parts supplier near ${supplierSearchAddress}`);
    html += `<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:12px 16px;margin-bottom:12px;">
      <div class="fw-semibold mb-2"><i class="bi bi-shop me-1"></i>Purchase Arrangement</div>
      <label class="form-label small mb-1">Purchase By</label>
      <select id="localPurchaseBy" class="form-select form-select-sm mb-2"><option value="technician">Technician</option><option value="customer">Customer</option></select>
      <div class="d-flex justify-content-between align-items-center"><label class="form-label small mb-1">Nearby Supplier</label><a href="https://www.google.com/maps/search/?api=1&query=${supplierSearchQuery}" target="_blank" rel="noopener" class="small"><i class="bi bi-geo-alt me-1"></i>Find Nearby Supplier</a></div>
      <input id="localSupplierName" class="form-control form-control-sm mb-2" placeholder="Supplier name">
      <input id="localSupplierAddress" class="form-control form-control-sm mb-2" placeholder="Supplier address">
      <input id="localSupplierContact" class="form-control form-control-sm mb-2" placeholder="Supplier contact (optional)">
      <label class="form-label small mb-1">Estimated purchase/travel time (minutes)</label><input id="localPurchaseMinutes" type="number" min="15" max="240" value="45" class="form-control form-control-sm mb-2">
      <label class="form-check small mb-2"><input id="localSupplierConfirmed" type="checkbox" class="form-check-input"><span class="form-check-label"> Supplier potentially has the correct part available</span></label>
      <label class="form-check small"><input id="localCustomerAgreed" type="checkbox" class="form-check-input"><span class="form-check-label"> Customer agrees to proceed under the approved quotation</span></label>
    </div>`;

    // Missing parts table
    html += `<div style="background:#fefce8;border:1px solid #fde68a;border-radius:8px;padding:12px 16px;margin-bottom:12px;">
      <div style="font-weight:600;color:#92400e;margin-bottom:8px;"><i class="bi bi-exclamation-triangle me-1"></i> Missing Parts — Purchase from Local Supplier</div>`;

    missingPartsData.forEach((p, i) => {
      html += `<div style="display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid #fef3c7;">
        <div>
          <div style="font-weight:600;color:#78350f;font-size:0.85rem;">${localPurchaseEscapeHtml(p.partName)}</div>
          <div style="font-size:0.75rem;color:#92400e;">Quoted Price: ₱${p.quotedCustomerPrice.toLocaleString()}</div>
        </div>
        <div style="display:flex;align-items:center;gap:6px;">
          <label style="font-size:0.75rem;color:#92400e;white-space:nowrap;">Expected Cost:</label>
          <input type="number" min="0" step="1" value="${p.quotedCustomerPrice}" id="localCost_${i}"
            class="form-control form-control-sm" style="width:110px;border-radius:6px;border-color:#fbbf24;font-size:0.82rem;"
            onchange="validateLocalCost(${i}, ${p.quotedCustomerPrice})" />
        </div>
      </div>`;
    });
    html += `</div>`;

    // Customer price warning
    html += `<div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:10px 14px;margin-bottom:12px;">
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
        <i class="bi bi-shield-lock" style="color:#dc2626;font-size:0.85rem;"></i>
        <strong style="color:#991b1b;font-size:0.82rem;">Customer Price Protected</strong>
      </div>
      <div style="font-size:0.75rem;color:#7f1d1d;">
        The customer's approved quotation will not change automatically. The actual supplier amount is recorded separately as a business cost and may reduce the repair margin.
      </div>
    </div>`;

    html += `</div>`;

    // Show confirmation modal
    const result = await Swal.fire({
      icon: 'info',
      title: 'Repair Now — Local Parts Purchase',
      html: html,
      showCancelButton: true,
      confirmButtonText: '<i class="bi bi-check-circle me-1"></i> Confirm & Repair Now',
      cancelButtonText: '<i class="bi bi-arrow-left me-1"></i> Go Back',
      confirmButtonColor: '#059669',
      cancelButtonColor: '#64748b',
      allowOutsideClick: false,
      allowEscapeKey: false,
      width: '520px',
      preConfirm: async () => {
        const purchaseBy = document.getElementById('localPurchaseBy')?.value || 'technician';
        const supplierName = document.getElementById('localSupplierName')?.value?.trim() || '';
        const supplierAddress = document.getElementById('localSupplierAddress')?.value?.trim() || '';
        const supplierContact = document.getElementById('localSupplierContact')?.value?.trim() || '';
        const purchaseMinutes = Number(document.getElementById('localPurchaseMinutes')?.value) || 45;
        const supplierCanProvide = Boolean(document.getElementById('localSupplierConfirmed')?.checked);
        const customerAgreed = Boolean(document.getElementById('localCustomerAgreed')?.checked);
        if (!supplierName || !supplierCanProvide || !customerAgreed) {
          Swal.showValidationMessage('Enter the supplier, confirm potential availability, and confirm customer agreement.');
          return false;
        }
        // Validate all costs
        const inputs = document.querySelectorAll('[id^="localCost_"]');
        inputs.forEach((input, i) => {
          const cost = parseFloat(input.value) || 0;
          const quoted = missingPartsData[i].quotedCustomerPrice;
          input.style.borderColor = cost > quoted && quoted > 0 ? '#f59e0b' : '#fbbf24';
        });
        // Collect values
        const localParts = missingPartsData.map((p, i) => ({
          partName: p.partName,
          quotedCustomerPrice: p.quotedCustomerPrice,
          expectedPurchaseCost: parseFloat(document.getElementById(`localCost_${i}`)?.value) || 0,
          toolId: p.toolId,
        }));
        try {
          const checkResponse = await fetch(`/api/technician/appointments/${bookingId}/local-purchase-feasibility`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
            body: JSON.stringify({ localParts, purchaseBy, customerAgreed, supplierName, supplierCanProvide, purchaseMinutes }),
          });
          const feasibility = await checkResponse.json();
          if (!checkResponse.ok || !feasibility.possible) {
            Swal.showValidationMessage(feasibility.message || feasibility.error || (feasibility.reasons || []).join(' ') || 'Local purchase cannot be completed without causing a schedule conflict.');
            return false;
          }
          return { localParts, purchaseBy, customerAgreed, supplierName, supplierAddress, supplierContact, supplierCanProvide, purchaseMinutes, feasibility };
        } catch (error) {
          console.error('[Local Purchase] Feasibility check failed:', error);
          Swal.showValidationMessage(error?.message || 'Could not verify schedule and purchase feasibility. Try again.');
          return false;
        }
      }
    });

    if (!result.isConfirmed) return;

    const { localParts, purchaseBy, customerAgreed, supplierName, supplierAddress, supplierContact, supplierCanProvide, purchaseMinutes } = result.value;

    // Submit to backend
    Swal.fire({ title: 'Checking Purchase Plan...', html: 'Validating supplier, customer approval, and schedule availability...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
    try {
      const resp = await fetch(`/api/technician/appointments/${bookingId}/local-purchase-repair`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ localParts, purchaseBy, customerAgreed, supplierName, supplierAddress, supplierContact, supplierCanProvide, purchaseMinutes }),
        credentials: 'same-origin'
      });
      const data = await resp.json();
      Swal.close();

      if (resp.ok && data.success) {
        if (data.requiresReceipt) {
          await showControlledLocalPurchaseReceiptPrompt(bookingId, data.localPurchase);
        } else if (data.requiresCustomerPartVerification) {
          await showCustomerPartVerificationPrompt(bookingId, data.localPurchase);
        }
      } else if (data.error === 'requires_revised_quotation') {
        Swal.fire({
          icon: 'warning',
          title: 'Revised Quotation Required',
          html: `<div style="font-size:0.9rem;text-align:left;">
            <p style="margin-bottom:8px;"><strong>${data.message}</strong></p>
            <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:10px 14px;">
              ${data.overpricedParts.map(p => `<div style="margin-bottom:4px;">
                <strong>${localPurchaseEscapeHtml(p.partName)}</strong><br>
                <span style="color:#991b1b;">Quoted: ₱${p.quotedPrice.toLocaleString()} → Local: ₱${p.localCost.toLocaleString()} (₱${p.difference.toLocaleString()} over)</span>
              </div>`).join('')}
            </div>
            <p style="margin-top:8px;color:#64748b;font-size:0.82rem;">Please revise the quotation and get customer approval before proceeding.</p>
          </div>`,
          confirmButtonColor: '#d97706',
        });
      } else {
        Swal.fire('Error', data.error || 'Failed to start repair.', 'error');
      }
    } catch (e) {
      Swal.close();
      Swal.fire('Error', 'Network error.', 'error');
    }
  }

  function validateLocalCost(index, quotedPrice) {
    const input = document.getElementById(`localCost_${index}`);
    if (!input) return;
    const cost = parseFloat(input.value) || 0;
    if (cost > quotedPrice) {
      input.style.borderColor = '#dc2626';
      input.style.boxShadow = '0 0 0 2px rgba(220,38,38,0.15)';
    } else {
      input.style.borderColor = '#fbbf24';
      input.style.boxShadow = 'none';
    }
  }

  async function showLocalPurchaseReceiptPrompt(bookingId, localPurchase) {
    if (!localPurchase || !localPurchase.length) return;
    for (let i = 0; i < localPurchase.length; i++) {
      const lp = localPurchase[i];
      const { value: receiptUrl } = await Swal.fire({
        title: `Upload Receipt — ${lp.partName}`,
        html: `<div style="text-align:left;font-size:0.88rem;">
          <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px;padding:10px 14px;margin-bottom:10px;">
            <div style="font-weight:600;color:#0c4a6e;font-size:0.85rem;">${esc(lp.partName)}</div>
            <div style="font-size:0.75rem;color:#0369a1;">Purchase Cost: ₱${(lp.actualPurchaseCost || 0).toLocaleString()}</div>
          </div>
          <p style="font-size:0.82rem;color:#475569;margin-bottom:8px;">Enter receipt URL or image link (optional but recommended for accountability):</p>
          <input type="text" id="receiptUrlInput" class="swal2-input" style="font-size:0.85rem;height:38px;" placeholder="https://... or paste image URL" />
        </div>`,
        icon: 'info',
        showCancelButton: true,
        confirmButtonText: 'Save Receipt',
        cancelButtonText: 'Skip',
        confirmButtonColor: '#2563eb',
      });

      if (receiptUrl) {
        try {
          await fetch(`/api/technician/appointments/${bookingId}/local-purchase-receipt`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ partIndex: i, receiptUrl }),
            credentials: 'same-origin'
          });
        } catch (e) { /* ignore */ }
      }
    }
  }

  async function showControlledLocalPurchaseReceiptPrompt(bookingId, purchases) {
    for (let index = 0; index < (purchases || []).length; index++) {
      const purchase = purchases[index];
      let completed = false;
      while (!completed) {
        const result = await Swal.fire({
          title: `Receipt — ${localPurchaseEscapeHtml(purchase.partName)}`,
          html: `<div class="text-start"><div class="alert alert-info py-2"><strong>${localPurchaseEscapeHtml(purchase.supplierName || 'External Supplier')}</strong><br><small>Expected cost: ₱${Number(purchase.expectedPurchaseCost || 0).toLocaleString()}</small></div><label class="form-label small">Actual cost</label><input id="controlledActualCost" type="number" min="0.01" step="0.01" value="${purchase.expectedPurchaseCost || ''}" class="form-control mb-2"><label class="form-label small">Quantity</label><input id="controlledQuantity" type="number" min="1" value="1" class="form-control mb-2"><label class="form-label small">Receipt photo/PDF (required)</label><input id="controlledReceipt" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" class="form-control mb-2"><textarea id="controlledReceiptNotes" class="form-control" placeholder="Optional notes"></textarea></div>`,
          confirmButtonText: 'Upload Receipt & Record Actual Cost', showCancelButton: false,
          allowOutsideClick: false, allowEscapeKey: false,
          preConfirm: () => {
            const file = document.getElementById('controlledReceipt')?.files?.[0];
            const actualPurchaseCost = Number(document.getElementById('controlledActualCost')?.value);
            if (!file || !(actualPurchaseCost > 0)) { Swal.showValidationMessage('Receipt and actual cost are required.'); return false; }
            return { file, actualPurchaseCost, quantity: Number(document.getElementById('controlledQuantity')?.value) || 1, notes: document.getElementById('controlledReceiptNotes')?.value || '' };
          },
        });
        if (!result.isConfirmed) continue;
        try {
          const form = new FormData(); form.append('receipt', result.value.file);
          const uploadResponse = await fetch('/api/technician/expenses/upload-receipt', { method: 'POST', body: form, credentials: 'same-origin' });
          const upload = await uploadResponse.json(); if (!uploadResponse.ok) throw new Error(upload.error || 'Receipt upload failed');
          const saveResponse = await fetch(`/api/technician/appointments/${bookingId}/local-purchase-receipt`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ partIndex: index, receiptUrl: upload.url, actualPurchaseCost: result.value.actualPurchaseCost, quantity: result.value.quantity, notes: result.value.notes }) });
          const saved = await saveResponse.json(); if (!saveResponse.ok) throw new Error(saved.error || 'Could not record purchase');
          completed = true;
          if (saved.repairStarted) await Swal.fire('Purchase Recorded', 'Receipt and actual cost recorded. Repair is now in progress.', 'success');
        } catch (error) { await Swal.fire('Receipt Required', error.message, 'error'); }
      }
    }
    refreshOpenAssignmentDetail('repair');
  }

  async function showCustomerPartVerificationPrompt(bookingId, purchases) {
    const names = (purchases || []).map(row => localPurchaseEscapeHtml(row.partName)).join(', ');
    const result = await Swal.fire({ icon: 'info', title: 'Customer Will Purchase Part',
      html: `<div class="text-start"><p>Wait until the customer obtains: <strong>${names}</strong>.</p><label class="form-check"><input id="customerCorrectPart" class="form-check-input" type="checkbox"><span class="form-check-label">I inspected and verified the customer obtained the correct part.</span></label><textarea id="customerPartNotes" class="form-control mt-3" placeholder="Verification notes"></textarea></div>`,
      showCancelButton: true, confirmButtonText: 'Customer Purchased — Start Repair', confirmButtonColor: '#059669',
      preConfirm: () => { if (!document.getElementById('customerCorrectPart')?.checked) { Swal.showValidationMessage('Verify the correct part first.'); return false; } return document.getElementById('customerPartNotes')?.value || ''; } });
    if (!result.isConfirmed) return;
    const response = await fetch(`/api/technician/appointments/${bookingId}/local-purchase/customer-verify`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ correctPartVerified: true, notes: result.value }) });
    const data = await response.json();
    if (!response.ok) return Swal.fire('Error', data.error || 'Could not verify part.', 'error');
    await Swal.fire('Part Verified', 'Customer-provided part verified. Repair is now in progress.', 'success');
    refreshOpenAssignmentDetail('repair');
  }

  async function startRepair(bookingId) {
    // Check parts availability and time constraints before starting
    const a = (window._allAssignments || []).find(x => String(x.bookingId?._id || x.bookingId) === String(bookingId))
      || window._detailAssignment;
    try {
      if (a) {
        const quotation = a.bookingId?.quotation || {};
        const parts = quotation.parts || [];
        const checkedParts = parts.filter(p => p.checked !== false);
        let hasOutOfStock = false;
        let outOfStockNames = [];

        // Check inventory if we have tool IDs
        for (const p of checkedParts) {
          if (p.toolId) {
            const inv = (window._inspInventoryStatus || {})[p.toolId];
            if (!inv || Number(inv.availableToBooking ?? inv.quantity ?? 0) < (p.quantity || 1)) {
              hasOutOfStock = true;
              outOfStockNames.push(p.name || 'Unknown part');
            }
          }
        }

        // Check time constraint — next booking soon?
        const parseTime = (t) => { if (!t) return null; const [h, m] = t.split(':').map(Number); return isNaN(h) ? null : h * 60 + (m || 0); };
        const currentAssignment = (window._allAssignments || []).find(x => (x.bookingId?._id || x.bookingId) === bookingId);
        let hasNextBookingSoon = false;
        if (currentAssignment && currentAssignment.startTime) {
          const currentStart = parseTime(currentAssignment.startTime);
          const now = new Date();
          const nowMinutes = now.getHours() * 60 + now.getMinutes();
          const todayStr = now.toISOString().slice(0, 10);
          const todayBookings = (window._allAssignments || [])
            .filter(x => {
              const bd = new Date(x.bookingDate).toISOString().slice(0, 10);
              return bd === todayStr && x._id !== currentAssignment._id && x.status !== 'completed' && x.status !== 'cancelled';
            })
            .sort((x, y) => (parseTime(x.startTime) || 9999) - (parseTime(y.startTime) || 9999));
          const nextBooking = todayBookings.find(x => {
            const t = parseTime(x.startTime);
            return t && currentStart !== null && t > currentStart;
          });
          if (nextBooking) {
            const nextStart = parseTime(nextBooking.startTime);
            const elapsed = nowMinutes - currentStart;
            const slotDuration = nextStart - currentStart;
            if (slotDuration > 0 && elapsed > slotDuration * 0.7) {
              hasNextBookingSoon = true;
            }
          }
        }

        if (hasOutOfStock) {
          const canBuyLocally = !hasNextBookingSoon;
          const result = await Swal.fire({
            icon: 'warning',
            title: 'Parts Unavailable',
            html: `<div style="font-size:0.85rem;">
              <p>The following parts are out of stock:</p>
              <p><strong>${outOfStockNames.join(', ')}</strong></p>
              ${canBuyLocally ? '<p style="margin-top:8px;color:#1e40af;">You can purchase these parts locally and complete the repair now.</p>' : '<p style="margin-top:8px;color:#991b1b;">Not enough time to purchase locally.</p>'}
            </div>`,
            showCancelButton: true,
            showDenyButton: canBuyLocally,
            confirmButtonText: '<i class="bi bi-shop me-1"></i> Buy Locally & Repair',
            denyButtonText: '<i class="bi bi-calendar me-1"></i> Schedule Later',
            cancelButtonText: '<i class="bi bi-x-circle me-1"></i> Cancel',
            confirmButtonColor: '#2563eb',
            denyButtonColor: '#059669',
            cancelButtonColor: '#dc2626',
          });
          if (result.isConfirmed) {
            await handleLocalPurchaseRepair(bookingId, outOfStockNames, [], checkedParts, currentAssignment);
          } else if (result.isDenied) {
            await handleScheduleLater(bookingId, outOfStockNames);
          }
          return;
        }

        if (hasNextBookingSoon) {
          Swal.fire({
            icon: 'warning',
            title: 'Insufficient Time',
            html: '<div style="font-size:0.85rem;">Your next booking is soon and there may not be enough time to complete this repair. Consider scheduling for later.</div>',
            showCancelButton: true,
            confirmButtonText: 'Start Anyway',
            cancelButtonText: 'Schedule Later',
            confirmButtonColor: '#059669'
          }).then((r) => { if (r.isConfirmed) _doStartRepair(bookingId); });
          return;
        }
      }
      await _doStartRepair(bookingId);
    } finally {
      document.querySelectorAll('.btn-loading').forEach(b => {
        b.classList.remove('btn-loading');
        b.disabled = false;
      });
    }
  }

  async function _doStartRepair(bookingId) {
    try {
      const resp = await fetch(`/api/technician/appointments/${bookingId}/start-repair`, {
        method: 'POST', credentials: 'same-origin'
      });
      const data = await resp.json();
      if (resp.ok && data.success) {
        Swal.fire('Started', 'Repair work is now in progress.', 'success').then(() => {
          loadAssignments(currentFilter, currentPage);
          if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
            showDetail(window._currentDetailId);
          }
        });
      } else {
        Swal.fire('Error', data.error || 'Failed to start repair.', 'error');
      }
    } catch (e) { Swal.fire('Error', 'Network error.', 'error'); }
  }

  async function completeRepair(bookingId) {
    try {
      // Fetch fresh booking data to check payment status
      const res = await fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' });
      const detail = await res.json();
      const booking = detail.booking || detail;

      const qTotal = booking.quotation?.totalCost || 0;
      const repairItems = Array.isArray(booking.services) ? booking.services : [];
      const isMixedBooking = booking.serviceType === 'mixed'
        || (repairItems.some(item => item.type === 'core') && repairItems.some(item => item.type === 'repair'));
      const paymentDue = isMixedBooking ? Number(booking.balanceAmount || 0) : qTotal;
      // Older repair collections may have been saved through the shared final-
      // balance endpoint. A fully collected balance is authoritative payment
      // evidence and must not trigger a second repair charge.
      const repairPaymentSettled = Boolean(booking.repairPaymentCollected || booking.balanceCollected);
      const needsRepairPay = !repairPaymentSettled && paymentDue > 0;
      const needsPayment = ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(booking.paymentMethod)
        && !booking.balanceCollected && (booking.balanceAmount || 0) > 0;

      // Step 1: If repair quotation payment needed, collect that first
      if (needsRepairPay) {
        Swal.fire({
          title: isMixedBooking ? 'Collect Booking Balance' : 'Collect Repair Payment',
          html: isMixedBooking
            ? `The shared Core + Repair booking balance of <strong>₱${paymentDue.toLocaleString()}</strong> must be collected before completing Repair.`
            : `The repair quotation of <strong>₱${qTotal.toLocaleString()}</strong> must be collected before completing.`,
          icon: 'info',
          confirmButtonText: 'Collect Payment',
          showCancelButton: true,
          cancelButtonText: 'Cancel',
        }).then(result => {
          if (result.isConfirmed) {
            collectRepairPayment(bookingId, paymentDue);
          }
        });
        return;
      }

      // Find the assignment for this booking
      const a = window._detailAssignment || {};
      let assignmentId = a._id;
      if (!assignmentId || String(a.bookingId?._id || a.bookingId) !== String(bookingId)) {
        const listRes = await fetch(`/api/technician/assignments?status=in_progress&limit=50`, { credentials: 'same-origin' });
        const listData = await listRes.json();
        const match = (listData.items || []).find(x => String(x.bookingId?._id || x.bookingId) === String(bookingId));
        if (match) assignmentId = match._id;
      }
      if (!assignmentId) {
        Swal.fire('Error', 'Assignment not found for this booking.', 'error');
        return;
      }

      // Step 2: If inspection balance needed, collect that before materials
      if (needsPayment) {
        const paymentData = {
          ...booking,
          _id: assignmentId,
          bookingId: booking,
          customerName: booking.customer?.name || a.customerName || '',
          serviceName: a.serviceName || booking.serviceType || '',
          address: booking.customer?.address || a.address || '',
          paymentMethod: booking.paymentMethod,
        };
        openModalAfterClose('materialsModal', 'assignDetailModal', () => {
          openCollectPaymentModal(paymentData._id, paymentData, false, function () {
            openMaterialsModal(bookingId);
          });
        });
      } else {
        // Step 3: Go straight to materials modal, then proof modal
        openModalAfterClose('materialsModal', 'assignDetailModal', () => openMaterialsModal(bookingId));
      }
    } catch (e) {
      Swal.fire('Error', 'Network error.', 'error');
    }
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // WORK GUIDE MODAL — AI-Powered Step-by-Step Repair Guide
  // ═════════════════════════════════════════════════════════════════════════════

  let _workGuideBookingId = null;
  let _workGuideAssignment = null;
  let _workGuideCheckedSteps = {};

  function _forceCleanModalState() {
    // Remove any lingering Bootstrap modal backdrops
    document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
    // Remove modal-open from body so scroll and interaction aren't blocked
    document.body.classList.remove('modal-open');
    document.body.classList.remove('work-guide-open');
    document.body.style.overflow = '';
    document.body.style.paddingRight = '';
  }

  async function openWorkGuideModal(bookingId, customerName, serviceName) {
    _workGuideBookingId = bookingId;
    _workGuideCheckedSteps = {};

    // Keep the active assignment visible behind the work guide.
    _forceCleanModalState();

    // Fetch assignment data to get AI assistant info
    try {
      const resp = await fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' });
      const detail = await resp.json();
      const booking = detail.booking || detail;
      const ta = booking.technicianAssistant;

      if (!ta || !ta.summary) {
        Swal.fire('No AI Data', 'AI diagnosis has not been generated yet for this job. Please generate it first from the AI Analysis tab.', 'info');
        return;
      }

      _workGuideAssignment = { booking, ta, customerName, serviceName };

      // Populate the modal
      _renderWorkGuideContent(ta, booking, customerName, serviceName);

      // Final cleanup before showing
      _forceCleanModalState();

      const workGuideEl = document.getElementById('workGuideModal');
      const modal = bootstrap.Modal.getOrCreateInstance(workGuideEl);
      // Tag body so backdrop gets elevated z-index via CSS
      document.body.classList.add('work-guide-open');
      workGuideEl.addEventListener('hidden.bs.modal', function onHide() {
        workGuideEl.removeEventListener('hidden.bs.modal', onHide);
        document.body.classList.remove('work-guide-open');
      }, { once: true });
      modal.show();
    } catch (e) {
      console.error('[WorkGuide] Error loading data:', e);
      Swal.fire('Error', 'Failed to load work guide data.', 'error');
    }
  }

  function _renderWorkGuideContent(ta, booking, customerName, serviceName) {
    // Subtitle
    document.getElementById('workGuideSubtitle').textContent = `${serviceName || 'Repair'} — ${customerName || 'Customer'}`;

    // Job info banner
    document.getElementById('workGuideJobInfo').innerHTML = `
      <div style="background:#fff;border:1px solid #e2e8f0;border-radius:var(--mw-radius-xs);overflow:hidden;box-shadow:var(--mw-shadow-sm);">
        <div style="background:linear-gradient(135deg,#0f172a,#1e3a5f);padding:12px 16px;">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
              <div style="width:28px;height:28px;border-radius:6px;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;">
                <i class="bi bi-wrench" style="color:#fff;font-size:0.72rem;"></i>
              </div>
              <span class="fw-bold" style="font-size:0.88rem;color:#fff;">${serviceName || 'Repair Service'}</span>
            </div>
            ${ta._webResearchUsed || ta.webResearchUsed ? '<span style="font-size:0.65rem;background:rgba(34,197,94,0.2);color:#4ade80;padding:3px 8px;border-radius:999px;font-weight:600;display:flex;align-items:center;gap:4px;"><i class="bi bi-globe2" style="font-size:0.6rem;"></i>Web Research</span>' : ''}
          </div>
        </div>
        <div style="padding:12px 16px;">
          <div class="d-flex gap-4" style="font-size:0.72rem;color:#64748b;">
            <span><i class="bi bi-person me-1" style="color:#2563eb;"></i>${customerName || 'Customer'}</span>
            <span><i class="bi bi-geo-alt me-1" style="color:#2563eb;"></i>${booking.customer?.address || 'N/A'}</span>
          </div>
          ${ta.summary ? `<div style="margin-top:10px;padding:10px 12px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:6px;font-size:0.78rem;color:#1e40af;line-height:1.5;display:flex;align-items:start;gap:6px;"><i class="bi bi-info-circle" style="color:#2563eb;margin-top:2px;flex-shrink:0;"></i>${ta.summary}</div>` : ''}
        </div>
      </div>`;

    // Safety reminders
    const safetyEl = document.getElementById('workGuideSafety');
    if (ta.safetyReminders && ta.safetyReminders.length > 0) {
      safetyEl.style.display = 'block';
      safetyEl.innerHTML = `
        <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:var(--mw-radius-xs);padding:14px 16px;border-left:4px solid #dc2626;">
          <div class="d-flex align-items-center gap-2 mb-2">
            <div style="width:26px;height:26px;border-radius:6px;background:#dc2626;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <i class="bi bi-shield-exclamation" style="color:#fff;font-size:0.75rem;"></i>
            </div>
            <div>
              <span class="fw-bold" style="font-size:0.85rem;color:#991b1b;">Safety First</span>
              <span style="font-size:0.68rem;color:#b91c1c;display:block;">Review these precautions before starting</span>
            </div>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px;">
            ${ta.safetyReminders.map(r => `<div style="display:flex;align-items:start;gap:8px;font-size:0.78rem;color:#7f1d1d;line-height:1.5;"><i class="bi bi-exclamation-diamond" style="color:#dc2626;font-size:0.65rem;margin-top:3px;flex-shrink:0;"></i>${r}</div>`).join('')}
          </div>
        </div>`;
    } else {
      safetyEl.style.display = 'none';
    }

    // Time & Complexity
    const timeEl = document.getElementById('workGuideTimeComplexity');
    const complexityColors = {
      low: { bg: '#f0fdf4', border: '#bbf7d0', text: '#166534', label: 'Simple', icon: 'bi-emoji-smile' },
      medium: { bg: '#fffbeb', border: '#fde68a', text: '#92400e', label: 'Moderate', icon: 'bi-emoji-neutral' },
      high: { bg: '#fef2f2', border: '#fecaca', text: '#991b1b', label: 'Complex', icon: 'bi-emoji-frown' },
      specialist_required: { bg: '#faf5ff', border: '#e9d5ff', text: '#6b21a8', label: 'Specialist Required', icon: 'bi-person-badge' }
    };
    const c = complexityColors[ta.repairComplexity] || complexityColors.medium;
    const dur = ta.estimatedDurationMinutes || 90;
    const hrs = Math.floor(dur / 60);
    const mins = dur % 60;
    const durText = hrs > 0 ? `${hrs}h ${mins > 0 ? mins + 'm' : ''}` : `${mins}m`;
    timeEl.innerHTML = `
      <div style="flex:1;background:#fff;border:1px solid #e2e8f0;border-radius:var(--mw-radius-xs);padding:14px;text-align:center;box-shadow:var(--mw-shadow-sm);">
        <div style="font-size:0.65rem;color:#64748b;text-transform:uppercase;font-weight:600;letter-spacing:0.5px;">Complexity</div>
        <div style="margin:6px 0 2px;">
          <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:8px;background:${c.bg};border:1px solid ${c.border};">
            <i class="bi ${c.icon}" style="color:${c.text};font-size:1rem;"></i>
          </span>
        </div>
        <div style="font-size:0.9rem;font-weight:700;color:${c.text};">${c.label}</div>
      </div>
      <div style="flex:1;background:#fff;border:1px solid #e2e8f0;border-radius:var(--mw-radius-xs);padding:14px;text-align:center;box-shadow:var(--mw-shadow-sm);">
        <div style="font-size:0.65rem;color:#64748b;text-transform:uppercase;font-weight:600;letter-spacing:0.5px;">Est. Duration</div>
        <div style="margin:6px 0 2px;">
          <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:8px;background:#eff6ff;border:1px solid #bfdbfe;">
            <i class="bi bi-clock" style="color:#2563eb;font-size:1rem;"></i>
          </span>
        </div>
        <div style="font-size:0.9rem;font-weight:700;color:#2563eb;">${durText}</div>
      </div>`;

    // Inspection Checklist (interactive)
    const checklistSteps = document.getElementById('workGuideChecklistSteps');
    if (ta.inspectionChecklist && ta.inspectionChecklist.length > 0) {
      checklistSteps.innerHTML = ta.inspectionChecklist.map((item, i) => {
        const stepNum = item.step || (i + 1);
        return `
          <div class="work-guide-step" data-step="${stepNum}" style="background:#fff;border:1px solid #e2e8f0;border-radius:var(--mw-radius-xs);padding:12px 14px;margin-bottom:8px;cursor:pointer;transition:var(--mw-transition);box-shadow:var(--mw-shadow-sm);" onclick="toggleWorkGuideStep(${stepNum})">
            <div class="d-flex align-items-start gap-3">
              <div class="work-guide-step-check" data-step="${stepNum}" style="width:26px;height:26px;border-radius:6px;border:2px solid #cbd5e1;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:var(--mw-transition);background:transparent;">
                <i class="bi bi-check-lg" style="font-size:0.85rem;color:#fff;opacity:0;transition:opacity 0.2s;"></i>
              </div>
              <div class="flex-grow-1" style="min-width:0;">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <span style="font-size:0.6rem;background:#eff6ff;color:#2563eb;padding:1px 8px;border-radius:4px;font-weight:700;">STEP ${stepNum}</span>
                </div>
                <div style="font-size:0.85rem;font-weight:600;color:#0f172a;line-height:1.4;">${item.action || ''}</div>
                ${item.whatToLookFor ? `<div style="font-size:0.72rem;color:#64748b;margin-top:4px;line-height:1.5;display:flex;align-items:start;gap:4px;"><i class="bi bi-eye" style="color:#2563eb;margin-top:2px;flex-shrink:0;"></i>${item.whatToLookFor}</div>` : ''}
              </div>
              ${item.expectedTool ? `<span style="font-size:0.6rem;background:#f1f5f9;color:#475569;padding:2px 8px;border-radius:4px;font-weight:500;white-space:nowrap;flex-shrink:0;display:flex;align-items:center;gap:4px;height:fit-content;"><i class="bi bi-tools" style="color:#2563eb;"></i>${item.expectedTool}</span>` : ''}
            </div>
          </div>`;
      }).join('');
    } else {
      checklistSteps.innerHTML = `<div style="text-align:center;padding:24px;color:#94a3b8;font-size:0.85rem;">
        <i class="bi bi-clipboard-check" style="font-size:1.5rem;display:block;margin-bottom:8px;"></i>No inspection checklist available.
      </div>`;
    }

    // Update progress
    _updateWorkGuideProgress(ta);

    // Tools
    const toolsSection = document.getElementById('workGuideToolsSection');
    const toolsList = document.getElementById('workGuideToolsList');
    if (toolsSection) {
      if (ta.suggestedTools && ta.suggestedTools.length > 0 && toolsList) {
        toolsSection.style.display = 'block';
        toolsList.innerHTML = ta.suggestedTools.map(t => `
        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:var(--mw-radius-xs);padding:8px 12px;display:flex;align-items:center;gap:8px;box-shadow:var(--mw-shadow-sm);">
          <div style="width:28px;height:28px;border-radius:6px;background:#eff6ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="bi bi-wrench" style="color:#2563eb;font-size:0.75rem;"></i>
          </div>
          <div>
            <div style="font-size:0.78rem;font-weight:600;color:#1e293b;">${t.name || t}</div>
            ${t.purpose ? `<div style="font-size:0.68rem;color:#64748b;">${t.purpose}</div>` : ''}
          </div>
        </div>`).join('');
      } else {
        toolsSection.style.display = 'none';
      }
    }

    // Probable Causes
    const causesSection = document.getElementById('workGuideCausesSection');
    const causesList = document.getElementById('workGuideCausesList');
    if (causesSection) {
      if (ta.probableCauses && ta.probableCauses.length > 0 && causesList) {
        causesSection.style.display = 'block';
        causesList.innerHTML = ta.probableCauses.map(c => {
          const lc = c.likelihood === 'high' ? '#dc2626' : c.likelihood === 'medium' ? '#d97706' : '#6b7280';
          const lbg = c.likelihood === 'high' ? '#fef2f2' : c.likelihood === 'medium' ? '#fffbeb' : '#f9fafb';
          const borderC = c.likelihood === 'high' ? '#fecaca' : c.likelihood === 'medium' ? '#fde68a' : '#e2e8f0';
          return `
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:var(--mw-radius-xs);padding:12px 14px;margin-bottom:8px;box-shadow:var(--mw-shadow-sm);border-left:3px solid ${lc};">
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="fw-semibold" style="font-size:0.82rem;color:#1e293b;">${c.cause || c}</span>
              <span style="font-size:0.58rem;background:${lc};color:#fff;padding:2px 8px;border-radius:4px;font-weight:600;text-transform:uppercase;">${c.likelihood || 'medium'}</span>
            </div>
            ${c.explanation ? `<div style="font-size:0.72rem;color:#64748b;line-height:1.5;margin-top:4px;padding-top:6px;border-top:1px solid #f1f5f9;">${c.explanation}</div>` : ''}
          </div>`;
        }).join('');
      } else {
        causesSection.style.display = 'none';
      }
    }

    // Parts
    const partsSection = document.getElementById('workGuidePartsSection');
    const partsList = document.getElementById('workGuidePartsList');
    if (partsSection) {
      if (ta.possibleParts && ta.possibleParts.length > 0 && partsList) {
        partsSection.style.display = 'block';
        partsList.innerHTML = ta.possibleParts.map(p => {
          const name = typeof p === 'string' ? p : (p.name || p);
          const cost = typeof p === 'object' ? (p.estimatedCostPHP || 0) : 0;
          const likelihood = typeof p === 'object' ? (p.likelihood || 'medium') : 'medium';
          const purpose = typeof p === 'object' ? (p.purpose || '') : '';
          const lc = likelihood === 'high' ? '#dc2626' : likelihood === 'medium' ? '#d97706' : '#6b7280';
          const lbg = likelihood === 'high' ? '#fef2f2' : likelihood === 'medium' ? '#fffbeb' : '#f8fafc';
          return `
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:var(--mw-radius-xs);padding:10px 14px;margin-bottom:6px;box-shadow:var(--mw-shadow-sm);">
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center gap-2">
                <div style="width:24px;height:24px;border-radius:6px;background:${lbg};display:flex;align-items:center;justify-content:center;">
                  <i class="bi bi-box" style="color:${lc};font-size:0.7rem;"></i>
                </div>
                <div>
                  <span class="fw-semibold" style="font-size:0.82rem;color:#1e293b;">${name}</span>
                  <span style="font-size:0.58rem;background:${lc};color:#fff;padding:1px 8px;border-radius:4px;display:inline-block;margin-left:6px;text-transform:uppercase;">${likelihood}</span>
                </div>
              </div>
              ${cost > 0 ? `<span style="font-size:0.82rem;font-weight:700;color:#059669;">₱${Number(cost).toLocaleString()}</span>` : ''}
            </div>
            ${purpose ? `<div style="font-size:0.72rem;color:#64748b;margin-top:4px;padding-top:4px;border-top:1px solid #f1f5f9;">${purpose}</div>` : ''}
          </div>`;
        }).join('');
      } else {
        partsSection.style.display = 'none';
      }
    }

    // Additional Notes
    const notesSection = document.getElementById('workGuideNotesSection');
    if (notesSection) {
      if (ta.additionalNotes) {
        notesSection.style.display = 'block';
        notesSection.innerHTML = `
        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:var(--mw-radius-xs);padding:14px 16px;box-shadow:var(--mw-shadow-sm);">
          <div class="d-flex align-items-center gap-2 mb-2">
            <div style="width:24px;height:24px;border-radius:6px;background:#eff6ff;display:flex;align-items:center;justify-content:center;">
              <i class="bi bi-info-circle" style="color:#2563eb;font-size:0.72rem;"></i>
            </div>
            <span class="fw-bold" style="font-size:0.85rem;color:#0f172a;">Additional Notes</span>
          </div>
          <div style="font-size:0.78rem;color:#475569;line-height:1.7;">${ta.additionalNotes}</div>
        </div>`;
      } else {
        notesSection.style.display = 'none';
      }
    }
  }

  function toggleWorkGuideStep(stepNum) {
    _workGuideCheckedSteps[stepNum] = !_workGuideCheckedSteps[stepNum];
    const stepEl = document.querySelector(`.work-guide-step[data-step="${stepNum}"]`);
    const checkEl = document.querySelector(`.work-guide-step-check[data-step="${stepNum}"]`);
    if (!stepEl || !checkEl) return;

    const isChecked = _workGuideCheckedSteps[stepNum];
    const iconEl = checkEl.querySelector('i');
    if (isChecked) {
      stepEl.style.background = '#f0fdf4';
      stepEl.style.borderColor = '#86efac';
      stepEl.style.boxShadow = '0 1px 3px rgba(5,150,105,0.1)';
      checkEl.style.background = '#059669';
      checkEl.style.borderColor = '#059669';
      checkEl.style.boxShadow = '0 2px 6px rgba(5,150,105,0.3)';
      if (iconEl) iconEl.style.opacity = '1';
      stepEl.style.cursor = 'default';
    } else {
      stepEl.style.background = '#fff';
      stepEl.style.borderColor = '#e2e8f0';
      stepEl.style.boxShadow = 'var(--mw-shadow-sm)';
      checkEl.style.background = 'transparent';
      checkEl.style.borderColor = '#cbd5e1';
      checkEl.style.boxShadow = 'none';
      if (iconEl) iconEl.style.opacity = '0';
      stepEl.style.cursor = 'pointer';
    }

    _updateWorkGuideProgress(_workGuideAssignment?.ta);
  }

  function _updateWorkGuideProgress(ta) {
    if (!ta || !ta.inspectionChecklist) return;
    const total = ta.inspectionChecklist.length;
    const completed = Object.values(_workGuideCheckedSteps).filter(Boolean).length;
    const pct = total > 0 ? Math.round((completed / total) * 100) : 0;

    const progressText = document.getElementById('workGuideProgressText');
    const progressBar = document.getElementById('workGuideProgressBar');
    const completeBtn = document.getElementById('workGuideCompleteBtn');
    if (!progressText || !progressBar) return;

    progressText.textContent = `${completed} / ${total} steps`;
    progressBar.style.width = pct + '%';

    if (pct === 100) {
      progressBar.style.background = 'linear-gradient(90deg,#059669,#10b981)';
    } else {
      progressBar.style.background = 'linear-gradient(90deg,#3b82f6,#60a5fa)';
    }
    if (completeBtn) completeBtn.disabled = false;
  }

  function openWorkGuideInspection() {
    if (!_workGuideBookingId || !_workGuideAssignment) return;
    const { customerName, serviceName } = _workGuideAssignment;
    // Close work guide modal and open inspection modal
    const wgModal = bootstrap.Modal.getInstance(document.getElementById('workGuideModal'));
    if (wgModal) wgModal.hide();
    setTimeout(() => {
      openInspectionModal(_workGuideBookingId, customerName, serviceName);
    }, 300);
  }
</script>

<script>
(function () {
  const params = new URLSearchParams(window.location.search);
  window._dailyKitRequestedDate = params.get('date') || null;
  if (params.get('openDailyKit') === '1') {
    const openPreparation = function () {
      if (typeof window.openDailyKitModal === 'function') window.openDailyKitModal();
      else setTimeout(openPreparation, 250);
    };
    setTimeout(openPreparation, 300);
  }
  const projectId = params.get('projectId');
  if (!projectId) return;
  function tryOpen() {
    if (window.pwViewDetails && window.__pwData && window.__pwData.length) {
      window.pwViewDetails(projectId);
    } else {
      setTimeout(tryOpen, 300);
    }
  }
  tryOpen();
})();
</script>
