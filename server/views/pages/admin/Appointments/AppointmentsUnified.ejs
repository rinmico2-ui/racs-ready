      '<th>Reference</th><th>Customer</th><th>Service</th><th>Technician</th><th>Amount</th><th>Status</th><th class="text-center">Actions</th>'+
      '</tr></thead><tbody>'+
      bookings.map(function(b){
        var dt=new Date(b.bookingDate).toLocaleDateString('en-US',{month:'short',day:'numeric'});
        var svc=b.service?b.service.name:(b.services&&b.services[0]?b.services[0].name:(b.serviceModel==='RepairService'||b.serviceType==='repair'?'Repair Service':'N/A'));
        var ref=b.bookingReference||b.workOrderNumber||'N/A';
        return '<tr>'+
          '<td><button class="btn btn-link p-0 text-decoration-none fw-bold workflow-record-ref" type="button" onclick="AU.Completed.viewDetail(\''+b._id+'\')">'+ref+'</button><div class="small text-muted mt-1">'+dt+'</div></td>'+
          '<td><strong>'+(b.customer?b.customer.name:'N/A')+'</strong><div class="small text-muted">'+(b.customer?b.customer.phone:'')+'</div></td>'+
          '<td class="small">'+svc+'</td>'+
          '<td>'+(b.technician&&b.technician.name?'<strong>'+b.technician.name+'</strong>':'<span class="text-muted">Unassigned</span>')+'</td>'+
          '<td class="fw-bold text-nowrap">\u20B1'+(b.totalPrice||b.estimatedFee||0).toLocaleString()+'</td>'+
          '<td><span class="st-badge st-completed">Completed</span></td>'+
          '<td><div class="d-flex flex-wrap justify-content-center gap-1"><button class="btn btn-sm btn-primary" onclick="AU.Completed.viewDetail(\''+b._id+'\')"><i class="bi bi-eye me-1"></i>View</button></div></td>'+
          '</tr>';
      }).join('')+
      '</tbody></table></div></div>';
