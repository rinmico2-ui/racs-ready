<div class="admin-dashboard container-fluid py-4 settings-roles-page">
  <%- include('../../../partials/dashboard-styles') %>

  <style>
    /* ── Role Cards ─────────────────────────────────────── */
    .role-card {
      border: 0;
      border-radius: var(--dash-card-radius);
      box-shadow: var(--dash-card-shadow);
      background: #fff;
      padding: 22px 24px;
      cursor: pointer;
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s;
      position: relative;
      overflow: hidden;
      border: 2px solid transparent;
    }
    .role-card:hover { transform: translateY(-3px); box-shadow: var(--dash-hover-shadow); }
    .role-card.active { border-color: var(--dash-primary); box-shadow: 0 0 0 3px rgba(37, 99, 235, .18); }
    .role-card .role-icon {
      width: 48px; height: 48px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.25rem; flex-shrink: 0; color: #fff;
    }
    .role-card .role-label { font-size: 1rem; font-weight: 700; color: #0f172a; }
    .role-card .role-desc  { font-size: .75rem; color: #94a3b8; margin-top: 2px; }
    .role-card .role-meta  { font-size: .72rem; color: #64748b; margin-top: 8px; }
    .role-card .role-bar {
      position: absolute; bottom: 0; left: 0; right: 0; height: 3px;
      border-radius: 0 0 var(--dash-card-radius) var(--dash-card-radius);
    }

    /* ── Permission Matrix ──────────────────────────────── */
    .perm-group { margin-bottom: 18px; }
    .perm-group-title {
      font-size: .78rem; font-weight: 800; text-transform: uppercase;
      letter-spacing: .06em; color: #94a3b8; margin-bottom: 8px;
      border-bottom: 1px solid var(--dash-border); padding-bottom: 6px;
    }
    .perm-item {
      display: flex; align-items: center; justify-content: space-between;
      padding: 7px 12px; border-radius: 8px;
      transition: background .12s;
    }
    .perm-item:hover { background: #f8fafc; }
    .perm-item label { font-size: .82rem; color: #1e293b; font-weight: 500; cursor: pointer; margin: 0; }

    /* toggle switch */
    .switch { position: relative; display: inline-block; width: 38px; height: 22px; flex-shrink: 0; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .switch .slider {
      position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
      background: #ccc; border-radius: 22px; transition: .25s;
    }
    .switch .slider::before {
      content: ""; position: absolute; height: 16px; width: 16px;
      left: 3px; bottom: 3px; background: #fff; border-radius: 50%;
      transition: .25s;
    }
    .switch input:checked + .slider { background: var(--dash-primary); }
    .switch input:checked + .slider::before { transform: translateX(16px); }

    /* ── User Override Panel ────────────────────────────── */
    .user-row {
      display: flex; align-items: center; gap: 12px;
      padding: 10px 14px; border-bottom: 1px solid var(--dash-border);
      transition: background .12s;
    }
    .user-row:hover { background: #f8fafc; }
    .user-row:last-child { border-bottom: none; }
    .user-avatar {
      width: 34px; height: 34px; border-radius: 50%;
      background: var(--dash-primary-light); color: var(--dash-primary);
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: .78rem; flex-shrink: 0;
    }
    .user-name  { font-size: .82rem; font-weight: 600; color: #0f172a; }
    .user-email { font-size: .75rem; color: #94a3b8; }
    .user-badge {
      font-size: .65rem; font-weight: 700; padding: .15rem .45rem;
      border-radius: 999px; letter-spacing: .03em;
    }
    .badge-custom  { background: rgba(245, 158, 11, 0.15); color: #d97706; }
    .badge-default { background: rgba(16, 185, 129, 0.12); color: #059669; }

    /* ── Toasts ─────────────────────────────────────────── */
    .toast-container {
      position: fixed; bottom: 24px; right: 24px; z-index: 9999;
      display: flex; flex-direction: column; gap: 8px;
    }
    .toast-msg {
      background: #0f172a; color: #fff; padding: 10px 20px;
      border-radius: 10px; font-size: .82rem; font-weight: 500;
      box-shadow: 0 4px 16px rgba(0,0,0,.18);
      animation: slideIn .3s ease;
    }
    .toast-msg.toast-error { background: var(--dash-danger); }
    @keyframes slideIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  </style>

  <!-- Hero -->
  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-shield-lock"></i></div>
        <div>
          <h1>Role Management</h1>
          <p>Define, modify, and assign access permissions across user roles</p>
        </div>
      </div>
    </div>
  </div>
    </div>
  </div>

  <!-- Role Cards -->
  <div class="row g-4 mb-4" id="roleCards">
    <% const colors = { admin: ['#4361ee','#3a0ca3'], secretary: ['#2ec4b6','#1a8f85'], technician: ['#ff9f1c','#ff7422'], customer: ['#7b2d8b','#5a1d68'] }; %>
    <% const icons  = { admin: 'bi-person-fill-gear', secretary: 'bi-person-badge', technician: 'bi-tools', customer: 'bi-person' }; %>
    <% (roles || []).forEach(function(r) { %>
      <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
        <div class="role-card h-100" data-role-id="<%= r._id %>" data-role-name="<%= r.name %>">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="role-icon" style="background: linear-gradient(135deg, <%= (colors[r.name]||['#6b7280','#4b5563'])[0] %>, <%= (colors[r.name]||['#6b7280','#4b5563'])[1] %>)">
              <i class="bi <%= icons[r.name] || 'bi-person' %>"></i>
            </div>
            <div>
              <div class="role-label"><%= r.label || r.name %></div>
              <div class="role-desc"><%= r.description || '' %></div>
            </div>
          </div>
          <div class="role-meta mt-auto">
            <div class="d-flex gap-2 text-muted mt-2">
              <span><i class="bi bi-people-fill me-1"></i><%= r.userCount || 0 %> user<%= (r.userCount||0) === 1 ? '' : 's' %></span>
              <span>&middot;</span>
              <span><i class="bi bi-key-fill me-1"></i><%= (r.permissions||[]).length %></span>
              <% if (r.isSystem) { %><span>&middot;</span><span class="text-secondary"><i class="bi bi-lock-fill"></i> system</span><% } %>
            </div>
          </div>
          <div class="role-bar" style="background: linear-gradient(90deg, <%= (colors[r.name]||['#6b7280','#4b5563'])[0] %>, <%= (colors[r.name]||['#6b7280','#4b5563'])[1] %>)"></div>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="row g-4">
    <div class="col-lg-7">
      <!-- Permission Matrix (shown when a role is selected) -->
      <div id="permPanel" class="card shadow-sm h-100" style="display:none;">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
              <h5 class="fw-bold mb-1" id="permPanelTitle">Permissions</h5>
              <p class="text-muted small mb-0" id="permPanelDesc"></p>
            </div>
            <div class="d-flex gap-2">
              <button class="btn btn-sm btn-light" id="btnSelectAll"><i class="bi bi-check-all me-1"></i>Select All</button>
              <button class="btn btn-sm btn-light" id="btnDeselectAll"><i class="bi bi-x-lg me-1"></i>Clear</button>
              <button class="btn btn-sm btn-primary" id="btnSavePerms"><i class="bi bi-floppy me-1"></i>Save</button>
            </div>
          </div>
          <div id="permMatrix" class="pe-2" style="max-height: 500px; overflow-y: auto;"></div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-5">
      <!-- Users in Role (shown when a role is selected) -->
      <div id="usersPanel" class="card shadow-sm h-100" style="display:none;">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <h5 class="fw-bold mb-0" id="usersPanelTitle">Users</h5>
            <span class="badge bg-primary rounded-pill px-3 py-2" id="usersPanelCount"></span>
          </div>
          <div id="usersList" class="pe-2"></div>
          <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
            <div id="users-range" class="text-muted small"></div>
            <nav aria-label="Users pagination">
              <ul id="users-pagination" class="pagination pagination-sm mb-0"></ul>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- User Permission Override Modal -->
  <div class="modal fade" id="userPermModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="userPermModalTitle">User Permission Overrides</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="userPermBody"></div>
        <div class="modal-footer">
          <button class="btn btn-outline-secondary btn-sm" id="btnResetUserPerms"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Role Defaults</button>
          <button class="btn btn-primary btn-sm" id="btnSaveUserPerms"><i class="bi bi-floppy me-1"></i>Save Overrides</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div class="toast-container" id="toastBox"></div>
</div>

<script>
(function () {
  "use strict";

  /* ── Server-injected data ─────────────────────────────── */
  const ROLES   = <%- JSON.stringify(roles || []) %>;
  const CATALOG = <%- JSON.stringify(catalog || []) %>;
  const API     = "/api/admin";

  let selectedRoleId   = null;
  let selectedRoleName = null;
  let userPermUserId   = null;

  /* ── Toast helper ─────────────────────────────────────── */
  function toast(msg, isError) {
    const box = document.getElementById("toastBox");
    const el  = document.createElement("div");
    el.className = "toast-msg" + (isError ? " toast-error" : "");
    el.textContent = msg;
    box.appendChild(el);
    setTimeout(() => el.remove(), 3200);
  }

  /* ── Permission matrix builder ────────────────────────── */
  function renderPermMatrix(activePerms, containerId, prefix) {
    const container = document.getElementById(containerId);
    container.innerHTML = "";
    CATALOG.forEach(function (group) {
      const div = document.createElement("div");
      div.className = "perm-group";
      let html = '<div class="perm-group-title">' + group.group + "</div>";
      group.permissions.forEach(function (p) {
        const checked = activePerms.includes(p.key) ? "checked" : "";
        const id = prefix + "-" + p.key.replace(/\./g, "-");
        html +=
          '<div class="perm-item">' +
            '<label for="' + id + '">' + p.label + ' <code class="text-muted" style="font-size:.68rem">(' + p.key + ')</code></label>' +
            '<label class="switch"><input type="checkbox" id="' + id + '" data-perm="' + p.key + '" ' + checked + '><span class="slider"></span></label>' +
          '</div>';
      });
      div.innerHTML = html;
      container.appendChild(div);
    });
  }

  function getCheckedPerms(containerId) {
    var checks = document.querySelectorAll("#" + containerId + " input[data-perm]");
    var out = [];
    checks.forEach(function (cb) { if (cb.checked) out.push(cb.dataset.perm); });
    return out;
  }

  /* ── Role card click ──────────────────────────────────── */
  document.getElementById("roleCards").addEventListener("click", function (e) {
    var card = e.target.closest(".role-card");
    if (!card) return;
    document.querySelectorAll(".role-card").forEach(function (c) { c.classList.remove("active"); });
    card.classList.add("active");
    selectedRoleId   = card.dataset.roleId;
    selectedRoleName = card.dataset.roleName;
    loadRoleDetails(selectedRoleId);
  });

  async function loadRoleDetails(roleId) {
    try {
      var resp = await fetch(API + "/roles/" + roleId);
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || "Failed");
      var role = data.role;

      // permission panel
      document.getElementById("permPanelTitle").textContent = (role.label || role.name) + " — Permissions";
      document.getElementById("permPanelDesc").textContent  = role.description || "";
      renderPermMatrix(role.permissions || [], "permMatrix", "rp");
      document.getElementById("permPanel").style.display = "";

      // users panel
      loadRoleUsers(roleId, role.label || role.name);
    } catch (err) {
      toast(err.message, true);
    }
  }

  let currentUsersData = [];
  let userPageSize = 5;
  let userCurrentPage = 1;

  function renderUsersPage(page) {
    var start = (page - 1) * userPageSize;
    var slice = currentUsersData.slice(start, start + userPageSize);
    var html = "";
    if (currentUsersData.length === 0) {
      html = '<div class="dash-empty"><i class="bi bi-person-x"></i>No users with this role.</div>';
    } else {
      slice.forEach(function (u) {
        var initials = ((u.firstName || "")[0] || "") + ((u.lastName || "")[0] || "");
        var hasCustom = Array.isArray(u.permissions) && u.permissions.length > 0;
        html +=
          '<div class="user-row" data-user-id="' + u._id + '">' +
            '<div class="user-avatar">' + (initials || '<i class="bi bi-person"></i>') + '</div>' +
            '<div class="flex-grow-1">' +
              '<div class="user-name">' + (u.firstName || "") + " " + (u.lastName || "") + '</div>' +
              '<div class="user-email text-micro">' + (u.email || "") + '</div>' +
            '</div>' +
            '<span class="user-badge ' + (hasCustom ? 'badge-custom' : 'badge-default') + '">' +
              (hasCustom ? '<i class="bi bi-pencil-square me-1"></i>Custom' : '<i class="bi bi-check-circle me-1"></i>Default') +
            '</span>' +
            '<button class="btn btn-micro btn-outline-primary btn-edit-user-perms ms-2" data-user-id="' + u._id + '" data-user-name="' + ((u.firstName||"") + " " + (u.lastName||"")) + '" data-user-perms=\'' + JSON.stringify(u.permissions || []) + '\' title="Edit permissions">' +
              '<i class="bi bi-sliders"></i>' +
            '</button>' +
          '</div>';
      });
    }
    document.getElementById("usersList").innerHTML = html;

    // pagination metadata
    const rangeEl = document.getElementById("users-range");
    const total = currentUsersData.length;
    if (total === 0) {
      rangeEl.textContent = "—";
      document.getElementById("users-pagination").innerHTML = "";
      return;
    }
    const from = start + 1;
    const to = Math.min(start + userPageSize, total);
    rangeEl.textContent = `${from} to ${to} of ${total}`;

    const pages = Math.ceil(total / userPageSize);
    const ul = document.getElementById('users-pagination');
    ul.innerHTML = '';
    
    const prevLi = document.createElement('li');
    prevLi.className = 'page-item' + (userCurrentPage <= 1 ? ' disabled' : '');
    prevLi.innerHTML = `<a class="page-link" href="#" aria-label="Previous"><span aria-hidden="true">&laquo;</span></a>`;
    prevLi.addEventListener('click', (e) => { e.preventDefault(); if (userCurrentPage > 1) { userCurrentPage--; renderUsersPage(userCurrentPage); } });
    ul.appendChild(prevLi);
    
    const indicatorLi = document.createElement('li');
    indicatorLi.className = 'page-item disabled mx-2';
    indicatorLi.innerHTML = `<span class="page-link">${userCurrentPage} of ${pages}</span>`;
    ul.appendChild(indicatorLi);
    
    const nextLi = document.createElement('li');
    nextLi.className = 'page-item' + (userCurrentPage >= pages ? ' disabled' : '');
    nextLi.innerHTML = `<a class="page-link" href="#" aria-label="Next"><span aria-hidden="true">&raquo;</span></a>`;
    nextLi.addEventListener('click', (e) => { e.preventDefault(); if (userCurrentPage < pages) { userCurrentPage++; renderUsersPage(userCurrentPage); } });
    ul.appendChild(nextLi);
  }

  async function loadRoleUsers(roleId, label) {
    try {
      var resp = await fetch(API + "/roles/" + roleId + "/users");
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || "Failed");
      
      currentUsersData = data.users || [];
      userCurrentPage = 1;

      document.getElementById("usersPanelTitle").textContent = label + " — Users";
      document.getElementById("usersPanelCount").textContent = currentUsersData.length + " user" + (currentUsersData.length === 1 ? "" : "s");
      
      renderUsersPage(userCurrentPage);
      document.getElementById("usersPanel").style.display = "";
    } catch (err) {
      toast(err.message, true);
    }
  }

  /* ── Select All / Deselect All ────────────────────────── */
  document.getElementById("btnSelectAll").addEventListener("click", function () {
    document.querySelectorAll("#permMatrix input[data-perm]").forEach(function (cb) { cb.checked = true; });
  });
  document.getElementById("btnDeselectAll").addEventListener("click", function () {
    document.querySelectorAll("#permMatrix input[data-perm]").forEach(function (cb) { cb.checked = false; });
  });

  /* ── Save role permissions ────────────────────────────── */
  document.getElementById("btnSavePerms").addEventListener("click", async function () {
    if (!selectedRoleId) return;
    var perms = getCheckedPerms("permMatrix");
    try {
      var resp = await fetch(API + "/roles/" + selectedRoleId, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ permissions: perms }),
      });
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || "Failed to save");
      toast("Permissions saved for " + (data.role.label || data.role.name));
      // update the card counts
      var card = document.querySelector('.role-card[data-role-id="' + selectedRoleId + '"]');
      if (card) {
        var meta = card.querySelector(".role-meta");
        if (meta) {
          var parts = meta.innerHTML.split("&middot;");
          parts[1] = ' <i class="bi bi-key-fill me-1"></i>' + perms.length + " permission" + (perms.length === 1 ? "" : "s") + " ";
          meta.innerHTML = parts.join("&middot;");
        }
      }
    } catch (err) {
      toast(err.message, true);
    }
  });

  /* ── User permission override modal ───────────────────── */
  document.getElementById("usersList").addEventListener("click", function (e) {
    var btn = e.target.closest(".btn-edit-user-perms");
    if (!btn) return;
    userPermUserId = btn.dataset.userId;
    var userName   = btn.dataset.userName;
    var userPerms  = JSON.parse(btn.dataset.userPerms || "[]");

    document.getElementById("userPermModalTitle").textContent = "Permissions — " + userName.trim();

    // If user has custom overrides, use those; otherwise use the role's current perms as starting point
    var permsToRender = userPerms.length > 0 ? userPerms : getCheckedPerms("permMatrix");
    renderPermMatrix(permsToRender, "userPermBody", "up");

    var modal = new bootstrap.Modal(document.getElementById("userPermModal"));
    modal.show();
  });

  /* ── Save user permission overrides ───────────────────── */
  document.getElementById("btnSaveUserPerms").addEventListener("click", async function () {
    if (!userPermUserId) return;
    var perms = getCheckedPerms("userPermBody");
    try {
      var resp = await fetch(API + "/users/" + userPermUserId + "/permissions", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ permissions: perms }),
      });
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || "Failed to save");
      toast("User permissions saved");
      bootstrap.Modal.getInstance(document.getElementById("userPermModal")).hide();
      // refresh user list
      if (selectedRoleId) loadRoleUsers(selectedRoleId, document.getElementById("usersPanelTitle").textContent.split(" — ")[0]);
    } catch (err) {
      toast(err.message, true);
    }
  });

  /* ── Reset user to role defaults ──────────────────────── */
  document.getElementById("btnResetUserPerms").addEventListener("click", async function () {
    if (!userPermUserId) return;
    if (!confirm("Reset this user to the role's default permissions?")) return;
    try {
      var resp = await fetch(API + "/users/" + userPermUserId + "/permissions", {
        method: "DELETE",
      });
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || "Failed");
      toast("Permissions reset to role defaults");
      bootstrap.Modal.getInstance(document.getElementById("userPermModal")).hide();
      if (selectedRoleId) loadRoleUsers(selectedRoleId, document.getElementById("usersPanelTitle").textContent.split(" — ")[0]);
    } catch (err) {
      toast(err.message, true);
    }
  });

})();
</script>
