        <button class="btn btn-primary rp-filter-btn" type="button" onclick="applyFilters()" title="Apply filters"><i class="bi bi-funnel-fill me-2"></i>Filter</button>
      </div>
      <div class="rp-toolbar-row">
        <div class="rp-filter-group">
          <label class="rp-filter-label" for="rpSupplierFilter"><i class="bi bi-truck me-1"></i>Supplier</label>
          <select class="form-select rp-filter-input" id="rpSupplierFilter" style="height:42px;">
            <option value="">All Suppliers</option>
          </select>
        </div>
        <div class="rp-filter-group">
          <label class="rp-filter-label" for="rpStockLevelFilter"><i class="bi bi-box me-1"></i>Stock Level</label>
          <select class="form-select rp-filter-input" id="rpStockLevelFilter" style="height:42px;">
            <option value="">All Stock Levels</option>
            <option value="in_stock">Has Stock (>0)</option>
            <option value="out_of_stock">No Stock (0)</option>
            <option value="low_stock">Low Stock (≤ Min)</option>
            <option value="has_reserved">Has Reserved (>0)</option>
