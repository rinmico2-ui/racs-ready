<script>
(function() {
  const API = '/api/payroll';
  const localDateValue = (date) => {
    const d = new Date(date);
    const pad = value => String(value).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
  };
  const dateOnlyTime = value => {
    if (!value) return NaN;
    const raw = String(value);
    const match = raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (match) return new Date(Number(match[1]), Number(match[2])-1, Number(match[3])).getTime();
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? NaN : new Date(date.getFullYear(),date.getMonth(),date.getDate()).getTime();
  };
  const fmt = (n) => '₱' + Number(n || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fmtDate = (d) => { if (!d) return '—'; const dt = new Date(d); return dt.toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }); };

  let allStaff = [];
  let allRecords = [];
  let allComp = [];
  let editingId = null;
  let calculationReady = false;
  let currentCalculation = null;

  // ── Init ──────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', async () => {
    await loadStaff();
    initYearFilter();
    initTabs();
    initEventListeners();
    await Promise.all([loadRecords(), loadCompensation(), loadDueToday()]);
    populateStaffDropdowns();
    renderSetupHealth();
  });

  // ── Load Staff ────────────────────────────────────────────────
  async function loadStaff() {
    try {
      const res = await fetch(API + '/staff', { credentials: 'same-origin' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Unable to load staff.');
      allStaff = data.staff || [];
      populateStaffDropdowns();
    } catch(e) { console.error('Failed to load staff', e); }
  }

  function populateStaffDropdowns() {
    const selected = {};
    ['pfEmployee','compEmployee','filterEmployee','compFilterEmployee'].forEach(id => { selected[id] = document.getElementById(id)?.value || ''; });
    const plainOpts = allStaff
      .filter(s => s.firstName && s.lastName)
      .map(s => `<option value="${s._id}">${esc(s.firstName)} ${esc(s.lastName)} (${s.role})</option>`)
      .join('');
    const payrollOpts = allStaff
      .filter(s => s.firstName && s.lastName)
      .map(s => {
        const rate = currentRateFor(s._id);
        const suffix = rate ? `${rate.payType} ${fmt(rate.baseRate)}/${payUnit(rate.payType)}` : 'pay policy missing today';
        return `<option value="${s._id}">${esc(s.firstName)} ${esc(s.lastName)} (${s.role}) — ${esc(suffix)}</option>`;
      }).join('');
    const defaultOpt = '<option value="">Select employee...</option>';
    const allOpt = '<option value="">All Employees</option>';
    const payrollEmployee = document.getElementById('pfEmployee');
    if (payrollEmployee) payrollEmployee.innerHTML = defaultOpt + payrollOpts;
    const compEmployee = document.getElementById('compEmployee');
    if (compEmployee) compEmployee.innerHTML = defaultOpt + plainOpts;
    ['filterEmployee', 'compFilterEmployee'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = allOpt + plainOpts;
    });
    Object.entries(selected).forEach(([id,value]) => { const el=document.getElementById(id); if(el && [...el.options].some(option=>option.value===value)) el.value=value; });
  }

  function payUnit(payType) {
    return payType === 'daily' ? 'day' : payType === 'hourly' ? 'hour' : 'month';
  }

  function compensationLifecycle(record, now = new Date()) {
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
    const from = dateOnlyTime(record.effectiveFrom);
    const to = record.effectiveTo ? dateOnlyTime(record.effectiveTo) : Infinity;
    if (from > today) return 'scheduled';
    if (to < today) return 'ended';
    return 'current';
  }

  function currentRateFor(employeeId) {
    return allComp.find(record => String(record.employee?._id || record.employee) === String(employeeId) && compensationLifecycle(record) === 'current');
  }

  function rateForPeriod(employeeId, startValue, endValue) {
    const start = dateOnlyTime(startValue), end = dateOnlyTime(endValue);
    if (!Number.isFinite(start) || !Number.isFinite(end)) return null;
    return allComp.find(record => {
      if (String(record.employee?._id || record.employee) !== String(employeeId)) return false;
      const from = dateOnlyTime(record.effectiveFrom);
      const to = record.effectiveTo ? dateOnlyTime(record.effectiveTo) : Infinity;
      return from <= start && to >= end;
    }) || null;
  }

  function renderSetupHealth() {
    const missing = allStaff.filter(staff => !currentRateFor(staff._id));
    const box = document.getElementById('payrollReadiness');
    const text = document.getElementById('payrollReadinessText');
    if (!box || !text) return;
    box.classList.toggle('warning', missing.length > 0);
    if (!missing.length) {
      text.textContent = `All ${allStaff.length} active staff members have a pay policy covering today. Payroll drafts can be generated for covered periods.`;
      return;
    }
    const names = missing.slice(0,3).map(staff => `${staff.firstName} ${staff.lastName}`).join(', ');
    text.textContent = `${missing.length} active staff member${missing.length === 1 ? '' : 's'} need a current pay policy${names ? `: ${names}${missing.length > 3 ? ', and others' : ''}` : ''}. Configure rates before creating their payroll.`;
  }

  function initYearFilter() {
    const sel = document.getElementById('filterYear');
    const year = new Date().getFullYear();
    for (let y = year; y >= year - 3; y--) {
      const opt = document.createElement('option');
      opt.value = y; opt.textContent = y;
      sel.appendChild(opt);
    }
  }

  // ── Tabs ──────────────────────────────────────────────────────
  function initTabs() {
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
      });
    });
  }

  function showTab(tabName) {
    document.querySelector(`.tab-btn[data-tab="${tabName}"]`)?.click();
  }

  // ── Event Listeners ───────────────────────────────────────────
  function initEventListeners() {
    document.getElementById('btnRefresh').addEventListener('click', loadRecords);
    document.getElementById('btnRefreshComp').addEventListener('click', loadCompensation);
    document.getElementById('btnRefreshDue').addEventListener('click', loadDueToday);
    document.getElementById('btnCreatePayroll').addEventListener('click', openCreatePayroll);
    document.getElementById('btnAddComp').addEventListener('click', openAddComp);
    document.getElementById('btnOpenPolicies').addEventListener('click', () => showTab('compensation'));
    ['filterStatus', 'filterRole', 'filterEmployee', 'filterYear'].forEach(id => {
      document.getElementById(id).addEventListener('change', loadRecords);
    });
    ['compFilterEmployee', 'compFilterActive'].forEach(id => {
      document.getElementById(id).addEventListener('change', renderCompensationFilter);
    });

    // Auto-calculate
    document.getElementById('btnAutoCalc').addEventListener('click', autoCalculate);
    document.getElementById('pfOvertimeHours').addEventListener('input', () => { calculationReady = false; syncOvertimeControls(); });
    document.getElementById('pfOvertimeHours').addEventListener('change', autoCalculate);
    ['pfEmployee', 'pfPeriodStart', 'pfPeriodEnd'].forEach(id => {
      document.getElementById(id).addEventListener('change', () => { invalidatePayrollCalculation(); renderPayrollRateContext(); });
    });
    document.getElementById('pfPayDate').addEventListener('change', validatePlannedPayDate);

    // Live summary update
    ['pfBasicPay', 'pfOvertimePay'].forEach(id => {
      document.getElementById(id).addEventListener('input', updateSummary);
    });

    // Allowances / Deductions
    document.getElementById('btnAddAllowance').addEventListener('click', () => addLineItem('allowancesContainer'));
    document.getElementById('btnAddDeduction').addEventListener('click', () => addLineItem('deductionsContainer'));

    // Save payroll
    document.getElementById('btnSavePayroll').addEventListener('click', savePayroll);

    // Approve
    document.getElementById('btnConfirmApprove').addEventListener('click', confirmApprove);
    // Paid
    document.getElementById('btnConfirmPaid').addEventListener('click', confirmPaid);
    document.getElementById('paidMethod').addEventListener('change', syncPaymentEvidence);
    // Void
    document.getElementById('btnConfirmVoid').addEventListener('click', confirmVoid);
    // Save compensation
    document.getElementById('btnSaveComp').addEventListener('click', saveCompensation);
    document.getElementById('compEmployee').addEventListener('change', syncCompEmployeeContext);

    // Pay type radio sync
    document.querySelectorAll('input[name="compPayTypeRadio"]').forEach(r => {
      r.addEventListener('change', () => {
        document.getElementById('compPayType').value = r.value;
        syncCompRateLabels();
      });
    });
  }

  // ── Load Payroll Records ──────────────────────────────────────
  async function loadRecords() {
    const params = new URLSearchParams();
    const status = document.getElementById('filterStatus').value;
    const role = document.getElementById('filterRole').value;
    const emp = document.getElementById('filterEmployee').value;
    const year = document.getElementById('filterYear').value;
    if (status) params.set('status', status);
    if (role) params.set('role', role);
    if (emp) params.set('employee', emp);
    if (year) params.set('year', year);

    try {
      const res = await fetch(API + '?' + params.toString(), { credentials: 'same-origin' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Unable to load payroll runs.');
      allRecords = data.records || [];
      renderRecords(allRecords);
      renderStats(data.stats || {});
    } catch(e) {
      document.getElementById('recordsBody').innerHTML = '<tr><td colspan="9" class="empty-state"><i class="bi bi-exclamation-circle"></i><p>Failed to load payroll records</p></td></tr>';
    }
  }

  function renderStats(s) {
    document.getElementById('kpiNetTotal').textContent = fmt(s.netTotal);
    document.getElementById('kpiDraft').textContent = s.draft || 0;
    document.getElementById('kpiApproved').textContent = s.approved || 0;
    document.getElementById('kpiPaid').textContent = s.paid || 0;
  }

  function renderRecords(records) {
    const tbody = document.getElementById('recordsBody');
    if (!records.length) {
      tbody.innerHTML = '<tr><td colspan="9" class="empty-state"><i class="bi bi-wallet2"></i><p>No payroll records found</p></td></tr>';
      return;
    }
    tbody.innerHTML = records.map(r => {
      const emp = r.employee || {};
      const name = (emp.firstName || '') + ' ' + (emp.lastName || '');
      const role = emp.role || r.employeeRole || '';
      const statusCls = 'status-' + r.status;
      const actions = getRecordActions(r);
      const warningIcon = (r.calculationWarnings || []).length
        ? `<i class="bi bi-exclamation-triangle-fill ms-1" style="color:#d97706;" title="${esc((r.calculationWarnings || []).join(' '))}"></i>`
        : '';
      return `<tr>
        <td>
          <div style="font-weight:600;color:#0f172a;">${esc(name)}</div>
          <div style="font-size:0.7rem;color:#94a3b8;">${esc(role)}</div>
        </td>
        <td style="white-space:nowrap;">${fmtDate(r.periodStart)} – ${fmtDate(r.periodEnd)}<div class="pw-muted-note">Planned pay: ${fmtDate(r.payDate)}</div></td>
        <td class="text-end">${fmt(r.basicPay)}</td>
        <td class="text-end">${fmt(r.overtimePay)}</td>
        <td class="text-end">${fmt((r.allowances||[]).reduce((s,i)=>s+i.amount,0))}</td>
        <td class="text-end">${fmt(r.totalDeductions)}</td>
        <td class="text-end" style="font-weight:700;color:#0f172a;">${fmt(r.netPay)}</td>
        <td><span class="status-badge ${statusCls}">${r.status}</span>${warningIcon}</td>
        <td class="text-center">${actions}</td>
      </tr>`;
    }).join('');
  }

  function getRecordActions(r) {
    let html = `<div class="pw-row-actions"><button class="pw-row-action" onclick="window._pw.viewRecord('${r._id}')"><i class="bi bi-eye me-1"></i>View</button>`;
    if (r.status === 'draft') {
      html += `<button class="pw-row-action" onclick="window._pw.editRecord('${r._id}')"><i class="bi bi-pencil me-1"></i>Edit</button>`;
      html += `<button class="pw-row-action success" onclick="window._pw.openApprove('${r._id}')"><i class="bi bi-check2-circle me-1"></i>Review</button>`;
      html += `<button class="pw-row-action danger" onclick="window._pw.openVoid('${r._id}')"><i class="bi bi-x-octagon me-1"></i>Void</button>`;
    } else if (r.status === 'approved') {
      html += `<button class="pw-row-action success" onclick="window._pw.openPaid('${r._id}')"><i class="bi bi-credit-card me-1"></i>Record Payment</button>`;
    }
    return html + '</div>';
  }

  // ── Load Compensation ─────────────────────────────────────────
  async function loadCompensation() {
    try {
      const res = await fetch(API + '/compensation', { credentials: 'same-origin' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Unable to load pay policies.');
      allComp = data.records || [];
      renderCompensationFilter();
      populateStaffDropdowns();
      renderSetupHealth();
    } catch(e) {
      document.getElementById('compBody').innerHTML = '<tr><td colspan="8" class="empty-state"><i class="bi bi-exclamation-circle"></i><p>Failed to load compensation records</p></td></tr>';
    }
  }

  function renderComp(records) {
    const tbody = document.getElementById('compBody');
    if (!records.length) {
      tbody.innerHTML = '<tr><td colspan="8" class="empty-state"><i class="bi bi-person-gear"></i><p>No compensation records found</p></td></tr>';
      return;
    }
    tbody.innerHTML = records.map(r => {
      const emp = r.employee || {};
      const name = (emp.firstName || '') + ' ' + (emp.lastName || '');
      const role = emp.role || '';
      const lifecycle = compensationLifecycle(r);
      const statusBadge = lifecycle === 'current'
        ? '<span class="status-badge status-approved">Current</span>'
        : lifecycle === 'scheduled'
          ? '<span class="status-badge status-draft">Scheduled</span>'
          : '<span class="status-badge status-voided">Ended</span>';
      return `<tr>
        <td>
          <div style="font-weight:600;color:#0f172a;">${esc(name)}</div>
          <div style="font-size:0.7rem;color:#94a3b8;">${esc(role)}</div>
        </td>
        <td><span class="role-tag role-${role}">${r.payType}</span></td>
        <td class="text-end" style="font-weight:600;">${fmt(r.baseRate)}<div class="pw-muted-note">per ${payUnit(r.payType)}</div></td>
        <td class="text-end">${fmt(r.overtimeRate)}</td>
        <td>${fmtDate(r.effectiveFrom)}</td>
        <td>${fmtDate(r.effectiveTo)}</td>
        <td>${statusBadge}</td>
        <td class="text-center"><div class="pw-row-actions">
          ${r.active ? `<button class="pw-row-action" onclick="window._pw.editComp('${r._id}')"><i class="bi bi-pencil me-1"></i>Edit</button><button class="pw-row-action" onclick="window._pw.scheduleRateChange('${r._id}')"><i class="bi bi-calendar-plus me-1"></i>New Rate</button><button class="pw-row-action danger" onclick="window._pw.endComp('${r._id}')"><i class="bi bi-stop-circle me-1"></i>End</button>` : ''}
        </div></td>
      </tr>`;
    }).join('');
  }

  // ── Load Due Today ────────────────────────────────────────────
  async function loadDueToday() {
    try {
      const res = await fetch(API + '/due-today', { credentials: 'same-origin' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Unable to load daily payroll readiness.');
      renderDueToday(data);
    } catch(e) {
      document.getElementById('dueTodayList').innerHTML = '<div class="pw-due-empty"><i class="bi bi-exclamation-circle me-1"></i>Failed to load</div>';
    }
  }

  function renderDueToday(data) {
    const banner = document.getElementById('dueTodayBanner');
    const list = document.getElementById('dueTodayList');
    const countEl = document.getElementById('dueTodayCount');
    const dateEl = document.getElementById('dueTodayDate');
    const items = data.dueToday || [];
    const dateStr = new Date(data.date).toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

    dateEl.textContent = dateStr;
    countEl.textContent = items.length + ' employee' + (items.length !== 1 ? 's' : '');

    if (!items.length) {
      banner.classList.add('show');
      list.innerHTML = '<div class="pw-due-empty"><i class="bi bi-check-circle-fill me-1" style="color:#059669;"></i>No completed daily shifts are waiting for a payroll draft.</div>';
      return;
    }

    banner.classList.add('show');
    list.innerHTML = items.map(item => {
      const emp = item.employee;
      const name = (emp.firstName || '') + ' ' + (emp.lastName || '');
      const initials = ((emp.firstName || '')[0] || '') + ((emp.lastName || '')[0] || '');
      const att = item.attendance || {};
      const attStatus = att.status || 'Unknown';
      const attCls = attStatus === 'Present' ? 'pw-due-att-present' : attStatus === 'Late' ? 'pw-due-att-late' : 'pw-due-att-absent';
      const rate = fmt(item.baseRate) + '/day';
      const periodStart = localDateValue(data.date);
      const periodEnd = periodStart;
      const ready = item.readyForDraft === true;
      return `<div class="pw-due-card">
        <div class="pw-due-card-left">
          <div class="pw-due-avatar">${esc(initials.toUpperCase())}</div>
          <div>
            <div class="pw-due-name">${esc(name)}</div>
            <div class="pw-due-meta">${esc(emp.role)} \u2022 ${rate} \u2022 <span class="pw-due-att ${attCls}">${attStatus}</span> \u2022 ${esc(item.readinessReason || '')}</div>
          </div>
        </div>
        <button class="pw-due-create-btn" ${ready ? `onclick="window._pw.createDuePayroll('${emp._id}','${esc(name)}','${periodStart}','${periodEnd}')"` : 'disabled'}><i class="bi ${ready ? 'bi-plus-lg' : 'bi-hourglass-split'} me-1"></i>${ready ? 'Create Draft' : 'Awaiting Checkout'}</button>
      </div>`;
    }).join('');
  }

  function createDuePayroll(empId, empName, periodStart, periodEnd) {
    openCreatePayroll();
    setTimeout(() => {
      const sel = document.getElementById('pfEmployee');
      if (sel) sel.value = empId;
      const ps = document.getElementById('pfPeriodStart');
      if (ps) ps.value = periodStart;
      const pe = document.getElementById('pfPeriodEnd');
      if (pe) pe.value = periodEnd;
      document.getElementById('pfPayDate').value = periodEnd;
      invalidatePayrollCalculation();
      renderPayrollRateContext();
      pwGoStep(1);
    }, 200);
  }

  // ── Create / Edit Payroll ─────────────────────────────────────
  let currentStep = 1;

  function validatePlannedPayDate(showMessage = false) {
    const end = dateOnlyTime(document.getElementById('pfPeriodEnd').value);
    const payDate = dateOnlyTime(document.getElementById('pfPayDate').value);
    const valid = Number.isFinite(end) && Number.isFinite(payDate) && payDate >= end;
    if (!valid && showMessage) showCalcMsg('Planned pay date must be on or after the period end date.', 'error');
    return valid;
  }

  function renderPayrollRateContext() {
    const employeeId = document.getElementById('pfEmployee').value;
    const start = document.getElementById('pfPeriodStart').value;
    const end = document.getElementById('pfPeriodEnd').value;
    const context = document.getElementById('pfRateContext');
    context.className = 'pw-context';
    if (!employeeId || !start || !end) {
      context.innerHTML = '<i class="bi bi-info-circle me-1"></i>Select an employee and pay period to check which effective pay rate will be used.';
      return null;
    }
    const rate = rateForPeriod(employeeId, start, end);
    if (rate) {
      context.classList.add('success');
      context.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i><strong>${esc(rate.payType.charAt(0).toUpperCase()+rate.payType.slice(1))} policy:</strong> ${fmt(rate.baseRate)} per ${payUnit(rate.payType)}${Number(rate.overtimeRate||0)>0?` · OT ${fmt(rate.overtimeRate)}/hour`:''}. Effective ${fmtDate(rate.effectiveFrom)}${rate.effectiveTo?` to ${fmtDate(rate.effectiveTo)}`:''}.`;
      return rate;
    }
    const intersects = allComp.some(record => String(record.employee?._id || record.employee) === String(employeeId) && dateOnlyTime(record.effectiveFrom) <= dateOnlyTime(end) && (!record.effectiveTo || dateOnlyTime(record.effectiveTo) >= dateOnlyTime(start)));
    context.classList.add(intersects ? 'warning' : 'danger');
    context.innerHTML = intersects
      ? '<i class="bi bi-exclamation-triangle-fill me-1"></i>The pay rate changes inside this period. Split the payroll into separate periods at the rate-change date.'
      : '<i class="bi bi-x-circle-fill me-1"></i>No pay policy covers this period. Configure an effective-dated rate before continuing.';
    return null;
  }

  function applyCyclePreset(type) {
    const today = new Date();
    let start = new Date(today.getFullYear(), today.getMonth(), today.getDate());
    let end = new Date(start);
    if (type === 'seven_days') start.setDate(end.getDate()-6);
    if (type === 'month_to_date') start = new Date(today.getFullYear(), today.getMonth(), 1);
    if (type === 'previous_month') {
      start = new Date(today.getFullYear(), today.getMonth()-1, 1);
      end = new Date(today.getFullYear(), today.getMonth(), 0);
    }
    document.getElementById('pfPeriodStart').value = localDateValue(start);
    document.getElementById('pfPeriodEnd').value = localDateValue(end);
    document.getElementById('pfPayDate').value = localDateValue(today < end ? end : today);
    invalidatePayrollCalculation();
    renderPayrollRateContext();
  }

  async function pwContinueToBreakdown() {
    const employeeId = document.getElementById('pfEmployee').value;
    const start = document.getElementById('pfPeriodStart').value;
    const end = document.getElementById('pfPeriodEnd').value;
    if (!employeeId || !start || !end || !document.getElementById('pfPayDate').value) {
      showCalcMsg('Select an employee, a complete pay period, and the planned pay date.', 'error');
      return;
    }
    if (dateOnlyTime(end) < dateOnlyTime(start)) return showCalcMsg('Period end cannot be before period start.', 'error');
    if (!validatePlannedPayDate(true) || !renderPayrollRateContext()) return;
    if (await autoCalculate()) pwGoStep(2);
  }

  function pwContinueToReview() {
    const overtimeHours = Number(document.getElementById('pfOvertimeHours').value || 0);
    if (!calculationReady) return showCalcMsg('Recalculate payroll after changing the employee, dates, or overtime hours.', 'error');
    if (overtimeHours > 0 && document.getElementById('pfOvertimeNote').value.trim().length < 5) return showCalcMsg('Document the overtime authorization before review.', 'error');
    pwGoStep(3);
  }

  function pwGoStep(step) {
    currentStep = step;
    document.querySelectorAll('.pw-step-panel').forEach(p => p.classList.remove('active'));
    document.getElementById('pwStep' + step).classList.add('active');

    document.querySelectorAll('.pw-step').forEach((s, i) => {
      s.classList.remove('active', 'completed');
      if (i + 1 < step) s.classList.add('completed');
      if (i + 1 === step) s.classList.add('active');
    });

    // Update review panel on step 3
    if (step === 3) updateReviewPanel();
  }

  function updateReviewPanel() {
    const empEl = document.getElementById('pfEmployee');
    const empName = empEl.options[empEl.selectedIndex]?.text || '—';
    document.getElementById('reviewEmp').textContent = empName === 'Select employee...' ? '—' : empName;
    const start = document.getElementById('pfPeriodStart').value;
    const end = document.getElementById('pfPeriodEnd').value;
    document.getElementById('reviewPeriod').textContent = (start && end) ? fmtDate(start) + ' – ' + fmtDate(end) : '—';
    document.getElementById('reviewPayDate').textContent = fmtDate(document.getElementById('pfPayDate').value);
    const attWrap = document.getElementById('calcAttendanceWrap');
    if (attWrap.style.display !== 'none') {
      document.getElementById('reviewAtt').textContent = currentCalculation?.compensation?.payType === 'monthly'
        ? 'Not used for monthly salary'
        : document.getElementById('attPresent').textContent + ' present, ' +
          document.getElementById('attLate').textContent + ' late, ' +
          document.getElementById('attAbsent').textContent + ' absent';
    } else {
      document.getElementById('reviewAtt').textContent = 'Not calculated';
    }
    document.getElementById('reviewRate').textContent = currentCalculation?.compensation
      ? `${currentCalculation.compensation.payType} · ${fmt(currentCalculation.compensation.baseRate)}/${payUnit(currentCalculation.compensation.payType)}`
      : '—';
  }

  function openCreatePayroll() {
    editingId = null;
    document.getElementById('payrollModalTitle').textContent = 'New Payroll Run';
    document.getElementById('payrollModalSub').textContent = 'Create an internal draft from a pay policy and attendance period';
    document.getElementById('pfPayrollId').value = '';
    document.getElementById('pfEmployee').value = '';
    document.getElementById('pfEmployee').disabled = false;
    document.getElementById('pfPayDate').value = localDateValue(new Date());
    document.getElementById('pfPeriodStart').value = '';
    document.getElementById('pfPeriodEnd').value = '';
    document.getElementById('pfBasicPay').value = '';
    document.getElementById('pfOvertimeHours').value = '0';
    document.getElementById('pfOvertimePay').value = '0';
    document.getElementById('pfOvertimeNote').value = '';
    document.getElementById('pfNotes').value = '';
    document.getElementById('btnSavePayroll').innerHTML = '<i class="bi bi-check2-circle"></i> Save Draft';
    clearLineItems('allowancesContainer');
    clearLineItems('deductionsContainer');
    document.getElementById('calcAttendanceWrap').style.display = 'none';
    document.getElementById('calcAttendanceDesc').textContent = 'Auto-calculated from attendance records';
    calculationReady = false;
    currentCalculation = null;
    document.getElementById('pfCalculationBasis').innerHTML = '<i class="bi bi-lock-fill me-1"></i>The server will select the effective rate and calculate attendance-based pay.';
    renderCalculationWarnings([]);
    syncOvertimeControls();
    updateSummary();
    pwGoStep(1);
    new bootstrap.Modal(document.getElementById('payrollModal')).show();
  }

  async function editRecord(id) {
    try {
      const res = await fetch(API + '/' + id, { credentials: 'same-origin' });
      const data = await res.json();
      const r = data.record;
      if (!r) { showCalcMsg('Record not found.', 'error'); return; }

      editingId = id;
      document.getElementById('payrollModalTitle').textContent = 'Edit Payroll';
      document.getElementById('payrollModalSub').textContent = 'Update draft payroll record';
      document.getElementById('pfPayrollId').value = id;
      document.getElementById('pfEmployee').value = r.employee._id;
      document.getElementById('pfEmployee').disabled = true;
      document.getElementById('pfPayDate').value = r.payDate ? localDateValue(r.payDate) : '';
      document.getElementById('pfPeriodStart').value = r.periodStart ? localDateValue(r.periodStart) : '';
      document.getElementById('pfPeriodEnd').value = r.periodEnd ? localDateValue(r.periodEnd) : '';
      document.getElementById('pfBasicPay').value = r.basicPay;
      document.getElementById('pfOvertimeHours').value = r.overtimeHours || 0;
      document.getElementById('pfOvertimePay').value = r.overtimePay || 0;
      document.getElementById('pfOvertimeNote').value = r.overtimeNote || '';
      document.getElementById('pfNotes').value = r.notes || '';
      document.getElementById('btnSavePayroll').innerHTML = '<i class="bi bi-check2-circle"></i> Update Draft';

      // Populate allowances
      clearLineItems('allowancesContainer');
      (r.allowances || []).forEach(a => addLineItem('allowancesContainer', a.name, a.amount));
      clearLineItems('deductionsContainer');
      (r.deductions || []).forEach(d => addLineItem('deductionsContainer', d.name, d.amount));

      document.getElementById('calcAttendanceWrap').style.display = 'block';
      document.getElementById('calcAttendanceDesc').textContent = r.payType === 'monthly'
        ? 'Monthly salary is prorated by covered calendar days; attendance does not change basic pay.'
        : 'Verified attendance used by the server calculation.';
      const att = r.attendanceSummary || {};
      document.getElementById('attPresent').textContent = att.present || 0;
      document.getElementById('attLate').textContent = att.late || 0;
      document.getElementById('attAbsent').textContent = att.absent || 0;
      document.getElementById('attLeave').textContent = att.onLeave || 0;
      document.getElementById('attSick').textContent = att.sickLeave || 0;
      document.getElementById('attHours').textContent = att.hoursWorked || 0;
      renderCalculationWarnings(r.calculationWarnings || []);
      calculationReady = true;
      currentCalculation = { compensation: { payType: r.payType, baseRate: r.baseRate, overtimeRate: r.overtimeRate } };
      document.getElementById('pfCalculationBasis').innerHTML = `<i class="bi bi-lock-fill me-1"></i><strong>${esc(r.payType)} policy:</strong> ${fmt(r.baseRate)}/${payUnit(r.payType)}${Number(r.overtimeRate||0)>0?` · OT ${fmt(r.overtimeRate)}/hour`:''}. Saved draft inputs will be recalculated by the server.`;
      renderPayrollRateContext();
      syncOvertimeControls();
      updateSummary();
      pwGoStep(1);
      new bootstrap.Modal(document.getElementById('payrollModal')).show();
    } catch(e) { showCalcMsg('Failed to load record.', 'error'); }
  }

  // ── Calc Toast (visible inside modal) ──────────────────────────
  function showCalcMsg(msg, type) {
    let toast = document.getElementById('calcToast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'calcToast';
      toast.style.cssText = 'position:fixed;top:16px;right:16px;z-index:10900;padding:12px 20px;border-radius:10px;font-size:0.82rem;font-weight:600;display:none;box-shadow:0 4px 16px rgba(0,0,0,0.15);transition:opacity 0.3s;';
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.style.display = 'block';
    toast.style.background = type === 'error' ? '#fef2f2' : type === 'success' ? '#f0fdf4' : '#eff6ff';
    toast.style.color = type === 'error' ? '#dc2626' : type === 'success' ? '#16a34a' : '#2563eb';
    toast.style.border = '1px solid ' + (type === 'error' ? '#fecaca' : type === 'success' ? '#bbf7d0' : '#bfdbfe');
    clearTimeout(toast._timer);
    toast._timer = setTimeout(() => { toast.style.display = 'none'; }, 4000);
  }

  // ── Auto Calculate ────────────────────────────────────────────
  async function autoCalculate() {
    const emp = document.getElementById('pfEmployee').value;
    const start = document.getElementById('pfPeriodStart').value;
    const end = document.getElementById('pfPeriodEnd').value;
    if (!emp || !start || !end) {
      showCalcMsg('Please select employee and period dates first.', 'error');
      return false;
    }

    const btn = document.getElementById('btnAutoCalc');
    const origHTML = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Calculating...';
    btn.disabled = true;
    let succeeded = false;

    try {
      const res = await fetch(API + '/calculate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          employeeId: emp,
          periodStart: start,
          periodEnd: end,
          overtimeHours: parseFloat(document.getElementById('pfOvertimeHours').value) || 0,
          excludePayrollId: editingId || undefined,
        })
      });
      const data = await res.json();
      if (!res.ok) {
        showCalcMsg(data.error || 'Calculation failed.', 'error');
        return false;
      }

      document.getElementById('pfBasicPay').value = data.basicPay;
      document.getElementById('pfOvertimeHours').value = data.overtimeHours || 0;
      document.getElementById('pfOvertimePay').value = data.overtimePay || 0;

      // Show attendance
      const att = data.attendanceSummary || {};
      document.getElementById('attPresent').textContent = att.present || 0;
      document.getElementById('attLate').textContent = att.late || 0;
      document.getElementById('attAbsent').textContent = att.absent || 0;
      document.getElementById('attLeave').textContent = att.onLeave || 0;
      document.getElementById('attSick').textContent = att.sickLeave || 0;
      document.getElementById('attHours').textContent = att.hoursWorked || 0;
      document.getElementById('calcAttendanceWrap').style.display = 'block';
      renderCalculationWarnings(data.calculationWarnings || []);
      calculationReady = true;
      currentCalculation = data;
      const basis = document.getElementById('pfCalculationBasis');
      basis.innerHTML = `<i class="bi bi-lock-fill me-1"></i><strong>${esc(data.compensation.payType)} policy:</strong> ${fmt(data.compensation.baseRate)}/${payUnit(data.compensation.payType)}${Number(data.compensation.overtimeRate||0)>0?` · OT ${fmt(data.compensation.overtimeRate)}/hour`:''}. Attendance and rate inputs were verified by the server.`;
      syncOvertimeControls();

      updateSummary();
      const calculationMessage = data.compensation.payType === 'monthly'
        ? `Calculated ${fmt(data.basicPay)} from the monthly salary and covered calendar days.`
        : data.compensation.payType === 'hourly'
          ? `Calculated ${fmt(data.basicPay)} from ${Number(att.hoursWorked||0)} verified hours.`
          : `Calculated ${fmt(data.basicPay)} from ${Number(att.present||0)+Number(att.late||0)} payable attendance days.`;
      showCalcMsg(calculationMessage, 'success');
      succeeded = true;
    } catch(e) {
      console.error('Calc error:', e);
      showCalcMsg('Network error. Check console for details.', 'error');
    } finally {
      btn.innerHTML = origHTML;
      btn.disabled = false;
    }
    return succeeded;
  }

  function renderCompensationFilter() {
    const employeeId = document.getElementById('compFilterEmployee').value;
    const lifecycle = document.getElementById('compFilterActive').value;
    const filtered = allComp.filter(record => {
      const matchesEmployee = !employeeId || String(record.employee?._id || record.employee) === String(employeeId);
      return matchesEmployee && (!lifecycle || compensationLifecycle(record) === lifecycle);
    });
    renderComp(filtered);
  }

  function syncOvertimeControls() {
    const overtimeHours = parseFloat(document.getElementById('pfOvertimeHours').value) || 0;
    const wrap = document.getElementById('overtimeNoteWrap');
    const note = document.getElementById('pfOvertimeNote');
    wrap.style.display = overtimeHours > 0 ? '' : 'none';
    note.required = overtimeHours > 0;
    if (overtimeHours === 0) note.value = '';
  }

  function invalidatePayrollCalculation() {
    calculationReady = false;
    currentCalculation = null;
    document.getElementById('pfBasicPay').value = '';
    document.getElementById('pfOvertimePay').value = '0';
    document.getElementById('calcAttendanceWrap').style.display = 'none';
    renderCalculationWarnings([]);
    updateSummary();
  }

  function renderCalculationWarnings(warnings) {
    const box = document.getElementById('calcWarnings');
    const items = Array.isArray(warnings) ? warnings.filter(Boolean) : [];
    if (!items.length) {
      box.style.display = 'none';
      box.innerHTML = '';
      return;
    }
    box.innerHTML = '<strong><i class="bi bi-exclamation-triangle me-1"></i>Review before approval</strong><ul class="mb-0 mt-1">' +
      items.map(item => '<li>' + esc(item) + '</li>').join('') + '</ul>';
    box.style.display = 'block';
  }

  // ── Line Items ────────────────────────────────────────────────
  function addLineItem(containerId, name, amount) {
    const container = document.getElementById(containerId);
    // Remove placeholder
    const empty = container.querySelector('.pw-line-empty');
    if (empty) empty.remove();

    const row = document.createElement('div');
    row.className = 'pw-line-row';
    row.innerHTML = `
      <input type="text" class="li-name" placeholder="Item name" maxlength="80" value="${esc(name || '')}" />
      <input type="number" class="li-amount" placeholder="0.00" min="0" step="0.01" value="${amount || 0}" style="max-width:120px;" />
      <button type="button" class="pw-line-remove" onclick="this.parentElement.remove();window._pw.checkEmpty('${containerId}');window._pw.updateSummary();"><i class="bi bi-x"></i></button>
    `;
    row.querySelectorAll('input').forEach(inp => inp.addEventListener('input', updateSummary));
    container.appendChild(row);
    updateSummary();
  }

  function checkEmpty(containerId) {
    const container = document.getElementById(containerId);
    if (!container.querySelector('.pw-line-row')) {
      const isAllow = containerId.includes('allow');
      container.innerHTML = `<div class="pw-line-empty"><i class="bi bi-inbox"></i> No ${isAllow ? 'allowances' : 'deductions'} added yet</div>`;
    }
  }

  function clearLineItems(containerId) {
    const isAllow = containerId.includes('allow');
    document.getElementById(containerId).innerHTML = `<div class="pw-line-empty"><i class="bi bi-inbox"></i> No ${isAllow ? 'allowances' : 'deductions'} added yet</div>`;
  }

  function getLineItems(containerId) {
    const items = [];
    document.getElementById(containerId).querySelectorAll('.pw-line-row').forEach(row => {
      const name = (row.querySelector('.li-name') || {}).value || '';
      const amount = parseFloat((row.querySelector('.li-amount') || {}).value) || 0;
      if (name.trim() && amount > 0) items.push({ name: name.trim(), amount });
    });
    return items;
  }

  function updateSummary() {
    const basic = parseFloat(document.getElementById('pfBasicPay').value) || 0;
    const ot = parseFloat(document.getElementById('pfOvertimePay').value) || 0;
    const allow = getLineItems('allowancesContainer').reduce((s, i) => s + i.amount, 0);
    const ded = getLineItems('deductionsContainer').reduce((s, i) => s + i.amount, 0);
    const gross = basic + ot + allow;
    const net = Math.max(0, gross - ded);

    document.getElementById('sumBasic').textContent = fmt(basic);
    document.getElementById('sumOT').textContent = fmt(ot);
    document.getElementById('sumAllow').textContent = fmt(allow);
    document.getElementById('sumGross').textContent = fmt(gross);
    document.getElementById('sumDed').textContent = '-' + fmt(ded);
    document.getElementById('sumNet').textContent = fmt(net);
  }

  // ── Save Payroll ──────────────────────────────────────────────
  async function savePayroll() {
    const emp = document.getElementById('pfEmployee').value;
    const start = document.getElementById('pfPeriodStart').value;
    const end = document.getElementById('pfPeriodEnd').value;
    const payDate = document.getElementById('pfPayDate').value;
    if (!emp || !start || !end || !payDate) { showCalcMsg('Please fill in all required fields.', 'error'); return; }
    if (!validatePlannedPayDate(true)) { pwGoStep(1); return; }
    if (!calculationReady) { showCalcMsg('Calculate the payroll again before saving the draft.', 'error'); pwGoStep(1); return; }

    const overtimeHours = parseFloat(document.getElementById('pfOvertimeHours').value) || 0;
    const overtimeNote = document.getElementById('pfOvertimeNote').value.trim();
    if (overtimeHours > 0 && !overtimeNote) {
      showCalcMsg('Enter the overtime approval reason.', 'error');
      pwGoStep(2);
      return;
    }

    const body = {
      employee: emp,
      periodStart: start,
      periodEnd: end,
      payDate,
      overtimeHours,
      overtimeNote,
      allowances: getLineItems('allowancesContainer'),
      deductions: getLineItems('deductionsContainer'),
      notes: document.getElementById('pfNotes').value || '',
    };

    try {
      const url = editingId ? API + '/' + editingId : API;
      const method = editingId ? 'PATCH' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body)
      });
      const data = await res.json();
      if (!res.ok) { showCalcMsg(data.error || 'Save failed.', 'error'); return; }

      const wasEditing = !!editingId;
      bootstrap.Modal.getInstance(document.getElementById('payrollModal')).hide();
      document.getElementById('pfEmployee').disabled = false;
      editingId = null;
      loadRecords();
      showCalcMsg(wasEditing ? 'Payroll draft updated.' : 'Payroll draft created. Review and approve it when the inputs are final.', 'success');
    } catch(e) { console.error('Save error:', e); showCalcMsg('Failed to save payroll.', 'error'); }
  }

