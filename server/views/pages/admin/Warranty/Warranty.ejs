<script>
let currentStatus = 'all';
let currentType = 'all';
let currentPage = 1;
const pageSize = 15;
let allData = [];
let filteredData = [];
let searchTimeout = null;
let activeClaimId = null;
const warrantyFooter = document.getElementById('warrantyFooter');
const re = v => String(v ?? '—').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));

function filterStatus(status, btn) {
  currentStatus = status;
  document.querySelectorAll('[data-status]').forEach(x => x.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tableTitle').textContent =
    status === 'all' ? 'All Warranties' :
    status === 'active' ? 'Active Warranties' :
    status === 'expired' ? 'Expired Warranties' :
    status === 'incomplete' ? 'Warranties Missing Dates' : 'Warranty Claims';
  applyFilters();
}

function filterType(type, btn) {
  currentType = type;
  document.querySelectorAll('[data-type]').forEach(x => x.classList.remove('active'));
  btn.classList.add('active');
  applyFilters();
}

function debounceSearch() {
  clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => applyFilters(), 300);
}

function applyFilters() {
  const search = (document.getElementById('searchInput').value || '').toLowerCase();
  filteredData = allData.filter(item => {
    if (currentStatus !== 'all' && item.warranty?.status !== currentStatus) return false;
    if (currentType !== 'all' && item.type !== currentType) return false;
    if (search) {
      const ref = (item.reference || '').toLowerCase();
      const name = (item.customer?.name || '').toLowerCase();
      if (!ref.includes(search) && !name.includes(search)) return false;
    }
    return true;
  });
  document.getElementById('tableCount').textContent = filteredData.length + ' records';
  currentPage = 1;
  renderPage(1);
}

async function loadWarranties() {
  try {
    const [statsRes, listRes] = await Promise.all([
      fetch('/api/admin/warranties/stats'),
      fetch('/api/admin/warranties?limit=500')
    ]);
    if (statsRes.ok) {
      const stats = await statsRes.json();
      document.getElementById('kpiActive').textContent = stats.activeWarranty || 0;
      document.getElementById('kpiClaims').textContent = stats.warrantyClaims || 0;
      document.getElementById('kpiExpiring').textContent = stats.expiringSoon || 0;
      document.getElementById('kpiTotal').textContent = stats.totalWarranties || 0;
    }
    if (listRes.ok) {
      const data = await listRes.json();
      allData = data.items || [];
      filteredData = [...allData];
      document.getElementById('tableCount').textContent = filteredData.length + ' records';
      renderPage(1);
    }
  } catch (e) {
    console.error('Failed to load warranties:', e);
  }
}

async function loadClaimQueue() {
  const target = document.getElementById('claimQueueRows');
  try {
    const response = await fetch('/api/admin/warranty-claims?active=true&limit=100', { headers:{ Accept:'application/json' } });
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || 'Failed to load claims');
    document.getElementById('claimQueueCount').textContent = `${data.total || 0} active claim${data.total === 1 ? '' : 's'}`;
    if (!data.claims?.length) {
      target.innerHTML = '<div class="text-center text-muted py-4"><i class="bi bi-shield-check fs-3 d-block mb-2 text-success"></i>No active warranty claims.</div>';
      return;
    }
    target.innerHTML = data.claims.map(claim => `<div class="wc-queue-row">
      <span class="wc-priority ${re(claim.priority)}"></span>
      <div class="wc-queue-main"><div class="wc-queue-ref">${re(claim.claimReference)} <span class="badge bg-light text-dark border ms-1">${re(warrantyLabel(claim.status))}</span></div><div class="wc-queue-meta">${re(claim.sourceReference)} · ${re(claim.customerId?.name || 'Customer')} · ${re(claim.affectedItem?.name)} · filed ${re(warrantyDate(claim.submittedAt))}</div></div>
      <button class="btn btn-sm btn-primary" onclick="openWarrantyClaim('${re(claim._id)}')"><i class="bi bi-clipboard2-pulse me-1"></i>Manage</button>
    </div>`).join('');
  } catch (error) {
    target.innerHTML = `<div class="alert alert-danger m-3 mb-0">${re(error.message)}</div>`;
  }
}

function claimActionPanel(claim, technicians) {
  if (['submitted','triage'].includes(claim.status)) {
    const technicianOptions = technicians.map(t => `<option value="${re(t._id)}">${re(t.name)}</option>`).join('');
    return `<div class="card border-0 shadow-sm"><div class="card-body">
      <h6 class="fw-bold">Admin triage and inspection</h6>
      <div class="row g-2"><div class="col-md-4"><label class="form-label small fw-bold">Priority</label><select id="wcPriority" class="form-select"><option value="normal" ${claim.priority==='normal'?'selected':''}>Normal</option><option value="high" ${claim.priority==='high'?'selected':''}>High</option><option value="critical" ${claim.priority==='critical'?'selected':''}>Critical</option></select></div><div class="col-md-8"><label class="form-label small fw-bold">Triage note</label><input id="wcTriageNote" class="form-control" placeholder="Scope, safety instructions, initial assessment"></div></div>
      <button class="btn btn-outline-primary mt-2" onclick="triageClaim()">Acknowledge triage</button>
      <hr><div class="row g-2"><div class="col-md-5"><label class="form-label small fw-bold">Technician</label><select id="wcTechnician" class="form-select"><option value="">Select technician</option>${technicianOptions}</select></div><div class="col-md-4"><label class="form-label small fw-bold">Inspection date</label><input id="wcInspectionDate" type="date" class="form-control"></div><div class="col-md-3"><label class="form-label small fw-bold">Time slot</label><input id="wcTimeSlot" class="form-control" placeholder="9:00 AM"></div></div>
      <button class="btn btn-primary mt-2" onclick="scheduleClaimInspection()"><i class="bi bi-calendar-check me-1"></i>Schedule inspection</button>
    </div></div>`;
  }
  if (claim.status === 'inspection_completed') {
    return `<div class="card border-0 shadow-sm"><div class="card-body"><h6 class="fw-bold">Coverage decision</h6><div class="alert alert-info small"><strong>Technician finding:</strong> ${re(claim.inspection?.diagnosis || 'No diagnosis')}<br><strong>Root cause:</strong> ${re(warrantyLabel(claim.inspection?.rootCause))}</div><div class="row g-2"><div class="col-md-4"><select id="wcOutcome" class="form-select"><option value="approved">Approve</option><option value="partially_approved">Partially approve</option><option value="denied">Deny</option></select></div><div class="col-md-4"><select id="wcRemedy" class="form-select"><option value="repair">Repair</option><option value="replacement">Replacement</option><option value="refund">Refund</option><option value="manufacturer_referral">Manufacturer referral</option><option value="reinspection">Reinspection</option></select></div><div class="col-md-4"><input id="wcAmount" type="number" min="0" class="form-control" placeholder="Approved amount"></div><div class="col-12"><textarea id="wcDecisionReason" class="form-control" rows="3" placeholder="Evidence-based decision reason (required)"></textarea></div></div><button class="btn btn-primary mt-2" onclick="decideClaim()">Record decision</button></div></div>`;
  }
  if (['approved','partially_approved','remedy_in_progress'].includes(claim.status)) {
    return `<div class="card border-0 shadow-sm"><div class="card-body"><h6 class="fw-bold">Approved remedy</h6><div class="row g-2"><div class="col-md-6"><input id="wcOldSerial" class="form-control" placeholder="Old serial number (replacement only)"></div><div class="col-md-6"><input id="wcNewSerial" class="form-control" placeholder="New serial number (replacement only)"></div><div class="col-12"><textarea id="wcRemedyNotes" class="form-control" rows="3" placeholder="Work performed, parts, handover notes"></textarea></div></div><button class="btn btn-outline-primary mt-2 me-2" onclick="updateClaimRemedy(false)">Start / update remedy</button><button class="btn btn-success mt-2" onclick="updateClaimRemedy(true)">Mark resolved</button></div></div>`;
  }
  if (claim.status === 'resolved') return '<div class="alert alert-success mb-0"><strong>Remedy completed.</strong> Waiting for the customer to confirm the resolution. Admin override closure requires a documented reason.</div>';
  if (claim.status === 'denied') return '<div class="alert alert-secondary">The claim was denied with a recorded reason. It can now be administratively closed.</div><button class="btn btn-dark" onclick="closeDeniedClaim()">Close denied claim</button>';
  return '<div class="alert alert-light border mb-0">The assigned technician owns the next field action for this claim.</div>';
}

function renderWarrantyClaim(claim, technicians) {
  document.getElementById('wcTitle').textContent = claim.claimReference;
  document.getElementById('wcSubtitle').textContent = `${claim.sourceReference} · ${warrantyLabel(claim.status)}`;
  const evidence = (claim.claimantEvidenceUrls || []).map(url => `<a class="btn btn-sm btn-outline-secondary me-1 mb-1" target="_blank" href="${re(url)}"><i class="bi bi-image me-1"></i>Evidence</a>`).join('') || '<span class="text-muted small">No customer evidence uploaded.</span>';
  document.getElementById('wcBody').innerHTML = `<div class="wc-workflow mb-3"><div><div class="wd-label">Priority</div><strong>${re(warrantyLabel(claim.priority))}</strong></div><div><div class="wd-label">Source</div><strong>${re(warrantyLabel(claim.sourceType))}</strong></div><div><div class="wd-label">Coverage</div><strong>${re(claim.coverageSnapshot?.serviceName || claim.coverageSnapshot?.coverageType || 'Warranty')}</strong></div><div><div class="wd-label">Requested</div><strong>${re(warrantyLabel(claim.requestedRemedy))}</strong></div></div>
    <div class="card border-0 shadow-sm mb-3"><div class="card-body"><h6 class="fw-bold">Customer report</h6><div class="small text-muted mb-1">${re(claim.affectedItem?.name)}${claim.affectedItem?.serialNumber ? ` · Serial ${re(claim.affectedItem.serialNumber)}` : ''}</div><p class="mb-2">${re(claim.description)}</p>${evidence}</div></div>
    ${claim.inspection?.scheduledDate ? `<div class="alert alert-primary small"><strong>Inspection:</strong> ${re(warrantyDate(claim.inspection.scheduledDate,true))} ${re(claim.inspection.timeSlot || '')} · ${re(claim.assignedTechnicianId?.name || 'Technician')}</div>` : ''}
    ${claimActionPanel(claim, technicians)}`;
}

window.openWarrantyClaim = async function(id) {
  activeClaimId = id;
  const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('warrantyClaimModal'));
  document.getElementById('wcBody').innerHTML = '<div class="text-center py-5"><span class="spinner-border"></span></div>';
  modal.show();
  try {
    const [claimRes, techRes] = await Promise.all([fetch(`/api/admin/warranty-claims/${encodeURIComponent(id)}`), fetch('/api/admin/technicians')]);
    const claimData = await claimRes.json(); const techData = await techRes.json();
    if (!claimRes.ok) throw new Error(claimData.error || 'Claim could not be loaded');
    renderWarrantyClaim(claimData.claim, techData.technicians || []);
  } catch (error) { document.getElementById('wcBody').innerHTML = `<div class="alert alert-danger mb-0">${re(error.message)}</div>`; }
};

async function claimPatch(action, payload) {
  const response = await fetch(`/api/admin/warranty-claims/${encodeURIComponent(activeClaimId)}/${action}`, { method:'PATCH', headers:{'Content-Type':'application/json','Accept':'application/json'}, body:JSON.stringify(payload) });
  const data = await response.json();
  if (!response.ok) throw new Error(data.error || 'Action failed');
  await loadClaimQueue(); await openWarrantyClaim(activeClaimId); await loadWarranties();
}
window.triageClaim = () => claimPatch('triage',{ priority:document.getElementById('wcPriority').value, note:document.getElementById('wcTriageNote').value }).catch(e=>alert(e.message));
window.scheduleClaimInspection = () => claimPatch('schedule-inspection',{ technicianId:document.getElementById('wcTechnician').value, scheduledDate:document.getElementById('wcInspectionDate').value, timeSlot:document.getElementById('wcTimeSlot').value, note:document.getElementById('wcTriageNote')?.value }).catch(e=>alert(e.message));
window.decideClaim = () => claimPatch('decision',{ outcome:document.getElementById('wcOutcome').value, remedyType:document.getElementById('wcRemedy').value, amount:document.getElementById('wcAmount').value, reason:document.getElementById('wcDecisionReason').value }).catch(e=>alert(e.message));
window.updateClaimRemedy = complete => claimPatch('remedy',{ complete, notes:document.getElementById('wcRemedyNotes').value, oldSerialNumber:document.getElementById('wcOldSerial').value, newSerialNumber:document.getElementById('wcNewSerial').value }).catch(e=>alert(e.message));
window.closeDeniedClaim = () => claimPatch('close',{ overrideReason:'Administrative closure after documented denial decision' }).catch(e=>alert(e.message));

function renderPage(page) {
  const start = (page - 1) * pageSize;
  const slice = filteredData.slice(start, start + pageSize);
  if (!slice.length) {
    document.getElementById('warrantyRows').innerHTML = '<tr><td colspan="8" class="text-center text-muted py-5"><i class="bi bi-shield fs-4 d-block mb-2"></i>No warranty records found.</td></tr>';
    warrantyFooter.innerHTML = '<nav><ul class="inv-pagination justify-content-end mb-0"><li class="page-item disabled"><a class="page-link" href="javascript:void(0)">Prev</a></li><li class="page-item active"><span class="page-link">1 / 1</span></li><li class="page-item disabled"><a class="page-link" href="javascript:void(0)">Next</a></li></ul></nav>';
    return;
  }
  const now = Date.now();
  document.getElementById('warrantyRows').innerHTML = slice.map(b => {
    const w = b.warranty || {};
    const status = w.status;
    const typeBadge = b.type === 'order'
      ? '<span class="badge bg-info text-white me-1"><i class="bi bi-bag me-1"></i>Order</span>'
      : '<span class="badge bg-primary text-white me-1"><i class="bi bi-wrench me-1"></i>Booking</span>';
    const statusBadge = status === 'claimed'
      ? '<span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>Claimed</span>'
      : status === 'expired'
        ? '<span class="badge bg-secondary"><i class="bi bi-shield-x me-1"></i>Expired</span>'
        : status === 'incomplete'
          ? '<span class="badge bg-danger"><i class="bi bi-calendar-x me-1"></i>Needs Dates</span>'
        : '<span class="badge bg-success"><i class="bi bi-shield-check me-1"></i>Active</span>';
    const endDate = w.endDate ? new Date(w.endDate) : null;
    const startDate = w.startDate ? new Date(w.startDate) : null;
    const remaining = endDate ? Math.max(0, Math.ceil((endDate - now) / (1000 * 60 * 60 * 24))) : '—';
    const totalDays = w.days || 30;
    const elapsed = startDate ? Math.ceil((now - startDate) / (1000 * 60 * 60 * 24)) : 0;
    const progress = Math.min(100, Math.max(0, (elapsed / totalDays) * 100));
    const progressColor = remaining <= 7 ? '#ef4444' : remaining <= 14 ? '#f59e0b' : '#10b981';
    const progressWidth = status === 'claimed' ? 100 : progress;
    const daysText = status === 'claimed'
      ? '<span class="text-muted">Claimed</span>'
      : status === 'expired'
        ? '<span class="text-muted">Coverage ended</span>'
      : status === 'incomplete'
        ? '<span class="text-danger">Dates required</span>'
      : (typeof remaining === 'number' ? `<strong style="color:${progressColor}">${remaining} days</strong>` : '—');
    return `<tr>
      <td class="fw-semibold">${typeBadge} ${re(b.reference)}</td>
      <td>${re(b.customer?.name)}</td>
      <td>${re(b.service)}</td>
      <td>${statusBadge}</td>
      <td>${startDate ? startDate.toLocaleDateString('en-PH') : '—'}</td>
      <td>${endDate ? endDate.toLocaleDateString('en-PH') : '—'}</td>
      <td>
        <div class="mb-1">${daysText}</div>
        <div class="warranty-progress">
          <div class="warranty-progress-bar" style="width:${progressWidth}%; background:${status === 'claimed' ? '#f59e0b' : progressColor};"></div>
        </div>
      </td>
      <td>
        <button type="button" class="btn btn-sm btn-outline-primary" onclick="openWarrantyDetails('${re(b.type)}','${re(b._id)}',this)"><i class="bi bi-eye me-1"></i>View</button>
      </td>
    </tr>`;
  }).join('');
  renderPagination(page, Math.ceil(filteredData.length / pageSize) || 1, filteredData.length);
}

function renderPagination(page, pages, total) {
  const disabled = total === 0;
  warrantyFooter.innerHTML = `<nav><ul class="inv-pagination justify-content-end mb-0">
    <li class="page-item ${page <= 1 || disabled ? 'disabled' : ''}">
      <a class="page-link" href="javascript:void(0)" data-page="${page - 1}">Prev</a>
    </li>
    <li class="page-item active">
      <span class="page-link">${disabled ? '1 / 1' : `${page} / ${pages}`}</span>
    </li>
    <li class="page-item ${page >= pages || disabled ? 'disabled' : ''}">
      <a class="page-link" href="javascript:void(0)" data-page="${page + 1}">Next</a>
    </li>
  </ul></nav>`;
  warrantyFooter.querySelectorAll('.page-link[data-page]').forEach(el => {
    el.addEventListener('click', e => {
      e.preventDefault();
      const target = e.target.closest('.page-link');
      const newPage = parseInt(target?.dataset.page);
      if (!target?.closest('.page-item.disabled') && newPage >= 1 && newPage <= pages) {
        currentPage = newPage;
        renderPage(currentPage);
      }
    });
  });
}

function warrantyDate(value, dateOnly = false) {
  if (!value) return 'Not recorded';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return 'Not recorded';
  const options = dateOnly
    ? { timeZone: 'Asia/Manila', year: 'numeric', month: 'long', day: 'numeric' }
    : { timeZone: 'Asia/Manila', year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit' };
  return date.toLocaleString('en-PH', options);
}

function warrantyMoney(value) {
  if (value === null || value === undefined || value === '') return 'Not recorded';
  const amount = Number(value);
  return Number.isFinite(amount)
    ? `PHP ${amount.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
    : 'Not recorded';
}

function warrantyLabel(value) {
  return String(value || 'Not recorded')
    .replace(/_/g, ' ')
    .replace(/\b\w/g, char => char.toUpperCase());
}

function warrantyField(label, value, full = false) {
  return `<div class="wd-field${full ? ' full' : ''}">
    <div class="wd-label">${re(label)}</div>
    <div class="wd-field-value">${re(value || 'Not recorded')}</div>
  </div>`;
}

function warrantySection(title, icon, body) {
  return `<section class="wd-section">
    <h6 class="wd-section-title"><i class="bi ${icon}"></i>${re(title)}</h6>
    <div class="wd-section-body">${body}</div>
  </section>`;
}

function warrantyStatusBadge(status) {
  if (status === 'claimed') return '<span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>Claimed</span>';
  if (status === 'expired') return '<span class="badge bg-secondary"><i class="bi bi-shield-x me-1"></i>Expired</span>';
  if (status === 'incomplete') return '<span class="badge bg-danger"><i class="bi bi-calendar-x me-1"></i>Needs Dates</span>';
  return '<span class="badge bg-success"><i class="bi bi-shield-check me-1"></i>Active</span>';
}

function renderWarrantyDetails(detail) {
  const warranty = detail.warranty || {};
  const end = warranty.endDate ? new Date(warranty.endDate) : null;
  const remainingDays = end && !Number.isNaN(end.getTime())
    ? Math.ceil((end.getTime() - Date.now()) / 86400000)
    : null;
  const remainingText = warranty.status === 'claimed'
    ? 'Claim filed'
    : warranty.status === 'expired'
      ? remainingDays === null ? 'Coverage ended' : `Expired ${Math.abs(Math.min(remainingDays, 0))} day(s) ago`
      : warranty.status === 'incomplete'
        ? 'Completion date required'
        : remainingDays === null ? 'Not recorded' : `${Math.max(0, remainingDays)} day(s)`;

  document.getElementById('warrantyDetailTitle').textContent = detail.reference || 'Warranty Details';
  document.getElementById('warrantyDetailSubtitle').textContent = `${warrantyLabel(detail.type)} | ${warrantyLabel(detail.workflowStatus)}`;

  const customer = detail.customer || {};
  const technician = detail.technician || {};
  const peopleHtml = `<div class="wd-grid">
    ${warrantyField('Customer', customer.name)}
    ${warrantyField('Contact number', customer.phone)}
    ${warrantyField('Email address', customer.email)}
    ${warrantyField('Assigned technician', technician.name || 'Not recorded')}
    ${warrantyField('Service address', customer.address, true)}
    ${(technician.phone || technician.email) ? warrantyField('Technician contact', [technician.phone, technician.email].filter(Boolean).join(' | '), true) : ''}
  </div>`;

  const records = detail.type === 'order' ? (detail.items || []) : (detail.services || []);
  const recordsHtml = records.length ? records.map((item, index) => {
    const title = detail.type === 'order'
      ? [item.brand, item.model].filter(Boolean).join(' ') || `Product ${index + 1}`
      : item.name || `Service ${index + 1}`;
    const meta = detail.type === 'order'
      ? [item.capacity, `Quantity: ${item.quantity || 1}`].filter(Boolean).join(' | ')
      : [item.unitType, item.brand, item.model, item.capacity, `Quantity: ${item.quantity || 1}`, item.status ? warrantyLabel(item.status) : null].filter(Boolean).join(' | ');
    return `<div class="wd-record">
      <div class="wd-record-main"><div class="wd-record-title">${re(title)}</div><div class="wd-record-meta">${re(meta || 'No additional unit details')}</div></div>
      <div class="wd-record-amount">${warrantyMoney(item.totalPrice ?? item.unitPrice)}</div>
    </div>`;
  }).join('') : '<div class="wd-empty">No service or product lines were recorded.</div>';

  const payment = detail.payment || {};
  const paymentStatusNotes = {
    waiting_for_remittance: 'Customer payment was collected on-site and is awaiting technician remittance.',
    payment_collected: 'Customer payment has been collected and is awaiting reconciliation.',
    remitted: 'Technician remittance was submitted and is awaiting final verification.',
    verified: 'Payment and remittance have been verified.',
    paid: 'Payment is fully settled.',
    partial: 'Only part of the required amount has been recorded.',
    pending: 'Payment has not yet been fully recorded.',
  };
  const paymentFields = detail.type === 'order'
    ? [
        warrantyField('Payment status', warrantyLabel(payment.status)),
        warrantyField('Payment method', warrantyLabel(payment.method)),
        warrantyField('Subtotal', warrantyMoney(payment.subtotal)),
        warrantyField('Delivery fee', warrantyMoney(payment.deliveryFee)),
        warrantyField('Installation fee', warrantyMoney(payment.installationFee)),
        warrantyField('Transportation fee', warrantyMoney(payment.transportationFee)),
        warrantyField('Downpayment', warrantyMoney(payment.downpayment)),
        warrantyField('Total collected', warrantyMoney(payment.amountPaid)),
        warrantyField('Balance', warrantyMoney(payment.balance)),
        warrantyField('Order total', warrantyMoney(payment.total), true),
      ]
    : [
        warrantyField('Payment status', warrantyLabel(payment.status)),
        warrantyField('Payment method', warrantyLabel(payment.method)),
        warrantyField('Total collected', warrantyMoney(payment.amountPaid)),
        warrantyField('Remaining balance', warrantyMoney(payment.balance)),
        warrantyField('Service total', warrantyMoney(payment.total), true),
      ];
  const paymentsHtml = (detail.payments || []).length
      ? `<div class="mt-3 pt-3 border-top"><div class="wd-label mb-2">Payment and remittance transactions</div>${detail.payments.map(transaction => {
        const collectedDate = transaction.collectedAt || transaction.completedAt || transaction.submittedAt;
        const collected = Boolean(transaction.collectedAt || ['payment_collected', 'waiting_for_remittance', 'remitted', 'verified', 'paid', 'partial'].includes(transaction.status));
        const remitted = Boolean(transaction.remittedAt || transaction.verifiedAt || transaction.status === 'remitted' || transaction.status === 'verified');
        const verified = Boolean(transaction.verifiedAt || transaction.status === 'verified' || transaction.status === 'paid');
        const wasRejected = transaction.status === 'rejected' || transaction.rejectedAt;
        return `<div class="wd-payment-entry">
          <div class="d-flex justify-content-between gap-3 align-items-start">
            <div class="wd-record-main"><div class="wd-record-title">${re(warrantyLabel(transaction.type))} via ${re(warrantyLabel(transaction.method))}</div><div class="wd-record-meta">${re(warrantyLabel(transaction.status))}${transaction.reference ? ` | Ref: ${re(transaction.reference)}` : ''}</div></div>
            <div class="wd-record-amount">${warrantyMoney(transaction.amount)}</div>
          </div>
          <div class="wd-remit-steps">
            <div class="wd-remit-step ${collected ? 'done' : 'pending'}"><i class="bi ${collected ? 'bi-cash-coin' : 'bi-clock'}"></i><div class="wd-remit-name">${collected ? 'Collected' : 'Submitted'}</div><div class="wd-remit-date">${re(warrantyDate(collectedDate))}</div></div>
            <div class="wd-remit-line ${remitted ? 'done' : ''}"></div>
            <div class="wd-remit-step ${remitted ? 'done' : 'pending'}"><i class="bi ${remitted ? 'bi-check-lg' : 'bi-hourglass-split'}"></i><div class="wd-remit-name">${remitted ? 'Remitted' : 'Awaiting remittance'}</div><div class="wd-remit-date">${re(remitted ? warrantyDate(transaction.remittedAt) : 'Technician action required')}</div></div>
            <div class="wd-remit-line ${verified ? 'done' : ''}"></div>
            <div class="wd-remit-step ${verified ? 'done' : 'pending'}"><i class="bi ${verified ? 'bi-check-lg' : 'bi-shield-lock'}"></i><div class="wd-remit-name">${verified ? 'Verified' : 'Admin verification'}</div><div class="wd-remit-date">${re(verified ? warrantyDate(transaction.verifiedAt || transaction.completedAt) : 'Pending remittance')}</div></div>
          </div>
          ${transaction.collectedByName ? `<div class="wd-record-meta mt-2">Collected by: ${re(transaction.collectedByName)}</div>` : ''}
          ${transaction.remittanceNotes ? `<div class="wd-record-meta">Remittance notes: ${re(transaction.remittanceNotes)}</div>` : ''}
          ${transaction.remittanceProofSubmitted ? '<div class="wd-record-meta text-success"><i class="bi bi-paperclip me-1"></i>Remittance proof submitted</div>' : ''}
          ${wasRejected ? `<div class="alert alert-danger py-2 px-3 small mt-2 mb-0"><strong>Rejected:</strong> ${re(transaction.rejectionReason || 'No reason recorded')}</div>` : ''}
          ${!remitted && ['waiting_for_remittance', 'payment_collected'].includes(transaction.status) ? '<div class="alert alert-warning py-2 px-3 small mt-2 mb-0"><i class="bi bi-exclamation-triangle me-1"></i>The technician must submit this collection from My Remittances before an admin can verify it.</div>' : ''}
        </div>`;
      }).join('')}</div>`
    : '<div class="wd-empty mt-3 border-top">No separate payment-ledger entries were found; totals use the booking snapshot.</div>';
  const reconciliation = payment.reconciliation || {};
  const reconciliationHtml = reconciliation.hasLedgerMismatch
    ? `<div class="alert alert-danger mt-3 mb-0">
        <div class="fw-bold"><i class="bi bi-exclamation-octagon-fill me-1"></i>Payment ledger is incomplete</div>
        <div class="small mt-1">The booking total is ${warrantyMoney(reconciliation.total)}, but traceable payment transactions account for only ${warrantyMoney(reconciliation.ledgerCollected)}. The unreconciled amount is <strong>${warrantyMoney(reconciliation.outstandingFromLedger)}</strong>.</div>
        <div class="small mt-2">Do not treat this booking as financially settled until the missing collection is recorded and remitted.</div>
        <a class="btn btn-sm btn-outline-danger mt-2" href="/admin/payments/remittance"><i class="bi bi-cash-stack me-1"></i>Open Remittance Queue</a>
      </div>`
    : '';
  const paymentNote = paymentStatusNotes[payment.status]
    ? `<div class="alert alert-light border mt-3 mb-0 py-2 px-3 small"><i class="bi bi-info-circle me-1 text-primary"></i>${re(paymentStatusNotes[payment.status])}</div>`
    : '';

  let operationalHtml = '';
  if (detail.type === 'order') {
    operationalHtml = `<div class="wd-grid">
      ${warrantyField('Fulfillment', warrantyLabel(detail.fulfillmentType))}
      ${warrantyField('Pickup location', detail.pickupLocation)}
      ${warrantyField('Delivery address', detail.delivery?.address, true)}
      ${warrantyField('Delivery notes', detail.delivery?.notes, true)}
    </div>`;
  } else {
    const completion = detail.completion || {};
    const parts = (completion.partsInstalled || []).map(part => `${part.name} x${part.quantity || 1}`).join(', ');
    const actions = (completion.actionsPerformed || []).join(', ');
    const equipment = [detail.equipment?.brand, detail.equipment?.model, detail.equipment?.unitType, detail.equipment?.hpDescription].filter(Boolean).join(' | ');
    const isRepairOutcome = detail.serviceType === 'repair' || detail.issueDescription || parts || actions || completion.completionNotes;
    operationalHtml = isRepairOutcome
      ? `<div class="wd-grid">
          ${warrantyField('Service type', warrantyLabel(detail.serviceType))}
          ${warrantyField('Equipment', equipment)}
          ${detail.issueDescription ? warrantyField('Reported issue', detail.issueDescription, true) : ''}
          ${parts ? warrantyField('Parts installed', parts, true) : ''}
          ${actions ? warrantyField('Actions performed', actions, true) : ''}
          ${completion.completionNotes ? warrantyField('Completion notes', completion.completionNotes, true) : ''}
          ${warrantyField('Completion proof', completion.proofSubmitted ? 'Submitted' : 'Not recorded')}
        </div>`
      : `<div class="wd-grid">
          ${warrantyField('Service type', warrantyLabel(detail.serviceType))}
          ${warrantyField('Equipment serviced', equipment)}
          ${warrantyField('Completion proof', completion.proofSubmitted ? 'Submitted' : 'Not recorded')}
          ${warrantyField('Next maintenance', completion.nextMaintenanceDays ? `${completion.nextMaintenanceDays} days` : 'Not recorded')}
          ${completion.nextMaintenanceNotes ? warrantyField('Maintenance recommendation', completion.nextMaintenanceNotes, true) : ''}
          <div class="wd-field full"><div class="alert alert-light border mb-0 py-2 px-3 small"><i class="bi bi-info-circle me-1 text-primary"></i>Repair diagnosis and installed-parts fields do not apply to this core service.</div></div>
        </div>`;
  }

  const dateLabels = {
    created: 'Record created', updated: 'Last updated', requestedService: 'Requested service date',
    scheduledService: 'Scheduled service date', inspectionScheduled: 'Inspection scheduled',
    inspectionCompleted: 'Inspection completed', diagnosisCompleted: 'Diagnosis completed',
    quotationCreated: 'Quotation created', quotationExpires: 'Quotation expiry',
    customerDecision: 'Customer decision', assigned: 'Technician assigned', paymentVerified: 'Payment verified', paymentCollected: 'On-site payment collected',
    serviceCompleted: 'Service completed', requestedDelivery: 'Requested delivery date',
    requestedPickup: 'Requested pickup date', technicianResponded: 'Technician responded',
    orderCompleted: 'Order completed', warrantyStarted: 'Warranty started', warrantyEnds: 'Warranty ends',
    warrantyClaimed: 'Warranty claimed', followUpScheduled: 'Follow-up scheduled', followUpCompleted: 'Follow-up completed',
  };
  const dateOnlyKeys = new Set(['requestedService', 'scheduledService', 'requestedDelivery', 'requestedPickup', 'warrantyStarted', 'warrantyEnds', 'followUpScheduled']);
  const dates = Object.entries(detail.dates || {})
    .filter(([, value]) => value && !Number.isNaN(new Date(value).getTime()))
    .sort((a, b) => new Date(a[1]) - new Date(b[1]));
  const datesHtml = dates.length ? `<div class="wd-timeline">${dates.map(([key, value]) => `<div class="wd-event">
    <div class="wd-event-title">${re(dateLabels[key] || warrantyLabel(key))}</div>
    <div class="wd-event-date">${re(warrantyDate(value, dateOnlyKeys.has(key)))}</div>
  </div>`).join('')}</div>` : '<div class="wd-empty">No lifecycle dates were recorded.</div>';

  const history = [...(detail.statusHistory || [])]
    .filter(entry => entry.at)
    .sort((a, b) => new Date(b.at) - new Date(a.at));
  const historyHtml = history.length ? history.map(entry => `<div class="wd-record">
    <div class="wd-record-main">
      <div class="wd-record-title">${re(warrantyLabel(entry.status))}</div>
      <div class="wd-record-meta">${re([entry.by, entry.note].filter(Boolean).join(' | ') || 'Workflow update')}</div>
    </div>
    <div class="wd-record-amount">${re(warrantyDate(entry.at))}</div>
  </div>`).join('') : '<div class="wd-empty">No status history was recorded.</div>';

  const claimHtml = warranty.status === 'claimed' || warranty.claimIssue
    ? `<div class="wd-alert"><div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle me-1"></i>Warranty claim</div><div>${re(warranty.claimIssue || 'No claim description was recorded.')}</div><div class="small mt-2">Filed: ${re(warrantyDate(warranty.claimedAt))}</div></div>`
    : '';
  const coverageSourceHtml = warranty.datesInferred
    ? '<div class="alert alert-info border mb-0 py-2 px-3 small"><i class="bi bi-info-circle me-1"></i>Coverage dates were reconstructed from the recorded job completion date using the saved warranty duration.</div>'
    : '';

  document.getElementById('warrantyDetailBody').innerHTML = `
    <div class="wd-summary">
      <div class="wd-summary-item"><div class="wd-label">Coverage status</div><div class="wd-value">${warrantyStatusBadge(warranty.status)}</div></div>
      <div class="wd-summary-item"><div class="wd-label">Warranty start</div><div class="wd-value">${re(warrantyDate(warranty.startDate, true))}</div></div>
      <div class="wd-summary-item"><div class="wd-label">Warranty end</div><div class="wd-value">${re(warrantyDate(warranty.endDate, true))}</div></div>
      <div class="wd-summary-item"><div class="wd-label">Remaining</div><div class="wd-value">${re(remainingText)}</div></div>
    </div>
    <div class="wd-content">
      <div class="wd-column">
        ${claimHtml}
        ${coverageSourceHtml}
        ${warrantySection('Customer and assignment', 'bi-person-vcard', peopleHtml)}
        ${warrantySection(detail.type === 'order' ? 'Products covered' : 'Services covered', detail.type === 'order' ? 'bi-box-seam' : 'bi-tools', recordsHtml)}
        ${warrantySection(detail.type === 'order' ? 'Fulfillment details' : 'Service outcome', 'bi-clipboard-check', operationalHtml)}
        ${warrantySection('Payment breakdown', 'bi-credit-card', `<div class="wd-grid">${paymentFields.join('')}</div>${paymentNote}${reconciliationHtml}${paymentsHtml}`)}
      </div>
      <div class="wd-column">
        ${warrantySection('Important dates', 'bi-calendar3', datesHtml)}
        ${warrantySection('Status history', 'bi-clock-history', historyHtml)}
      </div>
    </div>`;
}

window.openWarrantyDetails = async function(type, id, button) {
  const modalElement = document.getElementById('warrantyDetailModal');
  const body = document.getElementById('warrantyDetailBody');
  const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
  const originalButton = button?.innerHTML;

  document.getElementById('warrantyDetailTitle').textContent = 'Warranty Details';
  document.getElementById('warrantyDetailSubtitle').textContent = 'Loading record...';
  body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="text-muted small mt-3 mb-0">Loading warranty record...</p></div>';
  modal.show();

  if (button) {
    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
  }

  try {
    const response = await fetch(`/api/admin/warranties/${encodeURIComponent(type)}/${encodeURIComponent(id)}`, {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' },
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'The warranty record could not be loaded.');
    renderWarrantyDetails(data);
  } catch (error) {
    document.getElementById('warrantyDetailSubtitle').textContent = 'Unable to load record';
    body.innerHTML = `<div class="p-4"><div class="alert alert-danger mb-0 d-flex gap-3 align-items-start">
      <i class="bi bi-exclamation-octagon-fill fs-5"></i>
      <div><div class="fw-bold">Warranty details unavailable</div><div class="small mt-1">${re(error.message || 'Please try again.')}</div></div>
    </div></div>`;
  } finally {
    if (button) {
      button.disabled = false;
      button.innerHTML = originalButton;
    }
  }
};

loadWarranties();
loadClaimQueue().then(() => {
  const focusedClaim = new URLSearchParams(location.search).get('claim');
  if (focusedClaim) openWarrantyClaim(focusedClaim);
});
</script>
