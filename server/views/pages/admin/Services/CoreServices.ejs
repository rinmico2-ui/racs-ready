          <div>
            <h6 class="text-muted mb-1" style="font-size: 0.85rem; font-weight: 500;">Needs Review</h6>
            <div class="d-flex align-items-baseline gap-2">
              <span class="h3 mb-0 fw-bold text-dark" id="statReview"><%= reviewCount %></span>
              <span class="kpi-trend up"><i class="bi bi-arrow-up"></i> 0%</span>
              <span class="kpi-percent-badge"><%= totalCount ? Math.round((reviewCount/totalCount)*100) : 0 %>%</span>
            </div>
            <small class="text-muted">Inactive or draft</small>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
            <i class="bi bi-pencil-square text-white"></i>
          </div>
        </div>
        <div class="stat-sparkline"><canvas id="sparkCoreReview" height="40"></canvas></div>
      </div>
    </div>
    <div class="col-lg col-md-6">
      <div class="dash-card h-100" data-accent="purple" data-aos="fade-up" data-aos-delay="300">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <h6 class="text-muted mb-1" style="font-size: 0.85rem; font-weight: 500;">Avg Completion Time</h6>
            <div class="d-flex align-items-baseline gap-2">
              <span class="h3 mb-0 fw-bold text-dark" id="statAvgTimeCore"><%= fmtDuration(Math.round(avgTime)) %></span>
              <span class="kpi-trend up"><i class="bi bi-arrow-up"></i> 0%</span>
              <span class="kpi-percent-badge">AVG</span>
            </div>
