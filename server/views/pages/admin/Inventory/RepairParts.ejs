<div class="admin-dashboard container-fluid px-0 py-4">
  <%- include('../../../partials/dashboard-styles') %>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    :root {
      --rp-font: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      --rp-heading: 'Outfit', 'Inter', sans-serif;
      --rp-slate-900: #0f172a;
      --rp-slate-800: #1e293b;
      --rp-slate-700: #334155;
      --rp-slate-600: #475569;
      --rp-slate-500: #64748b;
      --rp-slate-400: #94a3b8;
      --rp-slate-300: #cbd5e1;
      --rp-slate-200: #e2e8f0;
      --rp-slate-100: #f1f5f9;
      --rp-slate-50: #f8fafc;
      --rp-blue-500: #3b82f6;
      --rp-blue-700: #1d4ed8;
      --rp-blue-800: #1e40af;
      --rp-green-500: #22c55e;
      --rp-green-600: #16a34a;
      --rp-green-700: #15803d;
      --rp-amber-500: #f59e0b;
      --rp-amber-700: #b45309;
      --rp-amber-800: #92400e;
      --rp-red-500: #ef4444;
      --rp-red-600: #dc2626;
      --rp-purple-500: #7c3aed;
    }

    .rp-inner { max-width: 1400px; margin: 0 auto; padding: 0 1.5rem; }

    /* Stats */
    .rp-stats { display: flex; flex-wrap: wrap; gap: 18px; margin-bottom: 24px; }
    .rp-stat { flex: 1 1 260px; min-width: 260px; max-width: 100%; background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 8px; transition: all 0.2s; position: relative; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
    .rp-stat:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.08); transform: translateY(-2px); }
    .rp-stat-top { display: flex; justify-content: space-between; align-items: flex-start; }
    .rp-stat-title { font-size: 0.72rem; color: #64748b; font-weight: 600; }
    .rp-stat-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1rem; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
    .rp-stat-icon.blue { background: #3b82f6; color: #fff; }
    .rp-stat-icon.green { background: #22c55e; color: #fff; }
    .rp-stat-icon.amber { background: #f59e0b; color: #fff; }
    .rp-stat-icon.red { background: #ef4444; color: #fff; }
    .rp-stat-icon.purple { background: #7c3aed; color: #fff; }
    .rp-stat-main { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 2px; }
    .rp-stat-value { font-size: 1.5rem; font-weight: 700; color: #0f172a; line-height: 1.1; }
    .rp-stat-pct { font-size: 0.7rem; font-weight: 600; padding: 2px 8px; border-radius: 10px; }
    .rp-stat-pct.blue { background: #eff6ff; color: #3b82f6; }
    .rp-stat-pct.green { background: #f0fdf4; color: #22c55e; }
    .rp-stat-pct.amber { background: #fffbeb; color: #f59e0b; }
    .rp-stat-pct.red { background: #fef2f2; color: #ef4444; }
    .rp-stat-pct.purple { background: #f5f3ff; color: #7c3aed; }
    .rp-stat-sub { font-size: 0.74rem; color: #94a3b8; font-weight: 500; }
    .rp-stat-line { width: 100%; height: 40px; box-sizing: border-box; padding: 0; margin-top: auto; }
    .rp-stat-canvas { width: 100%; height: 100%; display: block; }

    /* Toolbar */
    .rp-toolbar { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 16px 20px; margin-bottom: 20px; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px; }
    .rp-filter-group { display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 160px; }
    .rp-filter-group.search { flex: 1.8; min-width: 220px; }
    .rp-filter-label { font-size: 0.65rem; font-weight: 700; color: var(--rp-slate-400); text-transform: uppercase; letter-spacing: 0.6px; }
    .rp-filter-input { border-radius: 10px; border-color: var(--rp-slate-200); }
    .rp-search { flex: 1; min-width: 220px; }
    .rp-search .input-group-text { background: #fff; color: var(--rp-slate-400); border-color: var(--rp-slate-200); }
    .rp-search .form-control { border-color: var(--rp-slate-200); }
    .rp-filter-btn { height: 42px; border-radius: 10px; padding: 0 20px; font-weight: 600; }
    .rp-toolbar-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px; width: 100%; }
    .rp-reset-btn { height: 42px; border-radius: 10px; padding: 0 16px; font-weight: 600; font-size: 0.82rem; }
    .rp-filter-count { font-size: 0.7rem; color: #2563eb; font-weight: 600; margin-left: 6px; background: #eff6ff; padding: 2px 8px; border-radius: 10px; }

    /* Quick Actions */
    .rp-actions-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 16px; }
    .rp-actions-bar .btn { border-radius: 10px; font-size: 0.85rem; font-weight: 600; padding: 8px 14px; }
    .rp-actions-bar .btn i { margin-right: 6px; }

    /* Category Filter */
    .rp-cat-pills { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
    .rp-cat-pill { padding: 6px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; border: 1.5px solid #e2e8f0; background: #fff; color: #64748b; cursor: pointer; transition: all 0.2s; }
    .rp-cat-pill:hover { border-color: #3b82f6; color: #3b82f6; }
    .rp-cat-pill.active { background: #3b82f6; color: #fff; border-color: #3b82f6; }

    /* Parts Table */
    .rp-table-wrap { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; overflow-x: auto; }
    .rp-table { width: 100%; min-width: 1300px; border-collapse: collapse; }
    .rp-table thead th { background: #f8fafc; border-bottom: 2px solid #e2e8f0; padding: 12px 16px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; text-align: left; white-space: nowrap; }
    .rp-table tbody td { padding: 14px 16px; border-bottom: 1px solid #f1f5f9; font-size: 0.85rem; color: #1e293b; vertical-align: middle; }
    .rp-table tbody tr { transition: background 0.15s; }
    .rp-table tbody tr:hover { background: #f8fafc; }
    .rp-table tbody tr:hover td:last-child { background: #f8fafc; }
    .rp-table tbody tr:last-child td { border-bottom: none; }
    .rp-table th:last-child,
    .rp-table td:last-child { position: sticky; right: 0; background: #fff; z-index: 2; box-shadow: -2px 0 6px rgba(0,0,0,0.05); text-align: center; }
    .rp-table th:last-child { background: #f8fafc; }

    .rp-table-footer { display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; border-top: 1px solid #e2e8f0; background: #fff; flex-wrap: wrap; gap: 10px; }
    .rp-table-footer .pagination { margin: 0; }
    .rp-table-footer .page-link { border-radius: 8px; margin: 0 3px; padding: 6px 12px; font-size: 0.8rem; font-weight: 600; color: var(--rp-slate-600); border: 1px solid var(--rp-slate-200); }
    .rp-table-footer .page-item.active .page-link { background: var(--rp-blue-500); border-color: var(--rp-blue-500); color: #fff; }
    .rp-table-footer .page-item.disabled .page-link { color: var(--rp-slate-300); }
    .rp-pag-info { font-size: 0.8rem; color: var(--rp-slate-500); }

    /* Part Name */
    .rp-name { font-weight: 700; color: #0f172a; }
    .rp-spec { font-size: 0.75rem; color: #64748b; margin-top: 2px; }
    .rp-barcode { font-family: monospace; font-size: 0.7rem; color: #94a3b8; }

    /* Category Badge */
    .rp-cat-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 20px; font-size: 0.68rem; font-weight: 600; }
    .rp-cat-badge.capacitor { background: #eff6ff; color: #1d4ed8; }
    .rp-cat-badge.compressor { background: #fef3c7; color: #b45309; }
    .rp-cat-badge.motor { background: #f0fdf4; color: #15803d; }
    .rp-cat-badge.refrigerant { background: #faf5ff; color: #7c3aed; }
    .rp-cat-badge.pipe { background: #fff7ed; color: #c2410c; }
    .rp-cat-badge.electrical { background: #fef2f2; color: #dc2626; }
    .rp-cat-badge.general { background: #f1f5f9; color: #475569; }
    .rp-type-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 20px; font-size: 0.68rem; font-weight: 600; }
    .rp-type-badge.rp-type-equipment { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }
    .rp-type-badge.rp-type-part { background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
    .rp-type-badge.rp-type-consumable { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }
    .rp-type-badge.rp-type-tool { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }
    .rp-class-badge { display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;font-size:.68rem;font-weight:700;white-space:nowrap; }
    .rp-class-badge.merchandise { background:#ecfdf5;color:#047857;border:1px solid #a7f3d0; }
    .rp-class-badge.operational_asset { background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe; }
    .rp-class-picker { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px; }
    .rp-class-option { border:2px solid var(--rp-slate-200);border-radius:12px;padding:12px;cursor:pointer;display:flex;gap:10px;align-items:flex-start;background:#fff; }
    .rp-class-option:has(input:checked) { border-color:var(--rp-blue-500);background:#eff6ff; }
    .rp-class-option small { display:block;color:var(--rp-slate-500);font-size:.7rem; }

    /* Stock Badge */
    .rp-stock { display: inline-flex; align-items: center; gap: 5px; font-weight: 700; font-size: 0.85rem; }
    .rp-stock-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .rp-stock.in_stock .rp-stock-dot { background: #22c55e; box-shadow: 0 0 0 3px rgba(34,197,94,0.15); }
    .rp-stock.in_stock { color: #15803d; }
    .rp-stock.low_stock .rp-stock-dot { background: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,0.15); }
    .rp-stock.low_stock { color: #b45309; }
    .rp-stock.out_of_stock .rp-stock-dot { background: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,0.15); }
    .rp-stock.out_of_stock { color: #dc2626; }
    .rp-stock.discontinued .rp-stock-dot { background: #94a3b8; }
    .rp-stock.discontinued { color: #64748b; }

    .rp-min-stock { font-size: 0.7rem; color: #94a3b8; }

    /* Price */
    .rp-price { font-weight: 700; color: #0f172a; }
    .rp-price-cost { font-weight: 600; color: #dc2626; font-size: 0.82rem; }
    .rp-profit { font-weight: 700; color: #16a34a; font-size: 0.82rem; }
    .rp-profit-margin { font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; font-weight: 600; }
    .rp-profit-margin.high { background: #dcfce7; color: #166534; }
    .rp-profit-margin.medium { background: #fef3c7; color: #92400e; }
    .rp-profit-margin.low { background: #fee2e2; color: #991b1b; }

    /* Actions */
    .rp-actions { display: flex; gap: 8px; align-items: center; justify-content: center; flex-wrap: nowrap; }
    .rp-actions .btn { width: 30px; height: 30px; padding: 0; font-size: 0.75rem; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; }

    /* Modal */
    .rp-modal .modal-content { border: none; border-radius: 16px; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.25); }
    .rp-modal .modal-header { background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 40%, #2563eb 100%); color: #fff; border: none; padding: 20px 24px; }
    .rp-modal .modal-body { padding: 24px; }
    .rp-modal .modal-footer { padding: 16px 24px; border-top: 1px solid #f1f5f9; background: #fafbfc; }

    /* Stock update toast (POS-style) */
    .rp-toast-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center; }
    .rp-toast-overlay.show { display: flex; }
    .rp-toast-modal { background: #fff; border-radius: 16px; width: 420px; max-width: 90%; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.3); animation: rp-toast-in 0.2s ease; }
    @keyframes rp-toast-in { from { opacity: 0; transform: translateY(-20px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .rp-toast-header { padding: 18px 24px; background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 40%, #2563eb 100%); color: #fff; font-weight: 700; font-size: 1.05rem; text-align: center; position: relative; }
    .rp-toast-close { position: absolute; top: 50%; right: 16px; transform: translateY(-50%); background: none; border: none; color: #fff; font-size: 1.15rem; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; }
    .rp-toast-close:hover { background: rgba(255,255,255,0.15); }
    .rp-toast-body { padding: 24px; text-align: center; }
    .rp-toast-icon { width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; }
    .rp-toast-icon.success { background: #dcfce7; color: #16a34a; }
    .rp-toast-icon.error { background: #fee2e2; color: #ef4444; }
    .rp-toast-icon.warning { background: #fef3c7; color: #f59e0b; }
    .rp-toast-icon.info { background: #dbeafe; color: #3b82f6; }
    .rp-toast-message { font-size: 0.95rem; color: #334155; margin: 0 0 20px; line-height: 1.5; }
    .rp-toast-ok { padding: 10px 36px; border-radius: 10px; border: none; background: #e2e8f0; color: #0f172a; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: all 0.15s; }
    .rp-toast-ok:hover { background: #cbd5e1; }

    /* Custom confirm modal (POS-style header) */
    .rp-confirm-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center; }
    .rp-confirm-overlay.show { display: flex; }
    .rp-confirm-modal { background: #fff; border-radius: 16px; width: 420px; max-width: 90%; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.3); animation: rp-toast-in 0.2s ease; }
    .rp-confirm-header { padding: 18px 24px; background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 40%, #2563eb 100%); color: #fff; font-weight: 700; font-size: 1.05rem; text-align: center; position: relative; }
    .rp-confirm-close { position: absolute; top: 50%; right: 16px; transform: translateY(-50%); background: none; border: none; color: #fff; font-size: 1.15rem; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; }
    .rp-confirm-close:hover { background: rgba(255,255,255,0.15); }
    .rp-confirm-body { padding: 24px; text-align: center; }
    .rp-confirm-icon { width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; }
    .rp-confirm-icon.warning { background: #fef3c7; color: #f59e0b; }
    .rp-confirm-icon.success { background: #dcfce7; color: #16a34a; }
    .rp-confirm-icon.error { background: #fee2e2; color: #ef4444; }
    .rp-confirm-icon.info { background: #dbeafe; color: #3b82f6; }
    .rp-confirm-message { font-size: 1rem; color: #334155; margin: 0 0 20px; line-height: 1.5; }
    .rp-confirm-message strong { color: #0f172a; display: block; margin-bottom: 6px; }
    .rp-confirm-message small { color: #64748b; }
    .rp-confirm-actions { display: flex; justify-content: center; gap: 10px; }
    .rp-confirm-cancel { padding: 10px 24px; border-radius: 10px; border: none; background: #e2e8f0; color: #0f172a; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: all 0.15s; }
    .rp-confirm-cancel:hover { background: #cbd5e1; }
    .rp-confirm-delete { padding: 10px 24px; border-radius: 10px; border: none; background: #dc2626; color: #fff; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: all 0.15s; }
    .rp-confirm-delete:hover { background: #b91c1c; }

    /* Empty State */
    .rp-empty { text-align: center; padding: 60px 20px; color: #64748b; }
    .rp-empty i { font-size: 3rem; color: #cbd5e1; margin-bottom: 12px; display: block; }
    .rp-empty p { font-size: 0.9rem; margin: 0; }

    /* Loading */
    .rp-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; }
    .rp-loading .spinner-border { width: 2rem; height: 2rem; color: #3b82f6; }

    @media (max-width: 767px) {
      .rp-table-wrap { overflow-x: auto; }
      .rp-table { min-width: 1300px; }
      .rp-inner { padding: 0 1rem; }
    }

    /* Modal Form Cards */
    .rp-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .rp-form-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 20px; }
    .rp-form-card-header { display: flex; align-items: center; gap: 10px; font-weight: 700; color: #0f172a; font-size: 0.95rem; margin-bottom: 18px; }
    .rp-form-card-icon { width: 40px; height: 40px; border-radius: 11px; background: #eff6ff; color: #2563eb; display: inline-flex; align-items: center; justify-content: center; font-size: 1.2rem; }
    .rp-form-label { display: flex; align-items: center; gap: 6px; font-size: 0.65rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px; }
    .rp-form-label i { color: #2563eb; font-size: 0.85rem; }
    .rp-stock-summary-label i { font-size: 0.9rem; }
    .rp-modal .form-control, .rp-modal .form-select { border-radius: 10px; border-color: #e2e8f0; }
    .rp-modal .form-control:focus, .rp-modal .form-select:focus { border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12); }
    .rp-modal .form-control::placeholder { color: #94a3b8; }
    .rp-modal textarea { resize: none; }

    .rp-stock-summary { display: flex; align-items: center; gap: 10px; padding: 16px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; margin-bottom: 20px; }
    .rp-stock-summary-label { display: flex; align-items: center; justify-content: center; gap: 5px; font-size: 0.7rem; color: #64748b; margin-bottom: 4px; }
    .rp-stock-summary-value { font-size: 1.6rem; font-weight: 600; color: #166534; line-height: 1; }
    .rp-stock-summary-value.after { color: #1e293b; }
    .rp-stock-summary-arrow { font-size: 1.4rem; color: #94a3b8; }
    .rp-stock-toggle { border-radius: 10px; font-weight: 600; padding: 10px; border: 2px solid #e2e8f0; background: #fff; color: #64748b; }
    .rp-stock-toggle.active-in { border-color: #22c55e; background: #f0fdf4; color: #16a34a; }
    .rp-stock-toggle.active-out { border-color: #ef4444; background: #fef2f2; color: #dc2626; }

    @media (max-width: 767px) {
      .rp-form-grid { grid-template-columns: 1fr; }
    }

    /* Consistency overrides */
    .rp-inner { font-family: var(--rp-font); }
    .rp-inner h1, .rp-inner h2, .rp-inner h3 { font-family: var(--rp-heading); }
    .rp-stat-value, .rp-name, .rp-price { color: var(--rp-slate-900); }
    .rp-stat-title, .rp-stat-sub, .rp-spec, .rp-min-stock, .rp-empty, .rp-stock.discontinued, .rp-table thead th { color: var(--rp-slate-500); }
    .rp-table tbody td { color: var(--rp-slate-800); }
    .rp-barcode { font-family: var(--rp-font); font-variant-numeric: tabular-nums; }
    .rp-profit, .rp-stock.in_stock, .rp-profit-margin.high { color: var(--rp-green-700); }
    .rp-stock.low_stock, .rp-profit-margin.medium { color: var(--rp-amber-700); }
    .rp-stock.out_of_stock, .rp-profit-margin.low, .rp-price-cost { color: var(--rp-red-600); }
    .rp-cat-pill { color: var(--rp-slate-500); border-color: var(--rp-slate-200); }
    .rp-cat-pill:hover { color: var(--rp-blue-500); border-color: var(--rp-blue-500); }
    .rp-cat-pill.active { background: var(--rp-blue-500); color: #fff; border-color: var(--rp-blue-500); }
    /* Font weight consistency */
    .rp-stat-value { font-weight: 700; }
    .rp-name, .rp-price, .rp-stock, .rp-profit, .rp-table thead th, .rp-cat-badge, .rp-profit-margin, .rp-stat-pct { font-weight: 600; }
  </style>

  <div class="rp-inner">
    <div class="au-hero mb-4">
      <div class="au-hero-inner">
        <div class="au-hero-left">
          <div class="au-hero-icon"><i class="bi bi-box-seam"></i></div>
          <div>
            <h1 style="color:#2563eb;">Repair Parts Procurement</h1>
            <p>Source, manage, and procure repair parts and equipment needed when stock is unavailable for ongoing repair jobs</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Quick Actions -->
    <div class="rp-actions-bar">
      <a href="/admin/inventory/pos" class="btn btn-outline-primary btn-sm fw-semibold">
        <i class="bi bi-shop"></i>Open POS
      </a>
      <button class="btn btn-outline-primary btn-sm fw-semibold" onclick="generateBarcodes()">
