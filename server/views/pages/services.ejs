                      <text x="138" y="108" font-family="Arial Black,sans-serif" font-size="12" font-weight="900" fill="#1e40af" letter-spacing="1">RACS</text>
                      <g transform="translate(97,134)"><g class="racs-wheel"><circle cx="0" cy="0" r="30" fill="#0f172a" stroke="#e2e8f0" stroke-width="3"/><circle cx="0" cy="0" r="24" fill="#1e293b"/><circle cx="0" cy="0" r="16" fill="#cbd5e1"/><circle cx="0" cy="0" r="10" fill="#3b82f6"/><circle cx="0" cy="0" r="4" fill="#fff"/><line x1="0" y1="-16" x2="0" y2="16" stroke="#475569" stroke-width="3"/><line x1="-16" y1="0" x2="16" y2="0" stroke="#475569" stroke-width="3"/><line x1="-11" y1="-11" x2="11" y2="11" stroke="#475569" stroke-width="3"/><line x1="-11" y1="11" x2="11" y2="-11" stroke="#475569" stroke-width="3"/></g></g>
                      <g transform="translate(223,134)"><g class="racs-wheel"><circle cx="0" cy="0" r="30" fill="#0f172a" stroke="#e2e8f0" stroke-width="3"/><circle cx="0" cy="0" r="24" fill="#1e293b"/><circle cx="0" cy="0" r="16" fill="#cbd5e1"/><circle cx="0" cy="0" r="10" fill="#3b82f6"/><circle cx="0" cy="0" r="4" fill="#fff"/><line x1="0" y1="-16" x2="0" y2="16" stroke="#475569" stroke-width="3"/><line x1="-16" y1="0" x2="16" y2="0" stroke="#475569" stroke-width="3"/><line x1="-11" y1="-11" x2="11" y2="11" stroke="#475569" stroke-width="3"/><line x1="-11" y1="11" x2="11" y2="-11" stroke="#475569" stroke-width="3"/></g></g>
