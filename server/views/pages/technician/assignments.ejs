    --mw-warning: #f59e0b;
    --mw-danger: #ef4444;
    --mw-info: #06b6d4;
    --mw-purple: #8b5cf6;
    --mw-bg: #f1f5f9;
    --mw-card: #ffffff;
    --mw-border: #e2e8f0;
    --mw-text: #0f172a;
    --mw-text-secondary: #475569;
    --mw-text-muted: #94a3b8;
    --mw-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
    --mw-shadow: 0 1px 3px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);
    --mw-shadow-md: 0 4px 6px rgba(0, 0, 0, 0.05), 0 2px 4px rgba(0, 0, 0, 0.04);
    --mw-shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.08), 0 4px 10px rgba(0, 0, 0, 0.04);
    --mw-shadow-xl: 0 20px 40px rgba(0, 0, 0, 0.1), 0 8px 16px rgba(0, 0, 0, 0.06);
    --mw-radius: 16px;
    --mw-radius-sm: 10px;
    --mw-radius-xs: 8px;
    --mw-transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ── Hero Header (Enterprise Multi-Layer) ── */
  .mw-hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 40%, #2563eb 100%);
    border-radius: var(--mw-radius);
    padding: 28px 32px;
    color: #fff;
    position: relative;
    overflow: hidden;
    box-shadow: var(--mw-shadow-xl);
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 24px;
  }

  .mw-hero::before {
    content: '';
    position: absolute;
    top: -80%;
    right: -20%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(96, 165, 250, 0.12) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .mw-hero::after {
    content: '';
    position: absolute;
    bottom: -60%;
