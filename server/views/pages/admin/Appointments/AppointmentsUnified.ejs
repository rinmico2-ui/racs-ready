        '<div class="d-flex gap-2"><button class="au-btn au-btn-ghost flex-fill" onclick="AU.Active.viewDetail(\''+b._id+'\')" style="font-size:0.75rem;"><i class="bi bi-eye me-1"></i>Details</button><button class="au-btn au-btn-ghost" onclick="AU.Active.trackOnMap(\''+b._id+'\');setTimeout(function(){if(window.startTrackingRefresh)startTrackingRefresh();},500);" title="Track" style="padding:8px 12px;"><i class="bi bi-geo-alt"></i></button></div></div></div></div>';
    }).join('');
