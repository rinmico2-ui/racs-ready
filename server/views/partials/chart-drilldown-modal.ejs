<!-- ═══ Enterprise Chart Drilldown Modal ═══ -->
<!-- Include this partial in any report page that needs clickable chart modals -->
<div class="modal fade" id="chartDrilldownModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content cdm-content">
      <!-- Header -->
      <div class="cdm-header">
        <div class="cdm-header-left">
          <div class="cdm-header-icon"><i class="bi bi-bar-chart-line"></i></div>
          <div>
            <h5 class="cdm-title" id="cdmTitle">Chart Details</h5>
            <p class="cdm-subtitle" id="cdmSubtitle">Selected analytics records</p>
          </div>
        </div>
        <div class="cdm-header-actions">
          <span class="cdm-live-badge" id="cdmLiveBadge"><i class="bi bi-database-check"></i> Live data</span>
          <button type="button" class="cdm-close" data-bs-dismiss="modal" aria-label="Close">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
      </div>

      <!-- Body: Split View -->
      <div class="cdm-body">
        <!-- Left: Chart -->
        <div class="cdm-chart-panel">
          <div class="cdm-panel-heading">
            <span class="cdm-panel-kicker">Selected view</span>
            <strong id="cdmSelectionLabel">All records</strong>
          </div>
          <div class="cdm-chart-wrapper">
            <canvas id="cdmChartCanvas"></canvas>
          </div>
          <!-- Summary Stats -->
          <div class="cdm-summary-bar" id="cdmSummaryBar"></div>
        </div>

        <!-- Right: Details -->
        <div class="cdm-detail-panel">
          <div class="cdm-detail-heading">
            <div><span class="cdm-panel-kicker">Underlying records</span><strong id="cdmDataHeading">Selection details</strong></div>
            <span class="cdm-row-count" id="cdmHeaderRowCount"></span>
          </div>
          <!-- Filter Chips -->
          <div class="cdm-filter-bar" id="cdmFilterBar">
            <span class="cdm-filter-label"><i class="bi bi-funnel"></i> Filter:</span>
            <div class="cdm-filter-chips" id="cdmFilterChips"></div>
          </div>

          <!-- Detail Table -->
          <div class="cdm-state" id="cdmLoadingState" hidden aria-live="polite">
            <span class="cdm-spinner" aria-hidden="true"></span>
            <strong>Loading selected records</strong>
            <small>Retrieving the latest report data.</small>
          </div>
          <div class="cdm-state cdm-state-error" id="cdmErrorState" hidden role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>Unable to load selected records</strong>
            <small id="cdmErrorMessage">Please try the selection again.</small>
          </div>
          <div class="cdm-table-wrap" id="cdmTableWrap">
            <table class="cdm-table" id="cdmTable">
              <thead>
                <tr id="cdmTableHead">
                  <th>Item</th>
                  <th class="text-end">Value</th>
                </tr>
              </thead>
              <tbody id="cdmTableBody"></tbody>
            </table>
          </div>

          <!-- Export -->
          <div class="cdm-export-bar">
            <button type="button" class="cdm-export-btn" id="cdmExportBtn">
              <i class="bi bi-download"></i> Export CSV
            </button>
            <span class="cdm-row-count" id="cdmRowCount"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
