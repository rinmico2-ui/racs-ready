            'Speed switch and capacitor replacement',
            'Bearing lubrication and cleaning',
            'Cord and plug repair',
            'Full balance and safety test'
          ],
          price: 'Diagnosis: ₱200'
        },
        'Water Dispenser': {
          icon: 'bi-water',
          subtitle: 'Cooling, Heating & Leaking Problems',
          desc: 'Keep your water dispenser running cold and clean. We handle compressor issues, heating element failures, and leak repairs for all dispenser types.',
          features: [
            'Cooling compressor and thermostat repair',
            'Heating element replacement',
            'Leak detection and sealing',
            'Drip tray and drain line cleaning',
            'Power indicator and switch fix',
            'Water line sanitization',
            'Energy efficiency check'
          ],
          price: 'Diagnosis: ₱350'
        },
        'Electric Kettle': {
          icon: 'bi-thermometer',
          subtitle: 'Not Boiling, Auto-Off & Cord Issues',
          desc: 'Electric kettles are essential for daily use. We fix boiling failures, auto-shutoff issues, and cord damage with fast, affordable repairs.',
          features: [
            'Heating element testing and replacement',
            'Thermostat and thermal fuse repair',
            'Auto-shutoff mechanism calibration',
            'Power cord and base connector fix',
            'Switch and indicator light repair',
            'Water level sensor fix',
            'Descaling and deep cleaning'
          ],
          price: 'Diagnosis: ₱200'
        }
      };

      /* Click handler for service items */
      document.querySelectorAll('.svc-item').forEach(function(item, idx) {
        item.addEventListener('click', function() {
          var svcName = [
            'Aircon Installation', 'Aircon Cleaning', 'Freon Recharging',
            'Aircon Relocation', 'Dismantling & Reinstall', 'System Reprocess', 'Pump Down'
          ][idx];
          openSvcDetailModal(svcName);
        });
      });

      /* Click handler for repair tiles */
      document.querySelectorAll('.repair-tile').forEach(function(item, idx) {
        item.addEventListener('click', function() {
          var repairName = [
            'Refrigerator', 'Washing Machine', 'Microwave Oven', 'Freezer', 'Dryer',
            'Rice Cooker', 'Electric Fan', 'Water Dispenser', 'Electric Kettle'
          ][idx];
          openSvcDetailModal(repairName);
        });
      });

      /* Open modal */
      window.openSvcDetailModal = function(name) {
        var data = svcData[name];
        if (!data) return;
        var modal = document.getElementById('svcDetailModal');
        document.getElementById('svcDetailIcon').innerHTML = '<i class="bi ' + data.icon + '"></i>';
        document.getElementById('svcDetailTitle').textContent = name;
        document.getElementById('svcDetailSubtitle').textContent = data.subtitle;

        var bodyHtml = '<p>' + data.desc + '</p>';
        bodyHtml += '<ul class="svc-features-list">';
        data.features.forEach(function(f) {
          bodyHtml += '<li><i class="bi bi-check-circle-fill"></i><span>' + f + '</span></li>';
        });
        bodyHtml += '</ul>';
        bodyHtml += '<div class="svc-detail-price"><i class="bi bi-tag-fill"></i> ' + data.price + '</div>';
        document.getElementById('svcDetailBody').innerHTML = bodyHtml;

        modal.classList.add('show');
        document.body.style.overflow = 'hidden';
      };

      /* Close modal */
      window.closeSvcDetailModal = function() {
        var modal = document.getElementById('svcDetailModal');
        modal.classList.remove('show');
        document.body.style.overflow = '';
      };

      /* ESC key closes modal */
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') window.closeSvcDetailModal();
      });
    })();
  </script>
</section>

