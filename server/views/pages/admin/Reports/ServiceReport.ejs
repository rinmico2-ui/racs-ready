      <% } else { %>
        <div class="dash-empty"><i class="bi bi-check-circle" style="font-size:1.5rem;display:block;margin-bottom:8px;color:#10b981;"></i>No cancellations recorded — excellent performance!</div>
      <% } %>
    </div>
