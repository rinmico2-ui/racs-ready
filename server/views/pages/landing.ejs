<!-- Testimonials Slider -->
<section class="testimonials-premium py-5 position-relative" style="background: radial-gradient(circle at top, #0f1d3a, #050912); color:#fff; overflow:hidden;">
  <div class="position-absolute rounded-circle" style="width:520px;height:520px;background:radial-gradient(circle,rgba(59,130,246,0.18) 0%,transparent 70%);top:-180px;left:-120px;pointer-events:none;opacity:0.5;"></div>
  <div class="container position-relative" style="z-index:1;">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
      <div>
        <span class="contact-chip" style="background:rgba(255,255,255,0.08);border-color:rgba(255,255,255,0.2);color:#dbeafe;">Trusted Testimonials</span>
        <h2 class="display-6 fw-bold mt-3" style="letter-spacing:-1px;"><%= displayRating %> ★ Excellence in Service</h2>
        <p class="text-white-50 mb-0">Hear from satisfied clients who rely on CALIDRO RACS for exceptional air conditioning and appliance solutions.</p>
      </div>
      <div class="d-flex gap-2">
        <button class="testimonial-nav" id="testimonialPrev" aria-label="Previous testimonial"><i class="bi bi-arrow-left"></i></button>
        <button class="testimonial-nav" id="testimonialNext" aria-label="Next testimonial"><i class="bi bi-arrow-right"></i></button>
      </div>
    </div>

    <% const fallbackTestimonials = [
      { quote: 'CALIDRO restored our office climate control in under 24 hours. Their technicians demonstrated remarkable professionalism and transparent pricing.', name: 'Mara Santos', role: 'Operations Manager', score: 5 },
      { quote: 'The booking experience was seamless, and the technician provided clear explanations throughout the service process. Exceptional attention to detail.', name: 'Kenji Ramirez', role: 'Homeowner', score: 5 },
      { quote: 'We have entrusted CALIDRO with our quarterly maintenance for three years. Always punctual, meticulous, and committed to excellence.', name: 'Patrice Lim', role: 'Cafe Owner', score: 5 }
    ]; const displayTestimonials = testimonials.length > 0 ? testimonials : fallbackTestimonials; %>

    <div class="testimonial-track" id="testimonialTrack">
      <% displayTestimonials.forEach((item, index) => { %>
        <div class="testimonial-card" data-index="<%= index %>">
          <div class="testimonial-stars">
            <% for (let i = 0; i < (item.score || 5); i++) { %>
              <i class="bi bi-star-fill"></i>
            <% } %>
          </div>
          <p class="testimonial-quote">“<%= item.quote %>”</p>
          <div class="d-flex align-items-center gap-2">
            <div class="testimonial-avatar"> <i class="bi bi-person"></i> </div>
            <div>
              <p class="mb-0 fw-bold"><%= item.name %></p>
              <p class="mb-0 text-white-50 small"><%= item.role %></p>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <style>
    .testimonial-track {
      display: flex;
      gap: 1.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 1rem;
    }
    .testimonial-track::-webkit-scrollbar { display: none; }
    .testimonial-card {
      flex: 0 0 320px;
      background: rgba(255,255,255,0.08);
      border-radius: 1.5rem;
      padding: 1.5rem;
      border: 1px solid rgba(255,255,255,0.18);
      box-shadow: 0 20px 40px rgba(0,0,0,0.25);
      scroll-snap-align: start;
      position: relative;
    }
    .testimonial-stars {
      color: #fbbf24;
      letter-spacing: 0.15rem;
      margin-bottom: 1rem;
    }
    .testimonial-quote {
      font-size: 1rem;
      line-height: 1.7;
      color: rgba(255,255,255,0.9);
      min-height: 120px;
    }
    .testimonial-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
    }
    .testimonial-nav {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.4);
      background: transparent;
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }
    .testimonial-nav:hover {
      background: rgba(255,255,255,0.15);
      transform: translateY(-2px);
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const track = document.getElementById('testimonialTrack');
      const prev = document.getElementById('testimonialPrev');
      const next = document.getElementById('testimonialNext');
      if (!track) return;
      const scrollAmount = 360;
      prev && prev.addEventListener('click', () => track.scrollBy({ left: -scrollAmount, behavior: 'smooth' }));
      next && next.addEventListener('click', () => track.scrollBy({ left: scrollAmount, behavior: 'smooth' }));
    });
  </script>
</section>

