    charts.serviceEconomics = new Chart(document.getElementById('serviceEconomics'), {
      type: 'bar', data: { labels: ['Core', 'Repair', 'Mix'], datasets: [
        { label: 'Sales', data: [catRevenue('core'), catRevenue('repair'), catRevenue('mix')], backgroundColor: '#2563eb', borderRadius: 5 },
        { label: 'Saved parts cost', data: [catPartsCost('core'), catPartsCost('repair'), catPartsCost('mix')], backgroundColor: '#ef4444', borderRadius: 5 },
      ]}, options: { responsive: true, maintainAspectRatio: false, onClick: (e, els) => { if (els.length > 0) showChartDetail(chartConfigs.serviceEconomics, els[0].index, els[0].datasetIndex); }, onHover: (e, els) => { if (e.native) e.native.target.style.cursor = els.length > 0 ? 'pointer' : 'default'; }, scales, plugins: { legend: legendOpts, tooltip: tooltipFmt } }
    });

    // Product channel mix
    const productChannelEl = document.getElementById('productChannelMix');
    if (productChannelEl) {
      const orderProdRev = Number(A.onlineOrderProductRevenue || 0);
      const posProdRev = Number(A.posProductRevenue || 0);
      charts.productChannelMix = new Chart(productChannelEl, {
        type: 'doughnut', data: { labels: ['Product Orders', 'Walk-in sales Sales'], datasets: [{ data: [orderProdRev, posProdRev], backgroundColor: ['#10b981', '#f59e0b'], borderColor: '#fff', borderWidth: 3 }] },
        options: { responsive: true, maintainAspectRatio: false, cutout: '68%', onClick: (e, els) => { if (els.length > 0) showChartDetail(chartConfigs.productChannelMix, els[0].index, els[0].datasetIndex); }, onHover: (e, els) => { if (e.native) e.native.target.style.cursor = els.length > 0 ? 'pointer' : 'default'; }, plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 7, font: { size: 10 } } }, tooltip: { callbacks: { label: ctx => `${ctx.label}: ${pesoFmt(ctx.parsed)}` } } } }
      });
    }

    // Brand revenue chart
    const brandEl = document.getElementById('brandRevenue');
    if (brandEl && A.orderBrandAnalysis && A.orderBrandAnalysis.length) {
      charts.brandRevenue = new Chart(brandEl, {
        type: 'bar', data: {
          labels: A.orderBrandAnalysis.map(b => b.brand),
          datasets: [
            { label: 'Sales', data: A.orderBrandAnalysis.map(b => b.revenue), backgroundColor: '#10b981', borderRadius: 5 },
            { label: 'Units', data: A.orderBrandAnalysis.map(b => b.quantity), backgroundColor: '#06b6d4', borderRadius: 5, yAxisID: 'y1' }
          ]
        }, options: { responsive: true, maintainAspectRatio: false, onClick: (e, els) => { if (els.length > 0) showChartDetail(chartConfigs.brandRevenue, els[0].index, els[0].datasetIndex); }, onHover: (e, els) => { if (e.native) e.native.target.style.cursor = els.length > 0 ? 'pointer' : 'default'; }, scales: { x: { grid: { display: false }, ticks: { font: { size: 10 } } }, y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 10 }, callback: v => '\u20B1' + Number(v).toLocaleString() } }, y1: { position: 'right', beginAtZero: true, grid: { display: false }, ticks: { font: { size: 10 } } } }, plugins: { legend: legendOpts, tooltip: { callbacks: { label: ctx => ctx.dataset.label === 'Units' ? `${ctx.dataset.label}: ${ctx.parsed.y} units` : `${ctx.dataset.label}: ${pesoFmt(ctx.parsed.y)}` } } } }
