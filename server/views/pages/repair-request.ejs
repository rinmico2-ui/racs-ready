        <div class='photo-upload-hint'>Max 5 images · JPG, PNG · 5MB each</div>
      </div>
      <div id='photoPreview' class='mt-3 d-flex flex-wrap gap-2'></div>
    </section>
  </div>

  <div class='step2-actions'>
    <button type='button' class='ent-btn-primary' onclick='validateAndContinue(2)'>
      <i class='bi bi-arrow-right-circle me-2'></i>Continue to Location
    </button>
  </div>
</div>
<!-- Step 3: Location -->
          <div class="ent-step-card d-none booking-step" id="locationStep" data-step="3">
