    }
  };

  // ── Save Part ─────────────────────────────────────────────────────────
  let _procurePartSaved = false;
  window.savePart = async function() {
    const id = document.getElementById('partEditId').value;
    const name = document.getElementById('partName').value.trim();
    if (!name) { Swal.fire({ icon: 'warning', title: 'Required', text: 'Part name is required.', confirmButtonColor: '#2563eb', confirmButtonText: '<i class="bi bi-check-lg"></i> OK' }); return; }

    const body = {
      itemName: name,
      inventoryClass: document.querySelector('input[name="partInventoryClass"]:checked')?.value || 'merchandise',
      type: document.getElementById('partType').value,
      unit: document.getElementById('partUnit').value,
      category: document.getElementById('partCategory').value,
      specification: document.getElementById('partSpec').value.trim(),
      costPrice: parseFloat(document.getElementById('partCostPrice').value) || 0,
      sellingPrice: parseFloat(document.getElementById('partSellingPrice').value) || 0,
      quantity: parseInt(document.getElementById('partQty').value) || 0,
      minStockLevel: parseInt(document.getElementById('partMinStock').value) || 3,
      supplier: document.getElementById('partSupplier').value.trim(),
      serialNumber: document.getElementById('partSerialNumber').value.trim(),
      description: document.getElementById('partDesc').value.trim(),
      assetCode: document.getElementById('partAssetCode').value.trim() || null,
      assetCondition: document.getElementById('partAssetCondition').value,
      assetStatus: document.getElementById('partAssetStatus').value,
      maintenanceIntervalDays: parseInt(document.getElementById('partMaintenanceInterval').value) || 0,
      assignable: document.getElementById('partAssignable').checked,
      isStockItem: true,
      active: true,
    };

    const btn = document.getElementById('partSaveBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';

    try {
      const url = id ? `/api/admin/tools/${id}` : '/api/admin/tools';
      const method = id ? 'PATCH' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body)
      });
      const data = await res.json();
      if (res.ok) {
        _procurePartSaved = true;
        bootstrap.Modal.getInstance(document.getElementById('partModal'))?.hide();
        showRpToast(`${id ? 'Updated' : 'Added'}: ${name}`, 'success');
        await loadParts();
        if (_procureBookingId && _currentProcurePart && data.tool) {
          await window.linkProcuredPart(_procureBookingId, data.tool._id, _currentProcurePart.name || data.tool.itemName, data.tool.quantity);
        }
      } else {
        Swal.fire({ icon: 'error', title: 'Error', text: data.error || 'Failed to save.', confirmButtonColor: '#2563eb', confirmButtonText: '<i class="bi bi-check-lg"></i> OK', iconColor: '#dc2626' });
      }
    } catch (e) {
      Swal.fire({ icon: 'error', title: 'Error', text: 'Network error.', confirmButtonColor: '#2563eb', confirmButtonText: '<i class="bi bi-check-lg"></i> OK', iconColor: '#dc2626' });
    }
    btn.disabled = false;
    btn.innerHTML = id ? '<i class="bi bi-check-lg me-1"></i>Update Item' : '<i class="bi bi-plus-lg me-1"></i>Add Item';
  };

