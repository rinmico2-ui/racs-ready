      <span class="section-label mb-0" style="margin-right: 8px;">Quick Actions</span>
      <a href="/secretary/appointments" class="btn bg-white quick-action-btn"><i class="bi bi-plus-lg me-1" style="color: #2872A1"></i> Appointment</a>
      <a href="/secretary/calendar" class="btn bg-white quick-action-btn"><i class="bi bi-calendar me-1" style="color: #2872A1"></i> Calendar</a>
      <a href="/secretary/pointofsale" class="btn bg-white quick-action-btn"><i class="bi bi-cash-stack me-1" style="color: #10b981"></i> POS</a>
      <a href="/secretary/payments" class="btn bg-white quick-action-btn"><i class="bi bi-currency-dollar me-1" style="color: #10b981"></i> Payments</a>
      <a href="/secretary/inventory" class="btn bg-white quick-action-btn"><i class="bi bi-box-seam me-1" style="color: #ef4444"></i> Inventory</a>
      <a href="/secretary/services/core" class="btn bg-white quick-action-btn"><i class="bi bi-gear me-1" style="color: #2872A1"></i> Services</a>
      <a href="/secretary/reports/inventory" class="btn bg-white quick-action-btn"><i class="bi bi-graph-up me-1" style="color: #06b6d4"></i> Reports</a>
      <a href="/secretary/service-tracking" class="btn bg-white quick-action-btn"><i class="bi bi-truck me-1" style="color: #f59e0b"></i> Tracking</a>
    </div>

    <!-- Main layout -->
    <div class="row g-4">
      <!-- LEFT col -->
      <div class="col-xl-8 col-lg-7">

        <!-- Analytics Overview Chart -->
        <div class="dash-card mb-4 bg-white" data-aos="fade-up" data-aos-delay="200">
