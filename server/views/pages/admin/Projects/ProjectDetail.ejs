    /* ══ DAILY PROGRESS TABLE ══ */
    .dp-table { width:100%; border-collapse:collapse; font-size:0.78rem; }
    .dp-table th { font-size:0.62rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#94a3b8; padding:0.35rem 0.5rem; border-bottom:1px solid #e2e8f0; text-align:left; }
    .dp-table td { padding:0.3rem 0.5rem; border-bottom:1px solid #f1f5f9; color:#334155; }
    .dp-table tr:last-child td { border-bottom:none; }

    /* ══ TIMELINE ══ */
    .tl-milestones { display:flex; align-items:flex-start; gap:0; padding:0.5rem 0; }
    .tl-milestone { display:flex; flex-direction:column; align-items:center; gap:0.2rem; flex:1; text-align:center; }
    .tl-m-dot { width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.72rem; background:#e2e8f0; color:#94a3b8; flex-shrink:0; }
    .tl-milestone.done .tl-m-dot { background:#16a34a; color:#fff; }
