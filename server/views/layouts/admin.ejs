  <!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Admin CSS -->
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/sidebaradmin.css" />
    <!-- AOS Animation (CDN) -->
    <link
      href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css"
      rel="stylesheet"
    />
    <style>
      /* ═══ GLOBAL HERO (au-hero) ═══ */
      .au-hero { background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 40%, #2563eb 100%); border-radius: 20px; padding: 0; margin-bottom: 24px; color: #fff; position: relative; overflow: hidden; }
      .au-hero::before { content:''; position:absolute; top:-60%; right:-20%; width:500px; height:500px; background:radial-gradient(circle,rgba(59,130,246,0.15) 0%,transparent 70%); pointer-events:none; }
      .au-hero::after { content:''; position:absolute; bottom:-40%; left:-10%; width:400px; height:400px; background:radial-gradient(circle,rgba(16,185,129,0.1) 0%,transparent 70%); pointer-events:none; }
      .au-hero-inner { display: flex; align-items: center; justify-content: space-between; padding: 28px 36px; position: relative; z-index: 1; flex-wrap: wrap; gap: 20px; }
      .au-hero-left { display: flex; align-items: center; gap: 16px; }
      .au-hero-icon { width: 56px; height: 56px; border-radius: 16px; background: rgba(255,255,255,0.12); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0; }
      .au-hero h1 { font-size: 1.4rem; font-weight: 800; margin: 0; letter-spacing: -0.02em; font-family: "Outfit","Inter",sans-serif; }
      .au-hero p { color: rgba(255,255,255,0.65); margin: 4px 0 0; font-size: 0.85rem; font-weight: 400; }
      .au-hero-stats { display: flex; gap: 24px; }
      .au-hero-stat { text-align: center; }
      .au-hero-stat-val { font-size: 1.5rem; font-weight: 800; line-height: 1; }
      .au-hero-stat-lbl { font-size: 0.68rem; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px; font-weight: 500; }
      .au-hero-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
      @media(max-width:767px){
        .au-hero-inner { padding: 22px 20px; flex-direction: column; align-items: flex-start; }
        .au-hero-icon { width: 44px; height: 44px; font-size: 1.2rem; }
        .au-hero h1 { font-size: 1.15rem; }
        .au-hero-stats { gap: 18px; }
        .au-hero-stat-val { font-size: 1.2rem; }
        .au-hero-actions { width: 100%; }
        .au-hero-actions .btn { flex: 1; justify-content: center; }
      }

      /* ═══ GLOBAL MODAL HEADERS ═══ */
      .modal .modal-header {
        background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 50%, #2563eb 100%) !important;
        color: #fff !important;
        border-bottom: none !important;
      }
      .modal .modal-header .modal-title,
      .modal .modal-header h1,
      .modal .modal-header h2,
      .modal .modal-header h3,
      .modal .modal-header h4,
      .modal .modal-header h5,
      .modal .modal-header h6 { color: #fff !important; font-family: "Outfit", "Inter", sans-serif; font-weight: 700; }
      .modal .modal-header .btn-close { filter: invert(1) grayscale(100%) brightness(200%); }
      .modal .ent-modal-header:not(.ent-modal-header-danger):not(.ent-modal-header-success):not(.ent-modal-header-warning) {
        background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 50%, #2563eb 100%) !important;
      }
      .modal .ent-modal-header .modal-title,
      .modal .ent-modal-header h1,
      .modal .ent-modal-header h2,
      .modal .ent-modal-header h3,
      .modal .ent-modal-header h4,
      .modal .ent-modal-header h5,
      .modal .ent-modal-header h6 { color: #fff !important; font-family: "Outfit", "Inter", sans-serif; font-weight: 700; }
      .modal .ent-modal-header .btn-close { filter: invert(1) grayscale(100%) brightness(200%); }
      .modal .ent-modal-icon { background: rgba(255,255,255,0.15) !important; }
      .modal .ent-modal-icon i { color: #fff !important; }
      .modal .ent-modal-body { font-family: "Inter", sans-serif; font-size: 0.9rem; color: #334155; }
      .modal .ent-modal-body .ent-detail-label,
      .modal .ent-modal-body .ent-detail-card-content .ent-detail-label { font-family: "Outfit", sans-serif; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; color: #94a3b8; }
      .modal .ent-modal-body .ent-detail-value,
      .modal .ent-modal-body .ent-detail-card-content .ent-detail-value { font-family: "Inter", sans-serif; font-size: 0.95rem; font-weight: 600; color: #1e293b; }
      .modal .ent-modal-footer .btn,
      .modal .modal-footer .btn { font-family: "Inter", sans-serif; font-weight: 600; border-radius: 8px; }
    </style>
    <!-- Leaflet CSS/JS for technician maps (use jsdelivr, which is already permitted by CSP) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/leaflet/dist/leaflet.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/leaflet/dist/leaflet.js"></script>
  </head>
  <body class="admin-layout">
    <div class="d-flex admin-root">
      <div class="admin-topbar"><%- include('../partials/admin-navbar') %></div>

      <aside class="admin-sidebar" id="adminSidebar">
        <%- include('../partials/admin-sidebar') %>
      </aside>

      <button
        id="sidebarHandle"
        class="sidebar-handle"
        aria-controls="adminSidebar"
        aria-expanded="true"
        aria-label="Toggle sidebar"
        tabindex="0"
      >
        <i class="bi bi-chevron-left" aria-hidden="true"></i>
      </button>

      <div class="admin-content flex-grow-1">
        <main class="p-4"><%- body %></main>
      </div>
    </div>

    <!-- Toast container + global confirm/prompt modals (used by window.notify) -->
    <div
      id="globalToastContainer"
      aria-live="polite"
      aria-atomic="true"
      style="position: fixed; top: 1rem; right: 1rem; z-index: 10800"
    ></div>

    <!-- Confirm modal -->
    <div
      class="modal fade"
      id="globalConfirmModal"
      tabindex="-1"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Confirm</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body"></div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-sm btn-outline-secondary js-confirm-no"
              data-bs-dismiss="modal"
            >
              Cancel</button
            ><button
              type="button"
              class="btn btn-sm btn-primary js-confirm-yes"
            >
              Confirm
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Prompt modal -->
    <div
      class="modal fade"
      id="globalPromptModal"
      tabindex="-1"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Input</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <label class="form-label"></label
            ><input class="form-control js-prompt-input" />
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-sm btn-outline-secondary js-prompt-cancel"
              data-bs-dismiss="modal"
            >
              Cancel</button
            ><button type="button" class="btn btn-sm btn-primary js-prompt-ok">
              OK
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- AOS Animation (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
      // initialize AOS for admin pages too
      document.addEventListener("DOMContentLoaded", function () {
        if (window.AOS && typeof AOS.init === "function") {
          AOS.init({
            duration: 800,
            easing: "ease-in-out",
            once: true,
          });
        }
      });
    </script>

    <!-- GSAP for sidebar animations -->
    <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
    <script src="/js/admin.js"></script>
    <script src="/js/psgc-handler.js"></script>

    <!-- Fetch booking policy (minimum advance notice) for calendar components -->
    <script>
      (function() {
        window.__bookingPolicy = { minAdvanceNoticeMinutes: 120 };
        fetch('/api/schedule/booking-policy', { cache: 'no-store' })
          .then(function(r) { return r.ok ? r.json() : null; })
          .then(function(data) {
            if (data && data.minAdvanceNoticeMinutes) {
              window.__bookingPolicy.minAdvanceNoticeMinutes = data.minAdvanceNoticeMinutes;
            }
          })
          .catch(function() {});
      })();
    </script>
  </body>
</html>
