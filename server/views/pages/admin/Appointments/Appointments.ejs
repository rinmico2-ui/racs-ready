            tr.innerHTML = `
              <td><code class="workflow-record-ref">${rq.bookingReference || rq.id}</code></td>
              <td class="text-start td-truncate-md" title="${rq.customerName}\n${rq.customerEmail || ''}">
                <button type="button" class="request-customer-btn view-req-details fw-semibold text-dark text-truncate" style="border:none;background:none;padding:0;" data-id="${rq.id}">${rq.customerName}</button>
