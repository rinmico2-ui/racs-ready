<div class="order-report container-fluid px-0 py-4">
  <%- include('../../../partials/dashboard-styles') %>
  <link rel="stylesheet" href="/css/analytics.css">
  <style>
    .or-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.or-card{background:#fff;border:1px solid #e8edf5;border-radius:16px;box-shadow:0 3px 16px rgba(15,23,42,.045)}
    .or-kpi{padding:18px;position:relative;overflow:hidden}.or-kpi:before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:var(--accent,#2563eb)}.or-kpi-top{display:flex;align-items:center;justify-content:space-between}.or-icon{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:color-mix(in srgb,var(--accent) 12%,white);color:var(--accent)}
    .or-label{font-size:.7rem;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-top:14px}.or-value{font:700 1.45rem/1.2 Outfit,Inter,sans-serif;color:#0f172a;margin-top:3px}.or-meta{font-size:.69rem;color:#94a3b8;margin-top:5px}.or-delta{font-size:.68rem;font-weight:700;padding:3px 8px;border-radius:999px}.or-up{color:#047857;background:#ecfdf5}.or-down{color:#b91c1c;background:#fef2f2}
    .or-section{margin:28px 0 12px;display:flex;align-items:center;justify-content:space-between}.or-section h2{font:700 .92rem Outfit,Inter,sans-serif;color:#334155;text-transform:uppercase;letter-spacing:.06em;margin:0;border-left:4px solid #2563eb;padding-left:10px}.or-chart{height:275px;padding:18px}.or-card-head{padding:15px 18px;border-bottom:1px solid #eef2f7;display:flex;justify-content:space-between;align-items:center}.or-card-head h3{font-size:.84rem;font-weight:700;color:#1e293b;margin:0}.or-card-body{padding:16px 18px}.or-two{display:grid;grid-template-columns:2fr 1fr;gap:16px}.or-three{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .or-table{width:100%;border-collapse:collapse;font-size:.78rem}.or-table th{font-size:.64rem;text-transform:uppercase;letter-spacing:.05em;color:#94a3b8;padding:9px 8px;border-bottom:1px solid #e2e8f0}.or-table td{padding:11px 8px;border-bottom:1px solid #f1f5f9;color:#475569;vertical-align:middle}.or-table tr:last-child td{border:0}.or-rank{width:25px;height:25px;border-radius:8px;background:#eff6ff;color:#2563eb;display:grid;place-items:center;font-weight:700}.or-badge{font-size:.63rem;font-weight:700;padding:4px 8px;border-radius:999px;background:#f1f5f9;color:#475569;white-space:nowrap}.or-badge.completed,.or-badge.paid,.or-badge.verified,.or-badge.remitted{background:#ecfdf5;color:#047857}.or-badge.cancelled,.or-badge.failed,.or-badge.rejected{background:#fef2f2;color:#b91c1c}.or-badge.pending_payment,.or-badge.pending,.or-badge.partial{background:#fffbeb;color:#b45309}
    .or-insights{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.or-insight{padding:16px;display:flex;gap:12px}.or-insight-icon{width:38px;height:38px;flex:none;border-radius:11px;display:grid;place-items:center;background:#eff6ff;color:#2563eb}.or-insight.warning .or-insight-icon{background:#fffbeb;color:#d97706}.or-insight.danger .or-insight-icon{background:#fef2f2;color:#dc2626}.or-insight.success .or-insight-icon{background:#ecfdf5;color:#059669}.or-insight h4{font-size:.79rem;font-weight:700;color:#1e293b;margin:1px 0 4px}.or-insight p{font-size:.71rem;color:#64748b;line-height:1.45;margin:0}.or-empty{text-align:center;color:#94a3b8;padding:28px 12px}.or-filter{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.or-filter select,.or-filter input{border:1px solid #dbe3ee;border-radius:9px;padding:8px 10px;font-size:.78rem;background:#fff;color:#334155}.or-export{border:0;border-radius:9px;padding:9px 13px;background:#2563eb;color:#fff;font-size:.76rem;font-weight:700}
    @media(max-width:1199px){.or-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:900px){.or-two,.or-three{grid-template-columns:1fr}.or-insights{grid-template-columns:1fr 1fr}}@media(max-width:600px){.or-grid{grid-template-columns:repeat(2,1fr)}.or-insights{grid-template-columns:1fr}.or-value{font-size:1.2rem}.or-filter{width:100%}.or-filter select{flex:1}}
  </style>

  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left"><div class="au-hero-icon"><i class="bi bi-bag-check-fill"></i></div><div><h1>Order Analytics</h1><p>Commercial demand, revenue quality, and fulfillment performance</p></div></div>
      <div class="au-hero-actions"><a class="btn btn-light btn-sm" href="/admin/appointments/orders"><i class="bi bi-receipt me-1"></i> Manage Orders</a><a class="btn btn-outline-light btn-sm" href="/products" target="_blank"><i class="bi bi-box-arrow-up-right me-1"></i> View Store</a></div>
    </div>
  </div>

  <form class="or-card p-3 mb-4 or-filter" method="get" id="orderReportFilter">
    <span class="small fw-bold text-secondary me-1"><i class="bi bi-calendar3 me-1"></i>Reporting window</span>
    <select name="range" id="orderRange"><option value="7" <%= filters.range==='7'?'selected':'' %>>Last 7 days</option><option value="30" <%= filters.range==='30'?'selected':'' %>>Last 30 days</option><option value="90" <%= filters.range==='90'?'selected':'' %>>Last 90 days</option><option value="365" <%= filters.range==='365'?'selected':'' %>>Last 12 months</option><option value="custom" <%= filters.range==='custom'?'selected':'' %>>Custom range</option></select>
    <span class="or-custom" style="<%= filters.range==='custom'?'':'display:none' %>"><input type="date" name="from" value="<%= filters.from %>"> <span class="text-muted small">to</span> <input type="date" name="to" value="<%= filters.to %>"></span>
    <button class="or-export" type="submit"><i class="bi bi-arrow-repeat me-1"></i> Apply</button><button class="or-export ms-auto" type="button" id="exportOrders"><i class="bi bi-download me-1"></i> Export CSV</button>
  </form>

  <div class="or-grid">
    <% [{l:'Orders',v:analytics.totalOrders.toLocaleString(),m:'Placed in selected period',i:'bi-bag',a:'#2563eb',d:analytics.orderGrowth},{l:'Gross order value',v:'₱'+Math.round(analytics.grossRevenue).toLocaleString(),m:'Excludes cancelled orders',i:'bi-cash-stack',a:'#059669',d:analytics.revenueGrowth},{l:'Average order value',v:'₱'+Math.round(analytics.avgOrderValue).toLocaleString(),m:'Revenue per valid order',i:'bi-receipt-cutoff',a:'#7c3aed'},{l:'Units sold',v:analytics.unitsSold.toLocaleString(),m:(analytics.unitsPerOrder||0).toFixed(1)+' units per order',i:'bi-box-seam',a:'#0891b2'},{l:'Completion rate',v:analytics.completionRate.toFixed(1)+'%',m:analytics.completedOrders+' completed',i:'bi-check2-circle',a:'#10b981'},{l:'Cancellation rate',v:analytics.cancellationRate.toFixed(1)+'%',m:analytics.cancelledOrders+' cancelled',i:'bi-x-circle',a:'#ef4444'}].forEach(function(k){ %>
      <article class="or-card or-kpi" style="--accent:<%= k.a %>"><div class="or-kpi-top"><span class="or-icon"><i class="bi <%= k.i %>"></i></span><% if(typeof k.d==='number'){ %><span class="or-delta <%= k.d>=0?'or-up':'or-down' %>"><i class="bi <%= k.d>=0?'bi-arrow-up':'bi-arrow-down' %>"></i> <%= Math.abs(k.d).toFixed(1) %>%</span><% } %></div><div class="or-label"><%= k.l %></div><div class="or-value"><%= k.v %></div><div class="or-meta"><%= k.m %></div></article>
    <% }); %>
  </div>

  <div class="or-section"><h2>Executive outlook</h2><span class="small text-muted">Compared with the immediately preceding period</span></div>
  <div class="or-insights"><% analytics.insights.forEach(function(x){ %><article class="or-card or-insight <%= x.tone %>"><div class="or-insight-icon"><i class="bi <%= x.icon %>"></i></div><div><h4><%= x.title %></h4><p><%= x.text %></p></div></article><% }); %></div>

  <div class="or-section"><h2>Demand & revenue</h2></div>
  <div class="or-two"><article class="or-card"><div class="or-card-head"><h3><i class="bi bi-graph-up me-2 text-primary"></i>Order and Revenue Trend</h3><span class="or-badge">Selected period</span></div><div class="or-chart"><canvas id="orderTrend"></canvas></div></article><article class="or-card"><div class="or-card-head"><h3><i class="bi bi-signpost-split me-2 text-primary"></i>Fulfillment Mix</h3></div><div class="or-chart"><canvas id="fulfillmentChart"></canvas></div></article></div>

  <div class="or-section"><h2>Operational health</h2></div>
  <div class="or-three"><article class="or-card"><div class="or-card-head"><h3>Order Pipeline</h3></div><div class="or-chart"><canvas id="statusChart"></canvas></div></article><article class="or-card"><div class="or-card-head"><h3>Payment Health</h3></div><div class="or-chart"><canvas id="paymentChart"></canvas></div></article><article class="or-card"><div class="or-card-head"><h3>Fulfillment Efficiency</h3></div><div class="or-card-body"><div class="or-label">Average completed cycle</div><div class="or-value"><%= analytics.avgCycleHours < 48 ? analytics.avgCycleHours.toFixed(1)+' hours' : (analytics.avgCycleHours/24).toFixed(1)+' days' %></div><div class="or-meta mb-4">Order creation to completion</div><div class="or-label">Outstanding payment exposure</div><div class="or-value" style="color:#d97706">₱<%= Math.round(analytics.pendingPaymentValue).toLocaleString() %></div><div class="or-meta">Value not in a final payment state</div></div></article></div>

  <div class="or-section"><h2>Product intelligence</h2></div>
  <div class="or-two"><article class="or-card"><div class="or-card-head"><h3>Top Products by Revenue</h3></div><div class="or-card-body table-responsive"><table class="or-table"><thead><tr><th>#</th><th>Product</th><th class="text-center">Units</th><th class="text-end">Revenue</th></tr></thead><tbody><% if(!analytics.topProducts.length){ %><tr><td colspan="4" class="or-empty">No product sales in this period.</td></tr><% } analytics.topProducts.forEach(function(p,i){ %><tr><td><span class="or-rank"><%= i+1 %></span></td><td><strong><%= p.name %></strong><div class="or-meta"><%= p.orders %> order lines</div></td><td class="text-center"><%= p.units %></td><td class="text-end fw-bold">₱<%= Math.round(p.revenue).toLocaleString() %></td></tr><% }); %></tbody></table></div></article><article class="or-card"><div class="or-card-head"><h3>Brand Contribution</h3></div><div class="or-chart"><canvas id="brandChart"></canvas></div></article></div>

  <div class="or-section"><h2>Fulfillment team</h2></div>
  <article class="or-card"><div class="or-card-body table-responsive"><table class="or-table"><thead><tr><th>Technician</th><th class="text-center">Assigned</th><th class="text-center">Completed</th><th class="text-center">Completion</th><th class="text-end">Order Value</th></tr></thead><tbody><% if(!analytics.technicians.length){ %><tr><td colspan="5" class="or-empty">No technician-assigned orders in this period.</td></tr><% } analytics.technicians.forEach(function(t){ %><tr><td class="fw-bold"><%= t.name %></td><td class="text-center"><%= t.orders %></td><td class="text-center"><%= t.completed %></td><td class="text-center"><span class="or-badge <%= t.completionRate>=80?'completed':'' %>"><%= t.completionRate.toFixed(0) %>%</span></td><td class="text-end">₱<%= Math.round(t.value).toLocaleString() %></td></tr><% }); %></tbody></table></div></article>

  <div class="or-section"><h2>Recent order detail</h2><span class="small text-muted">Latest 12 in selected period</span></div>
  <article class="or-card"><div class="or-card-body table-responsive"><table class="or-table" id="ordersTable"><thead><tr><th>Date</th><th>Reference</th><th>Customer</th><th class="text-center">Units</th><th>Fulfillment</th><th>Payment</th><th>Status</th><th class="text-end">Total</th></tr></thead><tbody><% if(!analytics.recentOrders.length){ %><tr><td colspan="8" class="or-empty">No orders match this reporting window.</td></tr><% } analytics.recentOrders.forEach(function(o){ %><tr><td><%= new Date(o.date).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) %></td><td class="fw-bold"><%= o.reference %></td><td><%= o.customer %></td><td class="text-center"><%= o.items %></td><td><%= String(o.fulfillment||'—').replaceAll('_',' ') %></td><td><span class="or-badge <%= o.payment %>"><%= String(o.payment||'pending').replaceAll('_',' ') %></span></td><td><span class="or-badge <%= o.status %>"><%= String(o.status||'unknown').replaceAll('_',' ') %></span></td><td class="text-end fw-bold">₱<%= Math.round(o.total).toLocaleString() %></td></tr><% }); %></tbody></table></div></article>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(() => {
  const A = <%- analyticsJson %>;
  const nice = s => String(s).replaceAll('_',' ').replace(/\b\w/g,c=>c.toUpperCase());
  const palette=['#2563eb','#10b981','#8b5cf6','#f59e0b','#06b6d4','#ef4444','#64748b','#f97316','#14b8a6','#ec4899'];
  Chart.defaults.font.family='Inter, sans-serif'; Chart.defaults.color='#64748b';
  const baseOpts={responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{usePointStyle:true,boxWidth:7,font:{size:10}}}},scales:{x:{grid:{display:false},ticks:{font:{size:10}}},y:{beginAtZero:true,grid:{color:'#f1f5f9'},ticks:{font:{size:10}}}}};
  new Chart(document.getElementById('orderTrend'),{type:'bar',data:{labels:A.dailyTrend.map(x=>x.label),datasets:[{label:'Orders',data:A.dailyTrend.map(x=>x.orders),backgroundColor:'rgba(37,99,235,.72)',borderRadius:5,yAxisID:'y'},{label:'Revenue (₱)',data:A.dailyTrend.map(x=>x.revenue),type:'line',borderColor:'#10b981',backgroundColor:'#10b981',tension:.35,pointRadius:2,yAxisID:'r'}]},options:{...baseOpts,scales:{...baseOpts.scales,r:{position:'right',beginAtZero:true,grid:{display:false},ticks:{font:{size:10},callback:v=>'₱'+Number(v).toLocaleString()}}}}});
  function doughnut(id,obj){const labels=Object.keys(obj);new Chart(document.getElementById(id),{type:'doughnut',data:{labels:labels.map(nice),datasets:[{data:labels.map(k=>obj[k]),backgroundColor:palette,borderWidth:3,borderColor:'#fff'}]},options:{responsive:true,maintainAspectRatio:false,cutout:'67%',plugins:{legend:{position:'bottom',labels:{usePointStyle:true,boxWidth:7,font:{size:10}}}}}})}
  doughnut('fulfillmentChart',A.fulfillmentBreakdown); doughnut('statusChart',A.statusBreakdown); doughnut('paymentChart',A.paymentBreakdown);
  new Chart(document.getElementById('brandChart'),{type:'bar',data:{labels:A.topBrands.map(x=>x.name),datasets:[{label:'Revenue',data:A.topBrands.map(x=>x.revenue),backgroundColor:palette,borderRadius:6}]},options:{...baseOpts,indexAxis:'y',plugins:{legend:{display:false}},scales:{x:{beginAtZero:true,grid:{color:'#f1f5f9'},ticks:{callback:v=>'₱'+Number(v).toLocaleString(),font:{size:10}}},y:{grid:{display:false}}}}});
  const range=document.getElementById('orderRange');range.addEventListener('change',()=>document.querySelector('.or-custom').style.display=range.value==='custom'?'':'none');
  document.getElementById('exportOrders').addEventListener('click',()=>{const q=v=>'"'+String(v??'').replaceAll('"','""')+'"';const rows=[['Date','Reference','Customer','Units','Fulfillment','Payment','Status','Total'],...A.recentOrders.map(o=>[new Date(o.date).toLocaleDateString(),o.reference,o.customer,o.items,nice(o.fulfillment),nice(o.payment),nice(o.status),o.total])];const blob=new Blob([rows.map(r=>r.map(q).join(',')).join('\n')],{type:'text/csv;charset=utf-8'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='order-analytics.csv';a.click();URL.revokeObjectURL(a.href)});
})();
</script>
