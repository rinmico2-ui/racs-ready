<%
  const sidebarCurrentPath = typeof currentPath === 'string' ? currentPath : '';
  const sidebarPathMatches = function(prefix) {
    return sidebarCurrentPath === prefix || sidebarCurrentPath.startsWith(prefix + '/');
  };
  const bookingsGroupOpen = sidebarPathMatches('/secretary/appointments')
    || sidebarPathMatches('/secretary/calendar')
    || sidebarPathMatches('/secretary/projects')
    || sidebarPathMatches('/secretary/operations/resolution-center')
    || sidebarPathMatches('/secretary/inventory/ordered-products');
  const servicesGroupOpen = sidebarPathMatches('/secretary/services');
  const inventoryGroupOpen = sidebarPathMatches('/secretary/pointofsale')
    || sidebarPathMatches('/secretary/inventory/repair-parts')
    || sidebarCurrentPath === '/secretary/inventory'
    || sidebarPathMatches('/secretary/inventory/history');
%>
<div class="sidebar" id="sidebar">
  <style>
    .sidebar::-webkit-scrollbar { display: none; }
    .sidebar { -ms-overflow-style: none; scrollbar-width: none; }
    .admin-sidebar .sidebar { height: 100%; display: flex; flex-direction: column; overflow-y: auto; }
    .admin-sidebar { top: 0 !important; height: 100vh !important; z-index: 1000 !important; }

    .sidebar-brand {
      display: flex; align-items: center; gap: 12px;
      padding: 16px 18px 14px; margin: 0 6px 4px;
      border-bottom: 1px solid rgba(37, 99, 235, 0.08);
    }
    .sidebar-brand .brand-icon {
      width: 38px; height: 38px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      color: #fff; font-size: 1.15rem; flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }
    .sidebar-brand .brand-text { display: flex; flex-direction: column; gap: 1px; }
    .sidebar-brand .brand-name { font-size: 0.92rem; font-weight: 700; color: #0f172a; letter-spacing: 0.01em; line-height: 1.2; }
    .sidebar-brand .brand-sub { font-size: 0.62rem; font-weight: 600; color: #64748b; letter-spacing: 0.12em; text-transform: uppercase; }

    .nav-section { display: flex; align-items: center; gap: 8px; padding: 16px 22px 6px; margin: 0; }
    .nav-section .section-label {
      font-size: 0.6rem; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: #94a3b8; white-space: nowrap;
    }
    .nav-section .section-line { flex: 1; height: 1px; background: rgba(37, 99, 235, 0.08); }
    .nav-subsection {
      padding: 8px 0 4px; margin: 8px 0 0 12px;
      border-top: 1px solid rgba(37, 99, 235, 0.08);
      color: #94a3b8; font-size: 0.65rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.08em;
    }
    .nav-subsection:first-child { margin-top: 0; border-top: 0; }

    .btn-toggle-nav a.active, .sidebar-nav > .nav-item > a.active {
      background-color: rgba(29, 78, 216, 0.1);
      color: #1d4ed8; font-weight: 600; border-left: 3px solid #1d4ed8;
    }
    .btn-toggle.active { background-color: rgba(29, 78, 216, 0.1); color: #1d4ed8; font-weight: 600; }
    .btn-toggle-nav a { position: relative; z-index: 2; }

    .sidebar-footer {
      margin-top: auto; padding: 12px 10px 6px;
      border-top: 1px solid rgba(37, 99, 235, 0.08);
      display: flex; align-items: center; gap: 10px; flex-shrink: 0;
    }
    .sidebar-footer .footer-avatar {
      width: 34px; height: 34px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, #e0edff, #c3daff);
      color: #1d4ed8; font-size: 0.85rem; flex-shrink: 0;
    }
    .sidebar-footer .footer-meta { display: flex; flex-direction: column; gap: 1px; overflow: hidden; }
    .sidebar-footer .footer-name { font-size: 0.75rem; font-weight: 600; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sidebar-footer .footer-role { font-size: 0.6rem; color: #64748b; font-weight: 500; }
  </style>

  <div class="sidebar-brand">
    <div class="brand-icon"><i class="bi bi-lightning-charge-fill"></i></div>
    <div class="brand-text">
      <span class="brand-name">RACS</span>
      <span class="brand-sub">Secretary Console</span>
    </div>
  </div>

  <ul class="sidebar-nav nav-list">
    <div class="nav-section"><span class="section-label">Core</span><span class="section-line"></span></div>
    <li class="nav-item">
      <a href="/secretary" class="nav-link" data-permission="dashboard.view">
        <i class="bi bi-grid-1x2-fill nav-icon"></i><span class="nav-label">Dashboard</span>
      </a>
    </li>

    <div class="nav-section"><span class="section-label">Operations</span><span class="section-line"></span></div>
    <li class="nav-item">
      <button class="btn btn-toggle nav-link<%= bookingsGroupOpen ? ' active' : ' collapsed' %>" data-bs-toggle="collapse" data-bs-target="#appointment-mgmt-collapse" aria-expanded="<%= bookingsGroupOpen ? 'true' : 'false' %>">
        <i class="bi bi-calendar2-check nav-icon"></i><span class="nav-label">Work</span><span class="nav-badge badge bg-warning text-dark" id="pendingReviewCount" style="display:none;">0</span><i class="bi bi-chevron-down ms-auto"></i>
      </button>
      <div class="collapse<%= bookingsGroupOpen ? ' show' : '' %>" id="appointment-mgmt-collapse">
        <ul class="btn-toggle-nav list-unstyled">
          <li class="nav-subsection">Core</li>
          <li><a href="/secretary/appointments" class="nav-link" data-permission="appointments.view"><i class="bi bi-grid-3x3-gap nav-icon"></i><span class="nav-label">Bookings</span><span class="nav-badge badge bg-primary ms-auto" id="appointmentsBadge" style="display:none;">0</span></a></li>
          <li><a href="/secretary/inventory/ordered-products" class="nav-link" data-permission="orders.view"><i class="bi bi-receipt nav-icon"></i><span class="nav-label">Orders</span><span class="nav-badge badge bg-info ms-auto" id="ordersBadge" style="display:none;" title="Orders requiring action">0</span></a></li>
          <li class="nav-subsection">Planning</li>
          <li><a href="/secretary/calendar" class="nav-link" data-permission="appointments.view"><i class="bi bi-calendar3 nav-icon"></i><span class="nav-label">Calendar</span></a></li>
          <li><a href="/secretary/appointments/walk-in" class="nav-link" data-permission="appointments.manage"><i class="bi bi-person-plus nav-icon"></i><span class="nav-label">Walk-in</span></a></li>
          <li class="nav-subsection">Operations</li>
          <li><a href="/secretary/appointments/repair-scheduling" class="nav-link" data-permission="appointments.manage"><i class="bi bi-wrench nav-icon"></i><span class="nav-label">Repair Workflow Queue</span><span class="nav-badge badge ms-auto" id="repairSchedBadge" style="display:none;background:#7c3aed;color:#fff;">0</span></a></li>
          <li><a href="/secretary/appointments/expenses" class="nav-link" data-permission="appointments.view"><i class="bi bi-receipt nav-icon"></i><span class="nav-label">Expenses</span><span class="nav-badge badge bg-warning text-dark ms-auto" id="expensesBadge" style="display:none;">0</span></a></li>
          <li><a href="/secretary/projects" class="nav-link" data-permission="appointments.view"><i class="bi bi-building nav-icon"></i><span class="nav-label">Projects</span><span class="nav-badge badge ms-auto" id="projectsBadge" style="display:none;background:#6366f1;color:#fff;">0</span></a></li>
          <li class="nav-subsection">Monitoring</li>
          <li><a href="/secretary/operations/resolution-center" class="nav-link" data-permission="appointments.view"><i class="bi bi-exclamation-diamond nav-icon"></i><span class="nav-label">Resolution Center</span><span class="nav-badge badge bg-warning text-dark ms-auto" id="attentionBadge" style="display:none;">0</span></a></li>
          <li><a href="/secretary/appointments/cancellation-log" class="nav-link" data-permission="appointments.view"><i class="bi bi-clock-history nav-icon"></i><span class="nav-label">Cancellation Log</span><span class="nav-badge badge bg-danger ms-auto" id="escalatedBadge" style="display:none;">0</span></a></li>
        </ul>
      </div>
    </li>

    <li class="nav-item">
      <button class="btn btn-toggle nav-link<%= servicesGroupOpen ? ' active' : ' collapsed' %>" data-bs-toggle="collapse" data-bs-target="#services-collapse" aria-expanded="<%= servicesGroupOpen ? 'true' : 'false' %>">
        <i class="bi bi-tools nav-icon"></i><span class="nav-label">Services</span><i class="bi bi-chevron-down ms-auto"></i>
      </button>
      <div class="collapse<%= servicesGroupOpen ? ' show' : '' %>" id="services-collapse">
        <ul class="btn-toggle-nav list-unstyled">
          <li><a href="/secretary/services/core" class="nav-link" data-permission="services.view"><i class="bi bi-gear nav-icon"></i><span class="nav-label">Core Services</span></a></li>
          <li><a href="/secretary/services/repair" class="nav-link" data-permission="services.view"><i class="bi bi-wrench-adjustable nav-icon"></i><span class="nav-label">Repair</span></a></li>
        </ul>
      </div>
    </li>

    <li class="nav-item">
      <button class="btn btn-toggle nav-link<%= inventoryGroupOpen ? ' active' : ' collapsed' %>" data-bs-toggle="collapse" data-bs-target="#inventory-collapse" aria-expanded="<%= inventoryGroupOpen ? 'true' : 'false' %>">
        <i class="bi bi-box-seam nav-icon"></i><span class="nav-label">Inventory</span><i class="bi bi-chevron-down ms-auto"></i>
      </button>
      <div class="collapse<%= inventoryGroupOpen ? ' show' : '' %>" id="inventory-collapse">
        <ul class="btn-toggle-nav list-unstyled">
          <li><a href="/secretary/pointofsale" class="nav-link" data-permission="orders.manage" style="color:#22c55e;"><i class="bi bi-shop nav-icon"></i><span class="nav-label fw-bold">Point of Sale</span></a></li>
          <li><a href="/secretary/inventory/repair-parts" class="nav-link" data-permission="inventory.view"><i class="bi bi-box-seam nav-icon"></i><span class="nav-label">Repair Parts Procurement</span></a></li>
          <li><a href="/secretary/inventory" class="nav-link" data-permission="inventory.view"><i class="bi bi-list-ul nav-icon"></i><span class="nav-label">Inventory List</span></a></li>
          <li><a href="/secretary/inventory/history" class="nav-link" data-permission="inventory.view"><i class="bi bi-clock-history nav-icon"></i><span class="nav-label">Stock History</span></a></li>
        </ul>
      </div>
    </li>

    <div class="nav-section"><span class="section-label">People</span><span class="section-line"></span></div>
    <li class="nav-item"><a href="/secretary/customers" class="nav-link" data-permission="customers.view"><i class="bi bi-people nav-icon"></i><span class="nav-label">Customers</span></a></li>
    <li class="nav-item"><a href="/secretary/technicians" class="nav-link" data-permission="technicians.view"><i class="bi bi-person-workspace nav-icon"></i><span class="nav-label">Technician List</span></a></li>
    <li class="nav-item"><a href="/secretary/staff" class="nav-link" data-permission="staff.view"><i class="bi bi-person-badge nav-icon"></i><span class="nav-label">Staff List</span></a></li>
    <li class="nav-item"><a href="/secretary/attendance" class="nav-link" data-permission="attendance.self.manage"><i class="bi bi-person-check nav-icon"></i><span class="nav-label">My Attendance</span></a></li>

    <div class="nav-section"><span class="section-label">Finance</span><span class="section-line"></span></div>
    <li class="nav-item"><a href="/secretary/payments" class="nav-link" data-permission="payments.view"><i class="bi bi-credit-card nav-icon"></i><span class="nav-label">Payments</span></a></li>
    <li class="nav-item"><a href="/secretary/payroll" class="nav-link" data-permission="payroll.self.view"><i class="bi bi-wallet2 nav-icon"></i><span class="nav-label">My Payroll</span></a></li>

    <div class="nav-section"><span class="section-label">Analytics</span><span class="section-line"></span></div>
    <li class="nav-item"><a href="/secretary/reports/revenue" class="nav-link" data-permission="reports.view"><i class="bi bi-currency-dollar nav-icon"></i><span class="nav-label">Revenue</span></a></li>
    <li class="nav-item"><a href="/secretary/reports/service" class="nav-link" data-permission="reports.view"><i class="bi bi-wrench-adjustable nav-icon"></i><span class="nav-label">Services</span></a></li>
    <li class="nav-item"><a href="/secretary/reports/inventory" class="nav-link" data-permission="reports.view"><i class="bi bi-clipboard-data nav-icon"></i><span class="nav-label">Inventory</span></a></li>

    <div class="nav-section"><span class="section-label">Account</span><span class="section-line"></span></div>
    <li class="nav-item"><a href="/secretary/profile" class="nav-link"><i class="bi bi-person-circle nav-icon"></i><span class="nav-label">My Profile</span></a></li>
  </ul>

  <div class="sidebar-footer">
    <div class="footer-avatar"><i class="bi bi-person-fill"></i></div>
    <div class="footer-meta">
      <span class="footer-name"><%= typeof user !== 'undefined' && user && (user.name || user.fullName || user.firstName || user.email) ? (user.name || user.fullName || user.firstName || user.email) : 'Secretary' %></span>
      <span class="footer-role">Operations Staff</span>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const allowedPermissions = new Set(<%- JSON.stringify(typeof effectivePermissions !== 'undefined' ? effectivePermissions : []).replace(/</g, '\\u003c') %>);
      const sidebar = document.getElementById('sidebar');
      if (!sidebar) return;

      sidebar.querySelectorAll('[data-permission]').forEach(function(link) {
        if (!allowedPermissions.has(link.dataset.permission)) {
          const item = link.closest('li');
          if (item) item.remove();
        }
      });

      sidebar.querySelectorAll('.collapse').forEach(function(panel) {
        if (!panel.querySelector('a.nav-link')) {
          const group = panel.closest('li.nav-item');
          if (group) group.remove();
        }
      });

      sidebar.querySelectorAll('.nav-subsection').forEach(function(heading) {
        let sibling = heading.nextElementSibling;
        let hasLink = false;
        while (sibling && !sibling.classList.contains('nav-subsection')) {
          if (sibling.querySelector && sibling.querySelector('a.nav-link')) hasLink = true;
          sibling = sibling.nextElementSibling;
        }
        if (!hasLink) heading.remove();
      });

      const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
      const links = Array.from(sidebar.querySelectorAll('a.nav-link[href]'));
      const matches = links.filter(function(link) {
        const href = link.getAttribute('href').replace(/\/$/, '') || '/';
        return currentPath === href || (href !== '/secretary' && currentPath.startsWith(href + '/'));
      }).sort(function(a, b) {
        return b.getAttribute('href').length - a.getAttribute('href').length;
      });

      if (matches[0]) {
        matches[0].classList.add('active');
        const panel = matches[0].closest('.collapse');
        if (panel) {
          panel.classList.add('show');
          const toggle = sidebar.querySelector('[data-bs-target="#' + panel.id + '"]');
          if (toggle) {
            toggle.classList.remove('collapsed');
            toggle.classList.add('active');
            toggle.setAttribute('aria-expanded', 'true');
          }
        }
      }
    });

    document.addEventListener('DOMContentLoaded', function() {
      function setSecretaryBadge(id, value) {
        const element = document.getElementById(id);
        if (!element) return;
        const count = Math.max(0, Number(value) || 0);
        element.textContent = count > 99 ? '99+' : (count > 0 ? String(count) : '');
        element.style.display = count > 0 ? 'inline-block' : 'none';
      }

      async function updateSecretarySidebarBadges() {
        try {
          const response = await fetch('/api/notifications/counts', { credentials: 'same-origin' });
          if (response.ok) {
            const data = await response.json();
            setSecretaryBadge('pendingReviewCount', data.pendingBookings);
            setSecretaryBadge('appointmentsBadge', (data.pendingBookings || 0) + (data.assignmentQueue || 0) + (data.activeJobs || 0));
            setSecretaryBadge('expensesBadge', data.pendingExpenses);
            setSecretaryBadge('attentionBadge', data.attentionRequired || data.noShowReviewBookings);
            setSecretaryBadge('escalatedBadge', data.escalatedBookings);
          }
        } catch (error) {}

        await Promise.allSettled([
          fetch('/api/orders/badge', { credentials: 'same-origin' })
            .then(response => response.ok ? response.json() : null)
            .then(data => data && setSecretaryBadge('ordersBadge', data.actionable)),
          fetch('/api/projects/dashboard', { credentials: 'same-origin' })
            .then(response => response.ok ? response.json() : null)
            .then(data => data && setSecretaryBadge('projectsBadge', data.stats && data.stats.pendingScheduling)),
          fetch('/api/secretary/operations/repair-scheduling-queue/stats', { credentials: 'same-origin' })
            .then(response => response.ok ? response.json() : null)
            .then(data => data && setSecretaryBadge('repairSchedBadge', data.pendingScheduling)),
        ]);
      }

      updateSecretarySidebarBadges();
      window.setInterval(updateSecretarySidebarBadges, 30000);
      window.addEventListener('focus', updateSecretarySidebarBadges);
      window.addEventListener('notification:new', updateSecretarySidebarBadges);
    });
  </script>
</div>
