}

function waitForCharts() {
  if (typeof Chart === 'undefined') { setTimeout(waitForCharts, 100); return; }
  requestAnimationFrame(function() { setTimeout(initCharts, 50); });
}
if (document.readyState === 'loading') { window.addEventListener('DOMContentLoaded', waitForCharts); } else { waitForCharts(); }
