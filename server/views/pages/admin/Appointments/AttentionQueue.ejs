        } catch (error) {
          Swal.showValidationMessage(error.message || 'Could not save the pickup date. Try again.');
          return false;
        }
      },
    });
    if (result.isConfirmed) {
      showToast('success', 'Pickup date updated. The overdue case is now resolved.');
      await loadQueue();
    }
