  // ── Dashboard action handlers ──
  window.openScheduleModal = function() {
    const p = window.__projectData;
    if (!p) return;
    if (p.schedulePlan?.status === 'confirmed' || p.scheduleLocked || ['ready','in_progress','on_hold'].includes(p.status)) {
      openRecoveryPlan('recover');
      return;
    }
    const start = p.preferredStartDate ? new Date(p.preferredStartDate).toISOString().slice(0,10) : '';
    const end = p.preferredCompletionDeadline ? new Date(p.preferredCompletionDeadline).toISOString().slice(0,10) : '';
    const modal = document.createElement('div');
    modal.className = 'pw-modal-overlay';
    modal.innerHTML = `
      <div class="pw-modal">
        <h5 style="font-size:1rem;font-weight:700;margin-bottom:0.75rem;"><i class="bi bi-calendar3 me-2"></i>Update Project Schedule</h5>
        <div class="mb-2">
          <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Preferred Start Date</label>
          <input type="date" id="modalStartDate" class="form-control form-control-sm" value="${start}">
        </div>
        <div class="mb-3">
          <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Target Completion</label>
          <input type="date" id="modalEndDate" class="form-control form-control-sm" value="${end}">
        </div>
        <div class="d-flex gap-2 justify-content-end">
          <button class="pw-btn" onclick="this.closest('.pw-modal-overlay').remove()">Cancel</button>
          <button class="pw-btn primary" id="modalSaveSchedule">Save</button>
        </div>
      </div>`;
    document.body.appendChild(modal);
    modal.querySelector('#modalSaveSchedule').addEventListener('click', async () => {
      const s = modal.querySelector('#modalStartDate').value;
      const e = modal.querySelector('#modalEndDate').value;
      try {
        const r = await fetch(`/api/projects/${projectId}`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ preferredStartDate: s || null, preferredCompletionDeadline: e || null }),
        });
        if (r.ok) { modal.remove(); toast('Schedule updated'); loadProject(); }
        else { const err = await r.json(); toast(err.error || 'Failed', 'error'); }
      } catch (err) { toast('Failed to update schedule', 'error'); }
