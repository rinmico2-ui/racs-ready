<link rel="stylesheet" href="/css/notification-inbox.css?v=20261012-shared">
<style>
  .navbar-icon-btn {
    width: 40px; height: 40px; border-radius: 10px; border: 1px solid #e2e8f0;
    background: transparent; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    color: #64748b; display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .navbar-icon-btn:hover {
    background: #f1f5f9; border-color: #3b82f6; color: #2563eb;
    box-shadow: 0 2px 8px rgba(59,130,246,0.12);
  }
  .navbar-profile-btn {
    border-radius: 10px; padding: 0.5rem 1rem; border: 1px solid #e2e8f0;
    background: transparent; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    color: #334155; display: flex; align-items: center; gap: 0.5rem; font-family: inherit; font-size: 0.9rem;
    flex-shrink: 0;
  }
  .navbar-profile-btn:hover {
    background: #f1f5f9; border-color: #3b82f6; box-shadow: 0 2px 8px rgba(59,130,246,0.12);
  }
  .navbar-profile-btn:hover .chevron-icon {
    transform: rotate(180deg);
  }
  .dropdown-item-custom:hover {
    background: #f8fafc; color: #2563eb !important;
  }
  .dropdown-item-custom.logout-item {
    background: #fff1f0;
    color: #b42318;
    font-weight: 600;
  }
  .dropdown-item-custom.logout-item:hover,
  .dropdown-item-custom.logout-item:focus-visible {
    background: #fee4e2;
    color: #912018 !important;
  }
  .dropdown-item-custom.logout-item:focus-visible {
    outline: 2px solid #b42318;
    outline-offset: -2px;
  }
  #sidebarToggleMobile {
    display: none;
  }
  @media (max-width: 767px) {
    #sidebarToggleMobile {
      display: flex;
    }
    .navbar-brand .brand-text {
      display: none;
    }
    .navbar-profile-btn .profile-text {
      display: none;
    }
    .navbar-profile-btn .chevron-icon {
      display: none;
    }
    .navbar-icon-btn {
      width: 32px;
      height: 32px;
    }
    .navbar-icon-btn i {
      font-size: 1rem;
    }
    .navbar-profile-btn {
      padding: 0.35rem 0.5rem;
    }
    .navbar-profile-btn i {
      font-size: 1rem;
    }
    .navbar-brand-logo {
      width: 24px;
      height: 24px;
    }
    .navbar-brand-logo {
      margin-right: 0 !important;
    }
    #technicianNavbar {
      padding: 0.5rem 0.75rem;
    }
    #technicianNavbar > .container-fluid {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      display: grid !important;
      grid-template-columns: auto 1fr;
      gap: 0.5rem;
      align-items: center;
    }
    #technicianNavbar > .container-fluid > div:first-child {
      gap: 0.25rem !important;
      display: flex !important;
      flex-wrap: nowrap !important;
    }
    #technicianNavbar > .container-fluid > div:last-child {
      gap: 0.25rem !important;
      display: flex !important;
      flex-wrap: nowrap !important;
      justify-content: flex-end;
    }
    #technicianNavbar > .container-fluid > div:last-child.gap-3 {
      gap: 0.25rem !important;
    }
    .navbar-brand {
      flex-shrink: 0;
    }
  }

  @media (max-width: 480px) {
    .navbar-icon-btn {
      width: 34px;
      height: 34px;
    }
    .navbar-icon-btn i {
      font-size: 1rem;
    }
    .navbar-profile-btn {
      padding: 0.35rem 0.5rem;
    }
    .navbar-profile-btn i {
      font-size: 1rem;
    }
    .navbar-brand-logo {
      width: 26px;
      height: 26px;
    }
    #notifBadge {
      font-size: 0.5rem;
      padding: 0.15em 0.35em;
      margin-left: -8px;
      margin-top: -2px;
    }
    #notifDropdown {
      max-height: 80vh;
    }
    #notifList {
      max-height: calc(80vh - 100px);
    }
  }

  /* Override Bootstrap dropdown-menu behavior for technician notifications */
  #notifDropdown {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
  }
  #notifDropdown.show {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
</style>
<nav id="technicianNavbar" class="navbar navbar-expand-lg border-bottom px-4 py-2 bg-white" style="border-color: rgba(226, 232, 240, 0.8) !important; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03); z-index: 70; position: relative;">
  <div class="container-fluid d-flex align-items-center justify-content-between" style="padding-left: 1rem; padding-right: 1rem;">
    <!-- Brand Section -->
    <div class="d-flex align-items-center gap-2">
      <button id="sidebarToggleMobile" type="button" class="navbar-icon-btn" aria-label="Open navigation menu" aria-controls="adminSidebar" aria-expanded="false" aria-haspopup="dialog">
        <i class="bi bi-list" style="font-size: 1.3rem;"></i>
      </button>
      <a class="navbar-brand fw-bold d-flex align-items-center text-decoration-none" href="/technician" style="font-family: 'Outfit', sans-serif;">
        <img
          src="/images/LOGO/RACS.png"
          alt="CALIDRO RACS"
          class="navbar-brand-logo me-2"
          style="width: 32px; height: 32px; object-fit: contain;"
        />
        <span class="brand-text" style="color: #0f172a; font-weight: 400; letter-spacing: 0.3px; font-size: 1.1rem;">CALIDRO RACS</span>
      </a>
    </div>

    <!-- Actions Section -->
    <div class="d-flex align-items-center gap-3">
      <div class="dropdown">
        <button
          class="navbar-icon-btn"
          id="notifDropdownBtn"
          aria-label="Notifications"
          aria-controls="notifDropdown"
          aria-expanded="false"
          type="button"
        >
          <i class="bi bi-bell" style="font-size: 1.15rem;"></i>
          <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill d-none" style="font-size: 0.55rem; background: #ef4444; padding: 0.2em 0.45em; border: 1.5px solid #fff; margin-left: -10px; margin-top: -2px;">0</span>
        </button>
        <div class="dropdown-menu dropdown-menu-end p-0" id="notifDropdown" style="width: min(380px, 92vw); max-height: 70vh; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 20px 50px rgba(0,0,0,0.15); overflow: hidden; display: none; visibility: hidden; opacity: 0; position: absolute; right: 0; top: 100%; margin-top: 8px; z-index: 9999;">
          <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom flex-shrink-0" style="background: #f8fafc;">
            <span class="fw-bold" style="font-size: .85rem; color: #1e293b;">Notifications <span id="notifCount" class="visually-hidden">0</span></span>
            <div class="d-flex gap-2">
              <button id="markAllReadBtn" type="button" class="btn btn-sm text-primary" style="font-size: .75rem; padding: 2px 8px;">Mark all read</button>
              <button id="deleteAllBtn" type="button" class="btn btn-sm text-danger" style="font-size: .75rem; padding: 2px 8px;">Delete all</button>
            </div>
          </div>
          <div id="notifDropdownStatus" class="d-none px-3 py-2 small text-danger" role="status" aria-live="polite"></div>
          <div id="notifList" style="max-height: calc(70vh - 90px); overflow-y: auto; flex: 1;">
            <div class="p-4 text-center" id="notifEmpty">
              <i class="bi bi-bell-slash text-muted mb-2 d-block" style="font-size: 2rem;"></i>
              <p class="text-muted small mb-0">Loading notifications...</p>
            </div>
          </div>
          <div class="border-top text-center py-2 flex-shrink-0" id="notifFooter" style="background: #f8fafc;">
            <button id="viewAllNotifBtn" type="button" class="btn btn-sm text-primary" style="font-size: .78rem; font-weight: 600; padding: 0; background: transparent; border: none;">View All</button>
          </div>
        </div>
      </div>
      
      <div class="dropdown">
        <button
          type="button"
          id="profileDropdown"
          data-bs-toggle="dropdown"
          aria-expanded="false"
          class="navbar-profile-btn"
        >
          <i class="bi bi-person-circle" style="font-size: 1.2rem;"></i>
          <span class="profile-text">Technician</span>
          <i class="bi bi-chevron-down chevron-icon" style="font-size: 0.75rem; transition: transform 0.2s;"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end py-1" aria-labelledby="profileDropdown" style="border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.10); min-width: 180px;">
          <li>
            <a class="dropdown-item dropdown-item-custom py-2" href="/technician/profile" style="color: #475569; font-size: 0.88rem; padding: 0.5rem 1rem; border-radius: 6px; transition: all 0.15s;">
              <i class="bi bi-person me-2"></i>Profile
            </a>
          </li>
          <li><hr class="dropdown-divider" style="border-color: #f1f5f9; margin: 0.25rem 0.5rem;"></li>
          <li>
            <a class="dropdown-item dropdown-item-custom logout-item py-2" href="#" onclick="event.preventDefault(); fetch('/api/auth/logout', {method: 'POST'}).then(() => window.location.href='/login');" style="font-size: 0.88rem; padding: 0.5rem 1rem; border-radius: 6px; transition: all 0.15s;">
              <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Log Out
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>

<%- include('notification-modal') %>

<script>
  /* ── Mobile sidebar: toggle .open + backdrop ── */
  // Mobile navigation is managed by the shared admin.js controller.

  /* ---- Notifications ---- */
  (function() {
    var badge = document.getElementById('notifBadge');
    var countEl = document.getElementById('notifCount');
    var listEl = document.getElementById('notifList');
    var btn = document.getElementById('notifDropdownBtn');
    var panel = document.getElementById('notifDropdown');
    var isOpen = false;
    var latestData = null;
    var showMore = false;
    var fetching = false;
    var fetchPromise = null;
    var refreshAgain = false;

    function timeAgo(dateStr) {
      var now = new Date();
      var d = new Date(dateStr);
      var diff = Math.floor((now - d) / 1000);
      if (Number.isNaN(d.getTime())) return '';
      if (diff < 60) return 'just now';
      if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
      return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
    }

    function safeLink(link) {
      try {
        var url = new URL(link || '#dashboardNotifications', window.location.href);
        if (url.origin === window.location.origin && /^https?:$/.test(url.protocol) && /^\/technician(?:\/|$)/.test(url.pathname)) {
          return url.pathname + url.search + url.hash;
        }
      } catch (_) {}
      return '/technician#dashboardNotifications';
    }

    // Both views render the exact same response. Text content is deliberately
    // not inserted as HTML because messages can contain customer-entered data.
    function renderList(container, notifications, dashboard) {
      container.replaceChildren();
      if (!notifications.length) {
        var empty = document.createElement('p');
        empty.className = 'text-muted small text-center py-3 mb-0';
        empty.textContent = 'You have no notifications yet.';
        container.appendChild(empty);
        return;
      }
      notifications.forEach(function(n) {
        var item = document.createElement('a');
        item.href = safeLink(n.link);
        item.className = dashboard ? 'td-notification-item' : 'notif-item text-decoration-none';
        item.style.whiteSpace = 'normal';
        if (!n.read) item.classList.add(dashboard ? 'is-unread' : 'unread');
        var icon = document.createElement('i');
        icon.className = 'bi flex-shrink-0 mt-1';
        String((n.icon || 'bi-bell') + ' ' + (n.iconClass || 'text-primary')).split(/\s+/).forEach(function(token) {
          if (/^(bi-[a-z0-9-]+|text-[a-z-]+)$/.test(token)) icon.classList.add(token);
        });
        icon.setAttribute('aria-hidden', 'true');
        var copy = document.createElement('div');
        copy.className = dashboard ? 'min-w-0' : 'notif-content';
        var title = document.createElement('div');
        title.className = dashboard ? 'fw-semibold small' : 'notif-title';
        title.textContent = n.title || 'Notification';
        if (!n.read) {
          var unreadLabel = document.createElement('span');
          unreadLabel.className = 'badge bg-primary ms-2';
          unreadLabel.textContent = 'Unread';
          title.appendChild(unreadLabel);
        }
        var message = document.createElement('div');
        message.className = dashboard ? 'text-muted small' : 'notif-msg';
        message.textContent = n.message || '';
        var time = document.createElement('div');
        time.className = dashboard ? 'text-muted small mt-1' : 'notif-time';
        time.textContent = timeAgo(n.time);
        copy.append(title, message, time);
        if (dashboard) {
          item.append(icon, copy);
        } else {
          if (!n.read) {
            var dot = document.createElement('span');
            dot.className = 'notif-dot';
            dot.setAttribute('aria-label', 'Unread');
            item.appendChild(dot);
          }
          var iconBox = document.createElement('span');
          iconBox.className = 'notif-icon';
          iconBox.style.background = '#dbeafe';
          iconBox.style.color = '#2563eb';
          iconBox.appendChild(icon);
          item.append(iconBox, copy);
        }
        item.addEventListener('click', function(e) {
          if (n.read || !n.id) return;
          e.preventDefault();
          if (item.getAttribute('aria-busy') === 'true') return;
          item.setAttribute('aria-busy', 'true');
          fetch('/api/notifications/' + encodeURIComponent(n.id) + '/read', { method: 'PUT', credentials: 'same-origin' })
            .then(function(response) {
              if (!response.ok) throw new Error('Unable to mark notification read');
              return fetchNotifications();
            })
            .then(function() { window.location.href = safeLink(n.link); })
            .catch(function() {
              var status = document.getElementById('dashboardNotificationStatus');
              if (status) status.textContent = 'Could not mark notification read. Please try again.';
              var dropdownStatus = document.getElementById('notifDropdownStatus');
              if (dropdownStatus) {
                dropdownStatus.textContent = 'Could not mark notification read. Please try again.';
                dropdownStatus.classList.remove('d-none');
              }
            })
            .finally(function() { item.setAttribute('aria-busy', 'false'); });
        });
        container.appendChild(item);
      });
    }

    function renderDashboard(data) {
      var dashboardList = document.getElementById('dashboardNotificationList');
      if (!dashboardList) return;
      var notifs = data.notifications || [];
      var visible = showMore ? notifs : notifs.slice(0, 5);
      renderList(dashboardList, visible, true);
      document.getElementById('dashboardNotificationBody').setAttribute('aria-busy', 'false');
      document.getElementById('dashboardNotificationStatus').textContent =
        data.unread + ' unread' + (notifs.length ? ' · Latest ' + visible.length + ' notification' + (visible.length === 1 ? '' : 's') : '');
      var more = document.getElementById('dashboardNotificationMore');
      more.hidden = notifs.length <= 5;
      more.textContent = showMore ? 'Show fewer' : 'Show more';
      more.setAttribute('aria-expanded', String(showMore));
    }

    function fetchNotifications() {
      if (fetching) { refreshAgain = true; return fetchPromise; }
      fetching = true;
      var refresh = document.getElementById('dashboardNotificationRefresh');
      if (refresh) refresh.disabled = true;
      fetchPromise = fetch('/api/technician/notifications', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      })
        .then(function(r) {
          if (!r.ok) throw new Error('Unable to load notifications');
          return r.json();
        })
        .then(function(data) {
          if (!Array.isArray(data.notifications) || !Number.isFinite(data.unread)) throw new Error('Invalid notification response');
          latestData = data;
          var notifs = data.notifications || [];
          var unread = data.unread || 0;

          // Badge
          if (unread > 0) {
            badge.classList.remove('d-none');
            badge.textContent = unread > 999 ? '999+' : String(unread);
          } else {
            badge.classList.add('d-none');
          }

          countEl.textContent = unread;
          btn.setAttribute('aria-label', 'Notifications, ' + unread + ' unread');
          renderList(listEl, notifs, false);
          renderDashboard(data);
        })
        .catch(function() {
          if (!latestData) listEl.textContent = 'Could not load notifications. Open the bell to try again.';
          var status = document.getElementById('dashboardNotificationStatus');
          if (status) status.textContent = 'Could not load notifications. Tap Refresh to try again.';
          var body = document.getElementById('dashboardNotificationBody');
          if (body) body.setAttribute('aria-busy', 'false');
        })
        .finally(function() {
          fetching = false;
          if (refresh) refresh.disabled = false;
          if (refreshAgain) { refreshAgain = false; return fetchNotifications(); }
        });
      return fetchPromise;
    }
    window._technicianRefreshNotifications = fetchNotifications;

    function closeNotificationPanel() {
      panel.classList.remove('show');
      panel.style.display = 'none';
      panel.style.visibility = 'hidden';
      panel.style.opacity = '0';
      isOpen = false;
      btn.setAttribute('aria-expanded', 'false');
    }
    window._technicianCloseNotificationPanel = closeNotificationPanel;

    document.addEventListener('click', function(e) {
      if (e.target.closest('#dashboardNotificationRefresh')) fetchNotifications();
      if (e.target.closest('#dashboardNotificationMore') && latestData) {
        showMore = !showMore;
        renderDashboard(latestData);
      }
    });

    // Toggle panel (same as admin navbar)
    if (btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        isOpen = !isOpen;
        btn.setAttribute('aria-expanded', String(isOpen));
        if (isOpen) {
          panel.classList.add('show');
          panel.style.display = 'block';
          panel.style.visibility = 'visible';
          panel.style.opacity = '1';
          fetchNotifications();
        } else {
          panel.classList.remove('show');
          panel.style.display = 'none';
          panel.style.visibility = 'hidden';
          panel.style.opacity = '0';
        }
      });
    }

    // Close on outside click
    document.addEventListener('click', function(e) {
      if (panel && btn && !panel.contains(e.target) && !btn.contains(e.target)) {
        closeNotificationPanel();
      }
    });

    // Poll every 60s
    setInterval(function() {
      if (!document.hidden) fetchNotifications();
    }, 60000);
    document.addEventListener('visibilitychange', function() {
      if (!document.hidden) fetchNotifications();
    });

    // The layout creates its socket after the navbar. Wait until that script
    // and the dashboard markup exist before loading or binding live updates.
    function initializeNotificationFeed() {
      fetchNotifications();
      if (!window.socket) return;
      window.socket.on('connect', fetchNotifications);
      window.socket.on('notification:new', function(data) {
        // Refresh the notification list
        fetchNotifications();
      });

      window.socket.on('assignment:new', function(data) {
        // New assignment received - refresh immediately
        fetchNotifications();
        // Show browser notification if permitted
        if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
          new Notification('New Assignment', {
            body: data.customerName ? 'New job for ' + data.customerName : 'You have a new assignment',
            icon: '/images/LOGO/RACS.png',
          });
        }
      });

      window.socket.on('assignment:accepted', function(data) {
        fetchNotifications();
      });

      window.socket.on('assignment:declined', function(data) {
        fetchNotifications();
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeNotificationFeed, { once: true });
    } else {
      initializeNotificationFeed();
    }
  })();
</script>
<script src="/js/technician-notification-inbox.js?v=20261012-shared"></script>
