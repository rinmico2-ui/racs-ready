      </div>`;})())}

      <!-- ══ 8. CUSTOMER & BOOKING (collapsed) ══ -->
      <details class="pd-card details-card" data-stage="review planning ready active completed" style="border:1.5px solid #e2e8f0;">
        <summary class="pd-head" style="cursor:pointer;"><h3><i class="bi bi-person-vcard me-2" style="color:#64748b;"></i>Customer & Booking Details</h3><i class="bi bi-chevron-down"></i></summary>
