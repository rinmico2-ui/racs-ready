  /* ── Enterprise Animations ── */
  @keyframes mwFadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes techPulse {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.6;
    }

    70% {
      transform: translate(-50%, -50%) scale(1.6);
      opacity: 0;
    }

    100% {
      transform: translate(-50%, -50%) scale(1.6);
      opacity: 0;
    }
  }

  @keyframes dropIn {
    0% {
      transform: scale(0);
      opacity: 0;
    }

    60% {
      transform: scale(1.1);
    }

    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes mwFadeIn {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes mwSlideInRight {
    from {
      opacity: 0;
      transform: translateX(20px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes mwPulse {

    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.6;
    }
  }

  @keyframes mwShimmer {
    0% {
      background-position: -200% 0;
    }

    100% {
      background-position: 200% 0;
    }
  }

  .mw-animate-fade-in {
    animation: mwFadeIn 0.4s ease-out;
  }

  .mw-animate-fade-in-up {
    animation: mwFadeInUp 0.5s ease-out;
  }

  .mw-animate-slide-in {
    animation: mwSlideInRight 0.4s ease-out;
  }

  /* Tab pane transition */
  .tab-pane.fade {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tab-pane.fade.show {
    opacity: 1;
  }

  /* Skeleton loading */
  .mw-skeleton {
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
    background-size: 200% 100%;
    animation: mwShimmer 1.5s infinite;
    border-radius: 8px;
  }

  /* ── Responsive Breakpoints ── */
  /* ═══════════════════════════════════════════════════════════════════
     SPLIT-PANE LAYOUT — Desktop Side Panel / Mobile Fullscreen
     ═══════════════════════════════════════════════════════════════════ */

  .mw-split-layout {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    min-height: calc(100vh - 280px);
  }

  .mw-split-left {
    flex: 1;
    min-width: 0;
    transition: all 0.3s ease;
  }

  .mw-split-left.panel-open {
    flex: 0 0 380px;
    max-width: 380px;
  }

  /* list-hidden now hides the list so the detail panel feels like a separate page */
  .mw-split-left.list-hidden {
    display: none;
  }

  body:has(.mw-split-right.open) .mw-split-left {
    display: none;
  }

  /* ── Scrollable Job List ── */
  #assignmentsContainer {
    max-height: calc(100vh - 280px);
    overflow-y: auto;
    padding-right: 6px;
  }
  #assignmentsContainer::-webkit-scrollbar { width: 5px; }
  #assignmentsContainer::-webkit-scrollbar-track { background: transparent; }
  #assignmentsContainer::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  #assignmentsContainer::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

  @media (max-width: 991px) {
    #assignmentsContainer { max-height: none; overflow-y: visible; padding-right: 0; }
  }

  /* Large-Scale Project pane: fills the same left column as the bookings list */
  #projectPane {
    flex: 1 1 100%;
    width: 100%;
    min-width: 0;
    animation: mwFadeInUp 0.35s ease-out both;
  }

  #projectPane .pw-wrap {
    max-width: 100%;
    width: 100%;
    /* No persistent transform here — a retained transform would turn the
       position:fixed detail drawer/overlay into a containing-block child and
       make them render on-screen before being opened. */
    animation: mwFadeInUp 0.35s ease-out;
  }

  /* Standard Bookings hero — Premium E-commerce Style */
  .sb-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 35%, #2563eb 100%);
    border-radius: 20px;
    padding: 2rem 2.25rem 1.75rem;
    color: #fff;
    margin-bottom: 1.25rem;
    box-shadow: 0 20px 60px rgba(15, 23, 42, .18), 0 4px 16px rgba(37, 99, 235, .08);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .sb-hero::after {
    content: '';
    position: absolute;
    right: -40px;
    top: -50px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(99, 102, 241, .22) 0%, transparent 70%);
  }

  .sb-hero::before {
    content: '';
    position: absolute;
    right: 140px;
    bottom: -80px;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(14, 165, 233, .15) 0%, transparent 70%);
  }

  .sb-hero h2 {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: -.025em;
    position: relative;
    z-index: 1;
  }

  .sb-hero h2 i {
    opacity: .65;
    margin-right: .5rem;
  }

  .sb-hero .sub {
    font-size: 0.84rem;
    opacity: 0.78;
    margin-top: 0.5rem;
    line-height: 1.55;
    max-width: 60ch;
    position: relative;
    z-index: 1;
  }

  /* ═══════════════════════════════════════════════════════════════════════
     ENTERPRISE VIEW DETAILS PANEL — Complete Premium Redesign
     ─────────────────────────────────────────────────────────────────────
     Visual Hierarchy:
       Layer 1 — Status-Aware Immersive Header (dark gradient + orbs)
       Layer 2 — Workflow Progress Stepper (fused to header)
       Layer 3 — Scrollable content body (slate-50 bg)
       Layer 4 — Floating glassmorphic action footer
  ═══════════════════════════════════════════════════════════════════════ */

  /* ── L0: Panel Container ── */
  .mw-split-right {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100vh;
    z-index: 1050;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 0;
    background: #ffffff;
    box-shadow: none;
    opacity: 0;
    transform: translateX(24px);
    visibility: hidden;
  }

  .mw-split-right.open {
    opacity: 1;
    transform: translateX(0);
    visibility: visible;
    overflow: hidden;
  }

  .mw-split-right-inner {
    display: flex;
    flex-direction: column;
    border-radius: 0;
    height: 100%;
    min-height: 100vh;
    overflow: hidden;
  }

  /* ── L1: Status-Aware Immersive Header ── */
  .detail-panel-header {
    background: linear-gradient(150deg, #0c1526 0%, #162040 45%, #1d4ed8 100%);
    color: #ffffff;
    padding: 14px 16px 0;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    z-index: 50;
    overflow: hidden;
    transition: background 0.45s ease;
  }

  /* Status-aware dynamic gradient overrides */
  .detail-panel-header[data-status="completed"] {
    background: linear-gradient(150deg, #012118 0%, #023d2c 45%, #059669 100%);
  }
  .detail-panel-header[data-status="en_route"] {
    background: linear-gradient(150deg, #13103d 0%, #26196e 45%, #7c3aed 100%);
  }
  .detail-panel-header[data-status="on_site"] {
    background: linear-gradient(150deg, #1c0d00 0%, #3d1800 45%, #c2410c 100%);
  }
  .detail-panel-header[data-status="in_progress"] {
    background: linear-gradient(150deg, #08152e 0%, #122650 45%, #1d4ed8 100%);
  }
  .detail-panel-header[data-status="cancelled"],
  .detail-panel-header[data-status="declined"] {
    background: linear-gradient(150deg, #140505 0%, #3b0808 45%, #b91c1c 100%);
  }
  .detail-panel-header[data-status="pending_acceptance"] {
    background: linear-gradient(150deg, #0d1520 0%, #1a2a3e 45%, #475569 100%);
  }

  /* Decorative light orbs */
  .detail-panel-header::before {
    content: '';
    position: absolute;
    top: -55px;
    right: -55px;
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .detail-panel-header::after {
    content: '';
    position: absolute;
    bottom: -35px;
    left: -30px;
    width: 140px;
    height: 140px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.08) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .detail-panel-header-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    position: relative;
    z-index: 1;
  }

  .detail-panel-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1;
  }

  /* ── Large glowing avatar ── */
  .detail-panel-avatar {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(20px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: transform 0.3s ease;
  }

  /* ── Customer name ── */
  .detail-panel-title {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0 0 3px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .detail-panel-subtitle {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
  }

  /* Booking ref chip */
  .detail-panel-subtitle > #detailPanelRef {
    font-size: 0.62rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    opacity: 1 !important;
  }

  /* ── Animated live status pill ── */
  .detail-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.52rem;
    font-weight: 700;
    padding: 2px 8px 2px 6px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .detail-status-badge::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ffffff;
    flex-shrink: 0;
    animation: epStatusDot 2.4s ease-in-out infinite;
  }

  @keyframes epStatusDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.35; transform: scale(0.65); }
  }

  /* ── Back to jobs (page-style nav) ── */
  .detail-panel-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 13px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
    margin-right: 4px;
  }

  .detail-panel-back:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .detail-panel-back i { font-size: 0.75rem; }

  /* ── Close button ── */
  .detail-panel-close {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
    font-size: 0.9rem;
  }

  .detail-panel-close:hover {
    background: rgba(239, 68, 68, 0.85);
    border-color: #ef4444;
    color: #fff;
  }

  /* ── L2: Workflow Stepper — fused seamlessly to header ── */
  .detail-panel-workflow {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
    padding: 10px 14px 14px;
    border-radius: 12px 12px 0 0;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: none;
    position: relative;
    z-index: 1;
    backdrop-filter: blur(14px);
  }

  .detail-panel-workflow .dpw-hero {
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .detail-panel-workflow .dpw-hero .mw-service-hero {
    background: none;
    box-shadow: none;
    padding: 0;
    margin: 0;
    border-radius: 0;
  }

  .detail-panel-workflow .dpw-steps {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2px;
  }

  .detail-panel-workflow .wf-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex: 1;
    min-width: 0;
    position: relative;
  }

  .detail-panel-workflow .wf-dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.3);
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    transition: all 0.3s ease;
    position: relative;
    z-index: 2;
  }

  .detail-panel-workflow .wf-step.active .wf-dot {
    background: linear-gradient(135deg, #10b981, #059669);
    border-color: rgba(255, 255, 255, 0.45);
    color: #fff;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    transform: scale(1.1);
    animation: epWfPulse 2.5s ease-in-out infinite;
  }

  .detail-panel-workflow .wf-step.completed .wf-dot {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
    color: #fff;
  }

  .detail-panel-workflow .wf-step-label {
    font-size: 0.48rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.35);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
    transition: color 0.3s;
  }

  .detail-panel-workflow .wf-step.active .wf-step-label,
  .detail-panel-workflow .wf-step.completed .wf-step-label {
    color: rgba(255, 255, 255, 0.9);
  }

  .detail-panel-workflow .wf-connector {
    flex: 1;
    height: 1.5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    margin: 0 -2px;
    align-self: flex-start;
    margin-top: 11px;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .detail-panel-workflow .wf-connector.completed {
    background: rgba(255, 255, 255, 0.44);
  }

  @keyframes epWfPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.3); }
    50%       { box-shadow: 0 0 0 4px rgba(16, 185, 129, 0); }
  }

  /* Smooth body-header seam: body starts with a matching dark "continuation" */
  .detail-panel-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-y: contain;
    padding: 0;
    background: #f5f7fb;
  }

  .detail-panel-body > .mw-detail-panels { padding: 18px 20px 90px; }
  .detail-panel-body > .mw-detail-panel  { padding: 18px 20px 90px; }

  .detail-panel-body::-webkit-scrollbar { width: 4px; }
  .detail-panel-body::-webkit-scrollbar-track { background: transparent; }
  .detail-panel-body::-webkit-scrollbar-thumb { background: #c8d4e4; border-radius: 4px; }
  .detail-panel-body::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

  /* ── Premium Empty State ── */
  .detail-panel-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 300px;
    padding: 48px 28px;
    text-align: center;
    position: relative;
    background: linear-gradient(180deg, #f8fafc 0%, #f0f4f8 100%);
  }

  /* Spinning dashed ring behind icon */
  .detail-panel-empty::before {
    content: '';
    width: 110px;
    height: 110px;
    border-radius: 50%;
    border: 2px dashed #c3d0e4;
    position: absolute;
    animation: epEmptyRing 16s linear infinite;
    pointer-events: none;
  }

  @keyframes epEmptyRing { to { transform: rotate(360deg); } }

  .detail-panel-empty i {
    font-size: 3rem;
    margin-bottom: 18px;
    position: relative;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 4px 14px rgba(59, 130, 246, 0.35));
  }

  .detail-panel-empty h6 {
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 8px;
    font-size: 1.05rem;
    letter-spacing: -0.025em;
  }

  .detail-panel-empty p {
    font-size: 0.8rem;
    margin: 0;
    max-width: 220px;
    line-height: 1.65;
    color: #64748b;
  }

  /* ── Loading Spinner ── */
  .detail-panel-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    gap: 14px;
    background: #f0f4f8;
  }

  .detail-panel-loading .spinner {
    width: 36px;
    height: 36px;
    border: 3px solid #dde6f2;
    border-top-color: #3b82f6;
    border-radius: 50%;
    animation: epSpin 0.75s linear infinite;
  }

  @keyframes epSpin { to { transform: rotate(360deg); } }

  .detail-panel-loading span {
    font-size: 0.78rem;
    color: #64748b;
    font-weight: 600;
  }

  /* ── Tab Bar (Premium) ── */
  .mw-detail-tabs {
    display: flex;
    gap: 4px;
    padding: 8px 12px;
    background: #ffffff;
    border-bottom: 1px solid #e8edf5;
    flex-shrink: 0;
    overflow-x: auto;
    scrollbar-width: none;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
  }

  .mw-detail-tabs::-webkit-scrollbar { display: none; }

  .mw-detail-tab {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 14px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #64748b;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .mw-detail-tab i { font-size: 0.72rem; opacity: 0.7; }

  .mw-detail-tab:hover { color: #1e293b; background: #f8fafc; border-color: #e2e8f0; }

  .mw-detail-tab.active {
    color: #1d4ed8;
    background: #eff6ff;
    border-color: rgba(29, 78, 216, 0.12);
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(29, 78, 216, 0.1);
  }

  .mw-detail-tab.active i { opacity: 1; }

  .mw-detail-panels { flex: 1; }
  .mw-detail-panel { display: none; }
  .mw-detail-panel.active { display: block; }

  /* ── L3: Section Info Cards (Premium E-commerce) ── */
  .mw-split-right .detail-section {
    background: #ffffff;
    border: 1px solid #e8edf5;
    border-radius: 14px;
    margin-bottom: 14px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mw-split-right .detail-section:hover {
    border-color: rgba(37, 99, 235, 0.15);
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.07);
  }

  .mw-split-right .detail-section-header {
    padding: 12px 16px;
    border-bottom: 1px solid #f0f4f8;
    background: linear-gradient(135deg, #fafbff 0%, #f5f8ff 100%);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mw-split-right .detail-section-header i {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    flex-shrink: 0;
    background: rgba(37, 99, 235, 0.08);
    color: #2563eb;
    transition: all 0.2s;
  }

  .mw-split-right .detail-section:hover .detail-section-header i {
    background: rgba(37, 99, 235, 0.12);
    transform: scale(1.05);
  }

  .mw-split-right .detail-section-header h6 {
    font-size: 0.7rem;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
    flex: 1;
  }

  .mw-split-right .detail-section-body { padding: 12px 16px 14px; }

  .mw-split-right .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 7px 0;
    border-bottom: 1px solid #f5f8fc;
    gap: 8px;
  }

  .mw-split-right .detail-row:last-child { border-bottom: none; padding-bottom: 0; }
  .mw-split-right .detail-row:first-child { padding-top: 0; }

  .mw-split-right .detail-row label {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.055em;
    color: #94a3b8;
    margin: 0;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .mw-split-right .detail-row span {
    color: #1e293b;
    font-weight: 600;
    text-align: right;
    max-width: 65%;
    word-break: break-word;
    font-size: 0.78rem;
  }

  .mw-split-right .detail-fee {
    background: linear-gradient(135deg, #f0fdf4, #dcfce7);
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .mw-split-right .detail-fee label {
    font-size: 0.66rem;
    font-weight: 700;
    color: #166534;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .mw-split-right .detail-fee span { font-size: 1rem; color: #166534; font-weight: 800; }

  .mw-split-right .wizard-container { max-height: none; }
  .mw-split-right .wizard-page { padding: 0; }
  .mw-split-right #wizardActionBar { display: none !important; }
  .mw-split-right #wizardPageIndicator { display: none !important; }

  /* ── L4: Floating Glassmorphic Action Footer ── */
  .detail-panel-actions {
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-top: 1px solid #e4eaf4;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    flex-shrink: 0;
    position: relative;
    z-index: 50;
    box-shadow: 0 -6px 32px rgba(15, 23, 42, 0.1);
  }

  .detail-panel-actions .btn {
    border-radius: 11px;
    font-weight: 700;
    font-size: 0.78rem;
    padding: 10px 18px;
    transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: none;
    letter-spacing: -0.01em;
  }

  .detail-panel-actions .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
  }

  .detail-panel-actions .btn:active { transform: translateY(0) scale(0.98); }

  .detail-panel-actions .btn-success {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #fff;
    box-shadow: 0 2px 12px rgba(16, 185, 129, 0.38);
  }

  .detail-panel-actions .btn-primary {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    color: #fff;
    box-shadow: 0 2px 12px rgba(37, 99, 235, 0.38);
  }

  .detail-panel-actions .btn-warning {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: #fff;
    box-shadow: 0 2px 12px rgba(245, 158, 11, 0.38);
  }

  .detail-panel-actions .btn-danger {
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    color: #fff;
    box-shadow: 0 2px 12px rgba(239, 68, 68, 0.32);
  }

  .detail-panel-actions .btn-outline-secondary {
    background: #f8fafc;
    color: #475569;
    border: 1.5px solid #e2e8f0 !important;
  }

  .detail-panel-actions .btn-outline-secondary:hover {
    background: #f1f5f9;
    color: #1e293b;
    border-color: #cbd5e1 !important;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
  }

  /* ── Mobile Overlay ── */
  @media (max-width: 991px) {
    .mw-split-layout { flex-direction: column; gap: 0; min-height: auto; }
    .mw-split-left.panel-open { display: none; }

    .mw-split-right {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      z-index: 1060;
      border-radius: 0;
      max-height: 100vh; height: 100vh;
      min-height: 100vh;
      transform: translateX(100%);
      opacity: 1; visibility: visible;
      border: none; box-shadow: none;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      min-width: 0; max-width: 100%;
    }

    .mw-split-right.open { transform: translateX(0); }
    .mw-split-right-inner { max-height: 100vh; height: 100vh; min-height: 100vh; border-radius: 0; }
    .detail-panel-body { -webkit-overflow-scrolling: touch; padding-bottom: env(safe-area-inset-bottom, 0); }
    .detail-panel-back { display: flex !important; }
    .detail-panel-header { padding: 12px 14px 0; }
    .detail-panel-title { font-size: 0.85rem; }

    .detail-panel-workflow {
      margin-top: 10px; padding: 8px 12px 12px;
    }

    .detail-panel-workflow .dpw-hero { flex-wrap: wrap; gap: 4px; }
    .detail-panel-workflow .dpw-hero .mw-sh-icon { width: 26px; height: 26px; border-radius: 6px; font-size: 0.75rem; }
    .detail-panel-workflow .dpw-hero .mw-sh-name { font-size: 0.78rem; }
    .detail-panel-workflow .dpw-hero .mw-sh-sub { font-size: 0.48rem; }
    .detail-panel-workflow .dpw-hero .mw-sh-fee { font-size: 0.88rem; }
    .detail-panel-workflow .dpw-hero .mw-sh-feelabel { font-size: 0.45rem; }
    .detail-panel-workflow .wf-dot { width: 22px; height: 22px; font-size: 0.55rem; }
    .detail-panel-workflow .wf-connector { height: 1.5px; margin-top: 10px; }
    .detail-panel-workflow .wf-step-label { font-size: 0.44rem; }

    #routePanelMap #detailRouteMap {
      height: 35vh !important; min-height: 180px !important; max-height: 260px !important;
    }

