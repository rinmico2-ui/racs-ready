        <div class="rp-filter-group">
          <label class="rp-filter-label" for="rpAssetStatusFilter"><i class="bi bi-shield-check me-1"></i>Asset Status</label>
          <select class="form-select rp-filter-input" id="rpAssetStatusFilter" style="height:42px;">
            <option value="">All Asset Status</option>
            <option value="available">Available</option>
            <option value="reserved">Reserved</option>
            <option value="checked_out">Checked Out</option>
            <option value="under_maintenance">Under Maintenance</option>
