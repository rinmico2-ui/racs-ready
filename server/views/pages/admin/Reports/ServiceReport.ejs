        </div>
        <div class="dash-card-body">
          <div style="font-size:1.5rem;font-weight:600;color:#0f172a;">₱<%= analytics ? analytics.coreRevenueAccurate.toLocaleString() : "0" %></div>
          <div class="d-flex align-items-center justify-content-between mt-2">
            <span style="font-size:0.72rem;color:#94a3b8;"><%= analytics ? analytics.coreServiceBookings : 0 %> bookings</span>
            <span class="kpi-enterprise-badge cyan"><%= analytics && analytics.accurateTotalRevenue > 0 ? Math.round((analytics.coreRevenueAccurate / analytics.accurateTotalRevenue) * 100) : 0 %>%</span>
          </div>
        </div>
      </div>
