  AU.Queue.loadStats=function(){
    Promise.all([
      fetch('/api/admin/appointments/list?status=awaiting_assignment&limit=1').then(function(r){return r.json().catch(function(){return{pagination:{total:0}};});}),
      fetch('/api/admin/appointments/list?status=pending_reassignment&limit=1').then(function(r){return r.json().catch(function(){return{pagination:{total:0}};});}),
      fetch('/api/admin/appointments/cancellation-log?escalated=true&limit=1').then(function(r){return r.json().catch(function(){return{pagination:{total:0}};});})
    ]).then(function(res){
      var awaiting=res[0].pagination?res[0].pagination.total||0:0;
      var reassign=res[1].pagination?res[1].pagination.total||0:0;
      var escalated=res[2].pagination?res[2].pagination.total||0:0;
      document.getElementById('statAwaiting').textContent=awaiting;
      document.getElementById('statReassign').textContent=reassign;
      document.getElementById('statTotal').textContent=awaiting+reassign;
      document.getElementById('statEscalated').textContent=escalated;
      var tq=document.getElementById('tabQueueBadge');if(tq)tq.textContent=(awaiting+reassign)>0?(awaiting+reassign):'';
    }).catch(function(){});
  };

  AU.Queue.loadQueue=function(page){
    page=page||1;_qPage=page;
    var filterEl=document.getElementById('aqFilterStatus');
    var searchEl=document.getElementById('aqSearchInput');
    var filter=filterEl?filterEl.value:'awaiting_assignment';
    var search=searchEl?searchEl.value:'';
    var url;
    if(filter==='all_active')url='/api/admin/appointments/list?page='+page+'&limit=20&status=awaiting_assignment,pending_reassignment';
    else url='/api/admin/appointments/list?status='+filter+'&page='+page+'&limit=20';
    if(search)url+='&search='+encodeURIComponent(search);
    var container=document.getElementById('queueContainer');
    fetch(url).then(function(r){return r.json();}).then(function(data){
      if(!data.bookings||!data.bookings.length){container.innerHTML='<div class="au-empty-state"><div class="au-empty-state-icon"><i class="bi bi-inbox"></i></div><h6>No Bookings in Queue</h6><p>All assignments have been handled</p></div>';document.getElementById('aqPagination').innerHTML='';return;}
      var statusColors={awaiting_assignment:'bg-warning text-dark',assigned:'bg-info text-dark',pending_reassignment:'bg-danger',payment_verified:'bg-success',confirmed:'bg-primary'};
      container.innerHTML=data.bookings.map(function(b){
        var canAssign=['awaiting_assignment','pending_reassignment'].indexOf(b.status)!==-1;
        var rc=b.reassignmentCount||0;
        var isEsc=b.escalated||rc>=3;
        var hist=b.cancellationHistory||[];
        var last=hist.length>0?hist[hist.length-1]:null;
        return '<div class="aq-booking-card"><div class="aq-booking-header"><div><div class="aq-booking-id">#'+b._id.toString().slice(-8).toUpperCase()+'</div><div class="aq-booking-customer">'+(b.customer?b.customer.name:'Customer')+'</div><div class="aq-booking-service">'+(b.service?b.service.name:(b.serviceModel==='RepairService'||b.serviceType==='repair'?'Repair Service':'Service'))+(b.isMultiService?' (Multi-Service)':'')+'</div></div><div class="text-end d-flex flex-column align-items-end gap-1">'+(isEsc?'<span class="aq-escalation-badge"><i class="bi bi-exclamation-triangle-fill"></i>Escalated ('+rc+'x)</span>':'')+'<span class="badge '+(statusColors[b.status]||'bg-secondary')+'">'+statusLabel(b.status)+'</span></div></div><div class="aq-detail-grid"><div class="aq-detail-item"><i class="bi bi-calendar"></i> '+formatDate(b.bookingDate)+'</div><div class="aq-detail-item"><i class="bi bi-clock"></i> '+formatTime(b.startTime)+'</div><div class="aq-detail-item"><i class="bi bi-geo-alt"></i> '+((b.location?b.location.address:'No address')||'No address').substring(0,30)+'</div><div class="aq-detail-item"><i class="bi bi-cash"></i> \u20B1'+Number(b.totalPrice||b.estimatedFee||0).toLocaleString()+'</div><div class="aq-detail-item"><i class="bi bi-credit-card"></i> '+(b.paymentMethod||'cod').toUpperCase()+'</div><div class="aq-detail-item"><i class="bi bi-person"></i> '+(b.technician?b.technician.name:'Unassigned')+'</div>'+(rc>0?'<div class="aq-detail-item"><i class="bi bi-arrow-repeat"></i> Reassigned '+rc+' time'+(rc>1?'s':'')+'</div>':'')+'</div>'+
        (b.status==='pending_reassignment'?'<div class="aq-reassign-alert"><i class="bi bi-arrow-repeat me-1"></i><strong>Needs Reassignment</strong> \u2014 Previous technician '+(last?last.action:'declined')+' this job.</div>':'')+
        (hist.length>0?'<div class="aq-cancel-history"><div class="aq-cancel-history-title"><i class="bi bi-clock-history me-1"></i>Cancellation History</div>'+hist.slice(-3).reverse().map(function(h){return '<div class="aq-cancel-history-item"><span class="action-badge action-'+h.action+'">'+h.action+'</span><span><strong>'+h.technicianName+'</strong> \u2014 '+(h.reason||'No reason')+' <small class="text-muted">'+new Date(h.timestamp).toLocaleDateString('en-PH',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'})+'</small></span></div>';}).join('')+'</div>':'')+
        (canAssign?'<div class="aq-action-bar"><button class="au-btn au-btn-ghost" onclick="AU.Queue.viewBooking(\''+b._id+'\')" style="font-size:0.75rem;"><i class="bi bi-eye me-1"></i>View</button><button class="au-btn au-btn-primary" onclick="AU.Queue.openAssignModal(\''+b._id+'\',\''+(b.customer?b.customer.name:'').replace(/'/g,"\\'")+'\',\''+((b.service?b.service.name:'')||(b.serviceModel==='RepairService'||b.serviceType==='repair'?'Repair Service':'')).replace(/'/g,"\\'")+'\')" style="font-size:0.75rem;"><i class="bi bi-person-plus me-1"></i>Assign Technician</button></div>':'')+
        '</div>';
      }).join('');
      var pag=data.pagination||{};
      if(pag.pages>1){
        var pg='<ul class="pagination pagination-sm">';
        for(var i=1;i<=pag.pages;i++)pg+='<li class="page-item '+(i===pag.page?'active':'')+'"><button class="page-link" onclick="AU.Queue.loadQueue('+i+')">'+i+'</button></li>';
        pg+='</ul>';
        document.getElementById('aqPagination').innerHTML=pg;
      }else document.getElementById('aqPagination').innerHTML='';
    }).catch(function(){container.innerHTML='<div class="alert alert-danger">Failed to load queue</div>';});
  };

  AU.Queue.openAssignModal=function(bookingId,customerName,serviceName){
    _qCurrentBookingId=bookingId;_qSelectedTechId=null;_qEquipment=[];

    var modalEl=document.getElementById('assignModal');
    var mapEl=document.getElementById('assignMapContainer');

    document.getElementById('assignCustomerName').textContent=customerName;
    document.getElementById('assignServiceInfo').textContent=serviceName;
    document.getElementById('assignNotes').value='';
    document.getElementById('assignPriority').value='normal';
    document.getElementById('btnConfirmAssign').disabled=true;

    document.getElementById('aiRecommendName').textContent='—';
    document.getElementById('aiRecommendReason').textContent='—';
    document.getElementById('aiRecommendSection').style.display='';
    document.getElementById('assignFooterSub').textContent='—';
    document.getElementById('techCountBadge').textContent='—';
    document.getElementById('assignAvailabilityHint').textContent='';

    var toolInput=document.getElementById('assignEquipmentToolInput');
    var toolHidden=document.getElementById('assignEquipmentTool');
    var toolList=document.getElementById('assignEquipmentDatalist');
    var toolQty=document.getElementById('assignEquipmentQty');
    if(toolInput){toolInput.value='';toolInput.placeholder='Loading tools...';toolInput.disabled=true;}
    if(toolHidden) toolHidden.value='';
    if(toolList) toolList.innerHTML='';
    if(toolQty) toolQty.value=1;
    AU.Queue.renderEquipmentList();

    fetch('/api/admin/appointments/tools/available?serviceName='+encodeURIComponent(serviceName)).then(function(r){return r.json();}).then(function(d){
      _qEquipmentCache=d.tools||[];
      var dl=document.getElementById('assignEquipmentDatalist'); var input=document.getElementById('assignEquipmentToolInput');
      if(!dl||!input) return;
      if(!_qEquipmentCache.length){ input.disabled=false; input.placeholder='No tools available'; return; }
      dl.innerHTML=_qEquipmentCache.map(function(t){ return '<option value="'+t.itemName+' (avail '+t.availableQuantity+')">'; }).join('');
      input.disabled=false; input.placeholder='Type tool name...';
      AU.Queue.renderRecommendedTools(d.recommended||[]);
    }).catch(function(){ var dl=document.getElementById('assignEquipmentDatalist'); var input=document.getElementById('assignEquipmentToolInput'); if(dl) dl.innerHTML=''; if(input){input.disabled=false; input.placeholder='Tools unavailable';} });

    document.getElementById('techListContainer').innerHTML='<div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></div>';

    if(mapEl){ mapEl.innerHTML=''; }
    document.getElementById('assignLocationSub').textContent='Loading map...';

    new bootstrap.Modal(modalEl).show();

    function ensureAssignLeaflet(){
      if(window.L&&mapEl&&document.getElementById('leaflet-css')) return Promise.resolve();
      if(!document.getElementById('leaflet-css')){
        var css=document.createElement('link');
        css.id='leaflet-css';
        css.rel='stylesheet';
        css.href='https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(css);
      }
      if(window.L) return Promise.resolve();
      return new Promise(function(resolve){
        var s=document.createElement('script');
        s.src='https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js';
        s.onload=function(){resolve();};
        document.head.appendChild(s);
      });
    }

    function parseCoords(c){
      if(!c) return null;
      try{
        if(Array.isArray(c)&&c.length>=2){
          var lng=Number(c[0]),lat=Number(c[1]);
          if(!isFinite(lng)||!isFinite(lat)) return null;
          return {lat:lat,lng:lng};
        }
        if(typeof c==='object'){
          if(c.coordinates) return parseCoords(c.coordinates);
          if(c.lat!=null&&c.lng!=null){
            var la=Number(c.lat),lo=Number(c.lng);
            if(!isFinite(la)||!isFinite(lo)) return null;
            return {lat:la,lng:lo};
          }
        }
      }catch(e){}
      return null;
    }

    fetch('/api/admin/appointments/'+bookingId+'/eligible-technicians').then(function(r){return r.json();}).then(function(data){
      var container=document.getElementById('techListContainer');
      var avail=data.available||[];
      var unavail=data.offlinePresent||[];

      var eligibleCount=avail.length+(unavail.length||0);
      document.getElementById('techCountBadge').textContent=(eligibleCount>0?eligibleCount:0);

      var ai=data.aiRecommendation||data.ai||data.recommendation||null;

      // Resolve AI recommended technician id from different response shapes
      function resolveAiTechId(aiObj){
        if(!aiObj) return null;

        // direct / common shapes
        var candidate = aiObj.technicianId || aiObj.technician_id || aiObj.techId || aiObj._id || aiObj.id;
        if(candidate){
          if(typeof candidate === 'object'){
            return String(candidate._id || candidate.id || candidate.technicianId || candidate.value || '');
          }
          return String(candidate);
        }

        // nested shapes
        if(aiObj.technician){
          if(aiObj.technician._id) return String(aiObj.technician._id);
          if(aiObj.technician.id) return String(aiObj.technician.id);
          if(aiObj.technician.technicianId) return String(aiObj.technician.technicianId);
          if(typeof aiObj.technician === 'string') return aiObj.technician;
        }

        // occasionally: technicianId may itself be { _id: ... }
        if(aiObj.technicianId && typeof aiObj.technicianId === 'object'){
          if(aiObj.technicianId._id) return String(aiObj.technicianId._id);
          if(aiObj.technicianId.id) return String(aiObj.technicianId.id);
        }

        return null;
      }
      var aiTechId=resolveAiTechId(ai);

      // ── AI recommendation (uses server-side ranking: availability, rating, workload, proximity) ──
      if(!ai && avail.length > 0){
        // Server returns `available` already sorted best-first by the AI score.
        var best = avail[0];
        if(best){
          aiTechId = String(best._id);
          var reasonParts = [];
          if(best.availabilityStatus === 'Available') reasonParts.push('Available now');
          else if(best.availabilityStatus === 'Online') reasonParts.push('Online');
          if(best.distanceKm != null) reasonParts.push(best.distanceKm + ' km away');
          if(best.etaMin != null) reasonParts.push('ETA ~' + best.etaMin + ' min');
          if(best.rating >= 4.5) reasonParts.push('Top rated (' + Number(best.rating).toFixed(1) + ')');
          if(best.currentWorkload === 0) reasonParts.push('No current jobs');
          else if(best.currentWorkload) reasonParts.push(best.currentWorkload + ' active job' + (best.currentWorkload > 1 ? 's' : ''));
          document.getElementById('aiRecommendName').textContent = best.name;
          document.getElementById('aiRecommendReason').textContent = reasonParts.join(' · ');
          document.getElementById('aiRecommendSection').style.display = '';
        }
      }

      // AI section (server-side, if provided)
      if(ai){
        var aiName=ai.name||ai.technicianName||ai.technician||'Recommended';
        var aiReason=ai.reason||ai.reasons||ai.explanation||'Based on workload, distance, and availability';
        document.getElementById('aiRecommendName').textContent=aiName;
        document.getElementById('aiRecommendReason').textContent=aiReason;

        // if API returns aiTechId but not matching _id string format, try matching by name
        if(aiTechId){
          var aiMatch = avail.find(function(t){ return t && t._id && String(t._id)===String(aiTechId); });
          if(!aiMatch){
            var aiNameLower = String(aiName||'').toLowerCase();
            aiMatch = avail.find(function(t){ return t && t.name && String(t.name).toLowerCase()===aiNameLower; });
          }
          if(aiMatch && aiMatch._id) aiTechId = String(aiMatch._id);
        }

        // show only when we have at least something useful
        if(aiTechId || aiName || aiReason) document.getElementById('aiRecommendSection').style.display='';
        else document.getElementById('aiRecommendSection').style.display='none';
      }else if(!aiTechId){
        // No server AI and no client-side proximity match
        document.getElementById('aiRecommendName').textContent='—';
        document.getElementById('aiRecommendReason').textContent='—';
        document.getElementById('aiRecommendSection').style.display='none';
      }

      if(!avail.length&&!unavail.length){
        container.innerHTML='<div class="alert alert-warning small mb-0">No eligible technicians found.</div>';
        document.getElementById('assignLocationSub').textContent='No location available';
        return;
      }

      // Render technician cards
      var html='';
      if(avail.length>0){
        html+='<div class="aq-tech-list">'+avail.map(function(t){
          var isRecommended=(aiTechId&&String(t._id)===String(aiTechId));
          var selectedClass=isRecommended?' selected':'';
          var recommendedBadge=isRecommended?'<div style="margin-left:auto;display:flex;align-items:center;gap:6px;"><span class="badge" style="background:#eef2ff;color:#4f46e5;border:1px solid #c7d2fe;font-weight:800;">AI Recommended</span></div>':'';
          var distBadge=t.distanceKm!=null?'<span style="font-size:0.7rem;background:#f0fdf4;color:#166534;border:1px solid #bbf7d0;border-radius:6px;padding:1px 6px;margin-left:4px;"><i class="bi bi-geo me-1"></i>'+t.distanceKm+' km</span>':'';
          var etaBadge=t.etaMin!=null?'<span style="font-size:0.7rem;background:#eff6ff;color:#1e40af;border:1px solid #bfdbfe;border-radius:6px;padding:1px 6px;margin-left:4px;"><i class="bi bi-clock me-1"></i>'+t.etaMin+' min</span>':'';
          return '<div class="aq-tech-option'+selectedClass+'" onclick="AU.Queue.selectTech(\''+t._id+'\',this)" data-tech-id="'+t._id+'">'+
            '<div class="aq-tech-avatar">'+((t.name||'?')[0].toUpperCase())+'</div>'+
            '<div style="flex:1;min-width:0;">'+
              '<div class="aq-tech-name d-flex justify-content-between align-items-center gap-2">'+
                '<span>'+t.name+'</span>'+recommendedBadge+
              '</div>'+
              '<div class="aq-tech-status">'+
                (t.availabilityStatus==='Available'?'<span class="online">&#9679;</span> Available':t.availabilityStatus)+
                (t.rating?' | \u2605 '+t.rating.toFixed(1):'')+
                distBadge+etaBadge+
              '</div>'+
            '</div>'+
          '</div>';
        }).join('')+'</div>';
      }
      if(unavail.length>0){
        html+='<div class="mt-2"><small class="text-muted fw-semibold">Unavailable Technicians</small></div>';
        html+='<div class="aq-tech-list">'+unavail.map(function(t){
          return '<div class="aq-tech-option disabled" style="opacity:0.5;pointer-events:none;" title="'+(t.reason||'Unavailable')+'">'+
            '<div class="aq-tech-avatar" style="background:#6c757d;">'+((t.name||'?')[0].toUpperCase())+'</div>'+
            '<div style="flex:1;min-width:0;">'+
              '<div class="aq-tech-name">'+t.name+'</div>'+
              '<div class="aq-tech-status text-danger"><i class="bi bi-x-circle me-1"></i>'+(t.reason||'Unavailable')+'</div>'+
            '</div>'+
          '</div>';
        }).join('')+'</div>';
      }
      container.innerHTML=html;

      // Auto-select AI recommended (if present in available list)
      if(aiTechId){
        var firstRecEl=document.querySelector('.aq-tech-option[data-tech-id="'+String(aiTechId)+'"]');
        if(firstRecEl && !firstRecEl.classList.contains('disabled')){
          AU.Queue.selectTech(String(aiTechId), firstRecEl);
          document.getElementById('assignFooterSub').textContent='AI recommended technician selected';
        }else{
          // if AI id didn't match exactly, attempt by scanning card names
          var aiNameText = (document.getElementById('aiRecommendName')||{}).textContent || '';
          if(aiNameText){
            var cardEl=[].slice.call(document.querySelectorAll('.aq-tech-option')).find(function(el){
              var nm=(el.querySelector('.aq-tech-name span')||{}).textContent||'';
              return nm && nm.toLowerCase()===aiNameText.toLowerCase();
            });
            if(cardEl){
              var tId=cardEl.getAttribute('data-tech-id');
              if(tId && !cardEl.classList.contains('disabled')){
                AU.Queue.selectTech(String(tId), cardEl);
                document.getElementById('assignFooterSub').textContent='AI recommended technician selected';
              }
            }
          }
        }
      }

      // Leaflet map
      ensureAssignLeaflet().then(function(){
        if(!mapEl) return;

        var bookingLoc=parseCoords(data.bookingLocation||data.location||data.serviceLocation||data.service_location||data.coordinates||data.coords);
        if(!bookingLoc && data.bookingLat!=null && data.bookingLng!=null){
          bookingLoc={lat:Number(data.bookingLat),lng:Number(data.bookingLng)};
        }
        if(!bookingLoc && avail && avail[0] && (avail[0].bookingLat!=null && avail[0].bookingLng!=null)){
          bookingLoc={lat:Number(avail[0].bookingLat),lng:Number(avail[0].bookingLng)};
        }
        if(!bookingLoc){
          bookingLoc=parseCoords(data.serviceCoordinates||data.service_coordinates);
        }

        // Collect markers (booking + up to 8 techs)
        var techsToPlot=avail.slice(0,8);
        var markers=[];
        techsToPlot.forEach(function(t){
          var loc=parseCoords(t.location||t.coords||t.coordinates||t.geo||t.position);
          if(loc) markers.push({tech:t,loc:loc});
        });

        if(markers.length){
          document.getElementById('assignLocationSub').textContent='Location preview';

          // create map (destroy if already exists)
          if(window.__assignMap){
            try{ window.__assignMap.remove(); }catch(e){}
            window.__assignMap=null;
          }
          window.__assignMap=L.map(mapEl,{zoomControl:true,attributionControl:false});

          var bounds=[];
          if(bookingLoc) bounds.push([bookingLoc.lat,bookingLoc.lng]);
          markers.forEach(function(m){ bounds.push([m.loc.lat,m.loc.lng]); });

          if(bounds.length){
            window.__assignMap.setView(bounds[0], bookingLoc ? 12 : 13);
          }else{
            window.__assignMap.setView([14.5995,120.9842], 12);
          }

          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; <a href="https://openstreetmap.org/copyright">OSM</a>'}).addTo(window.__assignMap);

          if(bookingLoc){
            var bookingIcon=L.divIcon({className:'',html:'<div style="position:relative;"><div style="width:38px;height:38px;background:#2563eb;border-radius:50%;border:3px solid #fff;box-shadow:0 3px 14px rgba(37,99,235,0.5);display:flex;align-items:center;justify-content:center;"><i class="bi bi-geo-alt-fill" style="color:#fff;font-size:17px;"></i></div><div style="position:absolute;top:-22px;left:50%;transform:translateX(-50%);background:#2563eb;color:#fff;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;white-space:nowrap;box-shadow:0 1px 4px rgba(0,0,0,0.2);">Customer</div></div>',iconSize:[38,38],iconAnchor:[19,19]});
            L.marker([bookingLoc.lat,bookingLoc.lng],{icon:bookingIcon}).addTo(window.__assignMap).bindPopup('<b>Booking Location</b><br>Customer scheduled location');
          }

          // Find nearest tech for highlight
          var techsWithDist = markers.filter(function(m){ return m.tech && m.tech.distanceKm != null && m.tech.availabilityStatus === 'Available'; });
          var nearestTech = techsWithDist.length > 0 ? techsWithDist.reduce(function(a,b){ return a.tech.distanceKm <= b.tech.distanceKm ? a : b; }) : null;

          markers.forEach(function(m){
            var isRec=(aiTechId&&m.tech && m.tech._id && String(m.tech._id)===String(aiTechId));
            var isNearest=nearestTech && m.tech && nearestTech.tech && m.tech._id === nearestTech.tech._id;
            var iconColor=isRec?'#4f46e5':isNearest?'#22c55e':'#16a34a';
            var size=isNearest?36:32;
            var border=isNearest?'3px solid #fbbf24':'3px solid #fff';
            var labelHtml=isNearest?'<div style="position:absolute;top:-18px;left:50%;transform:translateX(-50%);background:#f59e0b;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:8px;white-space:nowrap;">Nearest</div>':'';
            var iconHtml='<div style="position:relative;"><div style="width:'+size+'px;height:'+size+'px;background:'+iconColor+';border-radius:50%;border:'+border+';box-shadow:0 3px 12px rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:center;"><i class="bi bi-person-fill" style="color:#fff;font-size:'+(isNearest?16:14)+'px;"></i></div>'+labelHtml+'</div>';
            var ti=L.divIcon({className:'',html:iconHtml,iconSize:[size,size],iconAnchor:[size/2,size/2]});
            var popupContent='<b>'+m.tech.name+'</b>'+(isNearest?' <span style="color:#f59e0b;">★ Nearest</span>':'')+'<br/><span style="font-size:0.8rem;color:#666;">'+(m.tech.availabilityStatus||'')+'</span>'+(m.tech.distanceKm!=null?'<br/>'+m.tech.distanceKm+' km away':'')+(m.tech.etaMin!=null?'<br/>ETA ~'+m.tech.etaMin+' min':'');
            L.marker([m.loc.lat,m.loc.lng],{icon:ti}).addTo(window.__assignMap).bindPopup(popupContent);
          });

          if(bounds.length>1){
            window.__assignMap.fitBounds(L.latLngBounds(bounds).pad(0.15));
          }

          // Bootstrap modal/show class handling can differ depending on DOM + timing.
          // Always invalidate after render so Leaflet computes correct size.
          setTimeout(function(){
            try{
              if(window.__assignMap && mapEl){
                window.__assignMap.invalidateSize();
              }
            }catch(e){}
          }, 200);

          // extra invalidate to cover first-tick sizing issues
          setTimeout(function(){
            try{
              if(window.__assignMap && mapEl){
                window.__assignMap.invalidateSize();
              }
            }catch(e){}
          }, 600);
        }else{
          document.getElementById('assignLocationSub').textContent='Map not available';
        }
      }).catch(function(){
        document.getElementById('assignLocationSub').textContent='Map unavailable';
      });

      // If no AI auto-selected, disable confirm unless user picks
      // (selectTech enables it)
      if(!aiTechId) {
        _qSelectedTechId=null;
        document.getElementById('btnConfirmAssign').disabled=true;
      }
    }).catch(function(){
      container.innerHTML='<div class="alert alert-danger small">Failed to load technicians</div>';
      document.getElementById('assignLocationSub').textContent='Map not available';
    });
  };

  AU.Queue.selectTech=function(techId,el){
