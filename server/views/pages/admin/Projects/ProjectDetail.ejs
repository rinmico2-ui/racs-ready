  function liveDotClass(s) {
    if (s === 'in_progress') return 'working';
    if (s === 'en_route') return 'en_route';
    if (s === 'arrived') return 'arrived';
    if (s === 'completed') return 'completed';
    return 'delayed';
  }
  function liveLabel(s) {
    return ({ accepted: 'Accepted', en_route: 'En Route', arrived: 'Arrived', in_progress: 'Working', completed: 'Completed', pending: 'Waiting', assigned: 'Assigned' })[s] || s;
  }

  function renderLiveStatus(workOrders = []) {
    const container = qs('#liveStatusContainer');
    if (!container) return;
    const active = workOrders.filter(wo => ['accepted','en_route','arrived','in_progress'].includes(wo.status));
    qs('#liveCount') && (qs('#liveCount').textContent = `${active.length} active`);
    if (active.length === 0) {
      container.innerHTML = '<div class="text-center py-3 text-muted" style="font-size:0.82rem;">No active work orders.</div>';
      return;
    }
    container.innerHTML = active.map(wo => {
      const tech = (wo.assignedTechnicians && wo.assignedTechnicians[0]) || {};
      return `<div class="live-row">
        <span class="live-dot ${liveDotClass(wo.status)}"></span>
        <div style="flex:1;">
          <div style="font-size:0.82rem;font-weight:600;">${tech.name || 'Unassigned'}</div>
          <div class="wo-mini">${wo.title || wo.section || 'Work Order'} · ${liveLabel(wo.status)}</div>
        </div>
        <span class="wo-mini">${wo.completedUnitCount || 0}/${wo.unitCount}u</span>
      </div>`;
    }).join('');
    // socket-driven realtime updates
    if (window.__liveSocketBound) return;
    window.__liveSocketBound = true;
    const io = window.io;
    if (!io) return;
    const socket = io();
    socket.on('project:wo-status', (d) => {
      if (d.projectId === projectId) loadProject();
    });
    socket.on('project:issue', (d) => { if (d.projectId === projectId) loadProject(); });
    socket.on('expense:submitted', (d) => { if (d.projectId === projectId) loadProject(); });
    // ── Real-time team acceptance updates ───────────────────────────────────
    // When a technician accepts or declines a project assignment, the backend
    // emits this event so the admin page refreshes immediately.
    socket.on('project:team-status', (d) => {
      if (d.projectId === projectId) {
        if (d.action === 'accepted') {
          toast(`${d.techName} accepted the project assignment`, 'success');
        } else if (d.action === 'declined') {
          toast(`${d.techName} declined the project assignment`, 'error');
        }
        loadProject();
      }
    });
    socket.on('assignment:accepted', (d) => {
      loadProject();
    });
    socket.on('assignment:declined', (d) => {
      loadProject();
    });
  }

