      <!-- TAB: WAITING FOR ACCEPTANCE -->
      <div id="tab-waiting-accept" class="tab-pane d-none">
        <div class="panel-card">
          <div class="workflow-overview-section-head">
            <h6><i class="bi bi-hourglass-split me-2 text-warning"></i>Waiting for Technician Acceptance</h6>
            <small class="text-muted" id="waitingAcceptCount">0 bookings</small>
