                <div id="airconTypesContainer">
                  <div class="text-center text-muted small py-4" id="noAirconTypesMsg">
                    <i class="bi bi-layers fs-4 d-block mb-2 text-primary"></i>
                    No aircon types configured. Click "Add Type" to start defining HP prices.
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer bg-light border-top-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg me-2"></i>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-lg me-2"></i>Save Service</button>
      </div>
    </form>
  </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="saveSuccessModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
    <div class="modal-content border-0 shadow" style="border-radius: 18px; overflow: hidden;">
      <div class="modal-header border-0" style="background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 50%, #2563eb 100%); color: #fff;">
        <h6 class="modal-title d-flex align-items-center gap-2 m-0"><i class="bi bi-check-circle-fill"></i> Saved Successfully</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="location.reload();"></button>
      </div>
      <div class="modal-body text-center py-4 px-4">
        <div class="d-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; border-radius: 50%; background: rgba(37,99,235,0.12); color: #2563eb; font-size: 1.8rem; margin: 0 auto;">
          <i class="bi bi-check-lg"></i>
        </div>
        <h5 class="mb-1" style="font-weight: 600; color: #0f172a;">Service saved!</h5>
        <p class="text-muted mb-0" style="font-size: 0.85rem;">The core service has been saved to the catalog.</p>
      </div>
      <div class="modal-footer border-0 justify-content-center pb-4 pt-0">
        <button type="button" class="btn btn-primary px-4" onclick="location.reload();" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const modalEl = document.getElementById('coreServiceModal');
    const css = document.createElement('style');
    css.textContent = ".modal { z-index: 2050 !important; } .modal-backdrop { z-index: 2040 !important; }";
    document.head.appendChild(css);

    // re-use the previously obtained modalEl (already declared above)
    if (!modalEl) return;
    if (!window.bootstrap || !bootstrap.Modal) {
      console.error('Bootstrap JS not available');
    }
    const modal = bootstrap && bootstrap.Modal ? new bootstrap.Modal(modalEl) : null;
    const form = document.getElementById('coreServiceForm');
    let editingId = null;
    let currentAirconTypes = [];

    const isAirconToggle = document.getElementById('isAirconServiceCheckCore');
    const airconSection = document.getElementById('airconConfigSection');
    const airconContainer = document.getElementById('airconTypesContainer');
    const msgEmpty = document.getElementById('noAirconTypesMsg');
    
    isAirconToggle.addEventListener('change', () => {
      if (isAirconToggle.checked) {
        airconSection.classList.remove('d-none');
      } else {
        airconSection.classList.add('d-none');
      }
    });

    document.getElementById('btnAddAirconType').addEventListener('click', () => {
      currentAirconTypes.push({
        type: 'split',
        name: 'Split Type',
        description: '',
        hpPricing: []
      });
      renderMatrix();
    });

    function renderMatrix() {
      if(currentAirconTypes.length === 0) {
        msgEmpty.style.display = 'block';
        Array.from(airconContainer.querySelectorAll('.aircon-type-card')).forEach(e => e.remove());
        return;
      }
      msgEmpty.style.display = 'none';
      Array.from(airconContainer.querySelectorAll('.aircon-type-card')).forEach(e => e.remove());

      currentAirconTypes.forEach((ac, i) => {
        const card = document.createElement('div');
        card.className = 'aircon-type-card card border-0 shadow-sm';
        
        const typeLabels = { split:'Split Type', window:'Window Type', floor_mounted:'Floor Mounted', split_suspended:'Split Suspended', cassette:'Cassette', central:'Central' };
        const defaultName = typeLabels[ac.type] || '';
        const displayName = (ac.name && ac.name !== defaultName) ? ac.name : '';

        let hpRows = '';
        hpRows += `
          <div class="table-responsive">
            <table class="table table-hover table-sm table-dense align-middle mb-0 core-hp-table">
              <thead class="bg-light">
                <tr>
                  <th style="width: 110px;"><i class="bi bi-speedometer2 me-1"></i>Capacity</th>
                  <th style="width: 160px;"><i class="bi bi-cash-coin me-1"></i>Price</th>
                  <th style="width: 120px;"><i class="bi bi-stopwatch me-1"></i>Duration</th>
                  <th><i class="bi bi-chat-text me-1"></i>Notes</th>
                  <th class="text-center" style="width: 60px;">Action</th>
                </tr>
              </thead>
              <tbody>`;
        ac.hpPricing.forEach((hpObj, j) => {
          hpRows += `
                <tr>
                  <td><input type="number" step="0.1" class="form-control form-control-sm" placeholder="1.0" value="${hpObj.hp||''}" oninput="updateHP(${i}, ${j}, 'hp', this.value)"></td>
                  <td><div class="input-group input-group-sm"><span class="input-group-text">₱</span><input type="number" step="0.01" class="form-control form-control-sm" placeholder="0.00" value="${hpObj.price||''}" oninput="updateHP(${i}, ${j}, 'price', this.value)"></div></td>
                  <td><div class="input-group input-group-sm"><input type="number" class="form-control form-control-sm" placeholder="Min" value="${hpObj.durationMinutes||''}" oninput="updateHP(${i}, ${j}, 'durationMinutes', this.value)"><span class="input-group-text">m</span></div></td>
                  <td><input type="text" class="form-control form-control-sm" placeholder="Optional notes" value="${hpObj.description||''}" oninput="updateHP(${i}, ${j}, 'description', this.value)"></td>
                  <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeHP(${i}, ${j})" aria-label="Remove HP tier"><i class="bi bi-trash3"></i></button></td>
                </tr>`;
        });
        hpRows += `
              </tbody>
            </table>
          </div>`;

        card.innerHTML = `
          <div class="card-header d-flex gap-2 align-items-end border-bottom-0 p-3">
            <div class="flex-grow-1">
              <label class="form-label modal-label mb-1">Type</label>
              <select class="form-select core-type-select" onchange="updateAC(${i}, 'type', this.value)">
                <option value="split" ${ac.type==='split'?'selected':''}>Split Type</option>
                <option value="window" ${ac.type==='window'?'selected':''}>Window Type</option>
                <option value="floor_mounted" ${ac.type==='floor_mounted'?'selected':''}>Floor Mounted</option>
                <option value="split_suspended" ${ac.type==='split_suspended'?'selected':''}>Split Suspended</option>
                <option value="cassette" ${ac.type==='cassette'?'selected':''}>Cassette</option>
                <option value="central" ${ac.type==='central'?'selected':''}>Central</option>
              </select>
            </div>
            <button type="button" class="core-type-remove" onclick="removeAC(${i})" aria-label="Remove aircon type"><i class="bi bi-trash3"></i></button>
          </div>
          <div class="card-body p-3">
            <div class="mb-2">
              <label class="form-label modal-label mb-1">Display Name</label>
              <input type="text" class="form-control" placeholder="Display name" value="${displayName}" oninput="updateAC(${i}, 'name', this.value)">
            </div>
            <div class="mb-3">
              <label class="form-label modal-label mb-1"><i class="bi bi-file-earmark-text me-1"></i>Type Description</label>
              <input type="text" class="form-control" placeholder="Short description of this type..." value="${ac.description||''}" oninput="updateAC(${i}, 'description', this.value)">
            </div>
            <div class="card border-0 shadow-sm">
              <div class="card-header bg-white d-flex justify-content-between align-items-center border-bottom-0 p-3">
                <h6 class="mb-0 d-flex align-items-center gap-2"><i class="bi bi-layers text-info"></i>HP Pricing Tiers (${ac.hpPricing.length})</h6>
                <button type="button" class="btn btn-sm btn-primary fw-bold" onclick="addHP(${i})"><i class="bi bi-plus me-1"></i>Add HP Tier</button>
              </div>
              <div class="card-body p-0 pt-2">
                ${hpRows}
              </div>
            </div>
          </div>
        `;
        airconContainer.appendChild(card);
      });
    }

    window.updateAC = (i, field, val) => { currentAirconTypes[i][field] = val; if (field === 'type') renderMatrix(); };
    window.removeAC = (i) => { currentAirconTypes.splice(i, 1); renderMatrix(); };
    window.addHP = (i) => { currentAirconTypes[i].hpPricing.push({hp: '', price: '', durationMinutes: '', description: ''}); renderMatrix(); };
    window.updateHP = (i, j, field, val) => { currentAirconTypes[i].hpPricing[j][field] = val; };
    window.removeHP = (i, j) => { currentAirconTypes[i].hpPricing.splice(j, 1); renderMatrix(); };

    function openForm(data) {
      if (data) {
        editingId = data._id;
        modalEl.querySelector('.modal-title').innerText = 'Edit Core Service';
        form.name.value = data.name || '';
        form.slug.value = data.slug || '';
        form.category.value = data.category || '';
        form.description.value = data.description || '';
        form.features.value = (data.features || []).join(', ');
        form.includedItems.value = (data.includedItems || []).join(', ');
        form.exclusions.value = (data.exclusions || []).join(', ');
        form.isAirconService.checked = !!data.isAirconService;
        form.active.checked = !!data.active;
        currentAirconTypes = JSON.parse(JSON.stringify(data.airconTypes || []));
      } else {
        editingId = null;
        modalEl.querySelector('.modal-title').innerText = 'New Core Service';
        form.reset();
        form.active.checked = true;
        currentAirconTypes = [];
      }
      isAirconToggle.dispatchEvent(new Event('change'));
      renderMatrix();
      modal.show();
    }

    document.querySelector('.new-core-service').addEventListener('click', function() {
      openForm();
    });

    document.body.addEventListener('click', function(e) {
      if (e.target.closest('.edit-core-service')) {
        const tr = e.target.closest('tr');
        if (!tr) return;
        const svc = JSON.parse(decodeURIComponent(tr.dataset.svc || '{}'));
        openForm(svc);
      }
    });

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const cleanAirconTypes = currentAirconTypes.map(ac => ({
        type: ac.type,
        name: ac.name,
        description: ac.description,
        hpPricing: ac.hpPricing.filter(hp => hp.hp !== '' && hp.price !== '').map(hp => ({
          hp: parseFloat(hp.hp),
          price: parseFloat(hp.price),
          durationMinutes: hp.durationMinutes ? parseInt(hp.durationMinutes) : undefined,
          description: hp.description
        }))
      }));

      const payload = {
        name: form.name.value.trim(),
        slug: form.slug.value.trim(),
        category: form.category.value.trim(),
        description: form.description.value.trim(),
        features: form.features.value.split(',').map(s => s.trim()).filter(Boolean),
        includedItems: form.includedItems.value.split(',').map(s => s.trim()).filter(Boolean),
        exclusions: form.exclusions.value.split(',').map(s => s.trim()).filter(Boolean),
        isAirconService: form.isAirconService.checked,
        airconTypes: cleanAirconTypes,
        active: form.active.checked,
      };
      let url = '/api/admin/core-services';
      let method = 'POST';
      if (editingId) {
        url += '/' + editingId;
        method = 'PATCH';
      }
      try {
        const r = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (r.ok) {
          const mainModal = bootstrap.Modal.getInstance(modalEl);
          if (mainModal) mainModal.hide();
          const saveSuccessModal = new bootstrap.Modal(document.getElementById('saveSuccessModal'));
          saveSuccessModal.show();
        } else {
          const j = await r.json();
          alert(j.error || 'Save failed');
        }
      } catch (err) {
        alert('Save failed');
      }
    });
  })();
</script>

<div id="coreSparkData" class="d-none" data-total="<%= totalCount %>" data-active="<%= activeCount %>" data-review="<%= reviewCount %>" data-avg="<%= Math.round(avgTime) %>"></div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  (function() {
    const qs = (s) => document.querySelector(s);

    function spark(ctx, data, color) {
      if (!ctx || !window.Chart) return null;
      const h = ctx.canvas.height || ctx.canvas.offsetHeight || 30;
      const g = ctx.createLinearGradient(0, 0, 0, h);
      g.addColorStop(0, color);
      g.addColorStop(1, 'rgba(255,255,255,0)');
      return new Chart(ctx, {
        type: 'line',
        data: {
          labels: data.map((_, i) => i + 1),
          datasets: [{
            data: data, borderColor: color, backgroundColor: g,
            fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2,
          }],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          animation: { duration: 600 },
          plugins: { legend: { display: false }, tooltip: { enabled: false } },
          scales: { x: { display: false }, y: { display: false } },
        },
      });
    }

    function makeSparkData(count) {
      const c = Math.max(0, count || 0);
      if (c === 0) return [0,0,0,0,0,0,0];
      return [Math.max(0, c-3), Math.max(0, c-2), Math.max(0, c-1), c-1, c, c, Math.max(0, c-1)];
    }

    const sparkDataEl = document.getElementById('coreSparkData');
    const sd = sparkDataEl ? sparkDataEl.dataset : {};
    spark(qs('#sparkCoreTotal')?.getContext('2d'), makeSparkData(Number(sd.total || 0)), '#2563eb');
    spark(qs('#sparkCoreActive')?.getContext('2d'), makeSparkData(Number(sd.active || 0)), '#10b981');
    spark(qs('#sparkCoreReview')?.getContext('2d'), makeSparkData(Number(sd.review || 0)), '#f59e0b');
    spark(qs('#sparkCoreAvg')?.getContext('2d'), makeSparkData(Number(sd.avg || 0)), '#8b5cf6');
  })();
</script>

<script>
  (function() {
    const tbody = document.getElementById('coreTableBody');
    const rows = tbody ? Array.from(tbody.querySelectorAll('tr')).filter(tr => tr.dataset.svc) : [];
    const info = document.getElementById('corePaginationInfo');
    const nav = document.getElementById('corePagination');
    const perPage = 10;
    let currentPage = 1;

    function renderPagination(total, pages) {
      if (!info || !nav) return;
      if (total === 0) { info.textContent = 'Showing 0 of 0'; nav.innerHTML = ''; return; }
      const start = (currentPage - 1) * perPage + 1;
      const end = Math.min(currentPage * perPage, total);
      info.textContent = `Showing ${start}-${end} of ${total} services`;
      if (pages <= 1) { nav.innerHTML = ''; return; }
      let h = '<li class="page-item' + (currentPage === 1 ? ' disabled' : '') + '"><a class="page-link" href="#" onclick="goToCorePage(' + (currentPage - 1) + '); return false;">&laquo;</a></li>';
      for (let i = 1; i <= pages; i++) {
        h += '<li class="page-item' + (i === currentPage ? ' active' : '') + '"><a class="page-link" href="#" onclick="goToCorePage(' + i + '); return false;">' + i + '</a></li>';
      }
      h += '<li class="page-item' + (currentPage === pages ? ' disabled' : '') + '"><a class="page-link" href="#" onclick="goToCorePage(' + (currentPage + 1) + '); return false;">&raquo;</a></li>';
      nav.innerHTML = h;
    }

    function goToCorePage(page) {
      const pages = Math.max(1, Math.ceil(rows.length / perPage));
      currentPage = Math.max(1, Math.min(page, pages));
      render();
    }
    window.goToCorePage = goToCorePage;

    function render() {
      const pages = Math.ceil(rows.length / perPage) || 1;
      rows.forEach((row, idx) => {
        const start = (currentPage - 1) * perPage;
        row.style.display = (idx >= start && idx < start + perPage) ? '' : 'none';
      });
      renderPagination(rows.length, pages);
    }

    render();
  })();
</script>
