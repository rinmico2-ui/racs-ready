    parts_reserved: 'Parts Reserved',
    ready_for_repair: 'Ready for Repair',
    repair_scheduled: 'Repair Scheduled',
    repair_in_progress: 'Repair In Progress',
    repair_completed: 'Repair Completed',
    closed: 'Closed',
  };

  const RQ_STATUS_BADGES = {
    repair_requested: 'bg-warning text-dark',
    pending_inspection: 'bg-warning text-dark',
    inspection_scheduled: 'bg-info text-dark',
    inspection_in_progress: 'bg-primary',
    inspection_completed: 'bg-success',
    awaiting_approval: 'bg-danger',
    repair_approved: 'bg-success',
    repair_declined: 'bg-danger',
    waiting_parts: 'bg-warning text-dark',
    ready_for_repair: 'bg-success',
    repair_scheduled: 'bg-primary',
    repair_in_progress: 'bg-primary',
    repair_completed: 'bg-success',
    closed: 'bg-secondary',
  };

  async function loadRepairRequests() {
    const container = document.getElementById('repairQueueContainer');
    if (!container) return;
    try {
      container.innerHTML = '<div class="text-center py-5 text-muted"><div class="spinner-border text-primary"></div><p class="mt-2">Loading repair requests...</p></div>';

      const res = await fetch('/api/admin/repair-queue?limit=200');
      if (!res.ok) throw new Error();
      const data = await res.json();
      allRepairs = data.items || [];
      renderRepairRequests();
    } catch(e) {
      container.innerHTML = '<div class="alert alert-danger">Failed to load repair requests</div>';
    }
  }

  function renderRepairRequests() {
    const container = document.getElementById('repairQueueContainer');
    if (!container) return;
    const filterEl = document.getElementById('rqFilterStatus');
    const searchEl = document.getElementById('rqSearchInput');
    const filter = filterEl ? filterEl.value : 'all';
    const search = searchEl ? (searchEl.value || '').toLowerCase() : '';

    let filtered = allRepairs;
    if (filter !== 'all') {
      if (filter === 'pending') {
        filtered = filtered.filter(b => ['repair_requested', 'pending_inspection'].includes(b.status));
      } else {
        filtered = filtered.filter(b => b.status === filter);
      }
    }
    if (search) {
      filtered = filtered.filter(b => {
        const name = (b.customer?.name || '').toLowerCase();
        const ref = (b.bookingReference || '').toLowerCase();
        const issue = (b.issueDescription || b.unitInfo?.problemDescription || '').toLowerCase();
        return name.includes(search) || ref.includes(search) || issue.includes(search);
      });
    }

    if (!filtered.length) {
      container.innerHTML = '<div class="aq-empty"><i class="bi bi-inbox"></i><p>No repair requests found</p></div>';
      return;
    }

    container.innerHTML = filtered.map(b => {
      const isRepairReq = b.status === 'repair_requested';
      const badge = RQ_STATUS_BADGES[b.status] || 'bg-secondary';
      const label = RQ_STATUS_LABELS[b.status] || b.status;
      const date = b.preferredDate || b.bookingDate;
      const dateStr = date ? formatDate(date) : '—';
      const issue = (b.issueDescription || b.unitInfo?.problemDescription || 'No description').substring(0, 60);
      const unit = [b.unitInfo?.brand, b.unitInfo?.model].filter(Boolean).join(' ') || '';

      return `
      <div class="aq-booking-card">
        <div class="aq-booking-header">
          <div>
            <div class="aq-booking-id">#${b._id.toString().slice(-8).toUpperCase()}</div>
            <div class="aq-booking-customer">${b.customer?.name || 'Customer'}</div>
            <div class="aq-booking-service">${unit ? unit + ' — ' : ''}${issue}${issue.length >= 60 ? '...' : ''}</div>
          </div>
          <div class="text-end d-flex flex-column align-items-end gap-1">
            <span class="badge ${badge}">${label}</span>
          </div>
        </div>
        <div class="aq-detail-grid">
          <div class="aq-detail-item"><i class="bi bi-calendar"></i> ${dateStr}</div>
          <div class="aq-detail-item"><i class="bi bi-geo-alt"></i> ${(b.location?.address || 'No address').substring(0, 30)}</div>
          <div class="aq-detail-item"><i class="bi bi-telephone"></i> ${b.customer?.phone || '—'}</div>
          ${b.priority ? `<div class="aq-detail-item"><i class="bi bi-flag"></i> ${b.priority.toUpperCase()}</div>` : ''}
        </div>
        ${isRepairReq ? `
        <div class="aq-action-bar">
          <button class="btn btn-sm btn-outline-secondary" onclick="viewRepairDetail('${b._id}')"><i class="bi bi-eye me-1"></i>View</button>
          <button class="btn btn-sm btn-outline-danger" onclick="openRejectRepair('${b._id}')"><i class="bi bi-x-lg me-1"></i>Reject</button>
          <button class="btn btn-sm btn-success" onclick="approveRepairRequest('${b._id}')"><i class="bi bi-check-lg me-1"></i>Approve & Queue</button>
        </div>
        ` : `
        <div class="aq-action-bar">
          <button class="btn btn-sm btn-outline-secondary" onclick="viewRepairDetail('${b._id}')"><i class="bi bi-eye me-1"></i>View</button>
        </div>
        `}
      </div>`;
    }).join('');
  }

  async function approveRepairRequest(id) {
    if (!confirm('Approve this repair request? It will be moved to the Assignment Queue for technician assignment.')) return;
    try {
      const res = await fetch(`/api/admin/repair-queue/${id}/confirm`, { method: 'POST' });
      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error || 'Failed to approve');
      }
      showNotification({ type: 'success', title: 'Repair Approved', message: 'Repair request has been approved and moved to the assignment queue.', duration: 4000 });
      loadRepairRequests();
      loadStats();
      loadQueue(currentPage);
    } catch(e) {
      showNotification({ type: 'error', title: 'Approval Failed', message: e.message || 'Failed to approve repair request.', duration: 5000 });
    }
  }

  window.openRejectRepair = function(id) {
    document.getElementById('rejectRepairBookingId').value = id;
    document.getElementById('rejectRepairReason').value = '';
    document.getElementById('rejectRepairNote').value = '';
    new bootstrap.Modal(document.getElementById('rejectRepairModal')).show();
  };

  window.confirmRejectRepair = async function() {
    const id = document.getElementById('rejectRepairBookingId').value;
    const reason = document.getElementById('rejectRepairReason').value;
    const note = document.getElementById('rejectRepairNote').value;
    if (!reason) {
      showNotification({ type: 'warning', title: 'Required', message: 'Please select a rejection reason.', duration: 3000 });
      return;
    }
    try {
      const res = await fetch(`/api/admin/repair-queue/${id}/reject`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: note || reason }),
      });
      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error || 'Failed to reject');
      }
      bootstrap.Modal.getInstance(document.getElementById('rejectRepairModal')).hide();
      showNotification({ type: 'success', title: 'Repair Rejected', message: 'The repair request has been rejected.', duration: 4000 });
      loadRepairRequests();
      loadStats();
    } catch(e) {
      showNotification({ type: 'error', title: 'Rejection Failed', message: e.message || 'Failed to reject repair request.', duration: 5000 });
    }
  };

  window.viewRepairDetail = async function(id) {
    const body = document.getElementById('detailModalBody');
    const subtitle = document.getElementById('detailModalSubtitle');
    body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Loading details...</p></div>';
    subtitle.textContent = 'Loading...';
    new bootstrap.Modal(document.getElementById('bookingDetailModal')).show();

    try {
      const res = await fetch(`/api/admin/repair-queue/${id}`);
      if (!res.ok) throw new Error('Failed to fetch');
      const b = await res.json();
      const refText = b.bookingReference || b.workOrderNumber || `#${b._id.toString().slice(-8).toUpperCase()}`;
      subtitle.textContent = refText;

      const statusLabel = RQ_STATUS_LABELS[b.status] || b.status;
      const statusBadge = RQ_STATUS_BADGES[b.status] || 'bg-secondary';
      const issue = b.issueDescription || b.unitInfo?.problemDescription || 'No description';
      const unit = [b.unitInfo?.unitType, b.unitInfo?.brand, b.unitInfo?.model].filter(Boolean).join(' ') || '—';
      const addr = (typeof b.location?.address === 'string' ? b.location.address : '') || '—';

      body.innerHTML = `
        <div class="pm-status-bar">
          <span class="badge ${statusBadge}" style="font-size:.85rem;padding:6px 14px;">${statusLabel}</span>
          ${b.priority ? `<span class="badge ${b.priority === 'high' || b.priority === 'critical' ? 'bg-danger' : 'bg-info'}">${b.priority.toUpperCase()}</span>` : ''}
          ${b.bookingReference ? `<span class="badge bg-light text-dark border">${b.bookingReference}</span>` : ''}
        </div>
        <div class="pm-grid">
          <div class="pm-card">
            <div class="pm-card-head"><div class="pm-icon" style="background:#dbeafe;color:#2563eb;"><i class="bi bi-person"></i></div><h3 class="pm-card-title">Customer</h3></div>
            <div class="pm-card-body">
              <div class="pm-row"><span class="pm-lbl">Name</span><span class="pm-val">${b.customer?.name || 'N/A'}</span></div>
              <div class="pm-row"><span class="pm-lbl">Phone</span><span class="pm-val">${b.customer?.phone || '—'}</span></div>
              <div class="pm-row"><span class="pm-lbl">Email</span><span class="pm-val">${b.customer?.email || '—'}</span></div>
            </div>
          </div>
          <div class="pm-card">
            <div class="pm-card-head"><div class="pm-icon" style="background:#fef3c7;color:#d97706;"><i class="bi bi-wrench"></i></div><h3 class="pm-card-title">Unit & Issue</h3></div>
            <div class="pm-card-body">
              <div class="pm-row"><span class="pm-lbl">Unit</span><span class="pm-val">${unit}</span></div>
              <div class="pm-row"><span class="pm-lbl">Issue</span><span class="pm-val" style="font-weight:400;">${issue}</span></div>
            </div>
          </div>
          <div class="pm-card">
            <div class="pm-card-head"><div class="pm-icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-calendar-event"></i></div><h3 class="pm-card-title">Schedule</h3></div>
            <div class="pm-card-body">
              <div class="pm-row"><span class="pm-lbl">Preferred Date</span><span class="pm-val">${b.preferredDate ? formatDate(b.preferredDate) : '—'}</span></div>
              <div class="pm-row"><span class="pm-lbl">Preferred Time</span><span class="pm-val">${b.preferredTime || b.selectedTimeLabel || '—'}</span></div>
            </div>
          </div>
          <div class="pm-card">
            <div class="pm-card-head"><div class="pm-icon" style="background:#e2e8f0;color:#475569;"><i class="bi bi-geo-alt"></i></div><h3 class="pm-card-title">Location</h3></div>
            <div class="pm-card-body">
              <div class="pm-row"><span class="pm-lbl">Address</span><span class="pm-val" style="font-weight:400;">${addr}</span></div>
              ${b.distanceKm != null ? `<div class="pm-row"><span class="pm-lbl">Distance</span><span class="pm-val">${Number(b.distanceKm).toFixed(2)} km</span></div>` : ''}
            </div>
          </div>
        </div>
        ${b.unitInfo?.photos && b.unitInfo.photos.length > 0 ? `
        <div style="margin-top:16px;">
          <div class="pm-section-hdr"><i class="bi bi-images" style="color:#0891b2;"></i><span class="pm-section-title">Unit Photos</span></div>
          <div class="pm-photo-grid">
            ${b.unitInfo.photos.map((src, i) => `<div class="pm-photo-item"><img src="${src}" alt="Photo ${i+1}" onclick="window.open('${src}','_blank')" onerror="this.closest('.pm-photo-item').innerHTML='<div style=\\'padding:16px;text-align:center;color:#94a3b8;font-size:.8rem;\\'>Unavailable</div>'"><div style="margin-top:4px;text-align:center;font-size:.68rem;color:#94a3b8;">Photo ${i+1}</div></div>`).join('')}
          </div>
        </div>` : ''}
        <div class="pm-footer">
          ${b.status === 'repair_requested' ? `
            <button class="btn btn-outline-danger btn-sm" onclick="bootstrap.Modal.getInstance(document.getElementById('bookingDetailModal')).hide();setTimeout(()=>openRejectRepair('${b._id}'),300);"><i class="bi bi-x-lg me-1"></i>Reject</button>
            <button class="btn btn-success btn-sm fw-semibold" onclick="bootstrap.Modal.getInstance(document.getElementById('bookingDetailModal')).hide();setTimeout(()=>approveRepairRequest('${b._id}'),300);"><i class="bi bi-check-lg me-1"></i>Approve & Queue</button>
          ` : ''}
          <button class="btn btn-light btn-sm" data-bs-dismiss="modal">Close</button>
        </div>
      `;
    } catch(e) {
      body.innerHTML = '<div class="alert alert-danger">Failed to load details</div>';
    }
  };

  // Repair request tab event listeners
  document.getElementById('repair-tab')?.addEventListener('shown.bs.tab', () => {
    loadRepairRequests();
  });
  document.getElementById('rqFilterStatus')?.addEventListener('change', () => renderRepairRequests());
  let rqSearchTimeout;
  document.getElementById('rqSearchInput')?.addEventListener('input', () => {
    clearTimeout(rqSearchTimeout);
    rqSearchTimeout = setTimeout(() => renderRepairRequests(), 300);
  });
})();
</script>
