      const recorded = p.payment || {};
      const pay = {
        totalAmount: recorded.totalAmount != null ? recorded.totalAmount : ((b.totalAmount != null ? b.totalAmount : (b.amountPaid || 0) + (b.balanceAmount || 0))),
        amountPaid: recorded.amountPaid != null ? recorded.amountPaid : (b.amountPaid || 0),
        balanceAmount: recorded.balanceAmount != null ? recorded.balanceAmount : (b.balanceAmount || 0),
        paymentMethod: recorded.paymentMethod || b.paymentMethod || '',
        paymentStatus: recorded.paymentStatus || b.paymentStatus || 'unpaid',
        proofUrl: recorded.proofUrl || b.paymentProof || '',
        proofNote: recorded.proofNote || b.paymentNotes || '',
      };
      const modal = document.createElement('div');
      modal.className = 'pd-modal-overlay';
      modal.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);z-index:9999;display:flex;align-items:center;justify-content:center;';
