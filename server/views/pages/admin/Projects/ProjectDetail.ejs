            <span class="es-tag" style="background:#fef3c7;color:#b45309;">BLOCKED</span>
          </div>`;
        }).join('');
        const rows = groups[date].map(row => {
          const order=ordersById[String(row.workOrderId)]||{};
          const color = techColor(row.technicianId);
          return `<div class="es-row">
            <span class="es-time" style="background:${color}14;color:${color};border-color:${color}40;">${to12h(row.startTime || '09:00')}–${to12h(row.endTime || '17:00')}</span>
