<!-- JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  let analyticsData = {
    totalRatings: 0,
    avgRating: 0,
    responseRate: 0,
    sentimentScore: 0,
    topRated: [],
    sentiment: {
      positive: 0,
      neutral: 0,
      negative: 0
    },
    detailedComments: []
  };

  let mainInteractiveChart = null;
  let sentimentTimelineChart = null;
  let sentimentByCategoryChart = null;
  let sentimentDistributionChart = null;
  let recentRatingsChart = null;

  // Initialize analytics
  document.addEventListener('DOMContentLoaded', function() {
    setupEventListeners();
    showChartOverlay();
    loadAnalyticsData();
  });

  // Load analytics data
  async function loadAnalyticsData() {
    try {
      const response = await fetch('/api/admin/ratings/analytics');
      if (response.ok) {
        const data = await response.json();
        analyticsData = data;
        updateMetrics();
        updateSentimentAnalysis();
        generateAIRecommendations();
        initializeAllCharts();
        loadRecentRatings();
      } else {
        console.error('Failed to load analytics data');
      }
    } catch (error) {
      console.error('Error loading analytics data:', error);
    }
  }



  // Update key metrics
  function updateMetrics() {
    document.getElementById('totalRatings').textContent = analyticsData.totalRatings || 0;
    document.getElementById('avgRating').textContent = (analyticsData.avgRating || 0).toFixed(1);
    document.getElementById('responseRate').textContent = (analyticsData.responseRate || 0) + '%';
    document.getElementById('sentimentScore').textContent = (analyticsData.sentimentScore || 0) + '%';

    // Populate top rated table
    const topRated = analyticsData.topRated || [];
    const tbody = document.getElementById('topRatedTable');
    if (tbody) {
      if (topRated.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No ratings data available</td></tr>';
      } else {
        tbody.innerHTML = topRated.map(t => {
          const trendIcon = t.trend === 'up' ? 'bi-arrow-up text-success' : t.trend === 'down' ? 'bi-arrow-down text-danger' : 'bi-dash text-muted';
          return `<tr>
            <td>${t.name}</td>
            <td><span class="badge bg-${getTypeColor(t.type)}">${t.category || t.type}</span></td>
            <td>${t.rating} <small class="text-muted">/ 5</small></td>
            <td>${t.reviews}</td>
            <td><i class="bi ${trendIcon}"></i></td>
          </tr>`;
        }).join('');
      }
    }
  }

  // Enhanced sentiment analysis
  function updateSentimentAnalysis() {
    const sentiment = analyticsData.sentiment || { positive: 0, neutral: 0, negative: 0 };
    const total = sentiment.positive + sentiment.neutral + sentiment.negative;
    
    if (total > 0) {
      // Update counts and percentages
      document.getElementById('positiveCount').textContent = sentiment.positive;
      document.getElementById('positivePercent').textContent = Math.round((sentiment.positive / total) * 100) + '%';
      document.getElementById('positiveProgress').style.width = (sentiment.positive / total * 100) + '%';
      
      document.getElementById('neutralCount').textContent = sentiment.neutral;
      document.getElementById('neutralPercent').textContent = Math.round((sentiment.neutral / total) * 100) + '%';
      document.getElementById('neutralProgress').style.width = (sentiment.neutral / total * 100) + '%';
      
      document.getElementById('negativeCount').textContent = sentiment.negative;
      document.getElementById('negativePercent').textContent = Math.round((sentiment.negative / total) * 100) + '%';
      document.getElementById('negativeProgress').style.width = (sentiment.negative / total * 100) + '%';

      // Update overall sentiment score
      const overallScore = ((sentiment.positive * 1) + (sentiment.neutral * 0.5) + (sentiment.negative * 0)) / total;
      document.getElementById('overallSentimentScore').textContent = (overallScore * 100).toFixed(1);
      
      // Update sentiment indicator
      const indicator = document.getElementById('sentimentIndicator');
      if (overallScore >= 0.7) {
        indicator.innerHTML = '<i class="bi bi-emoji-smile"></i>';
        indicator.className = 'sentiment-indicator text-success';
      } else if (overallScore >= 0.4) {
        indicator.innerHTML = '<i class="bi bi-emoji-neutral"></i>';
        indicator.className = 'sentiment-indicator text-warning';
      } else {
        indicator.innerHTML = '<i class="bi bi-emoji-frown"></i>';
        indicator.className = 'sentiment-indicator text-danger';
      }
    }

    updateSentimentCharts();
  }

  // Initialize all charts
  function initializeAllCharts() {
    initializeMainInteractiveChart();
    initializeSentimentCharts();
    initializeRecentRatingsChart();
    initializeOriginalCharts();
  }

  // Initialize recent ratings chart
  function initializeRecentRatingsChart() {
    const ctx = document.getElementById('recentRatingsChart').getContext('2d');
    const trend = analyticsData.weeklyTrend || { labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'], data: [0, 0, 0, 0] };
    const labels = trend.labels;
    const avg = trend.data.length ? trend.data.reduce((s, v) => s + v, 0) / trend.data.length : 0;

    const chartData = {
      labels: labels,
      datasets: [{
        label: 'Overall Avg Rating',
        data: trend.data,
        borderColor: '#0d6efd',
        backgroundColor: 'rgba(13, 110, 253, 0.1)',
        tension: 0.4,
        fill: true,
        pointRadius: 5,
        pointHoverRadius: 7
      }]
    };

    recentRatingsChart = new Chart(ctx, {
      type: 'line',
      data: chartData,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        onClick: function(event, elements) {
          if (elements.length > 0) {
            const el = elements[0];
            const label = recentRatingsChart.data.labels[el.index];
            const value = recentRatingsChart.data.datasets[el.datasetIndex].data[el.index];
            showChartDetailModal('Recent Ratings', label, value, analyticsData.recent || []);
          }
        },
        plugins: {
          legend: { display: true, position: 'top' },
          tooltip: {
            callbacks: {
              label: function(context) {
                return context.dataset.label + ': ' + context.parsed.y.toFixed(1);
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: false,
            min: Math.max(0, avg - 1),
            max: Math.min(5, avg + 1),
            ticks: { stepSize: 0.5 }
          }
        }
      }
    });
  }

  // Load recent ratings
  function loadRecentRatings() {
    const recent = (analyticsData.recent || []).slice(0, 10);
    displayRecentRatings(recent);
  }

  // Display recent ratings
  function displayRecentRatings(ratings) {
    const ratingsContent = document.getElementById('recentRatingsContent');
    
    if (ratings.length === 0) {
      ratingsContent.innerHTML = `
        <div class="text-center text-muted py-3">
          <i class="bi bi-star fs-1 d-block mb-2"></i>
          <p>No recent ratings found</p>
        </div>
      `;
      return;
    }

    ratingsContent.innerHTML = ratings.map(rating => `
      <div class="rating-item mb-3 p-3 border rounded">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <strong>${rating.customer}</strong>
            <small class="text-muted ms-2">${formatDate(rating.date)}</small>
          </div>
          <div class="rating-stars">
            ${generateStars(rating.rating)}
          </div>
        </div>
        <p class="mb-1">${rating.comment}</p>
        <div class="d-flex justify-content-between align-items-center">
          <span class="badge bg-${getTypeColor(rating.type)}">${rating.type}</span>
          <small class="text-muted">
            ${rating.technician ? `• ${rating.technician}` : ''}
            ${rating.product ? `• ${rating.product}` : ''}
          </small>
        </div>
      </div>
    `).join('');
  }

  // Handle recent ratings chart click
  function handleRecentRatingsClick(event, elements) {
    if (elements.length > 0) {
      const element = elements[0];
      const index = element.index;
      const label = recentRatingsChart.data.labels[index];
      const value = recentRatingsChart.data.datasets[element.datasetIndex].data[index];
      showChartDetailModal('Recent Ratings', label, value, analyticsData.recent || []);
    }
  }

  // Initialize main interactive chart
  function initializeMainInteractiveChart() {
    const ctx = document.getElementById('mainInteractiveChart').getContext('2d');
    const trend = analyticsData.weeklyTrend || { labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'], data: [0, 0, 0, 0] };
    const labels = trend.labels;
    const avg = trend.data.length ? trend.data.reduce((s, v) => s + v, 0) / trend.data.length : 0;

    const chartData = {
      labels: labels,
      datasets: [{
        label: 'Overall Rating Trend',
        data: trend.data,
        borderColor: '#0d6efd',
        backgroundColor: 'rgba(13, 110, 253, 0.1)',
        tension: 0.4,
        fill: true,
        pointRadius: 6,
        pointHoverRadius: 8
      }]
    };

    mainInteractiveChart = new Chart(ctx, {
      type: 'line',
      data: chartData,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        onClick: function(event, elements) {
          if (elements.length > 0) {
            const el = elements[0];
            const label = mainInteractiveChart.data.labels[el.index];
            const value = mainInteractiveChart.data.datasets[el.datasetIndex].data[el.index];
            document.getElementById('selectedDataPoint').textContent = 'Week ' + (el.index + 1) + ': ' + value.toFixed(1);
            showChartDetailModal('Rating Trend', label, value, analyticsData.recent || []);
          }
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(context) {
                return context.dataset.label + ': ' + context.parsed.y.toFixed(1);
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: false,
            min: Math.max(0, avg - 1),
            max: Math.min(5, avg + 1)
          }
        }
      }
    });
  }

  // Initialize sentiment charts
  function initializeSentimentCharts() {
    const sentiment = analyticsData.sentiment || { positive: 0, neutral: 0, negative: 0 };
    const totalSent = sentiment.positive + sentiment.neutral + sentiment.negative || 1;
    const pct = (v) => +(v / totalSent * 100).toFixed(1);
    const timelineData = analyticsData.weeklyTrend ? analyticsData.weeklyTrend.data.map(v => v / 5) : [0, 0, 0, 0];
    const timelineLabels = analyticsData.weeklyTrend ? analyticsData.weeklyTrend.labels : ['Week 1', 'Week 2', 'Week 3', 'Week 4'];

    // Sentiment Timeline Chart
    const timelineCtx = document.getElementById('sentimentTimelineChart').getContext('2d');
    sentimentTimelineChart = new Chart(timelineCtx, {
      type: 'line',
      data: {
        labels: timelineLabels,
        datasets: [{
          label: 'Sentiment Score',
          data: timelineData,
          borderColor: '#667eea',
          backgroundColor: 'rgba(102, 126, 234, 0.1)',
          tension: 0.4,
          fill: true,
          pointRadius: 4,
          pointHoverRadius: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        resizeDelay: 0,
        onClick: function(event, elements) {
          if (elements.length > 0) {
            const idx = elements[0].index;
            showChartDetailModal('Sentiment Timeline', timelineLabels[idx], timelineData[idx] * 5, analyticsData.recent || []);
          }
        },
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: {
            beginAtZero: true,
            min: 0,
            max: 1,
            ticks: {
              callback: function(value) { return (value * 100).toFixed(0) + '%'; },
              font: { size: 11 }
            },
            grid: { drawBorder: false }
          },
          x: {
            ticks: { font: { size: 11 } },
            grid: { drawBorder: false }
          }
        }
      }
    });

    // Sentiment by Category Chart
    const byCat = analyticsData.byCategory || {};
    const catLabels = Object.keys(byCat).length ? Object.keys(byCat) : ['service', 'product', 'technician'];
    const catPositive = catLabels.map(k => (byCat[k] || { positive: 0 }).positive);
    const catNeutral = catLabels.map(k => (byCat[k] || { neutral: 0 }).neutral);
    const catNegative = catLabels.map(k => (byCat[k] || { negative: 0 }).negative);

    const categoryCtx = document.getElementById('sentimentByCategoryChart').getContext('2d');
    sentimentByCategoryChart = new Chart(categoryCtx, {
      type: 'bar',
      data: {
        labels: catLabels.map(l => l.charAt(0).toUpperCase() + l.slice(1)),
        datasets: [{
          label: 'Positive',
          data: catPositive,
          backgroundColor: '#198754'
        }, {
          label: 'Neutral',
          data: catNeutral,
          backgroundColor: '#ffc107'
        }, {
          label: 'Negative',
          data: catNegative,
          backgroundColor: '#dc3545'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        resizeDelay: 0,
        onClick: function(event, elements) {
          if (elements.length > 0) {
            const idx = elements[0].index;
            const dsIdx = elements[0].datasetIndex;
            const label = sentimentByCategoryChart.data.labels[idx];
            const dsLabel = sentimentByCategoryChart.data.datasets[dsIdx].label;
            const value = sentimentByCategoryChart.data.datasets[dsIdx].data[idx];
            showChartDetailModal('Sentiment by Category', label + ' - ' + dsLabel, value, analyticsData.recent || []);
          }
        },
        plugins: {
          legend: { display: false }
        },
        scales: {
          x: {
            stacked: true,
            ticks: { font: { size: 11 } },
            grid: { drawBorder: false }
          },
          y: {
            stacked: true,
            ticks: { font: { size: 11 } },
            grid: { drawBorder: false }
          }
        }
      }
    });

    // Sentiment Distribution Chart
    const distributionCtx = document.getElementById('sentimentDistributionChart').getContext('2d');
    sentimentDistributionChart = new Chart(distributionCtx, {
      type: 'doughnut',
      data: {
        labels: ['Positive', 'Neutral', 'Negative'],
        datasets: [{
          data: [sentiment.positive, sentiment.neutral, sentiment.negative],
          backgroundColor: ['#198754', '#ffc107', '#dc3545']
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        resizeDelay: 0,
        onClick: function(event, elements) {
          if (elements.length > 0) {
            const idx = elements[0].index;
            const label = sentimentDistributionChart.data.labels[idx];
            const value = sentimentDistributionChart.data.datasets[0].data[idx];
            showChartDetailModal('Sentiment Distribution', label, value, analyticsData.recent || []);
          }
        },
        plugins: {
          legend: {
            position: 'bottom',
            labels: { font: { size: 11 }, padding: 10 }
          }
        }
      }
    });
  }

  // Update sentiment charts with data (now handled by initialize, this is a no-op)
  function updateSentimentCharts() {}

  // Handle chart click events
  function handleChartClick(event, elements) {
    if (elements.length > 0) {
      const el = elements[0];
      const label = mainInteractiveChart.data.labels[el.index];
      const value = mainInteractiveChart.data.datasets[el.datasetIndex].data[el.index];
      document.getElementById('selectedDataPoint').textContent = label + ': ' + value.toFixed(1);
      showChartDetailModal('Rating Trend', label, value, analyticsData.recent || []);
      document.getElementById('chartOverlay').style.display = 'none';
    }
  }

  // Display comments in the panel
  function displayComments(comments) {
    const commentsList = document.getElementById('commentsList');
    if (comments.length === 0) {
      commentsList.innerHTML = '<div class="text-center text-muted py-5"><i class="bi bi-chat-dots fs-1 d-block mb-2"></i><p>No comments found for this selection</p></div>';
      return;
    }
    commentsList.innerHTML = comments.map(c => `
      <div class="comment-item">
        <div class="comment-header">
          <div><strong>${c.customer || 'Customer'}</strong><small class="text-muted ms-2">${formatDate(c.date || c.createdAt)}</small></div>
          <div class="d-flex align-items-center gap-2">
            <div class="comment-rating">${generateStars(c.rating || c.score)}</div>
            <span class="comment-sentiment sentiment-${c.sentiment || 'neutral'}">${(c.sentiment || 'neutral').charAt(0).toUpperCase() + (c.sentiment || 'neutral').slice(1)}</span>
          </div>
        </div>
        <div class="comment-content">
          <p class="mb-1">${c.comment || 'No comment'}</p>
          <small class="text-muted">Rating: ${c.rating || c.score}/5</small>
        </div>
      </div>
    `).join('');
  }

  // Generate AI recommendations
  function generateAIRecommendations() {
    const sentiment = analyticsData.sentiment || { positive: 0, neutral: 0, negative: 0 };
    const total = sentiment.positive + sentiment.neutral + sentiment.negative || 1;
    const posPct = Math.round(sentiment.positive / total * 100);
    const negPct = Math.round(sentiment.negative / total * 100);
    const recommendationsList = document.getElementById('recommendationsList');

    const recs = [];
    recs.push({
      type: posPct >= 60 ? 'positive' : 'info',
      icon: 'bi-graph-up',
      text: `Customer satisfaction is at ${posPct}% positive rating${analyticsData.avgRating ? ' (avg: ' + analyticsData.avgRating + '/5)' : ''}`,
      action: posPct >= 60 ? 'Maintain current service quality standards' : 'Focus on improving service quality'
    });
    if (negPct > 10) {
      recs.push({
        type: 'warning',
        icon: 'bi-exclamation-triangle',
        text: `${negPct}% of ratings are negative — that's ${sentiment.negative} reviews`,
        action: 'Respond to negative feedback and identify improvement areas'
      });
    }
    recs.push({
      type: 'info',
      icon: 'bi-info-circle',
      text: `Total of ${analyticsData.totalRatings || 0} ratings collected across all categories`,
      action: 'Encourage more customers to leave feedback'
    });

    recommendationsList.innerHTML = recs.map(r => `
      <div class="alert alert-${r.type === 'positive' ? 'success' : r.type === 'warning' ? 'warning' : 'info'}">
        <i class="bi ${r.icon} me-2"></i><strong>Insight:</strong> ${r.text}
        <div class="mt-2"><small><strong>Recommendation:</strong> ${r.action}</small></div>
      </div>
    `).join('');
    generateInsights();
  }

  // Generate AI insights
  function generateInsights() {
    const sentiment = analyticsData.sentiment || { positive: 0, neutral: 0, negative: 0 };
    const total = sentiment.positive + sentiment.neutral + sentiment.negative || 1;
    document.getElementById('trendInsight').textContent =
      `Overall rating average is ${analyticsData.avgRating || 0}/5 with ${Math.round(sentiment.positive / total * 100)}% positive feedback.`;
    document.getElementById('trendMetric').textContent = analyticsData.avgRating >= 4 ? 'Excellent' : analyticsData.avgRating >= 3 ? 'Average' : 'Needs Improvement';
    document.getElementById('trendConfidence').textContent = Math.min(95, 50 + Math.round(sentiment.positive / total * 50)) + '%';
    document.getElementById('improvementInsight').textContent =
      sentiment.negative > 0 ? `${sentiment.negative} negative ratings need attention. Focus on addressing common complaints.` : 'No negative ratings found. Keep up the good work!';
    document.getElementById('strengthInsight').textContent =
      `Top rated categories: ${(analyticsData.topRated || []).slice(0, 2).map(t => t.name + ' (' + t.rating + ')').join(', ') || 'N/A'}`;
  }

  // Setup event listeners
  function setupEventListeners() {
    document.getElementById('chartType').addEventListener('change', function() { updateChartType(this.value); });
    document.getElementById('sentimentFilter').addEventListener('change', filterComments);
    document.getElementById('ratingFilter').addEventListener('change', filterComments);
    document.getElementById('commentSearch').addEventListener('input', filterComments);
  }

  // Update chart type
  function updateChartType(type) {
    if (!mainInteractiveChart) return;
    let newConfig;
    const recent = analyticsData.recent || [];
    const ratingDist = [0, 0, 0, 0, 0];
    recent.forEach(r => { const s = r.rating || r.score; if (s >= 1 && s <= 5) ratingDist[5 - s]++; });
    const totalDist = ratingDist.reduce((a, b) => a + b, 0) || 1;

    switch(type) {
      case 'distribution':
        newConfig = {
          type: 'bar',
          data: {
            labels: ['5 Stars', '4 Stars', '3 Stars', '2 Stars', '1 Star'],
            datasets: [{
              label: 'Rating Distribution',
              data: ratingDist,
              backgroundColor: ['#198754', '#0d6efd', '#ffc107', '#fd7e14', '#dc3545']
            }]
          }
        };
        break;
      case 'comparison':
        newConfig = {
          type: 'radar',
          data: {
            labels: ['Service', 'Product', 'Technician', 'Booking'],
            datasets: [{
              label: 'Avg Ratings by Category',
              data: (analyticsData.topRated || []).map(t => t.rating).concat([analyticsData.avgRating || 0]).slice(0, 4),
              borderColor: '#0d6efd',
              backgroundColor: 'rgba(13,110,253,0.1)'
            }]
          }
        };
        break;
      default:
        return;
    }
    mainInteractiveChart.destroy();
    const ctx = document.getElementById('mainInteractiveChart').getContext('2d');
    mainInteractiveChart = new Chart(ctx, {
      type: newConfig.type, data: newConfig.data,
      options: { responsive: true, maintainAspectRatio: false, onClick: handleChartClick }
    });
  }

  // Filter comments
  function filterComments() {
    const sentimentFilter = document.getElementById('sentimentFilter').value;
    const ratingFilter = document.getElementById('ratingFilter').value;
    const searchTerm = document.getElementById('commentSearch').value.toLowerCase();
    let comments = analyticsData.recent || [];
    if (sentimentFilter) comments = comments.filter(c => c.sentiment === sentimentFilter);
    if (ratingFilter) comments = comments.filter(c => (c.rating || c.score) == ratingFilter);
    if (searchTerm) comments = comments.filter(c =>
      (c.comment || '').toLowerCase().includes(searchTerm) ||
      (c.customer || '').toLowerCase().includes(searchTerm)
    );
    displayComments(comments);
  }

  // Clear comments
  function clearComments() {
    document.getElementById('selectedDataPoint').textContent = 'No selection';
    document.getElementById('commentsList').innerHTML = '<div class="text-center text-muted py-5"><i class="bi bi-bar-chart-line fs-1 d-block mb-2"></i><p>Click on chart data points to view detailed comments and ratings</p></div>';
    showChartOverlay();
  }

  function showChartOverlay() { document.getElementById('chartOverlay').style.display = 'flex'; }

  function resetCharts() { initializeMainInteractiveChart(); clearComments(); }
  function refreshSentiment() { loadAnalyticsData(); }
  function exportSentiment() { alert('Sentiment data export would be implemented here'); }

  // Generate insights on demand
  function generateInsights() {
    const sentiment = analyticsData.sentiment || { positive: 0, neutral: 0, negative: 0 };
    const total = sentiment.positive + sentiment.neutral + sentiment.negative || 1;
    setTimeout(() => {
      document.getElementById('trendInsight').textContent = `AI analysis: ${Math.round(sentiment.positive / total * 100)}% positive, avg ${analyticsData.avgRating || 0}/5`;
      document.getElementById('trendMetric').textContent = analyticsData.avgRating >= 4 ? 'Excellent' : 'Needs Attention';
      document.getElementById('trendConfidence').textContent = Math.min(95, 50 + Math.round(sentiment.positive / total * 50)) + '%';
    }, 500);
  }

  // ─── Original Charts (Rating Trends, Distribution, Category Performance, Monthly Comparison) ───────
  function initializeOriginalCharts() {
    const sentiment = analyticsData.sentiment || { positive: 0, neutral: 0, negative: 0 };
    const totalSent = sentiment.positive + sentiment.neutral + sentiment.negative || 1;
    const recent = analyticsData.recent || [];
    const byCat = analyticsData.byCategory || {};
    const catKeys = Object.keys(byCat).length ? Object.keys(byCat) : ['service', 'product', 'technician'];

    // ratingTrendsChart — Line chart using weeklyTrend
    const trend = analyticsData.weeklyTrend || { labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'], data: [0, 0, 0, 0] };
    const rtc = document.getElementById('ratingTrendsChart');
    if (rtc) {
      new Chart(rtc.getContext('2d'), {
        type: 'line',
        data: {
          labels: trend.labels,
          datasets: [{
            label: 'Avg Rating',
            data: trend.data,
            borderColor: '#0d6efd',
            backgroundColor: 'rgba(13,110,253,0.1)',
            tension: 0.4, fill: true
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          onClick: function(_, els) {
            if (els.length) showChartDetailModal('Rating Trends', trend.labels[els[0].index], trend.data[els[0].index], recent);
          },
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: false, min: 0, max: 5 } }
        }
      });
    }

    // ratingDistributionChart — Doughnut (star distribution)
    const rdc = document.getElementById('ratingDistributionChart');
    if (rdc) {
      const dist = [0, 0, 0, 0, 0];
      recent.forEach(r => { const s = r.rating || r.score; if (s >= 1 && s <= 5) dist[5 - s]++; });
      new Chart(rdc.getContext('2d'), {
        type: 'doughnut',
        data: {
          labels: ['5 Stars', '4 Stars', '3 Stars', '2 Stars', '1 Star'],
          datasets: [{ data: dist, backgroundColor: ['#198754', '#0d6efd', '#ffc107', '#fd7e14', '#dc3545'] }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          onClick: function(_, els) {
            if (els.length) showChartDetailModal('Rating Distribution', ['5 Stars','4 Stars','3 Stars','2 Stars','1 Star'][els[0].index], dist[els[0].index], recent);
          },
          plugins: { legend: { position: 'bottom' } }
        }
      });
    }

    // categoryPerformanceChart — Bar chart
    const cpc = document.getElementById('categoryPerformanceChart');
    if (cpc) {
      const catLabels = catKeys.map(k => k.charAt(0).toUpperCase() + k.slice(1));
      const catAvgs = catKeys.map(k => { const g = byCat[k]; if (!g) return 0; const t = g.positive + g.neutral + g.negative; return t ? +((g.positive * 5 + g.neutral * 3 + g.negative * 1) / t).toFixed(1) : 0; });
      new Chart(cpc.getContext('2d'), {
        type: 'bar',
        data: {
          labels: catLabels,
          datasets: [{ label: 'Avg Rating', data: catAvgs, backgroundColor: '#0d6efd' }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          onClick: function(_, els) {
            if (els.length) showChartDetailModal('Category Performance', catLabels[els[0].index], catAvgs[els[0].index], recent);
          },
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, max: 5 } }
        }
      });
    }

    // monthlyComparisonChart — Bar chart with sentiment
    const mcc = document.getElementById('monthlyComparisonChart');
    if (mcc) {
      new Chart(mcc.getContext('2d'), {
        type: 'bar',
        data: {
          labels: ['Positive', 'Neutral', 'Negative'],
          datasets: [{
            label: 'Sentiment Count',
            data: [sentiment.positive, sentiment.neutral, sentiment.negative],
            backgroundColor: ['#198754', '#ffc107', '#dc3545']
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          onClick: function(_, els) {
            if (els.length) showChartDetailModal('Monthly Comparison', ['Positive','Neutral','Negative'][els[0].index], [sentiment.positive, sentiment.neutral, sentiment.negative][els[0].index], recent);
          },
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } }
        }
      });
    }
  }

  // ─── Chart Detail Modal ──────────────────────────────────────────────────────
  function showChartDetailModal(title, label, value, data) {
    document.getElementById('chartDetailModalTitle').textContent = title;
    document.getElementById('chartDetailPoint').textContent = label + ': ' + (typeof value === 'number' ? value.toFixed(1) : value);
    const content = document.getElementById('chartDetailContent');
    if (data && data.length) {
      const filtered = data.slice(0, 20);
      content.innerHTML = filtered.map(r => `
        <div class="d-flex justify-content-between align-items-center p-2 border-bottom">
          <div>
            <strong>${r.customer || 'Customer'}</strong>
            <span class="badge bg-${r.sentiment === 'positive' ? 'success' : r.sentiment === 'negative' ? 'danger' : 'warning'} ms-2">${r.rating || r.score}/5</span>
            <small class="text-muted ms-2">${formatDate(r.date || r.createdAt)}</small>
          </div>
          <small class="text-truncate ms-3" style="max-width:250px">${r.comment || ''}</small>
        </div>
      `).join('');
    } else {
      content.innerHTML = '<div class="text-center text-muted py-3"><p>Value: ' + (typeof value === 'number' ? value.toFixed(2) : value) + '</p><p class="small">No detailed data available</p></div>';
    }
    const modal = new bootstrap.Modal(document.getElementById('chartDetailModal'));
    modal.show();
  }

  function exportChartDetail() {
    alert('Export chart detail would be implemented here');
  }

  // Helper functions
  function generateStars(rating) {
    let stars = '';
    for (let i = 1; i <= 5; i++) stars += i <= rating ? '<i class="bi bi-star-fill"></i>' : '<i class="bi bi-star"></i>';
    return stars;
  }

  function formatDate(dateString) {
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  // Export ratings data
  function exportRatings() {
    const ratings = analyticsData.recent || [];
    const csvContent = [
      ['Customer', 'Rating', 'Type', 'Comment', 'Date', 'Sentiment', 'Sentiment Score'],
      ...ratings.slice(0, 100).map(r => [
        r.customer || 'Customer',
        r.rating || r.score,
        r.type || 'N/A',
        `"${(r.comment || '').replace(/"/g, '""')}"`,
        formatDate(r.date || r.createdAt),
        r.sentiment || 'neutral',
        ((r.sentimentScore || 0.5) * 100).toFixed(1) + '%'
      ])
    ].map(row => row.join(',')).join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'ratings_export_' + new Date().toISOString().split('T')[0] + '.csv';
    a.click();
    window.URL.revokeObjectURL(url);
  }

  function exportAnalytics() { alert('Analytics export functionality would be implemented here'); }
  function scheduleReport() { alert('Report scheduling functionality would be implemented here'); }
  function exportFormat(format) { alert('Export as ' + format.toUpperCase() + ' functionality would be implemented here'); }
  function applyPeriod() { loadAnalyticsData(); }

  function getTypeColor(type) {
    const colors = { service: 'primary', product: 'success', technician: 'warning', booking: 'info', inventory: 'secondary', order: 'dark' };
    return colors[type] || 'secondary';
  }
</script>
