                  <td class="text-truncate" style="max-width: 200px;" title="${reason}">${reason || "—"}</td>
                  <td>${statusBadge}</td>
                  <td class="text-center">${actions}</td>
                `;
                tbody.appendChild(tr);
              });
            }
          }
          
          if (countEl) {
            countEl.textContent = `${appts.length} request${appts.length !== 1 ? 's' : ''}`;
          }
        } catch (err) {
          console.warn("loadRescheduleRequests failed", err);
          const tbody = document.getElementById("rescheduleRequestsTableBody");
          if (tbody) {
            tbody.innerHTML =
              '<tr><td colspan="8" class="workflow-record-empty text-danger">Failed to load reschedule requests.</td></tr>';
          }
        }
      }
      
      // Approve reschedule request
      async function approveReschedule(id) {
        if (!confirm("Are you sure you want to approve this reschedule request?")) {
          return;
        }
        
        try {
          const r = await fetch(`/api/appointments/${id}/reschedule-approve`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            }
          });
          
          if (r.ok) {
            alert("Reschedule request approved successfully!");
            loadRescheduleRequests();
          } else {
            const j = await r.json();
            alert(`Failed to approve: ${j.error || "Unknown error"}`);
          }
        } catch (err) {
          console.error("approveReschedule error", err);
          alert("Failed to approve reschedule request");
        }
      }
      
      // Reject reschedule request
      async function rejectReschedule(id) {
        const reason = prompt("Enter reason for rejection (optional):");
        if (reason === null) return; // User cancelled
        
        try {
          const r = await fetch(`/api/appointments/${id}/reschedule-reject`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({ reason })
          });
          
          if (r.ok) {
            alert("Reschedule request rejected successfully!");
            loadRescheduleRequests();
          } else {
            const j = await r.json();
            alert(`Failed to reject: ${j.error || "Unknown error"}`);
          }
        } catch (err) {
          console.error("rejectReschedule error", err);
          alert("Failed to reject reschedule request");
        }
      }
      
      // Event listeners for reschedule tab
      // Status filter change
      const statusFilter = document.getElementById("rescheduleStatusFilter");
      if (statusFilter) {
        statusFilter.addEventListener("change", loadRescheduleRequests);
      }

      // Refresh button
      const rescheduleRefreshBtn = document.getElementById("refreshRescheduleRequests");
      if (rescheduleRefreshBtn) {
        rescheduleRefreshBtn.addEventListener("click", loadRescheduleRequests);
      }
      
      // Make functions globally available
      window.approveReschedule = approveReschedule;
      window.rejectReschedule = rejectReschedule;

      // wire controls
      // filter/apply button for combined appointments
      const filterBtn = document.getElementById("btn-filter-combined");
      if (filterBtn) {
        filterBtn.addEventListener("click", () => {
          loadCombinedOverview();
        });
      }
      const refreshBtn = document.getElementById("btn-refresh-combined");
      if (refreshBtn) {
        refreshBtn.addEventListener("click", () => {
          loadCombinedOverview();
          loadBookingRequests();
        });
      }
      const refreshAllBtn = document.getElementById("apptsRefreshAll");
      if (refreshAllBtn) {
        refreshAllBtn.addEventListener("click", () => {
          loadCombinedOverview();
          loadBookingRequests();
        });
      }
      ["requestSearchCombined"].forEach((id) => {
        const node = document.getElementById(id);
        if (!node) return;
        node.addEventListener("input", renderBookingRequests);
      });      document
        .getElementById("requestRefreshCombined")
        ?.addEventListener("click", loadBookingRequests);

      // set title to match default status
      const pageTitle = document.querySelector(".dashboard-hero .page-title");
      if (pageTitle)
        pageTitle.innerHTML =
          '<i class="bi bi-calendar3-fill me-2"></i>Scheduled Appointments';
      // initial load of appointments list
      loadCombinedOverview(currentListStatus);

      // helper: create a compact sparkline chart (same as used in reports)
      function createSparkline(id, data, color){
        var c = document.getElementById(id);
        if (!c || typeof Chart === 'undefined') return null;
        return new Chart(c, {
          type: 'line',
          data: { labels: data.map((_,i)=>i+1), datasets: [{ data: data, borderColor: color, backgroundColor: color.replace('rgb','rgba').replace(')',',0.12)'), fill: true, tension: 0.35 }] },
          options: {
            responsive: true, maintainAspectRatio: false, animation:{duration:800},
            plugins:{legend:{display:false}, tooltip:{enabled:false}},
            elements:{point:{radius:0}},
            scales:{x:{display:false}, y:{display:false}}
          }
        });
      }

      // draw initial dummy sparklines for header KPIs
      createSparkline('kpiSparkScheduled', [4,6,5,7,6,8,7], '#2563eb');
      createSparkline('kpiSparkEnRoute',    [3,5,4,6,5,7,6], '#3b82f6');
      createSparkline('kpiSparkPending',    [2,3,4,3,5,4,3], '#f59e0b');
      createSparkline('kpiSparkCompleted',  [1,3,2,4,3,5,4], '#10b981');
      createSparkline('kpiSparkCancelled',  [1,1,2,1,1,0,1], '#dc3545');

      // also wire change events so filters auto-refresh
      [
        "filterSearchCombined",
        "filterStartCombined",
        "filterEndCombined",
        "filterTechCombined",
        "filterServiceType",
      ].forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.addEventListener(el.tagName === "INPUT" ? "input" : "change", () =>
          loadCombinedOverview(),
        );
      });

      // Load waiting for acceptance tab
      async function loadWaitingAcceptTab() {
        const container = document.getElementById("waitingAcceptContainer");
        const pagination = document.getElementById("waitingAcceptPagination");
        container.innerHTML = '<div class="workflow-record-empty"><div class="spinner-border text-primary"></div><p class="mt-2 mb-0">Loading...</p></div>';
        if (pagination) pagination.innerHTML = '';

        try {
          const res = await fetch('/api/admin/appointments/waiting-acceptance/list?limit=50');
          if (!res.ok) throw new Error();
          const data = await res.json();
          const bookings = data.bookings || [];

          const total = data.pagination?.total || 0;
          document.getElementById('waitingAcceptCount').textContent = total + ' bookings';
          const badge = document.getElementById('waitingAcceptTabBadge');
          if (badge) { badge.textContent = total; badge.style.display = total > 0 ? 'inline-block' : 'none'; }

          if (!bookings.length) {
            container.innerHTML = '<div class="workflow-record-empty"><i class="bi bi-check-circle fs-1 d-block mb-2"></i><p class="mb-0">All assigned bookings have been accepted.</p></div>';
            return;
          }

          container.innerHTML = bookings.map(b => {
            const tech = b.technician;
            const assignedAt = b.assignedAt ? new Date(b.assignedAt).toLocaleString() : '—';
            const bDate = b.bookingDate ? new Date(b.bookingDate).toLocaleDateString() : '—';
            return '<div class="workflow-record-card">' +
              '<div class="workflow-record-head">' +
                '<div>' +
                  '<div class="workflow-record-ref">' + (b.bookingReference || b._id.slice(-8).toUpperCase()) + '</div>' +
                  '<div class="workflow-record-title">' + (b.customer?.name || 'Unknown') + '</div>' +
                  '<div class="workflow-record-subtitle">' + (b.service?.name || '—') + '</div>' +
                '</div>' +
                '<span class="ao-st-badge ao-st-pending_payment"><i class="bi bi-clock me-1"></i>Waiting</span>' +
              '</div>' +
              '<div class="workflow-record-grid">' +
                '<div class="workflow-record-meta"><i class="bi bi-calendar3"></i> ' + bDate + '</div>' +
                '<div class="workflow-record-meta"><i class="bi bi-clock"></i> ' + (b.startTime || '—') + ' - ' + (b.endTime || '—') + '</div>' +
                '<div class="workflow-record-meta"><i class="bi bi-geo-alt"></i> ' + (b.address || '—') + '</div>' +
              '</div>' +
              (tech ? '<div class="workflow-record-actions">' +
                '<div style="display:flex;align-items:center;gap:8px;">' +
                  '<div style="width:28px;height:28px;border-radius:50%;background:#f59e0b;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.7rem;flex-shrink:0;">' + (tech.name || 'T')[0].toUpperCase() + '</div>' +
                  '<div style="font-size:.78rem;">' +
                    '<div style="font-weight:600;color:#1e293b;">' + tech.name + '</div>' +
                    '<div style="font-size:.7rem;color:#64748b;">' + (tech.phone || tech.email || '—') + '</div>' +
                  '</div>' +
                '</div>' +
                '<div style="font-size:.7rem;color:#94a3b8;">Assigned: ' + assignedAt + '</div>' +
              '</div>' : '') +
            '</div>';
          }).join('');
        } catch(e) {
          container.innerHTML = '<div class="workflow-record-empty"><i class="bi bi-exclamation-triangle fs-1 d-block mb-2 text-danger"></i><p class="mb-0 text-danger">Failed to load bookings</p></div>';
        }
      }

      // if URL contains ?sel=<id> open Reschedule tab and preselect the appointment
      // if URL contains ?tab=<tabname> open that tab
      (function preselectFromQuery() {
        try {
          const params = new URLSearchParams(location.search);

          // Handle ?tab= parameter for direct tab navigation
          const tabParam = params.get("tab");
          if (tabParam) {
            const tabBtn = document.querySelector(`#apptsTabs [data-tab="${tabParam}"]`);
            if (tabBtn) {
              setTimeout(() => tabBtn.click(), 200);
            }
          }

          const sel = params.get("sel") || params.get("id");
          if (!sel) return;
          let tries = 0;
          const trySelect = () => {
            tries++;
            if (
              typeof combinedAppointments !== "undefined" &&
              combinedAppointments.length
            ) {
              // reuse existing onEditAppt logic by simulating a click-event object
              try {
                onEditAppt({ currentTarget: { getAttribute: () => sel } });
              } catch (e) {
                /* ignore */
              }
              const tabBtn = document.querySelector(
                '#apptsTabs [data-tab="tab-reschedule"]',
              );
              if (tabBtn) tabBtn.click();
            } else if (tries < 20) {
              setTimeout(trySelect, 150);
            }
          };
          setTimeout(trySelect, 200);
        } catch (e) {
          /* ignore */
        }
      })();
    })();
  </script>
</div>
