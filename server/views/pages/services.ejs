                    </div>
                    <div class="alert alert-warning mb-3" style="font-size:0.85rem;border-radius:12px;">
                      <div class="d-flex align-items-start gap-2"><i class="bi bi-shield-check mt-1"></i><small><strong>Manual verification.</strong> Your payment stays pending until an admin verifies the uploaded receipt.</small></div>
                    </div>
                    <div class="mb-1"><textarea id="cashNotes" class="form-control" rows="2" placeholder="Special instructions (optional)" style="border-radius:12px;border:1.5px solid #e5e7eb;"></textarea></div>
                  </div>

                  <div id="paymentError" class="text-danger small mt-2" style="display:none"></div>
                </div>
              </div>

