  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Move all modals to body to prevent z-index/backdrop issues in nested layouts
      document.querySelectorAll('.modal').forEach(modal => {
        if (modal && modal.parentElement !== document.body) {
          document.body.appendChild(modal);
        }
      });
    });
  </script>

<script>
  // ─── Aircon Inventory Admin Logic ────────────────────────────────────────────
  (function () {
    const tbody = document.getElementById("inventoryTableBody");
    const summary = document.getElementById("inventorySummary");
    const kpiTotal = document.getElementById("kpiTotalItems");
    const kpiLow = document.getElementById("kpiLowStock");
    const kpiValue = document.getElementById("kpiTotalValue");
    let inventoryData = [];
    let editingId = null;

    // ── Helpers ────────────────────────────────────────────────────────────────
    function fmtPrice(p) {
      if (!p) return '₱ 0.00';
      return '₱ ' + Number(p).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    const TYPE_LABELS = {
      split: 'Split Type',
      split_ceiling: 'Split - Ceiling',
      window_inverter: 'Window (Inverter)',
      window_non_inverter: 'Window (Non-Inv)',
      floor_mounted: 'Floor Mounted',
    };

    const STATUS_BADGES = {
      in_stock:      { cls: 'bg-success-subtle text-success border border-success-subtle', label: 'In Stock' },
      low_stock:     { cls: 'bg-warning-subtle text-warning border border-warning-subtle', label: 'Low Stock' },
      out_of_stock:  { cls: 'bg-danger-subtle text-danger border border-danger-subtle', label: 'Out of Stock' },
      coming_soon:   { cls: 'bg-info-subtle text-info border border-info-subtle', label: 'Coming Soon' },
      discontinued:  { cls: 'bg-secondary-subtle text-secondary border border-secondary-subtle', label: 'Discontinued' },
    };

    function starHtml(rating, count) {
      if (!rating) return '<span class="text-muted text-micro">—</span>';
      const stars = Array.from({ length: 5 }).map((_, i) => {
        if (i + 1 <= Math.floor(rating)) return '<i class="bi bi-star-fill"></i>';
        if (i < rating) return '<i class="bi bi-star-half"></i>';
        return '<i class="bi bi-star"></i>';
      }).join('');
      return `<div class="text-warning">${stars}</div><div class="text-micro text-muted">${Number(rating).toFixed(1)} (${count || 0})</div>`;
    }

    // ── Group Aircons by Model Name ─────────────────────────────────────────────
    function groupAirconsByModel(items) {
      const grouped = {};
      
      items.forEach(item => {
        const modelName = item.modelLine || item.itemName || 'Unknown';
        const brandName = (item.brand && item.brand.name) || '';
        const key = `${brandName}-${modelName}`;
        
        if (!grouped[key]) {
          grouped[key] = {
            modelName,
            brandName,
            type: item.type,
            variants: [],
            totalQuantity: 0,
            imageUrl: item.imageUrl,
            status: item.status,
            lowestPrice: Infinity,
            highestPrice: 0,
            inverter: item.inverter
          };
        }
        
        grouped[key].variants.push({
          capacity: item.capacity,
          capacityUnit: item.capacityUnit || 'HP',
          btu: item.btu,
          sellingPrice: item.sellingPrice,
          quantity: item.quantity || 0,
          minStockLevel: item.minStockLevel || 3,
          _id: item._id
        });
        
        grouped[key].totalQuantity += (item.quantity || 0);
        grouped[key].lowestPrice = Math.min(grouped[key].lowestPrice, item.sellingPrice || 0);
        grouped[key].highestPrice = Math.max(grouped[key].highestPrice, item.sellingPrice || 0);
      });
      
      return Object.values(grouped);
    }

    // ── Pagination ─────────────────────────────────────────────────────────────
    let invPageSize = 10;
    let invCurrentPage = 1;

    function renderItemsPage(page) {
      const start = (page - 1) * invPageSize;
      const slice = inventoryData.slice(start, start + invPageSize);
      tbody.innerHTML = '';

      if (slice.length === 0 && inventoryData.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted text-micro">No aircon products found.</td></tr>';
        summary.innerText = '0 entries';
        document.getElementById('inventory-pagination').innerHTML = '';
        return;
      }

      slice.forEach(product => {
        const brandName = (product.brand && product.brand.name) || product.brand || 'Unknown';
        const modelName = product.modelLine || 'Unknown';
        const variants = product.variants || [];
        const totalQuantity = variants.reduce((sum, v) => sum + (v.quantity || 0), 0);
        const inStockVariants = variants.filter(v => v.status === 'in_stock').length;
        const stockCoverage = variants.length ? Math.round((inStockVariants / variants.length) * 100) : 0;
        const priceRange = variants.length > 0 ? {
          min: Math.min(...variants.map(v => v.sellingPrice || 0)),
          max: Math.max(...variants.map(v => v.sellingPrice || 0))
        } : { min: 0, max: 0 };

        const row = document.createElement('tr');
        row.innerHTML = 
          '<td class="ps-4">' +
            '<div class="inv-product-shell">' +
              '<div class="inv-product-media">' +
                (product.imageUrl && product.imageUrl !== '/images/products/default.png' ? 
                  '<img src="' + product.imageUrl + '" alt="' + modelName + '" class="img-fluid rounded" style="width:60px;height:60px;object-fit:cover;box-shadow:0 2px 8px rgba(0,0,0,0.1);" onerror="this.style.display=\'none\';this.parentElement.innerHTML=\'<i class=\\\'bi bi-snow2 fs-3 text-primary d-flex align-items-center justify-content-center\\\' style=\\\'width:60px;height:60px;background:#f8f9fa;border-radius:8px;\\\'></i>\';">' :
                  '<div class="d-flex align-items-center justify-content-center" style="width:60px;height:60px;background:#f8f9fa;border-radius:8px;"><i class="bi bi-snow2 fs-3 text-primary"></i></div>'
                ) +
              '</div>' +
              '<div class="flex-grow-1">' +
                '<div class="fw-bold text-dark mb-1" style="font-size:0.95rem;">' + modelName + '</div>' +
                '<div class="text-muted inv-meta-row">' +
                  '<span class="badge bg-light text-dark border" style="font-size:0.75rem;"><i class="bi bi-building me-1"></i>' + brandName + '</span>' +
                  '<span class="text-muted" style="font-size:0.8rem;">' + variants.length + ' HP Options</span>' +
                '</div>' +
                '<div class="d-flex flex-wrap gap-1">' +
                  (product.inverter ? '<span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:0.7rem;"><i class="bi bi-lightning-charge-fill me-1"></i>Inverter</span>' : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size:0.7rem;"><i class="bi bi-lightning me-1"></i>Standard</span>') +
                  '<span class="badge bg-info-subtle text-info border border-info-subtle" style="font-size:0.7rem;"><i class="bi bi-tag me-1"></i>' + (product.type || 'Split Type') + '</span>' +
                '</div>' +
              '</div>' +
            '</div>' +
          '</td>' +
          '<td>' +
            '<div class="text-muted small mb-1">Type: <strong>' + (product.type || 'Split Type') + '</strong></div>' +
            '<div class="text-muted small">Technology: <strong>' + (product.inverter ? 'Inverter' : 'Non-Inverter') + '</strong></div>' +
            (product.warranty ? '<div class="text-muted small">Warranty: <strong>' + product.warranty + '</strong></div>' : '') +
          '</td>' +
          '<td>' +
            '<div class="inv-variant-grid">' +
              variants.map(v => 
                '<span class="inv-variant-pill">' + 
                '<strong>' + (v.capacity || 'N/A') + ' HP</strong>' + 
                (v.btu ? '<small>' + v.btu + ' BTU</small>' : '') +
                '</span>'
              ).join('') +
            '</div>' +
          '</td>' +
          '<td>' +
            '<div class="fw-bold text-primary mb-1" style="font-size:0.95rem;">' +
              (priceRange.min === priceRange.max ? 
                '₱' + priceRange.min.toLocaleString() : 
                '₱' + priceRange.min.toLocaleString() + ' - ₱' + priceRange.max.toLocaleString()
              ) +
            '</div>' +
            '<div class="text-muted small">' + 
              (variants.length === 1 ? 'Single Price' : variants.length + ' Price Points') +
            '</div>' +
          '</td>' +
          '<td>' +
            '<div class="inv-stock-value">' +
              '<div class="fw-bold ' + (totalQuantity > 10 ? 'text-success' : totalQuantity > 5 ? 'text-warning' : 'text-danger') + '" style="font-size:1.1rem;">' + totalQuantity + '</div>' +
              '<div class="text-muted small">units</div>' +
            '</div>' +
            '<div class="progress" style="height:6px;">' +
              '<div class="progress-bar ' + (inStockVariants === variants.length ? 'bg-success' : inStockVariants > 0 ? 'bg-warning' : 'bg-danger') + '" style="width:' + stockCoverage + '%"></div>' +
            '</div>' +
            '<div class="text-muted small mt-1">' + inStockVariants + '/' + variants.length + ' variants in stock</div>' +
          '</td>' +
          '<td>' +
            (totalQuantity > 0 ? 
              '<div class="d-flex align-items-center gap-2"><span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i>In Stock</span></div>' : 
              '<div class="d-flex align-items-center gap-2"><span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle-fill me-1"></i>Out of Stock</span></div>'
            ) +
            (totalQuantity <= 5 && totalQuantity > 0 ? '<div class="text-warning small mt-1"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock</div>' : '') +
          '</td>' +
          '<td class="text-end pe-4">' +
            '<div class="inv-actions-stack">' +
              '<button class="btn btn-sm btn-outline-primary inv-action-btn edit-grouped" ' +
                      'data-model="' + modelName + '" data-brand="' + brandName + '" title="Edit product details">' +
                '<i class="bi bi-pencil me-1"></i>Edit' +
              '</button>' +
              '<button class="btn btn-sm btn-outline-info inv-action-btn manage-variants" ' +
                      'data-model="' + modelName + '" data-brand="' + brandName + '" title="Manage HP variants">' +
                '<i class="bi bi-layers me-1"></i>Variants' +
              '</button>' +

              '<button class="btn btn-sm btn-outline-danger inv-action-btn delete-inventory" ' +
                      'data-id="' + product._id + '" title="Archive product">' +
                '<i class="bi bi-archive me-1"></i>Archive' +
              '</button>' +
            '</div>' +
          '</td>';
        tbody.appendChild(row);
      });

      const total = inventoryData.length;
      const from = start + 1;
      const to = Math.min(start + invPageSize, total);
      summary.innerText = `Showing ${from}–${to} of ${total} entries`;

      // Pagination
      const pages = Math.ceil(total / invPageSize);
      const ul = document.getElementById('inventory-pagination');
      ul.innerHTML = '';
      const prev = document.createElement('li');
      prev.className = 'page-item' + (invCurrentPage <= 1 ? ' disabled' : '');
      prev.innerHTML = '<a class="page-link" href="#">&laquo;</a>';
      prev.addEventListener('click', e => { e.preventDefault(); if (invCurrentPage > 1) { invCurrentPage--; renderItemsPage(invCurrentPage); } });
      ul.appendChild(prev);
      const ind = document.createElement('li');
      ind.className = 'page-item disabled mx-2';
      ind.innerHTML = `<span class="page-link">${invCurrentPage} of ${pages}</span>`;
      ul.appendChild(ind);
      const next = document.createElement('li');
      next.className = 'page-item' + (invCurrentPage >= pages ? ' disabled' : '');
      next.innerHTML = '<a class="page-link" href="#">&raquo;</a>';
      next.addEventListener('click', e => { e.preventDefault(); if (invCurrentPage < pages) { invCurrentPage++; renderItemsPage(invCurrentPage); } });
      ul.appendChild(next);
    }

    // ── KPI Rendering ──────────────────────────────────────────────────────────
    function renderItems(items) {
      inventoryData = items;
      let totalValue = 0, lowCount = 0, totalVariants = 0;
      
      items.forEach((product) => {
        // Count variants
        totalVariants += (product.variants || []).length;
        
        // Calculate total value across all variants
        (product.variants || []).forEach(variant => {
          totalValue += (variant.sellingPrice || 0) * (variant.quantity || 0);
          if (variant.status === 'low_stock' || variant.status === 'out_of_stock') lowCount++;
        });
      });
      
      kpiTotal.innerText = totalVariants; // Total variants instead of items
      kpiLow.innerText = lowCount;
      kpiValue.innerText = fmtPrice(totalValue);

      invCurrentPage = 1;
      renderItemsPage(invCurrentPage);
    }

    // ── Data Fetch ─────────────────────────────────────────────────────────────
    async function loadInventory() {
      try {
        const r = await fetch('/api/admin/hvac');
        if (!r.ok) throw new Error('fail');
        const j = await r.json();
        renderItems(j.products || []);
      } catch (e) {
        console.error(e);
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 small text-muted text-danger">Failed to load</td></tr>';
      }
    }
    loadInventory();

    // ── Load Brands and Categories ─────────────────────────────────────────────
    async function loadBrandsAndCategories() {
      try {
        // Load brands
        const brandsResponse = await fetch('/api/admin/hvac/brands/all');
        if (brandsResponse.ok) {
          const brandsData = await brandsResponse.json();
          const brandSelect = document.getElementById('invBrand');
          if (brandSelect) {
            brandSelect.innerHTML = '<option value="">Select Brand</option>';
            brandsData.brands.forEach(brand => {
              brandSelect.innerHTML += `<option value="${brand._id}">${brand.name}</option>`;
            });
          }
        }

        // Load categories
        const categoriesResponse = await fetch('/api/admin/hvac/categories/all');
        if (categoriesResponse.ok) {
          const categoriesData = await categoriesResponse.json();
          const categorySelect = document.getElementById('invCategory');
          if (categorySelect) {
            categorySelect.innerHTML = '<option value="">Select Category</option>';
            categoriesData.categories.forEach(category => {
              categorySelect.innerHTML += `<option value="${category._id}">${category.name}</option>`;
            });
          }
        }
      } catch (error) {
        console.error('Error loading brands and categories:', error);
      }
    }
    loadBrandsAndCategories();

    // ── Add New Item Button Event Listener ───────────────────────────────────────
    const addBtn = document.getElementById('openAddItemBtn');
    if (addBtn) {
      addBtn.addEventListener('click', function() {
        openModal(null); // Open modal with null for adding new item
      });
    }

    // ── Variant Management ───────────────────────────────────────────────────────
    let variantIdCounter = 0;

    // Add variant button event listener
    const addVariantBtn = document.getElementById('addVariantBtn');
    if (addVariantBtn) {
      addVariantBtn.addEventListener('click', function() {
        addVariantRow();
      });
    }

    // Add variant row function
    function addVariantRow(variantData = null) {
      const variantId = variantData?._id || `variant_${++variantIdCounter}`;
      const container = document.getElementById('variantsContainer');
      const variantNumber = container.children.length + 1;
      
      const variantRow = document.createElement('div');
      variantRow.className = 'col-12';
      variantRow.id = `variant_${variantId}`;
      
      variantRow.innerHTML = `
        <div class="border rounded p-3 bg-white">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0 fw-bold text-primary">
              <i class="bi bi-box me-1"></i>Variant ${variantNumber}
            </h6>
            <div class="d-flex gap-2">
              ${variantData ? `<button type="button" class="btn btn-sm btn-outline-danger remove-variant" data-variant-id="${variantId}" title="Remove this variant">
                <i class="bi bi-trash"></i> Remove
              </button>` : ''}
            </div>
          </div>
          <div class="row g-3">
            <div class="col-md-3">
              <label class="inv-field-label small">Capacity (HP) <span class="text-danger">*</span></label>
              <input type="number" class="inv-input" step="0.5" min="0.5" max="5" placeholder="1.0" data-field="capacity" value="${variantData?.capacity || ''}" required />
            </div>
            <div class="col-md-3">
              <label class="inv-field-label small">BTU Rating</label>
              <input type="number" class="inv-input" placeholder="12000" data-field="btu" value="${variantData?.btu || ''}" />
            </div>
            <div class="col-md-3">
              <label class="inv-field-label small">Selling Price (₱) <span class="text-danger">*</span></label>
              <input type="number" class="inv-input" step="0.01" min="0" placeholder="15000" data-field="sellingPrice" value="${variantData?.sellingPrice || ''}" required />
            </div>
            <div class="col-md-3">
              <label class="inv-field-label small">Cost Price (₱)</label>
              <input type="number" class="inv-input" step="0.01" min="0" placeholder="12000" data-field="costPrice" value="${variantData?.costPrice || ''}" />
            </div>
            <div class="col-md-4">
              <label class="inv-field-label small">Stock Quantity <span class="text-danger">*</span></label>
              <input type="number" class="inv-input" min="0" placeholder="10" data-field="quantity" value="${variantData?.quantity || ''}" required />
            </div>
            <div class="col-md-4">
              <label class="inv-field-label small">Reorder Level</label>
              <input type="number" class="inv-input" min="0" placeholder="3" data-field="minStockLevel" value="${variantData?.minStockLevel || ''}" />
            </div>
            <div class="col-md-4">
              <label class="inv-field-label small">Status</label>
              <select class="inv-select" data-field="status">
                <option value="in_stock" ${variantData?.status === 'in_stock' ? 'selected' : ''}>In Stock</option>
                <option value="low_stock" ${variantData?.status === 'low_stock' ? 'selected' : ''}>Low Stock</option>
                <option value="out_of_stock" ${variantData?.status === 'out_of_stock' ? 'selected' : ''}>Out of Stock</option>
              </select>
            </div>
          </div>
        </div>
      `;
      
      container.appendChild(variantRow);
    }

    // Remove variant function
    function removeVariantRow(variantId) {
      const variantRow = document.getElementById(`variant_${variantId}`);
      if (variantRow) {
        variantRow.remove();
        // Update variant numbers
        const container = document.getElementById('variantsContainer');
        Array.from(container.children).forEach((row, index) => {
          const titleElement = row.querySelector('h6');
          if (titleElement) {
            titleElement.innerHTML = `<i class="bi bi-box me-1"></i>Variant ${index + 1}`;
          }
        });
      }
    }

    // Event delegation for remove variant buttons
    document.body.addEventListener('click', function(e) {
      if (e.target.matches('.remove-variant') || e.target.closest('.remove-variant')) {
        const btn = e.target.matches('.remove-variant') ? e.target : e.target.closest('.remove-variant');
        const variantId = btn.dataset.variantId;
        if (confirm('Remove this variant?')) {
          removeVariantRow(variantId);
        }
      }
    });

    // Get variants data function
    function getVariantsData() {
      const variants = [];
      const container = document.getElementById('variantsContainer');
      
      Array.from(container.children).forEach(variantRow => {
        const variantData = {};
        variantRow.querySelectorAll('[data-field]').forEach(input => {
          const field = input.dataset.field;
          const value = input.type === 'number' ? 
            (parseFloat(input.value) || 0) : input.value;
          variantData[field] = value;
        });
        
        // Only add variant if it has required fields
        if (variantData.capacity && variantData.sellingPrice) {
          variants.push(variantData);
        }
      });
      
      return variants;
    }

    // ── Form Alert Helpers ─────────────────────────────────────────────────────
    const formAlertEl = document.getElementById('inventoryFormAlert');
    function showFormAlert(type, msg) {
      formAlertEl.className = 'alert alert-' + type + ' mb-3';
      formAlertEl.textContent = msg;
      formAlertEl.classList.remove('d-none');
    }
    function hideFormAlert() {
      formAlertEl.classList.add('d-none');
    }

    // ── Image Upload Logic ───────────────────────────────────────────────────────
    let uploadedImageData = null;
    
    // Image upload event listener
    document.getElementById('invImage').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        // Validate file size (5MB max)
        if (file.size > 5 * 1024 * 1024) {
          showFormAlert('danger', 'Image size must be less than 5MB');
          e.target.value = '';
          return;
        }
        
        // Validate file type
        if (!file.type.startsWith('image/')) {
          showFormAlert('danger', 'Please select a valid image file');
          e.target.value = '';
          return;
        }
        
        // Read and preview the image
        const reader = new FileReader();
        reader.onload = function(e) {
          uploadedImageData = e.target.result;
          showImagePreview(uploadedImageData);
        };
        reader.readAsDataURL(file);
      }
    });
    
    // Remove image button
    document.getElementById('removeImageBtn').addEventListener('click', function() {
      uploadedImageData = null;
      document.getElementById('invImage').value = '';
      hideImagePreview();
    });
    
    function showImagePreview(imageSrc) {
      try {
        const preview = document.getElementById('invImagePreview');
        const placeholder = document.getElementById('invImagePlaceholder');
        const img = preview.querySelector('img');
        
        if (!preview || !placeholder || !img) {
          console.error('Image preview elements not found');
          return;
        }
        
        img.src = imageSrc;
        preview.style.display = 'block';
        placeholder.style.display = 'none';
      } catch (error) {
        console.error('Error in showImagePreview:', error);
      }
    }
    
    function hideImagePreview() {
      try {
        const preview = document.getElementById('invImagePreview');
        const placeholder = document.getElementById('invImagePlaceholder');
        
        if (!preview || !placeholder) {
          console.error('Image preview elements not found');
          return;
        }
        
        preview.style.display = 'none';
        placeholder.style.display = 'block';
      } catch (error) {
        console.error('Error in hideImagePreview:', error);
      }
    }

    // ── Modal Logic ────────────────────────────────────────────────────────────
    function openModal(item) {
      try {
        const mEl = document.getElementById('addItemModal');
        if (!mEl) {
          console.error('addItemModal element not found');
          return;
        }
        
        const modal = bootstrap && bootstrap.Modal
          ? bootstrap.Modal.getInstance(mEl) || new bootstrap.Modal(mEl)
          : null;
          
        const titleEl = document.getElementById('addItemModalTitle');
        if (!titleEl) {
          console.error('addItemModalTitle element not found');
          return;
        }
        
        hideFormAlert();

        // Reset image state
        uploadedImageData = null;
        const invImageEl = document.getElementById('invImage');
        if (invImageEl) invImageEl.value = '';

        // Clear variants container
        const variantsContainer = document.getElementById('variantsContainer');
        if (variantsContainer) {
          variantsContainer.innerHTML = '';
          variantIdCounter = 0;
        }

        if (item) {
          editingId = item._id;
          
          // Check if this is a variant edit (has variantId) or product edit
          if (item.variantId) {
            titleEl.innerHTML = '<i class="bi bi-snow2"></i> Edit HP Variant';
            // Hide add variant button for single variant edit
            const addVariantBtn = document.getElementById('addVariantBtn');
            if (addVariantBtn) addVariantBtn.style.display = 'none';
          } else {
            titleEl.innerHTML = '<i class="bi bi-snow2"></i> Edit HVAC Product';
            // Show add variant button for product edit
            const addVariantBtn = document.getElementById('addVariantBtn');
            if (addVariantBtn) addVariantBtn.style.display = 'block';
          }
          
          // Product-level fields
          const modelLineEl = document.getElementById('invModelLine');
          if (modelLineEl) modelLineEl.value = item.modelLine || '';
          
          const brandEl = document.getElementById('invBrand');
          if (brandEl) brandEl.value = (item.brand && item.brand._id) || item.brand || '';
          
          const categoryEl = document.getElementById('invCategory');
          if (categoryEl) categoryEl.value = (item.category && item.category._id) || item.category || '';
          
          const typeEl = document.getElementById('invType');
          if (typeEl) typeEl.value = item.type || 'split';
          
          const inverterEl = document.getElementById('invInverter');
          if (inverterEl) inverterEl.checked = !!item.inverter;
          
          const statusEl = document.getElementById('invStatus');
          if (statusEl) statusEl.value = item.status || '';
          
          const warrantyEl = document.getElementById('invWarranty');
          if (warrantyEl) warrantyEl.value = item.warranty || '';
          
          const descriptionEl = document.getElementById('invDescription');
          if (descriptionEl) descriptionEl.value = item.description || '';
          
          // Handle existing image
          if (item.imageUrl && item.imageUrl !== '/images/products/default.png') {
            showImagePreview(item.imageUrl);
          } else {
            hideImagePreview();
          }

          // Load existing variants for product edit
          if (item.variants && item.variants.length > 0) {
            item.variants.forEach(variant => {
              addVariantRow(variant);
            });
          } else if (item.capacity && item.sellingPrice) {
            // Single variant edit (from grouped table)
            addVariantRow({
              capacity: item.capacity,
              btu: item.btu,
              sellingPrice: item.sellingPrice,
              costPrice: item.costPrice,
              quantity: item.quantity,
              minStockLevel: item.minStockLevel,
              status: item.status,
              _id: item._id
            });
          }
        } else {
          editingId = null;
          titleEl.innerHTML = '<i class="bi bi-snow2"></i> Add HVAC Product';
          
          // Show add variant button for new product
          const addVariantBtn = document.getElementById('addVariantBtn');
          if (addVariantBtn) addVariantBtn.style.display = 'block';
          
          const formEl = document.getElementById('inventoryForm');
          if (formEl) formEl.reset();
          
          hideImagePreview();
          
          // Add one empty variant for new product
          addVariantRow();
        }
        
        modal && modal.show();
      } catch (error) {
        console.error('Error in openModal:', error);
        alert('Error opening modal: ' + error.message);
      }
    }
    window.openInventoryModal = openModal;


    // ── Event Delegation ──────────────────────────────────────────────────────
    document.body.addEventListener('click', function (e) {
      // Edit individual item
      if (e.target.matches('.edit-inventory')) {
        const id = e.target.dataset.id;
        const item = inventoryData.find((i) => i._id === id);
        if (item) openModal(item);
      }

      // Edit individual variant
      if (e.target.matches('.edit-variant') || e.target.closest('.edit-variant')) {
        const btn = e.target.matches('.edit-variant') ? e.target : e.target.closest('.edit-variant');
        const id = btn.dataset.id;
        const item = inventoryData.find((i) => i._id === id);
        if (item) openModal(item);
      }

      // Edit grouped item - show first variant for now
      if (e.target.matches('.edit-grouped') || e.target.closest('.edit-grouped')) {
        const btn = e.target.matches('.edit-grouped') ? e.target : e.target.closest('.edit-grouped');
        const modelName = btn.dataset.model;
        const brandName = btn.dataset.brand;
        const item = inventoryData.find((i) => 
          i.modelLine === modelName && 
          ((i.brand && i.brand.name) || i.brand || 'Unknown') === brandName
        );
        if (item && item.variants && item.variants.length > 0) {
          // Pass the first variant for editing
          const firstVariant = {
            ...item,
            capacity: item.variants[0].capacity,
            btu: item.variants[0].btu,
            sellingPrice: item.variants[0].sellingPrice,
            costPrice: item.variants[0].costPrice,
            quantity: item.variants[0].quantity,
            minStockLevel: item.variants[0].minStockLevel,
            variantId: item.variants[0]._id
          };
          openModal(firstVariant);
        }
      }

      // Manage variants for grouped item
      if (e.target.matches('.manage-variants') || e.target.closest('.manage-variants')) {
        const btn = e.target.matches('.manage-variants') ? e.target : e.target.closest('.manage-variants');
        const modelName = btn.dataset.model;
        const brandName = btn.dataset.brand;
        const item = inventoryData.find((i) => 
          i.modelLine === modelName && 
          ((i.brand && i.brand.name) || i.brand || 'Unknown') === brandName
        );
        if (item) {
          editingId = item._id;
          openVariantsModal();
        }
      }
    });

    // ── Variants Modal Management ─────────────────────────────────────────────
    let currentEditingProduct = null;
    let variantsData2 = [];
    let variantIdCounter2 = 0;

    function openVariantsModal() {
      currentEditingProduct = editingId;
      const product = inventoryData.find(i => i._id === currentEditingProduct);
      
      if (!product) return;
      
      // Set product name
      document.getElementById('variantProductName').textContent = 
        `${product.modelLine || 'Unknown'} - ${(product.brand && product.brand.name) || product.brand || 'Unknown'}`;
      
      // Clear and load all variants for this product
      variantsData2 = [];
      variantIdCounter2 = 0;
      document.getElementById('variantsContainer2').innerHTML = '';
      
      // Load all variants of this product
      if (product.variants && product.variants.length > 0) {
        product.variants.forEach((variant, index) => {
          addVariantRow2({
            capacity: variant.capacity,
            btu: variant.btu,
            sellingPrice: variant.sellingPrice,
            costPrice: variant.costPrice,
            quantity: variant.quantity,
            minStockLevel: variant.minStockLevel,
            _id: variant._id
          });
        });
      } else {
        // Add empty variant if none exist
        addVariantRow2();
      }
      
      // Show modal
      const modal = new bootstrap.Modal(document.getElementById('variantsModal'));
      modal.show();
    }

