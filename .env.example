
# App & DB
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname
# For a Dokploy MongoDB on the same private network, use its Internal Connection URL.
# Only then opt in to an unencrypted Docker-network connection. Public IPs are rejected.
# MONGODB_ALLOW_PLAINTEXT_INTERNAL=true
# Optional local-only fallback when Node cannot resolve Atlas SRV records.
# Obtain these values from the cluster's SRV and TXT DNS records. Do not set on Render unless needed.
MONGODB_DIRECT_HOSTS=shard-00-00.example.mongodb.net:27017,shard-00-01.example.mongodb.net:27017,shard-00-02.example.mongodb.net:27017
MONGODB_REPLICA_SET=atlas-example-shard-0
MONGODB_AUTH_SOURCE=admin

# Geocoding (use a real application contact on hosted deployments)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RACS-Ready-Booking-System/1.0 (contact: admin@example.com)

# JWT
JWT_SECRET=your-long-random-secret-here

# Email provider
# Provider selection is automatic: Brevo on Render/production, SMTP locally.
BREVO_API_KEY=your-brevo-api-key
FROM_EMAIL=racsready396@gmail.com
FROM_NAME=CALIDRO RACS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
APP_BASE_URL=http://localhost:5000
APP_URL=http://localhost:5000

# Registration throttling (15-minute window)
# Raise the IP ceiling when many legitimate users register behind one public IP.
REGISTRATION_EMAIL_RATE_LIMIT=10
REGISTRATION_IP_RATE_LIMIT=300
AUTH_ACCOUNT_RATE_LIMIT=10
AUTH_IP_BURST_RATE_LIMIT=300
ANONYMOUS_API_RATE_LIMIT=100
AUTHENTICATED_API_RATE_LIMIT=300
BOOKING_SUBMISSION_RATE_LIMIT=10

# Native asynchronous bcrypt work factor for new/changed passwords (10-14).
# Existing hashes remain compatible and are still verified at their own cost.
BCRYPT_ROUNDS=11

# MongoDB pool and network timeouts
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# HTTP server protection
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_SOCKET_TIMEOUT_MS=120000
HTTP_MAX_CONNECTIONS=1024
HTTP_MAX_REQUESTS_PER_SOCKET=1000
# Local direct requests default to 0 hops; production defaults to 1.
# Set only after verifying the actual proxy chain in your deployment.
# TRUST_PROXY_HOPS=1

# Process-local admission controls run before body parsing and MongoDB reads.
# These are safety ceilings, not measured user/throughput capacity.
HTTP_MAX_CONCURRENT_REQUESTS=128
HTTP_MAX_CONCURRENT_PER_IP=64
HTTP_MAX_LARGE_BODY_REQUESTS=4
HTTP_PER_IP_RATE_LIMIT=1200
HTTP_RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_MAX_KEYS=10000
SOCKET_MAX_CONNECTIONS=300
SOCKET_MAX_CONNECTIONS_PER_USER=12
SOCKET_HANDSHAKE_RATE_LIMIT=60
SOCKET_MAX_CONCURRENT_GPS_UPDATES=16
GEOCODING_MAX_PENDING_REQUESTS=8
GEOCODING_MAX_QUEUE_WAIT_MS=5000
CHAT_MAX_CONCURRENT_REQUESTS=8
CHAT_MAX_SESSIONS=200

# Durable asynchronous email delivery (production defaults to outbox)
EMAIL_DELIVERY_MODE=outbox
EMAIL_OUTBOX_SECRET=replace-with-a-separate-long-random-secret
EMAIL_OUTBOX_CONCURRENCY=2
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_POLL_MS=1000

# Attendance anti-fraud controls (QR signing falls back to SESSION_SECRET/JWT_SECRET)
ATTENDANCE_QR_SECRET=replace-with-a-separate-long-random-secret
ATTENDANCE_QR_TTL_SECONDS=45
ATTENDANCE_GEOFENCE_RADIUS_METERS=250
ATTENDANCE_MAX_GPS_ACCURACY_METERS=100
ATTENDANCE_LOCATION_MAX_AGE_SECONDS=120

# Payroll governance (optional). Leave false for a single payroll administrator.
# Set true only when separate active admins must create, approve, and record payment.
PAYROLL_SEPARATION_OF_DUTIES=false

# Persistent product-image storage (required on ephemeral hosts such as Render)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_HVAC_FOLDER=racs-ready/hvac

# Google sign-in (OAuth 2.0 Web application credentials)
# Add the exact redirect URI below to the Google Cloud OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Cal.com
CALCO_API_KEY=cal_live_your_key_here
CALCO_BASE_URL=https://api.cal.com/v2

# ReCAPTCHA
RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET=your-secret-key
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_MAPS_API_KEY=your-maps-key
# Optional server-side key for live, Philippines-only address suggestions.
GEOAPIFY_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# PayMongo
PAYMONGO_SECRET_KEY=sk_live_your_key
PAYMONGO_PUBLIC_KEY=pk_live_your_key
PAYMONGO_WEBHOOK_SECRET=your-webhook-secret
# Optional fallback; admins can configure the receiving number in System Settings.
ADMIN_GCASH_NUMBER=09123456789

# AI Keys (comma-separated for key rotation on quota exceeded)
GEMINI_API_KEY=your-gemini-key,your-gemini-key2
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=4500
GROQ_API_KEY=your-groq-key,your-groq-key2
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_OUTPUT_TOKENS=3000
TAVILY_API_KEY=your-tavily-key
