<div class="container-fluid py-4">
  <%- include('../../../partials/dashboard-styles') %>
  <link rel="stylesheet" href="/css/analytics.css">

  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-grid-1x2-fill"></i></div>
        <div>
          <h1>Admin Dashboard</h1>
          <p>Revenue, bookings, orders, inventory, customers, and technician performance</p>
        </div>
      </div>
      <div class="au-hero-actions">
        <button class="btn btn-outline-primary" onclick="window.location.reload()"><i class="bi bi-arrow-clockwise me-2"></i>Refresh</button>
      </div>
    </div>
  </div>

  <style>
    .kpi-card{background:#fff;border-radius:14px;padding:1.25rem;box-shadow:0 1px 3px rgba(0,0,0,.06);border:1px solid rgba(0,0,0,.04);transition:transform .2s,box-shadow .2s}
    .kpi-card:hover{transform:translateY(-2px);box-shadow:0 6px 16px rgba(0,0,0,.1)}
    .kpi-icon{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .kpi-icon i{color:#fff!important;font-size:1.3rem}
    .kpi-value{font-size:1.6rem;font-weight:800;line-height:1.1}
    .kpi-label{font-size:.8rem;color:#64748b;font-weight:500}
    .kpi-change{font-size:.72rem;font-weight:600;padding:.2rem .5rem;border-radius:20px}
    .bg-up{background:rgba(16,185,129,.12);color:#059669}
    .bg-down{background:rgba(239,68,68,.12);color:#dc2626}
    .section-card{background:#fff;border-radius:14px;box-shadow:0 1px 3px rgba(0,0,0,.06);border:1px solid rgba(0,0,0,.04);overflow:hidden}
    .section-header{padding:1rem 1.25rem;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between}
    .section-header h6{margin:0;font-weight:700;font-size:.9rem}
    .section-body{padding:1.25rem}
    .pipeline-bar{display:flex;height:10px;border-radius:5px;overflow:hidden;gap:2px}
    .pipeline-bar>div{height:100%;border-radius:5px;transition:width .5s}
    .pipeline-legend{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:.75rem}
    .pipeline-legend-item{display:flex;align-items:center;gap:4px;font-size:.75rem;color:#64748b}
    .pipeline-legend-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
    .alert-row{display:flex;align-items:center;gap:.75rem;padding:.6rem 0;border-bottom:1px solid #f8f9fa}
    .alert-row:last-child{border-bottom:none}
    .alert-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
    .stat-row{display:flex;justify-content:space-between;align-items:center;padding:.5rem 0;border-bottom:1px solid #f8f9fa}
    .stat-row:last-child{border-bottom:none}
    .tech-row{display:flex;align-items:center;gap:.75rem;padding:.6rem 0;border-bottom:1px solid #f8f9fa}
    .tech-row:last-child{border-bottom:none}
    .tech-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;color:#fff;flex-shrink:0}
    .review-mini{padding:.6rem 0;border-bottom:1px solid #f8f9fa}
    .review-mini:last-child{border-bottom:none}
    .chart-wrap{position:relative;width:100%;overflow:hidden}
    .chart-wrap canvas{position:absolute;top:0;left:0;width:100%!important;height:100%!important}
    .order-row{display:flex;align-items:center;gap:.75rem;padding:.6rem 0;border-bottom:1px solid #f8f9fa;font-size:.82rem}
    .order-row:last-child{border-bottom:none}
    .order-ref{font-weight:700;color:#334155}
    .order-status{font-size:.7rem;padding:.15rem .45rem;border-radius:10px;font-weight:600;white-space:nowrap}
  </style>

  <!-- KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-xl col-lg-4 col-md-6">
      <div class="kpi-card h-100">
        <div class="d-flex justify-content-between align-items-start">
          <div><div class="kpi-label">Monthly Revenue</div><div class="kpi-value text-dark" id="kpiRevenue">--</div><div class="kpi-change bg-up mt-1" id="kpiRevenueChange">--</div></div>
          <div class="kpi-icon" style="background:linear-gradient(135deg,#059669,#047857)"><i class="bi bi-cash-stack"></i></div>
        </div>
      </div>
    </div>
    <div class="col-xl col-lg-4 col-md-6">
      <div class="kpi-card h-100">
        <div class="d-flex justify-content-between align-items-start">
          <div><div class="kpi-label">Active Services</div><div class="kpi-value text-dark" id="kpiActiveServices">--</div><div class="kpi-change bg-up mt-1" id="kpiTodayBookings">--</div></div>
          <div class="kpi-icon" style="background:linear-gradient(135deg,#2563eb,#1d4ed8)"><i class="bi bi-tools"></i></div>
        </div>
      </div>
    </div>
    <div class="col-xl col-lg-4 col-md-6">
      <div class="kpi-card h-100">
        <div class="d-flex justify-content-between align-items-start">
          <div><div class="kpi-label">Orders</div><div class="kpi-value text-dark" id="kpiOrders">--</div><div class="kpi-change bg-up mt-1" id="kpiTodayOrders">--</div></div>
          <div class="kpi-icon" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed)"><i class="bi bi-bag-check"></i></div>
        </div>
      </div>
    </div>
    <div class="col-xl col-lg-4 col-md-6">
      <div class="kpi-card h-100">
        <div class="d-flex justify-content-between align-items-start">
          <div><div class="kpi-label">Customers</div><div class="kpi-value text-dark" id="kpiCustomers">--</div><div class="kpi-change bg-up mt-1" id="kpiNewCustomers">--</div></div>
          <div class="kpi-icon" style="background:linear-gradient(135deg,#ec4899,#db2777)"><i class="bi bi-people"></i></div>
        </div>
      </div>
    </div>
    <div class="col-xl col-lg-4 col-md-6">
      <div class="kpi-card h-100">
        <div class="d-flex justify-content-between align-items-start">
          <div><div class="kpi-label">Technicians</div><div class="kpi-value text-dark" id="kpiTechnicians">--</div><div class="kpi-change bg-up mt-1" id="kpiTechAvailable">--</div></div>
          <div class="kpi-icon" style="background:linear-gradient(135deg,#ea580c,#c2410c)"><i class="bi bi-person-gear"></i></div>
        </div>
      </div>
    </div>
    <div class="col-xl col-lg-4 col-md-6">
      <div class="kpi-card h-100">
        <div class="d-flex justify-content-between align-items-start">
          <div><div class="kpi-label">Avg Rating</div><div class="kpi-value text-dark" id="kpiAvgRating">--</div><div class="kpi-change bg-up mt-1" id="kpiTotalReviews">--</div></div>
          <div class="kpi-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706)"><i class="bi bi-star-fill"></i></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Revenue Trend + Booking Pipeline -->
  <div class="row g-4 mb-4">
    <div class="col-lg-8">
      <div class="section-card h-100">
        <div class="section-header"><h6><i class="bi bi-graph-up me-2 text-success"></i>Revenue Trend (7 Days)</h6><small class="text-muted" id="revenueSummary">--</small></div>
        <div class="section-body"><div class="chart-wrap" style="height:260px"><canvas id="revenueChart"></canvas></div></div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="section-card h-100">
        <div class="section-header"><h6><i class="bi bi-funnel me-2 text-primary"></i>Booking Pipeline</h6><small class="text-muted" id="pipelineTotal">-- total</small></div>
        <div class="section-body">
          <div class="pipeline-bar mb-2" id="pipelineBar"></div>
          <div class="pipeline-legend" id="pipelineLegend"></div>
          <hr>
          <div class="d-flex justify-content-between mb-1"><span class="text-muted" style="font-size:.82rem">Pending Payments</span><span class="fw-bold text-warning" id="pendingPayments">--</span></div>
          <div class="d-flex justify-content-between"><span class="text-muted" style="font-size:.82rem">Profit Margin</span><span class="fw-bold text-success" id="profitMargin">--</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Services Distribution + Inventory + Alerts -->
  <div class="row g-4 mb-4">
    <div class="col-lg-4">
      <div class="section-card h-100">
        <div class="section-header"><h6><i class="bi bi-pie-chart me-2 text-info"></i>Service Distribution</h6></div>
        <div class="section-body"><div class="chart-wrap" style="height:220px"><canvas id="serviceDistChart"></canvas></div></div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="section-card h-100">
        <div class="section-header"><h6><i class="bi bi-box-seam me-2 text-warning"></i>Inventory</h6></div>
        <div class="section-body" id="inventorySection">
          <div class="stat-row"><span class="text-muted" style="font-size:.85rem">Total Products</span><span class="fw-bold" id="invTotalProducts">--</span></div>
          <div class="stat-row"><span class="text-muted" style="font-size:.85rem">Total Units</span><span class="fw-bold" id="invTotalUnits">--</span></div>
          <div class="stat-row"><span class="text-muted" style="font-size:.85rem">In Stock</span><span class="fw-bold text-success" id="invInStock">--</span></div>
          <div class="stat-row"><span class="text-muted" style="font-size:.85rem">Low Stock</span><span class="fw-bold text-warning" id="invLowStock">--</span></div>
          <div class="stat-row"><span class="text-muted" style="font-size:.85rem">Out of Stock</span><span class="fw-bold text-danger" id="invOutOfStock">--</span></div>
          <hr>
          <h6 style="font-size:.8rem;color:#64748b" class="mb-2">Low Stock Items</h6>
          <div id="lowStockList"></div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="section-card h-100">
        <div class="section-header"><h6><i class="bi bi-exclamation-triangle me-2 text-danger"></i>Alerts</h6></div>
        <div class="section-body" id="alertsSection">
          <div class="alert-row"><div class="alert-dot" style="background:#f59e0b"></div><div class="flex-grow-1"><div style="font-size:.85rem" class="fw-semibold">Awaiting Assignment</div><small class="text-muted">Confirmed bookings with no technician</small></div><span class="badge bg-warning-subtle text-warning fw-bold" id="alertAssignment">0</span></div>
          <div class="alert-row"><div class="alert-dot" style="background:#dc3545"></div><div class="flex-grow-1"><div style="font-size:.85rem" class="fw-semibold">Low Ratings</div><small class="text-muted">1-2 star reviews need attention</small></div><span class="badge bg-danger-subtle text-danger fw-bold" id="alertLowRatings">0</span></div>
          <div class="alert-row"><div class="alert-dot" style="background:#0dcaf0"></div><div class="flex-grow-1"><div style="font-size:.85rem" class="fw-semibold">Low Stock</div><small class="text-muted">Products with 5 or fewer units</small></div><span class="badge bg-info-subtle text-info fw-bold" id="alertLowStock">0</span></div>
          <div class="alert-row"><div class="alert-dot" style="background:#8b5cf6"></div><div class="flex-grow-1"><div style="font-size:.85rem" class="fw-semibold">New Customers</div><small class="text-muted">Joined this month</small></div><span class="badge bg-purple-subtle text-purple fw-bold" id="alertNewCustomers">0</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Orders Section -->
  <div class="row g-4 mb-4">
    <div class="col-lg-5">
      <div class="section-card h-100">
        <div class="section-header"><h6><i class="bi bi-bag-check me-2 text-purple"></i>Order Pipeline</h6><small class="text-muted" id="orderPipelineTotal">-- total</small></div>
        <div class="section-body">
          <div class="pipeline-bar mb-2" id="orderPipelineBar"></div>
          <div class="pipeline-legend" id="orderPipelineLegend"></div>
          <hr>
          <div class="stat-row"><span class="text-muted" style="font-size:.85rem">Orders This Month</span><span class="fw-bold" id="orderThisMonth">--</span></div>
          <div class="stat-row"><span class="text-muted" style="font-size:.85rem">Order Revenue</span><span class="fw-bold text-success" id="orderRevenue">--</span></div>
          <div class="stat-row"><span class="text-muted" style="font-size:.85rem">Total Orders (All Time)</span><span class="fw-bold" id="orderTotalAllTime">--</span></div>
        </div>
      </div>
    </div>
    <div class="col-lg-7">
      <div class="section-card h-100">
        <div class="section-header"><h6><i class="bi bi-receipt me-2 text-secondary"></i>Recent Orders</h6></div>
        <div class="section-body" id="recentOrdersList"><div class="text-center text-muted py-3">No orders yet</div></div>
      </div>
    </div>
  </div>

  <!-- Technician Ratings + Customer Ratings + Sentiment -->
  <div class="row g-4 mb-4">
    <div class="col-lg-4">
      <div class="section-card h-100">
        <div class="section-header"><h6><i class="bi bi-trophy me-2 text-warning"></i>Top Technicians</h6><a href="/admin/ratings/technicians" class="text-primary" style="font-size:.8rem">View All</a></div>
        <div class="section-body" id="topTechList"><div class="text-center text-muted py-3">No data</div></div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="section-card h-100">
        <div class="section-header"><h6><i class="bi bi-star me-2 text-primary"></i>Customer Ratings</h6><a href="/admin/ratings/overview" class="text-primary" style="font-size:.8rem">View All</a></div>
        <div class="section-body">
          <div class="text-center mb-3">
            <div style="font-size:2.2rem;font-weight:800;line-height:1" id="ratingBig">--</div>
            <div id="ratingStars" class="mb-1"></div>
            <div class="text-muted" style="font-size:.8rem"><span id="totalReviewsText">0</span> reviews</div>
          </div>
          <div class="chart-wrap" style="height:120px"><canvas id="starDistChart"></canvas></div>
          <hr>
          <div class="d-flex justify-content-between" style="font-size:.82rem">
            <span class="text-muted">Sentiment</span>
            <span class="fw-bold" id="sentimentScore">--</span>
          </div>
          <div style="height:6px;background:#f1f5f9;border-radius:3px;overflow:hidden;margin-top:4px">
            <div id="sentBar" style="height:100%;background:#198754;border-radius:3px;width:0%;transition:width .6s"></div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="section-card h-100">
        <div class="section-header"><h6><i class="bi bi-chat-left-text me-2 text-success"></i>Recent Reviews</h6><a href="/admin/ratings/overview" class="text-primary" style="font-size:.8rem">View All</a></div>
        <div class="section-body" id="recentReviews"><div class="text-center text-muted py-3">No reviews</div></div>
      </div>
    </div>
  </div>

  <!-- Lowest Technicians + Expenses by Type -->
  <div class="row g-4 mb-4">
    <div class="col-lg-6">
      <div class="section-card h-100">
        <div class="section-header"><h6><i class="bi bi-exclamation-circle me-2 text-danger"></i>Lowest Rated Technicians</h6></div>
        <div class="section-body" id="lowestTechList"><div class="text-center text-muted py-3">No data</div></div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="section-card h-100">
        <div class="section-header"><h6><i class="bi bi-receipt me-2 text-secondary"></i>Expenses by Type</h6></div>
        <div class="section-body"><div class="chart-wrap" style="height:200px"><canvas id="expensesChart"></canvas></div></div>
      </div>
    </div>
  </div>

  <%- include('../../../partials/chart-drilldown-modal') %>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/chart-drilldown.js"></script>
<script src="/js/admin-dashboard.js?v=4"></script>
