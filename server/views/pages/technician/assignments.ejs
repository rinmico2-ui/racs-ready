    const serviceAnalyses = Array.isArray(ta.serviceAnalyses) ? ta.serviceAnalyses : [];
    const serviceAnalysisHtml = serviceAnalyses.map((analysis, index) => {
      const sources = (analysis._webSources || []).filter(url => /^https?:\/\//i.test(String(url))).slice(0, 3);
      const groundingClass = analysis._webResearchUsed ? 'bg-success' : analysis._webResearchFetched ? 'bg-warning text-dark' : 'bg-secondary';
      const groundingLabel = analysis._webResearchUsed ? 'Tavily grounded' : analysis._webResearchFetched ? 'Tavily fetched - not used' : analysis._source === 'fallback' ? 'Local reference' : 'AI reference';
      return `<div style="border:1px solid #dbeafe;border-radius:10px;padding:12px;margin-bottom:9px;background:#f8fbff;">
        <div style="display:flex;justify-content:space-between;gap:8px;align-items:flex-start;">
          <div><div style="font-size:.63rem;font-weight:800;color:#64748b;">REPAIR APPLIANCE ${index + 1} OF ${serviceAnalyses.length}</div><div style="font-size:.8rem;font-weight:750;color:#1e3a8a;">${safe(analysis.serviceName || analysis.unitType || 'Repair Service')}</div><div style="font-size:.68rem;color:#64748b;">${safe([analysis.brand, analysis.model, analysis.unitType].filter(Boolean).join(' · '))}</div></div>
          <span class="badge ${groundingClass}" style="font-size:.6rem;">${groundingLabel}</span>
        </div>
        <div style="font-size:.72rem;color:#334155;line-height:1.5;margin-top:8px;white-space:pre-line;">${safe(analysis.summary || 'On-site inspection is required to confirm the diagnosis.')}</div>
        ${analysis._webResearchUsed && sources.length ? `<div style="font-size:.65rem;margin-top:7px;color:#64748b;">Sources: ${sources.map((url, sourceIndex) => `<a href="${safe(url)}" target="_blank" rel="noopener noreferrer">${sourceIndex + 1}</a>`).join(' · ')}</div>` : ''}
      </div>`;
    }).join('');

    let top3Html = top3.map(c => {
      const pct = c.likelihood === 'high' ? '90%' : c.likelihood === 'medium' ? '65%' : '40%';
      const barColor = c.likelihood === 'high' ? '#2563eb' : c.likelihood === 'medium' ? '#f59e0b' : '#94a3b8';
      const barBg = c.likelihood === 'high' ? '#eff6ff' : c.likelihood === 'medium' ? '#fffbeb' : '#f8fafc';
      const borderC = c.likelihood === 'high' ? '#bfdbfe' : c.likelihood === 'medium' ? '#fde68a' : '#e2e8f0';
      return `<div class="mb-2" style="background:${barBg};border:1px solid ${borderC};border-radius:var(--mw-radius-xs);padding:12px 14px;">
        <div class="d-flex align-items-center justify-content-between mb-1">
