  .td-assign-badge { font-size: 0.7rem; padding: 3px 8px; border-radius: 6px; font-weight: 600; white-space: nowrap; }

  /* Active Job Card */
  .td-active-card {
    background: linear-gradient(135deg, #eff6ff 0%, #f0f9ff 100%);
    border: 1px solid #bfdbfe; border-radius: 14px; padding: 20px;
  }
  .td-active-card h5 { font-size: 1rem; font-weight: 700; color: #1e40af; margin: 0 0 10px; }
  .td-active-detail { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; color: #475569; margin-bottom: 6px; }
  .td-active-detail i { color: #3b82f6; width: 16px; }
  .td-active-actions { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }

  /* Repair Info Banner */
  .td-repair-banner {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 10px 14px; border-radius: 10px; margin-top: 10px; font-size: 0.8rem;
  }
  .td-repair-banner i { font-size: 1.1rem; margin-top: 2px; flex-shrink: 0; }
  .td-repair-banner strong { font-size: 0.82rem; }
  .td-repair-banner span { font-size: 0.75rem; opacity: 0.85; }

  /* Quick Actions */
  .td-quick-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .td-qa-btn {
    display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 10px;
    background: #f8fafc; border: 1px solid #eef2f7; text-decoration: none; color: #1e293b;
    font-size: 0.82rem; font-weight: 600; transition: all 0.15s;
    position: relative; min-width: 0; min-height: 62px;
  }
  .td-qa-btn:hover { background: #f1f5f9; border-color: #cbd5e1; transform: translateY(-1px); }
  .td-qa-icon {
    width: 36px; height: 36px; min-width: 36px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center; font-size: 1rem;
  }
  .td-qa-icon.blue { background: #eff6ff; color: #3b82f6; }
  .td-qa-icon.amber { background: #fffbeb; color: #f59e0b; }
  .td-qa-icon.green { background: #f0fdf4; color: #22c55e; }
  .td-qa-icon.rose { background: #fff1f2; color: #f43f5e; }
  .td-qa-icon.violet { background: #f5f3ff; color: #8b5cf6; }
  .td-qa-icon.emerald { background: #ecfdf5; color: #10b981; }
  .td-qa-label { min-width: 0; line-height: 1.25; overflow-wrap: anywhere; }
  .td-qa-badge {
    position: absolute;
    top: 6px;
    right: 8px;
    min-width: 18px;
    padding: 2px 5px;
    color: #fff;
    background: #dc2626;
    border: 2px solid #fff;
    border-radius: 999px;
    font-size: .58rem;
    font-weight: 800;
    line-height: 1;
    text-align: center;
  }

  /* Expense Summary */
  .td-expense-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; font-size: 0.82rem; }
  .td-expense-row span { color: #64748b; }
  .td-expense-row strong { color: #1e293b; font-size: 0.9rem; }

  /* Job Expenses Panel */
  #jobExpensesPanel .td-panel-body { padding: 14px 20px; }

  @media (max-width: 991px) {
    .td-work-grid { grid-template-columns: 1fr; }
    .td-hero-actions {
      justify-content: flex-start;
      gap: 12px;
    }
    .td-hero-stat {
      min-width: 70px;
      padding: 8px 12px;
    }
    .td-hero-stat .stat-num {
      font-size: 1.2rem;
    }
    .td-hero-stat .stat-label {
      font-size: 0.65rem;
    }
  }

  @media (max-width: 767px) {
    .td-hero {
      padding: 1.25rem;
      border-radius: 12px;
    }
    .td-hero-title {
      font-size: 1.25rem;
    }
    .td-hero-sub {
      font-size: 0.85rem;
    }
    .td-hero-date {
      font-size: 0.75rem;
    }
    .td-work-hub { padding: 14px; }
    .td-work-hub-header { align-items: flex-start; flex-direction: column; gap: 4px; }
    .td-hero-actions {
      width: 100%;
      justify-content: flex-start;
      gap: 0.75rem;
    }
    .td-hero-stat {
      flex: 1 1 calc(33.333% - 0.5rem);
      min-width: 80px;
      padding: 10px 12px;
    }
    .td-hero-stat .stat-num {
      font-size: 1.3rem;
    }
    .td-hero-stat .stat-label {
      font-size: 0.65rem;
    }
    .td-kpi-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    .td-kpi-card {
      padding: 1rem;
    }
    .td-kpi-icon {
      width: 40px;
      height: 40px;
      font-size: 1rem;
    }
    .td-kpi-value {
      font-size: 1.3rem;
    }
    .td-kpi-label {
      font-size: 0.7rem;
    }
    .td-panel-header {
      padding: 1rem 1.25rem;
    }
    .td-panel-title {
      font-size: 0.85rem;
    }
    .td-panel-link {
      font-size: 0.72rem;
    }
    .td-panel-body {
      padding: 1rem 1.25rem;
    }
    .td-assign-card {
      padding: 1rem;
      gap: 12px;
    }
    .td-assign-icon {
      width: 38px;
      height: 38px;
      min-width: 38px;
      font-size: 1rem;
    }
    .td-assign-info h6 {
