  // Generic essentials applied to any project.
  const TOOL_ESSENTIALS = [
    { name: 'Safety Helmet', qty: 4, type: 'tool' },
    { name: 'Work Gloves', qty: 8, type: 'part' },
    { name: 'Tool Box', qty: 2, type: 'equipment' },
