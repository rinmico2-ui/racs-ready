  .wa-product-image{height:150px;background:linear-gradient(145deg,#f8fafc,#eef4ff);display:grid;place-items:center;padding:1rem}.wa-product-image img{width:100%;height:100%;object-fit:contain}.wa-product-image i{font-size:3rem;color:#93c5fd}
  .wa-product-body{display:flex;flex-direction:column;gap:.55rem;padding:.9rem;flex:1}.wa-brand{text-transform:uppercase;letter-spacing:.08em;color:#2563eb;font-weight:800;font-size:.65rem}.wa-product h3{margin:0;color:#172033;font-size:.94rem;font-weight:750}.wa-chips{display:flex;gap:.35rem;flex-wrap:wrap}.wa-chip{padding:.2rem .45rem;border-radius:999px;background:#eff6ff;color:#1d4ed8;font-size:.65rem;font-weight:700}.wa-product select{width:100%;border:1px solid #dbe3ee;border-radius:9px;padding:.5rem;font-size:.76rem;background:#fff}.wa-price-row{display:flex;align-items:center;justify-content:space-between;gap:.5rem;margin-top:auto}.wa-price{font-weight:850;color:#0f172a}.wa-stock{font-size:.68rem;color:#15803d}.wa-add{border:0;border-radius:9px;padding:.52rem .7rem;background:#2563eb;color:#fff;font-weight:750;font-size:.76rem}.wa-add:hover{background:#1d4ed8}.wa-add:disabled{opacity:.5}
  .wa-empty{grid-column:1/-1;text-align:center;padding:4rem 1rem;color:#64748b}.wa-empty i{display:block;font-size:2rem;color:#cbd5e1;margin-bottom:.5rem}
  .wa-checkout{position:relative}.wa-checkout-head{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.1rem;border-bottom:1px solid #edf2f7;background:linear-gradient(135deg,#fff,#f8fbff)}.wa-checkout-head h3{font-size:1rem;font-weight:800;margin:0}.wa-checkout-sub{display:block;margin-top:.2rem;color:#64748b;font-size:.68rem}.wa-count{display:grid;place-items:center;min-width:30px;height:30px;padding:0 .45rem;border-radius:9px;background:#dbeafe;color:#1d4ed8;font-size:.75rem;font-weight:800}
  .wa-cart{max-height:235px;overflow:auto;padding:.75rem 1rem}.wa-cart-item{display:grid;grid-template-columns:1fr auto;gap:.4rem;padding:.65rem 0;border-bottom:1px solid #f1f5f9}.wa-cart-name{font-size:.78rem;font-weight:750;color:#1e293b}.wa-cart-meta{font-size:.68rem;color:#64748b}.wa-cart-controls{display:flex;align-items:center;gap:.4rem}.wa-cart-controls button{width:25px;height:25px;border:1px solid #dbe3ee;border-radius:7px;background:#fff;color:#334155}.wa-cart-controls span{min-width:18px;text-align:center;font-size:.75rem;font-weight:800}.wa-cart-total{font-size:.78rem;font-weight:800;color:#1d4ed8;text-align:right}
  .wa-form{padding:1rem;border-top:1px solid #edf2f7;background:#f8fafc}.wa-section{margin-bottom:.85rem;padding:.9rem;border:1px solid #e5eaf2;border-radius:13px;background:#fff}.wa-section-title{display:flex;align-items:center;gap:.45rem;margin:0 0 .7rem;font-size:.72rem;font-weight:850;text-transform:uppercase;letter-spacing:.05em;color:#334155}.wa-section-title i{display:grid;place-items:center;width:25px;height:25px;border-radius:8px;background:#eff6ff;color:#2563eb}.wa-fields{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}.wa-wide{grid-column:1/-1}.wa-field{width:100%;min-height:40px;border:1px solid #cfd9e6;border-radius:9px;background:#fff;padding:.6rem .7rem;font-size:.77rem;outline:none}.wa-label{display:block;font-size:.68rem;color:#475569;font-weight:750;margin-bottom:.3rem}.wa-choice{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem}.wa-choice button{min-height:68px;border:1px solid #dbe3ee;border-radius:10px;padding:.55rem .35rem;background:#fff;color:#64748b;font-size:.69rem;font-weight:750;transition:.18s ease}.wa-choice button i{font-size:1rem;margin-bottom:.2rem}.wa-choice button small{display:block;margin-top:.15rem;color:#94a3b8;font-size:.57rem;font-weight:600}.wa-choice button:hover{border-color:#93c5fd;background:#f8fbff}.wa-choice button.active{background:#eff6ff;color:#1d4ed8;border-color:#60a5fa;box-shadow:0 0 0 2px rgba(37,99,235,.08)}.wa-choice button.active small{color:#3b82f6}
  .wa-address-wrap{position:relative}.wa-address-results{position:absolute;z-index:30;left:0;right:0;top:100%;max-height:170px;overflow:auto;background:#fff;border:1px solid #dbe3ee;border-radius:9px;box-shadow:0 12px 26px rgba(15,23,42,.16)}.wa-address-results button{width:100%;border:0;border-bottom:1px solid #f1f5f9;background:#fff;padding:.65rem;text-align:left;font-size:.72rem;color:#334155}.wa-address-results button:hover{background:#eff6ff}
  .wa-quote{display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.6rem .7rem;margin-top:.15rem;border-radius:9px;background:#eff6ff;color:#1e40af;font-size:.69rem}
  .wa-schedule-card{overflow:hidden;border:1px solid #dbe5f0;border-radius:12px;background:#fff}.wa-calendar-head{display:grid;grid-template-columns:34px 1fr 34px;align-items:center;gap:.35rem;padding:.65rem .7rem;border-bottom:1px solid #edf2f7;background:#f8fafc}.wa-calendar-head h5{margin:0;text-align:center;font-size:.8rem;font-weight:850;color:#1e293b}.wa-cal-nav{width:32px;height:32px;border:1px solid #d7e0eb;border-radius:9px;background:#fff;color:#334155}.wa-cal-nav:hover:not(:disabled){border-color:#60a5fa;color:#1d4ed8;background:#eff6ff}.wa-cal-nav:disabled{opacity:.35;cursor:not-allowed}.wa-weekdays,.wa-calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:3px;padding:0 .55rem}.wa-weekdays{padding-top:.55rem}.wa-weekdays span{text-align:center;color:#94a3b8;font-size:.57rem;font-weight:850;text-transform:uppercase}.wa-calendar{min-height:220px;padding-top:.35rem;padding-bottom:.6rem;align-content:start}.wa-date,.wa-cal-blank{aspect-ratio:1/1;min-width:0}.wa-date{position:relative;border:1px solid transparent;border-radius:9px;background:#f8fafc;padding:.25rem .1rem;text-align:center;color:#334155;transition:.16s ease}.wa-date strong{display:block;font-size:.73rem;line-height:1}.wa-date small{display:block;margin-top:.2rem;color:#16a34a;font-size:.5rem;font-weight:800}.wa-date.available{border-color:#bbf7d0;background:#f0fdf4}.wa-date.available:hover{transform:translateY(-1px);border-color:#4ade80;box-shadow:0 4px 10px rgba(22,163,74,.12)}.wa-date.active{background:#2563eb;border-color:#2563eb;color:#fff;box-shadow:0 5px 12px rgba(37,99,235,.24)}.wa-date.active small{color:#dbeafe}.wa-date.unavailable{color:#cbd5e1;background:#fafafa;cursor:not-allowed}.wa-date.today:after{content:"";position:absolute;bottom:4px;left:50%;width:4px;height:4px;margin-left:-2px;border-radius:50%;background:#f59e0b}.wa-calendar-state{display:flex;align-items:center;justify-content:center;gap:.45rem;min-height:42px;padding:.55rem .7rem;border-top:1px solid #e