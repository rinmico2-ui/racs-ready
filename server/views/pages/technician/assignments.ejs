  .ent-panel .trk-detail-label { font-size:0.58rem; color:#94a3b8; letter-spacing:0.07em; }
  .ent-panel .trk-detail-value { font-size:0.8rem; color:#0f172a; font-weight:700; }
  .ent-panel .trk-detail-subsection { background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:8px 10px; margin-bottom:6px; }
  .ent-panel .trk-detail-subhead { font-size:0.7rem; color:#1d4ed8; }
  .ent-panel .trk-payment-summary { margin-top:12px; padding:12px; background:linear-gradient(135deg,#f0fdf4,#f8fafc); border:1px solid #bbf7d0; border-radius:14px; }
  .ent-panel .trk-payment-line { display:flex; justify-content:space-between; align-items:center; padding:5px 0; font-size:0.78rem; color:#475569; }
  .ent-panel .trk-payment-line span:first-child { font-weight:600; }
