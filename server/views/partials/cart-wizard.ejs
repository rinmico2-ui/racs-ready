<style>
  /* ── Progress Stepper (like services.ejs) ── */
  .wizard-progress {
    background: #fff;
    padding: 1.25rem 1.75rem 0.75rem;
    margin-bottom: 0;
  }
  .wizard-ph {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .wizard-ph span:first-child {
    font-size: 0.78rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }
  .wizard-ph span:last-child {
    font-size: 0.72rem;
    color: #64748b;
    font-weight: 600;
  }
  .wizard-pt {
    display: flex;
    justify-content: space-between;
    background: #f1f5f9;
    border-radius: 9999px;
    padding: 3px;
    gap: 2px;
  }
  .wizard-ps {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 0.72rem;
    font-weight: 600;
    color: #94a3b8;
    white-space: nowrap;
    flex: 1;
    justify-content: center;
  }
  .wizard-ps.active {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #fff;
    box-shadow: 0 4px 12px rgba(37,99,235,0.25);
  }
  .wizard-ps.completed {
    background: #f0fdf4;
    color: #16a34a;
  }
  .wizard-ps:hover:not(.active) {
    background: #e2e8f0;
    color: #475569;
  }
  .wizard-ps-icon {
    font-size: 0.85rem;
    display: flex;
  }

  .payment-method-card.selected {
    border-color: #2563eb !important;
    background: #eff6ff !important;
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.1) !important;
    transform: translateY(-3px);
  }

  .fulfill-card {
    border: 2px solid #e2e8f0;
    border-radius: 1.5rem;
    padding: 2rem 1.5rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: white;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .fulfill-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #3b82f6, #2563eb);
    opacity: 0;
    transition: opacity 0.35s;
  }

  .fulfill-card:hover {
    border-color: #93c5fd;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.05);
  }

  .fulfill-card.selected {
    border-color: #2563eb;
    background: linear-gradient(135deg, #eff6ff, #faf5ff);
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.1);
  }

  .fulfill-card.selected::before {
    opacity: 1;
  }

  .fulfill-card.selected .fulfill-icon {
    transform: scale(1.1);
    box-shadow: 0 5px 15px rgba(37, 99, 235, 0.2);
  }

  .fulfill-title {
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.5rem;
    font-size: 1.15rem;
  }

  .fulfill-desc {
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .wizard-panel {
    display: none;
    animation: fadeSlideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .wizard-panel.active {
    display: block;
  }

  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── RACS Van Loading Animation ── */
  .racs-loader{background:linear-gradient(160deg,#1e3a8a 0%,#1e40af 50%,#312e81 100%);border-radius:24px;padding:40px 32px;max-width:520px;margin:0 auto;box-shadow:0 25px 60px -15px rgba(30,58,138,0.5);position:relative;overflow:hidden}
  .racs-scene{position:relative;height:220px;margin-bottom:28px;overflow:hidden;border-radius:16px;background:linear-gradient(180deg,rgba(255,255,255,0.06) 0%,rgba(255,255,255,0.02) 100%)}
  .racs-glow{position:absolute;top:40%;left:0;width:100%;height:140px;background:linear-gradient(90deg,transparent 0%,rgba(96,165,250,0.15) 30%,rgba(96,165,250,0.25) 50%,rgba(96,165,250,0.15) 70%,transparent 100%);pointer-events:none;animation:racsGlow 3s ease-in-out infinite}
  @keyframes racsGlow{0%{opacity:0.3}50%{opacity:1}100%{opacity:0.3}}
  .racs-vanwrap{position:absolute;bottom:15px;left:0;width:380px;animation:racsDrive 3s ease-in-out infinite, racsBob 0.5s ease-in-out infinite alternate}
  @keyframes racsDrive{0%{left:-100px;opacity:0}10%{opacity:1}90%{opacity:1}100%{left:calc(100% + 100px);opacity:0}}
  @keyframes racsBob{from{transform:translateY(0)}to{transform:translateY(-4px)}}
  .racs-vanwrap svg{width:100%;height:auto;display:block;transform:scaleX(-1)}
  .racs-wheel{transform-box:fill-box;transform-origin:center;animation:racsSpin 0.4s linear infinite}
  @keyframes racsSpin{to{transform:rotate(360deg)}}
  .racs-fan{transform-box:fill-box;transform-origin:17.5px 15px;animation:racsFanSpin 0.8s linear infinite}
  @keyframes racsFanSpin{to{transform:rotate(360deg)}}
  .racs-track{position:absolute;bottom:0;left:0;width:100%;height:20px}
  .racs-track-dash{position:absolute;bottom:8px;left:0;width:200%;height:4px;background:repeating-linear-gradient(90deg,rgba(255,255,255,0.5) 0,rgba(255,255,255,0.5) 30px,transparent 30px,transparent 60px);animation:racsTrack 0.5s linear infinite}
  @keyframes racsTrack{from{transform:translateX(0)}to{transform:translateX(-60px)}}
  .racs-progress{width:100%;height:6px;background:rgba(255,255,255,0.12);border-radius:99px;overflow:hidden;margin-bottom:22px}
  .racs-progress-fill{height:100%;width:35%;border-radius:99px;background:linear-gradient(90deg,#60a5fa,#38bdf8,#60a5fa);background-size:200% 100%;animation:racsProg 1.5s ease-in-out infinite,racsShimmer 2s linear infinite}
  @keyframes racsProg{0%{transform:translateX(-100%)}100%{transform:translateX(386%)}}
  @keyframes racsShimmer{0%{background-position:0% 0}100%{background-position:200% 0}}
  .racs-title{display:block;text-align:center;font-size:1.25rem;font-weight:700;color:#fff;margin-bottom:8px;letter-spacing:0.3px}
  .racs-desc{display:block;text-align:center;font-size:0.88rem;color:rgba(255,255,255,0.65);margin-bottom:18px}
  .racs-pulse{display:flex;justify-content:center;gap:8px}
  .racs-pulse span{width:10px;height:10px;border-radius:50%;background:#60a5fa;animation:racsPulse 1.4s ease-in-out infinite}
  .racs-pulse span:nth-child(2){animation-delay:0.2s}
  .racs-pulse span:nth-child(3){animation-delay:0.4s}
  @keyframes racsPulse{0%,100%{opacity:0.3;transform:scale(0.7)}50%{opacity:1;transform:scale(1.15)}}

  .review-row {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px dashed rgba(0, 0, 0, 0.05);
  }

  .review-row:last-child {
    border-bottom: none;
  }

  .review-label {
    color: #64748b;
    font-weight: 500;
    font-size: 0.9rem;
  }

  .review-value {
    color: #0f172a;
    font-weight: 700;
    text-align: right;
  }

  #wizardMap {
    height: 380px;
    width: 100%;
    z-index: 1;
    background: #e8eef7;
    transition: height 0.25s ease;
  }
  .checkout-map-card {
    overflow: hidden;
    border: 1px solid #dbe3ee;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 8px 26px rgba(15,23,42,.07);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .checkout-map-card:focus-within,
  .checkout-map-card:hover {
    border-color: #93c5fd;
    box-shadow: 0 10px 30px rgba(37,99,235,.1);
  }
  .checkout-map-card.map-expanded #wizardMap { height: 540px; }
  .checkout-map-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .85rem;
    padding: .85rem 1rem;
    border-bottom: 1px solid #e2e8f0;
    background: linear-gradient(180deg,#fff,#f8fafc);
  }
  .checkout-map-title { margin: 0; color: #0f172a; font-size: .82rem; font-weight: 800; }
  .checkout-map-subtitle { margin-top: 2px; color: #64748b; font-size: .67rem; line-height: 1.35; }
  .checkout-map-actions { display: flex; align-items: center; gap: .35rem; flex-shrink: 0; }
  .checkout-map-action {
    display: inline-flex; align-items: center; justify-content: center; gap: .35rem;
    min-height: 34px; padding: .35rem .65rem; border: 1px solid #dbe3ee;
    border-radius: 8px; background: #fff; color: #334155; font-size: .68rem; font-weight: 700;
  }
  .checkout-map-action:hover:not(:disabled) { border-color: #93c5fd; background: #eff6ff; color: #1d4ed8; }
  .checkout-map-action:disabled { cursor: not-allowed; opacity: .45; }
  .checkout-map-stage { position: relative; }
  .checkout-map-legend {
    position: absolute; left: 10px; bottom: 24px; z-index: 800;
    display: flex; flex-direction: column; gap: 5px; padding: 8px 10px;
    border: 1px solid rgba(203,213,225,.9); border-radius: 9px;
    background: rgba(255,255,255,.94); color: #334155; font-size: .64rem; font-weight: 700;
    box-shadow: 0 4px 14px rgba(15,23,42,.12); backdrop-filter: blur(6px);
  }
  .checkout-map-legend span { display: flex; align-items: center; gap: 6px; }
  .map-legend-dot { width: 9px; height: 9px; border-radius: 50%; background: #2563eb; box-shadow: 0 0 0 2px #dbeafe; }
  .map-legend-dot.customer { background: #ef4444; box-shadow: 0 0 0 2px #fee2e2; }
  .map-selection-panel {
    display: grid; grid-template-columns: minmax(0,1fr) auto; gap: .9rem;
    padding: .85rem 1rem; border-top: 1px solid #e2e8f0; background: #fff;
  }
  .map-selection-address { display: flex; align-items: flex-start; gap: .65rem; min-width: 0; }
  .map-selection-icon {
    display: inline-flex; align-items: center; justify-content: center; flex: 0 0 32px;
    width: 32px; height: 32px; border-radius: 9px; background: #f1f5f9; color: #64748b;
  }
  .map-selection-panel.has-location .map-selection-icon { background: #dcfce7; color: #15803d; }
  .map-selection-status { color: #b45309; font-size: .66rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  .map-selection-panel.has-location .map-selection-status { color: #15803d; }
  .map-address-preview { max-width: 100%; margin-top: 2px; overflow: hidden; color: #334155; font-size: .72rem; font-weight: 600; line-height: 1.4; text-overflow: ellipsis; }
  .map-coordinate-card { min-width: 156px; padding-left: .9rem; border-left: 1px solid #e2e8f0; text-align: right; }
  .map-coordinate-label { color: #94a3b8; font-size: .6rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .map-coordinate-value { margin-top: 3px; color: #334155; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; font-size: .68rem; font-weight: 700; }
  .map-coordinate-source { margin-top: 2px; color: #64748b; font-size: .62rem; }
  .checkout-map-card .leaflet-control-layers,
  .checkout-map-card .leaflet-bar { border: 0; border-radius: 9px; box-shadow: 0 3px 14px rgba(15,23,42,.16); }
  .checkout-map-card .leaflet-control-layers-toggle { width: 36px; height: 36px; background-size: 18px 18px; }
  .checkout-map-card .leaflet-control-zoom a { color: #1e3a8a; }
  .checkout-map-card .leaflet-popup-content-wrapper { border-radius: 10px; box-shadow: 0 8px 28px rgba(15,23,42,.18); }
  .checkout-map-card .leaflet-popup-content { margin: 11px 13px; font-size: .72rem; line-height: 1.45; }

  /* ── Route Info Panel ───────────────────────────────── */
  .route-info-panel {
    display: none;
    background: linear-gradient(135deg, #f8faff 0%, #f0f4ff 100%);
    border: 1.5px solid #c7d2fe;
    border-radius: 0.875rem;
    padding: 0.85rem 1rem;
    margin-top: 0.6rem;
    animation: fadeInUp 0.35s cubic-bezier(.22,.68,0,.99);
    position: relative;
    overflow: hidden;
  }
  .route-info-panel::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 4px; height: 100%;
    background: linear-gradient(180deg, #6366f1, #0284c7);
    border-radius: 4px 0 0 4px;
  }
  .route-info-panel.has-route {
    display: block;
  }
  .route-stat-card {
    background: #fff;
    border-radius: 0.6rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid #e0e7ef;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-width: 0;
    text-align: center;
    box-shadow: 0 1px 4px rgba(99,102,241,0.07);
    transition: box-shadow 0.2s;
  }
  .route-stat-card:hover { box-shadow: 0 3px 12px rgba(99,102,241,0.13); }
  .route-stat-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 2px;
    white-space: nowrap;
  }
  .route-stat-value {
    font-size: 1.05rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1.2;
  }
  .route-stat-value.fare-value {
    color: #4f46e5;
  }
  .route-stat-icon {
    font-size: 0.95rem;
    margin-bottom: 2px;
  }
  .route-method-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 99px;
    background: #e0e7ff;
    color: #4f46e5;
    letter-spacing: 0.04em;
  }
  .route-method-badge.haversine {
    background: #fef3c7;
    color: #92400e;
  }
  .route-calculation-detail {
    font-size: 0.72rem;
    color: #64748b;
    text-align: center;
    margin-top: 0.35rem;
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .map-locating-spinner {
    position: absolute;
    top: 52px; right: 10px;
    background: rgba(255,255,255,0.9);
    border-radius: 0.5rem;
    padding: 4px 10px;
    font-size: 0.73rem;
    font-weight: 600;
    color: #4f46e5;
    display: none;
    align-items: center;
    gap: 5px;
    z-index: 1000;
    backdrop-filter: blur(4px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  .map-locating-spinner.show { display: flex; }

  .custom-map-pin {
    position: relative;
    width: 40px;
    height: 40px;
  }

  .custom-map-pin .pin-body {
    width: 30px;
    height: 30px;
    background: #ef4444;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    position: absolute;
    top: 0;
    left: 5px;
    box-shadow: 0 4px 8px rgba(239, 68, 68, 0.4);
    border: 3px solid white;
  }

  .custom-map-pin .pin-body::after {
    content: '';
    width: 10px;
    height: 10px;
    background: white;
    border-radius: 50%;
    position: absolute;
    top: 7px;
    left: 7px;
  }

  .custom-map-pin.tech-pin .pin-body::after {
    display: none;
  }
  .custom-map-pin.tech-pin .pin-body i {
    transform: rotate(45deg);
    font-size: 0.9rem;
    line-height: 1;
  }

  /* Keep the pickup calendar anchored to its input inside the scrollable modal. */
  .wizard-modal .flatpickr-wrapper {
    display: block;
    width: 100%;
  }
  .wizard-modal .flatpickr-wrapper .form-control { width: 100%; }
  .wizard-modal .flatpickr-calendar.static {
    width: min(330px, 100%) !important;
    max-width: 100% !important;
    left: 0 !important;
    right: auto !important;
    top: calc(100% + 6px) !important;
    z-index: 1080 !important;
    box-sizing: border-box !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 10px !important;
    box-shadow: 0 12px 30px rgba(15,23,42,.14) !important;
  }
  .wizard-modal .flatpickr-calendar.inline {
    position: relative !important;
    width: min(330px, 100%) !important;
    max-width: 100% !important;
    top: auto !important;
    left: auto !important;
    margin: 10px 0 0 !important;
    box-shadow: none !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 10px !important;
    box-sizing: border-box !important;
  }
  .wizard-modal .flatpickr-calendar:is(.static, .inline) .flatpickr-rContainer,
  .wizard-modal .flatpickr-calendar:is(.static, .inline) .flatpickr-days,
  .wizard-modal .flatpickr-calendar:is(.static, .inline) .dayContainer {
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
  }

  /* Override: pickup panel calendar should fill full width */
  .pickup-panel .flatpickr-calendar.inline {
    width: 100% !important;
    max-width: 100% !important;
  }

  @media (max-width: 576px) {
    .wizard-ps {
      padding: 5px 8px;
      font-size: 0.65rem;
      gap: 4px;
    }
    .wizard-ps-icon {
      font-size: 0.75rem;
    }
    .wizard-progress {
      padding: 1rem 1rem 0.5rem;
    }
    #wizardMap { height: 310px; }
    .checkout-map-card.map-expanded #wizardMap { height: 430px; }
    .checkout-map-toolbar { align-items: flex-start; flex-direction: column; }
    .checkout-map-actions { width: 100%; }
    .checkout-map-action { flex: 1; padding-left: .45rem; padding-right: .45rem; }
    .checkout-map-action span { display: none; }
    .map-selection-panel { grid-template-columns: 1fr; }
    .map-coordinate-card { padding: .7rem 0 0 42px; border-top: 1px solid #f1f5f9; border-left: 0; text-align: left; }
    .checkout-map-legend { bottom: 20px; }
  }
  /* ── Pickup Panel ── */
  .pickup-panel {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 1.5rem;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(15,36,96,0.06);
    margin-bottom: 1rem;
  }
  .pickup-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .pickup-store {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #f0f7ff, #e0f2fe);
    border: 1px solid #bae6fd;
    border-radius: 1rem;
    padding: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .pickup-store-bg-icon {
    position: absolute;
    top: 0;
    right: 0;
    font-size: 6rem;
    color: #0284c7;
    opacity: 0.1;
    transform: translate(20%, -20%);
  }
  .pickup-store-name {
    position: relative;
    font-size: 1rem;
    font-weight: 700;
    color: #0369a1;
  }
  .pickup-store-note {
    position: relative;
    margin: 0.25rem 0 0;
    font-size: 0.82rem;
    font-weight: 500;
    color: #0284c7;
  }
  .pickup-date-wrap { position: relative; margin-top: 1.25rem; }
  .pickup-date-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.75rem;
  }
  .pickup-date-input {
    width: 100%;
    padding: 0.65rem 1rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    font-size: 0.9rem;
    color: #0f172a;
    background: #fff;
    transition: all 0.2s;
  }
  .pickup-date-input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
    outline: none;
  }
  .pickup-date-input::placeholder { color: #94a3b8; }
  .pickup-calendar-wrapper {
    width: 100%;
    overflow: visible;
  }
  /* Premium inline Flatpickr */
  .pickup-panel .flatpickr-calendar {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin: 0.75rem 0 0;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    box-shadow: 0 10px 30px rgba(15,36,96,0.08);
    background: #fff;
    box-sizing: border-box;
  }
  .pickup-panel .flatpickr-months {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    border-radius: 1rem 1rem 0 0;
    padding: 0.4rem 0;
  }
  .pickup-panel .flatpickr-month,
  .pickup-panel .flatpickr-current-month { color: #fff; }
  .pickup-panel .flatpickr-prev-month,
  .pickup-panel .flatpickr-next-month { fill: #fff; color: #fff; }
  .pickup-panel .flatpickr-weekdays { background: #f8fafc; padding: 0.5rem 0.75rem; width: 100% !important; }
