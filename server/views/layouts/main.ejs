<!DOCTYPE html>
<html lang="en">
  <head>
    <%
      const lightweightPage = typeof lightweightPublicPage !== 'undefined' && lightweightPublicPage === true;
      const renderLandingChatbot = typeof showLandingChatbot !== 'undefined' && showLandingChatbot === true;
      const renderedPage = typeof body === 'string' ? body : '';
      const pageUsesAos = /data-aos(?:=|\s|>)/i.test(renderedPage);
      const pageUsesLeaflet = /leaflet|typeof\s+L\b|\bL\s*\./i.test(renderedPage);
      const pageUsesBookingCalendar = /enterprise-calendar|checkout-calendar/i.test(renderedPage);
    %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title><%= title %></title>
    <script src="/js/performance.js?v=20260911"></script>
    <script src="/js/esri-hybrid-layer.js?v=20260915-esri-overzoom-v4"></script>

    <!-- Bootstrap CSS (CDN) -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
      rel="stylesheet"
    />

    <% if (!lightweightPage) { %>
    <!-- SweetAlert2 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/enterprise-alerts.css?v=20260906-modal-layering" />

    <% if (pageUsesAos) { %>
    <!-- AOS is only needed by pages containing scroll-animation elements. -->
    <link
      href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css"
      rel="stylesheet"
    />
    <% } %>
    <% } %>

    <!-- Font - Using local Ubuntu font instead of Google Fonts -->
    <style>
      @font-face {
        font-family: 'Montserrat';
        font-style: normal;
        font-weight: 400;
        src: local('Ubuntu Regular'), local('Ubuntu-Regular');
      }
      @font-face {
        font-family: 'Montserrat';
        font-style: normal;
        font-weight: 500;
        src: local('Ubuntu Medium'), local('Ubuntu-Medium');
      }
      @font-face {
        font-family: 'Montserrat';
        font-style: normal;
        font-weight: 700;
        src: local('Ubuntu Bold'), local('Ubuntu-Bold');
      }
      body {
        font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
    </style>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/navbar.css" />
    <% if (!lightweightPage) { %>
    <link rel="stylesheet" href="/css/servicescards.css" />
    <!-- custom fonts removed (using Google Fonts CDN) -->
    <link rel="stylesheet" href="/css/staffs.css" />
    <% } %>
    <link rel="stylesheet" href="/css/performance.css?v=20260911" />
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <main><%- body %></main>

    <%- include('../partials/footer') %>

    <!-- Bootstrap JS (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <% if (!lightweightPage) { %>
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/enterprise-alerts.js?v=20260906-modal-layering"></script>

    <% if (pageUsesLeaflet) { %>
    <!-- Maps are expensive to parse; only map pages receive Leaflet. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />

    <!-- Leaflet JS -->
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
      // Initialize Leaflet callback
      function initLeafletMap() {
        console.log('Leaflet ready');
        window.leafletLoaded = true;
      }
      
      // Initialize immediately since Leaflet doesn't need callback
      document.addEventListener('DOMContentLoaded', function() {
        window.leafletLoaded = true;
      });
    </script>
    <% } %>
    <% if (pageUsesAos) { %>
    <!-- AOS Animation (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <% } %>
    <% } %>

    <!-- Navbar Active Link Script -->
    <script src="/js/navbar-active.js"></script>
    <% if (!lightweightPage && pageUsesAos) { %>
    <script src="/js/animations.js"></script>
    <% } %>
    <script src="/js/cta.js"></script>
    <script src="/js/navbar-auth.js"></script>

    <% if (renderLandingChatbot) { %>
    <!-- AI Chatbot: intentionally available only on the landing page. -->
    <%- include('../partials/chatbot') %>
    <% } %>

    <% if (!lightweightPage && pageUsesBookingCalendar) { %>
    <!-- Fetch booking policy (minimum advance notice) for calendar components -->
    <script>
      (function() {
        window.__bookingPolicy = { minAdvanceNoticeMinutes: 120 };
        fetch('/api/schedule/booking-policy', { cache: 'no-store' })
          .then(function(r) { return r.ok ? r.json() : null; })
          .then(function(data) {
            if (data && data.minAdvanceNoticeMinutes) {
              window.__bookingPolicy.minAdvanceNoticeMinutes = data.minAdvanceNoticeMinutes;
            }
          })
          .catch(function() {});
      })();
    </script>
    <% } %>
  </body>
</html>
