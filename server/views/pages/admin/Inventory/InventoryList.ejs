      if (spInput) spInput.addEventListener('input', () => computeVariantMargin(variantId));
      if (cpInput) cpInput.addEventListener('input', () => computeVariantMargin(variantId));
      computeVariantMargin(variantId);

      // Store variant data
      variantsData2.push({ variantId, data: variantData || {} });
