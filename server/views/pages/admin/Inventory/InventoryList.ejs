            <div class="col-md-4">
              <label class="inv-field-label small">Status</label>
              <select class="inv-select" data-field="status">
                <option value="in_stock" ${variantData?.status === 'in_stock' ? 'selected' : ''}>In Stock</option>
                <option value="low_stock" ${variantData?.status === 'low_stock' ? 'selected' : ''}>Low Stock</option>
                <option value="out_of_stock" ${variantData?.status === 'out_of_stock' ? 'selected' : ''}>Out of Stock</option>
              </select>
            </div>
          </div>
        </div>
      `;
      
      container.appendChild(variantRow);
    }

    // Remove variant function
    function removeVariantRow(variantId) {
      const variantRow = document.getElementById(`variant_${variantId}`);
      if (variantRow) {
        variantRow.remove();
        // Update variant numbers
        const container = document.getElementById('variantsContainer');
        Array.from(container.children).forEach((row, index) => {
          const titleElement = row.querySelector('h6');
          if (titleElement) {
            titleElement.innerHTML = `<i class="bi bi-box me-1"></i>Variant ${index + 1}`;
          }
        });
      }
    }

    // Event delegation for remove variant buttons
    document.body.addEventListener('click', async function(e) {
      if (e.target.matches('.remove-variant') || e.target.closest('.remove-variant')) {
        const btn = e.target.matches('.remove-variant') ? e.target : e.target.closest('.remove-variant');
        const variantId = btn.dataset.variantId;
        if (await showInvConfirm('Remove this variant?', '<small>Are you sure you want to remove this variant?</small>', 'Remove', 'Cancel', 'warning')) {
          removeVariantRow(variantId);
        }
      }
    });

    // Get variants data function
    function getVariantsData() {
      const variants = [];
      const container = document.getElementById('variantsContainer');
      
      Array.from(container.children).forEach(variantRow => {
        const variantData = {};
        variantRow.querySelectorAll('[data-field]').forEach(input => {
          const field = input.dataset.field;
          const value = input.type === 'number' ? 
            (parseFloat(input.value) || 0) : input.value;
          variantData[field] = value;
        });
        
        // Only add variant if it has required fields
        if (variantData.capacity && variantData.sellingPrice) {
          variants.push(variantData);
        }
      });
      
      return variants;
    }

    // ── Form Alert Helpers ─────────────────────────────────────────────────────
    const formAlertEl = document.getElementById('inventoryFormAlert');
    function showFormAlert(type, msg) {
      formAlertEl.className = 'alert alert-' + type + ' mb-3';
      formAlertEl.textContent = msg;
      formAlertEl.classList.remove('d-none');
    }
    function hideFormAlert() {
      formAlertEl.classList.add('d-none');
    }

    // ── Image Upload Logic ───────────────────────────────────────────────────────
    let uploadedImageData = null;
    
    // Image upload event listener
    document.getElementById('invImage').addEventListener('change', function(e) {
      const file = e.target.files[0];
      const nameEl = document.getElementById('invImageName');
      if (file) {
        if (nameEl) nameEl.textContent = file.name;
        // Validate file size (5MB max)
        if (file.size > 5 * 1024 * 1024) {
          showFormAlert('danger', 'Image size must be less than 5MB');
          e.target.value = '';
          if (nameEl) nameEl.textContent = 'No file chosen';
          return;
        }
        
        // Validate file type
        if (!file.type.startsWith('image/')) {
          showFormAlert('danger', 'Please select a valid image file');
          e.target.value = '';
          if (nameEl) nameEl.textContent = 'No file chosen';
          return;
        }
        
        // Read and preview the image
        const reader = new FileReader();
        reader.onload = function(e) {
          uploadedImageData = e.target.result;
          showImagePreview(uploadedImageData);
        };
        reader.readAsDataURL(file);
      } else {
        if (nameEl) nameEl.textContent = 'No file chosen';
      }
    });
    
    // Remove image button
    document.getElementById('removeImageBtn').addEventListener('click', function() {
      uploadedImageData = null;
      document.getElementById('invImage').value = '';
      hideImagePreview();
    });
    
    function showImagePreview(imageSrc) {
      try {
        const preview = document.getElementById('invImagePreview');
        const placeholder = document.getElementById('invImagePlaceholder');
        const img = preview.querySelector('img');
        const removeBtn = document.getElementById('removeImageBtn');
        
        if (!preview || !placeholder || !img) {
          console.error('Image preview elements not found');
          return;
        }
        
        img.src = imageSrc;
        preview.style.display = 'block';
        placeholder.style.display = 'none';
        if (removeBtn) removeBtn.style.display = 'inline-flex';
      } catch (error) {
        console.error('Error in showImagePreview:', error);
      }
    }
    
    function hideImagePreview() {
      try {
        const preview = document.getElementById('invImagePreview');
        const placeholder = document.getElementById('invImagePlaceholder');
        const removeBtn = document.getElementById('removeImageBtn');
        const nameEl = document.getElementById('invImageName');
        
        if (!preview || !placeholder) {
          console.error('Image preview elements not found');
          return;
        }
        
        preview.style.display = 'none';
        placeholder.style.display = 'flex';
        if (removeBtn) removeBtn.style.display = 'none';
        if (nameEl) nameEl.textContent = 'No file chosen';
      } catch (error) {
        console.error('Error in hideImagePreview:', error);
      }
    }

    // ── Modal Logic ────────────────────────────────────────────────────────────
    function openModal(item) {
      try {
        const mEl = document.getElementById('addItemModal');
        if (!mEl) {
          console.error('addItemModal element not found');
          return;
        }
        
        const modal = bootstrap && bootstrap.Modal
          ? bootstrap.Modal.getInstance(mEl) || new bootstrap.Modal(mEl)
          : null;
          
        const titleEl = document.getElementById('addItemModalTitle');
        if (!titleEl) {
          console.error('addItemModalTitle element not found');
          return;
        }
        
        hideFormAlert();

        // Reset image state
        uploadedImageData = null;
        const invImageEl = document.getElementById('invImage');
        if (invImageEl) invImageEl.value = '';

        // Clear variants container
        const variantsContainer = document.getElementById('variantsContainer');
        if (variantsContainer) {
          variantsContainer.innerHTML = '';
          variantIdCounter = 0;
        }

        if (item) {
          editingId = item._id;
          
          // Check if this is a variant edit (has variantId) or product edit
          if (item.variantId) {
            titleEl.innerHTML = '<i class="bi bi-snow2"></i> Edit HP Variant';
            // Hide add variant button for single variant edit
            const addVariantBtn = document.getElementById('addVariantBtn');
            if (addVariantBtn) addVariantBtn.style.display = 'none';
          } else {
            titleEl.innerHTML = '<i class="bi bi-snow2"></i> Edit HVAC Product';
            // Show add variant button for product edit
            const addVariantBtn = document.getElementById('addVariantBtn');
            if (addVariantBtn) addVariantBtn.style.display = 'block';
          }
          
          // Product-level fields
          const modelLineEl = document.getElementById('invModelLine');
          if (modelLineEl) modelLineEl.value = item.modelLine || '';
          
          const brandEl = document.getElementById('invBrand');
          if (brandEl) brandEl.value = (item.brand && item.brand._id) || item.brand || '';
          
          const categoryEl = document.getElementById('invCategory');
          if (categoryEl) categoryEl.value = (item.category && item.category._id) || item.category || '';
          
          const typeEl = document.getElementById('invType');
          if (typeEl) typeEl.value = item.type || 'split';
          
          const inverterEl = document.getElementById('invInverter');
          if (inverterEl) inverterEl.checked = !!item.inverter;
          
          const statusEl = document.getElementById('invStatus');
          if (statusEl) statusEl.value = item.status || '';
          
          const warrantyEl = document.getElementById('invWarranty');
          if (warrantyEl) warrantyEl.value = item.warranty || '';
          
          const descriptionEl = document.getElementById('invDescription');
          if (descriptionEl) descriptionEl.value = item.description || '';
          
          // Handle existing image
          if (item.imageUrl && item.imageUrl !== '/images/products/default.png') {
            showImagePreview(item.imageUrl);
          } else {
            hideImagePreview();
          }

          // Load existing variants for product edit
          if (item.variants && item.variants.length > 0) {
            item.variants.forEach(variant => {
              addVariantRow(variant);
            });
          } else if (item.capacity && item.sellingPrice) {
            // Single variant edit (from grouped table)
            addVariantRow({
              capacity: item.capacity,
              btu: item.btu,
              sellingPrice: item.sellingPrice,
              costPrice: item.costPrice,
              quantity: item.quantity,
              minStockLevel: item.minStockLevel,
              status: item.status,
              _id: item._id
            });
          }
        } else {
          editingId = null;
          titleEl.innerHTML = '<i class="bi bi-snow2"></i> Add HVAC Product';
          
          // Show add variant button for new product
          const addVariantBtn = document.getElementById('addVariantBtn');
          if (addVariantBtn) addVariantBtn.style.display = 'block';
          
          const formEl = document.getElementById('inventoryForm');
          if (formEl) formEl.reset();
          
          hideImagePreview();
          
          // Add one empty variant for new product
          addVariantRow();
        }
        
        modal && modal.show();
      } catch (error) {
        console.error('Error in openModal:', error);
        showInvToast('Error opening modal: ' + error.message, 'error');
      }
    }
    window.openInventoryModal = openModal;


    // ── Event Delegation ──────────────────────────────────────────────────────
    document.body.addEventListener('click', function (e) {
      // Edit individual item
      if (e.target.matches('.edit-inventory')) {
        const id = e.target.dataset.id;
        const item = inventoryData.find((i) => i._id === id);
        if (item) openModal(item);
      }

      // Edit individual variant
      if (e.target.matches('.edit-variant') || e.target.closest('.edit-variant')) {
        const btn = e.target.matches('.edit-variant') ? e.target : e.target.closest('.edit-variant');
        const id = btn.dataset.id;
        const item = inventoryData.find((i) => i._id === id);
        if (item) openModal(item);
      }

      // Edit grouped item - show first variant for now
      if (e.target.matches('.edit-grouped') || e.target.closest('.edit-grouped')) {
        const btn = e.target.matches('.edit-grouped') ? e.target : e.target.closest('.edit-grouped');
        const modelName = btn.dataset.model;
        const brandName = btn.dataset.brand;
        const item = inventoryData.find((i) => 
          i.modelLine === modelName && 
          ((i.brand && i.brand.name) || i.brand || 'Unknown') === brandName
        );
        if (item && item.variants && item.variants.length > 0) {
          // Pass the first variant for editing
          const firstVariant = {
            ...item,
            capacity: item.variants[0].capacity,
            btu: item.variants[0].btu,
            sellingPrice: item.variants[0].sellingPrice,
            costPrice: item.variants[0].costPrice,
            quantity: item.variants[0].quantity,
            minStockLevel: item.variants[0].minStockLevel,
            variantId: item.variants[0]._id
          };
          openModal(firstVariant);
        }
      }

      // Manage variants for grouped item
      if (e.target.matches('.manage-variants') || e.target.closest('.manage-variants')) {
        const btn = e.target.matches('.manage-variants') ? e.target : e.target.closest('.manage-variants');
        const modelName = btn.dataset.model;
        const brandName = btn.dataset.brand;
        const item = inventoryData.find((i) => 
          i.modelLine === modelName && 
          ((i.brand && i.brand.name) || i.brand || 'Unknown') === brandName
        );
        if (item) {
          editingId = item._id;
          openVariantsModal();
        }
      }
    });

    // ── Variants Modal Management ─────────────────────────────────────────────
    let currentEditingProduct = null;
    let variantsData2 = [];
    let variantIdCounter2 = 0;

    function openVariantsModal() {
      currentEditingProduct = editingId;
      const product = inventoryData.find(i => i._id === currentEditingProduct);
      
      if (!product) return;
      
      // Set product name
      document.getElementById('variantsModalSubtitle').textContent = 
        `${product.modelLine || 'Unknown'} - ${(product.brand && product.brand.name) || product.brand || 'Unknown'}`;
      
      // Clear and load all variants for this product
      variantsData2 = [];
      variantIdCounter2 = 0;
      document.getElementById('variantsContainer2').innerHTML = '';
      
      // Load all variants of this product
      if (product.variants && product.variants.length > 0) {
        product.variants.forEach((variant, index) => {
          addVariantRow2({
            capacity: variant.capacity,
            btu: variant.btu,
            sellingPrice: variant.sellingPrice,
            costPrice: variant.costPrice,
            quantity: variant.quantity,
            minStockLevel: variant.minStockLevel,
            _id: variant._id
          });
        });
      } else {
        // Add empty variant if none exist
        addVariantRow2();
      }
      
      // Show modal (reuse or create a single Bootstrap Modal instance)
      const mEl = document.getElementById('variantsModal');
      const modal = bootstrap && bootstrap.Modal
        ? (bootstrap.Modal.getInstance(mEl) || new bootstrap.Modal(mEl))
        : null;
      if (modal) modal.show();
    }

    function addVariantRow2(variantData = null) {
      const variantId = variantData?._id || `variant_${++variantIdCounter2}`;
      const container = document.getElementById('variantsContainer2');
      const variantNumber = container.children.length + 1;
      
      const variantRow = document.createElement('div');
