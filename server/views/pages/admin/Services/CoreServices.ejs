          </div>
        </div>
        <div class="stat-sparkline"><canvas id="sparkCoreActive" height="40"></canvas></div>
      </div>
    </div>
    <div class="col-lg col-md-6">
      <div class="dash-card h-100" data-accent="amber" data-aos="fade-up" data-aos-delay="200">
