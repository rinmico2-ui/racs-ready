      { value: 'under_maintenance', label: 'Under Maintenance', icon: 'bi-wrench', color: '#8b5cf6' },
      { value: 'damaged', label: 'Damaged', icon: 'bi-exclamation-triangle', color: '#ef4444' },
      { value: 'retired', label: 'Retired', icon: 'bi-x-circle', color: '#64748b' }
