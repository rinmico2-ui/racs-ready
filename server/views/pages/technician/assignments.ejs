          ${insp.severity ? `<div class="detail-row"><label>Severity</label><span class="badge ${insp.severity === 'critical' ? 'bg-danger' : insp.severity === 'major' ? 'bg-warning text-dark' : 'bg-info'}" style="font-size:0.65rem;">${insp.severity.toUpperCase()}</span></div>` : ''}
          ${insp.recommendedAction ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Action</label><span style="text-align:left;font-size:0.78rem;">${insp.recommendedAction}</span></div>` : ''}
