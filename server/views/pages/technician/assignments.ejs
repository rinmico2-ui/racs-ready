    window.transitionStatus = async function (id, status, btn) {
      if (status === 'completed') {
        // Always look up from allItems to avoid stale data
        let a = allItems.find(item => String(item._id) === String(id));
        if (!a && window._detailAssignment && String(window._detailAssignment._id) === String(id)) {
          a = window._detailAssignment;
        }
        if (a && ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && !a.balanceCollected && (a.balanceAmount || 0) > 0) {
          showNotification({ type: 'warning', title: 'Payment Required', message: 'You must collect the remaining balance before completing this job.', duration: 5000 });
          openCollectPaymentModal(id, a, true);
          return;
        }
      }

      // ── Front-end En Route Time Guard ────────────────────────────────────
      if (status === 'en_route') {
        let a = allItems.find(item => String(item._id) === String(id));
        if (!a && window._detailAssignment && String(window._detailAssignment._id) === String(id)) {
          a = window._detailAssignment;
        }
        if (a && !canEnRoute(a)) {
          const label = enRouteAvailableLabel(a);
          showNotification({
            type: 'warning',
            title: 'Too Early to Go En Route',
            message: `You can only mark yourself as "En Route" on the day of the booking and at or after the scheduled time${label ? ' (' + label + ')' : '.'}.`,
            duration: 6000
          });
          return;
        }
      }

      const labels = { en_route: 'mark as En Route', on_site: 'mark as Arrived', in_progress: 'start work', completed: 'mark as Completed' };
      if (!confirm(`Confirm: ${labels[status] || status}?`)) return;

      window._btnLoading(btn, async () => {
        const res = await fetch(`/api/technician/assignments/${id}/status`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
          body: JSON.stringify({ status })
        });
        const data = await res.json();
        if (res.ok) {
          const statusLabels = { en_route: 'En Route', on_site: 'Arrived On Site', in_progress: 'Work In Progress', completed: 'Job Completed' };
          showNotification({
            type: status === 'completed' ? 'success' : 'info',
            title: 'Status Updated',
            message: `Status changed to "${statusLabels[status] || status}".`,
            duration: 4000
          });
          // ── Auto-open route map when going en route ──
          if (status === 'en_route') {
            let a = allItems.find(item => String(item._id) === String(id));
            if (!a && window._detailAssignment && String(window._detailAssignment._id) === String(id)) {
              a = window._detailAssignment;
            }
            if (a) {
              const custLat = a.customerLat || (a.location?.coordinates?.[1]) || (a.location?.lat) || '';
              const custLng = a.customerLng || (a.location?.coordinates?.[0]) || (a.location?.lng) || '';
              setTimeout(() => {
                if (window.openRouteMapModal) {
                  window.openRouteMapModal(custLat, custLng, a.customerName || 'Customer', a.address || '');
                }
              }, 500);
            }
          }
          // ── Auto-hide route map when arriving on site ──
          if (status === 'on_site' && window.hideRoutePanel) {
            window.hideRoutePanel();
          }
          loadAssignments(currentFilter, currentPage);
          // Also refresh detail panel if it's currently open
          if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
            showDetail(window._currentDetailId);
          }
        } else {
          // Handle TOO_EARLY specifically for better UX
          if (data.code === 'TOO_EARLY') {
            showNotification({
              type: 'warning',
              title: 'Not Yet Time',
              message: data.error || 'You cannot go en route yet.',
              duration: 7000
            });
          } else {
            showNotification({ type: 'error', title: 'Update Failed', message: data.error || 'Failed to update status', duration: 5000 });
          }
        }
      });
    };

    window.markNoShow = async function (id, btn) {
      const confirmResult = await Swal.fire({
        title: 'Mark as No Show?',
        html: '<p style="color:#64748b;font-size:0.9rem;">The customer was not available. An email will be sent notifying them and providing reschedule options.</p>',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: '<i class="bi bi-person-x me-1"></i> Yes, Mark No Show',
        cancelButtonText: 'Go Back',
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#64748b',
      });
      if (!confirmResult.isConfirmed) return;

      Swal.fire({ title: 'Processing...', html: 'Marking as No Show and notifying customer...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

      try {
        const res = await fetch(`/api/technician/assignments/${id}/no-show`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin'
        });
        const data = await res.json();
        Swal.close();

        if (!res.ok) {
          Swal.fire('Action Failed', data.error || 'Failed to process', 'error');
          return;
        }

        showNotification({ type: 'warning', title: 'No Show Reported', message: 'Customer notified via email.', duration: 4000 });
        loadAssignments(currentFilter, currentPage);
        if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
          showDetail(window._currentDetailId);
        }

        // Offer reschedule or cancel
        const followUp = await Swal.fire({
          title: 'What\'s Next?',
          html: '<p style="color:#64748b;font-size:0.9rem;margin-bottom:8px;">The customer has been notified. What would you like to do with this booking?</p>',
          icon: 'info',
          showDenyButton: true,
          showCancelButton: true,
          confirmButtonText: '<i class="bi bi-calendar3 me-1"></i> Reschedule Now',
          denyButtonText: '<i class="bi bi-x-circle me-1"></i> Cancel Booking',
          cancelButtonText: 'Close',
          confirmButtonColor: '#2563eb',
          denyButtonColor: '#dc2626',
          cancelButtonColor: '#64748b',
        });

        if (followUp.isConfirmed) {
          await openNoShowReschedule(id);
        } else if (followUp.isDenied) {
          const cancelConfirm = await Swal.fire({
            title: 'Cancel Booking?',
            html: '<p style="color:#64748b;font-size:0.9rem;">This will permanently cancel the booking and notify the customer.</p>',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Cancel',
            cancelButtonText: 'Go Back',
            confirmButtonColor: '#dc2626',
          });
          if (cancelConfirm.isConfirmed) {
            Swal.fire({ title: 'Cancelling...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
            const cancelRes = await fetch(`/api/technician/assignments/${id}/no-show-cancel`, {
              method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin'
            });
            const cancelData = await cancelRes.json();
            Swal.close();
            if (cancelRes.ok) {
              Swal.fire('Cancelled', 'Booking has been cancelled.', 'success');
              loadAssignments(currentFilter, currentPage);
            } else {
              Swal.fire('Error', cancelData.error || 'Failed to cancel.', 'error');
            }
          }
        }
      } catch (e) {
        Swal.close();
        Swal.fire('Error', 'Network error.', 'error');
      }
    };

    // ── No-Show Reschedule Flow ────────────────────────────────────────────
    async function openNoShowReschedule(assignmentId) {
      // Find the assignment to get duration
      const assignment = (window._allAssignments || []).find(a => String(a._id) === String(assignmentId));
      const duration = assignment?.bookingId?.technicianAssistant?.estimatedDurationMinutes
        || assignment?.bookingId?.service?.durationMinutes
        || assignment?.bookingId?.service?.estimatedDurationMinutes
        || 90;

      // Load available dates
      Swal.fire({ title: 'Loading Available Dates...', html: 'Checking schedule capacity...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
      let availableDates = [];
      try {
        const resp = await fetch(`/api/technician/appointments/available-dates?duration=${duration}`, { credentials: 'same-origin' });
        const data = await resp.json();
        Swal.close();
        if (resp.ok && data.dates) {
          availableDates = data.dates;
        } else {
          Swal.fire('Error', 'Failed to load available dates.', 'error');
          return;
        }
      } catch (e) {
        Swal.close();
        Swal.fire('Error', 'Network error loading dates.', 'error');
        return;
      }

      // Build date grid
      const dateHtml = availableDates.map(d => {
        const dt = new Date(d.date + 'T00:00:00');
        const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        const dayLabel = dayNames[dt.getDay()];
        const monthDay = `${monthNames[dt.getMonth()]} ${dt.getDate()}`;

        if (d.available) {
          const slotsText = d.remainingSlots === 1 ? '1 slot left' : `${d.remainingSlots} slots left`;
          return `<label class="nsched-date-card available" data-date="${d.date}">
            <input type="radio" name="nsSchedDate" value="${d.date}" class="d-none">
            <div class="nsched-date-day">${dayLabel}</div>
            <div class="nsched-date-md">${monthDay}</div>
            <div class="nsched-date-slots"><i class="bi bi-check-circle-fill"></i> ${slotsText}</div>
          </label>`;
        } else {
          return `<label class="nsched-date-card unavailable" title="${d.reason}">
            <div class="nsched-date-day">${dayLabel}</div>
            <div class="nsched-date-md">${monthDay}</div>
            <div class="nsched-date-slots"><i class="bi bi-x-circle-fill"></i> ${d.reason}</div>
          </label>`;
        }
      }).join('');

      const { value: formValues } = await Swal.fire({
        title: 'Reschedule Booking',
        html: `<div style="text-align:left;font-size:0.9rem;">
          <style>
            .nsched-date-card{display:flex;flex-direction:column;align-items:center;gap:4px;padding:14px 10px;border:2px solid #e2e8f0;border-radius:14px;cursor:pointer;transition:all 0.2s;min-width:90px;text-align:center;}
            .nsched-date-card.available{background:#eff6ff;border-color:#bfdbfe;}
            .nsched-date-card.available:hover{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,0.15);}
            .nsched-date-card.available:has(input:checked){border-color:#2563eb;background:#dbeafe;box-shadow:0 0 0 3px rgba(59,130,246,0.2);}
            .nsched-date-card.unavailable{background:#f8fafc;border-color:#e2e8f0;opacity:0.55;cursor:not-allowed;}
            .nsched-date-day{font-weight:700;font-size:0.82rem;color:#1e293b;}
            .nsched-date-md{font-size:0.75rem;color:#64748b;}
            .nsched-date-slots{font-size:0.68rem;color:#2563eb;margin-top:2px;}
            .nsched-date-card.unavailable .nsched-date-slots{color:#94a3b8;}
          </style>
          <p style="color:#475569;margin-bottom:12px;">Select a new date and time window for this booking:</p>
          <div class="mb-3">
            <label class="form-label fw-bold" style="font-size:0.82rem;"><i class="bi bi-calendar3 me-1" style="color:#2563eb;"></i>Available Dates</label>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:10px;" id="nsAvailDates">${dateHtml}</div>
          </div>
          <div class="mb-2">
            <label class="form-label fw-bold" style="font-size:0.82rem;"><i class="bi bi-clock me-1" style="color:#2563eb;"></i>Preferred Time Window</label>
            <div class="d-flex flex-wrap gap-2">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="nsSchedTime" value="any" id="ns_time_any" checked>
                <label class="form-check-label" for="ns_time_any" style="font-size:0.82rem;">Any Time (8AM-5PM)</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="nsSchedTime" value="morning" id="ns_time_morning">
                <label class="form-check-label" for="ns_time_morning" style="font-size:0.82rem;">Morning (8AM-12PM)</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="nsSchedTime" value="afternoon" id="ns_time_afternoon">
                <label class="form-check-label" for="ns_time_afternoon" style="font-size:0.82rem;">Afternoon (12PM-5PM)</label>
              </div>
            </div>
          </div>
        </div>`,
        showCancelButton: true,
        confirmButtonText: '<i class="bi bi-arrow-right me-1"></i> Pick Time Slot',
        cancelButtonText: 'Back',
        confirmButtonColor: '#2563eb',
        focusConfirm: false,
        allowOutsideClick: false,
        didOpen: () => {
          document.querySelectorAll('.nsched-date-card.available').forEach(card => {
            card.addEventListener('click', () => {
              document.querySelectorAll('.nsched-date-card.available').forEach(c => c.classList.remove('selected'));
              card.classList.add('selected');
              card.querySelector('input[type="radio"]').checked = true;
            });
          });
        },
        preConfirm: () => {
          const selected = document.querySelector('input[name="nsSchedDate"]:checked');
          const timeRadio = document.querySelector('input[name="nsSchedTime"]:checked');
          if (!selected) { Swal.showValidationMessage('Please select an available date'); return false; }
          return { preferredDate: selected.value, preferredTimeWindow: timeRadio ? timeRadio.value : 'any' };
        }
      });

      if (!formValues) return;

      // Now show time slots for the selected date
      const selectedDateStr = formValues.preferredDate;
      const timeWindow = formValues.preferredTimeWindow;

      Swal.fire({ title: 'Loading Time Slots...', html: `Fetching slots for ${selectedDateStr}...`, allowOutsideClick: false, didOpen: () => Swal.showLoading() });

      let timeSlots = [];
      try {
        const slotUrl = `/api/schedule/time-slots?date=${selectedDateStr}&duration=${duration}&preferredTimeWindow=${timeWindow}`;
        const slotResp = await fetch(slotUrl, { credentials: 'same-origin' });
        const slotData = await slotResp.json();
        Swal.close();
        if (slotResp.ok && slotData.slots) {
          timeSlots = slotData.slots;
        } else {
          Swal.fire('Error', 'Failed to load time slots.', 'error');
          return;
        }
      } catch (e) {
        Swal.close();
        Swal.fire('Error', 'Network error loading time slots.', 'error');
        return;
      }

      // Build time slot grid
      const slotHtml = timeSlots.map(s => {
        const booked = !s.available && !s.isPast;
        const isDisabled = s.isPast || booked;
        return `<label class="nsched-slot${isDisabled ? ' unavailable' : ''}" data-start="${s.startTime}" ${!isDisabled ? 'role="button"' : ''}>
          <input type="radio" name="nsSchedSlot" value="${s.startTime}" class="d-none" ${isDisabled ? 'disabled' : ''}>
          <div class="nsched-slot-time">${s.startTime}</div>
          <div class="nsched-slot-status">${s.isPast ? 'Passed' : (booked ? 'Fully Booked' : 'Open')}</div>
        </label>`;
      }).join('');

      const dateObj = new Date(selectedDateStr + 'T00:00:00');
      const formattedDate = dateObj.toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

      const { value: slotValues } = await Swal.fire({
        title: 'Select Time Slot',
        html: `<div style="text-align:left;font-size:0.9rem;">
          <style>
            .nsched-slot{display:flex;flex-direction:column;align-items:center;gap:2px;padding:12px 10px;border:2px solid #e2e8f0;border-radius:12px;cursor:pointer;transition:all 0.2s;min-width:80px;text-align:center;}
            .nsched-slot:not(.unavailable):hover{border-color:#2563eb;box-shadow:0 0 0 3px rgba(59,130,246,0.15);}
            .nsched-slot:has(input:checked){border-color:#2563eb;background:#dbeafe;box-shadow:0 0 0 3px rgba(59,130,246,0.2);}
            .nsched-slot.unavailable{opacity:0.45;cursor:not-allowed;background:#f8fafc;}
            .nsched-slot-time{font-weight:700;font-size:0.82rem;color:#1e293b;}
            .nsched-slot-status{font-size:0.68rem;color:#64748b;}
            .nsched-slot.unavailable .nsched-slot-status{color:#94a3b8;}
          </style>
          <p style="color:#475569;margin-bottom:4px;">${formattedDate}</p>
          <p style="color:#94a3b8;font-size:0.82rem;margin-bottom:12px;">Choose an available time slot:</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:10px;" id="nsSlotGrid">${slotHtml}</div>
        </div>`,
        showCancelButton: true,
        confirmButtonText: '<i class="bi bi-check-lg me-1"></i> Confirm Reschedule',
        cancelButtonText: 'Pick Another Date',
        confirmButtonColor: '#2563eb',
        focusConfirm: false,
        allowOutsideClick: false,
        didOpen: () => {
          document.querySelectorAll('.nsched-slot:not(.unavailable)').forEach(card => {
            card.addEventListener('click', () => {
              document.querySelectorAll('.nsched-slot').forEach(c => c.classList.remove('selected'));
              card.classList.add('selected');
              card.querySelector('input[type="radio"]').checked = true;
            });
          });
        },
        preConfirm: () => {
          const selectedSlot = document.querySelector('input[name="nsSchedSlot"]:checked');
          if (!selectedSlot) { Swal.showValidationMessage('Please select a time slot'); return false; }
          return { startTime: selectedSlot.value };
        }
      });

      if (!slotValues) {
        // User clicked "Pick Another Date" — restart
        return openNoShowReschedule(assignmentId);
      }

      // Final confirmation
      const finalDateObj = new Date(selectedDateStr + 'T00:00:00');
      const finalFormatted = finalDateObj.toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

      const finalConfirm = await Swal.fire({
        title: 'Confirm Reschedule',
        html: `<div style="text-align:left;font-size:0.9rem;">
          <p>Please confirm the new schedule:</p>
          <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:14px 16px;">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
              <i class="bi bi-calendar-check" style="color:#2563eb;font-size:1.2rem;"></i>
              <strong style="color:#1e40af;">${finalFormatted}</strong>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
              <i class="bi bi-clock" style="color:#2563eb;font-size:1.1rem;"></i>
              <span style="color:#1e40af;">${slotValues.startTime}</span>
            </div>
          </div>
        </div>`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: '<i class="bi bi-check-lg me-1"></i> Yes, Reschedule',
        cancelButtonText: 'Go Back',
        confirmButtonColor: '#2563eb',
      });

      if (!finalConfirm.isConfirmed) {
        return openNoShowReschedule(assignmentId);
      }

      // Submit reschedule
      Swal.fire({ title: 'Rescheduling...', html: 'Updating booking...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
      try {
        const res = await fetch(`/api/technician/assignments/${assignmentId}/no-show-reschedule`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
          body: JSON.stringify({ newDate: selectedDateStr, newTime: slotValues.startTime })
        });
        const data = await res.json();
        if (res.ok) {
          Swal.fire('Rescheduled!', 'Booking has been rescheduled successfully.', 'success');
          loadAssignments(currentFilter, currentPage);
        } else {
          Swal.fire('Error', data.error || 'Failed to reschedule.', 'error');
        }
      } catch (e) {
        Swal.close();
        Swal.fire('Error', 'Network error.', 'error');
      }
    }

    // ── Collect Payment Modal ─────────────────────────────────────────────
    let collectTargetId = null;
    let collectTargetAssignment = null;

    window.openCollectPaymentModal = function (id, assignment, autoComplete = false, postPaymentAction = null) {
      collectTargetId = id;
      collectTargetAssignment = assignment;
      window._completeAfterPayment = autoComplete;
      window._postPaymentAction = postPaymentAction;
      const _b = assignment?.bookingId || {};
      // Compute correct total: repairs = inspectionFee + travelFee + quotation, core = totalPrice
      const _isRepairPay = (_b.serviceType === 'repair') || ((_b.services || assignment.services) && Array.isArray(_b.services || assignment.services) && (_b.services || assignment.services).some(s => s.type === 'repair'));
      let total = 0;
      if (_isRepairPay) {
        const inspFee = _b.inspectionFeeTotalCollected || _b.initialCost || assignment.initialCost || 0;
        const travelFee = _b.travelFare || 0;
        const quotTotal = (_b.quotation && _b.quotation.totalCost) || 0;
        total = inspFee + travelFee + quotTotal;
      }
      if (!total) total = assignment.totalPrice || assignment.estimatedFee || _b.totalPrice || _b.totalCost || 0;
      // Downpayment already collected at booking — show it so the technician
      // isn't confused about the remaining balance to collect on-site.
      const downpayment = Number(_b.downpaymentAmount || assignment.downpaymentAmount || 0);
      const dpRow = document.getElementById('paymentDownpaymentRow');
      const dpEl = document.getElementById('paymentDownpayment');
      if (downpayment > 0) {
        dpRow.style.display = 'flex';
        dpEl.textContent = '-₱' + downpayment.toLocaleString();
      } else {
        dpRow.style.display = 'none';
        dpEl.textContent = '-₱0';
      }
      // Remaining balance = stored balance, but fall back to (total - downpayment)
      // so the technician collects only what's actually left.
      let balance = assignment.balanceAmount || _b.balanceAmount;
      if (!balance || balance > total) balance = Math.max(0, total - downpayment);
      document.getElementById('paymentTotalFee').textContent = '₱' + total.toLocaleString();
      document.getElementById('paymentBalanceDue').textContent = '₱' + balance.toLocaleString();
      document.getElementById('paymentPartsTotal').textContent = '₱0';
      document.getElementById('paymentLaborCost').textContent = '₱0';
      document.getElementById('paymentAmountInput').value = balance;
      document.getElementById('paymentAmountInput').max = balance;
      document.getElementById('paymentAmountHint').textContent = `Enter the full balance amount (max ₱${balance.toLocaleString()})`;
      document.getElementById('paymentNotesInput').value = '';
      document.getElementById('paymentErrorBox').classList.add('d-none');
      document.getElementById('confirmCollectBtn').disabled = false;
      document.getElementById('confirmCollectBtn').innerHTML = '<i class="bi bi-check-circle me-1"></i>Collect Payment';
      document.getElementById('paymentModalSubtitle').textContent = `${assignment.customerName || 'Customer'} — ${assignment.serviceName || 'Service'}`;

      // Service & Customer Summary
      document.getElementById('paymentServiceName').textContent = assignment.serviceName || '—';
      document.getElementById('paymentCustomerName').textContent = assignment.customerName || '—';
      document.getElementById('paymentCustomerAddress').textContent = assignment.address ? (assignment.address.length > 60 ? assignment.address.substring(0, 60) + '...' : assignment.address) : '—';

      // Fetch quotation data from booking
      const bookingId = assignment.bookingId?._id || assignment.bookingId;
      const quotationBox = document.getElementById('paymentQuotationBox');
      const quotationParts = document.getElementById('paymentQuotationParts');
      const repairBox = document.getElementById('paymentRepairBox');
      const repairParts = document.getElementById('paymentRepairParts');
      const repairActions = document.getElementById('paymentRepairActions');
      const repairNotes = document.getElementById('paymentRepairNotes');
      const inspectionBox = document.getElementById('paymentInspectionBox');
      const inspectionFindings = document.getElementById('paymentInspectionFindings');
      const inspectionDiagnosis = document.getElementById('paymentInspectionDiagnosis');
      if (bookingId) {
        fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' })
          .then(r => r.json())
          .then(detail => {
            const booking = detail.booking || detail;

            // Populate inspection findings
            const insp = booking.inspection || {};
            const diag = booking.diagnosis || {};
            const hasInspection = insp.findings || diag.findings || insp.recommendedAction || insp.severity;
            if (hasInspection) {
              inspectionBox.style.display = 'block';
              inspectionFindings.textContent = insp.findings || diag.findings || '—';
              // Severity
              const severityRow = document.getElementById('paymentInspectionSeverityRow');
              if (insp.severity) {
                severityRow.style.display = 'block';
                const sevEl = document.getElementById('paymentInspectionSeverity');
                const sevColors = { minor: '#16a34a', major: '#d97706', critical: '#dc2626' };
                sevEl.innerHTML = `<span style="color:${sevColors[insp.severity] || '#334155'};font-weight:600;text-transform:capitalize;">${insp.severity}</span>`;
              } else { severityRow.style.display = 'none'; }
              // Damaged Parts
              const damagedRow = document.getElementById('paymentInspectionDamagedRow');
              const damagedParts = insp.damagedParts || diag.damagedParts;
              if (damagedParts && damagedParts.length) {
                damagedRow.style.display = 'block';
                document.getElementById('paymentInspectionDamagedParts').innerHTML = damagedParts.map(p => `<span style="background:#fef2f2;color:#991b1b;padding:2px 8px;border-radius:6px;font-size:0.78rem;margin-right:4px;">${p}</span>`).join('');
              } else { damagedRow.style.display = 'none'; }
              // Diagnosis
              inspectionDiagnosis.textContent = diag.findings || insp.diagnosis || '—';
              // Recommended Action
              const actionRow = document.getElementById('paymentInspectionActionRow');
              if (insp.recommendedAction) {
                actionRow.style.display = 'block';
                document.getElementById('paymentInspectionRecommendedAction').textContent = insp.recommendedAction;
              } else { actionRow.style.display = 'none'; }
            } else {
              inspectionBox.style.display = 'none';
            }

            // Populate quotation
            const q = booking.quotation || {};
            const qParts = q.parts || [];
            if (qParts.length > 0 || q.laborCost) {
              const partsTotal = qParts.reduce((sum, p) => sum + ((p.cost || p.unitPrice || p.price || 0) * (p.quantity || 1)), 0);
              document.getElementById('paymentPartsTotal').textContent = '₱' + partsTotal.toLocaleString();
              document.getElementById('paymentLaborCost').textContent = '₱' + (q.laborCost || 0).toLocaleString();
              quotationParts.innerHTML = qParts.map(p => {
                const unitPrice = p.cost || p.unitPrice || p.price || 0;
                const qty = p.quantity || 1;
                return `<div class="d-flex justify-content-between mb-1" style="font-size:0.82rem;">
                <span>${p.name || p.partName || 'Part'} × ${qty}</span>
                <span class="fw-semibold">₱${(unitPrice * qty).toLocaleString()}</span>
              </div>`;
              }).join('');
              document.getElementById('paymentQuotationLabor').textContent = '₱' + (q.laborCost || 0).toLocaleString();
              const qTotal = q.totalCost || (partsTotal + (q.laborCost || 0));
              document.getElementById('paymentQuotationTotal').textContent = '₱' + qTotal.toLocaleString();
              // Update Total Service Fee: for repairs, add inspection fee + travel fee to quotation total
              const _inspFee = collectTargetAssignment?.bookingId?.inspectionFeeTotalCollected || collectTargetAssignment?.bookingId?.initialCost || collectTargetAssignment?.initialCost || 0;
              const _travelFee = collectTargetAssignment?.bookingId?.travelFare || 0;
              const _isRepairPayment = collectTargetAssignment?.bookingId?.serviceType === 'repair' || (collectTargetAssignment?.services && collectTargetAssignment.services.some(s => s.type === 'repair'));
              const _fullTotal = _isRepairPayment ? (_inspFee + _travelFee + qTotal) : qTotal;
              // Reflect any downpayment already collected
              const _dp = Number(collectTargetAssignment?.bookingId?.downpaymentAmount || collectTargetAssignment?.downpaymentAmount || 0);
              const _dpRow = document.getElementById('paymentDownpaymentRow');
              const _dpEl = document.getElementById('paymentDownpayment');
              if (_dp > 0) {
                _dpRow.style.display = 'flex';
                _dpEl.textContent = '-₱' + _dp.toLocaleString();
              } else {
                _dpRow.style.display = 'none';
              }
              const _bal = Math.max(0, _fullTotal - _dp);
              document.getElementById('paymentTotalFee').textContent = '₱' + _fullTotal.toLocaleString();
              document.getElementById('paymentBalanceDue').textContent = '₱' + _bal.toLocaleString();
              document.getElementById('paymentAmountInput').value = _bal;
              document.getElementById('paymentAmountInput').max = _bal;
              document.getElementById('paymentAmountHint').textContent = `Enter the full balance amount (max ₱${_bal.toLocaleString()})`;
              // Quotation notes
              const notesRow = document.getElementById('paymentQuotationNotesRow');
              if (q.notes) {
                notesRow.style.display = 'block';
                document.getElementById('paymentQuotationNotes').textContent = q.notes;
              } else { notesRow.style.display = 'none'; }
              quotationBox.style.display = 'block';
            } else {
              quotationBox.style.display = 'none';
            }

            // Populate repair completion materials if available
            const rc = booking.repairCompletion || {};
            if (rc.partsInstalled?.length || rc.actionsPerformed?.length) {
              repairBox.style.display = 'block';
              if (rc.partsInstalled?.length) {
                repairParts.innerHTML = rc.partsInstalled.map(p =>
                  `<div class="d-flex justify-content-between mb-1" style="font-size:0.82rem;">
                  <span>${p.name || 'Part'} × ${p.quantity || 1} ${p.unit || 'pcs'}</span>
                  <span class="fw-semibold">₱${((p.cost || p.unitPrice || p.price || 0) * (p.quantity || 1)).toLocaleString()}</span>
                </div>`
                ).join('');
              } else { repairParts.innerHTML = ''; }
              if (rc.actionsPerformed?.length) {
                repairActions.innerHTML = `<div style="font-size:0.82rem;"><strong>Actions:</strong> ${rc.actionsPerformed.join(', ')}</div>`;
              } else { repairActions.innerHTML = ''; }
              if (rc.completionNotes) {
                repairNotes.innerHTML = `<div style="font-size:0.82rem;"><strong>Notes:</strong> ${rc.completionNotes}</div>`;
              } else { repairNotes.innerHTML = ''; }
            } else { repairBox.style.display = 'none'; }
          })
          .catch(() => { quotationBox.style.display = 'none'; repairBox.style.display = 'none'; inspectionBox.style.display = 'none'; });
      } else {
        quotationBox.style.display = 'none';
        repairBox.style.display = 'none';
        inspectionBox.style.display = 'none';
      }

      // Use getOrCreateInstance to prevent duplicate modal instances
      const modalEl = document.getElementById('collectPaymentModal');
      bootstrap.Modal.getOrCreateInstance(modalEl).show();
    };

    document.getElementById('confirmCollectBtn').addEventListener('click', async function () {
      const amount = parseFloat(document.getElementById('paymentAmountInput').value);
      const notes = document.getElementById('paymentNotesInput').value.trim();
      const errorBox = document.getElementById('paymentErrorBox');
      const balance = collectTargetAssignment.balanceAmount || 0;

      if (!amount || amount <= 0) {
        errorBox.textContent = 'Please enter a valid amount.';
        errorBox.classList.remove('d-none');
        return;
      }

      this.disabled = true;
      this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing...';

      try {
        const res = await fetch(`/api/technician/assignments/${collectTargetId}/collect-payment`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ amount, notes })
        });
        const data = await res.json();
        if (res.ok) {
          bootstrap.Modal.getOrCreateInstance(document.getElementById('collectPaymentModal')).hide();
          showNotification({ type: 'success', title: 'Payment Collected', message: data.message, duration: 5000 });

          if (window._postPaymentAction) {
            setTimeout(() => { window._postPaymentAction(); window._postPaymentAction = null; }, 300);
          } else if (window._completeAfterPayment) {
            // Open Proof of Completion modal so technician uploads photo to complete
            setTimeout(() => {
              openProofModal(
                collectTargetId,
                collectTargetAssignment.customerName,
                collectTargetAssignment.serviceName,
                collectTargetAssignment.totalPrice || collectTargetAssignment.estimatedFee || 0,
                true
              );
            }, 300);
          } else {
            // Re-open details modal with updated payment details
            setTimeout(() => {
              showDetail(collectTargetId);
            }, 300);
          }
          loadAssignments(currentFilter, currentPage);
        } else {
          errorBox.textContent = data.error || 'Failed to collect payment.';
          errorBox.classList.remove('d-none');
          document.getElementById('confirmCollectBtn').disabled = false;
          document.getElementById('confirmCollectBtn').innerHTML = '<i class="bi bi-check-circle me-1"></i>Collect Payment';
        }
      } catch (e) {
        errorBox.textContent = 'An error occurred while processing payment.';
        errorBox.classList.remove('d-none');
        document.getElementById('confirmCollectBtn').disabled = false;
        document.getElementById('confirmCollectBtn').innerHTML = '<i class="bi bi-check-circle me-1"></i>Collect Payment';
      }
    });

    // ── Collect Repair Payment (Quotation) ──────────────────────────────────
    window.collectRepairPayment = async function (bookingId, totalAmount) {
      const esc = (s) => (s || '').replace(/'/g, "\\'");
      const html = `
        <div style="text-align:left;padding:8px 0;">
          <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:16px;margin-bottom:16px;">
            <div style="font-size:0.78rem;color:#64748b;">Total Quotation Amount</div>
            <div style="font-size:1.6rem;font-weight:800;color:#166534;">₱${(totalAmount || 0).toLocaleString()}</div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Payment Method</label>
            <select id="rpMethod" class="form-select" style="border-radius:8px;">
              <option value="cash">Cash</option>
              <option value="gcash">GCash</option>
              <option value="card">Card</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Amount Collected</label>
            <input type="number" id="rpAmount" class="form-control" value="${totalAmount || 0}" min="0" style="border-radius:8px;font-weight:700;">
          </div>
          <div class="mb-3" id="rpProofGroup" style="display:none;">
            <label class="form-label fw-semibold">Proof of Payment <small class="text-muted">(required for GCash)</small></label>
            <input type="file" id="rpProofInput" class="form-control" accept="image/*" style="border-radius:8px;">
          </div>
        </div>`;

      const result = await Swal.fire({
        title: 'Collect Repair Payment',
        html,
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: '<i class="bi bi-check-circle me-1"></i>Collect Payment',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#059669',
        preConfirm: () => {
          const method = document.getElementById('rpMethod').value;
          const amount = parseFloat(document.getElementById('rpAmount').value);
          if (!amount || amount <= 0) { Swal.showValidationMessage('Enter a valid amount'); return; }
          if (method === 'gcash') {
            const proof = document.getElementById('rpProofInput').files[0];
            if (!proof) { Swal.showValidationMessage('Proof of payment is required for GCash'); return; }
            return { amount, method, proofFile: proof };
          }
          return { amount, method };
        }
      });

      if (!result.isConfirmed) return;

      const { amount, method, proofFile } = result.value;
      Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

      try {
        let proofUrl = '';
        if (proofFile) {
          const proofForm = new FormData();
          proofForm.append('proofPhoto', proofFile);
          const uploadRes = await fetch(`/api/technician/appointments/${bookingId}/upload-proof`, {
            method: 'POST', credentials: 'same-origin', body: proofForm
          });
          if (uploadRes.ok) {
            const uploadData = await uploadRes.json();
            proofUrl = uploadData.url || '';
          }
        }

        const res = await fetch(`/api/technician/appointments/${bookingId}/collect-repair-payment`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ amount, method, proofUrl }),
        });

        const data = await res.json();
        Swal.close();
        if (res.ok) {
          Swal.fire({ icon: 'success', title: 'Payment Collected', text: data.message || 'Repair payment collected successfully.', timer: 2000, showConfirmButton: false });
          loadAssignments(currentFilter, currentPage);
          let targetAssignId = window._currentDetailId;
          let a = (window._allAssignments || window.allItems || []).find(item => String(item.bookingId?._id || item.bookingId) === String(bookingId));
          if (!a && window._detailAssignment && String(window._detailAssignment.bookingId?._id || window._detailAssignment.bookingId) === String(bookingId)) {
            a = window._detailAssignment;
          }
          if (a) targetAssignId = a._id;

          if (targetAssignId) {
            showDetail(targetAssignId);
          }
        } else {
          Swal.fire('Error', data.error || 'Failed to collect payment.', 'error');
        }
      } catch (e) {
        Swal.close();
        Swal.fire('Error', 'Network error.', 'error');
      }
    };
    // Show/hide proof field based on payment method
    document.addEventListener('change', function (e) {
      if (e.target && e.target.id === 'rpMethod') {
        const proofGroup = document.getElementById('rpProofGroup');
        if (proofGroup) proofGroup.style.display = e.target.value === 'gcash' ? '' : 'none';
      }
    });

    // ── Proof of Completion ────────────────────────────────────────────────
    let proofTargetId = null;
    let proofFile = null;

    window.openProofModal = function (id, customerName, serviceName, fee, paymentJustCollected = false) {
      // Block if balance not collected (unless payment was just collected in the flow)
      let a = allItems.find(item => String(item._id) === String(id));
      if (!a && window._detailAssignment && String(window._detailAssignment._id) === String(id)) {
        a = window._detailAssignment;
      }
      const balanceStillDue = a && ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && !a.balanceCollected && (a.balanceAmount || 0) > 0;
      if (!paymentJustCollected && balanceStillDue) {
        showNotification({ type: 'warning', title: 'Payment Required', message: 'You must collect the remaining balance before completing this job.', duration: 5000 });
        openCollectPaymentModal(id, a, true);
        return;
      }
      proofTargetId = id;
      proofFile = null;
      document.getElementById('proofFileInput').value = '';
      document.getElementById('proofUploadPlaceholder').classList.remove('d-none');
      document.getElementById('proofPreviewContainer').classList.add('d-none');
      document.getElementById('proofError').classList.add('d-none');
      document.getElementById('submitProofBtn').disabled = true;
      const area = document.getElementById('proofUploadArea');
      area.style.padding = '40px 24px';
      const proofEl = document.getElementById('proofModal');
      bootstrap.Modal.getOrCreateInstance(proofEl).show();
    };

    window.handleProofFile = function (e) {
      const file = e.target.files[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) {
        showProofError('File size must be under 5MB');
        return;
      }
      if (!['image/jpeg', 'image/jpg', 'image/png', 'image/webp'].includes(file.type)) {
        showProofError('Only JPEG, PNG, or WebP images are accepted');
        return;
      }
      proofFile = file;
      const reader = new FileReader();
      reader.onload = function (ev) {
        document.getElementById('proofPreviewImg').src = ev.target.result;
        document.getElementById('proofFileName').textContent = file.name;
        document.getElementById('proofUploadPlaceholder').classList.add('d-none');
        document.getElementById('proofPreviewContainer').classList.remove('d-none');
        document.getElementById('proofError').classList.add('d-none');
        document.getElementById('submitProofBtn').disabled = false;
      };
      reader.readAsDataURL(file);
    };

    window.clearProofUpload = function () {
      proofFile = null;
      document.getElementById('proofFileInput').value = '';
      document.getElementById('proofUploadPlaceholder').classList.remove('d-none');
      document.getElementById('proofPreviewContainer').classList.add('d-none');
      document.getElementById('submitProofBtn').disabled = true;
    };

    function showProofError(msg) {
      document.getElementById('proofErrorMsg').textContent = msg;
      document.getElementById('proofError').classList.remove('d-none');
      document.getElementById('submitProofBtn').disabled = true;
    }

    // Drag and drop handlers
    (function () {
      const area = document.getElementById('proofUploadArea');
      if (!area) return;
      ['dragenter', 'dragover'].forEach(evt => {
        area.addEventListener(evt, function (e) { e.preventDefault(); e.stopPropagation(); area.classList.add('drag-over'); });
      });
      ['dragleave', 'drop'].forEach(evt => {
        area.addEventListener(evt, function (e) { e.preventDefault(); e.stopPropagation(); area.classList.remove('drag-over'); });
      });
      area.addEventListener('drop', function (e) {
        const file = e.dataTransfer.files[0];
        if (file) {
          const input = document.getElementById('proofFileInput');
          const dt = new DataTransfer();
          dt.items.add(file);
          input.files = dt.files;
          input.dispatchEvent(new Event('change'));
        }
      });
    })();

    window.submitProofOfCompletion = async function () {
      if (!proofFile || !proofTargetId) return;
      const btn = document.getElementById('submitProofBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Uploading...';

      try {
        const formData = new FormData();
        formData.append('proofPhoto', proofFile);

        const uploadRes = await fetch(`/api/technician/assignments/${proofTargetId}/proof-of-completion`, {
          method: 'POST',
          credentials: 'same-origin',
          body: formData
        });
        const uploadData = await uploadRes.json();
        if (!uploadRes.ok) throw new Error(uploadData.error || 'Upload failed');

        bootstrap.Modal.getOrCreateInstance(document.getElementById('proofModal')).hide();
        showNotification({ type: 'success', title: 'Job Completed', message: 'Proof uploaded and job marked as completed.', duration: 5000 });

        // Refresh data (proof endpoint already sets status to completed)
        loadAssignments(currentFilter, currentPage);
        if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
          showDetail(window._currentDetailId);
        }
      } catch (e) {
        showProofError(e.message || 'Failed to upload proof photo');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-circle"></i><span>Submit & Complete</span>';
      }
    };

    // ── Cancel Assignment ──────────────────────────────────────────────────
    let cancelTargetId = null;

    window.openCancelModal = function (id, customerName, serviceName) {
      cancelTargetId = id;
      document.getElementById('cancelReasonSelect').value = '';
      document.getElementById('customReasonText').value = '';
      document.getElementById('customReasonCount').textContent = '0';
      document.getElementById('customReasonGroup').classList.add('d-none');
      document.getElementById('confirmCancelBtn').disabled = true;
      document.getElementById('cancelModalSubtitle').textContent = `${serviceName} for ${customerName}`;
      document.getElementById('cancelAlertBox').classList.remove('d-none');
      const cancelEl = document.getElementById('cancelModal');
      bootstrap.Modal.getOrCreateInstance(cancelEl).show();
    };

    document.getElementById('cancelReasonSelect').addEventListener('change', function () {
      const isOther = this.value === 'other';
      document.getElementById('customReasonGroup').classList.toggle('d-none', !isOther);
      document.getElementById('confirmCancelBtn').disabled = !this.value;
      if (isOther) {
        document.getElementById('customReasonText').focus();
      }
    });

    document.getElementById('customReasonText').addEventListener('input', function () {
      document.getElementById('customReasonCount').textContent = this.value.length;
      const reason = document.getElementById('cancelReasonSelect').value;
      document.getElementById('confirmCancelBtn').disabled = reason !== 'other' || !this.value.trim();
    });

    document.getElementById('confirmCancelBtn').addEventListener('click', async function () {
      if (!cancelTargetId) return;
      const reason = document.getElementById('cancelReasonSelect').value;
      const customReason = document.getElementById('customReasonText').value.trim();
      if (!reason) return;

      this.disabled = true;
      this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Cancelling...';

      try {
        const res = await fetch(`/api/technician/assignments/${cancelTargetId}/cancel`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ reason, customReason }),
        });
        const data = await res.json();
        if (res.ok) {
          bootstrap.Modal.getOrCreateInstance(document.getElementById('cancelModal')).hide();
          showNotification({
            type: 'warning',
            title: 'Assignment Cancelled',
            message: 'The booking has been returned to the reassignment queue.',
            duration: 5000
          });
          loadAssignments(currentFilter, currentPage);
        } else {
          showNotification({ type: 'error', title: 'Cancel Failed', message: data.error || 'Failed to cancel assignment', duration: 5000 });
        }
      } catch (e) {
        showNotification({ type: 'error', title: 'Cancel Failed', message: 'Network error. Please try again.', duration: 5000 });
      } finally {
        this.disabled = false;
        this.innerHTML = '<i class="bi bi-x-circle me-1"></i>Confirm Cancellation';
      }
    });

    // ── Accept Available Job ───────────────────────────────────────────────
    window.acceptAvailableJob = async function (bookingId, customerName, btn) {
      if (!confirm(`Accept this job for ${customerName}?`)) return;
      window._btnLoading(btn, async () => {
        try {
          const res = await fetch(`/api/technician/available-jobs/${bookingId}/accept`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
          });
          const data = await res.json();
          if (res.ok) {
            showNotification({
              type: 'success',
              title: 'Job Accepted',
              message: `You have accepted the job for ${customerName}. It is now in your pending assignments.`,
              duration: 5000
            });
            loadAssignments(currentFilter, currentPage);
          } else {
            showNotification({ type: 'error', title: 'Accept Failed', message: data.error || 'Failed to accept job', duration: 5000 });
          }
        } catch (e) {
          showNotification({ type: 'error', title: 'Accept Failed', message: 'Network error. Please try again.', duration: 5000 });
        }
      });
    };

    // ── Socket.io Listeners (uses window.socket from technician layout) ─────
    (function initAssignmentSocketListeners() {
      try {
        if (!window.socket) return;
        window.socket.on('assignment:vacancy', (data) => {
          showNotification({
            type: 'info',
            title: 'New Job Available',
            message: data.message || `${data.serviceName} for ${data.customerName}`,
            duration: 8000
          });
          if (currentFilter === 'available') {
            loadAvailableJobs();
          }
          fetchTabCounts();
        });
        window.socket.on('assignment:new', (data) => {
          const isProject = data.isProject;
          showNotification({
            type: 'success',
            title: isProject ? 'New Project Assignment' : 'New Assignment',
            message: data.message || (isProject
              ? `You have been assigned to a project: ${data.serviceName || 'Project'} for ${data.customerName || 'a customer'}. Open to Accept or Decline.`
              : `New job: ${data.serviceName} for ${data.customerName}`),
            duration: 10000
          });
          if (currentFilter === 'pending' || currentFilter === 'all') {
            loadAssignments();
          }
          if (isProject && typeof window.__loadProjectWork === 'function') {
            window.__loadProjectWork();
          }
          fetchTabCounts();
        });
        window.socket.on('project:team_assigned', (data) => {
          showNotification({
            type: 'info',
            title: 'Commercial Project — Accept or Decline',
            message: data.message || `You have been assigned to a commercial project. Lead: ${data.lead || 'N/A'}. Open My Work to Accept or Decline.`,
            duration: 10000
          });
          if (currentFilter === 'pending' || currentFilter === 'all') {
            loadAssignments();
          }
          if (typeof window.__loadProjectWork === 'function') {
            window.__loadProjectWork();
          }
          fetchTabCounts();
        });
      } catch (e) { }
    })();

    window.switchDetailTab = function (tabName) {
      const contentEl = document.getElementById('detailPanelContent');
      if (!contentEl) return;
      const tab = contentEl.querySelector(`.mw-detail-tab[data-tab="${tabName}"]`);
      if (!tab) return;
      contentEl.querySelectorAll('.mw-detail-tab').forEach(b => b.classList.remove('active'));
      contentEl.querySelectorAll('.mw-detail-panel').forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      const panel = contentEl.querySelector(`.mw-detail-panel[data-tab="${tabName}"]`);
      if (panel) {
        panel.classList.add('active');
        const body = document.getElementById('detailPanelBody');
        if (body) body.scrollTop = 0;
      }
    };

    window.closeDetailPanel = function () {
      if (window._routeMapWatcher) { navigator.geolocation.clearWatch(window._routeMapWatcher); window._routeMapWatcher = null; }
      const panel = document.getElementById('rightPanel');
      const left = document.getElementById('leftPanel');
      panel.classList.remove('open');
      left.classList.remove('panel-open');
      left.classList.remove('list-hidden');
      if (window.hideRoutePanel) window.hideRoutePanel();
    };

    window.showDetail = async function (id) {
      try {
        // Show loading state
        document.getElementById('detailPanelHeader').style.display = 'none';
        document.getElementById('detailPanelEmpty').style.display = 'none';
        document.getElementById('detailPanelContent').style.display = 'none';
        document.getElementById('detailPanelActions').style.display = 'none';
        document.getElementById('detailPanelLoading').style.display = '';

        // Open panel and focus on the active job (hide the list)
        const panel = document.getElementById('rightPanel');
        const left = document.getElementById('leftPanel');
        panel.classList.add('open');
        left.classList.add('panel-open');
        left.classList.add('list-hidden');

        const res = await fetch(`/api/technician/assignments/${id}`, { credentials: 'same-origin' });
        if (!res.ok) { const errData = await res.json().catch(() => ({})); throw new Error(errData.error || `HTTP ${res.status}`); }
        const { assignment: a, techLocation } = await res.json();
        window._detailAssignment = a;
        window._currentDetailId = id;
        window._detailTechLocation = techLocation;

        // Load assigned equipment for this booking
        a.equipmentItems = [];
        const eqBookingId = a.bookingId?._id || (typeof a.bookingId === 'string' ? a.bookingId : '');
        if (eqBookingId) {
          try {
            const eqRes = await fetch(`/api/technician/equipment/${eqBookingId}`, { credentials: 'same-origin' });
            if (eqRes.ok) { const eqData = await eqRes.json(); a.equipmentItems = eqData.items || []; }
          } catch (e) {}
        }

        const date = a.bookingDate ? new Date(a.bookingDate).toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) : '';
        const bookingRef = a.bookingReference || a._id?.toString().slice(-6).toUpperCase() || 'N/A';

        // ── Panel Header ──
        const headerEl = document.getElementById('detailPanelHeader');
        headerEl.dataset.status = a.status;
        document.getElementById('detailPanelName').textContent = a.customerName || 'Customer';
        document.getElementById('detailPanelRef').textContent = `Booking #${bookingRef}`;
        const stBadge = document.getElementById('detailPanelStatusBadge');
        stBadge.textContent = statusLabels[a.status] || a.status;
        stBadge.style.background = a.status === 'completed' ? '#16a34a' : a.status === 'in_progress' ? '#2563eb' : a.status === 'en_route' ? '#7c3aed' : a.status === 'on_site' ? '#d97706' : 'rgba(255,255,255,0.2)';

        // Panel avatar icon based on status
        const avatarEl = document.getElementById('detailPanelAvatar');
        avatarEl.innerHTML = a.status === 'completed' ? '<i class="bi bi-check-circle" style="color:#4ade80;"></i>' :
          a.status === 'in_progress' ? '<i class="bi bi-gear" style="color:#60a5fa;"></i>' :
            a.status === 'en_route' ? '<i class="bi bi-geo-alt" style="color:#c084fc;"></i>' :
              a.status === 'on_site' ? '<i class="bi bi-building" style="color:#fbbf24;"></i>' :
                a.status === 'pending_acceptance' ? '<i class="bi bi-clock" style="color:#fbbf24;"></i>' :
                  '<i class="bi bi-person" style="color:#94a3b8;"></i>';

        // ── Service Hero (inside tracker card) ──
        const heroEl = document.getElementById('detailPanelWorkflowHero');
        const isRepairH = isRepairAssignment(a);
        const heroBadge = `<span class="mw-sh-badge priority-${(a.priority || 'normal')}">${(a.priority || 'normal').toUpperCase()}</span>`;
        const heroFee = Number(a.servicePrice || (a.serviceDetail && a.serviceDetail.basePrice) || 0).toLocaleString();
        heroEl.innerHTML = `
          <div class="mw-sh-left">
            <div class="mw-sh-icon"><i class="bi bi-${isRepairH ? 'wrench' : 'gear-wide-connected'}"></i></div>
            <div class="mw-sh-meta">
              <div class="mw-sh-name">${a.serviceName || 'Service'}</div>
              <div class="mw-sh-sub">${a.serviceType ? a.serviceType.toUpperCase() + ' SERVICE' : 'SERVICE'}</div>
            </div>
          </div>
          <div class="mw-sh-right">
            ${heroBadge}
            <div class="mw-sh-fee">₱${heroFee}</div>
            <div class="mw-sh-feelabel">Service Fee</div>
          </div>`;

        // ── Workflow Tracker ──
        const workflowEl = document.getElementById('detailPanelWorkflowSteps');
        const isRepair = isRepairAssignment(a);
        const bookingStatus = a.bookingId?.status || a.bookingStatus;

        if (isRepair) {
          const hasQuotation = !!(a.quotation?.createdAt || a.bookingId?.quotation?.createdAt) ||
            ['repair_scheduled', 'ready_for_repair', 'repair_in_progress', 'repair_completed', 'under_warranty'].includes(bookingStatus);
          let repairSteps, currentStep;

          if (hasQuotation) {
            repairSteps = [
              { key: 'en_route', label: 'En Route', icon: 'bi-sign-turn-right' },
              { key: 'arrived', label: 'Arrived', icon: 'bi-geo-alt' },
              { key: 'repair', label: 'Repair', icon: 'bi-tools' },
              { key: 'completed', label: 'Done', icon: 'bi-check-circle' }
            ];
            if (a.status === 'completed' || bookingStatus === 'repair_completed' || bookingStatus === 'under_warranty') currentStep = 'completed';
            else if (bookingStatus === 'repair_in_progress' || a.status === 'in_progress') currentStep = 'repair';
            else if (a.status === 'on_site') currentStep = 'arrived';
            else if (a.status === 'en_route') currentStep = 'en_route';
            else currentStep = 'en_route';
          } else {
            repairSteps = [
              { key: 'accepted', label: 'Accept', icon: 'bi-check-lg' },
              { key: 'checkout', label: 'Check Out', icon: 'bi-box-seam' },
              { key: 'en_route', label: 'En Route', icon: 'bi-sign-turn-right' },
              { key: 'inspect', label: 'Inspect', icon: 'bi-search' },
              { key: 'quote', label: 'Quote', icon: 'bi-receipt' },
              { key: 'done', label: 'Done', icon: 'bi-check-circle' }
            ];
            if (bookingStatus === 'inspection_completed' || bookingStatus === 'awaiting_approval') currentStep = 'quote';
            else if (a.status === 'on_site' || a.status === 'in_progress') currentStep = 'inspect';
            else if (a.status === 'en_route') currentStep = 'en_route';
            else if (a.status === 'accepted' && a.equipmentCheckedOut) currentStep = 'en_route';
            else if (a.status === 'accepted') currentStep = 'checkout';
            else currentStep = 'accepted';
          }

          const stepIdx = repairSteps.findIndex(s => s.key === currentStep);
          workflowEl.innerHTML = repairSteps.map((step, i) => {
            const isComp = i < stepIdx;
            const isCur = i === stepIdx;
            const icon = isComp ? 'bi-check-lg' : step.icon;
            return `
              <div class="wf-step ${isComp ? 'completed' : isCur ? 'active' : ''}">
                <div class="wf-dot"><i class="${icon}"></i></div>
                <span class="wf-step-label">${step.label}</span>
              </div>
              ${i < repairSteps.length - 1 ? `<div class="wf-connector ${i < stepIdx ? 'completed' : ''}"></div>` : ''}
            `;
          }).join('');
        } else {
          const steps = [
            { key: 'accepted', label: 'Accept', icon: 'bi-check-lg' },
            { key: 'checkout', label: 'Check Out', icon: 'bi-box-seam' },
            { key: 'en_route', label: 'En Route', icon: 'bi-geo-alt' },
            { key: 'on_site', label: 'Arrived', icon: 'bi-pin-map' },
            { key: 'in_progress', label: 'Work', icon: 'bi-gear' },
            { key: 'completed', label: 'Done', icon: 'bi-check-circle' }
          ];
          let curIdx;
          if (a.status === 'accepted' && a.equipmentCheckedOut) curIdx = steps.findIndex(s => s.key === 'en_route');
          else if (a.status === 'accepted' && !a.equipmentCheckedOut) curIdx = steps.findIndex(s => s.key === 'checkout');
          else curIdx = steps.findIndex(s => s.key === a.status);
          const stepIdx2 = curIdx >= 0 ? curIdx : 0;
          workflowEl.innerHTML = steps.map((step, i) => {
            const isComp = i < stepIdx2;
            const isCur = i === stepIdx2;
            const icon = isComp ? 'bi-check-lg' : step.icon;
            return `
              <div class="wf-step ${isComp ? 'completed' : isCur ? 'active' : ''}">
                <div class="wf-dot"><i class="${icon}"></i></div>
                <span class="wf-step-label">${step.label}</span>
              </div>
              ${i < steps.length - 1 ? `<div class="wf-connector ${i < stepIdx2 ? 'completed' : ''}"></div>` : ''}
            `;
          }).join('');
        }

        document.getElementById('detailPanelHeader').style.display = '';

        // ── Customer location ──
        const custLat = a.coordinates?.lat || a.customerLocation?.lat || a.location?.lat || a.bookingId?.customerLocation?.lat || (a.bookingId?.location?.coordinates?.[1]) || null;
        const custLng = a.coordinates?.lng || a.customerLocation?.lng || a.location?.lng || a.bookingId?.customerLocation?.lng || (a.bookingId?.location?.coordinates?.[0]) || null;
        const hasCoords = custLat && custLng && !isNaN(custLat) && !isNaN(custLng);

        // ── Activity log ──
        let activityHtml = '';
        if (a.notes && a.notes.length > 0) {
          activityHtml = `
          <div class="dminfo-activity ent-timeline" style="padding-left:18px;">
            ${a.notes.map(n => `
              <div class="ent-timeline-item" style="padding:6px 0 6px 14px;">
                <div class="ent-timeline-dot" style="left:-23px;top:10px;width:8px;height:8px;"></div>
                <div>
                  <div style="font-size:0.8rem;color:#334155;">${n.text}</div>
                  <div class="ent-timeline-time" style="font-size:0.68rem;">${n.byName || 'System'} &middot; ${n.createdAt ? new Date(n.createdAt).toLocaleString('en-PH') : ''}</div>
                </div>
              </div>
            `).join('')}
          </div>`;
        }

        // ── Payment section (for COD) ──
        let paymentHtml = '';
        const isRepairBooking = isRepairAssignment(a);
        const isRepairComplete = isRepairBooking && (a.status === 'completed' || ['repair_completed', 'completed'].includes(a.bookingId?.status || a.bookingStatus));

        if (['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod)) {
          if (!isRepairBooking || isRepairComplete) {
            const qTotal = a.bookingId?.quotation?.totalCost || a.quotation?.totalCost;
            const inspFee = a.bookingId?.inspectionFeeTotalCollected || a.bookingId?.initialCost || a.initialCost || 0;
            const total = isRepairBooking
              ? Number(inspFee + (qTotal || 0)).toLocaleString()
              : Number(qTotal || a.totalPrice || a.estimatedFee || 0).toLocaleString();
            const dp = Number(a.bookingId?.downpaymentAmount || a.downpaymentAmount || 0).toLocaleString();
            const bal = Number(a.bookingId?.balanceAmount || a.balanceAmount || 0).toLocaleString();
            const payStatus = a.paymentStatus === 'paid' ? 'Paid in Full' : a.balanceCollected ? 'Paid' : 'Balance Pending';
            const payBadgeCls = a.paymentStatus === 'paid' ? 'bg-success' : 'bg-warning text-dark';
            const paymentTitle = isRepairBooking ? 'Quotation Payment' : 'Payment';
            const paymentIcon = isRepairBooking ? 'bi-receipt-cutoff' : 'bi-cash-coin';

            paymentHtml = `
            <div class="detail-section" style="border-color:#bbf7d0;background:linear-gradient(to right, #f0fdf4, #f8fafc);">
              <div class="detail-section-header"><i class="bi ${paymentIcon}" style="color:#059669;"></i><h6 style="color:#059669;font-weight:700;letter-spacing:-0.01em;">${paymentTitle}</h6></div>
              <div class="detail-section-body">
                <div class="detail-row"><label>Total</label><span style="font-weight:800;color:#0f172a;">₱${total}</span></div>
                ${!isRepairBooking ? `<div class="detail-row"><label>Down</label><span style="color:#2563eb;font-weight:700;">₱${dp}</span></div>` : ''}
                <div class="detail-row"><label>Balance</label><span style="${a.balanceCollected ? 'color:#16a34a' : 'color:#d97706'};font-weight:700;">₱${bal}</span></div>
                <div class="detail-row mt-1"><label>Status</label><span class="badge ${payBadgeCls}" style="font-size:0.68rem;padding:4px 8px;">${payStatus}</span></div>
              </div>
            </div>`;
          }
        }

        // ── Build tab categories for panel ──
        const visiblePages = isRepair ? REPAIR_PAGES.filter(p => PAGE_REGISTRY[p].visible(a)) : ['overview'];
        const tabDefs = {
          'overview': { icon: 'bi-info-circle', label: 'Overview' },
          'ai-assistant': { icon: 'bi-robot', label: 'AI' },
          'inspection': { icon: 'bi-clipboard-check', label: 'Inspect' },
          'quotation': { icon: 'bi-receipt', label: 'Quote' },
          'repair': { icon: 'bi-tools', label: 'Repair' },
          'scheduling': { icon: 'bi-calendar-event', label: 'Schedule' },
          'completion': { icon: 'bi-check-circle', label: 'Done' },
          'invoice': { icon: 'bi-file-earmark-text', label: 'Invoice' },
          'rating': { icon: 'bi-star', label: 'Rating' },
        };

        // Build tab bar + tab panels
        let tabsHtml = '';
        let panelsHtml = '';
        visiblePages.forEach((p, idx) => {
          const d = tabDefs[p] || { icon: 'bi-circle', label: p };
          const active = idx === 0 ? 'active' : '';
          tabsHtml += `<button class="mw-detail-tab ${active}" data-tab="${p}"><i class="bi ${d.icon}"></i><span>${d.label}</span></button>`;
          let pageHtml = '';
          if (p === 'overview') pageHtml = renderOverviewPage(a, date, bookingRef, hasCoords, custLat, custLng, paymentHtml, activityHtml);
          else if (p === 'ai-assistant') pageHtml = renderAiAssistantPage(a);
          else if (p === 'inspection') pageHtml = renderInspectionPage(a);
          else if (p === 'quotation') pageHtml = renderQuotationPage(a);
          else if (p === 'repair') pageHtml = renderRepairPage(a);
          else if (p === 'scheduling') pageHtml = renderSchedulingPage(a);
          else if (p === 'completion') pageHtml = renderCompletionPage(a);
          else if (p === 'invoice') pageHtml = renderInvoicePage(a);
          else if (p === 'rating') pageHtml = renderRatingPage(a);
          panelsHtml += `<div class="mw-detail-panel ${active}" data-tab="${p}">${pageHtml}</div>`;
        });

        const contentEl = document.getElementById('detailPanelContent');
        // Remove previous tab listener to avoid stacking
        contentEl._tabListener && contentEl.removeEventListener('click', contentEl._tabListener);
        if (visiblePages.length > 1) {
          contentEl.innerHTML = `<div class="mw-detail-tabs">${tabsHtml}</div><div class="mw-detail-panels">${panelsHtml}</div>`;
          contentEl._tabListener = function onTabClick(e) {
            const btn = e.target.closest('.mw-detail-tab');
            if (!btn) return;
            switchDetailTab(btn.dataset.tab);
          };
          contentEl.addEventListener('click', contentEl._tabListener);
        } else {
          contentEl.innerHTML = panelsHtml;
        }
        contentEl.style.display = '';
        document.getElementById('detailPanelLoading').style.display = 'none';

        // ── Action bar ──
        const actionBar = document.getElementById('detailPanelActions');
        const actionsHtml = getWizardPageActions('overview', a);
        if (actionsHtml) {
          actionBar.innerHTML = actionsHtml;
          actionBar.style.display = 'flex';
        } else {
          actionBar.style.display = 'none';
        }

        // Auto-trigger AI diagnosis silently for ALL repair jobs without existing diagnosis
        const booking = a.bookingId || {};
        const bookingId = booking._id || (typeof a.bookingId === 'string' ? a.bookingId : a.bookingId?.toString?.());
        if ((a.serviceType === 'repair' || booking.serviceType === 'repair') &&
          !booking.technicianAssistant?.summary &&
          bookingId &&
          !['cancelled', 'closed', 'repair_completed', 'repair_declined'].includes(booking.status || a.status)) {
          setTimeout(() => generateAiDiagnosis(bookingId, true), 500);
        }

        // ── Route Map — embedded in detail panel ──
        window._routeMapInstance = null;

        window.openRouteMapModal = function (custLat, custLng, customerName, address) {
          const da = window._detailAssignment || {};
          // If called with no arguments, use the current detail assignment data
          if (custLat === undefined || custLng === undefined) {
            custLat = da.customerLat || (da.bookingId?.location?.coordinates ? da.bookingId.location.coordinates[1] : null) || (da.location?.lat) || '';
            custLng = da.customerLng || (da.bookingId?.location?.coordinates ? da.bookingId.location.coordinates[0] : null) || (da.location?.lng) || '';
          }
          if (!customerName) customerName = da.customerName || 'Customer';
          if (!address) address = da.address || da.bookingId?.address || '';

          // Store for Refresh / Open Maps
          window._routeMapCoords = {
            lat: custLat ? parseFloat(custLat) : null,
            lng: custLng ? parseFloat(custLng) : null,
            customerName: customerName,
            address: address
          };

          if (window._routeMapInstance) {
            window._routeMapInstance.remove();
            window._routeMapInstance = null;
          }

          // Open Bootstrap route map modal and hide any open detail modal
          var modalEl = document.getElementById('routeMapModal');
          if (modalEl) {
            bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop: 'static' }).show();
          }

          var assignDetailModalEl = document.getElementById('assignDetailModal');
          if (assignDetailModalEl) {
            var assignBsModal = bootstrap.Modal.getInstance(assignDetailModalEl);
            if (assignBsModal) assignBsModal.hide();
          }

          // Populate header / footer info
          const companyLoc = window._companyLocation || { lat: 14.676049, lng: 121.043731, address: 'Company Office', name: 'Company' };
          var compEl = document.getElementById('routeMapModalCompany');
          var compAddrEl = document.getElementById('routeMapModalCompanyAddress');
          var custEl = document.getElementById('routeMapModalCustomer');
          var addrEl = document.getElementById('routeMapModalAddress');
          var techEl = document.getElementById('routeMapModalTechnician');
          var statusEl = document.getElementById('routeMapModalStatus');
          var refEl = document.getElementById('routeMapModalRef');
          var subtitleEl = document.getElementById('routeMapModalSubtitle');
          if (compEl) compEl.textContent = companyLoc.name || 'Company';
          if (compAddrEl) compAddrEl.textContent = companyLoc.address || 'Office';
          if (custEl) custEl.textContent = customerName;
          if (addrEl) addrEl.textContent = address;
          if (techEl) techEl.textContent = 'You';
          if (statusEl) statusEl.textContent = 'En Route';
          if (refEl) refEl.textContent = da.bookingId?.bookingRef || da.bookingRef || '—';
          if (subtitleEl) subtitleEl.textContent = address || 'Live location tracking';

          var distEl = document.getElementById('routeMapModalDistance');
          var durEl = document.getElementById('routeMapModalDuration');
          var etaEl = document.getElementById('routeMapModalETA');
          if (distEl) distEl.innerHTML = '<i class="bi bi-compass me-1"></i>Calculating route...';
          if (durEl) durEl.textContent = '-- min';
          if (etaEl) etaEl.style.display = 'none';

          setTimeout(async function () {
              var mapEl = document.getElementById('routeMapModalMap');
              if (!mapEl) return;

              var detailMap = L.map('routeMapModalMap', { zoomControl: true });
              window._routeMapInstance = detailMap;

              L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 19
              }).addTo(detailMap);

              let finalLat = custLat ? parseFloat(custLat) : null;
              let finalLng = custLng ? parseFloat(custLng) : null;
              const companyLoc = window._companyLocation || { lat: 14.676049, lng: 121.043731, address: 'Company Office' };
              let companyLat = parseFloat(companyLoc.lat) || 14.676049;
              let companyLng = parseFloat(companyLoc.lng) || 121.043731;

              if (!finalLat || !finalLng) {
                document.getElementById('routeMapModalDistance').innerHTML =
                  '<i class="bi bi-search me-1"></i>Searching address location...';
                const geocodeAddress = async (addr) => {
                  const parts = addr.split(',').map(p => p.trim()).filter(Boolean);
                  for (let i = 0; i < parts.length; i++) {
                    const query = parts.slice(i).join(', ');
                    if (query.length < 5) continue;
                    try {
                      const geoUrl = 'https://nominatim.openstreetmap.org/search?format=json&q=' +
                        encodeURIComponent(query) + '&limit=1';
                      const geoRes = await fetch(geoUrl);
                      if (geoRes.ok) {
                        const geoData = await geoRes.json();
                        if (geoData && geoData.length > 0)
                          return { lat: parseFloat(geoData[0].lat), lng: parseFloat(geoData[0].lon) };
                      }
                    } catch (e) {
                      console.warn('Geocoding attempt failed for query: ' + query, e);
                    }
                  }
                  return null;
                };
                const result = await geocodeAddress(address);
                if (result) { finalLat = result.lat; finalLng = result.lng; }
              }

              const techLocation = window._detailTechLocation;
              const dbTechLng = techLocation?.coordinates?.[0] || null;
              const dbTechLat = techLocation?.coordinates?.[1] || null;

              const getTechLoc = () => {
                return new Promise((resolve) => {
                  if (!navigator.geolocation) {
                    resolve(dbTechLat && dbTechLng ? { lat: dbTechLat, lng: dbTechLng } : null);
                    return;
                  }
                  let resolved = false;
                  const done = (pos) => {
                    if (resolved) return;
                    resolved = true;
                    clearTimeout(fallbackTimer);
                    resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude });
                  };
                  const fail = () => {
                    if (resolved) return;
                    resolved = true;
                    clearTimeout(fallbackTimer);
                    resolve(dbTechLat && dbTechLng ? { lat: dbTechLat, lng: dbTechLng } : null);
                  };
                  const fallbackTimer = setTimeout(() => {
                    if (!resolved) { resolved = true; resolve(dbTechLat && dbTechLng ? { lat: dbTechLat, lng: dbTechLng } : null); }
                  }, 12000);
                  navigator.geolocation.getCurrentPosition(done, fail, { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 });
                });
              };
              const techLoc = await getTechLoc();

              window._routeTechMarker = null;
              const distEl = document.getElementById('routeMapModalDistance');
              const durEl = document.getElementById('routeMapModalDuration');
              const etaEl = document.getElementById('routeMapModalETA');
              const etaText = document.getElementById('routeMapModalETAText');

              if (finalLat && finalLng) {
                // Customer marker — enterprise purple with shadow
                const custMarker = L.marker([finalLat, finalLng], {
                  icon: L.divIcon({
                    className: '',
                    html: '<div style="background:linear-gradient(135deg,#7c3aed,#a78bfa);width:38px;height:38px;border-radius:12px 12px 12px 2px;border:2px solid #fff;box-shadow:0 4px 16px rgba(124,58,237,0.4);display:flex;align-items:center;justify-content:center;transform:rotate(0deg);animation:dropIn 0.3s ease-out;"><i class="bi bi-house-door-fill" style="color:#fff;font-size:16px;"></i></div>',
                    iconSize: [38, 38], iconAnchor: [19, 19]
                  })
                }).addTo(detailMap).bindPopup(
                  '<div style="font-family:inherit;text-align:center;"><strong>' + customerName + '</strong><br><span style="font-size:0.8rem;color:#64748b;">' + address + '</span></div>'
                );

                // Company marker — enterprise amber building
                const companyMarker = L.marker([companyLat, companyLng], {
                  icon: L.divIcon({
                    className: '',
                    html: '<div style="background:linear-gradient(135deg,#f59e0b,#fbbf24);width:38px;height:38px;border-radius:10px 10px 10px 2px;border:2px solid #fff;box-shadow:0 4px 16px rgba(245,158,11,0.4);display:flex;align-items:center;justify-content:center;animation:dropIn 0.3s ease-out;"><i class="bi bi-building-fill" style="color:#fff;font-size:16px;"></i></div>',
                    iconSize: [38, 38], iconAnchor: [19, 19]
                  })
                }).addTo(detailMap).bindPopup(
                  '<div style="font-family:inherit;text-align:center;"><strong>' + (companyLoc.name || 'Company') + '</strong><br><span style="font-size:0.8rem;color:#64748b;">' + (companyLoc.address || 'Office') + '</span></div>'
                );

                if (techLoc) {
                  // Technician marker — blue gradient with pulse ring
                  const techMarker = L.marker([techLoc.lat, techLoc.lng], {
                    icon: L.divIcon({
                      className: '',
                      html: '<div style="position:relative;"><div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:38px;height:38px;border-radius:50%;background:rgba(37,99,235,0.15);animation:techPulse 2s infinite;"></div><div style="background:linear-gradient(135deg,#2563eb,#60a5fa);width:34px;height:34px;border-radius:50%;border:2.5px solid #fff;box-shadow:0 4px 16px rgba(37,99,235,0.5);display:flex;align-items:center;justify-content:center;position:relative;z-index:1;"><i class="bi bi-geo-alt-fill" style="color:#fff;font-size:14px;"></i></div></div>',
                      iconSize: [38, 38], iconAnchor: [19, 19]
                    })
                  }).addTo(detailMap).bindPopup(
                    '<div style="font-family:inherit;text-align:center;"><strong>You</strong><br><span style="font-size:0.8rem;color:#64748b;">Technician</span></div>'
                  );
                  window._routeTechMarker = techMarker;

                  const group = new L.featureGroup([companyMarker, custMarker, techMarker]);
                  detailMap.fitBounds(group.getBounds().pad(0.2));

                  // Fetch OSRM routes (company → customer & technician → customer)
                  try {
                    const companyUrl = 'https://router.project-osrm.org/route/v1/driving/' +
                      companyLng + ',' + companyLat + ';' + finalLng + ',' + finalLat +
                      '?overview=full&geometries=geojson';
                    const techUrl = 'https://router.project-osrm.org/route/v1/driving/' +
                      techLoc.lng + ',' + techLoc.lat + ';' + finalLng + ',' + finalLat +
                      '?overview=full&geometries=geojson';
                    const [companyRes, techRes] = await Promise.all([fetch(companyUrl), fetch(techUrl)]);
                    let totalDistKm = null, totalDurMin = null, remDistKm = null, remDurMin = null;

                    if (companyRes.ok) {
                      const companyData = await companyRes.json();
                      if (companyData.routes && companyData.routes.length > 0) {
                        const cRoute = companyData.routes[0];
                        totalDistKm = (cRoute.distance / 1000).toFixed(1);
                        totalDurMin = Math.round(cRoute.duration / 60);
                        // Full planned route
                        L.geoJSON(cRoute.geometry, {
                          style: { color: '#2563eb', weight: 4, opacity: 0.8 }
                        }).addTo(detailMap);
                      }
                    }

                    if (techRes.ok) {
                      const techData = await techRes.json();
                      if (techData.routes && techData.routes.length > 0) {
                        const tRoute = techData.routes[0];
                        remDistKm = (tRoute.distance / 1000).toFixed(1);
                        remDurMin = Math.round(tRoute.duration / 60);
                        // Remaining route from technician to customer
                        L.geoJSON(tRoute.geometry, {
                          style: { color: '#0ea5e9', weight: 4, opacity: 0.85, dashArray: '8, 8' }
                        }).addTo(detailMap);
                        // ETA based on technician location
                        const eta = new Date(Date.now() + tRoute.duration * 1000);
                        etaEl.style.display = '';
                        etaText.textContent = 'ETA ' + eta.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                      }
                    }

                    if (totalDistKm != null && totalDurMin != null) {
                      distEl.innerHTML = '<i class="bi bi-building me-1"></i><strong>' + totalDistKm + ' km</strong> <span style="font-weight:400;color:#64748b;">(' + totalDurMin + ' min)</span>';
                    } else {
                      distEl.innerHTML = '<i class="bi bi-compass me-1"></i>Route unavailable';
                    }
                    if (remDurMin != null) {
                      durEl.innerHTML = '<i class="bi bi-clock me-1"></i>' + remDurMin + ' min away';
                    } else {
                      durEl.textContent = '-- min';
                    }
                  } catch (err) {
                    console.warn('OSRM routing failed', err);
                    const hDist = function (lat1, lng1, lat2, lng2) {
                      const R = 6371;
                      const dLat = (lat2 - lat1) * Math.PI / 180;
                      const dLng = (lng2 - lng1) * Math.PI / 180;
                      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                        Math.sin(dLng / 2) * Math.sin(dLng / 2) *
                        Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180);
                      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                    };
                    // Fallback straight-line estimates
                    L.polyline([[companyLat, companyLng], [finalLat, finalLng]], {
                      color: '#2563eb', weight: 3, opacity: 0.5, dashArray: '5, 5'
                    }).addTo(detailMap);
                    L.polyline([[techLoc.lat, techLoc.lng], [finalLat, finalLng]], {
                      color: '#0ea5e9', weight: 3, opacity: 0.5, dashArray: '5, 5'
                    }).addTo(detailMap);
                    const companyDist = hDist(companyLat, companyLng, finalLat, finalLng);
                    const techDist = hDist(techLoc.lat, techLoc.lng, finalLat, finalLng);
                    const techDur = Math.round(techDist / 30 * 60);
                    distEl.innerHTML = '<i class="bi bi-building me-1"></i><strong>' + companyDist.toFixed(1) + ' km</strong> <span style="font-weight:400;color:#64748b;">(Est.)</span>';
                    durEl.textContent = '~' + techDur + ' min';
                    const eta = new Date(Date.now() + techDur * 60000);
                    etaEl.style.display = '';
                    etaText.textContent = 'ETA ' + eta.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                  }
                } else {
                  detailMap.setView([finalLat, finalLng], 16);
                  L.circleMarker([finalLat, finalLng], {
                    radius: 8, color: '#7c3aed', fillColor: '#7c3aed', fillOpacity: 0.3, weight: 2
                  }).addTo(detailMap);
                }
              } else {
                if (techLoc) {
                  detailMap.setView([techLoc.lat, techLoc.lng], 14);
                  L.marker([techLoc.lat, techLoc.lng], {
                    icon: L.divIcon({
                      className: '',
                      html: '<div style="background:linear-gradient(135deg,#2563eb,#60a5fa);width:34px;height:34px;border-radius:50%;border:2.5px solid #fff;box-shadow:0 4px 16px rgba(37,99,235,0.5);display:flex;align-items:center;justify-content:center;"><i class="bi bi-geo-alt-fill" style="color:#fff;font-size:14px;"></i></div>',
                      iconSize: [34, 34], iconAnchor: [17, 17]
                    })
                  }).addTo(detailMap).bindPopup('<strong>You (Technician)</strong>');
                } else {
                  detailMap.setView([15.48, 120.97], 10);
                }
                distEl.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Could not locate address on map';
                durEl.textContent = 'N/A';
              }
              // Live position watcher + polling fallback (after initial marker exists)
              if (window._routeMapWatcher) { navigator.geolocation.clearWatch(window._routeMapWatcher); window._routeMapWatcher = null; }
              if (window._routeMapInterval) { clearInterval(window._routeMapInterval); window._routeMapInterval = null; }

              if (navigator.geolocation) {
                const updateTechMarker = function (lat, lng) {
                  window._lastTechLoc = { lat, lng };
                  if (window._routeTechMarker) {
                    window._routeTechMarker.setLatLng([lat, lng]);
                  } else {
                    window._routeTechMarker = L.marker([lat, lng], {
                      icon: L.divIcon({
                        className: '',
                        html: '<div style="position:relative;"><div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:38px;height:38px;border-radius:50%;background:rgba(37,99,235,0.15);animation:techPulse 2s infinite;"></div><div style="background:linear-gradient(135deg,#2563eb,#60a5fa);width:34px;height:34px;border-radius:50%;border:2.5px solid #fff;box-shadow:0 4px 16px rgba(37,99,235,0.5);display:flex;align-items:center;justify-content:center;position:relative;z-index:1;"><i class="bi bi-geo-alt-fill" style="color:#fff;font-size:14px;"></i></div></div>',
                        iconSize: [38, 38], iconAnchor: [19, 19]
                      })
                    }).addTo(detailMap).bindPopup('<div style="font-family:inherit;text-align:center;"><strong>You</strong><br><span style="font-size:0.8rem;color:#64748b;">Technician</span></div>');
                  }
                  fetch('/api/auth/technician/location', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ lat, lng }) }).catch(function () {});
                };

                window._routeMapWatcher = navigator.geolocation.watchPosition(
                  function (pos) { updateTechMarker(pos.coords.latitude, pos.coords.longitude); },
                  function (err) { console.warn('Route map geolocation watch failed', err); },
                  { enableHighAccuracy: true, maximumAge: 0, timeout: 10000 }
                );

                window._routeMapInterval = setInterval(function () {
                  navigator.geolocation.getCurrentPosition(
                    function (pos) { updateTechMarker(pos.coords.latitude, pos.coords.longitude); },
                    function (err) { console.warn('Route map geolocation poll failed', err); },
                    { enableHighAccuracy: true, maximumAge: 0, timeout: 8000 }
                  );
                }, 8000);
              }

              detailMap.invalidateSize();
              [100, 300, 700, 1200].forEach(function (ms) {
                setTimeout(function () { if (window._routeMapInstance) window._routeMapInstance.invalidateSize(); }, ms);
              });
          }, 350);
        };

        window.hideRoutePanel = function () {
          var panel = document.getElementById('routePanelMap');
          if (!panel) return;
          panel.style.display = 'none';
          panel.classList.add('collapsed');
          if (window._routeMapInstance) {
            window._routeMapInstance.remove();
            window._routeMapInstance = null;
          }
        };

        window.toggleRoutePanel = function () {
          var panel = document.getElementById('routePanelMap');
          var icon = document.getElementById('routePanelToggleIcon');
          if (!panel) return;
          if (panel.classList.contains('collapsed')) {
            panel.classList.remove('collapsed');
            if (icon) icon.className = 'bi bi-dash-lg';
            if (window._routeMapInstance) {
              setTimeout(function () { window._routeMapInstance.invalidateSize(); }, 100);
            }
          } else {
            panel.classList.add('collapsed');
            if (icon) icon.className = 'bi bi-arrows-expand';
          }
        };

        window.closeRouteMapModal = function () {
          if (window._routeMapWatcher) { navigator.geolocation.clearWatch(window._routeMapWatcher); window._routeMapWatcher = null; }
          if (window._routeMapInterval) { clearInterval(window._routeMapInterval); window._routeMapInterval = null; }
          if (window._routeMapInstance) { window._routeMapInstance.remove(); window._routeMapInstance = null; }
          window._routeTechMarker = null;
          var modalEl = document.getElementById('routeMapModal');
          if (modalEl) {
            var bsModal = bootstrap.Modal.getInstance(modalEl);
            if (bsModal) bsModal.hide();
          }
        };

        window.refreshRouteMapModal = function () {
          const c = window._routeMapCoords;
          if (!c || !c.lat || !c.lng) return;
          openRouteMapModal(c.lat, c.lng, c.customerName, c.address);
        };

        window.openFullRouteMap = function () {
          const c = window._routeMapCoords;
          if (!c || !c.lat || !c.lng) return;
          const url = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(c.lat + ',' + c.lng);
          window.open(url, '_blank');
        };

      } catch (e) {
        console.error('[showDetail] Error:', e);
        showNotification({ type: 'error', title: 'Load Failed', message: 'Failed to load assignment details.', duration: 5000 });
        document.getElementById('detailPanelLoading').style.display = 'none';
        document.getElementById('detailPanelEmpty').style.display = '';
      }
    };

    function showNotification({ type = 'info', title = '', message = '', duration = 4000 }) {
      const container = document.getElementById('technicianNotificationContainer');
      if (!container) return;
      const icons = { success: 'bi-check-circle-fill', error: 'bi-x-circle-fill', warning: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' };
      const notif = document.createElement('div');
      notif.className = `ent-notification ent-notif-${type}`;
      notif.innerHTML = `
      <div class="ent-notification-icon"><i class="bi ${icons[type] || icons.info}"></i></div>
      <div class="ent-notification-body">
        <p class="ent-notification-title">${title}</p>
        <p class="ent-notification-message">${message}</p>
      </div>
      <button class="ent-notification-close" onclick="this.closest('.ent-notification').classList.add('removing');setTimeout(()=>this.closest('.ent-notification')?.remove(),300);">&times;</button>`;
      container.appendChild(notif);
      setTimeout(() => { notif.classList.add('removing'); setTimeout(() => notif.remove(), 300); }, duration);
    }

    // Check URL for pre-selected status
    const params = new URLSearchParams(window.location.search);
    const statusParam = params.get('status');
    if (statusParam) {
      currentFilter = statusParam;
      document.querySelectorAll('#assignTabs .mw-tab').forEach(b => {
        b.classList.toggle('active', b.dataset.filter === statusParam);
      });
    }
    const idParam = params.get('id');
    if (idParam) {
      setTimeout(() => showDetail(idParam), 500);
    }

    loadAssignments(currentFilter, 1);
  })();
</script>

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.5/main.min.js"></script>
<script>
  // ═══════════════════════════════════════════════════════════════════════════
  // VIEW TOGGLE, CALENDAR, KPIs — Enterprise Unified Page
  // ═══════════════════════════════════════════════════════════════════════════
  (function () {
    "use strict";

    const h = window.techHelpers || window.techHelpers;
    let calendarInstance = null;
    let currentView = 'cards';
    let calendarPage = 1;
    const CALENDAR_PAGE_SIZE = 5;
    let calendarTotalPages = 1;
    let allCalendarItems = [];

    // ── View Toggle (Enterprise Segmented Control) ──
    const toggleBtns = document.querySelectorAll('#viewToggle .mw-view-btn');
    const cardsContainer = document.getElementById('cardsViewContainer');
    const calendarContainer = document.getElementById('calendarViewContainer');

    toggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.view;
        if (view === currentView) return;
        currentView = view;
        toggleBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        if (view === 'calendar') {
          cardsContainer.style.display = 'none';
          calendarContainer.style.display = 'block';
          loadCalendarPage(1);
        } else {
          cardsContainer.style.display = 'block';
          calendarContainer.style.display = 'none';
        }
      });
    });

    // ── Live Clock (Enterprise Hero) ──
    function tick() {
      const el = document.getElementById('currentDateTime');
      if (el) {
        const span = el.querySelector('span');
        if (span) {
          span.textContent = new Date().toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        }
      }
    }
    tick(); setInterval(tick, 30000);

    // ── Hero Stats (Animated Counters) ──
    function animateHeroStat(id, target) {
      const el = document.getElementById(id);
      if (!el) return;
      const current = parseInt(el.textContent) || 0;
      if (current === target) return;
      const diff = target - current;
      const steps = Math.min(Math.abs(diff), 15);
      const inc = diff / steps;
      let step = 0;
      const timer = setInterval(() => {
        step++;
        const val = step >= steps ? target : Math.round(current + inc * step);
        el.textContent = val;
        if (step >= steps) clearInterval(timer);
      }, 40);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // KPI — Fetches from dedicated backend endpoint (enterprise-grade)
    // ═══════════════════════════════════════════════════════════════════════════
    let kpiLoading = false;

    function setKpiText(id, v) {
      const el = document.getElementById(id);
      if (el) el.textContent = v;
    }

    function animateKpiValue(el, target, prefix) {
      if (!el) return;
      prefix = prefix || '';
      const current = parseInt(el.textContent.replace(/[^0-9]/g, '')) || 0;
      if (current === target) { el.textContent = prefix + target.toLocaleString(); return; }
      const diff = target - current;
      const steps = Math.min(Math.abs(diff), 20);
      const inc = diff / steps;
      let step = 0;
      const timer = setInterval(() => {
        step++;
        const val = step >= steps ? target : Math.round(current + inc * step);
        el.textContent = prefix + val.toLocaleString();
        if (step >= steps) clearInterval(timer);
      }, 30);
    }

    async function updateKpis() {
      if (kpiLoading) return;
      kpiLoading = true;

      // Show loading shimmer
      ['kpiTotal', 'kpiCompleted', 'kpiPending', 'kpiToday', 'kpiRevenue', 'kpiPartsCost', 'kpiExpenses', 'kpiGrossProfit', 'kpiCompletionRate'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.opacity = '0.4';
      });

      try {
        const res = await fetch('/api/technician/kpis', { credentials: 'same-origin' });
        if (!res.ok) throw new Error('KPI fetch failed');
        const kpi = await res.json();

        // Animate values with smooth transitions
        ['kpiTotal', 'kpiCompleted', 'kpiPending', 'kpiToday', 'kpiRevenue', 'kpiCompletionRate'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.style.opacity = '1';
        });

        animateKpiValue(document.getElementById('kpiTotal'), kpi.total, '');
        animateKpiValue(document.getElementById('kpiCompleted'), kpi.completed, '');
        animateKpiValue(document.getElementById('kpiPending'), kpi.pending, '');
        animateKpiValue(document.getElementById('kpiToday'), kpi.today, '');
        animateKpiValue(document.getElementById('kpiRevenue'), kpi.revenue, '\u20B1');
        animateKpiValue(document.getElementById('kpiPartsCost'), kpi.partsCost || 0, '\u20B1');
        animateKpiValue(document.getElementById('kpiExpenses'), kpi.expenses || 0, '\u20B1');
        animateKpiValue(document.getElementById('kpiGrossProfit'), kpi.grossProfit || 0, '\u20B1');
        setKpiText('kpiCompletionRate', kpi.completionRate + '%');

        // Update hero stats with animated counters
        animateHeroStat('heroActive', kpi.active || 0);
        animateHeroStat('heroPending', kpi.pending || 0);
        animateHeroStat('heroToday', kpi.today || 0);
        // Update Today button badge
        if (window._updateTodayBadge) window._updateTodayBadge(kpi.today || 0);
        // Update gross profit hero stat
        const heroProfit = document.getElementById('heroProfit');
        if (heroProfit) {
          const gp = kpi.grossProfit || 0;
          const absVal = Math.abs(gp);
          const formatted = absVal >= 1000 ? (absVal / 1000).toFixed(1) + 'K' : absVal.toLocaleString();
          heroProfit.textContent = gp >= 0 ? '\u20B1' + formatted : '-\u20B1' + formatted;
          heroProfit.style.color = gp >= 0 ? '#10b981' : '#ef4444';
        }

        // Update tab badges with real counts (auto-hide when 0)
        const setBadge = (id, v) => {
          const el = document.getElementById(id);
          if (el) {
            el.textContent = v;
            el.style.display = v > 0 ? '' : 'none';
          }
        };
        setBadge('countAll', kpi.total);
        setBadge('countPending', kpi.pending);
        setBadge('countActive', kpi.active);
        setBadge('countToday', kpi.today);
        setBadge('countCompleted', kpi.completed);
        setBadge('countDeclined', kpi.declined);
        setBadge('countCancelled', kpi.cancelled);
        setBadge('countAvailable', kpi.available);

        // Render sparklines
        if (h && h.renderSparkline) {
          h.renderSparkline('spark_kpiTotal', [kpi.total, kpi.total + 2, kpi.total + 1, kpi.total + 3, kpi.total], '#3b82f6');
          h.renderSparkline('spark_kpiCompleted', [kpi.completed, kpi.completed + 1, kpi.completed, kpi.completed + 2, kpi.completed], '#10b981');
          h.renderSparkline('spark_kpiPending', [kpi.pending, Math.max(0, kpi.pending - 1), kpi.pending, Math.max(0, kpi.pending - 1), kpi.pending], '#f59e0b');
          h.renderSparkline('spark_kpiToday', [kpi.today, kpi.today + 1, kpi.today, kpi.today + 1, kpi.today], '#ef4444');
          h.renderSparkline('spark_kpiRevenue', [kpi.revenue * 0.8, kpi.revenue * 0.9, kpi.revenue, kpi.revenue * 0.95, kpi.revenue], '#0891b2');
          h.renderSparkline('spark_kpiPartsCost', [kpi.partsCost * 0.8, kpi.partsCost * 0.9, kpi.partsCost, kpi.partsCost * 0.95, kpi.partsCost], '#ef4444');
          h.renderSparkline('spark_kpiExpenses', [kpi.expenses * 0.8, kpi.expenses * 0.9, kpi.expenses, kpi.expenses * 0.95, kpi.expenses], '#8b5cf6');
          h.renderSparkline('spark_kpiGrossProfit', [kpi.grossProfit * 0.8, kpi.grossProfit * 0.9, kpi.grossProfit, kpi.grossProfit * 0.95, kpi.grossProfit], '#10b981');
          h.renderSparkline('spark_kpiCompletionRate', [kpi.completionRate, Math.min(100, kpi.completionRate + 5), kpi.completionRate, Math.min(100, kpi.completionRate + 3), kpi.completionRate], '#8b5cf6');
        }
      } catch (e) {
        console.warn('[KPI] Failed to load KPIs:', e);
        // Fallback: compute from client-side data
        const items = window._allAssignments || [];
        if (items.length) {
          const total = items.length;
          let completed = 0, pending = 0, today = 0, revenue = 0;
          const todayStr = new Date().toDateString();
          items.forEach(a => {
            const st = (a.status || '').toLowerCase();
            if (st === 'completed') {
              completed++;
              // Use computedRevenue if available, else compute correctly
              if (a.computedRevenue) {
                revenue += a.computedRevenue;
              } else {
                const isRepair = a.serviceType === 'repair' || (a.services && Array.isArray(a.services) && a.services.some(s => s.type === 'repair'));
                if (isRepair) {
                  const inspFee = a.bookingInspectionFeeCollected || a.bookingInitialCost || a.initialCost || 0;
                  const quotTotal = a.bookingQuotationTotal || 0;
                  revenue += inspFee + quotTotal;
                } else {
                  revenue += (a.bookingTotalPrice || a.totalPrice || a.estimatedFee || 0);
                }
              }
            }
            else if (st === 'pending_acceptance') pending++;
            const d = new Date(a.bookingDate || 0);
            if (d.toDateString() === todayStr) today++;
          });
          setKpiText('kpiTotal', total);
          setKpiText('kpiCompleted', completed);
          setKpiText('kpiPending', pending);
          setKpiText('kpiToday', today);
          setKpiText('kpiRevenue', '\u20B1' + revenue.toLocaleString(undefined, { maximumFractionDigits: 0 }));
          setKpiText('kpiCompletionRate', total > 0 ? Math.round((completed / total) * 100) + '%' : '0%');
        }
        ['kpiTotal', 'kpiCompleted', 'kpiPending', 'kpiToday', 'kpiRevenue', 'kpiPartsCost', 'kpiExpenses', 'kpiGrossProfit', 'kpiCompletionRate'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.style.opacity = '1';
        });
      }
      kpiLoading = false;
    }

    // Expose for the main loader to call after data arrives
    window._updateWorkKpis = updateKpis;

    // ═══════════════════════════════════════════════════════════════════════════
    // CALENDAR — Server-side paginated with "Show More" button
    // ═══════════════════════════════════════════════════════════════════════════
    function parseMinuteValue(value) {
      if (value == null) return NaN;
      const raw = String(value).trim();
      if (!raw) return NaN;
      if (/^\d{1,4}$/.test(raw)) return Number(raw);
      const hm = raw.match(/^(\d{1,2}):(\d{2})$/);
      if (hm) return Number(hm[1]) * 60 + Number(hm[2]);
      const apm = raw.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
      if (apm) { let hh = Number(apm[1]) % 12; if (apm[3].toUpperCase() === 'PM') hh += 12; return hh * 60 + Number(apm[2]); }
      return NaN;
    }

    function toCalendarEvent(a) {
      const startMin = parseMinuteValue(a.startTime);
      const hasTime = Number.isFinite(startMin);
      const day = new Date(a.bookingDate || Date.now());
      const yyyy = day.getFullYear(), mo = String(day.getMonth() + 1).padStart(2, '0'), dd = String(day.getDate()).padStart(2, '0');
      const dateOnly = yyyy + '-' + mo + '-' + dd;
      let startStr = dateOnly, endStr = null;
      if (hasTime) {
        const sH = String(Math.floor(startMin / 60)).padStart(2, '0'), sM = String(startMin % 60).padStart(2, '0');
        startStr = dateOnly + 'T' + sH + ':' + sM + ':00';
        const fallEnd = startMin + 60;
        endStr = dateOnly + 'T' + String(Math.floor(fallEnd / 60)).padStart(2, '0') + ':' + String(fallEnd % 60).padStart(2, '0') + ':00';
      }
      const status = (a.status || '').toLowerCase();
      const STATUS_COLORS = { confirmed: '#22c55e', scheduled: '#22c55e', pending: '#f59e0b', completed: '#0ea5e9', cancelled: '#ef4444', 're-scheduled': '#6366f1', 'on-the-way': '#f59e0b', 'in-progress': '#f59e0b', arrived: '#22c55e', en_route: '#0ea5e9', on_site: '#22c55e', pending_acceptance: '#f59e0b', accepted: '#3b82f6' };
      const color = STATUS_COLORS[status] || '#64748b';
      const ev = { id: String(a._id || ''), title: (a.serviceName || 'Service') + ' - ' + (a.customerName || 'Customer'), start: startStr, allDay: !hasTime, backgroundColor: color, borderColor: color, extendedProps: { raw: a } };
      if (endStr) ev.end = endStr;
      return ev;
    }

    async function loadCalendarPage() {
      if (calendarInstance) {
        calendarInstance.render();
        return;
      }
      const calendarEl = document.getElementById('techCalendar');
      if (!calendarEl) return;
      calendarInstance = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        headerToolbar: {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
        },
        height: 700,
        dayMaxEvents: 0,
        moreLinkClassNames: 'cal-more-link-btn',
        moreLinkContent: function (args) {
          const total = args.num + args.hiddenSegs?.length || args.num;
          return { html: `<div class="cal-more-pill"><i class="bi bi-briefcase-fill" style="margin-right:4px;"></i>${total} Booking${total !== 1 ? 's' : ''}</div>` };
        },
        moreLinkClick: function (info) {
          const dateStr = info.date.toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
          const dayEvents = info.allSegs
            .filter(seg => seg.event.display !== 'background' && seg.event.id)
            .map(seg => seg.event);
          openCalSlide(dateStr, dayEvents);
          return 'stop';
        },
        dayCellContent: function (args) {
          return { html: `<span class="fc-daygrid-day-number">${args.date.getDate()}</span>` };
        },
        dayCellDidMount: function (arg) {
          // Allow clicking on day cells to show all events for that day
          arg.el.style.cursor = 'pointer';
          arg.el.addEventListener('click', function (e) {
            // Don't trigger if clicking an event or more link
            if (e.target.closest('.fc-event') || e.target.closest('.cal-more-pill') || e.target.closest('.fc-daygrid-more-link')) return;
            const dateStr = arg.date.toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            const dayStr = arg.date.toISOString().split('T')[0];
            const allEvents = calendarInstance.getEvents().filter(ev => {
              if (ev.display === 'background' || !ev.id) return false;
              const evDate = ev.start ? ev.start.toISOString().split('T')[0] : null;
              return evDate === dayStr;
            });
            openCalSlide(dateStr, allEvents);
          });
        },
        events: async function (fetchInfo, successCallback, failureCallback) {
          try {
            const params = new URLSearchParams({
              start: fetchInfo.startStr,
              end: fetchInfo.endStr,
              limit: '500'
            });
            const res = await fetch(`/api/technician/calendar?${params.toString()}`, { credentials: 'same-origin' });
            if (!res.ok) throw new Error();
            const data = await res.json();
            const statusColors = { pending_acceptance: '#f59e0b', accepted: '#3b82f6', en_route: '#0ea5e9', on_site: '#22c55e', in_progress: '#2563eb', completed: '#10b981', cancelled: '#6b7280', declined: '#ef4444', no_show: '#6b7280' };
            const events = (data.items || []).map(a => {
              let startDateTime = a.bookingDate;
              if (a.startTime) {
                const d = new Date(a.bookingDate);
                const timeParts = a.startTime.match(/(\d+):(\d+)\s*(AM|PM)?/i);
                if (timeParts) {
                  let hh = parseInt(timeParts[1], 10);
                  let mm = parseInt(timeParts[2], 10);
                  if (timeParts[3]) {
                    if (timeParts[3].toUpperCase() === 'PM' && hh < 12) hh += 12;
                    if (timeParts[3].toUpperCase() === 'AM' && hh === 12) hh = 0;
                  }
                  d.setHours(hh, mm, 0);
                  startDateTime = d.toISOString();
                }
              }
              return {
                id: a._id,
                title: `${a.customerName || 'Customer'} - ${a.serviceName || 'Service'}`,
                start: startDateTime,
                color: statusColors[a.status] || '#6b7280',
                extendedProps: { assignment: a }
              };
            });

            // Enterprise Schedule Integration
            if (data.schedule) {
              const formatTime = (mins) => {
                const h = Math.floor(mins / 60);
                const m = mins % 60;
                let h12 = h % 12 || 12;
                let ampm = h >= 12 ? 'PM' : 'AM';
                return `${h12}:${m.toString().padStart(2, '0')} ${ampm}`;
              };

              // 1. Add Working Days Shifts
              if (data.schedule.workingDays) {
                data.schedule.workingDays.forEach(w => {
                  events.push({
                    title: `Shift: ${formatTime(w.startMinutes)} - ${formatTime(w.endMinutes)}`,
                    daysOfWeek: [w.dayOfWeek],
                    display: 'background',
                    color: 'rgba(59, 130, 246, 0.08)' // light blue background
                  });
                });
              }
              // 2. Add Non-Working Weekdays
              if (data.schedule.nonWorkingWeekdays) {
                data.schedule.nonWorkingWeekdays.forEach(nw => {
                  events.push({
                    title: 'Day Off',
                    daysOfWeek: [nw.dayOfWeek || nw],
                    display: 'background',
                    color: 'rgba(239, 68, 68, 0.1)' // light red background
                  });
                });
              }
              // 3. Add Rest Dates (Leaves)
              if (data.schedule.restDates) {
                data.schedule.restDates.forEach(r => {
                  events.push({
                    title: `Leave: ${r.reason || 'Rest Day'}`,
                    start: new Date(r.date).toISOString().split('T')[0],
                    allDay: true,
                    display: 'background',
                    color: 'rgba(245, 158, 11, 0.15)' // amber background
                  });
                });
              }
            }

            successCallback(events);
          } catch (e) {
            failureCallback(e);
          }
        },
        eventClick: function (info) {
          if (info.event.display === 'background' || !info.event.id) return;
          window.showDetail(info.event.id);
        }
      });
      calendarInstance.render();
    }

    // ── Enterprise Day Slide Panel ──
    const STATUS_LABELS = { pending_acceptance: 'Pending', accepted: 'Accepted', en_route: 'En Route', on_site: 'On Site', in_progress: 'In Progress', completed: 'Completed', cancelled: 'Cancelled', declined: 'Declined', no_show: 'No Show' };
    const STATUS_COLORS = { pending_acceptance: '#f59e0b', accepted: '#3b82f6', en_route: '#0ea5e9', on_site: '#22c55e', in_progress: '#2563eb', completed: '#10b981', cancelled: '#6b7280', declined: '#ef4444', no_show: '#6b7280' };

    function openCalSlide(dateStr, events) {
      const overlay = document.getElementById('calSlideOverlay');
      const panel = document.getElementById('calSlidePanel');
      const title = document.getElementById('calSlideDateTitle');
      const subtitle = document.getElementById('calSlideSubtitle');
      const body = document.getElementById('calSlideBody');

      title.textContent = dateStr;
      subtitle.textContent = `${events.length} booking${events.length !== 1 ? 's' : ''} scheduled`;

      if (events.length === 0) {
        body.innerHTML = `
        <div class="text-center py-5" style="color:#94a3b8;">
          <i class="bi bi-calendar-x" style="font-size:2.5rem;display:block;margin-bottom:12px;opacity:0.5;"></i>
          <div style="font-weight:600;font-size:0.9rem;color:#64748b;">No bookings on this day</div>
          <div style="font-size:0.78rem;margin-top:4px;">This day appears to be free.</div>
        </div>`;
      } else {
        const sorted = [...events].sort((a, b) => (a.start || 0) > (b.start || 0) ? 1 : -1);
        body.innerHTML = sorted.map(ev => {
          const a = ev.extendedProps?.assignment || {};
          const color = STATUS_COLORS[a.status] || '#6b7280';
          const label = STATUS_LABELS[a.status] || a.status;
          const time = a.startTime || (ev.start ? ev.start.toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' }) : 'N/A');
          const badgeCls = a.status === 'completed' ? 'bg-success' : a.status === 'in_progress' ? 'bg-primary' : a.status === 'en_route' ? 'bg-info text-dark' : a.status === 'on_site' ? 'bg-dark' : a.status === 'cancelled' || a.status === 'declined' ? 'bg-danger' : a.status === 'pending_acceptance' ? 'bg-warning text-dark' : 'bg-secondary';
          const esc = (s) => (s || '').replace(/'/g, "\\'");
          return `
          <div class="cal-slide-card" style="--card-accent:${color};" onclick="closeCalSlide();setTimeout(()=>window.showDetail('${ev.id}'),250);">
            <div class="card-header-row">
              <div style="min-width:0;flex:1;">
                <div class="d-flex align-items-center gap-2">
                  <span class="priority-dot priority-${a.priority || 'normal'}"></span>
                  <p class="card-customer">${a.customerName || 'Customer'}</p>
                </div>
                <div class="card-service">${a.serviceName || 'Service'} ${a.serviceType ? '(' + a.serviceType + ')' : ''}</div>
              </div>
              <span class="badge ${badgeCls}" style="font-size:0.65rem;flex-shrink:0;">${label}</span>
            </div>
            <div class="card-details">
              <div class="card-detail"><i class="bi bi-clock"></i> ${time}</div>
              ${a.address ? `<div class="card-detail"><i class="bi bi-geo-alt"></i> ${a.address.substring(0, 35)}${a.address.length > 35 ? '...' : ''}</div>` : ''}
              ${a.estimatedFee ? `<div class="card-detail"><i class="bi bi-cash"></i> ₱${Number(a.estimatedFee).toLocaleString()}</div>` : ''}
              ${['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && !a.balanceCollected && (a.balanceAmount || 0) > 0 ? `<div class="card-detail" style="color:#d97706;"><i class="bi bi-exclamation-triangle"></i> Balance ₱${Number(a.balanceAmount).toLocaleString()}</div>` : ''}
            </div>
            <div class="card-footer">
              <span class="card-ref">${a.bookingReference || a._id?.slice(-6).toUpperCase() || ''}</span>
              <span class="card-view-link">View Details &rarr;</span>
            </div>
          </div>`;
        }).join('');
      }

      overlay.classList.add('show');
      requestAnimationFrame(() => panel.classList.add('open'));
    }

    function closeCalSlide() {
      const overlay = document.getElementById('calSlideOverlay');
      const panel = document.getElementById('calSlidePanel');
      panel.classList.remove('open');
      overlay.classList.remove('show');
    }
    window.closeCalSlide = closeCalSlide;

    document.getElementById('calSlideOverlay')?.addEventListener('click', closeCalSlide);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeCalSlide(); });

    // Initialize calendar on first view switch
    function initCalendar() {
      // Calendar is now list-based with "Show More" — no FullCalendar needed for the list view
      // FullCalendar still available if user wants month view
    }

    // ── Boot ──
    updateKpis();
    // Auto-refresh KPIs every 60 seconds
    setInterval(updateKpis, 60000);
  })();
</script>

