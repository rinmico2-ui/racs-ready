  };

  window.notifyCustomer = async function() {
    const p = window.__projectData;
    if (!p || !p.customer?.email) { toast('No customer email on file', 'error'); return; }
    if (!confirm(`Send project update notification to ${p.customer.email}?`)) return;
    try {
      const r = await fetch(`/api/projects/${projectId}/notify-customer`, { method: 'POST' });
      if (r.ok) { toast('Customer notified'); } else { const err = await r.json(); toast(err.error || 'Failed', 'error'); }
    } catch (e) { toast('Failed to send notification', 'error'); }
  };

  window.scrollToAssignments = function() {
    const el = document.querySelector('[data-stage-host], .wo-card');
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  function recoveryDateInput(value) {
    if (!value) return '';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    const adjusted = new Date(date.getTime() - (date.getTimezoneOffset() * 60000));
    return adjusted.toISOString().slice(0, 10);
  }

  function recoveryDefaultStart() {
    const tomorrow = new Date();
    tomorrow.setHours(0, 0, 0, 0);
    tomorrow.setDate(tomorrow.getDate() + 1);
    return recoveryDateInput(tomorrow);
  }

  window.openRecoveryPlan = function(initialMode = 'recover') {
    const p = window.__projectData;
    if (!p) return;
    document.querySelector('.project-recovery-modal')?.remove();
    const workOrders = window.__lastWorkOrders || [];
    const dm = dashboardMetrics(p, workOrders);
    const governance = p.scheduleGovernance || {};
    const commitment = approvedCompletionDate(p);
    const earliestRecovery = new Date(recoveryDefaultStart());
    const commitmentExpired = Boolean(commitment && new Date(commitment) < earliestRecovery);
    if (commitmentExpired) initialMode = 'extend';
    const baseline = governance.originalBaselineCompletionDate || p.schedulePlan?.targetEndDate || commitment;
    // Use the same live estimate shown on the dashboard. Stored governance
    // dates describe the last approved calculation and may be stale after
    // planned work is missed.
    const forecast = dm.estCompletionDate || governance.currentForecastCompletionDate || p.schedulePlan?.estimatedEndDate;
    const currentDays = projectWorkingDays(p);
    const workingHours = p.schedulePlan?.workingHours || p.preferredWorkingHours || {};
    const history = Array.isArray(governance.history) ? governance.history.slice(-3).reverse() : [];
    const initialExtension = (() => {
      const candidate = new Date(forecast || commitment);
      const approved = new Date(commitment);
      if (Number.isNaN(candidate.getTime()) || candidate <= approved) approved.setDate(approved.getDate() + Math.max(1, dm.delayDays || 1));
      return recoveryDateInput(Number.isNaN(candidate.getTime()) || candidate <= new Date(commitment) ? approved : candidate);
    })();
    const dayLabels = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    const modal = document.createElement('div');
    modal.className = 'pw-modal-overlay project-recovery-modal';
    modal.innerHTML = `
      <div class="pw-modal project-recovery-dialog" role="dialog" aria-modal="true" aria-labelledby="recoveryTitle" tabindex="-1">
        <div class="recovery-header">
          <div class="recovery-header-main">
            <span class="recovery-header-icon"><i class="bi bi-calendar2-range"></i></span>
            <div>
            <div class="recovery-eyebrow">Controlled schedule revision</div>
            <h5 id="recoveryTitle" class="recovery-title">${commitmentExpired ? 'Resolve Past-Due Project Schedule' : 'Review Project Recovery Plan'}</h5>
            <p class="recovery-subtitle">Set the proposed schedule, verify live operational capacity, then authorize the revision. Nothing is rescheduled during validation.</p>
            </div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="recovery-header-status"><i class="bi bi-exclamation-diamond-fill"></i>${commitmentExpired ? 'PAST DUE' : 'SCHEDULE RISK'}</span>
            <button class="pw-modal-close recovery-close" type="button" aria-label="Close"><i class="bi bi-x-lg"></i></button>
          </div>
        </div>

        <div class="recovery-scroll">
        <div class="recovery-kpi-grid">
          <div class="recovery-kpi"><span class="recovery-kpi-icon"><i class="bi bi-flag"></i></span><span class="recovery-kpi-label">Original baseline</span><span class="recovery-kpi-value">${fmtDate(baseline)}</span></div>
          <div class="recovery-kpi"><span class="recovery-kpi-icon"><i class="bi bi-calendar-check"></i></span><span class="recovery-kpi-label">Current approved date</span><span class="recovery-kpi-value">${fmtDate(commitment)}</span></div>
          <div class="recovery-kpi ${dm.delayDays > 0 ? 'is-alert' : ''}"><span class="recovery-kpi-icon"><i class="bi bi-graph-up-arrow"></i></span><span class="recovery-kpi-label">Live completion estimate</span><span class="recovery-kpi-value" style="color:${dm.delayDays > 0 ? '#dc2626' : '#0f172a'};">${fmtDate(forecast)}</span></div>
        </div>

        ${commitmentExpired ? `<div class="recovery-overdue-note"><i class="bi bi-exclamation-triangle-fill"></i><div><strong>The approved date of ${fmtDate(commitment)} has passed.</strong><br>Choose a new completion date. Recovery without an extension is unavailable because future work cannot be scheduled against an expired commitment.</div></div>` : ''}

        <form id="recoveryPlanForm">
          <div class="recovery-step">
            <div class="recovery-step-head"><span class="recovery-step-no">1</span><div><strong>Choose the schedule decision</strong><span>A past-due commitment requires an extension. Recovery is available only while the approved date can still be met.</span></div></div>
            <div class="recovery-mode-grid" style="gap:.625rem;">
              <label class="rec-action ${commitmentExpired ? 'is-disabled' : ''}" style="cursor:pointer;margin:0;align-items:flex-start;">
                <input type="radio" name="mode" value="recover" ${initialMode !== 'extend' ? 'checked' : ''} ${commitmentExpired ? 'disabled' : ''} style="margin-top:.2rem;">
                <span><strong style="font-size:.8rem;">Recover within approved date</strong><span style="display:block;font-size:.7rem;color:#64748b;margin-top:.15rem;">${commitmentExpired ? `Unavailable — ${fmtDate(commitment)} has already passed.` : `Keep ${fmtDate(commitment)} and re-plan remaining work.`}</span></span>
              </label>
              <label class="rec-action" style="cursor:pointer;margin:0;align-items:flex-start;">
                <input type="radio" name="mode" value="extend" ${initialMode === 'extend' ? 'checked' : ''} style="margin-top:.2rem;">
                <span><strong style="font-size:.8rem;">Approve a new completion date</strong><span style="display:block;font-size:.7rem;color:#64748b;margin-top:.15rem;">Create an audited extension, reschedule remaining work, and notify the customer.</span></span>
              </label>
            </div>
          </div>

          <div class="recovery-step">
            <div class="recovery-step-head"><span class="recovery-step-no">2</span><div><strong>Define the revised plan</strong><span>Explain the delay and set the earliest realistic working window.</span></div></div>
          <div class="recovery-form-grid">
            <label class="recovery-field"><span>Recovery starts <b class="required">Required</b></span>
              <input class="form-control form-control-sm" type="date" name="recoveryStartDate" min="${recoveryDefaultStart()}" value="${recoveryDefaultStart()}" required>
            </label>
            <label id="revisedDateField" class="recovery-field"><span>New approved completion <b class="required">Required</b></span>
              <input class="form-control form-control-sm" type="date" name="revisedCompletionDate" min="${recoveryDefaultStart()}" value="${initialExtension}">
            </label>
            <label class="recovery-field"><span>Delay category <b class="required">Required</b></span>
              <select class="form-select form-select-sm" name="reasonCategory" required>
                <option value="">Select reason</option><option value="weather">Weather</option><option value="material_delay">Material delay</option><option value="customer_change">Customer change</option><option value="access_constraint">Access constraint</option><option value="staffing">Staffing / capacity</option><option value="technical_complexity">Technical complexity</option><option value="safety">Safety</option><option value="external_dependency">External dependency</option><option value="other">Other</option>
              </select>
            </label>
            <div class="recovery-time-grid">
              <label class="recovery-field"><span>Daily start <b class="required">Required</b></span><input class="form-control form-control-sm" type="time" name="startTime" value="${escHtml(workingHours.start || '09:00')}" required></label>
              <label class="recovery-field"><span>Daily end <b class="required">Required</b></span><input class="form-control form-control-sm" type="time" name="endTime" value="${escHtml(workingHours.end || '17:00')}" required></label>
            </div>
          </div>
          <div style="margin-top:.75rem;">
            <div style="font-size:.69rem;font-weight:750;color:#334155;margin-bottom:.4rem;">Approved working days <span style="color:#dc2626;float:right;">Required</span></div>
            <div class="recovery-days">${dayLabels.map((label, day) => `<label class="recovery-day"><input type="checkbox" name="workingDays" value="${day}" ${currentDays.has(day) ? 'checked' : ''}><span>${label}</span></label>`).join('')}</div>
          </div>
          <label class="recovery-field" style="margin-top:.8rem;"><span>Delay and recovery rationale <b class="required">Required</b></span>
            <textarea class="form-control form-control-sm" name="reason" rows="3" minlength="10" maxlength="1500" required placeholder="Document what caused the delay and why this revised schedule is achievable."></textarea>
          </label>
          <label class="recovery-field" style="margin-top:.8rem;"><span>Customer and operational impact <small style="color:#94a3b8;font-weight:600;">Optional</small></span>
            <textarea class="form-control form-control-sm" name="impactSummary" rows="2" maxlength="1500" placeholder="Record affected access, dependencies, costs, or customer expectations."></textarea>
          </label>
          <label class="recovery-notify"><input type="checkbox" name="notifyCustomer" checked><span><strong>Notify the customer after approval</strong><small>Sends an in-app update and email when available. A delivery failure will not roll back the approved schedule revision.</small></span></label>
          </div>
        </form>

        <div class="recovery-step">
          <div class="recovery-step-head"><span class="recovery-step-no">3</span><div><strong>Check capacity, then approve</strong><span>The check is read-only. It verifies technicians, leave, bookings, equipment, and the resulting finish date before any future assignment is changed.</span></div></div>
          <div id="recoveryPreview" role="status" aria-live="polite"><div class="recovery-check-empty"><i class="bi bi-shield-check me-1"></i><strong>Approval is locked.</strong> Run the schedule check to verify live capacity and enable the final authorization button.</div></div>
        </div>
        ${history.length ? `<details style="margin-top:.875rem;"><summary style="font-size:.74rem;font-weight:700;color:#475569;cursor:pointer;">Recent schedule revisions (${governance.history.length})</summary><div style="margin-top:.5rem;">${history.map(item => `<div style="font-size:.7rem;color:#475569;padding:.45rem .55rem;border:1px solid #e2e8f0;border-radius:7px;margin-bottom:.35rem;"><strong>Revision ${Number(item.revisionNumber || 0)}</strong> · ${escHtml(String(item.action || '').replace('_',' '))} · ${fmtDate(item.approvedAt)}<br><span style="color:#64748b;">${escHtml(item.reason || '')}</span></div>`).join('')}</div></details>` : ''}
        </div>
        <div class="recovery-footer">
          <div id="recoveryGateState" class="recovery-gate-state" role="status" aria-live="polite"><i class="bi bi-shield-lock me-1"></i>No changes yet — check the schedule before approval.</div>
          <div class="recovery-footer-actions"><button class="pw-btn recovery-close" type="button">Cancel</button><button class="pw-btn" id="previewRecovery" type="button"><i class="bi bi-calendar2-check me-1"></i>Check Schedule</button><button class="pw-btn primary" id="approveRecovery" type="button" disabled><i class="bi bi-check2-circle me-1"></i>Approve Change</button></div>
        </div>
      </div>`;
    document.body.appendChild(modal);
    const form = modal.querySelector('#recoveryPlanForm');
    const previewBox = modal.querySelector('#recoveryPreview');
    const previewButton = modal.querySelector('#previewRecovery');
    const approveButton = modal.querySelector('#approveRecovery');
    const revisedField = modal.querySelector('#revisedDateField');
    const gateState = modal.querySelector('#recoveryGateState');
    let approvedPreview = null;

    const selectedMode = () => form.querySelector('[name="mode"]:checked')?.value || (commitmentExpired ? 'extend' : 'recover');
    const syncMode = () => {
      const extension = selectedMode() === 'extend';
      revisedField.style.display = extension ? 'block' : 'none';
      revisedField.querySelector('input').required = extension;
      approveButton.innerHTML = extension ? '<i class="bi bi-calendar-check me-1"></i>Approve Extension' : '<i class="bi bi-check2-circle me-1"></i>Approve Recovery';
    };
    const payload = () => ({
      mode: selectedMode(),
      recoveryStartDate: form.recoveryStartDate.value,
      revisedCompletionDate: form.revisedCompletionDate.value || null,
      reasonCategory: form.reasonCategory.value,
      reason: form.reason.value.trim(),
      impactSummary: form.impactSummary.value.trim(),
      startTime: form.startTime.value,
      endTime: form.endTime.value,
      workingDays: [...form.querySelectorAll('[name="workingDays"]:checked')].map(input => Number(input.value)),
      notifyCustomer: form.notifyCustomer.checked,
    });
    const invalidatePreview = () => {
      approvedPreview = null;
      approveButton.disabled = true;
      previewBox.innerHTML = '<div style="font-size:.72rem;color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:.6rem;"><i class="bi bi-exclamation-circle me-1"></i>The proposed schedule changed. Run the schedule check again before approval.</div>';
      gateState.classList.remove('is-ready');
      gateState.innerHTML = '<i class="bi bi-shield-lock me-1"></i>No changes yet — check the revised schedule before approval.';
      syncMode();
    };
    const closeRecoveryModal = () => {
      document.removeEventListener('keydown', handleRecoveryKeydown);
      modal.remove();
    };
    const handleRecoveryKeydown = event => {
      if (event.key === 'Escape') closeRecoveryModal();
    };
    form.addEventListener('input', invalidatePreview);
    form.addEventListener('change', invalidatePreview);
    modal.querySelectorAll('.recovery-close').forEach(button => button.addEventListener('click', closeRecoveryModal));
    modal.addEventListener('click', event => { if (event.target === modal) closeRecoveryModal(); });
    document.addEventListener('keydown', handleRecoveryKeydown);
    syncMode();

    previewButton.addEventListener('click', async () => {
      if (!form.reportValidity()) return;
      const request = payload();
      if (!request.workingDays.length) { toast('Select at least one working day', 'error'); return; }
      previewButton.disabled = true;
      previewButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Checking capacity';
      gateState.classList.remove('is-ready');
      gateState.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Checking live operational capacity…';
      previewBox.style.display = 'block';
      previewBox.innerHTML = '<div style="font-size:.74rem;color:#64748b;padding:.75rem;"><span class="spinner-border spinner-border-sm me-2"></span>Validating remaining work against live capacity…</div>';
      try {
        const r = await fetch(`/api/projects/${projectId}/recovery-plan/preview`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(request),
        });
        const result = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(result.error || 'Failed to preview recovery plan');
        const conflicts = Array.isArray(result.conflicts) ? result.conflicts : [];
        approvedPreview = result.viable ? request : null;
        approveButton.disabled = !result.viable;
        gateState.classList.toggle('is-ready', result.viable);
        gateState.innerHTML = result.viable
          ? '<i class="bi bi-check-circle-fill me-1"></i>Schedule check passed — approval is now enabled.'
          : '<i class="bi bi-exclamation-triangle-fill me-1"></i>Resolve the blocking conflicts, then check again.';
        previewBox.innerHTML = `<div class="recovery-check-result ${result.viable ? 'is-ready' : 'is-blocked'}">
          <div class="recovery-check-head"><strong><i class="bi ${result.viable ? 'bi-check-circle-fill' : 'bi-x-circle-fill'} me-1"></i>${result.viable ? 'Schedule check passed' : 'Schedule has blocking conflicts'}</strong><span class="recovery-quality">QUALITY ${Number(result.qualityScore || 0)}%</span></div>
          <div class="recovery-kpi-grid" style="gap:.5rem;margin-top:.65rem;"><div class="recovery-kpi"><span class="recovery-kpi-icon"><i class="bi bi-calendar-event"></i></span><span class="recovery-kpi-label">Forecast after</span><span class="recovery-kpi-value">${fmtDate(result.forecastAfter)}</span></div><div class="recovery-kpi"><span class="recovery-kpi-icon"><i class="bi bi-list-task"></i></span><span class="recovery-kpi-label">Affected work orders</span><span class="recovery-kpi-value">${Number(result.affectedWorkOrders || 0)}</span></div><div class="recovery-kpi"><span class="recovery-kpi-icon"><i class="bi bi-calendar-week"></i></span><span class="recovery-kpi-label">Scheduled workdays</span><span class="recovery-kpi-value">${Number(result.workingDays || 0)}</span></div></div>
          ${conflicts.length ? `<div class="recovery-check-conflicts">${conflicts.slice(0, 5).map(conflict => `<div><i class="bi bi-exclamation-triangle me-1"></i>${escHtml(conflict.message || conflict.type || 'Schedule conflict')}</div>`).join('')}</div>` : ''}
        </div>`;
      } catch (error) {
        approvedPreview = null;
        approveButton.disabled = true;
        gateState.classList.remove('is-ready');
        gateState.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i>The schedule could not be cleared for approval.';
        previewBox.innerHTML = `<div style="font-size:.74rem;color:#991b1b;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:.7rem;"><i class="bi bi-x-circle me-1"></i>${escHtml(error.message)}</div>`;
      } finally {
        previewButton.disabled = false;
        previewButton.innerHTML = '<i class="bi bi-calendar2-check me-1"></i>Check Schedule';
      }
    });

    approveButton.addEventListener('click', async () => {
      if (!approvedPreview) return;
      const mode = approvedPreview.mode;
      if (mode === 'extend' && !confirm(`Approve the new customer completion date of ${fmtDate(approvedPreview.revisedCompletionDate)}? This creates a formal schedule revision.`)) return;
      approveButton.disabled = true;
      approveButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Applying revision';
      try {
        const r = await fetch(`/api/projects/${projectId}/recovery-plan`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(approvedPreview),
        });
        const result = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(result.error || 'Failed to approve recovery plan');
        closeRecoveryModal();
        const notificationNote = result.customerNotification?.status === 'failed' ? ' Customer notification failed; the revision is still recorded.' : '';
        toast(`${result.message || 'Recovery plan approved'}${notificationNote}`, result.customerNotification?.status === 'failed' ? 'warning' : 'success');
        await loadProject();
      } catch (error) {
        toast(error.message, 'error');
        approveButton.disabled = false;
        syncMode();
      }
    });
    modal.querySelector('.pw-modal')?.focus();
  };

  window.exportReport = function() {
    const p = window.__projectData;
    if (!p) return;
    const wo = window.__lastWorkOrders || [];
    const lines = [
      `PROJECT REPORT — ${p.customer?.name || 'Customer'}`,
      `Service: ${p.service?.name || ''}`,
      `Status: ${p.status}`,
      `Units: ${p.completedUnits || 0}/${p.totalUnits || 0}`,
      `Work Orders: ${wo.length}`,
      ``,
      `WORK ORDERS:`,
      ...wo.map(w => ` - ${w.title || w.section || 'WO'}: ${w.completedUnitCount || 0}/${w.unitCount} (${w.status})`),
      ``,
      `TEAM:`,
      ...(p.assignedTechnicians || []).map(t => ` - ${t.name}`),
      ``,
      `EXPENSES (pending): ₱${(window.__projectExpenseSummary?.pendingTotal || 0).toLocaleString()}`,
      `ISSUES: ${(window.__projectIssues || []).length}`,
    ];
    const w = window.open('', '_blank');
    if (!w) { toast('Allow pop-ups to export', 'error'); return; }
    w.document.write(`<pre style="font-family:monospace;padding:2rem;white-space:pre-wrap;">${lines.join('\n').replace(/</g,'&lt;')}</pre>`);
    w.document.title = `Project_${(p._id || 'report')}.txt`;
    w.document.close();
  };

