        <h6><i class="bi bi-clipboard-check"></i> Your Work Orders (${myWos.length})</h6>
        <div class="pw-wo-list">
          ${myWos.map(wo => {
            const woPct = (wo.unitCount||0) > 0 ? Math.round(((wo.completedUnitCount||0) / wo.unitCount) * 100) : 0;
