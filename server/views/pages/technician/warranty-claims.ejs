<style>
  .tw-page{max-width:1180px;margin:0 auto}.tw-hero{padding:1.5rem;border-radius:18px;background:linear-gradient(135deg,#0f172a,#1d4ed8);color:#fff}.tw-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1rem}.tw-card{border:1px solid #e2e8f0;border-radius:15px;background:#fff;box-shadow:0 5px 20px rgba(15,23,42,.06);overflow:hidden}.tw-head{display:flex;justify-content:space-between;gap:1rem;padding:1rem;border-bottom:1px solid #e2e8f0}.tw-body{padding:1rem}.tw-label{font-size:.65rem;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:.06em}.tw-value{font-size:.82rem;font-weight:650;color:#334155;margin-top:.2rem}.tw-actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}.tw-critical{border-color:#fecaca}.tw-critical .tw-head{background:#fef2f2}.tw-flow{display:flex;gap:.25rem;margin:.8rem 0}.tw-flow span{height:4px;flex:1;border-radius:99px;background:#e2e8f0}.tw-flow span.done{background:#2563eb}
</style>
<div class="tw-page">
  <header class="tw-hero mb-4"><div class="small text-uppercase fw-bold text-info mb-1">Field aftercare</div><h2 class="fw-bold mb-1">Warranty Inspections</h2><p class="mb-0 text-white-50">Use the same controlled field flow as a core service: en route, arrived, inspect, then submit evidence-based findings.</p></header>
  <div class="d-flex justify-content-between align-items-center mb-3"><h5 class="fw-bold mb-0">Assigned work</h5><button class="btn btn-sm btn-outline-primary" id="twRefresh"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button></div>
  <div id="twClaims" class="tw-grid"><div class="text-center text-muted py-5"><span class="spinner-border"></span><div class="mt-2">Loading inspections...</div></div></div>
</div>

<script>
(() => {
  const root=document.getElementById('twClaims');
  const esc=value=>{const n=document.createElement('span');n.textContent=String(value??'');return n.innerHTML;};
  const label=value=>String(value||'').replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase());
  const flow=['inspection_scheduled','inspection_en_route','inspection_arrived','inspection_in_progress','inspection_completed'];
  async function load(){
    root.innerHTML='<div class="text-center text-muted py-5"><span class="spinner-border"></span></div>';
    try{const response=await fetch('/api/technician/warranty-claims',{headers:{Accept:'application/json'}});const data=await response.json();if(!response.ok)throw new Error(data.error||'Unable to load inspections');
      if(!data.claims?.length){root.innerHTML='<div class="tw-card"><div class="tw-body text-center text-muted py-5"><i class="bi bi-shield-check fs-2 d-block mb-2 text-success"></i>No active warranty inspections assigned.</div></div>';return;}
      root.innerHTML=data.claims.map(claim=>{const index=flow.indexOf(claim.status);const next={inspection_scheduled:['inspection_en_route','Start travel'],inspection_en_route:['inspection_arrived','Confirm arrival'],inspection_arrived:['inspection_in_progress','Start inspection']}[claim.status];return `<article class="tw-card ${claim.priority==='critical'?'tw-critical':''}"><div class="tw-head"><div><div class="fw-bold">${esc(claim.claimReference)}</div><div class="small text-muted">${esc(claim.sourceReference)}</div></div><span class="badge ${claim.priority==='critical'?'bg-danger':claim.priority==='high'?'bg-warning text-dark':'bg-primary'}">${esc(label(claim.priority))}</span></div><div class="tw-body"><div class="tw-flow">${flow.map((_,i)=>`<span class="${i<=index?'done':''}"></span>`).join('')}</div><div class="row g-3"><div class="col-6"><div class="tw-label">Customer</div><div class="tw-value">${esc(claim.customerId?.name||'Customer')}</div></div><div class="col-6"><div class="tw-label">Schedule</div><div class="tw-value">${claim.inspection?.scheduledDate?new Date(claim.inspection.scheduledDate).toLocaleDateString('en-PH'):'Not scheduled'} ${esc(claim.inspection?.timeSlot||'')}</div></div><div class="col-12"><div class="tw-label">Address</div><div class="tw-value">${esc(claim.serviceAddress||claim.customerId?.address||'Contact operations for address')}</div></div><div class="col-12"><div class="tw-label">Reported issue</div><div class="tw-value">${esc(claim.description)}</div></div></div><div class="tw-actions">${next?`<button class="btn btn-primary btn-sm" onclick="twMove('${esc(claim._id)}','${next[0]}')">${next[1]}</button>`:''}${claim.status==='inspection_in_progress'?`<button class="btn btn-success btn-sm" onclick="twComplete('${esc(claim._id)}')">Submit findings</button>`:''}${claim.customerId?.phone?`<a class="btn btn-outline-secondary btn-sm" href="tel:${esc(claim.customerId.phone)}"><i class="bi bi-telephone me-1"></i>Call</a>`:''}</div></div></article>`}).join('');
    }catch(error){root.innerHTML=`<div class="alert alert-danger">${esc(error.message)}</div>`;}
  }
  async function patch(id,payload){const response=await fetch(`/api/technician/warranty-claims/${encodeURIComponent(id)}/status`,{method:'PATCH',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify(payload)});const data=await response.json();if(!response.ok)throw new Error(data.error||'Update failed');await load();}
  window.twMove=(id,status)=>patch(id,{status}).catch(error=>alert(error.message));
  window.twComplete=async id=>{const result=await Swal.fire({title:'Submit inspection findings',html:'<textarea id="twDiagnosis" class="swal2-textarea" placeholder="Detailed diagnosis (minimum 20 characters)"></textarea><select id="twRootCause" class="swal2-select"><option value="">Select root cause</option><option value="product_defect">Product defect</option><option value="workmanship">Workmanship</option><option value="replacement_part">Replacement part</option><option value="customer_damage">Customer damage</option><option value="maintenance">Maintenance-related</option><option value="third_party">Third-party work</option><option value="inconclusive">Inconclusive</option></select>',showCancelButton:true,confirmButtonText:'Submit findings',preConfirm:()=>({diagnosis:document.getElementById('twDiagnosis').value,rootCause:document.getElementById('twRootCause').value})});if(result.isConfirmed)patch(id,{status:'inspection_completed',...result.value}).catch(error=>Swal.fire('Unable to submit',error.message,'error'));};
  document.getElementById('twRefresh').addEventListener('click',load);load();
})();
</script>
