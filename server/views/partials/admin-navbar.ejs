            <a
              class="dropdown-item premium-item"
              href="<%= (user && user.role === 'admin') ? '/profile-admin' : (user && user.role === 'secretary') ? '/secretary/profile' : (user && user.role === 'technician') ? '/technician/profile' : '/profile' %>"
