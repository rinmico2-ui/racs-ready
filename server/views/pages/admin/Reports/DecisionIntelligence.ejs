<% const decisionRole = typeof user !== 'undefined' && user && user.role === 'secretary' ? 'secretary' : 'admin'; %>
<% const isDecisionEmbedded = typeof embeddedDecision !== 'undefined' && embeddedDecision; %>
<% if (!isDecisionEmbedded) { %><link rel="stylesheet" href="/css/decision-intelligence.css?v=20261008-tabs"><% } %>
<div class="di-page<%= isDecisionEmbedded ? ' di-embedded' : '' %>" data-decision-role="<%= decisionRole %>">
  <header class="di-hero">
    <div><% if (!isDecisionEmbedded) { %><a href="/<%= decisionRole %>/reports" class="di-back"><i class="bi bi-arrow-left"></i> Report Center</a><% } %><span class="di-kicker">Management intelligence</span><h1>Management Decisions</h1><p>Demand, sales, provisional contribution, customers, and stock signals in one review.</p></div>
    <a href="/<%= decisionRole %>/reports/revenue" class="di-finance-link">Open authoritative financial report <i class="bi bi-arrow-right"></i></a>
  </header>
  <form id="diFilters" class="di-filters">
    <label>Period<select name="range" id="diRange"><option value="today">Today</option><option value="week">This week</option><option value="month" selected>This month</option><option value="quarter">This quarter</option><option value="year">This year</option><option value="custom">Custom range</option></select></label>
    <label class="di-custom">From<input type="date" name="from" id="diFrom"></label>
    <label class="di-custom">To<input type="date" name="to" id="diTo"></label>
    <button type="submit">Apply</button><span id="diPeriod" aria-live="polite"></span>
  </form>
  <div id="diState" role="status">Loading decision intelligence…</div>
  <section aria-labelledby="diAnswersTitle"><div class="di-heading"><span>At a glance</span><h2 id="diAnswersTitle">Answers to the owner’s first questions</h2></div><div id="diAnswers" class="di-answer-grid"></div></section>
  <section aria-labelledby="diActionsTitle"><div class="di-heading"><span>Decision queue</span><h2 id="diActionsTitle">What needs management review?</h2><p>Suggestions follow recorded sales, completed-service use, stock cover, and available cost data. Restock and hold labels are review prompts; no prices or inventory records change here.</p></div><div id="diActions" class="di-actions"></div></section>
  <section aria-labelledby="diServicesTitle">
    <div class="di-heading"><span>Service intelligence</span><h2 id="diServicesTitle">Which services and unit configurations are booked?</h2><p>Booking cohort by creation date. Completed value uses stored booking prices; financial recognition is in Revenue Intelligence.</p></div>
    <div class="di-tabs" role="group" aria-label="Service requests"><button type="button" class="active" data-di-service="all">All services</button><button type="button" data-di-service="top">Most requested</button><button type="button" data-di-service="low">Least requested</button><button type="button" data-di-service="none">No requests</button></div>
    <p id="diServiceSummary" class="di-note" aria-live="polite"></p>
    <div class="di-table-wrap"><table><thead><tr><th>Service / unit</th><th>Demand</th><th>Bookings</th><th>Completed</th><th>Cancelled</th><th>Completed cohort value</th><th>Decision</th></tr></thead><tbody id="diServices"></tbody></table></div><button type="button" id="diServiceMore" class="di-more" hidden>Show 50 more services</button><a href="/<%= decisionRole %>/reports/service" class="di-detail-link">Open service records and drilldowns <i class="bi bi-arrow-right"></i></a>
  </section>
  <section aria-labelledby="diProductsTitle">
    <div class="di-heading"><span>Product intelligence</span><h2 id="diProductsTitle">What sells, gets used, and needs a stock decision?</h2><p>Completed order and counter-sale units are counted separately from parts used on completed services. The last recorded sale looks across all history; unit counts follow the selected period.</p></div>
    <div class="di-tabs" role="group" aria-label="Product category"><button type="button" class="active" data-di-tab="aircon">Aircon</button><button type="button" data-di-tab="tools">Tools</button><button type="button" data-di-tab="parts">Repair parts & consumables</button></div>
    <div class="di-tabs" role="group" aria-label="Sales performance"><button type="button" class="active" data-di-sales="all">All units</button><button type="button" data-di-sales="top">Top sellers</button><button type="button" data-di-sales="low">Low sales</button><button type="button" data-di-sales="none">No sales</button></div>
    <label class="di-product-search">Find a unit <input type="search" id="diProductSearch" placeholder="Search product name, type, or brand" autocomplete="off"></label>
    <p id="diProductSummary" class="di-note" aria-live="polite"></p>
    <div class="di-table-wrap"><table><thead><tr><th>Item</th><th>Stock pressure</th><th>Units sold</th><th>Service use</th><th>Sales after discounts</th><th>Provisional contribution</th><th>Stock / cover</th><th>Last recorded sale</th><th>Suggested action</th></tr></thead><tbody id="diProducts"></tbody></table></div>
    <button type="button" id="diProductMore" class="di-more" hidden>Show 50 more units</button>
    <p id="diProductCaveat" class="di-note"></p><a href="/<%= decisionRole %>/reports/orders" class="di-detail-link">Open order records <i class="bi bi-arrow-right"></i></a> <a href="/<%= decisionRole %>/reports/inventory" class="di-detail-link">Open inventory <i class="bi bi-arrow-right"></i></a>
  </section>
  <section aria-labelledby="diCustomersTitle"><div class="di-heading"><span>Customer intelligence</span><h2 id="diCustomersTitle">Who is active and who needs attention?</h2><p>Scores use completed booking and order activity in the selected period. The follow-up lists use last completed activity across all history. Use these as review prompts before contacting a customer.</p></div><div id="diSegments" class="di-segments"></div><div class="di-tabs" role="group" aria-label="Customer activity"><button type="button" class="active" data-di-customer="top">Top activity</button><button type="button" data-di-customer="followUp">Reconnect after 90 days</button><button type="button" data-di-customer="crossService">Sales or service only</button></div><p id="diCustomerSummary" class="di-note" aria-live="polite"></p><div class="di-table-wrap"><table><thead><tr><th>Customer</th><th>Segment</th><th>Score</th><th>Completed services</th><th>Completed orders</th><th>Recorded cohort value</th><th>Last completed activity</th><th>Suggested follow-up</th></tr></thead><tbody id="diCustomers"></tbody></table></div><p id="diScoring" class="di-note"></p><a href="<%= decisionRole === 'secretary' ? '/secretary/customers' : '/admin/reports/customers' %>" class="di-detail-link"><%= decisionRole === 'secretary' ? 'Open customer records' : 'Open Customer Performance' %> <i class="bi bi-arrow-right"></i></a></section>
  <section aria-labelledby="diLoyaltyTitle"><div class="di-heading"><span>Customer rewards</span><h2 id="diLoyaltyTitle">Who qualifies for a loyalty discount?</h2><p>Uses lifetime completed activity and the active Customer Privileges rules. Checkout applies the best reward to eligible items. Reporting dates do not reset qualification.</p></div><div id="diLoyaltySummary" class="di-segments"></div><div class="di-table-wrap"><table><thead><tr><th>Customer</th><th>Qualified reward</th><th>Completed / required</th><th>Reward progress</th></tr></thead><tbody id="diLoyalty"></tbody></table></div><% if (decisionRole === 'admin') { %><p class="di-policy"><a href="/admin/customers/privileges">Edit completion requirements and discounts in Customer Privileges <i class="bi bi-arrow-right"></i></a></p><% } %></section>
  <aside class="di-method" id="diMethod"></aside>
</div>
<script src="/js/decision-intelligence.js?v=20261009-loyalty-customer" defer></script>
