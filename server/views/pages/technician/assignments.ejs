            ${ta.possibleParts?.length ? `<button type="button" class="btn btn-sm btn-outline-success" style="font-size:0.72rem;" onclick="verifyAiAssistant('${a.bookingId._id}')"><i class="bi bi-box-seam me-1"></i>Select Optional Parts</button>` : ''}
            <button type="button" class="btn btn-sm btn-outline-info" style="font-size:0.72rem;" onclick="generateRepairNotes('${a.bookingId._id}')"><i class="bi bi-file-earmark-text me-1"></i>Generate Notes</button>
          </div>
