    if (!await requirePhaseOneInspectionPayment(bookingId, () => handleDeclineRepair(bookingId))) return;
    const { value: reason, isDismissed } = await Swal.fire({
      title: 'Decline Repair',
      html: `<div style="text-align:left;font-size:0.9rem;">
        <p style="margin-bottom:8px;">Please provide a reason for declining this repair:</p>
        <textarea id="swal-decline-reason" class="swal2-textarea" style="font-size:0.85rem;height:80px;" placeholder="e.g. Customer decided not to proceed, parts unavailable..."></textarea>
      </div>`,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: '<i class="bi bi-x-circle me-1"></i> Confirm Decline',
      confirmButtonColor: '#dc2626',
      cancelButtonText: 'Cancel',
      focusConfirm: false,
      preConfirm: async () => {
        const purchaseBy = document.getElementById('localPurchaseBy')?.value || 'technician';
        const supplierName = document.getElementById('localSupplierName')?.value.trim() || '';
        const supplierAddress = document.getElementById('localSupplierAddress')?.value.trim() || '';
        const supplierContact = document.getElementById('localSupplierContact')?.value.trim() || '';
        const purchaseMinutes = Number(document.getElementById('localPurchaseMinutes')?.value) || 45;
        const supplierCanProvide = Boolean(document.getElementById('localSupplierConfirmed')?.checked);
        const customerAgreed = Boolean(document.getElementById('localCustomerAgreed')?.checked);
        if (!isMixedAssignment(window._detailAssignment) && (!supplierName || !supplierCanProvide || !customerAgreed)) {
          Swal.showValidationMessage('Record a supplier, confirm potential part availability, and confirm customer agreement.');
          return false;
        }
        const val = document.getElementById('swal-decline-reason')?.value?.trim() || '';
        if (!val) { Swal.showValidationMessage('Please provide a reason'); return false; }
        return val;
      }
    });
    if (isDismissed || !reason) return;

    Swal.fire({ title: 'Processing...', html: 'Declining repair...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
    try {
      const resp = await fetch(`/api/technician/appointments/${bookingId}/technician-decline-repair`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason }),
        credentials: 'same-origin'
      });
      const data = await resp.json();
      Swal.close();
      if (!resp.ok && data.code === 'BOOKING_BALANCE_REQUIRED' && isMixedAssignment(window._detailAssignment)) {
        const assignment = window._detailAssignment;
        assignment.balanceAmount = Number(data.balanceAmount || assignment.balanceAmount || 0);
        if (assignment.bookingId && typeof assignment.bookingId === 'object') {
          assignment.bookingId.balanceAmount = assignment.balanceAmount;
        }
        openCollectPaymentModal(assignment._id, assignment, false, () => handleDeclineRepair(bookingId));
        return;
      }
      if (resp.ok && data.success) {
        Swal.fire({
          icon: 'success',
          title: 'Repair Declined',
          html: `<div style="font-size:0.9rem;">${data.mixedBooking && data.remainingCoreItems?.length
            ? `The Repair service was declined. ${data.remainingCoreItems.length} Core service item(s) remain active in this booking.`
            : 'The repair has been declined. The customer will be notified via email.'}</div>`,
          confirmButtonColor: '#dc2626',
        }).then(() => refreshOpenAssignmentDetail(data.mixedBooking ? 'repair-service' : 'overview'));
      } else {
        Swal.fire('Error', data.error || 'Failed to decline.', 'error');
      }
    } catch (e) {
      Swal.close();
      Swal.fire('Error', 'Network error.', 'error');
    }
  }

