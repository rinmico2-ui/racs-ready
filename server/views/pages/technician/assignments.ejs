    padding: 8px 0;
    border-bottom: 1px solid #f8fafc;
  }

  .dminfo-row:last-child {
    border-bottom: none;
  }

  .dminfo-row label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #94a3b8;
    font-weight: 600;
    margin: 0;
  }

  .dminfo-row span {
    font-size: 0.82rem;
    color: #1e293b;
    font-weight: 500;
  }

  .dminfo-fee-row {
    background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    padding: 14px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .dminfo-fee-row label {
    font-size: 0.72rem;
    font-weight: 700;
    color: #166534;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .dminfo-fee-row span {
    font-size: 1.1rem;
    color: #166534;
    font-weight: 800;
  }

  .dminfo-map-card {
    background: #fff;
    border: 1px solid #e8ecf1;
    border-radius: 14px;
    overflow: hidden;
  }

  .dminfo-map-header {
    padding: 14px 18px 10px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fafbfc;
  }

  .dminfo-map-header h6 {
    font-size: 0.72rem;
    font-weight: 700;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dminfo-map-actions {
    display: flex;
    gap: 6px;
