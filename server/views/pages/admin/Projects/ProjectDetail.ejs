    }

    /* ══ WORK ORDERS ══ */
    .wo-card {
      border: 1px solid #e2e8f0; border-radius: 10px; padding: 0.875rem 1rem;
      margin-bottom: 0.625rem; background: #fff;
      transition: box-shadow 0.2s, border-color 0.2s;
    }
    .wo-card:hover { box-shadow: 0 4px 10px rgba(0,0,0,0.07); border-color: #bfdbfe; }
    .wo-daily { display: flex; flex-wrap: wrap; gap: 0.3rem; }
    .wo-daily-pill { font-size: 0.63rem; font-weight: 700; background: #f1f5f9; color: #475569; border-radius: 5px; padding: 0.13rem 0.45rem; display: inline-flex; align-items: center; gap: 0.22rem; }
    .wo-daily-pill.hl { background: #eff6ff; color: #1d4ed8; }
    .wo-dd-wrap { display:flex; flex-direction:column; gap:2px; margin-top:4px; width:100%; }
    .wo-dd-row { display:flex; align-items:center; gap:6px; font-size:0.62rem; padding:2px 4px; border-radius:4px; }
    .wo-dd-row.wo-dd-today { background:#eff6ff; }
    .wo-dd-date { flex-shrink:0; width:85px; font-weight:700; color:#1e293b; }
    .wo-dd-bar { flex:1; height:5px; background:#e9eef5; border-radius:999px; overflow:hidden; min-width:30px; }
    .wo-dd-fill { height:100%; border-radius:999px; background:linear-gradient(90deg,#3b82f6,#60a5fa); transition:width .3s; }
    .wo-dd-num { flex-shrink:0; width:44px; text-align:right; font-weight:700; color:#475569; }
    .wo-title { font-size: 0.9rem; font-weight: 700; color: #0f172a; letter-spacing: -0.01em; }
    .wo-mini { font-size: 0.72rem; color: #64748b; }
    .wo-bar { height: 5px; background: #f1f5f9; border-radius: 999px; overflow: hidden; margin: 0.4rem 0; }
    .wo-bar > div { height: 100%; border-radius: 999px; background: linear-gradient(90deg, #1d4ed8, #3b82f6); transition: width 0.5s ease; }
    .wo-tag { display: inline-flex; align-items: center; gap: 0.28rem; background: #eff6ff; color: #1d4ed8; font-size: 0.69rem; font-weight: 600; padding: 0.18rem 0.45rem; border-radius: 5px; }
    .wo-status { font-size: 0.65rem; font-weight: 700; padding: 0.18rem 0.5rem; border-radius: 5px; text-transform: uppercase; letter-spacing: 0.04em; }
    .wo-status.pending { background: #f1f5f9; color: #64748b; }
    .wo-status.assigned { background: #eff6ff; color: #1e40af; }
    .wo-status.accepted { background: #ecfeff; color: #0e7490; }
    .wo-status.in_progress { background: #ecfdf5; color: #065f46; }
    .wo-status.completed { background: #dbeafe; color: #1e3a8a; }
    .wo-status.cancelled { background: #fef2f2; color: #7f1d1d; }
    .wo-status.en_route { background: #fffbeb; color: #92400e; }
    .wo-status.arrived { background: #f5f3ff; color: #4c1d95; }
    .wo-status.rescheduled { background: #fdf4ff; color: #701a75; }

    /* ══ LIVE STATUS ══ */
    .live-row { display: flex; align-items: center; gap: 0.55rem; padding: 0.45rem 0; border-bottom: 1px solid #f8fafc; }
    .live-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .live-dot.working { background: #16a34a; }
    .live-dot.en_route { background: #f59e0b; }
    .live-dot.arrived { background: #7c3aed; }
    .live-dot.delayed { background: #dc2626; }
    .live-dot.completed { background: #2563eb; }
    .pill-btn { font-size: 0.67rem; font-weight: 600; border: 1px solid #e2e8f0; background: #fff; border-radius: 6px; padding: 0.22rem 0.55rem; cursor: pointer; transition: background 0.15s; }
    .pill-btn:hover { background: #f8fafc; border-color: #cbd5e1; }

    /* ══ TEAM ══ */
    .team-lead {
      display: flex; align-items: center; gap: 0.65rem; padding: 0.65rem 0.75rem;
      background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; margin-bottom: 0.5rem;
    }
    .tech-avatar {
      width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      background: #1d4ed8; color: #fff; font-weight: 700; font-size: 0.875rem;
    }
    .tech-row { display: flex; align-items: center; gap: 0.55rem; padding: 0.45rem 0; border-bottom: 1px solid #f8fafc; }
    .tech-row:last-child { border-bottom: none; }
    .cap-pill { font-size: 0.67rem; font-weight: 700; padding: 0.22rem 0.55rem; border-radius: 5px; background: #ecfdf5; color: #15803d; }

    /* ══ TIMELINE ══ */
    .tl-day { font-size: 0.67rem; font-weight: 600; color: #1d4ed8; text-transform: uppercase; letter-spacing: 0.07em; margin: 0.75rem 0 0.35rem; }
    .tl-row { display: flex; align-items: center; gap: 0.55rem; padding: 0.4rem 0; border-bottom: 1px solid #f8fafc; font-size: 0.82rem; }
    .tl-dot { width: 8px; height: 8px; border-radius: 50%; background: #1d4ed8; flex-shrink: 0; }

    /* ══ INFO ROWS ══ */
    .info-row { display: flex; gap: 0.55rem; padding: 0.45rem 0; border-bottom: 1px solid #f8fafc; font-size: 0.82rem; }
    .info-row:last-child { border-bottom: none; }
    .info-row .ik { width: 20px; color: #94a3b8; flex-shrink: 0; text-align: center; font-size: 0.85rem; }
    .info-row .iv { color: #334155; }

    /* ══ BUTTONS ══ */
    .pd-btn {
      padding: 0.4rem 0.875rem; border-radius: 8px;
      font-size: 0.78rem; font-weight: 600;
      border: 1px solid #e2e8f0; background: #fff; cursor: pointer;
