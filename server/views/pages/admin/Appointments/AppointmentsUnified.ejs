  AU.Queue.loadQueue=function(page){
    page=page||1;_qPage=page;
    var searchEl=document.getElementById('aqSearchInput');
    var filter=_qStatusFilter||'all_active';
    var search=searchEl?searchEl.value:'';
    var url;
    if(filter==='all_active')url='/api/admin/appointments/list?page='+page+'&limit=20&status=awaiting_assignment,pending_reassignment';
    else url='/api/admin/appointments/list?status='+filter+'&page='+page+'&limit=20';
    if(search)url+='&search='+encodeURIComponent(search);
    var container=document.getElementById('queueContainer');
    fetch(url).then(function(r){return r.json();}).then(function(data){
      if(!data.bookings||!data.bookings.length){container.innerHTML='<div class="au-empty-state"><div class="au-empty-state-icon"><i class="bi bi-inbox"></i></div><h6>No Bookings in Queue</h6><p>All assignments have been handled</p></div>';document.getElementById('aqPagination').innerHTML='';return;}
      var statusColors={awaiting_assignment:'bg-warning text-dark',assigned:'bg-info text-dark',pending_reassignment:'bg-danger',payment_verified:'bg-success',confirmed:'bg-primary','waiting-for-customer':'bg-warning text-dark'};
      container.innerHTML=data.bookings.map(function(b){
        var canAssign=['awaiting_assignment','pending_reassignment'].indexOf(b.status)!==-1;
        var isWaitingCustomer=b.status==='waiting-for-customer';
        var rc=b.reassignmentCount||0;
        var isEsc=b.escalated||rc>=3;
        var hist=b.cancellationHistory||[];
        var last=hist.length>0?hist[hist.length-1]:null;
        // Overdue when the scheduled service window has fully elapsed
        // (mirrors server-side isBookingPast: endTime, else start + duration)
        var overdue=false;
        if(b.bookingDate){
          var aqParseMin=function(t){if(!t)return NaN;var m=String(t).trim().match(/^(\d{1,2})(?::(\d{2}))?\s*(AM|PM)?$/i);if(!m)return NaN;var h=Number(m[1])%12;if(m[3]&&/pm/i.test(m[3]))h+=12;return h*60+Number(m[2]||0);};
          var vd=new Date(b.bookingDate);
          var eMin=aqParseMin(b.endTime);
          if(!Number.isFinite(eMin)){var sMin=aqParseMin(b.startTime);eMin=Number.isFinite(sMin)?sMin+(Number(b.serviceDurationMinutes)||60):NaN;}
          if(Number.isFinite(eMin))vd.setHours(Math.floor(eMin/60),eMin%60,0,0);else vd.setHours(23,59,59,999);
          overdue=vd.getTime()<Date.now();
        }
        if(!overdue)overdue=!!b.autoReschedulePending;
        var custName=(b.customer?b.customer.name:'').replace(/'/g,"\\'");
        var servName=((b.service?b.service.name:'')||(b.serviceModel==='RepairService'||b.serviceType==='repair'?'Repair Service':'')).replace(/'/g,"\\'");
        var schedDate=b.bookingDate?new Date(b.bookingDate).toISOString().slice(0,10):'';
        var schedTime=String(b.startTime||'').replace(/'/g,"\\'");
        var queueStatusLabel=statusLabel(b.status);
        return '<div class="aq-booking-card"><div class="aq-booking-header"><div><div class="aq-booking-id">#'+b._id.toString().slice(-8).toUpperCase()+'</div><div class="aq-booking-customer">'+(b.customer?b.customer.name:'Customer')+'</div><div class="aq-booking-service">'+(b.service?b.service.name:(b.serviceModel==='RepairService'||b.serviceType==='repair'?'Repair Service':'Service'))+(b.isMultiService?' (Multi-Service)':'')+'</div></div><div class="text-end d-flex flex-column align-items-end gap-1">'+(b.maintenance&&b.maintenance.isMaintenance?'<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle"><i class="bi bi-calendar2-check me-1"></i>Preventive Maintenance</span>':'')+(overdue?'<span class="aq-overdue-badge"><i class="bi bi-alarm-fill"></i>Past Schedule &middot; Needs Resolution</span>':'')+(isEsc?'<span class="aq-escalation-badge"><i class="bi bi-exclamation-triangle-fill"></i>Escalated ('+rc+'x)</span>':'')+(isWaitingCustomer?'<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Waiting for Customer</span>':'')+(overdue?'':'<span class="badge '+(statusColors[b.status]||'bg-secondary')+'">'+queueStatusLabel+'</span>')+'</div></div><div class="aq-detail-grid"><div class="aq-detail-item"><i class="bi bi-calendar"></i> '+formatDate(b.bookingDate)+'</div><div class="aq-detail-item"><i class="bi bi-clock"></i> '+formatTime(b.startTime)+'</div><div class="aq-detail-item"><i class="bi bi-geo-alt"></i> '+((b.location?b.location.address:'No address')||'No address').substring(0,30)+'</div><div class="aq-detail-item"><i class="bi bi-cash"></i> \u20B1'+Number(b.totalPrice||b.estimatedFee||0).toLocaleString()+'</div><div class="aq-detail-item"><i class="bi bi-credit-card"></i> '+(b.paymentMethod||'cod').toUpperCase()+'</div><div class="aq-detail-item"><i class="bi bi-person"></i> '+(b.technician?b.technician.name:'Unassigned')+'</div>'+(rc>0?'<div class="aq-detail-item"><i class="bi bi-arrow-repeat"></i> Reassigned '+rc+' time'+(rc>1?'s':'')+'</div>':'')+'</div>'+
        (overdue?'<div class="aq-reassign-alert aq-overdue-alert"><i class="bi bi-alarm me-1"></i><strong>Exceeded Schedule</strong> \u2014 The scheduled time has already passed. Resolve this booking via the Resolution Center before assigning.</div>':'')+
        (b.status==='pending_reassignment'&&!overdue?'<div class="aq-reassign-alert"><i class="bi bi-arrow-repeat me-1"></i><strong>Needs Reassignment</strong> \u2014 Previous technician '+(last?last.action:'declined')+' this job.</div>':'')+
        (hist.length>0?'<div class="aq-cancel-history"><div class="aq-cancel-history-title"><i class="bi bi-clock-history me-1"></i>Cancellation History</div>'+hist.slice(-3).reverse().map(function(h){return '<div class="aq-cancel-history-item"><span class="action-badge action-'+(h.action==='auto_reschedule'?'reassigned':h.action)+'">'+h.action+'</span><span><strong>'+h.technicianName+'</strong> \u2014 '+(h.reason||'No reason')+' <small class="text-muted">'+new Date(h.timestamp).toLocaleDateString('en-PH',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'})+'</small></span></div>';}).join('')+'</div>':'')+
        (canAssign&&!overdue?'<div id="aqRec-'+b._id+'" class="border rounded-3 p-3 mt-3" style="background:#f8fafc"><div class="d-flex align-items-center gap-2 text-muted small"><span class="spinner-border spinner-border-sm"></span>Analyzing the best technician...</div></div>':'')+
        (canAssign?'<div class="aq-action-bar"><button class="au-btn au-btn-ghost" onclick="AU.Queue.viewBooking(\''+b._id+'\')" style="font-size:0.75rem;"><i class="bi bi-eye me-1"></i>View</button>'+(overdue?'<a class="au-btn au-btn-danger" href="'+bookingResolutionUrl(b)+'" style="font-size:0.75rem;"><i class="bi bi-exclamation-diamond me-1"></i>Resolve Issue</a>':'<button class="au-btn au-btn-primary" onclick="AU.Queue.openAssignModal(\''+b._id+'\',\''+custName+'\',\''+servName+'\',\''+schedDate+'\',\''+schedTime+'\')" style="font-size:0.75rem;"><i class="bi bi-person-plus me-1"></i>Choose Another Technician</button>')+'</div>':'')+
        '</div>';
      }).join('');
      AU.Queue.loadRecommendations();
      var pag=data.pagination||{};
      if(pag.pages>1){
        var pg='<ul class="pagination pagination-sm">';
        for(var i=1;i<=pag.pages;i++)pg+='<li class="page-item '+(i===pag.page?'active':'')+'"><button class="page-link" onclick="AU.Queue.loadQueue('+i+')">'+i+'</button></li>';
        pg+='</ul>';
        document.getElementById('aqPagination').innerHTML=pg;
      }else document.getElementById('aqPagination').innerHTML='';
    }).catch(function(){container.innerHTML='<div class="alert alert-danger">Failed to load queue</div>';});
  };

  function qEsc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}

  AU.Queue.loadRecommendations=function(){
    var filter=_qStatusFilter||'all_active';
    var statuses=filter==='all_active'?'awaiting_assignment,pending_reassignment':filter;
    fetch('/api/admin/appointments/assignment-plan?status='+encodeURIComponent(statuses)).then(function(r){return r.json().then(function(d){if(!r.ok)throw new Error(d.error||'Failed');return d;});}).then(function(data){
      _qRecommendations={};
      (data.plan||[]).forEach(function(row){
        _qRecommendations[row.bookingId]=row;
        var el=document.getElementById('aqRec-'+row.bookingId);if(!el)return;
        if(!row.recommended){el.innerHTML='<div class="text-warning small"><i class="bi bi-exclamation-triangle me-1"></i>No conflict-free technician is currently available.</div>';return;}
        var r=row.recommended;
        el.innerHTML='<div class="d-flex justify-content-between gap-3 flex-wrap"><div><div class="small text-uppercase text-muted fw-bold"><i class="bi bi-stars text-warning me-1"></i>Recommended Technician</div><div class="fw-bold fs-6 mt-1">⭐ '+qEsc(r.name)+' <span class="badge bg-primary-subtle text-primary ms-1">Score '+r.score+'</span></div><ul class="small text-muted mb-0 mt-1 ps-3">'+r.reasons.slice(0,4).map(function(x){return'<li>'+qEsc(x)+'</li>';}).join('')+'</ul></div><button class="au-btn au-btn-primary align-self-center" onclick="AU.Queue.assignRecommended(\''+row.bookingId+'\')"><i class="bi bi-check2-circle me-1"></i>Assign Recommended</button></div>';
      });
      document.querySelectorAll('[id^="aqRec-"]').forEach(function(el){var id=el.id.slice(6);if(!_qRecommendations[id])el.innerHTML='<div class="small text-muted"><i class="bi bi-info-circle me-1"></i>No recommendation available for this booking.</div>';});
    }).catch(function(){document.querySelectorAll('[id^="aqRec-"]').forEach(function(el){el.innerHTML='<div class="small text-danger">Recommendation could not be loaded.</div>';});});
  };

  AU.Queue.assignRecommended=function(bookingId){
    var row=_qRecommendations[bookingId];if(!row||!row.recommended)return;
    var r=row.recommended;
    var details=(r.reasons||[]).map(function(x){return '• '+x;}).join('\n');
    if(!window.confirm('Assign '+r.name+' and notify the technician?'+(details?'\n\nWhy recommended:\n'+details:'')))return;
    var button=document.querySelector('[onclick="AU.Queue.assignRecommended(\''+bookingId+'\')"]');
    var original=button?button.innerHTML:'';
    if(button){button.disabled=true;button.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Assigning...';}
    fetch('/api/admin/appointments/assignment-plan/confirm',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({assignments:[{bookingId:bookingId,technicianId:r.technicianId}],responseMinutes:30})}).then(function(resp){return resp.json().then(function(d){if(!resp.ok||!d.assigned)throw new Error(d.results?.[0]?.error||d.error||'Assignment failed');return d;});}).then(function(){showNotification({type:'success',title:'Technician Assigned',message:r.name+' was notified.',duration:4000});AU.Queue.loadQueue(_qPage);AU.Queue.loadStats();}).catch(function(e){showNotification({type:'error',title:'Assignment Failed',message:e.message,duration:5000});if(button){button.disabled=false;button.innerHTML=original;}});
  };

