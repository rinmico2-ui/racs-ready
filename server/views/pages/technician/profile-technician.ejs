<div class="admin-dashboard container-fluid px-0 py-4 profile-technician-page">
  <%- include('../../partials/dashboard-styles') %>

  <div class="dashboard-hero mb-4">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h1 class="page-title">
          <i class="bi bi-person-circle me-2"></i>Technician Profile
        </h1>
        <p class="hero-sub small">
          View your account details, availability, and customer rating.
        </p>
      </div>
    </div>
  </div>

  <%
    const fullName = [user.firstName, user.lastName].filter(Boolean).join(' ') || (techProfile && techProfile.name) || 'Technician';
    const email = user.email || (techProfile && techProfile.userEmail) || '';
    const phone = user.phone || (techProfile && techProfile.phone) || '';
    const initials = (fullName || 'T').split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase();
    const status = (techProfile && techProfile.availabilityStatus) ? techProfile.availabilityStatus : 'Offline';
    const statusClass = { 'Available':'success', 'Assigned':'primary', 'On The Way':'info', 'In Progress':'warning', 'Unavailable':'secondary', 'Offline':'dark' }[status] || 'secondary';
    const joined = user.createdAt || (techProfile && techProfile.createdAt);
    const lastLogin = user.lastLogin;
    const rating = (techProfile && techProfile.rating) ? techProfile.rating : 0;
    const ratingCount = (techProfile && techProfile.ratingCount) ? techProfile.ratingCount : 0;
    const active = techProfile ? techProfile.active : true;
  %>

  <div class="row gy-4">
    <div class="col-lg-4">
      <div class="card shadow-lg border-0 text-center p-4 h-100">
        <div class="d-flex justify-content-center mb-3">
          <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:96px;height:96px;font-size:2.5rem;font-weight:600;">
            <%= initials %>
          </div>
        </div>
        <h4 class="fw-bold mb-1"><%= fullName %></h4>
        <p class="text-muted mb-3">Technician</p>
        <div class="d-flex justify-content-center gap-2 mb-3 flex-wrap">
          <span class="badge bg-<%= active ? 'success' : 'danger' %>"><%= active ? 'Active' : 'Inactive' %></span>
          <span class="badge bg-<%= statusClass %>"><%= status %></span>
        </div>
        <div class="d-flex justify-content-center align-items-center gap-1 text-warning fs-5 mb-1">
          <% for (let i = 1; i <= 5; i++) { %>
            <i class="bi bi-star<%= i <= Math.round(rating) ? '-fill' : '' %>"></i>
          <% } %>
          <span class="text-muted small ms-2">(<%= ratingCount %>)</span>
        </div>
        <p class="text-muted small"><%= rating ? rating.toFixed(1) + ' / 5.0' : 'Unrated' %></p>
        <hr>
        <div class="text-start small">
          <div class="mb-2"><i class="bi bi-envelope me-2 text-muted"></i><%= email || 'No email on file' %></div>
          <div class="mb-2"><i class="bi bi-telephone me-2 text-muted"></i><%= phone || 'No phone on file' %></div>
          <div><i class="bi bi-geo-alt me-2 text-muted"></i><%= (techProfile && techProfile.locationText) ? techProfile.locationText : 'Location not set' %></div>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card shadow-lg border-0 h-100">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-4">Account Information</h5>
          <form class="row gx-3 gy-3">
            <div class="col-md-6">
              <label class="form-label small text-muted">First Name</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <input type="text" class="form-control" value="<%= user.firstName || '' %>" readonly>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label small text-muted">Last Name</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <input type="text" class="form-control" value="<%= user.lastName || '' %>" readonly>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label small text-muted">Email</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input type="email" class="form-control" value="<%= email %>" readonly>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label small text-muted">Phone</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                <input type="tel" class="form-control" value="<%= phone %>" readonly>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label small text-muted">Employed Since</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-calendar-check"></i></span>
                <input type="text" class="form-control" value="<%= joined ? new Date(joined).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) : '' %>" readonly>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label small text-muted">Last Login</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-clock"></i></span>
                <input type="text" class="form-control" value="<%= lastLogin ? new Date(lastLogin).toLocaleString() : 'Never' %>" readonly>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label small text-muted">Customer Rating</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-star"></i></span>
                <input type="text" class="form-control" value="<%= rating ? rating.toFixed(1) + ' / 5.0 (' + ratingCount + ' reviews)' : 'Unrated' %>" readonly>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label small text-muted">Role</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-briefcase"></i></span>
                <input type="text" class="form-control" value="Technician" readonly>
              </div>
            </div>
          </form>
          <div class="mt-4 d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="/technician">
              <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-lg border-0 mt-4">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
        <div>
          <h5 class="fw-bold mb-1"><i class="bi bi-laptop me-2"></i>Trusted Devices</h5>
          <p class="text-muted small mb-0">Trusted devices can skip technician login OTP for up to 30 days. Your password is always required.</p>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="refreshTrustedDevices">
          <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
      </div>
      <div id="trustedDevicesList" aria-live="polite">
        <div class="text-muted small">Loading trusted devices...</div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';
  var list = document.getElementById('trustedDevicesList');
  var refresh = document.getElementById('refreshTrustedDevices');
  if (!list) return;

  function formatDate(value) {
    if (!value) return 'Unknown';
    var date = new Date(value);
    return Number.isNaN(date.getTime()) ? 'Unknown' : date.toLocaleString();
  }

  function render(devices) {
    list.replaceChildren();
    if (!devices.length) {
      var empty = document.createElement('div');
      empty.className = 'alert alert-light border mb-0 small text-muted';
      empty.textContent = 'No trusted devices. An OTP will be required on the next technician login.';
      list.appendChild(empty);
      return;
    }

    devices.forEach(function (device) {
      var row = document.createElement('div');
      row.className = 'd-flex justify-content-between align-items-center gap-3 border rounded-3 p-3 mb-2 flex-wrap';

      var details = document.createElement('div');
      var title = document.createElement('div');
      title.className = 'fw-semibold';
      title.textContent = device.label || 'Trusted device';
      if (device.current) {
        var badge = document.createElement('span');
        badge.className = 'badge bg-success ms-2';
        badge.textContent = 'This device';
        title.appendChild(badge);
      }
      var meta = document.createElement('div');
      meta.className = 'small text-muted mt-1';
      meta.textContent = 'Last used ' + formatDate(device.lastUsedAt) + ' · Expires ' + formatDate(device.expiresAt);
      details.appendChild(title);
      details.appendChild(meta);

      var revoke = document.createElement('button');
      revoke.type = 'button';
      revoke.className = 'btn btn-outline-danger btn-sm';
      revoke.innerHTML = '<i class="bi bi-x-circle me-1"></i>Revoke';
      revoke.addEventListener('click', function () { revokeDevice(device, revoke); });

      row.appendChild(details);
      row.appendChild(revoke);
      list.appendChild(row);
    });
  }

  async function load() {
    list.innerHTML = '<div class="text-muted small">Loading trusted devices...</div>';
    try {
      var response = await fetch('/api/users/me/trusted-devices', {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { Accept: 'application/json' },
      });
      var body = await response.json().catch(function () { return {}; });
      if (!response.ok) throw new Error(body.error || 'Unable to load trusted devices.');
      render(Array.isArray(body.devices) ? body.devices : []);
    } catch (error) {
      list.innerHTML = '<div class="alert alert-danger mb-0 small"></div>';
      list.firstElementChild.textContent = error.message || 'Unable to load trusted devices.';
    }
  }

  async function revokeDevice(device, button) {
    var confirmed = await Swal.fire({
      icon: 'warning',
      title: 'Revoke trusted device?',
      text: device.current
        ? 'This browser will require OTP the next time you sign in.'
        : 'That device will require OTP on its next sign-in.',
      showCancelButton: true,
      confirmButtonText: 'Revoke device',
      confirmButtonColor: '#dc3545',
    });
    if (!confirmed.isConfirmed) return;

    button.disabled = true;
    try {
      var response = await fetch('/api/users/me/trusted-devices/' + encodeURIComponent(device.id), {
        method: 'DELETE',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      });
      var body = await response.json().catch(function () { return {}; });
      if (!response.ok) throw new Error(body.error || 'Unable to revoke device.');
      await Swal.fire({ icon: 'success', title: 'Device revoked', text: body.message || 'The device was removed.', timer: 1800, showConfirmButton: false });
      load();
    } catch (error) {
      button.disabled = false;
      Swal.fire({ icon: 'error', title: 'Unable to revoke', text: error.message || 'Please try again.' });
    }
  }

  if (refresh) refresh.addEventListener('click', load);
  load();
})();
</script>
