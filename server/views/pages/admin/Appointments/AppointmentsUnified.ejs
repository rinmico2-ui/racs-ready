  AU.Pending.load=function(){
    Promise.all([
      fetch('/api/admin/appointments/list?stage=pending_review&page=1&limit=500').then(function(r){return r.json();}),
      fetch('/api/admin/appointments/flow-stats').then(function(r){return r.json();})
