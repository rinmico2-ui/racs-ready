<div class="order-report container-fluid px-0 py-4">
  <%- include('../../../partials/dashboard-styles') %>
  <link rel="stylesheet" href="/css/analytics.css">
  <style>
    .or-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.or-card{background:#fff;border:1px solid #e8edf5;border-radius:16px;box-shadow:0 3px 16px rgba(15,23,42,.045)}
    .or-kpi{padding:18px;position:relative;overflow:hidden}.or-kpi:before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:var(--accent,#2563eb)}.or-kpi-top{display:flex;align-items:center;justify-content:space-between}.or-icon{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:color-mix(in srgb,var(--accent) 12%,white);color:var(--accent)}
    .or-label{font-size:.7rem;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-top:14px}.or-value{font:700 1.45rem/1.2 Outfit,Inter,sans-serif;color:#0f172a;margin-top:3px}.or-meta{font-size:.69rem;color:#94a3b8;margin-top:5px}.or-delta{font-size:.68rem;font-weight:700;padding:3px 8px;border-radius:999px}.or-up{color:#047857;background:#ecfdf5}.or-down{color:#b91c1c;background:#fef2f2}
    .or-section{margin:28px 0 12px;display:flex;align-items:center;justify-content:space-between}.or-section h2{font:700 .92rem Outfit,Inter,sans-serif;color:#334155;text-transform:uppercase;letter-spacing:.06em;margin:0;border-left:4px solid #2563eb;padding-left:10px}.or-chart{height:275px;padding:18px}.or-card-head{padding:15px 18px;border-bottom:1px solid #eef2f7;display:flex;justify-content:space-between;align-items:center}.or-card-head h3{font-size:.84rem;font-weight:700;color:#1e293b;margin:0}.or-card-body{padding:16px 18px}.or-two{display:grid;grid-template-columns:2fr 1fr;gap:16px}.or-three{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .or-table{width:100%;border-collapse:collapse;font-size:.78rem}.or-table th{font-size:.64rem;text-transform:uppercase;letter-spacing:.05em;color:#94a3b8;padding:9px 8px;border-bottom:1px solid #e2e8f0}.or-table td{padding:11px 8px;border-bottom:1px solid #f1f5f9;color:#475569;vertical-align:middle}.or-table tr:last-child td{border:0}.or-rank{width:25px;height:25px;border-radius:8px;background:#eff6ff;color:#2563eb;display:grid;place-items:center;font-weight:700}.or-badge{font-size:.63rem;font-weight:700;padding:4px 8px;border-radius:999px;background:#f1f5f9;color:#475569;white-space:nowrap}.or-badge.completed,.or-badge.paid,.or-badge.verified,.or-badge.remitted{background:#ecfdf5;color:#047857}.or-badge.cancelled,.or-badge.failed,.or-badge.rejected{background:#fef2f2;color:#b91c1c}.or-badge.pending_payment,.or-badge.pending,.or-badge.partial{background:#fffbeb;color:#b45309}
    .or-insights{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.or-insight{padding:16px;display:flex;gap:12px}.or-insight-icon{width:38px;height:38px;flex:none;border-radius:11px;display:grid;place-items:center;background:#eff6ff;color:#2563eb}.or-insight.warning .or-insight-icon{background:#fffbeb;color:#d97706}.or-insight.danger .or-insight-icon{background:#fef2f2;color:#dc2626}.or-insight.success .or-insight-icon{background:#ecfdf5;color:#059669}.or-insight h4{font-size:.79rem;font-weight:700;color:#1e293b;margin:1px 0 4px}.or-insight p{font-size:.71rem;color:#64748b;line-height:1.45;margin:0}.or-empty{text-align:center;color:#94a3b8;padding:28px 12px}
    .or-filter-card{padding:0;overflow:hidden}.or-filter-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 18px;border-bottom:1px solid #e8edf5;background:#f8fafc}.or-filter-title{font-size:.82rem;font-weight:800;color:#1e293b}.or-filter-subtitle{font-size:.68rem;color:#64748b;margin-top:2px}.or-filter-count{font-size:.65rem;font-weight:800;color:#1d4ed8;background:#dbeafe;border-radius:999px;padding:5px 9px}.or-filter-body{padding:16px 18px}.or-date-row{display:flex;gap:10px;align-items:end;flex-wrap:wrap;padding-bottom:14px;margin-bottom:14px;border-bottom:1px solid #eef2f7}.or-filter-grid{display:grid;grid-template-columns:minmax(210px,1.5fr) repeat(3,minmax(150px,1fr));gap:12px}.or-field{display:flex;flex-direction:column;gap:5px;min-width:0}.or-field label{font-size:.62rem;font-weight:800;color:#64748b;text-transform:uppercase;letter-spacing:.055em}.or-field select,.or-field input{width:100%;height:38px;border:1px solid #dbe3ee;border-radius:8px;padding:8px 10px;font-size:.76rem;background:#fff;color:#334155;outline:none}.or-field select:focus,.or-field input:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1)}.or-custom{display:flex;gap:8px;align-items:center}.or-custom .or-field{min-width:145px}.or-filter-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;margin-top:15px;padding-top:14px;border-top:1px solid #eef2f7}.or-export{border:0;border-radius:8px;padding:9px 13px;background:#2563eb;color:#fff;font-size:.76rem;font-weight:700}.or-export.secondary{background:#fff;color:#475569;border:1px solid #dbe3ee;text-decoration:none}.or-export.secondary:hover{background:#f8fafc;color:#1e293b}.or-export:disabled{background:#94a3b8;cursor:not-allowed}
    @media(max-width:1199px){.or-grid{grid-template-columns:repeat(3,1fr)}.or-filter-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:900px){.or-two,.or-three{grid-template-columns:1fr}.or-insights{grid-template-columns:1fr 1fr}.or-filter-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.or-grid{grid-template-columns:repeat(2,1fr)}.or-insights{grid-template-columns:1fr}.or-value{font-size:1.2rem}.or-filter-grid{grid-template-columns:1fr}.or-date-row{align-items:stretch}.or-date-row>.or-field{width:100%}.or-custom{width:100%}.or-custom .or-field{min-width:0;flex:1}.or-filter-actions{flex-wrap:wrap}.or-filter-actions .or-export{flex:1;white-space:nowrap}}
  </style>

  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left"><div class="au-hero-icon"><i class="bi bi-bag-check-fill"></i></div><div><h1>Order Analytics</h1><p>Commercial demand, revenue quality, and fulfillment performance</p></div></div>
      <div class="au-hero-actions"><a class="btn btn-light btn-sm" href="/admin/appointments/orders"><i class="bi bi-receipt me-1"></i> Manage Orders</a><a class="btn btn-outline-light btn-sm" href="/products" target="_blank"><i class="bi bi-box-arrow-up-right me-1"></i> View Store</a></div>
    </div>
  </div>

  <form class="or-card or-filter-card mb-4" method="get" id="orderReportFilter">
    <div class="or-filter-head">
      <div><div class="or-filter-title"><i class="bi bi-sliders2 me-2 text-primary"></i>Report controls</div><div class="or-filter-subtitle">All KPIs, charts, drilldowns, and exports use these filters.</div></div>
      <% if(filters.activeCount){ %><span class="or-filter-count"><%= filters.activeCount %> active filter<%= filters.activeCount===1?'':'s' %></span><% } %>
    </div>
    <div class="or-filter-body">
      <div class="or-date-row">
        <div class="or-field" style="min-width:190px"><label for="orderRange">Reporting window</label><select name="range" id="orderRange"><option value="today" <%= filters.range==='today'?'selected':'' %>>Today</option><option value="7" <%= filters.range==='7'?'selected':'' %>>Last 7 days</option><option value="30" <%= filters.range==='30'?'selected':'' %>>Last 30 days</option><option value="mtd" <%= filters.range==='mtd'?'selected':'' %>>Month to date</option><option value="qtd" <%= filters.range==='qtd'?'selected':'' %>>Quarter to date</option><option value="ytd" <%= filters.range==='ytd'?'selected':'' %>>Year to date</option><option value="90" <%= filters.range==='90'?'selected':'' %>>Last 90 days</option><option value="365" <%= filters.range==='365'?'selected':'' %>>Last 12 months</option><option value="custom" <%= filters.range==='custom'?'selected':'' %>>Custom range</option></select></div>
        <div class="or-custom" style="<%= filters.range==='custom'?'':'display:none' %>"><div class="or-field"><label for="orderFrom">From</label><input id="orderFrom" type="date" name="from" value="<%= filters.from %>"></div><div class="or-field"><label for="orderTo">To</label><input id="orderTo" type="date" name="to" value="<%= filters.to %>"></div></div>
      </div>
      <div class="or-filter-grid">
        <div class="or-field"><label for="orderSearch">Search</label><input id="orderSearch" name="q" value="<%= filters.q %>" maxlength="80" placeholder="Reference, customer, product…"></div>
        <div class="or-field"><label for="orderStatus">Order status</label><select id="orderStatus" name="status"><option value="">All order statuses</option><% [['pending_payment','Pending payment'],['preparing_unit','Preparing unit'],['ready_for_pickup','Ready for pickup'],['technician_assigned','Technician assigned'],['technician_accepted','Technician accepted'],['technician_declined','Technician declined'],['out_for_delivery','Out for delivery'],['arrived','Arrived'],['installing','Installing'],['completed','Completed'],['cancelled','Cancelled']].forEach(function(option){ %><option value="<%= option[0] %>" <%= filters.status===option[0]?'selected':'' %>><%= option[1] %></option><% }); %></select></div>
        <div class="or-field"><label for="paymentStatus">Payment status</label><select id="paymentStatus" name="paymentStatus"><option value="">All payment statuses</option><% [['pending','Pending'],['partial','Partial'],['payment_collected','Collected'],['waiting_for_remittance','Awaiting remittance'],['remitted','Remitted'],['verified','Verified'],['paid','Paid'],['refunded','Refunded'],['rejected','Rejected'],['failed','Failed']].forEach(function(option){ %><option value="<%= option[0] %>" <%= filters.paymentStatus===option[0]?'selected':'' %>><%= option[1] %></option><% }); %></select></div>
        <div class="or-field"><label for="fulfillment">Fulfillment</label><select id="fulfillment" name="fulfillment"><option value="">All fulfillment types</option><option value="delivery_only" <%= filters.fulfillment==='delivery_only'?'selected':'' %>>Delivery only</option><option value="delivery_installation" <%= filters.fulfillment==='delivery_installation'?'selected':'' %>>Delivery + installation</option><option value="customer_pickup" <%= filters.fulfillment==='customer_pickup'?'selected':'' %>>Customer pickup</option></select></div>
        <div class="or-field"><label for="paymentMethod">Payment method</label><select id="paymentMethod" name="paymentMethod"><option value="">All payment methods</option><% [['cod','Cash on delivery'],['cash','Cash'],['cash_onsite','Cash on-site'],['gcash','GCash'],['gcash_full','GCash full payment'],['gcash_downpayment','GCash downpayment'],['downpayment','Downpayment'],['paymongo','PayMongo'],['other','Other']].forEach(function(option){ %><option value="<%= option[0] %>" <%= filters.paymentMethod===option[0]?'selected':'' %>><%= option[1] %></option><% }); %></select></div>
        <div class="or-field"><label for="technician">Technician</label><select id="technician" name="technician"><option value="">All technicians</option><option value="unassigned" <%= filters.technician==='unassigned'?'selected':'' %>>Unassigned</option><% filterOptions.technicians.forEach(function(technician){ %><option value="<%= technician.id %>" <%= filters.technician===technician.id?'selected':'' %>><%= technician.name %><%= technician.active?'':' (inactive)' %></option><% }); %></select></div>
        <div class="or-field"><label for="brand">Product brand</label><select id="brand" name="brand"><option value="">All brands</option><% filterOptions.brands.forEach(function(brand){ %><option value="<%= brand %>" <%= filters.brand===brand?'selected':'' %>><%= brand %></option><% }); %></select></div>
        <div class="or-field"><label>Order value (PHP)</label><div class="d-flex gap-2"><input aria-label="Minimum order value" name="minValue" type="number" min="0" max="1000000000" step="0.01" placeholder="Minimum" value="<%= filters.minValue===null?'':filters.minValue %>"><input aria-label="Maximum order value" name="maxValue" type="number" min="0" max="1000000000" step="0.01" placeholder="Maximum" value="<%= filters.maxValue===null?'':filters.maxValue %>"></div></div>
      </div>
      <div class="or-filter-actions"><a class="or-export secondary" href="/admin/reports/orders"><i class="bi bi-x-circle me-1"></i> Reset</a><button class="or-export secondary" type="button" id="exportOrders"><i class="bi bi-download me-1"></i> Export filtered CSV</button><button class="or-export" type="submit"><i class="bi bi-funnel me-1"></i> Apply filters</button></div>
    </div>
  </form>

  <div class="or-grid">
    <% [{l:'Orders placed',v:analytics.totalOrders.toLocaleString(),m:analytics.validOrders+' valid orders',i:'bi-bag',a:'#2563eb',d:analytics.orderGrowth},{l:'Booked order value',v:'₱'+Math.round(analytics.grossOrderValue).toLocaleString(),m:'Valid orders placed in period',i:'bi-receipt',a:'#7c3aed',d:analytics.revenueGrowth},{l:'Recognized sales',v:'₱'+Math.round(analytics.recognizedRevenue).toLocaleString(),m:analytics.recognizedOrders+' orders completed in period',i:'bi-check2-circle',a:'#059669',d:analytics.recognizedRevenueGrowth},{l:'Net collections',v:'₱'+Math.round(analytics.netCollections).toLocaleString(),m:'Collected less completed refunds',i:'bi-cash-stack',a:'#0891b2',d:analytics.collectionGrowth},{l:'Outstanding balance',v:'₱'+Math.round(analytics.outstandingBalance).toLocaleString(),m:analytics.ledgerMismatchCount+' ledger mismatch'+(analytics.ledgerMismatchCount===1?'':'es'),i:'bi-wallet2',a:'#d97706'},{l:'Estimated gross margin',v:analytics.marginReliable?'₱'+Math.round(analytics.estimatedGrossMargin).toLocaleString():'Cost data incomplete',m:analytics.costCoveragePercent.toFixed(1)+'% unit cost coverage',i:'bi-graph-up-arrow',a:'#0f766e'}].forEach(function(k){ %>
      <article class="or-card or-kpi" style="--accent:<%= k.a %>"><div class="or-kpi-top"><span class="or-icon"><i class="bi <%= k.i %>"></i></span><% if(typeof k.d==='number'){ %><span class="or-delta <%= k.d>=0?'or-up':'or-down' %>"><i class="bi <%= k.d>=0?'bi-arrow-up':'bi-arrow-down' %>"></i> <%= Math.abs(k.d).toFixed(1) %>%</span><% } %></div><div class="or-label"><%= k.l %></div><div class="or-value"><%= k.v %></div><div class="or-meta"><%= k.m %></div></article>
    <% }); %>
  </div>

  <div class="or-section"><h2>Executive outlook</h2><span class="small text-muted">Compared with the immediately preceding period</span></div>
  <div class="or-insights"><% analytics.insights.forEach(function(x){ %><article class="or-card or-insight <%= x.tone %>"><div class="or-insight-icon"><i class="bi <%= x.icon %>"></i></div><div><h4><%= x.title %></h4><p><%= x.text %></p></div></article><% }); %></div>

  <div class="or-section"><h2>Demand & revenue</h2></div>
  <div class="or-two"><article class="or-card"><div class="or-card-head"><h3><i class="bi bi-graph-up me-2 text-primary"></i>Order and Revenue Trend</h3><span class="or-badge">Click to inspect</span></div><div class="or-chart"><canvas id="orderTrend"></canvas></div></article><article class="or-card"><div class="or-card-head"><h3><i class="bi bi-signpost-split me-2 text-primary"></i>Fulfillment Mix</h3><span class="or-badge">Click to inspect</span></div><div class="or-chart"><canvas id="fulfillmentChart"></canvas></div></article></div>

  <div class="or-section"><h2>Operational health</h2></div>
  <div class="or-three"><article class="or-card"><div class="or-card-head"><h3>Order Pipeline</h3><span class="or-badge">Click to inspect</span></div><div class="or-chart"><canvas id="statusChart"></canvas></div></article><article class="or-card"><div class="or-card-head"><h3>Payment Health</h3><span class="or-badge">Click to inspect</span></div><div class="or-chart"><canvas id="paymentChart"></canvas></div></article><article class="or-card"><div class="or-card-head"><h3>Fulfillment Efficiency</h3></div><div class="or-card-body"><div class="or-label">Average completed cycle</div><div class="or-value"><%= analytics.avgCycleHours < 48 ? analytics.avgCycleHours.toFixed(1)+' hours' : (analytics.avgCycleHours/24).toFixed(1)+' days' %></div><div class="or-meta mb-3">Order creation to completion</div><div class="or-label">Cohort completion / cancellation</div><div class="or-value"><%= analytics.completionRate.toFixed(1) %>% / <span style="color:#dc2626"><%= analytics.cancellationRate.toFixed(1) %>%</span></div><div class="or-meta mb-3"><%= analytics.completedOrders %> completed, <%= analytics.cancelledOrders %> cancelled</div><div class="or-label">Completed units</div><div class="or-value"><%= analytics.unitsSold.toLocaleString() %></div><div class="or-meta"><%= analytics.unitsPerOrder.toFixed(1) %> units per recognized order</div></div></article></div>

  <div class="or-section"><h2>Product intelligence</h2></div>
  <div class="or-two"><article class="or-card"><div class="or-card-head"><h3>Top Products by Recognized Revenue</h3><span class="or-badge">Completed orders</span></div><div class="or-card-body table-responsive"><table class="or-table"><thead><tr><th>#</th><th>Product</th><th class="text-center">Units</th><th class="text-end">Revenue</th></tr></thead><tbody><% if(!analytics.topProducts.length){ %><tr><td colspan="4" class="or-empty">No completed product sales in this period.</td></tr><% } analytics.topProducts.forEach(function(p,i){ %><tr><td><span class="or-rank"><%= i+1 %></span></td><td><strong><%= p.name %></strong><div class="or-meta"><%= p.orders %> completed order lines</div></td><td class="text-center"><%= p.units %></td><td class="text-end fw-bold">₱<%= Math.round(p.revenue).toLocaleString() %></td></tr><% }); %></tbody></table></div></article><article class="or-card"><div class="or-card-head"><h3>Brand Contribution</h3><span class="or-badge">Click to inspect</span></div><div class="or-chart"><canvas id="brandChart"></canvas></div></article></div>

  <div class="or-section"><h2>Fulfillment team</h2></div>
  <article class="or-card"><div class="or-card-body table-responsive"><table class="or-table"><thead><tr><th>Technician</th><th class="text-center">Assigned</th><th class="text-center">Completed</th><th class="text-center">Completion</th><th class="text-end">Order Value</th></tr></thead><tbody><% if(!analytics.technicians.length){ %><tr><td colspan="5" class="or-empty">No technician-assigned orders in this period.</td></tr><% } analytics.technicians.forEach(function(t){ %><tr><td class="fw-bold"><%= t.name %></td><td class="text-center"><%= t.orders %></td><td class="text-center"><%= t.completed %></td><td class="text-center"><span class="or-badge <%= t.completionRate>=80?'completed':'' %>"><%= t.completionRate.toFixed(0) %>%</span></td><td class="text-end">₱<%= Math.round(t.value).toLocaleString() %></td></tr><% }); %></tbody></table></div></article>

  <div class="or-section"><h2>Recent order detail</h2><span class="small text-muted">Latest 12 in selected period</span></div>
  <article class="or-card"><div class="or-card-body table-responsive"><table class="or-table" id="ordersTable"><thead><tr><th>Date</th><th>Reference</th><th>Customer</th><th class="text-center">Units</th><th>Fulfillment</th><th>Payment</th><th>Status</th><th class="text-end">Total</th></tr></thead><tbody><% if(!analytics.recentOrders.length){ %><tr><td colspan="8" class="or-empty">No orders match this reporting window.</td></tr><% } analytics.recentOrders.forEach(function(o){ %><tr><td><%= new Date(o.date).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) %></td><td class="fw-bold"><%= o.reference %></td><td><%= o.customer %></td><td class="text-center"><%= o.items %></td><td><%= String(o.fulfillment||'—').replaceAll('_',' ') %></td><td><span class="or-badge <%= o.payment %>"><%= String(o.payment||'pending').replaceAll('_',' ') %></span></td><td><span class="or-badge <%= o.status %>"><%= String(o.status||'unknown').replaceAll('_',' ') %></span></td><td class="text-end fw-bold">₱<%= Math.round(o.total).toLocaleString() %></td></tr><% }); %></tbody></table></div></article>
</div>

<%- include('../../../partials/chart-drilldown-modal') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script src="/js/chart-drilldown.js"></script>
<script>
(() => {
  const A = <%- analyticsJson %>;
  const nice = s => String(s).replaceAll('_',' ').replace(/\b\w/g,c=>c.toUpperCase());
  const palette=['#2563eb','#10b981','#8b5cf6','#f59e0b','#06b6d4','#ef4444','#64748b','#f97316','#14b8a6','#ec4899'];
  const filterForm=document.getElementById('orderReportFilter');
  const range=document.getElementById('orderRange');
  const customRange=document.querySelector('.or-custom');
  const customInputs=[document.getElementById('orderFrom'),document.getElementById('orderTo')];
  const syncCustomRange=()=>{const custom=range.value==='custom';customRange.style.display=custom?'':'none';customInputs.forEach(input=>{input.disabled=!custom;input.required=custom;});};
  range.addEventListener('change',syncCustomRange);syncCustomRange();
  const exportButton=document.getElementById('exportOrders');
  if(!A.reportStart||!A.reportEnd){exportButton.disabled=true;exportButton.title='Report data must load before it can be exported';}
  else exportButton.addEventListener('click',()=>{const params=new URLSearchParams(new FormData(filterForm));params.delete('range');params.set('from',A.reportStart);params.set('to',A.reportEnd);window.location.href='/api/admin/reports/orders/export?'+params.toString();});
  if (typeof Chart === 'undefined') return;
  Chart.defaults.font.family='Inter, sans-serif'; Chart.defaults.color='#64748b';
  const baseOpts={responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{usePointStyle:true,boxWidth:7,font:{size:10}}}},scales:{x:{grid:{display:false},ticks:{font:{size:10}}},y:{beginAtZero:true,grid:{color:'#f1f5f9'},ticks:{font:{size:10}}}}};
  const orderColumns=[{key:'reference',label:'Reference'},{key:'customer',label:'Customer'},{key:'products',label:'Products'},{key:'status',label:'Status'},{key:'payment',label:'Payment'},{key:'fulfillment',label:'Fulfillment'},{key:'units',label:'Units',align:'right'},{key:'date',label:'Placed'},{key:'amount',label:'Order Value',align:'right'}];
  const brandColumns=[{key:'reference',label:'Reference'},{key:'customer',label:'Customer'},{key:'products',label:'Products'},{key:'status',label:'Status'},{key:'payment',label:'Payment'},{key:'selectedUnits',label:'Selected Units',align:'right'},{key:'completionDate',label:'Completed',date:true},{key:'selectedRevenue',label:'Selected Revenue',align:'right',currency:true}];

  async function fetchDrilldown(spec){
    const response=await fetch('/api/admin/reports/orders/drilldown',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({...A.appliedFilters,...spec,from:A.reportStart,to:A.reportEnd})});
    if(response.status===401) throw new Error('Your admin session has expired. Sign in again and retry.');
    const payload=await response.json().catch(()=>({}));
    if(!response.ok) throw new Error(payload.error||'Unable to load the selected orders.');
    const summary=payload.summary||{};
    payload.summary=spec.dimension==='brand'
      ? {records:{label:'Orders',value:Number(summary.records||0).toLocaleString()},selectedRevenue:{label:'Selected merchandise revenue',value:'₱'+Math.round(Number(summary.selectedRevenue||0)).toLocaleString()},selectedUnits:{label:'Selected units',value:Number(summary.selectedUnits||0).toLocaleString()},orderValue:{label:'Total order value',value:'₱'+Math.round(Number(summary.orderValue||0)).toLocaleString()}}
      : {records:{label:'Orders',value:Number(summary.records||0).toLocaleString()},orderValue:{label:'Order value',value:'₱'+Math.round(Number(summary.orderValue||0)).toLocaleString()},collected:{label:'Collected',value:'₱'+Math.round(Number(summary.collected||0)).toLocaleString()},outstanding:{label:'Outstanding',value:'₱'+Math.round(Number(summary.outstanding||0)).toLocaleString()}};
    return payload;
  }

  function modalChartConfig(chart){return {type:chart.config.type,data:JSON.parse(JSON.stringify(chart.data)),options:{indexAxis:chart.options.indexAxis||'x',plugins:{legend:{display:true,position:'bottom'}}}};}
  function openDrill(chart,elements,title,buildSpec){
    if(!elements.length||typeof ChartDrilldown==='undefined') return;
    const hit=elements[0];
    const resolve=selection=>buildSpec(selection.index,selection.datasetIndex);
    const label=String(chart.data.labels[hit.index]||'Selection');
    const dataset=chart.data.datasets[hit.datasetIndex]||{};
    const initialSpec=resolve(hit);
    ChartDrilldown.open({title,subtitle:'Live orders behind the selected chart point',selectionLabel:label+(dataset.label?' / '+dataset.label:''),dataHeading:'Underlying order records',chartConfig:modalChartConfig(chart),selectedElement:{index:hit.index,datasetIndex:hit.datasetIndex},details:[],loadDetails:()=>fetchDrilldown(initialSpec),onChartSelect:selection=>fetchDrilldown(resolve(selection)),columns:initialSpec.dimension==='brand'?brandColumns:orderColumns,filters:[],filterField:'status'});
  }
  const hoverPointer=(event,elements)=>{if(event.native&&event.native.target)event.native.target.style.cursor=elements.length?'pointer':'default';};

  const trendChart=new Chart(document.getElementById('orderTrend'),{type:'bar',data:{labels:A.dailyTrend.map(x=>x.label),datasets:[{label:'Orders placed',data:A.dailyTrend.map(x=>x.orders),backgroundColor:'rgba(37,99,235,.72)',borderRadius:5,yAxisID:'y'},{label:'Booked order value',data:A.dailyTrend.map(x=>x.bookedValue),type:'line',borderColor:'#8b5cf6',backgroundColor:'#8b5cf6',tension:.3,pointRadius:2,yAxisID:'r'},{label:'Recognized sales',data:A.dailyTrend.map(x=>x.recognizedRevenue),type:'line',borderColor:'#10b981',backgroundColor:'#10b981',tension:.3,pointRadius:2,yAxisID:'r'}]},options:{...baseOpts,onHover:hoverPointer,onClick:(event,elements,chart)=>openDrill(chart,elements,'Order and Revenue Trend',(index,datasetIndex)=>({dimension:'trend',dataset:chart.data.datasets[datasetIndex].label,bucketStart:A.dailyTrend[index].start,bucketEnd:A.dailyTrend[index].end})),scales:{...baseOpts.scales,r:{position:'right',beginAtZero:true,grid:{display:false},ticks:{font:{size:10},callback:v=>'₱'+Number(v).toLocaleString()}}}}});

  function doughnut(id,obj,dimension,title){
    const keys=Object.keys(obj);let chart;
    chart=new Chart(document.getElementById(id),{type:'doughnut',data:{labels:keys.map(nice),datasets:[{label:'Orders',data:keys.map(k=>obj[k]),backgroundColor:palette,borderWidth:3,borderColor:'#fff'}]},options:{responsive:true,maintainAspectRatio:false,cutout:'67%',onHover:hoverPointer,onClick:(event,elements)=>openDrill(chart,elements,title,index=>({dimension,value:keys[index]})),plugins:{legend:{position:'bottom',labels:{usePointStyle:true,boxWidth:7,font:{size:10}}}}}});
    return chart;
  }
  doughnut('fulfillmentChart',A.fulfillmentBreakdown,'fulfillment','Fulfillment Mix');
  doughnut('statusChart',A.statusBreakdown,'status','Order Pipeline');
  doughnut('paymentChart',A.paymentBreakdown,'payment','Payment Health');

  let brandChart;
  brandChart=new Chart(document.getElementById('brandChart'),{type:'bar',data:{labels:A.topBrands.map(x=>x.name),datasets:[{label:'Recognized merchandise revenue',data:A.topBrands.map(x=>x.revenue),backgroundColor:A.topBrands.map((x,i)=>palette[i%palette.length]),borderRadius:6}]},options:{...baseOpts,indexAxis:'y',onHover:hoverPointer,onClick:(event,elements)=>openDrill(brandChart,elements,'Brand Contribution',index=>({dimension:'brand',value:A.topBrands[index].name})),scales:{x:{beginAtZero:true,grid:{color:'#f1f5f9'},ticks:{callback:v=>'₱'+Number(v).toLocaleString(),font:{size:10}}},y:{grid:{display:false}}}}});
})();
</script>
