<script>
  (function () {
    function setSidebarBadge(id, value, title) {
      const badge = document.getElementById(id);
      if (!badge) return;
      const number = Number(value);
      const count = Number.isFinite(number) ? Math.max(0, Math.floor(number)) : 0;
      badge.dataset.count = String(count);
      badge.textContent = count > 0 ? String(count) : '';
      badge.style.display = count > 0 ? 'inline-flex' : 'none';
      if (title) { badge.title = title; badge.dataset.countTitle = title; }
      else if (badge.dataset.countUnavailable) {
        if (badge.dataset.countTitle) badge.title = badge.dataset.countTitle;
        else badge.removeAttribute('title');
      }
      delete badge.dataset.countUnavailable;
      delete badge.dataset.countStale;
    }

    function updateSidebarGroupBadge(id, selector, label) {
      const children = [...document.querySelectorAll(selector)];
      const unavailable = children.some(badge => badge.dataset.countUnavailable === 'true' && badge.dataset.countStale !== 'true');
      const stale = children.some(badge => badge.dataset.countStale === 'true');
      const total = children.reduce((sum, badge) => sum + (Number(badge.dataset.count) || 0), 0);
      const detail = label === 'Work' ? '; queues may overlap' : '';
      setSidebarBadge(id, total, unavailable
        ? `Total of the counts shown under ${label}; some counts temporarily unavailable${detail}`
        : stale ? `Last known total of the counts shown under ${label}; update temporarily unavailable${detail}`
          : `Total of the counts shown under ${label}${detail}`);
      const group = document.getElementById(id);
      if (group) {
        group.dataset.countUnavailable = String(unavailable || stale);
        group.dataset.countStale = String(stale && !unavailable);
      }
    }

    function updateSystemGroupBadge() {
      updateSidebarGroupBadge('systemGroupBadge', '#settings-collapse a.nav-link .nav-badge', 'System');
    }

    function updateWorkGroupBadge() {
      updateSidebarGroupBadge('pendingReviewCount', '#appointment-mgmt-collapse a.nav-link .nav-badge', 'Work');
    }

    function markSidebarBadgeUnavailable(id) {
      const badge = document.getElementById(id);
      if (!badge) return;
      const known = badge.dataset.count !== undefined;
      badge.dataset.countUnavailable = 'true';
      badge.dataset.countStale = String(known);
      badge.title = known ? 'Last known count; update temporarily unavailable' : 'Count temporarily unavailable';
    }

    function setResolutionSidebarCount(summary) {
      const bookingCases = Math.max(0, Number(summary?.bySource?.booking) || 0);
      const orderCases = Math.max(0, Number(summary?.bySource?.order) || 0);
      const total = bookingCases + orderCases;
      setSidebarBadge('attentionBadge', total, `${bookingCases} booking case${bookingCases === 1 ? '' : 's'} and ${orderCases} order case${orderCases === 1 ? '' : 's'}`);
      updateWorkGroupBadge();
    }

    async function sidebarJson(url) {
      const response = await fetch(url, { credentials: 'same-origin', cache: 'no-store' });
      if (!response.ok) throw new Error(`Sidebar count request failed: ${response.status}`);
      return response.json();
    }

    let sidebarBadgeRefreshRunning = false;
    async function updateSidebarBadges() {
      if (document.hidden || sidebarBadgeRefreshRunning) return;
      sidebarBadgeRefreshRunning = true;
      try {
        // The Resolution Center page publishes its own fresh summary; avoid
        // running the same expensive queue query twice during page load.
        const onResolutionCenter = ['/admin/operations/resolution-center', '/admin/appointments/attention'].includes(window.location.pathname);
        const summary = await sidebarJson('/api/admin/navigation-summary');
        const counts = summary.counts;
        if (counts) {
          if ([counts.pendingBookings, counts.assignmentQueue, counts.activeJobs].every(Number.isFinite)) {
            setSidebarBadge('appointmentsBadge', counts.pendingBookings + counts.assignmentQueue + counts.activeJobs);
          }
          if (Number.isFinite(counts.pendingExpenses)) setSidebarBadge('expensesBadge', counts.pendingExpenses);
          if (Number.isFinite(counts.escalatedBookings)) setSidebarBadge('escalatedBadge', counts.escalatedBookings);
          if (Number.isFinite(counts.pendingLeaveRequests)) setSidebarBadge('leavesBadge', counts.pendingLeaveRequests);
          if (Number.isFinite(counts.auditToday)) setSidebarBadge('auditTodayBadge', counts.auditToday, 'Audit events today (Philippine time)');
        }
        const maintenance = summary.maintenance;
        if (maintenance) setSidebarBadge('maintenanceBadge', maintenance.actionable);
        const orders = summary.orders;
        if (orders) setSidebarBadge('ordersBadge', orders.actionable);
        const projects = summary.projects;
        if (projects) setSidebarBadge('projectsBadge', projects.pendingScheduling);
        const repairScheduling = summary.repairScheduling;
        if (repairScheduling) setSidebarBadge('repairSchedBadge', repairScheduling.pendingScheduling);
        const returns = summary.returns;
        if (returns) {
          setSidebarBadge('equipmentReturnsBadge', returns.overdue);
          setSidebarBadge('equipmentReturnsDashboardBadge', returns.overdue);
        }
        const failedSources = new Set(summary.failedSources || []);
        const staleSources = new Set(summary.staleSources || []);
        const sourceBadges = {
          bookings: ['appointmentsBadge', 'escalatedBadge', 'repairSchedBadge'],
          expenses: ['expensesBadge'], leaveRequests: ['leavesBadge'], auditToday: ['auditTodayBadge'],
          orders: ['ordersBadge'], projects: ['projectsBadge'],
          returns: ['equipmentReturnsBadge', 'equipmentReturnsDashboardBadge'],
          maintenance: ['maintenanceBadge'],
        };
        Object.entries(sourceBadges).forEach(([source, ids]) => ids.forEach(id => {
          const badge = document.getElementById(id);
          if (!badge) return;
          if (failedSources.has(source)) {
            if (!staleSources.has(source)) setSidebarBadge(id, 0);
            badge.title = staleSources.has(source) ? 'Last known count; update temporarily unavailable' : 'Count temporarily unavailable';
            badge.dataset.countUnavailable = 'true';
            badge.dataset.countStale = String(staleSources.has(source));
          } else if (badge.dataset.countUnavailable) {
            if (badge.dataset.countTitle) badge.title = badge.dataset.countTitle;
            else badge.removeAttribute('title');
            delete badge.dataset.countUnavailable;
            delete badge.dataset.countStale;
          }
        }));
        updateSystemGroupBadge();
        updateWorkGroupBadge();
        if (summary.degraded) console.warn('Some navigation counts are temporarily unavailable:', summary.failedSources.join(', '));
        // Keep the exact warranty/case policies, but defer their heavier reads
        // so they do not compete with the first list/modal response.
        scheduleExtendedBadges(onResolutionCenter);
      } catch (error) {
        const auditBadge = document.getElementById('auditTodayBadge');
        if (auditBadge) {
          auditBadge.dataset.countUnavailable = 'true';
          auditBadge.dataset.countStale = String(auditBadge.dataset.count !== undefined);
          auditBadge.title = auditBadge.dataset.countStale === 'true' ? 'Last known audit count; update temporarily unavailable' : 'Audit count temporarily unavailable';
        }
        updateSystemGroupBadge();
        ['appointmentsBadge', 'escalatedBadge', 'repairSchedBadge', 'expensesBadge', 'ordersBadge', 'projectsBadge', 'maintenanceBadge'].forEach(markSidebarBadgeUnavailable);
        updateWorkGroupBadge();
        console.warn('Navigation summary unavailable:', error.message);
      } finally {
        sidebarBadgeRefreshRunning = false;
      }
    }

    let extendedBadgeTimer = null;
    let extendedBadgeRunning = false;
    function scheduleExtendedBadges(onResolutionCenter) {
      if (extendedBadgeTimer || extendedBadgeRunning) return;
      extendedBadgeTimer = window.setTimeout(async function () {
        extendedBadgeTimer = null;
        if (document.hidden || extendedBadgeRunning) return;
        extendedBadgeRunning = true;
        try {
          const results = await Promise.allSettled([
            sidebarJson('/api/admin/warranties/stats'),
            onResolutionCenter ? Promise.resolve(null) : sidebarJson('/api/admin/resolution-center?page=1&perPage=1'),
          ]);
          if (results[0].status === 'fulfilled') {
            const warranty = results[0].value;
            setSidebarBadge('warrantyBadge', Number(warranty.activeWarranty || 0) + Number(warranty.warrantyClaims || 0));
          } else markSidebarBadgeUnavailable('warrantyBadge');
          if (results[1].status === 'fulfilled' && results[1].value) setResolutionSidebarCount(results[1].value.summary);
          else if (results[1].status === 'rejected') markSidebarBadgeUnavailable('attentionBadge');
          updateWorkGroupBadge();
        } finally { extendedBadgeRunning = false; }
      }, 1500);
    }

    document.addEventListener('DOMContentLoaded', function () {
      window.addEventListener('resolution:counts', event => setResolutionSidebarCount(event.detail));
      updateSidebarBadges();
      window.setInterval(updateSidebarBadges, 60000);
      document.addEventListener('visibilitychange', function () { if (!document.hidden) updateSidebarBadges(); });
    });
  })();
</script>
