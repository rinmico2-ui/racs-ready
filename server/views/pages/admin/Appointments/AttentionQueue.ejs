  async function viewDetail(id) {
    const modal = new bootstrap.Modal(document.getElementById('detailModal'));
    const body = document.getElementById('detailBody');
    body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
    modal.show();
    try {
      const res = await fetch(`/api/admin/appointments/${id}`);
      const data = await res.json();
      if (!data.booking) throw new Error('Booking not found');
      const b = data.booking;
      const date = b.bookingDate ? new Date(b.bookingDate).toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) : 'TBD';
      const phone = b.customer?.phone || b.customer?.mobile || '';
      body.innerHTML = `
        <div class="ent-detail-grid">
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon"><i class="bi bi-hash"></i></div>
