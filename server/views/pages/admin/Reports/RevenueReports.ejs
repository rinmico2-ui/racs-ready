          <span class="kpi-enterprise-badge ${Number(A.operatingProfit||0) >= 0 ? 'green' : 'red'}">${pct(A.operatingProfitMargin)} margin</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Operating Profit</p>
