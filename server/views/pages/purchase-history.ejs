<div
  class="container py-5 page-min-height purchase-history-premium"
  data-aos="fade-up"
  data-aos-duration="800"
>
  <!-- Premium Header -->
  <div class="ph-header-premium mb-4">
    <div style="position:absolute; inset:0; overflow:hidden; border-radius:24px; pointer-events:none;">
      <div class="ph-header-glow"></div>
    </div>
    <div class="d-flex justify-content-between align-items-center position-relative" style="z-index:2;">
      <div class="d-flex align-items-center gap-3">
        <div class="ph-avatar-premium">
          <i class="bi bi-bag-check-fill"></i>
        </div>
        <div>
          <h1 class="ph-title">Purchase History</h1>
          <p class="ph-subtitle">View your orders, track deliveries, and rate products</p>
        </div>
      </div>
      <!-- Filter Dropdown -->
      <div class="ph-dropdown-wrapper">
        <button class="ph-dropdown-trigger" id="phFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-funnel"></i>
          <span>Filter</span>
          <i class="bi bi-chevron-down ph-dropdown-arrow"></i>
        </button>
        <div class="ph-dropdown-menu dropdown-menu dropdown-menu-end">
          <div class="ph-dropdown-header">
            <i class="bi bi-funnel"></i> Filter Orders
          </div>
          <div class="ph-dropdown-item active" data-filter="all">
            <i class="bi bi-grid"></i> All Orders
          </div>
          <div class="ph-dropdown-item" data-filter="delivered">
            <i class="bi bi-check-circle"></i> Delivered
          </div>
          <div class="ph-dropdown-item" data-filter="pending">
            <i class="bi bi-clock"></i> Pending
          </div>
          <div class="ph-dropdown-item" data-filter="cancelled">
            <i class="bi bi-x-circle"></i> Cancelled
          </div>
          <div class="ph-dropdown-divider"></div>
          <div class="ph-dropdown-header">
            <i class="bi bi-calendar"></i> Date Range
          </div>
          <div class="ph-dropdown-dates">
            <input type="text" class="ph-date-input" id="phDateFrom" placeholder="From" readonly />
            <span>to</span>
            <input type="text" class="ph-date-input" id="phDateTo" placeholder="To" readonly />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="ph-stat-card">
        <div class="ph-stat-icon blue"><i class="bi bi-bag"></i></div>
        <div class="ph-stat-content">
          <span class="ph-stat-value"><%= (orders || []).length %></span>
          <span class="ph-stat-label">Total Orders</span>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="ph-stat-card">
        <div class="ph-stat-icon emerald"><i class="bi bi-check-circle"></i></div>
        <div class="ph-stat-content">
          <span class="ph-stat-value"><%= (orders || []).filter(function(o){ return o.status === 'completed'; }).length %></span>
          <span class="ph-stat-label">Completed</span>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="ph-stat-card">
        <div class="ph-stat-icon amber"><i class="bi bi-clock"></i></div>
        <div class="ph-stat-content">
          <span class="ph-stat-value"><%= (orders || []).filter(function(o){ return o.status !== 'completed' && o.status !== 'cancelled'; }).length %></span>
          <span class="ph-stat-label">In Progress</span>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="ph-stat-card">
        <div class="ph-stat-icon purple"><i class="bi bi-x-circle"></i></div>
        <div class="ph-stat-content">
          <span class="ph-stat-value"><%= (orders || []).filter(function(o){ return o.status === 'cancelled'; }).length %></span>
          <span class="ph-stat-label">Cancelled</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Orders List -->
  <div class="ph-orders-container">
    <% var allOrders = orders || []; %>
    <% if (allOrders.length > 0) { %>
      <% allOrders.forEach(function(order) { %>
        <%
          var statusMap = {
            'pending_payment': { label: 'Pending Payment', badge: 'pending', icon: 'bi-clock' },
            'preparing_unit': { label: 'Preparing', badge: 'pending', icon: 'bi-box-seam' },
            'technician_assigned': { label: 'Assigned', badge: 'pending', icon: 'bi-person-check' },
            'out_for_delivery': { label: 'Out for Delivery', badge: 'pending', icon: 'bi-truck' },
            'arrived': { label: 'Arrived', badge: 'pending', icon: 'bi-geo-alt' },
            'installing': { label: 'Installing', badge: 'pending', icon: 'bi-tools' },
            'completed': { label: 'Completed', badge: 'delivered', icon: 'bi-check-circle' },
            'cancelled': { label: 'Cancelled', badge: 'cancelled', icon: 'bi-x-circle' }
          };
          var si = statusMap[order.status] || { label: order.status || 'Unknown', badge: 'pending', icon: 'bi-question-circle' };
          var od = order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : '';
          var oref = order.orderReference || ('ORD-' + String(order._id).slice(-8).toUpperCase());
        %>
        <div class="ph-order-card" data-status="<%= si.badge %>">
          <div class="ph-order-header">
            <div class="ph-order-info">
              <div class="ph-order-id"><i class="bi bi-hash"></i> <%= oref %></div>
              <div class="ph-order-date"><i class="bi bi-calendar3"></i> <%= od %></div>
            </div>
            <span class="ph-status-badge <%= si.badge %>">
              <i class="bi <%= si.icon %>"></i> <%= si.label %>
            </span>
          </div>
          <div class="ph-order-body">
            <% (order.items || []).forEach(function(item) { %>
              <div class="ph-product-item">
                <div class="ph-product-image">
                  <% if (item.imageUrl) { %>
                    <img src="<%= item.imageUrl %>" alt="Product" style="width:100%;height:100%;object-fit:cover;border-radius:12px;" />
                  <% } else { %>
                    <i class="bi bi-image"></i>
                  <% } %>
                </div>
                <div class="ph-product-details">
                  <h6 class="ph-product-name"><%= item.brand ? item.brand + ' ' : '' %><%= item.modelLine || 'Aircon Unit' %></h6>
                  <p class="ph-product-variant"><%= item.capacity ? item.capacity + ' ' + (item.capacityUnit || 'HP') : '' %></p>
                  <div class="ph-product-meta">
                    <span class="ph-product-qty">Qty: <%= item.quantity || 1 %></span>
                    <span class="ph-product-price">₱<%= (item.totalPrice || item.unitPrice || 0).toLocaleString() %></span>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
          <div class="ph-order-footer">
            <div class="ph-order-total">
              <span>Total:</span>
              <strong>₱<%= (order.total || 0).toLocaleString() %></strong>
            </div>
            <div class="ph-order-actions mt-3 w-100 d-flex justify-content-between align-items-center" style="border-top: 1px dashed rgba(148,163,184,0.3); padding-top: 1rem;">
              <div class="d-flex align-items-center gap-2">
                <% if (order.fulfillmentType) { %>
                  <span class="ph-status-badge" style="background:rgba(37,99,235,0.1);color:#2563eb;font-size:0.75rem;">
                    <i class="bi bi-<%= order.fulfillmentType === 'delivery_installation' ? 'tools' : order.fulfillmentType === 'delivery_only' ? 'truck' : 'shop' %>"></i>
                    <%= order.fulfillmentType === 'delivery_installation' ? 'Delivery + Install' : order.fulfillmentType === 'delivery_only' ? 'Delivery Only' : 'Pickup' %>
                  </span>
                <% } %>
                <% if (order.paymentMethod) { %>
                  <span class="ph-status-badge" style="background:rgba(16,185,129,0.1);color:#059669;font-size:0.75rem;">
                    <i class="bi bi-credit-card"></i> <%= order.paymentMethod.replace('_', ' ').toUpperCase() %>
                  </span>
                <% } %>
              </div>

              <div class="d-flex align-items-center gap-2">
                <% const isPending = ['pending_payment', 'preparing_unit', 'technician_assigned', 'out_for_delivery', 'arrived', 'installing'].includes(order.status); %>
                <% if (isPending) { %>
                  <button class="btn btn-sm btn-outline-warning ph-reschedule-btn"
                    data-id="<%= order._id %>"
                    data-ref="<%= oref %>"
                    data-technician-id="<%= order.technicianId %>"
                    data-technician-name="<%= order.technician && order.technician.name ? order.technician.name : '' %>"
                    data-is-project="<%= order.isProject ? 'true' : 'false' %>"
                    style="padding: 6px 14px; border-radius: 999px; background: transparent; transition: all 0.3s ease;">
                    <i class="bi bi-calendar-event me-1"></i> Re-schedule
                  </button>
                  <button class="btn btn-sm btn-outline-danger ph-cancel-btn" data-id="<%= order._id %>" data-ref="<%= oref %>" style="padding: 6px 14px; border-radius: 999px; background: transparent; transition: all 0.3s ease;">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                  </button>
                <% } %>

                <% if (order.status === 'completed') { %>
                  <div class="ph-rating-section">
                    <% if (order.customerRating) { %>
                      <div class="ph-rating-wrapper rated">
                        <span class="ph-rating-label">Your Rating:</span>
                        <div class="ph-star-rating readonly">
                          <% for(let i=1; i<=5; i++) { %>
                            <span class="ph-star-btn <%= i <= Math.floor(order.customerRating) ? 'active' : '' %>">
                              <i class="bi bi-star<%= i <= Math.floor(order.customerRating) ? '-fill' : '' %>"></i>
                            </span>
                          <% } %>
                        </div>
                      </div>
                    <% } else { %>
                      <button class="ph-btn-outline ph-rate-order-btn" data-id="<%= order._id %>" data-ref="<%= oref %>" data-tech="<%= order.technician && order.technician.name ? order.technician.name : 'Technician' %>" style="border: 1.5px solid #f59e0b; color: #d97706; padding: 6px 14px; border-radius: 999px; background: transparent; transition: all 0.3s ease;">
                        <i class="bi bi-star me-1"></i> Rate Service
                      </button>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- Empty State -->
  <div class="ph-empty-state <%= (orders && orders.length > 0) ? 'd-none' : '' %>">
    <div class="ph-empty-icon"><i class="bi bi-bag-x"></i></div>
    <h4>No orders found</h4>
    <p>You haven't made any purchases yet.</p>
    <a href="/aircons" class="ph-btn-primary" style="text-decoration:none;">
      <i class="bi bi-shop"></i> Browse Aircons
    </a>
  </div>



  <!-- Premium Styles -->
  <style>
    .purchase-history-premium {
      --primary: #2563eb;
      --primary-light: #3b82f6;
      --emerald: #10b981;
      --amber: #f59e0b;
      --purple: #8b5cf6;
    }
    
    /* Header */
    .ph-header-premium {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%);
      border-radius: 24px;
      padding: 32px 40px;
      position: relative;
      box-shadow: 0 24px 60px rgba(15,36,96,0.25);
    }
    .ph-header-glow {
      position: absolute;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(59,130,246,0.2) 0%, transparent 70%);
      top: -150px;
      right: -100px;
      pointer-events: none;
    }
    .ph-avatar-premium {
      width: 64px;
      height: 64px;
      border-radius: 18px;
      background: rgba(255,255,255,0.1);
      backdrop-filter: blur(10px);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid rgba(255,255,255,0.2);
      box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    }
    .ph-avatar-premium i {
      font-size: 1.8rem;
      color: #fff;
    }
    .ph-title {
      font-size: 1.8rem;
      font-weight: 800;
      color: #fff;
      margin: 0;
      letter-spacing: -0.5px;
    }
    .ph-subtitle {
      color: rgba(255,255,255,0.75);
      margin: 0;
      font-size: 0.9rem;
    }

    /* Premium Dropdown */
    .ph-dropdown-wrapper {
      position: relative;
    }
    .ph-dropdown-trigger {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 12px 20px;
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(10px);
      border: 1.5px solid rgba(255,255,255,0.3);
      border-radius: 14px;
      color: #fff;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .ph-dropdown-trigger:hover {
      background: rgba(255,255,255,0.25);
      transform: translateY(-2px);
    }
    .ph-dropdown-arrow {
      transition: transform 0.3s ease;
    }
    .ph-dropdown-wrapper.show .ph-dropdown-arrow {
      transform: rotate(180deg);
    }
    .ph-dropdown-menu {
      background: rgba(255,255,255,0.95);
      border: 1px solid rgba(255,255,255,0.9);
      border-radius: 16px;
      box-shadow: 0 24px 48px rgba(15,36,96,0.15);
      backdrop-filter: blur(20px);
      padding: 12px;
      min-width: 280px;
      margin-top: 8px !important;
    }
    .ph-dropdown-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 8px 12px;
      font-size: 0.75rem;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .ph-dropdown-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 10px 12px;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.25s ease;
      font-size: 0.9rem;
      color: #334155;
    }
    .ph-dropdown-item:hover,
    .ph-dropdown-item.active {
      background: rgba(37,99,235,0.1);
      color: #2563eb;
    }
    .ph-dropdown-item.active {
      font-weight: 600;
    }
    .ph-dropdown-item i {
      font-size: 1rem;
      width: 20px;
      text-align: center;
    }
    .ph-dropdown-divider {
      height: 1px;
      background: rgba(148,163,184,0.2);
      margin: 8px 0;
    }
    .ph-dropdown-dates {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
    }
    .ph-dropdown-dates span {
      font-size: 0.8rem;
      color: #64748b;
    }
    .ph-date-input {
      flex: 1;
      padding: 8px 12px;
      border: 1.5px solid rgba(148,163,184,0.2);
      border-radius: 8px;
      font-size: 0.85rem;
      color: #334155;
      background: rgba(255,255,255,0.6);
    }
    .ph-date-input:focus {
      outline: none;
      border-color: #2563eb;
    }

    /* Stats Cards */
    .ph-stat-card {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.25rem;
      background: rgba(255,255,255,0.85);
      border: 1px solid rgba(255,255,255,0.9);
      border-radius: 18px;
      box-shadow: 0 8px 24px rgba(15,36,96,0.06);
      backdrop-filter: blur(20px);
      transition: all 0.3s ease;
    }
    .ph-stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(15,36,96,0.1);
    }
    .ph-stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      color: #fff;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }
    .ph-stat-icon.blue { background: linear-gradient(135deg, #2563eb, #3b82f6); }
    .ph-stat-icon.emerald { background: linear-gradient(135deg, #059669, #10b981); }
    .ph-stat-icon.amber { background: linear-gradient(135deg, #d97706, #f59e0b); }
    .ph-stat-icon.purple { background: linear-gradient(135deg, #7c3aed, #8b5cf6); }
    .ph-stat-value {
      font-size: 1.5rem;
      font-weight: 800;
      color: #0a1628;
      line-height: 1;
    }
    .ph-stat-label {
      font-size: 0.75rem;
      color: #64748b;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Order Cards */
    .ph-orders-container {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .ph-order-card {
      background: rgba(255,255,255,0.9);
      border: 1px solid rgba(255,255,255,0.95);
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(15,36,96,0.08);
      backdrop-filter: blur(20px);
      overflow: hidden;
      transition: all 0.3s ease;
    }
    .ph-order-card:hover {
      box-shadow: 0 16px 48px rgba(15,36,96,0.12);
      transform: translateY(-2px);
    }
    .ph-order-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 1.5rem;
      background: rgba(241,245,249,0.6);
      border-bottom: 1px solid rgba(148,163,184,0.1);
    }
    .ph-order-info {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }
    .ph-order-id {
      font-size: 0.95rem;
      font-weight: 700;
      color: #0a1628;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .ph-order-id i {
      color: #2563eb;
    }
    .ph-order-date {
      font-size: 0.85rem;
      color: #64748b;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .ph-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .ph-status-badge.delivered {
      background: rgba(16,185,129,0.1);
      color: #059669;
    }
    .ph-status-badge.pending {
      background: rgba(245,158,11,0.1);
      color: #d97706;
    }
    .ph-status-badge.cancelled {
      background: rgba(239,68,68,0.1);
      color: #dc2626;
    }
    .ph-order-body {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .ph-product-item {
      display: flex;
      gap: 1rem;
    }
    .ph-product-image {
      width: 80px;
      height: 80px;
      border-radius: 12px;
      background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: #94a3b8;
      flex-shrink: 0;
    }
    .ph-product-details {
      flex: 1;
    }
    .ph-product-name {
      font-size: 1rem;
      font-weight: 700;
      color: #0a1628;
      margin-bottom: 0.25rem;
    }
    .ph-product-variant {
      font-size: 0.85rem;
      color: #64748b;
      margin-bottom: 0.5rem;
    }
    .ph-product-meta {
      display: flex;
      gap: 1rem;
      font-size: 0.9rem;
    }
    .ph-product-qty {
      color: #64748b;
    }
    .ph-product-price {
      font-weight: 700;
      color: #0a1628;
    }
    .ph-order-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.5rem;
      background: rgba(241,245,249,0.4);
      border-top: 1px solid rgba(148,163,184,0.1);
    }
    .ph-order-total {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.95rem;
    }
    .ph-order-total span {
      color: #64748b;
    }
    .ph-order-total strong {
      font-size: 1.2rem;
      color: #0a1628;
    }
    .ph-order-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    /* Premium Star Rating Component */
    .ph-rating-wrapper {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .ph-rating-label {
      font-size: 0.8rem;
      color: #64748b;
      font-weight: 500;
    }
    .ph-star-rating {
      display: flex;
      gap: 4px;
    }
    .ph-star-btn {
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      font-size: 1.3rem;
      color: #cbd5e1;
      transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .ph-star-btn:hover {
      transform: scale(1.2);
    }
    .ph-star-btn.active {
      color: #fbbf24;
    }
    .ph-star-btn.active i::before {
      content: "\f586";
    }
    .ph-star-rating.readonly {
      pointer-events: none;
    }
    .ph-star-rating.readonly i {
      color: #cbd5e1;
      font-size: 1.1rem;
    }
    .ph-star-rating.readonly i.active {
      color: #fbbf24;
    }
    .ph-rating-text {
      font-size: 0.75rem;
      color: #94a3b8;
      font-weight: 500;
    }
    .ph-rating-text.rated {
      color: #059669;
      font-weight: 600;
    }
    .ph-rating-wrapper.rated .ph-rating-label {
      color: #059669;
    }

    /* Delivery Calendar Widget */
    .ph-delivery-calendar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 8px 14px;
      background: rgba(245,158,11,0.1);
      border: 1.5px solid rgba(245,158,11,0.2);
      border-radius: 14px;
    }
    .ph-calendar-header {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.75rem;
      color: #d97706;
      font-weight: 600;
    }
    .ph-calendar-date {
      display: flex;
      flex-direction: column;
      align-items: center;
      background: #fff;
      border-radius: 10px;
      padding: 4px 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .ph-calendar-day {
      font-size: 1.2rem;
      font-weight: 800;
      color: #d97706;
      line-height: 1;
    }
    .ph-calendar-month {
      font-size: 0.65rem;
      font-weight: 700;
