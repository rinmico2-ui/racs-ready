<div class="pos-container">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body.pos-body { background: #0f172a; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; overflow: hidden; height: 100vh; }

    .pos-layout { display: grid; grid-template-columns: 1fr 400px; height: 100vh; overflow: hidden; }

    /* ── Left: Product Grid ── */
