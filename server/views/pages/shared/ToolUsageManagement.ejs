  <script>
    // Map sparkline IDs to the ones generated by the partial
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new MutationObserver(() => {
        const entriesCanvas = document.getElementById('spark_kpiEntries');
        if (entriesCanvas) {
          // You might need to alias these in the global scope if the main script expects the old IDs
          window.kpiEntriesChart = entriesCanvas;
          window.kpiQtyChart = document.getElementById('spark_kpiQty');
          window.kpiLowStockChart = document.getElementById('spark_kpiLowStock');
          window.kpiCostChart = document.getElementById('spark_kpiCost');
          observer.disconnect();
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
    });
  </script>

