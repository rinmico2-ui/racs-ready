  function viewProduct(productId) {
    console.log('View product:', productId);
    window.open(`/admin/inventory/product/${productId}`, '_blank');
  }

  function viewProductReviews(productId) {
    console.log('View product reviews:', productId);
  }

  function viewReviewDetails(reviewId) {
    const review = productReviews.find(r => r.id === reviewId);
    if (!review) return;

    const modalBody = document.getElementById('reviewModalBody');
    modalBody.innerHTML = `
      <div class="row">
        <div class="col-md-6">
          <h6>Product Information</h6>
          <div class="d-flex align-items-center mb-3">
            <img src="${review.productImageUrl || '/images/products/default.png'}" 
                 alt="${review.productName}" 
                 class="product-image me-3">
            <div>
              <h6 class="mb-0">${review.productName}</h6>
              <p class="text-muted mb-0">${review.brand} • ${review.model || 'N/A'}</p>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <h6>Customer Information</h6>
          <p><strong>Name:</strong> ${review.customerName}</p>
          <p><strong>Email:</strong> ${review.customerEmail}</p>
          <p><strong>Date:</strong> ${formatDate(review.date)}</p>
          <p><strong>Verified:</strong> ${review.verified ? 'Yes' : 'No'}</p>
        </div>
      </div>
      <hr>
      <div class="row">
        <div class="col-12">
          <h6>Review Details</h6>
          <div class="mb-3">
            <div class="rating-stars fs-5">
              ${generateStars(review.rating)}
            </div>
            <h6 class="review-title mt-2">${review.title || 'No title'}</h6>
          </div>
          <p><strong>Review:</strong></p>
          <p>${review.comment || 'No comment provided'}</p>
          
          ${review.pros ? `
            <p><strong>Pros:</strong></p>
            <p>${review.pros}</p>
          ` : ''}
          
          ${review.cons ? `
            <p><strong>Cons:</strong></p>
            <p>${review.cons}</p>
          ` : ''}
        </div>
      </div>
    `;

    const modal = new bootstrap.Modal(document.getElementById('reviewModal'));
    modal.show();
  }

  function approveReview(reviewId) {
    console.log('Approve review:', reviewId);
    alert('Review approval functionality would be implemented here');
  }

  function flagReview(reviewId) {
    if (confirm('Are you sure you want to flag this review?')) {
      console.log('Flag review:', reviewId);
      alert('Review flagged for review');
    }
  }

  function deleteReview(reviewId) {
    if (confirm('Are you sure you want to delete this review? This action cannot be undone.')) {
      console.log('Delete review:', reviewId);
      alert('Review deletion would be implemented here');
    }
  }

  function exportProductReviews() {
    console.log('Exporting product reviews...');
    alert('Export functionality would be implemented here');
  }

  function renderPagination() {
    const pagination = document.getElementById('pagination');
    if (totalPages <= 1) {
      pagination.innerHTML = '';
      return;
    }

    let paginationHTML = '';
    
    paginationHTML += `
      <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
        <a class="page-link" href="#" onclick="changePage(${currentPage - 1})">Previous</a>
      </li>
    `;

    for (let i = 1; i <= totalPages; i++) {
      paginationHTML += `
        <li class="page-item ${currentPage === i ? 'active' : ''}">
          <a class="page-link" href="#" onclick="changePage(${i})">${i}</a>
        </li>
      `;
    }

    paginationHTML += `
      <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
        <a class="page-link" href="#" onclick="changePage(${currentPage + 1})">Next</a>
      </li>
    `;

    pagination.innerHTML = paginationHTML;
  }

  function changePage(page) {
    if (page < 1 || page > totalPages) return;
    currentPage = page;
    loadAirconRatings();
  }
</script>
