          <div class="modal-content ent-invoice-modal">
            <!-- Header -->
            <div class="ent-inv-header">
              <div class="ent-inv-header-top">
                <div class="ent-inv-brand">
                  <div class="ent-inv-logo"><i class="bi bi-tools"></i></div>
