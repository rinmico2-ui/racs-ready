      overlay.querySelector('#enterpriseScheduleSettings').addEventListener('submit',async e=>{e.preventDefault();try{await studioApi(`/api/projects/${projectId}/schedule-settings`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(scheduleBody(e.target))});toast('Schedule settings saved');overlay.remove();await loadProject();await showEnterpriseScheduleModal();}catch(err){toast(err.message,'error');}});
      overlay.querySelector('#enterpriseGenerate').addEventListener('click',async()=>{const form=overlay.querySelector('#enterpriseScheduleSettings');if(!form.reportValidity())return;const body=scheduleBody(form);if(!body.workingDays.length)return toast('Select at least one working day.','warning');try{await studioApi(`/api/projects/${projectId}/schedule-settings`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const result=await studioApi(`/api/projects/${projectId}/generate-schedule`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});toast(result.message,result.status==='ready'?'success':'warning');overlay.remove();await loadProject();await showEnterpriseScheduleModal();}catch(err){toast(err.message,'error');}});
    } catch (e) { toast(e.message,'error'); }
  };

  window.editWorkOrderSchedule = function(workOrderId) {
    const order=(window.__lastWorkOrders||[]).find(row=>String(row._id)===String(workOrderId));
    if (!order) return toast('Work order details are not available. Reload and try again.','error');
    document.querySelector('.pw-modal-overlay')?.remove();
    const p=window.__projectData||{}, plan=p.schedulePlan||{}, techs=p.assignedTechnicians||[];
    const fmt=value=>{if(!value)return'';const d=new Date(value);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;};
    const selected=new Set((order.assignedTechnicians||[]).map(t=>String(t._id||t)));
    const overlay=document.createElement('div');overlay.className='pw-modal-overlay';
    overlay.innerHTML=`<div class="pw-modal" style="max-width:620px;"><h3>Change Work Order Schedule</h3><p class="text-muted">${order.workOrderNumber||order.title||'Work Order'} · The complete project schedule will be recalculated and validated.</p><form id="woScheduleAdjust"><div class="resource-summary" style="grid-template-columns:repeat(2,minmax(0,1fr));"><label><b>Start Date *</b><input class="form-control" name="startDate" type="date" required value="${fmt(order.scheduledDate||plan.startDate)}"></label><label><b>End Date *</b><input class="form-control" name="endDate" type="date" required value="${fmt(order.scheduledEndDate||order.scheduledDate||plan.startDate)}"></label><label><b>Start Time *</b><input class="form-control" name="startTime" type="time" required value="${order.startTime||plan.workingHours?.start||'09:00'}"></label><label><b>End Time *</b><input class="form-control" name="endTime" type="time" required value="${order.endTime||plan.workingHours?.end||'17:00'}"></label></div><div class="mt-3"><b style="font-size:.78rem;">Technician / Team</b>${techs.map(t=>`<label class="studio-row" style="justify-content:flex-start;gap:.5rem;"><input type="checkbox" name="technicians" value="${t._id}" ${selected.has(String(t._id))?'checked':''}> ${t.name||'Technician'}</label>`).join('')}</div><div class="d-flex gap-2 justify-content-end mt-3"><button class="pw-btn" type="button" onclick="this.closest('.pw-modal-overlay').remove();showEnterpriseScheduleModal();">Cancel</button><button class="pw-btn primary" type="submit">Validate & Apply</button></div></form></div>`;
    document.body.appendChild(overlay);
    overlay.querySelector('form').addEventListener('submit',async e=>{e.preventDefault();const fd=new FormData(e.target);const override={startDate:fd.get('startDate'),endDate:fd.get('endDate'),startTime:fd.get('startTime'),endTime:fd.get('endTime'),assignedTechnicians:fd.getAll('technicians')};if(!override.assignedTechnicians.length)return toast('Select the required technician or team.','warning');if(override.endDate<override.startDate)return toast('End date cannot be before start date.','warning');try{const result=await studioApi(`/api/projects/${projectId}/generate-schedule`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({startDate:plan.startDate,targetEndDate:plan.targetEndDate,workingDays:plan.workingDays,startTime:plan.workingHours?.start,endTime:plan.workingHours?.end,bufferDays:plan.bufferDays||0,workOrderOverrides:{[String(order._id)]:override}})});toast(result.status==='ready'?'Schedule updated and validated.':result.message,result.status==='ready'?'success':'warning');overlay.remove();await loadProject();showEnterpriseScheduleModal();}catch(err){toast(err.message,'error');}});
  };

  window.studioReservePlan = async function() {
    const p = window.__projectData;
    if (p && teamAcceptancePending(p)) { toast('Required team acceptance is needed before physical resources can be reserved', 'error'); return; }
    const items = p?.planningDraft?.resources || [];
    if (!items.length) return showMaterialModal();
    if (!confirm(`Reserve ${items.length} planned resource item(s) from inventory?`)) return;
    try {
      const result = await studioApi(`/api/projects/${projectId}/reserve-suggested`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ items }) });
      toast(result.message || 'Planned resources reserved');
      await loadProject();
    } catch (e) { toast(e.message, 'error'); }
  };

  window.studioReviewResourcePlan = function() {
    const items = window.__projectData?.planningDraft?.resources || [];
    const safe = value => String(value ?? '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
    if (!items.length) {
      toast('No resource plan yet. Generate AI suggestions to create one.', 'warning');
      return studioSuggestResources();
    }
    const overlay = document.createElement('div');
    overlay.className = 'pw-modal-overlay';
    overlay.innerHTML = `<div class="pw-modal">
      <h5 style="font-size:1rem;font-weight:700;margin-bottom:0.25rem;"><i class="bi bi-clipboard-check me-2" style="color:#6366f1;"></i>Planned Resources</h5>
      <p style="font-size:0.75rem;color:#64748b;">Planning preview only — no inventory has been reserved.</p>
      <div>${items.map(item => `<div class="studio-row"><span><b>${safe(item.itemName)}</b> ×${Number(item.quantity) || 1} ${safe(item.unit || 'pcs')}</span><span class="wo-mini">${safe(item.type || 'equipment')} / ${safe(item.scope || 'shared')}</span></div>`).join('')}</div>
      <div class="d-flex gap-2 justify-content-end mt-3"><button class="pw-btn" onclick="this.closest('.pw-modal-overlay').remove()">Close</button><button class="pw-btn primary" id="reviseResourcePlan"><i class="bi bi-magic"></i> Revise Suggestions</button></div>
    </div>`;
    document.body.appendChild(overlay);
    overlay.addEventListener('click', event => { if (event.target === overlay) overlay.remove(); });
    overlay.querySelector('#reviseResourcePlan').addEventListener('click', () => { overlay.remove(); studioSuggestResources(); });
  };

  // Enterprise Step 2 reviewer. This intentionally replaces the compact
  // preview above while retaining it as a safe fallback for older records.
  window.studioReviewResourcePlan = async function(options = {}) {
    const safe = value => String(value ?? '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
    try {
      const data = await studioApi(`/api/projects/${projectId}/resource-plan`);
      const items = data.resources || [];
      const readiness = data.readiness || {};
      const purchases = data.purchases || [];
      const purchaseFor = item => purchases.find(row => String(row._id) === String(item.purchaseRecordId)) || purchases.find(row => String(row.resourceId) === String(item._id));
      const isOptional = item => item.recommendationState === 'optional' || (item.type === 'part' && item.source === 'ai' && item.recommendationState === 'recommended');
      const isShortage = item => !isOptional(item) && Number(item.available||0) < Number(item.quantity||0);
      const isAvailable = item => !isOptional(item) && !isShortage(item);
      const availableItems = items.filter(item => item.recommendationState !== 'rejected' && isAvailable(item));
      const shortageItems = items.filter(item => item.recommendationState !== 'rejected' && isShortage(item));
      const optionalItems = items.filter(item => item.recommendationState !== 'rejected' && isOptional(item));
      const notRequiredItems = items.filter(item => item.recommendationState === 'rejected');
      const bulkEligible = availableItems.filter(item => item.recommendationState === 'recommended');
      // Category metadata mirrors the technician Daily Kit sections so both
      // surfaces speak the same language.
      const CAT_META = {
        equipment:  { label:'Equipment (Reusable)',          icon:'bi-tools',                  color:'#2563eb', bg:'#eff6ff', border:'#bfdbfe' },
        consumable: { label:'Consumables (Estimated Prep)',  icon:'bi-droplet',                color:'#16a34a', bg:'#f0fdf4', border:'#bbf7d0' },
        part:       { label:'Repair Parts',                  icon:'bi-gear-wide-connected',    color:'#b45309', bg:'#fefce8', border:'#fde68a' },
      };
      const catOf = item => CAT_META[item.type] ? item.type : 'equipment';
      const catHeader = (type, count) => {
        const m = CAT_META[type];
        return `<div style="display:flex;align-items:center;gap:.4rem;margin:.5rem 0 .3rem;padding:.3rem .6rem;border-radius:8px;background:${m.bg};border:1px solid ${m.border};">
          <i class="bi ${m.icon}" style="color:${m.color};"></i>
          <span style="font-size:.66rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:${m.color};">${safe(m.label)}</span>
          <span style="margin-left:auto;font-size:.64rem;font-weight:800;color:${m.color};background:#fff;border-radius:999px;padding:0 .45rem;">${count}</span>
        </div>`;
      };
      const groupRowsByCategory = rows => {
        const buckets = new Map();
        rows.forEach(row => { const t = catOf(row); if (!buckets.has(t)) buckets.set(t, []); buckets.get(t).push(row); });
        let html = '';
        ['equipment','consumable','part'].forEach(type => {
          const list = buckets.get(type);
          if (list && list.length) html += catHeader(type, list.length) + list.map(item => rowHtml(item)).join('');
        });
        return html;
      };
      const rowHtml = (item, mode = 'active') => {
        const purchase = purchaseFor(item), remainingOrder = purchase ? Math.max(0,Number(purchase.orderedQuantity||0)-Number(purchase.receivedQuantity||0)) : 0;
        if (mode === 'dismissed') {
          return `<div class="resource-review-grid" data-resource-id="${item._id}">
            <div><b>${safe(item.itemName)}</b><div class="text-muted">${safe(item.adjustmentReason || 'Marked as not required')}</div></div>
            <div><b>Required ${Number(item.quantity)||1}</b><div class="text-muted">Available ${Number(item.available)||0} ${safe(item.unit||'pcs')}</div></div>
            <span class="resource-status optional">NOT REQUIRED</span>
            <div class="resource-row-actions"><button class="pd-btn success res-action" data-action="planned" data-reason="Restored to plan by admin">Restore</button></div>
          </div>`;
        }
        const status = isOptional(item) ? 'OPTIONAL' : isShortage(item) ? (purchase?.status === 'partially_received' ? 'PARTIAL' : purchase?.status === 'ordered' ? 'PURCHASED' : 'SHORTAGE') : 'AVAILABLE';
        return `<div class="resource-review-grid" data-resource-id="${item._id}">
          <div><b>${safe(item.itemName)}</b><div class="text-muted">${safe(item.reason || (isOptional(item) ? 'AI recommendation · possible repair part' : 'Project requirement'))}</div>${purchase ? `<div class="text-muted">Purchased ${Number(purchase.orderedQuantity||0)} · Received ${Number(purchase.receivedQuantity||0)} · ${safe(purchase.supplier||'Supplier')}</div>` : ''}</div>
          <div><b>Required ${Number(item.quantity)||1}</b><div class="text-muted">Available ${Number(item.available)||0}${Number(item.shortage||0)>0 ? `<br>Shortage ${Number(item.shortage)}` : ''} ${safe(item.unit||'pcs')}</div></div>
          <span class="resource-status ${isOptional(item)?'optional':isShortage(item)?'procurement_required':'available'}">${status}</span>
          <div class="resource-row-actions">
            ${isShortage(item) && !remainingOrder ? (item.type === 'equipment' ? `<button class="pd-btn res-find-equipment">Find Available Equipment</button><button class="pd-btn primary res-purchase" data-mode="rent">Rent/Acquire</button>` : `<button class="pd-btn primary res-purchase" data-mode="purchase">Procure ${Number(item.shortage||0)}</button>`) : ''}
            ${purchase && remainingOrder>0 ? `<button class="pd-btn success res-receive">Receive (${remainingOrder} due)</button>` : ''}
            ${isShortage(item) ? '<button class="pd-btn res-replace">Replace</button>' : ''}
            <button class="pd-btn res-edit">Edit</button>
            ${isShortage(item) ? '<button class="pd-btn res-not-required" title="Exclude this item from readiness checks and blockers">Not Required</button>' : ''}
            ${isOptional(item) ? `<button class="pd-btn success res-action" data-action="planned" data-reason="Optional recommendation included by admin">Include</button><button class="pd-btn res-action" data-action="rejected" data-reason="Optional recommendation dismissed by admin">Dismiss</button>` : ''}
          </div></div>`;
      };
      const grouped = [
        { label:'AVAILABLE', rows:availableItems, icon:'check-circle-fill' },
        { label:'SHORTAGES', rows:shortageItems, icon:'exclamation-triangle-fill' },
        { label:'OPTIONAL', rows:optionalItems, icon:'circle' },
      ].map(group => {
        if (!group.rows.length) return '';
        return `<div class="resource-group-title"><i class="bi bi-${group.icon}"></i> ${group.label} (${group.rows.length})</div>${groupRowsByCategory(group.rows)}`;
      }).join('');
      const dismissedSection = notRequiredItems.length
        ? `<div class="resource-group-title" style="opacity:.85;"><i class="bi bi-archive"></i> NOT REQUIRED (${notRequiredItems.length})</div>${notRequiredItems.map(item => rowHtml(item,'dismissed')).join('')}`
        : '';
      const overlay = document.createElement('div');
      overlay.className = 'pw-modal-overlay';
      overlay.innerHTML = `<div class="pw-modal" style="max-width:1080px;max-height:92vh;overflow:auto;" role="dialog" aria-modal="true" aria-labelledby="resourcePlanningTitle" tabindex="-1">
        <div class="d-flex justify-content-between align-items-start gap-3"><div><h5 id="resourcePlanningTitle" style="font-size:1rem;font-weight:800;margin:0;"><i class="bi bi-boxes me-2" style="color:#1d4ed8"></i>Resource Planning & Readiness</h5><p style="font-size:.72rem;color:#64748b;margin:.2rem 0 0;">Planning only. No stock is reserved or deducted until Confirm Project Plan.</p></div><div class="d-flex align-items-center gap-2"><span class="resource-status ${readiness.status === 'ready' ? 'available' : readiness.status === 'blocked' ? 'procurement_required' : 'partially_available'}">${safe(String(readiness.status||'not checked').replace(/_/g,' ').toUpperCase())}</span><button type="button" class="pw-modal-close" aria-label="Close resource planning dialog"><i class="bi bi-x-lg"></i></button></div></div>
        <div class="resource-summary"><div><b>Total Resources</b><span>${availableItems.length+shortageItems.length+optionalItems.length}</span></div><div><b>✓ Available</b><span>${availableItems.length}</span></div><div><b>⚠ Shortages</b><span>${shortageItems.length}</span></div><div><b>○ Optional</b><span>${optionalItems.length}</span></div><div><b>Not Required</b><span>${notRequiredItems.length}</span></div><div><b>Direct Material Estimate</b><span>PHP ${Number(readiness.estimatedDirectMaterialCost||0).toLocaleString('en-PH',{minimumFractionDigits:2})}</span></div></div>
        <div class="d-flex gap-2 flex-wrap mt-2"><button class="pw-btn primary" id="acceptAllAvailable" ${bulkEligible.length?'':'disabled'}><i class="bi bi-check2-all"></i> Accept All Available (${bulkEligible.length})</button>${shortageItems.length?'<button class="pw-btn" id="reviewShortages"><i class="bi bi-exclamation-triangle"></i> Review Shortages</button>':''}<button class="pw-btn" id="resourceAddTop"><i class="bi bi-plus-lg"></i> Add Resource</button><button class="pw-btn" id="resourceReadinessTop"><i class="bi bi-activity"></i> Check Readiness</button></div>
        ${grouped || '<div class="studio-row mt-2"><span class="text-muted">No resources yet. Add the first planned resource below or use AI Suggest.</span></div>'}
        ${dismissedSection}
        <div class="text-muted mt-2" style="font-size:.7rem;"><i class="bi bi-archive"></i> Not Required items are excluded from readiness checks and blockers, kept for audit, and can be restored anytime.</div>
        <div class="resource-group-title" id="manualResourceHeading">Add Resource Manually</div>
        <div id="manualResourceForm" style="display:grid;grid-template-columns:2fr 1fr 90px 1.3fr;gap:.45rem;margin-top:.5rem;">
          <div><input class="form-control form-control-sm" id="resourceSearch" placeholder="Search inventory or enter item name"><select class="form-select form-select-sm mt-1" id="resourceMatches"><option value="">Custom / no catalog match</option></select></div>
          <select class="form-select form-select-sm" id="resourceType"><option value="equipment">Equipment</option><option value="consumable">Consumable</option><option value="part">Repair Part</option></select>
          <input class="form-control form-control-sm" id="resourceQty" type="number" min="1" value="1" aria-label="Quantity">
          <select class="form-select form-select-sm" id="resourceRule"><option value="fixed">Fixed project quantity</option><option value="per_technician">Per technician</option><option value="per_unit">Per unit</option><option value="per_work_order">Per work order</option><option value="shared">Shared</option></select>
          <input class="form-control form-control-sm" id="resourceReason" style="grid-column:1/4" placeholder="Reason / planning basis">
          <button class="pw-btn primary" id="resourceAdd"><i class="bi bi-plus-lg"></i> Add Resource</button>
        </div>
        ${readiness.blockers?.length ? `<div class="pwz-cover-note warn mt-3"><b>Blocking issues:</b> ${readiness.blockers.map(safe).join('; ')}</div>` : ''}
        <div class="d-flex gap-2 justify-content-end mt-3"><button class="pw-btn" id="resourceReadiness"><i class="bi bi-activity"></i> Check Resource Readiness</button><button class="pw-btn resource-modal-close">Close</button></div>
      </div>`;
      document.body.appendChild(overlay);
      const priorBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      const closeOnEscape = event => {
        if (event.key === 'Escape' && overlay.isConnected) closeResourceModal();
      };
      const closeResourceModal = () => {
        document.removeEventListener('keydown', closeOnEscape);
        document.body.style.overflow = priorBodyOverflow;
        overlay.remove();
      };
      overlay.addEventListener('click', event => { if (event.target === overlay) closeResourceModal(); });
      overlay.querySelectorAll('.pw-modal-close, .resource-modal-close').forEach(button => button.addEventListener('click', closeResourceModal));
      document.addEventListener('keydown', closeOnEscape);
      overlay.querySelector('.pw-modal')?.focus();
      const reloadReview = async message => { if (message) toast(message); closeResourceModal(); await loadProject(); studioReviewResourcePlan(); };
      overlay.querySelector('#acceptAllAvailable')?.addEventListener('click', async () => {
        if (!confirm(`Accept All Available?\n\n${bulkEligible.length} resources have sufficient inventory.\n\nThese resources will be included in the project plan.`)) return;
        const result = await studioApi(`/api/projects/${projectId}/resources/accept-available`, { method:'POST' });
        reloadReview(result.message);
      });
      overlay.querySelector('#reviewShortages')?.addEventListener('click', () => overlay.querySelector('.resource-status.procurement_required')?.closest('[data-resource-id]')?.scrollIntoView({behavior:'smooth',block:'center'}));
      overlay.querySelector('#resourceAddTop')?.addEventListener('click', () => { overlay.querySelector('#manualResourceHeading')?.scrollIntoView({behavior:'smooth'}); setTimeout(()=>overlay.querySelector('#resourceSearch')?.focus(),300); });
      overlay.querySelector('#resourceReadinessTop')?.addEventListener('click', () => overlay.querySelector('#resourceReadiness')?.click());
      overlay.querySelectorAll('.res-action').forEach(button => button.addEventListener('click', async () => {
        const row = button.closest('[data-resource-id]');
        const result = await studioApi(`/api/projects/${projectId}/resources/${row.dataset.resourceId}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ recommendationState:button.dataset.action, adjustmentReason:button.dataset.reason || (button.dataset.action==='planned'?'Optional recommendation included by admin':'Optional recommendation dismissed by admin') }) });
        reloadReview(result.message);
      }));
      overlay.querySelectorAll('.res-not-required').forEach(button => button.addEventListener('click', async () => {
        const row = button.closest('[data-resource-id]');
        const current = items.find(item => String(item._id) === String(row.dataset.resourceId));
        if (!confirm(`Mark "${current.itemName}" as NOT REQUIRED?\n\nIt will be excluded from readiness checks and confirmation blockers, kept in the audit trail, and can be restored from the Not Required section.`)) return;
        const result = await studioApi(`/api/projects/${projectId}/resources/${row.dataset.resourceId}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ recommendationState:'rejected', adjustmentReason:'Marked as not required by admin' }) });
        reloadReview(result.message);
      }));
      overlay.querySelectorAll('.res-edit').forEach(button => button.addEventListener('click', async () => {
        const row = button.closest('[data-resource-id]');
        const current = items.find(item => String(item._id) === row.dataset.resourceId);
        const quantity = prompt(`Planned quantity for ${current.itemName}:`, current.quantity);
        if (quantity === null) return;
        const adjustmentReason = prompt('Reason for quantity adjustment (required for audit):', current.adjustmentReason || '');
