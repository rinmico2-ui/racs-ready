    async function loadServiceCalendarMonth() {
      if (!state.selectedServiceId) return;
      const start = startOfMonth(state.calendar.activeMonth);
      const end = addMonths(start, 1);
      const params = new URLSearchParams({
        start: formatDateKey(start),
        end: formatDateKey(end),
      });
      if (techEl.value) params.set("technicianId", techEl.value);

      try {
        const r = await fetch(
          `/api/services/${encodeURIComponent(state.selectedServiceId)}/calendar?${params.toString()}`,
          { cache: "no-store" },
        );
        const j = await r.json();
        state.calendar.bookedDates = new Set(j.bookedDates || []);
        state.calendar.blockedDates = new Set(j.blockedDates || []);
        state.calendar.publicHolidays = new Map(
          (j.publicHolidays || []).map((h) => [h.date, h.name || ""]),
        );
      } catch (e) {
        state.calendar.bookedDates = new Set();
        state.calendar.blockedDates = new Set();
        state.calendar.publicHolidays = new Map();
      }
    }

    function resolveDateStatus(date) {
      const key = formatDateKey(date);
      const now = new Date();
      const today = startOfDay(now);
      const totalCurrentMinutes = now.getHours() * 60 + now.getMinutes();
      const workingDayEndMinutes = 19 * 60; // 7 PM (includes overtime)
      
      // Block dates before today
      if (date < today) return "blocked";
      
      // Block current date if past working hours (5 PM)
      if (isSameDate(date, today) && totalCurrentMinutes > workingDayEndMinutes) {
        return "blocked";
      }
      
      // Block technician rest dates
      if (state.calendar.restDates.has(key)) return "blocked";
      
      // Block technician non-working weekdays
      if (state.calendar.nonWorkingWeekdays.includes(date.getDay()))
        return "blocked";
      
      // Block booked dates
      if (state.calendar.bookedDates.has(key)) return "booked";
      
      // Block public holidays
      if (state.calendar.publicHolidays.has(key)) return "public";
      
      // Block explicitly blocked dates
      if (state.calendar.blockedDates.has(key)) return "blocked";
      
      return "available";
    }

    async function renderCalendar() {
      if (!calendarGridEl) return;
      await loadServiceCalendarMonth();

      const month = state.calendar.activeMonth;
      calendarLabelEl.textContent = new Intl.DateTimeFormat("en-US", {
        month: "long",
        year: "numeric",
      }).format(month);

      calendarGridEl.innerHTML = "";
      const year = month.getFullYear();
      const m = month.getMonth();
      const lead = new Date(year, m, 1).getDay();
      for (let i = 0; i < lead; i++) {
        const filler = document.createElement("div");
        filler.className = "calendar-cell disabled";
        calendarGridEl.appendChild(filler);
      }

      const days = new Date(year, m + 1, 0).getDate();
      for (let day = 1; day <= days; day++) {
        const date = new Date(year, m, day);
        const status = resolveDateStatus(date);
        const cell = document.createElement("button");
        cell.type = "button";
        cell.className = "calendar-cell";
        cell.dataset.status = status;
        cell.textContent = String(day).padStart(2, "0");
        if (status !== "available") {
          cell.classList.add("disabled");
          cell.disabled = true;
        } else {
          cell.addEventListener("click", async () => {
            state.selectedDate = startOfDay(date);
            state.selectedStartMinutes = null;
            await renderCalendar();
            await renderTimeSlotsForDate(state.selectedDate);
            updateSummary();
          });
        }
        if (state.selectedDate && isSameDate(state.selectedDate, date))
          cell.classList.add("is-selected");
        calendarGridEl.appendChild(cell);
      }
    }

    async function renderTimeSlotsForDate(date) {
      if (!date) return;
      const dateKey = formatDateKey(date);

      timeSelectionEl.classList.remove("d-none");
      timeSlotsEl.innerHTML = "";
      timeNoticeEl.textContent = "Loading available slots...";

      const params = new URLSearchParams({
        date: dateKey,
        serviceId: state.selectedServiceId,
      });
      if (techEl.value) params.set("technicianId", techEl.value);
      if (
        Number.isFinite(Number(state.travelTime)) &&
        Number(state.travelTime) > 0
      )
        params.set("travelTime", String(state.travelTime));

      try {
        const r = await fetch(
          `/api/services/availability?${params.toString()}`,
          { cache: "no-store" },
        );
        const j = await r.json();
        const slots = j.slots || [];

        if (!slots.length) {
          timeNoticeEl.textContent = "No available slots for this date.";
          timeRangeInfoEl.textContent = "";
          return;
        }

        timeNoticeEl.textContent = "";
        const available = slots.filter((s) => s.status === "available");
        if (available.length) {
          timeRangeInfoEl.textContent = `Available between ${minutesToLabel(available[0].startMinutes)} and ${minutesToLabel(available[available.length - 1].endMinutes)}`;
        } else {
          timeRangeInfoEl.textContent = "No available times";
        }

        // Enhanced past-time blocking with buffer
        const now = new Date();
        const today = startOfDay(now);
        const currentHour = now.getHours();
        const currentMinutes = now.getMinutes();
        const totalCurrentMinutes = currentHour * 60 + currentMinutes;
        const bufferMinutes = 30; // 30-minute buffer
        const isToday = isSameDate(date, today);

        slots.forEach((slot) => {
          // Check if this time slot is in the past for today
          let isPastTime = false;
          if (isToday && slot.status === "available") {
            // If the slot start time is earlier than current time plus buffer, mark as past
            if (slot.startMinutes <= (totalCurrentMinutes + bufferMinutes)) {
              isPastTime = true;
            }
          }

          // Skip past time slots completely - don't render them at all
          if (isPastTime) {
            return; // Skip this iteration, don't create the button
          }

          const btn = document.createElement("button");
          btn.type = "button";
          btn.className =
            "time-slot btn btn-sm d-flex flex-column align-items-start gap-0 px-3 py-2";
          btn.dataset.start = String(slot.startMinutes);

          const line1 = document.createElement("span");
          line1.className = "fw-semibold";
          line1.textContent =
            slot.label ||
            `${minutesToLabel(slot.startMinutes)} - ${minutesToLabel(slot.endMinutes)}`;
          btn.appendChild(line1);

          if (slot.detail) {
            const line2 = document.createElement("span");
            line2.className = "small text-muted";
            line2.style.fontSize = ".72rem";
            line2.textContent = slot.detail;
            btn.appendChild(line2);
          }

          if (slot.status !== "available") {
            btn.disabled = true;
            btn.classList.add("disabled");
            if (slot.status === "booked") {
              btn.title = "Already reserved";
            } else if (slot.status === "blocked") {
              btn.title = "Not working";
            }
          } else {
            btn.addEventListener("click", () => {
              timeSlotsEl
                .querySelectorAll(".time-slot")
                .forEach((n) => n.classList.remove("active"));
              btn.classList.add("active");
              state.selectedStartMinutes = Number(slot.startMinutes);
              updateSummary();
            });
          }

          if (
            state.selectedStartMinutes != null &&
            Number(state.selectedStartMinutes) === Number(slot.startMinutes)
          )
            btn.classList.add("active");
          timeSlotsEl.appendChild(btn);
        });
      } catch (e) {
        timeNoticeEl.textContent = "Failed to load availability.";
        timeRangeInfoEl.textContent = "";
      }
    }

    async function buildSuggestedDates() {
      const results = [];
      const candidates = [];
      
      // Get service duration once for use throughout the function
      const service = currentService();
      const serviceDuration = service ? (service.durationMinutes || service.estimatedDurationMinutes || 60) : 60;

      // Generate candidate dates for the next 30 days
      let cursor = addDays(new Date(), 1);
      let guard = 0;

      while (candidates.length < 15 && guard < 60) {
        const status = resolveDateStatus(cursor);
        if (status === "available") {
          candidates.push({
            date: startOfDay(cursor),
            displayDate: friendlyDateFormatter.format(cursor),
            dayOfWeek: cursor.getDay(),
            daysFromToday: Math.floor((cursor - new Date()) / (1000 * 60 * 60 * 24))
          });
        }
        cursor = addDays(cursor, 1);
        guard += 1;
      }

      // Score candidates based on AI-like factors
      const scoredCandidates = candidates.map(candidate => {
        let score = 0;

        // Factor 1: Time quality (40%) - prefer weekdays, avoid weekends
        const dayOfWeek = candidate.dayOfWeek;
        if (dayOfWeek >= 1 && dayOfWeek <= 5) {
          score += 0.4; // Weekdays are preferred
        } else {
          score += 0.1; // Weekends are less preferred
        }

        // Factor 2: Distance from today (25%) - prefer sooner dates but not too soon
        const daysFromToday = candidate.daysFromToday;
        if (daysFromToday >= 2 && daysFromToday <= 14) {
          score += 0.25; // Sweet spot
        } else if (daysFromToday >= 15 && daysFromToday <= 21) {
          score += 0.15; // Still good but less ideal
        } else {
          score += 0.05; // Too soon or too far
        }

        // Factor 3: Service time compatibility (25%) - prefer times that work well with service duration
        if (serviceDuration <= 120) {
          score += 0.25; // Short services are flexible
        } else if (serviceDuration <= 240) {
          score += 0.20; // Medium services
        } else {
          score += 0.15; // Long services need more planning
        }

        // Factor 4: Random variation (10%) - to provide variety
        score += Math.random() * 0.1;

        return {
          ...candidate,
          score: Math.min(score, 1.0)
        };
      });

      // Sort by score and take top 3
      scoredCandidates.sort((a, b) => b.score - a.score);
      const topCandidates = scoredCandidates.slice(0, 3);

      // Build final suggestions with time slots and confidence levels
      const timeSlots = ["09:00 AM", "11:00 AM", "02:00 PM", "04:00 PM"];

      topCandidates.forEach((candidate, index) => {
        const confidence = calculateConfidence(candidate.score);
        const timeLabel = timeSlots[index % timeSlots.length];

        // Generate realistic availability windows
        const availableRanges = generateAvailabilityWindows(timeLabel, serviceDuration);

        results.push({
          date: candidate.date,
          displayDate: candidate.displayDate,
          timeLabel,
          timeStart: parseAMPMToMinutes(timeLabel),
          score: candidate.score,
          confidence,
          availableRanges,
          technicianId: techEl.value || null
        });
      });

      return results;
    }

    function calculateConfidence(score) {
      if (score >= 0.8) {
        return { level: "Excellent", color: "#10b981", icon: "" };
      } else if (score >= 0.6) {
        return { level: "Very Good", color: "#3b82f6", icon: "" };
      } else if (score >= 0.4) {
        return { level: "Good", color: "#10b981", icon: "" };
      } else {
        return { level: "Fair", color: "#f59e0b", icon: "" };
      }
    }

    function generateAvailabilityWindows(baseTime, serviceDuration) {
      const baseMinutes = parseAMPMToMinutes(baseTime);
      const windows = [];

      // Create 2-3 availability windows around the base time
      const windowCount = Math.floor(Math.random() * 2) + 2; // 2-3 windows

      for (let i = 0; i < windowCount; i++) {
        const offset = (i - 1) * 120; // Spread windows 2 hours apart
        const start = baseMinutes + offset;
        const end = start + 180; // 3-hour windows

        // Ensure windows are within business hours (8 AM - 6 PM)
        if (start >= 480 && start <= 1080 && end <= 1260) {
          windows.push({ start, end });
        }
      }

      return windows.sort((a, b) => a.start - b.start);
    }

    function parseAMPMToMinutes(label) {
      // expected formats: '08:00 AM' or '8:00 AM'
      const parts = label.trim().split(/\s+/);
      if (parts.length < 2) return 0;
      const [timePart, ampm] = parts;
      const [hh, mm] = timePart.split(":").map((n) => parseInt(n, 10));
      let hours = hh % 12;
      if (ampm.toUpperCase() === "PM") hours += 12;
      return hours * 60 + (mm || 0);
    }

    function minutesTo12HourLabel(totalMinutes) {
      const h = Math.floor(totalMinutes / 60);
      const m = totalMinutes % 60;
      const ampm = h >= 12 ? "PM" : "AM";
      const hour12 = ((h + 11) % 12) + 1;
      return `${String(hour12).padStart(2, "0")}:${String(m).padStart(2, "0")} ${ampm}`;
    }

    // Helper function to add days to a date
    function addDays(date, days) {
      const result = new Date(date);
      result.setDate(result.getDate() + days);
      return result;
    }

    // Helper function to check if two dates are the same day
    function isSameDate(date1, date2) {
      return date1.getFullYear() === date2.getFullYear() &&
             date1.getMonth() === date2.getMonth() &&
             date1.getDate() === date2.getDate();
    }

    // Helper function to start of day
    function startOfDay(date) {
      const result = new Date(date);
      result.setHours(0, 0, 0, 0);
      return result;
    }

    // Friendly date formatter
    const friendlyDateFormatter = new Intl.DateTimeFormat('en-US', {
      weekday: 'short',
      month: 'short', 
      day: 'numeric'
    });

    function renderSuggestedDates() {
      // Check if we have the necessary elements
      const suggestedWrapper = document.getElementById('suggestedWrapper');
      const suggestedCards = document.getElementById('suggestedCards');

      if (!suggestedWrapper || !suggestedCards) {
        return;
      }

      if (!state.selectedServiceId) {
        suggestedWrapper.classList.add("d-none");
        suggestedCards.innerHTML = "";
        return;
      }

      const suggestions = buildSuggestedDates();
      suggestedCards.innerHTML = "";

      if (!suggestions.length) {
        suggestedWrapper.classList.remove("d-none");
        suggestedCards.innerHTML =
          '<div class="col-12"><div class="alert alert-warning">No suggested dates available right now. Please use the calendar.</div></div>';
        return;
      }

      suggestions.forEach((entry, index) => {
        const column = document.createElement("div");
        column.className = "col-md-4";

        const confidence = entry.confidence;
        const isProfessional = entry.technicianId && techEl.value;

        column.innerHTML = `
          <article class="suggested-card h-100" role="button" tabindex="0">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="badge" style="background-color: ${confidence.color}20; color: ${confidence.color}">
                ${confidence.icon} AI ${isProfessional ? 'Tech' : 'Smart'} #${index + 1}
              </span>
              <small class="text-muted">${confidence.level}</small>
            </div>
            <h6 class="mb-1">${entry.displayDate}</h6>
            <p class="mb-1 small fw-semibold">${entry.timeLabel}</p>
            <p class="mb-0 small text-muted">
              ${currentService() ? (currentService().durationMinutes || currentService().estimatedDurationMinutes || 60) : 60} mins · ${entry.availableRanges.length} windows
              ${isProfessional ? `· Tech ${entry.technicianId.slice(-4)}` : ''}
            </p>
            ${entry.availableRanges.length > 0 ? `
            <div class="mt-2">
              <small class="text-muted">Available: ${entry.availableRanges.map(r => 
                `${minutesTo12HourLabel(r.start)}-${minutesTo12HourLabel(r.end)}` 
              ).join(', ')}</small>
            </div>
            ` : ''}
            ${isProfessional ? `
            <div class="mt-1">
              <small class="text-success"> Optimized for selected technician</small>
            </div>
            ` : ''}
            <div class="mt-2">
              <small class="text-info"> AI-scored ${(entry.score * 100).toFixed(0)}%</small>
            </div>
          </article>
        `;

        const card = column.querySelector(".suggested-card");
        card.addEventListener("click", () => handleSuggestionSelection(entry, card));
        card.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            handleSuggestionSelection(entry, card);
          }
        });

        suggestedCards.appendChild(column);
      });

      suggestedWrapper.classList.remove("d-none");
    }

    function handleSuggestionSelection(entry, card) {
      state.selectedDate = startOfDay(entry.date);
      state.selectedStartMinutes = entry.timeStart;

      // Remove active class from all suggestion cards
      document.querySelectorAll(".suggested-card").forEach(node => node.classList.remove("active"));
      card.classList.add("active");

      // Update calendar and time slots
      renderCalendar();
      renderTimeSlotsForDate(state.selectedDate);
      updateSummary();

      // Scroll to calendar section
      const calendarSection = document.querySelector('.booking-step:has(#calendarGrid)');
      if (calendarSection) {
        calendarSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    async function resolveAddressOrCoordinates() {
      const raw = String(locationInputEl.value || "").trim();
      if (!raw) return;

      const coord = raw.match(
        /^\s*(-?\d+(?:\.\d+)?)\s*[,;\s]\s*(-?\d+(?:\.\d+)?)\s*$/
      );
      if (coord) {
        const lat = Number(coord[1]);
        const lng = Number(coord[2]);
        if (
          Number.isFinite(lat) &&
          Number.isFinite(lng) &&
          Math.abs(lat) <= 90 &&
          Math.abs(lng) <= 180
        ) {
          setCustomerCoords({ lat, lng }, "Coordinates pinned on map.");
          return;
        }
      }

      setLocationStatus("Resolving address...", "info");
      try {
        const r = await fetch(
          `/api/services/geocode?q=${encodeURIComponent(raw)}`,
        );
        const j = await r.json();
        const lat = Number(j.lat);
        const lng = Number(j.lon);
        if (Number.isFinite(lat) && Number.isFinite(lng)) {
          setCustomerCoords(
            { lat, lng },
            "Address resolved and pinned on map.",
          );
        } else {
          setLocationStatus(
            "Could not resolve address. Use coordinates or current location.",
            "danger",
          );
        }
      } catch (e) {
        setLocationStatus(
          "Could not resolve address. Use coordinates or current location.",
          "danger",
        );
      }
    }

    async function suggestAddresses(q) {
      try {
        const r = await fetch(
          `/api/services/geocode-suggest?q=${encodeURIComponent(q)}`,
        );
        const j = await r.json();
        return (j.suggestions || []).slice(0, 5);
      } catch (e) {
        return [];
      }
    }

    document
      .getElementById("resolveAddressBtn")
      .addEventListener("click", resolveAddressOrCoordinates);
    document
      .getElementById("detectLocationBtn")
      .addEventListener("click", () => {
        if (!navigator.geolocation)
          return setLocationStatus("Geolocation not supported.", "danger");
        setLocationStatus("Detecting location...", "info");
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const coords = {
              lat: pos.coords.latitude,
              lng: pos.coords.longitude,
            };
            locationInputEl.value = `${coords.lat.toFixed(6)}, ${coords.lng.toFixed(6)}`;
            setCustomerCoords(coords, "Current location pinned on map.");
          },
          () => setLocationStatus("Unable to detect location.", "danger"),
          { enableHighAccuracy: true, timeout: 12000 },
        );
      });

    let suggestTimer = null;
    locationInputEl.addEventListener("input", () => {
      clearTimeout(suggestTimer);
      const q = String(locationInputEl.value || "").trim();
      if (!q || q.length < 3) {
        locationSuggestEl.classList.add("d-none");
        locationSuggestEl.innerHTML = "";
        return;
      }
      suggestTimer = setTimeout(async () => {
        const items = await suggestAddresses(q);
        locationSuggestEl.innerHTML = "";
        if (!items.length) return locationSuggestEl.classList.add("d-none");
        items.forEach((it) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "list-group-item list-group-item-action";
          btn.textContent = it.display_name;
          btn.addEventListener("click", () => {
            locationInputEl.value = it.display_name;
            locationSuggestEl.classList.add("d-none");
            const lat = Number(it.lat);
            const lng = Number(it.lon);
            if (Number.isFinite(lat) && Number.isFinite(lng))
              setCustomerCoords(
                { lat, lng },
                "Address suggestion pinned on map.",
              );
          });
          locationSuggestEl.appendChild(btn);
        });
        locationSuggestEl.classList.remove("d-none");
      }, 260);
    });

    locationInputEl.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        resolveAddressOrCoordinates();
      }
    });

    document.querySelectorAll("[data-calendar-nav]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        state.calendar.activeMonth = addMonths(
          state.calendar.activeMonth,
          btn.dataset.calendarNav === "prev" ? -1 : 1,
        );
        await renderCalendar();
      });
    });

    document.querySelectorAll(".category-btn").forEach((btn) => {
      btn.addEventListener("click", async function () {
        document
          .querySelectorAll(".category-btn")
          .forEach((item) => item.classList.remove("active"));
        this.classList.add("active");
        serviceTypeEl.value = this.getAttribute("data-category") || "core";
        state.selectedServiceId = "";
        state.selectedDate = null;
        state.selectedStartMinutes = null;
        renderServiceCards();
        await renderCalendar();
      });
    });

    if (serviceCardsEl) {
      serviceCardsEl.addEventListener("click", async (e) => {
        const card = e.target.closest(".service-card[data-service-id]");
        if (!card) return;
        state.selectedServiceId = card.getAttribute("data-service-id") || "";
        serviceIdEl.value = state.selectedServiceId;
        state.selectedDate = null;
        state.selectedStartMinutes = null;
        renderServiceCards();
        await renderCalendar();
        renderSuggestedDates(); // Update suggested dates when service changes
      });

      serviceCardsEl.addEventListener("keydown", async (e) => {
        if (e.key !== "Enter" && e.key !== " ") return;
        const card = e.target.closest(".service-card[data-service-id]");
        if (!card) return;
        e.preventDefault();
        state.selectedServiceId = card.getAttribute("data-service-id") || "";
        serviceIdEl.value = state.selectedServiceId;
        state.selectedDate = null;
        state.selectedStartMinutes = null;
        renderServiceCards();
        await renderCalendar();
        renderSuggestedDates(); // Update suggested dates when service changes
      });
    }

    // Also attach handlers for tabbed service card containers (admin layout)
    const coreCardsEl = document.getElementById("coreServiceCards");
    const repairCardsEl = document.getElementById("repairServiceCards");
    function handleServiceCardClick(e) {
      const btn = e.target.closest(".add-service-btn[data-service-id]");
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      state.selectedServiceId = btn.getAttribute("data-service-id") || "";
      serviceIdEl.value = state.selectedServiceId;
      state.selectedDate = null;
      state.selectedStartMinutes = null;
      renderServiceCards();
    }
    if (coreCardsEl) coreCardsEl.addEventListener("click", handleServiceCardClick);
    if (repairCardsEl) repairCardsEl.addEventListener("click", handleServiceCardClick);

    techEl.addEventListener("change", async () => {
      state.selectedDate = null;
      state.selectedStartMinutes = null;
      await loadTechnicianSchedule();
      await fetchTechLocation();
      await renderCalendar();
      renderSuggestedDates(); // Update suggested dates when technician changes
      updateSummary();
    });

    document.querySelectorAll(".payment-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        document
          .querySelectorAll(".payment-tab")
          .forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");
        const mode = tab.getAttribute("data-cash-mode") || "downpayment";
        state.cashPaymentMode = mode === "full" ? "full" : "downpayment";
        state.paymentMethod = "cod";
        document.getElementById("payCod").value = "cod";
        syncCashAmountInput();
        updateSummary();
      });
    });

    // Customer type selection event listeners
    document.querySelectorAll('input[name="customerType"]').forEach(radio => {
      radio.addEventListener('change', () => {
        state.isNewCustomer = document.getElementById('custNew').checked;
        
        // Clear customer fields when switching type
        if (state.isNewCustomer) {
          // Switching to new customer - clear and enable fields
          ['firstName', 'lastName', 'customerPhone', 'customerEmail'].forEach(id => {
            const field = document.getElementById(id);
            field.value = '';
            field.disabled = false;
          });
          // For address selects: enable province, let PSGC handler cascade city/barangay
          const provinceEl = document.getElementById('addrProvince');
          const cityEl = document.getElementById('addrCity');
          const barangayEl = document.getElementById('addrBarangay');
          const postalEl = document.getElementById('addrPostalCode');
          if (provinceEl) { provinceEl.value = ''; provinceEl.disabled = false; }
          if (cityEl) { cityEl.value = ''; cityEl.disabled = true; }
          if (barangayEl) { barangayEl.value = ''; barangayEl.disabled = true; }
          if (postalEl) { postalEl.value = ''; postalEl.disabled = false; }
          showSuccess('Switched to new customer mode. All fields are now editable.');
        } else {
          // Switching to existing customer - clear and enable only email initially
          ['firstName', 'lastName', 'customerPhone', 'addrProvince', 'addrCity', 'addrBarangay', 'addrPostalCode'].forEach(id => {
            const field = document.getElementById(id);
            field.value = '';
            field.disabled = true;
          });
          document.getElementById('customerEmail').disabled = false;
          document.getElementById('customerEmail').value = '';
          showSuccess('Switched to existing customer mode. Enter email to load customer details.');
        }
        
        adjustCustomerDetailsStep();
      });
    });

    document.querySelectorAll("[data-next-step]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const target = Number(btn.getAttribute("data-next-step"));
        if (!validateStep(state.currentStep)) return;
        if (state.currentStep === 0 && target === 1) {
          state.isNewCustomer = document.getElementById("custNew").checked;
          adjustCustomerDetailsStep();
          if (!(await checkCustomerEmail())) return;
        }
        if (target === 3) {
          await loadTechnicianSchedule();
          await renderCalendar();
          renderSuggestedDates();
        }
        goToStep(target);
      });
    });

    document.querySelectorAll("[data-prev-step]").forEach((btn) => {
      btn.addEventListener("click", () => {
        goToStep(Number(btn.getAttribute("data-prev-step")));
        hideAlert();
      });
    });

    document.querySelectorAll(".stepper-step[data-step]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const target = Number(btn.getAttribute("data-step"));
        if (target > state.currentStep && !validateStep(state.currentStep))
          return;
        if (state.currentStep === 0 && target >= 1) {
          state.isNewCustomer = document.getElementById("custNew").checked;
          adjustCustomerDetailsStep();
          if (!(await checkCustomerEmail())) return;
        }
        if (target === 3) {
          await loadTechnicianSchedule();
          await renderCalendar();
          renderSuggestedDates();
        }
        goToStep(target);
      });
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideAlert();

      for (const s of [1, 2, 3, 4, 5]) {
        if (!validateStep(s)) {
          goToStep(s);
          return;
        }
      }

      const svc = currentService();
      const customerEmailFieldValue = document.getElementById("customerEmail").value.trim();
      console.log("[FRONTEND] Submitting with email:", customerEmailFieldValue, "isNewCustomer:", state.isNewCustomer);
      
      const payload = {
        firstName: document.getElementById("firstName").value.trim(),
        lastName: document.getElementById("lastName").value.trim(),
        customerPhone: document.getElementById("customerPhone").value.trim(),
        customerEmail: customerEmailFieldValue,
        isNewCustomer: state.isNewCustomer,
        address: {
          province: document.getElementById("addrProvince").value.trim(),
          city: document.getElementById("addrCity").value.trim(),
          barangay: document.getElementById("addrBarangay").value.trim(),
          postalCode: document.getElementById("addrPostalCode").value.trim(),
        },
        customerLocation: state.customerCoords
          ? {
              lat: state.customerCoords.lat,
              lng: state.customerCoords.lng,
              address:
                locationInputEl.value.trim() ||
                document.getElementById("addrCity").value.trim(),
            }
          : undefined,
        serviceId: state.selectedServiceId,
        technicianId: techEl.value,
        date: formatDateKey(state.selectedDate),
        startTime: minutesToHHMM(state.selectedStartMinutes),
        issueDescription: document
          .getElementById("issueDescription")
          .value.trim(),
        paymentMethod: "cod",
        cashPaymentMode: state.cashPaymentMode,

        downpaymentAmount: Number(
          document.getElementById("downpaymentAmount").value,
        ),
        travelFare: state.travelFare,
        travelTime: state.travelTime,
        estimatedFee: Number(
          (
            Number((svc && svc.basePrice) || 0) + Number(state.travelFare || 0)
          ).toFixed(2),
        ),
      };
      // auto-generate reference if not provided
      // always auto‑generate a reference (field removed from UI)
      payload.paymentReference = `OR-${Date.now()}`;

      saveBtn.disabled = true;
      saveBtn.innerHTML =
        '<span class="spinner-border spinner-border-sm me-1"></span>Creating…';

      try {
        const r = await fetch("/api/appointments/walk-in", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify(payload),
        });
        const d = await r.json();
        if (!r.ok)
          throw new Error(d.error || "Failed to create walk-in appointment");

        console.log("walk-in response customer", d.customer);
        const ref =
          (d.appointment && d.appointment.bookingReference) || "(no reference)";
        let accountMsg = "";
        let bookingMsg = "";
        
        if (d.customerAccountCreated && d.customer) {
          accountMsg = ` A new customer account was auto-created for <strong>${d.customer.email}</strong>. An auto-generated password and secure password reset link have been emailed to the customer.`;
          bookingMsg = ` Booking confirmation and appointment details have been sent to the customer's email.`;
        } else if (!d.customerAccountCreated && d.customer) {
          bookingMsg = ` Booking confirmation and appointment details have been sent to the existing customer's email at <strong>${d.customer.email}</strong>.`;
        }
        
        alertEl.innerHTML =
          `Walk-in appointment created successfully. Reference: <strong>${ref}</strong>.${accountMsg}${bookingMsg}`;
        alertEl.className = "alert alert-success";
        alertEl.classList.remove("d-none");

        form.reset();
        state.paymentMethod = "cod";
        state.cashPaymentMode = "downpayment";
        state.selectedDate = null;
        state.selectedStartMinutes = null;
        state.travelFare = 0;
        state.travelTime = 0;
        state.customerCoords = null;
        if (state.markers.customer && state.map) {
          state.map.removeLayer(state.markers.customer);
          state.markers.customer = null;
        }
        if (state.route && state.map) {
          state.map.removeLayer(state.route);
          state.route = null;
        }
        document
          .querySelectorAll(".payment-tab")
          .forEach((t) =>
            t.classList.toggle(
              "active",
              t.getAttribute("data-cash-mode") === "downpayment",
            ),
          );
        document.getElementById("payCod").value = "cod";
        serviceTypeEl.value = "core";
        document
          .querySelectorAll(".category-btn")
          .forEach((item) =>
            item.classList.toggle(
              "active",
              item.getAttribute("data-category") === "core",
            ),
          );
        state.selectedServiceId = "";
        locationInputEl.value = "";
        mapDistanceInfoEl.textContent =
          "Distance and ETA will appear here after setting location.";
        setLocationStatus(
          "Set customer location to compute travel fare and available slots.",
          "muted",
        );
        await renderCalendar();
        renderServiceCards();
        renderTechnicians();
        syncCashAmountInput();
        goToStep(0);
        updateSummary();
      } catch (err) {
        showAlert("danger", err.message || "Create failed");
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML =
          '<i class="bi bi-check2-circle me-1"></i>Create Walk-in Appointment';
      }
    });

    (async function init() {
      try {
        await loadFarePerKm();
        await loadOptions();
        await renderCalendar();
        syncCashAmountInput();
        goToStep(0);
      } catch (err) {
        showAlert(
          "danger",
          err.message || "Failed to initialize walk-in page.",
        );
      }
    })();
  })();
</script>
