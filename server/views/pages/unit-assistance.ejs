<link rel="stylesheet" href="/css/unit-assistance-customer.css?v=20261006-v1">

<div class="uac-page">
  <header class="uac-header">
    <div>
      <p class="uac-eyebrow">Your service requests</p>
      <h1>Aircon unit identification</h1>
      <p class="uac-subtitle">Track the details staff are checking and review your price before you choose a schedule.</p>
    </div>
    <div class="uac-header-actions">
      <a class="uac-button uac-button-light" href="/services"><i class="bi bi-grid" aria-hidden="true"></i> Browse services</a>
      <a class="uac-button uac-button-light" href="/book-history"><i class="bi bi-calendar-check" aria-hidden="true"></i> My bookings</a>
    </div>
  </header>

  <div class="uac-process" aria-label="How unit identification works">
    <div><span>1</span><p><strong>Staff checks your unit</strong><small>We confirm the type and HP.</small></p></div>
    <i class="bi bi-chevron-right" aria-hidden="true"></i>
    <div><span>2</span><p><strong>You review the price</strong><small>Accept or decline the verified quote.</small></p></div>
    <i class="bi bi-chevron-right" aria-hidden="true"></i>
    <div><span>3</span><p><strong>Continue your booking</strong><small>Choose a schedule or update an existing booking.</small></p></div>
  </div>

  <div id="unitRequestMessage" class="uac-alert" role="alert" hidden></div>
  <div id="unitRequestNotice" class="uac-notice" role="status" aria-live="polite" aria-atomic="true" hidden></div>

  <section class="uac-section" aria-labelledby="uacSectionTitle">
    <div class="uac-toolbar">
      <div>
        <h2 id="uacSectionTitle">Your requests</h2>
        <p id="unitRequestCount">Loading requests…</p>
      </div>
      <div class="uac-controls">
        <label for="unitRequestFilter">Show</label>
        <select id="unitRequestFilter" aria-label="Filter unit requests">
          <option value="all">All requests</option>
          <option value="action">Needs your action</option>
          <option value="progress">In progress</option>
          <option value="past">Past requests</option>
        </select>
        <button id="unitRequestRefresh" class="uac-button uac-button-light" type="button"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
      </div>
    </div>
    <div id="unitRequests" class="uac-list" aria-live="polite"><div class="uac-loading">Loading your requests…</div></div>
  </section>
</div>
<script src="/js/unit-assistance-customer.js?v=20261007-relocation" defer></script>
