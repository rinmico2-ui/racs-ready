        <button id="modalMarkSelectedRead" class="btn btn-sm text-primary" style="font-size: 0.75rem; padding: 4px 10px;" disabled>Mark selected</button>
      </div>
      <div class="d-flex gap-2">
        <button id="modalDeleteSelected" class="btn btn-sm text-danger" style="font-size: 0.75rem; padding: 4px 10px;" disabled>Delete selected</button>
        <button id="modalDeleteAll" class="btn btn-sm text-danger" style="font-size: 0.75rem; padding: 4px 10px;">Delete all</button>
      </div>
    </div>
  </div>
</div>

<style>
  .notif-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid #f1f5f9;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .notif-item:hover { background: #f8fafc; }
  .notif-item.unread { background: #eff6ff; }
  .notif-item.unread:hover { background: #dbeafe; }
  .notif-icon {
    width: 32px; height: 32px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem; flex-shrink: 0;
  }
  .notif-content { flex: 1; min-width: 0; }
  .notif-title { font-size: 0.8rem; font-weight: 600; color: #1e293b; margin-bottom: 1px; }
  .notif-msg { font-size: 0.75rem; color: #64748b; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .notif-time { font-size: 0.68rem; color: #94a3b8; margin-top: 2px; }
  .notif-dot { width: 6px; height: 6px; border-radius: 50%; background: #3b82f6; flex-shrink: 0; margin-top: 6px; }
  .notif-modal-item { display: flex; align-items: flex-start; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #f1f5f9; cursor: pointer; transition: background 0.15s ease; }
  .notif-modal-item:hover { background: #f8fafc; }
  .notif-modal-item.unread { background: #eff6ff; }
  .notif-modal-item.unread:hover { background: #dbeafe; }
  .notif-modal-item.hidden { display: none; }
  .notif-checkbox { width: 16px; height: 16px; cursor: pointer; margin-top: 8px; flex-shrink: 0; }

  /* Mobile responsive styles for notification panel */
  @media (max-width: 767px) {
    #notifPanel {
      right: -8px;
      left: auto;
      width: min(340px, 85vw);
      max-height: 70vh;
      top: calc(100% + 6px);
    }
    #notifList {
      max-height: calc(70vh - 100px);
    }
    .notif-item {
      padding: 10px 10px;
    }
    .notif-icon {
      width: 28px;
      height: 28px;
      font-size: 0.75rem;
    }
    .notif-title {
      font-size: 0.78rem;
    }
    .notif-msg {
      font-size: 0.72rem;
    }
    .notif-time {
      font-size: 0.65rem;
    }
  }

  @media (max-width: 480px) {
    #notifPanel {
      right: 0;
      left: auto;
      width: min(300px, 80vw);
      border-radius: 12px;
    }
    .notif-item {
      padding: 10px 12px;
    }
  }

  /* Mobile responsive styles for notification modal */
  @media (max-width: 767px) {
    #notifModal {
      padding: 8px;
      align-items: flex-end;
    }
    #notifModal > div {
      max-height: 85vh;
      border-radius: 14px 14px 0 0;
      max-width: 100%;
    }
    #notifModalList {
      max-height: calc(85vh - 180px);
    }
    .notif-modal-item {
      padding: 10px 12px;
      gap: 10px;
    }
    .notif-checkbox {
      width: 14px;
      height: 14px;
    }
    .notif-icon {
      width: 28px;
      height: 28px;
      font-size: 0.75rem;
    }
    .notif-title {
      font-size: 0.78rem;
    }
    .notif-msg {
      font-size: 0.72rem;
    }
    .notif-time {
      font-size: 0.65rem;
    }
  }

  @media (max-width: 480px) {
    #notifModal {
      padding: 0;
    }
    #notifModal > div {
      border-radius: 0;
      max-height: 100vh;
    }
    #notifModalList {
      max-height: calc(100vh - 200px);
    }
    .notif-modal-item {
      padding: 10px 12px;
    }
  }
</style>

<script>
  window.USER_ROLE = "<%= (user && user.role) || '' %>";

  (function() {
    const btn = document.getElementById('notifBtn');
    const panel = document.getElementById('notifPanel');
    const list = document.getElementById('notifList');
    const badge = document.getElementById('notifBadge');
    const markAllBtn = document.getElementById('markAllReadBtn');
    const deleteAllBtn = document.getElementById('deleteAllBtn');
    const viewAllBtn = document.getElementById('viewAllNotifBtn');
    const notifModal = document.getElementById('notifModal');
    const closeNotifModal = document.getElementById('closeNotifModal');
    const notifModalList = document.getElementById('notifModalList');
    const notifSearch = document.getElementById('notifSearch');
    const selectAllNotif = document.getElementById('selectAllNotif');
    const modalMarkAllRead = document.getElementById('modalMarkAllRead');
    const modalMarkSelectedRead = document.getElementById('modalMarkSelectedRead');
    const modalDeleteSelected = document.getElementById('modalDeleteSelected');
    const modalDeleteAll = document.getElementById('modalDeleteAll');
    let isOpen = false;
    let notifTimer = null;
    let allNotifications = [];
    let selectedIds = new Set();
    let currentPage = 1;
    let pageSize = 10;
    let filteredNotifications = [];

    // Toggle panel
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen = !isOpen;
      panel.classList.toggle('d-none', !isOpen);
      if (isOpen) {
        loadNotifications();
        btn.style.background = '#f1f5f9';
      } else {
        btn.style.background = 'transparent';
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!panel.contains(e.target) && !btn.contains(e.target)) {
        panel.classList.add('d-none');
        isOpen = false;
        btn.style.background = 'transparent';
      }
    });

    // Mark all read
    markAllBtn.addEventListener('click', async () => {
      try {
        await fetch('/api/notifications/read-all', { method: 'PUT', credentials: 'same-origin' });
        loadNotifications();
        loadUnreadCount();
      } catch (e) { console.error(e); }
    });

    // Delete all
    deleteAllBtn.addEventListener('click', async () => {
      if (!confirm('Delete all notifications? This cannot be undone.')) return;
      try {
        await fetch('/api/notifications/delete-all', { method: 'DELETE', credentials: 'same-origin' });
        loadNotifications();
        loadUnreadCount();
      } catch (e) { console.error(e); }
    });

    // Load notifications
    async function loadNotifications() {
      try {
        const res = await fetch('/api/notifications?limit=15', { credentials: 'same-origin' });
        const data = await res.json();
        if (!data.notifications || !data.notifications.length) {
          list.innerHTML = `<div class="text-center py-4 text-muted" style="font-size:0.85rem;"><i class="bi bi-bell-slash" style="font-size:1.5rem;"></i><div class="mt-1">No notifications</div></div>`;
          return;
        }
        list.innerHTML = data.notifications.map(n => {
          const iconMap = {
            booking_created: { icon: 'bi-calendar-plus', bg: '#dbeafe', color: '#2563eb' },
            booking_confirmed: { icon: 'bi-check-circle', bg: '#dcfce7', color: '#16a34a' },
            booking_cancelled: { icon: 'bi-x-circle', bg: '#fee2e2', color: '#dc2626' },
            booking_completed: { icon: 'bi-check2-circle', bg: '#dcfce7', color: '#16a34a' },
            booking_expired: { icon: 'bi-clock-history', bg: '#fef3c7', color: '#d97706' },
            payment_received: { icon: 'bi-cash-stack', bg: '#dcfce7', color: '#16a34a' },
            payment_verified: { icon: 'bi-shield-check', bg: '#dbeafe', color: '#2563eb' },
            assignment_new: { icon: 'bi-person-plus', bg: '#e0e7ff', color: '#6366f1' },
            assignment_accepted: { icon: 'bi-person-check', bg: '#dcfce7', color: '#16a34a' },
            assignment_declined: { icon: 'bi-person-x', bg: '#fee2e2', color: '#dc2626' },
            expense_submitted: { icon: 'bi-receipt', bg: '#fef3c7', color: '#d97706' },
            expense_approved: { icon: 'bi-check-circle', bg: '#dcfce7', color: '#16a34a' },
            expense_rejected: { icon: 'bi-x-circle', bg: '#fee2e2', color: '#dc2626' },
            leave_requested: { icon: 'bi-calendar-event', bg: '#fef3c7', color: '#d97706' },
            leave_approved: { icon: 'bi-check-circle-fill', bg: '#dcfce7', color: '#16a34a' },
            leave_rejected: { icon: 'bi-x-circle-fill', bg: '#fee2e2', color: '#dc2626' },
            review_submitted: { icon: 'bi-star', bg: '#fef3c7', color: '#d97706' },
            daily_kit_issue: { icon: 'bi-tools', bg: '#fef3c7', color: '#d97706' },
            booking_no_show: { icon: 'bi-person-x', bg: '#fee2e2', color: '#dc2626' },
            booking_waiting_customer: { icon: 'bi-hourglass-split', bg: '#fef3c7', color: '#d97706' },
            booking_no_show_report: { icon: 'bi-person-exclamation', bg: '#fee2e2', color: '#dc2626' },
            system: { icon: 'bi-gear', bg: '#f1f5f9', color: '#64748b' },
          };
          const ic = iconMap[n.type] || iconMap.system;
          const timeAgo = getTimeAgo(n.createdAt);
          const link = n.link ? `onclick="window.location.href='${n.link}'"` : '';
          return `<div class="notif-item ${n.read ? '' : 'unread'}" data-id="${n._id}" ${link}>
            ${n.read ? '' : '<div class="notif-dot"></div>'}
            <div class="notif-icon" style="background:${ic.bg};color:${ic.color};"><i class="bi ${ic.icon}"></i></div>
            <div class="notif-content">
              <div class="notif-title">${escapeHtml(n.title)}</div>
              <div class="notif-msg">${escapeHtml(n.message)}</div>
              <div class="notif-time">${timeAgo}</div>
            </div>
          </div>`;
        }).join('');

        // Click to mark as read
        list.querySelectorAll('.notif-item').forEach(el => {
          el.addEventListener('click', async () => {
            const id = el.dataset.id;
            if (el.classList.contains('unread')) {
              await fetch(`/api/notifications/${id}/read`, { method: 'PUT', credentials: 'same-origin' });
              el.classList.remove('unread');
              el.querySelector('.notif-dot')?.remove();
              loadUnreadCount();
            }
          });
        });
      } catch (e) { console.error('Failed to load notifications:', e); }
    }

    // Load unread count
    async function loadUnreadCount() {
      try {
        const res = await fetch('/api/notifications/unread-count', { credentials: 'same-origin' });
        const data = await res.json();
        const count = data.unreadCount || 0;
        if (count > 0) {
          badge.textContent = count > 999 ? '999+' : String(count);
          badge.classList.remove('d-none');
        } else {
          badge.classList.add('d-none');
        }
      } catch (e) {}
    }

    // Poll every 30 seconds
    loadUnreadCount();
    notifTimer = setInterval(loadUnreadCount, 30000);

    // Expose for Socket.io updates
    window._notifLoadUnreadCount = loadUnreadCount;
    window._notifLoadNotifications = loadNotifications;

    // ── Socket.io Real-time Notifications ──────────────────────────────────
    if (typeof io !== 'undefined') {
      const socket = io();
      socket.emit('admin:join', '<%= (user && user._id) ? user._id.toString() : "" %>');

      socket.on('notification:new', (data) => {
        // Refresh badge count
        loadUnreadCount();
        // If panel is open, refresh list
        if (isOpen) loadNotifications();
      });
    }

    // ── Full Notifications Modal ───────────────────────────────────────────
    function getVisibleNotifications() {
      const q = (notifSearch.value || '').toLowerCase();
      return allNotifications.filter(n =>
        (n.title || '').toLowerCase().includes(q) ||
        (n.message || '').toLowerCase().includes(q)
      );
    }

    function renderModalList(notifs) {
      const total = notifs.length;
      const totalPages = Math.max(1, Math.ceil(total / pageSize));
      if (currentPage > totalPages) currentPage = totalPages;
      const start = (currentPage - 1) * pageSize;
      const pageNotifs = notifs.slice(start, start + pageSize);

      renderPagination(total, currentPage);

      if (!pageNotifs.length) {
        notifModalList.innerHTML = `<div class="text-center py-5 text-muted" style="font-size:0.85rem;"><i class="bi bi-bell-slash" style="font-size:1.5rem;"></i><div class="mt-1">No notifications</div></div>`;
        return;
      }
      notifModalList.innerHTML = pageNotifs.map(n => {
        const iconMap = {
          booking_created: { icon: 'bi-calendar-plus', bg: '#dbeafe', color: '#2563eb' },
          booking_confirmed: { icon: 'bi-check-circle', bg: '#dcfce7', color: '#16a34a' },
          booking_cancelled: { icon: 'bi-x-circle', bg: '#fee2e2', color: '#dc2626' },
          booking_completed: { icon: 'bi-check2-circle', bg: '#dcfce7', color: '#16a34a' },
          booking_expired: { icon: 'bi-clock-history', bg: '#fef3c7', color: '#d97706' },
          payment_received: { icon: 'bi-cash-stack', bg: '#dcfce7', color: '#16a34a' },
          payment_verified: { icon: 'bi-shield-check', bg: '#dbeafe', color: '#2563eb' },
          assignment_new: { icon: 'bi-person-plus', bg: '#e0e7ff', color: '#6366f1' },
          assignment_accepted: { icon: 'bi-person-check', bg: '#dcfce7', color: '#16a34a' },
          assignment_declined: { icon: 'bi-person-x', bg: '#fee2e2', color: '#dc2626' },
          expense_submitted: { icon: 'bi-receipt', bg: '#fef3c7', color: '#d97706' },
          expense_approved: { icon: 'bi-check-circle', bg: '#dcfce7', color: '#16a34a' },
          expense_rejected: { icon: 'bi-x-circle', bg: '#fee2e2', color: '#dc2626' },
          leave_requested: { icon: 'bi-calendar-event', bg: '#fef3c7', color: '#d97706' },
          leave_approved: { icon: 'bi-check-circle-fill', bg: '#dcfce7', color: '#16a34a' },
          leave_rejected: { icon: 'bi-x-circle-fill', bg: '#fee2e2', color: '#dc2626' },
          review_submitted: { icon: 'bi-star', bg: '#fef3c7', color: '#d97706' },
          daily_kit_issue: { icon: 'bi-tools', bg: '#fef3c7', color: '#d97706' },
          booking_no_show: { icon: 'bi-person-x', bg: '#fee2e2', color: '#dc2626' },
          booking_waiting_customer: { icon: 'bi-hourglass-split', bg: '#fef3c7', color: '#d97706' },
          booking_no_show_report: { icon: 'bi-person-exclamation', bg: '#fee2e2', color: '#dc2626' },
          system: { icon: 'bi-gear', bg: '#f1f5f9', color: '#64748b' },
        };
        const ic = iconMap[n.type] || iconMap.system;
        const timeAgo = getTimeAgo(n.createdAt);
        const linkAttr = n.link ? `data-link="${escapeHtml(n.link)}"` : '';
        const checked = selectedIds.has(n._id) ? 'checked' : '';
        return `<div class="notif-modal-item ${n.read ? '' : 'unread'}" data-id="${n._id}" ${linkAttr}>
          <input type="checkbox" class="notif-checkbox" data-id="${n._id}" ${checked}>
          ${n.read ? '' : '<div class="notif-dot"></div>'}
          <div class="notif-icon" style="background:${ic.bg};color:${ic.color};"><i class="bi ${ic.icon}"></i></div>
          <div class="notif-content">
            <div class="notif-title">${escapeHtml(n.title)}</div>
            <div class="notif-msg">${escapeHtml(n.message)}</div>
            <div class="notif-time">${timeAgo}</div>
          </div>
        </div>`;
      }).join('');

      // Update select all checkbox state for the current page
      const pageIds = pageNotifs.map(n => n._id);
      const allSelected = pageIds.length > 0 && pageIds.every(id => selectedIds.has(id));
      selectAllNotif.checked = allSelected;
      selectAllNotif.indeterminate = !allSelected && pageIds.some(id => selectedIds.has(id));
      updateSelectedButtons();

      notifModalList.querySelectorAll('.notif-checkbox').forEach(cb => {
        cb.addEventListener('change', (e) => {
          e.stopPropagation();
          const id = cb.dataset.id;
          if (cb.checked) selectedIds.add(id);
          else selectedIds.delete(id);
          updateSelectedButtons();
          const pageIds2 = pageNotifs.map(n => n._id);
          const allSelected2 = pageIds2.length > 0 && pageIds2.every(id => selectedIds.has(id));
          selectAllNotif.checked = allSelected2;
          selectAllNotif.indeterminate = !allSelected2 && pageIds2.some(id => selectedIds.has(id));
        });
      });

      notifModalList.querySelectorAll('.notif-modal-item').forEach(el => {
        el.addEventListener('click', async (e) => {
          if (e.target.classList.contains('notif-checkbox')) return;
          const link = el.dataset.link;
          if (link) window.location.href = link;
          if (el.classList.contains('unread')) {
            const id = el.dataset.id;
            await fetch(`/api/notifications/${id}/read`, { method: 'PUT', credentials: 'same-origin' });
            el.classList.remove('unread');
            el.querySelector('.notif-dot')?.remove();
            loadUnreadCount();
          }
        });
      });
    }

    function updateSelectedButtons() {
      const hasSelected = selectedIds.size > 0;
      modalMarkSelectedRead.disabled = !hasSelected;
      modalDeleteSelected.disabled = !hasSelected;
    }

    function renderPagination(total, page) {
      const totalPages = Math.max(1, Math.ceil(total / pageSize));
      const paginationEl = document.getElementById('notifPagination');
      const pageNumbersEl = document.getElementById('notifPageNumbers');
      if (totalPages <= 1) {
        paginationEl.style.display = 'none';
        return;
      }
      paginationEl.style.display = 'flex';

      const prevBtn = document.getElementById('notifPrevPage');
      const nextBtn = document.getElementById('notifNextPage');
      prevBtn.disabled = page <= 1;
      nextBtn.disabled = page >= totalPages;

      let startPage = Math.max(1, page - 4);
      let endPage = Math.min(totalPages, startPage + 9);
      if (endPage - startPage < 9) {
        startPage = Math.max(1, endPage - 9);
      }

      let html = '';
      for (let i = startPage; i <= endPage; i++) {
        const active = i === page ? 'background:#2563eb;color:#fff;border-color:#2563eb;' : 'background:#fff;color:#64748b;border-color:#e2e8f0;';
        html += `<button class="notif-page-btn btn btn-sm" data-page="${i}" style="min-width:28px;font-size:0.7rem;padding:2px 6px;border:1px solid;${active}">${i}</button>`;
      }
      pageNumbersEl.innerHTML = html;

      pageNumbersEl.querySelectorAll('.notif-page-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentPage = parseInt(btn.dataset.page, 10);
          const visible = getVisibleNotifications();
          renderModalList(visible);
        });
      });
    }

    async function loadAllNotifications() {
      try {
        selectedIds.clear();
        const res = await fetch('/api/notifications?limit=200', { credentials: 'same-origin' });
        const data = await res.json();
        allNotifications = data.notifications || [];
        notifSearch.value = '';
        currentPage = 1;
        filteredNotifications = allNotifications;
        renderModalList(filteredNotifications);
      } catch (e) { console.error('Failed to load all notifications:', e); }
    }

    function filterNotifications(query) {
      const q = (query || '').toLowerCase();
      filteredNotifications = allNotifications.filter(n =>
        (n.title || '').toLowerCase().includes(q) ||
        (n.message || '').toLowerCase().includes(q)
      );
      currentPage = 1;
      renderModalList(filteredNotifications);
    }

    function openNotifModal() {
      // Close the dropdown panel first
      panel.classList.add('d-none');
      isOpen = false;
      btn.style.background = 'transparent';
      // Then open the modal
      notifModal.classList.remove('d-none');
      notifModal.style.display = 'flex';
      loadAllNotifications();
    }

    function closeNotifModalFn() {
      notifModal.classList.add('d-none');
      notifModal.style.display = 'none';
    }

    viewAllBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();
      openNotifModal();
    });

    closeNotifModal.addEventListener('click', (e) => {
      e.stopPropagation();
      closeNotifModalFn();
    });

    notifModal.addEventListener('click', (e) => {
      if (e.target === notifModal) {
        e.stopPropagation();
        closeNotifModalFn();
      }
    });

    notifSearch.addEventListener('input', () => {
      filterNotifications(notifSearch.value);
    });

    document.getElementById('notifPrevPage').addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderModalList(getVisibleNotifications());
      }
    });

    document.getElementById('notifNextPage').addEventListener('click', () => {
      const totalPages = Math.ceil(getVisibleNotifications().length / pageSize);
      if (currentPage < totalPages) {
        currentPage++;
        renderModalList(getVisibleNotifications());
      }
    });

    selectAllNotif.addEventListener('change', () => {
      const visible = getVisibleNotifications();
      if (selectAllNotif.checked) {
        visible.forEach(n => selectedIds.add(n._id));
      } else {
        visible.forEach(n => selectedIds.delete(n._id));
      }
      const visiblePage = getVisibleNotifications();
      renderModalList(visiblePage);
    });

    modalMarkAllRead.addEventListener('click', async () => {
      try {
        await fetch('/api/notifications/read-all', { method: 'PUT', credentials: 'same-origin' });
        allNotifications = allNotifications.map(n => ({ ...n, read: true }));
        renderModalList(allNotifications);
        loadNotifications();
        loadUnreadCount();
      } catch (e) { console.error(e); }
    });

    modalMarkSelectedRead.addEventListener('click', async () => {
      const ids = Array.from(selectedIds);
      if (!ids.length) return;
      try {
        await fetch('/api/notifications/read', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ids }), credentials: 'same-origin' });
        allNotifications = allNotifications.map(n => ids.includes(n._id) ? { ...n, read: true } : n);
        selectedIds.clear();
        filterNotifications(notifSearch.value);
        loadNotifications();
        loadUnreadCount();
      } catch (e) { console.error(e); }
    });

    modalDeleteSelected.addEventListener('click', async () => {
      const ids = Array.from(selectedIds);
      if (!ids.length) return;
      if (!confirm(`Delete ${ids.length} selected notification${ids.length > 1 ? 's' : ''}?`)) return;
      try {
        await fetch('/api/notifications/bulk-delete', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ids }), credentials: 'same-origin' });
        allNotifications = allNotifications.filter(n => !ids.includes(n._id));
        selectedIds.clear();
        filterNotifications(notifSearch.value);
        loadNotifications();
        loadUnreadCount();
      } catch (e) { console.error(e); }
    });

    modalDeleteAll.addEventListener('click', async () => {
      if (!confirm('Delete all notifications? This cannot be undone.')) return;
      try {
        await fetch('/api/notifications/delete-all', { method: 'DELETE', credentials: 'same-origin' });
        allNotifications = [];
        selectedIds.clear();
        renderModalList(allNotifications);
        loadNotifications();
        loadUnreadCount();
      } catch (e) { console.error(e); }
    });

    // Helpers
    function getTimeAgo(dateStr) {
      const diff = Date.now() - new Date(dateStr).getTime();
      const mins = Math.floor(diff / 60000);
      if (mins < 1) return 'Just now';
      if (mins < 60) return mins + 'm ago';
      const hrs = Math.floor(mins / 60);
      if (hrs < 24) return hrs + 'h ago';
      const days = Math.floor(hrs / 24);
      return days + 'd ago';
    }

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }
  })();
</script>
