            <button type="button" class="ent-btn-primary" data-next-step="1">
              <i class="bi bi-arrow-right"></i>Continue to Services
            </button>
          </div>
          </div>
        </div>

        <div class="booking-step d-none ent-step-card" data-step="1">
          <div class="ent-step-header">
            <div class="ent-step-icon step-services"><i class="bi bi-tools"></i></div>
            <div class="ent-step-info">
              <h5>Step 2</h5>
              <p>Select Services</p>
            </div>
