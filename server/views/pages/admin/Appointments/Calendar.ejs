  <script>
    document.addEventListener("DOMContentLoaded", function () {
      if (!window.FullCalendar || !window.FullCalendar.Calendar) {
        const host = document.getElementById("adminAppointmentsCalendar");
        if (host) host.innerHTML = '<div class="empty-state"><i class="bi bi-exclamation-triangle"></i>Calendar library failed to load. Please refresh.</div>';
        return;
      }

      const byId = (id) => document.getElementById(id);
      const dom = {
        calendarEl: byId("adminAppointmentsCalendar"),
        calendarRangeLabel: byId("calendarRangeLabel"),
        selectedDateLabel: byId("selectedDateLabel"),
        selectedDateSub: byId("selectedDateSub"),
        selectedDateCount: byId("selectedDateCount"),
        selectedDateList: byId("selectedDateList"),
        calendarSpinner: byId("calendarSpinner"),
        filterBar: byId("calFilterBar"),
        filterChips: byId("calFilterChips"),
        techTrigger: byId("techFilterTrigger"),
        techLabel: byId("techFilterLabel"),
        techCount: byId("techFilterCount"),
        techDropdown: byId("techFilterDropdown"),
        techSearchInput: byId("techSearchInput"),
        techOptions: byId("techOptions"),
        techSelectAll: byId("techSelectAll"),
        techSelectAllCheckbox: byId("techSelectAllCheckbox"),
        viewToggle: byId("viewToggle"),
        searchWrap: byId("calSearchWrap"),
        searchInput: byId("calSearchInput"),
        searchClear: byId("calSearchClear"),
        metricBookings: byId("calMetricBookings"),
        metricUnassigned: byId("calMetricUnassigned"),
        metricActive: byId("calMetricActive"),
        metricOrders: byId("calMetricOrders"),
      };

      const TECH_COLORS = [
        "#4F46E5", "#0EA5E9", "#10B981", "#F59E0B", "#EF4444",
        "#8B5CF6", "#EC4899", "#14B8A6", "#F97316", "#6366F1",
        "#06B6D4", "#84CC16", "#D946EF", "#22C55E", "#E11D48",
      ];

      const state = {
        appointments: [],
        orders: [],
        allAppointments: [],
        allOrders: [],
        selectedDateKey: toDateKey(new Date()),
        activeFilters: new Set(),
        showOrders: true,
        schedules: {},
        workingDaysMap: {},
        currentViewType: "dayGridMonth",
        technicians: [],
        selectedTechIds: [],
        technicianColorMap: {},
        query: "",
      };

      const STATUS_DEFS = [
        { key: "pending",              label: "Pending",             color: "#f59e0b" },
        { key: "payment_verified",     label: "Payment Verified",    color: "#2563eb" },
        { key: "awaiting_assignment",  label: "Awaiting Assignment", color: "#8b5cf6" },
        { key: "assigned",             label: "Assigned",            color: "#8b5cf6" },
        { key: "pending_reassignment", label: "Reassign",            color: "#8b5cf6" },
        { key: "confirmed",            label: "Confirmed",           color: "#0ea5e9" },
        { key: "scheduled",            label: "Scheduled",           color: "#6366f1" },
        { key: "on-the-way",           label: "On The Way",          color: "#3b82f6" },
        { key: "arrived",              label: "Arrived",             color: "#14b8a6" },
        { key: "in-progress",          label: "In Progress",         color: "#22c55e" },
        { key: "waiting-for-customer", label: "Waiting Customer",    color: "#d97706" },
        { key: "no-show-reported",     label: "No-Show Review",      color: "#dc2626" },
        { key: "no-show",              label: "No-Show",             color: "#b91c1c" },
        { key: "inspection_scheduled", label: "Inspection",          color: "#0891b2" },
        { key: "inspection_in_progress", label: "Inspecting",        color: "#0e7490" },
        { key: "repair_scheduled",     label: "Repair Scheduled",    color: "#7c3aed" },
        { key: "repair_in_progress",   label: "Repair Active",       color: "#16a34a" },
        { key: "waiting_parts",        label: "Waiting Parts",       color: "#ea580c" },
        { key: "completed",            label: "Completed",           color: "#16a34a" },
        { key: "repair_approved",      label: "Repair Approved",     color: "#059669" },
        { key: "rejected",             label: "Rejected",            color: "#dc2626" },
        { key: "cancelled",            label: "Cancelled",           color: "#6b7280" },
        { key: "expired",              label: "Expired",             color: "#d97706" },
      ];

      function getColor(status) {
        const s = String(status || "pending").toLowerCase();
        const found = STATUS_DEFS.find(d => d.key === s);
        return found ? found.color : "#475569";
      }

      function getTechColor(techId) {
        if (!techId) return "#94a3b8";
        const sid = String(techId);
        if (state.technicianColorMap[sid]) return state.technicianColorMap[sid];
        const idx = state.technicians.findIndex(t => String(t._id) === sid);
        if (idx >= 0) {
          const c = TECH_COLORS[idx % TECH_COLORS.length];
          state.technicianColorMap[sid] = c;
          return c;
        }
        return TECH_COLORS[0];
      }

      function toDateKey(input) { const d = new Date(input); return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0"); }
      function toPrettyDate(input) { return new Date(input).toLocaleDateString(undefined, { weekday:"long", year:"numeric", month:"long", day:"numeric" }); }
      function escHtml(value) { return String(value == null ? "" : value).replace(/[&<>"']/g, c => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" })[c]); }
      function prettyStatus(value) { return String(value || "pending").replace(/[_-]+/g, " ").replace(/\b\w/g, c => c.toUpperCase()); }
      function orderScheduledDate(order) { return order.fulfillmentType === "customer_pickup" ? order.pickupDate : order.delivery && order.delivery.preferredDate; }
      function parseTimeMinutes(value) {
        const match = String(value || "").trim().match(/^(\d{1,2}):(\d{2})\s*(AM|PM)?/i);
        if (!match) return null;
        let hours = Number(match[1]);
        const minutes = Number(match[2]);
        if (minutes > 59 || hours > 23) return null;
        if (match[3]) {
          const meridiem = match[3].toUpperCase();
          if (hours > 12 || hours === 0) return null;
          if (meridiem === "PM" && hours < 12) hours += 12;
          if (meridiem === "AM" && hours === 12) hours = 0;
        }
        return (hours * 60) + minutes;
      }
      function orderEventStart(order) {
        const base = new Date(orderScheduledDate(order));
        const minutes = parseTimeMinutes(order.timeSlot);
        if (minutes !== null) base.setHours(Math.floor(minutes / 60), minutes % 60, 0, 0);
        return base;
      }
      function orderTimeLabel(order) {
        const minutes = parseTimeMinutes(order.timeSlot);
        if (minutes === null) return order.timeSlot || "All day";
        const date = new Date();
        date.setHours(Math.floor(minutes / 60), minutes % 60, 0, 0);
        return date.toLocaleTimeString([], { hour:"numeric", minute:"2-digit" });
      }
      function appointmentTimeMinutes(appointment) {
        const raw = appointment && appointment.startTime;
        if (raw === undefined || raw === null || String(raw).trim() === "") return null;
        if (typeof raw === "number" && Number.isFinite(raw)) return raw;
        if (/^\d{1,4}$/.test(String(raw).trim())) {
          const minutes = Number(raw);
          return minutes >= 0 && minutes < 1440 ? minutes : null;
        }
        return parseTimeMinutes(raw);
      }
      function statusBadge(s) {
        if (s === "pending") return "warning";
        if (s === "payment_verified") return "primary";
        if (s === "awaiting_assignment" || s === "assigned" || s === "pending_reassignment") return "info";
        if (s === "confirmed") return "info";
        if (s === "scheduled") return "primary";
        if (s === "on-the-way") return "primary";
        if (s === "arrived") return "info";
        if (s === "in-progress") return "success";
        if (s === "completed") return "success";
        if (s === "rejected") return "danger";
        if (s === "cancelled") return "secondary";
        if (s === "expired") return "warning";
        return "secondary";
      }

      function serviceName(a) { return (a.service && typeof a.service === "string" && a.service) || (a.service && a.service.name) || (a.serviceId && a.serviceId.name) || (a.serviceId && a.serviceId.title) || (a.serviceModel === 'RepairService' || a.serviceType === 'repair' ? 'Repair Service' : null) || a.serviceType || "Service"; }
      function customerName(a) { return a.customerName || (a.customer && a.customer.name) || (a.customer && (a.customer.firstName||"")+" "+(a.customer.lastName||"")).trim() || a.customer || "Customer"; }
      function technicianName(a) { return a.technicianName || (a.technician && a.technician.name) || (a.technicianId && a.technicianId.name) || "Unassigned"; }
      function technicianId(a) { return (a.technicianId && (a.technicianId._id || a.technicianId)) || (a.technician && a.technician._id) || null; }

      function timeLabel(a) {
        const minutes = appointmentTimeMinutes(a);
        if (minutes === null) return "Time not set";
        const dt = new Date();
        dt.setHours(Math.floor(minutes / 60), minutes % 60, 0, 0);
        return dt.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
      }

      function eventStart(a) {
        const base = new Date(a.bookingDate || a.date || a.start || new Date());
        const minutes = appointmentTimeMinutes(a);
        if (minutes !== null) { const dt = new Date(base); dt.setHours(Math.floor(minutes / 60), minutes % 60, 0, 0); return dt; }
        return base;
      }

      function updateRangeLabel(viewTitle) {
        if (!dom.calendarRangeLabel) return;
        dom.calendarRangeLabel.textContent = viewTitle;
        dom.calendarRangeLabel.style.display = "inline-flex";
      }

      function matchesQuery(values) {
        if (!state.query) return true;
        return values.filter(Boolean).join(" ").toLowerCase().includes(state.query);
      }

      function appointmentMatchesQuery(appointment) {
        return matchesQuery([
          appointment.bookingReference, appointment.workOrderNumber, customerName(appointment),
          serviceName(appointment), technicianName(appointment), appointment.status,
        ]);
      }

      function orderMatchesQuery(order) {
        return matchesQuery([
          order.orderReference, order.customer && order.customer.name, order.customer && order.customer.phone,
          order.status, order.fulfillmentType, technicianName(order),
          ...(order.items || []).map(item => [item.brand, item.modelLine, item.capacity].filter(Boolean).join(" ")),
        ]);
      }

      function updateSummary() {
        const activeStatuses = new Set(["confirmed", "scheduled", "on-the-way", "arrived", "in-progress", "inspection_in_progress", "repair_in_progress"]);
        const unassigned = state.appointments.filter(item => !technicianId(item) && !["completed", "cancelled", "rejected", "expired"].includes(String(item.status || "").toLowerCase())).length;
        const active = state.appointments.filter(item => activeStatuses.has(String(item.status || "").toLowerCase())).length;
        if (dom.metricBookings) dom.metricBookings.textContent = Number(state.appointments.length).toLocaleString();
        if (dom.metricUnassigned) dom.metricUnassigned.textContent = Number(unassigned).toLocaleString();
        if (dom.metricActive) dom.metricActive.textContent = Number(active).toLocaleString();
        if (dom.metricOrders) dom.metricOrders.textContent = Number(state.showOrders ? state.orders.length : 0).toLocaleString();
      }

      function resetCalendarFilters() {
        state.activeFilters.clear();
        state.selectedTechIds = [];
        state.query = "";
        state.showOrders = true;
        if (dom.searchInput) dom.searchInput.value = "";
        if (dom.searchWrap) dom.searchWrap.classList.remove("has-value");
        updateTechFilterUI();
        buildTechDropdown();
        applyFilters();
        buildFilterBar();
      }

      /* ── Technician Filter ─────────────────────────────────────── */
      function techStatusClass(status) {
        if (!status || status === "Offline") return "offline";
        if (status === "Available") return "available";
        return "busy";
      }

      async function fetchTechnicians() {
        try {
          const res = await fetch("/api/admin/technicians", { credentials: "same-origin", cache: "no-store" });
          if (!res.ok) return [];
          const json = await res.json();
          return json.technicians || [];
        } catch (e) {
          console.error("Failed to fetch technicians:", e);
          return [];
        }
      }

      function buildTechDropdown() {
        if (!dom.techOptions) return;
        const allSelected = state.selectedTechIds.length === 0 || state.selectedTechIds.length === state.technicians.length;
        if (dom.techSelectAllCheckbox) dom.techSelectAllCheckbox.innerHTML = allSelected ? '<i class="bi bi-check"></i>' : '';
        if (dom.techSelectAll) dom.techSelectAll.classList.toggle("selected", allSelected);

        dom.techOptions.innerHTML = state.technicians.map(t => {
          const tid = String(t._id);
          const sel = state.selectedTechIds.length === 0 || state.selectedTechIds.includes(tid);
          const color = getTechColor(tid);
          return `<div class="tech-option ${sel ? 'selected' : ''}" data-tech-id="${escHtml(tid)}">
            <span class="tech-checkbox">${sel ? '<i class="bi bi-check"></i>' : ''}</span>
            <span class="tech-color-dot" style="background:${color};color:${color};"></span>
            <span class="tech-name">${escHtml(t.name || t.userEmail || "Unknown")}</span>
            <span class="tech-status-dot ${techStatusClass(t.availabilityStatus)}"></span>
          </div>`;
        }).join("");

        dom.techOptions.querySelectorAll(".tech-option").forEach(el => {
          el.addEventListener("click", () => {
            const tid = el.dataset.techId;
            const idx = state.selectedTechIds.indexOf(tid);
            if (idx >= 0) state.selectedTechIds.splice(idx, 1);
            else state.selectedTechIds.push(tid);
            if (state.selectedTechIds.length === state.technicians.length) state.selectedTechIds = [];
            updateTechFilterUI();
            applyFilters();
            buildTechDropdown();
          });
        });
      }

      function updateTechFilterUI() {
        const count = state.selectedTechIds.length;
        if (count === 0 || count === state.technicians.length) {
          if (dom.techLabel) dom.techLabel.textContent = "All Technicians";
          if (dom.techCount) dom.techCount.style.display = "none";
        } else {
          const names = state.technicians.filter(t => state.selectedTechIds.includes(String(t._id))).map(t => t.name);
          const label = names.slice(0, 2).join(", ") + (count > 2 ? ` +${count-2}` : "");
          if (dom.techLabel) dom.techLabel.textContent = label;
          if (dom.techCount) { dom.techCount.textContent = String(count); dom.techCount.style.display = "inline-flex"; }
        }
      }

      function toggleTechDropdown(e) {
        if (!e) return;
        e.stopPropagation();
        if (!dom.techDropdown || !dom.techTrigger) return;
        const isOpen = dom.techDropdown.classList.toggle("open");
        dom.techTrigger.classList.toggle("active", isOpen);
        if (isOpen && dom.techSearchInput) setTimeout(() => dom.techSearchInput.focus(), 50);
      }

      /* ── Working Hours ──────────────────────────────────────────── */
      function minutesToTimeStr(minutes) {
        const h = Math.floor(minutes / 60);
        const m = minutes % 60;
        return h.toString().padStart(2,"0")+":"+m.toString().padStart(2,"0")+":00";
      }

      async function fetchTechnicianSchedules() {
        try {
          const res = await fetch("/api/admin/technician-schedules", { credentials: "same-origin", cache: "no-store" });
          if (!res.ok) return {};
          const json = await res.json();
          const schedules = json.schedules || json || [];
          const map = {};
          (Array.isArray(schedules) ? schedules : []).forEach(s => {
            const techId = s.technicianId?._id || s.technicianId;
            if (techId) map[String(techId)] = s;
          });
          return map;
        } catch (e) {
          console.error("Failed to fetch technician schedules:", e);
          return {};
        }
      }

      function computeWorkingDaysMap(schedules) {
        const dayMap = {};
        Object.values(schedules).forEach(schedule => {
          (schedule.workingDays || []).forEach(wd => {
            if (!dayMap[wd.dayOfWeek]) dayMap[wd.dayOfWeek] = [];
            dayMap[wd.dayOfWeek].push({
              startMinutes: wd.startMinutes || 480,
              endMinutes: wd.endMinutes || 1020,
            });
          });
        });
        return dayMap;
      }

      function getWorkingHoursForDate(dateStr) {
        const d = new Date(dateStr + "T12:00:00");
        const dayOfWeek = d.getDay();
        const entries = state.workingDaysMap[dayOfWeek] || [];
        if (entries.length === 0) return null;
        let earliest = 9999;
        let latest = 0;
        entries.forEach(e => {
          if (e.startMinutes < earliest) earliest = e.startMinutes;
          if (e.endMinutes > latest) latest = e.endMinutes;
        });
        return {
          startMinutes: earliest,
          endMinutes: latest,
          startStr: minutesToTimeStr(earliest),
          endStr: minutesToTimeStr(latest),
          techCount: entries.length,
        };
      }

      function updateTimeGridHours(viewType, focusDate) {
        if (viewType !== "timeGridWeek" && viewType !== "timeGridDay") return;
        let minStart = 9999;
        let maxEnd = 0;
        if (viewType === "timeGridDay") {
          const key = toDateKey(focusDate);
          const hours = getWorkingHoursForDate(key);
          if (hours) { minStart = hours.startMinutes; maxEnd = hours.endMinutes; }
        } else {
          const startOfWeek = new Date(focusDate);
          startOfWeek.setDate(startOfWeek.getDate() - startOfWeek.getDay());
          for (let i = 0; i < 7; i++) {
            const d = new Date(startOfWeek);
            d.setDate(d.getDate() + i);
            const key = toDateKey(d);
            const hours = getWorkingHoursForDate(key);
            if (hours) {
              if (hours.startMinutes < minStart) minStart = hours.startMinutes;
              if (hours.endMinutes > maxEnd) maxEnd = hours.endMinutes;
            }
          }
        }
        if (minStart < 9999) minStart = Math.max(0, minStart - 30);
        else minStart = 420;
        if (maxEnd > 0) maxEnd = Math.min(1440, maxEnd + 30);
        else maxEnd = 1110;
        calendar.setOption("slotMinTime", minutesToTimeStr(minStart));
        calendar.setOption("slotMaxTime", minutesToTimeStr(maxEnd));
      }

      /* ── Filter Bar ─────────────────────────────────────────────── */
      function buildFilterBar() {
        if (!dom.filterChips) return;
        const counts = {};
        state.allAppointments.forEach(a => { const s = String(a.status || "pending").toLowerCase(); counts[s] = (counts[s] || 0) + 1; });
        const orderCount = state.allOrders.length;

        let html = '<span class="filter-label">Filter</span>';
        STATUS_DEFS.forEach(def => {
          const count = counts[def.key] || 0;
          if (count === 0 && !state.activeFilters.has(def.key)) return;
          html += `<button class="cal-filter-chip ${state.activeFilters.has(def.key) ? 'active' : ''}" data-status="${def.key}"><span class="chip-dot" style="background:${def.color};"></span>${def.label}<span class="chip-count">${count}</span></button>`;
        });

        html += `<div class="cal-filter-divider"></div>`;
        html += `<button class="cal-filter-chip ${state.showOrders ? 'active' : ''}" id="calToggleOrders"><i class="bi bi-truck"></i> Orders<span class="chip-count">${orderCount}</span></button>`;

        const hasFilters = state.activeFilters.size > 0 || state.selectedTechIds.length > 0 || Boolean(state.query) || !state.showOrders;
        if (hasFilters) html += `<div class="cal-filter-divider"></div><button class="cal-clear-filters" id="calClearFilters"><i class="bi bi-x-circle me-1"></i>Reset all</button>`;
        html += `<span class="cal-filter-summary"><i class="bi bi-eye"></i>${state.appointments.length + (state.showOrders ? state.orders.length : 0)} visible</span>`;

        if (state.currentViewType === "timeGridWeek" || state.currentViewType === "timeGridDay") {
          const focusDate = calendar.getDate ? calendar.getDate() : new Date();
          const key = toDateKey(focusDate);
          const hours = getWorkingHoursForDate(key);
          if (hours) {
            const startTime = minutesToTimeStr(hours.startMinutes).slice(0,5);
            const endTime = minutesToTimeStr(hours.endMinutes).slice(0,5);
            html += `<div class="cal-hours-badge"><i class="bi bi-clock-history"></i>Hours: ${startTime} \u2013 ${endTime} (${hours.techCount} tech${hours.techCount !== 1 ? 's' : ''})</div>`;
          } else {
            html += `<div class="cal-hours-badge off-hours"><i class="bi bi-pause-circle"></i>Non-working day</div>`;
          }
        }

        dom.filterChips.innerHTML = html;

        dom.filterChips.querySelectorAll('.cal-filter-chip[data-status]').forEach(chip => {
          chip.addEventListener('click', () => { const s = chip.dataset.status; if (state.activeFilters.has(s)) state.activeFilters.delete(s); else state.activeFilters.add(s); applyFilters(); buildFilterBar(); });
        });
        const toggleOrdersBtn = dom.filterChips.querySelector('#calToggleOrders');
        if (toggleOrdersBtn) toggleOrdersBtn.addEventListener('click', () => { state.showOrders = !state.showOrders; applyFilters(); buildFilterBar(); });
        const clearBtn = dom.filterChips.querySelector('#calClearFilters');
        if (clearBtn) clearBtn.addEventListener('click', resetCalendarFilters);
      }

      function applyFilters() {
        let filtered = state.allAppointments.filter(appointmentMatchesQuery);
        let filteredOrders = state.allOrders.filter(orderMatchesQuery);

        if (state.activeFilters.size > 0) {
          filtered = filtered.filter(a => {
            const s = String(a.status || "pending").toLowerCase();
            if (state.activeFilters.has("awaiting_assignment") && (s === "awaiting_assignment" || s === "assigned" || s === "pending_reassignment")) return true;
            return state.activeFilters.has(s);
          });
        }

        if (state.selectedTechIds.length > 0 && state.selectedTechIds.length < state.technicians.length) {
          filtered = filtered.filter(a => {
            const tid = technicianId(a);
            return tid && state.selectedTechIds.includes(String(tid));
          });
          filteredOrders = filteredOrders.filter(order => {
            const tid = technicianId(order);
            return tid && state.selectedTechIds.includes(String(tid));
          });
        }

        state.appointments = filtered;
        state.orders = filteredOrders;
        calendar.removeAllEvents();

        // Add appointment events
        if (filtered.length > 0) {
          calendar.addEventSource(filtered.map(a => {
            const id = String(a._id || a.id || "");
            const s = String(a.status || "pending").toLowerCase();
            const tid = technicianId(a);
            const techColor = tid ? getTechColor(tid) : null;
            const hasTime = appointmentTimeMinutes(a) !== null;
            return {
              id: "appt-" + id,
              title: customerName(a) + " \u2022 " + serviceName(a),
              start: eventStart(a),
              allDay: !hasTime,
              color: techColor || getColor(s),
              classNames: [s, tid ? "tech-"+String(tid) : ""].filter(Boolean),
              extendedProps: { raw: a, type: "appointment" },
            };
          }));
        }

        // Add order/delivery events
        if (state.showOrders && filteredOrders.length > 0) {
          calendar.addEventSource(filteredOrders.map(o => {
            const id = String(o._id || "");
            const s = "order-" + (o.status || "pending_payment");
            const prefDate = orderScheduledDate(o);
            if (!prefDate) return null;
            const start = orderEventStart(o);
            const cust = (o.customer && o.customer.name) || "Customer";
            const items = (o.items || []).map(it => (it.modelLine || "Aircon") + " " + (it.capacity || "")).join(", ");
            const hasTime = parseTimeMinutes(o.timeSlot) !== null;
            return {
              id: "order-" + id,
              title: cust + " \u2022 " + items.substring(0, 30),
              start,
              allDay: !hasTime,
              display: "block",
              classNames: [s, "order-event"],
              extendedProps: { raw: o, type: "order" },
            };
          }).filter(Boolean));
        }

        updateSummary();
        renderDateList();
      }

      /* ── Sidebar List ───────────────────────────────────────────── */
      function renderDateList() {
        const dayItems = state.appointments.filter(a => toDateKey(a.bookingDate || a.date || a.start || new Date()) === state.selectedDateKey).sort((a, b) => eventStart(a).getTime() - eventStart(b).getTime());
        const orderItems = state.showOrders ? state.orders.filter(o => {
          const d = orderScheduledDate(o);
          return d && toDateKey(d) === state.selectedDateKey;
        }).sort((a, b) => orderEventStart(a).getTime() - orderEventStart(b).getTime()) : [];
        const totalItems = dayItems.length + orderItems.length;

        dom.selectedDateLabel.textContent = toPrettyDate(state.selectedDateKey);
        dom.selectedDateSub.textContent = totalItems > 0 ? "Bookings and orders scheduled for this date" : "No scheduled work for this date";
        dom.selectedDateCount.textContent = String(totalItems);

        if (!totalItems) { dom.selectedDateList.innerHTML = '<div class="empty-state"><i class="bi bi-calendar-x"></i>No bookings or orders for this date.</div>'; return; }

        let html = '';
        // Appointment items
        dayItems.forEach(a => {
          const id = a._id || a.id || "";
          const s = String(a.status || "pending").toLowerCase();
          const tid = technicianId(a);
          const tname = technicianName(a);
          const tcolor = tid ? getTechColor(tid) : "#94a3b8";
          html += `<article class="appt-item" data-id="${escHtml(id)}" data-type="appt"><div class="appt-marker" style="background:${getColor(s)}"></div><div class="appt-body" onclick="openCalDetail('${escHtml(id)}','appt')"><div class="appt-row1"><span class="appt-time">${escHtml(timeLabel(a))}</span><span class="appt-name">${escHtml(customerName(a))}</span><span class="appt-status-label">${escHtml(prettyStatus(s))}</span></div><div class="appt-row2"><span>${escHtml(serviceName(a))}</span><span class="appt-sep">&middot;</span><span><span class="tdot" style="background:${tcolor}"></span>${escHtml(tname)}</span><span class="appt-sep">&middot;</span><span>${escHtml(a.bookingReference || a.workOrderNumber || "\u2014")}</span></div></div><button class="appt-chevron" onclick="event.stopPropagation(); openCalDetail('${escHtml(id)}','appt')" title="View details" aria-label="View ${escHtml(customerName(a))} booking"><i class="bi bi-chevron-right"></i></button></article>`;
        });
        // Order items
        orderItems.forEach(o => {
          const id = o._id || "";
          const oRef = o.orderReference || '#' + id.toString().slice(-8).toUpperCase();
          const cust = (o.customer && o.customer.name) || "Customer";
          const items = (o.items || []).map(it => (it.modelLine || "Aircon") + " " + (it.capacity || "") + (it.capacityUnit || "HP")).join(", ");
          const fulfillLabel = ({ delivery_only: "Delivery Only", delivery_installation: "Delivery + Install", customer_pickup: "Customer Pickup" })[o.fulfillmentType] || o.fulfillmentType;
          const tech = (o.technician && o.technician.name) || "Unassigned";
          const orderIcon = o.fulfillmentType === "customer_pickup" ? "bi-bag-check" : o.fulfillmentType === "delivery_installation" ? "bi-tools" : "bi-truck";
          html += `<article class="appt-item order-item" data-id="${escHtml(id)}" data-type="order"><div class="appt-marker" style="background:#f97316"></div><div class="appt-body" onclick="openCalDetail('${escHtml(id)}','order')"><div class="appt-row1"><span class="appt-time">${escHtml(orderTimeLabel(o))}</span><span class="appt-type-badge"><i class="bi ${orderIcon}"></i>Order</span><span class="appt-name">${escHtml(cust)}</span><span class="appt-status-label">${escHtml(prettyStatus(o.status))}</span></div><div class="appt-row2"><span>${escHtml(fulfillLabel)}</span><span class="appt-sep">&middot;</span><span>${escHtml(items.substring(0, 36))}</span><span class="appt-sep">&middot;</span><span>${escHtml(tech)}</span><span class="appt-sep">&middot;</span><span>${escHtml(oRef)}</span></div></div><button class="appt-chevron" onclick="event.stopPropagation(); openCalDetail('${escHtml(id)}','order')" title="View details" aria-label="View ${escHtml(cust)} order"><i class="bi bi-chevron-right"></i></button></article>`;
        });

        dom.selectedDateList.innerHTML = html;
      }

      /* ── Detail Modal ───────────────────────────────────────────── */
      window.openCalDetail = async function(id, type) {
        try {
          const isOrder = type === 'order';
          const openRecord = document.getElementById("calDetailOpenRecord");
          const detailSubtitle = document.getElementById("calDetailSubtitle");
          if (openRecord) openRecord.href = isOrder ? "/admin/orders?order=" + encodeURIComponent(id) : "/admin/appointments?sel=" + encodeURIComponent(id);
          if (detailSubtitle) detailSubtitle.textContent = isOrder ? "Order fulfillment schedule" : "Service booking schedule";
          if (isOrder) {
            const res = await fetch("/api/orders/" + id);
            if (!res.ok) throw new Error("Failed to fetch order");
            const data = await res.json();
            const o = data.order;
            const oRef = o.orderReference || '#' + o._id.toString().slice(-8).toUpperCase();
            const scheduledDate = orderScheduledDate(o);
            const date = scheduledDate ? new Date(scheduledDate).toLocaleDateString("en-US", { weekday:"long", year:"numeric", month:"long", day:"numeric" }) : "—";
            const stLabel = (o.status || "pending_payment").replace(/_/g, " ").replace(/\b\w/g, l => l.toUpperCase());
            const stColor = o.status === "completed" ? "success" : o.status === "cancelled" ? "danger" : o.status === "out_for_delivery" || o.status === "arrived" ? "info" : o.status === "installing" ? "primary" : "warning";
            document.getElementById("calDetailTitle").textContent = "Order " + oRef;
            const items = (o.items || []).map(it => '<div class="pm-row"><span class="pm-lbl">' + (it.modelLine || "Aircon") + ' ' + (it.capacity || "") + (it.capacityUnit || "HP") + ' × ' + (it.quantity || 1) + '</span><span class="pm-val">₱' + Number(it.totalPrice || 0).toLocaleString() + '</span></div>').join('');
            const fulfillLabel = ({ delivery_only: "Delivery Only", delivery_installation: "Delivery + Install", customer_pickup: "Customer Pickup" })[o.fulfillmentType] || o.fulfillmentType;
            const techHtml = o.technician && o.technician.name ? '<div class="ent-detail-card"><div class="ent-detail-card-icon bg-info-subtle"><i class="bi bi-person-badge text-info"></i></div><div class="ent-detail-card-content"><span class="ent-detail-label">Technician</span><span class="ent-detail-value">' + o.technician.name + '</span><span class="ent-detail-sub">' + (o.technician.phone || "—") + '</span></div></div>' : '';
            const timeline = (o.statusHistory || []).slice(-5).map(h => '<div class="ent-timeline-item"><span class="ent-timeline-dot current"></span><span class="ent-timeline-text"><strong>' + (h.status || "").replace(/_/g, " ").replace(/\b\w/g, l => l.toUpperCase()) + '</strong> — ' + new Date(h.timestamp || new Date()).toLocaleString() + (h.note ? '<br><small>' + h.note + '</small>' : '') + '</span></div>').join('') || '<div class="ent-timeline-item"><span class="ent-timeline-dot"></span><span class="ent-timeline-text">No history</span></div>';
            document.getElementById("calDetailBody").innerHTML =
              '<div class="ent-status-bar"><span class="badge bg-' + stColor + ' status-badge"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>' + stLabel + '</span><span class="ref-no"><i class="bi bi-receipt me-1"></i>' + oRef + '</span></div>' +
              '<div class="ent-detail-grid">' +
                '<div class="ent-detail-card"><div class="ent-detail-card-icon bg-primary-subtle"><i class="bi bi-person-fill text-primary"></i></div><div class="ent-detail-card-content"><span class="ent-detail-label">Customer</span><span class="ent-detail-value">' + (o.customer?.name || "N/A") + '</span><span class="ent-detail-sub">' + (o.customer?.phone || "") + '</span><span class="ent-detail-sub">' + (o.customer?.email || "") + '</span></div></div>' +
                '<div class="ent-detail-card"><div class="ent-detail-card-icon bg-success-subtle"><i class="bi bi-box-seam text-success"></i></div><div class="ent-detail-card-content"><span class="ent-detail-label">Fulfillment</span><span class="ent-detail-value">' + fulfillLabel + '</span><span class="ent-detail-sub">' + date + '</span></div></div>' +
                (techHtml) +
                '<div class="ent-detail-card"><div class="ent-detail-card-icon bg-warning-subtle"><i class="bi bi-cash-stack text-warning"></i></div><div class="ent-detail-card-content"><span class="ent-detail-label">Payment</span><span class="ent-detail-value fw-bold">₱' + (o.total || 0).toLocaleString() + '</span><span class="ent-detail-sub">' + (o.paymentMethod || "cod").toUpperCase() + ' · ' + (o.paymentStatus || "pending") + '</span></div></div>' +
                '<div class="ent-detail-card ent-detail-card-wide"><div class="ent-detail-card-icon bg-secondary-subtle"><i class="bi bi-geo-alt-fill text-secondary"></i></div><div class="ent-detail-card-content"><span class="ent-detail-label">Delivery Address</span><span class="ent-detail-value">' + ((o.delivery && o.delivery.address) || "Customer Pickup") + '</span></div></div>' +
              '</div>' +
              '<div style="margin-top:14px;" class="ent-items-box"><h6><i class="bi bi-box me-1"></i>Items</h6>' + items + '</div>' +
              '<div class="ent-timeline"><h6><i class="bi bi-clock-history me-1"></i>Status Timeline</h6>' + timeline + '</div>';
            new bootstrap.Modal(document.getElementById("calDetailModal")).show();
          } else {
            const res = await fetch("/api/admin/appointments/" + id);
            if (!res.ok) throw new Error("Failed to fetch");
            const data = await res.json();
            const b = data.booking;
            const date = new Date(b.bookingDate).toLocaleDateString("en-US", { weekday:"long", year:"numeric", month:"long", day:"numeric" });
            const stLabel = (b.status || "pending").replace(/-/g, " ").replace(/\b\w/g, l => l.toUpperCase());
            const stColor = b.status === "completed" ? "success" : b.status === "confirmed" ? "primary" : b.status === "cancelled" || b.status === "rejected" ? "danger" : b.status === "in-progress" ? "success" : "warning";
            document.getElementById("calDetailTitle").textContent = "Appointment " + (b.bookingReference || b.workOrderNumber || "#" + b._id.toString().slice(-8).toUpperCase());
            const techIdStr = technicianId(b);
            const techCol = techIdStr ? getTechColor(techIdStr) : "#94a3b8";
            const timeline = (b.statusHistory || []).slice(-5).map(h => `<div class="ent-timeline-item"><span class="ent-timeline-dot current"></span><span class="ent-timeline-text"><strong>${(h.status || "").replace(/-/g, " ").replace(/\b\w/g, l => l.toUpperCase())}</strong> — ${new Date(h.timestamp || h.date || new Date()).toLocaleString()}</span></div>`).join("") || '<div class="ent-timeline-item"><span class="ent-timeline-dot"></span><span class="ent-timeline-text">No history available</span></div>';
            document.getElementById("calDetailBody").innerHTML =
              '<div class="ent-status-bar"><span class="badge bg-' + stColor + ' status-badge"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>' + stLabel + '</span><span class="ref-no"><i class="bi bi-receipt me-1"></i>' + (b.bookingReference || b.workOrderNumber || "#" + b._id.toString().slice(-8).toUpperCase()) + '</span></div>' +
              '<div class="ent-detail-grid">' +
                '<div class="ent-detail-card"><div class="ent-detail-card-icon bg-primary-subtle"><i class="bi bi-person-fill text-primary"></i></div><div class="ent-detail-card-content"><span class="ent-detail-label">Customer</span><span class="ent-detail-value">' + (b.customer?.name || "N/A") + '</span><span class="ent-detail-sub">' + (b.customer?.phone || "") + '</span><span class="ent-detail-sub">' + (b.customer?.email || "") + '</span></div></div>' +
                '<div class="ent-detail-card"><div class="ent-detail-card-icon bg-success-subtle"><i class="bi bi-tools text-success"></i></div><div class="ent-detail-card-content"><span class="ent-detail-label">Service</span><span class="ent-detail-value">' + (b.service?.name || (b.services?.map(s => s.name).join(", ")) || (b.serviceModel === 'RepairService' || b.serviceType === 'repair' ? 'Repair Service' : 'N/A')) + '</span><span class="ent-detail-sub">' + date + '</span><span class="ent-detail-sub">' + (b.startTime || "") + " - " + (b.endTime || "") + '</span></div></div>' +
                '<div class="ent-detail-card"><div class="ent-detail-card-icon bg-info-subtle"><i class="bi bi-person-badge text-info"></i></div><div class="ent-detail-card-content"><span class="ent-detail-label">Technician</span><span class="ent-detail-value" style="color:' + techCol + ';">' + (b.technician?.name || "Unassigned") + '</span><span class="ent-detail-sub">' + (b.technician?.phone || "\u2014") + '</span></div></div>' +
                '<div class="ent-detail-card"><div class="ent-detail-card-icon bg-warning-subtle"><i class="bi bi-cash-stack text-warning"></i></div><div class="ent-detail-card-content"><span class="ent-detail-label">Payment</span><span class="ent-detail-value fw-bold">\u20B1' + ((b.totalPrice || b.estimatedFee || 0)).toLocaleString() + '</span><span class="ent-detail-sub">' + (b.paymentMethod || "cod").toUpperCase() + " \u00B7 " + (b.paymentStatus || "pending") + '</span></div></div>' +
                '<div class="ent-detail-card ent-detail-card-wide"><div class="ent-detail-card-icon bg-secondary-subtle"><i class="bi bi-geo-alt-fill text-secondary"></i></div><div class="ent-detail-card-content"><span class="ent-detail-label">Location</span><span class="ent-detail-value">' + (b.location?.address || b.customer?.address || "\u2014") + '</span></div></div>' +
              '</div>' +
              '<div class="ent-timeline"><h6><i class="bi bi-clock-history me-1"></i>Status Timeline</h6>' + timeline + '</div>';
            new bootstrap.Modal(document.getElementById("calDetailModal")).show();
          }
        } catch (e) {
          console.error(e);
          window.location.href = type === "order"
            ? "/admin/orders?order=" + encodeURIComponent(id)
            : "/admin/appointments?sel=" + encodeURIComponent(id);
        }
      };

      /* ── Fetch Data ─────────────────────────────────────────────── */
      async function fetchAppointmentsForRange(start, end) {
        const params = new URLSearchParams({ limit: "2000", start, end });
        const res = await fetch("/api/appointments?" + params.toString(), { credentials: "same-origin", cache: "no-store" });
        if (!res.ok) throw new Error("appointments fetch failed: " + res.status);
        const json = await res.json();
        return json.items || json.appointments || [];
      }

      async function fetchOrdersForRange(start, end) {
        const params = new URLSearchParams({ limit: "100", page: "1", scheduledFrom: start, scheduledTo: end });
        const firstResponse = await fetch("/api/orders/all?" + params.toString(), { credentials: "same-origin", cache: "no-store" });
        if (!firstResponse.ok) throw new Error("orders fetch failed: " + firstResponse.status);
        const firstPage = await firstResponse.json();
        const orders = [...(firstPage.orders || [])];
        const pages = Math.max(1, Number(firstPage.pages) || 1);
        if (pages > 1) {
          const requests = [];
          for (let page = 2; page <= pages; page += 1) {
            const nextParams = new URLSearchParams(params);
            nextParams.set("page", String(page));
            requests.push(fetch("/api/orders/all?" + nextParams.toString(), { credentials: "same-origin", cache: "no-store" }).then(response => response.ok ? response.json() : { orders: [] }));
          }
          const remainingPages = await Promise.all(requests);
          remainingPages.forEach(result => orders.push(...(result.orders || [])));
        }
        return orders;
      }

      /* ── Calendar Init ──────────────────────────────────────────── */
      const initView = window.innerWidth < 600 ? "listWeek" : "dayGridMonth";
      const calendar = new FullCalendar.Calendar(dom.calendarEl, {
        initialView: initView,
        headerToolbar: { left: "prev,next today", center: "", right: "" },
        buttonText: { today: "Today", month: "Month", week: "Week", day: "Day", list: "List" },
        height: "auto",
        slotMinTime: "06:00:00",
        slotMaxTime: "20:00:00",
        slotDuration: "01:00:00",
        slotLabelInterval: "01:00",
        slotLabelFormat: { hour: "numeric", minute: "2-digit", hour12: true, meridiem: "short" },
        eventMinHeight: 70,
        allDaySlot: true,
        allDayText: "Unscheduled",
        dayMaxEvents: 4,
        moreLinkContent: args => "+" + args.num + " more",
        eventTimeFormat: { hour: "2-digit", minute: "2-digit", hour12: true },

        dayCellClassNames(info) { return toDateKey(info.date) === state.selectedDateKey ? ["cal-selected-day"] : []; },
        dateClick(info) { state.selectedDateKey = toDateKey(info.date); calendar.rerenderDates(); renderDateList(); },
        eventClick(info) {
          state.selectedDateKey = toDateKey(info.event.start || new Date());
          calendar.rerenderDates();
          renderDateList();
          const id = info.event.id;
          const type = info.event.extendedProps.type || 'appt';
          if (id) {
            const cleanId = id.replace(/^(appt-|order-)/, '');
            openCalDetail(cleanId, type);
          }
        },
        eventContent(arg) {
          const raw = arg.event.extendedProps.raw;
          if (!raw) return { html: '<span class="event-time">' + (arg.timeText || "") + '</span>' };
          const type = arg.event.extendedProps.type;
          if (type === 'order') {
            const cust = (raw.customer && raw.customer.name) || "Customer";
            const items = (raw.items || []).map(it => (it.modelLine || "Aircon") + " " + (it.capacity || "")).join(", ");
            const fulfillLabel = ({ delivery_only: "Deliver", delivery_installation: "Install", customer_pickup: "Pickup" })[raw.fulfillmentType] || "Deliver";
            const icon = raw.fulfillmentType === "customer_pickup" ? "bi-bag-check" : raw.fulfillmentType === "delivery_installation" ? "bi-tools" : "bi-truck";
            return { html: '<div class="event-content-wrapper"><div class="event-time">' + escHtml(orderTimeLabel(raw)) + '</div><div class="event-customer"><i class="bi ' + icon + ' me-1" style="font-size:0.65rem;"></i>' + escHtml(cust) + '</div><div class="event-service">' + escHtml(fulfillLabel + ': ' + items.substring(0, 25)) + '</div></div>' };
          }
          const tname = technicianName(raw);
          const sname = serviceName(raw);
          const serviceText = tname !== "Unassigned" ? (escHtml(sname) + ' <span style="opacity:0.8;">&middot; ' + escHtml(tname) + '</span>') : escHtml(sname);
          return { html: '<div class="event-content-wrapper"><div class="event-time">' + escHtml(timeLabel(raw)) + '</div><div class="event-customer">' + escHtml(customerName(raw)) + '</div><div class="event-service">' + serviceText + '</div></div>' };
        },

        eventDidMount(info) {
          const raw = info.event.extendedProps.raw || {};
          const isOrder = info.event.extendedProps.type === "order";
          const label = isOrder
            ? `${orderTimeLabel(raw)} · ${(raw.customer && raw.customer.name) || "Customer"} · ${prettyStatus(raw.status)}`
            : `${timeLabel(raw)} · ${customerName(raw)} · ${serviceName(raw)} · ${prettyStatus(raw.status)}`;
          info.el.setAttribute("title", label);
          info.el.setAttribute("aria-label", label);
        },

        viewDidMount(info) {
          state.currentViewType = info.view.type;
          updateTimeGridHours(info.view.type, info.view.currentStart);
          if (dom.viewToggle) dom.viewToggle.querySelectorAll("button").forEach(button => button.classList.toggle("active", button.dataset.view === info.view.type));
          buildFilterBar();
        },

        async datesSet(arg) {
          if (window._debounceDatesSet) clearTimeout(window._debounceDatesSet);
          window._debounceDatesSet = setTimeout(async () => {
            updateRangeLabel(arg.view.title);
            state.currentViewType = arg.view.type;

            const isTimegrid = arg.view.type === "timeGridWeek" || arg.view.type === "timeGridDay";
            calendar.setOption("height", isTimegrid ? Math.max(640, window.innerHeight - 320) : "auto");

            if (isTimegrid) updateTimeGridHours(arg.view.type, arg.view.currentStart);

            const start = toDateKey(arg.start);
            const endDate = new Date(arg.end.getTime() - 1);
            const end = toDateKey(endDate);
            if (dom.calendarSpinner) dom.calendarSpinner.style.display = "block";
            try {
              const [appts, orders, schedules] = await Promise.all([
                fetchAppointmentsForRange(start, end),
                fetchOrdersForRange(start, end).catch(() => []),
                Object.keys(state.schedules).length === 0 ? fetchTechnicianSchedules() : Promise.resolve(state.schedules),
              ]);
              state.schedules = schedules;
              state.workingDaysMap = computeWorkingDaysMap(schedules);
              state.allAppointments = appts;
              state.allOrders = orders.filter(o => o.status !== "cancelled" && o.status !== "completed" && orderScheduledDate(o));
              applyFilters();
              buildFilterBar();
            } catch (err) {
              console.error(err);
              dom.selectedDateList.innerHTML = '<div class="empty-state"><i class="bi bi-exclamation-triangle"></i>Failed to load appointments.</div>';
              dom.selectedDateCount.textContent = "0";
            } finally {
              if (dom.calendarSpinner) dom.calendarSpinner.style.display = "none";
            }
          }, 150);
        },
      });

      calendar.render();

      function updateNavButtons() {
        const p = dom.calendarEl.querySelector(".fc-prev-button"); const n = dom.calendarEl.querySelector(".fc-next-button");
        if (p) { p.setAttribute("tabindex", "0"); p.setAttribute("aria-label", "Previous"); }
        if (n) { n.setAttribute("tabindex", "0"); n.setAttribute("aria-label", "Next"); }
      }
      calendar.on("viewDidMount", updateNavButtons); updateNavButtons();

      let calendarWasMobile = window.innerWidth < 600;
      let calendarResizeTimer;
      window.addEventListener("resize", () => {
        window.clearTimeout(calendarResizeTimer);
        calendarResizeTimer = window.setTimeout(() => {
          const isMobile = window.innerWidth < 600;
          if (isMobile !== calendarWasMobile) {
            if (isMobile) calendar.changeView("listWeek");
            else if (calendar.view && calendar.view.type === "listWeek") calendar.changeView("dayGridMonth");
            calendarWasMobile = isMobile;
          }
          calendar.updateSize();
        }, 120);
      });
      const ro = new ResizeObserver(() => calendar.updateSize()); ro.observe(dom.calendarEl);
      const ps = document.querySelector(".page-shell"); if (ps) ro.observe(ps);
      const md = document.querySelector(".admin-dashboard"); if (md) ro.observe(md);
      { const orig = renderDateList; renderDateList = function() { orig(); const l = dom.selectedDateList; if (l) { l.classList.add("slide-in"); setTimeout(() => l.classList.remove("slide-in"), 400); } }; }

      /* ── Init Technicians ───────────────────────────────────────── */
      (async function initTechFilter() {
        state.technicians = await fetchTechnicians();
        buildTechDropdown();
        updateTechFilterUI();
        applyFilters();

        if (dom.techTrigger) dom.techTrigger.addEventListener("click", toggleTechDropdown);
        document.addEventListener("click", (e) => {
          if (dom.techFilterWrapper && !dom.techFilterWrapper.contains(e.target)) {
            if (dom.techDropdown) dom.techDropdown.classList.remove("open");
            if (dom.techTrigger) dom.techTrigger.classList.remove("active");
          }
        });
        if (dom.techSelectAll) dom.techSelectAll.addEventListener("click", () => {
          if (state.selectedTechIds.length === 0 || state.selectedTechIds.length < state.technicians.length) {
            state.selectedTechIds = [];
          } else {
            state.selectedTechIds = state.technicians.map(t => String(t._id));
          }
          updateTechFilterUI();
          applyFilters();
          buildTechDropdown();
        });
        if (dom.techSearchInput) dom.techSearchInput.addEventListener("input", () => {
          const q = dom.techSearchInput.value.toLowerCase();
          const options = dom.techOptions;
          if (options) options.querySelectorAll(".tech-option").forEach(el => {
            const name = el.querySelector(".tech-name")?.textContent?.toLowerCase() || "";
            el.style.display = name.includes(q) ? "flex" : "none";
          });
        });

        if (dom.searchInput) dom.searchInput.addEventListener("input", () => {
          state.query = dom.searchInput.value.trim().toLowerCase();
          if (dom.searchWrap) dom.searchWrap.classList.toggle("has-value", Boolean(state.query));
          applyFilters();
          buildFilterBar();
        });
        if (dom.searchClear) dom.searchClear.addEventListener("click", () => {
          if (dom.searchInput) { dom.searchInput.value = ""; dom.searchInput.focus(); }
          state.query = "";
          if (dom.searchWrap) dom.searchWrap.classList.remove("has-value");
          applyFilters();
          buildFilterBar();
        });

        if (dom.viewToggle) dom.viewToggle.querySelectorAll("button").forEach(btn => {
          btn.addEventListener("click", () => {
            dom.viewToggle.querySelectorAll("button").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            calendar.changeView(btn.dataset.view);
          });
        });
      })();
    });
  </script>
</div>
