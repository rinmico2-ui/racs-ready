<div class="auth-wrapper" id="authWrapper">
  <div class="auth-shapes">
    <div class="auth-shape"></div>
    <div class="auth-shape"></div>
    <div class="auth-shape"></div>
  </div>

  <!-- Brand Panel (desktop) -->
  <div class="auth-brand">
    <div class="auth-brand-inner">
      <div class="auth-brand-logo">
        <div class="auth-brand-logo-icon"><i class="bi bi-snow2"></i></div>
        <span class="auth-brand-logo-text">CALIDRO RACS</span>
      </div>
      <p class="auth-brand-tagline">A reliable aircon and appliances service company, specialize in repair, installation, and maintenance for your comfort.</p>
      <div class="auth-brand-services">
        <div class="auth-brand-service">
          <div class="auth-brand-service-icon">❄️</div>
          <div class="auth-brand-service-label">Aircon Repair</div>
        </div>
        <div class="auth-brand-service">
          <div class="auth-brand-service-icon">🔧</div>
          <div class="auth-brand-service-label">Installation</div>
        </div>
        <div class="auth-brand-service">
          <div class="auth-brand-service-icon">🛡️</div>
          <div class="auth-brand-service-label">Maintenance</div>
        </div>
        <div class="auth-brand-service">
          <div class="auth-brand-service-icon">📋</div>
          <div class="auth-brand-service-label">Inspection</div>
        </div>
      </div>
      <div class="auth-brand-testimonial">
        <div class="auth-brand-testimonial-text">"Fast and reliable service! Fixed my AC unit within hours. Highly recommended for all HVAC needs."</div>
        <div class="auth-brand-testimonial-author">
          <div class="auth-brand-testimonial-avatar">JM</div>
          <div>
            <div class="auth-brand-testimonial-name">Juan M.</div>
            <div class="auth-brand-testimonial-title"><%= locals.companyAddress || 'Quezon City' %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Panel -->
  <div class="auth-form-panel">
    <div class="auth-form-card" id="authFormCard">

      <!-- ===== SIGN IN ===== -->
      <div id="authSignIn">
        <div class="auth-form-card-header">
          <a href="/" class="auth-form-card-logo">
            <div class="auth-form-card-logo-icon"><i class="bi bi-snow2"></i></div>
            <span class="auth-form-card-logo-text">CALIDRO</span>
          </a>
          <h1 class="auth-form-card-title">Welcome Back</h1>
          <p class="auth-form-card-subtitle">Sign in to manage your services and bookings.</p>
        </div>

        <form id="auth-login-form" method="POST" novalidate autocomplete="off">
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />

          <div class="auth-field">
            <label class="auth-field-label" for="email">Email Address</label>
            <div class="auth-field-input-wrap">
              <input id="email" name="email" type="email" class="auth-field-input"
                placeholder="you@example.com" required autocomplete="off" maxlength="50" />
              <i class="bi bi-envelope auth-field-icon"></i>
            </div>
            <div class="auth-field-error" id="login-email-error"></div>
          </div>

          <div class="auth-field">
            <label class="auth-field-label" for="password">Password</label>
            <div class="auth-field-input-wrap">
              <input id="password" name="password" type="password" class="auth-field-input"
                placeholder="Enter your password" required autocomplete="current-password" maxlength="20" />
              <i class="bi bi-lock auth-field-icon"></i>
              <button type="button" class="auth-field-toggle" id="togglePassword" aria-label="Toggle password visibility">
                <i class="bi bi-eye"></i>
              </button>
            </div>
            <div class="auth-field-error" id="login-password-error"></div>
          </div>

          <div class="auth-options">
            <label class="auth-remember">
              <input type="checkbox" id="rememberMe" name="rememberMe" />
              Remember me
            </label>
            <a href="/forgot-password" class="auth-forgot">Forgot password?</a>
          </div>

          <div class="auth-captcha math-captcha" id="loginCaptcha">
            <div class="auth-captcha-header">
              <span class="auth-captcha-label">Verify you're human</span>
              <button type="button" class="auth-captcha-refresh refresh-captcha" title="New captcha">
                <i class="bi bi-arrow-clockwise"></i>
              </button>
            </div>
            <div class="auth-captcha-dice">
              <span class="captcha-equation" id="loginEquation" style="font-size:20px;font-weight:700;color:var(--clr-text);"><%= num1 %> + <%= num2 %> =</span>
            </div>
            <input type="text" id="login-math" name="mathCaptcha" class="auth-captcha-input"
              placeholder="Enter the sum" required maxlength="3" inputmode="numeric" pattern="[0-9]{1,3}" />
            <input type="hidden" name="mathAnswer" value="<%= mathAnswer %>" />
          </div>

          <!-- OTP Block -->
          <div class="auth-otp d-none" id="otpBlock">
            <label class="auth-field-label">Verification Code</label>
            <div class="auth-otp-row">
              <input id="login-otp" name="otp" type="text" inputmode="numeric"
                pattern="[0-9]*" maxlength="6" class="auth-otp-input"
                placeholder="6-digit code" />
              <button type="button" class="auth-otp-resend" id="resendOtpBtn" disabled>
                Resend
              </button>
            </div>
          </div>

          <button type="submit" class="auth-submit" id="loginBtn">
            <span class="btn-text">Sign In</span>
          </button>
        </form>

        <div class="auth-toggle-text">
          Don't have an account? <a class="auth-toggle-link" id="switchToSignUp">Create one</a>
        </div>
        <div style="text-align:center;">
          <a href="/" class="auth-back-home"><i class="bi bi-arrow-left"></i> Back to home</a>
        </div>
      </div>

      <!-- ===== SIGN UP ===== -->
      <div id="authSignUp" style="display:none;">
        <div class="auth-form-card-header">
          <a href="/" class="auth-form-card-logo">
            <div class="auth-form-card-logo-icon"><i class="bi bi-snow2"></i></div>
            <span class="auth-form-card-logo-text">CALIDRO</span>
          </a>
          <h1 class="auth-form-card-title">Create Account</h1>
          <p class="auth-form-card-subtitle">Join thousands of satisfied customers.</p>
        </div>

        <form id="auth-register-form" method="POST" novalidate autocomplete="off">
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />

          <div class="auth-field-row">
            <div class="auth-field">
              <label class="auth-field-label" for="register-firstName">First Name</label>
              <div class="auth-field-input-wrap">
                <input id="register-firstName" name="firstName" type="text" class="auth-field-input"
                  placeholder="Juan" autocomplete="given-name" maxlength="20"
                  pattern="[A-Za-z\s]{1,20}" required />
                <i class="bi bi-person auth-field-icon"></i>
              </div>
            </div>
            <div class="auth-field">
              <label class="auth-field-label" for="register-lastName">Last Name</label>
              <div class="auth-field-input-wrap">
                <input id="register-lastName" name="lastName" type="text" class="auth-field-input"
                  placeholder="Dela Cruz" autocomplete="family-name" maxlength="20"
                  pattern="[A-Za-z\s]{1,20}" required />
                <i class="bi bi-person auth-field-icon"></i>
              </div>
            </div>
          </div>

          <div class="auth-field">
            <label class="auth-field-label" for="register-phone">Phone Number</label>
            <div class="auth-field-input-wrap">
              <input id="register-phone" name="phone" type="tel" inputmode="numeric"
                class="auth-field-input" placeholder="09XXXXXXXXX" autocomplete="tel" maxlength="11" required />
              <i class="bi bi-telephone auth-field-icon"></i>
            </div>
          </div>

          <div class="auth-field">
            <label class="auth-field-label" for="register-email">Email Address</label>
            <div class="auth-field-input-wrap">
              <input id="register-email" name="email" type="email" class="auth-field-input"
                placeholder="you@example.com" required autocomplete="off" maxlength="50" />
              <i class="bi bi-envelope auth-field-icon"></i>
            </div>
          </div>

          <div class="auth-section-label">Address</div>

          <div class="auth-field-row">
            <div class="auth-field">
              <label class="auth-field-label" for="register-addressProvince">Province</label>
              <div class="auth-field-input-wrap">
                <select id="register-addressProvince" name="addressProvince" class="auth-field-input"
                  autocomplete="address-level1" required>
                  <option value="">Select Province</option>
                </select>
              </div>
            </div>
            <div class="auth-field">
              <label class="auth-field-label" for="register-addressCity">City</label>
              <div class="auth-field-input-wrap">
                <select id="register-addressCity" name="addressCity" class="auth-field-input"
                  autocomplete="address-level2" disabled required>
                  <option value="">Select City</option>
                </select>
              </div>
            </div>
          </div>

          <div class="auth-field-row">
            <div class="auth-field">
              <label class="auth-field-label" for="register-addressBarangay">Barangay</label>
              <div class="auth-field-input-wrap">
                <select id="register-addressBarangay" name="addressBarangay" class="auth-field-input"
                  autocomplete="address-level3" disabled required>
                  <option value="">Select Barangay</option>
                </select>
              </div>
            </div>
            <div class="auth-field">
              <label class="auth-field-label" for="register-addressPostal">Postal Code</label>
              <div class="auth-field-input-wrap">
                <input id="register-addressPostal" name="addressPostal" type="text"
                  class="auth-field-input" placeholder="1000" autocomplete="postal-code"
                  inputmode="numeric" pattern="[0-9]{1,4}" maxlength="4" required />
              </div>
            </div>
          </div>

          <div class="auth-section-label">Account Security</div>

          <div class="auth-field">
            <label class="auth-field-label" for="register-password">Password</label>
            <div class="auth-field-input-wrap">
              <input id="register-password" name="password" type="password" class="auth-field-input"
                placeholder="Create a strong password" required autocomplete="new-password" maxlength="20" />
              <i class="bi bi-lock auth-field-icon"></i>
              <button type="button" class="auth-field-toggle" id="togglePasswordReg" aria-label="Toggle password">
                <i class="bi bi-eye"></i>
              </button>
              <span id="register-password-check" class="auth-match-indicator d-none"></span>
            </div>
            <ul class="auth-password-rules" id="register-password-suggestions">
              <li data-rule="letter"><i class="bi bi-circle"></i> Uppercase letter</li>
              <li data-rule="digitOrSpecial"><i class="bi bi-circle"></i> Number or special character</li>
              <li data-rule="length"><i class="bi bi-circle"></i> At least 10 characters</li>
            </ul>
            <div class="auth-strength-meter"><div class="auth-strength-meter-fill" id="register-strength-fill"></div></div>
          </div>

          <div class="auth-field">
            <label class="auth-field-label" for="register-confirm">Confirm Password</label>
            <div class="auth-field-input-wrap">
              <input id="register-confirm" name="confirmPassword" type="password" class="auth-field-input"
                placeholder="Re-enter your password" required autocomplete="new-password" maxlength="20" />
              <i class="bi bi-shield-lock auth-field-icon"></i>
              <button type="button" class="auth-field-toggle" id="toggleConfirmPasswordReg" aria-label="Toggle confirm password">
                <i class="bi bi-eye"></i>
              </button>
              <span id="register-confirm-check" class="auth-match-indicator d-none"></span>
            </div>
          </div>

          <div class="auth-captcha math-captcha" id="registerCaptcha">
            <div class="auth-captcha-header">
              <span class="auth-captcha-label">Verify you're human</span>
              <button type="button" class="auth-captcha-refresh refresh-captcha" title="New captcha">
                <i class="bi bi-arrow-clockwise"></i>
              </button>
            </div>
            <div class="auth-captcha-dice">
              <span class="captcha-equation" id="registerEquation" style="font-size:20px;font-weight:700;color:var(--clr-text);"><%= num1 %> + <%= num2 %> =</span>
            </div>
            <input type="text" id="register-math" name="mathCaptcha" class="auth-captcha-input"
              placeholder="Enter the sum" required maxlength="3" inputmode="numeric" pattern="[0-9]{1,3}" />
            <input type="hidden" name="mathAnswer" value="<%= mathAnswer %>" />
          </div>

          <button type="submit" class="auth-submit" id="registerBtn">
            <span class="btn-text">Create Account</span>
          </button>
        </form>

        <div class="auth-toggle-text">
          Already have an account? <a class="auth-toggle-link" id="switchToSignIn">Sign In</a>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
(function() {
  'use strict';
  const signInEl = document.getElementById('authSignIn');
  const signUpEl = document.getElementById('authSignUp');

  window.openSignUp = function() {
    signInEl.style.display = 'none';
    signUpEl.style.display = '';
    signUpEl.classList.remove('auth-fade-in');
    void signUpEl.offsetWidth;
    signUpEl.classList.add('auth-fade-in');
    const first = signUpEl.querySelector('input:not([type="hidden"])');
    if (first) setTimeout(() => first.focus(), 300);
  };

  window.openSignIn = function() {
    signUpEl.style.display = 'none';
    signInEl.style.display = '';
    signInEl.classList.remove('auth-fade-in');
    void signInEl.offsetWidth;
    signInEl.classList.add('auth-fade-in');
    const first = signInEl.querySelector('input:not([type="hidden"])');
    if (first) setTimeout(() => first.focus(), 300);
  };

  document.getElementById('switchToSignUp').addEventListener('click', function(e) {
    e.preventDefault(); openSignUp();
  });
  document.getElementById('switchToSignIn').addEventListener('click', function(e) {
    e.preventDefault(); openSignIn();
  });

  // Direct URL parameter support
  const p = new URLSearchParams(window.location.search);
  if (p.get('signup') === '1' || window.location.hash === '#signup') openSignUp();
  else openSignIn();

  // Clear sensitive fields
  function clearSensitive() {
    ['email','password','login-otp','login-math',
     'register-firstName','register-lastName','register-phone','register-email',
     'register-password','register-confirm','register-math'
    ].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
  }
  clearSensitive();
  window.addEventListener('pageshow', clearSensitive);
})();
</script>
