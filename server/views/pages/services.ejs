<script>
function showBookingConfirmationModal(d){
  /* ── Populate the enterprise invoice modal ── */
  var refEl=document.getElementById('bookingResultReference');
  var dateEl=document.getElementById('bookingResultDate');
  var timeEl=document.getElementById('bookingResultTime');
  var totalEl=document.getElementById('bookingResultTotalFee');
  var svcTotalEl=document.getElementById('bookingResultServicesTotal');
  var travelEl=document.getElementById('bookingResultTravelFare');
  var svcListEl=document.getElementById('bookingResultServices');
  var distInfoEl=document.getElementById('bookingResultDistanceInfo');
  var distLabelEl=document.getElementById('bookingResultDistanceLabel');

  if(refEl) refEl.textContent=d.bookingReference||d.workOrderNumber||'#RACS-000000';
  if(dateEl) dateEl.textContent=d.dateLabel||d.date||'—';
  if(timeEl){
    if(d.isProject){
      var ps=d.projectScheduling||{};
      var prefs=ps.preferences||{};
      var html='<span class="ent-inv-badge-project"><i class="bi bi-kanban me-1"></i>Large-Scale Project</span>';
      if(ps.startDate||ps.preferredStartDate){
        var sd=new Date(ps.startDate||ps.preferredStartDate);
        if(!isNaN(sd)) html+='<div class="ent-inv-detail">Start: '+sd.toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'})+'</div>';
      }
      if(prefs.completionDeadline){
        var dl=new Date(prefs.completionDeadline);
        if(!isNaN(dl)) html+='<div class="ent-inv-detail">Target End: '+dl.toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'})+'</div>';
      }
      if(prefs.preferredWorkingHours){
        html+='<div class="ent-inv-detail">Access: '+prefs.preferredWorkingHours.charAt(0).toUpperCase()+prefs.preferredWorkingHours.slice(1)+'</div>';
      }
      timeEl.innerHTML=html;
    } else {
      timeEl.textContent=d.timeLabel||d.time||'—';
    }
  }

  /* Services breakdown */
  var services=BookingState.selectedServices||[];
  var servicesTotal=0;
  if(svcListEl){
    svcListEl.innerHTML='';
    if(services.length===0){
      svcListEl.innerHTML='<div class="ent-inv-service-row"><span class="ent-inv-svc-name text-muted">No services</span><span class="ent-inv-svc-price">—</span></div>';
    } else {
      services.forEach(function(svc){
        var qty=svc.quantity||1;
        var price=svc.unitPrice||svc.price||0;
        var lineTotal=price*qty;
        servicesTotal+=lineTotal;
        var isRepair=svc.type==='repair';
        var badge=isRepair?'<span class="ent-inv-svc-badge" style="background:#fef3c7;color:#92400e;">REPAIR</span>':'<span class="ent-inv-svc-badge" style="background:#dbeafe;color:#1e40af;">CORE</span>';
        var details='';
        if(isRepair){
          var parts=[];
          if(svc.brand) parts.push(escapeInvHtml(svc.brand));
          if(svc.unitType) parts.push(escapeInvHtml(svc.unitType));
          if(svc.model) parts.push('Model: '+escapeInvHtml(svc.model));
          details='<div class="ent-inv-svc-detail">'+parts.join(' &middot; ')+'</div>';
          if(svc.problemDescription||svc.repairIssue){
            details+='<div class="ent-inv-svc-issue"><i class="bi bi-exclamation-triangle-fill me-1"></i>'+escapeInvHtml(svc.problemDescription||svc.repairIssue)+'</div>';
          }
        } else {
          var parts=[];
          if(svc.hp) parts.push(svc.hp+' HP');
          if(svc.airconTypeName) parts.push(escapeInvHtml(svc.airconTypeName));
          parts.push('Qty: '+qty);
          details='<div class="ent-inv-svc-detail">'+parts.join(' &middot; ')+'</div>';
        }
        var row=document.createElement('div');
        row.className='ent-inv-service-row';
        row.style.cssText='flex-direction:column;align-items:flex-start;gap:4px;padding:10px 0;border-bottom:1px solid rgba(226,232,240,0.5);';
        row.innerHTML='<div style="display:flex;align-items:center;justify-content:space-between;width:100%;">'+
          '<div style="display:flex;align-items:center;gap:6px;">'+
            badge+
            '<span class="ent-inv-svc-name" style="font-weight:600;">'+escapeInvHtml(svc.name||'Service')+'</span>'+
          '</div>'+
          '<span class="ent-inv-svc-price" style="font-weight:700;color:#059669;">₱'+lineTotal.toLocaleString()+'</span>'+
        '</div>'+
        details;
        svcListEl.appendChild(row);
      });
    }
  }
  if(svcTotalEl) svcTotalEl.textContent='₱'+servicesTotal.toLocaleString();

  /* Travel fare */
  var travelFare=BookingState.travelFare||BookingState.fare||0;
  if(travelEl) travelEl.textContent='₱'+travelFare.toLocaleString();
  if(distInfoEl&&distLabelEl&&travelFare>0){
    var km=(travelFare/40).toFixed(1);
    distLabelEl.textContent=km+' km × ₱40/km';
    distInfoEl.style.display='flex';
  }

  /* Total */
  var total=servicesTotal+travelFare;
  if(totalEl) totalEl.textContent='₱'+total.toLocaleString();

  /* Downpayment & balance */
  var downpayment=0;
  if((BookingState.paymentMethod||'gcash')==='cod' || (BookingState.paymentMethod||'gcash')==='cash'){
    var dpEl=document.getElementById('downpaymentAmt');
    downpayment=Number(dpEl ? dpEl.value : 400)||400;
  } else {
    downpayment=total;
  }
  var balance=Math.max(0,total-downpayment);
  var dpOut=document.getElementById('bookingResultDownpayment');
  var balOut=document.getElementById('bookingResultBalance');
  if(dpOut) dpOut.textContent='₱'+downpayment.toLocaleString();
  if(balOut) balOut.textContent='₱'+balance.toLocaleString();

  /* Show modal */
  var me=document.getElementById('bookingResultModal');
  if(me){
    document.querySelectorAll('.modal-backdrop').forEach(function(b){b.remove()});
    document.body.classList.remove('modal-open');
    me.style.zIndex='9999';
    var existing=bootstrap.Modal.getInstance(me);
    if(existing){existing.dispose();}
    var modal=new bootstrap.Modal(me,{backdrop:'static',keyboard:false});
    me.addEventListener('hidden.bs.modal',function(){window.location.reload();},{once:true});
    modal.show();
  } else {
    alert('Booking confirmed! Reference: '+(d.bookingReference||d.workOrderNumber||''));
  }
}
