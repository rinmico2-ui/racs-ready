<script>
  (function () {
    // Move modals to body to escape AOS transform stacking context on <main>
    !function(){var m=document.getElementById('viewStaffModal');m&&m.parentNode!==document.body&&document.body.appendChild(m)}();
    !function(){var m=document.getElementById('editStaffModal');m&&m.parentNode!==document.body&&document.body.appendChild(m)}();
    !function(){var m=document.getElementById('addStaffModal');m&&m.parentNode!==document.body&&document.body.appendChild(m)}();

    const el = (id) => document.getElementById(id);
    let currentPage = 1;
    const pageSize = 10;
    let staffData = [];
    let staffFiltered = [];
    const staffFooter = document.getElementById("staffFooter");

    function stringToHslColor(str, s = 65, l = 52) {
      let hash = 0;
      for (let i = 0; i < str.length; i++)
        hash = str.charCodeAt(i) + ((hash << 5) - hash);
      const h = Math.abs(hash) % 360;
      return `hsl(${h}, ${s}%, ${l}%)`;
    }

    function renderItem(u) {
      const name =
        ((u.firstName || "") + " " + (u.lastName || "")).trim() ||
        u.name ||
        u.email ||
        "";
      const seed = String(u._id || u.email || name || "user");
      const color = stringToHslColor(seed, 65, 50);
      const role = (u.role || "").toString().toLowerCase();
      const roleTag = `<span class='staff-role-tag ${role}' data-role='${role}' title='Filter by role'>${role || ''}</span>`;
      const initial = (
        (u.firstName || "")[0] ||
        (u.name || "")[0] ||
        "U"
      ).toUpperCase();

      return `
<div class='col-md-4 mb-0 staff-card-col' data-role='${role}' data-email='${u.email || ""}' data-name='${(name || "").replace(/'/g, "&#39;")}' data-id='${u._id || ""}'>
  <div class="staff-card">
    <div class="staff-avatar" style="background:${color};">${initial}</div>
    <div class="staff-card-body">
      <div class="staff-card-name">${name}</div>
      <div class="staff-card-email">${u.email || ""}</div>
    </div>
    <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
      ${roleTag}
      <div class="staff-actions">
        <button class="btn-icon view-staff" data-id='${u._id || ""}' title='View'><i class="bi bi-eye"></i></button>
        <button class="btn-icon edit-staff" data-id='${u._id || ""}' title='Edit'><i class="bi bi-pencil"></i></button>
      </div>
    </div>
  </div>
</div>`;
    }

    async function loadStaff() {
      // show spinner in cards area
      const spinner = `<div class="text-center py-4 text-muted small">
          <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
          Loading staff…
        </div>`;
      if (el("staffCards")) el("staffCards").innerHTML = spinner;
      try {
        const r = await fetch("/api/admin/staff", {
          credentials: "same-origin",
        });
        if (!r.ok) {
          console.error(
            "staff fetch failed",
            r.status,
            await r.text(),
          );
          if (el("staffCards"))
            el("staffCards").innerHTML =
              `<div class="text-center py-4 text-muted small"><div>Unable to load staff at this time.</div><div class="mt-2"><button id="retryLoadStaff" class="btn btn-sm btn-outline-primary">Retry</button></div></div>`;
          document
            .getElementById("retryLoadStaff")
            ?.addEventListener("click", loadStaff);
          return;
        }
        const j = await r.json();
        const arr = j.staff || [];
        // sort by role for consistency (technicians first, then secretaries)
        arr.sort((a, b) => {
          if (a.role === b.role) return 0;
          if (a.role === 'technician') return -1;
          if (b.role === 'technician') return 1;
          // secretary last
          return 0;
        });

        // Apply current client-side filters immediately so the DOM only contains matching staff
        const currentSearch = (
          document.getElementById("staffSearch")?.value || ""
        )
          .trim()
          .toLowerCase();
        const currentRoleFilter = (
          document.getElementById("staffFilterRole")?.value || ""
        )
          .trim()
          .toLowerCase();
        const filtered = arr.filter((u) => {
          const n = (
            ((u.firstName || "") + " " + (u.lastName || "")).trim() ||
            u.name ||
            ""
          ).toLowerCase();
          const e = (u.email || "").toLowerCase();
          const matchesSearch =
            !currentSearch ||
            n.includes(currentSearch) ||
            e.includes(currentSearch);
          const matchesRole =
            !currentRoleFilter ||
            (u.role || "").toString().toLowerCase() ===
              currentRoleFilter;
          return matchesSearch && matchesRole;
        });

        staffData = arr;
        staffFiltered = filtered;
        currentPage = 1;
        if (el("staffCards")) renderPage(1, filtered);

        // Update summary stats (totals for all staff)
        // prefer counts based on actual User documents when available
        if (j.userCounts) {
          document.getElementById("statTotalStaff").innerText = j.userCounts.total;
          document.getElementById("statTech").innerText = j.userCounts.technicians;
          document.getElementById("statSecretary").innerText = j.userCounts.secretaries;
          // Update inline header counters
          var techCountEl = document.querySelector('.stat-tech-count');
          var secCountEl = document.querySelector('.stat-sec-count');
          if (techCountEl) techCountEl.innerText = j.userCounts.technicians;
          if (secCountEl) secCountEl.innerText = j.userCounts.secretaries;
          // admin metric no longer present by design
          const adminEl = document.getElementById("statAdmins");
          if (adminEl) {
            adminEl.innerText = 0;
            const card = adminEl.closest('.col-md-3');
            if (card) card.style.display = 'none';
          }
        } else {
          document.getElementById("statTotalStaff").innerText = arr.length;
          document.getElementById("statTech").innerText = arr.filter(
            (s) => s.role === "technician",
          ).length;
          const adminEl = document.getElementById("statAdmins");
          if (adminEl) {
            const adminCount = arr.filter((s) => s.role === "admin").length;
            adminEl.innerText = adminCount;
            if (adminCount === 0) {
              const adminCard = adminEl.closest('.col-md-3');
              if (adminCard) adminCard.style.display = 'none';
            }
          }
          document.getElementById("statSecretary").innerText =
            arr.filter((s) => s.role === "secretary").length;
          // Update inline header counters
          var techCountEl = document.querySelector('.stat-tech-count');
          var secCountEl = document.querySelector('.stat-sec-count');
          if (techCountEl) techCountEl.innerText = arr.filter((s) => s.role === "technician").length;
          if (secCountEl) secCountEl.innerText = arr.filter((s) => s.role === "secretary").length;
        }

        // Update recently added
        const recentArr = arr.slice(-3);
        if (recentArr.length) {
          document.getElementById("recentStaff").innerHTML =
            recentArr.map((u) =>
              `<div class="staff-recent-item"><span class="staff-recent-dot"></span>${((u.firstName || "") + " " + (u.lastName || "")).trim() || u.email}</div>`
            ).join("");
        } else {
          document.getElementById("recentStaff").innerHTML =
            `<div class="staff-recent-item"><span class="staff-recent-dot"></span>No recent activity</div>`;
        }

        // Re-apply active search/filter so the UI remains consistent after refresh
        try {
          if (typeof filterStaffList === "function")
            filterStaffList();
        } catch (e) {
          /* noop */
        }
      } catch (e) {
        console.error("loadStaff error", e);
        if (el("staffCards"))
          el("staffCards").innerHTML =
            `<div class="text-center py-4 text-muted small"><div>Unable to load staff — network or server error.</div><div class="mt-2"><button id="retryLoadStaff2" class="btn btn-sm btn-outline-primary">Retry</button></div></div>`;
        document
          .getElementById("retryLoadStaff2")
          ?.addEventListener("click", loadStaff);
      }
    }

    // ═══ ADD STAFF WIZARD ═══
    (function () {
      let wizStep = 1;
      const totalSteps = 3;

      const roleSelector = document.getElementById("roleSelector");
      if (roleSelector) {
        roleSelector.querySelectorAll(".role-option").forEach(function (btn) {
          btn.addEventListener("click", function () {
            roleSelector.querySelectorAll(".role-option").forEach(function (b) { b.classList.remove("active"); });
            btn.classList.add("active");
            el("wizRole").value = btn.dataset.role;
            // Toggle location field visibility
            var techFields = el("wizTechFields");
            if (techFields) techFields.style.display = btn.dataset.role === "technician" ? "" : "none";
          });
        });
      }

      function updateWizardUI() {
        // Update step indicators
        document.querySelectorAll("#wizardSteps .wizard-step").forEach(function (s) {
          var step = parseInt(s.dataset.step);
          s.classList.remove("active", "completed");
          if (step === wizStep) s.classList.add("active");
          else if (step < wizStep) s.classList.add("completed");
        });
        // Update panels
        document.querySelectorAll(".wizard-panel").forEach(function (p) { p.classList.remove("active"); });
        var panel = el("wizardPanel" + wizStep);
        if (panel) panel.classList.add("active");
        // Update buttons
        el("wizBackBtn").style.display = wizStep > 1 ? "" : "none";
        el("wizNextBtn").style.display = wizStep < totalSteps ? "" : "none";
        el("wizCreateBtn").style.display = wizStep === totalSteps ? "" : "none";
      }

      function clearErrors() {
        document.querySelectorAll(".wiz-error").forEach(function (e) { e.textContent = ""; });
        document.querySelectorAll(".wizard-panel .staff-form-control").forEach(function (c) { c.classList.remove("is-invalid", "is-valid"); });
      }

      function setError(id, msg) { var e = el(id); if (e) e.textContent = msg; }

      function validateStep1() {
        clearErrors();
        var valid = true;
        var email = (el("wizEmail").value || "").trim();
        var pass = el("wizPassword").value || "";
        if (!email) { setError("wizEmailError", "Email is required"); el("wizEmail").classList.add("is-invalid"); valid = false; }
        else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError("wizEmailError", "Enter a valid email address"); el("wizEmail").classList.add("is-invalid"); valid = false; }
        else { el("wizEmail").classList.add("is-valid"); }
        if (!pass) { setError("wizPassError", "Password is required"); el("wizPassword").classList.add("is-invalid"); valid = false; }
        else if (pass.length < 8 || pass.length > 12) { setError("wizPassError", "Must be 8-12 characters"); el("wizPassword").classList.add("is-invalid"); valid = false; }
        else if (!/^[A-Za-z0-9]+$/.test(pass)) { setError("wizPassError", "Letters and numbers only"); el("wizPassword").classList.add("is-invalid"); valid = false; }
        else { el("wizPassword").classList.add("is-valid"); }
        return valid;
      }

      function validateStep2() {
        clearErrors();
        var valid = true;
        var first = (el("wizFirst").value || "").trim();
        var last = (el("wizLast").value || "").trim();
        var phone = (el("wizPhone").value || "").trim();
        if (!first) { setError("wizFirstError", "First name is required"); el("wizFirst").classList.add("is-invalid"); valid = false; }
        else { el("wizFirst").classList.add("is-valid"); }
        if (!last) { setError("wizLastError", "Last name is required"); el("wizLast").classList.add("is-invalid"); valid = false; }
        else { el("wizLast").classList.add("is-valid"); }
        if (phone && !/^\d{10,11}$/.test(phone)) { setError("wizPhoneError", "Enter a valid 10-11 digit phone number"); el("wizPhone").classList.add("is-invalid"); valid = false; }
        else if (phone) { el("wizPhone").classList.add("is-valid"); }
        return valid;
      }

      function populateConfirmation() {
        var role = el("wizRole").value;
        var first = (el("wizFirst").value || "").trim();
        var last = (el("wizLast").value || "").trim();
        var email = (el("wizEmail").value || "").trim();
        var phone = (el("wizPhone").value || "").trim();
        var location = (el("wizLocation").value || "").trim();
        var name = (first + " " + last).trim() || email;

        // Avatar
        var seed = email || name;
        var hash = 0;
        for (var i = 0; i < seed.length; i++) hash = seed.charCodeAt(i) + ((hash << 5) - hash);
        var hue = Math.abs(hash) % 360;
        var avatar = el("confirmAvatar");
        if (avatar) {
          avatar.style.background = "hsl(" + hue + ", 65%, 50%)";
          avatar.textContent = (first[0] || "U").toUpperCase();
        }
        var nameEl = el("confirmName"); if (nameEl) nameEl.textContent = name;
        var roleEl = el("confirmRole"); if (roleEl) roleEl.textContent = role === "technician" ? "Technician" : "Secretary";
        var emailEl = el("confirmEmail"); if (emailEl) emailEl.textContent = email;
        var phoneEl = el("confirmPhone"); if (phoneEl) phoneEl.textContent = phone || "—";
        var locEl = el("confirmLocation"); if (locEl) locEl.textContent = location || "Not specified";
        var noteEl = el("confirmNote");
        if (noteEl) noteEl.textContent = role === "technician"
          ? "A technician account will be added to the scheduling roster automatically."
          : "A secretary account will be created with standard permissions.";
      }

      // Password strength indicator
      var passInput = el("wizPassword");
      if (passInput) {
        passInput.addEventListener("input", function () {
          var v = this.value || "";
          var strength = 0;
          if (v.length >= 8) strength++;
          if (/[A-Z]/.test(v)) strength++;
          if (/[0-9]/.test(v)) strength++;
          if (v.length >= 10) strength++;
          var bars = document.querySelectorAll("#passStrength div");
          var colors = ["#ef4444", "#f59e0b", "#3b82f6", "#10b981"];
          bars.forEach(function (bar, i) {
            bar.style.background = i < strength ? colors[Math.min(strength - 1, 3)] : "#e2e8f0";
          });
        });
      }

      // Password toggle
      var toggleBtn = el("toggleWizPass");
      if (toggleBtn) {
        toggleBtn.addEventListener("click", function () {
          var input = el("wizPassword");
          var icon = this.querySelector("i");
          if (input.type === "password") { input.type = "text"; icon.className = "bi bi-eye-slash"; }
          else { input.type = "password"; icon.className = "bi bi-eye"; }
        });
      }

      // Next button
      var nextBtn = el("wizNextBtn");
      if (nextBtn) {
        nextBtn.addEventListener("click", function () {
          if (wizStep === 1 && !validateStep1()) return;
          if (wizStep === 2 && !validateStep2()) return;
          if (wizStep === 2) populateConfirmation();
          if (wizStep < totalSteps) { wizStep++; updateWizardUI(); }
        });
      }

      // Back button
      var backBtn = el("wizBackBtn");
      if (backBtn) {
        backBtn.addEventListener("click", function () {
          if (wizStep > 1) { wizStep--; updateWizardUI(); }
        });
      }

      // Create button
      var createBtn = el("wizCreateBtn");
      if (createBtn) {
        createBtn.addEventListener("click", async function () {
          var payload = {
            role: el("wizRole").value,
            firstName: (el("wizFirst").value || "").trim(),
            lastName: (el("wizLast").value || "").trim(),
            email: (el("wizEmail").value || "").trim(),
            phone: (el("wizPhone").value || "").trim(),
            password: el("wizPassword").value,
          };
          var geoVal = el("wizLocationGeo")?.value;
          if (geoVal) {
            try { payload.location = JSON.parse(geoVal); } catch (e) {
              payload.location = (el("wizLocation").value || "").trim() || undefined;
            }
          } else if (payload.role === "technician") {
            payload.location = (el("wizLocation").value || "").trim() || undefined;
          }
          createBtn.disabled = true;
          createBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Creating...';
          try {
            var res = await fetch("/api/admin/staff", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            if (res.ok) {
              var modal = bootstrap.Modal.getInstance(el("addStaffModal"));
              if (modal) modal.hide();
              window.notify.success("Staff account created successfully");
              // Reset wizard
              wizStep = 1;
              el("wizEmail").value = "";
              el("wizPassword").value = "";
              el("wizFirst").value = "";
              el("wizLast").value = "";
              el("wizPhone").value = "";
              el("wizLocation").value = "";
              el("wizLocationGeo").value = "";
              clearErrors();
              updateWizardUI();
              loadStaff();
            } else {
              var t = await res.text();
              var msg = t;
              try { var j = JSON.parse(t); if (j && j.error) msg = j.error; } catch (e) {}
              window.notify.error("Failed: " + msg);
            }
          } catch (err) { window.notify.error("Failed to create staff"); }
          createBtn.disabled = false;
          createBtn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Create Account';
        });
      }

      // Reset wizard when modal closes
      var addModal = el("addStaffModal");
      if (addModal) {
        addModal.addEventListener("hidden.bs.modal", function () {
          wizStep = 1;
          clearErrors();
          updateWizardUI();
        });
      }

      // Geolocation for wizard
      var wizLocBtn = el("wizBtnUseLocation");
      if (wizLocBtn) {
        wizLocBtn.addEventListener("click", function () {
          if (!navigator.geolocation) return;
          wizLocBtn.disabled = true;
          wizLocBtn.textContent = "Locating...";
          navigator.geolocation.getCurrentPosition(
            function (pos) {
              el("wizLocationGeo").value = JSON.stringify({ type: "Point", coordinates: [Number(pos.coords.longitude), Number(pos.coords.latitude)] });
              el("wizLocation").value = pos.coords.latitude.toFixed(6) + ", " + pos.coords.longitude.toFixed(6);
              wizLocBtn.disabled = false;
              wizLocBtn.textContent = "Use GPS";
            },
            function () { wizLocBtn.disabled = false; wizLocBtn.textContent = "Use GPS"; },
            { enableHighAccuracy: true, timeout: 10000 }
          );
        });
      }
    })();

    const refreshBtn = el("btn-refresh-staff");
    if (refreshBtn) {
      refreshBtn.addEventListener("click", loadStaff);
    }

    // Geolocation capture: fill hidden field with GeoJSON and display coords in the text input
    (function () {
      const btn = document.getElementById("btnUseLocation");
      const geoField = document.getElementById("staffLocationGeo");
      const locInput = document.getElementById("staffLocation");
      if (!btn) return;
      btn.addEventListener("click", function () {
        if (!navigator.geolocation) {
          return alert("Geolocation not supported by this browser.");
        }
        btn.disabled = true;
        btn.innerText = "Locating...";
        navigator.geolocation.getCurrentPosition(
          function (pos) {
            const coords = {
              type: "Point",
              coordinates: [
                Number(pos.coords.longitude),
                Number(pos.coords.latitude),
              ],
            };
            if (geoField) geoField.value = JSON.stringify(coords);
            if (locInput)
              locInput.value = `${pos.coords.latitude.toFixed(6)}, ${pos.coords.longitude.toFixed(6)}`;
            btn.disabled = false;
            btn.innerText = "Use current location";
          },
          function (err) {
            alert("Unable to get location: " + (err && err.message));
            btn.disabled = false;
            btn.innerText = "Use current location";
          },
          { enableHighAccuracy: true, timeout: 10000 },
        );
      });
    })();

    // Search + Filter functionality (applies to card layout)
    const staffSearch = document.getElementById("staffSearch");
    const staffFilterRole =
      document.getElementById("staffFilterRole");

    function debounce(fn, wait = 160) {
      let t;
      return function (...args) {
        clearTimeout(t);
        t = setTimeout(() => fn.apply(this, args), wait);
      };
    }

    function filterStaffList() {
      const search = ((staffSearch && staffSearch.value) || "")
        .trim()
        .toLowerCase();
      const role = ((staffFilterRole && staffFilterRole.value) || "")
        .trim()
        .toLowerCase();

      staffFiltered = staffData.filter((u) => {
        const n = (
          ((u.firstName || "") + " " + (u.lastName || "")).trim() ||
          u.name ||
          ""
        ).toLowerCase();
        const e = (u.email || "").toLowerCase();
        const r = (u.role || "").toString().toLowerCase();
        const matchesSearch = !search || n.includes(search) || e.includes(search);
        const matchesRole = !role || r === role;
        return matchesSearch && matchesRole;
      });

      currentPage = 1;
      renderPage(1, staffFiltered);
    }

    function renderPage(page, items) {
      const start = (page - 1) * pageSize;
      const slice = items.slice(start, start + pageSize);
      if (!slice.length) {
        el("staffCards").innerHTML =
          '<div class="small text-muted">No staff match your search/filter.</div>';
        staffFooter.innerHTML =
          '<nav aria-label="Staff pagination"><ul class="inv-pagination justify-content-end mb-0"><li class="page-item disabled"><a class="page-link" href="javascript:void(0)">‹ Prev</a></li><li class="page-item active"><span class="page-link">1 / 1</span></li><li class="page-item disabled"><a class="page-link" href="javascript:void(0)">Next ›</a></li></ul></nav>';
        return;
      }
      el("staffCards").innerHTML = slice.map(renderItem).join("");
      renderPagination(page, Math.ceil(items.length / pageSize) || 1, items.length);
    }

    function renderPagination(page, pages, total) {
      const disabled = total === 0;
      const nav = `<nav aria-label="Staff pagination">
  <ul class="inv-pagination justify-content-end mb-0">
    <li class="page-item ${page <= 1 || disabled ? 'disabled' : ''}">
      <a class="page-link" href="javascript:void(0)" data-page="${page - 1}">‹ Prev</a>
    </li>
    <li class="page-item active">
      <span class="page-link">${disabled ? '1 / 1' : `${page} / ${pages}`}</span>
    </li>
    <li class="page-item ${page >= pages || disabled ? 'disabled' : ''}">
      <a class="page-link" href="javascript:void(0)" data-page="${page + 1}">Next ›</a>
    </li>
  </ul>
</nav>`;
      staffFooter.innerHTML = nav;
      staffFooter.querySelectorAll('.page-link[data-page]').forEach(el => {
        el.addEventListener('click', e => {
          e.preventDefault();
          const target = e.target.closest('.page-link');
          const newPage = parseInt(target?.dataset.page);
          if (!target?.closest('.page-item.disabled') && newPage >= 1 && newPage <= pages) {
            currentPage = newPage;
            renderPage(currentPage, staffFiltered);
          }
        });
      });
    }

    // attach listeners with safe fallbacks (works even if elements are missing / loaded later)
    const debouncedFilter = debounce(filterStaffList, 160);
    if (staffSearch) {
      staffSearch.addEventListener("input", debouncedFilter);
    } else {
      document.addEventListener("input", function (ev) {
        if (ev.target && ev.target.id === "staffSearch")
          debouncedFilter();
      });
    }
    if (staffFilterRole) {
      staffFilterRole.addEventListener("change", debouncedFilter);
    } else {
      document.addEventListener("change", function (ev) {
        if (ev.target && ev.target.id === "staffFilterRole")
          debouncedFilter();
      });
    }
    if (!staffSearch && !staffFilterRole)
      console.warn("Staff list: filter elements not found on page.");

    // make role badges clickable: clicking a badge will set/toggle the role filter
    document
      .getElementById("staffCards")
      .addEventListener("click", function (ev) {
        const badge =
          ev.target.closest && ev.target.closest(".staff-role-tag");
        if (!badge) return;
        const clickedRole = (badge.dataset.role || "")
          .toString()
          .trim()
          .toLowerCase();
        if (!clickedRole) return;
        if (staffFilterRole.value === clickedRole) {
          staffFilterRole.value = "";
        } else {
          staffFilterRole.value = clickedRole;
        }
        debouncedFilter();
      });

    // ── View Staff click handler ──
    document.getElementById("staffCards").addEventListener("click", function (ev) {
      var btn = ev.target.closest && ev.target.closest(".view-staff");
      if (!btn) return;
      var id = btn.dataset.id;
      if (!id) return;

      fetch("/api/admin/staff/" + id)
        .then(function (r) { return r.json(); })
        .then(function (j) {
          if (!j || j.error) { window.notify.error("Failed to load staff"); return; }
          var u = j.staff;
          var name = ((u.firstName || "") + " " + (u.lastName || "")).trim() || u.email || "";
          document.getElementById("viewStaffName").innerText = name;
          document.getElementById("viewStaffRole").innerText = (u.role || "").charAt(0).toUpperCase() + (u.role || "").slice(1);
          document.getElementById("viewStaffEmail").innerText = u.email || "—";
          document.getElementById("viewStaffPhone").innerText = u.phone || "—";

          var statusEl = document.getElementById("viewStaffStatus");
          if (u.active !== false) {
            statusEl.innerHTML = '<span style="font-size:0.72rem;font-weight:600;padding:0.15rem 0.6rem;border-radius:999px;background:rgba(34,197,94,0.12);color:#16a34a;">Active</span>';
          } else {
            statusEl.innerHTML = '<span style="font-size:0.72rem;font-weight:600;padding:0.15rem 0.6rem;border-radius:999px;background:rgba(239,68,68,0.10);color:#dc2626;">Inactive</span>';
          }

          document.getElementById("viewStaffCreated").innerText = u.createdAt ? new Date(u.createdAt).toLocaleDateString("en-PH", { year: "numeric", month: "short", day: "numeric" }) : "—";

          var avatarEl = document.getElementById("viewStaffAvatar");
          var seed = String(u._id || u.email || name);
          var hue = 0;
          for (var i = 0; i < seed.length; i++) { hue += seed.charCodeAt(i); }
          hue = hue % 360;
          avatarEl.style.background = "hsl(" + hue + ", 65%, 50%)";
          var initial = (u.firstName || "")[0] || (u.name || "")[0] || "U";
          avatarEl.innerText = initial.toUpperCase();

          new bootstrap.Modal(document.getElementById("viewStaffModal")).show();
        })
        .catch(function () { window.notify.error("Failed to load staff"); });
    });

    // ── Edit Staff click handler ──
    document.getElementById("staffCards").addEventListener("click", function (ev) {
      var btn = ev.target.closest && ev.target.closest(".edit-staff");
      if (!btn) return;
      var id = btn.dataset.id;
      if (!id) return;

      fetch("/api/admin/staff/" + id)
        .then(function (r) { return r.json(); })
        .then(function (j) {
          if (!j || j.error) { window.notify.error("Failed to load staff"); return; }
          var u = j.staff;
          document.getElementById("editStaffId").value = u._id;
          document.getElementById("editStaffFirst").value = u.firstName || "";
          document.getElementById("editStaffLast").value = u.lastName || "";
          document.getElementById("editStaffEmail").value = u.email || "";
          document.getElementById("editStaffPhone").value = u.phone || "";
          document.getElementById("editStaffRole").value = u.role || "secretary";
          document.getElementById("editStaffActive").value = u.active !== false ? "true" : "false";

          var name = ((u.firstName || "") + " " + (u.lastName || "")).trim() || u.email || "";
          document.getElementById("editStaffSubtitle").innerText = "Editing " + name;

          new bootstrap.Modal(document.getElementById("editStaffModal")).show();
        })
        .catch(function () { window.notify.error("Failed to load staff"); });
    });

    // ── Save Edit ──
    document.getElementById("saveEditStaffBtn").addEventListener("click", function () {
      var id = document.getElementById("editStaffId").value;
      if (!id) return;
      var payload = {
        firstName: document.getElementById("editStaffFirst").value.trim(),
        lastName: document.getElementById("editStaffLast").value.trim(),
        email: document.getElementById("editStaffEmail").value.trim(),
        phone: document.getElementById("editStaffPhone").value.trim(),
        role: document.getElementById("editStaffRole").value,
        active: document.getElementById("editStaffActive").value === "true",
      };

      fetch("/api/admin/staff/" + id, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify(payload),
      })
        .then(function (r) {
          return r.text().then(function (t) { return { ok: r.ok, status: r.status, body: t }; });
        })
        .then(function (res) {
          console.log("PATCH response", res);
          if (!res.ok) throw new Error("Status " + res.status + ": " + res.body);
          var j = JSON.parse(res.body);
          window.notify.success("Staff updated (modified: " + (j.modified || "?") + ")");
          var modal = bootstrap.Modal.getInstance(document.getElementById("editStaffModal"));
          if (modal) modal.hide();
          loadStaff();
        })
        .catch(function (err) {
          console.error("PATCH error", err);
          window.notify.error("Failed: " + err.message);
        });
    });

    // load staff after filter handlers are in place so loadStaff can re-apply active filters
    loadStaff();
  })();
</script>
