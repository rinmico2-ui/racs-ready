  <%- include('../../partials/kpi-cards', { 
    kpiItems: [
      { id: 'kpiEntries', icon: 'bi bi-tools', label: 'Total Tools', variant: 'primary' },
      { id: 'kpiQty', icon: 'bi bi-box-seam', label: 'Total Quantity', variant: 'info' },
