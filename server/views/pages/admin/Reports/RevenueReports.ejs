        options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { grid: { color: '#f1f5f9' }, ticks: { callback: value => pesoFmt(value), font: { size: 10 } } }, y: { grid: { display: false }, ticks: { font: { size: 10 } } } }, plugins: { legend: { display: false }, tooltip: tooltipFmt } }
