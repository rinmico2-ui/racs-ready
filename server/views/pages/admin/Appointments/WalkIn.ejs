      if (state.map) {
        setTimeout(() => state.map && state.map.invalidateSize(), 120);
        return;
      }

      state.map = L.map(el, { zoomControl: false, scrollWheelZoom: false, preferCanvas: true })
        .setView([state.techCoords.lat, state.techCoords.lng], 13);
      const streets = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>', maxZoom: 19,
      }).addTo(state.map);
      const satelliteImagery = L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", { attribution: "Tiles &copy; Esri", maxZoom: 19 });
      const satelliteLabels = L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}", { attribution: "Labels &copy; Esri", maxZoom: 19 });
      L.control.zoom({ position: "bottomright" }).addTo(state.map);
      L.control.scale({ position: "bottomleft", imperial: false, maxWidth: 120 }).addTo(state.map);
      L.control.layers({ "Detailed streets": streets, "Satellite + labels": L.layerGroup([satelliteImagery, satelliteLabels]) }, null, { position: "topright", collapsed: true }).addTo(state.map);

      const companyIcon = L.divIcon({
        html: '<div style="background:#2563eb;border:3px solid #fff;border-radius:50% 50% 50% 0;width:30px;height:30px;transform:rotate(-45deg);box-shadow:0 2px 8px rgba(0,0,0,.3)"><span style="display:block;background:#fff;border-radius:50%;width:10px;height:10px;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)"></span></div>',
        className: "walkin-company-marker", iconSize: [40, 40], iconAnchor: [20, 40], popupAnchor: [0, -38],
      });
      state.customerIcon = L.divIcon({
        html: '<div style="background:#16a34a;border:3px solid #fff;border-radius:50% 50% 50% 0;width:38px;height:38px;transform:rotate(-45deg);box-shadow:0 2px 8px rgba(0,0,0,.3)"><span style="display:block;background:#fff;border-radius:50%;width:12px;height:12px;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)"></span></div>',
        className: "walkin-customer-marker", iconSize: [44, 44], iconAnchor: [22, 44], popupAnchor: [0, -42],
      });

      state.markers.tech = L.marker([state.techCoords.lat, state.techCoords.lng], { icon: companyIcon })
        .addTo(state.map)
        .bindPopup(`<strong>CALIDRO RACS</strong><br><small>${escapeMarkup(state.companyAddress)}</small>`)
        .bindTooltip("CALIDRO RACS", { direction: "top", offset: [0, -32] });

      state.map.on("click", (e) => {
        const coords = { lat: e.latlng.lat, lng: e.latlng.lng };
        locationInputEl.value = `${coords.lat.toFixed(6)}, ${coords.lng.toFixed(6)}`;
        setCustomerCoords(coords, "Service pin selected on map.", "", "Map selection");
        reverseGeocodeWalkin(coords, "Confirmed map location");
      });

      setTimeout(() => state.map && state.map.invalidateSize(), 180);
    }

    function setLocationStatus(text, type) {
      const icon = type === "success" ? "check-circle-fill" : type === "danger" ? "exclamation-triangle-fill" : type === "info" ? "arrow-repeat" : "shield-lock";
      locationStatusEl.className = `location-hint mb-0 mt-2 text-${type || "muted"}`;
      locationStatusEl.innerHTML = `<i class="bi bi-${icon} me-1"></i>${escapeMarkup(text)}`;
    }

    function updateServiceMapSelection(coords, address, source) {
      serviceMapSelectionEl?.classList.add("has-location");
      const status = document.getElementById("serviceMapSelectionStatus");
      const addressEl = document.getElementById("serviceMapAddress");
      const coordinatesEl = document.getElementById("serviceMapCoordinates");
      const sourceEl = document.getElementById("serviceMapSource");
      const fitButton = document.getElementById("fitServiceRouteBtn");
      if (status) status.textContent = "Service pin confirmed";
      if (addressEl) addressEl.textContent = address || "Resolving the selected street address...";
      if (coordinatesEl) coordinatesEl.textContent = `${Number(coords.lat).toFixed(6)}, ${Number(coords.lng).toFixed(6)}`;
      if (sourceEl) sourceEl.textContent = source || "Map selection";
      if (fitButton) fitButton.disabled = false;
    }

    async function reverseGeocodeWalkin(coords, source) {
      try {
        const response = await fetch(`/api/geocoding/reverse?lat=${encodeURIComponent(coords.lat)}&lon=${encodeURIComponent(coords.lng)}`);
        const result = await response.json();
        if (!response.ok || !result.display_name) return;
        if (!state.customerCoords || state.customerCoords.lat !== coords.lat || state.customerCoords.lng !== coords.lng) return;
        locationInputEl.value = result.display_name;
        updateServiceMapSelection(coords, result.display_name, source || "Confirmed map location");
        state.markers.customer?.setPopupContent(`<strong>Service Location</strong><br><small>${escapeMarkup(result.display_name)}</small>`);
      } catch (error) {
        console.warn("Walk-in reverse geocoding failed", error && error.message);
      }
    }

    function setCustomerCoords(coords, message, address = "", source = "Map selection") {
      state.customerCoords = coords;
      if (state.map && window.L) {
        if (!state.markers.customer) {
          state.markers.customer = L.marker([coords.lat, coords.lng], { icon: state.customerIcon, draggable: true, keyboard: true, title: "Service location" })
            .addTo(state.map)
            .bindPopup("Service Location")
            .bindTooltip("Service location", { direction: "top", offset: [0, -36] });
          state.markers.customer.on("dragend", () => {
            const point = state.markers.customer.getLatLng();
            const dragged = { lat: point.lat, lng: point.lng };
            locationInputEl.value = `${dragged.lat.toFixed(6)}, ${dragged.lng.toFixed(6)}`;
            setCustomerCoords(dragged, "Dragged service pin confirmed.", "", "Dragged service pin");
            reverseGeocodeWalkin(dragged, "Dragged service pin");
          });
        } else {
          state.markers.customer.setLatLng([coords.lat, coords.lng]);
        }
        state.markers.customer.setPopupContent(`<strong>Service Location</strong><br><small>${escapeMarkup(address || `${coords.lat.toFixed(6)}, ${coords.lng.toFixed(6)}`)}</small>`);
        updateServiceMapSelection(coords, address, source);
        updateRouteAndFare();
        const bounds = L.latLngBounds([
          state.markers.tech.getLatLng(),
          state.markers.customer.getLatLng(),
        ]);
        state.map.fitBounds(bounds, { padding: [70, 70] });
      }
      setLocationStatus(message || "Customer location set.", "success");
      updateSummary();
    }

    async function updateRouteAndFare() {
      if (!state.markers.tech || !state.markers.customer) return;
      const t = state.markers.tech.getLatLng();
      const c = state.markers.customer.getLatLng();
      const coords = `${t.lng},${t.lat};${c.lng},${c.lat}`;
      if (serviceRouteMethodEl) serviceRouteMethodEl.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Calculating road route';

      try {
        const r = await fetch(
          `/api/services/osrm-route?coords=${encodeURIComponent(coords)}`,
          { cache: "no-store" },
        );
        if (!r.ok) throw new Error("route");
        const j = await r.json();
        const route = (j.routes && j.routes[0]) || null;
        if (
          !route ||
          !route.geometry ||
          !Array.isArray(route.geometry.coordinates)
        )
          throw new Error("route");

        const points = route.geometry.coordinates.map((p) => [p[1], p[0]]);
        if (state.route) state.route.setLatLngs(points);
        else
          state.route = L.polyline(points, {
            color: "#2563eb",
            weight: 5,
            opacity: .9,
          }).addTo(state.map);

        const km = Number(route.distance || 0) / 1000;
        const etaMins = Math.round(Number(route.duration || 0) / 60);
        state.travelFare = Number((km * state.farePerKm).toFixed(2));
        state.travelTime = etaMins > 0 ? etaMins : 0;
        if (mapInfoDistanceEl) mapInfoDistanceEl.textContent = `${km.toFixed(1)} km`;
        if (mapInfoDurationEl) mapInfoDurationEl.textContent = `~${etaMins} min`;
        if (mapInfoFareEl) mapInfoFareEl.textContent = `₱${state.travelFare.toFixed(2)}`;
        if (serviceRouteMethodEl) serviceRouteMethodEl.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Road route calculated';
        mapDistanceInfoEl.textContent = `Road distance: ${km.toFixed(1)} km • ETA: ~${etaMins} min • Fare: ₱${state.travelFare.toFixed(2)}`;
        updateSummary();
        if (state.selectedDate) renderTimeSlotsForDate(state.selectedDate);
        return;
      } catch (e) {}

      const R = 6371;
      const dLat = ((c.lat - t.lat) * Math.PI) / 180;
      const dLon = ((c.lng - t.lng) * Math.PI) / 180;
      const a =
        Math.sin(dLat / 2) ** 2 +
        Math.cos((t.lat * Math.PI) / 180) *
          Math.cos((c.lat * Math.PI) / 180) *
          Math.sin(dLon / 2) ** 2;
      const km = R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));

      if (state.route)
        state.route.setLatLngs([
          [t.lat, t.lng],
          [c.lat, c.lng],
        ]);
      else
        state.route = L.polyline(
          [
            [t.lat, t.lng],
            [c.lat, c.lng],
          ],
          { color: "#2563eb", weight: 4, dashArray: "10, 10" },
        ).addTo(state.map);

      state.travelFare = Number((km * state.farePerKm).toFixed(2));
      state.travelTime = 0;
      if (mapInfoDistanceEl) mapInfoDistanceEl.textContent = `${km.toFixed(1)} km`;
      if (mapInfoDurationEl) mapInfoDurationEl.textContent = "Estimate unavailable";
      if (mapInfoFareEl) mapInfoFareEl.textContent = `₱${state.travelFare.toFixed(2)}`;
      if (serviceRouteMethodEl) serviceRouteMethodEl.innerHTML = '<i class="bi bi-info-circle me-1"></i>Straight-line fallback';
      mapDistanceInfoEl.textContent = `Distance (approx): ${km.toFixed(1)} km • Fare: ₱${state.travelFare.toFixed(2)}`;
      updateSummary();
      if (state.selectedDate) renderTimeSlotsForDate(state.selectedDate);
    }

