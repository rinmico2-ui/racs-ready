            <div class="ent-detail-card-icon" style="background:#f5f3ff;color:#7c3aed;"><i class="bi bi-wrench"></i></div>
            <div class="ent-detail-card-content"><div class="ent-detail-card-label">Service</div><div class="ent-detail-card-value">${b.service?.name || (Array.isArray(b.services)&&b.services.length ? b.services.map(s=>s.name).join(', ') : (b.serviceModel === 'RepairService' ? 'Repair Service' : 'N/A'))}</div></div>
          </div>
          ${Array.isArray(b.services) && b.services.length > 0 ? `
          <div class="ent-detail-card ent-detail-card-wide">
            <div class="ent-detail-card-icon" style="background:#dbeafe;color:#2563eb;"><i class="bi bi-box-seam"></i></div>
            <div class="ent-detail-card-content" style="width:100%;">
              <div class="ent-detail-card-label">Unit Details (${b.services.length} item${b.services.length>1?'s':''})</div>
              ${b.services.map(function(s,i){
                var t=s.applianceTypeName||s.airconTypeName||s.applianceType||s.airconType||'—';
                var bnd=s.brand||'—';
                var q=Number(s.quantity)||1;
                var h=s.hpDescription||(s.hp?s.hp+' HP':'—');
                var sn=s.name||('Service '+(i+1));
                var model=s.model||'—';
                var issue=s.problemDescription||s.repairIssue||s.issueDescription||'';
                var stBadge=s.type==='repair'?'background:#fef3c7;color:#92400e;':'background:#dbeafe;color:#1e40af;';
                return '<div style="padding:10px 0;border-bottom:1px solid rgba(226,232,240,0.5);">'+
                  '<div style="display:flex;align-items:center;justify-content:space-between;">'+
                    '<div style="font-weight:600;font-size:0.82rem;color:#1e293b;">'+sn+'</div>'+
                    '<span style="'+stBadge+'padding:3px 8px;border-radius:6px;font-size:0.65rem;font-weight:600;">'+(s.type||'core').toUpperCase()+'</span>'+
                  '</div>'+
                  '<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:6px;margin-top:6px;">'+
                    '<div><span style="font-size:0.65rem;color:#64748b;">Type</span><div style="font-size:0.78rem;color:#334155;font-weight:500;">'+t+'</div></div>'+
                    '<div><span style="font-size:0.65rem;color:#64748b;">Brand</span><div style="font-size:0.78rem;color:#334155;font-weight:500;">'+bnd+'</div></div>'+
                    '<div><span style="font-size:0.65rem;color:#64748b;">Model</span><div style="font-size:0.78rem;color:#334155;font-weight:500;">'+model+'</div></div>'+
                    '<div><span style="font-size:0.65rem;color:#64748b;">HP / Qty</span><div style="font-size:0.78rem;color:#334155;font-weight:500;">'+h+' / '+q+'</div></div>'+
                  '</div>'+
                  (issue?'<div style="margin-top:6px;"><span style="font-size:0.65rem;color:#64748b;">Problem</span><div style="font-size:0.75rem;color:#475569;line-height:1.4;">'+issue+'</div></div>':'')+
                '</div>';
              }).join('')}
            </div>
          </div>` : ''}
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon" style="background:#eff6ff;color:#1d4ed8;"><i class="bi bi-calendar-check"></i></div>
            <div class="ent-detail-card-content"><div class="ent-detail-card-label">Scheduled</div><div class="ent-detail-card-value">${date} ${b.startTime ? 'at ' + b.startTime : ''}</div></div>
          </div>
          ${b.technician?.name ? `
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon" style="background:#fffbeb;color:#b45309;"><i class="bi bi-person-badge"></i></div>
            <div class="ent-detail-card-content"><div class="ent-detail-card-label">Technician</div><div class="ent-detail-card-value">${b.technician.name}</div></div>
          </div>` : ''}
          ${b.totalPrice ? `
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon" style="background:#f0fdf4;color:#15803d;"><i class="bi bi-cash"></i></div>
            <div class="ent-detail-card-content"><div class="ent-detail-card-label">Estimated Fee</div><div class="ent-detail-card-value">₱${b.totalPrice.toLocaleString()}</div></div>
          </div>` : ''}
          <div class="ent-detail-card ent-detail-card-wide">
            <div class="ent-detail-card-icon" style="background:#fee2e2;color:#991b1b;"><i class="bi bi-geo-alt"></i></div>
            <div class="ent-detail-card-content"><div class="ent-detail-card-label">Address</div><div class="ent-detail-card-value" style="white-space:pre-line;">${b.location?.address || 'N/A'}</div></div>
          </div>
          ${b.rescheduleReason ? `
          <div class="ent-detail-card ent-detail-card-wide" style="background:#fffbeb;border-color:#fde68a;">
            <div class="ent-detail-card-icon" style="background:#fef3c7;color:#b45309;"><i class="bi bi-info-circle"></i></div>
            <div class="ent-detail-card-content"><div class="ent-detail-card-label">Attention Reason</div><div class="ent-detail-card-value" style="color:#b45309;">${b.rescheduleReason}</div></div>
          </div>` : ''}
          ${b.proposedReschedule?.status === 'pending' ? `
          <div class="ent-detail-card ent-detail-card-wide" style="background:#eff6ff;border-color:#bfdbfe;">
            <div class="ent-detail-card-icon" style="background:#dbeafe;color:#1d4ed8;"><i class="bi bi-calendar-check"></i></div>
            <div class="ent-detail-card-content"><div class="ent-detail-card-label">Proposed Reschedule</div><div class="ent-detail-card-value" style="color:#1d4ed8;">${b.proposedReschedule.dateLabel || new Date(b.proposedReschedule.date).toLocaleDateString('en-PH')} at ${b.proposedReschedule.timeLabel || b.proposedReschedule.time} — awaiting customer confirmation</div></div>
          </div>` : ''}
          ${b.proposedReschedule?.status === 'new_requested' ? `
          <div class="ent-detail-card ent-detail-card-wide" style="background:#fffbeb;border-color:#fde68a;">
            <div class="ent-detail-card-icon" style="background:#fef3c7;color:#b45309;"><i class="bi bi-calendar-event"></i></div>
            <div class="ent-detail-card-content"><div class="ent-detail-card-label">Customer Requests New Schedule</div><div class="ent-detail-card-value" style="color:#b45309;">${b.rescheduleRequest?.requestedDate} at ${b.rescheduleRequest?.requestedTime}${b.rescheduleRequest?.reason ? ' — ' + b.rescheduleRequest.reason : ''}</div></div>
          </div>` : ''}
        </div>`;
    } catch (e) {
      body.innerHTML = `<div class="text-center text-danger py-4">${e.message || 'Failed to load details'}</div>`;
    }
  }

  /* ══════════════════════════════════════════════════════════════════════════
     RESOLVE MENU — 3-option decision for past-date bookings
     ══════════════════════════════════════════════════════════════════════════ */

  let resolveBookingId = null;
  let resolveRef = '';
  let resolveDuration = 60;
  let resolvePrice = 0;
  let resolvePaid = 0;
  let resolvePhone = '';
  let resolveEmail = '';
  let resolveCustomer = 'Customer';

  function renderResolveContactActions() {
    const panel = document.getElementById('resolveContactPanel');
    const target = document.getElementById('resolveContactActions');
    if (!panel || !target) return;
    const phoneHref = contactPhoneHref(resolvePhone);
    const emailHref = contactEmailHref(resolveEmail);
    const links = [];
    if (phoneHref) links.push(`<button type="button" class="btn btn-sm btn-outline-success" onclick="openCustomerCall(decodeURIComponent('${contactInlineArg(resolvePhone)}'),decodeURIComponent('${contactInlineArg(resolveCustomer)}'),decodeURIComponent('${contactInlineArg(resolveRef)}'))"><i class="bi bi-telephone-fill me-1"></i>Call ${escapeHtml(resolvePhone)}</button>`);
    if (emailHref) links.push(`<button type="button" class="btn btn-sm btn-outline-primary" onclick="openCustomerEmail(decodeURIComponent('${contactInlineArg(resolveEmail)}'),decodeURIComponent('${contactInlineArg(resolveCustomer)}'),decodeURIComponent('${contactInlineArg(resolveRef)}'))"><i class="bi bi-envelope-fill me-1"></i>Email ${escapeHtml(resolveEmail)}</button>`);
    target.innerHTML = links.join('');
    panel.classList.toggle('d-none', links.length === 0);
  }

  function openResolveMenu(id, ref, duration, price, paid, issueType, phone = '', email = '', customer = 'Customer') {
    resolveBookingId = id;
    resolveRef = ref;
    resolveDuration = duration;
    resolvePrice = price;
    resolvePaid = paid;
    resolvePhone = phone;
    resolveEmail = email;
    resolveCustomer = customer;
    renderResolveContactActions();
    document.getElementById('resolveMenuError')?.classList.add('d-none');
    const modal = new bootstrap.Modal(document.getElementById('resolveMenuModal'));
    modal.show();
  }

  function handleResolveAction(action) {
    const modalEl = document.getElementById('resolveMenuModal');
    const modal = bootstrap.Modal.getInstance(modalEl);
    modal.hide();

    if (action === 'send_link') {
      sendCustomerRescheduleLink(resolveBookingId, resolveRef);
    } else if (action === 'admin_schedule') {
      openReschedule(resolveBookingId, resolveRef, resolveDuration, 'standard', 'past_date');
    } else if (action === 'cancel') {
      openCancelModal(resolveBookingId, resolveRef, resolvePaid);
    }
  }

  async function sendCustomerRescheduleLink(bookingId, ref) {
    const btn = event.target.closest('button');
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sending...'; }
    try {
      const res = await fetch(`/api/reschedule/${bookingId}/send-link`, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to send reschedule link');
      showToast('success', 'Reschedule link sent!', `A reschedule link has been sent to the customer for ${ref}.`);
    } catch (err) {
      showToast('error', 'Failed to send link', err.message);
    } finally {
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-link-45deg me-1"></i>Send Reschedule Link'; }
    }
  }

  /* ══════════════════════════════════════════════════════════════════════════
     CANCEL WITH REFUND MODAL
     ══════════════════════════════════════════════════════════════════════════ */

  function openCancelModal(bookingId, ref, paidAmount) {
    resolvePaid = 0;
    document.getElementById('cancelBookingId').value = bookingId;
    document.getElementById('cancelRefLabel').textContent = ref;
    document.getElementById('cancelAmountPaid').textContent = 'Loading actual payment…';
    document.getElementById('cancelReasonType').value = '';
    document.getElementById('cancelNotes').value = '';
    document.getElementById('refundNone').checked = true;
    document.getElementById('partialRefundAmount').value = '';
    document.getElementById('refundMethod').value = 'original';
    document.getElementById('refundNotes').value = '';
    clearCancelError();
    document.getElementById('cancelPaymentNotice')?.classList.add('d-none');
    document.getElementById('verifyPaymentConfirm')?.classList.add('d-none');
    document.getElementById('verifyPendingPaymentBtn')?.classList.remove('d-none');
    document.getElementById('cancelAmountPaid')?.classList.remove('text-danger', 'text-success');
    updateRefundUI();
    const modal = new bootstrap.Modal(document.getElementById('cancelRefundModal'));
    modal.show();

    // Fetch verified and pending amounts separately from the payment ledger.
    fetch(`/api/admin/resolution-center/${bookingId}/payment-summary`)
      .then(r => r.json())
      .then(summary => {
        if (!summary || summary.success === false) throw new Error(summary?.error || 'Failed to load');
        renderRefundPaymentSummary(summary);
      })
      .catch(() => {
        // Never enable a refund from the configured booking amount alone.
        resolvePaid = 0;
        document.getElementById('cancelAmountPaid').textContent = 'Unable to load the verified payment ledger';
        document.getElementById('cancelAmountPaid').classList.add('text-danger');
        document.getElementById('refundNone').checked = true;
        updateRefundUI();
        showCancelError('Payment ledger unavailable', 'The verified payment could not be loaded. Refund options remain disabled; retry by reopening this dialog.');
      });
  }

  function showCancelError(title, message, fieldId) {
    const errorEl = document.getElementById('cancelError');
    document.getElementById('cancelErrorTitle').textContent = title || 'Unable to continue';
    document.getElementById('cancelErrorMessage').textContent = message || 'Review the form and try again.';
    errorEl.classList.remove('d-none');
    if (fieldId) document.getElementById(fieldId)?.classList.add('is-invalid');
    requestAnimationFrame(() => {
      errorEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      errorEl.focus({ preventScroll: true });
    });
  }

  function clearCancelError(fieldId) {
    document.getElementById('cancelError')?.classList.add('d-none');
    if (fieldId) {
      document.getElementById(fieldId)?.classList.remove('is-invalid');
    } else {
      document.querySelectorAll('#cancelRefundModal .is-invalid').forEach(el => el.classList.remove('is-invalid'));
    }
  }

  function renderRefundPaymentSummary(summary) {
    resolvePaid = Number(summary.amountPaid) || 0;
    const submittedAmount = Number(summary.submittedAmount) || 0;
    const labelEl = document.getElementById('cancelAmountPaid');
    const noticeEl = document.getElementById('cancelPaymentNotice');
    const noticeText = document.getElementById('cancelPaymentNoticeText');
    const verifyBtn = document.getElementById('verifyPendingPaymentBtn');
    labelEl.classList.remove('text-danger', 'text-success');
    noticeEl.classList.add('d-none');
    hidePaymentVerificationConfirm();

    if (resolvePaid > 0) {
      labelEl.textContent = `₱${resolvePaid.toLocaleString()}${summary.alreadyRefunded > 0 ? ` (₱${Number(summary.alreadyRefunded).toLocaleString()} already refunded)` : ''}${summary.method ? ` via ${summary.method.toUpperCase()}` : ''}`;
      labelEl.classList.add('text-success');
      if (!document.querySelector('input[name="refundDecision"]:checked') || document.getElementById('refundNone').checked) {
        document.getElementById('refundFull').checked = true;
      }
    } else if (summary.requiresVerification && submittedAmount > 0) {
      labelEl.textContent = '₱0 verified';
      labelEl.classList.add('text-danger');
      noticeText.innerHTML = `<strong>₱${submittedAmount.toLocaleString()} was submitted</strong>${summary.method ? ` via ${summary.method.toUpperCase()}` : ''}, but it is still pending verification. Review the payment proof before enabling a refund.`;
      verifyBtn.disabled = false;
      verifyBtn.innerHTML = '<i class="bi bi-shield-check me-1"></i>Verify Submitted Payment';
      noticeEl.classList.remove('d-none');
      document.getElementById('refundNone').checked = true;
    } else {
      labelEl.textContent = '₱0 — no payment submission found for this booking';
      labelEl.classList.add('text-danger');
      document.getElementById('refundNone').checked = true;
    }
    updateRefundUI();
  }

  async function verifyPendingPaymentForRefund() {
    document.getElementById('verifyPendingPaymentBtn').classList.add('d-none');
    document.getElementById('verifyPaymentConfirm').classList.remove('d-none');
    document.getElementById('confirmVerifyPaymentBtn').focus();
  }

  function hidePaymentVerificationConfirm() {
    document.getElementById('verifyPaymentConfirm')?.classList.add('d-none');
    document.getElementById('verifyPendingPaymentBtn')?.classList.remove('d-none');
    const confirmBtn = document.getElementById('confirmVerifyPaymentBtn');
    if (confirmBtn) {
      confirmBtn.disabled = false;
      confirmBtn.innerHTML = '<i class="bi bi-check2 me-1"></i>Confirm Received';
    }
  }

  async function confirmPendingPaymentVerification() {
    const bookingId = document.getElementById('cancelBookingId').value;
    const btn = document.getElementById('confirmVerifyPaymentBtn');

    clearCancelError();
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Verifying...';
    try {
      const res = await fetch(`/api/admin/resolution-center/${bookingId}/verify-pending-payment`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({}),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to verify payment');
      renderRefundPaymentSummary(data);
      showToast('success', data.message || 'Payment verified.');
    } catch (err) {
      showCancelError('Payment verification failed', err.message || 'The submitted payment could not be verified. Review the proof and try again.');
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Confirm Received';
    }
  }

  function updateRefundUI() {
    const decision = document.querySelector('input[name="refundDecision"]:checked')?.value || 'none';
    const paidAmount = resolvePaid || 0;
    document.getElementById('refundFull').disabled = !(paidAmount > 0);
    document.getElementById('refundPartial').disabled = !(paidAmount > 0);
    document.getElementById('partialRefundGroup').classList.toggle('d-none', decision !== 'partial');
    document.getElementById('refundMethodGroup').classList.toggle('d-none', decision === 'none');
    document.getElementById('refundNotesGroup').classList.toggle('d-none', decision === 'none');
    if (decision === 'partial') {
      document.getElementById('partialRefundAmount').max = paidAmount;
      document.getElementById('partialRefundAmount').placeholder = paidAmount > 0 ? `Max ₱${paidAmount.toLocaleString()}` : 'No verified payment';
    }
  }

  async function submitCancellation(btn) {
    const bookingId = document.getElementById('cancelBookingId').value;
    const reasonType = document.getElementById('cancelReasonType').value;
    const notes = document.getElementById('cancelNotes').value.trim();
    const refundDecision = document.querySelector('input[name="refundDecision"]:checked')?.value || 'none';
    const partialAmount = document.getElementById('partialRefundAmount').value;
    const refundMethod = document.getElementById('refundMethod').value;
    const refundNotes = document.getElementById('refundNotes').value.trim();
    clearCancelError();
    if (!reasonType) {
      showCancelError('Cancellation reason required', 'Select why this booking is being cancelled before continuing.', 'cancelReasonType');
      return;
    }
    if (refundDecision !== 'none' && !(resolvePaid > 0)) {
      showCancelError('Payment verification required', 'There is no verified refundable amount. Verify the submitted payment first or choose No Refund.');
      return;
    }
    if (refundDecision === 'partial' && (!partialAmount || Number(partialAmount) <= 0)) {
      showCancelError('Refund amount required', 'Enter a partial refund amount greater than zero.', 'partialRefundAmount');
      return;
    }
    if (refundDecision === 'partial' && Number(partialAmount) > resolvePaid) {
      showCancelError('Refund amount is too high', `Enter an amount up to the verified refundable balance of ₱${resolvePaid.toLocaleString()}.`, 'partialRefundAmount');
      return;
    }

    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing...'; }

    try {
      const body = { reasonType, reason: notes || `Cancelled by admin (${reasonType})`, refundDecision, refundMethod, refundNotes };
      if (refundDecision === 'partial') body.refundAmount = Number(partialAmount);

      const res = await fetch(`/api/admin/resolution-center/${bookingId}/cancel-with-refund`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to cancel booking');

      const modalEl = document.getElementById('cancelRefundModal');
      const modal = bootstrap.Modal.getInstance(modalEl);
      modal.hide();

      showToast('success', 'Booking cancelled', data.message || 'The booking has been cancelled.');
      setTimeout(() => loadQueue(), 1200);
    } catch (err) {
      showCancelError('Cancellation could not be completed', err.message || 'The server did not accept this request. Nothing was changed.');
    } finally {
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-x-circle me-1"></i>Confirm Cancellation'; }
    }
  }

  /* ══════════════════════════════════════════════════════════════════════════
     RESCHEDULE — EnterpriseCalendar (same as core services page)
     ══════════════════════════════════════════════════════════════════════════ */

  async function openReschedule(id, ref, duration, mode = 'standard', issueType = '', quantity = 1) {
    rescheduleBookingId = id;
    rescheduleRef = ref;
    rescheduleMode = mode;
    rescheduleIssueType = issueType;

    const modalEl = document.getElementById('rescheduleModal');
    const body = document.getElementById('rescheduleBody');

    // Build the container structure that EnterpriseCalendar renders into
    body.innerHTML = `
      <div class="rsch-booking-info">
        <strong>Booking:</strong> ${escapeHtml(ref)} &nbsp;|&nbsp;
        <small>${issueType ? escapeHtml(ISSUE_BADGES[issueType]?.label || issueType) + ' &mdash; ' : ''}pick a future date and time for the new visit</small>
      </div>
      <div id="calendarGrid"></div>
      <div id="timeSelection" class="mt-3 d-none">
        <div id="timeSlots"></div>
      </div>
    `;

    new bootstrap.Modal(modalEl).show();

    // Initialize EnterpriseCalendar — same as core services page
    try {
      await EnterpriseCalendar.init({
        duration: duration || 60,
        quantity: Math.max(1, Number(quantity) || 1),
        mode: 'appointment',
        onSelect: rschOnCalendarSelect,
      });
    } catch (e) {
      console.error('EnterpriseCalendar init failed:', e);
    }
  }

  function rschOnCalendarSelect({ date, slot }) {
    if (!date || !slot) return;
    const dateStr = EnterpriseCalendar.formatDateKey(date);
    const timeLabel = slot.label || slot.startTime;
    const startTime = slot.startTime || slot.label;

    const actionLabel = rescheduleMode === 'no-show-review' ? 'Schedule the new visit' : 'Propose reschedule';
    if (!confirm(`${actionLabel} for ${date.toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })} at ${timeLabel}?`)) return;

    rschSubmitProposal(dateStr, startTime, timeLabel);
  }

  async function rschSubmitProposal(dateStr, startTime, timeLabel) {
    try {
      const endpoint = rescheduleMode === 'no-show-review'
        ? `/api/admin/no-show-review/${rescheduleBookingId}/reschedule`
        : `/api/admin/review-reschedule/${rescheduleBookingId}/reschedule`;
      const payload = rescheduleMode === 'no-show-review'
        ? { newDate: dateStr, newTime: startTime }
        : { date: dateStr, time: startTime, reason: 'New visit scheduled from Booking Resolution Center', issueType: rescheduleIssueType };
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok) {
        if (data.refreshSlots && window.EnterpriseCalendar) await EnterpriseCalendar.refresh();
        throw new Error(data.error || 'Reschedule failed');
      }
      bootstrap.Modal.getInstance(document.getElementById('rescheduleModal')).hide();
      alert(data.message || (rescheduleMode === 'no-show-review'
        ? 'No-show report resolved. The new visit is ready for technician assignment.'
        : 'Reschedule proposed. The customer has been notified via email and must confirm before a technician is assigned.'));
      loadQueue();
    } catch (e) {
      alert(e.message || 'Reschedule failed');
    }
  }

  async function confirmNoShow(id, allowCustomerReschedule, button) {
    const confirmationMessage = allowCustomerReschedule
      ? 'Confirm this customer as a no-show and send a 72-hour link so the customer can choose a new available schedule?'
      : 'Confirm and close this customer no-show? The configured no-show fee policy will be applied and no reschedule link will be sent.';
    if (!confirm(confirmationMessage)) return;
    const original = button ? button.innerHTML : '';
    if (button) {
      button.disabled = true;
      button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Confirming...';
    }
    try {
      const res = await fetch(`/api/admin/no-show-review/${id}/confirm`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ allowCustomerReschedule: allowCustomerReschedule === true })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to confirm no-show');
      alert(data.message || 'No-show confirmed.');
      await loadQueue();
      if (window.updateSidebarBadges) window.updateSidebarBadges();
    } catch (e) {
      alert(e.message || 'Failed to confirm no-show');
      if (button) {
        button.disabled = false;
        button.innerHTML = original;
      }
    }
  }

  async function closeCase(id, issueType) {
    const note = prompt('Resolution note (optional):', 'Reviewed and closed by admin');
    if (note === null) return;
    if (!confirm('Close this resolution case? The booking record and history will remain unchanged.')) return;
    try {
      const res = await fetch(`/api/admin/resolution-center/${id}/close`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ issueType, note: note.trim() })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to close case');
      await loadQueue();
      if (window.updateSidebarBadges) window.updateSidebarBadges();
    } catch (e) {
      alert(e.message || 'Failed to close case');
    }
  }

  async function reassignCase(id, issueType) {
    if (!confirm('Send this booking to the assignment queue for a new technician?')) return;
    try {
      const res = await fetch(`/api/admin/resolution-center/${id}/reassign`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ issueType })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to prepare reassignment');
      window.location.href = `/admin/appointments?tab=queue&assign=${id}`;
    } catch (e) {
      alert(e.message || 'Failed to prepare reassignment');
    }
  }

  function filterBy(btn, status) {
    currentFilter = status;
    const url = new URL(window.location.href);
    url.searchParams.delete('status');
    if (status) url.searchParams.set('issue', status);
    else url.searchParams.delete('issue');
    window.history.replaceState({}, '', url);
    document.querySelectorAll('.status-tab').forEach(t => { t.classList.remove('active', 'btn-primary'); t.classList.add('btn-outline-secondary'); });
    btn.classList.add('active', 'btn-primary');
    btn.classList.remove('btn-outline-secondary');
    renderQueue(currentFilter ? allResolutionCases.filter(item => item.issueType === currentFilter) : allResolutionCases);
  }

  async function approveReschedule(id) {
    if (!confirm('Accept the customer-requested schedule and proceed to assign a technician?')) return;
    try {
      const res = await fetch(`/api/appointments/${id}/reschedule-approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Approve failed');
      window.location.href = `/admin/appointments/queue?assign=${id}`;
    } catch (e) {
      alert(e.message || 'Failed to approve reschedule');
    }
  }

  async function rejectReschedule(id) {
    const reason = prompt('Reason for rejecting the reschedule request:');
    if (reason === null) return;
    try {
      const res = await fetch(`/api/appointments/${id}/reschedule-reject`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: reason.trim() })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Reject failed');
      loadQueue();
    } catch (e) {
      alert(e.message || 'Failed to reject reschedule');
    }
  }

  document.getElementById('resolutionIssue').value = currentFilter;
  document.getElementById('resolutionSeverity').value = currentSeverity;
  document.getElementById('resolutionSearch').value = currentSearch;
  document.querySelectorAll('.rc-domain-tab').forEach(tab => {
    const selected = tab.dataset.source === currentSource;
    tab.classList.toggle('active', selected);
    tab.setAttribute('aria-selected', selected ? 'true' : 'false');
    tab.addEventListener('click', () => {
      currentSource = tab.dataset.source || '';
      currentPage = 1;
      document.querySelectorAll('.rc-domain-tab').forEach(item => { item.classList.remove('active'); item.setAttribute('aria-selected','false'); });
      tab.classList.add('active');
      tab.setAttribute('aria-selected','true');
      loadQueue();
    });
  });
  document.getElementById('resolutionIssue').addEventListener('change', event => { currentFilter = event.target.value; currentPage = 1; loadQueue(); });
  document.getElementById('resolutionSeverity').addEventListener('change', event => { currentSeverity = event.target.value; currentPage = 1; loadQueue(); });
  let searchTimer;
  document.getElementById('resolutionSearch').addEventListener('input', event => {
    currentSearch = event.target.value;
    currentPage = 1;
    clearTimeout(searchTimer);
    searchTimer = setTimeout(loadQueue, 350);
  });
  document.getElementById('resolutionClear').addEventListener('click', () => {
    currentSource = ''; currentFilter = ''; currentSeverity = ''; currentSearch = ''; currentPage = 1;
    document.getElementById('resolutionIssue').value = '';
    document.getElementById('resolutionSeverity').value = '';
    document.getElementById('resolutionSearch').value = '';
    document.querySelectorAll('.rc-domain-tab').forEach(tab => { const selected = !tab.dataset.source; tab.classList.toggle('active', selected); tab.setAttribute('aria-selected', selected ? 'true' : 'false'); });
    loadQueue();
  });
  document.getElementById('resolutionRefresh').addEventListener('click', loadQueue);
  loadQueue();
</script>
