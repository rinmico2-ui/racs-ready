  AU.Completed._renderPagination=function(pag){
    var info=document.getElementById('cjPagInfo');
    var el=document.getElementById('cjPagination');
    if(info) info.textContent=pag&&pag.total?'Showing '+(((pag.page-1)*pag.limit)+1)+'-'+Math.min(pag.page*pag.limit,pag.total)+' of '+pag.total:'Showing 0 of 0';
    if(!el)return;
    if(!pag||pag.pages<=1){el.innerHTML='';return;}
    var h='<li class="page-item '+(pag.page===1?'disabled':'')+'"><a class="page-link" href="#" onclick="AU.Completed.goPage('+(pag.page-1)+');return false;">&laquo;</a></li>';
    var blockSize=10;
    var start=Math.floor((pag.page-1)/blockSize)*blockSize+1;
    var end=Math.min(start+blockSize-1, pag.pages);
    for(var i=start;i<=end;i++) h+='<li class="page-item '+(i===pag.page?'active':'')+'"><a class="page-link" href="#" onclick="AU.Completed.goPage('+i+');return false;">'+i+'</a></li>';
    h+='<li class="page-item '+(pag.page===pag.pages?'disabled':'')+'"><a class="page-link" href="#" onclick="AU.Completed.goPage('+(pag.page+1)+');return false;">&raquo;</a></li>';
    el.innerHTML=h;
  };

  AU.Completed.goPage=function(p){_cjPage=p;AU.Completed.load();};

