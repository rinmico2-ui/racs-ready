    .td-work-route { grid-template-columns: 40px minmax(0, 1fr); min-height: 0; padding: 13px; }
    .td-work-route-icon { width: 40px; height: 40px; }
    .td-work-route-side { grid-column: 1 / -1; width: 100%; flex-direction: row; align-items: center; justify-content: space-between; padding-top: 9px; border-top: 1px solid #e2e8f0; }
