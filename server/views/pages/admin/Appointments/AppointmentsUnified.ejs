    var btn=document.getElementById('btnConfirmAssign');
    var orig=btn.innerHTML;
    btn.disabled=true;btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Assigning...';
    fetch('/api/admin/appointments/'+_qCurrentBookingId+'/assign',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({technicianId:_qSelectedTechId,priority:document.getElementById('assignPriority').value,notes:document.getElementById('assignNotes').value,equipment:_qEquipment})})
    .then(function(r){return r.json().then(function(d){if(!r.ok)throw new Error(d.error||'Failed');return d;});})
    .then(function(){bootstrap.Modal.getInstance(document.getElementById('assignModal')).hide();showNotification({type:'success',title:'Technician Assigned',message:'Booking has been assigned successfully.',duration:4000});AU.Queue.loadQueue(_qPage);AU.Queue.loadStats();})
    .catch(function(e){showNotification({type:'error',title:'Assignment Failed',message:e.message||'An error occurred.',duration:5000});btn.disabled=false;btn.innerHTML=orig;});
  };

