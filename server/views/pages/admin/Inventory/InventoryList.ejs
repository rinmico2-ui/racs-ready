    function computeVariantMargin(variantId) {
      const sellingInput = document.querySelector(`[data-field="sellingPrice"][data-variant-id="${variantId}"]`);
      const costInput = document.querySelector(`[data-field="costPrice"][data-variant-id="${variantId}"]`);
      const marginEl = document.getElementById(`variantMargin_${variantId}`);
      if (!sellingInput || !costInput || !marginEl) return;
      const selling = parseFloat(sellingInput.value) || 0;
      const cost = parseFloat(costInput.value) || 0;
      const margin = selling - cost;
      const pct = cost ? ((margin / cost) * 100).toFixed(1) : 0;
      marginEl.textContent = `₱${margin.toLocaleString()} (${pct}%)`;
    }

    // Event delegation for variants modal
    document.body.addEventListener('click', async function(e) {
      // Save variant in variants modal
