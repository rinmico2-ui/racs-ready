<style>
  /* ── Enterprise Day Schedule Slide Panel ── */
  .cal-slide-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.45);
    z-index: 1055;
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .cal-slide-overlay.show {
    display: block;
    opacity: 1;
  }

  .cal-slide-panel {
    position: fixed;
    top: 0;
    right: -460px;
    width: 440px;
    max-width: 96vw;
    height: 100vh;
    background: #f8fafc;
    box-shadow: -8px 0 40px rgba(15, 23, 42, 0.18);
    z-index: 1056;
    display: flex;
    flex-direction: column;
    transition: right 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 16px 0 0 16px;
    overflow: hidden;
  }

  .cal-slide-panel.open {
    right: 0;
  }

  .cal-slide-header {
    background: linear-gradient(135deg, #1e40af 0%, #2563eb 60%, #3b82f6 100%);
    color: #fff;
    padding: 22px 24px 18px;
    flex-shrink: 0;
  }

  .cal-slide-header h5 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 3px;
  }

  .cal-slide-header small {
    opacity: 0.82;
    font-size: 0.78rem;
  }

  .cal-slide-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 16px 24px;
    background: #f8fafc;
  }

  .cal-slide-card {
    background: #fff;
    border-radius: 14px;
    padding: 16px 18px;
    margin-bottom: 12px;
    border: 1px solid #eef2f7;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    position: relative;
    overflow: hidden;
  }

  .cal-slide-card:hover {
    border-color: #cbd5e1;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
    transform: translateY(-1px);
  }

  .cal-slide-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--card-accent, #3b82f6);
    border-radius: 4px 0 0 4px;
  }

  .cal-slide-card .card-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .cal-slide-card .card-customer {
    font-weight: 700;
    font-size: 0.9rem;
    color: #0f172a;
    margin: 0;
  }

  .cal-slide-card .card-service {
    font-size: 0.76rem;
    color: #64748b;
    margin-top: 2px;
  }

  .cal-slide-card .card-details {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 10px;
  }

  .cal-slide-card .card-detail {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.76rem;
    color: #475569;
  }

  .cal-slide-card .card-detail i {
    color: #94a3b8;
    font-size: 0.7rem;
  }

  .cal-slide-card .card-footer {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cal-slide-card .card-ref {
    font-size: 0.7rem;
    color: #94a3b8;
  }

  .cal-slide-card .card-view-link {
    font-size: 0.72rem;
    color: #3b82f6;
    font-weight: 600;
  }

  .cal-status-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 0.68rem;
    font-weight: 600;
    color: #fff;
    margin-top: 6px;
  }

  /* FullCalendar Enterprise Overrides */
  .fc {
    font-family: 'Inter', 'Outfit', system-ui, sans-serif !important;
  }

  .fc .fc-toolbar-title {
    font-size: 1.15rem !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    letter-spacing: -0.3px;
  }

  .fc .fc-button {
    font-size: 0.77rem !important;
    padding: 0.38rem 0.8rem !important;
    border-radius: 8px !important;
    font-weight: 600 !important;
    transition: all 0.2s ease !important;
  }

  .fc .fc-button-primary {
    background: #f1f5f9 !important;
    border-color: #e2e8f0 !important;
    color: #475569 !important;
  }

  .fc .fc-button-primary:not(:disabled):hover {
    background: #e2e8f0 !important;
    border-color: #cbd5e1 !important;
    color: #1e293b !important;
  }

  .fc .fc-button-primary:not(:disabled).fc-button-active {
    background: #2563eb !important;
    border-color: #2563eb !important;
    color: #fff !important;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3) !important;
  }

  .fc .fc-daygrid-day.fc-day-today {
    background: rgba(59, 130, 246, 0.04) !important;
  }

  .fc .fc-daygrid-day.fc-day-today .fc-daygrid-day-number {
    background: linear-gradient(135deg, #2563eb, #3b82f6);
    color: #fff !important;
    border-radius: 50%;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
  }

  .fc .fc-col-header-cell-cushion {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
    padding: 8px 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .fc .fc-daygrid-day-number {
    font-size: 0.82rem;
    font-weight: 600;
    color: #475569;
    padding: 4px 6px;
  }

  .fc .fc-daygrid-more-link {
    display: flex !important;
    align-items: center;
    justify-content: center;
    margin: 2px 4px;
    width: calc(100% - 8px);
  }

  .fc .fc-daygrid-more-link>div {
    width: 100%;
    text-align: center;
  }

  .fc th {
    border-color: #f1f5f9 !important;
  }

  .fc td {
    border-color: #f1f5f9 !important;
  }

  .fc .fc-scrollgrid {
    border-color: #e2e8f0 !important;
    border-radius: 10px;
    overflow: hidden;
  }

  .cal-more-pill {
    background: linear-gradient(135deg, #2563eb, #3b82f6);
    color: #fff;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 0.72rem;
    font-weight: 700;
    text-align: center;
    box-shadow: 0 2px 6px rgba(37, 99, 235, 0.28);
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    transition: all 0.2s ease;
  }

  .cal-more-pill:hover {
    background: linear-gradient(135deg, #1d4ed8, #2563eb);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.38);
    transform: translateY(-1px);
  }

  /* ── Calendar Event Cards ── */
  .fc .fc-event {
    border-radius: 6px !important;
    padding: 2px 6px !important;
    font-size: 0.74rem !important;
    font-weight: 600 !important;
    border: none !important;
    cursor: pointer !important;
    transition: all 0.15s ease !important;
    line-height: 1.3 !important;
  }

  .fc .fc-event:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15) !important;
    filter: brightness(1.08);
  }

  .fc .fc-daygrid-event-dot {
    display: none !important;
  }

  .fc .fc-list-event:hover td {
    background: rgba(59, 130, 246, 0.04) !important;
  }

  .fc .fc-list-event td {
    border-bottom-color: #f1f5f9 !important;
  }

  .fc .fc-list-event-time {
    font-size: 0.78rem;
    font-weight: 600;
    color: #475569;
    min-width: 80px;
  }

  .fc .fc-list-event-title a {
    font-size: 0.82rem;
    font-weight: 600;
    color: #1e293b;
  }

  .fc .fc-list-event:hover td:first-child {
    border-left: 3px solid #2563eb !important;
  }

  /* ── Calendar View Container ── */
  #calendarViewContainer .schedule-premium-card {
    border: 1px solid #e2e8f0;
  }

  #calendarViewContainer .legend-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.72rem;
    color: #475569;
    background: #fff;
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
  }

  /* ── Cal Slide: remove old .cal-status-badge ── */
  .cal-status-badge {
    display: none;
  }

  /* ── Responsive Design ── */
  @media (max-width: 991px) {
    .mw-hero-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .mw-hero-right {
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
    }

    .mw-hero-stats {
      width: 100%;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .mw-hero-stat {
      flex: 1 1 calc(50% - 0.375rem);
      min-width: 120px;
    }

    .mw-hero-clock {
      align-self: flex-start;
    }

    .cal-slide-panel {
      width: 100%;
      max-width: 100%;
      right: -100%;
      border-radius: 0;
    }

    .cal-slide-panel.open {
      right: 0;
    }
  }

  @media (max-width: 767px) {
    .container-fluid {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    .mw-hero {
      padding: 1.25rem;
      border-radius: 12px;
    }

    .mw-hero-title {
      font-size: 1.4rem;
    }

    .mw-hero-subtitle {
      font-size: 0.85rem;
    }

    .mw-hero-icon {
      width: 44px;
      height: 44px;
      font-size: 1.3rem;
    }

    .mw-hero-stat {
      flex: 1 1 calc(50% - 0.375rem);
      min-width: 100px;
    }

    .mw-hero-stat-value {
      font-size: 1.4rem;
    }

    .mw-hero-stat-label {
      font-size: 0.65rem;
    }

    .fc .fc-toolbar-title {
      font-size: 1rem !important;
    }

    .fc .fc-button {
      font-size: 0.7rem !important;
      padding: 0.3rem 0.6rem !important;
    }

    .fc .fc-col-header-cell-cushion {
      font-size: 0.65rem;
      padding: 6px 0;
    }

    .fc .fc-daygrid-day-number {
      font-size: 0.75rem;
      padding: 3px 4px;
    }

    .fc .fc-daygrid-day.fc-day-today .fc-daygrid-day-number {
      width: 24px;
      height: 24px;
      font-size: 0.7rem;
    }

    .cal-slide-header {
      padding: 1rem 1.25rem;
    }

    .cal-slide-header h5 {
      font-size: 0.95rem;
    }

    .cal-slide-header small {
      font-size: 0.7rem;
    }

    .cal-slide-body {
      padding: 1rem;
    }

    .cal-slide-card {
      padding: 1rem;
      border-radius: 10px;
    }

    .cal-slide-card .card-customer {
      font-size: 0.85rem;
    }

    .cal-slide-card .card-service {
      font-size: 0.7rem;
    }

    .cal-slide-card .card-detail {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 480px) {
    .mw-hero-stat {
      flex: 1 1 100%;
    }

    .mw-hero-stat-value {
      font-size: 1.25rem;
    }

    .fc .fc-toolbar {
      flex-direction: column;
      gap: 0.5rem;
    }

    .fc .fc-toolbar-chunk {
      width: 100%;
      display: flex;
      justify-content: center;
    }

    .fc .fc-daygrid-day-number {
      font-size: 0.7rem;
    }
  }
</style>

<div class="technician-page" style="background:#f1f5f9;min-height:100vh;">
  <div class="container-fluid px-3 px-md-4 py-3 py-md-4">

    <!-- Enterprise Hero Header -->
    <div class="mw-hero mw-animate-fade-in-up">
      <div class="mw-hero-content">
        <div class="mw-hero-left">
          <div class="mw-hero-icon">
            <i class="bi bi-clipboard-check"></i>
          </div>
