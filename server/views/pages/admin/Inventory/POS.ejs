        <span>TOTAL</span><span>₱${Number(sale.totalAmount).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</span>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:0.82rem;margin-top:8px;">
