    <!-- Right: Cart -->
    <div class="pos-cart">
      <div class="pos-cart-header">
        <h6><i class="bi bi-cart3 me-1"></i>Current Sale</h6>
        <span class="pos-cart-count" id="cartCount">0</span>
      </div>
      <div class="pos-customer-bar">
        <input type="text" id="customerName" placeholder="Customer name (optional)" style="margin-bottom:6px;">
        <div style="display:flex;gap:6px;margin-bottom:6px;">
          <input type="text" id="customerPhone" placeholder="Phone (optional)" style="flex:1;padding:8px 12px;border-radius:8px;border:1.5px solid #e2e8f0;font-size:0.82rem;background:#f8fafc;outline:none;">
          <input type="text" id="customerTin" placeholder="TIN (optional)" style="flex:1;padding:8px 12px;border-radius:8px;border:1.5px solid #e2e8f0;font-size:0.82rem;background:#f8fafc;outline:none;">
        </div>
