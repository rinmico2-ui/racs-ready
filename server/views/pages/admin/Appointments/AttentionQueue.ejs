      const date = i.bookingDate ? new Date(i.bookingDate).toLocaleDateString('en-PH') : 'TBD';
      return `
        <div class="attention-card">
          <div class="d-flex align-items-start gap-3">
            <div class="attention-icon ${status.class}"><i class="bi bi-exclamation-lg"></i></div>
            <div class="flex-grow-1">
              <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
                <span class="fw-bold">${i.reference}</span>
                <span class="badge ${status.class}" style="font-size:0.72rem;">${status.label}</span>
              </div>
              <div class="small text-muted mb-1"><strong>Customer:</strong> ${i.customer}${i.phone ? ' • ' + i.phone : ''}${i.email ? ' • ' + i.email : ''}</div>
              <div class="small text-muted mb-1"><strong>Service:</strong> ${i.serviceName} (${i.serviceModel.replace('Service', ' Service')})</div>
              <div class="small text-muted mb-1"><strong>Scheduled:</strong> ${date} ${i.startTime ? 'at ' + i.startTime : ''}</div>
              ${i.proposedReschedule ? `<div class="small text-info mb-1"><i class="bi bi-calendar-check me-1"></i><strong>Proposed:</strong> ${i.proposedReschedule.dateLabel || new Date(i.proposedReschedule.date).toLocaleDateString('en-PH')} at ${i.proposedReschedule.timeLabel || i.proposedReschedule.time}${i.proposedReschedule.technicianName ? ' — ' + i.proposedReschedule.technicianName : ''} <span class="badge bg-info text-dark" style="font-size:0.65rem;">${i.proposedReschedule.status}</span></div>` : ''}
              ${i.proposedReschedule && i.proposedReschedule.status === 'pending' ? `<div class="alert alert-light border-info text-info small py-2 px-2 d-flex align-items-center gap-2 mb-1" style="border-style:dashed;"><i class="bi bi-hourglass-split"></i> <strong>Awaiting customer's confirmation</strong> — the customer must accept, request a new time, or cancel before any assignment.</div>` : ''}
              ${i.isProposedPassed ? `<div class="alert alert-danger small py-2 my-2 d-flex align-items-center gap-2"><i class="bi bi-exclamation-triangle-fill"></i><strong>This date/time has already passed.</strong> Reassign is blocked — use Reschedule to propose a new slot.</div>` : ''}
              <div class="small text-warning mb-1"><i class="bi bi-info-circle me-1"></i>${i.reason}</div>
              ${i.rescheduleRequest?.requested && i.rescheduleRequest?.status === 'pending' ? `
              <div class="alert alert-warning small py-2 my-2">
                <i class="bi bi-calendar-event me-1"></i><strong>Customer requests new schedule:</strong> ${i.rescheduleRequest.requestedDate} at ${i.rescheduleRequest.requestedTime}${i.rescheduleRequest.reason ? ' — ' + i.rescheduleRequest.reason : ''}
              </div>
              <div class="d-flex flex-wrap gap-2 mt-2">
                <button class="btn btn-sm btn-success" onclick="approveReschedule('${i.id}')" title="Accept the customer's requested schedule and go to assign"><i class="bi bi-check-lg me-1"></i>Accept & Assign</button>
                <button class="btn btn-sm btn-outline-danger" onclick="rejectReschedule('${i.id}')" title="Reject the customer's request"><i class="bi bi-x-lg me-1"></i>Reject</button>
                <button class="btn btn-sm btn-outline-secondary" onclick="viewDetail('${i.id}')"><i class="bi bi-eye me-1"></i>View Details</button>
                ${i.phone ? `<a href="tel:${i.phone}" class="btn btn-sm btn-outline-success"><i class="bi bi-telephone me-1"></i>Call</a>` : ''}
                <a href="mailto:${i.email}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-envelope me-1"></i>Contact</a>
              </div>` : `
              <div class="d-flex flex-wrap gap-2 mt-2">
                <button class="btn btn-sm btn-outline-secondary" onclick="viewDetail('${i.id}')" title="View Details"><i class="bi bi-eye me-1"></i>View Details</button>
                ${i.status === 'pending_reassignment' && !i.isProposedPassed ? `<a href="/admin/appointments/queue?assign=${i.id}" class="btn btn-sm btn-outline-success" title="Assign a technician in the assignment queue"><i class="bi bi-person-plus me-1"></i>Reassign</a>` : ''}
                ${i.requiresReschedule && (!i.proposedReschedule || i.proposedReschedule.status !== 'pending') ? `<button class="btn btn-sm btn-outline-info" onclick="openReschedule('${i.id}', '${i.reference}', ${i.serviceDurationMinutes || 60})"><i class="bi bi-calendar-event me-1"></i>${i.isProposedPassed ? 'Reschedule (required)' : 'Reschedule'}</button>` : ''}
                ${i.phone ? `<a href="tel:${i.phone}" class="btn btn-sm btn-outline-success" title="Call customer"><i class="bi bi-telephone me-1"></i>Call</a>` : ''}
                <a href="mailto:${i.email}" class="btn btn-sm btn-outline-secondary" title="Contact customer via email"><i class="bi bi-envelope me-1"></i>Contact</a>
              </div>`}
            </div>
          </div>
        </div>`;
    }).join('');
