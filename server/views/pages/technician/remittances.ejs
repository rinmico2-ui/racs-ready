          </div>
          <div class="kpi-enterprise-label">Waiting to Submit</div>
          <div class="kpi-enterprise-value" id="trWaiting">0</div>
        </div>
      </div>
      <div class="col-6 col-md-4">
        <div class="kpi-enterprise" data-accent="cyan">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon cyan"><i class="bi bi-send-check"></i></div>
          </div>
          <div class="kpi-enterprise-label">Submitted</div>
          <div class="kpi-enterprise-value" id="trSubmitted">0</div>
        </div>
      </div>
      <div class="col-6 col-md-4">
        <div class="kpi-enterprise" data-accent="green">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon green"><i class="bi bi-check-circle"></i></div>
          </div>
          <div class="kpi-enterprise-label">Verified</div>
          <div class="kpi-enterprise-value" id="trVerified">0</div>
        </div>
      </div>
    </div>

    <div id="toOrdersList"></div>
  </div>
</div>

<script>
let TECH_REMIT=[];
const tre=v=>String(v??'—').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const statusStyle=s=>{
  if(s==='verified') return ['#dcfce7','#166534'];
  if(s==='remitted') return ['#cffafe','#155e75'];
  if(s==='waiting_for_remittance') return ['#dbeafe','#1e40af'];
  return ['#f1f5f9','#475569'];
};
async function loadTechRemittances(){
  const r=await fetch('/api/technician/remittances'), d=await r.json();
  if(!r.ok) return alert(d.error||'Unable to load remittances');
  TECH_REMIT=d.payments||[];
  document.getElementById('trWaiting').textContent=TECH_REMIT.filter(p=>p.status==='waiting_for_remittance').length;
  document.getElementById('trSubmitted').textContent=TECH_REMIT.filter(p=>p.status==='remitted').length;
  document.getElementById('trVerified').textContent=TECH_REMIT.filter(p=>p.status==='verified').length;
  const list=document.getElementById('toOrdersList');
  if(!TECH_REMIT.length){
    list.innerHTML='<div class="to-empty"><i class="bi bi-cash-stack"></i><h6>No collected payments found</h6><p>Once payments are collected, they will appear here for remittance.</p></div>';
    return;
  }
  let h='';
  for(const p of TECH_REMIT){
    const subject=p.bookingId||p.orderId||p.projectId||{};
    const ref=tre(p.bookingId?.bookingReference||p.orderId?.orderReference||p.projectId?.projectReference||String(p._id).slice(-8));
    const customer=tre(subject.customer?.name)||'Unknown';
    const amount='₱'+Number(p.amount||0).toLocaleString();
    const method=tre(p.method).toUpperCase();
    const collected=p.collectedAt?new Date(p.collectedAt).toLocaleString('en-PH'):'—';
    const day=p.collectedAt?new Date(p.collectedAt).getDate():'—';
    const month=p.collectedAt?new Date(p.collectedAt).toLocaleString('en-PH',{month:'short'}):'';
    const ev=[];
    if(p.proofUrl) ev.push('<span class="badge bg-success me-1">Receipt</span>');
    if(p.customerSignature) ev.push('<span class="badge bg-primary">Signed</span>');
    const status=tre(p.status).replaceAll('_',' ');
    const [bg,color]=statusStyle(p.status);
    const action=p.status==='waiting_for_remittance'?'<button class="tjc-view" onclick="event.stopPropagation();submitRemittance(\''+p._id+'\')"><i class="bi bi-send"></i> Submit</button>':'';
    h+='<div class="to-order-card tjc">';
    h+='<div class="tjc-date"><div class="tjc-date-day">'+day+'</div><div class="tjc-date-month">'+month+'</div></div>';
    h+='<div class="tjc-main">';
    h+='<div class="tjc-top"><div class="tjc-title">'+customer+'</div><span class="tjc-status" style="background:'+bg+';color:'+color+';">'+status+'</span></div>';
    h+='<div class="tjc-meta">';
    h+='<span><i class="bi bi-upc-scan me-1"></i>'+ref+'</span>';
    h+='<span><i class="bi bi-credit-card me-1"></i>'+method+'</span>';
    h+='<span><i class="bi bi-calendar me-1"></i>'+collected+'</span>';
    if(ev.length) h+='<span>'+ev.join(' ')+'</span>';
    h+='</div></div>';
    h+='<div class="tjc-action"><div class="tjc-amount">'+amount+'</div>'+action+'</div>';
    h+='</div>';
  }
  list.innerHTML=h;
}

async function submitRemittance(id){const result=await Swal.fire({title:'Submit Remittance',html:'<div class="text-start"><label class="form-label">Handover Notes</label><textarea id="trNotes" class="form-control mb-3" rows="3" placeholder="Cash denomination, recipient, or handover details"></textarea><label class="form-label">Remittance Proof (optional)</label><input id="trProof" type="file" accept="image/*" class="form-control"></div>',icon:'question',showCancelButton:true,confirmButtonText:'Submit to Admin',confirmButtonColor:'#2563eb',preConfirm:async()=>{const file=document.getElementById('trProof').files[0];const proofUrl=file?await new Promise((ok,bad)=>{const f=new FileReader();f.onload=()=>ok(f.result);f.onerror=bad;f.readAsDataURL(file);}):null;return {notes:document.getElementById('trNotes').value.trim(),proofUrl};}});if(!result.isConfirmed)return;const location=await new Promise(ok=>{if(!navigator.geolocation)return ok(null);navigator.geolocation.getCurrentPosition(p=>ok({lat:p.coords.latitude,lng:p.coords.longitude,accuracy:p.coords.accuracy}),()=>ok(null),{timeout:5000});});const r=await fetch(`/api/technician/remittances/${id}/submit`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...result.value,location})}),d=await r.json();if(!r.ok)return Swal.fire('Submission Failed',d.error||'Unable to submit remittance','error');await Swal.fire('Remittance Submitted','Administration can now review and verify this payment.','success');loadTechRemittances()}

loadTechRemittances();
</script>
