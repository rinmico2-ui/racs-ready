              </td>
              <td class="text-start td-truncate-md" title="${rq.service}">${rq.service}</td>
              <td class="text-end">${rq.estimatedFee != null ? "₱" + Number(rq.estimatedFee).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "—"}</td>
              <td class="text-nowrap">${formatDate(rq.date) || "—"}<div class="text-muted text-micro">${formatTime(rq.time)}</div></td>
              <td class="text-start">${rq.paymentMethod || ""}${rq.paymentReference ? ` (${rq.paymentReference})` : ""}</td>
              <td class="text-center"><span class="badge req-status bg-${statusBadgeClass(rq.status)}">${rq.status}</span></td>
              <td class="text-center">
                <div class="d-flex gap-1 justify-content-center flex-wrap">
                  <button class="btn btn-sm btn-outline-secondary view-req-details" data-id="${rq.id}"><i class="bi bi-eye me-1"></i>Details</button>
                  <button class="btn btn-sm btn-outline-secondary view-payment" data-id="${rq.id}" title="View payment"><i class="bi bi-credit-card-2-front-fill"></i></button>
                </div>
              </td>
            `;
            body.appendChild(tr);
          });
        }

        document.getElementById("requestsCountCombined").innerText =
          `${filtered.length} request${filtered.length === 1 ? "" : "s"} shown`;

        qsa(".view-req-details").forEach((b) =>
          b.addEventListener("click", function () {
            const id = this.getAttribute("data-id");
            const rq = bookingRequests.find((x) => x.id === id);
            openBookingRequestDetails(rq);
          }),
        );

        // redirect to payments when payment button clicked
        qsa(".view-payment").forEach((b) =>
          b.addEventListener("click", function () {
            const id = this.getAttribute("data-id");
            if (id) {
              // Add loading state to button
              this.classList.add("btn-payment-loading");
              const originalContent = this.innerHTML;
              this.disabled = true;
              
              // Show loading for a short duration before redirect
              setTimeout(() => {
                window.location.href = `/admin/payments?bookingId=${encodeURIComponent(id)}`;
              }, 500);
            }
          }),
        );
      }

      // no inline approve/cancel handlers any more; all actions happen in payments view

      // Booking requests validation queue
      async function loadBookingRequests() {
        const tbody = document.getElementById("requestsTableBodyCombined");
        showLoadingRow(tbody);
        try {
          const r = await fetch("/api/appointments?requests=1&limit=200", {
            credentials: "same-origin",
          });
          let reqs = [];
          if (r.ok) {
            const j = await r.json();
            reqs = j.items || j.requests || [];
          }
          bookingRequests = (reqs || []).map((rq, idx) =>
            normalizeRequest(rq, idx),
          );
          renderBookingRequests();
        } catch (e) {
          console.warn(e);
          bookingRequests = [];
          renderBookingRequests();
        }
      }

      // load cancelled appointments list
