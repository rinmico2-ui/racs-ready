  // ── Completion Proof Modal ──
  function pwOpenCompletionProof(pid) {
    const overlay = document.createElement('div'); overlay.className = 'pw-modal-overlay';
    overlay.innerHTML = `
      <div class="pw-modal pw-proof-modal">
        <div style="text-align:center;margin-bottom:.75rem;">
          <div style="width:52px;height:52px;border-radius:50%;background:#eff6ff;color:var(--pw-primary, #2563eb);display:inline-flex;align-items:center;justify-content:center;font-size:1.5rem;margin-bottom:.4rem;"><i class="bi bi-camera-fill"></i></div>
          <h5 style="margin:0 0 .3rem;font-weight:800;">Proof of Completion</h5>
          <p style="font-size:.78rem;color:var(--pw-muted);margin:0;">Upload a clear photo of the completed project. The customer and admin will see this proof.</p>
        </div>
        <div id="cpPreviewWrap" style="display:none;margin-bottom:1rem;">
          <img id="cpPreview" src="" alt="Completion preview" style="width:100%;max-height:260px;object-fit:contain;border-radius:var(--pw-radius-sm);border:2px solid var(--pw-border);background:#f8fafc;" />
        </div>
        <div id="cpUploadZone" style="display:flex;flex-direction:column;align-items:center;gap:.5rem;padding:1.25rem;border:2px dashed var(--pw-border);border-radius:var(--pw-radius-sm);background:#f8fafc;text-align:center;margin-bottom:.5rem;transition:all .2s ease;">
          <i class="bi bi-cloud-upload" style="font-size:1.6rem;color:var(--pw-primary, #2563eb);"></i>
          <div style="font-weight:700;font-size:.85rem;color:#0f172a;">Select a completion photo</div>
          <div style="font-size:.72rem;color:var(--pw-muted);">Take a new photo or choose from gallery</div>
          <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;justify-content:center;margin-top:.25rem;">
            <label class="pw-btn primary" style="cursor:pointer;margin:0;">
              <i class="bi bi-camera-fill"></i> Take Photo
              <input id="cpFileInput" type="file" accept="image/*" capture="environment" style="display:none;" />
            </label>
            <label class="pw-btn" style="cursor:pointer;margin:0;">
              <i class="bi bi-image"></i> Choose File
              <input id="cpFileBrowse" type="file" accept="image/*" style="display:none;" />
            </label>
          </div>
        </div>
        <div id="cpFileName" style="font-size:.72rem;color:var(--pw-muted);text-align:center;min-height:1.25rem;"></div>
        <div class="d-flex gap-2 justify-content-end mt-3">
          <button class="pw-btn" onclick="this.closest('.pw-modal-overlay').remove();window.__loadProjectWork();">Skip</button>
          <button class="pw-btn success" id="cpUploadBtn" disabled><i class="bi bi-upload"></i> Upload &amp; Finish</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);
    overlay.addEventListener('click', e => { if (e.target === overlay) { overlay.remove(); window.__loadProjectWork(); } });

    let selectedFile = null;
    const previewWrap = document.getElementById('cpPreviewWrap');
    const previewImg = document.getElementById('cpPreview');
    const fileNameEl = document.getElementById('cpFileName');
    const uploadBtn = document.getElementById('cpUploadBtn');
    const fileInput = document.getElementById('cpFileInput');
    const fileBrowse = document.getElementById('cpFileBrowse');
    const uploadZone = document.getElementById('cpUploadZone');

    function handleFile(file) {
      if (!file || !file.type.startsWith('image/')) return;
      selectedFile = file;
      fileNameEl.textContent = file.name + ' (' + (file.size/1024).toFixed(1) + ' KB)';
      const reader = new FileReader();
      reader.onload = e => {
        previewImg.src = e.target.result;
        previewWrap.style.display = 'block';
        if (uploadZone) uploadZone.style.display = 'none';
      };
      reader.readAsDataURL(file);
      uploadBtn.disabled = false;
    }

    fileInput.addEventListener('change', e => { if (e.target.files[0]) handleFile(e.target.files[0]); });
    fileBrowse.addEventListener('change', e => { if (e.target.files[0]) handleFile(e.target.files[0]); });

    uploadBtn.addEventListener('click', async () => {
      if (!selectedFile) return;
      uploadBtn.disabled = true;
      uploadBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Uploading…';
      try {
        const fd = new FormData();
        fd.append('completionPhoto', selectedFile);
        const r = await fetch(`/api/projects/${pid}/upload-completion-proof`, { method:'POST', credentials:'same-origin', body: fd });
        if (!r.ok) { const d = await r.json().catch(()=>({})); throw new Error(d.error || 'Upload failed'); }
        toast('Proof of completion uploaded'); overlay.remove(); window.__loadProjectWork();
      } catch (e) { toast(e.message, 'error'); uploadBtn.disabled = false; uploadBtn.innerHTML = '<i class="bi bi-upload"></i> Upload & Finish'; }
    });
  };

  // ── Lead-only actions (reuse earlier patterns) ──
  window.pwLeadReportDelay = function (pid) { openIssueModal(pid, '', 'delay', 'Report Delay', 'Describe the delay (e.g., weather, access, supply). Sent to admin.'); };
  window.pwNotifyAdmin = function (pid) { openIssueModal(pid, '', 'other', 'Notify Admin', 'Send a note to the admin about this project.'); };
  function openIssueModal(projectId, woId, category, title, subtitle) {
    const overlay = document.createElement('div'); overlay.className = 'pw-modal-overlay';
