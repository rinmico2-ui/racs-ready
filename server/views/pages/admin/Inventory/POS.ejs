    .pos-aircon-stock { font-size: 0.7rem; color: #94a3b8; }

    .pos-empty { text-align: center; padding: 60px 20px; color: #64748b; grid-column: 1 / -1; }
    .pos-empty i { font-size: 3rem; color: #334155; display: block; margin-bottom: 12px; }

    /* ── Right: Cart Panel ── */
    .pos-cart { display: flex; flex-direction: column; background: #f8fafc; border-left: 1px solid #e2e8f0; overflow: hidden; }
    .pos-cart-header { padding: 16px 20px; background: #fff; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
    .pos-cart-header h6 { font-weight: 700; font-size: 0.9rem; color: #0f172a; margin: 0; }
    .pos-cart-count { background: #3b82f6; color: #fff; font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 10px; }

    .pos-customer-bar { padding: 12px 20px; background: #fff; border-bottom: 1px solid #e2e8f0; flex-shrink: 0; }
    .pos-customer-bar input { width: 100%; padding: 8px 12px; border-radius: 8px; border: 1.5px solid #e2e8f0; font-size: 0.82rem; background: #f8fafc; outline: none; transition: border 0.2s; }
    .pos-customer-bar input:focus { border-color: #3b82f6; }

    .pos-cart-items { flex: 1; overflow-y: auto; padding: 12px 20px; }
    .pos-cart-items::-webkit-scrollbar { width: 4px; }
    .pos-cart-items::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

    .pos-cart-item { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid #f1f5f9; }
    .pos-cart-item:last-child { border-bottom: none; }
    .pos-cart-item-info { flex: 1; min-width: 0; }
    .pos-cart-item-name { font-weight: 600; font-size: 0.82rem; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
