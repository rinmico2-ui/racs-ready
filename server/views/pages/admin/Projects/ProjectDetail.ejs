  window.splitWorkOrder = async function(id, unitCount) {
    const splitAt = parseInt(prompt(`Split after how many units? (1-${Math.max(1, unitCount-1)})`, String(Math.ceil(unitCount/2))));
    if (!splitAt || splitAt < 1 || splitAt >= unitCount) return toast('Enter a valid split point', 'warning');
    try {
      const result = await studioApi(`/api/work-orders/${id}/split`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ splitAt }) });
      toast(result.message || 'Draft work order split'); await loadProject();
    } catch (error) { toast(error.message, 'error'); }
  };

  window.mergeSelectedWorkOrders = async function() {
    const workOrderIds = [...document.querySelectorAll('.wo-merge-check:checked')].map(input => input.value);
    if (workOrderIds.length < 2) return toast('Select at least two draft work orders to merge', 'warning');
    if (!confirm(`Merge ${workOrderIds.length} selected draft work orders?`)) return;
    try {
      const result = await studioApi(`/api/projects/${projectId}/work-orders/merge`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ workOrderIds }) });
      toast(result.message || 'Draft work orders merged'); await loadProject();
    } catch (error) { toast(error.message, 'error'); }
  };

  window.moveWorkOrderUnits = async function(sourceId) {
    const orders = (window.__lastWorkOrders || []).filter(order => String(order._id) !== String(sourceId) && order.status === 'pending' && order.planningStatus !== 'released');
    if (!orders.length) return toast('Create another compatible draft work order before moving units', 'warning');
    const choices = orders.map((order, index) => `${index + 1}. ${order.workOrderNumber || 'WO'} — ${order.title || order.section || 'Work Order'}`).join('\n');
    const selected = parseInt(prompt(`Move units to which draft?\n${choices}`, '1'));
    if (!selected || !orders[selected - 1]) return;
    const count = parseInt(prompt('How many incomplete units should be moved?', '1'));
    if (!count || count < 1) return;
    try {
      const result = await studioApi(`/api/work-orders/${sourceId}/move-units`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ targetWorkOrderId:orders[selected-1]._id, count }) });
      toast(result.message || 'Units moved'); await loadProject();
    } catch (error) { toast(error.message, 'error'); }
  };

  window.deleteWorkOrder = async function(id, btn, isDraft = true) {
    const reason = isDraft ? '' : prompt('Cancellation reason (required):');
    if (!isDraft && !reason?.trim()) return;
    if (isDraft && !confirm('Delete this draft work order? Completed or released work is never affected.')) return;
    const action = async () => {
      try {
        const r = await fetch(`/api/work-orders/${id}${isDraft ? '' : '/cancel'}`, { method: isDraft ? 'DELETE' : 'POST', headers:{'Content-Type':'application/json'}, body:isDraft ? undefined : JSON.stringify({ reason }) });
        if (r.ok) { toast(isDraft ? 'Draft work order deleted' : 'Work order cancelled'); loadProject(); }
        else { const e = await r.json(); toast(e.error || 'Failed', 'error'); }
      } catch(e) { toast('Failed', 'error'); }
    };
    if (btn) await withBtnLoading(btn, 'Deleting…', action);
    else await action();
  };

