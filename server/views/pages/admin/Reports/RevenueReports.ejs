  function pesoFmt(v) { return '\u20B1' + Math.round(Number(v || 0)).toLocaleString('en-PH'); }

  function showChartDetail(config, initialIndex, initialDataset) {
    if (!cdmModal) {
      try { cdmModal = new bootstrap.Modal(document.getElementById('chartDetailModal')); } catch(e) { console.error('Modal init error:', e); return; }
    }
    document.getElementById('cdmTitle').innerHTML = `<i class="bi bi-${config.icon} me-2"></i>${config.title}`;
    document.getElementById('cdmSubtitle').textContent = config.subtitle;
    document.getElementById('cdmChartTitle').textContent = config.chartTitle;
    document.getElementById('cdmChartSubtitle').textContent = config.chartSubtitle;
    document.getElementById('cdmDataTitle').textContent = config.dataTitle;
    document.getElementById('cdmDataSubtitle').textContent = 'Click a chart element to filter';
    document.getElementById('cdmTableHead').innerHTML = `<tr>${config.headers.map(h => `<th>${h}</th>`).join('')}</tr>`;

    if (cdmChart) { try { cdmChart.destroy(); } catch(e){} }
    const chartOpts = {
      responsive: true, maintainAspectRatio: false,
      onClick: (e, els) => {
        if (els.length > 0) updateDetailTable(config, els[0].index, els[0].datasetIndex);
        else updateDetailTable(config, null, null);
      },
      onHover: (e, els) => { if (e.native) e.native.target.style.cursor = els.length > 0 ? 'pointer' : 'default'; },
      plugins: {
        legend: { labels: { usePointStyle: true, boxWidth: 7, font: { size: 11 } } },
        tooltip: { callbacks: { label: ctx => config.tooltipFn ? config.tooltipFn(ctx) : `${ctx.dataset.label || ctx.label}: ${pesoFmt(ctx.parsed.y ?? ctx.parsed)}` } }
      }
    };
    if (config.scales) chartOpts.scales = config.scales;
    if (config.cutout) chartOpts.cutout = config.cutout;

    cdmChart = new Chart(document.getElementById('cdmChart'), { type: config.type, data: typeof config.chartData === 'function' ? config.chartData() : config.chartData, options: chartOpts });
    const initIdx = (initialIndex !== undefined && initialIndex !== null) ? initialIndex : null;
    const initDs = (initialDataset !== undefined && initialDataset !== null) ? initialDataset : null;
    updateDetailTable(config, initIdx, initDs);
    if (cdmModal) {
      cdmModal.show();
      document.getElementById('chartDetailModal').addEventListener('shown.bs.modal', function onShown() {
        if (cdmChart) cdmChart.resize();
        document.getElementById('chartDetailModal').removeEventListener('shown.bs.modal', onShown);
      }, { once: true });
    }
  }

  function updateDetailTable(config, filterIndex, datasetIndex) {
    const rows = config.getRows(filterIndex, datasetIndex, currentA);
    const summary = config.getSummary(filterIndex, datasetIndex, currentA);
    const summaryEl = document.getElementById('cdmSummary');
    if (summary && summary.length) {
      summaryEl.innerHTML = summary.map(s => `<div class="cdm-stat"><div class="cdm-stat-label">${s.label}</div><div class="cdm-stat-value">${s.value}</div></div>`).join('');
      summaryEl.style.display = 'grid';
    } else { summaryEl.style.display = 'none'; }

    const tbody = document.getElementById('cdmTableBody');
    const empty = document.getElementById('cdmEmpty');
    if (rows && rows.length) {
      tbody.innerHTML = rows.map(r => `<tr>${r.map(c => `<td>${c}</td>`).join('')}</tr>`).join('');
      empty.style.display = 'none';
      document.getElementById('cdmTable').style.display = '';
    } else {
      tbody.innerHTML = '';
      empty.style.display = 'block';
      document.getElementById('cdmTable').style.display = 'none';
    }

    if (filterIndex !== null) {
      document.getElementById('cdmDataSubtitle').textContent = `Filtered: ${config.getFilterLabel(filterIndex, datasetIndex, currentA)}`;
    } else {
      document.getElementById('cdmDataSubtitle').textContent = 'Click a chart element to filter';
    }
  }

