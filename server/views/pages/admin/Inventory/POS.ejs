    .pos-header { display: flex; align-items: center; gap: 16px; padding: 16px 20px; background: #0f172a; border-bottom: 1px solid #334155; flex-shrink: 0; }
    .pos-header h5 { color: #f8fafc; font-weight: 700; font-size: 1rem; margin: 0; white-space: nowrap; }
    .pos-header h5 i { color: #3b82f6; margin-right: 8px; }

    .pos-search-box { flex: 1; position: relative; }
    .pos-search-box input { width: 100%; padding: 10px 14px 10px 40px; border-radius: 10px; border: 1.5px solid #334155; background: #1e293b; color: #f8fafc; font-size: 0.9rem; outline: none; transition: border 0.2s; }
    .pos-search-box input:focus { border-color: #3b82f6; }
    .pos-search-box input::placeholder { color: #64748b; }
    .pos-search-box i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #64748b; font-size: 0.9rem; }

    .pos-barcode-box { position: relative; width: 200px; }
    .pos-barcode-box input { width: 100%; padding: 10px 14px 10px 40px; border-radius: 10px; border: 1.5px solid #334155; background: #1e293b; color: #f8fafc; font-size: 0.9rem; font-family: monospace; outline: none; transition: border 0.2s; }
    .pos-barcode-box input:focus { border-color: #22c55e; }
    .pos-barcode-box input::placeholder { color: #64748b; }
    .pos-barcode-box i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #22c55e; font-size: 0.9rem; }

    .pos-categories { display: flex; gap: 6px; padding: 12px 20px; overflow-x: auto; flex-shrink: 0; border-bottom: 1px solid #334155; }
    .pos-categories::-webkit-scrollbar { height: 3px; }
    .pos-categories::-webkit-scrollbar-thumb { background: #475569; border-radius: 10px; }
    .pos-cat-btn { padding: 6px 14px; border-radius: 20px; font-size: 0.72rem; font-weight: 600; border: 1.5px solid #334155; background: transparent; color: #94a3b8; cursor: pointer; white-space: nowrap; transition: all 0.2s; }
    .pos-cat-btn:hover { border-color: #3b82f6; color: #3b82f6; }
    .pos-cat-btn.active { background: #3b82f6; color: #fff; border-color: #3b82f6; }

    .pos-grid { flex: 1; overflow-y: auto; padding: 16px 20px; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; align-content: start; }
    .pos-grid::-webkit-scrollbar { width: 6px; }
    .pos-grid::-webkit-scrollbar-thumb { background: #475569; border-radius: 10px; }

    .pos-item { background: #1e293b; border: 1.5px solid #334155; border-radius: 12px; padding: 14px; cursor: pointer; transition: all 0.2s; display: flex; flex-direction: column; gap: 8px; position: relative; }
    .pos-item:hover { border-color: #3b82f6; transform: translateY(-2px); box-shadow: 0 4px 16px rgba(59,130,246,0.15); }
    .pos-item.oos { opacity: 0.4; pointer-events: none; }
    .pos-item-name { font-weight: 700; font-size: 0.85rem; color: #f8fafc; line-height: 1.3; }
    .pos-item-cat { font-size: 0.68rem; color: #64748b; }
    .pos-item-price { font-size: 1.1rem; font-weight: 800; color: #22c55e; }
    .pos-item-stock { font-size: 0.7rem; color: #94a3b8; }
    .pos-item-stock strong { color: #f59e0b; }
    .pos-item-barcode { font-size: 0.7rem; color: #64748b; font-family: monospace; margin: 4px 0; letter-spacing: 0.5px; display: flex; align-items: center; gap: 4px; }

    .pos-tabs { display: flex; gap: 4px; padding: 0 16px 8px; }
    .pos-tab { flex: 1; padding: 8px 12px; background: #1e293b; border: 1px solid #334155; border-radius: 8px; color: #94a3b8; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px; }
