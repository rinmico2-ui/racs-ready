  async function requirePhaseOneInspectionPayment(bookingId, continueAction, requireCompletedCore = false) {
    try {
      const response = await fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Could not verify inspection payment');
      const booking = data.booking || data;
      const serviceItems = Array.isArray(booking.services) ? booking.services : [];
      const isMixedBooking = booking.serviceType === 'mixed'
        || (serviceItems.some(item => item.type === 'core') && serviceItems.some(item => item.type === 'repair'));
      const requiredInspectionFee = isMixedBooking
        ? serviceItems.filter(item => item.type === 'repair')
          .reduce((sum, item) => sum + Number(item.totalPrice || ((item.unitPrice || 0) * (item.quantity || 1))) || 0, 0)
        : Number(booking.initialCost || 0);
      const coreItems = serviceItems.filter(item => item.type === 'core');
      const allCoreCompleted = isMixedBooking && coreItems.length > 0 && coreItems.every(item => item.status === 'completed');
      if (requireCompletedCore && isMixedBooking && !allCoreCompleted) {
        await Swal.fire({
          icon: 'info',
          title: 'Complete Core Service First',
          text: 'Finish every Core service item before closing the first visit as Schedule Later. Phase 1 payment will then include the completed Core service and Repair inspection.',
          confirmButtonText: 'Go to Core Service',
          confirmButtonColor: '#2563eb'
        });
        await refreshOpenAssignmentDetail('core-service');
        return false;
      }
      const inspectionTarget = requiredInspectionFee + Math.max(0, Number(booking.travelFare) || 0);
      const initialBookingTotal = Math.max(0, Number(booking.totalPrice || booking.estimatedFee) || 0);
      const phaseOneTarget = allCoreCompleted ? Math.max(initialBookingTotal, inspectionTarget) : inspectionTarget;
      const phaseOneAmountDue = Math.max(0, phaseOneTarget - Math.max(0, Number(booking.amountPaid) || 0));
      if ((booking.inspectionFeeCollected && phaseOneAmountDue <= 0.01) || phaseOneTarget <= 0) return true;
      const assignment = {
        ...(window._inspAssignmentContext || window._detailAssignment || {}),
        bookingId: booking,
        customerName: booking.customer?.name || window._detailAssignment?.customerName || 'Customer',
        paymentMethod: booking.paymentMethod || 'cash',
      };
      openInspectionPaymentModal(bookingId, assignment, booking.inspection?.findings || '', booking.diagnosis?.diagnosisSummary || booking.diagnosis?.findings || '', continueAction, true);
      return false;
    } catch (error) {
      Swal.fire('Payment Check Failed', error.message, 'error');
      return false;
    }
  }

