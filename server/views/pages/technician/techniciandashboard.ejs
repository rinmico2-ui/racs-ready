<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet/dist/leaflet.css" />

<div class="technician-dashboard-page">
  <div class="dashboard-page-inner">

    <!-- Hero Header -->
    <div class="td-hero">
      <div class="row align-items-center">
        <div class="col-md-7">
          <span class="td-hero-eyebrow">Field operations</span>
          <h1 class="td-hero-title"><i class="bi bi-speedometer2 me-2"></i>Technician Dashboard</h1>
          <p class="td-hero-sub">Welcome back, <strong><%= (technician && technician.name) || 'Technician' %></strong>. Review your bookings, orders, preparation, and daily accountability in one place.</p>
          <div class="td-hero-meta">
            <span class="td-hero-date"><i class="bi bi-calendar3 me-1"></i><%= new Date().toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
            <span class="td-availability-badge <%= (technician && ['Available','On The Way','In Progress'].includes(technician.availabilityStatus)) ? 'online' : 'offline' %>">
              <span class="status-dot" aria-hidden="true"></span>
              <%= (technician && technician.availabilityStatus) || 'Offline' %>
            </span>
          </div>
        </div>
        <div class="col-md-5 text-md-end mt-3 mt-md-0">
          <div class="td-hero-actions">
            <div class="td-hero-stat" id="heroTodayCount">
              <span class="stat-num" id="heroTodayNum">—</span>
              <span class="stat-label">Today's Jobs</span>
            </div>
            <div class="td-hero-stat" id="heroActiveCount">
              <span class="stat-num" id="heroActiveNum">—</span>
              <span class="stat-label">Active Now</span>
            </div>
            <div class="td-hero-stat" id="heroCompletedCount">
              <span class="stat-num" id="heroCompletedNum">—</span>
              <span class="stat-label">Completed</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Primary work queues -->
    <section class="td-work-hub" aria-labelledby="tdWorkHubTitle">
      <div class="td-work-hub-header">
        <div>
          <span class="td-section-eyebrow">Work queues</span>
          <h2 id="tdWorkHubTitle">Continue your assigned work</h2>
        </div>
        <span class="td-work-hub-note">Use the correct workflow for each assignment type</span>
      </div>
      <div class="td-work-grid">
        <a href="/technician/assignments" class="td-work-route td-work-route-bookings">
          <span class="td-work-route-icon"><i class="bi bi-clipboard2-check"></i></span>
          <span class="td-work-route-copy">
            <span class="td-work-route-type">Service workflow</span>
            <strong>Bookings</strong>
            <small>Core services, repairs, inspections, and projects</small>
          </span>
          <span class="td-work-route-side">
            <span class="td-work-route-count"><strong id="tdBookingQueueCount">—</strong> open</span>
            <span class="td-work-route-action">Open queue <i class="bi bi-arrow-right"></i></span>
          </span>
        </a>
        <a href="/technician/orders" class="td-work-route td-work-route-orders">
          <span class="td-work-route-icon"><i class="bi bi-box-seam"></i></span>
          <span class="td-work-route-copy">
            <span class="td-work-route-type">Fulfillment workflow</span>
            <strong>Orders</strong>
            <small>Delivery, installation, pickup, and daily preparation</small>
          </span>
          <span class="td-work-route-side">
            <span class="td-work-route-count"><strong id="tdOrderQueueCount">—</strong> assigned</span>
            <span class="td-work-route-action">Open queue <i class="bi bi-arrow-right"></i></span>
          </span>
        </a>
      </div>
    </section>

    <!-- End-of-Day Accountability Banner (remittance / expenses) -->
    <div id="tdEodBanner" class="d-none" style="margin-top:16px;border-radius:14px;padding:14px 18px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;"></div>

    <!-- Main Content Grid -->
    <div class="row g-4 mt-1">

      <!-- Left Column: Core Work -->
      <div class="col-lg-8">

        <!-- 1. Current Job Panel -->
        <div class="td-panel" id="activePanel">
          <div class="td-panel-header">
            <h6 class="td-panel-title"><i class="bi bi-lightning-charge me-2 text-primary"></i>Current Job</h6>
            <a href="/technician/assignments?status=active" class="td-panel-link">View Active <i class="bi bi-arrow-right"></i></a>
          </div>
          <div class="td-panel-body" id="activeJob">
            <div class="td-empty-state">
              <i class="bi bi-inbox"></i>
              <p>No active job right now</p>
            </div>
          </div>
        </div>
        
        <!-- Job Expenses Panel (shown when active job has expenses) -->
        <div class="td-panel mt-4" id="jobExpensesPanel" style="display:none;">
          <div class="td-panel-header">
            <h6 class="td-panel-title"><i class="bi bi-receipt me-2 text-warning"></i>Job Expenses</h6>
            <a href="/technician/expenses" class="td-panel-link">All Expenses <i class="bi bi-arrow-right"></i></a>
          </div>
          <div class="td-panel-body" id="jobExpensesList"></div>
        </div>

        <!-- 2. Today's Jobs Panel -->
        <div class="td-panel mt-4" id="todayPanel">
          <div class="td-panel-header">
            <h6 class="td-panel-title"><i class="bi bi-calendar-day me-2 text-info"></i>Today's Jobs</h6>
            <a href="/technician/assignments?status=today" class="td-panel-link">View All <i class="bi bi-arrow-right"></i></a>
          </div>
          <div class="td-panel-body" id="todayList">
            <div class="td-empty-state">
              <i class="bi bi-calendar-check"></i>
              <p>No jobs scheduled for today</p>
            </div>
          </div>
        </div>

        <!-- 2b. Upcoming Preparation Panel -->
        <div class="td-panel mt-4" id="preparationPanel">
          <div class="td-panel-header" style="display:flex;align-items:center;justify-content:space-between;">
            <h6 class="td-panel-title"><i class="bi bi-box-seam me-2 text-success"></i>Upcoming Preparation</h6>
            <div class="d-flex align-items-center gap-2">
              <span class="td-panel-badge" id="prepBadge" style="display:none;background:#fef3c7;color:#92400e;font-size:0.72rem;padding:2px 8px;border-radius:10px;font-weight:600;"></span>
              <input type="date" id="prepDateDash" class="form-control form-control-sm" style="width:auto;padding:2px 8px;font-size:0.75rem;border-radius:8px;" onchange="loadPreparation(this.value)">
            </div>
          </div>
          <div class="td-panel-body" id="preparationList">
            <div class="td-empty-state">
              <i class="bi bi-box-seam"></i>
              <p>No resources to prepare yet</p>
            </div>
          </div>
          <div class="td-panel-footer" id="preparationFooter" style="display:none;padding:12px 16px;border-top:1px solid #f1f5f9;">
            <button class="btn btn-success w-100 fw-bold" id="batchCheckoutBtn" onclick="batchCheckoutResources()" style="border-radius:10px;">
              <i class="bi bi-box-arrow-in-right me-2"></i>Check Out All Resources
            </button>
            <div class="text-center mt-2" style="font-size:0.78rem;color:#64748b;">
              <i class="bi bi-info-circle me-1"></i>Collect all reserved items in one trip
            </div>
          </div>
        </div>

        <!-- 3. Pending Repairs Panel -->
        <div class="td-panel mt-4" id="pendingPanel">
          <div class="td-panel-header">
            <h6 class="td-panel-title"><i class="bi bi-wrench me-2 text-warning"></i>Pending Repairs & Assignments</h6>
            <a href="/technician/assignments?status=pending_acceptance" class="td-panel-link">View All <i class="bi bi-arrow-right"></i></a>
          </div>
          <div class="td-panel-body" id="pendingList">
            <div class="td-empty-state">
              <i class="bi bi-check-circle"></i>
              <p>No pending repairs or assignments</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Status & Actions -->
      <div class="col-lg-4">

        <!-- 4. Attendance Status Panel -->
        <div class="td-panel mb-4">
          <div class="td-panel-header">
            <h6 class="td-panel-title"><i class="bi bi-person-badge me-2 text-success"></i>Attendance Status</h6>
          </div>
          <div class="td-panel-body text-center py-4">
            <div style="font-size:3rem; margin-bottom:10px;">
              <i class="bi <%= (technician && ['Available','On The Way','In Progress'].includes(technician.availabilityStatus)) ? 'bi-emoji-smile text-success' : 'bi-emoji-neutral text-secondary' %>"></i>
            </div>
            <h5 style="font-weight:700; color:#1e293b; margin-bottom: 5px;">
              <%= (technician && technician.availabilityStatus) || 'Offline' %>
            </h5>
            <p style="color:#64748b; font-size:0.9rem; margin-bottom: 20px;">
              <%= (technician && ['Available','On The Way','In Progress'].includes(technician.availabilityStatus)) ? 'You are currently active and ready for jobs.' : 'You are currently offline or unavailable.' %>
            </p>
            <a href="/technician/attendance" class="btn btn-primary w-100 fw-bold" style="border-radius:10px;">
              <i class="bi bi-qr-code-scan me-2"></i>Scan Attendance
            </a>
          </div>
        </div>

        <!-- NEW: Daily Progress -->
        <div class="td-panel mb-4">
          <div class="td-panel-header">
            <h6 class="td-panel-title"><i class="bi bi-bar-chart-line me-2 text-info"></i>Daily Progress</h6>
          </div>
          <div class="td-panel-body">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span style="font-size:0.85rem;color:#475569;">Jobs Completed Today</span>
              <span style="font-weight:700;color:#1e293b;" id="dpProgressText">0 / 0</span>
            </div>
            <div style="background:#e2e8f0; border-radius:10px; height:10px; overflow:hidden; margin-bottom:14px;">
              <div id="dpProgressBar" style="height:100%; width:0%; background:linear-gradient(90deg,#3b82f6,#06b6d4); border-radius:10px; transition:width 0.6s ease;"></div>
            </div>
            <div class="d-flex justify-content-between" style="font-size:0.78rem; color:#64748b;">
              <span><i class="bi bi-clock-history me-1"></i>Pending: <strong id="dpPending">—</strong></span>
              <span><i class="bi bi-check-circle me-1 text-success"></i>Done: <strong id="dpDone">—</strong></span>
            </div>
            <hr style="margin:12px 0;">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <span style="font-size:0.78rem;color:#64748b;">Today's Earnings (Est.)</span>
                <div style="font-size:1.2rem;font-weight:800;color:#16a34a;" id="dpEarnings">₱0</div>
              </div>
              <a href="/technician/assignments" class="btn btn-sm btn-outline-primary">View Jobs</a>
            </div>
          </div>
        </div>

        <!-- NEW: Today's Expenses -->
        <div class="td-panel mb-4">
          <div class="td-panel-header">
            <h6 class="td-panel-title"><i class="bi bi-wallet2 me-2 text-warning"></i>Today's Expenses</h6>
          </div>
          <div class="td-panel-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <div style="font-size:1.5rem;font-weight:800;color:#1e293b;" id="todayExpTotal">₱0.00</div>
                <div style="font-size:0.78rem;color:#64748b;">logged today (<span id="todayExpCount">0</span> entries)</div>
              </div>
              <button class="btn btn-warning btn-sm fw-bold" onclick="openDailyExpenseModal()" style="border-radius:8px;">
                <i class="bi bi-plus-lg me-1"></i>Log Now
              </button>
            </div>
            <div id="todayExpBreakdown" style="font-size:0.82rem;color:#475569;">
              <!-- type breakdown loaded by JS -->
            </div>
            <a href="/technician/expenses" class="btn btn-sm btn-outline-secondary w-100 mt-2" style="font-size:0.8rem;">View All Expenses</a>
          </div>
        </div>

        <!-- 5. Quick Actions -->
        <div class="td-panel mb-4">
          <div class="td-panel-header">
            <h6 class="td-panel-title"><i class="bi bi-lightning me-2 text-info"></i>Quick Actions</h6>
          </div>
          <div class="td-panel-body">
            <div class="td-quick-actions">
              <a href="/technician/remittances" class="td-qa-btn">
                <div class="td-qa-icon rose"><i class="bi bi-cash-stack"></i></div>
                <span class="td-qa-label">Remittances</span>
                <span id="qaRemitBadge" class="td-qa-badge d-none"></span>
              </a>
              <a href="/technician/payroll" class="td-qa-btn">
                <div class="td-qa-icon emerald"><i class="bi bi-wallet2"></i></div>
                <span class="td-qa-label">My Payroll</span>
              </a>
              <a href="/technician/expenses" class="td-qa-btn">
                <div class="td-qa-icon amber"><i class="bi bi-receipt"></i></div>
                <span class="td-qa-label">Expenses</span>
              </a>
              <a href="/technician/tracking" class="td-qa-btn">
                <div class="td-qa-icon rose"><i class="bi bi-geo-alt"></i></div>
                <span class="td-qa-label">Live Tracking</span>
              </a>
              <a href="/technician/tools" class="td-qa-btn">
                <div class="td-qa-icon violet"><i class="bi bi-tools"></i></div>
                <span class="td-qa-label">My Tools</span>
              </a>
              <a href="/technician/warranty-claims" class="td-qa-btn">
                <div class="td-qa-icon emerald"><i class="bi bi-shield-check"></i></div>
                <span class="td-qa-label">Warranty Inspections</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 6. Notifications Panel -->
        <div class="td-panel">
          <div class="td-panel-header">
            <h6 class="td-panel-title"><i class="bi bi-bell me-2 text-primary"></i>Notifications</h6>
          </div>
          <div class="td-panel-body">
            <div class="td-empty-state py-4">
              <i class="bi bi-bell-slash" style="font-size:2rem; color:#cbd5e1; margin-bottom:10px;"></i>
              <p style="margin:0; font-size:0.9rem; color:#94a3b8;">You have no new notifications.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Daily Expense Quick Log Modal -->
<div class="modal fade" id="dailyExpenseModal" tabindex="-1">
  <div class="modal-dialog modal-md modal-dialog-centered">
    <div class="modal-content" style="border-radius:16px;overflow:hidden;">
      <div class="modal-header" style="background:linear-gradient(135deg,#f59e0b,#f97316);color:#fff;border:none;">
        <h6 class="modal-title fw-bold"><i class="bi bi-receipt me-2"></i>Log Today's Expense</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="dailyExpenseForm" onsubmit="submitDailyExpense(event)">
        <div class="modal-body py-4">
          <div class="mb-3">
            <label class="form-label fw-semibold">Expense Type *</label>
            <div class="d-flex gap-2 flex-wrap" id="expTypeButtons">
              <button type="button" class="btn btn-outline-info btn-sm exp-type-pill active" data-val="fuel"><i class="bi bi-fuel-pump me-1"></i>Fuel</button>
              <button type="button" class="btn btn-outline-primary btn-sm exp-type-pill" data-val="material"><i class="bi bi-box me-1"></i>Materials</button>
              <button type="button" class="btn btn-outline-secondary btn-sm exp-type-pill" data-val="transport"><i class="bi bi-truck me-1"></i>Transport</button>
              <button type="button" class="btn btn-outline-warning btn-sm exp-type-pill" data-val="meal"><i class="bi bi-cup-hot me-1"></i>Meal</button>
              <button type="button" class="btn btn-outline-dark btn-sm exp-type-pill" data-val="other"><i class="bi bi-three-dots me-1"></i>Other</button>
            </div>
            <input type="hidden" id="dailyExpType" value="fuel">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Amount (₱) *</label>
            <input type="number" class="form-control" id="dailyExpAmount" step="0.01" min="0.01" required placeholder="0.00">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Description *</label>
            <textarea class="form-control" id="dailyExpDesc" rows="2" maxlength="500" required placeholder="Brief description..."></textarea>
          </div>
          <div id="dailyFuelFields" style="background:#fffbeb;border-radius:10px;padding:14px;border:1px solid #fde68a;">
            <label class="form-label fw-semibold text-warning-emphasis mb-2"><i class="bi bi-fuel-pump me-1"></i>Fuel Details (optional)</label>
            <div class="row g-2">
              <div class="col-6"><label class="form-label form-label-sm">Liters</label><input type="number" class="form-control form-control-sm" id="dailyExpLiters" step="0.01" min="0" placeholder="0.00"></div>
              <div class="col-6"><label class="form-label form-label-sm">₱/Liter</label><input type="number" class="form-control form-control-sm" id="dailyExpPricePerLiter" step="0.01" min="0" placeholder="0.00"></div>
              <div class="col-6"><label class="form-label form-label-sm">Odometer</label><input type="number" class="form-control form-control-sm" id="dailyExpOdometer" min="0" placeholder="km"></div>
              <div class="col-6"><label class="form-label form-label-sm">Gas Station</label><input type="text" class="form-control form-control-sm" id="dailyExpStation" maxlength="100" placeholder="e.g. Shell"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer" style="background:#f8fafc;border:none;">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning btn-sm fw-bold"><i class="bi bi-check-lg me-1"></i>Save Expense</button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  .technician-dashboard-page {
    --td-ink: #172033;
    --td-muted: #64748b;
    --td-border: #e2e8f0;
    color: var(--td-ink);
  }
  .dashboard-page-inner { width: 100%; max-width: 1520px; margin: 0 auto; }
  .td-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(125deg, #111827 0%, #1e3a5f 58%, #155e75 100%);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 18px;
    padding: 30px 32px;
    margin-bottom: 18px;
    color: #fff;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.16);
  }
  .td-hero::after {
    content: "";
    position: absolute;
    width: 320px;
    height: 320px;
    right: -120px;
    top: -190px;
    border-radius: 50%;
    background: rgba(56, 189, 248, 0.12);
    pointer-events: none;
  }
  .td-hero-eyebrow, .td-section-eyebrow {
    display: block;
    margin-bottom: 6px;
    color: #67e8f9;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .td-section-eyebrow { color: #0369a1; }
  .td-hero-title { font-size: 1.65rem; font-weight: 800; margin: 0; letter-spacing: -0.02em; }
  .td-hero-sub { max-width: 720px; color: #cbd5e1; margin: 7px 0 0; font-size: 0.9rem; line-height: 1.55; }
  .td-hero-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
  .td-hero-date { color: #cbd5e1; font-size: 0.78rem; display: inline-flex; align-items: center; }
  .td-hero-actions { display: flex; align-items: center; gap: 16px; justify-content: flex-end; flex-wrap: wrap; }
  .td-hero-stat { text-align: center; background: rgba(255,255,255,0.09); border: 1px solid rgba(255,255,255,0.13); border-radius: 12px; padding: 11px 16px; min-width: 88px; backdrop-filter: blur(8px); }
  .td-hero-stat .stat-num { display: block; font-size: 1.4rem; font-weight: 800; color: #fff; line-height: 1; }
  .td-hero-stat .stat-label { display: block; font-size: 0.7rem; color: #94a3b8; margin-top: 3px; white-space: nowrap; }
  .td-availability-badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 700;
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
  }
  .td-availability-badge .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #64748b; }
  .td-availability-badge.online .status-dot { background: #22c55e; box-shadow: 0 0 6px rgba(34,197,94,0.5); }
  .td-availability-badge.offline .status-dot { background: #64748b; }
  .exp-type-pill { border-radius: 20px !important; font-size: 0.78rem !important; transition: all 0.15s; }
  .exp-type-pill.active { font-weight: 700; box-shadow: 0 2px 6px rgba(0,0,0,0.15); }

  /* Primary booking/order navigation */
  .td-work-hub {
    padding: 18px;
    background: #fff;
    border: 1px solid var(--td-border);
    border-radius: 16px;
    box-shadow: 0 6px 22px rgba(15, 23, 42, 0.05);
  }
  .td-work-hub-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 13px;
  }
  .td-work-hub-header h2 { margin: 0; color: var(--td-ink); font-size: 1rem; font-weight: 800; }
  .td-work-hub-note { color: var(--td-muted); font-size: 0.75rem; }
  .td-work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .td-work-route {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) auto;
    align-items: center;
    gap: 13px;
    min-width: 0;
    min-height: 104px;
    padding: 16px;
    color: var(--td-ink);
    text-decoration: none;
    border: 1px solid #dbe5f0;
    border-radius: 13px;
    background: #f8fafc;
    transition: border-color .16s ease, box-shadow .16s ease, transform .16s ease;
  }
  .td-work-route:hover {
    color: var(--td-ink);
    border-color: #93c5fd;
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.08);
    transform: translateY(-1px);
  }
  .td-work-route:focus-visible { outline: 3px solid rgba(14, 165, 233, .25); outline-offset: 2px; }
  .td-work-route-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    font-size: 1.15rem;
  }
  .td-work-route-bookings .td-work-route-icon { color: #0369a1; background: #e0f2fe; }
  .td-work-route-orders .td-work-route-icon { color: #6d28d9; background: #ede9fe; }
  .td-work-route-copy { display: flex; flex-direction: column; min-width: 0; }
  .td-work-route-type { color: var(--td-muted); font-size: .64rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .td-work-route-copy strong { margin-top: 2px; font-size: .98rem; }
  .td-work-route-copy small { margin-top: 2px; overflow: hidden; color: var(--td-muted); font-size: .73rem; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
  .td-work-route-side { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; white-space: nowrap; }
  .td-work-route-count { color: var(--td-muted); font-size: .7rem; }
  .td-work-route-count strong { color: var(--td-ink); font-size: 1rem; }
  .td-work-route-action { display: inline-flex; align-items: center; gap: 6px; color: #2563eb; font-size: .74rem; font-weight: 800; }

  /* KPI Grid */
  .td-kpi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
  .td-kpi-card {
    background: #fff; border-radius: 14px; padding: 20px; display: flex; align-items: center; gap: 16px;
    border: 1px solid #eef2f7; transition: all 0.2s;
  }
  .td-kpi-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(15,23,42,0.06); }
  .td-kpi-icon {
    width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
  }
  .td-kpi-icon.blue { background: #eff6ff; color: #3b82f6; }
  .td-kpi-icon.amber { background: #fffbeb; color: #f59e0b; }
  .td-kpi-icon.green { background: #f0fdf4; color: #22c55e; }
  .td-kpi-icon.emerald { background: #ecfdf5; color: #10b981; }
  .td-kpi-icon.violet { background: #f5f3ff; color: #8b5cf6; }
  .td-kpi-icon.rose { background: #fff1f2; color: #f43f5e; }
  .td-kpi-body { display: flex; flex-direction: column; }
  .td-kpi-value { font-size: 1.6rem; font-weight: 800; color: #1e293b; line-height: 1.1; }
  .td-kpi-label { font-size: 0.75rem; color: #64748b; margin-top: 2px; }

  /* Panels */
  .td-panel {
    background: #fff; border-radius: 14px; border: 1px solid var(--td-border); overflow: hidden;
    box-shadow: 0 5px 18px rgba(15, 23, 42, 0.04);
  }
  .td-panel-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 20px; border-bottom: 1px solid #f1f5f9;
  }
  .td-panel-title { font-size: 0.9rem; font-weight: 700; color: #1e293b; margin: 0; }
  .td-panel-link { font-size: 0.78rem; color: #3b82f6; text-decoration: none; font-weight: 600; }
  .td-panel-link:hover { text-decoration: underline; }
  .td-panel-body { padding: 16px 20px; }

  /* Empty State */
  .td-empty-state { text-align: center; padding: 24px 0; color: #94a3b8; }
  .td-empty-state i { font-size: 2rem; margin-bottom: 8px; display: block; }
  .td-empty-state p { margin: 0; font-size: 0.85rem; }

  /* Assignment Card */
  .td-assign-card {
    display: flex; align-items: flex-start; gap: 14px; padding: 14px 16px; border-radius: 12px;
    background: #f8fafc; border: 1px solid #eef2f7; margin-bottom: 10px; transition: all 0.15s;
  }
  .td-assign-card:hover { background: #f1f5f9; }
  .td-assign-card:last-child { margin-bottom: 0; }
  .td-assign-card.today-booking {
    border: 1px solid #fbbf24;
    background: #fffbeb;
    box-shadow: inset 3px 0 0 #f59e0b;
    position: relative;
  }
  .td-assign-card.today-booking:hover { background: #fef3c7; }
  .td-assign-icon {
    width: 42px; height: 42px; min-width: 42px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
  }
  .td-assign-info { flex: 1; min-width: 0; }
  .td-assign-info h6 { font-size: 0.85rem; font-weight: 700; color: #1e293b; margin: 0 0 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .td-assign-info p { font-size: 0.75rem; color: #64748b; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .td-assign-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; flex: 0 0 auto; }
  .td-assign-actions { display: flex; justify-content: flex-end; gap: 6px; flex-wrap: wrap; }
  .td-assign-actions .btn,
  .td-active-actions .btn,
  #tdEodBanner .btn {
    display: inline-flex;
