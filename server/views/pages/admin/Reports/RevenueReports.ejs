  // ── Render KPI sparklines ──
  function renderSparklines(A) {
    const months = Object.values(A.monthlyRevenue || {}).reverse();
    const sparkData = {
      kpiSparkRevenue: months.map(x => x.total || 0),
      kpiSparkCash: months.map(x => (x.service || 0) * 0.7 + (x.pos || 0) * 0.3),
      kpiSparkAvgTxn: months.map(x => (x.total || 0) / Math.max(1, (x.service || 0) + (x.orders || 0) + (x.pos || 0))),
    };
    const sparkColors = { kpiSparkRevenue: '#2563eb', kpiSparkCash: '#06b6d4', kpiSparkAvgTxn: '#8b5cf6' };
    Object.entries(sparkData).forEach(([id, data]) => {
      const el = document.getElementById(id);
      if (!el || !data.length) return;
      const existing = Chart.getChart(el);
      if (existing) existing.destroy();
      new Chart(el, {
        type: 'line',
        data: { labels: data.map((_, i) => i), datasets: [{ data, borderColor: sparkColors[id], borderWidth: 1.5, pointRadius: 0, tension: 0.4, fill: true, backgroundColor: sparkColors[id] + '15' }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { display: false }, y: { display: false } }, elements: { line: { borderCapStyle: 'round' } } }
      });
    });
  }

  // ── Chart Detail Modal ──
  let currentA = initA;
  let cdmChart = null;
  let cdmModal = null;
  let serviceLineModal = null;

  document.getElementById('posCategoryTabs')?.addEventListener('click', event => {
    const button = event.target.closest('[data-pos-category]');
    if (!button) return;
    activePosCategory = button.dataset.posCategory || 'all';
    document.querySelectorAll('#posCategoryTabs [data-pos-category]').forEach(tab => {
      const active = tab === button;
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-selected', String(active));
    });
    renderPosCategorySection(currentA);
  });

  function openServiceLineDrilldown(index) {
    const row = (currentA.serviceProfitability?.rows || [])[index];
    if (!row) return;
    const modalElement = document.getElementById('serviceLineDrilldownModal');
    if (!modalElement) return;
    if (!serviceLineModal) serviceLineModal = new bootstrap.Modal(modalElement);
    document.getElementById('serviceLineDrilldownTitle').textContent = row.serviceName;
    document.getElementById('serviceLineDrilldownSubtitle').textContent = `${String(row.serviceCategory||'service').replaceAll('_',' ')} · ${row.jobs||0} completed jobs · ${pct(row.costEvidenceCoverage)} direct-saved cost details`;
    document.getElementById('serviceLineDrilldownSummary').innerHTML = `
      <article><small>Revenue</small><strong>${peso(row.revenue)}</strong></article>
      <article><small>Saved job and product cost</small><strong>${peso(row.directCost)}</strong></article>
      <article><small>Profit before expenses</small><strong style="color:${Number(row.grossProfit||0)>=0?'#047857':'#b91c1c'}">${peso(row.grossProfit)}</strong></article>
      <article><small>Recorded profit %</small><strong>${pct(row.grossProfitMargin)}</strong></article>`;
    const records = row.records || [];
    document.getElementById('serviceLineDrilldownBody').innerHTML = records.length ? records.map(record => {
      const completed = record.completedAt ? new Date(record.completedAt).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
      return `<tr><td class="ps-4">${esc(completed)}</td><td class="fw-bold">${esc(record.reference||'—')}</td><td>${esc(record.customer||'Customer')}</td><td>${esc(record.technician||'Unassigned')}</td><td class="text-center">${Number(record.quantity||1)}</td><td class="text-end">${peso(record.revenue)}</td><td class="text-end">${peso(record.directCost)}</td><td class="text-end pe-4 fw-bold ${Number(record.grossProfit||0)>=0?'text-success':'text-danger'}">${peso(record.grossProfit)}</td></tr>`;
    }).join('') : '<tr><td colspan="8" class="rr-empty">No jobs to show.</td></tr>';
    serviceLineModal.show();
  }

  document.addEventListener('click', event => {
    const button = event.target.closest('.service-drilldown-btn');
    if (!button) return;
    openServiceLineDrilldown(Number(button.dataset.serviceIndex));
  });

  function pesoFmt(v) { return '\u20B1' + Math.round(Number(v || 0)).toLocaleString('en-PH'); }

  function showChartDetail(config, initialIndex, initialDataset) {
    if (!cdmModal) {
      try { cdmModal = new bootstrap.Modal(document.getElementById('chartDetailModal')); } catch(e) { console.error('Modal init error:', e); return; }
    }
    document.getElementById('cdmTitle').innerHTML = `<i class="bi bi-${config.icon} me-2"></i>${config.title}`;
    document.getElementById('cdmSubtitle').textContent = config.subtitle;
    document.getElementById('cdmChartTitle').textContent = config.chartTitle;
    document.getElementById('cdmChartSubtitle').textContent = config.chartSubtitle;
    document.getElementById('cdmDataTitle').textContent = config.dataTitle;
    document.getElementById('cdmDataSubtitle').textContent = 'Click a chart element to filter';
    document.getElementById('cdmTableHead').innerHTML = `<tr>${config.headers.map(h => `<th>${h}</th>`).join('')}</tr>`;

    if (cdmChart) { try { cdmChart.destroy(); } catch(e){} }
    const chartOpts = {
      responsive: true, maintainAspectRatio: false,
      onClick: (e, els) => {
        if (els.length > 0) updateDetailTable(config, els[0].index, els[0].datasetIndex);
        else updateDetailTable(config, null, null);
      },
      onHover: (e, els) => { if (e.native) e.native.target.style.cursor = els.length > 0 ? 'pointer' : 'default'; },
      plugins: {
        legend: { labels: { usePointStyle: true, boxWidth: 7, font: { size: 11 } } },
        tooltip: { callbacks: { label: ctx => config.tooltipFn ? config.tooltipFn(ctx) : `${ctx.dataset.label || ctx.label}: ${pesoFmt(ctx.parsed.y ?? ctx.parsed)}` } }
      }
    };
    if (config.scales) chartOpts.scales = config.scales;
    if (config.cutout) chartOpts.cutout = config.cutout;

    cdmChart = new Chart(document.getElementById('cdmChart'), { type: config.type, data: typeof config.chartData === 'function' ? config.chartData() : config.chartData, options: chartOpts });
    const initIdx = (initialIndex !== undefined && initialIndex !== null) ? initialIndex : null;
    const initDs = (initialDataset !== undefined && initialDataset !== null) ? initialDataset : null;
    updateDetailTable(config, initIdx, initDs);
    if (cdmModal) {
      cdmModal.show();
      document.getElementById('chartDetailModal').addEventListener('shown.bs.modal', function onShown() {
        if (cdmChart) cdmChart.resize();
        document.getElementById('chartDetailModal').removeEventListener('shown.bs.modal', onShown);
      }, { once: true });
    }
  }

  function updateDetailTable(config, filterIndex, datasetIndex) {
    const rows = config.getRows(filterIndex, datasetIndex, currentA);
    const summary = config.getSummary(filterIndex, datasetIndex, currentA);
    const summaryEl = document.getElementById('cdmSummary');
    if (summary && summary.length) {
      summaryEl.innerHTML = summary.map(s => `<div class="cdm-stat"><div class="cdm-stat-label">${s.label}</div><div class="cdm-stat-value">${s.value}</div></div>`).join('');
      summaryEl.style.display = 'grid';
    } else { summaryEl.style.display = 'none'; }

    const tbody = document.getElementById('cdmTableBody');
    const empty = document.getElementById('cdmEmpty');
    if (rows && rows.length) {
      tbody.innerHTML = rows.map(r => `<tr>${r.map(c => `<td>${c}</td>`).join('')}</tr>`).join('');
      empty.style.display = 'none';
      document.getElementById('cdmTable').style.display = '';
    } else {
      tbody.innerHTML = '';
      empty.style.display = 'block';
      document.getElementById('cdmTable').style.display = 'none';
    }

    if (filterIndex !== null) {
      document.getElementById('cdmDataSubtitle').textContent = `Filtered: ${config.getFilterLabel(filterIndex, datasetIndex, currentA)}`;
    } else {
      document.getElementById('cdmDataSubtitle').textContent = 'Click a chart element to filter';
    }
  }

  // ── Chart detail configs ──
  const chartConfigs = {
    revenueTrend: {
      icon: 'bar-chart-line', title: 'Monthly Approved work value', subtitle: 'Approved work by type — click a month to see records',
      chartTitle: 'Monthly approved work by type', chartSubtitle: 'Services · Product Orders · Walk-in sales',
      dataTitle: 'Transactions', headers: ['Date','Source','Reference','Customer','Method','Amount'],
      type: 'bar',
      chartData: () => {
        const labels = Object.keys(currentA.monthlyRevenue || {}).reverse();
        const months = Object.values(currentA.monthlyRevenue || {}).reverse();
        return { labels, datasets: [
          { label: 'Services', data: months.map(x => x.service||0), backgroundColor: '#2563eb', borderRadius: 5 },
          { label: 'Product Orders', data: months.map(x => x.orders||0), backgroundColor: '#10b981', borderRadius: 5 },
          { label: 'POS', data: months.map(x => x.pos||0), backgroundColor: '#f59e0b', borderRadius: 5 },
        ]};
      },
      scales: { x: { stacked: true, grid: { display: false }, ticks: { font: { size: 10 } } }, y: { stacked: true, beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 10 }, callback: v => pesoFmt(v) } } },
      getFilterLabel: (i) => { const labels = Object.keys(currentA.monthlyRevenue || {}).reverse(); return labels[i] || 'Unknown'; },
      getSummary: (i) => {
        const months = Object.values(currentA.monthlyRevenue || {}).reverse();
        if (i === null) return [{label:'Total Booking value',value:pesoFmt(currentA.totalRevenue)},{label:'Transactions',value:(currentA.totalTransactions||0)}];
        const m = months[i] || {};
        return [{label:'Month Booking value',value:pesoFmt(m.total||0)},{label:'Services',value:pesoFmt(m.service||0)},{label:'Orders',value:pesoFmt(m.orders||0)},{label:'POS',value:pesoFmt(m.pos||0)}];
      },
      getRows: (i) => {
        const labels = Object.keys(currentA.monthlyRevenue || {}).reverse();
        let txns = currentA.recentTransactions || [];
