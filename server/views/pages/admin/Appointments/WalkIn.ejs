          </div>
          <div class="walkin-actions">
            <button type="button" class="ent-btn-outline" data-prev-step="1"><i class="bi bi-arrow-left"></i>Back</button>
            <button type="button" class="ent-btn-primary" data-next-step="3">Continue to Calendar<i class="bi bi-arrow-right"></i></button>
          </div>
          </div>
        </div>

        <div class="booking-step d-none ent-step-card" data-step="3">
          <div class="ent-step-header">
            <div class="ent-step-icon step-calendar"><i class="bi bi-calendar-check"></i></div>
            <div class="ent-step-info">
              <h5>Step 4</h5>
              <p>Pick a date and time</p>
            </div>
          </div>
          <div class="ent-step-body">
          <p class="small text-muted mb-2">
            Choose an available date first, then select a preferred start time.
            Availability is re-checked when the Walk-In booking is created.
          </p>

          <div id="calendarGrid" role="grid" aria-live="polite"></div>

          <div id="timeSelection" class="mt-3 d-none">
            <div id="timeSlots"></div>
            <div id="timeSelectionDate" class="d-none"></div>
            <div class="small text-muted mt-2" id="timeRangeInfo"></div>
