                style="width: 72px; height: 72px; background: #f0f7ff; border: 1px solid #bfdbfe; border-radius: 12px;">
                <i class="bi bi-box-seam" style="font-size: 2rem; color: #3b82f6;"></i>
              </div>
              <h5 class="fw-bold mb-1" style="color: #0f172a; font-size: 1rem;">No Products Available</h5>
              <p class="mb-3 mx-auto" style="max-width: 360px; color: #64748b; font-size: 0.85rem;">Check back soon — we're adding new models regularly.</p>
              <button class="btn btn-sm px-3 py-1 fw-semibold" onclick="activeFilter='all';document.querySelectorAll('.ent-filter-pill').forEach(b=>b.classList.toggle('active',b.dataset.filter==='all'));applyFilters();" style="background: linear-gradient(135deg, #2563eb, #3b82f6); color: #fff; border: none; border-radius: 6px; font-size: 0.82rem;">Reset Filters</button>
            </div>
          <% } %>

              <% airconGroups.forEach((g, gIdx)=> { %>
                <div class="col-6 col-md-4 col-lg-3 product-card-wrap" data-type="<%= g.type %>" data-name="<%= g.modelLine.toLowerCase() %>" data-brand="<%= (g.brand || '').toLowerCase() %>">
                  <div class="fp-card h-100">
                    <div class="fp-card-media">
                      <img src="<%= g.imageUrl %>" alt="<%= g.brand %> <%= g.modelLine %>" loading="lazy"
                           onerror="this.src='/images/products/default.png';">
                      <% if (g.inverter) { %><span class="fp-tag fp-tag-inverter">Inverter</span><% } %>
                      <span class="fp-tag fp-tag-stock <%= g.inStock ? 'in' : 'out' %>"><%= g.inStock ? 'In Stock' : 'Sold Out' %></span>
                      <% if (!g.inStock) { %>
                        <div class="fp-sold-overlay"><span>Sold Out</span></div>
                      <% } %>
                    </div>
                    <div class="fp-card-body">
                      <div class="fp-brand"><%= g.brand %></div>
                      <h5 class="fp-name"><%= g.modelLine %></h5>
                      <div class="fp-meta">
                        <span class="fp-type"><%= g.type.replace(/_/g,' ').replace(/\b\w/g, c=> c.toUpperCase()) %></span>
                        <% if (g.variants && g.variants.length) { %><span class="fp-dot">•</span><span><%= g.variants[0].capacity %> <%= g.variants[0].capacityUnit %><% if (g.variants.length > 1) { %> +<% } %></span><% } %>
                      </div>
                      <div class="fp-foot">
                        <div class="fp-price">
                          <% if (g.variants.length > 1) { %><span class="fp-from">from</span><% } %>
                          <% if (g.startingPrice) { %>₱<%= Number(g.startingPrice).toLocaleString() %><% } else { %><span class="fp-from">Price on request</span><% } %>
                        </div>
                        <a href="/products/<%= g._id %>" class="fp-buy" aria-label="View <%= g.brand %> <%= g.modelLine %>">View Product <i class="bi bi-arrow-right"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
        </div>

    </div>
  </div>

