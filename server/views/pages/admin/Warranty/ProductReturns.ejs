<link rel="stylesheet" href="/css/operations-aftercare.css?v=20260927">
<div class="container-fluid py-4 ops-modern" id="productReturnsAdmin">
  <style>
    .rma-shell{max-width:1320px;margin:auto}.rma-card{background:#fff;border:1px solid #e2e8f0;border-radius:16px;box-shadow:0 4px 18px #0f172a0a}.rma-card-header{padding:1.15rem 1.3rem;border-bottom:1px solid #e2e8f0}.rma-card-body{padding:1.3rem}.rma-muted{color:#64748b}.rma-eyebrow{text-transform:uppercase;letter-spacing:.09em;font-size:.7rem;font-weight:800;color:#2563eb}.rma-status{display:inline-block;border-radius:999px;background:#eff6ff;color:#1d4ed8;padding:.3rem .65rem;font-size:.75rem;font-weight:700}.rma-list-button{display:block;width:100%;border:1px solid #e2e8f0;background:#fff;text-align:left;border-radius:12px;padding:.9rem;margin-bottom:.6rem}.rma-list-button:hover,.rma-list-button.active{border-color:#3b82f6;background:#eff6ff}.rma-fact{border:1px solid #e2e8f0;border-radius:10px;padding:.75rem;background:#f8fafc}.rma-fact small{display:block;color:#64748b}.rma-step{border-left:3px solid #bfdbfe;padding:.2rem 0 .2rem 1rem;margin:.7rem 0}.rma-step small{color:#64748b}.rma-action-panel{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:1rem}.rma-history{max-height:260px;overflow:auto}@media(max-width:991px){.rma-card-body{padding:1rem}}
  </style>
  <div class="rma-shell">
    <header class="ops-hero mb-3">
      <div class="ops-hero-inner">
        <div class="ops-hero-copy"><div class="ops-hero-icon"><i class="bi bi-arrow-return-left"></i></div><div><div class="ops-eyebrow">After-sales operations</div><h1>Product Returns</h1><p>Review eligibility, inspect returned products, and control refunds or replacements without returning unsafe items to sellable stock.</p></div></div>
        <button class="btn btn-light" id="rmaOpenCounter"><i class="bi bi-receipt me-1"></i>New counter return</button>
      </div>
    </header>
    <div class="ops-kpis" aria-label="Return operations summary">
      <div class="ops-kpi" style="--kpi:#2563eb"><div class="ops-kpi-top"><span class="ops-kpi-label">Open requests</span><span class="ops-kpi-icon"><i class="bi bi-inbox"></i></span></div><div class="ops-kpi-value" id="rmaKpiOpen">0</div><div class="ops-kpi-meta">Requires operational action</div></div>
      <div class="ops-kpi" style="--kpi:#dc2626"><div class="ops-kpi-top"><span class="ops-kpi-label">High priority</span><span class="ops-kpi-icon"><i class="bi bi-exclamation-octagon"></i></span></div><div class="ops-kpi-value" id="rmaKpiPriority">0</div><div class="ops-kpi-meta">Damage or dead-on-arrival cases</div></div>
      <div class="ops-kpi" style="--kpi:#d97706"><div class="ops-kpi-top"><span class="ops-kpi-label">Refund decisions</span><span class="ops-kpi-icon"><i class="bi bi-cash-coin"></i></span></div><div class="ops-kpi-value" id="rmaKpiRefund">0</div><div class="ops-kpi-meta">Pending approval or processing</div></div>
      <div class="ops-kpi" style="--kpi:#059669"><div class="ops-kpi-top"><span class="ops-kpi-label">Completed</span><span class="ops-kpi-icon"><i class="bi bi-check2-circle"></i></span></div><div class="ops-kpi-value" id="rmaKpiCompleted">0</div><div class="ops-kpi-meta">Resolved return requests</div></div>
    </div>
    <details class="rma-card mb-3"><summary class="rma-card-header" style="cursor:pointer;font-weight:700">Return period settings</summary><form class="rma-card-body d-flex flex-wrap align-items-end gap-2" id="rmaPolicyForm"><div><label class="form-label small" for="rmaReturnDays">Days after purchase or handover</label><input class="form-control" id="rmaReturnDays" type="number" min="1" max="3650" step="1" required></div><button class="btn btn-outline-primary" type="submit">Save period</button><div class="small rma-muted">Recorded product warranty coverage can extend eligibility beyond this period.</div></form></details>
    <div class="rma-workspace">
      <div class="col-lg-4"><div class="rma-card"><div class="rma-card-header d-flex align-items-center justify-content-between"><strong>Requests</strong><select class="form-select form-select-sm w-auto" id="rmaStatusFilter"><option value="">All</option><option value="requested">New</option><option value="under_review">Reviewing</option><option value="awaiting_return">Waiting for item</option><option value="received">Received</option><option value="inspected">Inspected</option><option value="refund_pending">Refund decision</option><option value="refund_approved">Refund approved</option><option value="refund_processing">Refund processing</option><option value="replacement_pending">Replacement</option><option value="repair_pending">Repair</option><option value="completed">Completed</option><option value="rejected">Declined</option></select></div><div class="rma-card-body" id="rmaList" aria-live="polite">Loading requests…</div></div></div>
      <div class="col-lg-8"><div class="rma-card"><div class="rma-card-header"><strong id="rmaDetailTitle">Choose a request</strong><div class="small rma-muted" id="rmaDetailSubtitle">The next action appears here.</div></div><div class="rma-card-body" id="rmaDetail"><div class="text-center rma-muted py-5"><i class="bi bi-box-seam fs-2 d-block mb-2"></i>Choose a return from the list.</div></div></div></div>
    </div>
  </div>
    <div class="modal fade" id="rmaCounterModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><form class="modal-content" id="rmaCounterForm"><div class="modal-header"><h2 class="modal-title h5 mb-0">Counter-sale return</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p class="small rma-muted">Use the receipt number to find the exact part sold. The customer cannot approve their own refund.</p><label class="form-label fw-semibold" for="rmaInvoice">Receipt number</label><div class="input-group mb-3"><input class="form-control" id="rmaInvoice" placeholder="WIS-..." required><button type="button" class="btn btn-outline-primary" id="rmaFindInvoice">Find sale</button></div><div id="rmaCounterFields" hidden><label class="form-label" for="rmaCounterItem">Product</label><select class="form-select mb-3" id="rmaCounterItem" required></select><div id="rmaCounterEligibility" class="small mb-3"></div><label class="form-label" for="rmaCounterQuantity">Quantity to return</label><input type="number" min="1" step="1" value="1" class="form-control mb-3" id="rmaCounterQuantity" required><label class="form-label" for="rmaCounterReason">Reason</label><select class="form-select mb-3" id="rmaCounterReason" required><option value="defective">Not working</option><option value="delivery_damage">Damaged when received</option><option value="wrong_item">Wrong item</option><option value="wrong_specification">Wrong specification</option><option value="missing_parts">Missing parts</option><option value="warranty">Warranty issue</option><option value="dead_on_arrival">Did not work from the start</option><option value="manufacturing_defect">Manufacturing defect</option><option value="wrong_quantity">Wrong quantity</option><option value="other">Other</option></select><label class="form-label" for="rmaCounterDescription">What is wrong?</label><textarea class="form-control mb-3" id="rmaCounterDescription" rows="3" minlength="10" required></textarea><label class="form-label" for="rmaCounterResolution">Customer prefers</label><select class="form-select mb-3" id="rmaCounterResolution"><option value="replacement">Replacement</option><option value="refund">Refund</option><option value="repair">Repair</option></select><label class="form-label" for="rmaBookingReference">Related service booking (optional)</label><input class="form-control" id="rmaBookingReference" placeholder="Booking number if CALIDRO installed this part"></div><div class="alert alert-danger d-none mt-3 mb-0" id="rmaCounterError" role="alert"></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button><button type="submit" class="btn btn-primary" id="rmaCounterSubmit" disabled>Send request for review</button></div></form></div></div>
</div>
<script src="/js/product-returns-admin.js?v=20260927-modern-ops" defer></script>
