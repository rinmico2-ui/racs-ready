  AU.Pending.getServiceType=function(b){
    var items=Array.isArray(b.services)?b.services:[];
    var hasRepair=items.some(function(s){return String(s.type||'').toLowerCase()==='repair';});
    var hasCore=items.some(function(s){return String(s.type||'').toLowerCase()!=='repair';});
    if((hasCore&&hasRepair)||String(b.serviceType||'').toLowerCase()==='mixed')return'mixed';
    if(hasRepair||String(b.serviceType||'').toLowerCase()==='repair'||b.serviceModel==='RepairService')return'repair';
    return'core';
  };

  AU.Pending.getServiceDetails=function(b){
    var items=Array.isArray(b.services)&&b.services.length?b.services:[b.service||{}];
    return items.map(function(s,index){
      var itemType=String(s.type||'').toLowerCase();
      var type=itemType==='repair'||(!itemType&&AU.Pending.getServiceType(b)==='repair')?'Repair':'Core';
      var name=s.name||s.applianceTypeName||s.applianceType||(type==='Repair'?'Repair Service':'Service');
      var unit=[s.brand,s.model,s.hpDescription||s.hp].filter(Boolean).join(' / ');
      var issue=s.problemDescription||s.repairIssue||s.issueDescription||'';
      return '<div class="'+(index?'mt-2 pt-2 border-top':'')+'"><div class="small fw-semibold">'+qEsc(name)+' <span class="text-muted fw-normal">('+type+')</span></div>'+
        (unit?'<div class="text-muted" style="font-size:0.7rem;">'+qEsc(unit)+'</div>':'')+
        (issue?'<div class="text-muted text-truncate" style="font-size:0.7rem;max-width:260px;" title="'+qEsc(issue)+'"><i class="bi bi-exclamation-circle me-1"></i>'+qEsc(issue)+'</div>':'')+'</div>';
    }).join('');
  };

