<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120" aria-hidden="true" focusable="false">
  <circle cx="60" cy="60" r="60" fill="<%= avatar.background %>" />
  <circle cx="99" cy="21" r="13" fill="#ffffff" opacity=".45" />
  <circle cx="19" cy="99" r="19" fill="#ffffff" opacity=".3" />
  <path d="M24 120v-13c0-20 16-33 36-33s36 13 36 33v13" fill="<%= avatar.dark %>" />
  <path d="m47 89 13 12 13-12" fill="none" stroke="<%= avatar.accent %>" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M60 30V19" stroke="<%= avatar.dark %>" stroke-width="4" stroke-linecap="round" />
  <% if (avatar.accessory === 0) { %>
    <circle cx="60" cy="16" r="6" fill="<%= avatar.body %>" />
  <% } else if (avatar.accessory === 1) { %>
    <path d="m60 9 7 7-7 7-7-7z" fill="<%= avatar.body %>" />
  <% } else { %>
    <path d="M55 18c-6-8-15-7-15-1 0 7 13 10 20 4 7 6 20 3 20-4 0-6-9-7-15 1" fill="<%= avatar.body %>" />
  <% } %>
  <rect x="18" y="47" width="15" height="21" rx="7" fill="<%= avatar.accent %>" />
  <rect x="87" y="47" width="15" height="21" rx="7" fill="<%= avatar.accent %>" />
  <rect x="28" y="29" width="64" height="57" rx="<%= avatar.variant === 1 ? 26 : 20 %>" fill="<%= avatar.body %>" />
  <rect x="35" y="42" width="50" height="27" rx="13" fill="<%= avatar.background %>" />
  <% if (avatar.variant === 2) { %>
    <path d="M44 56q4-7 8 0m16 0q4-7 8 0" fill="none" stroke="<%= avatar.dark %>" stroke-width="3" stroke-linecap="round" />
  <% } else { %>
    <ellipse cx="48" cy="55" rx="3" ry="5" fill="<%= avatar.dark %>" />
    <ellipse cx="72" cy="55" rx="3" ry="5" fill="<%= avatar.dark %>" />
  <% } %>
  <path d="M54 74q6 6 12 0" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" />
  <circle cx="38" cy="70" r="4" fill="<%= avatar.accent %>" opacity=".7" />
  <circle cx="82" cy="70" r="4" fill="<%= avatar.accent %>" opacity=".7" />
</svg>
