</section>

<style>
:root{--sv-b:#2563eb;--sv-bd:#1d4ed8;--sv-bl:#60a5fa;--sv-bs:rgba(37,99,235,0.08);--sv-g:#10b981;--sv-r:#ef4444;--sv-c:#f59e0b;--sv-f:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;--sv-r1:12px;--sv-r2:16px;--sv-sh:0 2px 16px rgba(15,23,42,0.04);--sv-sh2:0 8px 32px rgba(15,23,42,0.06);--sv-e:cubic-bezier(0.16,1,0.3,1)}
body{font-family:var(--sv-f);background:#f8fafc;min-height:100vh}

.sv-hero{position:relative;overflow:hidden;padding:5rem 0 6rem;background:linear-gradient(160deg, #e0f2fe 0%, #f0fdf4 35%, #e0e7ff 70%, #ede9fe 100%);border-bottom:1px solid rgba(37,99,235,0.06)}
.sv-hero-bg{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 900px 600px at 70% 10%, rgba(59, 130, 246, 0.1) 0%, transparent 55%),radial-gradient(ellipse 600px 450px at 20% 90%,rgba(6,182,212,0.05) 0%,transparent 55%)}
.sv-orb{position:absolute;border-radius:50%;pointer-events:none;filter:blur(60px)}
.sv-orb-1{width:400px;height:400px;background:radial-gradient(circle,rgba(37,99,235,0.08) 0%,transparent 70%);top:-120px;right:-60px;animation:sf1 12s ease-in-out infinite}
.sv-orb-2{width:280px;height:280px;background:radial-gradient(circle,rgba(6,182,212,0.07) 0%,transparent 70%);bottom:-80px;left:20%;animation:sf2 14s ease-in-out infinite}
@keyframes sf1{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-30px,35px) scale(1.06)}}
@keyframes sf2{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(25px,-30px) scale(1.08)}}
.sv-hero-badge{display:inline-flex;align-items:center;gap:8px;padding:7px 18px 7px 16px;border-radius:9999px;font-size:0.65rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;background:linear-gradient(135deg,rgba(37,99,235,0.1),rgba(37,99,235,0.04));color:#1d4ed8;border:1px solid rgba(37,99,235,0.12);margin-bottom:1.25rem;box-shadow:0 2px 8px rgba(15,23,42,0.03)}
.sv-hero-title{font-size:clamp(2.6rem,5.5vw,3.8rem);font-weight:800;color:#0f172a;letter-spacing:-1.5px;line-height:1.1;margin-bottom:0.75rem}
.sv-grad{background:linear-gradient(135deg,var(--sv-b),#06b6d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.sv-hero-sub{font-size:clamp(1rem,1.5vw,1.15rem);color:#475569;max-width:520px;margin:0 auto 1.5rem;line-height:1.6}
.sv-trust{display:flex;align-items:center;justify-content:center;gap:0.75rem;flex-wrap:wrap;margin-bottom:1.75rem}
.sv-trust span{display:inline-flex;align-items:center;gap:6px;font-size:0.8rem;font-weight:600;color:#334155}
.sv-trust svg{color:var(--sv-b);flex-shrink:0}
.sv-dot{width:4px;height:4px;border-radius:50%;background:#cbd5e1}
.sv-stats{display:inline-flex;justify-content:center;gap:2.5rem;padding:1.25rem 2rem;background:rgba(255,255,255,0.7);backdrop-filter:blur(16px);border-radius:var(--sv-r2);border:1px solid rgba(148,163,184,0.1);margin:0 auto;box-shadow:0 4px 24px rgba(15,23,42,0.04)}
.sv-stat-v{font-size:1.4rem;font-weight:800;color:#0f172a;letter-spacing:-0.5px}
.sv-stat-l{font-size:0.75rem;color:#64748b;font-weight:500;margin-top:2px}
.sv-body{padding:3rem 0 5rem}
.sv-wrap{position:relative;max-width:980px;margin:0 auto;background:rgba(255,255,255,0.95);backdrop-filter:blur(40px) saturate(180%);-webkit-backdrop-filter:blur(40px) saturate(180%);padding:2rem 2.5rem;border-radius:24px;border:1px solid rgba(255,255,255,0.8);box-shadow:0 12px 40px rgba(15,23,42,0.05),0 2px 10px rgba(15,23,42,0.02),inset 0 1px 0 rgba(255,255,255,0.9)}
@media(max-width:767px){.sv-wrap{padding:1.25rem;border-radius:16px}}

.sv-alert{display:flex;align-items:flex-start;gap:10px;padding:1rem 1.25rem;border-radius:var(--sv-r1);font-size:0.9rem;line-height:1.5}
.sv-alert-w{background:#fffbeb;border-left:4px solid #f59e0b;color:#92400e}
.sv-alert-s{background:#f0fdf4;border-left:4px solid #16a34a;color:#166534}
.sv-alert-i{background:#eff6ff;border-left:4px solid var(--sv-b);color:#1e3a8a}
.sv-alert-c{background:#fffbeb;border-left:4px solid #ca8a04}
.sv-alert-link{color:var(--sv-b);font-weight:600;text-decoration:underline}

.sv-tr{position:fixed;right:20px;top:100px;z-index:100;max-width:280px;width:100%}
.sv-tr-card{background:rgba(255,255,255,0.96);backdrop-filter:blur(20px);border-radius:var(--sv-r2);border:1px solid rgba(148,163,184,0.12);padding:1.15rem;box-shadow:0 20px 60px rgba(15,23,42,0.1)}
.sv-tr-h{margin-bottom:0.75rem}
.sv-tr-b{background:linear-gradient(135deg,#10b981,#059669);color:#fff;padding:3px 10px;border-radius:9999px;font-size:0.65rem;font-weight:700;letter-spacing:0.3px}
.sv-tr-p{width:7px;height:7px;border-radius:50%;background:#10b981;animation:pp 1.6s ease-in-out infinite;display:inline-block}
@keyframes pp{0%{box-shadow:0 0 0 0 rgba(16,185,129,0.6)}70%{box-shadow:0 0 0 6px rgba(16,185,129,0)}100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}}
.sv-tr h5{font-size:0.85rem;font-weight:700;color:#0f172a}
.sv-tr-steps{list-style:none;padding:0;margin:0}
.sv-tr-steps>li{display:flex;align-items:flex-start;gap:8px;position:relative;padding-bottom:0.85rem}
.sv-tr-i{width:24px;height:24px;border-radius:50%;background:#f1f5f9;border:1.5px solid #e2e8f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#94a3b8;font-size:0.6rem;position:relative;z-index:1}
.sv-tr-l{position:absolute;left:11px;top:24px;bottom:0;width:1.5px;background:#e2e8f0}
.sv-tr-t{display:block;font-size:0.75rem;font-weight:600;color:#64748b}
.sv-tr-d{display:block;font-size:0.65rem;color:#94a3b8}
.sv-tr-f{margin-top:0.5rem}
.sv-btn-b{width:100%;padding:0.45rem;border-radius:8px;border:1px solid var(--sv-b);background:transparent;color:var(--sv-b);font-weight:600;font-size:0.75rem;cursor:pointer}
.sv-btn-b:hover{background:var(--sv-bs)}

.ent-stepper{background:#fff;border-radius:var(--sv-r2);border:1px solid rgba(148,163,184,0.08);padding:1rem 1.25rem;margin-bottom:1.5rem;box-shadow:0 4px 24px rgba(15,23,42,0.04);position:sticky;top:84px;z-index:40}
.ent-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:0.85rem}
.ent-h span:first-child{font-size:0.8rem;font-weight:700;color:#0f172a;letter-spacing:0.3px;text-transform:uppercase}
.ent-h span:last-child{font-size:0.72rem;color:#64748b;font-weight:600}
.ent-h span:last-child span{color:var(--sv-b)}
.ent-tr{display:flex;justify-content:space-between;background:#f1f5f9;border-radius:9999px;padding:3px;gap:2px}
.ent-fill{display:none}
.ent-n{display:flex;align-items:center;gap:5px;padding:6px 12px;border-radius:9999px;cursor:pointer;transition:all 0.3s var(--sv-e);font-size:0.72rem;font-weight:600;color:#94a3b8;white-space:nowrap}
.ent-n.active{background:var(--sv-b);color:#fff;box-shadow:0 4px 12px rgba(37,99,235,0.2)}
.ent-n.completed{background:#f0fdf4;color:#16a34a}
.ent-n:hover{background:#e2e8f0;color:#475569}
.ent-n.active:hover{background:var(--sv-b)}
.ent-ni{font-size:0.85rem;display:flex}

.sv-card{width:100%;background:#fff;border-radius:var(--sv-r2);border:1px solid rgba(148,163,184,0.08);box-shadow:0 2px 16px rgba(15,23,42,0.04);margin-bottom:1.5rem;overflow:visible}
.sv-card-h{display:flex;align-items:center;gap:12px;padding:1.15rem 1.5rem;background:linear-gradient(135deg,#fafbff,#f8fafc);border-bottom:1px solid #eef2f6}
.sv-card-h h5{font-size:1rem;font-weight:700;color:#0f172a;margin:0;letter-spacing:-0.3px}
.sv-card-h p{font-size:0.82rem;color:#64748b;margin:2px 0 0}
.sv-card-ico{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1.05rem}
.sv-ico-login{background:linear-gradient(135deg,rgba(37,99,235,0.12),rgba(37,99,235,0.04));color:var(--sv-b);border:1px solid rgba(37,99,235,0.08)}
.sv-ico-srv{background:linear-gradient(135deg,rgba(139,92,246,0.12),rgba(139,92,246,0.04));color:#7c3aed;border:1px solid rgba(139,92,246,0.08)}
.sv-ico-loc{background:linear-gradient(135deg,rgba(16,185,129,0.12),rgba(16,185,129,0.04));color:#059669;border:1px solid rgba(16,185,129,0.08)}
.sv-ico-cal{background:linear-gradient(135deg,rgba(245,158,11,0.12),rgba(245,158,11,0.04));color:#d97706;border:1px solid rgba(245,158,11,0.08)}
.sv-ico-fee{background:linear-gradient(135deg,rgba(236,72,153,0.12),rgba(236,72,153,0.04));color:#db2777;border:1px solid rgba(236,72,153,0.08)}
.sv-ico-pay{background:linear-gradient(135deg,rgba(99,102,241,0.12),rgba(99,102,241,0.04));color:#6366f1;border:1px solid rgba(99,102,241,0.08)}
.sv-card-b{padding:1.5rem}

.sv-btn{display:inline-flex;align-items:center;gap:8px;padding:0.6rem 1.35rem;border-radius:10px;font-weight:700;font-size:0.88rem;cursor:pointer;transition:all 0.25s var(--sv-e);text-decoration:none;border:none}
.sv-btn-p{background:linear-gradient(135deg,var(--sv-b),var(--sv-bd));color:#fff;box-shadow:0 4px 16px rgba(37,99,235,0.2)}
.sv-btn-p:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(37,99,235,0.3)}
.sv-btn-p:disabled{opacity:0.5;cursor:not-allowed;transform:none}
.sv-btn-o{border:1.5px solid #cbd5e1;background:transparent;color:#475569}
.sv-btn-o:hover{border-color:var(--sv-b);color:var(--sv-b);background:var(--sv-bs)}
.sv-btn-lg{padding:0.85rem;font-size:0.95rem;width:100%;justify-content:center}
.sv-btn-sm{padding:0.35rem 0.9rem;font-size:0.78rem;border-radius:8px}
.sv-btn-g{border-color:#10b981;color:#059669}
.sv-btn-g:hover{border-color:#047857;color:#047857;background:#f0fdf4}

.sv-tabs{border-bottom:1px solid #e2e8f0}
.sv-tabs .nav-link{border:none;color:#64748b;font-weight:500;font-size:0.85rem;padding:0.55rem 1.1rem;border-radius:8px 8px 0 0}
.sv-tabs .nav-link:hover{color:var(--sv-b);background:var(--sv-bs)}
.sv-tabs .nav-link.active{color:var(--sv-b);background:transparent;border-bottom:2px solid var(--sv-b)}

.sv-sel{border-left:3px solid var(--sv-b);background:#fff;border-radius:var(--sv-r1);border:1px solid #e2e8f0;overflow:hidden}
.sv-sel-h{padding:0.85rem 1rem;border-bottom:1px solid #f1f5f9}
.sv-sel-h h6{font-size:0.88rem;font-weight:700;color:#0f172a;margin:0}
.sv-bg{display:inline-flex;padding:2px 10px;border-radius:9999px;font-size:0.72rem;font-weight:700;background:var(--sv-b);color:#fff}
.sv-t{color:var(--sv-b)}

.sv-lb{font-size:0.85rem;font-weight:600;color:#374151;margin-bottom:0.4rem;display:block}
.sv-ig{display:flex;align-items:center;border-radius:12px;overflow:hidden;border:1.5px solid #e5e7eb;background:#fff;transition:border-color 0.2s ease}
.sv-ig:focus-within{border-color:var(--sv-b);box-shadow:0 0 0 3px rgba(37,99,235,0.1)}
.sv-ig-i{display:flex;align-items:center;padding:0.55rem 0.75rem;color:var(--sv-b);background:#fff}
.sv-in{flex:1;border:none;background:#fafafa;padding:0.55rem 0.75rem;font-size:0.88rem;outline:none}
.sv-in:focus{background:#fff}
.sv-sg{position:absolute;width:100%;z-index:1000;border-radius:12px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,0.12);border:1px solid #e5e7eb;background:#fff}
.sv-mw{position:relative;border-radius:16px;overflow:hidden;box-shadow:0 4px 16px rgba(15,23,42,0.06)}
.technician-map{height:340px;width:100%;border-radius:16px}
.sv-mb{position:absolute;top:10px;right:10px;display:flex;gap:6px;z-index:1000}
.sv-mbtn{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;border:2px solid #fff;font-size:0.75rem;font-weight:600;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,0.12)}
.sv-mbtn-b{background:#2563eb;color:#fff}
.sv-mbtn-gr{background:#10b981;color:#fff}
.sv-md{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,0.8)}
.sv-mo{position:absolute;bottom:10px;left:10px;right:10px;background:rgba(255,255,255,0.95);backdrop-filter:blur(8px);border-radius:12px;padding:8px 12px;font-size:0.75rem;color:#64748b;display:flex;align-items:center;gap:8px;flex-wrap:wrap;box-shadow:0 2px 12px rgba(0,0,0,0.08);z-index:1000;pointer-events:none}
.sv-fare{background:#fff;border-radius:14px;padding:1rem;border:1px solid #e2e8f0;box-shadow:0 2px 8px rgba(0,0,0,0.03)}
.sv-fi{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.sv-fi-d{background:linear-gradient(135deg,#ede9fe,#ddd6fe);color:#7c3aed;font-size:0.85rem}
.sv-fi-c{background:linear-gradient(135deg,#dcfce7,#bbf7d0);color:#16a34a;font-size:0.85rem}
.sv-ft{color:#1e293b;font-size:0.88rem;font-weight:700;margin:0}

/* ── Checkout-style service map ── */
.service-map-search .form-label{font-size:.82rem;color:#334155;margin-bottom:.45rem}
.service-map-input{overflow:hidden;border:1.5px solid #dbe3ee;border-radius:12px;background:#fff;box-shadow:0 2px 8px rgba(15,23,42,.05);transition:border-color .2s,box-shadow .2s}
.service-map-input:focus-within{border-color:#60a5fa;box-shadow:0 0 0 4px rgba(37,99,235,.08)}
.service-map-input .form-control{background:#fbfdff;font-size:.88rem;box-shadow:none}
.service-map-suggestions{z-index:1080;border:1px solid #dbe3ee;border-radius:12px;overflow:auto;max-height:240px;box-shadow:0 12px 30px rgba(15,23,42,.14)}
.location-hint{color:#64748b;font-size:.7rem}
.service-checkout-map-card{overflow:hidden;border:1px solid #dbe3ee;border-radius:16px;background:#fff;box-shadow:0 8px 26px rgba(15,23,42,.07);transition:border-color .2s,box-shadow .2s}
.service-checkout-map-card:hover,.service-checkout-map-card:focus-within{border-color:#93c5fd;box-shadow:0 10px 30px rgba(37,99,235,.1)}
.service-map-toolbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.85rem 1rem;border-bottom:1px solid #e2e8f0;background:linear-gradient(180deg,#fff,#f8fafc)}
.service-map-toolbar h6{margin:0;color:#0f172a;font-size:.82rem;font-weight:800}
.service-map-toolbar p{margin:2px 0 0;color:#64748b;font-size:.67rem}
.service-map-actions{display:flex;align-items:center;gap:.35rem;flex-wrap:wrap;justify-content:flex-end}
.service-map-action{display:inline-flex;align-items:center;justify-content:center;gap:.35rem;min-height:34px;padding:.35rem .6rem;border:1px solid #dbe3ee;border-radius:8px;background:#fff;color:#334155;font-size:.67rem;font-weight:700;white-space:nowrap}
.service-map-action:hover:not(:disabled){border-color:#93c5fd;background:#eff6ff;color:#1d4ed8}
.service-map-action:disabled{cursor:not-allowed;opacity:.42}
.service-map-stage{position:relative;background:#e8eef7}
.service-checkout-map-card .technician-map{height:410px;width:100%;border-radius:0;background:#e8eef7;transition:height .25s ease}
.service-checkout-map-card.map-expanded .technician-map{height:560px}
.service-map-legend{position:absolute;left:10px;bottom:24px;z-index:800;display:flex;flex-direction:column;gap:5px;padding:8px 10px;border:1px solid rgba(203,213,225,.9);border-radius:9px;background:rgba(255,255,255,.94);color:#334155;font-size:.64rem;font-weight:700;box-shadow:0 4px 14px rgba(15,23,42,.12);backdrop-filter:blur(6px)}
.service-map-legend span{display:flex;align-items:center;gap:6px}
.service-map-dot{width:9px;height:9px;border-radius:50%;display:inline-block}
.service-map-dot.company{background:#2563eb;box-shadow:0 0 0 2px #dbeafe}
.service-map-dot.customer{background:#16a34a;box-shadow:0 0 0 2px #dcfce7}
.service-map-selection{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.9rem;padding:.85rem 1rem;border-top:1px solid #e2e8f0;background:#fff}
.service-map-selection-main{display:flex;align-items:flex-start;gap:.65rem;min-width:0}
.service-map-selection-icon{display:inline-flex;align-items:center;justify-content:center;flex:0 0 32px;width:32px;height:32px;border-radius:9px;background:#f1f5f9;color:#64748b}
.service-map-selection.has-location .service-map-selection-icon{background:#dcfce7;color:#15803d}
.service-map-selection-status{color:#b45309;font-size:.66rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase}
.service-map-selection.has-location .service-map-selection-status{color:#15803d}
.service-map-address{margin-top:2px;overflow:hidden;color:#334155;font-size:.72rem;font-weight:600;line-height:1.4;text-overflow:ellipsis}
.service-map-coordinate{min-width:168px;padding-left:.9rem;border-left:1px solid #e2e8f0;text-align:right}
.service-map-coordinate span{display:block;color:#94a3b8;font-size:.6rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
.service-map-coordinate strong{display:block;margin-top:3px;color:#334155;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.68rem}
.service-map-coordinate small{display:block;margin-top:2px;color:#64748b;font-size:.62rem}
.service-checkout-map-card .leaflet-control-layers,.service-checkout-map-card .leaflet-bar{border:0;border-radius:9px;box-shadow:0 3px 14px rgba(15,23,42,.16)}
.service-checkout-map-card .leaflet-control-layers-toggle{width:36px;height:36px;background-size:18px 18px}
.service-checkout-map-card .leaflet-popup-content-wrapper{border-radius:10px;box-shadow:0 8px 28px rgba(15,23,42,.18)}
.service-route-panel{padding:.9rem 1rem;border:1px solid #c7d2fe;border-radius:14px;background:linear-gradient(135deg,#f8faff,#f0f4ff);box-shadow:0 3px 12px rgba(99,102,241,.06)}
.service-route-head{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:.7rem;color:#1e293b;font-size:.78rem}
.service-route-head>span{display:inline-flex;align-items:center;padding:3px 9px;border-radius:999px;background:#e0e7ff;color:#4f46e5;font-size:.65rem;font-weight:700}
.service-route-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:.55rem}
.service-route-stat{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;padding:.6rem .5rem;border:1px solid #e0e7ef;border-radius:10px;background:#fff;text-align:center;box-shadow:0 1px 4px rgba(99,102,241,.05)}
.service-route-stat>i{margin-bottom:2px;font-size:.9rem}
.service-route-stat>span{color:#6b7280;font-size:.62rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
.service-route-stat>strong{margin-top:2px;color:#1e293b;font-size:.95rem}
.service-route-stat.fare{border-color:#a5b4fc;background:linear-gradient(135deg,#eef2ff,#f0f4ff)}
.service-route-stat.fare i,.service-route-stat.fare strong{color:#4f46e5}
.service-route-formula{margin-top:.55rem;color:#64748b;font-size:.68rem;text-align:center}
@media(max-width:767.98px){
  .service-map-toolbar{align-items:flex-start;flex-direction:column}
  .service-map-actions{display:grid;grid-template-columns:repeat(5,1fr);width:100%}
  .service-map-action{padding:.4rem}
  .service-map-action span{display:none}
  .service-checkout-map-card .technician-map{height:320px}
  .service-checkout-map-card.map-expanded .technician-map{height:440px}
  .service-map-selection{grid-template-columns:1fr}
  .service-map-coordinate{padding:.7rem 0 0 42px;border-top:1px solid #f1f5f9;border-left:0;text-align:left}
  .service-route-stats{grid-template-columns:repeat(2,1fr)}
}

.sv-fee-c{background:linear-gradient(135deg,#fafbff,#f8fafc);border-radius:var(--sv-r1);border:1px solid #e2e8f0}
.sv-fee{padding:1.25rem;border-top:3px solid var(--sv-b)}
.sv-fee-r{display:flex;justify-content:space-between;align-items:center;padding:0.4rem 0}
.sv-fee-div{height:1px;background:#e2e8f0;margin:0.75rem 0}
.sv-fee-t{display:flex;justify-content:space-between;align-items:center;padding-top:0.3rem}
.sv-fee-note{background:rgba(37,99,235,0.06);border:1px solid rgba(37,99,235,0.14);border-radius:10px;padding:0.6rem 0.85rem;color:#1e40af;font-size:0.82rem;margin-top:0.65rem;}

/* ── Order summary (payment step) ── */
.sv-pay-summary{max-width:600px;margin:0 auto 1.5rem;background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:1rem 1.1rem;box-shadow:0 4px 18px rgba(15,23,42,0.035)}
.sv-pay-summary-t{font-size:0.85rem;font-weight:700;color:#0f172a}
.sv-pay-summary-badge{background:var(--sv-b);color:#fff;font-size:0.7rem;font-weight:700}
.sv-pay-lines{max-height:160px;overflow:auto;margin:0.5rem 0 0.75rem;padding-right:2px}
.sv-pay-line{display:flex;justify-content:space-between;gap:1rem;font-size:0.82rem;padding:0.3rem 0;border-bottom:1px dashed #eef2f6;color:#475569}
.sv-pay-line:last-child{border-bottom:none}
.sv-pay-line span:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sv-pay-line span:last-child{font-weight:600;color:#0f172a;flex-shrink:0}
.sv-pay-total{display:flex;justify-content:space-between;align-items:center;padding-top:0.6rem;border-top:2px solid #e2e8f0}
.sv-pay-total>span:first-child{font-size:0.82rem;font-weight:600;color:#64748b}
.sv-pay-total-v{font-size:1.3rem;font-weight:800;color:var(--sv-b);letter-spacing:-0.5px}

/* ── Payment method selector ── */
.sv-pay-method-label{margin-top:0.25rem}
.sv-pt{display:flex;gap:10px;max-width:600px;margin:0 auto 1.5rem}
.sv-ptb{flex:1;position:relative;display:flex;align-items:center;gap:10px;min-height:68px;padding:0.75rem 1rem;border-radius:12px;border:2px solid #e2e8f0;background:#fff;color:#64748b;font-weight:600;font-size:0.85rem;text-align:left;cursor:pointer;transition:all 0.25s var(--sv-e)}
.sv-ptb-ic{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;background:#f1f5f9;color:#64748b;flex-shrink:0;transition:all 0.25s var(--sv-e)}
.sv-ptb-tx{display:flex;flex-direction:column;gap:2px}
.sv-ptb-tx strong{font-size:0.9rem;line-height:1.1;color:#334155}
.sv-ptb-tx small{font-size:0.72rem;font-weight:500;color:#94a3b8;line-height:1.1}
.sv-ptb-check{position:absolute;top:8px;right:8px;width:20px;height:20px;border-radius:50%;background:var(--sv-b);color:#fff;display:none;align-items:center;justify-content:center;font-size:0.65rem}
.sv-ptb:hover{border-color:#94a3b8}
.sv-ptb:hover .sv-ptb-ic{background:#e2e8f0;color:#475569}
.sv-ptb[aria-pressed="true"]{border-color:var(--sv-b);background:rgba(37,99,235,0.04);box-shadow:0 0 0 3px rgba(37,99,235,0.08)}
.sv-ptb[aria-pressed="true"] .sv-ptb-ic{background:var(--sv-b);color:#fff}
.sv-ptb[aria-pressed="true"] .sv-ptb-tx strong{color:var(--sv-b)}
.sv-ptb[aria-pressed="true"] .sv-ptb-tx small{color:#3b82f6}
.sv-ptb[aria-pressed="true"] .sv-ptb-check{display:flex}

.sv-pf{max-width:600px;margin:0 auto;padding:1.25rem;border:1px solid #e2e8f0;border-radius:16px;background:#fff;box-shadow:0 4px 18px rgba(15,23,42,0.035)}

/* ── GCash account display ── */
.sv-gcash-acct{background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:0.7rem 0.9rem}
.sv-gcash-acct>span{display:block;margin-bottom:2px}
.sv-gcash-num{font-size:1.05rem;color:#166534;letter-spacing:0.5px;line-height:1.4}
.sv-copy-btn{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;border:1px solid #bbf7d0;background:#fff;color:#16a34a;cursor:pointer;transition:all 0.2s}
.sv-copy-btn:hover{background:#dcfce7}
.sv-copy-btn.copied{background:#16a34a;color:#fff;border-color:#16a34a}
.sv-ob{border-radius:14px;border:1px solid #e2e8f0;padding:1rem 1.25rem}
.sv-ob-g{background:linear-gradient(135deg,#f0fdf4,#dcfce7);border-color:#bbf7d0}
.sv-ob-a{background:linear-gradient(135deg,#fffbeb,#fef3c7);border-color:#fde68a}
.sv-oi{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.sv-oi-gr{background:#16a34a}
.sv-oi-am{background:#d97706}
.sv-fl{display:block;font-size:0.82rem;font-weight:600;color:#374151;margin-bottom:0.35rem}
.sv-f{width:100%;padding:0.55rem 0.8rem;border-radius:10px;border:1.5px solid #e2e8f0;background:#fff;font-size:0.88rem;outline:none;transition:border-color 0.2s,box-shadow 0.2s}
.sv-f:focus{border-color:var(--sv-b);box-shadow:0 0 0 3px rgba(37,99,235,0.08)}
.sv-f[type="file"]{padding:0.45rem;background:#f8fafc;cursor:pointer}
.sv-f[type="file"]::file-selector-button{margin:-0.45rem 0.7rem -0.45rem -0.45rem;padding:0.58rem 0.75rem;border:0;border-right:1px solid #e2e8f0;background:#fff;color:#475569;font-weight:600;cursor:pointer}
.sv-qr-wrap{display:flex;flex-direction:column;align-items:center;gap:0.5rem;padding:1rem;background:#f8fafc;border:1px dashed #cbd5e1;border-radius:14px;color:#64748b;font-size:0.78rem;font-weight:600}
.sv-qr-wrap img{display:block;width:180px;max-width:100%;height:auto;padding:6px;border-radius:12px;border:1px solid #e2e8f0;background:#fff}
.sv-sb{border-radius:10px;padding:0.85rem 1rem;background:#f8fdff;border:1px solid #bee3f8;margin-bottom:1rem}
.sv-pb{display:flex;align-items:center;justify-content:space-between;padding:0.85rem 1rem;border-radius:10px;background:rgba(37,99,235,0.04);border:1px solid rgba(37,99,235,0.1);margin-bottom:0.5rem}
.sv-sl{display:flex;align-items:center;gap:0.5rem;margin-bottom:0.4rem}
.sv-sl span:first-child{color:#64748b;font-size:0.7rem;font-weight:600;text-transform:uppercase;letter-spacing:1px}
.sv-sll{flex:1;height:1px;background:linear-gradient(90deg,rgba(37,99,235,0.12),transparent)}
.sv-cb{border-radius:12px;padding:1rem;background:#fffbeb;border:1px solid #fde68a}

/* ── Enterprise Payment Step Cards ── */
.rv-card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 4px 20px rgba(15,23,42,0.05);overflow:hidden;margin-bottom:1.25rem}
.rv-card-body{padding:1.35rem}
.rv-section-title{display:flex;align-items:center;gap:0.6rem;font-size:0.95rem;font-weight:700;color:#0f172a;margin-bottom:1.1rem}
.rv-section-title i{color:#2563eb;font-size:1.1rem}
.rv-box{background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;padding:1rem}
.rv-row{display:flex;align-items:center;justify-content:space-between;padding:0.5rem 0;font-size:0.88rem}
.rv-row:not(:last-child){border-bottom:1px solid #eef2f7}
.rv-total .rv-row{font-size:1rem;font-weight:700;border-bottom:none;padding:0.35rem 0}
#paymentSummaryTotal{font-size:1.7rem;font-weight:800;color:#2563eb;letter-spacing:-0.03em}
.payment-section .rounded-3{padding:1.1rem;border-radius:14px!important}
.payment-section .form-label{font-size:0.82rem;font-weight:600;color:#475569;margin-bottom:0.45rem}
.payment-section .form-control,.payment-section .form-select{border-radius:12px;border:1.5px solid #e2e8f0;padding:0.75rem 1rem;font-size:0.9rem;transition:all .2s}
.payment-section .form-control:focus{box-shadow:0 0 0 4px rgba(37,99,235,0.08);border-color:#2563eb}
.payment-section input[type=file]{padding:0.6rem}

/* ── Enterprise Payment Tabs ── */
.ent-payment-tabs{display:flex;gap:10px;width:100%}
.ent-payment-tab{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:0.75rem 1rem;border-radius:12px;border:2px solid #e2e8f0;background:#fff;color:#64748b;font-weight:600;font-size:0.85rem;cursor:pointer;transition:all 0.25s var(--sv-e)}
.ent-payment-tab:hover{border-color:#94a3b8}
.ent-payment-tab.active{border-color:var(--sv-b);background:rgba(37,99,235,0.04);color:var(--sv-b);box-shadow:0 0 0 3px rgba(37,99,235,0.08)}
.ent-payment-tab i{font-size:1.1rem}
.payment-section{width:100%;padding:0}
.booking-review-count{padding:3px 8px;border-radius:999px;background:#eff6ff;color:#1d4ed8;font-size:.65rem;font-weight:800}
.booking-review-details{display:grid;gap:.55rem}
.booking-review-details>div{display:grid;grid-template-columns:28px 110px minmax(0,1fr);align-items:start;gap:.55rem;padding:.7rem .75rem;border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc}
.booking-review-details i{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;background:#eff6ff;color:#2563eb}
.booking-review-details span{padding-top:5px;color:#64748b;font-size:.7rem;font-weight:700}
.booking-review-details strong{padding-top:4px;color:#1e293b;font-size:.73rem;line-height:1.45;text-align:right}
.booking-review-summary{position:sticky;top:92px}
.booking-review-total{display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding-top:1rem;margin-top:.55rem;border-top:1px solid #e2e8f0}
.booking-review-total span{color:#0f172a;font-size:.85rem;font-weight:800}
.booking-review-total strong{color:#1d4ed8;font-size:1.35rem;letter-spacing:-.03em}
.booking-review-note{margin:.45rem 0 1rem;color:#64748b;font-size:.68rem;line-height:1.45}
.booking-payment-context{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}
.booking-payment-context>div{display:flex;flex-direction:column;gap:3px;padding:.7rem .8rem;border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc;min-width:0}
.booking-payment-context>div.wide{grid-column:1/-1}
.booking-payment-context span{color:#64748b;font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em}
.booking-payment-context strong{overflow:hidden;color:#1e293b;font-size:.76rem;line-height:1.4;text-overflow:ellipsis}
.booking-payment-context #paymentSummaryTotal{color:#1d4ed8;font-size:1.05rem}
.booking-payment-flow{display:flex;align-items:center;justify-content:center;gap:.55rem;color:#94a3b8;font-size:.67rem;font-weight:700}
.booking-payment-flow span{display:inline-flex;align-items:center;gap:.35rem}
.booking-payment-flow span.active{color:#1d4ed8}
.booking-gcash-amount{padding:.85rem 1rem;border:1px solid #bbf7d0;border-radius:12px;background:#f0fdf4}
.booking-gcash-amount>div{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:#64748b;font-size:.75rem}
.booking-gcash-amount>div+div{margin-top:.45rem;padding-top:.45rem;border-top:1px solid #bbf7d0}
.booking-gcash-amount strong{color:#166534}
.booking-gcash-amount .due strong{font-size:1.05rem}
.booking-gcash-amount small{display:block;margin-top:.55rem;color:#64748b;font-size:.66rem;line-height:1.45}
@media(max-width:575.98px){
  .booking-review-details>div{grid-template-columns:28px minmax(0,1fr)}
  .booking-review-details strong{grid-column:2;text-align:left;padding-top:0}
  .booking-payment-flow{align-items:flex-start;justify-content:flex-start;flex-direction:column}
  .booking-payment-flow>i{display:none}
}

/* ── Enterprise Buttons ── */
.ent-btn-primary{display:inline-flex;align-items:center;gap:8px;padding:0.65rem 1.5rem;border-radius:12px;font-weight:700;font-size:0.88rem;cursor:pointer;transition:all 0.25s var(--sv-e);text-decoration:none;border:none;background:linear-gradient(135deg,var(--sv-b),var(--sv-bd));color:#fff;box-shadow:0 4px 16px rgba(37,99,235,0.2)}
.ent-btn-primary:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(37,99,235,0.3);color:#fff}
.ent-btn-primary:disabled{opacity:0.5;cursor:not-allowed;transform:none}
.ent-btn-outline{display:inline-flex;align-items:center;gap:8px;padding:0.65rem 1.5rem;border-radius:12px;font-weight:700;font-size:0.88rem;cursor:pointer;transition:all 0.25s var(--sv-e);text-decoration:none;border:1.5px solid #cbd5e1;background:transparent;color:#475569}
.ent-btn-outline:hover{border-color:var(--sv-b);color:var(--sv-b);background:rgba(37,99,235,0.04)}
.sv-m{border-radius:20px;overflow:hidden;border:none;box-shadow:0 25px 60px rgba(0,0,0,0.2)}
.sv-mh{padding:28px 28px 20px;border:none;position:relative}
.sv-mh-b{background:linear-gradient(135deg,#0d6efd,#1d4ed8);color:#fff}
.sv-mr{display:inline-block;margin-top:0.5rem;padding:4px 14px;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.25);border-radius:8px;font-size:0.95rem;font-weight:700;letter-spacing:2px}
.sv-mico{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,rgba(59,130,246,0.1),rgba(37,99,235,0.05));border:1px solid rgba(59,130,246,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.sv-bw{display:inline-block;padding:5px 14px;border-radius:9999px;background:#fff8e1;color:#e65100;border:1px solid #ffd54f;font-size:0.75rem;font-weight:700}
.sv-rb{background:#f8f9fa;border-radius:12px;padding:1rem;font-size:0.85rem;margin-bottom:1rem}
.sv-rc{background:linear-gradient(135deg,#f8fafc,#f1f5f9);border:1.5px dashed #d1d5db;border-radius:14px;padding:1.25rem;margin-bottom:1rem}
.sv-rct{color:#6b7280;letter-spacing:1.5px;font-size:0.72rem}

.racs-loader{background:linear-gradient(160deg,#1e3a8a 0%,#1e40af 50%,#312e81 100%);border-radius:24px;padding:40px 32px;max-width:480px;margin:0 auto;box-shadow:0 25px 60px -15px rgba(30,58,138,0.5);position:relative;overflow:hidden}
.racs-scene{position:relative;height:230px;margin-bottom:28px;overflow:hidden;border-radius:16px;background:linear-gradient(180deg,rgba(255,255,255,0.06) 0%,rgba(255,255,255,0.02) 100%)}
.racs-glow{position:absolute;top:45%;left:50%;transform:translate(-50%,-50%);width:300px;height:120px;background:radial-gradient(ellipse,rgba(96,165,250,0.2) 0%,transparent 70%);pointer-events:none}
.racs-carwrap{position:absolute;bottom:30px;left:50%;transform:translateX(-50%);width:340px;animation:racsBob 0.6s ease-in-out infinite alternate}
@keyframes racsBob{from{transform:translateX(-50%) translateY(0)}to{transform:translateX(-50%) translateY(-4px)}}
.racs-carwrap svg{width:100%;height:auto;display:block}
.racs-wheel{transform-box:fill-box;transform-origin:center;animation:racsSpin 0.5s linear infinite}
@keyframes racsSpin{to{transform:rotate(360deg)}}
.racs-track{position:absolute;bottom:0;left:0;width:100%;height:20px}
.racs-track-dash{position:absolute;bottom:8px;left:0;width:200%;height:4px;background:repeating-linear-gradient(90deg,rgba(255,255,255,0.5) 0,rgba(255,255,255,0.5) 30px,transparent 30px,transparent 60px);animation:racsTrack 0.6s linear infinite}
@keyframes racsTrack{from{transform:translateX(0)}to{transform:translateX(-60px)}}
.racs-progress{width:100%;height:5px;background:rgba(255,255,255,0.12);border-radius:99px;overflow:hidden;margin-bottom:22px}
.racs-progress-fill{height:100%;width:35%;border-radius:99px;background:linear-gradient(90deg,#60a5fa,#93c5fd,#60a5fa);background-size:200% 100%;animation:racsProg 1.5s ease-in-out infinite,racsShimmer 2s linear infinite}
@keyframes racsProg{0%{transform:translateX(-100%)}100%{transform:translateX(386%)}}
@keyframes racsShimmer{0%{background-position:0% 0}100%{background-position:200% 0}}
.racs-title{display:block;text-align:center;font-size:1.2rem;font-weight:700;color:#fff;margin-bottom:8px;letter-spacing:0.3px}
.racs-desc{display:block;text-align:center;font-size:0.88rem;color:rgba(255,255,255,0.6);margin-bottom:18px}
.racs-pulse{display:flex;justify-content:center;gap:7px}
.racs-pulse span{width:8px;height:8px;border-radius:50%;background:#60a5fa;animation:racsPulse 1.4s ease-in-out infinite}
.racs-pulse span:nth-child(2){animation-delay:0.2s}
.racs-pulse span:nth-child(3){animation-delay:0.4s}
@keyframes racsPulse{0%,100%{opacity:0.3;transform:scale(0.7)}50%{opacity:1;transform:scale(1.15)}}

/* Hide "Choose Schedule" button in completed step 3 to prevent overlap with step 4 */
#locationStep.step-completed .ent-step-body .mt-4.text-center {
  display: none !important;
}
/* Hide "Continue to Next Step" button in completed step 2 */
#serviceSelection.step-completed .ent-step-body .mt-4.text-center {
  display: none !important;
}

/* ═══ Calendar selected date override (ensures blue selected state) ═══ */
.ent-cal-cell.available.selected,
.ent-cal-cell.limited.selected,
.ent-cal-cell.selected {
  background: linear-gradient(135deg, #2563eb, #3b82f6) !important;
  color: #fff !important;
  border-color: #2563eb !important;
  border-style: solid !important;
}
