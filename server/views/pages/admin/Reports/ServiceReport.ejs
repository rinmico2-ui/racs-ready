    <div class="col-lg-8">
      <div class="dash-card h-100">
        <div class="dash-card-header"><h6><i class="bi bi-exclamation-diamond-fill me-1" style="color:#ef4444;"></i>Most Common Repair Issues</h6><span class="kpi-enterprise-badge purple">Customer-reported</span></div>
        <div class="dash-card-body">
          <% if (analytics && analytics.commonRepairIssues && analytics.commonRepairIssues.length) { analytics.commonRepairIssues.forEach(function(row, index) { %>
            <div class="d-flex align-items-center justify-content-between py-2 border-bottom"><div><span class="me-2" style="font-weight:700;color:#94a3b8;">#<%= index + 1 %></span><span><%= row.name %></span></div><span class="badge-status warning"><%= row.bookings %> booking<%= row.bookings === 1 ? '' : 's' %></span></div>
          <% }); } else { %><div class="dash-empty">No repair issue descriptions recorded</div><% } %>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="dash-card h-100">
        <div class="dash-card-header"><h6><i class="bi bi-building-gear me-1" style="color:#3b82f6;"></i>Booking Scale</h6></div>
        <div class="dash-card-body">
          <% [{ key: 'standard', label: 'Standard bookings' }, { key: 'largeScale', label: 'Large-scale projects' }].forEach(function(item) { const scale = analytics && analytics.bookingScale ? analytics.bookingScale[item.key] : { bookings: 0, units: 0, revenue: 0 }; %>
            <div class="p-3 mb-2" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;"><div class="d-flex justify-content-between"><strong><%= item.label %></strong><span class="badge-status neutral"><%= scale.bookings %></span></div><div class="mt-2" style="font-size:.75rem;color:#64748b;"><%= scale.units %> units · ₱<%= Math.round(scale.revenue).toLocaleString() %> booked value</div></div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>


