    fetch('/api/admin/appointments/'+id+'/verify-payment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({notes:'Payment verified by admin'})})
    .then(function(r){return r.json();}).then(function(data){
      if(data.success){
        fetch('/api/admin/appointments/'+id+'/move-to-queue',{method:'POST'}).
        then(function(){
          showNotification({type:'success',title:'Payment Verified',message:'Booking has been verified and moved to assignment queue.',duration:4000});
          var queueTabBtn=document.querySelector('.au-tab-btn[data-bs-target="#tab-queue"]');
          if(queueTabBtn){var bsTab=new bootstrap.Tab(queueTabBtn);bsTab.show();}
          else{AU.Pending.load();}
        });
      }else showNotification({type:'error',title:'Verification Failed',message:data.error||'Failed to verify payment.',duration:5000});
    }).catch(function(){showNotification({type:'error',title:'Error',message:'An error occurred while verifying payment.',duration:5000});});
  };

