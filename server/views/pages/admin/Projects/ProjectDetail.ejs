  // ── Planning Studio handlers (one-click generation) ──────────
  async function studioApi(path, opts) {
    const r = await fetch(path, opts);
    const data = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(data.error || 'Request failed');
    return data;
  }

  window.studioGenerateWorkOrders = async function() {
    const p = window.__projectData;
    if (p && teamAcceptancePending(p)) { toast('All team members must accept the assignment before generating work orders', 'error'); return; }
    const hasTeam = p && (p.assignedTechnicians?.length || p.totalAssignedTechnicians || 0) > 0;
    try {
      let body = {};
      // When team is assigned, auto-calculate optimal split based on capacity
      if (hasTeam) {
        // For large-scale projects, default to 1 work order by default
        body = { mode: 'quantity', count: 1 };
        if (!confirm('Create a single work order for this project with units distributed across working days? Click OK to proceed, or Cancel for manual options.')) {
          const mode = prompt("Split work orders by:\n- quantity (N equal parts)\n- building\n- floor\n- manual\nType one (default: quantity):", "quantity") || "quantity";
          body = { mode };
          if (mode === 'quantity') {
            const units = (p.totalUnits || p.quantity) || 0;
            const suggested = units > 0 ? Math.max(1, Math.ceil(units / 5)) : 4;
            const n = parseInt(prompt(`How many work orders? (project has ${units} unit(s))`, String(suggested))) || suggested;
            body.count = n;
          } else if (mode === 'building' || mode === 'floor') {
            const raw = prompt("Enter sections as name:units, separated by commas (e.g. A:10,B:10):", "A:10,B:10");
            body.sections = (raw || "").split(",").map(s => { const [name, units] = s.split(":"); return { name: name.trim(), units: parseInt(units) || 0 }; });
          } else if (mode === 'manual') {
            const raw = prompt("Enter work orders as title:units:hours, comma-separated:", "WO1:5:10,WO2:5:10");
            body.manual = (raw || "").split(",").map(s => { const [title, units, hours] = s.split(":"); return { title: title.trim(), units: parseInt(units) || 0, hours: parseFloat(hours) || 0 }; });
          }
        }
        // body = {} means auto-calculate (server uses capacity-based logic)
      } else {
        const mode = prompt("No team assigned yet. Choose split mode:\n- quantity (N equal parts)\n- building\n- floor\n- manual\nType one:", "quantity") || "quantity";
        body = { mode };
        if (mode === 'quantity') {
          const units = (p?.totalUnits || p?.quantity) || 0;
          const suggested = units > 0 ? Math.max(1, Math.ceil(units / 5)) : 4;
          const n = parseInt(prompt(`How many work orders? (project has ${units} unit(s))`, String(suggested))) || suggested;
          body.count = n;
        } else if (mode === 'building' || mode === 'floor') {
          const raw = prompt("Enter sections as name:units (e.g. A:10,B:10):", "A:10,B:10");
          body.sections = (raw || "").split(",").map(s => { const [name, units] = s.split(":"); return { name: name.trim(), units: parseInt(units) || 0 }; });
        } else if (mode === 'manual') {
          const raw = prompt("Enter work orders as title:units:hours:", "WO1:5:10,WO2:5:10");
          body.manual = (raw || "").split(",").map(s => { const [title, units, hours] = s.split(":"); return { title: title.trim(), units: parseInt(units) || 0, hours: parseFloat(hours) || 0 }; });
        }
      }
      const btn = qs('.studio-card:nth-child(3) .sc-gen .pd-btn');
      const action = async () => {
        const d = await studioApi(`/api/projects/${projectId}/generate-work-orders`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        toast(d.message || 'Work orders generated');
        await loadProject();
      };
      if (btn) await withBtnLoading(btn, 'Generating…', action);
      else await action();
    } catch (e) { toast(e.message, 'error'); }
  };

  window.studioSuggestResources = async function() {
    const p = window.__projectData;
    if (p && teamAcceptancePending(p)) { toast('All team members must accept the assignment before reserving resources', 'error'); return; }
    const btn = qs('.studio-card:nth-child(2) .sc-gen .pd-btn:first-child');
    const action = async () => {
      try {
        const d = await studioApi(`/api/projects/${projectId}/suggest-resources`);
        const items = d.recommendations || [];
        const webBadge = d.webResearchUsed
          ? '<span style="font-size:0.65rem;background:rgba(34,197,94,0.15);color:#16a34a;padding:2px 8px;border-radius:999px;font-weight:600;margin-left:8px;"><i class="bi bi-globe2 me-1" style="font-size:0.6rem;"></i>Web Research</span>'
          : '';
        const html = items.map((it, i) => {
          const hasStock = (it.available || 0) >= it.quantity;
          const stockClass = hasStock ? 'text-success' : 'text-warning';
          const stockLabel = hasStock ? 'In Stock' : `Low/No Stock (${it.available || 0} avail)`;
          return `
          <div class="studio-row">
            <label style="font-size:0.78rem;display:flex;align-items:center;gap:0.4rem;cursor:pointer;">
              <input type="checkbox" class="studio-res-chk" data-i="${i}" ${hasStock ? 'checked' : ''}> <b>${it.itemName}</b> ×${it.quantity} ${it.unit}
            </label>
            <span class="wo-mini">${it.type}/${it.scope}</span>
            <span class="${stockClass}" style="font-size:0.65rem;margin-left:0.5rem;font-weight:600;">${stockLabel}</span>
          </div>`;
        }).join('');
        const overlay = document.createElement('div');
        overlay.className = 'pw-modal-overlay';
        overlay.innerHTML = `
          <div class="pw-modal">
            <h5 style="font-size:1rem;font-weight:700;margin-bottom:0.5rem;"><i class="bi bi-magic me-2" style="color:#6366f1;"></i>AI Resource Suggestions${webBadge}</h5>
            <div id="studioResList">${html}</div>
            <div class="d-flex gap-2 justify-content-end mt-3">
              <button class="pw-btn" onclick="this.closest('.pw-modal-overlay').remove()">Cancel</button>
              <button class="pw-btn primary" id="studioResSave">Reserve Selected</button>
            </div>
          </div>`;
        document.body.appendChild(overlay);
        overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
        overlay.querySelector('#studioResSave').addEventListener('click', async () => {
          const chosen = items.filter((_, i) => overlay.querySelector(`.studio-res-chk[data-i="${i}"]`).checked);
          try {
            const result = await studioApi(`/api/projects/${projectId}/reserve-suggested`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: chosen }) });
            overlay.remove();
            if (result.stockWarnings && result.stockWarnings.length > 0) {
              const warnText = result.stockWarnings.map(w => `${w.itemName}: has ${w.available}, need ${w.requested}`).join('\n');
              toast(`Reserved ${result.materials.length} items.\n⚠️ Stock shortages:\n${warnText}`, 'warning');
            } else {
              toast('Resources reserved');
            }
            await loadProject();
          } catch (e2) { toast(e2.message, 'error'); }
        });
      } catch (e) { toast(e.message, 'error'); }
    };
    if (btn) await withBtnLoading(btn, 'Suggesting…', action);
    else await action();
  };

  window.studioGenerateSchedule = async function() {
    const p = window.__projectData;
    if (p && teamAcceptancePending(p)) { toast('All team members must accept the assignment before generating the schedule', 'error'); return; }
    const btn = qs('.studio-card:nth-child(4) .sc-gen .pd-btn');
