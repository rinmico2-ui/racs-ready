  <div class="ent-hero-orb ent-hero-orb-1"></div>
  <div class="ent-hero-orb ent-hero-orb-2"></div>
  <div class="ent-hero-orb ent-hero-orb-3"></div>
  <div class="container">
    <div class="text-center mb-4" data-aos="fade-up" data-aos-duration="1000">
      <div class="ent-hero-badge">
        <i class="bi bi-calendar-check"></i>
        Schedule Service
        <span class="badge-dot"></span>
      </div>
      <h2 class="ent-hero-title">
        Book a <span class="ent-gradient-text">Service</span>
      </h2>
      <p class="ent-hero-subtitle">
        Professional air conditioning maintenance, installation &amp; servicing — scheduled at your convenience.
      </p>
      <div class="ent-trust-badges">
        <span class="ent-trust-item"><i class="bi bi-shield-check"></i> Licensed &amp; Insured</span>
        <span class="ent-trust-divider"></span>
        <span class="ent-trust-item"><i class="bi bi-lightning-charge"></i> Same-Day Service</span>
        <span class="ent-trust-divider"></span>
        <span class="ent-trust-item"><i class="bi bi-star-fill"></i> 4.9 Rating</span>
      </div>
      <div class="ent-hero-stats">
        <div class="ent-hero-stat">
          <div class="ent-hero-stat-value">5,000+</div>
          <div class="ent-hero-stat-label">Bookings</div>
        </div>
        <div class="ent-hero-stat">
          <div class="ent-hero-stat-value">50+</div>
          <div class="ent-hero-stat-label">Technicians</div>
        </div>
        <div class="ent-hero-stat">
          <div class="ent-hero-stat-value">98%</div>
          <div class="ent-hero-stat-label">Satisfaction</div>
        </div>
      </div>
