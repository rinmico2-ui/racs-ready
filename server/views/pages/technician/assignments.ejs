          ${ta.suggestedTools?.length ? `<div style="margin-bottom:14px;"><div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;"><i class="bi bi-tools" style="font-size:0.8rem;color:#7c3aed;"></i><strong style="font-size:0.82rem;color:#1e293b;">Recommended Tools</strong></div><div style="display:flex;flex-wrap:wrap;gap:6px;">${ta.suggestedTools.map(t => { const name = typeof t === 'string' ? t : t.name || t; const purpose = typeof t === 'object' ? t.purpose : ''; return `<div style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:#f5f3ff;border:1px solid #e9d5ff;border-radius:20px;font-size:0.78rem;"><i class="bi bi-wrench" style="color:#7c3aed;font-size:0.7rem;"></i><span style="font-weight:500;color:#1e293b;">${name}</span>${purpose ? `<span style="font-size:0.65rem;color:#64748b;">— ${purpose}</span>` : ''}</div>`; }).join('')}</div></div>` : ''}
          ${ta.possibleParts?.length ? `<div style="margin-bottom:14px;"><div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;"><i class="bi bi-cpu" style="font-size:0.8rem;color:#d97706;"></i><strong style="font-size:0.82rem;color:#1e293b;">Suggested Parts</strong></div><div style="display:flex;flex-direction:column;gap:3px;">${ta.possibleParts.map(p => { const name = typeof p === 'string' ? p : p.name || p; const cost = typeof p === 'object' ? p.estimatedCostPHP : 0; const likelihood = typeof p === 'object' ? p.likelihood : 'medium'; const purpose = typeof p === 'object' ? p.purpose : ''; return `<div style="display:flex;align-items:center;justify-content:space-between;padding:6px 10px;background:#fff;border-radius:6px;border:1px solid #f1f5f9;font-size:0.8rem;"><div style="display:flex;align-items:center;gap:8px;"><span class="badge bg-${likelihood === 'high' ? 'danger' : likelihood === 'medium' ? 'warning text-dark' : 'secondary'}" style="font-size:0.55rem;">${likelihood}</span><div><span style="font-weight:500;color:#1e293b;">${name}</span>${purpose ? `<div style="font-size:0.7rem;color:#64748b;">${purpose}</div>` : ''}</div></div>${cost ? `<span style="font-size:0.75rem;font-weight:600;color:#059669;">₱${cost.toLocaleString()}</span>` : ''}</div>`; }).join('')}</div></div>` : ''}
          ${ta.safetyReminders?.length ? `<div style="margin-bottom:12px;"><div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;"><i class="bi bi-shield-exclamation" style="font-size:0.8rem;color:#dc2626;"></i><strong style="font-size:0.82rem;color:#dc2626;">Safety Reminders</strong></div><div style="padding:10px 12px;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;">${ta.safetyReminders.map(r => `<div style="display:flex;align-items:flex-start;gap:6px;margin-bottom:4px;font-size:0.78rem;color:#991b1b;"><i class="bi bi-exclamation-triangle-fill" style="font-size:0.65rem;margin-top:3px;flex-shrink:0;"></i><span>${r}</span></div>`).join('')}</div></div>` : ''}
          ${ta.additionalNotes ? `<div style="margin-bottom:10px;"><div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;"><i class="bi bi-info-circle" style="font-size:0.8rem;color:#0284c7;"></i><strong style="font-size:0.82rem;color:#1e293b;">Additional Notes</strong></div><div style="font-size:0.78rem;color:#475569;line-height:1.5;padding:8px 10px;background:#f8fafc;border-radius:6px;border:1px solid #e2e8f0;">${ta.additionalNotes}</div></div>` : ''}
          ${a.bookingId?.previousRepairs?.length ? `<div style="margin-bottom:12px;"><div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;"><i class="bi bi-clock-history" style="font-size:0.8rem;color:#d97706;"></i><strong style="font-size:0.82rem;color:#92400e;">Previous Repair History</strong></div><div style="padding:10px 12px;background:#fefce8;border:1px solid #fde68a;border-radius:8px;">${a.bookingId.previousRepairs.map(pr => `<div style="display:flex;align-items:flex-start;gap:6px;margin-bottom:4px;font-size:0.78rem;color:#92400e;"><i class="bi bi-arrow-repeat" style="font-size:0.65rem;margin-top:3px;flex-shrink:0;"></i><span><strong>${pr.date || ''}</strong> — ${pr.issue || pr.description || 'Previous repair'}${pr.recurring ? ' <span class="badge bg-danger" style="font-size:0.55rem;">RECURRING</span>' : ''}</span></div>`).join('')}</div></div>` : ''}
          ${a.bookingId?.preventiveMaintenance?.length ? `<div style="margin-bottom:12px;"><div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;"><i class="bi bi-calendar-check" style="font-size:0.8rem;color:#059669;"></i><strong style="font-size:0.82rem;color:#16a34a;">Preventive Maintenance Tips</strong></div><div style="padding:10px 12px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;">${a.bookingId.preventiveMaintenance.map(tip => `<div style="display:flex;align-items:flex-start;gap:6px;margin-bottom:4px;font-size:0.78rem;color:#166534;"><i class="bi bi-check2-circle" style="font-size:0.65rem;margin-top:3px;flex-shrink:0;"></i><span>${tip}</span></div>`).join('')}</div></div>` : ''}
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;padding-top:10px;border-top:1px solid #e0f2fe;">
            <button type="button" class="btn btn-sm btn-outline-primary" style="font-size:0.72rem;" onclick="generateAiDiagnosis('${a.bookingId._id}')"><i class="bi bi-arrow-clockwise me-1"></i>Regenerate</button>
            ${!ta.verifiedByTechnician ? `<button type="button" class="btn btn-sm btn-outline-success" style="font-size:0.72rem;" onclick="verifyAiAssistant('${a.bookingId._id}')"><i class="bi bi-check-circle me-1"></i>Verify</button>` : ''}
            <button type="button" class="btn btn-sm btn-outline-info" style="font-size:0.72rem;" onclick="generateRepairNotes('${a.bookingId._id}')"><i class="bi bi-file-earmark-text me-1"></i>Generate Notes</button>
          </div>
          <div style="margin-top:6px;font-size:0.68rem;color:#94a3b8;font-style:italic;">Decision-support recommendation. Final diagnosis is your responsibility.</div>
        </div>
      </div>
    </div>`;
    }

    function renderInspectionPage(a) {
      const insp = a.bookingId?.inspection;
      const bs = a.bookingId?.status || a.bookingStatus;
      if (!insp?.completedAt) {
        return `<div><div class="wizard-empty-state"><i class="bi bi-search"></i><div class="ws-title">Inspection Not Yet Completed</div><div class="ws-desc">${bs === 'inspection_scheduled' ? 'Complete the inspection form to record your findings.' : 'Inspection results will appear here once completed.'}</div></div></div>`;
      }
      return `<div>
      <div class="detail-section">
        <div class="detail-section-header"><i class="bi bi-clipboard-check" style="color:#16a34a;"></i><h6>Inspection Results</h6></div>
        <div class="detail-section-body">
          <div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Findings</label><span style="text-align:left;font-size:0.78rem;line-height:1.5;">${insp.findings || 'N/A'}</span></div>
          ${insp.findingsChecklist?.length ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Observed Findings</label><div style="font-size:0.78rem;">${insp.findingsChecklist.map(f => `<div><i class="bi bi-check-circle text-success me-1" style="font-size:0.65rem;"></i>${f}</div>`).join('')}</div></div>` : ''}
          ${insp.actionsChecklist?.length ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Recommended Actions</label><div style="font-size:0.78rem;">${insp.actionsChecklist.map(a => `<div><i class="bi bi-check-circle text-success me-1" style="font-size:0.65rem;"></i>${a}</div>`).join('')}</div></div>` : ''}
          ${insp.severity ? `<div class="detail-row"><label>Severity</label><span class="badge ${insp.severity === 'critical' ? 'bg-danger' : insp.severity === 'major' ? 'bg-warning text-dark' : 'bg-info'}" style="font-size:0.65rem;">${insp.severity.toUpperCase()}</span></div>` : ''}
          ${insp.recommendedAction ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Action</label><span style="text-align:left;font-size:0.78rem;">${insp.recommendedAction}</span></div>` : ''}
          ${insp.damagedParts?.length ? `<div class="detail-row"><label>Parts</label><span style="font-size:0.78rem;">${insp.damagedParts.join(', ')}</span></div>` : ''}
          ${insp.photos?.length ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Photos</label><div class="d-flex gap-2 flex-wrap mt-1">${insp.photos.map(p => `<a href="${p}" target="_blank"><img src="${p}" style="width:40px;height:40px;object-fit:cover;border-radius:6px;border:1px solid #e2e8f0;cursor:pointer;" /></a>`).join('')}</div></div>` : ''}
          ${insp.laborRequired ? `<div class="detail-row"><label>Labor</label><span>${insp.laborRequired}</span></div>` : ''}
          ${insp.estimatedRepairCost ? `<div class="detail-row"><label>Est. Cost</label><span style="font-weight:700;color:#2563eb;">₱${Number(insp.estimatedRepairCost).toLocaleString()}</span></div>` : ''}
        </div>
      </div>
    </div>`;
    }

    function renderQuotationPage(a) {
      const q = a.bookingId?.quotation;
      const bs = a.bookingId?.status || a.bookingStatus;
      if (!q?.totalCost) {
        return `<div><div class="wizard-empty-state"><i class="bi bi-receipt"></i><div class="ws-title">No Quotation Yet</div><div class="ws-desc">${['inspection_completed', 'inspection_scheduled'].includes(bs) ? 'Submit the inspection form with quotation details.' : 'Quotation will appear here once generated.'}</div></div></div>`;
      }
      const approvalStatus = a.bookingId?.approval?.status;
      return `<div>
      <div class="detail-section">
        <div class="detail-section-header"><i class="bi bi-receipt" style="color:#7c3aed;"></i><h6>Quotation</h6><span class="badge ${approvalStatus === 'approved' ? 'bg-success' : approvalStatus === 'declined' ? 'bg-danger' : 'bg-warning text-dark'}" style="font-size:0.6rem;margin-left:auto;">${approvalStatus?.toUpperCase() || 'PENDING'}</span></div>
        <div class="detail-section-body">
          ${q.parts?.length ? q.parts.map(p => `<div class="detail-row"><label>${p.name}</label><span>${p.quantity || 1} × ₱${Number(p.cost).toLocaleString()} = ₱${Number((p.cost || 0) * (p.quantity || 1)).toLocaleString()}</span></div>`).join('') : ''}
          <div class="detail-row"><label>Labor</label><span>₱${Number(q.laborCost || 0).toLocaleString()}</span></div>
          <div class="detail-row" style="border-top:2px solid #f1f5f9;padding-top:8px;margin-top:2px;"><label style="font-weight:800;color:#334155;">Total</label><span style="font-weight:800;font-size:1rem;color:#2563eb;">₱${Number(q.totalCost).toLocaleString()}</span></div>
          ${q.notes ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Notes</label><span style="font-size:0.78rem;">${q.notes}</span></div>` : ''}
          ${q.expiresAt ? `<div class="detail-row"><label>Expires</label><span style="font-size:0.78rem;">${new Date(q.expiresAt).toLocaleDateString('en-PH')}</span></div>` : ''}
        </div>
      </div>
    </div>`;
    }

    function renderRepairPage(a) {
      const bs = a.bookingId?.status || a.bookingStatus;
      const repairStatusLabels = { ready_for_repair: 'Ready for Repair', scheduled: 'Scheduled', repair_scheduled: 'Repair Scheduled', repair_in_progress: 'Repair In Progress', repair_completed: 'Repair Completed', under_warranty: 'Under Warranty', repair_approved: 'Approved — Ready to Start' };
      const statusColor = bs === 'repair_in_progress' ? '#2563eb' : bs === 'repair_completed' || bs === 'under_warranty' ? '#16a34a' : '#d97706';
      return `<div>
      <div class="detail-section">
        <div class="detail-section-header"><i class="bi bi-tools" style="color:${statusColor};"></i><h6>Repair Status</h6></div>
        <div class="detail-section-body">
          <div class="detail-row"><label>Status</label><span class="badge" style="background:${statusColor};color:#fff;font-size:0.7rem;">${repairStatusLabels[bs] || bs}</span></div>
        </div>
      </div>
      ${a.bookingId?.repairNotes ? `<div class="detail-section"><div class="detail-section-header"><i class="bi bi-journal-text" style="color:#2563eb;"></i><h6>Notes</h6></div><div class="detail-section-body"><div style="font-size:0.78rem;color:#475569;line-height:1.5;">${a.bookingId.repairNotes}</div></div></div>` : ''}
      ${a.bookingId?.materialsUsed?.length ? `<div class="detail-section"><div class="detail-section-header"><i class="bi bi-box-seam" style="color:#7c3aed;"></i><h6>Materials</h6></div><div class="detail-section-body">${a.bookingId.materialsUsed.map(m => `<div class="detail-row"><label>${m.name || m}</label><span>${m.quantity ? `× ${m.quantity}` : ''}</span></div>`).join('')}</div></div>` : ''}
    </div>`;
    }

    function renderCompletionPage(a) {
      const bs = a.bookingId?.status || a.bookingStatus;
      const isWarranty = bs === 'under_warranty';
      return `<div>
      <div class="detail-section" style="border-color:#bbf7d0;background:#f0fdf4;">
        <div class="detail-section-header"><i class="bi bi-check-circle-fill" style="color:#16a34a;"></i><h6 style="color:#16a34a;">${isWarranty ? 'Under Warranty' : 'Completed'}</h6></div>
        <div class="detail-section-body">
          ${a.bookingId?.completedAt ? `<div class="detail-row"><label>Completed</label><span style="font-size:0.78rem;">${new Date(a.bookingId.completedAt).toLocaleString('en-PH')}</span></div>` : ''}
          ${a.bookingId?.warranty?.endDate ? `<div class="detail-row"><label>Warranty</label><span style="font-size:0.78rem;">${new Date(a.bookingId.warranty.endDate).toLocaleDateString('en-PH')}</span></div>` : ''}
          ${a.bookingId?.completionNotes ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Notes</label><span style="font-size:0.78rem;line-height:1.5;">${a.bookingId.completionNotes}</span></div>` : ''}
          ${a.bookingId?.afterPhotos?.length ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Photos</label><div class="d-flex gap-2 flex-wrap mt-1">${a.bookingId.afterPhotos.map(p => `<a href="${p}" target="_blank"><img src="${p}" style="width:40px;height:40px;object-fit:cover;border-radius:6px;border:1px solid #e2e8f0;cursor:pointer;" /></a>`).join('')}</div></div>` : ''}
        </div>
      </div>
      <div class="detail-section">
        <div class="detail-section-header"><i class="bi bi-clipboard-data" style="color:#2563eb;"></i><h6>Summary</h6></div>
        <div class="detail-section-body">
          ${a.bookingId?.inspection?.findings ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Inspection</label><span style="font-size:0.78rem;">${a.bookingId.inspection.findings}</span></div>` : ''}
          ${a.bookingId?.inspection?.findingsChecklist?.length ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Observed Findings</label><div style="font-size:0.78rem;">${a.bookingId.inspection.findingsChecklist.map(f => `<div><i class="bi bi-check-circle text-success me-1" style="font-size:0.65rem;"></i>${f}</div>`).join('')}</div></div>` : ''}
          ${a.bookingId?.inspection?.actionsChecklist?.length ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Actions Taken</label><div style="font-size:0.78rem;">${a.bookingId.inspection.actionsChecklist.map(a => `<div><i class="bi bi-check-circle text-success me-1" style="font-size:0.65rem;"></i>${a}</div>`).join('')}</div></div>` : ''}
          ${a.bookingId?.diagnosis?.findings ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Diagnosis</label><span style="font-size:0.78rem;">${a.bookingId.diagnosis.findings}</span></div>` : ''}
          ${a.bookingId?.quotation?.totalCost ? `<div class="detail-row"><label>Total</label><span style="font-weight:700;color:#2563eb;">₱${Number(a.bookingId.quotation.totalCost).toLocaleString()}</span></div>` : ''}
        </div>
      </div>
    </div>`;
    }

    function renderSchedulingPage(a) {
      const b = a.bookingId || {};
      const preferredDate = b.preferredDate ? new Date(b.preferredDate).toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) : null;
      const preferredTime = b.preferredTime || null;
      const bs = b.status || a.bookingStatus;
      const scheduledDate = b.schedulingRequest?.scheduledDate ? new Date(b.schedulingRequest.scheduledDate).toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) : null;
      const scheduledTime = b.schedulingRequest?.scheduledTime || null;
      const schedulingStatus = b.schedulingRequest?.status || 'pending';
      const statusBadge = schedulingStatus === 'confirmed' ? 'bg-success' : schedulingStatus === 'pending' ? 'bg-warning text-dark' : 'bg-secondary';
      return `<div>
      <div class="detail-section">
        <div class="detail-section-header"><i class="bi bi-calendar-check" style="color:#2563eb;"></i><h6>Repair Schedule</h6></div>
        <div class="detail-section-body">
          ${preferredDate ? `<div class="detail-row"><label>Preferred Date</label><span style="font-size:0.82rem;font-weight:600;">${preferredDate}</span></div>` : ''}
          ${preferredTime ? `<div class="detail-row"><label>Preferred Time</label><span style="font-size:0.82rem;">${preferredTime}</span></div>` : ''}
          ${scheduledDate ? `<div class="detail-row" style="border-top:2px solid #f1f5f9;padding-top:8px;margin-top:4px;"><label style="font-weight:700;color:#059669;">Scheduled Date</label><span style="font-size:0.82rem;font-weight:700;color:#059669;">${scheduledDate}</span></div>` : ''}
          ${scheduledTime ? `<div class="detail-row"><label style="font-weight:700;color:#059669;">Scheduled Time</label><span style="font-size:0.82rem;font-weight:700;color:#059669;">${scheduledTime}</span></div>` : ''}
          <div class="detail-row"><label>Status</label><span class="badge ${statusBadge}" style="font-size:0.7rem;">${schedulingStatus.toUpperCase()}</span></div>
        </div>
      </div>
      ${!scheduledDate && schedulingStatus === 'pending' ? `<div class="alert alert-info py-2 px-3 mb-0" style="font-size:0.8rem;border-radius:8px;"><i class="bi bi-info-circle me-1"></i>Waiting for admin to confirm the repair schedule. The customer's preferred dates have been submitted.</div>` : ''}
      ${scheduledDate ? `<div class="alert alert-success py-2 px-3 mb-0" style="font-size:0.8rem;border-radius:8px;"><i class="bi bi-check-circle me-1"></i>Repair has been scheduled. Proceed to the job on the scheduled date.</div>` : ''}
    </div>`;
    }

    function fmtAddr(addr) {
      if (!addr) return '—';
      if (typeof addr === 'string') {
        if (addr === '[object Object]' || addr.startsWith('{')) return '—';
        return addr;
      }
      if (typeof addr === 'object') {
        return [addr.barangay, addr.city, addr.province, addr.postalCode].filter(Boolean).join(', ') || '—';
      }
      return String(addr);
    }

    function renderInvoicePage(a) {
      const b = a.bookingId || {};
      const q = b.quotation || {};
      const insp = b.inspection || {};
      const diag = b.diagnosis || {};
      const workOrder = b.workOrderNumber || 'N/A';
      const inspectionFee = b.inspectionFeeTotalCollected || b.initialCost || a.initialCost || 0;
      const travelFee = b.travelFare || 0;
      const laborCost = q.laborCost || 0;
      const partsTotal = (q.parts || []).reduce((sum, p) => sum + ((p.cost || p.unitPrice || p.price || 0) * (p.quantity || 1)), 0);
      const quotationTotal = q.totalCost || 0;
      const grandTotal = inspectionFee + travelFee + quotationTotal;
      const downpayment = b.downpaymentAmount || 0;
      const inspPaid = b.inspectionFeeTotalCollected || 0;
      const repairPaid = b.repairPaymentAmount || 0;
      const totalPaid = inspPaid + repairPaid + (downpayment > 0 ? downpayment : 0);
      const balanceDue = Math.max(0, grandTotal - totalPaid);
      const warrantyEnd = b.warranty?.endDate ? new Date(b.warranty.endDate).toLocaleDateString('en-PH') : null;

      const sevColors = { minor: '#16a34a', major: '#d97706', critical: '#dc2626' };
      const hasInspection = insp.findings || diag.findings || insp.severity;

      return `<div>
      <div class="detail-section" style="border-color:#c7d2fe;background:#eef2ff;">
        <div class="detail-section-header"><i class="bi bi-file-earmark-text" style="color:#4f46e5;"></i><h6 style="color:#4f46e5;">Invoice</h6></div>
        <div class="detail-section-body">
          <div class="detail-row"><label>Work Order</label><span style="font-weight:700;font-size:0.85rem;">${workOrder}</span></div>
          <div class="detail-row"><label>Date</label><span style="font-size:0.82rem;">${b.completedAt ? new Date(b.completedAt).toLocaleDateString('en-PH') : new Date().toLocaleDateString('en-PH')}</span></div>
          <div class="detail-row"><label>Customer</label><span style="font-size:0.82rem;">${b.customer?.name || a.customerName || 'N/A'}</span></div>
          <div class="detail-row"><label>Address</label><span style="font-size:0.82rem;">${fmtAddr(b.customer?.address || b.address || a.address || '')}</span></div>
        </div>
      </div>

      ${hasInspection ? `
      <div class="detail-section" style="border-color:#bbf7d0;background:#f0fdf4;">
        <div class="detail-section-header"><i class="bi bi-clipboard-check" style="color:#059669;"></i><h6 style="color:#059669;">Inspection Report</h6></div>
        <div class="detail-section-body">
          <div class="detail-row"><label>Findings</label><span style="font-size:0.82rem;">${insp.findings || diag.findings || '—'}</span></div>
          ${insp.severity ? `<div class="detail-row"><label>Severity</label><span style="color:${sevColors[insp.severity] || '#334155'};font-weight:600;font-size:0.82rem;text-transform:capitalize;">${insp.severity}</span></div>` : ''}
          ${insp.damagedParts?.length ? `<div class="detail-row"><label>Damaged Parts</label><span style="font-size:0.82rem;">${insp.damagedParts.map(p => `<span style="background:#fef2f2;color:#991b1b;padding:1px 6px;border-radius:4px;font-size:0.75rem;margin-right:3px;">${p}</span>`).join('')}</span></div>` : ''}
          <div class="detail-row"><label>Diagnosis</label><span style="font-size:0.82rem;">${diag.findings || insp.diagnosis || '—'}</span></div>
          ${insp.recommendedAction ? `<div class="detail-row"><label>Recommended Action</label><span style="font-size:0.82rem;">${insp.recommendedAction}</span></div>` : ''}
        </div>
      </div>` : ''}

      <div class="detail-section">
        <div class="detail-section-header"><i class="bi bi-receipt" style="color:#2563eb;"></i><h6>Charges</h6></div>
        <div class="detail-section-body">
          ${inspectionFee > 0 ? `<div class="detail-row"><label><i class="bi bi-search me-1"></i>Inspection Fee</label><span>₱${Number(inspectionFee).toLocaleString()}</span></div>` : ''}
          ${travelFee > 0 ? `<div class="detail-row"><label><i class="bi bi-geo-alt me-1"></i>Travel Fee</label><span>₱${Number(travelFee).toLocaleString()}</span></div>` : ''}
          ${(q.parts || []).length ? q.parts.map(p => {
        const unitPrice = p.cost || p.unitPrice || p.price || 0;
        const qty = p.quantity || 1;
        return `<div class="detail-row"><label>${p.name || p.partName || 'Part'}</label><span>${qty} × ₱${Number(unitPrice).toLocaleString()} = ₱${Number(unitPrice * qty).toLocaleString()}</span></div>`;
      }).join('') : '<div class="detail-row"><label>Parts</label><span class="text-muted">—</span></div>'}
          <div class="detail-row"><label><i class="bi bi-tools me-1"></i>Labor</label><span>₱${Number(laborCost).toLocaleString()}</span></div>
          <div class="detail-row" style="border-top:2px solid #f1f5f9;padding-top:8px;margin-top:4px;"><label style="font-weight:800;color:#334155;">Total Amount</label><span style="font-weight:800;font-size:1.05rem;color:#2563eb;">₱${Number(grandTotal).toLocaleString()}</span></div>
          ${q.notes ? `<div class="detail-row"><label>Quotation Notes</label><span style="font-size:0.82rem;color:#64748b;">${q.notes}</span></div>` : ''}
        </div>
      </div>

      <div class="detail-section">
        <div class="detail-section-header"><i class="bi bi-cash-stack" style="color:#059669;"></i><h6>Payment</h6></div>
        <div class="detail-section-body">
          ${inspPaid > 0 ? `<div class="detail-row"><label>Inspection Fee</label><span style="color:#059669;">Paid — ₱${Number(inspPaid).toLocaleString()}</span></div>` : ''}
          ${downpayment > 0 ? `<div class="detail-row"><label>Downpayment</label><span style="color:#059669;">₱${Number(downpayment).toLocaleString()}</span></div>` : ''}
          ${repairPaid > 0 ? `<div class="detail-row"><label>Repair Payment</label><span style="color:#059669;">Paid — ₱${Number(repairPaid).toLocaleString()}</span></div>` : ''}
          ${balanceDue > 0
          ? `<div class="detail-row"><label>Balance Due</label><span style="color:#d97706;font-weight:600;">₱${Number(balanceDue).toLocaleString()}</span></div>`
          : `<div class="detail-row"><label>Balance</label><span style="color:#059669;font-weight:600;">Fully Paid</span></div>`
        }
          <div class="detail-row" style="border-top:2px solid #f1f5f9;padding-top:8px;margin-top:4px;"><label style="font-weight:700;">Total Paid</label><span style="font-weight:700;color:${balanceDue <= 0 ? '#059669' : '#d97706'};">₱${Number(totalPaid).toLocaleString()} / ₱${Number(grandTotal).toLocaleString()}</span></div>
        </div>
      </div>

      ${warrantyEnd ? `<div class="alert alert-success py-2 px-3 mb-0" style="font-size:0.8rem;border-radius:8px;"><i class="bi bi-shield-check me-1"></i>Warranty valid until ${warrantyEnd}</div>` : ''}
    </div>`;
    }

    function renderRatingPage(a) {
      const b = a.bookingId || {};
      const rating = b.customerRating;
      const comment = b.customerRatingComment;
      if (!rating) {
        return `<div><div class="wizard-empty-state"><i class="bi bi-star"></i><div class="ws-title">No Rating Yet</div><div class="ws-desc">The customer has not submitted a rating for this service.</div></div></div>`;
      }
      const stars = '★'.repeat(rating) + '☆'.repeat(5 - rating);
      const ratingColor = rating >= 4 ? '#059669' : rating >= 3 ? '#d97706' : '#dc2626';
      return `<div>
      <div class="detail-section" style="border-color:#fef3c7;background:#fffbeb;">
        <div class="detail-section-header"><i class="bi bi-star-fill" style="color:#f59e0b;"></i><h6>Customer Rating</h6></div>
        <div class="detail-section-body" style="text-align:center;padding:20px;">
          <div style="font-size:2.5rem;letter-spacing:4px;color:${ratingColor};margin-bottom:8px;">${stars}</div>
          <div style="font-size:1.5rem;font-weight:800;color:${ratingColor};margin-bottom:4px;">${rating}/5</div>
          ${comment ? `<div style="margin-top:12px;padding:12px 16px;background:#fff;border:1px solid #e2e8f0;border-radius:10px;font-size:0.82rem;color:#475569;line-height:1.5;text-align:left;">"${comment}"</div>` : ''}
        </div>
      </div>
    </div>`;
    }

    /**
     * Returns true if the technician is allowed to go "en route" for this assignment.
     * Rule: booking date must be today (or in the past), AND current time >= startTime.
     */
    function canEnRoute(a) {
      return true; // TEMPORARILY DISABLED - always allow en route
    }

    /**
     * Returns a human-readable label for when en route becomes available.
     */
    function enRouteAvailableLabel(a) {
      if (!a.bookingDate) return '';
      const bookingDate = new Date(a.bookingDate);
      const now = new Date();
      const todayMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0, 0);
      const bookingMidnight = new Date(bookingDate.getFullYear(), bookingDate.getMonth(), bookingDate.getDate(), 0, 0, 0, 0);
      if (bookingMidnight > todayMidnight) {
        return bookingDate.toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric' }) + (a.startTime ? ' at ' + a.startTime : '');
      }
      return a.startTime ? 'at ' + a.startTime : '';
    }

    function renderCard(a, isCurrentJob) {
      const date = a.bookingDate ? new Date(a.bookingDate).toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric' }) : '';
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const isToday = a.bookingDate && new Date(a.bookingDate).toDateString() === today.toDateString();
      const isRepair = isRepairAssignment(a);
      const bs = a.bookingId?.status || a.bookingStatus;

      // Determine accent color based on status
      const accentColors = {
        pending_acceptance: '#f59e0b',
        accepted: '#3b82f6',
        en_route: '#06b6d4',
        on_site: '#8b5cf6',
        in_progress: '#2563eb',
        completed: '#10b981',
        cancelled: '#94a3b8',
        declined: '#ef4444',
        no_show: '#94a3b8'
      };
      const accentColor = accentColors[a.status] || '#e2e8f0';

      // Service type badge
      const serviceBadge = a.serviceType === 'project'
        ? '<span class="mw-service-badge" style="background:rgba(99,102,241,0.12);color:#4338ca;"><i class="bi bi-building me-1"></i>Project</span>'
        : isRepair
          ? '<span class="mw-service-badge repair"><i class="bi bi-tools me-1"></i>Repair</span>'
          : '<span class="mw-service-badge core"><i class="bi bi-wrench me-1"></i>Core</span>';

      // Active/Today label chips
      let labelChips = '';
      if (isCurrentJob) labelChips += '<span style="font-size:0.58rem;font-weight:800;letter-spacing:0.08em;padding:3px 8px;border-radius:6px;background:rgba(59,130,246,0.15);color:#1e40af;text-transform:uppercase;">Active</span>';
      if (isToday && !isCurrentJob) labelChips += '<span class="pulse-today" style="font-size:0.65rem;font-weight:800;letter-spacing:0.08em;padding:4px 10px;border-radius:6px;background:#f59e0b;color:#fff;text-transform:uppercase;"><i class="bi bi-star-fill me-1"></i> Today</span>';
      if (a.serviceType === 'project') labelChips += '<span style="font-size:0.58rem;font-weight:800;letter-spacing:0.08em;padding:3px 8px;border-radius:6px;background:rgba(99,102,241,0.15);color:#4338ca;text-transform:uppercase;"><i class="bi bi-building me-1"></i>Project Assignment</span>';
      // Show "Repair Execution" chip for Phase 2 assignments (booking status starts with repair_ or is ready_for_repair)
      const isPhase2 = isRepair && (bs?.startsWith?.('repair_') || bs === 'ready_for_repair');
      if (isPhase2) labelChips += '<span style="font-size:0.58rem;font-weight:800;letter-spacing:0.08em;padding:3px 8px;border-radius:6px;background:rgba(220,38,38,0.12);color:#991b1b;text-transform:uppercase;border:1px solid rgba(220,38,38,0.2);"><i class="bi bi-tools me-1"></i>Execution</span>';

      return `
