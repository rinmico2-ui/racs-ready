<script>
  (function () {
    function setSidebarBadge(id, value, title) {
      const badge = document.getElementById(id);
      if (!badge) return;
      const count = Math.max(0, Number(value) || 0);
      badge.textContent = count > 0 ? String(count) : '';
      badge.style.display = count > 0 ? 'inline-flex' : 'none';
      if (title) badge.title = title;
    }

    function setResolutionSidebarCount(summary) {
      const bookingCases = Math.max(0, Number(summary?.bySource?.booking) || 0);
      const orderCases = Math.max(0, Number(summary?.bySource?.order) || 0);
      const total = bookingCases + orderCases;
      setSidebarBadge('attentionBadge', total, `${bookingCases} booking case${bookingCases === 1 ? '' : 's'} and ${orderCases} order case${orderCases === 1 ? '' : 's'}`);
    }

    async function sidebarJson(url) {
      const response = await fetch(url, { credentials: 'same-origin', cache: 'no-store' });
      if (!response.ok) throw new Error(`Sidebar count request failed: ${response.status}`);
      return response.json();
    }

    let sidebarBadgeRefreshRunning = false;
    async function updateSidebarBadges() {
      if (document.hidden || sidebarBadgeRefreshRunning) return;
      sidebarBadgeRefreshRunning = true;
      try {
        const results = await Promise.allSettled([
          sidebarJson('/api/notifications/counts'),
          sidebarJson('/api/admin/warranties/stats'),
          sidebarJson('/api/maintenance/badge'),
          sidebarJson('/api/orders/badge'),
          sidebarJson('/api/projects/dashboard'),
          sidebarJson('/api/admin/repair-scheduling-queue/stats'),
          fetch('/api/admin/resolution-center?page=1&perPage=1', { credentials: 'same-origin', cache: 'no-store' }).then(response => response.ok ? response.json() : Promise.reject(new Error('Resolution count unavailable'))),
          sidebarJson('/api/admin/appointments/equipment-returns/summary'),
        ]);
        const value = index => results[index].status === 'fulfilled' ? results[index].value : null;
        const counts = value(0);
        if (counts) {
          setSidebarBadge('pendingReviewCount', counts.pendingBookings);
          setSidebarBadge('appointmentsBadge', Number(counts.pendingBookings || 0) + Number(counts.assignmentQueue || 0) + Number(counts.activeJobs || 0));
          setSidebarBadge('expensesBadge', counts.pendingExpenses);
          setSidebarBadge('escalatedBadge', counts.escalatedBookings);
          setSidebarBadge('leavesBadge', counts.pendingLeaveRequests);
          setSidebarBadge('auditTodayBadge', counts.auditToday);
        }
        const warranty = value(1);
        if (warranty) setSidebarBadge('warrantyBadge', Number(warranty.activeWarranty || 0) + Number(warranty.warrantyClaims || 0));
        const maintenance = value(2);
        if (maintenance) setSidebarBadge('maintenanceBadge', maintenance.actionable);
        const orders = value(3);
        if (orders) setSidebarBadge('ordersBadge', orders.actionable);
        const projects = value(4);
        if (projects) setSidebarBadge('projectsBadge', projects.stats?.pendingScheduling);
        const repairScheduling = value(5);
        if (repairScheduling) setSidebarBadge('repairSchedBadge', repairScheduling.pendingScheduling);
        const resolution = value(6);
        if (resolution) setResolutionSidebarCount(resolution.summary);
        const returns = value(7);
        if (returns) {
          setSidebarBadge('equipmentReturnsBadge', returns.overdue);
          setSidebarBadge('equipmentReturnsDashboardBadge', returns.overdue);
        }
      } finally {
        sidebarBadgeRefreshRunning = false;
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      window.addEventListener('resolution:counts', event => setResolutionSidebarCount(event.detail));
      updateSidebarBadges();
      window.setInterval(updateSidebarBadges, 60000);
      document.addEventListener('visibilitychange', function () { if (!document.hidden) updateSidebarBadges(); });
    });
  })();
</script>
