          <tr>
            <th><i class="bi bi-hash me-1"></i>Reference</th>
            <th><i class="bi bi-person me-1"></i>Customer</th>
            <th><i class="bi bi-currency-peso me-1"></i>Amount</th>
            <th><i class="bi bi-wallet me-1"></i>Method</th>
            <th><i class="bi bi-calendar me-1"></i>Date</th>
            <th><i class="bi bi-chat-left-text me-1"></i>Reason</th>
