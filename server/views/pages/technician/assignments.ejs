<script>
  (function () {
    // ── Fix Bootstrap aria-hidden focus trap (senior-level) ──────────────────
    // Bootstrap 5 sets aria-hidden="true" when hiding modals, but the close
    // button retains focus, causing the browser to block aria-hidden. We blur
    // the active element BEFORE Bootstrap processes the hide to prevent this.
    document.addEventListener('hide.bs.modal', function (e) {
      if (e.target?.id === 'materialsModal' && window._repairCompletionSubmitting) {
        e.preventDefault();
        return;
      }
      const modal = e.target;
      const active = document.activeElement;
      if (active && modal.contains(active)) {
        active.blur();
      }
    }, true);

    // ── Button Loading Utility (anti-spam, enterprise) ────────────────────────
    // Wraps an async function with button disable + spinner. Prevents double-click.
    window._btnLoading = function (btn, asyncFn) {
      if (!btn) return Promise.resolve().then(asyncFn);
      // Skip duplicate check if already loading via inline onclick — just proceed
      if (btn.classList.contains('btn-loading') && !btn._btnLoadingActive) {
        btn._btnLoadingActive = true;
        const originalHtml = btn.innerHTML;
        const cleanup = () => { btn.classList.remove('btn-loading'); btn.disabled = false; btn.innerHTML = originalHtml; btn._btnLoadingActive = false; };
        return Promise.resolve().then(asyncFn).finally(cleanup);
      }
      if (btn._btnLoadingActive) return; // Already running
      const originalHtml = btn.innerHTML;
      btn.classList.add('btn-loading');
      btn.disabled = true;
      btn._btnLoadingActive = true;
      const cleanup = () => { btn.classList.remove('btn-loading'); btn.disabled = false; btn.innerHTML = originalHtml; btn._btnLoadingActive = false; };
      return Promise.resolve().then(asyncFn).finally(cleanup);
    };

    let currentFilter = 'all';
    let currentPage = 1;
    let allItems = [];

    const statusColors = {
      pending_acceptance: 'bg-warning text-dark',
      accepted: 'bg-primary',
      en_route: 'bg-info text-dark',
      on_site: 'bg-dark',
      in_progress: 'bg-primary',
      completed: 'bg-success',
      cancelled: 'bg-secondary',
      declined: 'bg-danger',
      no_show: 'bg-secondary',
      // Repair booking statuses
      waiting_parts: 'bg-warning text-dark',
      repair_approved: 'bg-info text-dark',
      ready_for_repair: 'bg-success',
      repair_scheduled: 'bg-success',
      repair_in_progress: 'bg-primary',
      repair_completed: 'bg-success',
    };

    const statusLabels = {
      pending_acceptance: 'Pending',
      accepted: 'Accepted',
      en_route: 'En Route',
      on_site: 'On Site',
      waiting_for_customer: 'Waiting for Customer',
      no_show_reported: 'No-Show Reported',
      in_progress: 'In Progress',
      completed: 'Completed',
      cancelled: 'Cancelled',
      declined: 'Declined',
      no_show: 'No Show',
      // Repair booking statuses
      waiting_parts: 'Waiting for Parts',
      repair_approved: 'Repair Approved',
      ready_for_repair: 'Ready for Repair',
      repair_scheduled: 'Repair Scheduled',
      repair_in_progress: 'Repair In Progress',
      repair_completed: 'Repair Completed',
    };

    function statusBadgeClass(status) {
      const s = String(status || '').toLowerCase().replace(/_/g, '-');
      if (['pending-acceptance','pending','waiting-parts','expired'].includes(s)) return 'pending';
      if (['accepted','confirmed','scheduled','repair-approved','ready-for-repair','repair-scheduled'].includes(s)) return 'confirmed';
      if (['en-route','en_route','out-for-delivery','on-the-way'].includes(s)) return 'on-the-way';
      if (['on-site','on_site','arrived','waiting-for-customer','waiting_for_customer'].includes(s)) return 'scheduled';
      if (['in-progress','in_progress','installing','repair-in-progress','repair_in_progress'].includes(s)) return 'in-progress';
      if (['completed','repair-completed','repair_completed','under-warranty','under_warranty'].includes(s)) return 'completed';
      if (['cancelled','canceled','declined','rejected','no-show','no_show','no-show-reported','no_show_reported'].includes(s)) return 'cancelled';
      return 'pending';
    }

    const WORK_PROGRESS_ACTIONS = {
      accepted: { t: 'Technician assigned', s: 'A technician has been assigned to your job.', icon: 'bi-person-check' },
      daily_prep: { t: 'Equipment prepared', s: 'Equipment and consumables prepared for all of today\'s jobs.', icon: 'bi-briefcase' },
      en_route: { t: 'Heading to your location', s: 'Live GPS tracking is active — watch the map for arrival.', icon: 'bi-geo-alt' },
      on_site: { t: 'Arrived at your location', s: 'The technician is now onsite preparing for the service.', icon: 'bi-pin-map' },
      arrived: { t: 'Arrived at your location', s: 'The technician is now onsite preparing for the service.', icon: 'bi-pin-map' },
      in_progress: { t: 'Working on your unit', s: 'The technician is performing the service right now.', icon: 'bi-gear' },
      repair: { t: 'Repairing unit', s: 'Parts and labor are in progress.', icon: 'bi-tools' },
      inspect: { t: 'Inspecting unit', s: 'Diagnosing the issue and preparing a quotation.', icon: 'bi-search' },
      quote: { t: 'Quotation ready', s: 'Waiting for customer approval.', icon: 'bi-receipt' },
      done: { t: 'All done', s: 'The repair/service is complete.', icon: 'bi-check-circle' },
      completed: { t: 'Service completed', s: 'Your technician has finished the job.', icon: 'bi-check-circle' }
    };

    const STEP_DESCRIPTIONS = {
      accepted: 'A technician has been assigned to your job.',
      ai_review: 'Review and verify the preliminary AI diagnosis before preparing equipment.',
      daily_prep: 'Equipment and consumables are prepared once for all of today\'s jobs.',
      checkout: 'Prepare equipment and consumables after resolving the recommended parts.',
      ai_analysis: 'Open the required AI analysis for this repair.',
      reserve_parts: 'Reserve every part recommended by the AI analysis.',
      additional_parts: 'Add any other parts needed for the visit.',
      preparation: 'Confirm that equipment, diagnosis, and parts are ready.',
      en_route: 'Your technician is on the way to your location.',
      on_site: 'Technician has arrived and is assessing the unit.',
      arrived: 'Technician has arrived and is assessing the unit.',
      in_progress: 'Work is being performed on your unit.',
      repair: 'Repair is being performed on your unit.',
      inspect: 'Technician is diagnosing the issue.',
      quote: 'Quotation is being prepared.',
      done: 'Job finished. Thank you!',
      completed: 'Job finished. Thank you!'
    };

    function renderWorkProgress(steps, activeIdx, currentKey) {
      const liveKeys = ['en_route','arrived','on_site','in_progress','repair','inspect','quote'];
      const isLive = liveKeys.includes(currentKey);
      const act = WORK_PROGRESS_ACTIONS[currentKey] || { t: steps[activeIdx]?.label || currentKey, s: 'In progress', icon: steps[activeIdx]?.icon || 'bi-info-circle' };
      const curIdx = activeIdx >= 0 ? activeIdx : steps.findIndex(s => s.key === currentKey);
      const tasks = steps.map((step, i) => {
        let cls = '';
        if (i < curIdx) cls = 'done';
        else if (i === curIdx) cls = 'active';
        const icon = i < curIdx ? 'bi-check-lg' : step.icon;
        const desc = STEP_DESCRIPTIONS[step.key] || '';
        return `<div class="trk-task ${cls}"><div class="trk-task-dot"><i class="bi ${icon}"></i></div><div class="trk-task-body"><div class="trk-task-label">${step.label}</div>${desc ? `<div class="trk-task-desc">${desc}</div>` : ''}</div></div>`;
      }).join('');
      const curIcon = isLive ? 'bi-arrow-repeat' : act.icon;
      return `
        <div class="trk-card-header">
          <h6 class="trk-card-title"><i class="bi bi-activity"></i> Work Progress</h6>
          ${isLive ? '<span class="trk-live-tag"><span class="trk-pulse-dot live"></span> LIVE</span>' : ''}
        </div>
        <div class="trk-card-body">
          <div class="trk-current-action ${isLive ? 'live' : ''}">
            <div class="trk-current-action-icon"><i class="bi ${curIcon}"></i></div>
            <div class="trk-current-action-text">
              <div class="trk-current-action-title">${act.t}</div>
              <div class="trk-current-action-sub">${act.s}</div>
            </div>
          </div>
          <div class="trk-task-list">${tasks}</div>
        </div>`;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // WIZARD PAGINATION ENGINE
    // ═══════════════════════════════════════════════════════════════════════════

    function isRepairAssignment(a) {
      const serviceItems = Array.isArray(a?.bookingId?.services)
        ? a.bookingId.services
        : (Array.isArray(a?.services) ? a.services : []);
      return a.serviceType === 'repair' || a.serviceType === 'mixed' ||
        a.bookingId?.serviceType === 'repair' || a.bookingId?.serviceType === 'mixed' ||
        serviceItems.some(item => item?.type === 'repair') ||
        a.bookingId?.status?.startsWith?.('repair_') ||
        ['inspection_scheduled', 'inspection_completed', 'awaiting_approval', 'repair_approved',
          'repair_declined', 'waiting_parts', 'parts_reserved', 'ready_for_repair',
          'repair_in_progress', 'repair_completed'].includes(a.bookingId?.status || a.bookingStatus);
    }

    function isMixedAssignment(a) {
      const items = Array.isArray(a?.bookingId?.services)
        ? a.bookingId.services
        : (Array.isArray(a?.services) ? a.services : []);
      return a?.serviceType === 'mixed' || a?.bookingId?.serviceType === 'mixed' ||
        (items.some(item => item?.type === 'core') && items.some(item => item?.type === 'repair'));
    }

    function isMixedWorkStarted(a) {
      if (!isMixedAssignment(a)) return false;
      const items = Array.isArray(a?.bookingId?.services)
        ? a.bookingId.services
        : (Array.isArray(a?.services) ? a.services : []);
      return ['in_progress', 'completed'].includes(a?.status)
        || items.some(item => ['in_progress', 'inspection_in_progress', 'repair_in_progress', 'payment_pending', 'completed'].includes(item?.status));
    }

    function mixedRepairItems(a) {
      const items = Array.isArray(a?.bookingId?.services)
        ? a.bookingId.services
        : (Array.isArray(a?.services) ? a.services : []);
      return items.filter(item => item?.type === 'repair');
    }

    function areMixedRepairItemsCompleted(a) {
      const items = mixedRepairItems(a);
      return isMixedAssignment(a) && items.length > 0 && items.every(item => item.status === 'completed');
    }

    function areMixedRepairItemsFinished(a) {
      const items = mixedRepairItems(a);
      return isMixedAssignment(a) && items.length > 0
        && items.every(item => ['completed', 'repair_declined', 'cancelled'].includes(item.status));
    }

    const REPAIR_PAGES = ['overview', 'core-service', 'repair-service', 'ai-assistant', 'inspection', 'quotation', 'scheduling', 'repair', 'completion', 'invoice', 'rating'];

    const PAGE_REGISTRY = {
      'overview': {
        id: 'overview', label: 'Overview', icon: 'bi-clipboard-check',
        visible: () => true
      },
      'core-service': {
        id: 'core-service', label: 'Core Service', icon: 'bi-gear-wide-connected',
        visible: (a) => isMixedWorkStarted(a) &&
          (a.bookingId?.services || []).some(item => item.type === 'core')
      },
      'repair-service': {
        id: 'repair-service', label: 'Repair Service', icon: 'bi-tools',
        visible: (a) => isMixedWorkStarted(a) &&
          (a.bookingId?.services || []).some(item => item.type === 'repair')
      },
      'ai-assistant': {
        id: 'ai-assistant', label: 'AI Analysis', icon: 'bi-robot',
        visible: (a) => {
          if (!isRepairAssignment(a)) return false;
          if (isMixedWorkStarted(a)) return false;
          const bs = a.bookingId?.status || a.bookingStatus;
          // Phase 2 statuses — AI tab not needed during repair execution
          if (['repair_scheduled', 'ready_for_repair', 'repair_in_progress', 'repair_completed',
               'under_warranty', 'closed', 'cancelled', 'repair_declined', 'waiting_parts',
               'parts_reserved'].includes(bs)) return false;
          // Also hide if a quotation already exists (means phase 1 is done)
          if (a.quotation?.createdAt || a.bookingId?.quotation?.createdAt) return false;
          // Show during all phase 1 statuses: accepted, en_route, on_site, in_progress,
          // inspection_scheduled, inspection_completed, awaiting_approval, repair_approved
          return true;
        }
      },
      'inspection': {
        id: 'inspection', label: 'Inspection & Quote', icon: 'bi-search',
        visible: (a) => {
          if (!isRepairAssignment(a)) return false;
          if (isMixedWorkStarted(a)) return false;
          const bs = a.bookingId?.status || a.bookingStatus;
          const as = a.status;
          // Hide during phase 2
          if (a.quotation?.createdAt || a.bookingId?.quotation?.createdAt) return false;
          if (['repair_scheduled', 'ready_for_repair', 'repair_in_progress', 'repair_completed', 'under_warranty'].includes(bs)) return false;
          // Only show during the initial inspection phase — NOT during repair reschedule
          return as === 'in_progress' && ['inspection_scheduled', 'inspection_completed', 'awaiting_approval'].includes(bs);
        }
      },
      'quotation': {
        id: 'quotation', label: 'Quotation', icon: 'bi-receipt',
        visible: (a) => {
          if (!isRepairAssignment(a)) return false;
          if (isMixedWorkStarted(a)) return false;
          const bs = a.bookingId?.status || a.bookingStatus;
          const as = a.status;
          if (a.quotation?.createdAt || a.bookingId?.quotation?.createdAt) return false;
          if (['repair_scheduled', 'ready_for_repair', 'repair_in_progress', 'repair_completed', 'under_warranty'].includes(bs)) return false;
          // Only show during the initial quotation phase — NOT during repair reschedule
          return as === 'in_progress' && ['awaiting_approval'].includes(bs) && !a.bookingId?.quotation?.createdAt;
        }
      },
      'repair': {
        id: 'repair', label: 'Repair', icon: 'bi-tools',
        visible: (a) => {
          if (!isRepairAssignment(a)) return false;
          if (isMixedWorkStarted(a)) return false;
          const bs = a.bookingId?.status || a.bookingStatus;
          return ['ready_for_repair', 'scheduled', 'repair_scheduled', 'repair_in_progress', 'repair_completed', 'under_warranty', 'closed', 'repair_approved'].includes(bs);
        }
      },
      'scheduling': {
        id: 'scheduling', label: 'Scheduling', icon: 'bi-calendar-check',
        visible: (a) => {
          if (!isRepairAssignment(a)) return false;
          if (isMixedWorkStarted(a)) return false;
          const bs = a.bookingId?.status || a.bookingStatus;
          // Only show during initial inspection phase — NOT during repair execution (admin handles scheduling)
          return ['inspection_scheduled', 'inspection_completed', 'awaiting_approval'].includes(bs) && a.bookingId?.preferredDate;
        }
      },
      'completion': {
        id: 'completion', label: 'Completion', icon: 'bi-check-circle-fill',
        visible: (a) => ['completed'].includes(a.status) || ['repair_completed', 'under_warranty', 'closed'].includes(a.bookingId?.status || a.bookingStatus)
      },
      'invoice': {
        id: 'invoice', label: 'Invoice', icon: 'bi-file-earmark-text',
        visible: (a) => {
          if (isRepairAssignment(a)) {
            return ['completed'].includes(a.status) || ['repair_completed', 'under_warranty', 'closed'].includes(a.bookingId?.status || a.bookingStatus);
          }
          return ['completed'].includes(a.status) || ['completed', 'closed'].includes(a.bookingId?.status || a.bookingStatus);
        }
      },
      'rating': {
        id: 'rating', label: 'Rating', icon: 'bi-star-fill',
        visible: (a) => {
          if (isRepairAssignment(a)) {
            if (!(a.customerRating || a.bookingId?.customerRating)) return false;
            return ['completed'].includes(a.status) || ['repair_completed', 'under_warranty', 'closed'].includes(a.bookingId?.status || a.bookingStatus);
          }
          if (!(a.customerRating || a.bookingId?.customerRating)) return false;
          return ['completed'].includes(a.status) || ['completed', 'closed'].includes(a.bookingId?.status || a.bookingStatus);
        }
      }
    };

    window._wizardState = { pages: [], current: 0, assignment: null };

    window.wizardNav = function (dir) {
      const offset = dir === 'next' ? 1 : -1;
      wizardShowPage(window._wizardState.current + offset);
    };

    function wizardShowPage(index) {
      const { pages } = window._wizardState;
      if (index < 0 || index >= pages.length) return;
      const container = document.querySelector('#assignDetailBody .wizard-container');
      if (!container) return;

      container.querySelectorAll('.wizard-page.active').forEach(el => el.classList.remove('active'));

      const pageId = pages[index];
      const pageEl = container.querySelector(`.wizard-page[data-page="${pageId}"]`);
      if (pageEl) { pageEl.classList.add('active'); }

      container.scrollTop = 0;
      window._wizardState.current = index;

      document.getElementById('wizardPrev').style.display = index > 0 ? '' : 'none';
      document.getElementById('wizardNext').style.display = index < pages.length - 1 ? '' : 'none';
      document.getElementById('wizardActionBar').style.display = 'flex';

      const actionSlot = document.getElementById('wizardActionSlot');
      actionSlot.innerHTML = getWizardPageActions(pageId, window._wizardState.assignment);

      const indicator = document.getElementById('wizardPageIndicator');
      indicator.innerHTML = pages.map((pid, i) => {
        const cls = i === index ? 'wizard-step-dot active' : i < index ? 'wizard-step-dot visited' : 'wizard-step-dot';
        return `<span class="${cls}" title="${PAGE_REGISTRY[pid].label}" onclick="wizardShowPage(${i})" style="cursor:pointer;"></span>`;
      }).join('');

      updateWizardStepper(pages, index);
    }
    window.wizardShowPage = wizardShowPage;

    function updateWizardStepper(pages, currentIdx) {
      const stepperEl = document.getElementById('detailModalWorkflow');
      if (!stepperEl) return;
      stepperEl.innerHTML = pages.map((pageId, i) => {
        const def = PAGE_REGISTRY[pageId];
        const isComplete = i < currentIdx;
        const isCurrent = i === currentIdx;
        const dotBg = isComplete ? '#60a5fa' : isCurrent ? '#fff' : 'rgba(255,255,255,0.25)';
        const dotBorder = isComplete ? '#60a5fa' : isCurrent ? '#fff' : 'rgba(255,255,255,0.3)';
        const labelColor = isComplete ? 'rgba(255,255,255,0.9)' : isCurrent ? '#fff' : 'rgba(255,255,255,0.5)';
        return `
        <div style="display:flex;align-items:center;flex:1;cursor:pointer;" onclick="wizardShowPage(${i})" title="Go to ${def.label}">
          <div style="display:flex;flex-direction:column;align-items:center;gap:5px;min-width:0;">
            <div style="width:26px;height:26px;border-radius:50%;background:${dotBg};border:2px solid ${dotBorder};display:flex;align-items:center;justify-content:center;box-shadow:${isCurrent ? '0 0 0 4px rgba(255,255,255,0.2)' : 'none'};">
              <i class="bi ${def.icon}" style="font-size:11px;color:${isComplete ? '#fff' : isCurrent ? '#2563eb' : 'rgba(255,255,255,0.5)'}"></i>
            </div>
            <span style="font-size:0.62rem;font-weight:${isCurrent ? '700' : '500'};color:${labelColor};white-space:nowrap;max-width:70px;text-align:center;">${def.label}</span>
          </div>
          ${i < pages.length - 1 ? `<div style="flex:1;height:2px;background:${i < currentIdx ? '#60a5fa' : 'rgba(255,255,255,0.2)'};margin:0 -4px;margin-bottom:16px;"></div>` : ''}
        </div>`;
      }).join('');
    }

    function getWizardPageActions(pageId, a, allowMixedRepairActions = false) {
      if (!a) return '';
      const bs = a.bookingId?.status || a.bookingStatus;
      const bId = a.bookingId?._id || a.bookingId;
      const esc = (s) => (s || '').replace(/'/g, "\\'");
      const isRepair = isRepairAssignment(a);
      // Recovery for records created by the former premature-completion bug.
      if (!isRepair && a.status === 'completed' && !(a.proofPhoto || a.bookingId?.proofPhoto)) {
        return `<button type="button" class="btn btn-danger" onclick="openProofModal('${a._id}','${esc(a.customerName)}','${esc(a.serviceName)}',${a.estimatedFee || 0});"><i class="bi bi-camera me-2"></i>Proof Required</button>`;
      }

      if (pageId === 'ai-assistant' && isRepair) {
        const ta = a.bookingId?.technicianAssistant;
        if (ta?.summary) {
          return `<div class="d-flex gap-2 flex-wrap">
            ${(ta.possibleParts || []).length ? `<button type="button" class="btn btn-outline-success" onclick="verifyAiAssistant('${bId}')"><i class="bi bi-box-seam me-2"></i>Select Optional Contingency Parts</button>` : ''}
            <button type="button" class="btn btn-outline-primary" onclick="switchDetailTab('overview')"><i class="bi bi-arrow-right-circle me-2"></i>Continue Preparation</button>
          </div>`;
        }
      }

      // Keep the shared Start Work control available while the technician is
      // viewing either service tab after marking the mixed visit as Arrived.
      if (isMixedAssignment(a) && ['core-service', 'repair-service'].includes(pageId) && a.status === 'on_site') {
        return `<button class="btn btn-success" onclick="repairTransition('${bId}','in_progress', this);"><i class="bi bi-play-fill me-2"></i>Start Work</button>`;
      }

      // The Repair tab exclusively owns Repair actions for mixed bookings.
      if (pageId === 'repair-service' && isMixedAssignment(a)) {
        const repairItems = mixedRepairItems(a);
        if (areMixedRepairItemsFinished(a)) {
          const declined = repairItems.every(item => ['repair_declined', 'cancelled'].includes(item.status));
          return `<span class="badge ${declined ? 'bg-secondary' : 'bg-success'}" style="font-size:0.78rem;padding:8px 16px;"><i class="bi ${declined ? 'bi-x-circle' : 'bi-check-circle'} me-1"></i>${declined ? 'Repair Declined' : 'Repair Complete'} â€” Finish Remaining Core Service</span>`;
        }
        // The shared assignment is the source of truth for Arrived/Start Work.
        // Older mixed bookings can have a Repair child left at one of these
        // pre-inspection states even though the shared work session is active.
        const repairInspectionReadyStatuses = new Set([
          'pending', 'inspection_pending', 'awaiting_assignment', 'assigned', 'inspection_scheduled',
          'accepted', 'scheduled', 'en_route', 'arrived'
        ]);
        const startableItemIds = repairItems
          .filter(item => isMixedWorkStarted(a) && repairInspectionReadyStatuses.has(String(item.status || '')))
          .map(item => String(item._id || ''))
          .filter(Boolean);
        if (startableItemIds.length) {
          if (a.bookingId?.inspection?.completedAt) {
            return `<button type="button" class="btn btn-success" onclick="startRepair('${bId}')"><i class="bi bi-tools me-2"></i>Start Repair Work</button>`;
          }
          return `<button type="button" class="btn btn-primary" onclick="startMixedRepairInspection('${bId}','${startableItemIds.join(',')}',this)"><i class="bi bi-search me-2"></i>Start Repair Inspection</button>`;
        }
        const inspectionStarted = repairItems.some(item => ['inspection_in_progress', 'inspection_completed', 'diagnosis_completed', 'parts_check', 'awaiting_quotation', 'awaiting_customer_decision', 'repair_approved', 'ready_for_repair', 'repair_scheduled', 'repair_in_progress', 'payment_pending', 'completed', 'repair_declined'].includes(item.status));
        if (!inspectionStarted) {
          return `<span class="badge bg-secondary" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-info-circle me-1"></i>Complete Arrived and Start Work first</span>`;
        }
        return getWizardPageActions('overview', a, true);
      }

      if (pageId === 'overview') {
        if (a.status === 'pending_acceptance') {
          return `<button type="button" class="btn btn-success" onclick="acceptAssign('${a._id}',this);"><i class="bi bi-check-circle me-2"></i>Accept</button>
                <button type="button" class="btn btn-outline-danger" onclick="declineAssign('${a._id}',this);"><i class="bi bi-x-circle me-2"></i>Decline</button>`;
        }

        // Once the shared session starts, Overview is status-only. Core and
        // Repair actions live exclusively in their respective tabs.
        if (isMixedAssignment(a) && isMixedWorkStarted(a) && !allowMixedRepairActions) {
          return '';
        }

        // ── Repair flow: correct status-driven buttons ──
        // A completed Core child keeps the mixed booking historically started,
        // but the rescheduled Repair visit must follow the Phase 2 parent state.
        if (isMixedAssignment(a) && allowMixedRepairActions) {
          if (bs === 'waiting_parts') {
            return `<div class="d-flex flex-column gap-1"><span class="badge" style="background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;font-size:0.78rem;padding:8px 16px;"><i class="bi bi-box-seam me-1"></i>Waiting for Parts</span><small class="text-muted" style="font-size:0.7rem;padding:0 4px;">Admin is procuring the required Repair parts</small></div>`;
          }
          if (bs === 'repair_approved') {
            return `<div class="d-flex flex-column gap-1"><span class="badge bg-warning text-dark" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-calendar-clock me-1"></i>Awaiting Phase 2 Schedule</span><small class="text-muted" style="font-size:0.7rem;padding:0 4px;">Repair is approved and waiting for Admin scheduling</small></div>`;
          }
          if (['repair_scheduled', 'ready_for_repair', 'parts_reserved'].includes(bs) && ['accepted', 'in_progress', 'completed'].includes(a.status)) {
            return `<button type="button" class="btn btn-primary" onclick="repairEnRoute('${bId}',this);"><i class="bi bi-sign-turn-right me-2"></i>En Route — Phase 2</button>`;
          }
        }

        if (isRepair) {
          // STEP 1: Accept / Decline (handled above)

if (a.status === 'accepted') {
            const ta = a.bookingId?.technicianAssistant;
            if (!ta?.summary) {
              return `<button class="btn btn-info text-white" disabled><span class="spinner-border spinner-border-sm me-2"></span>Generating AI Diagnosis...</button>`;
            }
            if (!ta.verifiedByTechnician) {
              return `<button class="btn btn-info text-white" onclick="verifyAiAssistant('${bId}')"><i class="bi bi-clipboard2-pulse me-2"></i>Review AI Diagnosis</button>`;
            }
            return `<div class="d-flex gap-2 flex-wrap align-items-center"><button class="btn btn-outline-info" onclick="switchDetailTab('ai-assistant')"><i class="bi bi-robot me-2"></i>View AI Diagnosis</button><button type="button" class="btn btn-primary" onclick="repairEnRoute('${bId}',this);"><i class="bi bi-sign-turn-right me-2"></i>En Route</button></div>`;
          }

          // STEP 3: Arrived (was en_route, now at customer site)
          if (a.status === 'en_route') {
            return `<div class="d-flex gap-2 flex-nowrap">
              <button class="btn btn-primary" onclick="repairTransition('${bId}','on_site', this);"><i class="bi bi-geo-alt me-2"></i>Arrived</button>
              <button class="btn btn-outline-primary" style="border:1.5px solid #2563eb !important;background:#fff;color:#2563eb !important;" onclick="openRouteMapModal();event.stopPropagation();"><i class="bi bi-map me-1"></i>View Map</button>
              <button class="btn btn-outline-danger" onclick="openModalAfterClose(null,'assignDetailModal',()=>openCancelModal('${a._id}','${esc(a.customerName)}','${esc(a.serviceName)}'));"><i class="bi bi-x-circle me-2"></i>Cancel</button>
            </div>`;
          }

          // STEP 4: Start Work (arrived at site, ready to begin)
          if (a.status === 'on_site') {
            return `<button class="btn btn-success" onclick="repairTransition('${bId}','in_progress', this);"><i class="bi bi-play-fill me-2"></i>Start Work</button>
                    <button type="button" class="btn btn-warning text-dark" onclick="openCustomerNotAvailable('${a._id}',this);"><i class="bi bi-person-x me-2"></i>Customer Not Available</button>`;
          }

          // STEP 4b: Waiting for customer (no-show window active)
          if (a.status === 'waiting_for_customer') {
            const wt = a.waitingUntil || '';
            return `<div class="d-flex flex-column gap-1 w-100">
              <span class="badge" style="background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;font-size:0.78rem;padding:8px 16px;"><i class="bi bi-hourglass-split me-1"></i>Waiting for Customer</span>
              <small class="text-muted" style="font-size:0.7rem;padding:0 4px;">Attempted: ${(a.contactAttempts || []).join(', ') || '—'}</small>
              <button type="button" class="btn btn-outline-warning btn-sm" onclick="openCustomerNotAvailable('${a._id}',this,'resume');"><i class="bi bi-clock-history me-1"></i>View Waiting Timer</button>
            </div>`;
          }

          // STEP 4c: No-show reported — pending admin review
          if (a.status === 'no_show_reported') {
            return `<div class="d-flex flex-column gap-1 w-100">
              <span class="badge bg-danger" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-person-exclamation me-1"></i>No-Show Reported</span>
              <small class="text-muted" style="font-size:0.7rem;padding:0 4px;">Pending admin review. You may continue with other assignments.</small>
            </div>`;
          }

          // STEP 5+: in_progress — depends on booking phase
          if (a.status === 'in_progress') {
            if (areMixedRepairItemsCompleted(a)) {
              return `<span class="badge bg-success" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-check-circle me-1"></i>Repair Complete — Finish Remaining Core Service</span>`;
            }
            // Check Phase 1 inspection
            const hasInspection = !!(a.bookingId?.inspection?.completedAt);
            if (!hasInspection) {
              return `<div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-primary" onclick="openInspectionModal('${bId}','${esc(a.customerName)}','${esc(a.serviceName)}');"><i class="bi bi-clipboard-check me-2"></i>Inspect &amp; Quote</button>
                <button class="btn btn-outline-info" onclick="openModalAfterClose('workGuideModal','assignDetailModal',()=>openWorkGuideModal('${bId}','${esc(a.customerName)}','${esc(a.serviceName)}'));"><i class="bi bi-robot me-1"></i>Work Guide</button>
              </div>`;
            }

            // Waiting States (After Phase 1)
            if (bs === 'inspection_completed' || (!['awaiting_approval', 'repair_approved', 'waiting_parts', 'repair_scheduled', 'ready_for_repair', 'parts_reserved', 'repair_declined', 'repair_in_progress', 'repair_completed', 'under_warranty'].includes(bs))) {
              return `<button type="button" class="btn btn-success" onclick="showPostInspectionDecision('${bId}',${a.bookingId?.quotation?.totalCost || 0});"><i class="bi bi-clipboard-check me-2"></i>Decide Next Step</button>`;
            }
            if (['awaiting_approval'].includes(bs)) {
              return `<div class="d-flex flex-column gap-1">
                <span class="badge bg-warning text-dark" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-hourglass-split me-1"></i>Awaiting Admin Approval</span>
                <small class="text-muted" style="font-size:0.7rem;padding:0 4px;">Admin is reviewing your inspection &amp; quotation</small>
              </div>`;
            }
            if (bs === 'repair_approved') {
              return `<div class="d-flex flex-column gap-1">
                <span class="badge bg-warning text-dark" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-calendar-clock me-1"></i>Awaiting Schedule</span>
                <small class="text-muted" style="font-size:0.7rem;padding:0 4px;">Admin is scheduling your next visit</small>
              </div>`;
            }
            if (bs === 'waiting_parts') {
              return `<div class="d-flex flex-column gap-1">
                <span class="badge" style="background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;font-size:0.78rem;padding:8px 16px;"><i class="bi bi-box-seam me-1"></i>Waiting for Parts</span>
                <small class="text-muted" style="font-size:0.7rem;padding:0 4px;">Admin is procuring the required parts</small>
              </div>`;
            }
            if (bs === 'repair_declined') {
              const hasFee = (a.bookingId?.initialCost || 0) > 0;
              if (hasFee && !a.balanceCollected) {
                return `<button type="button" class="btn btn-warning" onclick="openInspectionPaymentModal('${bId}',window._detailAssignment,'${esc(a.bookingId?.inspection?.findings || '')}','${esc(a.bookingId?.diagnosis?.findings || '')}',()=>refreshOpenAssignmentDetail('inspection'));"><i class="bi bi-cash me-2"></i>Collect Inspection Fee</button>`;
              }
              return `<span class="badge bg-danger" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-x-circle me-1"></i>Repair Declined</span>`;
            }

            // Phase 2 Re-entry (Ready to go En Route again)
            if (['repair_scheduled', 'ready_for_repair', 'parts_reserved'].includes(bs)) {
              return `<div class="d-flex flex-column gap-1">
                <button type="button" class="btn btn-primary" onclick="repairEnRoute('${bId}',this);"><i class="bi bi-sign-turn-right me-2"></i>En Route — Phase 2</button>
                <small class="text-muted" style="font-size:0.7rem;padding:0 4px;"><i class="bi bi-check-circle text-success me-1"></i>Parts ready &amp; scheduled — head to customer</small>
              </div>`;
            }

            // Phase 2 Execution (At Site)
            if (bs === 'repair_in_progress') {
              const qTotal = a.bookingId?.quotation?.totalCost || 0;
              const paymentDue = isMixedAssignment(a)
                ? Number(a.bookingId?.balanceAmount ?? a.balanceAmount ?? qTotal)
                : qTotal;
              const repairPaymentSettled = Boolean(
                a.bookingId?.repairPaymentCollected || a.repairPaymentCollected
                || a.bookingId?.balanceCollected || a.balanceCollected
              );
              const needsRepairPay = !repairPaymentSettled && paymentDue > 0;
              if (needsRepairPay) {
                return `<button type="button" class="btn btn-warning" onclick="collectRepairPayment('${bId}',${paymentDue});"><i class="bi bi-cash me-2"></i>Collect Booking Balance (₱${paymentDue.toLocaleString()})</button>`;
              }
              return `<button type="button" class="btn btn-success" onclick="completeRepair('${bId}');"><i class="bi bi-camera me-2"></i>Proof of Completion</button>`;
            }
            if (['repair_completed', 'under_warranty'].includes(bs)) {
              return `<span class="badge bg-success" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-check-circle me-1"></i>${bs === 'under_warranty' ? 'Under Warranty' : 'Repair Done'}</span>`;
            }

            // Fallback
            return `<span class="badge bg-secondary" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-info-circle me-1"></i>${bs || 'Processing'}</span>`;
          }

          // Repair-specific booking statuses (assignment may not have transitioned to in_progress yet)
          if (bs === 'awaiting_approval') {
            return `<div class="d-flex flex-column gap-1">
              <span class="badge bg-warning text-dark" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-hourglass-split me-1"></i>Awaiting Admin Approval</span>
              <small class="text-muted" style="font-size:0.7rem;padding:0 4px;">Admin is reviewing your inspection &amp; quotation</small>
            </div>`;
          }
          if (bs === 'repair_approved') {
            return `<div class="d-flex flex-column gap-1">
              <span class="badge bg-warning text-dark" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-calendar-clock me-1"></i>Awaiting Schedule</span>
              <small class="text-muted" style="font-size:0.7rem;padding:0 4px;">Admin is scheduling your next visit</small>
            </div>`;
          }
          if (bs === 'waiting_parts') {
            return `<div class="d-flex flex-column gap-1">
              <span class="badge" style="background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;font-size:0.78rem;padding:8px 16px;"><i class="bi bi-box-seam me-1"></i>Waiting for Parts</span>
              <small class="text-muted" style="font-size:0.7rem;padding:0 4px;">Admin is procuring the required parts</small>
            </div>`;
          }
          if (bs === 'repair_scheduled') {
            return `<div class="d-flex flex-column gap-1">
              <button type="button" class="btn btn-primary" onclick="repairEnRoute('${bId}',this);"><i class="bi bi-sign-turn-right me-2"></i>En Route — Phase 2</button>
              <small class="text-muted" style="font-size:0.7rem;padding:0 4px;"><i class="bi bi-check-circle text-success me-1"></i>Repair scheduled — head to customer</small>
            </div>`;
          }
          if (['ready_for_repair', 'parts_reserved'].includes(bs)) {
            // Check if any parts are out of stock
            const qParts = a.bookingId?.quotation?.parts || [];
            let partsUnavailable = false;
            for (const p of qParts) {
              if (p.toolId) {
                const inv = (window._inspInventoryStatus || {})[p.toolId];
                if (!inv || Number(inv.availableToBooking ?? inv.quantity ?? 0) < (p.quantity || 1)) { partsUnavailable = true; break; }
              }
            }
            if (partsUnavailable) {
              return `<div class="d-flex flex-column gap-1">
                <button class="btn btn-secondary" disabled style="cursor:not-allowed;opacity:0.65;"><i class="bi bi-lock me-2"></i>Start Repair — Parts Unavailable</button>
                <small class="text-muted" style="font-size:0.7rem;padding:0 4px;"><i class="bi bi-exclamation-triangle text-danger me-1"></i>Some required parts are out of stock</small>
              </div>`;
            }
            return `<button type="button" class="btn btn-success" onclick="startRepair('${bId}');"><i class="bi bi-tools me-2"></i>Start Repair</button>`;
          }
          if (bs === 'repair_in_progress') {
            const qTotal = a.bookingId?.quotation?.totalCost || 0;
            const repairPaymentSettled = Boolean(
              a.bookingId?.repairPaymentCollected || a.repairPaymentCollected
              || a.bookingId?.balanceCollected || a.balanceCollected
            );
            const needsRepairPay = !repairPaymentSettled && qTotal > 0;
            if (needsRepairPay) {
              return `<button type="button" class="btn btn-warning" onclick="collectRepairPayment('${bId}',${qTotal});"><i class="bi bi-cash me-2"></i>Collect Final Payment (₱${qTotal.toLocaleString()})</button>`;
            }
            return `<button type="button" class="btn btn-success" onclick="completeRepair('${bId}');"><i class="bi bi-camera me-2"></i>Proof of Completion</button>`;
          }
          if (bs === 'inspection_completed') {
            return `<button type="button" class="btn btn-success" onclick="showPostInspectionDecision('${bId}',${a.bookingId?.quotation?.totalCost || 0});"><i class="bi bi-clipboard-check me-2"></i>Decide Next Step</button>`;
          }
          if (bs === 'repair_declined') {
            const hasFee = (a.bookingId?.initialCost || 0) > 0;
            if (hasFee && !a.balanceCollected) {
              return `<button type="button" class="btn btn-warning" onclick="openInspectionPaymentModal('${bId}',window._detailAssignment,'${esc(a.bookingId?.inspection?.findings || '')}','${esc(a.bookingId?.diagnosis?.findings || '')}',()=>refreshOpenAssignmentDetail('inspection'));"><i class="bi bi-cash me-2"></i>Collect Inspection Fee</button>`;
            }
            return `<span class="badge bg-danger" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-x-circle me-1"></i>Repair Declined</span>`;
          }
          if (['repair_completed', 'under_warranty'].includes(bs)) {
            return `<span class="badge bg-success" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-check-circle me-1"></i>${bs === 'under_warranty' ? 'Under Warranty' : 'Repair Completed'}</span>`;
          }
          return '';
        }

        // Standard non-repair flow
        if (['accepted', 'en_route', 'on_site', 'in_progress'].includes(a.status)) {
          const next = { accepted: 'en_route', en_route: 'on_site', on_site: 'in_progress', in_progress: 'completed' };
          const labels = { en_route: 'En Route', on_site: 'Arrived', in_progress: 'Start Work', completed: 'Complete' };
          const icons = { en_route: 'bi-sign-turn-right', on_site: 'bi-geo-alt', in_progress: 'bi-tools', completed: 'bi-check-circle' };
          const canCancel = ['accepted', 'en_route', 'on_site'].includes(a.status);
          const isCompleteStep = a.status === 'in_progress';
          const needsPayment = ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && !a.balanceCollected && (a.balanceAmount || 0) > 0;
          const nextAction = next[a.status];
          const isEnRouteStep = nextAction === 'en_route';
          const enRouteLocked = isEnRouteStep && !canEnRoute(a);
          const enRouteLockLabel = enRouteLocked ? enRouteAvailableLabel(a) : '';
          const completeAction = isCompleteStep && needsPayment
            ? `openCollectPaymentModal('${a._id}',window._detailAssignment,true);`
            : isCompleteStep
              ? `openProofModal('${a._id}','${esc(a.customerName)}','${esc(a.serviceName)}',${a.estimatedFee || 0});`
              : `transitionStatus('${a._id}','${next[a.status]}',this);`;
          let btnLabel = labels[next[a.status]];
          let btnIcon = icons[next[a.status]];
          let btnAction = completeAction;
          let btnClass = isCompleteStep && needsPayment ? 'btn-warning' : isCompleteStep ? 'btn-success' : 'btn-primary';
          if (a.status === 'accepted') {
            const kitReady = ['confirmed', 'in_progress'].includes(window._dailyKitStatus);
            if (kitReady) {
              btnLabel = 'En Route';
              btnIcon = 'bi-sign-turn-right';
              btnAction = `transitionStatus('${a._id}','en_route',this);`;
              btnClass = 'btn-success';
            } else {
              btnLabel = 'Open Daily Preparation';
              btnIcon = 'bi-briefcase';
              btnAction = `openDailyKitModal();`;
              btnClass = 'btn-primary';
            }
          }
          let actionBtns = `
          ${canCancel ? `<button class="btn btn-outline-danger" onclick="openModalAfterClose(null,'assignDetailModal',()=>openCancelModal('${a._id}','${esc(a.customerName)}','${esc(a.serviceName)}'));"><i class="bi bi-x-circle me-2"></i>Cancel</button>` : ''}
          ${a.status === 'on_site' ? `<button type="button" class="btn btn-warning text-dark" onclick="openCustomerNotAvailable('${a._id}',this);"><i class="bi bi-person-x me-2"></i>Customer Not Available</button>` : ''}
          ${a.status === 'waiting_for_customer' ? `<button type="button" class="btn btn-outline-warning" onclick="openCustomerNotAvailable('${a._id}',this,'resume');"><i class="bi bi-clock-history me-2"></i>Waiting Timer</button>` : ''}`;
          if (a.status === 'en_route') {
            actionBtns += `<button class="btn btn-outline-primary" onclick="openRouteMapModal();event.stopPropagation();"><i class="bi bi-map me-1"></i>View Map</button>`;
          }
          actionBtns += enRouteLocked
              ? `<span class="d-inline-block" title="Available ${enRouteLockLabel}"><button class="btn btn-secondary" disabled style="cursor:not-allowed;opacity:0.65;min-width:140px;"><i class="bi bi-lock me-2"></i>En Route<br><small style="font-size:0.7rem;font-weight:400;">${enRouteLockLabel}</small></button></span>`
              : `<button type="button" class="btn ${btnClass}" onclick="${btnAction}"><i class="${btnIcon} me-2"></i>${btnLabel}</button>`;
          return actionBtns;
        }
        return '';
      }

      if (pageId === 'inspection') {
        if (['inspection_scheduled', 'confirmed', 'on-the-way', 'arrived'].includes(bs) && !a.bookingId?.inspection?.completedAt) {
          return `<button type="button" style="background:linear-gradient(135deg,#2563eb,#3b82f6);color:#fff;border:none;border-radius:var(--mw-radius-xs);font-weight:600;font-size:0.78rem;padding:6px 14px;box-shadow:0 2px 6px rgba(37,99,235,0.25);" onclick="openInspectionModal('${bId}','${esc(a.customerName)}','${esc(a.serviceName)}');"><i class="bi bi-clipboard-check me-2"></i>Inspect & Quote</button>`;
        }
        if (bs === 'inspection_completed') {
          return `<span class="badge bg-info text-dark" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-check-circle me-1"></i>Inspection Complete</span>`;
        }
        return '';
      }

      if (pageId === 'quotation') {
        if (bs === 'inspection_completed') {
          return `<span class="badge bg-info text-dark" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-check-circle me-1"></i>Quotation Ready</span>`;
        }
        return '';
      }

      if (pageId === 'scheduling') {
        const schedStatus = a.bookingId?.schedulingRequest?.status || 'pending';
        if (schedStatus === 'pending') {
          return `<span class="badge bg-warning text-dark" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-clock-history me-1"></i>Waiting for Admin to Confirm Schedule</span>`;
        }
        if (schedStatus === 'confirmed') {
          return `<span class="badge bg-success" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-check-circle me-1"></i>Schedule Confirmed</span>`;
        }
        return '';
      }

      if (pageId === 'invoice') {
        const needsPay = ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && !a.balanceCollected && (a.balanceAmount || 0) > 0;
        if (needsPay) {
          return `<button type="button" class="btn btn-warning" onclick="openCollectPaymentModal('${a._id}',window._detailAssignment,true);"><i class="bi bi-cash me-2"></i>Collect ₱${Number(a.balanceAmount).toLocaleString()}</button>`;
        }
        return `<span class="badge bg-success" style="font-size:0.78rem;padding:8px 16px;"><i class="bi bi-check-circle me-1"></i>Invoice Complete</span>`;
      }

      return '';
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // WIZARD PAGE RENDERERS
    // ═══════════════════════════════════════════════════════════════════════════

    function renderMixedCorePage(a) {
      const escHtml = value => value == null ? '' : String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
      const booking = a.bookingId || {};
      const coreItems = (booking.services || []).filter(item => item.type === 'core');
      const visitStarted = ['in_progress', 'completed'].includes(a.status);
      if (!coreItems.length) return '<div class="alert alert-light">No Core services in this assignment.</div>';

      const PENDING_STATES = ['pending', 'awaiting_assignment', 'assigned', 'accepted', 'scheduled', 'en_route', 'arrived'];
      const pendingItems = coreItems.filter(item => PENDING_STATES.includes(String(item.status || 'pending')));
      const inProgressItems = coreItems.filter(item => String(item.status) === 'in_progress');
      const completedItems = coreItems.filter(item => String(item.status) === 'completed');
      const allCompleted = completedItems.length === coreItems.length;

      const canStart = visitStarted && pendingItems.length > 0;
      const canCompleteAll = visitStarted && inProgressItems.length > 0 && pendingItems.length === 0;

      const totalAmount = coreItems.reduce((sum, item) => sum + Number(item.totalPrice || ((item.unitPrice || 0) * (item.quantity || 1)) || 0), 0);
      const progressPct = Math.round((completedItems.length / coreItems.length) * 100);

      function statusPill(status) {
        const s = String(status || 'pending').replace(/_/g, ' ');
        if (status === 'completed') return `<span class="badge bg-success" style="font-size:.6rem;padding:4px 10px;border-radius:6px;text-transform:capitalize;font-weight:700;">${escHtml(s)}</span>`;
        if (status === 'in_progress') return `<span class="badge bg-primary" style="font-size:.6rem;padding:4px 10px;border-radius:6px;text-transform:capitalize;font-weight:700;">${escHtml(s)}</span>`;
        return `<span class="badge bg-secondary" style="font-size:.6rem;padding:4px 10px;border-radius:6px;text-transform:capitalize;font-weight:700;">${escHtml(s)}</span>`;
      }

      return `<div class="ent-panel">
        <div class="trk-card" style="margin-bottom:16px;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;">
          <div class="trk-card-header" style="background:linear-gradient(135deg,#1e3a5f 0%,#2563eb 100%);padding:16px 20px;border:none;">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
              <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="bi bi-gear-wide-connected" style="font-size:1.1rem;color:#fff;"></i></div>
                <div>
                  <h6 style="margin:0;color:#fff;font-size:.85rem;font-weight:700;letter-spacing:-0.01em;">Core Service Work</h6>
                  <div style="font-size:.65rem;color:rgba(255,255,255,0.7);margin-top:2px;">${coreItems.length} item${coreItems.length > 1 ? 's' : ''} · ₱${totalAmount.toLocaleString()}</div>
                </div>
              </div>
              <div style="text-align:right;">
                <div style="font-size:1.1rem;font-weight:800;color:#fff;line-height:1;">${progressPct}%</div>
                <div style="font-size:.55rem;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:0.05em;margin-top:2px;">Complete</div>
              </div>
            </div>
            <div style="margin-top:12px;height:4px;background:rgba(255,255,255,0.15);border-radius:2px;overflow:hidden;"><div style="height:100%;width:${progressPct}%;background:#10b981;border-radius:2px;transition:width 0.4s ease;"></div></div>
          </div>
          <div class="trk-card-body" style="padding:16px 20px;">
            ${!visitStarted && !allCompleted ? `<div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:#fef3c7;border:1px solid #fde68a;border-radius:10px;margin-bottom:14px;font-size:.72rem;color:#92400e;"><i class="bi bi-info-circle-fill" style="font-size:.85rem;flex-shrink:0;"></i><span>Core work becomes available after the shared <strong>Start Work</strong> step.</span></div>` : ''}

            ${canStart ? `<button type="button" class="btn btn-primary w-100 mb-3" style="font-weight:700;padding:13px;border-radius:10px;font-size:.8rem;letter-spacing:0.01em;box-shadow:0 2px 8px rgba(37,99,235,0.25);" onclick="startAllCoreWork('${booking._id}', this)"><i class="bi bi-play-fill me-2"></i>Start Core Work${pendingItems.length > 1 ? ' · ' + pendingItems.length + ' items' : ''}</button>` : ''}

            ${canCompleteAll ? `<button type="button" class="btn btn-success w-100 mb-3" style="font-weight:700;padding:13px;border-radius:10px;font-size:.8rem;letter-spacing:0.01em;box-shadow:0 2px 8px rgba(22,163,74,0.25);" onclick="completeAllCoreWork('${booking._id}', this)"><i class="bi bi-check-circle me-2"></i>Complete All Core Services${inProgressItems.length > 1 ? ' · ' + inProgressItems.length + ' items' : ''}</button>` : ''}

            ${coreItems.map((item, index) => {
              const status = String(item.status || 'pending');
              const completed = status === 'completed';
              const inProgress = status === 'in_progress';
              const price = Number(item.totalPrice || ((item.unitPrice || 0) * (item.quantity || 1)) || 0);
              const details = [item.brand, item.applianceTypeName || item.airconTypeName, item.hpDescription || (item.hp ? item.hp + ' HP' : '')].filter(Boolean).join(' · ');
              const cardBorder = completed ? '#86efac' : inProgress ? '#93c5fd' : '#e2e8f0';
              const cardBg = completed ? '#f0fdf4' : inProgress ? '#eff6ff' : '#ffffff';
              const numBg = completed ? '#22c55e' : inProgress ? '#3b82f6' : '#cbd5e1';
              return `<div style="border:1px solid ${cardBorder};border-radius:12px;padding:14px 16px;margin-bottom:${index < coreItems.length - 1 ? '10px' : '0'};background:${cardBg};transition:all 0.2s ease;">
                <div style="display:flex;align-items:flex-start;gap:12px;">
                  <div style="width:28px;height:28px;border-radius:8px;background:${numBg};color:#fff;display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:800;flex-shrink:0;">${index + 1}</div>
                  <div style="flex:1;min-width:0;">
                    <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;">
                      <div style="font-weight:700;color:#0f172a;font-size:.78rem;">${escHtml(item.name || 'Core Service')}</div>
                      ${statusPill(status)}
                    </div>
                    ${details ? `<div style="font-size:.68rem;color:#64748b;margin-top:5px;">${escHtml(details)}</div>` : ''}
                    <div style="display:flex;gap:16px;margin-top:8px;font-size:.68rem;color:#475569;">
                      <div style="display:flex;align-items:center;gap:4px;"><i class="bi bi-box" style="font-size:.6rem;opacity:0.6;"></i> Qty: ${Number(item.quantity) || 1}</div>
                      <div style="display:flex;align-items:center;gap:4px;"><i class="bi bi-cash" style="font-size:.6rem;opacity:0.6;"></i> ₱${price.toLocaleString()}</div>
                    </div>
                  </div>
                </div>
                ${completed ? `<div style="display:flex;align-items:center;gap:6px;margin-top:10px;padding-top:10px;border-top:1px solid #bbf7d0;font-size:.65rem;color:#15803d;font-weight:600;"><i class="bi bi-check-circle-fill"></i> Service completed</div>` : ''}
                ${inProgress ? `<div style="display:flex;align-items:center;gap:6px;margin-top:10px;padding-top:10px;border-top:1px solid #93c5fd;font-size:.65rem;color:#1d4ed8;font-weight:600;"><i class="bi bi-arrow-repeat"></i> Work in progress</div>` : ''}
              </div>`;
            }).join('')}
          </div>
        </div>
      </div>`;
    }

    window.updateMixedCoreItemStatus = async function (bookingId, itemId, status, btn) {
      const isStarting = status === 'in_progress';
      const result = await Swal.fire({
        icon: 'question', title: isStarting ? 'Start Core Work?' : 'Complete Core Service?',
        text: isStarting
          ? 'Only this Core item will move to In Progress. The Repair workflow will not change.'
          : 'This completes only the selected Core item. The Repair service will remain active.',
        showCancelButton: true,
        confirmButtonText: isStarting ? 'Start Core Work' : 'Complete Core Service',
        confirmButtonColor: isStarting ? '#2563eb' : '#16a34a'
      });
      if (!result.isConfirmed) return;
      if (btn) btn.disabled = true;
      try {
        const response = await fetch(`/api/technician/appointments/${bookingId}/service-items/${itemId}/status`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
          body: JSON.stringify({ status, reason: isStarting ? 'Core work started by technician' : 'Core service completed by technician' })
        });
        const data = await response.json();
        if (!response.ok && data.code === 'BOOKING_BALANCE_REQUIRED' && window._detailAssignment) {
          if (btn) btn.disabled = false;
          openCollectPaymentModal(
            window._detailAssignment._id,
            window._detailAssignment,
            false,
            () => updateMixedCoreItemStatus(bookingId, itemId, status, btn)
          );
          return;
        }
        if (!response.ok) throw new Error(data.error || 'Unable to update Core service.');
        await Swal.fire({
          icon: 'success',
          title: data.allServicesCompleted ? (data.hasDeclinedRepair ? 'Booking Finished' : 'Booking Completed') : isStarting ? 'Core Work Started' : 'Core Service Completed',
          text: data.allServicesCompleted
            ? data.hasDeclinedRepair
              ? 'All Core work is complete and the declined Repair service is closed.'
              : 'Every Core and Repair service in this booking is complete.'
            : isStarting
              ? 'This Core item is now In Progress. The Repair service remains unchanged.'
              : 'Only this Core item was completed. The Repair service remains in its own workflow.',
          timer: 1800,
          showConfirmButton: false
        });
        await refreshOpenAssignmentDetail(data.allServicesCompleted ? 'completion' : 'core-service');
      } catch (error) {
        if (btn) btn.disabled = false;
        Swal.fire('Unable to Complete', error.message, 'error');
      }
    };

    window.startAllCoreWork = async function (bookingId, btn) {
      const a = window._detailAssignment;
      const coreItems = ((a?.bookingId?.services) || []).filter(item => item.type === 'core');
      const pendingCount = coreItems
        .filter(item => ['pending', 'awaiting_assignment', 'assigned', 'accepted', 'scheduled', 'en_route', 'arrived'].includes(String(item.status || 'pending')))
        .length;
      if (!pendingCount) return;
      const result = await Swal.fire({
        icon: 'question',
        title: `Start Core Work?`,
        text: `${pendingCount} Core service item${pendingCount > 1 ? 's' : ''} will move to In Progress at once.`,
        showCancelButton: true,
        confirmButtonText: 'Start Core Work',
        confirmButtonColor: '#2563eb'
      });
      if (!result.isConfirmed) return;
      if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Starting...'; }
      try {
        const response = await fetch(`/api/technician/appointments/${bookingId}/core-items/batch`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ status: 'in_progress', reason: 'Core work started by technician' })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Unable to start Core work.');
        await refreshOpenAssignmentDetail('core-service');
      } catch (error) {
        if (btn) { btn.disabled = false; btn.innerHTML = `<i class="bi bi-play-fill me-2"></i>Start Core Work${pendingCount > 1 ? ' · ' + pendingCount + ' items' : ''}`; }
        Swal.fire('Unable to Start', error.message, 'error');
      }
    };

    window.completeAllCoreWork = async function (bookingId, btn) {
      const a = window._detailAssignment;
      const coreItems = ((a?.bookingId?.services) || []).filter(item => item.type === 'core');
      const inProgressCount = coreItems.filter(item => String(item.status) === 'in_progress').length;
      if (!inProgressCount) return;
      const result = await Swal.fire({
        icon: 'question',
        title: `Complete All Core Services?`,
        text: `${inProgressCount} in-progress Core service item${inProgressCount > 1 ? 's' : ''} will be marked as completed.`,
        showCancelButton: true,
        confirmButtonText: 'Complete All',
        confirmButtonColor: '#16a34a'
      });
      if (!result.isConfirmed) return;
      if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Completing...'; }
      try {
        const response = await fetch(`/api/technician/appointments/${bookingId}/core-items/batch`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ status: 'completed', reason: 'Core service completed by technician' })
        });
        const data = await response.json();
        if (!response.ok && data.code === 'BOOKING_BALANCE_REQUIRED' && window._detailAssignment) {
          if (btn) { btn.disabled = false; btn.innerHTML = `<i class="bi bi-check-circle me-2"></i>Complete All Core Services${inProgressCount > 1 ? ' · ' + inProgressCount + ' items' : ''}`; }
          openCollectPaymentModal(
            window._detailAssignment._id,
            window._detailAssignment,
            false,
            () => completeAllCoreWork(bookingId, btn)
          );
          return;
        }
        if (!response.ok) throw new Error(data.error || 'Unable to complete Core services.');
        await Swal.fire({
          icon: 'success',
          title: data.allServicesCompleted ? (data.hasDeclinedRepair ? 'Booking Finished' : 'Booking Completed') : 'Core Services Completed',
          text: data.allServicesCompleted
            ? data.hasDeclinedRepair
              ? 'All Core work is complete and the declined Repair service is closed.'
              : 'Every Core and Repair service in this booking is complete.'
            : `${inProgressCount} Core service${inProgressCount > 1 ? 's' : ''} completed.`,
          timer: 1800,
          showConfirmButton: false
        });
        await refreshOpenAssignmentDetail(data.allServicesCompleted ? 'completion' : 'core-service');
      } catch (error) {
        if (btn) { btn.disabled = false; btn.innerHTML = `<i class="bi bi-check-circle me-2"></i>Complete All Core Services${inProgressCount > 1 ? ' · ' + inProgressCount + ' items' : ''}`; }
        Swal.fire('Unable to Complete', error.message, 'error');
      }
    };

    window.startMixedRepairInspection = async function (bookingId, itemIdsCsv, btn) {
      const itemIds = String(itemIdsCsv || '').split(',').map(value => value.trim()).filter(Boolean);
      if (!itemIds.length) return;
      const result = await Swal.fire({
        icon: 'question',
        title: 'Start Repair Inspection?',
        text: 'Only the Repair service will enter Inspection In Progress. Core service statuses will not change.',
        showCancelButton: true,
        confirmButtonText: 'Start Inspection',
        confirmButtonColor: '#2563eb'
      });
      if (!result.isConfirmed) return;
      if (btn) btn.disabled = true;
      try {
        for (const itemId of itemIds) {
          const response = await fetch(`/api/technician/appointments/${bookingId}/service-items/${itemId}/status`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ status: 'inspection_in_progress', reason: 'Repair inspection started by technician' })
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Unable to start Repair inspection.');
        }
        await refreshOpenAssignmentDetail('repair-service');
        const assignment = window._detailAssignment || {};
        const repairServiceName = mixedRepairItems(assignment)
          .map(item => item.name || item.serviceName)
          .filter(Boolean)
          .join(', ') || assignment.serviceName || 'Repair Service';
        openInspectionModal(
          bookingId,
          assignment.customerName || 'Customer',
          repairServiceName,
          assignment
        );
      } catch (error) {
        if (btn) btn.disabled = false;
        await refreshOpenAssignmentDetail('repair-service');
        Swal.fire('Unable to Start Inspection', error.message, 'error');
      }
    };

    function renderMixedRepairPage(a) {
      const escHtml = value => value == null ? '' : String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
      const booking = a.bookingId || {};
      const repairItems = mixedRepairItems(a);
      const repairCompleted = repairItems.length > 0 && repairItems.every(item => item.status === 'completed');
      const repairDeclined = repairItems.length > 0
        && repairItems.every(item => ['repair_declined', 'cancelled'].includes(item.status));
      const hasInspection = Boolean(booking.inspection?.completedAt);
      const hasQuotation = Boolean(booking.quotation?.createdAt || booking.quotation?.totalCost);
      const bookingStatus = booking.status || a.bookingStatus;
      const inspectionActive = repairItems.some(item => item.status === 'inspection_in_progress');
      const decisionMade = ['approved', 'declined'].includes(booking.approval?.status)
        || ['repair_approved', 'waiting_parts', 'parts_reserved', 'ready_for_repair', 'repair_scheduled', 'repair_in_progress', 'repair_completed', 'repair_declined', 'under_warranty'].includes(bookingStatus);
      const statusLabel = repairCompleted
        ? 'Repair completed'
        : repairDeclined
          ? 'Repair declined'
        : hasQuotation
          ? decisionMade ? 'Phase 2 - Repair' : 'Awaiting repair decision'
          : hasInspection
            ? 'Inspection completed'
            : inspectionActive ? 'Inspection in progress' : 'Inspection required';

      let workflowHtml = '';
      if (repairCompleted) {
        workflowHtml = `
          <div class="alert alert-success" style="border-radius:12px;font-size:.8rem;">
            <i class="bi bi-check-circle-fill me-2"></i>
            Repair work is complete. This booking remains active until every Core service is also completed.
          </div>
          ${renderRepairPage(a)}`;
      } else if (repairDeclined) {
        workflowHtml = `<div class="alert alert-secondary" style="border-radius:12px;font-size:.8rem;"><i class="bi bi-x-circle me-2"></i>The Repair service was declined after inspection. Continue any unfinished Core service from the Core Service tab.</div>`;
      } else if (!hasInspection) {
        workflowHtml = `<div class="fw-bold mb-2" style="font-size:.78rem;color:#1e3a8a;">PHASE 1 - INSPECTION &amp; QUOTE</div>${renderAiAssistantPage(a)}${renderInspectionPage(a)}`;
      } else if (!decisionMade) {
        workflowHtml = `
          <div class="fw-bold mb-2" style="font-size:.78rem;color:#1e3a8a;">PHASE 1 - INSPECTION &amp; QUOTE</div>
          ${renderInspectionPage(a)}${renderQuotationPage(a)}
          <div class="alert alert-light" style="border:1px solid #dbeafe;border-radius:12px;font-size:.76rem;"><i class="bi bi-lock me-2"></i>Phase 2 remains locked until the Repair decision is recorded.</div>`;
      } else {
        workflowHtml = `
          <div class="fw-bold mb-2" style="font-size:.78rem;color:#64748b;">PHASE 1 - COMPLETED</div>
          ${renderInspectionPage(a)}${renderQuotationPage(a)}
          <div class="fw-bold my-3" style="font-size:.78rem;color:#166534;">PHASE 2 - REPAIR</div>
          ${hasQuotation ? renderRepairPage(a) : ''}`;
      }

      return `<div class="ent-panel">
        <div class="trk-card" style="margin-bottom:16px;">
          <div class="trk-card-header"><h6 class="trk-card-title"><i class="bi bi-tools"></i> Repair Service Work</h6></div>
          <div class="trk-card-body">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;">
              <div style="font-size:.75rem;color:#64748b;">Inspection, diagnosis, quotation, parts, and repair completion stay inside this workstream.</div>
              <span class="badge ${repairCompleted ? 'bg-success' : 'bg-warning text-dark'}" style="white-space:nowrap;">${escHtml(statusLabel)}</span>
            </div>
            ${repairItems.map((item, index) => {
              const status = String(item.status || 'inspection_in_progress');
              const completed = status === 'completed';
              const details = [item.brand, item.model, item.applianceTypeName || item.airconTypeName, item.problemDescription || item.repairIssue].filter(Boolean).join(' · ');
              return `<div style="border:1px solid ${completed ? '#bbf7d0' : '#fde68a'};border-radius:12px;padding:14px;margin-bottom:${index < repairItems.length - 1 ? '10px' : '0'};background:${completed ? '#f0fdf4' : '#fffbeb'};">
                <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;">
                  <div><div style="font-size:.64rem;font-weight:800;color:#64748b;">REPAIR SERVICE ${index + 1} OF ${repairItems.length}</div><div style="font-weight:750;color:#0f172a;">${escHtml(item.name || 'Repair Service')}</div></div>
                  <span class="badge ${completed ? 'bg-success' : 'bg-warning text-dark'}" style="text-transform:capitalize;">${escHtml(status.replace(/_/g, ' '))}</span>
                </div>
                ${details ? `<div style="font-size:.72rem;color:#64748b;margin-top:7px;line-height:1.5;">${escHtml(details)}</div>` : ''}
              </div>`;
            }).join('')}
          </div>
        </div>
        ${workflowHtml}
      </div>`;
    }

    function renderCustomerDetails(a, date, bookingRef, hasCoords, custLat, custLng, activityHtml) {
      const _e = (s) => s != null ? String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;') : '';
      const isRepair = isRepairAssignment(a);
      const b = a.bookingId || {};
      const serviceItems = Array.isArray(b.services) ? b.services : [];
      const hasCoreItems = serviceItems.some(item => item.type === 'core');
      const hasRepairItems = serviceItems.some(item => item.type === 'repair');
      const isMixed = a.serviceType === 'mixed' || b.serviceType === 'mixed' || (hasCoreItems && hasRepairItems);
      const statusText = statusLabels[a.status] || a.status;
      const serviceName = isMixed ? `${serviceItems.length} Services` : (a.serviceName || 'Service');
      const typeText = isMixed ? 'MIXED SERVICE - CORE + REPAIR' : ((a.serviceType || 'Core') + ' service').toUpperCase();
      const bookingNumber = bookingRef || 'N/A';
      const address = a.customerLocation?.address || a.location?.address || b.customerLocation?.address || b.location?.address || b.address || a.address || 'No address provided';
      const dateTime = (date || 'TBD') + (a.startTime ? ' at ' + a.startTime : '');
      const customer = a.customerName || 'Customer';
      const phone = a.customerPhone || 'N/A';
      const email = a.customerEmail || 'N/A';
      const priority = (a.priority || 'normal').toUpperCase();

      const qTotal = b.quotation?.totalCost || a.quotation?.totalCost || 0;
      const inspFee = b.inspectionFeeTotalCollected || b.initialCost || a.initialCost || 0;
      // Mixed bookings already carry the complete Core + Repair visit price.
      // A repair-only booking continues to use inspection + quotation.
      const total = isMixed
        ? Number(b.totalPrice ?? a.totalPrice ?? a.estimatedFee ?? 0)
        : isRepair
          ? (Number(inspFee) + Number(qTotal))
          : Number(qTotal || b.totalPrice || a.totalPrice || a.estimatedFee || 0);
      const dp = b.downpaymentAmount || a.downpaymentAmount || 0;
      const bal = b.balanceAmount ?? a.balanceAmount ?? 0;
      const financialStatus = b.paymentStatus || a.paymentStatus || 'pending';
      const payMethod = (a.paymentMethod || '—').replace(/_/g,' ').toUpperCase();

      const phoneLink = phone !== 'N/A' ? String(phone).replace(/[^+\d]/g, '') : '';
      const hasEmail = email !== 'N/A' && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(email));
      const destination = hasCoords ? `${Number(custLat)},${Number(custLng)}` : address;
      const mapsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(destination)}`;
      const settledPayment = ['paid', 'verified', 'remitted', 'payment_collected'].includes(String(financialStatus));
      let h = '';
      let sideHtml = '';

      const overviewHtml = `
        <section class="booking-detail-overview">
          <div class="booking-detail-overview-main">
            <div class="booking-detail-overview-icon"><i class="bi bi-${isMixed ? 'layers' : isRepair ? 'wrench' : 'gear-wide-connected'}"></i></div>
            <div><div class="booking-detail-eyebrow">Assigned booking</div><h4>${_e(serviceName)}</h4><p>Booking #${_e(bookingNumber)} &middot; ${_e(typeText)}</p></div>
          </div>
          <div class="booking-detail-total"><span>Service total</span><strong>₱${Number(total).toLocaleString('en-PH', {minimumFractionDigits:2, maximumFractionDigits:2})}</strong></div>
        </section>
        <div class="booking-detail-summary">
          <div class="booking-summary-cell"><span>Schedule</span><strong>${_e(dateTime)}</strong></div>
          <div class="booking-summary-cell"><span>Service type</span><strong>${_e(isMixed ? 'Mixed Service' : isRepair ? 'Repair Service' : 'Core Service')}</strong></div>
          <div class="booking-summary-cell"><span>Customer</span><strong>${_e(customer)}</strong></div>
          <div class="booking-summary-cell"><span>Current status</span><strong>${_e(statusText)}</strong></div>
        </div>`;

      h += `<section class="booking-detail-card"><div class="booking-detail-card-head"><h6 class="booking-detail-card-title"><i class="bi bi-geo-alt-fill"></i>Customer &amp; Service Location</h6></div><div class="booking-detail-card-body"><div class="booking-info-list">`;
      h += `<div class="booking-info-row"><div class="booking-info-icon"><i class="bi bi-person"></i></div><div><div class="booking-info-label">Customer</div><div class="booking-info-value">${_e(customer)}${phone !== 'N/A' ? ' &middot; ' + _e(phone) : ''}</div></div></div>`;
      h += `<div class="booking-info-row"><div class="booking-info-icon"><i class="bi bi-envelope"></i></div><div><div class="booking-info-label">Email</div><div class="booking-info-value">${_e(email)}</div></div></div>`;
      h += `<div class="booking-info-row"><div class="booking-info-icon"><i class="bi bi-pin-map"></i></div><div><div class="booking-info-label">Service address</div><div class="booking-info-value">${_e(address)}</div></div></div>`;
      h += `<div class="booking-info-row"><div class="booking-info-icon"><i class="bi bi-calendar3"></i></div><div><div class="booking-info-label">Appointment schedule</div><div class="booking-info-value">${_e(dateTime)}</div></div></div>`;
      h += `<div class="booking-info-row"><div class="booking-info-icon"><i class="bi bi-award"></i></div><div><div class="booking-info-label">Priority</div><div class="booking-info-value">${_e(priority)}</div></div></div>`;
      h += `</div><div class="booking-contact-actions">`;
      if (phoneLink) {
        h += `<a class="booking-contact-action" href="tel:${_e(phoneLink)}"><i class="bi bi-telephone"></i>Call</a>`;
        h += `<a class="booking-contact-action" href="sms:${_e(phoneLink)}"><i class="bi bi-chat-dots"></i>Text</a>`;
      }
      if (hasEmail) h += `<a class="booking-contact-action" href="mailto:${_e(email)}"><i class="bi bi-envelope"></i>Email</a>`;
      h += `<a class="booking-contact-action" href="${_e(mapsHref)}" target="_blank" rel="noopener noreferrer"><i class="bi bi-sign-turn-right"></i>Directions</a>`;
      h += `</div></div></section>`;

      const displayServices = serviceItems.length ? serviceItems : [{
        name: serviceName,
        type: isRepair ? 'repair' : 'core',
        quantity: 1,
        totalPrice: total,
        status: a.status
      }];
      h += `<section class="booking-detail-card"><div class="booking-detail-card-head"><h6 class="booking-detail-card-title"><i class="bi bi-list-check"></i>Booked Services</h6><span class="text-muted" style="font-size:.64rem;font-weight:700;">${displayServices.length} service${displayServices.length === 1 ? '' : 's'}</span></div><div class="booking-detail-card-body">`;
      displayServices.forEach(item => {
        const itemName = item.name || item.serviceName || (item.type === 'repair' ? 'Repair Service' : 'Core Service');
        const details = [
          item.type === 'repair' ? 'Repair' : 'Core',
          item.brand,
          item.applianceTypeName || item.airconTypeName,
          item.hpDescription || (item.hp ? `${item.hp} HP` : ''),
          `Qty ${Number(item.quantity) || 1}`,
          String(item.status || 'pending').replace(/_/g, ' ')
        ].filter(Boolean).map(_e).join(' &middot; ');
        const itemTotal = Number(item.totalPrice || ((item.unitPrice || 0) * (item.quantity || 1)) || 0);
        h += `<div class="booking-service-row"><div class="booking-service-icon"><i class="bi ${item.type === 'repair' ? 'bi-wrench-adjustable' : 'bi-gear-wide-connected'}"></i></div><div><div class="booking-service-name">${_e(itemName)}</div><div class="booking-service-meta">${details}</div></div><div class="booking-service-amount">₱${itemTotal.toLocaleString()}</div></div>`;
      });
      h += `</div></section>`;

      sideHtml += `<section class="booking-detail-card"><div class="booking-detail-card-head"><h6 class="booking-detail-card-title"><i class="bi bi-clipboard2-check"></i>Service Snapshot</h6></div><div class="booking-detail-card-body"><div class="booking-info-list">`;
      sideHtml += `<div class="booking-info-row"><div class="booking-info-icon"><i class="bi bi-hash"></i></div><div><div class="booking-info-label">Booking reference</div><div class="booking-info-value">${_e(bookingNumber)}</div></div></div>`;
      sideHtml += `<div class="booking-info-row"><div class="booking-info-icon"><i class="bi bi-tools"></i></div><div><div class="booking-info-label">Assigned service</div><div class="booking-info-value">${_e(serviceName)}</div></div></div>`;
      sideHtml += `<div class="booking-info-row"><div class="booking-info-icon"><i class="bi bi-diagram-3"></i></div><div><div class="booking-info-label">Workflow</div><div class="booking-info-value">${_e(typeText)}</div></div></div>`;
      sideHtml += `</div></div></section>`;

      if (a.paymentMethod || total > 0) {
        const _payments = a.payments || [];
        const _paymentsTotal = _payments.reduce((s, p) => s + Number(p.amount || 0), 0);
        const paid = _paymentsTotal > 0 ? _paymentsTotal : Number(b.amountPaid ?? a.amountPaid ?? Math.max(0, Number(total) - Number(bal)));
        const computedBal = Math.max(0, total - paid);
        const displayBal = _paymentsTotal > 0 ? computedBal : Number(bal);
        const isPaid = displayBal <= 0;
        const paymentLabel = isPaid ? 'paid' : String(financialStatus).replace(/_/g, ' ');
        sideHtml += `<section class="booking-detail-card"><div class="booking-detail-card-head"><h6 class="booking-detail-card-title"><i class="bi bi-receipt"></i>Payment Snapshot</h6><span class="booking-payment-status ${(isPaid || settledPayment) ? 'settled' : 'unsettled'}">${_e(paymentLabel)}</span></div><div class="booking-detail-card-body">`;
        sideHtml += `<div class="booking-money-row"><span>Payment method</span><strong>${_e(payMethod)}</strong></div>`;
        if (dp > 0) sideHtml += `<div class="booking-money-row"><span>Downpayment</span><strong>₱${Number(dp).toLocaleString()}</strong></div>`;
        sideHtml += `<div class="booking-money-row"><span>${isPaid ? 'Paid' : 'Paid so far'}</span><strong>₱${Number(paid).toLocaleString()}</strong></div>`;
        if (displayBal > 0 && !isPaid) sideHtml += `<div class="booking-money-row"><span>Balance due</span><strong>₱${Number(displayBal).toLocaleString()}</strong></div>`;
        sideHtml += `<div class="booking-money-row total"><span>Service total</span><strong>₱${Number(total).toLocaleString()}</strong></div></div></section>`;
      }

      if (isMixed) {
        const coreItems = serviceItems.filter(item => item.type === 'core');
        const repairItems = serviceItems.filter(item => item.type === 'repair');
        const allCoreCompleted = coreItems.length > 0 && coreItems.every(item => item.status === 'completed');
        const allRepairCompleted = repairItems.length > 0 && repairItems.every(item => item.status === 'completed');
        const allRepairDeclined = repairItems.length > 0 && repairItems.every(item => ['repair_declined', 'cancelled'].includes(item.status));
        const coreStatus = allCoreCompleted ? 'Completed'
          : coreItems.some(item => item.status === 'in_progress') ? 'In Progress'
            : isMixedWorkStarted(a) ? 'Ready' : 'Waiting for Start Work';
        const repairStatus = allRepairCompleted ? 'Completed'
          : allRepairDeclined ? 'Declined'
            : repairItems.some(item => ['repair_in_progress', 'payment_pending'].includes(item.status)) ? 'Repair In Progress'
              : repairItems.some(item => ['awaiting_customer_decision', 'repair_approved', 'ready_for_repair', 'repair_scheduled'].includes(item.status)) ? 'Decision / Scheduling'
                : repairItems.some(item => ['inspection_in_progress', 'inspection_completed', 'diagnosis_completed', 'parts_check', 'awaiting_quotation'].includes(item.status)) ? 'Inspection & Quote'
                  : isMixedWorkStarted(a) ? 'Inspection Required' : 'Waiting for Start Work';
        const overallStatus = a.status === 'completed' ? 'Completed' : isMixedWorkStarted(a) ? 'In Progress' : statusText;
        const componentRow = (label, status, tab, icon, color) => `
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #e2e8f0;">
            <div style="display:flex;align-items:center;gap:10px;min-width:0;"><span style="width:32px;height:32px;border-radius:9px;background:${color}18;color:${color};display:inline-flex;align-items:center;justify-content:center;"><i class="bi ${icon}"></i></span><div><div style="font-weight:750;color:#0f172a;font-size:.8rem;">${label}</div><div style="font-size:.7rem;color:#64748b;">${_e(status)}</div></div></div>
            ${isMixedWorkStarted(a) ? `<button type="button" class="btn btn-sm btn-outline-primary" onclick="switchDetailTab('${tab}')">Open</button>` : ''}
          </div>`;
        h += `<div class='trk-card' style='margin-bottom:16px;'>`;
        h += `<div class='trk-card-header'><h6 class='trk-card-title'><i class='bi bi-grid-1x2'></i> Service Work Command Center</h6></div>`;
        h += `<div class='trk-card-body'>`;
        h += componentRow('Core Service', coreStatus, 'core-service', 'bi-gear-wide-connected', '#2563eb');
        h += componentRow('Repair Service', repairStatus, 'repair-service', 'bi-tools', '#d97706');
        h += `<div style="display:flex;justify-content:space-between;align-items:center;padding-top:12px;font-size:.76rem;"><strong>Overall Booking</strong><span class="badge ${overallStatus === 'Completed' ? 'bg-success' : overallStatus === 'In Progress' ? 'bg-primary' : 'bg-secondary'}">${_e(overallStatus)}</span></div>`;
        if (!isMixedWorkStarted(a)) h += `<div class="alert alert-light py-2 px-3 mt-3 mb-0" style="font-size:.7rem;"><i class="bi bi-info-circle me-1"></i>Start Work activates the shared session. It does not start either service component.</div>`;
        h += `</div></div>`;
      }

      if (isRepair) {
        h += `<div class='trk-card' style='margin-bottom:16px;'>`;
        h += `<div class='trk-card-header'><h6 class='trk-card-title'><i class='bi bi-layers'></i> ${isMixed ? 'Services in this Assignment' : 'Unit & Repair Details'}</h6></div>`;
        h += `<div class='trk-card-body'>`;
        const unitItems = Array.isArray(b.services) && b.services.length ? b.services : null;
        if (unitItems) {
          unitItems.forEach((item, index) => {
            const itemType = item.type === 'repair' ? 'repair' : 'core';
            const uName = item.applianceTypeName || item.airconTypeName || item.name || 'N/A';
            const uBrand = item.brand || 'N/A';
            const uModel = item.model || 'N/A';
            const uProblem = item.problemDescription || item.repairIssue || 'N/A';
            h += `<div style='border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;margin-bottom:10px;background:#f8fafc;'>`;
            h += `<div style='display:flex;justify-content:flex-end;margin-bottom:4px;'><span class='badge ${itemType === 'repair' ? 'bg-warning text-dark' : 'bg-primary'}' style='font-size:.62rem;'>${itemType === 'repair' ? 'REPAIR' : 'CORE'}</span></div>`;
            h += `<div style='font-weight:700;font-size:0.78rem;color:#334155;margin-bottom:8px;'><i class='bi bi-box-seam me-1'></i>Item ${index + 1}: ${_e(item.name || (item.type || 'Service').toUpperCase())}${item.quantity > 1 ? ' · Qty ' + item.quantity : ''}</div>`;
            h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-cpu'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Unit</div><div class='trk-detail-value'>${_e(uName)}</div></div></div>`;
            h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-activity'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Status</div><div class='trk-detail-value' style='text-transform:capitalize;'>${_e(String(item.status || 'pending').replace(/_/g, ' '))}</div></div></div>`;
            h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-building'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Brand</div><div class='trk-detail-value'>${_e(uBrand)}</div></div></div>`;
            if (itemType === 'core') {
              const hpLabel = item.hpDescription || (item.hp ? `${item.hp} HP` : 'N/A');
              const durationLabel = Number(item.duration) > 0 ? `${Number(item.duration)} minutes` : 'N/A';
              const itemPrice = Number(item.totalPrice || ((item.unitPrice || 0) * (item.quantity || 1)) || 0);
              h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-speedometer2'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Capacity</div><div class='trk-detail-value'>${_e(hpLabel)}</div></div></div>`;
              h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-stack'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Quantity</div><div class='trk-detail-value'>${Number(item.quantity) || 1}</div></div></div>`;
              h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-clock'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Estimated Duration</div><div class='trk-detail-value'>${_e(durationLabel)}</div></div></div>`;
              h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-cash'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Service Total</div><div class='trk-detail-value'>₱${itemPrice.toLocaleString()}</div></div></div>`;
            } else {
            h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-upc'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Model</div><div class='trk-detail-value'>${_e(uModel)}</div></div></div>`;
            h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-exclamation-circle'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Problem</div><div class='trk-detail-value' style='font-size:0.8rem;'>${_e(uProblem)}</div></div></div>`;
              h += `<div style='font-size:.68rem;color:#7c3aed;background:#faf5ff;border-radius:7px;padding:7px 9px;margin-top:7px;'><i class='bi bi-robot me-1'></i>AI guidance and on-site inspection apply to this Repair item only.</div>`;
            }
            h += `</div>`;
          });
        } else {
          const unit = b.unitInfo?.unitType || a.unitType || 'N/A';
          const brand = b.unitInfo?.brand || a.brand || 'N/A';
          const model = b.unitInfo?.model || 'N/A';
          const problem = b.unitInfo?.problemDescription || a.issueDescription || 'N/A';
          h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-cpu'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Unit</div><div class='trk-detail-value'>${_e(unit)}</div></div></div>`;
          h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-building'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Brand</div><div class='trk-detail-value'>${_e(brand)}</div></div></div>`;
          h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-upc'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Model</div><div class='trk-detail-value'>${_e(model)}</div></div></div>`;
          h += `<div class='trk-detail-row'><div class='trk-detail-icon'><i class='bi bi-exclamation-circle'></i></div><div class='trk-detail-content'><div class='trk-detail-label'>Problem</div><div class='trk-detail-value' style='font-size:0.8rem;'>${_e(problem)}</div></div></div>`;
        }

        const diag = b.diagnosis || a.diagnosis;
        const insp = b.inspection || a.inspection;
        if (diag || insp) {
          const findings = (diag?.findings || insp?.findings) || '';
          const action = (diag?.recommendedAction || insp?.recommendedAction) || '';
          h += `<div class='trk-detail-subsection' style='margin-top:10px;'>`;
          h += `<div class='trk-detail-subhead'><i class='bi bi-clipboard2-pulse'></i> Diagnostic</div>`;
          if (findings) h += `<div class='trk-detail-subtext'><strong>Findings:</strong> ${_e(findings)}</div>`;
          if (action) h += `<div class='trk-detail-subtext'><strong>Recommended Action:</strong> ${_e(action)}</div>`;
          h += `</div>`;
        }
        if (qTotal > 0) {
          h += `<div class='trk-payment-summary' style='margin-top:10px;'>`;
          h += `<div class='trk-payment-line trk-payment-total'><span>Quotation Total</span><span>₱${Number(qTotal).toLocaleString()}</span></div>`;
          if (b.repairPaymentCollected || a.repairPaymentCollected) h += `<div class='trk-payment-line ok'><span>Payment Collected</span><span>✅ ₱${Number((b.repairPaymentAmount || a.repairPaymentAmount || 0)).toLocaleString()}</span></div>`;
          h += `</div>`;
        }
        h += `</div></div>`;
      }

      const equipmentItems = a.equipmentItems || [];
      if (equipmentItems.length) {
        h += `<div class='trk-card' style='margin-bottom:16px;'>`;
        h += `<div class='trk-card-header'><h6 class='trk-card-title'><i class='bi bi-box-seam'></i> Assigned Equipment</h6></div>`;
        h += `<div class='trk-card-body'>`;
        equipmentItems.forEach(eq => {
          h += `<div class='trk-detail-subsection' style='margin-bottom:8px;'>`;
          h += `<div class='trk-detail-subhead'><i class='bi bi-check-square'></i> ${_e(eq.equipmentName || 'Tool')}</div>`;
          h += `<div class='trk-detail-subtext'>Status: ${_e((eq.status || 'reserved').replace(/_/g,' '))}${eq.quantity > 1 ? ' · Qty ' + eq.quantity : ''}</div>`;
          h += `</div>`;
        });
        h += `</div></div>`;
      }

      const reservedParts = a.reservedParts || [];
      if (reservedParts.length) {
        h += `<div class='trk-card' style='margin-bottom:16px;'>`;
        h += `<div class='trk-card-header'><h6 class='trk-card-title'><i class='bi bi-box-seam'></i> Reserved Parts</h6></div>`;
        h += `<div class='trk-card-body'>`;
        reservedParts.forEach(part => {
          const st = part.status || 'reserved';
          h += `<div class='trk-detail-subsection' style='margin-bottom:8px;'>`;
          h += `<div class='trk-detail-subhead'><i class='bi ${st === 'checked_out' ? 'bi-check-circle' : 'bi-hourglass-split'}'></i> ${_e(part.itemName || part.toolId?.itemName || 'Part')}</div>`;
          h += `<div class='trk-detail-subtext'>Status: ${_e(st.replace(/_/g,' '))} · Qty ${part.quantity || 1}${part.unitPrice ? ' · ₱' + Number(part.unitPrice * (part.quantity || 1)).toLocaleString() : ''}</div>`;
          h += `</div>`;
        });
        h += `</div></div>`;
      }

      if (activityHtml) {
        h += `<div class='trk-card' style='margin-bottom:16px;'>`;
        h += `<div class='trk-card-header'><h6 class='trk-card-title'><i class='bi bi-clock-history'></i> Activity</h6></div>`;
        h += `<div class='trk-card-body'>${activityHtml}</div></div>`;
      }
      h = h.replace(/class='trk-card'/g, "class='trk-card booking-legacy-card'");
      sideHtml = sideHtml.replace(/class='trk-card'/g, "class='trk-card booking-legacy-card'");
      return `<div class="booking-order-overview">${overviewHtml}<div class="booking-detail-grid"><div class="booking-detail-column">${h}</div><div class="booking-detail-column">${sideHtml}</div></div></div>`;
    }

    function renderOverviewPage(a, date, bookingRef, hasCoords, custLat, custLng, paymentHtml, activityHtml) {
      const esc = (s) => (s || '').replace(/'/g, "\\'");
      const bId = a.bookingId?._id || (typeof a.bookingId === 'string' ? a.bookingId : '');
      const isRepair = isRepairAssignment(a);
      const bs = a.bookingId?.status || a.bookingStatus;
      const equipmentItems = a.equipmentItems || [];
      const equipmentHtml = equipmentItems.length ? `
      <div class="detail-section" style="border-color:#dbeafe;background:linear-gradient(135deg, #eff6ff, #f8fafc);">
        <div class="detail-section-header"><i class="bi bi-box-seam" style="color:#2563eb;"></i><h6>Assigned Equipment</h6></div>
        <div class="detail-section-body" style="display:flex;flex-direction:column;gap:8px;">
          ${equipmentItems.map(eq => `
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 12px;background:#fff;border:1px solid #e2e8f0;border-radius:10px;transition:all 0.2s;">
              <div style="display:flex;align-items:center;gap:10px;">
                <i class="bi bi-check-square" style="color:${eq.status === 'reserved' ? '#94a3b8' : eq.status === 'checked_out' || eq.status === 'in_use' ? '#2563eb' : eq.status === 'returned' ? '#16a34a' : '#d97706'};font-size:0.9rem;"></i>
                <div>
                  <div style="font-weight:600;font-size:0.8rem;color:#1e293b;">${eq.equipmentName || 'Tool'}</div>
                  <div style="font-size:0.68rem;color:#64748b;text-transform:capitalize;">${(eq.status || 'reserved').replace(/_/g,' ')}${eq.quantity > 1 ? ' · Qty ' + eq.quantity : ''}</div>
                </div>
              </div>
              ${eq.status === 'reserved' ? `<span class="badge bg-secondary" style="font-size:0.62rem;border-radius:6px;">Not checked out</span>` : eq.status === 'checked_out' || eq.status === 'in_use' ? `<span class="badge bg-primary" style="font-size:0.62rem;border-radius:6px;">In Use</span>` : eq.status === 'returned' ? `<span class="badge bg-success" style="font-size:0.62rem;border-radius:6px;">Returned</span>` : `<span class="badge bg-warning text-dark" style="font-size:0.62rem;border-radius:6px;">${(eq.status||'').replace(/_/g,' ')}</span>`}
            </div>
          `).join('')}
        </div>
      </div>` : '';

      // ── Multi-unit repair details ─────────────────────────────────────
      const bkServices = (Array.isArray(a.bookingId?.services) && a.bookingId.services.length) ? a.bookingId.services : null;
      const isMixed = a.serviceType === 'mixed' || a.bookingId?.serviceType === 'mixed' ||
        Boolean(bkServices?.some(item => item.type === 'core') && bkServices?.some(item => item.type === 'repair'));
      let repairUnitHtml = '';
      if (isRepair) {
        if (bkServices) {
          repairUnitHtml = bkServices.map((item, index) => `
            <div style="padding:10px 12px;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:8px;background:#f8fafc;">
              <div style="font-weight:700;font-size:0.75rem;color:#334155;margin-bottom:6px;">${index + 1}. ${item.name || item.type || 'Item'}${item.quantity > 1 ? ' · Qty ' + item.quantity : ''}</div>
              <div class="detail-row"><label>Unit</label><span>${item.applianceTypeName || item.airconTypeName || item.name || 'N/A'}</span></div>
              <div class="detail-row"><label>Brand</label><span>${item.brand || 'N/A'}</span></div>
              <div class="detail-row"><label>Model</label><span>${item.model || 'N/A'}</span></div>
              <div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Problem</label><span style="text-align:left;font-size:0.78rem;line-height:1.5;">${item.problemDescription || item.repairIssue || 'N/A'}</span></div>
            </div>`).join('');
        } else {
          repairUnitHtml = `
            <div class="detail-row"><label>Unit</label><span>${a.bookingId?.unitInfo?.unitType || a.unitType || 'N/A'}</span></div>
            <div class="detail-row"><label>Brand</label><span>${a.bookingId?.unitInfo?.brand || a.brand || 'N/A'}</span></div>
            <div class="detail-row"><label>Model</label><span>${a.bookingId?.unitInfo?.model || 'N/A'}</span></div>
            <div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Problem</label><span style="text-align:left;font-size:0.78rem;line-height:1.5;">${a.bookingId?.unitInfo?.problemDescription || a.issueDescription || 'N/A'}</span></div>`;
        }
      }

      return `<div>
      ${(a.quantity != null) ? `<div class="mw-qty-pill"><i class="bi bi-stack me-1"></i>${a.quantity} unit${a.quantity > 1 ? 's' : ''}</div>` : ''}
      <div class="detail-section">
        <div class="detail-section-header"><i class="bi bi-person-circle" style="color:#2563eb;"></i><h6>Customer</h6></div>
        <div class="detail-section-body">
          <div class="detail-row"><label>Name</label><span>${a.customerName || 'N/A'}</span></div>
          <div class="detail-row"><label>Phone</label><span>${a.customerPhone || 'N/A'}</span></div>
          <div class="detail-row"><label>Email</label><span style="font-size:0.75rem;">${a.customerEmail || 'N/A'}</span></div>
        </div>
      </div>
      <div class="detail-section detail-section-feature">
        <div class="detail-section-header"><i class="bi bi-gear-wide-connected" style="color:#2563eb;"></i><h6>Service</h6></div>
        <div class="detail-section-body">
          <div class="detail-row"><label>${isMixed ? 'Visit' : 'Service'}</label><span>${isMixed ? `${bkServices.length} services in one assignment` : (a.serviceName || 'N/A')}</span></div>
          <div class="detail-row"><label>Type</label><span>${isMixed ? 'Mixed - Core + Repair' : (a.serviceType || 'N/A')}</span></div>
          <div class="detail-row"><label>Priority</label><span><span class="priority-dot priority-${a.priority || 'normal'}"></span> ${(a.priority || 'normal').toUpperCase()}</span></div>
          ${(a.airconTypeName || a.airconType) ? `<div class="detail-row"><label>Aircon Type</label><span>${a.airconTypeName || a.airconType || 'N/A'}</span></div>` : ''}
          ${(a.hp != null) ? `<div class="detail-row"><label>HP Rating</label><span>${a.hp} HP${a.hpDescription ? ' · ' + a.hpDescription : ''}</span></div>` : ''}
          ${(a.quantity != null) ? `<div class="detail-row"><label>Quantity</label><span>${a.quantity} unit(s)</span></div>` : ''}
          ${(a.serviceDurationMinutes || (a.serviceDetail && a.serviceDetail.durationMinutes)) ? `<div class="detail-row"><label>Est. Duration</label><span>${(a.serviceDurationMinutes || (a.serviceDetail && a.serviceDetail.durationMinutes))} min</span></div>` : ''}
          ${(a.servicePrice || (a.serviceDetail && a.serviceDetail.basePrice)) ? `<div class="detail-row"><label>Service Fee</label><span>₱${Number(a.servicePrice || (a.serviceDetail && a.serviceDetail.basePrice) || 0).toLocaleString()}</span></div>` : ''}
          ${(a.serviceDescription || (a.serviceDetail && a.serviceDetail.description)) ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Description</label><span style="text-align:left;font-size:0.78rem;line-height:1.5;">${a.serviceDescription || (a.serviceDetail && a.serviceDetail.description) || ''}</span></div>` : ''}
          ${(a.bookingNotes) ? `<div class="detail-row" style="flex-direction:column;align-items:flex-start;gap:4px;"><label>Booking Notes</label><span style="text-align:left;font-size:0.78rem;line-height:1.5;">${a.bookingNotes}</span></div>` : ''}
        </div>
      </div>
      ${Array.isArray(a.bookingId?.services) && a.bookingId.services.length ? `<div class="detail-section"><div class="detail-section-header"><i class="bi bi-list-check" style="color:#2563eb;"></i><h6>Service Items</h6></div><div class="detail-section-body">${a.bookingId.services.map((item,index)=>`<div style="padding:10px 0;border-bottom:${index<a.bookingId.services.length-1?'1px solid #e2e8f0':'0'}"><div style="display:flex;justify-content:space-between;gap:8px"><strong>${index+1}. ${item.name||item.type||'Service'}</strong><span class="badge bg-${item.status==='completed'?'success':item.type==='repair'?'warning':'primary'}">${String(item.status||'pending').replace(/_/g,' ')}</span></div><div style="font-size:.72rem;color:#64748b;margin-top:3px">${[item.type,item.brand,item.model,item.applianceTypeName||item.airconTypeName].filter(Boolean).join(' · ')} · Qty ${item.quantity||1}</div>${item.problemDescription||item.repairIssue?`<div style="font-size:.72rem;margin-top:4px"><strong>Problem:</strong> ${item.problemDescription||item.repairIssue}</div>`:''}${item.type==='repair'?`<div style="font-size:.68rem;color:#7c3aed;margin-top:3px">${String(item.phase||'repair_phase_1').replace(/_/g,' ')}</div>`:''}</div>`).join('')}</div></div>` : ''}
${isRepair ? `
      <div class="detail-section">
        <div class="detail-section-header"><i class="bi bi-wrench" style="color:#d97706;"></i><h6>${bkServices ? 'Unit & Repair Details' : 'Unit'}</h6></div>
        <div class="detail-section-body">
          ${repairUnitHtml}
          ${(function () {
            let diagHtml = '';
            const diag = a.bookingId?.diagnosis || a.diagnosis;
            const insp = a.bookingId?.inspection || a.inspection;
            if (diag || insp) {
              const severity = insp?.severity ? `<div style="margin-bottom:6px;"><span class="badge bg-danger">${insp.severity.toUpperCase()} SEVERITY</span></div>` : '';
              const findings = diag?.findings || insp?.findings;
              const findingsHtml = findings ? `<div style="margin-bottom:8px;"><strong>Findings:</strong><br/>${findings}</div>` : '';
              const action = insp?.recommendedAction;
              const actionHtml = action ? `<div style="margin-bottom:8px;"><strong>Recommended Action:</strong><br/>${action}</div>` : '';
              let partsHtml = '';
              if (diag?.requiredParts && diag.requiredParts.length > 0) {
                partsHtml = `<div style="margin-bottom:8px;"><strong>Required Parts:</strong><ul style="margin:4px 0 0;padding-left:20px;">${diag.requiredParts.map(p => `<li>${p.name} (x${p.quantity || 1})</li>`).join('')}</ul></div>`;
              } else if (insp?.damagedParts && insp.damagedParts.length > 0) {
                partsHtml = `<div style="margin-bottom:8px;"><strong>Damaged Parts:</strong><ul style="margin:4px 0 0;padding-left:20px;">${insp.damagedParts.map(p => `<li>${p}</li>`).join('')}</ul></div>`;
              }
              const labor = diag?.laborDuration;
              const laborHtml = labor ? `<div style="margin-bottom:8px;"><strong>Labor Estimate:</strong> ${labor}</div>` : '';

              diagHtml = `<div class="detail-row mt-2" style="flex-direction:column;align-items:flex-start;gap:4px;">
                <label style="color:#7e22ce;font-weight:700;"><i class="bi bi-clipboard2-pulse me-1"></i>Final Diagnostic</label>
                <div style="text-align:left;font-size:0.78rem;line-height:1.5;color:#4c1d95;background:linear-gradient(to right, #faf5ff, #f3e8ff);padding:12px 16px;border-radius:10px;border:1px solid #e9d5ff;width:100%;box-shadow:inset 0 1px 3px rgba(147, 51, 234, 0.05);">
                  ${severity}${findingsHtml}${actionHtml}${partsHtml}${laborHtml}
                </div>
              </div>`;
            }
