  AU.Queue.loadRescheduleSlots=function(){
    var date=document.getElementById('rsDate').value;
    var select=document.getElementById('rsTime');
    var info=document.getElementById('rsSlotInfo');
    var submit=document.getElementById('rsSubmitBtn');
    if(!date){ select.innerHTML='<option value="">Select a date first</option>'; info.textContent='Slots load after choosing a date.'; submit.disabled=false; return; }
    select.innerHTML='<option value="">Loading slots...</option>';
    info.textContent='';
    submit.disabled=true;
    fetch('/api/admin/appointments/waiting-reassignment/slots?date='+encodeURIComponent(date)+'&bookingId='+encodeURIComponent(_qRescheduleBookingId)).then(function(r){return r.json();}).then(function(d){
      if(!d.slots||!d.slots.length){
        select.innerHTML='<option value="">No slots available</option>';
        info.textContent='No available time slots on this date. Try another day.';
        return;
      }
      select.innerHTML='<option value="">Select a time...</option>'+d.slots.map(function(s){
        var cap=s.remainingCapacity?s.remainingCapacity+' technician(s) available':'';
        return '<option value="'+s.value+'">'+s.label+(cap?' ('+cap+')':'')+'</option>';
      }).join('');
      info.textContent=d.slots.length+' available slot(s) on '+date+'.';
      submit.disabled=false;
    }).catch(function(){
      select.innerHTML='<option value="">Error loading slots</option>';
      info.textContent='Failed to load slots. Please try again.';
      submit.disabled=false;
