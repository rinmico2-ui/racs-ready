        <h6 class="td-panel-title"><i class="bi bi-box-seam me-2 text-info"></i>Equipment By Booking</h6>
        <span class="badge bg-info" id="bookingEquipmentCount">0</span>
      </div>
      <div class="td-panel-header-sub text-muted">Tools and equipment grouped by the booking they belong to</div>
      <div class="td-panel-body" id="bookingEquipment">
        <div class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm"></div> Loading...</div>
