  createSparkline('kpiSparkTechs', [5,5,6,5,5,4,5], '#06b6d4');
  createSparkline('kpiSparkRating', serviceAnalytics.weeklyCsat.length > 0 ? serviceAnalytics.weeklyCsat.map(function(w) { return w.avg; }) : [4.5,4.6,4.7,4.5,4.8,4.6], '#ef4444');

  /* -- Pipeline bars -- */
  document.querySelectorAll('[data-completion]').forEach(function(el) {
    el.style.width = el.getAttribute('data-completion') + '%';
  });

  /* -- Progress bars -- */
  document.querySelectorAll('[data-completion-rate],[data-resource-utilization],[data-csat-score],[data-revenue-target]').forEach(function(bar) {
    var val = bar.getAttribute('data-completion-rate') || bar.getAttribute('data-resource-utilization') || bar.getAttribute('data-csat-score') || bar.getAttribute('data-revenue-target') || 0;
    bar.style.width = val + '%';
  });

  /* -- CSV Export -- */
  document.getElementById('exportReportBtn').addEventListener('click', function() {
    var rows = [];
    document.querySelectorAll('table tbody tr').forEach(function(tr) {
      var cols = Array.from(tr.querySelectorAll('td')).map(function(td) { return td.innerText.trim(); });
