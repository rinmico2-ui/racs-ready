<script>
  document.addEventListener('DOMContentLoaded', function() {
    const collapseButtons = document.querySelectorAll('.btn-toggle[data-bs-toggle="collapse"]');
    const currentPath = window.location.pathname;

    function saveCollapseState(id, isExpanded) {
      const state = JSON.parse(localStorage.getItem('secretarySidebarState') || '{}');
      state[id] = isExpanded;
      localStorage.setItem('secretarySidebarState', JSON.stringify(state));
    }

    function restoreCollapseState() {
      const state = JSON.parse(localStorage.getItem('secretarySidebarState') || '{}');

      // Find all collapses that have active links
      const activeCollapses = [];

      collapseButtons.forEach(button => {
        const targetId = button.getAttribute('data-bs-target');
        const collapseElement = document.querySelector(targetId);

        if (collapseElement) {
          const linksInside = collapseElement.querySelectorAll('a');
          let isActiveSection = false;

          linksInside.forEach(link => {
            const linkPath = link.getAttribute('href');
            // Check if current path matches this link
            if (linkPath && (currentPath === linkPath || currentPath.startsWith(linkPath + '/'))) {
              isActiveSection = true;
            }
          });

          // Expand if it's the active section or if it was previously expanded
          const shouldExpand = state[targetId] === true || isActiveSection;

          if (shouldExpand) {
            activeCollapses.push(collapseElement);
          } else {
            // Collapse this one
            button.classList.add('collapsed');
            button.setAttribute('aria-expanded', 'false');
            collapseElement.classList.remove('show');
          }
        }
      });

      // Now expand only the first active collapse (accordion behavior)
      if (activeCollapses.length > 0) {
        activeCollapses.forEach((collapseElement, index) => {
          const targetId = '#' + collapseElement.id;
          const button = document.querySelector(`[data-bs-target="${targetId}"]`);

          if (index === 0) {
            // Expand the first one
            const bsCollapse = new bootstrap.Collapse(collapseElement, {
              toggle: false
            });
            bsCollapse.show();

            button.classList.remove('collapsed');
            button.setAttribute('aria-expanded', 'true');
            collapseElement.classList.add('show');
            saveCollapseState(targetId, true);
          } else {
            // Collapse the others
            button.classList.add('collapsed');
            button.setAttribute('aria-expanded', 'false');
            collapseElement.classList.remove('show');
            saveCollapseState(targetId, false);
          }
        });
      }
    }
    
    function setActiveLink() {
      const navLinks = document.querySelectorAll('.btn-toggle-nav a');

      // First, remove all active classes
      navLinks.forEach(link => {
        link.classList.remove('active');
      });

      // Also remove active class from all collapse buttons
      collapseButtons.forEach(button => {
        button.classList.remove('active');
      });

      // Now set active classes
      navLinks.forEach(link => {
        const linkPath = link.getAttribute('href');

        if (linkPath && (currentPath === linkPath || currentPath.startsWith(linkPath + '/') )) {
          link.classList.add('active');

          // Also set active state on parent collapse button
          const parentCollapse = link.closest('.collapse');
          if (parentCollapse) {
            const targetId = '#' + parentCollapse.id;
            const parentButton = document.querySelector(`[data-bs-target="${targetId}"]`);
            if (parentButton) {
              parentButton.classList.add('active');
            }
          }
        }
      });
    }
    
    collapseButtons.forEach(button => {
      const targetId = button.getAttribute('data-bs-target');
      const collapseElement = document.querySelector(targetId);

      if (collapseElement) {
        collapseElement.addEventListener('show.bs.collapse', function() {
          saveCollapseState(targetId, true);

          // Close all other collapses (accordion behavior)
          collapseButtons.forEach(otherButton => {
            const otherTargetId = otherButton.getAttribute('data-bs-target');
            if (otherTargetId !== targetId) {
              const otherCollapse = document.querySelector(otherTargetId);
              if (otherCollapse && otherCollapse.classList.contains('show')) {
                const bsCollapse = bootstrap.Collapse.getInstance(otherCollapse);
                if (bsCollapse) {
                  bsCollapse.hide();
                }
              }
            }
          });
        });

        collapseElement.addEventListener('hide.bs.collapse', function() {
          saveCollapseState(targetId, false);
        });
      }
    });

    // Prevent collapse from closing when clicking on a link inside
    const navLinks = document.querySelectorAll('.btn-toggle-nav a');
    navLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        const parentCollapse = this.closest('.collapse');
        if (parentCollapse) {
          const targetId = '#' + parentCollapse.id;
          // Ensure the parent stays open when clicking a link
          saveCollapseState(targetId, true);

          // Close all other collapses (accordion behavior)
          collapseButtons.forEach(button => {
            const otherTargetId = button.getAttribute('data-bs-target');
            if (otherTargetId !== targetId) {
              const otherCollapse = document.querySelector(otherTargetId);
              if (otherCollapse && otherCollapse.classList.contains('show')) {
                const bsCollapse = bootstrap.Collapse.getInstance(otherCollapse);
                if (bsCollapse) {
                  bsCollapse.hide();
                }
              }
            }
          });

          // Prevent any collapse toggle behavior from propagating
          e.stopPropagation();
        }
      });

      // Also prevent the default Bootstrap collapse behavior on mousedown
      link.addEventListener('mousedown', function(e) {
        e.stopPropagation();
      });
    });
    
    restoreCollapseState();
    setActiveLink();
  });
</script>














