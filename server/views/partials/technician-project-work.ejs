              ${(wo.dailySchedule||[]).length ? `<div style="margin:.45rem 0;display:grid;gap:.3rem;">${wo.dailySchedule.map(day=>{const target=Number(day.targetUnits||0),completed=Number(day.completedUnits||0),ahead=Math.max(0,completed-target);return `<div style="display:flex;justify-content:space-between;gap:.6rem;padding:.35rem .5rem;border:1px solid var(--pw-line-2);border-radius:6px;background:#f8fafc;font-size:.63rem;"><span><b>${fmtShort(day.date)}</b> · ${esc(day.startTime||'')}–${esc(day.endTime||'')}</span><span>Target <b>${target}</b> · Completed <b>${completed}</b>${ahead ? ` · <b style="color:var(--pw-ok);">+${ahead} ahead</b>` : ''}</span></div>`;}).join('')}</div>` : ''}
              <div class="pw-wo-stats">
                <div class="pw-wo-stat"><span class="k">Total</span><span class="v">${wo.unitCount}</span></div>
