                <option value="2.5">2.5 HP</option>
                <option value="3.0">3.0 HP</option>
                <option value="3.5">3.5 HP</option>
                <option value="4.0">4.0 HP</option>
                <option value="5.0">5.0 HP</option>
              </select>
            </div>
            <div class="mb-0">
              <label class="rp-form-label"><i class="bi bi-fire"></i>BTU Rating</label>
              <input type="number" class="form-control" data-field="btu" data-variant-id="${variantId}" placeholder="e.g. 9000" min="0" />
            </div>
          </div>
          <div class="rp-form-card">
            <div class="rp-form-card-header"><div class="rp-form-card-icon"><i class="bi bi-cash-coin"></i></div>Pricing &amp; Stock</div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-cash-stack"></i>Selling Price (₱) <span class="text-danger">*</span></label>
              <input type="number" class="form-control" data-field="sellingPrice" data-variant-id="${variantId}" placeholder="0" step="1" min="0" required />
            </div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-cash-stack"></i>Cost Price (₱)</label>
              <input type="number" class="form-control" data-field="costPrice" data-variant-id="${variantId}" placeholder="0" step="1" min="0" />
