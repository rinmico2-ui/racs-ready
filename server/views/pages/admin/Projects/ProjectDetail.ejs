  </style>


  <div id="projectDetailContainer">
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
  </div>

  <div id="toast" class="toast-msg"></div>
</div>

<script>
(async function() {
  const qs = (s) => document.querySelector(s);
  const projectId = window.location.pathname.split('/').pop();

  const statusLabels = {
    pending_project_scheduling: { label: 'Pending Review', cls: 'status-pending_project_scheduling' },
    accepted: { label: 'Approved · Planning', cls: 'status-accepted' },
    planning: { label: 'Project Planning', cls: 'status-planning' },
    ready: { label: 'Project Ready', cls: 'status-ready' },
    in_progress: { label: 'Project Active', cls: 'status_in_progress' },
    completed: { label: 'Project Completed', cls: 'status-completed' },
    closed: { label: 'Project Closed', cls: 'status-closed' },
    cancelled: { label: 'Cancelled', cls: 'status-cancelled' },
    on_hold: { label: 'On Hold', cls: 'status-on_hold' },
  };

  // Five-stage enterprise lifecycle. `pending_project_scheduling` = Pending Review
  // (awaiting admin approval); once approved/verified the status becomes
  // `accepted` and the project moves straight into the Planning stage.
  const STAGES = [
    { key: 'review', label: 'Pending Review', statuses: ['pending_project_scheduling'] },
    { key: 'planning', label: 'Project Planning', statuses: ['planning', 'accepted'] },
    { key: 'ready', label: 'Project Ready', statuses: ['ready'] },
    { key: 'active', label: 'Project Active', statuses: ['in_progress'] },
    { key: 'completed', label: 'Project Completed', statuses: ['completed', 'closed'] },
  ];
  function stageOf(p) {
    if (p.status === 'cancelled' || p.status === 'on_hold') return null;
    const s = STAGES.find(st => st.statuses.includes(p.status));
    return s ? s.key : 'review';
  }


  function toast(msg, type = 'success') {
    const t = qs('#toast');
    t.textContent = msg; t.className = 'toast-msg ' + type;
    t.style.display = 'block';
    setTimeout(() => t.style.display = 'none', 3000);
  }

  // Wrap an async action in button loading state to prevent double-clicks.
  // Pass the button element (or its event target) and an async callback.
  async function withBtnLoading(btn, label, fn) {
    if (btn._isLoading) return;
    btn._isLoading = true;
    const orig = btn.innerHTML;
    btn.classList.add('btn-loading');
    btn.innerHTML = `<span class="btn-spinner"></span>${label || 'Saving…'}`;
    try { await fn(); }
    catch (_) { /* toast handles errors */ }
    finally {
      btn.classList.remove('btn-loading');
      btn.innerHTML = orig;
      btn._isLoading = false;
    }
  }

  // ── Enterprise pipeline definition ──────────────────────────────
  const PIPELINE = [
    { key: 'pending_project_scheduling', label: 'Pending Review', icon: 'clipboard-check' },
    { key: 'accepted', label: 'Accepted', icon: 'check2-circle' },
    { key: 'planning', label: 'Planning', icon: 'pencil-square' },
    { key: 'team_assigned', label: 'Team Assigned', icon: 'people' },
    { key: 'wo_created', label: 'Work Orders', icon: 'list-check' },
    { key: 'ready', label: 'Ready to Start', icon: 'flag' },
    { key: 'in_progress', label: 'In Progress', icon: 'gear' },
    { key: 'completed', label: 'Completed', icon: 'check-lg' },
    { key: 'closed', label: 'Closed', icon: 'archive' },
  ];

  // Map the project's actual status to a pipeline stage index.
  function pipelineStageIndex(p) {
    if (p.status === 'cancelled') return -1;
    if (p.status === 'on_hold') return -1;
    if (p.status === 'completed') {
      return (p.actualCompletionDate || p.closedAt) ? 8 : 7;
    }
    if (p.status === 'in_progress') return 6;
    if (p.status === 'accepted' || p.status === 'planning') return 2;   // verified → planning
    // Below "in_progress": derive from planning progress.
    const hasTeam = (p.assignedTechnicians && p.assignedTechnicians.length) || (p.totalAssignedTechnicians > 0);
    const hasWO = (p.totalWorkOrders || 0) > 0;
    if (hasWO && hasTeam) return 4;       // work orders created
    if (hasTeam) return 3;                // team assigned
    if (p.status === 'planning') return 2; // planning
    return 0;                             // still pending review
  }

  function renderPipeline(p) {
    const cur = pipelineStageIndex(p);
    return PIPELINE.map((st, idx) => {
      const done = cur > idx;
      const active = cur === idx;
      const reachable = idx <= cur + 1;
      const cls = done ? 'done' : active ? 'active' : reachable ? 'reachable' : 'locked';
      const action = reachable && !active && cur >= 0
        ? `onclick="advancePipeline('${st.key}')" style="cursor:pointer;" title="Move to ${st.label}"`
        : '';
      const mark = done ? '<i class="bi bi-check-lg"></i>'
        : (active ? `<i class="bi bi-${st.icon}"></i>` : (idx + 1));
      return `<div class="pl-step ${cls}" ${action}><div class="pl-dot">${mark}</div><div class="pl-label">${st.label}</div></div>`;
    }).join('');
  }

  // Advance to a chosen pipeline stage by translating it into a project status.
  window.advancePipeline = async function(stageKey) {
    const map = {
      'pending_project_scheduling': 'pending_project_scheduling',
      'planning': 'planning',
      'team_assigned': 'planning',
      'wo_created': 'planning',
      'ready': 'planning',
      'in_progress': 'in_progress',
      'completed': 'completed',
      'closed': 'completed',
    };
    const status = map[stageKey];
    if (status) await changeStatus(status);
  };

  // ── Planning checklist (derived from project state) ─────────────
  function planningStepsHtml(p, workOrders, materials, allDone) {
    const teamDone = (p.assignedTechnicians?.length || p.totalAssignedTechnicians || 0) > 0;
    // Team acceptance gate: all assigned technicians must acknowledge before
    // the admin can proceed with detailed planning (resources, WOs, schedule).
    const teamStatusArr = p.teamStatus || [];
    const allAssignedTechs = p.assignedTechnicians || [];
    const allTeamAccepted = !teamDone || allAssignedTechs.length === 0 || allAssignedTechs.every(t => {
      const ts = teamStatusArr.find(s => s._id && s._id.toString() === (t._id || '').toString());
      return ts && ts.status === 'acknowledged';
    });
    const teamDeclined = teamDone && allAssignedTechs.some(t => {
      const ts = teamStatusArr.find(s => s._id && s._id.toString() === (t._id || '').toString());
      return ts && ts.status === 'declined';
    });
    const pendingTechs = teamDone && !allTeamAccepted ? allAssignedTechs.filter(t => {
      const ts = teamStatusArr.find(s => s._id && s._id.toString() === (t._id || '').toString());
      return !ts || ts.status !== 'acknowledged';
    }) : [];
    const waitingForTeam = teamDone && !allTeamAccepted;

    const resDone = (materials.length || window.__materialsCount || 0) > 0;
    const schedDone = workOrders.length > 0 && workOrders.every(wo => wo.scheduledDate);
    const woDone = workOrders.length > 0;
    let covered = 0, total = 0, unassignedWos = 0;
    workOrders.forEach(wo => {
      total += (wo.unitCount || 0);
      const techs = (wo.assignedTechnicians || []).filter(t => t && (t._id || t.id));
      if (techs.length === 0) { unassignedWos++; return; }
      const wc = techs.reduce((s, t) => s + (t.assignedUnits || 0), 0);
      covered += wc > 0 ? wc : (wo.unitCount || 0);
    });
    const coverDone = workOrders.length > 0 && unassignedWos === 0 && covered >= total;
    const steps = [
      { n: 1, label: 'Assign Team', done: teamDone, act: 'showTeamModal' },
      { n: 2, label: 'Reserve Resources', done: resDone, act: 'showMaterialModal', requiresAccept: true },
      { n: 3, label: 'Generate Work Orders', done: woDone, act: 'showWorkOrderModal', requiresAccept: true },
      { n: 4, label: 'Generate Schedule', done: schedDone, act: 'showScheduleWizard', requiresAccept: true },
      { n: 5, label: `Cover Units (${covered}/${total})`, done: coverDone, act: 'showWorkOrderModal', requiresAccept: true },
      { n: 6, label: 'Mark Ready', done: allDone, act: 'markReady', requiresAccept: true },
    ];
    let activeSet = false;
    const items = steps.map(s => {
      const blockedByTeam = s.requiresAccept && waitingForTeam;
      const state = s.done ? 'done' : (activeSet ? 'todo' : (activeSet = true, 'current'));
      const isLocked = (s.n === 6 && !allDone && !activeSet) || blockedByTeam;
      const finalState = isLocked ? 'locked' : state;
      const isDisabled = (state === 'todo' && !s.done) || isLocked;
      const title = blockedByTeam ? 'Waiting for team members to accept the assignment' : (isLocked ? 'Complete all previous steps first' : '');
      const icon = s.done ? '<i class="bi bi-check-lg"></i>' : (blockedByTeam ? '<i class="bi bi-person-fill-lock"></i>' : (isLocked ? '<i class="bi bi-lock"></i>' : s.n));
      const labelSuffix = blockedByTeam ? ' <small style="color:#d97706;">(awaiting acceptance)</small>' : '';
      return `
        <button class="pwz-step ${finalState}" onclick="${s.act}()" type="button" ${isDisabled ? 'disabled' : ''} ${title ? `title="${title}"` : ''}>
          <span class="pwz-num">${icon}</span>
          <span class="pwz-lbl">${s.label}${labelSuffix}</span>
        </button>`;
    }).join('<span class="pwz-arrow"><i class="bi bi-chevron-right"></i></span>');

    // Team acceptance status banner
    let teamBanner = '';
    if (teamDone && allTeamAccepted) {
      teamBanner = `<div class="pwz-cover-note" style="color:#15803d;background:#f0fdf4;border-color:#bbf7d0;"><i class="bi bi-check-circle-fill"></i> All team members have accepted the assignment</div>`;
    } else if (teamDeclined) {
      const declinedNames = allAssignedTechs.filter(t => {
        const ts = teamStatusArr.find(s => s._id && s._id.toString() === (t._id || '').toString());
        return ts && ts.status === 'declined';
      }).map(t => t.name || 'a technician').join(', ');
      teamBanner = `<div class="pwz-cover-note warn"><i class="bi bi-exclamation-triangle-fill"></i> ${declinedNames} declined the assignment. Use "Assign Team" to replace them before proceeding.</div>`;
    } else if (waitingForTeam) {
      const names = pendingTechs.map(t => t.name || 'a technician').join(', ');
      teamBanner = `<div class="pwz-cover-note" style="color:#92400e;background:#fffbeb;border-color:#fde68a;"><i class="bi bi-hourglass-split"></i> Waiting for ${names} to accept the project assignment. Steps 2–6 will unlock once all confirm.</div>`;
    }

    const coverNote = unassignedWos > 0
      ? `<div class="pwz-cover-note warn"><i class="bi bi-exclamation-triangle-fill"></i> ${unassignedWos} work order(s) have no technician assigned — units are not covered.</div>`
      : (covered < total ? `<div class="pwz-cover-note warn"><i class="bi bi-exclamation-triangle-fill"></i> Only ${covered} of ${total} units assigned to technicians.</div>` : '');

    // Count only steps 1-5 for progress (step 6 is the final gate)
    const completedCount = steps.filter(s => s.done).length;
    const totalSteps = steps.length;
    const progressPct = Math.round((completedCount / totalSteps) * 100);
    const nextStep = waitingForTeam ? 'Team Acceptance' : (steps.find(s => !s.done)?.label || '—');
    return `
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.5rem;padding:0.45rem 0.75rem;background:#f8fafc;border-radius:8px;border:1px solid #e2e8f0;">
        <div style="flex:1;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.15rem;">
            <span style="font-size:0.72rem;font-weight:700;color:#334155;">Planning Progress</span>
            <span style="font-size:0.72rem;font-weight:700;color:${allDone ? '#16a34a' : '#1d4ed8'};">${completedCount}/${totalSteps} steps</span>
          </div>
          <div style="height:5px;background:#e2e8f0;border-radius:999px;overflow:hidden;">
            <div style="height:100%;width:${progressPct}%;border-radius:999px;background:${allDone ? 'linear-gradient(90deg,#16a34a,#22c55e)' : 'linear-gradient(90deg,#1d4ed8,#3b82f6)'};transition:width 0.4s ease;"></div>
          </div>
        </div>
        ${allDone ? '<span style="font-size:0.68rem;font-weight:700;color:#16a34a;white-space:nowrap;"><i class="bi bi-check-circle-fill"></i> All steps complete</span>' : `<span style="font-size:0.68rem;font-weight:600;color:#64748b;white-space:nowrap;">Next: <span style="color:#1d4ed8;">${nextStep}</span></span>`}
      </div>
      ${teamBanner}
      <div class="pwz-rail">${items}</div>
      ${coverNote}`;
  }

  function renderChecklist(p, workOrders, locked) {
    const materials = window.__lastMaterials || [];
    const equipment = materials.filter(mm => mm.type !== 'part');
    let covered = 0, total = 0, unassignedWos = 0;
    workOrders.forEach(wo => {
      total += (wo.unitCount || 0);
      const techs = (wo.assignedTechnicians || []).filter(t => t && (t._id || t.id));
      if (techs.length === 0) { unassignedWos++; return; }
      const wc = techs.reduce((s, t) => s + (t.assignedUnits || 0), 0);
      covered += wc > 0 ? wc : (wo.unitCount || 0);
    });
    const coverDone = workOrders.length > 0 && unassignedWos === 0 && covered >= total;
    const items = [
      { label: 'Review customer request', done: true },
      { label: 'Assign technicians', done: (p.assignedTechnicians?.length || p.totalAssignedTechnicians || 0) > 0, act: 'showTeamModal' },
      { label: 'Reserve equipment & materials', done: (window.__materialsCount || 0) > 0, act: 'showMaterialModal' },
      ...(p.isLargeScale ? [{ label: 'Lead checks limited/exclusive equipment (optional)', done: equipment.some(mm => mm.scope === 'assigned'), act: 'scrollToResources' }] : []),
      { label: 'Generate work orders', done: (workOrders.length || 0) > 0, act: 'showWorkOrderModal' },
      { label: `Cover all units (${covered}/${total} assigned)`, done: coverDone, act: 'showWorkOrderModal' },
      { label: 'Confirm schedule', done: workOrders.length > 0 && workOrders.every(wo => wo.scheduledDate), act: 'showScheduleWizard' },
      { label: 'Notify customer', done: false, act: null },
    ];
    return items.map(it => `
      <div class="plan-item">
        <div class="plan-check ${it.done ? 'ok' : 'todo'}">${it.done ? '<i class="bi bi-check-lg"></i>' : ''}</div>
        <span style="${it.done ? 'color:#64748b;' : 'color:#0f172a;font-weight:600;'}">${it.label}</span>
        ${it.act && !it.done && !locked ? `<button class="pd-btn plan-act" onclick="${it.act}()"><i class="bi bi-plus-lg"></i> Do</button>` : ''}
        ${it.done ? '<span class="plan-act" style="color:#059669;font-size:0.7rem;font-weight:700;">DONE</span>' : (it.act && !it.done && locked ? '<span class="plan-act" style="color:#94a3b8;font-size:0.68rem;font-weight:600;">Accept to enable</span>' : '')}
      </div>`).join('');
  }

  // ── Planning Studio: 5 auto-generate cards (no manual date dragging) ──
  function planningStudioHtml(p, workOrders, materials, allDone) {
    const team = (p.assignedTechnicians || []);
    const leadId = (p.leadTechnicianId || (team[0] && team[0]._id) || '').toString();
    const lead = team.find(t => (t._id || '').toString() === leadId) || team[0];
    const members = team.slice(1);
    // Team acceptance gate — all assigned technicians must accept
    const teamStatusArr = p.teamStatus || [];
    const allAssignedTechs = team;
    const allTeamAccepted = team.length === 0 || allAssignedTechs.length === 0 || allAssignedTechs.every(t => {
      const ts = teamStatusArr.find(s => s._id && s._id.toString() === (t._id || '').toString());
      return ts && ts.status === 'acknowledged';
    });
    const waitingForTeam = team.length > 0 && !allTeamAccepted;
    const woCount = workOrders.length;
    const matCount = materials.length;
    const teamReady = team.length > 0;
    const woReady = woCount > 0;
    const matReady = matCount > 0;

    const teamBanner = waitingForTeam
      ? `<div style="grid-column:1/-1;margin-bottom:0.25rem;padding:0.4rem 0.75rem;border-radius:8px;border:1px solid #fde68a;background:#fffbeb;color:#92400e;font-size:0.78rem;"><i class="bi bi-hourglass-split"></i> <strong>Awaiting Team Acceptance</strong> — ${allAssignedTechs.filter(t => { const ts = teamStatusArr.find(s => s._id && s._id.toString() === (t._id || '').toString()); return !ts || ts.status !== 'acknowledged'; }).map(t => t.name || 'a tech').join(', ')} haven't accepted yet. Planning tools below are locked until all confirm.</div>`
      : '';
    return `
    <div class="studio-grid">${teamBanner}
      <div class="studio-card full">
        <h4><span class="sc-num">1</span> Team</h4>
        <div class="sc-sub">Assign lead and members. Acceptance required before planning tools unlock.</div>
        ${teamReady ? teamCardBodyHtml(p, workOrders) : '<div class="studio-row mb-2"><span class="text-muted">No team assigned yet</span></div>'}
        <div class="sc-gen mt-2"><button class="pd-btn primary" onclick="showTeamModal()"><i class="bi bi-people"></i> ${teamReady ? 'Edit Team' : 'Assign Team'}</button></div>
      </div>

      <div class="studio-card">
        <h4><span class="sc-num">2</span> Resources</h4>
        <div class="sc-sub">AI suggests equipment & materials — confirm to reserve.</div>
        ${waitingForTeam ? '<div class="studio-row mt-1"><span style="color:#d97706;font-size:0.72rem;"><i class="bi bi-lock"></i> Locked</span></div>' : ''}
        <div id="studioResStatus">${matReady ? `<span class="studio-pill ok"><i class="bi bi-check-lg"></i> ${matCount} reserved</span>` : '<span class="studio-pill">None</span>'}</div>
        <div class="sc-gen mt-2">
          <button class="pd-btn" onclick="studioSuggestResources()" ${waitingForTeam ? 'disabled' : ''}><i class="bi bi-magic"></i> AI Suggest</button>
          <button class="pd-btn primary" onclick="showMaterialModal()" ${waitingForTeam ? 'disabled' : ''}><i class="bi bi-plus-lg"></i> Reserve</button>
        </div>
      </div>

      <div class="studio-card">
        <h4><span class="sc-num">3</span> Work Orders</h4>
        <div class="sc-sub">Auto-calculate based on team capacity.</div>
        ${waitingForTeam ? '<div class="studio-row mt-1"><span style="color:#d97706;font-size:0.72rem;"><i class="bi bi-lock"></i> Locked</span></div>' : ''}
        <div id="studioWoStatus">${woReady ? `<span class="studio-pill ok"><i class="bi bi-check-lg"></i> ${woCount} WO(s)</span>` : '<span class="studio-pill">Not generated</span>'}</div>
        <div class="sc-gen mt-2"><button class="pd-btn primary" onclick="studioGenerateWorkOrders()" ${waitingForTeam ? 'disabled' : ''}><i class="bi bi-list-check"></i> Generate Work Orders</button></div>
      </div>

      <div class="studio-card">
        <h4><span class="sc-num">4</span> Scheduling</h4>
        <div class="sc-sub">Auto-distributes units across working days based on technician capacity and existing bookings.</div>
        ${waitingForTeam ? '<div class="studio-row mt-1"><span style="color:#d97706;font-size:0.72rem;"><i class="bi bi-lock"></i> Locked</span></div>' : ''}
        <div id="studioSchedStatus"></div>
        <div class="sc-gen mt-2">
          <button class="pd-btn primary" onclick="studioGenerateSchedule()" ${waitingForTeam ? 'disabled' : ''}><i class="bi bi-calendar2-check"></i> Generate Schedule</button>
        </div>
      </div>
    </div>`;
  }

  // ── Resource helpers (enterprise reservation flow) ───────────
  function techNameOf(p, tid) {
    if (!tid) return null;
    const t = (p.assignedTechnicians || []).find(x => (x._id || '').toString() === String(tid));
    return t ? (t.name || 'Technician') : 'Technician';
  }

  function typeChip(type) {
    const map = { part: ['part', 'Part'], equipment: ['equipment', 'Equipment'], tool: ['tool', 'Tool'] };
    const [cls, label] = map[type] || map.equipment;
    return `<span class="res-type-chip res-type-${cls}">${label}</span>`;
  }

  function renderResourceFlow(p, materials) {
    const reserved = materials.length > 0;
    const equipment = materials.filter(mm => mm.type !== 'part');
    // Per-tech assignment is OPTIONAL — only needed for limited/exclusive items.
    const limited = equipment.filter(mm => mm.scope === 'assigned');
    const assignedLimited = limited.length > 0 && limited.every(mm => mm.assignedToTechnicianId);
    const confirmed = equipment.length > 0 && equipment.every(mm => mm.pickedUp);
    const steps = [
      { label: 'Admin Reserves', state: reserved ? 'done' : 'todo' },
      { label: limited.length ? 'Lead Assigns (limited)' : 'Lead Check (optional)', state: !reserved ? 'todo' : (limited.length === 0 || assignedLimited) ? 'done' : 'current' },
      { label: 'Tech Confirms Ready', state: !reserved ? 'todo' : (assignedLimited || limited.length === 0) && confirmed ? 'done' : 'current' },
    ];
    return `<div class="flow-banner mb-3">${steps.map((s, i) => `
      ${i > 0 ? '<span class="flow-arrow"><i class="bi bi-chevron-right"></i></span>' : ''}
      <span class="flow-step ${s.state}">${s.state === 'done' ? '<i class="bi bi-check-lg"></i>' : ''}${s.label}</span>`).join('')}</div>`;
  }

  function renderResourceRow(p, mm) {
    const assigned = mm.assignedToTechnicianId;
    const isEquip = mm.type !== 'part';
    const isAssigned = mm.scope === 'assigned';
    const isFromInventory = mm.source === 'inventory' && mm.sourceId;

    const assignControl = isAssigned
      ? (assigned
          ? `<span class="assign-pill"><i class="bi bi-person-check"></i> ${techNameOf(p, assigned)}</span>`
          : `<button class="pd-btn plan-act" style="font-size:0.68rem;padding:0.2rem 0.5rem;" onclick="openAssignModal('${mm._id}')"><i class="bi bi-person-plus"></i> Assign to tech</button>`)
      : (isEquip ? `<span class="wo-mini">Project-level (shared)</span>` : `<span class="wo-mini">Consumable</span>`);
    const pickup = isEquip
      ? (mm.pickedUp
          ? `<span class="pickup-badge pickup-done"><i class="bi bi-check-circle"></i> Picked Up</span>`
          : `<button class="pickup-badge pickup-ready" style="border:none;cursor:pointer;" onclick="confirmPickup('${mm._id}',this)">Ready · Confirm</button>`)
      : '';

    const typeIcon = mm.type === 'part' ? 'bi-box-seam' : (mm.type === 'tool' ? 'bi-wrench' : 'bi-tools');
    const typeBg = mm.type === 'part' ? '#ede9fe' : (mm.type === 'tool' ? '#fef3c7' : '#e0f2fe');
    const typeColor = mm.type === 'part' ? '#5b21b6' : (mm.type === 'tool' ? '#92400e' : '#0369a1');

    return `
      <div class="res-row" style="border-left:3px solid ${typeBg};padding-left:0.85rem;">
        <div class="res-ico" style="background:${typeBg};color:${typeColor};"><i class="bi ${typeIcon}"></i></div>
        <div class="res-main">
          <div class="res-name">
            ${mm.itemName}
            <span class="res-type-chip" style="background:${typeBg};color:${typeColor};">${mm.type || 'equipment'}</span>
            ${isAssigned ? '<span class="res-type-chip res-type-assigned">limited</span>' : ''}
            ${isFromInventory ? '<span class="res-type-chip" style="background:#ecfdf5;color:#065f46;"><i class="bi bi-box-seam" style="font-size:0.6rem;"></i> inventory</span>' : ''}
          </div>
          <div class="res-sub">${mm.notes ? mm.notes + ' · ' : ''}${mm.status || 'reserved'}${isFromInventory ? ' · <span style="color:#065f46;">From stock</span>' : ''}</div>
        </div>
        <div class="d-flex flex-column align-items-end gap-1">
          <span class="res-qty" style="font-size:0.85rem;font-weight:800;">×${mm.quantity} <span style="font-size:0.72rem;font-weight:600;color:#94a3b8;">${mm.unit || 'pcs'}</span></span>
          ${assignControl}
          ${pickup}
        </div>
      </div>`;
  }

  function renderEquipmentPlan(p, materials) {
    const equipment = materials.filter(mm => mm.type !== 'part');
    const parts = materials.filter(mm => mm.type === 'part');
    const techs = (p.assignedTechnicians || []);

    if (equipment.length === 0 && parts.length === 0) {
      return `
        <div style="text-align:center;padding:2rem 1rem;background:#f8fafc;border:1px dashed #e2e8f0;border-radius:12px;">
          <div style="width:56px;height:56px;border-radius:14px;background:#eef2ff;display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;font-size:1.4rem;color:#6366f1;"><i class="bi bi-box-seam"></i></div>
          <div style="font-size:0.9rem;font-weight:700;color:#475569;margin-bottom:0.3rem;">No resources reserved yet</div>
          <div style="font-size:0.78rem;color:#94a3b8;margin-bottom:0.75rem;">Reserve equipment, tools, and parts from inventory to ensure availability.</div>
          <button class="pd-btn primary" onclick="showMaterialModal()" style="font-size:0.78rem;display:inline-flex;align-items:center;gap:0.35rem;"><i class="bi bi-plus-lg"></i> Reserve Resources</button>
        </div>`;
    }

    const shared = equipment.filter(mm => mm.scope !== 'assigned');
    const limited = equipment.filter(mm => mm.scope === 'assigned');

    let html = '';

    // Shared equipment block
    if (shared.length > 0) {
      html += `
        <div class="eq-tech-group" style="border-color:#cbd5e1;background:#f8fafc;">
          <div class="eq-tech-head">
            <i class="bi bi-people-fill" style="color:#0369a1;"></i>
            <div style="font-size:0.82rem;font-weight:700;color:#0c4a6e;">Shared Project Equipment</div>
            <span class="cap-pill ms-auto">${shared.length} item${shared.length === 1 ? '' : 's'}</span>
          </div>
          <div class="eq-tech-items">${shared.map(mm => `<span class="eq-tag"><i class="bi ${mm.pickedUp ? 'bi-check-circle-fill' : 'bi-tools'}"></i> ${mm.itemName} ×${mm.quantity}${mm.pickedUp ? ' <i class="bi bi-check-lg" style="color:#166534;"></i>' : ''}</span>`).join('')}</div>
        </div>`;
    }

    // Parts summary block
    if (parts.length > 0) {
      const totalPartsCost = parts.reduce((sum, p) => sum + (p.totalPrice || 0), 0);
      html += `
        <div class="eq-tech-group" style="border-color:#c4b5fd;background:#faf5ff;">
          <div class="eq-tech-head">
            <i class="bi bi-box-seam" style="color:#7c3aed;"></i>
            <div style="font-size:0.82rem;font-weight:700;color:#5b21b6;">Reserved Parts & Consumables</div>
            <span class="cap-pill ms-auto" style="background:#ede9fe;color:#5b21b6;">${parts.length} item${parts.length === 1 ? '' : 's'}</span>
          </div>
          <div class="eq-tech-items">${parts.map(mm => `<span class="eq-tag" style="background:#ede9fe;border-color:#c4b5fd;color:#5b21b6;"><i class="bi bi-box-seam"></i> ${mm.itemName} ×${mm.quantity}</span>`).join('')}</div>
          ${totalPartsCost > 0 ? `<div style="font-size:0.72rem;color:#7c3aed;margin-top:0.4rem;font-weight:600;">Total parts value: ₱${totalPartsCost.toLocaleString()}</div>` : ''}
        </div>`;
    }

    // Limited/exclusive items per technician
    const byTech = {};
    limited.forEach(mm => {
      const key = (mm.assignedToTechnicianId || '').toString();
      (byTech[key] = byTech[key] || []).push(mm);
    });

    if (techs.length) {
      html += techs.map(t => {
        const items = byTech[(t._id || '').toString()] || [];
        const head = `<div class="eq-tech-head">
          <div class="tech-avatar" style="width:30px;height:30px;font-size:0.75rem;">${(t.name || '?').charAt(0).toUpperCase()}</div>
          <div style="font-size:0.82rem;font-weight:700;">${t.name || 'Technician'}</div>
          <span class="cap-pill ms-auto">${items.length} limited item${items.length === 1 ? '' : 's'}</span>
        </div>`;
        const body = items.length
          ? `<div class="eq-tech-items">${items.map(mm => `
              <span class="eq-tag"><i class="bi ${mm.pickedUp ? 'bi-check-circle-fill' : 'bi-tools'}"></i> ${mm.itemName} ×${mm.quantity}
              ${mm.pickedUp ? '<i class="bi bi-check-lg" style="color:#166534;"></i>' : ''}</span>`).join('')}</div>`
          : `<div class="eq-empty">No limited equipment assigned.</div>`;
        return `<div class="eq-tech-group">${head}${body}</div>`;
      }).join('');
    }

    const unassignedLimited = byTech[''] || [];
    if (unassignedLimited.length) {
      html += `<div class="eq-tech-group" style="border-style:dashed;background:#fffaf0;">
        <div class="eq-tech-head"><i class="bi bi-question-circle" style="color:#92400e;"></i><div style="font-size:0.82rem;font-weight:700;color:#92400e;">Unassigned Limited Items</div><span class="cap-pill ms-auto">${unassignedLimited.length}</span></div>
        <div class="eq-tech-items">${unassignedLimited.map(mm => `<span class="eq-tag"><i class="bi bi-tools"></i> ${mm.itemName} ×${mm.quantity} <button class="pd-btn plan-act" style="font-size:0.62rem;padding:0.1rem 0.4rem;margin-left:0.3rem;" onclick="openAssignModal('${mm._id}')">Assign</button></span>`).join('')}</div>
      </div>`;
    }

    return html;
  }

  // ── Derived metrics ─────────────────────────────────────────────
  function deriveMetrics(p, workOrders, materials) {
    const totalUnits = p.totalUnits || 0;
    const completedUnits = p.completedUnits || 0;
    const remainingUnits = Math.max(totalUnits - completedUnits, 0);
    const reservedParts = materials.length;
    const totalEstHours = workOrders.reduce((s, w) => s + (w.estimatedHours || 0), 0) || p.estimatedTotalHours || 0;
    const hoursUsed = workOrders.reduce((s, w) => {
      const frac = w.unitCount > 0 ? (w.completedUnitCount || 0) / w.unitCount : 0;
      return s + (w.estimatedHours || 0) * frac;
    }, 0);
    const days = new Set(workOrders.filter(w => w.scheduledDate).map(w => new Date(w.scheduledDate).toDateString()));
    const workingDays = days.size || Math.ceil(totalEstHours / 8) || 0;
    const woTotal = workOrders.length;
    const woCompleted = workOrders.filter(w => w.status === 'completed').length;
    const woActive = workOrders.filter(w => w.status === 'in_progress').length;
    const woPending = workOrders.filter(w => !['completed','in_progress','cancelled'].includes(w.status)).length;
    const progress = totalUnits > 0 ? Math.round((completedUnits / totalUnits) * 100) : 0;
    return { totalUnits, completedUnits, remainingUnits, reservedParts, totalEstHours, hoursUsed, workingDays, woTotal, woCompleted, woActive, woPending, progress };
  }

  function projectTypeLabel(p) {
    if (p.service?.category && /commercial|business|industrial/i.test(p.service.category)) return 'Commercial Project';
    if ((p.totalUnits || 0) >= 10) return 'Commercial Project';
    return 'Large-Scale Residential Project';
  }

  function payStatusClass(p) {
    const s = (p.payment && p.payment.paymentStatus) || 'unpaid';
    if (s === 'paid') return 'ok';
    if (s === 'partial') return 'current';
    if (s === 'refunded') return '';
    return '';
  }

  // Customer-entered payment details (captured at booking time on the source booking).
  function customerPayment(data) {
    const b = data.booking || {};
    return {
      status: b.paymentStatus || 'unpaid',
      amountPaid: b.amountPaid || 0,
      balance: (b.balanceAmount != null) ? b.balanceAmount : 0,
      total: (b.totalAmount != null) ? b.totalAmount : (b.amountPaid || 0) + (b.balanceAmount || 0),
      method: b.paymentMethod || '—',
      reference: b.paymentReference || '',
      gcashNumber: b.gcashNumber || '',
      notes: b.paymentNotes || '',
      proofUrl: b.paymentProof || '',
      verifiedAt: b.paymentVerifiedAt || null,
    };
  }

  function fmtDate(d) {
    if (!d) return '—';
    return new Date(d).toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  // ── Team card body (reusable across stages) ──
  function teamCardBodyHtml(p, workOrders) {
    if (!p.assignedTechnicians || !p.assignedTechnicians.length) return '<div class="text-muted" style="font-size:0.82rem;">No technicians assigned.</div>';
    const leadId = (p.leadTechnicianId || '').toString();
    const lead = p.assignedTechnicians.find(t => (t._id || '').toString() === leadId) || p.assignedTechnicians[0];
    const teamStatusArr = p.teamStatus || [];
    const techAcceptStatus = (techId) => { const ts = teamStatusArr.find(s => s._id && s._id.toString() === String(techId)); return ts ? ts.status : 'notified'; };
    const statusBadge = (status) => {
      const c = { acknowledged: '#16a34a', declined: '#dc2626', notified: '#f59e0b' };
      const l = { acknowledged: 'Accepted', declined: 'Declined', notified: 'Pending' };
      const icons = { acknowledged: 'bi-check-circle-fill', declined: 'bi-x-circle-fill', notified: 'bi-clock-fill' };
      return `<span style="display:inline-flex;align-items:center;gap:3px;font-size:0.65rem;font-weight:700;color:${c[status] || '#94a3b8'};"><i class="bi ${icons[status] || 'bi-circle'}"></i>${l[status] || status}</span>`;
    };
    const accepted = teamStatusArr.filter(s => s.status === 'acknowledged').length;
    const declined = teamStatusArr.filter(s => s.status === 'declined').length;
    const pending = p.assignedTechnicians.length - accepted - declined;
    const hpu = p.estimatedDurationPerUnit || 1;
    const dailyHrs = p.preferredWorkingHours?.end ? Math.max(1, parseInt(p.preferredWorkingHours.end) - parseInt(p.preferredWorkingHours.start)) : 8;
    const todayKey = new Date().toDateString();
    const todayWos = workOrders.filter(w => w.scheduledDate && new Date(w.scheduledDate).toDateString() === todayKey);
    const techCap = (techId) => {
      const tid = (techId || '').toString();
      const a = todayWos.reduce((s, w) => s + (w.assignedTechnicians || []).filter(at => (at._id || at.id || '').toString() === tid).reduce((s2, t2) => s2 + (t2.assignedUnits || 0), 0), 0);
      const cap = Math.floor(dailyHrs / hpu);
      const rem = Math.max(0, cap - a);
      return { capacity: cap, assigned: a, remaining: rem, pct: cap > 0 ? Math.round((a / cap) * 100) : 0 };
    };
    const leadC = techCap(lead._id);
    return `
      <div class="team-lead">
        <div class="tech-avatar">${(lead.name||'?').charAt(0).toUpperCase()}</div>
        <div style="flex:1;"><div style="font-size:0.82rem;font-weight:700;">${lead.name||'Lead'}</div><div class="wo-mini">Lead</div></div>
        ${statusBadge(techAcceptStatus(lead._id))}
      </div>
      <div class="tc-bar"><div class="tc-bar-fill" style="width:${leadC.pct}%;background:${leadC.remaining > 0 ? '#16a34a' : '#d97706'};"></div></div>
      <div class="tc-stats mb-2">
        <span><strong>Capacity:</strong> ${leadC.capacity}/day</span>
        <span><strong>Assigned:</strong> ${leadC.assigned}</span>
        <span style="color:${leadC.remaining > 0 ? '#16a34a' : '#dc2626'};"><strong>Free:</strong> ${leadC.remaining}</span>
      </div>
      ${p.assignedTechnicians.slice(1).map(t => {
        const tc = techCap(t._id);
        return `
        <div class="tech-row">
          <div class="tech-avatar" style="width:28px;height:28px;font-size:0.7rem;">${(t.name||'?').charAt(0).toUpperCase()}</div>
          <div style="flex:1;font-size:0.78rem;font-weight:600;">${t.name||'Member'}</div>
          ${statusBadge(techAcceptStatus(t._id))}
        </div>
        <div class="tc-bar" style="margin-left:2.1rem;"><div class="tc-bar-fill" style="width:${tc.pct}%;background:${tc.remaining > 0 ? '#16a34a' : '#d97706'};"></div></div>
        <div class="tc-stats" style="margin-left:2.1rem;font-size:0.65rem;">
          <span>Cap: ${tc.capacity}/d</span>
          <span>Now: ${tc.assigned}</span>
          <span style="color:${tc.remaining > 0 ? '#16a34a' : '#dc2626'};">Free: ${tc.remaining}</span>
        </div>`;
      }).join('')}
      <div class="mt-2 d-flex gap-2 flex-wrap" style="font-size:0.7rem;">
        <span class="cap-pill">${p.assignedTechnicians.length} Total</span>
        ${accepted > 0 ? `<span class="cap-pill" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-check-lg"></i> ${accepted} OK</span>` : ''}
        ${declined > 0 ? `<span class="cap-pill" style="background:#fef2f2;color:#dc2626;"><i class="bi bi-x-lg"></i> ${declined} No</span>` : ''}
        ${pending > 0 ? `<span class="cap-pill" style="background:#fefce8;color:#a16207;"><i class="bi bi-clock"></i> ${pending} Wait</span>` : ''}
      </div>`;
  }

  // ── Dashboard metrics: schedule health, capacity, projections ──
  function dashboardMetrics(p, workOrders) {
    const start = p.plannedStartDate || p.preferredStartDate;
    const deadline = p.plannedCompletionDate || p.preferredCompletionDeadline;
    const total = p.totalUnits || 0;
    const completed = p.completedUnits || workOrders.reduce((s, w) => s + (w.completedUnitCount || 0), 0);
    const remaining = Math.max(total - completed, 0);
    const team = p.assignedTechnicians || [];
    const leadId = (p.leadTechnicianId || '').toString();
    const nonLead = team.filter(t => (t._id || '').toString() !== leadId);
    const techCount = Math.max(team.length, 1);
    const hpU = p.estimatedDurationPerUnit || 1;
    const dailyHrs = p.preferredWorkingHours?.end
      ? Math.max(1, parseInt(p.preferredWorkingHours.end) - parseInt(p.preferredWorkingHours.start))
      : 8;
    const workingDays = (start && deadline)
      ? (() => {
          const wd = p.preferredWorkingDays || ['Mon','Tue','Wed','Thu','Fri'];
          let count = 0;
          const d = new Date(start);
          const end = new Date(deadline);
          while (d <= end) {
            const dayName = d.toLocaleDateString('en-US', { weekday: 'short' });
            if (wd.some(w => w.toLowerCase().startsWith(dayName.toLowerCase().slice(0,3)))) count++;
            d.setDate(d.getDate() + 1);
          }
          return count || 1;
        })()
      : 1;
    const unitsPerTechPerDay = Math.floor(dailyHrs / hpU);
    const dailyTeamCapacity = Math.max(1, unitsPerTechPerDay * techCount);
    const daysElapsed = start ? (() => {
      const wd = p.preferredWorkingDays || ['Mon','Tue','Wed','Thu','Fri'];
      let count = 0;
      const d = new Date(start);
      const today = new Date();
      today.setHours(0,0,0,0);
      while (d <= today) {
        const dayName = d.toLocaleDateString('en-US', { weekday: 'short' });
        if (wd.some(w => w.toLowerCase().startsWith(dayName.toLowerCase().slice(0,3)))) count++;
        d.setDate(d.getDate() + 1);
      }
      return count;
    })() : 0;
    const daysLeft = Math.max(0, workingDays - daysElapsed);
    const idealDailyTarget = total / workingDays;
    const dailyTarget = idealDailyTarget;
    const cumTarget = Math.round(dailyTarget * daysElapsed);
    const variance = completed - cumTarget;
    const remainingCapacity = daysLeft * dailyTeamCapacity;
    const onTrack = variance >= 0;
    const todayStr = new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });

    // Estimated completion based on current pace; fall back to theoretical capacity
    const pacePerDay = daysElapsed > 0 ? completed / daysElapsed : dailyTeamCapacity;
    const daysNeeded = pacePerDay > 0 ? Math.ceil(remaining / pacePerDay) : Math.ceil(remaining / dailyTeamCapacity);
    const estCompletion = new Date();
    estCompletion.setDate(estCompletion.getDate() + daysNeeded);
    // Count only working days for the estimate
    let workingDaysNeeded = 0, checkDate = new Date();
    const wd = p.preferredWorkingDays || ['Mon','Tue','Wed','Thu','Fri'];
    while (workingDaysNeeded < daysNeeded) {
      checkDate.setDate(checkDate.getDate() + 1);
      const dayName = checkDate.toLocaleDateString('en-US', { weekday: 'short' });
      if (wd.some(w => w.toLowerCase().startsWith(dayName.toLowerCase().slice(0,3)))) workingDaysNeeded++;
    }
    const estCompletionDate = new Date(checkDate);

    const delayDays = deadline && estCompletionDate > new Date(deadline) ? Math.ceil((estCompletionDate - new Date(deadline)) / (1000*60*60*24)) : 0;

    // Schedule health
    let health = 'on-schedule';
    let healthLabel = 'On Schedule';
    let healthIcon = 'bi-check-circle-fill';
    let healthColor = '#16a34a';
    if (variance < -Math.ceil(dailyTeamCapacity * 1.5)) {
      health = 'behind';
      healthLabel = 'Behind Schedule';
      healthIcon = 'bi-exclamation-triangle-fill';
      healthColor = '#dc2626';
    } else if (variance < -Math.ceil(dailyTeamCapacity * 0.5)) {
      health = 'at-risk';
      healthLabel = 'At Risk';
      healthIcon = 'bi-exclamation-circle-fill';
      healthColor = '#d97706';
    }

    // Today's completion data from work orders scheduled today
    const todayStrKey = new Date().toDateString();
    const todayWos = workOrders.filter(w => w.scheduledDate && new Date(w.scheduledDate).toDateString() === todayStrKey);
    const todayCompleted = todayWos.reduce((s, w) => s + (w.completedUnitCount || 0), 0);
    const todayTarget = Math.round(dailyTarget);

    return {
      start, deadline, total, completed, remaining,
      workingDays, daysElapsed, daysLeft,
      dailyTarget, cumTarget, variance,
      dailyTeamCapacity, remainingCapacity,
      unitsPerTechPerDay, techCount,
      onTrack, health, healthLabel, healthIcon, healthColor,
      estCompletionDate, delayDays,
      todayTarget, todayCompleted, todayStr,
      pacePerDay,
    };
  }

  // ── Project Overview dashboard ──
  function projectOverviewHtml(p, workOrders, dm) {
    const progress = dm.total > 0 ? Math.round((dm.completed / dm.total) * 100) : 0;
    const agoText = dm.daysElapsed > 0 ? `${dm.daysElapsed} day${dm.daysElapsed > 1 ? 's' : ''} elapsed` : 'Not started';
    const healthEl = `<span style="display:inline-flex;align-items:center;gap:6px;font-size:0.78rem;font-weight:700;color:${dm.healthColor};"><i class="bi ${dm.healthIcon}"></i>${dm.healthLabel}</span>`;

    let delayHtml = '';
    if (dm.delayDays > 0) {
      delayHtml = `
        <div style="grid-column:1/-1;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:0.75rem 1rem;margin-top:0.25rem;">
          <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;font-size:0.82rem;">
            <span><strong>Estimated Completion:</strong> ${fmtDate(dm.estCompletionDate)} <span style="color:#dc2626;font-weight:700;">🔴</span></span>
            <span><strong>Customer Due Date:</strong> ${fmtDate(dm.deadline)}</span>
            <span style="color:#dc2626;font-weight:700;"><i class="bi bi-arrow-down"></i> ${dm.delayDays} Day${dm.delayDays > 1 ? 's' : ''} Behind</span>
          </div>
        </div>`;
    }

    return `
      <div class="pd-card" style="border-left:4px solid ${dm.healthColor};">
        <div class="pd-body">
          <div class="dash-grid">
            <div class="dash-main">
              <div class="dash-row">
                <div style="font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#64748b;">Project Status</div>
                <div style="font-size:0.95rem;">${healthEl}</div>
              </div>
              <div class="dash-row">
                <div style="font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#64748b;">Progress</div>
                <div>
                  <div class="dash-bar"><div style="width:${progress}%;background:${dm.healthColor};"></div></div>
                  <div style="font-size:0.72rem;color:#64748b;margin-top:2px;">${dm.completed}/${dm.total} units · ${progress}% · ${agoText}</div>
                </div>
              </div>
            </div>
            <div class="dash-meta">
              <div class="dash-meta-item"><span class="dmk">Customer</span><span class="dmv">${p.customer?.name || '—'}</span></div>
              <div class="dash-meta-item"><span class="dmk">Project Duration</span><span class="dmv">${dm.start ? fmtDate(dm.start) : '—'} — ${dm.deadline ? fmtDate(dm.deadline) : '—'}</span></div>
              <div class="dash-meta-item"><span class="dmk">Completed Units</span><span class="dmv" style="color:#16a34a;font-weight:700;">${dm.completed} / ${dm.total}</span></div>
              <div class="dash-meta-item"><span class="dmk">Remaining Units</span><span class="dmv" style="color:#d97706;font-weight:700;">${dm.remaining}</span></div>
              <div class="dash-meta-item"><span class="dmk">Working Days Left</span><span class="dmv">${dm.daysLeft}</span></div>
              <div class="dash-meta-item"><span class="dmk">Estimated Completion</span><span class="dmv" style="${dm.delayDays > 0 ? 'color:#dc2626;' : 'color:#16a34a;'}">${fmtDate(dm.estCompletionDate)} ${dm.delayDays > 0 ? '🔴' : '✅'}</span></div>
            </div>
          </div>
          ${delayHtml}
        </div>
      </div>`;
  }

  // ── Schedule Health section ──
  function scheduleHealthHtml(p, workOrders, dm) {
    const todayStr = new Date().toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric' });
    // Compute today's actual from work orders scheduled today
    const todayScheduled = workOrders.filter(w => w.scheduledDate && new Date(w.scheduledDate).toDateString() === new Date().toDateString());
    const todayActual = todayScheduled.reduce((s, w) => s + (w.completedUnitCount || 0), 0);
    const todayTarget = dm.todayTarget;
    const todayVariance = todayActual - todayTarget;

    let statusHtml = '';
    let statusLabel = 'On Track';
    let statusColor = '#16a34a';
    let statusIcon = 'bi-check-circle-fill';
    if (dm.variance < -Math.ceil(dm.dailyTeamCapacity * 0.5)) {
      statusLabel = 'At Risk';
      statusColor = '#d97706';
      statusIcon = 'bi-exclamation-circle-fill';
    }
    if (dm.delayDays > 0) {
      statusLabel = 'Behind Schedule';
      statusColor = '#dc2626';
      statusIcon = 'bi-exclamation-triangle-fill';
    }

    if (dm.variance < 0) {
      statusHtml = `<div style="margin-top:0.5rem;padding:0.4rem 0.75rem;background:#fef2f2;border-radius:8px;border:1px solid #fecaca;font-size:0.78rem;color:#991b1b;"><i class="bi ${statusIcon}"></i> Project is ${statusLabel.toLowerCase()} — ${Math.abs(dm.variance)} unit${Math.abs(dm.variance) > 1 ? 's' : ''} behind target. ${dm.remaining > dm.remainingCapacity ? `Remaining (${dm.remaining}) exceed${dm.remaining === 1 ? 's' : ''} available capacity (${dm.remainingCapacity}).` : 'Can still recover with full team effort.'}</div>`;
    } else {
      statusHtml = `<div style="margin-top:0.5rem;padding:0.4rem 0.75rem;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;font-size:0.78rem;color:#166534;"><i class="bi ${statusIcon}"></i> Project is on schedule. ${dm.variance > 0 ? `${dm.variance} unit${dm.variance > 1 ? 's' : ''} ahead of target.` : ''}</div>`;
    }

    return `
      <div class="pd-card" style="border:1.5px solid #e2e8f0;">
        <div class="pd-head"><h3><i class="bi bi-activity" style="color:${statusColor};"></i> Schedule Health</h3><span style="font-size:0.72rem;font-weight:700;color:${statusColor};"><i class="bi ${statusIcon}"></i> ${statusLabel}</span></div>
        <div class="pd-body" style="padding:0.75rem 1rem;">
          <div class="sh-grid">
            <div class="sh-item"><span class="shk">Today's Target</span><span class="shv">${todayTarget} units</span></div>
            <div class="sh-item"><span class="shk">Actual Completed</span><span class="shv" style="color:${todayActual >= todayTarget ? '#16a34a' : '#d97706'};">${todayActual} units</span></div>
            <div class="sh-item"><span class="shk">Today Variance</span><span class="shv" style="color:${todayVariance >= 0 ? '#16a34a' : '#dc2626'};">${todayVariance >= 0 ? '+' : ''}${todayVariance} units</span></div>
            <div class="sh-item"><span class="shk">Cumulative Target</span><span class="shv">${dm.cumTarget} units</span></div>
            <div class="sh-item"><span class="shk">Remaining Capacity</span><span class="shv">${dm.remainingCapacity} units</span></div>
            <div class="sh-item"><span class="shk">Units Remaining</span><span class="shv" style="color:${dm.remaining > dm.remainingCapacity ? '#dc2626' : '#16a34a'};">${dm.remaining} units</span></div>
          </div>
          ${statusHtml}
        </div>
      </div>`;
  }

  // ── Recommended Actions ──
  function recommendedActionsHtml(p, workOrders, dm) {
    if (dm.delayDays <= 0 && dm.variance >= 0) return '';
    const team = p.assignedTechnicians || [];
    const actions = [];
    // Option 1: Add 1 technician
    const addTechEst = dm.remaining > 0 && team.length > 0
      ? (() => {
          const newDailyCap = dm.unitsPerTechPerDay * (team.length + 1);
          const extraDays = Math.ceil(dm.remaining / newDailyCap);
          const est = new Date();
          let wd = 0, d = new Date();
          const wdays = p.preferredWorkingDays || ['Mon','Tue','Wed','Thu','Fri'];
          while (wd < extraDays) {
            d.setDate(d.getDate() + 1);
            const dayName = d.toLocaleDateString('en-US', { weekday: 'short' });
            if (wdays.some(w => w.toLowerCase().startsWith(dayName.toLowerCase().slice(0,3)))) wd++;
          }
          return d;
        })()
      : null;
    if (addTechEst && team.length > 0) {
      const meetsDeadline = dm.deadline && addTechEst <= new Date(dm.deadline);
      actions.push({ icon: 'bi-person-plus', label: `Add 1 Technician (${team.length + 1} total)`, estFinish: addTechEst, meetsDeadline });
    }
    // Option 2: Saturday work
    const satEst = dm.remaining > 0
      ? (() => {
          const extraDays = Math.ceil(dm.remaining / dm.dailyTeamCapacity);
          let wd = 0, d = new Date();
          const wdays = ['Mon','Tue','Wed','Thu','Fri','Sat'];
          while (wd < extraDays) {
            d.setDate(d.getDate() + 1);
            const dayName = d.toLocaleDateString('en-US', { weekday: 'short' });
            if (wdays.some(w => w.toLowerCase().startsWith(dayName.toLowerCase().slice(0,3)))) wd++;
          }
          return d;
        })()
      : null;
    if (satEst) {
      const meetsDeadline = dm.deadline && satEst <= new Date(dm.deadline);
      actions.push({ icon: 'bi-calendar-week', label: 'Approve Saturday Work', estFinish: satEst, meetsDeadline });
    }
    // Option 3: Extend due date (only when actually behind deadline)
    if (dm.delayDays > 0) {
      actions.push({
        icon: 'bi-calendar-plus',
        label: `Extend Due Date to ${fmtDate(dm.estCompletionDate)}`,
        estFinish: dm.estCompletionDate,
        meetsDeadline: false,
        recommended: true,
      });
    }
    // Option 4: Continue current plan
    actions.push({
      icon: 'bi-arrow-right-circle',
      label: 'Continue Current Plan',
      estFinish: dm.estCompletionDate,
      meetsDeadline: dm.deadline && dm.estCompletionDate <= new Date(dm.deadline),
    });

    return `
      <div class="pd-card" style="border:1.5px solid #fef3c7;">
        <div class="pd-head"><h3><i class="bi bi-lightbulb" style="color:#d97706;"></i> Recommended Actions</h3><span style="font-size:0.72rem;color:#92400e;font-weight:600;"><i class="bi bi-exclamation-triangle-fill"></i> Behind schedule</span></div>
        <div class="pd-body" style="padding:0.75rem 1rem;">
          <div style="font-size:0.78rem;color:#64748b;margin-bottom:0.625rem;">${dm.delayDays > 0 ? `Current team cannot finish before ${fmtDate(dm.deadline)}.` : `Behind target — ${Math.abs(dm.variance)} unit${Math.abs(dm.variance) > 1 ? 's' : ''} below schedule.`} Choose an action:</div>
          ${actions.map((a, i) => `
            <div class="rec-action ${a.recommended ? 'rec-recommended' : ''}" onclick="${a.meetsDeadline ? `applyRecommendation('${a.label}',this)` : `promptExtend('${a.label}','${fmtDate(a.estFinish)}',this)`}">
              <div class="rec-left">
                <i class="bi ${a.icon}" style="color:${a.meetsDeadline ? '#16a34a' : '#d97706'};font-size:1rem;"></i>
                <div>
                  <div class="rec-title">${a.label}</div>
                  <div class="rec-sub">Est. Finish: ${fmtDate(a.estFinish)} ${a.meetsDeadline ? '✅' : `⚠ Due ${fmtDate(dm.deadline)}`}</div>
                </div>
              </div>
              <span class="rec-badge ${a.meetsDeadline ? 'ok' : 'warn'}">${a.meetsDeadline ? 'Meets Due Date' : 'Exceeds Due Date'}</span>
            </div>
          `).join('')}
        </div>
      </div>`;
  }

  // ── Work Order Progress ──
  function workOrderProgressHtml(workOrders) {
    if (!workOrders.length) return '';
    return `
      <div class="pd-card" style="border:1.5px solid #e0e7ff;">
        <div class="pd-head"><h3><i class="bi bi-bar-chart" style="color:#4f46e5;"></i> Work Order Progress</h3></div>
        <div class="pd-body" style="padding:0.75rem 1rem;">
          ${workOrders.slice().sort((a,b) => (a.sortOrder||0)-(b.sortOrder||0)).map(wo => {
            const pct = wo.unitCount > 0 ? Math.round((wo.completedUnitCount / wo.unitCount) * 100) : 0;
            return `
              <div class="wop-row">
                <div class="wop-header">
                  <span class="wop-title">${wo.title || wo.section || 'Work Order'}</span>
                  <span class="wop-stat">${wo.completedUnitCount || 0}/${wo.unitCount} units</span>
                </div>
                <div class="wop-bar"><div style="width:${pct}%;background:${pct >= 100 ? '#16a34a' : pct >= 50 ? '#d97706' : '#dc2626'};"></div></div>
              </div>`;
          }).join('')}
        </div>
      </div>`;
  }

  // ── Daily Progress Table ──
  function dailyProgressHtml(workOrders, dm) {
    const today = new Date();
    today.setHours(0,0,0,0);
    const rows = [];
    for (let i = 6; i >= 0; i--) {
      const d = new Date(today);
      d.setDate(d.getDate() - i);
      const dayKey = d.toDateString();
      const dayWos = workOrders.filter(w => w.scheduledDate && new Date(w.scheduledDate).toDateString() === dayKey);
      const completed = dayWos.reduce((s, w) => s + (w.completedUnitCount || 0), 0);
      const target = Math.round(dm.dailyTarget);
      const variance = completed - target;
      let status = variance >= 0 ? '✓' : '⚠';
      let statusColor = variance >= 0 ? '#16a34a' : '#d97706';
      rows.push({ date: d.toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric' }), target, completed, variance, status, statusColor });
    }
    return `
      <div class="pd-card" style="border:1.5px solid #e2e8f0;">
        <div class="pd-head"><h3><i class="bi bi-calendar-check" style="color:#6366f1;"></i> Daily Progress (Last 7 Days)</h3></div>
        <div class="pd-body" style="padding:0.5rem 0.75rem 0.75rem;">
          <table class="dp-table">
            <thead><tr><th>Date</th><th>Target</th><th>Completed</th><th>Status</th></tr></thead>
            <tbody>${rows.map(r => `
              <tr>
                <td>${r.date}</td>
                <td class="text-center">${r.target}</td>
                <td class="text-center" style="color:${r.completed >= r.target ? '#16a34a' : '#d97706'};">${r.completed}</td>
                <td class="text-center" style="color:${r.statusColor};font-weight:700;">${r.status}</td>
              </tr>`).join('')}
            </tbody>
          </table>
        </div>
      </div>`;
  }

  // ── Timeline / Milestone ──
  function timelineHtml(p, dm) {
    const milestones = [
      { label: 'Project Started', done: !!p.createdAt, icon: 'bi-flag' },
      { label: 'Planning Complete', done: p.status !== 'pending_project_scheduling' && p.status !== 'accepted', icon: 'bi-kanban' },
      { label: 'Resources Reserved', done: (window.__materialsCount || 0) > 0, icon: 'bi-box-seam' },
      { label: 'Work Orders Generated', done: (window.__lastWorkOrders || []).length > 0, icon: 'bi-list-check' },
      { label: 'Project Active', done: ['in_progress','completed','closed'].includes(p.status), icon: 'bi-play-fill' },
    ];
    const schedHealth = dm.delayDays > 0
      ? `<span style="font-size:0.82rem;font-weight:700;color:#dc2626;"><i class="bi bi-exclamation-triangle-fill"></i> Behind Schedule</span>`
      : `<span style="font-size:0.82rem;font-weight:700;color:#16a34a;"><i class="bi bi-check-circle-fill"></i> Healthy</span>`;

    return `
      <div class="pd-card" style="border:1.5px solid #e2e8f0;">
        <div class="pd-head"><h3><i class="bi bi-signpost-2" style="color:#6366f1;"></i> Project Timeline</h3></div>
        <div class="pd-body">
          <div class="tl-milestones">
            ${milestones.map(m => `
              <div class="tl-milestone ${m.done ? 'done' : ''}">
                <span class="tl-m-dot">${m.done ? '<i class="bi bi-check-lg"></i>' : '<i class="bi bi-circle"></i>'}</span>
                <span class="tl-m-label">${m.label}</span>
              </div>
            `).join('<div class="tl-m-line"></div>')}
          </div>
          <div class="tl-footer">
            <div><strong>Schedule:</strong> ${schedHealth}</div>
            <div><strong>Expected Finish:</strong> ${fmtDate(dm.estCompletionDate)} ${dm.delayDays > 0 ? '<span style="color:#dc2626;">⚠ Behind Schedule</span>' : ''}</div>
          </div>
        </div>
      </div>`;
  }

  async function loadProject() {
    try {
      const r = await fetch(`/api/projects/${projectId}`);
      if (!r.ok) throw new Error('Not found');
      const data = await r.json();

      // Load issues + expenses in parallel (best-effort)
      try {
        const [ir, er] = await Promise.all([
          fetch(`/api/projects/${projectId}/issues`),
          fetch(`/api/projects/${projectId}/expenses`),
        ]);
        const idata = ir.ok ? await ir.json() : { issues: [] };
        const edata = er.ok ? await er.json() : { expenses: [], summary: {} };
        window.__projectIssues = idata.issues || [];
        window.__projectExpenses = edata.expenses || [];
        window.__projectExpenseSummary = edata.summary || {};
      } catch (e2) { /* non-fatal */ }

      renderProject(data);
      window.currentProject = data;
      renderLiveStatus(data.workOrders);
      loadEquipmentCheckout();
    } catch(e) {
      qs('#projectDetailContainer').innerHTML = '<div class="text-center py-5 text-muted">Project not found</div>';
    }
  }

  // ── Equipment Checkout: load and render ──
  async function loadEquipmentCheckout() {
    const container = qs('#equipmentCheckoutContainer');
    if (!container) return;
    try {
      const r = await fetch(`/api/projects/${projectId}/equipment`);
      if (!r.ok) { container.innerHTML = '<div class="text-center py-3 text-muted" style="font-size:0.85rem;">Could not load equipment</div>'; return; }
      const d = await r.json();
      if (!d.assignments || !d.assignments.length) {
        container.innerHTML = '<div class="text-center py-3 text-muted" style="font-size:0.85rem;">No equipment requests yet. Technicians can request tools from the field.</div>';
        return;
      }
      // Group by date and technician
      const groups = {};
      d.assignments.forEach(a => {
        const tId = a.technicianId || 'unknown';
        const dk = new Date(a.workDate).toDateString();
        const key = tId + '|' + dk;
        if (!groups[key]) groups[key] = { technicianId: tId, workDate: a.workDate, items: [] };
        groups[key].items.push(a);
      });
      // Also need technician names - load from the project's assigned techs
      const p = window.currentProject;
      const techMap = {};
      (p?.assignedTechnicians || []).forEach(t => { techMap[t._id] = t.name || 'Unknown'; });

      let html = '';
      Object.values(groups).sort((a,b) => new Date(b.workDate) - new Date(a.workDate)).forEach(g => {
        const dt = new Date(g.workDate).toLocaleDateString('en-PH', { weekday:'short', month:'short', day:'numeric', year:'numeric' });
        const techName = techMap[g.technicianId] || 'Technician';
        const pending = g.items.filter(i => i.status === 'reserved');
        const active = g.items.filter(i => i.status === 'checked_out' || i.status === 'in_use');
        const done = g.items.filter(i => i.status === 'returned' || i.status === 'damaged');
        const status = pending.length ? 'pending' : active.length ? 'active' : 'done';
        const statusLabel = pending.length ? `${pending.length} pending` : active.length ? `${active.length} in use` : `${done.length} returned`;

        html += `<div style="border:1px solid var(--pw-line-2);border-radius:10px;margin-bottom:.75rem;overflow:hidden;">
          <div style="display:flex;justify-content:space-between;align-items:center;padding:.5rem .75rem;background:#f8fafc;border-bottom:1px solid var(--pw-line-2);">
            <div><strong style="font-size:.8rem;">${esc(techName)}</strong><span style="font-size:.65rem;color:var(--pw-muted);margin-left:.5rem;">${dt}</span></div>
            <span style="font-size:.6rem;font-weight:700;padding:.15rem .45rem;border-radius:999px;background:${pending.length ? '#fffbeb' : active.length ? '#eef2ff' : '#f1f5f9'};color:${pending.length ? '#92400e' : active.length ? '#4338ca' : '#64748b'};">${statusLabel}</span>
          </div>
          <div style="padding:.5rem .75rem;">
            ${g.items.map(item => {
              const st = item.status;
              const stLabel = { reserved:'Pending', checked_out:'Issued', in_use:'In Use', returned:'Returned', damaged:'Damaged', lost:'Lost' }[st] || st;
              const stColor = { reserved:'#d97706', checked_out:'#4338ca', in_use:'#065f46', returned:'#64748b', damaged:'#dc2626', lost:'#dc2626' }[st] || '#64748b';
              return `<div style="display:flex;align-items:center;gap:.5rem;padding:.25rem 0;font-size:.75rem;border-bottom:1px solid #f1f5f9;">
                <span style="flex:1;"><b>${esc(item.equipmentName)}</b>${item.equipmentCode ? ` <small style="color:var(--pw-muted);">#${esc(item.equipmentCode)}</small>` : ''}${item.consumable ? ' <small style="color:#d97706;">(consumable)</small>' : ''}</span>
                <span style="font-size:.6rem;font-weight:700;padding:.12rem .4rem;border-radius:999px;background:${stColor}15;color:${stColor};">${stLabel}</span>
                ${st === 'reserved' ? `<button class="pd-btn" style="font-size:.65rem;padding:.2rem .5rem;" onclick="issueEquipmentItem('${item._id}')"><i class="bi bi-check-lg"></i> Issue</button>` : ''}
                ${item.damageDescription ? `<span style="font-size:.6rem;color:var(--pw-danger);" title="${esc(item.damageDescription)}"><i class="bi bi-exclamation-triangle"></i></span>` : ''}
                ${item.issuedBy ? `<span style="font-size:.6rem;color:var(--pw-muted);">by ${esc(item.issuedBy)}</span>` : ''}
              </div>`;
            }).join('')}
            ${pending.length > 1 ? `<div style="margin-top:.4rem;"><button class="pd-btn" style="font-size:.65rem;padding:.25rem .6rem;" onclick="issueAllEquipment('${g.technicianId}','${g.workDate}')"><i class="bi bi-check-all"></i> Issue All (${pending.length})</button></div>` : ''}
          </div>
        </div>`;
      });
      container.innerHTML = html;
    } catch (_) { container.innerHTML = '<div class="text-center py-3 text-muted">Failed to load equipment</div>'; }
  }

  // ── Issue a single equipment item ──
  window.issueEquipmentItem = async function (assignmentId) {
    try {
      await fetch(`/api/projects/${projectId}/equipment/issue`, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ assignmentIds: [assignmentId], issuedBy: window.__currentUserName || 'Admin' }) });
      toast('Equipment issued');
      loadEquipmentCheckout();
    } catch (e) { toast(e.message, 'error'); }
  };

  // ── Issue all pending items for a technician on a date ──
  window.issueAllEquipment = async function (techId, date) {
    try {
      // Get all reserved assignments for this tech+date
      const r = await fetch(`/api/projects/${projectId}/equipment`);
      if (!r.ok) throw new Error('Failed');
      const d = await r.json();
      const ids = d.assignments.filter(a => String(a.technicianId) === String(techId) && new Date(a.workDate).toDateString() === new Date(date).toDateString() && a.status === 'reserved').map(a => a._id);
      if (!ids.length) { toast('No pending items', 'error'); return; }
      if (!confirm(`Issue ${ids.length} item(s)?`)) return;
      await fetch(`/api/projects/${projectId}/equipment/issue`, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ assignmentIds: ids, issuedBy: window.__currentUserName || 'Admin' }) });
      toast(`${ids.length} item(s) issued`);
      loadEquipmentCheckout();
    } catch (e) { toast(e.message, 'error'); }
  };

  function renderProject(data) {
    const p = data.project;
    const workOrders = data.workOrders || [];
    const materials = data.materials || [];
    const m = deriveMetrics(p, workOrders, materials);
    const st = statusLabels[p.status] || { label: p.status, cls: '' };
    const prjId = 'PRJ-' + String(p._id).slice(-6).toUpperCase();
    const locked = p.isLargeScale && p.status === 'pending_project_scheduling';
    // Editing actions (team, work orders, resources) are only allowed while Planning.
    const planningOnly = stageOf(p) !== 'planning';
    // Planning completion gate — all prerequisite steps for "Mark Ready"
    const teamDone = (p.assignedTechnicians?.length || p.totalAssignedTechnicians || 0) > 0;
    // Team acceptance gate — all assigned technicians must accept
    const teamStatusArr = p.teamStatus || [];
    const allAssignedTechs = p.assignedTechnicians || [];
    const allTeamAccepted = !teamDone || allAssignedTechs.length === 0 || allAssignedTechs.every(t => {
      const ts = teamStatusArr.find(s => s._id && s._id.toString() === (t._id || '').toString());
      return ts && ts.status === 'acknowledged';
    });
    const resDone = (materials.length || window.__materialsCount || 0) > 0;
    const schedDone = workOrders.length > 0 && workOrders.every(wo => wo.scheduledDate);
    const woDone = workOrders.length > 0;
    let covered = 0, total = 0, unassignedWos = 0;
    workOrders.forEach(wo => {
      total += (wo.unitCount || 0);
      const techs = (wo.assignedTechnicians || []).filter(t => t && (t._id || t.id));
      if (techs.length === 0) { unassignedWos++; return; }
      const wc = techs.reduce((s, t) => s + (t.assignedUnits || 0), 0);
      covered += wc > 0 ? wc : (wo.unitCount || 0);
    });
    const coverDone = workOrders.length > 0 && unassignedWos === 0 && covered >= total;
    const planningAllDone = allTeamAccepted && teamDone && resDone && schedDone && woDone && coverDone;

    const dm = dashboardMetrics(p, workOrders);
    const b = data.booking;

    // If the project has no repair snapshot, fall back to the booking's repair data
    if ((!p.repair || p.repair.serviceType !== 'repair') && b && b.serviceType === 'repair') {
      p.repair = {
        serviceType: 'repair',
        unitInfo: b.unitInfo || {},
        issueDescription: b.issueDescription || '',
        aiAssist: b.technicianAssistant ? {
          summary: b.technicianAssistant.summary || '',
          probableCauses: (b.technicianAssistant.probableCauses || []).map(c => typeof c === 'string' ? c : (c.description || String(c))),
          possibleParts: (b.technicianAssistant.possibleParts || []).map(pt => typeof pt === 'string' ? pt : (pt.name || String(pt)))
        } : null,
        quotation: b.quotation || null
      };
    }

    let html = `
      <a href="/admin/projects" class="text-decoration-none text-muted" style="font-size:0.82rem;">&larr; Back to Projects</a>

      <!-- ══ 1. PROJECT HEADER ══ -->
      <div class="pd-hero mt-2">
        <div>
          <div class="prj-id">${prjId}</div>
          <h2>${p.customer?.name || 'Unknown Customer'}</h2>
          <div class="meta-grid">
            <div><div class="mk">Service</div><div class="mv">${p.service?.name || (p.repair?.serviceType === 'repair' ? 'Repair — ' + [p.repair?.unitInfo?.unitType, p.repair?.unitInfo?.brand, p.repair?.unitInfo?.model].filter(Boolean).join(' ') : '—')}</div></div>
            <div><div class="mk">Project Type</div><div class="mv">${projectTypeLabel(p)} ${p.repair?.serviceType === 'repair' ? '<span class="status-badge" style="background:#fef3c7;color:#92400e;border-color:#fde68a;font-size:0.6rem;">Repair</span>' : '<span class="status-badge" style="background:#e0f2fe;color:#0369a1;border-color:#bae6fd;font-size:0.6rem;">Core Service</span>'}</div></div>
            <div><div class="mk">Progress</div><div class="mv">${m.completedUnits}/${m.totalUnits} (${m.progress}%)</div></div>
            <div><div class="mk">Target Completion</div><div class="mv">${fmtDate(p.preferredCompletionDeadline)}</div></div>
          </div>
        </div>
        <div class="d-flex flex-column align-items-end gap-2">
          <span class="status-badge ${st.cls}">${st.label}</span>
          <button class="btn btn-light btn-sm" onclick="exportReport()" style="font-size:0.72rem;"><i class="bi bi-download"></i> Export</button>
        </div>
      </div>

      <!-- Stage navigator -->
      <div class="pd-stagebar mb-3">
        ${STAGES.map((st, i) => {
          const cur = stageOf(p);
          const active = st.key === cur;
          const done = STAGES.findIndex(s => s.key === cur) > i;
          return `<div class="pd-stage ${active ? 'active' : ''} ${done ? 'done' : ''}">
            <div class="pd-stage-dot">${done ? '<i class="bi bi-check-lg"></i>' : (i + 1)}</div>
            <div class="pd-stage-label">${st.label}</div>
          </div>`;
        }).join('<div class="pd-stage-sep"></div>')}
      </div>

      ${stageOf(p) === 'review' ? `
        <div class="pd-decision-bar">
          <div class="pd-decision-info">
            <i class="bi bi-info-circle-fill"></i>
            <div>
              <strong>Pending Review</strong>
              <div>Review the request below. Approve to start planning, reject to cancel, or request changes from the customer.</div>
            </div>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <button class="pd-btn success" onclick="verifyProject(this)"><i class="bi bi-check2-circle"></i> Approve Project</button>
            <button class="pd-btn" onclick="requestChanges(this)"><i class="bi bi-pencil-square"></i> Request Changes</button>
            <button class="pd-btn danger" onclick="changeStatus('cancelled',this)"><i class="bi bi-x-circle"></i> Reject</button>
          </div>
        </div>` : ''}

      ${stageOf(p) === 'planning' ? `
        <div class="pd-decision-bar planning">
          <div class="pd-decision-info">
            <i class="bi ${planningAllDone ? 'bi-check2-circle' : (teamDone && !allTeamAccepted ? 'bi-person-fill-lock' : 'bi-kanban')}"></i>
            <div>
              <strong>${planningAllDone ? 'All Planning Steps Complete' : (teamDone && !allTeamAccepted ? 'Awaiting Team Acceptance' : 'Project Planning')}</strong>
              <div>${planningAllDone
                ? 'Every prerequisite is satisfied. Click "Mark Project Ready" to notify technicians and begin work order execution.'
                : (teamDone && !allTeamAccepted
                  ? 'Team members must accept before planning can proceed.'
                  : 'Follow steps 1–6 in order. Each step unlocks the next.')}</div>
            </div>
          </div>
          <div class="d-flex gap-2 flex-wrap align-items-center">
            ${!planningAllDone ? `<span style="font-size:0.72rem;font-weight:600;color:${teamDone && !allTeamAccepted ? '#d97706' : '#b45309'};background:${teamDone && !allTeamAccepted ? '#fef3c7' : '#fef3c7'};padding:0.3rem 0.65rem;border-radius:6px;"><i class="bi ${teamDone && !allTeamAccepted ? 'bi-hourglass-split' : 'bi-info-circle'}"></i> ${teamDone && !allTeamAccepted ? 'Waiting for team acceptance' : 'Complete all steps above first'}</span>` : ''}
            <button class="pd-btn ${planningAllDone ? 'success' : 'primary'}" onclick="markReady(this)" ${!planningAllDone ? 'disabled' : ''} title="${!planningAllDone ? (teamDone && !allTeamAccepted ? 'Waiting for team acceptance' : 'Complete all planning steps first') : 'Mark project as ready'}"><i class="bi bi-flag"></i> Mark Project Ready</button>
          </div>
        </div>
        ${planningStepsHtml(p, workOrders, materials, planningAllDone)}` : ''}

      ${stageOf(p) === 'ready' ? `
        <div class="pd-decision-bar ready">
          <div class="pd-decision-info">
            <i class="bi bi-hourglass-split"></i>
            <div>
              <strong>Project Ready</strong>
              <div>Fully planned. When the team begins on-site work, click "Start Project".</div>
            </div>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <button class="pd-btn success" onclick="changeStatus('in_progress',this)"><i class="bi bi-play-fill"></i> Start Project</button>
          </div>
        </div>` : ''}

      ${stageOf(p) === 'completed' ? `
        <div class="pd-decision-bar completed">
          <div class="pd-decision-info">
            <i class="bi bi-check2-all"></i>
            <div>
              <strong>${p.status === 'closed' ? 'Project Closed' : 'Project Completed'}</strong>
              <div>${p.status === 'closed' ? 'Archived.' : 'All work done. Close to archive.'}</div>
            </div>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            ${p.status !== 'closed' ? `<button class="pd-btn primary" onclick="changeStatus('closed',this)"><i class="bi bi-archive"></i> Close Project</button>` : ''}
          </div>
        </div>` : ''}

      ${['cancelled','on_hold'].includes(p.status) ? `
        <div class="pd-decision-bar ${p.status}">
          <div class="pd-decision-info"><i class="bi bi-exclamation-triangle-fill"></i><div><strong>${p.status === 'cancelled' ? 'Cancelled' : 'On Hold'}</strong><div>${p.status === 'on_hold' ? 'Paused.' : 'Cancelled.'}</div></div></div>
          ${p.status === 'on_hold' ? `<button class="pd-btn" onclick="changeStatus('planning',this)"><i class="bi bi-arrow-counterclockwise"></i> Resume Planning</button>` : ''}
        </div>` : ''}

      <!-- ══ 3. PROJECT HEALTH DASHBOARD (after team accepts) ══ -->
      ${stageOf(p) !== 'review' ? `
        ${projectOverviewHtml(p, workOrders, dm)}
        <div class="row g-3" style="margin-bottom:0.875rem;">
          <div class="col-lg-6">${scheduleHealthHtml(p, workOrders, dm)}</div>
          <div class="col-lg-6">${recommendedActionsHtml(p, workOrders, dm)}</div>
        </div>` : ''}

      <!-- ══ 4. PLANNING STUDIO ══ -->
      ${stageOf(p) === 'planning' ? `
        <div class="pd-card" style="border:1.5px solid #e0e7ff;" data-stage="planning">
          <div class="pd-head"><h3><i class="bi bi-kanban me-2" style="color:#4f46e5;"></i>Planning Studio</h3></div>
          <div class="pd-body">${planningStudioHtml(p, workOrders, materials, planningAllDone)}</div>
        </div>` : ''}

      <!-- Team card (shown after planning, during execution) -->
      ${stageOf(p) !== 'review' && stageOf(p) !== 'planning' && p.assignedTechnicians?.length ? `
        <div class="pd-card" data-stage="ready active">
          <div class="pd-head d-flex justify-content-between">
            <h3><i class="bi bi-people me-2" style="color:#6366f1;"></i>Project Team</h3>
            <button class="pd-btn" style="font-size:0.72rem;" onclick="showTeamModal()"><i class="bi bi-plus-lg"></i> Manage</button>
          </div>
          <div class="pd-body">${teamCardBodyHtml(p, workOrders)}</div>
        </div>` : ''}

      ${p.isLargeScale && p.projectPhase ? `
      <!-- Large-Scale Project Phase: Inspection + Quotation Review -->
      <div class="pd-card" data-stage="active completed" style="border:1.5px solid ${p.projectPhase === 'quotation_review' ? '#f59e0b' : p.projectPhase === 'assessment' ? '#e0e7ff' : '#d1fae5'};">
        <div class="pd-head"><h3><i class="bi bi-diagram-3 me-2" style="color:#6366f1;"></i>Project Phase: <span class="cap-pill" style="font-size:0.7rem;background:${p.projectPhase === 'assessment' ? '#fef3c7' : p.projectPhase === 'quotation_review' ? '#e0f2fe' : '#d1fae5'};color:${p.projectPhase === 'assessment' ? '#92400e' : p.projectPhase === 'quotation_review' ? '#0369a1' : '#065f46'};">${p.projectPhase === 'assessment' ? 'Site Assessment' : p.projectPhase === 'quotation_review' ? 'Quotation Review' : 'Execution'}</span></h3>
          ${p.projectPhase === 'quotation_review' ? '<span class="cap-pill warn" style="font-size:0.7rem;">Awaiting your review</span>' : ''}
        </div>
        <div class="pd-body">
          ${p.inspectionReport?.submittedAt ? `
          <div class="sd-section">
