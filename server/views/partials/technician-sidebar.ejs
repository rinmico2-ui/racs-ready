<div class="sidebar" id="sidebar">
  <!-- Sidebar Header -->
  <div class="sidebar-header premium-card">
    <div class="admin-avatar">
      <i class="bi bi-person-badge"></i>
    </div>
    <div class="header-meta">
      <span class="workspace-badge">
        <i class="bi bi-tools me-1"></i>Service Team
      </span>
      <span class="admin-name">
        <%= technician.name || 'Technician' %>
      </span>
      <span class="admin-role">
        <span
          class="status-dot <%= (technician.availabilityStatus === 'Available' || technician.availabilityStatus === 'On The Way' || technician.availabilityStatus === 'In Progress') ? 'online' : 'offline' %>"></span>
        <%= technician.availabilityStatus || 'Offline' %>
      </span>
    </div>
  </div>

  <!-- Sidebar Navigation -->
  <ul class="sidebar-nav nav-list">

    <!-- Dashboard -->
    <li class="nav-section-label">Main</li>
    <li class="nav-item">
      <a href="/technician" class="nav-link">
        <i class="bi bi-grid-1x2 nav-icon"></i>
        <span class="nav-label">Dashboard</span>
        <span class="nav-tooltip">Dashboard</span>
      </a>
    </li>

    <!-- My Work (Assignments + Schedule merged) -->
    <li class="nav-section-label">Work</li>
    <li class="nav-item">
      <a href="/technician/assignments" class="nav-link">
        <i class="bi bi-clipboard-check nav-icon"></i>
        <span class="nav-label">Bookings</span>
        <span class="nav-badge" id="pendingBadge" style="display:none;">0</span>
        <span class="nav-tooltip">Bookings</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/technician/orders" class="nav-link">
        <i class="bi bi-box-seam nav-icon"></i>
        <span class="nav-label">Orders</span>
        <span class="nav-badge" id="ordersBadge" style="display:none;">0</span>
        <span class="nav-tooltip">Orders</span>
      </a>
    </li>

    <!-- Attendance -->
    <li class="nav-section-label">Attendance</li>
    <li class="nav-item">
      <a href="/technician/attendance" class="nav-link">
        <i class="bi bi-qr-code-scan nav-icon"></i>
        <span class="nav-label">Check In / Out</span>
        <span class="nav-tooltip">Check In / Out</span>
      </a>
    </li>

    <!-- Inventory & Expenses -->
    <li class="nav-section-label">Expenses</li>
    <li class="nav-item">
      <a href="/technician/expenses" class="nav-link">
        <i class="bi bi-receipt-cutoff nav-icon"></i>
        <span class="nav-label">Expenses</span>
        <span class="nav-badge" id="expenseBadge" style="display:none;">0</span>
        <span class="nav-tooltip">Expenses</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/technician/tools" class="nav-link">
        <i class="bi bi-tools nav-icon"></i>
        <span class="nav-label">My Tools</span>
        <span class="nav-tooltip">My Tools</span>
      </a>
    </li>

    <!-- Service Reports -->
    <li class="nav-section-label">Reports</li>
    <li class="nav-item">
      <a href="/technician/reports" class="nav-link">
        <i class="bi bi-file-earmark-text nav-icon"></i>
        <span class="nav-label">Service Reports</span>
        <span class="nav-badge" id="reportsBadge" style="display:none;">0</span>
        <span class="nav-tooltip">Service Reports</span>
      </a>
    </li>

    <!-- Live Tracking -->
    <li class="nav-section-label">Tracking</li>
    <li class="nav-item">
      <a href="/technician/tracking" class="nav-link">
        <i class="bi bi-geo-alt nav-icon"></i>
        <span class="nav-label">Live Tracking</span>
        <span class="nav-tooltip">Live Tracking</span>
      </a>
    </li>

    <!-- Analytics -->
    <li class="nav-item">
      <a href="/technician/analytics" class="nav-link">
        <i class="bi bi-bar-chart-line nav-icon"></i>
        <span class="nav-label">Analytics</span>
        <span class="nav-tooltip">Analytics</span>
      </a>
    </li>
  </ul>

</div>

<style>
  .nav-section-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #94a3b8;
    padding: 16px 20px 4px;
    margin: 0;
  }

  .nav-badge {
    background: #ef4444;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 10px;
    margin-left: auto;
    min-width: 18px;
    text-align: center;
    line-height: 1.2;
  }
</style>

<script>
  // Fetch all sidebar badge counts
  (async function () {
    try {
      const res = await fetch('/api/technician/badge-counts', { credentials: 'same-origin' });
      if (res.ok) {
        const data = await res.json();

        // Pending assignments badge
        const pendingBadge = document.getElementById('pendingBadge');
        if (pendingBadge && data.pendingAssignments > 0) {
          pendingBadge.textContent = data.pendingAssignments;
          pendingBadge.style.display = '';
        }

        // Pending orders badge
        const ordersBadge = document.getElementById('ordersBadge');
        if (ordersBadge && data.pendingOrders > 0) {
          ordersBadge.textContent = data.pendingOrders;
          ordersBadge.style.display = '';
        }

        // Pending expenses badge
        const expenseBadge = document.getElementById('expenseBadge');
        if (expenseBadge && data.pendingExpenses > 0) {
          expenseBadge.textContent = data.pendingExpenses;
          expenseBadge.style.display = '';
        }
      }
    } catch (e) { }

    // Draft reports badge
    try {
      const res2 = await fetch('/api/technician/reports?status=draft&limit=1');
      if (res2.ok) {
        const data2 = await res2.json();
        const badge2 = document.getElementById('reportsBadge');
        if (badge2 && data2.total > 0) {
          badge2.textContent = data2.total;
          badge2.style.display = '';
        }
      }
    } catch (e) { }
  })();

  // Refresh badges every 30s
  setInterval(async function () {
    try {
      const res = await fetch('/api/technician/badge-counts', { credentials: 'same-origin' });
      if (res.ok) {
        const data = await res.json();
        var pendingBadge = document.getElementById('pendingBadge');
        if (pendingBadge) {
          pendingBadge.textContent = data.pendingAssignments > 0 ? data.pendingAssignments : '';
          pendingBadge.style.display = data.pendingAssignments > 0 ? '' : 'none';
        }
        var scheduleBadge = document.getElementById('scheduleBadge');
        if (scheduleBadge) {
          scheduleBadge.textContent = data.todayJobs > 0 ? data.todayJobs : '';
          scheduleBadge.style.display = data.todayJobs > 0 ? '' : 'none';
        }
        var ordersBadge = document.getElementById('ordersBadge');
        if (ordersBadge) {
          ordersBadge.textContent = data.pendingOrders > 0 ? data.pendingOrders : '';
          ordersBadge.style.display = data.pendingOrders > 0 ? '' : 'none';
        }
        var expenseBadge = document.getElementById('expenseBadge');
        if (expenseBadge) {
          expenseBadge.textContent = data.pendingExpenses > 0 ? data.pendingExpenses : '';
          expenseBadge.style.display = data.pendingExpenses > 0 ? '' : 'none';
        }
      }
    } catch (e) { }
  }, 30000);
</script>