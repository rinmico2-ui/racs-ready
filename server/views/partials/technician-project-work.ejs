  window.pwRequestMaterial = function (projectId, woId) {
    const overlay = document.createElement('div'); overlay.className = 'pw-modal-overlay';
    overlay.innerHTML = `
      <div class="pw-modal">
        <h5 style="font-size:1rem;font-weight:800;margin-bottom:0.5rem;"><i class="bi bi-box-seam me-2" style="color:var(--pw-brand);"></i>Request Material</h5>
        <p style="font-size:.78rem;color:var(--pw-muted);margin-bottom:0.75rem;">Tell the admin what you've run out of. They'll arrange replenishment.</p>
        <label style="font-size:.75rem;font-weight:600;color:var(--pw-muted);">Material Needed</label>
        <input id="pwMatName" class="form-control form-control-sm mt-1" placeholder="e.g., Cleaning Solution">
        <label style="font-size:.75rem;font-weight:600;color:var(--pw-muted);" class="mt-2">Quantity</label>
        <input id="pwMatQty" type="number" class="form-control form-control-sm mt-1" min="1" value="1">
        <label style="font-size:.75rem;font-weight:600;color:var(--pw-muted);" class="mt-2">Reason</label>
        <textarea id="pwMatReason" class="form-control form-control-sm mt-1" rows="2" placeholder="e.g., Running low / out of stock"></textarea>
        <div class="d-flex gap-2 justify-content-end mt-3">
          <button class="pw-btn" onclick="this.closest('.pw-modal-overlay').remove()">Cancel</button>
          <button class="pw-btn primary" id="pwMatSave"><i class="bi bi-send"></i> Send Request</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);
    overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
    overlay.querySelector('#pwMatSave').addEventListener('click', async () => {
      const name = overlay.querySelector('#pwMatName').value.trim();
      const qty = parseInt(overlay.querySelector('#pwMatQty').value) || 1;
      const reason = overlay.querySelector('#pwMatReason').value.trim();
      if (!name) { toast('Enter the material needed', 'error'); return; }
      const payload = {
        projectId,
        workOrderId: woId,
        category: 'inventory',
        title: 'Material request: ' + name + ' x' + qty,
        description: (reason ? reason + ' ' : '') + '(Requested by technician on site)',
      };
      try {
        await api('/api/issues', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
        toast('Material request sent to admin'); overlay.remove();
      } catch (e) { toast(e.message, 'error'); }
