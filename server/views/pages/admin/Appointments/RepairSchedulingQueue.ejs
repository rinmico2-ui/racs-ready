            <div class="ent-detail-card-icon" style="background:#f0fdf4;color:#059669;"><i class="bi bi-box-seam"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Requested Parts</span>
              <span class="ent-detail-value" id="assignPartsList" style="font-weight:500;font-size:0.85rem;">-</span>
            </div>
          </div>
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon" style="background:#f0fdf4;color:#059669;"><i class="bi bi-clock-history"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Est. Duration</span>
              <span class="ent-detail-value" id="assignDuration">-</span>
              <span class="ent-detail-sub" id="assignComplexity"></span>
            </div>
          </div>
        </div>

        <!-- Original Inspector Info -->
        <div class="ent-detail-card ent-detail-card-wide mb-3" id="assignOriginalInspectorCard">
          <div class="ent-detail-card-icon" style="background:#f0fdf4;color:#22c55e;"><i class="bi bi-person-badge"></i></div>
          <div class="ent-detail-card-content">
            <span class="ent-detail-label">Original Inspector</span>
            <span class="ent-detail-value" id="assignOriginalInspector">-</span>
          </div>
