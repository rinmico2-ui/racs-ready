  .wa-time-area{margin-top:.75rem}.wa-time-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:.45rem}.wa-time-heading strong{font-size:.72rem;color:#334155}.wa-time-heading span{font-size:.61rem;color:#64748b}.wa-time-slots{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.4rem}.wa-time-slot{min-height:38px;border:1px solid #dbe3ee;border-radius:9px;background:#fff;color:#334155;font-size:.68rem;font-weight:750;transition:.16s ease}.wa-time-slot:hover{border-color:#60a5fa;background:#eff6ff;color:#1d4ed8}.wa-time-slot.active{border-color:#2563eb;background:#2563eb;color:#fff;box-shadow:0 4px 10px rgba(37,99,235,.2)}.wa-time-empty{grid-column:1/-1;padding:.7rem;border:1px dashed #cbd5e1;border-radius:9px;background:#f8fafc;color:#64748b;font-size:.67rem;text-align:center}.wa-time-group{grid-column:1/-1;margin-top:.2rem;color:#64748b;font-size:.59rem;font-weight:850;text-transform:uppercase;letter-spacing:.06em}.wa-schedule-summary{display:flex;gap:.55rem;align-items:flex-start;margin-top:.65rem;padding:.65rem;border-radius:9px;background:#ecfdf5;color:#166534;font-size:.68rem}.wa-schedule-summary i{margin-top:.05rem}.wa-schedule-summary strong{display:block;margin-bottom:.1rem}
  .wa-summary{padding:.75rem 1rem;background:#f8fafc;border-top:1px solid #edf2f7}.wa-sum-row{display:flex;justify-content:space-between;font-size:.74rem;color:#64748b;margin:.25rem 0}.wa-sum-row strong{color:#334155}.wa-sum-total{padding-top:.5rem;margin-top:.5rem;border-top:1px dashed #cbd5e1;font-size:.95rem;font-weight:850;color:#0f172a}.wa-submit{width:100%;border:0;border-radius:11px;padding:.75rem;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;font-size:.83rem;font-weight:800;box-shadow:0 5px 14px rgba(37,99,235,.2)}.wa-submit:disabled{opacity:.55;box-shadow:none}.wa-help{font-size:.66rem;color:#64748b;margin:.35rem 0 0}.wa-hidden{display:none!important}
  @media(max-width:1050px){.wa-layout{grid-template-columns:1fr}.wa-checkout{position:static}.wa-products{grid-template-columns:repeat(3,minmax(0,1fr))}}
