      configuredCoreHp = null;
      const section = document.getElementById("coreHpSection");
      const host = document.getElementById("coreHpOptions");
      section.classList.remove("d-none");
      host.innerHTML = "";
      const options = type?.hpPricing || [];
      if (!options.length) {
        host.innerHTML = '<div class="col-12 text-muted small">No HP pricing is configured for this aircon type.</div>';
        return;
      }
      options.forEach(option => {
        const col = document.createElement('div');
        col.className = 'col-12';
        const card = document.createElement('div');
        card.className = 'card hp-option-card border-2 bg-white shadow-sm';
        card.dataset.hp = option.hp;
        card.dataset.price = option.price;
        card.dataset.durationMinutes = option.durationMinutes || 60;
        card.dataset.description = option.description || '';
        card.style.cssText = 'border-radius:12px!important;transition:all .3s cubic-bezier(0.4,0,0.2,1)!important;border-color:#e5e7eb!important;cursor:pointer!important;position:relative!important;overflow:hidden!important;';
        card.innerHTML = `
          <div class="card-body p-4">
            <div class="row align-items-center">
              <div class="col-md-6">
                <div class="d-flex align-items-start">
                  <input class="hp-checkbox" type="checkbox" value="${option.hp}" data-price="${option.price}" style="width:1.25rem;height:1.25rem;margin-right:1rem;accent-color:#3b82f6;cursor:pointer;flex-shrink:0;">
                  <div class="flex-grow-1">
                    <div class="d-flex align-items-center mb-2 flex-wrap gap-2">
                      <span class="badge bg-primary rounded-pill px-3 py-2">${option.hp} HP</span>
                      <div class="text-primary fw-bold fs-5">₱${Number(option.price || 0).toLocaleString()}</div>
                    </div>
                    <div class="text-muted small"><i class="bi bi-clock me-1"></i>${option.durationMinutes || 60} minutes</div>
                    ${option.description ? `<div class="text-muted small mt-1">${option.description}</div>` : ''}
                    <div class="mt-2"><span class="badge bg-info bg-opacity-10 text-info">${type.name || type.type}</span></div>
                  </div>
                </div>
              </div>
              <div class="col-md-6 mt-3 mt-md-0">
                <div class="hp-quantity-control text-center text-md-start">
                  <label class="form-label fw-semibold text-dark mb-2" style="font-size:.85rem;">Quantity:</label>
                  <div class="cfg-stepper d-inline-flex">
                    <button class="hp-qty-minus" type="button" disabled style="border-radius:8px 0 0 8px;"><i class="bi bi-dash"></i></button>
                    <input type="number" class="hp-qty-input" value="1" min="1" max="40" readonly disabled style="background:#f8fafc;">
                    <button class="hp-qty-plus" type="button" disabled style="border-radius:0 8px 8px 0;"><i class="bi bi-plus"></i></button>
                  </div>
                  <div class="text-muted small mt-2 text-center text-md-start"><span class="hp-qty-price">₱${Number(option.price || 0).toLocaleString()}</span> per unit</div>
                </div>
              </div>
            </div>
          </div>`;
        col.appendChild(card);
        host.appendChild(col);
        setupHpCard(card, option, type);
      });

      const step1 = document.getElementById("cfgStep1");
      const step2 = document.getElementById("cfgStep2");
      if (step1 && step2) {
        step1.classList.remove("is-active");
        step1.classList.add("is-done");
        step2.classList.add("is-active");
        step2.classList.remove("is-done");
      }

      setTimeout(() => section.scrollIntoView({ behavior: 'smooth', block: 'start' }), 0);
      updateCoreConfigurationPrice();
    }

    function renderCoreConfigurator(service) {
      configuredCoreAirconType = null; configuredCoreHp = null;
      const typeIcons = {
        split: 'bi-columns-gap',
        window: 'bi-window',
        floor_mounted: 'bi-box',
        floor_standing: 'bi-door-closed',
        split_suspended: 'bi-arrow-down-circle',
        cassette: 'bi-grid-3x3',
        central: 'bi-building'
      };
      const typeDescriptions = {
        split: 'Wall-mounted indoor + outdoor units',
        window: 'Self-contained window units',
        floor_mounted: 'Floor-standing units',
        floor_standing: 'Freestanding floor-standing units',
        split_suspended: 'Ceiling-suspended units',
        cassette: 'Ceiling cassette for commercial',
        central: 'Centralized ducted system'
      };

      document.getElementById("coreConfigServiceName").textContent = service.name || "Core Service";
      const descEl = document.getElementById("coreConfigDescription");
      descEl.textContent = service.description || "";
      descEl.classList.toggle("d-none", !service.description);

      const wizard = document.getElementById("coreAirconWizard");
      const brandSection = document.getElementById("coreBrandSection");
      const isAircon = Boolean(service.isAirconService && ((service.airconTypes || []).length || (service.hpPricing || []).length));
      wizard.classList.toggle("d-none", !isAircon);
      brandSection.classList.toggle("d-none", !isAircon);
      document.getElementById("coreHpSection").classList.add("d-none");
      document.getElementById("coreAirconTypes").innerHTML = "";
      document.getElementById("coreHpOptions").innerHTML = "";

      const qtySection = document.getElementById("configQuantitySection");
      if (qtySection) qtySection.classList.toggle("d-none", isAircon);

      const step1 = document.getElementById("cfgStep1");
      const step2 = document.getElementById("cfgStep2");
      if (step1 && step2) {
        step1.classList.add("is-active");
        step1.classList.remove("is-done");
        step2.classList.remove("is-active");
        step2.classList.remove("is-done");
      }

      if (isAircon) {
        const types = (service.airconTypes || []).length ? service.airconTypes : [{ type: "aircon", name: "Air Conditioning", hpPricing: service.hpPricing || [] }];
        document.getElementById("coreAirconTypes").dataset.types = JSON.stringify(types);
        document.getElementById("coreAirconTypes").innerHTML = types.map((type, index) => {
          const minPrice = Math.min(...(type.hpPricing || []).map(hp => hp.price || 0));
          const maxPrice = Math.max(...(type.hpPricing || []).map(hp => hp.price || 0));
          const hpCount = (type.hpPricing || []).length;
          const icon = typeIcons[type.type] || 'bi-fan';
          const desc = typeDescriptions[type.type] || type.description || '';
          return `<div class="col-6 col-md-4"><button type="button" class="aircon-type-card core-aircon-type w-100 h-100" data-index="${index}"><i class="bi ${icon} d-block fs-2 mb-2 text-primary"></i><strong class="d-block mb-1">${type.name || type.type}</strong><span class="d-block text-muted small mb-2" style="font-size:0.75rem;">${desc}</span><div class="d-flex justify-content-center align-items-center gap-2 mb-2"><span class="badge bg-success bg-opacity-10 text-success">₱${minPrice.toLocaleString()} - ₱${maxPrice.toLocaleString()}</span></div><div class="text-muted" style="font-size:0.7rem;">${hpCount} HP options available</div></button></div>`;
        }).join('');
        const brand = document.getElementById("coreBrand");
        brand.innerHTML = '<option value="">Select brand…</option>' + (service.brands || []).map(value => `<option value="${value}">${value}</option>`).join('') + '<option value="__custom">Other / Custom</option>';
      }

      document.getElementById("configQuantity").value = 1;
      updateCoreConfigurationPrice();
    }

    function configureService(service, type, inline = false) {
      if (!service) return;
      document.getElementById("configServiceId").value = service._id;
      document.getElementById("configServiceType").value = type;
      document.getElementById("serviceConfigTitle").textContent = type === "repair" ? "Repair Service Configuration" : "Configure Service";
      document.getElementById("configQuantity").value = 1;
      document.getElementById("repairConfigQuantity").value = 1;
      document.getElementById("configBrand").value = "";
      document.getElementById("configModel").value = "";
      document.getElementById("configProblem").value = "";
      document.getElementById("walkinRepairCharCount").textContent = "0 / 500";
      document.getElementById("configRepairPhotos").value = "";
      document.getElementById("configRepairPhotoPreview").innerHTML = "";
      document.getElementById("serviceConfigSubtitle").textContent = type === "repair" ? "Configure your repair request step by step. Our technician will be prepared with the right tools and parts." : "Select aircon type & HP rating";
      document.getElementById("priceLabel").textContent = type === "repair" ? "Inspection Fee" : "Estimated Price";
      document.getElementById("priceSub").textContent = type === "repair" ? "Diagnosis only; final repair is quoted after inspection" : "Configured service total";
      configuredRepairCategory = ""; configuredRepairUnitType = ""; configuredRepairPhotos = [];
      document.querySelectorAll(".repair-category,.repair-symptom,.repair-unit-type").forEach(el => el.classList.remove("selected", "active"));
      document.getElementById("walkinUnitTypes").innerHTML = '<span class="small text-muted">Select a category first.</span>';
      document.querySelectorAll(".repair-config").forEach(el => el.classList.toggle("d-none", type !== "repair"));
      document.querySelectorAll(".core-config").forEach(el => el.classList.toggle("d-none", type !== "core"));
      if (type === "core") renderCoreConfigurator(service);
      else {
        document.getElementById("coreAirconWizard").classList.add("d-none");
        updateRepairConfigurationPrice();
      }

      const modal = document.getElementById("serviceConfigModal");
      const content = document.getElementById("serviceConfigContent");
      const close = content.querySelector(".cfg-close");
      const cancel = content.querySelector(".modal-footer .cfg-btn-ghost");
      const save = document.getElementById("saveConfiguredService");
      if (inline) {
        document.getElementById("repairInlineConfigurator").appendChild(content);
        content.classList.add("border");
        close.classList.add("d-none");
        cancel.classList.add("d-none");
        save.innerHTML = '<i class="bi bi-plus-circle me-1"></i>Add Repair Service';
      } else {
        modal.querySelector(".modal-dialog").appendChild(content);
        content.classList.remove("border");
        close.classList.remove("d-none");
        cancel.classList.remove("d-none");
        save.innerHTML = '<i class="bi bi-check-lg me-2"></i>Add to Booking';
        bootstrap.Modal.getOrCreateInstance(modal).show();
      }
    }

    function mountInlineRepairConfigurator(forceReset = false) {
      const service = state.repairServices[0];
      const host = document.getElementById("repairInlineConfigurator");
      const content = document.getElementById("serviceConfigContent");
      if (!forceReset && host.contains(content) && document.getElementById("configServiceType").value === "repair") return;
      if (service) configureService(service, "repair", true);
      else document.getElementById("repairInlineConfigurator").innerHTML = '<div class="alert alert-info">No active repair service configuration is available.</div>';
    }

    function selectRepairCategory(category) {
      configuredRepairCategory = category;
      configuredRepairUnitType = "";
      document.querySelectorAll(".repair-category").forEach(button => button.classList.toggle("selected", button.dataset.category === category));
      const host = document.getElementById("walkinUnitTypes");
      const record = repairCategoryRecords().find(item => String(item.slug) === String(category));
      const unitTypes = (record?.unitTypes || []).map(item => typeof item === "string" ? { value: item, label: item } : item);
      host.innerHTML = record?.isCustom || category === "other"
        ? '<input type="text" id="customRepairUnitType" maxlength="100" class="cfg-f" placeholder="Describe the equipment type">'
        : unitTypes.map(type => `<button type="button" class="unit-type-chip repair-unit-type" data-unit-type="${escapeMarkup(type.value || type.label)}"><i class="bi ${safeCssClasses(type.icon, "bi-circle")} me-1"></i>${escapeMarkup(type.label || type.value)}</button>`).join("");
    }
    function handleServiceCardClick(e) {
      const btn = e.target.closest(".add-service-btn[data-service-id]");
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      const id = btn.getAttribute("data-service-id") || "";
      const type = btn.getAttribute("data-service-type") || "core";
      const catalog = type === "repair" ? state.repairServices : state.coreServices;
      const service = catalog.find(item => String(item._id) === String(id));
      if (!service) return;
      configureService(service, type, false);
    }
    if (coreCardsEl) coreCardsEl.addEventListener("click", handleServiceCardClick);
    if (repairCardsEl) repairCardsEl.addEventListener("click", handleServiceCardClick);
    document.getElementById("repair-tab")?.addEventListener("shown.bs.tab", () => mountInlineRepairConfigurator(false));

    document.getElementById("walkinRepairCategories")?.addEventListener("click", e => { const button = e.target.closest(".repair-category"); if (button) selectRepairCategory(button.dataset.category); });
    document.getElementById("coreAirconTypes")?.addEventListener("click", e => {
      const button = e.target.closest(".core-aircon-type"); if (!button) return;
      const types = JSON.parse(document.getElementById("coreAirconTypes").dataset.types || "[]");
      configuredCoreAirconType = types[Number(button.dataset.index)];
      document.querySelectorAll(".core-aircon-type").forEach(el => el.classList.toggle("selected", el === button));
      renderCoreHpOptions(configuredCoreAirconType);
    });
    document.getElementById("coreBrand")?.addEventListener("change", () => {
      const custom = document.getElementById("coreBrandCustom");
      if (document.getElementById("coreBrand").value === "__custom") {
        custom?.classList.remove("d-none");
        custom?.focus();
      } else {
        custom?.classList.add("d-none");
        if (custom) custom.value = "";
      }
    });
    document.getElementById("configQuantity")?.addEventListener("input", updateCoreConfigurationPrice);
    document.getElementById("configQtyMinus")?.addEventListener("click", () => { const input = document.getElementById("configQuantity"); if (input) { input.value = Math.max(1, Number(input.value) - 1); updateCoreConfigurationPrice(); } });
    document.getElementById("configQtyPlus")?.addEventListener("click", () => { const input = document.getElementById("configQuantity"); if (input) { input.value = Math.min(40, Number(input.value) + 1); updateCoreConfigurationPrice(); } });
    document.getElementById("repairConfigQtyMinus")?.addEventListener("click", () => { const input = document.getElementById("repairConfigQuantity"); if (input) { input.value = Math.max(1, Number(input.value) - 1); updateRepairConfigurationPrice(); } });
    document.getElementById("repairConfigQtyPlus")?.addEventListener("click", () => { const input = document.getElementById("repairConfigQuantity"); if (input) { input.value = Math.min(40, Number(input.value) + 1); updateRepairConfigurationPrice(); } });
    document.getElementById("walkinUnitTypes")?.addEventListener("click", e => { const button = e.target.closest(".repair-unit-type"); if (!button) return;      configuredRepairUnitType = button.dataset.unitType; document.querySelectorAll(".repair-unit-type").forEach(el => el.classList.toggle("active", el === button)); });
    document.getElementById("walkinUnitTypes")?.addEventListener("input", e => { if (e.target.id === "customRepairUnitType") configuredRepairUnitType = e.target.value.trim(); });
    document.getElementById("walkinSymptomChips")?.addEventListener("click", event => {
      const button = event.target.closest(".repair-symptom");
      if (!button) return;
      button.classList.toggle("active");
      const textarea = document.getElementById("configProblem");
      const symptom = button.dataset.symptom || "";
      const current = textarea.value.trim();
      if (button.classList.contains("active")) {
        if (!current.includes(symptom)) textarea.value = current ? `${current}, ${symptom}` : symptom;
      } else {
        const escaped = symptom.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        textarea.value = current
          .replace(new RegExp(`,?\\s*${escaped}`), "")
          .replace(/^,\s*/, "")
          .trim();
      }
      document.getElementById("walkinRepairCharCount").textContent = `${textarea.value.length} / 500`;
    });

    document.getElementById("locateCompanyBtn")?.addEventListener("click", () => {
      if (!state.map || !state.markers.tech) return;
      state.map.setView(state.markers.tech.getLatLng(), 16);
      state.markers.tech.openPopup();
    });
    document.getElementById("focusCustomerBtn")?.addEventListener("click", () => {
      if (!state.map || !state.markers.customer) return showWarn("Select the service location first.");
      state.map.setView(state.markers.customer.getLatLng(), 16);
      state.markers.customer.openPopup();
    });
    document.getElementById("fitServiceRouteBtn")?.addEventListener("click", () => {
      if (!state.map) return;
      if (state.route?.getBounds && state.route.getBounds().isValid()) {
        state.map.fitBounds(state.route.getBounds(), { padding: [50, 50], maxZoom: 16 });
      } else if (state.markers.tech && state.markers.customer) {
        state.map.fitBounds(L.featureGroup([state.markers.tech, state.markers.customer]).getBounds(), { padding: [50, 50], maxZoom: 16 });
      }
    });
    document.getElementById("expandServiceMapBtn")?.addEventListener("click", event => {
      const card = document.getElementById("serviceCheckoutMapCard");
      if (card) {
        const expanded = card.classList.toggle("map-expanded");
        event.currentTarget.innerHTML = expanded
          ? '<i class="bi bi-fullscreen-exit"></i><span>Collapse</span>'
          : '<i class="bi bi-fullscreen"></i><span>Expand</span>';
        setTimeout(() => state.map?.invalidateSize(), 280);
      }
    });
    document.getElementById("configProblem")?.addEventListener("input", e => { const el = document.getElementById("walkinRepairCharCount"); if (el) el.textContent = `${e.target.value.length} / 500`; });
    function previewRepairPhotos(fileList) {
      const input = document.getElementById("configRepairPhotos");
      const files = Array.from(fileList || []).slice(0, 5);
      const invalid = files.find(file => file.size > 5 * 1024 * 1024 || !/^image\/(jpeg|png|webp)$/.test(file.type));
      if (invalid) { input.value = ""; return showWarn("Photos must be JPG, PNG, or WebP and no larger than 5 MB each."); }
      const preview = document.getElementById("configRepairPhotoPreview"); preview.innerHTML = "";
      files.forEach(file => { const img = document.createElement("img"); img.src = URL.createObjectURL(file); img.style.cssText = "width:72px;height:72px;object-fit:cover;border-radius:10px;border:1px solid #e2e8f0"; preview.appendChild(img); });
      return true;
    }
    const repairPhotoInput = document.getElementById("configRepairPhotos");
    const repairPhotoZone = document.getElementById("walkinRepairPhotoUploadZone");
    if (repairPhotoInput) repairPhotoInput.addEventListener("change", event => previewRepairPhotos(event.target.files));
    if (repairPhotoZone) {
      repairPhotoZone.addEventListener("click", event => { if (event.target !== repairPhotoInput) repairPhotoInput?.click(); });
      repairPhotoZone.addEventListener("keydown", event => { if (event.key === "Enter" || event.key === " ") { event.preventDefault(); repairPhotoInput?.click(); } });
      repairPhotoZone.addEventListener("dragover", event => { event.preventDefault(); repairPhotoZone.classList.add("dragover"); });
      repairPhotoZone.addEventListener("dragleave", () => repairPhotoZone.classList.remove("dragover"));
    repairPhotoZone.addEventListener("drop", event => {
      event.preventDefault();
      repairPhotoZone.classList.remove("dragover");
      const files = Array.from(event.dataTransfer?.files || []).slice(0, 5);
      if (!files.length || !previewRepairPhotos(files)) return;
      const transfer = new DataTransfer();
      files.forEach(file => transfer.items.add(file));
      repairPhotoInput.files = transfer.files;
    });

    document.getElementById("saveConfiguredService")?.addEventListener("click", async () => {
      const id = document.getElementById("configServiceId").value;
      const type = document.getElementById("configServiceType").value;
      const quantityInput = type === "repair" ? document.getElementById("repairConfigQuantity") : document.getElementById("configQuantity");
      const quantity = Math.max(1, Number(quantityInput.value) || 1);
      if (totalBookedUnits() + quantity > 40) return showWarn("The maximum is 40 units per booking.");
      const catalog = type === "repair" ? state.repairServices : state.coreServices;
      const service = catalog.find(item => String(item._id) === String(id));
      const problemDescription = document.getElementById("configProblem").value.trim();
      if (type === "repair" && !configuredRepairCategory) return showWarn("Select a repair service category.");
      if (type === "repair" && !configuredRepairUnitType) return showWarn("Select the specific unit type.");
      if (type === "repair" && !document.getElementById("configBrand").value.trim()) return showWarn("Brand is required for repair services.");
      if (type === "repair" && problemDescription.length < 10) return showWarn("Enter a repair problem description of at least 10 characters.");
      const isCoreAircon = type === "core" && service?.isAirconService && ((service.airconTypes || []).length || (service.hpPricing || []).length);
      if (isCoreAircon && !configuredCoreAirconType) return showWarn("Select the aircon type.");
      if (isCoreAircon && !configuredCoreHp) return showWarn("Select the HP rating.");
      const coreBrandSelect = document.getElementById("coreBrand");
      const coreBrand = coreBrandSelect.value === "__custom" ? document.getElementById("coreBrandCustom").value.trim() : coreBrandSelect.value;
      if (isCoreAircon && !coreBrand) return showWarn("Select or enter the aircon brand.");
      if (type === "repair" && document.getElementById("configRepairPhotos").files.length) {
        const uploadData = new FormData(); Array.from(document.getElementById("configRepairPhotos").files).slice(0, 5).forEach(file => uploadData.append("photos", file));
        const uploadResponse = await fetch("/api/appointments/walk-in/upload-repair-photos", { method: "POST", credentials: "same-origin", body: uploadData });
        const uploaded = await uploadResponse.json(); if (!uploadResponse.ok) return showWarn(uploaded.error || "Repair photos could not be uploaded."); configuredRepairPhotos = uploaded.urls || [];
      }
      const unitPrice = Number(type === "core" && configuredCoreHp
        ? configuredCoreHp.price
        : type === "repair"
          ? (service?.initialPrice ?? service?.basePrice ?? 0)
          : (service?.basePrice ?? 0));
      state.selectedServices.push({ serviceId: id, name: type === "repair" ? `${configuredRepairUnitType} Repair` : (service?.name || "Service"), type, quantity, unitPrice, totalPrice: unitPrice * quantity,
        duration: Number(configuredCoreHp?.durationMinutes || service?.durationMinutes || service?.estimatedDurationMinutes || 60) * quantity,
        model: document.getElementById("configModel").value.trim(),
        hp: configuredCoreHp?.hp, hpDescription: configuredCoreHp ? `${configuredCoreHp.hp} HP` : "",
        airconType: configuredCoreAirconType?.type, airconTypeName: configuredCoreAirconType?.name,
        brand: type === "core" ? coreBrand : document.getElementById("configBrand").value.trim(),
        unitCategory: configuredRepairCategory, applianceType: type === "core" ? configuredCoreAirconType?.type : configuredRepairUnitType, applianceTypeName: type === "core" ? configuredCoreAirconType?.name : configuredRepairUnitType,
        symptoms: Array.from(document.querySelectorAll(".repair-symptom.active")).map(button => button.dataset.symptom), photos: configuredRepairPhotos, problemDescription });
      state.selectedDate = null; state.selectedStartMinutes = null;
      bootstrap.Modal.getInstance(document.getElementById("serviceConfigModal"))?.hide();
      renderServiceCards();
      if (type === "repair") mountInlineRepairConfigurator(true);
    });

    document.getElementById("selectedServicesList")?.addEventListener("click", e => {
      const remove = e.target.closest(".remove-service");
      if (!remove) return;
      state.selectedServices.splice(Number(remove.dataset.index), 1);
      state.selectedDate = null; state.selectedStartMinutes = null;
      renderServiceCards();
    });

    techEl.addEventListener("change", async () => {
      state.selectedDate = null;
      state.selectedStartMinutes = null;
      state.enterpriseCalendarSignature = "";
      await fetchTechLocation();
      await renderCalendar();
      updateSummary();
    });

    document.querySelectorAll(".payment-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        document
          .querySelectorAll(".payment-tab")
          .forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");
        const mode = tab.getAttribute("data-cash-mode") || "downpayment";
        state.cashPaymentMode = mode === "full" ? "full" : "downpayment";
        state.paymentMethod = "cod";
        document.getElementById("payCod").value = "cod";
        syncCashAmountInput();
        updateSummary();
      });
    });

    document.getElementById("checkCustomerBtn")?.addEventListener("click", checkCustomerEmail);
    document.getElementById("customerEmail")?.addEventListener("input", () => {
      const email = document.getElementById("customerEmail").value.trim().toLowerCase();
      if (email === state.customerLookupEmail) return;
      state.customerLookupEmail = "";
      state.customerAccountFound = false;
      state.isNewCustomer = null;
      state.customerAccountState = "unchecked";
      document.getElementById("accountConsent").checked = false;
      clearCustomerDetails();
      adjustCustomerDetailsStep();
      setCustomerLookupStatus("Email changed. Find the customer again before continuing.", "info");
    });

    document.querySelectorAll("[data-next-step]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const target = Number(btn.getAttribute("data-next-step"));
        if (!validateStep(state.currentStep)) return;
        if (state.currentStep === 0 && target === 1) {
          if (!(await checkCustomerEmail())) return;
          if (!validateStep(0)) return;
        }
        if (target === 3) {
          await renderCalendar();
        }
        goToStep(target);
      });
    });

    document.querySelectorAll("[data-prev-step]").forEach((btn) => {
      btn.addEventListener("click", () => {
        goToStep(Number(btn.getAttribute("data-prev-step")));
        hideAlert();
      });
    });

    document.querySelectorAll(".ent-n[data-step]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const target = Number(btn.getAttribute("data-step"));
        if (target > state.maxReachedStep) {
          showWarn("Complete the current step before moving ahead.");
          return;
        }
        if (target > state.currentStep && !validateStep(state.currentStep))
          return;
        if (state.currentStep === 0 && target >= 1) {
          if (!(await checkCustomerEmail())) return;
        }
        if (target === 3) {
          await renderCalendar();
        }
        goToStep(target);
      });
    });

    form.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && e.target.tagName !== "TEXTAREA" && state.currentStep !== 6) {
        e.preventDefault();
        e.stopPropagation();
      }
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideAlert();

      if (state.currentStep !== 6) return;

      for (const s of [1, 2, 3, 4, 5]) {
        if (!validateStep(s)) {
          goToStep(s);
          return;
        }
      }

      const svc = currentService();
      const customerEmailFieldValue = document.getElementById("customerEmail").value.trim();
      console.log("[FRONTEND] Submitting with email:", customerEmailFieldValue, "isNewCustomer:", state.isNewCustomer);
      
      const payload = {
        firstName: document.getElementById("firstName").value.trim(),
        lastName: document.getElementById("lastName").value.trim(),
        customerPhone: document.getElementById("customerPhone").value.trim(),
        customerEmail: customerEmailFieldValue,
        isNewCustomer: state.isNewCustomer,
        accountConsent: document.getElementById("accountConsent").checked,
        address: {
          province: document.getElementById("addrProvince").value.trim(),
          city: document.getElementById("addrCity").value.trim(),
          barangay: document.getElementById("addrBarangay").value.trim(),
          postalCode: document.getElementById("addrPostalCode").value.trim(),
        },
        customerLocation: state.customerCoords
          ? {
              lat: state.customerCoords.lat,
              lng: state.customerCoords.lng,
              address:
                locationInputEl.value.trim() ||
                document.getElementById("addrCity").value.trim(),
            }
          : undefined,
        serviceId: state.selectedServiceId,
        services: state.selectedServices,
        technicianId: isLargeScaleSelection() ? undefined : techEl.value,
        date: formatDateKey(state.selectedDate),
        startTime: state.projectScheduling ? "08:00" : minutesToHHMM(state.selectedStartMinutes),
        projectScheduling: state.projectScheduling,
        issueDescription: document
          .getElementById("issueDescription")
          .value.trim(),
        paymentMethod: "cod",
        cashPaymentMode: state.cashPaymentMode,

        downpaymentAmount: Number(
          document.getElementById("downpaymentAmount").value,
        ),
        travelFare: state.travelFare,
        travelTime: state.travelTime,
        estimatedFee: Number(
          (
            servicesSubtotal() + Number(state.travelFare || 0)
          ).toFixed(2),
        ),
      };
      // auto-generate reference if not provided
      // always auto‑generate a reference (field removed from UI)
      payload.paymentReference = `OR-${Date.now()}`;

      saveBtn.disabled = true;
      saveBtn.innerHTML =
        '<span class="spinner-border spinner-border-sm me-1"></span>Creating…';

      try {
        const r = await fetch("/api/appointments/walk-in", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify(payload),
        });
        const d = await r.json();
        if (!r.ok)
          throw new Error(d.error || "Failed to create walk-in appointment");

        console.log("walk-in response customer", d.customer);
        const ref =
          (d.appointment && d.appointment.bookingReference) || "(no reference)";
        let accountMsg = "";
        let bookingMsg = "";
        
        if (d.customerAccountCreated && d.customer) {
          accountMsg = ` A secure invited account was created for <strong>${escapeMarkup(d.customer.email)}</strong>. The customer must verify the email and choose their own password.`;
        } else if (!d.customerAccountCreated && d.customer) {
          accountMsg = ` The appointment was linked to the existing customer account for <strong>${escapeMarkup(d.customer.email)}</strong>.`;
        }
        if (d.customerAccount?.invitationDelivery === "accepted") {
          bookingMsg = ` The account and appointment email was accepted by the email provider.`;
        } else if (d.customerAccount?.invitationDelivery === "failed") {
          bookingMsg = ` <strong>The appointment was created, but the email could not be delivered.</strong> Verify the address before attempting account recovery.`;
        } else if (d.customerAccount?.state === "pending_verification") {
          bookingMsg = ` The existing registration still requires email verification.`;
        }
        
        showAlert("success", `Walk-in appointment created successfully. Reference: <strong>${ref}</strong>.${accountMsg}${bookingMsg}`);

        form.reset();
        state.paymentMethod = "cod";
        state.cashPaymentMode = "downpayment";
        state.selectedDate = null;
        state.selectedStartMinutes = null;
        state.travelFare = 0;
        state.travelTime = 0;
        state.customerCoords = null;
        state.isNewCustomer = null;
        state.customerLookupEmail = "";
        state.customerAccountFound = false;
        state.customerAccountState = "unchecked";
        state.maxReachedStep = 0;
        state.selectedServices = [];
        state.enterpriseCalendarSignature = "";
        state.projectScheduling = null;
        if (state.markers.customer && state.map) {
          state.map.removeLayer(state.markers.customer);
          state.markers.customer = null;
        }
        if (state.route && state.map) {
          state.map.removeLayer(state.route);
          state.route = null;
        }
        document
          .querySelectorAll(".payment-tab")
          .forEach((t) =>
            t.classList.toggle(
              "active",
              t.getAttribute("data-cash-mode") === "downpayment",
            ),
          );
        document.getElementById("payCod").value = "cod";
        serviceTypeEl.value = "core";
        document
          .querySelectorAll(".category-btn")
          .forEach((item) =>
            item.classList.toggle(
              "active",
              item.getAttribute("data-category") === "core",
            ),
          );
        state.selectedServiceId = "";
        document.getElementById("accountConsent").checked = false;
        adjustCustomerDetailsStep();
        setCustomerLookupStatus("No account selected. Search by email before continuing.", "info");
        locationInputEl.value = "";
        serviceMapSelectionEl?.classList.remove("has-location");
        const selectionStatus = document.getElementById("serviceMapSelectionStatus");
        const selectionAddress = document.getElementById("serviceMapAddress");
        const selectionCoordinates = document.getElementById("serviceMapCoordinates");
        const selectionSource = document.getElementById("serviceMapSource");
        const fitRouteButton = document.getElementById("fitServiceRouteBtn");
        if (selectionStatus) selectionStatus.textContent = "Location not pinned";
        if (selectionAddress) selectionAddress.textContent = "Search, use GPS, or click the map to set the service address.";
        if (selectionCoordinates) selectionCoordinates.textContent = "—";
        if (selectionSource) selectionSource.textContent = "Waiting for selection";
        if (fitRouteButton) fitRouteButton.disabled = true;
        if (mapInfoDistanceEl) mapInfoDistanceEl.textContent = "—";
        if (mapInfoDurationEl) mapInfoDurationEl.textContent = "—";
        if (mapInfoFareEl) mapInfoFareEl.textContent = "—";
        if (serviceRouteMethodEl) serviceRouteMethodEl.textContent = "Waiting for a confirmed service location";
        mapDistanceInfoEl.textContent =
          "Distance and ETA will appear here after setting location.";
        setLocationStatus(
          "Set customer location to compute travel fare and available slots.",
          "muted",
        );
        await renderCalendar();
        renderServiceCards();
        renderRepairCategories();
        mountInlineRepairConfigurator(true);
        renderTechnicians();
        syncCashAmountInput();
        goToStep(0);
        updateSummary();
      } catch (err) {
        showAlert("danger", err.message || "Create failed");
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML =
          '<i class="bi bi-check2-circle me-1"></i>Create Walk-in Appointment';
      }
    });

    (async function init() {
      try {
        await Promise.all([loadFarePerKm(), loadBookingPolicy(), loadCompanyLocation(), loadOptions()]);
        updateTechnicianSelectionMode();
        await renderCalendar();
        syncCashAmountInput();
        goToStep(0);
      } catch (err) {
        showAlert(
          "danger",
          err.message || "Failed to initialize walk-in page.",
        );
      }
    })();
  })();
</script>
