    .dash-meta-item { display:flex; flex-direction:column; background:#fff; border:1px solid #f1f5f9; border-radius:8px; padding:0.5rem 0.65rem; }
    .dash-meta-item .dmk { font-size:0.62rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#94a3b8; margin-bottom:0.15rem; }
