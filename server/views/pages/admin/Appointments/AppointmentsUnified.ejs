  .dv2-hero-amount { font-family:'Inter', sans-serif; font-size:1.25rem; font-weight:700; color:#0f172a; line-height:1; }
  .dv2-grid { display:grid; grid-template-columns:repeat(2, 1fr); gap:14px; }
  .dv2-card { background:#fff; border:1px solid #e2e8f0; border-radius:16px; padding:18px; display:flex; align-items:flex-start; gap:14px; box-shadow:0 1px 2px rgba(0,0,0,0.04); }
  .dv2-card-wide { grid-column:span 2; }
  .dv2-card-icon { width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; }
  .dv2-card-content { display:flex; flex-direction:column; gap:3px; min-width:0; flex:1; }
  .dv2-label { font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#94a3b8; }
  .dv2-value { font-family:'Inter', sans-serif; font-size:0.9rem; font-weight:700; color:#0f172a; line-height:1.35; }
  .dv2-sub { font-size:0.8rem; color:#64748b; line-height:1.4; }
  .dv2-payment-row { display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid #f1f5f9; }
  .dv2-payment-row:last-child { border-bottom:none; }
  .dv2-payment-label { font-size:0.82rem; color:#64748b; }
  .dv2-payment-value { font-family:'Inter', sans-serif; font-size:0.9rem; font-weight:700; color:#0f172a; }
  .dv2-photo-strip { display:flex; gap:10px; overflow-x:auto; padding:4px 0; }
  .dv2-photo-item { background:#f8fafc; padding:6px; border-radius:10px; border:1px solid #e2e8f0; flex:0 0 auto; text-align:center; display:flex; flex-direction:column; }
  .dv2-photo-thumb { max-height:120px; max-width:150px; border-radius:8px; object-fit:cover; cursor:pointer; display:block; margin:0 auto; }
  .dv2-photo-caption { font-size:0.68rem; color:#94a3b8; margin-top:4px; }
  @media (max-width: 767px) { .dv2-grid { grid-template-columns:1fr; } .dv2-card-wide { grid-column:span 1; } .dv2-hero { flex-direction:column; } .dv2-hero-side { text-align:left; align-items:flex-start; } }

  /* ═══ AUDIT TRAIL TIMELINE ═══ */
  .at-wrap { padding:4px 0 0; }
  .at-item { position:relative; padding:0 0 18px 30px; }
  .at-item::before { content:''; position:absolute; left:9px; top:20px; bottom:-2px; width:2px; background:#e2e8f0; }
  .at-item:last-child::before { display:none; }
  .at-dot { position:absolute; left:2px; top:2px; width:18px; height:18px; border-radius:50%; background:#fff; border:3px solid #cbd5e1; z-index:1; }
  .at-item.current .at-dot { border-color:#16a34a; box-shadow:0 0 0 4px rgba(22,163,74,0.15); }
  .at-head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .at-status { font-size:0.8rem; font-weight:700; color:#0f172a; text-transform:capitalize; }
  .at-arrow { color:#94a3b8; font-size:0.7rem; }
  .at-prev { font-size:0.72rem; color:#94a3b8; font-weight:500; text-transform:capitalize; }
  .at-meta { font-size:0.7rem; color:#94a3b8; font-weight:500; margin-top:2px; }
  .at-note { font-size:0.78rem; color:#475569; background:#f8fafc; border:1px solid #f1f5f9; border-radius:8px; padding:6px 10px; margin-top:6px; display:inline-block; }
  .at-actor { display:inline-flex; align-items:center; gap:4px; font-size:0.7rem; font-weight:600; color:#64748b; background:#f1f5f9; border-radius:20px; padding:2px 9px; }
  .at-actor i { font-size:0.65rem; color:#94a3b8; }

  /* ═══ WORK-FLOW SUMMARY GRID ═══ */
  .wf-kv { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-top:10px; }
  .wf-kv-item { display:flex; flex-direction:column; gap:2px; padding:10px 12px; background:#f8fafc; border:1px solid #f1f5f9; border-radius:10px; }
  .wf-kv-label { font-size:0.62rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#94a3b8; }
  .wf-kv-value { font-size:0.84rem; font-weight:600; color:#1e293b; }
  .wf-chip { display:inline-flex; align-items:center; gap:5px; padding:4px 10px; border-radius:20px; font-size:0.7rem; font-weight:600; }
  .wf-list { display:flex; flex-direction:column; gap:6px; margin-top:8px; }
  .wf-list-row { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:8px 12px; background:#f8fafc; border:1px solid #f1f5f9; border-radius:10px; font-size:0.8rem; }
  .wf-list-row .wfl-name { font-weight:600; color:#1e293b; }
  .wf-list-row .wfl-meta { color:#64748b; font-size:0.74rem; }
  .wf-note-box { margin-top:10px; padding:10px 12px; background:#fffbeb; border:1px solid #fde68a; border-radius:10px; font-size:0.8rem; color:#78350f; }
  .wf-empty { font-size:0.78rem; color:#94a3b8; padding:10px 0; font-style:italic; }
  @media (max-width: 767px) { .wf-kv { grid-template-columns:1fr; } }

  /* ═══ MIXED SERVICE BREAKDOWN ═══ */
  .ms-wrap { display:flex; flex-direction:column; gap:14px; }
  .ms-section { border:1px solid #e2e8f0; border-radius:14px; overflow:hidden; }
  .ms-section-core { border-color:#dbeafe; }
  .ms-section-repair { border-color:#fef3c7; }
  .ms-section-header { display:flex; align-items:center; gap:10px; padding:12px 16px; font-family:'Outfit',sans-serif; font-size:0.82rem; font-weight:700; }
  .ms-section-header-core { background:linear-gradient(135deg,#eff6ff,#dbeafe); color:#1e40af; }
  .ms-section-header-repair { background:linear-gradient(135deg,#fffbeb,#fef3c7); color:#92400e; }
  .ms-section-header i { font-size:1rem; }
  .ms-section-count { margin-left:auto; font-size:0.68rem; font-weight:700; padding:3px 10px; border-radius:20px; background:rgba(255,255,255,0.7); }
  .ms-section-body { padding:14px 16px; display:flex; flex-direction:column; gap:10px; }
  .ms-service-item { background:#f8fafc; border:1px solid #f1f5f9; border-radius:12px; padding:14px; }
  .ms-service-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; }
  .ms-service-name { font-family:'Inter',sans-serif; font-size:0.85rem; font-weight:700; color:#1e293b; display:flex; align-items:center; gap:8px; }
  .ms-service-name i { font-size:0.9rem; }
  .ms-service-status { padding:3px 10px; border-radius:6px; font-size:0.62rem; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; white-space:nowrap; }
  .ms-service-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }
  .ms-meta-item { display:flex; flex-direction:column; gap:2px; }
  .ms-meta-label { font-size:0.6rem; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:#94a3b8; }
  .ms-meta-value { font-size:0.78rem; font-weight:600; color:#334155; line-height:1.3; }
  .ms-service-issue { margin-top:10px; padding:10px 12px; background:#fff; border:1px solid #f1f5f9; border-radius:10px; font-size:0.76rem; color:#475569; line-height:1.4; }
  .ms-service-issue strong { color:#1e293b; }
  .ms-service-pricing { margin-top:10px; display:flex; flex-wrap:wrap; gap:16px; padding-top:10px; border-top:1px solid #f1f5f9; }
  .ms-price-item { display:flex; flex-direction:column; gap:1px; }
  .ms-price-label { font-size:0.6rem; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:#94a3b8; }
  .ms-price-value { font-size:0.82rem; font-weight:700; color:#1e293b; }
  .ms-price-value.accent { color:#059669; }
  .ms-service-tech { margin-top:8px; display:flex; align-items:center; gap:6px; font-size:0.74rem; color:#64748b; }
  .ms-service-tech i { color:#94a3b8; }
  .ms-section-subtotal { display:flex; justify-content:space-between; align-items:center; padding:10px 14px; border-top:1px solid #f1f5f9; background:#fafbfc; font-size:0.8rem; }
  .ms-section-subtotal-label { font-weight:600; color:#64748b; }
  .ms-section-subtotal-value { font-family:'Inter',sans-serif; font-weight:700; color:#0f172a; }
  .ms-summary-bar { display:flex; gap:0; border-radius:12px; overflow:hidden; border:1px solid #e2e8f0; }
  .ms-summary-cell { flex:1; padding:12px 16px; background:#f8fafc; border-right:1px solid #e2e8f0; }
  .ms-summary-cell:last-child { border-right:none; }
