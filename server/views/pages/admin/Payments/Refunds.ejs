    .inv-pagination { display: flex; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
    .inv-pagination .page-item .page-link { padding: 8px 14px; border-radius: 10px; border: 1.5px solid rgba(148,163,184,0.3); background: rgba(255,255,255,0.8); color: #475569; font-weight: 600; font-size: 0.85rem; transition: all 0.3s ease; }
    .inv-pagination .page-item:not(.disabled) .page-link:hover { background: #fff; border-color: #2563eb; color: #2563eb; }
    .inv-pagination .page-item.disabled .page-link { opacity: 0.5; }
    .refund-detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 0; }
    .refund-detail-field { min-width: 0; padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc; }
    .refund-detail-field dt { margin-bottom: 5px; color: #64748b; font-size: .72rem; font-weight: 700; }
    .refund-detail-field dd { margin: 0; color: #0f172a; font-size: .88rem; font-weight: 650; line-height: 1.45; overflow-wrap: anywhere; }
    .refund-detail-section { margin-top: 20px; }
    .refund-detail-section h6 { margin-bottom: 10px; color: #334155; font-size: .82rem; font-weight: 750; }
    .refund-detail-event { padding: 10px 0 10px 14px; border-left: 2px solid #cbd5e1; }
    .refund-detail-event + .refund-detail-event { margin-top: 4px; }
    .refund-detail-event strong { display: block; font-size: .8rem; }
    .refund-detail-event small { color: #64748b; }
    .refund-detail-event p { margin: 5px 0 0; color: #475569; font-size: .78rem; white-space: pre-wrap; overflow-wrap: anywhere; }
    @media (max-width: 575px) { .refund-detail-grid { grid-template-columns: 1fr; } }
  </style>

  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-cash-stack"></i></div>
        <div>
          <h1>Refunds</h1>
          <p>Review payment records and track refunds in one place.</p>
        </div>
      </div>
    </div>
  </div>
  <div class="alert d-none" id="refundPageMessage" role="status"></div>

  <div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="0">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="kpi-title">Verified Payments</div>
            <div class="d-flex align-items-center gap-2">
              <span class="inv-kpi-value mb-0" id="kpiEligible">—</span>
              <span class="badge inv-kpi-pill bg-success-subtle text-success">Ready</span>
            </div>
            <span class="inv-kpi-sub">Review before recording a refund</span>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #10b981, #059669);"><i class="bi bi-check-circle"></i></div>
        </div>
        <div class="inv-kpi-spark-wrap"><canvas class="inv-kpi-spark" id="refundSpark1"></canvas></div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="100">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="kpi-title">Refund History</div>
            <div class="d-flex align-items-center gap-2">
              <span class="inv-kpi-value mb-0" id="kpiRefunded">—</span>
              <span class="badge inv-kpi-pill bg-dark-subtle text-dark">Processed</span>
            </div>
            <span class="inv-kpi-sub">Completed refund records</span>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #475569, #334155);"><i class="bi bi-clock-history"></i></div>
        </div>
        <div class="inv-kpi-spark-wrap"><canvas class="inv-kpi-spark" id="refundSpark2"></canvas></div>
      </div>
    </div>
  </div>

  <div class="rp-toolbar">
    <div class="rp-filter-group">
      <label class="rp-filter-label">View</label>
      <div class="d-flex gap-2">
        <button class="btn btn-light rp-filter-btn active" data-tab="requests" onclick="refundTab('requests',this)"><i class="bi bi-hourglass-split me-1"></i>Refund Requests</button>
        <button class="btn btn-light rp-filter-btn" data-tab="verified" onclick="refundTab('verified',this)"><i class="bi bi-check2-circle me-1"></i>Verified Payments</button>
        <button class="btn btn-light rp-filter-btn" data-tab="refunded" onclick="refundTab('refunded',this)"><i class="bi bi-clock-history me-1"></i>Refund History</button>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white" style="border-bottom: 1px solid #f1f5f9;">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0 fw-bold" id="tableTitle">Refund Requests</h5>
        <span class="badge bg-primary-subtle text-primary" id="tableCount">0 records</span>
      </div>
      <div class="d-flex align-items-start gap-2 p-2 rounded-2" style="background: rgba(245,158,11,0.08); border-left: 3px solid #f59e0b;">
        <i class="bi bi-info-circle text-warning mt-1" style="font-size: 0.85rem;"></i>
        <span class="small" style="color: #92400e;">This page records refund requests and completed refunds. The system does not transfer funds through GCash, banks, or payment gateways.</span>
      </div>
