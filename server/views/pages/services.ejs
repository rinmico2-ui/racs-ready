/* ── Payment step: order summary, GCash account & copy ── */
(function(){
  function fmt(n){return '₱'+(Number(n)||0).toLocaleString();}

  function getBookingState(){
    try { return (window.BookingState || (window.parent && window.parent.BookingState)) || {}; } catch(e){ return {}; }
  }

  function getSelectedServices(){
    var bs=getBookingState();
    if(Array.isArray(bs.selectedServices)&&bs.selectedServices.length) return bs.selectedServices;
    if(Array.isArray(bs.services)&&bs.services.length) return bs.services;
    if(bs.service) return [bs.service];
    if(window.BookingSystem && typeof window.BookingSystem.selectedServices==='function'){
      var s=window.BookingSystem.selectedServices(); if(Array.isArray(s)&&s.length) return s;
    }
    return [];
  }

  function renderPaymentSummary(){
    var totalEl=document.getElementById('paymentSummaryTotal');
    if(!totalEl) return;
    var svcs=getSelectedServices();
    var total=0;
    svcs.forEach(function(s){
      var price=(s.price||s.unitPrice||s.totalPrice||0)*(s.quantity||1);
      total+=price;
    });
    var bs=getBookingState();
    if(bs.travelFare) total+=Number(bs.travelFare)||0;
    totalEl.textContent=fmt(total);
    var gcashAmount=document.getElementById('gcashAmountDisplay');
    var gcashTotal=document.getElementById('gcashBookingTotal');
    if(gcashAmount) gcashAmount.textContent=fmt(total);
    if(gcashTotal) gcashTotal.textContent=fmt(total);

    var serviceCount=document.getElementById('paymentServiceCount');
    var schedule=document.getElementById('paymentScheduleSummary');
    var location=document.getElementById('paymentLocationSummary');
    var travel=document.getElementById('paymentTravelSummary');
    var unitCount=svcs.reduce(function(sum,s){return sum+(Number(s.quantity)||1);},0);
    if(serviceCount) serviceCount.textContent=svcs.length+' '+(svcs.length===1?'service':'services')+' · '+unitCount+' '+(unitCount===1?'unit':'units');
    if(location) location.textContent=(bs.customerLocation&&bs.customerLocation.address)||bs.location||'Not selected';
    if(travel) travel.textContent=fmt(bs.travelFare||bs.fare||0);
    if(schedule){
      var scheduleText='Not selected';
      if(bs.selectedDate){
        var date=new Date(bs.selectedDate);
        var dateText=isNaN(date.getTime())?String(bs.selectedDate):date.toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'});
        var timeText=(bs.selectedTimeSlot&&bs.selectedTimeSlot.label)||bs.selectedTime||'';
        scheduleText=dateText+(timeText?' · '+timeText:'');
      }
      schedule.textContent=scheduleText;
    }
  }
  function selectPaymentMethod(method){
    var gcashFields=document.getElementById('gcashFields');
    var cashFields=document.getElementById('cashFields');
    var payGcash=document.getElementById('payGcash');
    var payCash=document.getElementById('payCash');
    if(method==='gcash'){
      if(gcashFields) gcashFields.classList.remove('d-none');
      if(cashFields) cashFields.classList.add('d-none');
      if(payGcash) payGcash.checked=true;
      if(payCash) payCash.checked=false;
    } else {
      if(gcashFields) gcashFields.classList.add('d-none');
      if(cashFields) cashFields.classList.remove('d-none');
      if(payGcash) payGcash.checked=false;
      if(payCash) payCash.checked=true;
    }
    document.querySelectorAll('.ent-payment-tab').forEach(function(t){
      t.classList.toggle('active',t.dataset.method===method);
    });
    renderPaymentSummary();
  }
  window.selectPaymentMethod = selectPaymentMethod;

  function renderGcashAccount(){
    var num=window.adminGcashNumber||'';
    var disp=document.getElementById('gcashAccountNumber');
    var qr=document.getElementById('gcashQrImage');
    if(disp) disp.textContent=num?num:'—';
    if(qr&&num){
      qr.src='https://api.qrserver.com/v1/create-qr-code/?size=220x220&data='+encodeURIComponent('GCash|'+num);
    }
  }

  function bindCopy(){
    var btn=document.getElementById('copyGcashNumber');
    if(!btn) return;
    btn.addEventListener('click',function(){
      var num=(window.adminGcashNumber||'').trim();
      if(!num) return;
      var done=function(){btn.classList.add('copied');btn.innerHTML='<i class="bi bi-check-lg"></i>';setTimeout(function(){btn.classList.remove('copied');btn.innerHTML='<i class="bi bi-clipboard"></i>';},1500);};
      if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(num).then(done).catch(function(){});}
      else { var t=document.createElement('textarea');t.value=num;document.body.appendChild(t);t.select();try{document.execCommand('copy');done();}catch(e){}document.body.removeChild(t);}
    });
  }

  // Auto-fill the customer's GCash / Cash mobile number from their profile
  // so they don't have to type it again. Only fills empty fields.
  function prefillCustomerContact(){
    var phone=(window.currentUser&&window.currentUser.phone)||(window.LOGGED_IN&&window.currentUser&&window.currentUser.phone)||'';
    if(!phone) return;
    ['gcashNumber','cashNumber'].forEach(function(id){
      var el=document.getElementById(id);
      if(el&&!el.value){ el.value=phone; }
    });
  }

  // Re-render whenever the payment step becomes visible or on state changes
  var ps=document.getElementById('paymentStep');
  if(ps&&window.MutationObserver){
    new MutationObserver(function(){
      if(!ps.classList.contains('d-none')){ renderPaymentSummary(); renderGcashAccount(); prefillCustomerContact(); }
    }).observe(ps,{attributes:true,attributeFilter:['class']});
  }
  document.addEventListener('DOMContentLoaded',function(){
    renderPaymentSummary(); renderGcashAccount(); bindCopy(); prefillCustomerContact();
  });
  // Refresh after the booking scripts initialize state
  setTimeout(function(){ renderPaymentSummary(); renderGcashAccount(); prefillCustomerContact(); }, 600);
  setTimeout(function(){ renderPaymentSummary(); renderGcashAccount(); prefillCustomerContact(); }, 1500);
})();
</script>

