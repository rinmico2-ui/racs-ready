<div class="container-fluid py-4 aftercare-governance" id="aftercareGovernanceApp">
  <%- include('../../../partials/dashboard-styles') %>

  <style>
    .aftercare-governance{--ag-blue:#2563eb;--ag-navy:#0f172a;--ag-muted:#64748b;--ag-line:#e2e8f0;--ag-soft:#f8fafc;max-width:1540px;color:var(--ag-navy)}
    .ag-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:26px 28px;border-radius:20px;color:#fff;background:linear-gradient(130deg,#0f172a 0%,#172554 55%,#1d4ed8 100%);box-shadow:0 18px 42px rgba(15,23,42,.2)}
    .ag-hero-main{display:flex;align-items:center;gap:16px}.ag-hero-icon{width:54px;height:54px;display:grid;place-items:center;flex:none;border:1px solid rgba(255,255,255,.18);border-radius:15px;background:rgba(255,255,255,.1);font-size:1.4rem}
    .ag-eyebrow{margin-bottom:3px;color:#93c5fd;font-size:.67rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.ag-hero h1{margin:0;font-size:1.5rem;font-weight:800}.ag-hero p{max-width:760px;margin:5px 0 0;color:#bfdbfe;font-size:.8rem;line-height:1.5}
    .ag-alert{min-height:48px;margin:16px 0}.ag-kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin-bottom:18px}.ag-kpi{display:flex;align-items:center;gap:13px;min-height:94px;padding:17px;border:1px solid var(--ag-line);border-radius:15px;background:#fff;box-shadow:0 3px 12px rgba(15,23,42,.045)}
    .ag-kpi-icon{width:43px;height:43px;display:grid;place-items:center;flex:none;border-radius:12px;font-size:1.05rem}.ag-kpi-icon.blue{color:#1d4ed8;background:#dbeafe}.ag-kpi-icon.green{color:#047857;background:#d1fae5}.ag-kpi-icon.amber{color:#b45309;background:#fef3c7}.ag-kpi-icon.violet{color:#6d28d9;background:#ede9fe}.ag-kpi-icon.rose{color:#be123c;background:#ffe4e6}
    .ag-kpi-value{font-size:1.35rem;font-weight:850;line-height:1}.ag-kpi-label{margin-top:5px;color:var(--ag-muted);font-size:.66rem;font-weight:750;letter-spacing:.035em;text-transform:uppercase}.ag-shell{overflow:hidden;border:1px solid var(--ag-line);border-radius:18px;background:#fff;box-shadow:0 5px 20px rgba(15,23,42,.055)}
    .ag-tabs{display:flex;gap:5px;padding:7px;border-bottom:1px solid var(--ag-line);background:#f8fafc;overflow:auto}.ag-tab{display:flex;align-items:center;gap:8px;min-height:43px;padding:0 17px;border:0;border-radius:11px;color:#475569;background:transparent;font-size:.76rem;font-weight:750;white-space:nowrap}.ag-tab:hover{color:#1d4ed8;background:#eff6ff}.ag-tab.active{color:#fff;background:#1d4ed8;box-shadow:0 5px 13px rgba(37,99,235,.24)}.ag-tab-count{min-width:20px;padding:2px 6px;border-radius:999px;background:rgba(148,163,184,.2);font-size:.62rem;text-align:center}.ag-tab.active .ag-tab-count{background:rgba(255,255,255,.2)}
    .ag-panel{display:none;padding:22px}.ag-panel.active{display:block}.ag-section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:17px}.ag-section-head h2{margin:0;font-size:1.03rem;font-weight:820}.ag-section-head p{margin:4px 0 0;color:var(--ag-muted);font-size:.73rem;line-height:1.45}
    .ag-grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.ag-card{border:1px solid var(--ag-line);border-radius:15px;background:#fff}.ag-card-head{display:flex;align-items:flex-start;gap:11px;padding:17px 18px;border-bottom:1px solid var(--ag-line);background:#f8fafc}.ag-card-head i{color:#2563eb}.ag-card-head h3{margin:0;font-size:.86rem;font-weight:800}.ag-card-head p{margin:3px 0 0;color:var(--ag-muted);font-size:.68rem;line-height:1.45}.ag-card-body{padding:18px}
    .ag-flow{display:grid;grid-template-columns:1fr 32px 1fr 32px 1fr;align-items:center;gap:8px}.ag-flow-step{height:100%;padding:15px;border:1px solid var(--ag-line);border-radius:13px;background:#fff}.ag-flow-step strong{display:block;font-size:.76rem}.ag-flow-step span{display:block;margin-top:4px;color:var(--ag-muted);font-size:.67rem;line-height:1.45}.ag-flow-arrow{text-align:center;color:#94a3b8}.ag-note{display:flex;gap:10px;padding:12px 14px;border:1px solid #bfdbfe;border-radius:11px;color:#1e40af;background:#eff6ff;font-size:.7rem;line-height:1.5}.ag-note.warning{border-color:#fde68a;color:#92400e;background:#fffbeb}.ag-metric-list{display:grid;gap:10px}.ag-metric-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding-bottom:10px;border-bottom:1px solid #f1f5f9;font-size:.73rem}.ag-metric-row:last-child{padding-bottom:0;border:0}.ag-metric-row span{color:var(--ag-muted)}.ag-metric-row strong{font-size:.74rem}
    .ag-toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px}.ag-search{position:relative;min-width:260px;flex:1}.ag-search i{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#94a3b8}.ag-search input{height:41px;padding-left:38px;border-color:var(--ag-line);border-radius:10px;font-size:.76rem}.ag-toolbar select{width:auto;min-width:145px;height:41px;border-color:var(--ag-line);border-radius:10px;font-size:.75rem}
    .ag-table-wrap{overflow:auto;border:1px solid var(--ag-line);border-radius:13px}.ag-table{width:100%;min-width:920px;margin:0;border-collapse:separate;border-spacing:0}.ag-table th{padding:11px 13px;border-bottom:1px solid var(--ag-line);color:#64748b;background:#f8fafc;font-size:.62rem;font-weight:800;letter-spacing:.065em;text-transform:uppercase;white-space:nowrap}.ag-table td{padding:12px 13px;border-bottom:1px solid #f1f5f9;color:#334155;font-size:.72rem;vertical-align:middle}.ag-table tr:last-child td{border-bottom:0}.ag-table tbody tr:hover{background:#fafcff}.ag-name{color:#0f172a;font-size:.77rem;font-weight:780}.ag-sub{margin-top:3px;color:#94a3b8;font-size:.64rem}.ag-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 8px;border-radius:999px;font-size:.61rem;font-weight:780;white-space:nowrap}.ag-badge.configured{color:#047857;background:#d1fae5}.ag-badge.fallback{color:#b45309;background:#fef3c7}.ag-badge.inactive{color:#64748b;background:#e2e8f0}.ag-badge.core{color:#1d4ed8;background:#dbeafe}.ag-badge.repair{color:#6d28d9;background:#ede9fe}.ag-badge.repair_category{color:#9a3412;background:#ffedd5}.ag-empty{padding:38px!important;color:#94a3b8!important;text-align:center}.ag-action{border-color:#cbd5e1;border-radius:8px;font-size:.68rem;font-weight:700}
    .ag-rule{padding:14px;border:1px solid var(--ag-line);border-radius:12px}.ag-rule+.ag-rule{margin-top:11px}.ag-rule-top{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}.ag-rule-title{font-size:.77rem;font-weight:780}.ag-rule-help{margin-top:3px;color:var(--ag-muted);font-size:.67rem;line-height:1.45}.ag-input-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:13px}.ag-field label{display:block;margin-bottom:5px;color:#64748b;font-size:.62rem;font-weight:780;letter-spacing:.045em;text-transform:uppercase}.ag-field .form-control,.ag-field .form-select{min-height:40px;border-color:#cbd5e1;border-radius:9px;font-size:.75rem}.ag-field .input-group-text{border-color:#cbd5e1;font-size:.68rem}.ag-switch{width:42px;height:23px;margin:0;cursor:pointer}.ag-switch:checked{border-color:#16a34a;background-color:#16a34a}.ag-savebar{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:16px;padding:13px 15px;border:1px solid #cbd5e1;border-radius:13px;background:#f8fafc}.ag-savebar span{color:var(--ag-muted);font-size:.68rem}.ag-savebar .btn{border-radius:9px;font-size:.72rem;font-weight:750}
    .ag-modal .modal-content{overflow:hidden;border:0;border-radius:17px;box-shadow:0 22px 60px rgba(15,23,42,.25)}.ag-modal .modal-header{padding:18px 21px;color:#fff;background:linear-gradient(135deg,#0f172a,#1d4ed8)}.ag-modal .modal-title{font-size:.96rem;font-weight:800}.ag-modal .modal-body{padding:21px;background:#f8fafc}.ag-modal .modal-footer{padding:13px 20px;background:#fff}.ag-modal .form-label{margin-bottom:5px;color:#475569;font-size:.68rem;font-weight:750}.ag-modal .form-control,.ag-modal .form-select{border-color:#cbd5e1;border-radius:9px;font-size:.77rem}.ag-modal textarea{resize:vertical}.ag-loading{pointer-events:none;opacity:.55}
    @media(max-width:1199px){.ag-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:767px){.ag-hero,.ag-section-head,.ag-savebar{align-items:flex-start;flex-direction:column}.ag-hero-main{align-items:flex-start}.ag-kpis,.ag-grid-2{grid-template-columns:1fr}.ag-flow{grid-template-columns:1fr}.ag-flow-arrow{transform:rotate(90deg)}.ag-panel{padding:15px}.ag-input-grid{grid-template-columns:1fr}.ag-toolbar select,.ag-search{width:100%;min-width:0}.ag-savebar .btn{width:100%}}
  </style>

  <header class="ag-hero"><div class="ag-hero-main"><div class="ag-hero-icon"><i class="bi bi-shield-check"></i></div><div><div class="ag-eyebrow">Policy control center</div><h1>Aftercare &amp; Warranty Governance</h1><p>One operational view for service policies, product and order coverage, maintenance automation, and legacy fallbacks. Issued customer warranties remain immutable.</p></div></div><div class="d-flex flex-wrap gap-2"><button class="btn btn-sm btn-outline-light" type="button" id="agRefreshBtn"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button><a class="btn btn-sm btn-light" href="/admin/warranty"><i class="bi bi-folder2-open me-1"></i>Warranty records</a></div></header>
  <div class="ag-alert" id="agAlert" role="status" aria-live="polite"></div>
  <section class="ag-kpis" aria-label="Warranty governance summary"><div class="ag-kpi"><div class="ag-kpi-icon blue"><i class="bi bi-ui-checks-grid"></i></div><div><div class="ag-kpi-value" id="agConfiguredServices">—</div><div class="ag-kpi-label">Configured services</div></div></div><div class="ag-kpi"><div class="ag-kpi-icon amber"><i class="bi bi-exclamation-diamond"></i></div><div><div class="ag-kpi-value" id="agFallbackServices">—</div><div class="ag-kpi-label">Using fallback</div></div></div><div class="ag-kpi"><div class="ag-kpi-icon green"><i class="bi bi-box-seam"></i></div><div><div class="ag-kpi-value" id="agConfiguredProducts">—</div><div class="ag-kpi-label">Products with terms</div></div></div><div class="ag-kpi"><div class="ag-kpi-icon violet"><i class="bi bi-shield-lock"></i></div><div><div class="ag-kpi-value" id="agActiveWarranties">—</div><div class="ag-kpi-label">Active warranties</div></div></div><div class="ag-kpi"><div class="ag-kpi-icon rose"><i class="bi bi-clipboard2-pulse"></i></div><div><div class="ag-kpi-value" id="agOpenClaims">—</div><div class="ag-kpi-label">Open claims</div></div></div></section>

  <section class="ag-shell">
    <nav class="ag-tabs" aria-label="Aftercare sections"><button class="ag-tab active" type="button" data-ag-tab="overview"><i class="bi bi-grid"></i>Overview</button><button class="ag-tab" type="button" data-ag-tab="services"><i class="bi bi-tools"></i>Service policies <span class="ag-tab-count" id="agServiceCount">0</span></button><button class="ag-tab" type="button" data-ag-tab="orders"><i class="bi bi-box-seam"></i>Products &amp; orders <span class="ag-tab-count" id="agProductCount">0</span></button><button class="ag-tab" type="button" data-ag-tab="automation"><i class="bi bi-sliders"></i>Automation &amp; fallbacks</button></nav>

    <div class="ag-panel active" data-ag-panel="overview">
      <div class="ag-section-head"><div><h2>Governance overview</h2><p>The precedence below prevents two sources of truth and protects warranties already issued to customers.</p></div><a href="/admin/maintenance" class="btn btn-sm btn-outline-primary"><i class="bi bi-calendar2-check me-1"></i>Maintenance records</a></div>
      <div class="ag-flow mb-3"><div class="ag-flow-step"><strong>1. Catalog policy</strong><span>Core services, repair catalog services, repair-request categories, and products define future coverage.</span></div><div class="ag-flow-arrow"><i class="bi bi-arrow-right"></i></div><div class="ag-flow-step"><strong>2. Completion snapshot</strong><span>The effective terms and version are copied into the completed booking or order.</span></div><div class="ag-flow-arrow"><i class="bi bi-arrow-right"></i></div><div class="ag-flow-step"><strong>3. Claim decision</strong><span>Eligibility is evaluated against the saved snapshot—not today’s catalog settings.</span></div></div>
      <div class="ag-grid-2"><div class="ag-card"><div class="ag-card-head"><i class="bi bi-diagram-3"></i><div><h3>Policy ownership</h3><p>Each setting has one authoritative owner.</p></div></div><div class="ag-card-body ag-metric-list"><div class="ag-metric-row"><span>Core-service workmanship</span><strong>Core service policy</strong></div><div class="ag-metric-row"><span>Priced repair services</span><strong>Repair catalog policy</strong></div><div class="ag-metric-row"><span>Customer repair requests</span><strong>Repair category policy</strong></div><div class="ag-metric-row"><span>Manufacturer terms</span><strong>Product inventory</strong></div><div class="ag-metric-row"><span>CALIDRO seller coverage</span><strong>Global order policy</strong></div><div class="ag-metric-row"><span>Unmapped legacy services</span><strong>Fallback policy</strong></div></div></div><div class="ag-card"><div class="ag-card-head"><i class="bi bi-activity"></i><div><h3>Current exposure</h3><p>Live records created from previously snapshotted terms.</p></div></div><div class="ag-card-body ag-metric-list"><div class="ag-metric-row"><span>Active booking warranties</span><strong id="agBookingWarranties">—</strong></div><div class="ag-metric-row"><span>Active order warranties</span><strong id="agOrderWarranties">—</strong></div><div class="ag-metric-row"><span>Open warranty claims</span><strong id="agOverviewClaims">—</strong></div><div class="ag-metric-row"><span>Installation workmanship</span><strong>180 days</strong></div></div></div></div>
      <div class="ag-note mt-3"><i class="bi bi-lock-fill"></i><span><strong>Prospective changes only.</strong> Editing policies here never rewrites the warranty dates, scope, or version saved on completed bookings and orders.</span></div>
    </div>

    <div class="ag-panel" data-ag-panel="services">
      <div class="ag-section-head"><div><h2>Service warranty policies</h2><p>Edit the authoritative policies used by Core Services, priced Repair Services, and the repair-request categories shown to customers.</p></div></div>
      <div class="ag-toolbar"><div class="ag-search"><i class="bi bi-search"></i><input class="form-control" id="agServiceSearch" placeholder="Search service, category, or slug"></div><select class="form-select" id="agServiceKind"><option value="all">All service types</option><option value="core">Core services</option><option value="repair">All repair services</option><option value="repair_category">Repair request categories</option></select><select class="form-select" id="agServiceSource"><option value="all">All policy sources</option><option value="configured">Configured</option><option value="fallback">Using fallback</option></select></div>
      <div class="ag-table-wrap"><table class="ag-table"><thead><tr><th>Service</th><th>Type</th><th>Policy source</th><th>Coverage</th><th>Workmanship</th><th>Parts</th><th>Response</th><th>Status</th><th></th></tr></thead><tbody id="agServiceRows"><tr><td colspan="9" class="ag-empty">Loading service policies…</td></tr></tbody></table></div>
    </div>

    <div class="ag-panel" data-ag-panel="orders">
      <div class="ag-section-head"><div><h2>Product and order coverage</h2><p>Manage seller coverage globally and manufacturer terms on each product. Delivery + installation also receives a separate workmanship snapshot.</p></div><a href="/admin/inventory" class="btn btn-sm btn-outline-secondary"><i class="bi bi-boxes me-1"></i>Inventory catalog</a></div>
      <div class="ag-grid-2 mb-3"><div class="ag-card"><div class="ag-card-head"><i class="bi bi-shop-window"></i><div><h3>CALIDRO seller coverage</h3><p>Applies to future completed product orders, separate from manufacturer coverage.</p></div></div><div class="ag-card-body"><div class="ag-rule"><div class="ag-rule-top"><div><div class="ag-rule-title">Seller-managed product coverage</div><div class="ag-rule-help">Provides assessment and remedy review for reported product defects.</div></div><div class="form-check form-switch"><input class="form-check-input ag-switch" id="orderWarrantyEnabled" type="checkbox"></div></div><div class="ag-input-grid"><div class="ag-field"><label for="orderWarrantyDays">Coverage duration</label><div class="input-group"><input class="form-control" id="orderWarrantyDays" type="number" min="1" max="3650"><span class="input-group-text">days</span></div></div></div></div><div class="ag-savebar"><span>Changes apply to orders completed after saving.</span><button class="btn btn-primary" type="button" id="agSaveOrderPolicy"><i class="bi bi-floppy me-1"></i>Save order policy</button></div></div></div><div class="ag-card"><div class="ag-card-head"><i class="bi bi-wrench-adjustable-circle"></i><div><h3>Delivery + installation</h3><p>Automatically added as a distinct coverage on qualifying orders.</p></div></div><div class="ag-card-body ag-metric-list"><div class="ag-metric-row"><span>Installation workmanship</span><strong>180 days</strong></div><div class="ag-metric-row"><span>Product manufacturer terms</span><strong>Per product</strong></div><div class="ag-metric-row"><span>Seller product coverage</span><strong id="agSellerCoverageSummary">—</strong></div><div class="ag-note"><i class="bi bi-info-circle-fill"></i><span>Product defects and installation workmanship remain separate so claims can be routed to the correct remedy.</span></div></div></div></div>
      <div class="ag-card"><div class="ag-card-head"><i class="bi bi-building-check"></i><div><h3>Manufacturer warranty catalog</h3><p>These written terms are snapshotted into future orders. Existing orders are never rewritten.</p></div></div><div class="ag-card-body"><div class="ag-toolbar"><div class="ag-search"><i class="bi bi-search"></i><input class="form-control" id="agProductSearch" placeholder="Search product or capacity"></div><select class="form-select" id="agProductStatus"><option value="all">All products</option><option value="configured">Terms configured</option><option value="missing">Missing terms</option></select></div><div class="ag-table-wrap"><table class="ag-table"><thead><tr><th>Product</th><th>Capacity</th><th>Manufacturer terms</th><th>Configuration</th><th>Status</th><th></th></tr></thead><tbody id="agProductRows"><tr><td colspan="6" class="ag-empty">Loading product policies…</td></tr></tbody></table></div></div></div>
    </div>

    <div class="ag-panel" data-ag-panel="automation">
      <div class="ag-section-head"><div><h2>Automation and legacy fallbacks</h2><p>Configure maintenance reminders and the safety net used only when an old service record has no catalog policy.</p></div></div>
      <div class="ag-grid-2"><div class="ag-card"><div class="ag-card-head"><i class="bi bi-calendar2-check"></i><div><h3>Maintenance automation</h3><p>Create preventive-maintenance cycles when work is completed.</p></div></div><div class="ag-card-body"><div class="ag-rule"><div class="ag-rule-top"><div><div class="ag-rule-title">Service bookings</div><div class="ag-rule-help">Completed service and repair bookings.</div></div><div class="form-check form-switch"><input class="form-check-input ag-switch" id="maintBookingsEnabled" type="checkbox"></div></div><div class="ag-input-grid"><div class="ag-field"><label>Default interval</label><div class="input-group"><input class="form-control" id="maintBookingDays" type="number" min="30" max="730"><span class="input-group-text">days</span></div></div></div><div class="form-check mt-3"><input class="form-check-input" id="maintTechOverride" type="checkbox"><label class="form-check-label small" for="maintTechOverride">Allow technician recommendation</label></div></div><div class="ag-rule"><div class="ag-rule-top"><div><div class="ag-rule-title">Product orders</div><div class="ag-rule-help">Creates one maintainable asset per completed unit.</div></div><div class="form-check form-switch"><input class="form-check-input ag-switch" id="maintOrdersEnabled" type="checkbox"></div></div><div class="ag-input-grid"><div class="ag-field"><label>Default interval</label><div class="input-group"><input class="form-control" id="maintOrderDays" type="number" min="30" max="730"><span class="input-group-text">days</span></div></div></div></div></div></div>
        <div class="ag-card"><div class="ag-card-head"><i class="bi bi-bell"></i><div><h3>Reminder policy</h3><p>Customer and administrator maintenance notifications.</p></div></div><div class="ag-card-body"><div class="ag-rule"><div class="ag-rule-top"><div><div class="ag-rule-title">Automatic reminders</div><div class="ag-rule-help">Active cycles are evaluated by the background monitor.</div></div><div class="form-check form-switch"><input class="form-check-input ag-switch" id="remindersEnabled" type="checkbox"></div></div><div class="ag-input-grid"><div class="ag-field"><label>First reminder</label><div class="input-group"><input class="form-control" id="firstReminderDays" type="number" min="2" max="90"><span class="input-group-text">days</span></div></div><div class="ag-field"><label>Final reminder</label><div class="input-group"><input class="form-control" id="finalReminderDays" type="number" min="1" max="30"><span class="input-group-text">days</span></div></div></div><div class="mt-3 d-grid gap-2"><label class="form-check small"><input class="form-check-input" id="dueDateEnabled" type="checkbox"> Notify customer on due date</label><label class="form-check small"><input class="form-check-input" id="overdueEnabled" type="checkbox"> Notify customer when overdue</label><label class="form-check small"><input class="form-check-input" id="notifyAdminOverdue" type="checkbox"> Alert admin when overdue</label></div></div></div></div></div>
      <div class="ag-card mt-3"><div class="ag-card-head"><i class="bi bi-exclamation-diamond"></i><div><h3>Advanced: legacy warranty fallbacks</h3><p>Used only when a historical or unmatched service record has no service-specific warranty policy.</p></div></div><div class="ag-card-body"><div class="ag-note warning mb-3"><i class="bi bi-exclamation-triangle-fill"></i><span>These are not master switches. Disabling a fallback does not disable warranties configured directly on services.</span></div><div class="ag-grid-2"><div class="ag-rule"><div class="ag-rule-top"><div><div class="ag-rule-title">Unmapped core-service fallback</div><div class="ag-rule-help">Does not override configured Core Service policies.</div></div><div class="form-check form-switch"><input class="form-check-input ag-switch" id="serviceWarrantyEnabled" type="checkbox"></div></div><div class="ag-input-grid"><div class="ag-field"><label>Fallback duration</label><div class="input-group"><input class="form-control" id="serviceWarrantyDays" type="number" min="90" max="3650"><span class="input-group-text">days</span></div></div></div></div><div class="ag-rule"><div class="ag-rule-top"><div><div class="ag-rule-title">Unmapped repair fallback</div><div class="ag-rule-help">Does not override configured Repair Service policies.</div></div><div class="form-check form-switch"><input class="form-check-input ag-switch" id="repairWarrantyEnabled" type="checkbox"></div></div><div class="ag-input-grid"><div class="ag-field"><label>Fallback duration</label><div class="input-group"><input class="form-control" id="repairWarrantyDays" type="number" min="90" max="3650"><span class="input-group-text">days</span></div></div></div></div></div><div class="ag-savebar"><span>Automation and fallback changes are audited and apply prospectively.</span><button class="btn btn-primary" type="button" id="agSaveAutomation"><i class="bi bi-floppy me-1"></i>Save automation &amp; fallbacks</button></div></div></div>
    </div>
  </section>

  <div class="modal fade ag-modal" id="agServiceModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><form class="modal-content" id="agServiceForm"><div class="modal-header"><div><div class="small text-white-50">Service warranty policy</div><h2 class="modal-title" id="agServiceModalTitle">Edit warranty</h2></div><button class="btn-close btn-close-white" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><input type="hidden" id="agServiceId"><input type="hidden" id="agServiceModalKind"><div class="ag-note mb-3"><i class="bi bi-lock"></i><span>This policy applies only to future completions. Existing issued warranty snapshots remain unchanged.</span></div><div class="row g-3"><div class="col-12"><label class="form-check form-switch"><input class="form-check-input" type="checkbox" id="agSvcEnabled"><span class="form-check-label ms-2 fw-semibold">Issue warranty for this service</span></label></div><div class="col-md-4"><label class="form-label">Coverage type</label><select class="form-select" id="agSvcCoverage"><option value="workmanship">Workmanship</option><option value="installation">Installation</option><option value="diagnostic">Diagnostic / reinspection</option></select></div><div class="col-md-4"><label class="form-label">Workmanship duration</label><div class="input-group"><input class="form-control" id="agSvcDays" type="number" min="90" max="3650" required><span class="input-group-text">days</span></div></div><div class="col-md-4"><label class="form-label">Free reinspection</label><div class="input-group"><input class="form-control" id="agSvcReinspection" type="number" min="1" max="3650" required><span class="input-group-text">days</span></div></div><div class="col-md-4"><label class="form-label">Claim response target</label><div class="input-group"><input class="form-control" id="agSvcResponse" type="number" min="1" max="30" required><span class="input-group-text">days</span></div></div><div class="col-md-4"><label class="form-label">Parts coverage</label><select class="form-select" id="agSvcPartsMode"><option value="same_as_workmanship">Same as workmanship</option><option value="custom">Custom duration</option><option value="manufacturer_terms">Manufacturer terms</option><option value="not_included">Not included</option></select></div><div class="col-md-4"><label class="form-label">Custom parts duration</label><div class="input-group"><input class="form-control" id="agSvcPartsDays" type="number" min="90" max="3650"><span class="input-group-text">days</span></div></div><div class="col-12"><label class="form-label">Covered scope (one item per line)</label><textarea class="form-control" id="agSvcCovered" rows="4" maxlength="6200"></textarea></div><div class="col-12"><label class="form-label">Exclusions (one item per line)</label><textarea class="form-control" id="agSvcExclusions" rows="4" maxlength="6200"></textarea></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="agSaveService" type="submit"><i class="bi bi-floppy me-1"></i>Save policy</button></div></form></div></div>
  <div class="modal fade ag-modal" id="agProductModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" id="agProductForm"><div class="modal-header"><div><div class="small text-white-50">Product warranty source</div><h2 class="modal-title" id="agProductModalTitle">Edit manufacturer terms</h2></div><button class="btn-close btn-close-white" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input id="agProductId" type="hidden"><div class="ag-note mb-3"><i class="bi bi-info-circle"></i><span>Use the manufacturer’s written wording. The longest recognizable year, month, or day duration is used for the order snapshot.</span></div><label class="form-label" for="agProductTerms">Manufacturer warranty terms</label><textarea class="form-control" id="agProductTerms" rows="5" maxlength="500" placeholder="Example: 5 years compressor, 1 year parts"></textarea><div class="form-text">Leave blank only when the product has no documented manufacturer coverage.</div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="agSaveProduct" type="submit"><i class="bi bi-floppy me-1"></i>Save terms</button></div></form></div></div>
</div>

<script>
(function(){
  const app=document.getElementById('aftercareGovernanceApp'),alertBox=document.getElementById('agAlert');
  const state={policy:null,services:[],products:[],summary:{}};
  const defaults={maintenance:{bookingsEnabled:true,bookingIntervalDays:90,allowTechnicianRecommendation:true,ordersEnabled:true,orderIntervalDays:90},reminders:{enabled:true,firstReminderDays:30,finalReminderDays:7,dueDateEnabled:true,overdueEnabled:true,notifyAdminWhenOverdue:true},warranty:{serviceBookingsEnabled:true,serviceBookingDays:90,repairBookingsEnabled:true,repairBookingDays:90,productOrdersEnabled:true,productOrderDays:30}};
  const $=id=>document.getElementById(id),esc=value=>String(value??'').replace(/[&<>'"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char])),lines=value=>String(value||'').split(/\r?\n/).map(item=>item.trim()).filter(Boolean).slice(0,20);
  const partsLabel=policy=>{const part=policy.partsCoverage||{};if(part.mode==='same_as_workmanship')return 'Same as labor';if(part.mode==='custom')return (part.days||'—')+' days';if(part.mode==='manufacturer_terms')return 'Manufacturer';return 'Not included'};
  function notify(type,message){alertBox.innerHTML='<div class="alert alert-'+type+' py-2 px-3 mb-0"><i class="bi bi-'+(type==='success'?'check-circle-fill':'exclamation-triangle-fill')+' me-2"></i>'+esc(message)+'</div>';window.scrollTo({top:0,behavior:'smooth'})}
  async function jsonFetch(url,options){const response=await fetch(url,{credentials:'same-origin',headers:{Accept:'application/json',...(options&&options.body?{'Content-Type':'application/json'}:{})},...options});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'The request could not be completed.');return data}
  function populatePolicy(){const p=state.policy||defaults,map={maintBookingsEnabled:[p.maintenance,'bookingsEnabled','checked'],maintBookingDays:[p.maintenance,'bookingIntervalDays','value'],maintTechOverride:[p.maintenance,'allowTechnicianRecommendation','checked'],maintOrdersEnabled:[p.maintenance,'ordersEnabled','checked'],maintOrderDays:[p.maintenance,'orderIntervalDays','value'],remindersEnabled:[p.reminders,'enabled','checked'],firstReminderDays:[p.reminders,'firstReminderDays','value'],finalReminderDays:[p.reminders,'finalReminderDays','value'],dueDateEnabled:[p.reminders,'dueDateEnabled','checked'],overdueEnabled:[p.reminders,'overdueEnabled','checked'],notifyAdminOverdue:[p.reminders,'notifyAdminWhenOverdue','checked'],serviceWarrantyEnabled:[p.warranty,'serviceBookingsEnabled','checked'],serviceWarrantyDays:[p.warranty,'serviceBookingDays','value'],repairWarrantyEnabled:[p.warranty,'repairBookingsEnabled','checked'],repairWarrantyDays:[p.warranty,'repairBookingDays','value'],orderWarrantyEnabled:[p.warranty,'productOrdersEnabled','checked'],orderWarrantyDays:[p.warranty,'productOrderDays','value']};Object.entries(map).forEach(([id,m])=>{$(id)[m[2]]=m[0][m[1]]});syncDisabled()}
  function readPolicy(){return{maintenance:{bookingsEnabled:$('maintBookingsEnabled').checked,bookingIntervalDays:Number($('maintBookingDays').value),allowTechnicianRecommendation:$('maintTechOverride').checked,ordersEnabled:$('maintOrdersEnabled').checked,orderIntervalDays:Number($('maintOrderDays').value)},reminders:{enabled:$('remindersEnabled').checked,firstReminderDays:Number($('firstReminderDays').value),finalReminderDays:Number($('finalReminderDays').value),dueDateEnabled:$('dueDateEnabled').checked,overdueEnabled:$('overdueEnabled').checked,notifyAdminWhenOverdue:$('notifyAdminOverdue').checked},warranty:{serviceBookingsEnabled:$('serviceWarrantyEnabled').checked,serviceBookingDays:Number($('serviceWarrantyDays').value),repairBookingsEnabled:$('repairWarrantyEnabled').checked,repairBookingDays:Number($('repairWarrantyDays').value),productOrdersEnabled:$('orderWarrantyEnabled').checked,productOrderDays:Number($('orderWarrantyDays').value)}}}
  function validatePolicy(p){const rules=[['Booking maintenance interval',p.maintenance.bookingIntervalDays,30,730],['Order maintenance interval',p.maintenance.orderIntervalDays,30,730],['First reminder',p.reminders.firstReminderDays,2,90],['Final reminder',p.reminders.finalReminderDays,1,30],['Core fallback',p.warranty.serviceBookingDays,90,3650],['Repair fallback',p.warranty.repairBookingDays,90,3650],['Order seller warranty',p.warranty.productOrderDays,1,3650]];for(const [label,value,min,max] of rules)if(!Number.isInteger(value)||value<min||value>max)return label+' must be between '+min+' and '+max+' days.';if(p.reminders.firstReminderDays<=p.reminders.finalReminderDays)return 'The first reminder must occur earlier than the final reminder.';return ''}
  function syncDisabled(){[['maintBookingsEnabled',['maintBookingDays','maintTechOverride']],['maintOrdersEnabled',['maintOrderDays']],['remindersEnabled',['firstReminderDays','finalReminderDays','dueDateEnabled','overdueEnabled','notifyAdminOverdue']],['serviceWarrantyEnabled',['serviceWarrantyDays']],['repairWarrantyEnabled',['repairWarrantyDays']],['orderWarrantyEnabled',['orderWarrantyDays']]].forEach(([toggle,ids])=>ids.forEach(id=>$(id).disabled=!$(toggle).checked))}
  function renderSummary(){const s=state.summary;$('agConfiguredServices').textContent=(s.configuredServices||0)+' / '+(s.totalServices||0);$('agFallbackServices').textContent=s.fallbackServices||0;$('agConfiguredProducts').textContent=(s.configuredProducts||0)+' / '+(s.totalProducts||0);$('agActiveWarranties').textContent=(s.activeBookingWarranties||0)+(s.activeOrderWarranties||0);$('agOpenClaims').textContent=s.openClaims||0;$('agServiceCount').textContent=s.totalServices||0;$('agProductCount').textContent=s.totalProducts||0;$('agBookingWarranties').textContent=s.activeBookingWarranties||0;$('agOrderWarranties').textContent=s.activeOrderWarranties||0;$('agOverviewClaims').textContent=s.openClaims||0;$('agSellerCoverageSummary').textContent=state.policy.warranty.productOrdersEnabled?state.policy.warranty.productOrderDays+' days':'Disabled'}
  function renderServices(){const query=$('agServiceSearch').value.trim().toLowerCase(),kind=$('agServiceKind').value,source=$('agServiceSource').value,kindMatches=s=>kind==='all'||s.kind===kind||(kind==='repair'&&s.kind==='repair_category'),rows=state.services.filter(s=>kindMatches(s)&&(source==='all'||s.policySource===source)&&(!query||[s.name,s.slug,s.category].join(' ').toLowerCase().includes(query)));$('agServiceRows').innerHTML=rows.length?rows.map(s=>{const p=s.policy,sourceLabel=s.policySource==='configured'?'Configured':s.fallbackKind==='recommended_service_default'?'Recommended default':'Legacy fallback',typeLabel=s.kind==='core'?'Core service':s.kind==='repair_category'?'Repair category':'Repair catalog';return '<tr><td><div class="ag-name">'+esc(s.name)+'</div><div class="ag-sub">'+esc(s.slug||s.category)+'</div></td><td><span class="ag-badge '+s.kind+'">'+typeLabel+'</span></td><td><span class="ag-badge '+s.policySource+'"><i class="bi bi-'+(s.policySource==='configured'?'check-circle':'exclamation-circle')+'"></i>'+esc(sourceLabel)+'</span></td><td>'+esc(p.coverageType)+'</td><td><strong>'+esc(p.workmanshipDays)+'</strong> days</td><td>'+esc(partsLabel(p))+'</td><td>'+esc(p.claimResponseDays)+' days</td><td><span class="ag-badge '+(s.active?'configured':'inactive')+'">'+(s.active?'Active':'Inactive')+'</span></td><td><button class="btn btn-sm btn-outline-primary ag-action" data-edit-service="'+esc(s.id)+'"><i class="bi bi-pencil-square me-1"></i>Edit policy</button></td></tr>'}).join(''):'<tr><td colspan="9" class="ag-empty"><i class="bi bi-search me-1"></i>No service policies match these filters.</td></tr>'}
  function renderProducts(){const query=$('agProductSearch').value.trim().toLowerCase(),status=$('agProductStatus').value,rows=state.products.filter(p=>(status==='all'||(status==='configured'&&p.configured)||(status==='missing'&&!p.configured))&&(!query||[p.name,p.capacity,p.manufacturerWarranty].join(' ').toLowerCase().includes(query)));$('agProductRows').innerHTML=rows.length?rows.map(p=>'<tr><td><div class="ag-name">'+esc(p.name)+'</div></td><td>'+esc(p.capacity||'—')+'</td><td style="max-width:430px">'+esc(p.manufacturerWarranty||'No documented manufacturer terms')+'</td><td><span class="ag-badge '+(p.configured?'configured':'fallback')+'">'+(p.configured?'Configured':'Missing terms')+'</span></td><td><span class="ag-badge '+(p.active?'configured':'inactive')+'">'+(p.active?'Active':'Inactive')+'</span></td><td><button class="btn btn-sm btn-outline-primary ag-action" data-edit-product="'+esc(p.id)+'"><i class="bi bi-pencil-square me-1"></i>Edit terms</button></td></tr>').join(''):'<tr><td colspan="6" class="ag-empty"><i class="bi bi-search me-1"></i>No products match these filters.</td></tr>'}
  async function load(){app.classList.add('ag-loading');try{const data=await jsonFetch('/api/admin/settings/aftercare/governance');state.policy=data.policy||defaults;state.services=data.services||[];state.products=data.products||[];state.summary=data.summary||{};populatePolicy();renderSummary();renderServices();renderProducts();alertBox.innerHTML=''}catch(error){notify('danger',error.message)}finally{app.classList.remove('ag-loading')}}
  async function savePolicy(button,scope,message){const policy=readPolicy(),error=validatePolicy(policy);if(error)return notify('danger',error);const original=button.innerHTML;button.disabled=true;button.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Saving…';try{const request=scope==='order'?{url:'/api/admin/settings/aftercare/order-policy',body:{enabled:policy.warranty.productOrdersEnabled,days:policy.warranty.productOrderDays}}:{url:'/api/admin/settings/aftercare/automation',body:{maintenance:policy.maintenance,reminders:policy.reminders,fallback:{serviceBookingsEnabled:policy.warranty.serviceBookingsEnabled,serviceBookingDays:policy.warranty.serviceBookingDays,repairBookingsEnabled:policy.warranty.repairBookingsEnabled,repairBookingDays:policy.warranty.repairBookingDays}}};await jsonFetch(request.url,{method:'PATCH',body:JSON.stringify(request.body)});await load();notify('success',message)}catch(error){notify('danger',error.message)}finally{button.disabled=false;button.innerHTML=original}}
  function syncPartsInput(){$('agSvcPartsDays').disabled=$('agSvcPartsMode').value!=='custom'}
  function openService(id){const service=state.services.find(item=>item.id===id);if(!service)return;const p=service.policy;$('agServiceId').value=service.id;$('agServiceModalKind').value=service.kind;$('agServiceModalTitle').textContent=service.name;$('agSvcEnabled').checked=p.enabled!==false;$('agSvcCoverage').value=p.coverageType||'workmanship';$('agSvcDays').value=p.workmanshipDays||90;$('agSvcReinspection').value=p.freeReinspectionDays||90;$('agSvcResponse').value=p.claimResponseDays||2;$('agSvcPartsMode').value=p.partsCoverage&&p.partsCoverage.mode||'same_as_workmanship';$('agSvcPartsDays').value=p.partsCoverage&&p.partsCoverage.days||'';$('agSvcCovered').value=(p.coveredItems||[]).join('\n');$('agSvcExclusions').value=(p.exclusions||[]).join('\n');syncPartsInput();bootstrap.Modal.getOrCreateInstance($('agServiceModal')).show()}
  async function saveService(event){event.preventDefault();const id=$('agServiceId').value,kind=$('agServiceModalKind').value,days=Number($('agSvcDays').value),reinspection=Number($('agSvcReinspection').value),response=Number($('agSvcResponse').value),partsMode=$('agSvcPartsMode').value,partsDays=$('agSvcPartsDays').value?Number($('agSvcPartsDays').value):null;if(!Number.isInteger(days)||days<90||days>3650)return notify('danger','Workmanship duration must be between 90 and 3650 days.');if(!Number.isInteger(reinspection)||reinspection<1||reinspection>3650)return notify('danger','Free reinspection must be between 1 and 3650 days.');if(!Number.isInteger(response)||response<1||response>30)return notify('danger','Claim response target must be between 1 and 30 days.');if(partsMode==='custom'&&(!Number.isInteger(partsDays)||partsDays<90||partsDays>3650))return notify('danger','Custom parts coverage must be between 90 and 3650 days.');const button=$('agSaveService'),original=button.innerHTML;button.disabled=true;button.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Saving…';try{const data=await jsonFetch('/api/admin/settings/aftercare/services/'+encodeURIComponent(kind)+'/'+encodeURIComponent(id)+'/warranty',{method:'PATCH',body:JSON.stringify({warrantyPolicy:{enabled:$('agSvcEnabled').checked,coverageType:$('agSvcCoverage').value,workmanshipDays:days,freeReinspectionDays:reinspection,claimResponseDays:response,partsCoverage:{mode:partsMode,days:partsDays},coveredItems:lines($('agSvcCovered').value),exclusions:lines($('agSvcExclusions').value)}})});bootstrap.Modal.getInstance($('agServiceModal')).hide();await load();notify('success',data.message)}catch(error){notify('danger',error.message)}finally{button.disabled=false;button.innerHTML=original}}
  function openProduct(id){const product=state.products.find(item=>item.id===id);if(!product)return;$('agProductId').value=product.id;$('agProductModalTitle').textContent=product.name;$('agProductTerms').value=product.manufacturerWarranty||'';bootstrap.Modal.getOrCreateInstance($('agProductModal')).show()}
  async function saveProduct(event){event.preventDefault();const id=$('agProductId').value,terms=$('agProductTerms').value.trim(),button=$('agSaveProduct'),original=button.innerHTML;button.disabled=true;button.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Saving…';try{const data=await jsonFetch('/api/admin/settings/aftercare/products/'+encodeURIComponent(id)+'/warranty',{method:'PATCH',body:JSON.stringify({manufacturerWarranty:terms})});bootstrap.Modal.getInstance($('agProductModal')).hide();await load();notify('success',data.message)}catch(error){notify('danger',error.message)}finally{button.disabled=false;button.innerHTML=original}}
  document.querySelectorAll('[data-ag-tab]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-ag-tab]').forEach(item=>item.classList.toggle('active',item===button));document.querySelectorAll('[data-ag-panel]').forEach(panel=>panel.classList.toggle('active',panel.dataset.agPanel===button.dataset.agTab))}));
  ['agServiceSearch','agServiceKind','agServiceSource'].forEach(id=>$(id).addEventListener(id==='agServiceSearch'?'input':'change',renderServices));['agProductSearch','agProductStatus'].forEach(id=>$(id).addEventListener(id==='agProductSearch'?'input':'change',renderProducts));
  $('agServiceRows').addEventListener('click',event=>{const button=event.target.closest('[data-edit-service]');if(button)openService(button.dataset.editService)});$('agProductRows').addEventListener('click',event=>{const button=event.target.closest('[data-edit-product]');if(button)openProduct(button.dataset.editProduct)});
  $('agServiceForm').addEventListener('submit',saveService);$('agProductForm').addEventListener('submit',saveProduct);$('agSvcPartsMode').addEventListener('change',syncPartsInput);$('agRefreshBtn').addEventListener('click',load);$('agSaveOrderPolicy').addEventListener('click',event=>savePolicy(event.currentTarget,'order','Order warranty policy saved for future completions.'));$('agSaveAutomation').addEventListener('click',event=>savePolicy(event.currentTarget,'automation','Maintenance, reminder, and legacy fallback settings saved.'));
  ['maintBookingsEnabled','maintOrdersEnabled','remindersEnabled','serviceWarrantyEnabled','repairWarrantyEnabled','orderWarrantyEnabled'].forEach(id=>$(id).addEventListener('change',syncDisabled));
  load();
})();
</script>
