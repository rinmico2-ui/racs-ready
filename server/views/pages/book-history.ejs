  <!-- Rating and Calendar JavaScript -->
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // Star Rating Modal - Enterprise Design
      const ratingModal = document.getElementById('bhRatingModal');
      const ratingStars = document.getElementById('bhRatingStars');
      const ratingLabel = document.getElementById('bhRatingLabel');
      const ratingService = document.getElementById('bhRatingService');
      const ratingTechWrapper = document.getElementById('bhRatingTechWrapper');
      const ratingTechName = document.getElementById('bhRatingTechName');
      const ratingComment = document.getElementById('bhRatingComment');
      const submitRatingBtn = document.getElementById('bhSubmitRating');
      let currentRating = 0;
      let currentBookingId = null;
      let bhRatingOpen = false;

      const bhRatingLabels = ['', 'Poor', 'Fair', 'Good', 'Very Good', 'Excellent'];

      // Star interaction
      if (ratingStars) {
        const stars = ratingStars.querySelectorAll('.trk-star');
        stars.forEach((star) => {
          star.addEventListener('click', (e) => {
            e.preventDefault();
            currentRating = parseInt(star.dataset.score);
            bhUpdateStars(currentRating);
          });
          star.addEventListener('mouseenter', () => {
            const score = parseInt(star.dataset.score);
            stars.forEach(s => {
              s.style.color = parseInt(s.dataset.score) <= score ? '#f59e0b' : '#d1d5db';
            });
          });
          star.addEventListener('mouseleave', () => {
            stars.forEach(s => { s.style.color = ''; });
            bhUpdateStars(currentRating);
          });
        });
      }

      function bhUpdateStars(rating) {
        const stars = ratingStars.querySelectorAll('.trk-star');
        stars.forEach((star, index) => {
          star.classList.toggle('active', index < rating);
        });
        ratingLabel.textContent = rating ? bhRatingLabels[rating] : 'Tap a star to rate';
        submitRatingBtn.disabled = rating === 0;
      }

      // Comment character count
      if (ratingComment) {
        ratingComment.addEventListener('input', function() {
          const len = this.value.length;
          document.getElementById('bhCommentCount').textContent = `${Math.min(len, 300)}/300`;
          if (len > 300) this.value = this.value.slice(0, 300);
        });
      }

      // Submit rating
      if (submitRatingBtn) {
        submitRatingBtn.addEventListener('click', async () => {
          if (currentRating === 0 || !currentBookingId) return;
          submitRatingBtn.disabled = true;
          submitRatingBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Submitting...';
          try {
            const commentVal = ratingComment ? ratingComment.value.trim() : null;
            const res = await fetch(`/api/rating/booking/${currentBookingId}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include',
              body: JSON.stringify({ score: currentRating, comment: commentVal || null }),
            });
            if (res.ok) {
              // Show success
              document.getElementById('bhRatingBody').classList.add('d-none');
              document.getElementById('bhRatingSuccess').classList.remove('d-none');
              // Refresh bookings list
              if (typeof fetchBookings === 'function') fetchBookings();
              else setTimeout(() => window.location.reload(), 1500);
            } else {
              const data = await res.json();
              alert(data.error || 'Failed to submit rating');
              submitRatingBtn.disabled = false;
              submitRatingBtn.innerHTML = '<i class="bi bi-send me-1"></i>Submit';
            }
          } catch (e) {
            alert('Failed to submit rating. Please try again.');
            submitRatingBtn.disabled = false;
            submitRatingBtn.innerHTML = '<i class="bi bi-send me-1"></i>Submit';
          }
        });
      }

      // Open/close functions
      window.openRatingModal = function(bookingId, serviceName, techName) {
        currentBookingId = bookingId;
        currentRating = 0;
        bhRatingOpen = true;

        if (ratingService) ratingService.textContent = `How was your ${serviceName || 'Service'} service?`;

        if (ratingTechWrapper && ratingTechName) {
          if (techName) {
            ratingTechName.textContent = techName;
            ratingTechWrapper.classList.remove('d-none');
          } else {
            ratingTechWrapper.classList.add('d-none');
          }
        }

        if (ratingComment) ratingComment.value = '';
        document.getElementById('bhCommentCount').textContent = '0/300';
        bhUpdateStars(0);

        // Show rating body, hide success
        document.getElementById('bhRatingBody').classList.remove('d-none');
        document.getElementById('bhRatingSuccess').classList.add('d-none');

        ratingModal.style.display = '';
      };

      window.closeBhRatingModal = function() {
        ratingModal.style.display = 'none';
        bhRatingOpen = false;
        currentBookingId = null;
        currentRating = 0;
        submitRatingBtn.disabled = false;
        submitRatingBtn.innerHTML = '<i class="bi bi-send me-1"></i>Submit';
      };

      // Premium Flatpickr Initialization
      const fpConfig = {
        dateFormat: "m/d/Y",
        disableMobile: "true",
        onChange: function(selectedDates, dateStr, instance) {
          instance.element.value = dateStr;
          instance.element.dispatchEvent(new Event('change', { bubbles: true }));
        }
      };
      
      const fpFrom = flatpickr("#bh-from", fpConfig);
      const fpTo = flatpickr("#bh-to", fpConfig);

      const fromBtn = document.getElementById('bh-from-btn');
      if (fromBtn) fromBtn.addEventListener('click', () => fpFrom.open());

      const toBtn = document.getElementById('bh-to-btn');
      if (toBtn) toBtn.addEventListener('click', () => fpTo.open());
    });
  </script>
