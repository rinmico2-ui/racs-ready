  </div>
</section>

<section class="ent-page-body">
  <div class="container">
    <div class="ent-booking-container" id="bookingContainer">

      <% if (!user) { %>
        <div class="ent-alert ent-alert-warning" role="alert">
          <i class="bi bi-exclamation-triangle-fill"></i>
          Please <a href="/login" class="alert-link">log in</a> to book an appointment.
        </div>
      <% } %>

      <% if (typeof initialServices !=='undefined' ) { %>
        <script id="initial-services-json" type="application/json"><%- JSON.stringify(initialServices, null, 2) %></script>
        <script>window.initialCatalog = JSON.parse(document.getElementById('initial-services-json').textContent||'{"coreServices":[],"repairs":[]}');</script>
      <% } else { %>
        <script>console.warn('No initialServices data available');</script>
      <% } %>

      <% if (typeof serviceCategories !== 'undefined' && serviceCategories.length) { %>
        <script>window._serviceCategories = <%- JSON.stringify(serviceCategories) %>;</script>
      <% } else { %>
        <script>window._serviceCategories = [];</script>
      <% } %>

      <script>
        window.adminGcashNumber = "<%= adminGcashNumber %>";
        window._farePerKm = Number("<%= typeof farePerKm !== 'undefined' ? farePerKm : 40 %>");
        window._projectLaborRatePerDay = Number("<%= typeof projectLaborRatePerDay !== 'undefined' ? projectLaborRatePerDay : 0 %>");
        window._companyBaseLocation = null;
        window._airconInstallFee = Number("<%= typeof airconInstallFee !== 'undefined' ? airconInstallFee : 1500 %>");
      </script>

      <script>
        function updateEntStepper(step){
          var n=document.querySelectorAll('.ent-n'),f=document.getElementById('stepperFill'),l=document.getElementById('stepperCurrentStep');
          if(!n.length)return;
          var i=step-1,t=n.length;
          n.forEach(function(e,j){
            e.classList.remove('active','completed','inactive');
            if(j<i)e.classList.add('completed');
            else if(j===i)e.classList.add('active');
            else e.classList.add('inactive');
          });
          f.style.height=(i/(t-1)*100)+'%';
          if(l)l.textContent=step;
        }
        function isLocationEntered(){
          if(typeof BookingState!=='undefined' && BookingState.customerLocation && BookingState.customerLocation.address) return true;
          if(typeof BookingState!=='undefined' && typeof BookingState.location==='string' && BookingState.location.length>=10) return true;
          var li=document.getElementById('locationInput');
          if(li && li.value.trim().length>=10) return true;
          return false;
        }
        function navigateToStep(step){
          var currentStep=parseInt(document.getElementById('stepperCurrentStep').textContent || '1');
          if(step>currentStep && step>3 && !isLocationEntered()){
            var li=document.getElementById('locationInput');
            if(li) li.focus();
            var msg='Please enter and confirm your service location before continuing.';
            if(typeof showError==='function') showError(msg); else alert(msg);
            navigateToStep(3);
            return;
          }
          var maxStep=1;
          if(typeof BookingState!=='undefined'&&BookingState.maxReachedStep){
            maxStep=BookingState.maxReachedStep;
          }else{
            var all=document.querySelectorAll('.booking-step');
            all.forEach(function(e){var n=parseInt(e.getAttribute('data-step'));if(n>maxStep)maxStep=n;});
          }
          if(step>maxStep)return;
          updateEntStepper(step);
          if(typeof showStep==='function')showStep(step);
        }
        document.addEventListener('DOMContentLoaded',function(){updateEntStepper(1);});
      </script>

      <% if (user) { %>
      <aside class="sv-tr d-none" id="bookingTrackerSidebar">
        <div class="sv-tr-card">
          <div class="sv-tr-h">
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="sv-tr-b">Active Booking</span>
              <span class="sv-tr-p"></span>
            </div>
            <h5 id="trackerBookingRef">#RACS-XXXXXX</h5>
            <p class="text-muted small text-truncate" id="trackerServiceName" style="max-width:250px;">Service Name</p>
          </div>
          <ul class="sv-tr-steps">
            <li data-status-step="pending"><div class="sv-tr-i"><i class="bi bi-file-earmark-plus"></i></div><div class="sv-tr-l"></div><div><span class="sv-tr-t">Request Submitted</span><span class="sv-tr-d">Awaiting verification</span></div></li>
            <li data-status-step="confirmed"><div class="sv-tr-i"><i class="bi bi-shield-check"></i></div><div class="sv-tr-l"></div><div><span class="sv-tr-t">Booking Confirmed</span><span class="sv-tr-d">Payment verified</span></div></li>
            <li data-status-step="scheduled"><div class="sv-tr-i"><i class="bi bi-calendar-event"></i></div><div class="sv-tr-l"></div><div><span class="sv-tr-t">Tech Scheduled</span><span class="sv-tr-d">Assigned</span></div></li>
            <li data-status-step="on-the-way"><div class="sv-tr-i"><i class="bi bi-truck"></i></div><div class="sv-tr-l"></div><div><span class="sv-tr-t">On The Way</span><span class="sv-tr-d">En route</span></div></li>
            <li data-status-step="arrived"><div class="sv-tr-i"><i class="bi bi-geo-alt-fill"></i></div><div class="sv-tr-l"></div><div><span class="sv-tr-t">Arrived</span><span class="sv-tr-d">On site</span></div></li>
            <li data-status-step="in-progress"><div class="sv-tr-i"><i class="bi bi-tools"></i></div><div class="sv-tr-l"></div><div><span class="sv-tr-t">In Progress</span><span class="sv-tr-d">Service ongoing</span></div></li>
            <li data-status-step="completed"><div class="sv-tr-i"><i class="bi bi-check-circle-fill"></i></div><div><span class="sv-tr-t">Completed</span><span class="sv-tr-d">Done</span></div></li>
          </ul>
          <div class="sv-tr-f"><button type="button" class="sv-btn-b" onclick="window.location.href='/tracking'"><i class="bi bi-map me-1"></i>Open Live Map Tracker</button></div>
        </div>
      </aside>
      <% } %>

      <div class="ent-stepper" id="entStepper">
        <div class="ent-h">
          <span>Booking Progress</span>
          <span>Step <span id="stepperCurrentStep">1</span> of 6</span>
        </div>
        <div class="ent-tr">
          <div class="ent-fill" id="stepperFill" style="height:0%;"></div>
          <div class="ent-n active" data-step="1" onclick="navigateToStep(1)"><div class="ent-ni"><i class="bi bi-person-check"></i></div><span>Login</span></div>
          <div class="ent-n" data-step="2" onclick="navigateToStep(2)"><div class="ent-ni"><i class="bi bi-grid-3x3-gap"></i></div><span>Services</span></div>
          <div class="ent-n" data-step="3" onclick="navigateToStep(3)"><div class="ent-ni"><i class="bi bi-geo-alt"></i></div><span>Location</span></div>
          <div class="ent-n" data-step="4" onclick="navigateToStep(4)"><div class="ent-ni"><i class="bi bi-calendar3"></i></div><span>Schedule</span></div>
          <div class="ent-n" data-step="5" onclick="navigateToStep(5)"><div class="ent-ni"><i class="bi bi-receipt"></i></div><span>Fee Review</span></div>
          <div class="ent-n" data-step="6" onclick="navigateToStep(6)"><div class="ent-ni"><i class="bi bi-credit-card-2-front"></i></div><span>Payment</span></div>
        </div>
      </div>

      <div class="booking-layout">
        <div class="booking-body">

          <!-- Step 1 -->
          <div class="ent-step-card booking-step" data-step="1">
            <div class="ent-step-header">
              <div class="ent-step-icon step-login"><i class="bi bi-person-check"></i></div>
              <div class="ent-step-info">
                <h5>Step 1</h5>
                <p>Please log in to continue</p>
              </div>
            </div>
            <div class="ent-step-body">
              <% if (user) { %>
                <div class="ent-alert ent-alert-success">
                  <i class="bi bi-check-circle-fill"></i>
                  <div>
                    <strong>Welcome back!</strong><br>
                    You are logged in as <strong><%= user.name || user.email %></strong>. Click below to proceed.
                  </div>
                </div>
                <button type="button" class="ent-btn-primary mt-3" onclick="continueToServices()">
                  <i class="bi bi-arrow-right"></i> Continue to Services
                </button>
              <% } else { %>
                <div class="ent-alert ent-alert-info">
                  <i class="bi bi-info-circle-fill"></i>
                  <div>
                    <strong>Login Required</strong><br>
                    Please log in to your account to book our services.
                  </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                  <a href="/login" class="ent-btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Log In
                  </a>
                  <a href="/register" class="ent-btn-outline">
                    <i class="bi bi-person-plus"></i> Register
                  </a>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="ent-step-card d-none booking-step" id="serviceSelection" data-step="2">
            <div class="ent-step-header">
              <div class="ent-step-icon step-services"><i class="bi bi-grid-3x3-gap"></i></div>
              <div class="ent-step-info">
                <h5>Step 2</h5>
                <p>Choose the services you need</p>
              </div>
            </div>
            <div class="ent-step-body">
              <ul class="nav nav-tabs mb-3" id="serviceTabs" role="tablist">
                <li class="nav-item"><button class="nav-link active" id="core-tab" data-bs-toggle="tab" data-bs-target="#core-services" type="button" role="tab" aria-controls="core-services" aria-selected="true"><i class="bi bi-gear-fill me-2"></i>Core Services</button></li>
                <li class="nav-item"><button class="nav-link" id="repair-tab" data-bs-toggle="tab" data-bs-target="#repair-services" type="button" role="tab" aria-controls="repair-services" aria-selected="false"><i class="bi bi-tools me-2"></i>Repair Services</button></li>
              </ul>
              <div class="tab-content" id="serviceTabContent">
                <!-- Core Services Tab -->
                <div class="tab-pane fade show active" id="core-services" role="tabpanel" aria-labelledby="core-tab">
                  <div class="ent-svc-section">
                    <div class="ent-svc-section-header">
                      <div class="ent-svc-section-icon"><i class="bi bi-gear-wide-connected"></i></div>
                      <div>
                        <h6 class="ent-svc-section-title">Core Services</h6>
                        <p class="ent-svc-section-sub">Professional maintenance, installation &amp; servicing</p>
                      </div>
                    </div>
                    <div class="row g-3" id="coreServiceCards"></div>
                    <div class="ent-svc-section-footer d-none" id="coreServiceEmpty">
                      <i class="bi bi-info-circle me-1"></i>No core services available at the moment.
                    </div>
                  </div>
                </div>
                <!-- Repair Services Tab -->
                <div class="tab-pane fade" id="repair-services" role="tabpanel" aria-labelledby="repair-tab">
                  <div class="rp-shell">
                    <div class="rp-intro">
                      <div class="rp-intro-icon"><i class="bi bi-wrench-adjustable-circle-fill"></i></div>
                      <div>
                        <h6 class="rp-intro-title">Repair Service Configuration</h6>
                        <p class="rp-intro-sub">Configure your repair request step by step. Our technician will be prepared with the right tools and parts.</p>
                      </div>
                    </div>

                    <section class="rp-section" data-rp-step="1">
                      <div class="rp-section-header">
                        <div class="rp-step-badge">1</div>
                        <div class="rp-step-info">
                          <h6><i class="bi bi-grid-3x3-gap-fill me-2 text-primary"></i>Service Category</h6>
                          <p>Select the type of equipment that needs repair.</p>
                        </div>
                        <span class="rp-step-status" id="rpCatStatus"><i class="bi bi-circle text-muted"></i></span>
                      </div>
                      <div class="rp-section-body">
                        <div class="row g-3" id="unitCategoryGrid">
                          <% if (typeof serviceCategories !== 'undefined' && serviceCategories.length) { %>
                            <% serviceCategories.forEach(function(cat) { %>
                            <div class="col-md-4">
                              <div class="unit-category-card" data-category="<%= cat.slug %>" onclick="selectUnitCategory(this.dataset.category)">
                                <div class="unit-category-icon <%= cat.iconColor %>"><i class="bi <%= cat.icon %>"></i></div>
                                <div class="unit-category-label"><%= cat.name %></div>
                                <div class="unit-category-count"><%= cat.isCustom ? 'Custom description' : cat.unitTypes.length + ' unit types' %></div>
                                <div class="unit-category-check"><i class="bi bi-check-circle-fill"></i></div>
                              </div>
                            </div>
                            <% }); %>
                          <% } else { %>
                            <div class="col-md-4">
                              <div class="unit-category-card" data-category="aircon" onclick="selectUnitCategory(this.dataset.category)">
                                <div class="unit-category-icon blue"><i class="bi bi-snow"></i></div>
                                <div class="unit-category-label">Air Conditioning</div>
                                <div class="unit-category-count">5 unit types</div>
                                <div class="unit-category-check"><i class="bi bi-check-circle-fill"></i></div>
                              </div>
                            </div>
                            <div class="col-md-4">
                              <div class="unit-category-card" data-category="appliance" onclick="selectUnitCategory(this.dataset.category)">
                                <div class="unit-category-icon amber"><i class="bi bi-house-gear"></i></div>
                                <div class="unit-category-label">Home Appliances</div>
                                <div class="unit-category-count">9 unit types</div>
                                <div class="unit-category-check"><i class="bi bi-check-circle-fill"></i></div>
                              </div>
                            </div>
                            <div class="col-md-4">
                              <div class="unit-category-card" data-category="other" onclick="selectUnitCategory(this.dataset.category)">
                                <div class="unit-category-icon violet"><i class="bi bi-plus-circle"></i></div>
                                <div class="unit-category-label">Other</div>
                                <div class="unit-category-count">Custom description</div>
                                <div class="unit-category-check"><i class="bi bi-check-circle-fill"></i></div>
                              </div>
                            </div>
                          <% } %>
                        </div>
                        <input type="hidden" id="unitType" value="" />
                      </div>
                    </section>

                    <section class="rp-section d-none" id="subUnitSection">
                      <div class="rp-section-header">
                        <div class="rp-step-badge">2</div>
                        <div class="rp-step-info">
                          <h6><i class="bi bi-diagram-3-fill me-2 text-primary"></i>Specific Unit Type</h6>
                          <p>Choose the exact model or configuration.</p>
                        </div>
                        <span class="rp-step-status" id="rpUnitStatus"><i class="bi bi-circle text-muted"></i></span>
                      </div>
                      <div class="rp-section-body">
                        <div class="sub-unit-chips" id="subUnitChips"></div>
                      </div>
                    </section>

                    <section class="rp-section">
                      <div class="rp-section-header">
                        <div class="rp-step-badge">3</div>
                        <div class="rp-step-info">
                          <h6><i class="bi bi-upc-scan me-2 text-primary"></i>Unit Specifications</h6>
                          <p>Basic identifiers to help the technician prepare.</p>
                        </div>
                      </div>
                      <div class="rp-section-body">
                        <div class="row g-3">
                          <div class="col-md-6">
                            <label class="form-label rp-field-label" for="unitBrand"><i class="bi bi-award me-2 text-primary"></i>Brand <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rp-input" id="unitBrand" placeholder="e.g. Carrier, Samsung, LG" required />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label rp-field-label" for="unitModel"><i class="bi bi-upc me-2 text-primary"></i>Model Number <span class="rp-optional">(optional)</span></label>
                            <input type="text" class="form-control rp-input" id="unitModel" placeholder="e.g. 42KDPV48" />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label rp-field-label" for="repairUnitQuantity"><i class="bi bi-stack me-2 text-primary"></i>Number of Units</label>
                            <div class="input-group quantity-stepper">
                              <button class="btn btn-outline-secondary" type="button" id="repairQtyMinus">&minus;</button>
                              <input type="number" class="form-control text-center" id="repairUnitQuantity" value="1" min="1" max="40" />
                              <button class="btn btn-outline-secondary" type="button" id="repairQtyPlus">+</button>
                            </div>
                            <div class="rp-hint"><i class="bi bi-info-circle me-1"></i>Multiple units may be scheduled as a multi-day project.</div>
                          </div>
                        </div>
                      </div>
                    </section>

                    <section class="rp-section">
                      <div class="rp-section-header">
                        <div class="rp-step-badge">4</div>
                        <div class="rp-step-info">
                          <h6><i class="bi bi-chat-square-text-fill me-2 text-primary"></i>Problem Description</h6>
                          <p>Tap the symptoms, then add details.</p>
                        </div>
                      </div>
                      <div class="rp-section-body">
                        <div class="symptom-chips mb-3" id="symptomChips">
                          <button type="button" class="symptom-chip" data-symptom="Not Cooling" onclick="toggleSymptom(this, this.dataset.symptom)"><i class="bi bi-thermometer-half me-1"></i>Not Cooling</button>
                          <button type="button" class="symptom-chip" data-symptom="Strange Noise" onclick="toggleSymptom(this, this.dataset.symptom)"><i class="bi bi-volume-up me-1"></i>Strange Noise</button>
                          <button type="button" class="symptom-chip" data-symptom="Leaking Water" onclick="toggleSymptom(this, this.dataset.symptom)"><i class="bi bi-droplet me-1"></i>Leaking Water</button>
                          <button type="button" class="symptom-chip" data-symptom="Not Turning On" onclick="toggleSymptom(this, this.dataset.symptom)"><i class="bi bi-power me-1"></i>Not Turning On</button>
                          <button type="button" class="symptom-chip" data-symptom="Bad Smell" onclick="toggleSymptom(this, this.dataset.symptom)"><i class="bi bi-cloud me-1"></i>Bad Smell</button>
                          <button type="button" class="symptom-chip" data-symptom="Error Code" onclick="toggleSymptom(this, this.dataset.symptom)"><i class="bi bi-bug me-1"></i>Error Code</button>
                          <button type="button" class="symptom-chip" data-symptom="Overheating" onclick="toggleSymptom(this, this.dataset.symptom)"><i class="bi bi-fire me-1"></i>Overheating</button>
                          <button type="button" class="symptom-chip" data-symptom="Electrical Issue" onclick="toggleSymptom(this, this.dataset.symptom)"><i class="bi bi-lightning me-1"></i>Electrical Issue</button>
                        </div>
                        <label class="form-label rp-field-label" for="repairProblemDescription"><i class="bi bi-chat-square-text me-2 text-primary"></i>Detailed Issue <span class="text-danger">*</span></label>
                        <textarea class="form-control rp-input" id="repairProblemDescription" rows="4" required placeholder="Describe the problem in detail. Example: Not cooling properly, making unusual noises, leaking water..."></textarea>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                          <div class="rp-hint"><i class="bi bi-info-circle me-1"></i>The more details you provide, the better our technician can prepare.</div>
                          <div class="rp-hint" id="repairCharCount">0 / 500</div>
                        </div>
                      </div>
                    </section>

                    <section class="rp-section">
                      <div class="rp-section-header">
                        <div class="rp-step-badge">5</div>
                        <div class="rp-step-info">
                          <h6><i class="bi bi-camera-fill me-2 text-primary"></i>Photo Evidence</h6>
                          <p>Optional images help us assess the issue before arrival.</p>
                        </div>
                      </div>
                      <div class="rp-section-body">
                        <div class="photo-upload-zone" id="repairPhotoUploadZone" onclick="document.getElementById('repairUnitPhotos').click()">
                          <input type="file" class="d-none" id="repairUnitPhotos" multiple accept="image/*" />
                          <div class="photo-upload-icon"><i class="bi bi-cloud-arrow-up"></i></div>
                          <div class="photo-upload-text">Drag photos here or <span>browse</span></div>
                          <div class="photo-upload-hint">Max 5 images &middot; JPG, PNG &middot; 5MB each</div>
                        </div>
                        <div id="repairPhotoPreview" class="mt-3 d-flex flex-wrap gap-2"></div>
                      </div>
                    </section>

                    <div class="rp-add-bar">
                      <button type="button" class="ent-btn-primary" onclick="addCurrentRepairItem()"><i class="bi bi-plus-circle me-2"></i>Add Repair Service</button>
                      <div class="rp-add-hint">Add the configured appliance as a service before continuing.</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mt-4" id="selectedServicesSummary">
                <div class="rv-card">
                  <div class="rv-card-body">
                    <div class="rv-section-title"><i class="bi bi-cart-check"></i>Selected Services <span class="badge bg-primary ms-2" id="selectedServiceCount">0</span></div>
                    <div id="selectedServicesList"><p class="text-muted mb-0">No services selected yet</p></div>
                    <div class="mt-3 pt-3 border-top d-none" id="totalPricingSection">
                      <div class="rv-row">
                        <span class="rv-label">Total Estimated Price:</span>
                        <span class="rv-value" style="font-size:1.3rem;font-weight:800;color:var(--brand-primary);" id="totalEstimatedPrice">₱0</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mt-4 text-center" id="continueButtonSection">
                <button type="button" class="ent-btn-primary px-5" id="continueToNextStep" disabled onclick="if(!this.disabled){showStep(3);updateStepper(3);}else{alert('Please select at least one service first');}return false;"><i class="bi bi-arrow-right-circle"></i> Continue to Next Step</button>
                <p class="text-muted small mt-2" id="continueHint">Please select at least one service to continue</p>
              </div>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="ent-step-card d-none booking-step" id="locationStep" data-step="3">
            <div class="ent-step-header">
              <div class="ent-step-icon step-location"><i class="bi bi-geo-alt"></i></div>
              <div class="ent-step-info">
                <h5>Step 3</h5>
                <p>Set your service location</p>
              </div>
            </div>
            <div class="ent-step-body">
              <script>
                window._companyBaseLocation={configured:false,lat:14.676049,lng:121.043731,address:'Company location not set'};
                window._companyBaseLocationPromise=fetch('/api/public/company/location',{credentials:'same-origin'}).then(r=>{if(!r.ok)throw Error();return r.json();}).then(d=>{window._companyBaseLocation=d||window._companyBaseLocation;return window._companyBaseLocation;}).catch(()=>window._companyBaseLocation);
              </script>
              <script>
                document.addEventListener('DOMContentLoaded',async()=>{
                  try{const l=await(window._companyBaseLocationPromise||Promise.resolve(window._companyBaseLocation));window._companyBaseLocation=l||window._companyBaseLocation;if(window.BookingState&&window._companyBaseLocation){window.BookingState.companyBaseCoordinates={lat:window._companyBaseLocation.lat,lng:window._companyBaseLocation.lng};}}catch(e){console.error('Company location load failed:',e);}
                });
              </script>
