            </div>
            <div class="service-route-stats">
              <div class="service-route-stat"><i class="bi bi-rulers text-primary"></i><span>Distance</span><strong id="mapInfoDistance">&mdash;</strong></div>
              <div class="service-route-stat"><i class="bi bi-clock text-warning"></i><span>Est. Travel</span><strong id="mapInfoDuration">&mdash;</strong></div>
              <div class="service-route-stat"><i class="bi bi-tag text-primary"></i><span>Rate</span><strong>&#8369;<span id="fareRateDisplay">40</span>/km</strong></div>
              <div class="service-route-stat fare"><i class="bi bi-cash-coin"></i><span>Travel Fare</span><strong id="mapInfoFare">&mdash;</strong></div>
            </div>
