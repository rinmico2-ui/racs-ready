  window.pwViewDetails = function (pid) {
    window.__openProjectId = pid;
    const a = window.__pwData && window.__pwData.find(x => x.project._id.toString() === pid.toString());
    if (!a) { toast('Loading details…', 'error'); return; }
    const p = a.project;
    const c = a.customer || {};
    const pu = a.projectUnits || { total:0, done:0 };
    const name = p?.customer?.name || p?.service?.name || 'Project';
    const lead = (p.assignedTechnicians||[]).find(t=>p.leadTechnicianId&&t._id.toString()===p.leadTechnicianId.toString());
    const pct = pu.total > 0 ? Math.round((pu.done/pu.total)*100) : 0;
    const fee = (p.payment && p.payment.totalAmount) ? money(p.payment.totalAmount) : (a.serviceName ? 'Quoted' : 'TBD');
    const declined = (a.teamBoard||[]).filter(t=>t.acknowledge==='declined').map(t=>esc(t.name));

    document.getElementById('pwDrawerTitle').textContent = name;
    document.getElementById('pwDrawerRef').textContent = (p?.service?.name || 'Commercial Project');
    document.getElementById('pwDrawerStatus').textContent = (PHASE_LABEL[a.phase] || a.phase || 'Ready');
