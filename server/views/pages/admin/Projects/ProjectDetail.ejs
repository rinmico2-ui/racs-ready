  function wireToolSearch(field) {
    const input = field.querySelector('.mat-search');
    const results = field.querySelector('.mat-results');
    const selected = field.querySelector('.mat-selected');
    const idInput = field.querySelector('.mat-toolid');
    const nameInput = field.querySelector('.mat-name');
    const qtyInput = field.querySelector('.mat-qty');
    const stockWarning = field.querySelector('.mat-stock-warning');
    const procureBtn = field.querySelector('.mat-procure-btn');

    input.addEventListener('input', function () {
      const q = input.value.trim();
      nameInput.value = q;
      if (idInput.value && q !== selected.textContent) {
        idInput.value = '';
      }
      selected.textContent = q || 'No item selected';
      clearTimeout(__toolSearchTimer);
      if (q.length === 0) { results.style.display = 'none'; return; }
      __toolSearchTimer = setTimeout(async () => {
        const tools = await searchTools(q);
        if (tools.length === 0) {
          results.innerHTML = `
            <div style="padding:0.8rem;text-align:center;">
              <div style="font-size:0.85rem;color:#64748b;margin-bottom:0.4rem;"><i class="bi bi-search" style="font-size:1.2rem;display:block;margin-bottom:0.3rem;color:#cbd5e1;"></i>No matching tools found</div>
              <div style="font-size:0.75rem;color:#94a3b8;">Try a different search term or <a href="/admin/inventory/repair-parts?projectId=${projectId}&procure=true&partName=${encodeURIComponent(q)}&partQty=${encodeURIComponent(field.querySelector('.mat-qty').value)}" target="_blank" style="color:#4f46e5;font-weight:600;">add a new part</a></div>
            </div>`;
        } else {
          results.innerHTML = tools.map(t => {
            const inStock = t.quantity || 0;
            const available = t.availableQuantity || 0;
            const reserved = t.reservedQuantity || 0;
            const isOut = available <= 0;
            const isLow = available > 0 && available <= (t.minStockLevel || 3);
            const isOk = available > (t.minStockLevel || 3);

            let statusDot, statusText, statusColor, bgTint;
            if (isOut) {
              statusDot = '#ef4444'; statusText = 'Out of Stock'; statusColor = '#991b1b'; bgTint = '#fef2f2';
            } else if (isLow) {
              statusDot = '#f59e0b'; statusText = 'Low Stock'; statusColor = '#92400e'; bgTint = '#fffbeb';
            } else {
              statusDot = '#10b981'; statusText = 'In Stock'; statusColor = '#065f46'; bgTint = '#ecfdf5';
            }

            return `
            <div class="mat-opt" data-id="${t._id}" data-name="${t.itemName}" data-available="${available}" data-stock="${inStock}" data-reserved="${reserved}" data-unit="${t.unit || 'pcs'}" style="padding:0.6rem 0.8rem;cursor:pointer;border-bottom:1px solid #f1f5f9;transition:background 0.15s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background=''">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
                <div style="flex:1;min-width:0;">
                  <div style="font-size:0.82rem;font-weight:700;color:#0f172a;display:flex;align-items:center;gap:0.4rem;">
                    ${t.itemName}
                    <span style="font-size:0.62rem;font-weight:700;padding:0.12rem 0.4rem;border-radius:999px;background:${bgTint};color:${statusColor};text-transform:uppercase;letter-spacing:0.03em;">${statusText}</span>
                  </div>
                  <div style="font-size:0.72rem;color:#94a3b8;margin-top:0.15rem;display:flex;gap:0.75rem;">
                    <span><i class="bi bi-box-seam" style="margin-right:0.15rem;"></i>${inStock} in stock</span>
                    <span><i class="bi bi-check2-circle" style="margin-right:0.15rem;"></i>${available} available</span>
                    ${reserved > 0 ? `<span style="color:#d97706;"><i class="bi bi-lock" style="margin-right:0.15rem;"></i>${reserved} reserved</span>` : ''}
                    <span style="color:#cbd5e1;">${t.unit || 'pcs'}</span>
                  </div>
                </div>
                <div style="width:10px;height:10px;border-radius:50%;background:${statusDot};flex-shrink:0;box-shadow:0 0 0 3px ${statusDot}22;"></div>
              </div>
              ${isOut ? `<div style="margin-top:0.35rem;font-size:0.7rem;color:#b91c1c;background:#fef2f2;border:1px solid #fecaca;border-radius:6px;padding:0.25rem 0.5rem;display:flex;align-items:center;gap:0.3rem;"><i class="bi bi-exclamation-triangle-fill"></i> Out of stock — <a href="/admin/inventory/repair-parts?projectId=${projectId}&procure=true" target="_blank" style="color:#4f46e5;font-weight:700;text-decoration:underline;">Procure from inventory</a></div>` : ''}
              ${isLow ? `<div style="margin-top:0.35rem;font-size:0.7rem;color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:6px;padding:0.25rem 0.5rem;display:flex;align-items:center;gap:0.3rem;"><i class="bi bi-exclamation-circle-fill"></i> Low stock — only ${available} left</div>` : ''}
            </div>`;
          }).join('');
        }
        results.style.display = 'block';
        const rect = input.getBoundingClientRect();
        results.style.position = 'fixed';
        results.style.left = rect.left + 'px';
        results.style.top = (rect.bottom + 4) + 'px';
        results.style.width = rect.width + 'px';
        results.style.zIndex = '9999';
        results.querySelectorAll('.mat-opt').forEach(opt => {
          opt.addEventListener('click', () => {
            const available = parseInt(opt.dataset.available) || 0;
            const stock = parseInt(opt.dataset.stock) || 0;
            const reserved = parseInt(opt.dataset.reserved) || 0;
            const unit = opt.dataset.unit || 'pcs';

            idInput.value = opt.dataset.id;
            nameInput.value = opt.dataset.name;
            input.value = opt.dataset.name;
            selected.textContent = opt.dataset.name;

            if (stockWarning && procureBtn) {
              if (available <= 0) {
                stockWarning.style.display = 'block';
                stockWarning.innerHTML = `<div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:0.5rem 0.7rem;display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
                  <div style="display:flex;align-items:center;gap:0.4rem;color:#991b1b;font-size:0.78rem;font-weight:600;"><i class="bi bi-exclamation-triangle-fill"></i> This item is out of stock (${stock} total, ${reserved} reserved by other projects)</div>
                  <a href="/admin/inventory/repair-parts?projectId=${projectId}&procure=true" target="_blank" class="pd-btn" style="font-size:0.7rem;padding:0.3rem 0.6rem;background:#4f46e5;color:#fff;border:none;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;gap:0.3rem;"><i class="bi bi-cart-plus"></i> Procure Parts</a>
                </div>`;
                procureBtn.style.display = 'none';
              } else if (available <= (stock * 0.3)) {
                stockWarning.style.display = 'block';
                stockWarning.innerHTML = `<div style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:0.5rem 0.7rem;display:flex;align-items:center;gap:0.4rem;color:#92400e;font-size:0.78rem;font-weight:600;"><i class="bi bi-exclamation-circle-fill"></i> Low stock warning — only ${available} available (${stock} total, ${reserved} reserved)</div>`;
                procureBtn.style.display = 'none';
              } else {
                stockWarning.style.display = 'none';
                procureBtn.style.display = 'none';
              }
            }

            if (qtyInput) {
              qtyInput.max = available > 0 ? available : '';
              if (available > 0 && parseInt(qtyInput.value) > available) {
                qtyInput.value = available;
              }
            }
            results.style.display = 'none';
          });
        });
      }, 250);
    });
    input.addEventListener('blur', () => setTimeout(() => results.style.display = 'none', 150));
  }

  window.showMaterialModal = function() {
    const sp2 = window.__projectData;
    if (sp2 && teamAcceptancePending(sp2)) { toast('All team members must accept the assignment before reserving resources', 'error'); return; }
    const modal = document.createElement('div');
    modal.className = 'pd-modal-overlay';
    modal.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);z-index:9999;display:flex;align-items:center;justify-content:center;padding:1rem;';
    const procureUrl = `/admin/inventory/repair-parts?projectId=${projectId}&procure=true`;
    modal.innerHTML = `
      <div style="background:#fff;border-radius:16px;width:600px;max-width:94vw;max-height:88vh;display:flex;flex-direction:column;box-shadow:0 25px 50px rgba(15,23,42,0.25);overflow:hidden;">
        <!-- HEADER -->
        <div style="padding:1rem 1.25rem;border-bottom:1px solid #e2e8f0;background:#f8fafc;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;">
          <div style="display:flex;align-items:center;gap:0.6rem;">
            <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#4f46e5,#6366f1);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1rem;"><i class="bi bi-box-seam"></i></div>
            <div>
              <div style="font-size:0.9rem;font-weight:700;color:#0f172a;">Reserve Project Resources</div>
              <div style="font-size:0.72rem;color:#64748b;">Set aside equipment, tools, and parts from inventory</div>
            </div>
          </div>
          <button onclick="closeModal(this)" style="border:none;background:none;color:#94a3b8;font-size:1rem;cursor:pointer;padding:0.3rem;border-radius:6px;" title="Close"><i class="bi bi-x-lg"></i></button>
        </div>
        <!-- INFO + AI -->
        <div style="padding:0.75rem 1.25rem;border-bottom:1px solid #f1f5f9;flex-shrink:0;">
          <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;">
            <button class="pd-btn" id="aiSuggestBtn" style="font-size:0.72rem;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border:none;display:inline-flex;align-items:center;gap:0.35rem;"><i class="bi bi-stars"></i> Suggest Tools (AI)</button>
            <span id="aiSuggestMsg" style="font-size:0.72rem;color:#6366f1;"></span>
          </div>
          <div id="aiSuggestionsBox" style="display:none;background:linear-gradient(135deg,#eef2ff,#f5f3ff);border:1px solid #c7d2fe;border-radius:10px;padding:0.6rem 0.75rem;margin-top:0.5rem;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.4rem;">
              <span style="font-size:0.75rem;font-weight:700;color:#4338ca;"><i class="bi bi-stars me-1"></i>AI Suggestions <span id="aiSuggCount" style="font-weight:600;color:#6366f1;"></span></span>
              <button class="pd-btn" id="aiAddAllBtn" style="font-size:0.68rem;padding:0.2rem 0.5rem;"><i class="bi bi-plus-lg"></i> Add All</button>
            </div>
            <div id="aiSuggestionsList" style="display:flex;flex-direction:column;gap:0.35rem;max-height:160px;overflow-y:auto;"></div>
            <div style="font-size:0.64rem;color:#6366f1;margin-top:0.3rem;">Green = in catalog. Amber = manual item.</div>
          </div>
        </div>
        <!-- RESOURCE LIST -->
        <div style="flex:1 1 0;overflow-y:auto;padding:0.75rem 1.25rem;min-height:0;background:#fafbfc;">
          <div style="font-size:0.72rem;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.5rem;">Reserved Resources</div>
          <div id="materialFields">${toolFieldHtml()}</div>
          <button type="button" class="pd-btn" onclick="addMaterialField()" style="border:1px dashed #cbd5e1;background:#fff;width:100%;font-size:0.78rem;color:#64748b;padding:0.5rem;"><i class="bi bi-plus-lg me-1"></i>Add Resource</button>
        </div>
        <!-- FOOTER -->
        <div style="padding:0.75rem 1.25rem;border-top:1px solid #e2e8f0;background:#f8fafc;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;">
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <span style="font-size:0.72rem;color:#94a3b8;" id="matCountLabel">0 resources</span>
            <a href="${procureUrl}" target="_blank" style="font-size:0.72rem;color:#4f46e5;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.3rem;"><i class="bi bi-cart-plus"></i> Procure Missing Parts</a>
          </div>
          <div style="display:flex;gap:0.5rem;">
            <button class="pd-btn" onclick="closeModal(this)" style="padding:0.45rem 0.9rem;font-size:0.78rem;">Cancel</button>
            <button class="pd-btn primary" id="saveMaterialsBtn" style="padding:0.45rem 1rem;font-size:0.78rem;display:inline-flex;align-items:center;gap:0.3rem;"><i class="bi bi-check-lg"></i> Reserve</button>
          </div>
        </div>
      </div>
    `;
    document.body.appendChild(modal);
    modal.querySelectorAll('.mat-field').forEach(f => {
      wireToolSearch(f);
      const typeSel = f.querySelector('.mat-type');
      const scopeSel = f.querySelector('.mat-scope');
      if (typeSel && scopeSel) {
        typeSel.addEventListener('change', () => { scopeSel.style.display = typeSel.value === 'part' ? 'none' : ''; });
      }
    });
    updateMatCount();

    // Wire up remove buttons to update count
    modal.querySelectorAll('.mat-field .btn-link.text-danger').forEach(btn => {
      btn.addEventListener('click', () => {
        setTimeout(updateMatCount, 10);
      });
    });

    const fieldsWrap = modal.querySelector('#materialFields');
    const aiMsg = modal.querySelector('#aiSuggestMsg');
    modal.querySelector('#aiSuggestBtn').addEventListener('click', async function() {
      await withBtnLoading(this, 'Checking…', async () => {
        aiMsg.textContent = 'Checking catalog…';
        const suggestions = suggestToolsFor(currentProject);
        const existing = new Set([...fieldsWrap.querySelectorAll('.mat-name')].map(n => (n.value || '').toLowerCase()));
        const box = modal.querySelector('#aiSuggestionsBox');
        const list = modal.querySelector('#aiSuggestionsList');
        const countEl = modal.querySelector('#aiSuggCount');
        list.innerHTML = '';
        let bound = 0, missing = 0;
        const rows = [];
        for (const s of suggestions) {
          const key = (s.name || '').toLowerCase();
          if (existing.has(key)) continue;
          let preset = { ...s };
          try {
            const r = await fetch(`/api/inventory/tools/search?q=${encodeURIComponent(s.name)}`, { credentials: 'same-origin' });
            const d = r.ok ? await r.json() : { tools: [] };
            const hit = (d.tools || []).find(t => (t.itemName || '').toLowerCase() === key)
              || (d.tools || []).find(t => (t.itemName || '').toLowerCase().includes(key));
            if (hit) {
              preset.toolId = hit._id;
              preset.available = hit.availableQuantity;
              preset.unitPrice = hit.costPrice || 0;
              bound++;
            } else {
              preset.catalogMissing = true;
              missing++;
            }
          } catch (_) {
            preset.catalogMissing = true;
            missing++;
          }
          rows.push(preset);
        }
        if (rows.length === 0) {
          aiMsg.textContent = 'No new suggestions — all items are already in the reservation list.';
          box.style.display = 'none';
          return;
        }
        const typeLabel = { equipment: 'Shared Equipment', tool: 'Tool', part: 'Part / Consumable' };
        let outOfStockItems = [];
        rows.forEach((preset, idx) => {
          const isAvailable = preset.toolId && preset.available !== null && preset.available > 0;
          const isOut = preset.toolId && preset.available !== null && preset.available <= 0;
          const isMissing = preset.catalogMissing;

          let statusBadge;
          if (isMissing) {
            statusBadge = `<span style="color:#b45309;font-weight:600;font-size:0.7rem;display:inline-flex;align-items:center;gap:0.2rem;"><i class="bi bi-exclamation-triangle-fill"></i> Not in catalog</span>`;
          } else if (isOut) {
            statusBadge = `<span style="color:#dc2626;font-weight:600;font-size:0.7rem;display:inline-flex;align-items:center;gap:0.2rem;"><i class="bi bi-x-circle-fill"></i> Out of stock</span>`;
            outOfStockItems.push(preset);
          } else if (isAvailable) {
            statusBadge = `<span style="color:#15803d;font-weight:600;font-size:0.7rem;display:inline-flex;align-items:center;gap:0.2rem;"><i class="bi bi-check-circle-fill"></i> ${preset.available} available</span>`;
          } else {
            statusBadge = `<span style="color:#94a3b8;font-weight:600;font-size:0.7rem;">Check stock</span>`;
          }

          const row = document.createElement('div');
          row.style.cssText = `display:flex;align-items:center;gap:0.5rem;background:#fff;border:1px solid ${isOut ? '#fecaca' : '#e0e7ff'};border-radius:10px;padding:0.5rem 0.65rem;transition:all 0.15s;${isOut ? 'background:#fef2f2;' : ''}`;
          row.innerHTML = `
            <div style="width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:0.85rem;flex-shrink:0;background:${preset.type === 'part' ? '#ede9fe' : preset.type === 'tool' ? '#fef3c7' : '#e0f2fe'};color:${preset.type === 'part' ? '#5b21b6' : preset.type === 'tool' ? '#92400e' : '#0369a1'};"><i class="bi ${preset.type === 'part' ? 'bi-box-seam' : preset.type === 'tool' ? 'bi-wrench' : 'bi-tools'}"></i></div>
            <div style="flex:1;min-width:0;">
              <div style="font-size:0.8rem;font-weight:700;color:#0f172a;display:flex;align-items:center;gap:0.3rem;">${preset.name} <span style="font-weight:500;color:#64748b;font-size:0.72rem;">x${preset.qty}</span></div>
              <div style="font-size:0.68rem;color:#64748b;margin-top:0.1rem;">${typeLabel[preset.type] || preset.type} · ${statusBadge}</div>
              ${isOut ? `<div style="font-size:0.68rem;color:#b91c1c;margin-top:0.15rem;"><i class="bi bi-exclamation-triangle-fill"></i> This item is out of stock — <a href="/admin/inventory/repair-parts?projectId=${projectId}&procure=true&partName=${encodeURIComponent(preset.name)}&partQty=${preset.qty}" target="_blank" style="color:#4f46e5;font-weight:700;text-decoration:underline;">procure from inventory</a></div>` : ''}
            </div>
            <button class="pd-btn ai-add-one" data-idx="${idx}" style="font-size:0.68rem;padding:0.3rem 0.6rem;${isOut ? 'opacity:0.6;' : ''}" ${isOut ? 'title="Item is out of stock — you may need to procure first"' : ''}><i class="bi bi-plus-lg"></i> Add</button>`;
          list.appendChild(row);
        });

        if (outOfStockItems.length > 0) {
          const warningDiv = document.createElement('div');
          warningDiv.style.cssText = 'background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:0.5rem 0.7rem;margin-top:0.5rem;display:flex;align-items:center;justify-content:space-between;gap:0.5rem;';
          warningDiv.innerHTML = `
            <span style="font-size:0.72rem;color:#991b1b;font-weight:600;"><i class="bi bi-exclamation-triangle-fill"></i> ${outOfStockItems.length} item(s) are out of stock</span>
            <a href="/admin/inventory/repair-parts?projectId=${projectId}&procure=true" target="_blank" style="font-size:0.7rem;color:#4f46e5;font-weight:700;text-decoration:underline;white-space:nowrap;">Procure Parts</a>`;
          list.appendChild(warningDiv);
        }
        function promote(preset) {
          const div = document.createElement('div');
          div.innerHTML = toolFieldHtml(preset);
          const field = div.firstElementChild;
          fieldsWrap.appendChild(field);
          wireToolSearch(field);
          existing.add((preset.name || '').toLowerCase());
        }
        list.querySelectorAll('.ai-add-one').forEach(btn => {
          btn.addEventListener('click', () => {
            const preset = rows[parseInt(btn.dataset.idx)];
            if (!preset) return;
            promote(preset);
            btn.closest('div').remove();
            if (list.children.length === 0) box.style.display = 'none';
          });
        });
        modal.querySelector('#aiAddAllBtn').addEventListener('click', () => {
          rows.slice().forEach(p => promote(p));
          list.innerHTML = '';
          box.style.display = 'none';
        });
        box.style.display = 'block';
        countEl.textContent = '(' + rows.length + ')';
        let msg = `Found ${rows.length} suggestion(s)`;
        if (bound) msg += ` · ${bound} in catalog`;
        if (missing) msg += ` · ${missing} manual`;
        aiMsg.textContent = msg + ' — add the ones you want below.';
      });
    });
    window.addMaterialField = function() {
      const div = document.createElement('div');
      div.innerHTML = toolFieldHtml();
      const field = div.firstElementChild;
      modal.querySelector('#materialFields').appendChild(field);
      wireToolSearch(field);
      const typeSel = field.querySelector('.mat-type');
      const scopeSel = field.querySelector('.mat-scope');
      if (typeSel && scopeSel) {
        typeSel.addEventListener('change', () => { scopeSel.style.display = typeSel.value === 'part' ? 'none' : ''; });
      }
      updateMatCount();
      field.querySelector('.mat-search').focus();
    };

    function updateMatCount() {
      const count = modal.querySelectorAll('.mat-field').length;
      const label = modal.querySelector('#matCountLabel');
      if (label) label.textContent = count > 0 ? `${count} resource${count === 1 ? '' : 's'} added` : '0 resources added';
    }

    // Observe field additions/removals
    const fieldsContainer = modal.querySelector('#materialFields');
    if (fieldsContainer) {
      const observer = new MutationObserver(() => updateMatCount());
      observer.observe(fieldsContainer, { childList: true });
    }
    modal.querySelector('#saveMaterialsBtn').addEventListener('click', async function() {
      const fields = [...modal.querySelectorAll('.mat-field')];
      const materials = fields.map(f => {
        const searchInputVal = (f.querySelector('.mat-search')?.value || '').trim();
        const hiddenNameVal = (f.querySelector('.mat-name')?.value || '').trim();
        const finalName = searchInputVal || hiddenNameVal;
        const toolIdVal = f.querySelector('.mat-toolid')?.value || undefined;
        return {
          itemName: finalName,
          quantity: Math.max(1, parseInt(f.querySelector('.mat-qty')?.value) || 1),
          type: f.querySelector('.mat-type')?.value || 'equipment',
          scope: f.querySelector('.mat-scope')?.value || 'shared',
          sourceId: toolIdVal,
          source: toolIdVal ? 'inventory' : 'other',
        };
      }).filter(m => m.itemName);
      if (materials.length === 0) { toast('Add at least one resource', 'error'); return; }
      await withBtnLoading(this, 'Reserving...', async () => {
        try {
          const r = await fetch(`/api/projects/${projectId}/materials`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ materials }),
          });
          const data = await r.json().catch(() => ({}));
          if (r.ok) {
            if (data.stockConflicts && data.stockConflicts.length > 0) {
              modal.remove();
              loadProject();
              Swal.fire({
                icon: 'warning',
                title: `${data.materials?.length || 0} item(s) reserved`,
                html: `<b>${data.stockConflicts.length} item(s) skipped</b> due to insufficient stock:<br><br>
                  ${data.stockConflicts.map(c => `<div style="text-align:left;font-size:0.8rem;margin-bottom:0.3rem;"><b>${c.itemName}</b> — need ${c.want}, only ${c.available} available</div>`).join('')}`,
                showCancelButton: true,
                confirmButtonText: '<i class="bi bi-cart-plus me-1"></i> Procure Missing Items',
                cancelButtonText: 'Close',
              }).then(res => {
                if (res.isConfirmed) {
                  const firstName = data.stockConflicts[0]?.itemName || '';
                  window.open(`/admin/inventory/repair-parts?projectId=${projectId}&procure=true&partName=${encodeURIComponent(firstName)}`, '_blank');
                }
              });
            } else {
              toast(data.message || 'Resources reserved successfully');
              modal.remove();
              loadProject();
            }
          } else {
            const e = data;
            if (r.status === 409) {
              const errorBox = modal.querySelector('#aiSuggestMsg') || modal.querySelector('.pd-error-box') || (() => {
                const d = document.createElement('div');
                modal.querySelector('#aiSuggestionsBox')?.parentNode?.insertBefore(d, modal.querySelector('#aiSuggestionsBox'));
                return d;
              })();

              let errorHtml = `<div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:0.75rem 1rem;margin-top:0.5rem;">
                <div style="display:flex;align-items:center;gap:0.4rem;color:#991b1b;font-size:0.82rem;font-weight:700;margin-bottom:0.4rem;">
                  <i class="bi bi-exclamation-triangle-fill"></i> Stock Conflict
                </div>
                <div style="font-size:0.78rem;color:#991b1b;margin-bottom:0.5rem;">${e.error || 'All items exceed available stock.'}</div>`;

              if (e.details && e.details.length > 0) {
                errorHtml += `<div style="margin-bottom:0.5rem;">`;
                e.details.forEach(d => {
                  errorHtml += `<div style="display:flex;align-items:center;justify-content:space-between;background:#fff;border:1px solid #fecaca;border-radius:8px;padding:0.4rem 0.6rem;margin-bottom:0.3rem;font-size:0.75rem;">
                    <span style="font-weight:600;color:#0f172a;">${d.itemName || 'Item'}</span>
                    <span style="color:#991b1b;">Need ${d.want} · Available ${d.available}</span>
                  </div>`;
                });
                errorHtml += `</div>`;
              }

              errorHtml += `<div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                <a href="/admin/inventory/repair-parts?projectId=${projectId}&procure=true&partName=${encodeURIComponent(e.item || '')}&partQty=${encodeURIComponent(e.want || 1)}" target="_blank" style="display:inline-flex;align-items:center;gap:0.3rem;background:#4f46e5;color:#fff;border:none;border-radius:8px;padding:0.4rem 0.8rem;font-size:0.75rem;font-weight:600;text-decoration:none;">
                  <i class="bi bi-cart-plus"></i> Procure Parts from Inventory
                </a>
                <button onclick="this.closest('.pd-modal-overlay').remove()" style="background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:0.4rem 0.8rem;font-size:0.75rem;font-weight:600;color:#64748b;cursor:pointer;">
                  Cancel & Review
                </button>
              </div></div>`;

              if (errorBox) {
                errorBox.innerHTML = errorHtml;
                errorBox.style.display = 'block';
                errorBox.style.color = '#b91c1c';
              }
              toast('Stock conflict — adjust quantities or procure parts', 'error');
            } else {
              toast(e.error || 'Failed to reserve resources', 'error');
            }
          }
        } catch(e) { toast('Failed to reserve resources', 'error'); }
      });
    });
    modal.addEventListener('click', function(e) { if (e.target === this) this.remove(); });
  };

  // ── Repair: Reserve quotation parts from inventory ──
  window.adminReserveParts = async function(projectId) {
    try {
      const r = await fetch(`/api/projects/${projectId}/reserve-parts`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });
      const data = await r.json();
      if (r.ok) {
        if (data.insufficientStock?.length) {
          const firstOut = data.insufficientStock[0]?.name || '';
          Swal.fire({
            icon: 'warning',
            title: 'Partial Reservation',
            html: `${data.insufficientStock.length} item(s) are out of stock.<br><br>Click below to procure missing items.`,
            showCancelButton: true,
            confirmButtonText: '<i class="bi bi-cart-plus me-1"></i> Procure Missing Parts',
            cancelButtonText: 'Close',
          }).then(res => {
            if (res.isConfirmed) {
              window.open(`/admin/inventory/repair-parts?projectId=${projectId}&procure=true&partName=${encodeURIComponent(firstOut)}`, '_blank');
            }
          });
        } else {
          toast('All parts reserved successfully');
        }
        loadProject();
      } else {
        const procurePart = data.procurePart || '';
        Swal.fire({
          icon: 'error',
          title: 'Reservation Error',
          html: `${data.error || 'Failed to reserve parts.'}${procurePart ? '<br><br>You can add or procure this item in inventory.' : ''}`,
          showCancelButton: true,
          confirmButtonText: procurePart ? '<i class="bi bi-cart-plus me-1"></i> Add / Procure Item' : 'Procure Parts',
          cancelButtonText: 'Close',
        }).then(res => {
          if (res.isConfirmed) {
            window.open(`/admin/inventory/repair-parts?projectId=${projectId}&procure=true&partName=${encodeURIComponent(procurePart)}`, '_blank');
          }
        });
      }
    } catch (e) {
      toast('Failed to reserve parts', 'error');
    }
  };

  // Robust modal close
  window.closeModal = function(el) {
    const overlay = el.closest('.pd-modal-overlay') || el.closest('div[style*="position:fixed"]');
    if (overlay) overlay.remove();
  };

  window.scrollToResources = function() {
    const card = [...document.querySelectorAll('.pd-card')].find(c => c.textContent.includes('Project Resources'));
    if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    toast('Resources reserved at project level — the lead assigns only limited items');
  };

  loadProject();
})();
</script>
