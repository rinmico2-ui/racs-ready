  /* ── Responsive tweaks ── */
  @media (max-width: 767px) {
    .schedule-card-header .d-flex {
      flex-direction: column;
      align-items: flex-start !important;
    }
    .fc .fc-toolbar-title {
      font-size: 0.95rem !important;
    }
    .fc .fc-header-toolbar {
      flex-wrap: wrap;
