  AU.Queue.updateSelectedToolId=function(){
    var input=document.getElementById('assignEquipmentToolInput');
    var hidden=document.getElementById('assignEquipmentTool');
    if(!input||!hidden)return;
    var v=input.value.trim().toLowerCase();
    hidden.value='';
    for(var i=0;i<_qEquipmentCache.length;i++){
      var t=_qEquipmentCache[i];
      if((t.itemName+' (avail '+t.availableQuantity+')').toLowerCase()===v || t.itemName.toLowerCase()===v){ hidden.value=t._id; break; }
    }
  };

  AU.Queue.addEquipment=function(){
    var hidden=document.getElementById('assignEquipmentTool');
    var input=document.getElementById('assignEquipmentToolInput');
    var qty=document.getElementById('assignEquipmentQty');
    var toolId=hidden?hidden.value:'';
    if(!toolId && input && input.value.trim()){
      var typed=input.value.trim().toLowerCase();
      var t=_qEquipmentCache.find(function(x){return x.itemName.toLowerCase()===typed;}); // strict match to avoid partials
      if(t) toolId=t._id;
    }
    if(!qty||!toolId){showNotification({type:'warning',title:'Select Equipment',message:'Please select a tool from suggestions and quantity.',duration:3000});return;}
    var tool=_qEquipmentCache.find(function(t){return t._id===toolId;});
    if(!tool){showNotification({type:'warning',title:'Invalid Tool',message:'Choose a tool from the list or use Add New Tool.',duration:3000});return;}
    var requested=parseInt(qty.value)||1;
    var available=tool.availableQuantity!=null?tool.availableQuantity:Math.max(0,(tool.quantity||0)-(tool.reservedQuantity||0));
    var already=_qEquipment.filter(function(e){return e.equipmentId===toolId;}).reduce(function(a,b){return a+b.quantity;},0);
    if(requested+already>available){showNotification({type:'error',title:'Not Enough Stock',message:'Available: '+available,duration:3000});return;}
    _qEquipment.push({equipmentId:toolId,equipmentName:tool.itemName,quantity:requested});
    if(input) input.value='';
    if(hidden) hidden.value='';
    qty.value=1;
    AU.Queue.renderEquipmentList();
  };

  AU.Queue.removeEquipment=function(index){
    _qEquipment.splice(index,1);
    AU.Queue.renderEquipmentList();
  };

  AU.Queue.renderEquipmentList=function(){
    var list=document.getElementById('assignEquipmentList');
    var empty=document.getElementById('assignEquipmentEmpty');
    if(!list||!empty)return;
    if(!_qEquipment.length){list.innerHTML='';empty.style.display='block';return;}
    empty.style.display='none';
    list.innerHTML=_qEquipment.map(function(e,i){
      return '<div class="d-flex justify-content-between align-items-center p-2 border rounded"><div><strong>'+e.equipmentName+'</strong><div class="small text-muted">Qty: '+e.quantity+'</div></div><button class="btn btn-sm btn-outline-danger" onclick="AU.Queue.removeEquipment('+i+')"><i class="bi bi-trash"></i></button></div>';
    }).join('');
  };

  AU.Queue.renderRecommendedTools=function(recommended){
    var container=document.getElementById('assignEquipmentRecommended');
    var empty=document.getElementById('assignEquipmentRecommendedEmpty');
    if(!container||!empty)return;
    if(!recommended||!recommended.length){container.innerHTML='';empty.classList.remove('d-none');return;}
    empty.classList.add('d-none');
    container.innerHTML=recommended.map(function(t){
      return '<button type="button" class="btn btn-sm btn-outline-info me-1 mb-1" onclick="AU.Queue.addRecommendedEquipment(\''+t._id+'\')"><i class="bi bi-magic me-1"></i>'+t.itemName+' (avail '+t.availableQuantity+')</button>';
    }).join('');
  };

  AU.Queue.addRecommendedEquipment=function(toolId){
    var tool=_qEquipmentCache.find(function(t){return t._id===toolId;});
    if(!tool)return;
    var available=tool.availableQuantity!=null?tool.availableQuantity:Math.max(0,(tool.quantity||0)-(tool.reservedQuantity||0));
    var already=_qEquipment.filter(function(e){return e.equipmentId===toolId;}).reduce(function(a,b){return a+b.quantity;},0);
    if(1+already>available){showNotification({type:'error',title:'Not Enough Stock',message:'Available: '+available,duration:3000});return;}
    _qEquipment.push({equipmentId:toolId,equipmentName:tool.itemName,quantity:1});
    AU.Queue.renderEquipmentList();
  };

  AU.Queue.toggleNewToolForm=function(){
    var form=document.getElementById('newToolForm');
    if(form) form.classList.toggle('d-none');
  };

  AU.Queue.saveNewTool=function(){
    var nameEl=document.getElementById('assignNewToolName');
    var qtyEl=document.getElementById('assignNewToolQty');
    var unitEl=document.getElementById('assignNewToolUnit');
    var catEl=document.getElementById('assignNewToolCategory');
    var name=(nameEl&&nameEl.value||'').trim();
    var qty=parseInt(qtyEl&&qtyEl.value)||0;
    if(!name){showNotification({type:'warning',title:'Tool Name Required',message:'Enter a tool name.',duration:3000});return;}
    var btn=document.getElementById('btnSaveNewTool');
    btn.disabled=true;btn.innerHTML='Saving...';
    fetch('/api/admin/tools',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({itemName:name,quantity:qty,unit:(unitEl&&unitEl.value)||'pcs',category:(catEl&&catEl.value)||'General'})})
    .then(function(r){return r.json().then(function(d){if(!r.ok)throw new Error(d.error||'Failed to save tool');return d;});})
    .then(function(d){
      showNotification({type:'success',title:'Tool Created',message:d.tool.itemName+' added to inventory.',duration:3000});
      var tool=d.tool;
      tool.availableQuantity=Math.max(0,(tool.quantity||0)-(tool.reservedQuantity||0));
      _qEquipmentCache.push(tool);
      var input=document.getElementById('assignEquipmentToolInput');
      var hidden=document.getElementById('assignEquipmentTool');
      var dl=document.getElementById('assignEquipmentDatalist');
      var display=tool.itemName+' (avail '+tool.availableQuantity+')';
      if(dl){ var o=document.createElement('option'); o.value=display; dl.appendChild(o); }
      if(input){ input.value=display; input.disabled=false; }
      if(hidden) hidden.value=tool._id;
      nameEl.value='';qtyEl.value=1;if(unitEl) unitEl.value='pcs';if(catEl) catEl.value='General';
      AU.Queue.toggleNewToolForm();
    })
    .catch(function(e){showNotification({type:'error',title:'Failed to Save Tool',message:e.message||'Could not add tool.',duration:5000});})
    .finally(function(){btn.disabled=false;btn.innerHTML='Save Tool to Inventory';});
  };

  AU.Queue.confirmAssign=function(){
