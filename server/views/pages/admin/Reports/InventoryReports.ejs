    <!-- Inventory Health Score & Category Breakdown -->
    <div class="row g-3 mb-4">
      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
        <div class="dash-card bg-white h-100">
          <div class="card-header-custom border-0 pb-0">
            <h6 class="mb-0 fw-bold" style="color: #1d4ed8; font-size: 1.1rem;">
              <i class="bi bi-heart-pulse me-2"></i>Inventory Health Score
            </h6>
          </div>
          <div class="card-body px-4 pb-4 text-center">
            <div class="position-relative d-inline-block">
              <canvas id="healthScoreChart" width="180" height="180"></canvas>
              <div class="position-absolute top-50 start-50 translate-middle text-center">
                <div class="h2 mb-0 fw-bold" style="color: #1d4ed8;">
                  <%= analytics ? analytics.inventoryHealthScore : 0 %>
                </div>
                <small class="text-muted">/100</small>
              </div>
            </div>
            <div class="mt-3">
              <% const healthStatus = analytics && analytics.inventoryHealthScore >= 80 ? "Excellent" : 
                                      analytics && analytics.inventoryHealthScore >= 60 ? "Good" : 
                                      analytics && analytics.inventoryHealthScore >= 40 ? "Fair" : "Critical"; %>
              <% const healthColor = analytics && analytics.inventoryHealthScore >= 80 ? "success" : 
                                     analytics && analytics.inventoryHealthScore >= 60 ? "info" : 
                                     analytics && analytics.inventoryHealthScore >= 40 ? "warning" : "danger"; %>
              <span class="badge bg-<%= healthColor %>-subtle text-<%= healthColor %> border border-<%= healthColor %>-subtle fs-6 px-3 py-2">
                <%= healthStatus %>
              </span>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="300">
        <div class="dash-card bg-white h-100">
          <div class="card-header-custom border-0 pb-0">
            <h6 class="mb-0 fw-bold" style="color: #1d4ed8; font-size: 1.1rem;">Inventory by Type</h6>
          </div>
          <div class="card-body px-4 pb-4">
            <div style="height: 200px">
              <canvas id="inventoryTypeChart"></canvas>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="400">
        <div class="dash-card bg-white h-100">
          <div class="card-header-custom border-0 pb-0">
            <h6 class="mb-0 fw-bold" style="color: #1d4ed8; font-size: 1.1rem;">Value Distribution</h6>
          </div>
          <div class="card-body px-4 pb-4">
            <div style="height: 200px">
              <canvas id="valueDistributionChart"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="/js/chart-drilldown.js"></script>
    <script id="inventory-data" type="application/json">
      {
        "stockTurnover": <%- JSON.stringify(analytics && analytics.stockTurnover ? analytics.stockTurnover.slice(0, 5).map(t => ({ name: t.name, rate: parseFloat(t.turnoverRate.toFixed(2)) })) : [{name:'Item 1', rate:1.2}, {name:'Item 2', rate:0.9}, {name:'Item 3', rate:0.7}, {name:'Item 4', rate:0.5}, {name:'Item 5', rate:0.3}]) %>,
        "healthScore": <%= analytics ? analytics.inventoryHealthScore : 0 %>,
        "typeCounts": <%- JSON.stringify(analytics && analytics.typeCounts ? Object.keys(analytics.typeCounts) : ['Split', 'Window', 'Cassette', 'Floor']) %>,
        "typeCountValues": <%- JSON.stringify(analytics && analytics.typeCounts ? Object.values(analytics.typeCounts) : [45, 25, 15, 15]) %>,
        "typeValuesKeys": <%- JSON.stringify(analytics && analytics.typeValues ? Object.keys(analytics.typeValues).slice(0, 5) : ['Type A', 'Type B', 'Type C', 'Type D', 'Type E']) %>,
        "typeValuesData": <%- JSON.stringify(analytics && analytics.typeValues ? Object.values(analytics.typeValues).slice(0, 5).map(v => Math.round(v / 1000)) : [450, 320, 280, 190, 150]) %>,
        "totalValue": <%= analytics ? (analytics.totalValue || 0) : 0 %>,
        "inventoryValue": <%= analytics ? (analytics.inventoryValue || 0) : 0 %>,
        "stockLevels": <%- JSON.stringify(analytics?.stockLevels || []) %>,
        "lowStockAlerts": <%- JSON.stringify(analytics?.lowStockAlerts || []) %>,
        "stockMovementActual": <%- JSON.stringify(analytics?.stockMovementActual || []) %>,
        "topUsedTools": <%- JSON.stringify(analytics?.topConsumedItems || []) %>,
        "itemAnalytics": <%- JSON.stringify((analytics?.itemAnalytics || []).map(function(r){return {name:r.name,type:r.type,kind:r.kind,quantity:r.quantity,available:r.available,status:r.status,stockCost:r.stockCost,retailValue:r.retailValue,marginPct:r.marginPct,usage:r.usage,coverDays:r.coverDays,updatedAt:r.updatedAt,supplier:r.supplier};})) %>
      }
    </script>
    <script>
      // @ts-nocheck
      var inventoryAnalytics = JSON.parse(document.getElementById('inventory-data').textContent);

      function initializeInventoryCharts() {
        if (window.__inventoryChartsInitialized) return;
        if (typeof Chart === "undefined" || typeof ChartDrilldown === "undefined") {
          setTimeout(initializeInventoryCharts, 100);
          return;
        }
        window.__inventoryChartsInitialized = true;

        function computeStockMovement() {
          var rows = inventoryAnalytics.stockMovementActual || [];
          var labels = rows.map(function(r){return r.date;});
          var inbound = rows.map(function(r){return r.inbound||0;});
          var outbound = rows.map(function(r){return r.outbound||0;});
          if (!labels.length) { labels=['No movements']; inbound=[0]; outbound=[0]; }
          return { labels: labels, inbound: inbound, outbound: outbound };
        }

        function openDrill(title, subtitle, chartCfg, details, filters, ff, summary) {
          ChartDrilldown.open({ title: title, subtitle: subtitle || 'Click any element to filter the details below', chartConfig: chartCfg, details: details, filters: filters || [], filterField: ff || 'category', summary: summary || {} });
        }

        /* ── Stock Movement Trend ── */
        var movement = computeStockMovement();
        var movementCtx = document.getElementById("inventoryMovementChart");
        if (movementCtx) {
          var gradientInbound = movementCtx.getContext('2d').createLinearGradient(0, 0, 0, 300);
          gradientInbound.addColorStop(0, 'rgba(16, 185, 129, 0.4)');
          gradientInbound.addColorStop(1, 'rgba(16, 185, 129, 0.05)');
          var gradientOutbound = movementCtx.getContext('2d').createLinearGradient(0, 0, 0, 300);
          gradientOutbound.addColorStop(0, 'rgba(239, 68, 68, 0.4)');
          gradientOutbound.addColorStop(1, 'rgba(239, 68, 68, 0.05)');
          var movementChartCfg = {
            type: "line",
            data: {
              labels: movement.labels,
              datasets: [
                { label: "Inbound", data: movement.inbound, borderColor: "#10b981", backgroundColor: gradientInbound, borderWidth: 3, fill: true, tension: 0.4, pointBackgroundColor: "#fff", pointBorderColor: "#10b981", pointBorderWidth: 2, pointRadius: 4 },
                { label: "Outbound", data: movement.outbound, borderColor: "#ef4444", backgroundColor: gradientOutbound, borderWidth: 3, fill: true, tension: 0.4, pointBackgroundColor: "#fff", pointBorderColor: "#ef4444", pointBorderWidth: 2, pointRadius: 4 }
              ]
            },
            options: {
              maintainAspectRatio: false,
              plugins: { legend: { position: "top", align: "end", labels: { usePointStyle: true, boxWidth: 8 } } },
              scales: { x: { grid: { display: false }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } }, y: { grid: { color: '#CBDDE9', borderDash: [5, 5] }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } } }
            }
          };
          var movementDetails = movement.labels.map(function(l, i) {
            return { label: l, value: movement.inbound[i] + ' / ' + movement.outbound[i], category: l, barValue: movement.inbound[i], subtext: 'Outbound: ' + movement.outbound[i] };
          });
          var movementFilters = movement.labels.map(function(l) { return { key: l, label: l }; });
          movementCtx.style.cursor = 'pointer';
          movementCtx.onclick = function() { openDrill('Stock Movement Trend', 'Inbound vs outbound stock flow', movementChartCfg, movementDetails, movementFilters, 'category', { totalInbound: movement.inbound.reduce(function(a,b){return a+b;},0), totalOutbound: movement.outbound.reduce(function(a,b){return a+b;},0) }); };
          new Chart(movementCtx, movementChartCfg);
        }

        /* ── Inventory Value by Category ── */
        var categoryCtx = document.getElementById("inventoryCategoryValueChart");
        if (categoryCtx) {
          var catLabels = inventoryAnalytics.typeValuesKeys && inventoryAnalytics.typeValuesKeys.length ? inventoryAnalytics.typeValuesKeys : inventoryAnalytics.typeCounts || ['Split','Window','Cassette'];
          var catValues = inventoryAnalytics.typeValuesData && inventoryAnalytics.typeValuesData.length ? inventoryAnalytics.typeValuesData : inventoryAnalytics.typeCountValues || [45, 25, 15];
          var catColors = ["#14b8a6", "#10b981", "#f59e0b", "#3b82f6", "#8b5cf6"];
          var catChartCfg = {
            type: "bar",
            data: { labels: catLabels, datasets: [{ data: catValues, backgroundColor: catColors, borderRadius: 6, barThickness: 24 }] },
            options: {
              maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: { x: { grid: { display: false }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } }, y: { grid: { color: '#CBDDE9', borderDash: [5, 5] }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } } }
            }
          };
          var catDetails = catLabels.map(function(l, i) { return { label: l, value: catValues[i], category: l, barValue: catValues[i] }; });
          var catFilters = catLabels.map(function(l, i) { return { key: l, label: l, color: catColors[i] }; });
          categoryCtx.style.cursor = 'pointer';
          categoryCtx.onclick = function() { openDrill('Inventory Value by Category', 'Stock value distribution across categories', catChartCfg, catDetails, catFilters, 'category', { total: catValues.reduce(function(a,b){return a+b;},0) }); };
          new Chart(categoryCtx, catChartCfg);
        }

        /* ── Stock Aging Distribution ── */
        var agingCtx = document.getElementById("inventoryAgingChart");
        if (agingCtx) {
          var agingRows = inventoryAnalytics.itemAnalytics || [];
          var agelabels = Array.from(new Set(agingRows.map(function(r){return r.type||r.kind||'Unknown';}))).slice(0,6);
          if(!agelabels.length)agelabels=['No inventory'];
          function ageCount(type,min,max){return agingRows.filter(function(r){var age=(Date.now()-new Date(r.updatedAt).getTime())/86400000;return (r.type||r.kind||'Unknown')===type&&age>=min&&age<=max;}).length;}
          var agingYoung = agelabels.map(function(t){return ageCount(t,0,30);});
          var agingMid = agelabels.map(function(t){return ageCount(t,30.0001,90);});
          var agingOld = agelabels.map(function(t){return ageCount(t,90.0001,Infinity);});
          var agingChartCfg = {
            type: "bar",
            data: {
              labels: agelabels,
              datasets: [
                { label: "<30d", data: agingYoung, backgroundColor: "#10b981", borderRadius: { topLeft: 0, topRight: 0, bottomLeft: 4, bottomRight: 4 } },
                { label: "31-90d", data: agingMid, backgroundColor: "#f59e0b", borderRadius: 0 },
                { label: ">90d", data: agingOld, backgroundColor: "#ef4444", borderRadius: { topLeft: 4, topRight: 4, bottomLeft: 0, bottomRight: 0 } }
              ]
            },
            options: {
              maintainAspectRatio: false,
              plugins: { legend: { position: "top", align: "end", labels: { usePointStyle: true, boxWidth: 8 } } },
              scales: { x: { stacked: true, grid: { display: false }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } }, y: { stacked: true, grid: { color: '#CBDDE9', borderDash: [5, 5] }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } } }
            }
          };
          var agingDetails = agelabels.map(function(l, i) {
            return { label: l, value: agingYoung[i] + agingMid[i] + agingOld[i], category: l, barValue: agingYoung[i] + agingMid[i] + agingOld[i], subtext: '<30d: ' + agingYoung[i] + ' | 31-90d: ' + agingMid[i] + ' | >90d: ' + agingOld[i] };
          });
          var agingFilters = agelabels.map(function(l) { return { key: l, label: l }; });
          agingCtx.style.cursor = 'pointer';
          agingCtx.onclick = function() { openDrill('Stock Aging Distribution', 'Inventory age breakdown by category', agingChartCfg, agingDetails, agingFilters, 'category', { total: agingYoung.reduce(function(a,b){return a+b;},0) + agingMid.reduce(function(a,b){return a+b;},0) + agingOld.reduce(function(a,b){return a+b;},0) }); };
          new Chart(agingCtx, agingChartCfg);
        }

        /* ── Top Consumed Items ── */
        var consumedCtx = document.getElementById("topConsumedItemsChart");
        if (consumedCtx) {
          var toItems2 = inventoryAnalytics.topUsedTools || [];
          var consumedLabels = toItems2.length ? toItems2.map(function(t){ return t.name; }).slice(0, 8) : ["No consumption"];
          var consumedData = toItems2.length ? toItems2.map(function(t){ return t.quantity; }).slice(0, 8) : [0];
          var consumedChartCfg = {
            type: "bar",
            data: { labels: consumedLabels, datasets: [{ label: "Units", data: consumedData, backgroundColor: "#14b8a6", borderRadius: 6, barThickness: 16 }] },
            options: {
              indexAxis: "y", maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: { x: { grid: { color: '#CBDDE9', borderDash: [5, 5] }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } }, y: { grid: { display: false }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } } }
            }
          };
          var consumedDetails = consumedLabels.map(function(l, i) { return { label: l, value: consumedData[i], category: l, barValue: consumedData[i] }; });
          var consumedFilters = consumedLabels.map(function(l) { return { key: l, label: l }; });
          consumedCtx.style.cursor = 'pointer';
          consumedCtx.onclick = function() { openDrill('Top Consumed Items', 'Highest consumption quantities', consumedChartCfg, consumedDetails, consumedFilters, 'category', { total: consumedData.reduce(function(a,b){return a+b;},0) }); };
          new Chart(consumedCtx, consumedChartCfg);
        }

        /* ── Stock Turnover Analysis ── */
        var turnoverCtx = document.getElementById("stockTurnoverChart");
        if (turnoverCtx && inventoryAnalytics.stockTurnover.length > 0) {
          var toTurnoverLabels = inventoryAnalytics.stockTurnover.map(function(t) { return t.name; });
          var toTurnoverData = inventoryAnalytics.stockTurnover.map(function(t) { return t.rate; });
          var toTurnoverColors = ["#10b981", "#3b82f6", "#f59e0b", "#8b5cf6", "#ef4444"];
          var turnoverChartCfg = {
            type: "bar",
            data: {
              labels: toTurnoverLabels,
              datasets: [{
                label: "Turnover Rate",
                data: toTurnoverData,
                backgroundColor: toTurnoverColors,
                borderRadius: 6,
                barThickness: 20
              }]
            },
            options: {
              indexAxis: "y",
              maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: {
                x: { grid: { color: '#e5e7eb' }, ticks: { color: '#6b7280' } },
                y: { grid: { display: false }, ticks: { color: '#374151', font: { size: 11 } } }
              }
            }
          };
          var turnoverDetails = toTurnoverLabels.map(function(l, i) { return { label: l, value: toTurnoverData[i] + 'x', category: l, barValue: toTurnoverData[i] }; });
          var turnoverFilters = toTurnoverLabels.map(function(l, i) { return { key: l, label: l, color: toTurnoverColors[i] }; });
          turnoverCtx.style.cursor = 'pointer';
          turnoverCtx.onclick = function() { openDrill('Stock Turnover Analysis', 'Items ranked by turnover rate', turnoverChartCfg, turnoverDetails, turnoverFilters, 'category', { avg: (toTurnoverData.reduce(function(a,b){return a+b;},0) / toTurnoverData.length).toFixed(2) + 'x' }); };
          new Chart(turnoverCtx, turnoverChartCfg);
        }

        /* ── Inventory Health Score ── */
        var healthCtx = document.getElementById("healthScoreChart");
        if (healthCtx) {
          var healthScore = inventoryAnalytics.healthScore;
          new Chart(healthCtx, {
            type: "doughnut",
            data: {
              labels: ["Healthy", "At Risk"],
              datasets: [{
                data: [healthScore, 100 - healthScore],
                backgroundColor: [healthScore >= 60 ? "#10b981" : healthScore >= 40 ? "#f59e0b" : "#ef4444", "#e5e7eb"],
                borderWidth: 0,
                cutout: "75%"
              }]
            },
            options: {
              maintainAspectRatio: false,
              plugins: { legend: { display: false }, tooltip: { enabled: false } }
            }
          });
        }

        /* ── Inventory by Type ── */
        var typeCtx = document.getElementById("inventoryTypeChart");
        if (typeCtx) {
          var typeLabels = inventoryAnalytics.typeCounts;
          var typeData = inventoryAnalytics.typeCountValues;
          var typeColors = ["#3b82f6", "#10b981", "#f59e0b", "#8b5cf6", "#ec4899"];
          var typeChartCfg = {
            type: "doughnut",
            data: {
              labels: typeLabels,
              datasets: [{
                data: typeData,
                backgroundColor: typeColors,
                borderWidth: 2,
                borderColor: "#fff"
              }]
            },
            options: {
              maintainAspectRatio: false,
              cutout: "50%",
              plugins: {
                legend: { position: "right", labels: { boxWidth: 12, font: { size: 10 } } }
              }
            }
          };
          var typeDetails = typeLabels.map(function(l, i) { return { label: l, value: typeData[i], category: l, barValue: typeData[i] }; });
          var typeFilters = typeLabels.map(function(l, i) { return { key: l, label: l, color: typeColors[i] }; });
          typeCtx.style.cursor = 'pointer';
          typeCtx.onclick = function() { openDrill('Inventory by Type', 'Product type distribution', typeChartCfg, typeDetails, typeFilters, 'category', { total: typeData.reduce(function(a,b){return a+b;},0) }); };
          new Chart(typeCtx, typeChartCfg);
        }

        /* ── Value Distribution ── */
        var valueCtx = document.getElementById("valueDistributionChart");
        if (valueCtx) {
          var vLabels = inventoryAnalytics.typeValuesKeys;
          var vData = inventoryAnalytics.typeValuesData;
          var vColors = ["rgba(59, 130, 246, 0.7)", "rgba(16, 185, 129, 0.7)", "rgba(245, 158, 11, 0.7)", "rgba(139, 92, 246, 0.7)", "rgba(236, 72, 153, 0.7)"];
          var valueChartCfg = {
            type: "polarArea",
            data: {
              labels: vLabels,
              datasets: [{
                data: vData,
                backgroundColor: vColors,
                borderWidth: 1
              }]
            },
            options: {
              maintainAspectRatio: false,
              plugins: {
                legend: { position: "right", labels: { boxWidth: 10, font: { size: 10 } } }
              },
              scales: {
                r: { grid: { color: "#e5e7eb" }, ticks: { display: false } }
              }
            }
          };
          var valueDetails = vLabels.map(function(l, i) { return { label: l, value: vData[i] + 'k', category: l, barValue: vData[i] }; });
          var valueFilters = vLabels.map(function(l, i) { return { key: l, label: l, color: vColors[i] }; });
          valueCtx.style.cursor = 'pointer';
          valueCtx.onclick = function() { openDrill('Value Distribution', 'Inventory value breakdown by type', valueChartCfg, valueDetails, valueFilters, 'category', { total: vData.reduce(function(a,b){return a+b;},0) + 'k' }); };
          new Chart(valueCtx, valueChartCfg);
        }

        /* ── Progress bars ── */
        document.querySelectorAll('.inventory-value-bar').forEach(function(bar) {
          var value = parseFloat(bar.getAttribute('data-value')) || 0;
          var maxValue = 10000000;
          var width = Math.min((value / maxValue) * 100, 100);
          bar.style.width = width + '%';
        });

        /* ── KPI sparklines ── */
        function createSparkline(id, data, color) {
          var c = document.getElementById(id);
          if (!c) return null;
          var ctx = c.getContext('2d');
          var height = c.height || c.offsetHeight || 50;
          var grad = ctx.createLinearGradient(0, 0, 0, height);
          grad.addColorStop(0, color);
          grad.addColorStop(1, 'rgba(255,255,255,0)');
          return new Chart(c, {
            type: 'line',
            data: { labels: data.map(function(_, i) { return i + 1; }), datasets: [{ data: data, borderColor: color, backgroundColor: grad, fill: true, tension: 0.35 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { enabled: false } }, elements: { point: { radius: 0 } }, scales: { x: { display: false }, y: { display: false } } }
          });
        }
        var invBase = [25, 30, 28, 35, 40, 38, 42];
        createSparkline('invSparkSKUs', invBase, '#0d6efd');
        createSparkline('invSparkTurnover', invBase.map(function(v) { return Math.round(v * 0.3); }), '#3b82f6');
        createSparkline('invSparkLowstock', [2, 3, 1, 4, 2, 3, 2], '#dc3545');
        createSparkline('invSparkStockout', [1, 0, 2, 1, 1, 0, 3], '#f59e0b');
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeInventoryCharts);
      else initializeInventoryCharts();

      function setupReportNav() {
        var nav = document.getElementById('reportNav');
        if (!nav) return;
        var buttons = nav.querySelectorAll('.report-nav-btn');
        buttons.forEach(function(btn) {
          btn.addEventListener('click', function() {
            var target = btn.dataset.target;
            if (target === 'top') {
              window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
              var el = document.getElementById(target);
              if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            buttons.forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
          });
        });
        var trigger = document.getElementById('reportNavTrigger');
        var icon = document.getElementById('reportNavTriggerIcon');
        var label = document.getElementById('reportNavTriggerLabel');
        if (trigger) {
          trigger.addEventListener('click', function() {
            nav.classList.toggle('open');
            if (icon) { icon.classList.toggle('bi-list'); icon.classList.toggle('bi-x-lg'); }
            if (label) { label.textContent = nav.classList.contains('open') ? 'Close' : 'Sections'; }
          });
        }
      }
      if (document.readyState === 'loading') { window.addEventListener('DOMContentLoaded', setupReportNav); } else { setupReportNav(); }
    </script>

