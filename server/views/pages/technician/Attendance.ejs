<div class="technician-page">
  <div class="container-fluid px-3 px-md-4 py-3 py-md-4">

    <!-- Enterprise Hero Header -->
    <div class="td-hero">
      <div class="td-hero-content">
        <div class="td-hero-left">
          <div class="td-hero-icon">
            <i class="bi bi-person-check"></i>
          </div>
          <div>
            <h1 class="td-hero-title">Attendance</h1>
            <p class="td-hero-sub">Scan QR to check in, track your work hours.</p>
          </div>
        </div>
        <div class="td-hero-right">
          <div class="td-hero-clock">
            <i class="bi bi-clock"></i>
            <span id="todayDate">--:--</span>
          </div>
        </div>
      </div>
    </div>

    <div class="att-main-row row g-4">

      <!-- ═══ LEFT COLUMN: Status + QR ═══ -->
      <div class="col-12 col-lg-5">

        <!-- Current Attendance Card -->
        <div class="att-status-card" id="statusCard">
          <div class="att-status-header">
            <div class="att-status-icon" id="statusIcon">
              <i class="bi bi-qr-code"></i>
            </div>
            <div>
              <div class="att-status-title" id="statusTitle">Scan QR to Check In</div>
              <div class="att-status-sub" id="statusSub">Point your camera at the admin's QR code</div>
            </div>
          </div>

          <div class="att-status-details">
            <div class="att-detail-row">
              <span class="att-detail-label">Date</span>
              <span class="att-detail-value" id="detailDate">—</span>
            </div>
            <div class="att-detail-row">
              <span class="att-detail-label">Status</span>
              <span class="att-detail-value" id="detailStatus">—</span>
            </div>
            <div class="att-detail-row">
              <span class="att-detail-label">Check-In</span>
              <span class="att-detail-value" id="detailCheckIn">—</span>
            </div>
            <div class="att-detail-row">
              <span class="att-detail-label">Check-Out</span>
              <span class="att-detail-value" id="detailCheckOut">—</span>
            </div>
            <div class="att-detail-row" id="totalHoursRow" style="display:none;">
              <span class="att-detail-label">Total Hours</span>
              <span class="att-detail-value fw-bold text-primary" id="detailTotalHours">—</span>
            </div>
          </div>

          <!-- Check Out Button (shown after check-in) -->
          <div class="att-checkout-wrap" id="checkoutWrap" style="display:none;">
            <button class="att-checkout-btn" id="checkoutBtn" onclick="handleCheckOut()">
              <i class="bi bi-box-arrow-right"></i>
              <span>Check Out</span>
            </button>
            <p class="att-checkout-hint">Your availability will be set to Offline</p>
          </div>
        </div>

        <!-- Live Timer (shown after check-in) -->
        <div class="att-timer-card" id="timerCard" style="display:none;">
          <div class="att-timer-icon"><i class="bi bi-stopwatch"></i></div>
          <div class="att-timer-content">
            <div class="att-timer-value" id="timerValue">00:00:00</div>
            <div class="att-timer-label">Hours Worked Today</div>
          </div>
        </div>

      </div>

      <!-- ═══ RIGHT COLUMN: QR Scanner ═══ -->
      <div class="col-12 col-lg-7">

        <!-- QR Code Check-In -->
        <div class="att-panel">
          <div class="att-panel-header">
            <h6 class="att-panel-title"><i class="bi bi-qr-code me-2 text-success"></i>QR Code Check-In</h6>
            <span class="badge bg-success" id="scanStatusBadge">Ready</span>
          </div>
          <div class="att-panel-body text-center">
            <!-- On Leave Banner -->
            <div id="bannerOnLeave" style="display:none;">
              <div class="att-leave-banner">
                <i class="bi bi-calendar-x"></i>
                <h6 id="leaveTitle">On Leave</h6>
                <p class="text-muted small">QR scanning is disabled today.</p>
              </div>
            </div>
            <!-- Scanner -->
            <div id="scannerSection">
              <p class="text-muted small mb-3">Scan the admin's daily QR code to check in for today.</p>
              <div id="scannerPlaceholder" class="att-scanner-box">
                <i class="bi bi-camera-video"></i>
                <p>Camera preview</p>
              </div>
              <div id="reader" style="display:none;border-radius:12px;overflow:hidden;"></div>
              <div class="mt-3 att-scanner-controls">
                <button id="btnStartScanner" class="att-sm-btn green" onclick="startScanner()">
                  <i class="bi bi-qr-code-scan"></i> Scan QR
                </button>
                <button id="btnStopScanner" class="att-sm-btn red" onclick="stopScanner()" style="display:none;">
                  <i class="bi bi-stop-circle"></i> Stop
                </button>
              </div>
              <div class="mt-3">
                <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Check-in time determines if you're Present or Late</small>
              </div>
            </div>
          </div>
        </div>

        <!-- Today's Timeline -->
        <div class="att-panel mt-3">
          <div class="att-panel-header">
            <h6 class="att-panel-title"><i class="bi bi-clock-history me-2 text-primary"></i>Today's Timeline</h6>
          </div>
          <div class="att-panel-body" id="timelineContainer">
            <div class="att-empty-timeline">
              <i class="bi bi-clock"></i>
              <p>No activity recorded yet</p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ═══ ATTENDANCE HISTORY ═══ -->
    <div class="att-panel mt-4">
      <div class="att-panel-header">
        <h6 class="att-panel-title"><i class="bi bi-table me-2 text-purple"></i>Attendance History</h6>
        <span class="badge bg-secondary" id="historyCount">0 records</span>
      </div>
      <div class="att-panel-body p-0" id="historyContainer">
        <div class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm"></div> Loading...</div>
      </div>
    </div>

    <!-- ═══ LEAVE REQUESTS ═══ -->
    <div class="att-panel mt-3">
      <div class="att-panel-header">
        <h6 class="att-panel-title"><i class="bi bi-calendar-x me-2 text-warning"></i>Leave Requests</h6>
        <button class="btn btn-sm btn-warning fw-semibold" onclick="openLeaveModal()">
          <i class="bi bi-plus-lg me-1"></i>Request Leave
        </button>
      </div>
      <div class="att-panel-body" id="leaveContainer">
        <div class="text-center py-3 text-muted"><div class="spinner-border spinner-border-sm"></div> Loading...</div>
      </div>
    </div>

  </div>
</div>

<!-- Leave Request Modal -->
<div class="modal fade" id="leaveModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title fw-bold"><i class="bi bi-calendar-x me-2 text-warning"></i>Request Leave</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="leaveForm" onsubmit="submitLeave(event)">
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-sm-6">
              <label class="form-label fw-semibold">Start Date *</label>
              <input type="date" class="form-control" id="leaveStart" required min="">
            </div>
            <div class="col-sm-6">
              <label class="form-label fw-semibold">End Date</label>
              <input type="date" class="form-control" id="leaveEnd" min="">
              <small class="text-muted">Leave blank for single day</small>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Reason</label>
              <textarea class="form-control" id="leaveReason" rows="3" maxlength="500" placeholder="Optional reason..."></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning btn-sm">Submit Request</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- html5-qrcode -->
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

<style>
  /* Status Card */
  .att-status-card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px;
    box-shadow: 0 8px 24px rgba(15,23,42,0.04);
  }
  .att-status-header { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
  .att-status-icon {
    width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; background: #f1f5f9; color: #94a3b8; transition: all 0.3s; flex-shrink: 0;
  }
  .att-status-icon.checked-in { background: linear-gradient(135deg, #dcfce7, #bbf7d0); color: #16a34a; }
  .att-status-icon.late { background: linear-gradient(135deg, #fff7ed, #fed7aa); color: #ea580c; }
  .att-status-icon.checked-out { background: linear-gradient(135deg, #e0e7ff, #c7d2fe); color: #4f46e5; }
  .att-status-icon.on-leave { background: linear-gradient(135deg, #f3e8ff, #e9d5ff); color: #7c3aed; }
  .att-status-title { font-size: 1.1rem; font-weight: 800; color: #0f172a; }
  .att-status-sub { font-size: 0.82rem; color: #64748b; }

  .att-status-details { border-top: 1px solid #f1f5f9; padding-top: 16px; }
  .att-detail-row {
    display: flex; justify-content: space-between; align-items: center; padding: 10px 0;
    border-bottom: 1px solid #f8fafc;
  }
  .att-detail-row:last-child { border-bottom: none; }
  .att-detail-label { color: #64748b; font-size: 0.85rem; }
  .att-detail-value { color: #1e293b; font-weight: 600; font-size: 0.9rem; }

  .att-checkout-wrap { margin-top: 20px; padding-top: 16px; border-top: 1px solid #f1f5f9; text-align: center; }
  .att-checkout-btn {
    width: 100%; padding: 14px 24px; border-radius: 12px; border: none; font-size: 1rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; transition: all 0.25s;
    background: linear-gradient(135deg, #dc2626, #ef4444); color: #fff;
    box-shadow: 0 6px 20px rgba(220,38,38,0.3);
  }
  .att-checkout-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(220,38,38,0.4); }
  .att-checkout-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none !important; }
  .att-checkout-hint { font-size: 0.75rem; color: #94a3b8; margin-top: 8px; }

  /* Timer Card */
  .att-timer-card {
    background: linear-gradient(135deg, #eff6ff, #dbeafe); border: 1px solid #bfdbfe; border-radius: 14px;
    padding: 20px; display: flex; align-items: center; gap: 16px; margin-top: 12px;
    box-shadow: 0 4px 16px rgba(59,130,246,0.08);
  }
  .att-timer-icon { font-size: 1.5rem; color: #3b82f6; }
  .att-timer-value { font-size: 2rem; font-weight: 800; color: #1e40af; font-variant-numeric: tabular-nums; }
  .att-timer-label { font-size: 0.78rem; color: #3b82f6; font-weight: 600; }

  /* Panel */
  .att-panel { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; box-shadow: 0 1px 3px rgba(15,23,42,0.04), 0 4px 16px rgba(15,23,42,0.04); transition: box-shadow 0.25s ease, transform 0.25s ease; }
  .att-panel:hover { box-shadow: 0 8px 32px rgba(15,23,42,0.08), 0 2px 8px rgba(15,23,42,0.04); transform: translateY(-2px); }
  .att-panel-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px; border-bottom: 1px solid #f1f5f9; background: #fafbfc;
  }
  .att-panel-title { font-size: 0.88rem; font-weight: 700; color: #1e293b; margin: 0; }
  .att-panel-body { padding: 16px 20px; }

  /* Scanner */
  .att-scanner-box {
    width: 100%; max-width: 300px; margin: 0 auto; aspect-ratio: 1; border: 2px dashed #e2e8f0;
    border-radius: 14px; display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: #f8fafc; gap: 6px;
  }
  .att-scanner-box i { font-size: 2rem; color: #94a3b8; }
  .att-scanner-box p { color: #94a3b8; font-size: 0.82rem; margin: 0; }

  #reader { max-width: 100%; margin: 0 auto; }
  #reader video, #reader canvas, #reader img { max-width: 100% !important; height: auto !important; }

  .att-sm-btn {
    padding: 10px 20px; border-radius: 10px; border: none; font-size: 0.85rem; font-weight: 600;
    display: inline-flex; align-items: center; gap: 6px; cursor: pointer; transition: all 0.2s;
  }
  .att-sm-btn.green { background: #dcfce7; color: #16a34a; }
  .att-sm-btn.green:hover { background: #bbf7d0; }
  .att-sm-btn.red { background: #fee2e2; color: #dc2626; }
  .att-sm-btn.red:hover { background: #fecaca; }

  .att-scanner-controls {
    display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap;
  }

  /* Timeline */
  .att-timeline { padding-left: 24px; border-left: 2px solid #e2e8f0; }
  .att-timeline-item { position: relative; padding: 10px 0 10px 20px; }
  .att-timeline-item::before {
    content: ''; position: absolute; left: -29px; top: 14px; width: 12px; height: 12px;
    border-radius: 50%; background: #3b82f6; border: 2px solid #fff; box-shadow: 0 0 0 2px #e2e8f0;
  }
  .att-timeline-item.check-in::before { background: #22c55e; }
  .att-timeline-item.check-out::before { background: #6366f1; }
  .att-timeline-time { font-size: 0.72rem; color: #94a3b8; font-weight: 600; }
  .att-timeline-label { font-size: 0.85rem; color: #1e293b; font-weight: 600; }
  .att-timeline-detail { font-size: 0.78rem; color: #64748b; }
  .att-empty-timeline { text-align: center; padding: 24px; color: #94a3b8; }
  .att-empty-timeline i { font-size: 2rem; display: block; margin-bottom: 8px; }

  .att-leave-banner { text-align: center; padding: 20px; }
  .att-leave-banner i { font-size: 2.5rem; color: #7c3aed; }
  .att-leave-banner h6 { margin-top: 8px; font-weight: 700; }

  /* History Table */
  .att-history-table { width: 100%; border-collapse: collapse; }
  .att-history-table th {
    background: #fafbfc; color: #64748b; font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.04em; padding: 12px 16px; border-bottom: 1px solid #e2e8f0; text-align: left; white-space: nowrap;
  }
  .att-history-table td { padding: 12px 16px; font-size: 0.85rem; color: #334155; border-bottom: 1px solid #f1f5f9; }
  .att-history-table tr:hover td { background: #fafbfc; }

  /* Page background (matches My Work) */
  .technician-page { background: #f1f5f9; min-height: 100vh; }
  .technician-page .container-fluid { display: block !important; }

  /* Main row */
  .att-main-row { display: flex; flex-wrap: wrap; }
  @media (max-width: 991px) {
    .att-main-row { flex-direction: column; }
  }

  /* Hero (matches My Work assignments) */
  .td-hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 40%, #2563eb 100%);
    border-radius: 16px;
    padding: 28px 32px;
    color: #fff;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1), 0 8px 16px rgba(0,0,0,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 24px;
  }
  .td-hero::before {
    content: '';
    position: absolute; top: -80%; right: -20%; width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(96,165,250,0.12) 0%, transparent 70%);
    border-radius: 50%; pointer-events: none;
  }
  .td-hero::after {
    content: '';
    position: absolute; bottom: -60%; left: -10%; width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(59,130,246,0.08) 0%, transparent 70%);
    border-radius: 50%; pointer-events: none;
  }
  .td-hero-content {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
  }
  .td-hero-left { display: flex; align-items: center; gap: 18px; }
  .td-hero-icon {
    width: 56px; height: 56px; border-radius: 16px;
    background: rgba(255,255,255,0.12); backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; border: 1px solid rgba(255,255,255,0.15); flex-shrink: 0;
  }
  .td-hero-title { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 4px; text-shadow: 0 1px 2px rgba(0,0,0,0.1); }
  .td-hero-sub { font-size: 0.82rem; opacity: 0.8; margin: 0; font-weight: 400; }
  .td-hero-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
  .td-hero-clock {
    padding: 10px 16px; background: rgba(255,255,255,0.1); border-radius: 12px;
    backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.12);
    font-size: 0.82rem; font-weight: 600; display: flex; align-items: center; gap: 8px;
  }
  .td-hero-clock i { opacity: 0.8; }

  /* Responsive Design */
  @media (max-width: 991px) {
    .td-hero { padding: 24px 28px; margin-bottom: 24px; }
