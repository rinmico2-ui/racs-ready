<div class="pos-container">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body.pos-body { background: #f8fafc; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; overflow: hidden; height: 100vh; color: #0f172a; }

    .pos-layout { display: grid; grid-template-columns: 1fr 400px; height: 100vh; overflow: hidden; }

    /* ── Left: Product Grid ── */
    .pos-products { display: flex; flex-direction: column; background: #f8fafc; overflow: hidden; }
    .pos-header { display: flex; align-items: center; padding: 18px 36px; background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 40%, #2563eb 100%); border-bottom: none; border-radius: 0; flex-shrink: 0; position: relative; overflow: hidden; }
    .pos-header::before { content:''; position:absolute; top:-60%; right:-20%; width:400px; height:400px; background:radial-gradient(circle,rgba(59,130,246,0.15) 0%,transparent 70%); pointer-events:none; }
    .pos-header::after { content:''; position:absolute; bottom:-40%; left:-10%; width:300px; height:300px; background:radial-gradient(circle,rgba(16,185,129,0.1) 0%,transparent 70%); pointer-events:none; }
    .pos-header-left { display: flex; align-items: center; gap: 16px; position: relative; z-index: 1; }
    .pos-header-icon { color: #fff; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.15); width: 56px; height: 56px; border-radius: 16px; font-size: 1.5rem; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(10px); }
    .pos-header-title { display: flex; flex-direction: column; gap: 3px; }+
    .pos-header h5 { color: #fff; font-weight: 700; font-size: 1.4rem; margin: 0; white-space: nowrap; font-family: "Outfit", "Inter", sans-serif; letter-spacing: -0.02em; line-height: 1.2; }
    .pos-header-title small { font-size: 0.85rem; color: rgba(255,255,255,0.65); font-weight: 400; line-height: 1.4; }

    .pos-search-bar { display: flex; align-items: center; gap: 12px; padding: 14px 36px; background: #ffffff; border-bottom: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.03); }

    .pos-search-box { flex: 1; position: relative; }
    .pos-search-box input { width: 100%; height: 44px; padding: 10px 14px 10px 42px; border-radius: 10px; border: 1.5px solid #e2e8f0; background: #ffffff; color: #0f172a; font-size: 0.9rem; outline: none; transition: border 0.2s; }
    .pos-search-box input:focus { border-color: #3b82f6; }
    .pos-search-box input::placeholder { color: #64748b; }
    .pos-search-box i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #64748b; font-size: 0.9rem; }

    .pos-barcode-box { position: relative; width: 260px; }
    .pos-barcode-box input { width: 100%; height: 44px; padding: 10px 14px 10px 42px; border-radius: 10px; border: 1.5px solid #e2e8f0; background: #ffffff; color: #0f172a; font-size: 0.9rem; font-family: monospace; outline: none; transition: border 0.2s; }
    .pos-barcode-box input:focus { border-color: #22c55e; }
    .pos-barcode-box input::placeholder { color: #64748b; }
    .pos-barcode-box i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #22c55e; font-size: 0.9rem; }

    .pos-categories { display: flex; gap: 8px; padding: 16px 20px; overflow-x: auto; flex-shrink: 0; border-bottom: 1px solid #e2e8f0; }
    .pos-categories::-webkit-scrollbar { height: 3px; }
    .pos-categories::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 10px; }
    .pos-cat-btn { padding: 6px 14px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; border: 1.5px solid #e2e8f0; background: #ffffff; color: #64748b; cursor: pointer; white-space: nowrap; transition: all 0.2s; }
    .pos-cat-btn:hover { border-color: #3b82f6; color: #3b82f6; }
    .pos-cat-btn.active { background: #3b82f6; color: #fff; border-color: #3b82f6; box-shadow: 0 4px 10px rgba(59,130,246,0.25); }

    .pos-grid { flex: 1; overflow-y: auto; padding: 16px 20px; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; align-content: start; }
    .pos-grid::-webkit-scrollbar { width: 6px; }
    .pos-grid::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 10px; }

    .pos-item { background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 14px; cursor: pointer; transition: all 0.2s; display: flex; flex-direction: column; gap: 8px; position: relative; }
    .pos-item:hover { border-color: #3b82f6; transform: translateY(-2px); box-shadow: 0 4px 16px rgba(59,130,246,0.15); }
    .pos-item.oos { opacity: 0.4; pointer-events: none; }
    .pos-item-img { width: 100%; height: 100px; object-fit: contain; border-radius: 8px; background: #f1f5f9; margin-bottom: 8px; }
    .pos-item-name { font-weight: 700; font-size: 0.85rem; color: #0f172a; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .pos-item-cat { font-size: 0.68rem; color: #64748b; }
    .pos-item-price { font-size: 1.1rem; font-weight: 600; color: #22c55e; }
    .pos-item-stock { font-size: 0.7rem; color: #94a3b8; }
    .pos-item-stock strong { color: #f59e0b; }
    .pos-item-barcode { font-size: 0.7rem; color: #64748b; font-family: monospace; margin: 4px 0; letter-spacing: 0.5px; display: flex; align-items: center; gap: 4px; }

    .pos-tabs { display: flex; gap: 10px; padding: 14px 20px; background: #ffffff; border-bottom: 1px solid #e2e8f0; }
    .pos-tab { flex: 1; padding: 10px 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; color: #64748b; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px; }
    .pos-tab:hover { border-color: #3b82f6; color: #3b82f6; }
    .pos-tab.active { background: linear-gradient(90deg, #0f172a 0%, #1d4ed8 60%, #2563eb 100%); border: 1px solid transparent; color: #fff; box-shadow: 0 4px 12px rgba(37,99,235,0.25); }

    .pos-aircon-card { background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 14px; cursor: pointer; transition: all 0.2s; display: flex; flex-direction: column; gap: 8px; position: relative; }
    .pos-aircon-card:hover { border-color: #3b82f6; transform: translateY(-2px); box-shadow: 0 4px 16px rgba(59,130,246,0.15); }
    .pos-aircon-card.oos { opacity: 0.4; pointer-events: none; }
    .pos-aircon-img { width: 100%; height: 100px; object-fit: contain; border-radius: 8px; background: #f1f5f9; margin-bottom: 8px; }
    .pos-aircon-name { font-weight: 700; font-size: 0.85rem; color: #0f172a; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .pos-aircon-cat { font-size: 0.68rem; color: #64748b; }
    .pos-aircon-price { font-size: 1.1rem; font-weight: 600; color: #22c55e; }
    .pos-aircon-stock { font-size: 0.7rem; color: #94a3b8; }
    .pos-aircon-stock strong { color: #f59e0b; }
    .pos-aircon-barcode { font-size: 0.7rem; color: #64748b; font-family: monospace; margin: 4px 0; letter-spacing: 0.5px; display: flex; align-items: center; gap: 4px; }

    .pos-empty { text-align: center; padding: 60px 20px; color: #64748b; grid-column: 1 / -1; }
    .pos-empty i { font-size: 3rem; color: #94a3b8; display: block; margin-bottom: 12px; }

    /* ── Right: Cart Panel ── */
    .pos-cart { display: flex; flex-direction: column; background: #ffffff; border-left: 1px solid #e2e8f0; border-radius: 20px 0 0 20px; overflow: hidden; box-shadow: -10px 0 30px rgba(15,36,96,0.06); }
    .pos-cart-header { padding: 20px 36px; background: linear-gradient(90deg, #0f172a 0%, #1d4ed8 60%, #2563eb 100%); border-bottom: 1px solid rgba(255,255,255,0.1); border-radius: 0; display: flex; align-items: center; flex-shrink: 0; }
    .pos-cart-header-left { display: flex; align-items: center; gap: 16px; }
    .pos-cart-header-icon { color: #fff; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.15); width: 48px; height: 48px; border-radius: 14px; font-size: 1.3rem; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(10px); }
    .pos-cart-header-title { display: flex; flex-direction: column; gap: 3px; }
    .pos-cart-header h6 { font-weight: 600; font-size: 1.15rem; color: #fff; margin: 0; font-family: "Outfit", "Inter", sans-serif; letter-spacing: -0.02em; }
    .pos-cart-header-title small { font-size: 0.8rem; color: rgba(255,255,255,0.65); font-weight: 400; }
    .pos-cart-count { background: #fff; color: #2563eb; font-size: 0.8rem; font-weight: 700; padding: 3px 9px; border-radius: 10px; }
    .pos-cart-meta { padding: 10px 20px; background: #fff; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; }
    .pos-cart-meta-label { display: flex; align-items: center; gap: 10px; font-size: 0.85rem; font-weight: 600; color: #0f172a; }
    .pos-cart-meta-label i { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; font-size: 0.8rem; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 6px rgba(37,99,235,0.25); }
    .pos-cart-meta .pos-cart-count { background: #2563eb; color: #fff; }

    .pos-customer-bar { margin: 12px 20px; padding: 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; flex-shrink: 0; }
    .pos-customer-bar input { width: 100%; padding: 8px 12px; border-radius: 8px; border: 1.5px solid #e2e8f0; font-size: 0.82rem; background: #ffffff; outline: none; transition: border 0.2s; }
    .pos-customer-bar input:focus { border-color: #3b82f6; }

    .pos-cart-items { flex: 1; overflow-y: auto; padding: 12px 20px; }
    .pos-cart-items::-webkit-scrollbar { width: 4px; }
    .pos-cart-items::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

    .pos-cart-item { display: flex; align-items: center; gap: 10px; padding: 10px; border-bottom: 1px solid #f1f5f9; border-radius: 8px; transition: background 0.15s; }
    .pos-cart-item:hover { background: #f8fafc; }
    .pos-cart-item:last-child { border-bottom: none; }
    .pos-cart-item-info { flex: 1; min-width: 0; }
    .pos-cart-item-name { font-weight: 600; font-size: 0.82rem; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pos-cart-item-price { font-size: 0.72rem; color: #64748b; }
    .pos-cart-item-qty { display: flex; align-items: center; gap: 6px; }
    .pos-cart-item-qty button { width: 26px; height: 26px; border-radius: 6px; border: 1.5px solid #e2e8f0; background: #fff; color: #0f172a; font-weight: 700; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
    .pos-cart-item-qty button:hover { border-color: #3b82f6; color: #3b82f6; }
    .pos-cart-item-qty span { font-weight: 700; font-size: 0.85rem; min-width: 20px; text-align: center; }
    .pos-cart-item-total { font-weight: 700; font-size: 0.85rem; color: #0f172a; white-space: nowrap; }
    .pos-cart-item-remove { color: #ef4444; cursor: pointer; font-size: 0.85rem; padding: 4px; border-radius: 6px; transition: background 0.15s; }
    .pos-cart-item-remove:hover { background: #fef2f2; }

    .pos-cart-empty { text-align: center; padding: 40px 20px; color: #94a3b8; }
    .pos-cart-empty i { font-size: 2.5rem; color: #e2e8f0; display: block; margin-bottom: 8px; }
    .pos-cart-empty p { font-size: 0.82rem; }

    /* ── Cart Summary ── */
    .pos-cart-summary { background: #f8fafc; border-top: 2px solid #e2e8f0; padding: 16px 20px; flex-shrink: 0; }
    .pos-summary-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .pos-summary-row .label { font-size: 0.8rem; color: #64748b; }
    .pos-summary-row .value { font-weight: 600; font-size: 0.85rem; color: #0f172a; }
    .pos-summary-row.discount .value { color: #ef4444; }
    .pos-summary-row.total { margin-top: 10px; padding-top: 10px; border-top: 2px dashed #e2e8f0; }
    .pos-summary-row.total .label { font-weight: 700; font-size: 0.9rem; color: #0f172a; }
    .pos-summary-row.total .value { font-size: 1.5rem; font-weight: 700; color: #0f172a; }

    .pos-discount-row { display: flex; gap: 8px; margin-bottom: 10px; }
    .pos-discount-row input { flex: 1; padding: 8px 10px; border-radius: 8px; border: 1.5px solid #e2e8f0; font-size: 0.82rem; background: #ffffff; outline: none; }
    .pos-discount-row input:focus { border-color: #3b82f6; }

    /* ── Payment Section ── */
    .pos-payment { padding: 16px 20px; background: #f8fafc; border-top: 1px solid #e2e8f0; flex-shrink: 0; }
    .pos-payment-methods { display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap; }
    .pos-pay-btn { padding: 7px 14px; border-radius: 8px; border: 1.5px solid #e2e8f0; background: #fff; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.15s; display: flex; align-items: center; gap: 5px; }
    .pos-pay-btn:hover { border-color: #3b82f6; color: #3b82f6; }
    .pos-pay-btn.active { background: #3b82f6; color: #fff; border-color: #3b82f6; box-shadow: 0 4px 12px rgba(37,99,235,0.2); }

    .pos-amount-input { display: flex; gap: 8px; margin-bottom: 12px; }
    .pos-amount-input label { font-size: 0.75rem; color: #64748b; font-weight: 600; align-self: center; }
    .pos-amount-input input { flex: 1; padding: 10px 12px; border-radius: 8px; border: 1.5px solid #e2e8f0; font-size: 1rem; font-weight: 700; outline: none; text-align: right; background: #ffffff; }
    .pos-amount-input input:focus { border-color: #3b82f6; }

    .pos-change-row { display: flex; justify-content: space-between; padding: 8px 12px; background: #f0fdf4; border-radius: 8px; margin-bottom: 12px; }
    .pos-change-row .label { font-size: 0.78rem; color: #16a34a; font-weight: 600; }
    .pos-change-row .value { font-size: 1rem; font-weight: 600; color: #16a34a; }

    .pos-checkout-btn { width: 100%; padding: 16px; border: none; border-radius: 12px; background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; font-size: 1.05rem; font-weight: 700; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 16px rgba(34,197,94,0.25); }
    .pos-checkout-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(34,197,94,0.3); }
    .pos-checkout-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }

    /* ── Receipt Modal ── */
    .pos-receipt-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9999; justify-content: center; align-items: center; }
    .pos-receipt-overlay.show { display: flex; }
    .pos-receipt { background: #fff; border-radius: 16px; width: 420px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 60px rgba(0,0,0,0.3); }
    .pos-receipt-header { padding: 20px 24px; background: linear-gradient(135deg, #0f172a, #1e40af); color: #fff; border-radius: 16px 16px 0 0; text-align: center; }
    .pos-receipt-header h4 { font-weight: 700; font-size: 1rem; margin: 0; }
    .pos-receipt-header p { font-size: 0.75rem; opacity: 0.8; margin: 4px 0 0; }
    .pos-receipt-body { padding: 20px 24px; }
    .pos-receipt-divider { border: none; border-top: 2px dashed #e2e8f0; margin: 16px 0; }
    .pos-receipt-footer { padding: 16px 24px; background: #f8fafc; border-radius: 0 0 16px 16px; text-align: center; }
    .pos-receipt-footer p { font-size: 0.72rem; color: #64748b; margin: 2px 0; }
    .pos-receipt-actions { display: flex; gap: 8px; padding: 16px 24px; }
    .pos-receipt-actions button { flex: 1; padding: 10px; border-radius: 8px; font-weight: 600; font-size: 0.82rem; cursor: pointer; border: none; transition: all 0.15s; }
    .pos-receipt-print { background: #3b82f6; color: #fff; }
    .pos-receipt-print:hover { background: #2563eb; }
    .pos-receipt-close { background: #e2e8f0; color: #475569; }
    .pos-receipt-close:hover { background: #cbd5e1; }

    /* ── POS Toast/Modal ── */
    .pos-toast-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center; }
    .pos-toast-overlay.show { display: flex; }
    .pos-toast-modal { background: #fff; border-radius: 16px; width: 420px; max-width: 90%; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.3); animation: pos-toast-in 0.2s ease; }
    @keyframes pos-toast-in { from { opacity: 0; transform: translateY(-20px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .pos-toast-header { padding: 18px 24px; background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 40%, #2563eb 100%); color: #fff; font-weight: 700; font-size: 1.05rem; text-align: center; position: relative; }
    .pos-toast-close { position: absolute; top: 50%; right: 16px; transform: translateY(-50%); background: none; border: none; color: #fff; font-size: 1.15rem; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; }
    .pos-toast-close:hover { background: rgba(255,255,255,0.15); }
    .pos-toast-body { padding: 24px; text-align: center; }
    .pos-toast-icon { width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; }
    .pos-toast-icon.success { background: #dcfce7; color: #16a34a; }
    .pos-toast-icon.error { background: #fee2e2; color: #ef4444; }
    .pos-toast-icon.warning { background: #fef3c7; color: #f59e0b; }
    .pos-toast-icon.info { background: #dbeafe; color: #3b82f6; }
    .pos-toast-message { font-size: 0.95rem; color: #334155; margin: 0 0 20px; line-height: 1.5; }
    .pos-toast-ok { padding: 10px 36px; border-radius: 10px; border: none; background: #e2e8f0; color: #0f172a; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: all 0.15s; }
    .pos-toast-ok:hover { background: #cbd5e1; }

    /* ── Sales History ── */
    .pos-history-toggle { background: #ffffff; border: 1.5px solid #e2e8f0; color: #0f172a; width: 44px; height: 44px; border-radius: 10px; cursor: pointer; font-size: 1.1rem; transition: all 0.2s; display: flex; align-items: center; justify-content: center; }
    .pos-history-toggle:hover { border-color: #3b82f6; color: #3b82f6; }
    .pos-history-modal { display: flex; flex-direction: column; max-height: 85vh; overflow: hidden; }
    .pos-history-controls { padding: 16px 24px; border-bottom: 1px solid #e2e8f0; display: flex; gap: 10px; background: #fff; }
    .pos-history-controls input, .pos-history-controls select { flex: 1; padding: 8px 12px; border-radius: 8px; border: 1.5px solid #e2e8f0; background: #f8fafc; color: #0f172a; font-size: 0.85rem; outline: none; }
    .pos-history-controls input:focus, .pos-history-controls select:focus { border-color: #3b82f6; }
    .pos-history-list { flex: 1; overflow-y: auto; padding: 16px 24px; min-height: 0; }
    .pos-history-pagination { padding: 12px 24px; border-top: 1px solid #e2e8f0; display: flex; justify-content: center; gap: 6px; align-items: center; background: #fff; }
    .pos-history-page { padding: 6px 10px; border-radius: 6px; border: 1.5px solid #cbd5e1; background: #f1f5f9; color: #0f172a; font-size: 0.78rem; font-weight: 600; cursor: pointer; }
    .pos-history-page:hover:not(:disabled) { background: #e2e8f0; border-color: #3b82f6; color: #3b82f6; }
    .pos-history-page.active { background: #3b82f6; border-color: #3b82f6; color: #fff; }
    .pos-history-page:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ── Responsive ── */
    @media print {
      body * { visibility: hidden; }
      .pos-receipt, .pos-receipt * { visibility: visible; }
      .pos-receipt { position: absolute; left: 0; top: 0; width: 100%; border-radius: 0; box-shadow: none; }
      .pos-receipt-actions { display: none !important; }
    }
  /* ── Enterprise Cart Panel ── */
    .pos-cart { border-radius: 0; box-shadow: none; border-left: 1px solid #e2e8f0; overflow-y: auto; }
    .pos-cart-header { padding: 18px 24px; background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 40%, #2563eb 100%); border-bottom: none; position: relative; overflow: hidden; }
    .pos-cart-header-icon { width: 56px; height: 56px; border-radius: 16px; font-size: 1.5rem; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(10px); }
    .pos-cart-header h6 { font-size: 1.4rem; font-weight: 700; }
    .pos-cart-header-title small { color: rgba(255,255,255,0.65); font-size: 0.85rem; }
    .pos-cart-meta { padding: 12px 24px; background: #fff; border-bottom: 1px solid #e2e8f0; }
    .pos-cart-meta-label { font-size: 0.8rem; font-weight: 600; color: #64748b; }
    .pos-cart-meta .pos-cart-count { background: #0f172a; color: #fff; padding: 4px 10px; border-radius: 20px; }
