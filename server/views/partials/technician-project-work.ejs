      <div class="pw-modal">
        <h5 style="font-size:1rem;font-weight:800;margin-bottom:0.5rem;">${title}</h5>
        <p style="font-size:.78rem;color:var(--pw-muted);margin-bottom:0.75rem;">${subtitle}</p>
        <label style="font-size:.75rem;font-weight:600;color:var(--pw-muted);">Details</label>
        <textarea id="pwIssDesc" class="form-control form-control-sm mt-1" rows="3" placeholder="Add details"></textarea>
        <div class="d-flex gap-2 justify-content-end mt-3">
