  <div style="background: #fff; border-radius: 14px; box-shadow: 0 25px 60px rgba(0,0,0,0.2); width: 100%; max-width: min(640px, 94vw); max-height: 85vh; display: flex; flex-direction: column; overflow: hidden;">
