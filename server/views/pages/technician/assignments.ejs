    overflow-y: auto;
  }

  .dminfo-activity::-webkit-scrollbar {
    width: 4px;
  }

  .dminfo-activity::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }

  .dminfo-action-bar {
    background: #fff;
    border-top: 1px solid #e8ecf1;
    padding: 18px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .dminfo-action-bar .btn {
    font-weight: 700;
    font-size: 0.85rem;
    padding: 10px 24px;
    border-radius: 10px;
    letter-spacing: 0.01em;
    transition: all 0.2s;
  }

  .dminfo-action-bar .btn:hover {
    transform: translateY(-1px);
  }

  /* ── Proof Upload ── */
  .proof-upload-area.drag-over {
    border-color: #059669;
    background: #f0fdf4;
    box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.1);
  }

  .proof-upload-area.drag-over #proofUploadPlaceholder {
    opacity: 0.5;
  }

  /* ── Timeline ── */
  .ent-timeline {
    padding-left: 20px;
    border-left: 2px solid #e2e8f0;
  }

  .ent-timeline-item {
    position: relative;
    padding: 8px 0 8px 16px;
    font-size: 0.8rem;
    color: #475569;
  }

  .ent-timeline-dot {
    position: absolute;
    left: -26px;
    top: 12px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3b82f6;
    border: 2px solid #fff;
  }

  .ent-timeline-time {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  /* ── Enterprise Notifications ── */
  .ent-notification {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #fff;
    border-radius: 14px;
    padding: 16px 20px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.12);
    border-left: 4px solid #2563eb;
    pointer-events: auto;
    animation: entNotifIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    width: min(380px, 90vw);
  }

  .ent-notification.removing {
    animation: entNotifOut 0.3s ease-in forwards;
  }

  .ent-notification-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .ent-notification-body {
    flex: 1;
    min-width: 0;
  }

  .ent-notification-title {
    font-weight: 700;
    font-size: 0.85rem;
    color: #1e293b;
    margin: 0 0 2px;
  }

  .ent-notification-message {
    font-size: 0.78rem;
    color: #64748b;
    margin: 0;
    line-height: 1.4;
  }

  .ent-notification-close {
    background: none;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    padding: 0 0 0 8px;
    font-size: 1rem;
    line-height: 1;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  .ent-notification-close:hover {
    color: #475569;
  }

  .ent-notif-success {
    border-left-color: #10b981;
  }

  .ent-notif-success .ent-notification-icon {
    background: #d1fae5;
    color: #059669;
  }

  .ent-notif-error {
    border-left-color: #ef4444;
  }

  .ent-notif-error .ent-notification-icon {
    background: #fee2e2;
    color: #dc2626;
  }

  .ent-notif-warning {
    border-left-color: #f59e0b;
  }

  .ent-notif-warning .ent-notification-icon {
    background: #fef3c7;
    color: #d97706;
  }

  .ent-notif-info {
    border-left-color: #2563eb;
  }

  .ent-notif-info .ent-notification-icon {
    background: #dbeafe;
    color: #2563eb;
  }

  @keyframes entNotifIn {
    from {
      opacity: 0;
      transform: translateX(100%);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes entNotifOut {
    from {
      opacity: 1;
      transform: translateX(0);
    }

    to {
      opacity: 0;
      transform: translateX(100%);
    }
  }

