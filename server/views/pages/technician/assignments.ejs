            <h1 class="mw-hero-title">My Work</h1>
            <p class="mw-hero-subtitle">Manage assignments, schedule, and track status</p>
          </div>
        </div>
        <div class="mw-hero-right">
          <div class="mw-hero-stats">
            <div class="mw-hero-stat">
              <div class="mw-hero-stat-value" id="heroActive">0</div>
              <div class="mw-hero-stat-label">Active</div>
            </div>
            <div class="mw-hero-stat">
              <div class="mw-hero-stat-value" id="heroPending">0</div>
              <div class="mw-hero-stat-label">Pending</div>
            </div>
            <div class="mw-hero-stat">
              <div class="mw-hero-stat-value" id="heroToday">0</div>
              <div class="mw-hero-stat-label">Today</div>
            </div>
