<script>
  // ═════════════════════════════════════════════════════════════════════════════
  // REPAIR WORK ORDER FUNCTIONS
  // ═════════════════════════════════════════════════════════════════════════════

  let _repairBookingId = null;

  // Helper: Open a modal after ensuring all other modals are fully closed
  // usage: openModalAfterClose('inspectionModal', 'assignDetailModal', () => openInspectionModal(id, name, service))
  function openModalAfterClose(openModalId, closeModalId, callback) {
    // If closing the detail panel, close it first
    if (closeModalId === 'assignDetailModal') {
      closeDetailPanel();
    } else {
      const closeEl = document.getElementById(closeModalId);
      if (closeEl && closeEl.classList.contains('show')) {
        closeEl.addEventListener('hidden.bs.modal', function onHidden() {
          closeEl.removeEventListener('hidden.bs.modal', onHidden);
          document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
          document.body.classList.remove('modal-open');
          document.body.style.overflow = '';
          document.body.style.paddingRight = '';
          setTimeout(doOpenInner, 150);
        });
        bootstrap.Modal.getOrCreateInstance(closeEl).hide();
        return;
      }
    }

    const doOpenInner = () => {
      const openEl = document.getElementById(openModalId);
      if (callback) callback();
      else if (openEl) new bootstrap.Modal(openEl).show();
    };

    if (openModalId || callback) {
      setTimeout(doOpenInner, 50);
    }
  }

