  <!-- KPIs script -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    function applyBadge(id,text){
      var el=document.getElementById(id);
      if(!el)return;
      el.innerHTML=text;
      el.classList.remove('positive','negative','neutral');
      if(/^[+]/.test(text))el.classList.add('positive');
      else if(/^[-]/.test(text))el.classList.add('negative');
      else el.classList.add('neutral');
    }
    function createSparkline(id,data,color){
      var c=document.getElementById(id);if(!c||typeof Chart==='undefined')return null;
      var ctx=c.getContext('2d');var h=c.height||c.offsetHeight||50;
      var grad=ctx.createLinearGradient(0,0,0,h);grad.addColorStop(0,color);grad.addColorStop(1,'rgba(255,255,255,0)');
      return new Chart(c,{type:'line',data:{labels:data.map((_,i)=>i+1),datasets:[{data:data,borderColor:color,backgroundColor:grad,fill:true,tension:0.35}]},options:{responsive:true,maintainAspectRatio:false,animation:{duration:800},plugins:{legend:{display:false},tooltip:{enabled:false}},elements:{point:{radius:0}},scales:{x:{display:false},y:{display:false}}}});
    }
    try{
      applyBadge('badgePrivRegular','+3.2%');
      applyBadge('badgePrivVIP','+1.1%');
      applyBadge('badgePrivCorp','-0.8%');
      createSparkline('kpiSparkPrivRegular',[5,7,6,8,7,9,8],'#4361ee');
      createSparkline('kpiSparkPrivVIP',[4,6,5,7,6,8,7],'#f59e0b');
      createSparkline('kpiSparkPrivCorp',[3,5,4,6,5,7,6],'#2ec4b6');
    }catch(e){/*ignore*/}
  </script>

