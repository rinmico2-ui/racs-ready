    .inventory-premium .rp-filter-input { border-radius: 10px; border-color: #e2e8f0; height: 42px; }
    .inventory-premium .rp-filter-group .form-select { background-position: right .6rem center; }
    .inventory-premium .rp-filter-btn { height: 42px; border-radius: 10px; padding: 0 20px; font-weight: 600; }

    /* Subtle badges */
    .inventory-premium .bg-success-subtle { background-color: rgba(16, 185, 129, 0.15); }
    .inventory-premium .bg-info-subtle { background-color: rgba(8, 145, 178, 0.15); }
    .inventory-premium .bg-warning-subtle { background-color: rgba(245, 158, 11, 0.15); }
    .inventory-premium .bg-danger-subtle { background-color: rgba(220, 38, 38, 0.15); }
    .inventory-premium .bg-primary-subtle { background-color: rgba(59, 130, 246, 0.15); }
    .inventory-premium .bg-secondary-subtle { background-color: rgba(100, 116, 139, 0.15); }

    /* Dense table */
    .inventory-premium .table-dense th, .inventory-premium .table-dense td { padding: 0.65rem 0.85rem; font-size: 0.85rem; vertical-align: middle; }
    .inventory-premium .table-dense thead th { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; color: #475569; }
    .inventory-premium .table-dense .btn-sm { padding: 0.25rem 0.5rem; font-size: 0.75rem; }

    /* Pagination */
    .inv-pagination {
      display: flex; gap: 0.5rem; margin: 0; padding: 0; list-style: none;
    }
    .inv-pagination .page-item .page-link {
      padding: 8px 14px; border-radius: 10px; border: 1.5px solid rgba(148,163,184,0.3);
      background: rgba(255,255,255,0.8); color: #475569; font-weight: 600; font-size: 0.85rem;
      transition: all 0.3s ease;
    }
    .inv-pagination .page-item:not(.disabled) .page-link:hover { background: #fff; border-color: #2563eb; color: #2563eb; }
    .inv-pagination .page-item.disabled .page-link { opacity: 0.5; }
  </style>

