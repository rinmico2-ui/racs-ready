          <thead>
            <tr>
              <th>Service</th>
              <th>Segment</th>
              <th style="text-align:center;">Bookings / Units</th>
              <th style="text-align:center;">Completion Rate</th>
              <th style="text-align:right;">Avg Booked Value</th>
              <th style="text-align:center;">Customer Rating</th>
