<script>
function setupReportNav() {
  var nav = document.getElementById('reportNav');
  if (!nav) return;
  var sectionIds = ['section-executive','section-performance','section-collection','section-cost','section-service-profit','section-pos','section-activity'];
  var buttons = Array.from(nav.querySelectorAll('.report-nav-btn'));
  var groups = {};

  sectionIds.forEach(function(id) {
    var heading = document.getElementById(id);
    var nodes = [];
    if (!heading) { groups[id] = nodes; return; }
    var current = heading;
    while (current && (current === heading || !sectionIds.includes(current.id))) {
      nodes.push(current);
      current.classList.add('rr-report-panel');
      current = current.nextElementSibling;
    }
    groups[id] = nodes;
  });

  var kpiGrid = document.getElementById('kpiGrid');
  if (kpiGrid) kpiGrid.insertAdjacentElement('afterend', nav);

  function selectSection(target, updateHash) {
    sectionIds.forEach(function(id) {
      (groups[id] || []).forEach(function(node) {
        node.hidden = id !== target;
        node.classList.toggle('is-active', id === target);
      });
    });
    buttons.forEach(function(button) {
      var active = button.dataset.target === target;
      button.classList.toggle('active', active);
      button.setAttribute('aria-selected', active ? 'true' : 'false');
      button.setAttribute('aria-controls', button.dataset.target);
      button.tabIndex = active ? 0 : -1;
    });
    if (updateHash && history.replaceState) history.replaceState(null, '', '#' + target);
    window.setTimeout(function() { window.dispatchEvent(new Event('resize')); }, 30);
  }

  buttons.forEach(function(button) {
    button.addEventListener('click', function() { selectSection(button.dataset.target, true); });
    button.addEventListener('keydown', function(event) {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      var currentIndex = buttons.indexOf(button);
      var nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : (currentIndex + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length;
      buttons[nextIndex].focus();
      buttons[nextIndex].click();
    });
  });

  var requested = window.location.hash.replace('#', '');
  selectSection(sectionIds.includes(requested) ? requested : 'section-executive', false);
}
if (document.readyState === 'loading') { window.addEventListener('DOMContentLoaded', setupReportNav); } else { setupReportNav(); }
</script>
