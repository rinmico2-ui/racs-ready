<!-- Log Equipment Usage Modal -->
<div class="modal fade" id="logEquipmentModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:16px;border:none;box-shadow:0 20px 50px rgba(15,23,42,0.15);">
      <div style="background:linear-gradient(135deg,#0f172a,#1e293b);padding:1.25rem 1.5rem;display:flex;align-items:center;justify-content:space-between;border-radius:16px 16px 0 0;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#10b981,#059669);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1rem;"><i class="bi bi-calendar-check"></i></div>
          <div>
            <h6 style="margin:0;font-weight:700;color:#fff;font-size:0.95rem;">Log Equipment Usage</h6>
            <p style="margin:0;font-size:0.72rem;color:#94a3b8;">Record which equipment you used today</p>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" style="padding:1.25rem 1.5rem;">
        <div style="margin-bottom:14px;">
          <label style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:#64748b;margin-bottom:6px;display:block;">Equipment *</label>
          <select id="logEquipment" class="form-select" style="border-radius:10px;border:1px solid #e2e8f0;font-size:0.85rem;" required>
            <option value="">Select equipment...</option>
          </select>
        </div>
        <div style="margin-bottom:14px;">
          <label style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:#64748b;margin-bottom:6px;display:block;">Date *</label>
          <input type="date" id="logDate" class="form-control" style="border-radius:10px;border:1px solid #e2e8f0;font-size:0.85rem;" required />
        </div>
        <div style="margin-bottom:14px;">
          <label style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:#64748b;margin-bottom:6px;display:block;">Notes</label>
          <textarea id="logNotes" class="form-control" rows="2" maxlength="500" placeholder="Optional notes about usage..." style="border-radius:10px;border:1px solid #e2e8f0;font-size:0.85rem;resize:none;"></textarea>
        </div>
      </div>
      <div style="padding:0 1.5rem 1.25rem;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-sm" style="border-radius:8px;border:1px solid #e2e8f0;color:#64748b;" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-sm btn-success" style="border-radius:8px;font-weight:600;" onclick="saveEquipmentUsage()"><i class="bi bi-check2-circle me-1"></i>Save</button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  const conditionBadges = { good: 'bg-success', fair: 'bg-warning text-dark', damaged: 'bg-danger', lost: 'bg-secondary' };

  async function loadTools() {
    try {
      const res = await fetch('/api/technician/tools/assigned');
      const data = await res.json();
      const container = document.getElementById('assignedTools');
      document.getElementById('assignedCount').textContent = data.count || 0;

      if (!data.items || data.items.length === 0) {
        container.innerHTML = '<div class="text-center py-4 text-muted"><i class="bi bi-tools" style="font-size:2rem;"></i><br>No tools currently assigned</div>';
      } else {
        container.innerHTML = data.items.map(t => `
          <div class="tool-card">
            <div class="tool-icon"><i class="bi bi-tools"></i></div>
            <div class="tool-info">
              <h6>${t.toolName || 'Tool'}</h6>
              <p>Qty: ${t.quantity || 1} ${t.toolBarcode ? '| ' + t.toolBarcode : ''}</p>
            </div>
            <span class="badge ${conditionBadges[t.condition] || 'bg-secondary'}">${(t.condition || 'good').toUpperCase()}</span>
          </div>
        `).join('');
      }
    } catch(e) {
      document.getElementById('assignedTools').innerHTML = '<div class="text-danger">Failed to load</div>';
    }
  }

  async function loadHistory() {
    try {
      const res = await fetch('/api/technician/tools/assigned/history');
      const data = await res.json();
      const container = document.getElementById('toolHistory');

      if (!data.items || data.items.length === 0) {
        container.innerHTML = '<div class="text-center py-4 text-muted">No tool history</div>';
      } else {
        container.innerHTML = data.items.map(t => {
          const assigned = t.assignedDate ? new Date(t.assignedDate).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' }) : '';
          const returned = t.returnedDate ? new Date(t.returnedDate).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' }) : 'Still assigned';
          return `
            <div class="tool-history-item">
              <div>
                <strong>${t.toolName || 'Tool'}</strong>
                <span class="text-muted ms-2">x${t.quantity || 1}</span>
              </div>
              <div class="text-end">
                <span class="badge ${t.status === 'returned' ? 'bg-success' : t.status === 'lost' ? 'bg-danger' : 'bg-primary'}">${t.status || 'assigned'}</span>
                <div class="text-muted" style="font-size:0.72rem;">${assigned} → ${returned}</div>
              </div>
            </div>`;
        }).join('');
      }
    } catch(e) {
      document.getElementById('toolHistory').innerHTML = '<div class="text-danger">Failed to load</div>';
    }
  }

  let bookingGroups = new Map();
  let currentBookingKey = null;

  const fmtDate = (d) => d ? new Date(d).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }) : '';

  function renderItems(items) {
    return items.map(e => {
      const statusClass = e.status === 'reserved' ? 'bg-warning text-dark' : e.status === 'checked_out' ? 'bg-info' : e.status === 'returned' ? 'bg-success' : 'bg-secondary';
      const canReturn = e.status === 'checked_out' || e.status === 'in_use';
      return `
        <div class="tool-card">
          <div class="tool-icon"><i class="bi bi-tools"></i></div>
          <div class="tool-info">
            <h6>${e.equipmentName || 'Tool'}${e.equipmentCode ? ' <span class="text-muted fw-normal">(' + e.equipmentCode + ')</span>' : ''}</h6>
            <p>Qty: ${e.quantity || 1} <span class="badge ${statusClass}">${e.status}</span></p>
          </div>
          ${canReturn ? `<button class="btn btn-sm btn-outline-primary" onclick="returnBookingEquipment('${e._id}', '${String(e.equipmentName).replace(/'/g, '\\\'')}')">Return</button>` : ''}
        </div>`;
    }).join('');
  }

  function bookingInfo(group) {
    const b = group.booking;
    const isOrphan = !b;
    const ref = isOrphan ? 'General / No Booking' : (b.bookingReference || 'Booking');
    const customer = (!isOrphan && b.customer && b.customer.name) ? b.customer.name : '';
    const service = (!isOrphan && b.service && b.service.name) ? b.service.name : '';
    const dateStr = (!isOrphan && b.bookingDate) ? fmtDate(b.bookingDate) : '';
    const sub = isOrphan
      ? 'Equipment not linked to a specific booking'
      : [customer, service, dateStr].filter(Boolean).join(' &middot; ');
    return { isOrphan, ref, sub };
  }

  async function loadBookingEquipment() {
    try {
      const res = await fetch('/api/technician/equipment');
      const data = await res.json();
      const container = document.getElementById('bookingEquipment');
      const countEl = document.getElementById('bookingEquipmentCount');
      const items = (data.items || []);
      const activeItems = items.filter(e => e.status === 'checked_out' || e.status === 'in_use');
      if (countEl) countEl.textContent = activeItems.length;

      if (items.length === 0) {
        container.innerHTML = '<div class="text-center py-4 text-muted"><i class="bi bi-tools" style="font-size:2rem;"></i><br>No booking equipment assigned</div>';
        return;
      }

      const groups = new Map();
      for (const e of items) {
        const booking = e.bookingId && e.bookingId._id ? e.bookingId : null;
        const key = booking ? String(booking._id) : 'none';
        if (!groups.has(key)) groups.set(key, { booking, items: [] });
        groups.get(key).items.push(e);
      }
      bookingGroups = groups;

      container.innerHTML = Array.from(groups.values()).map(group => {
        const key = group.booking ? String(group.booking._id) : 'none';
        const info = bookingInfo(group);
        return `
          <button type="button" class="booking-row ${info.isOrphan ? 'booking-row-orphan' : ''}" onclick="openBookingModal('${key}')">
            <div class="booking-row-left">
              <div class="booking-ref">${info.ref}</div>
              <div class="booking-meta">
                ${info.isOrphan
                  ? '<span class="badge bg-warning text-dark">Not linked to a booking</span>'
                  : info.sub}
              </div>
            </div>
            <div class="booking-row-right">
              <span class="badge bg-info">${group.items.length} item${group.items.length === 1 ? '' : 's'}</span>
              <i class="bi bi-chevron-right"></i>
            </div>
          </button>`;
      }).join('');
    } catch(e) {
      document.getElementById('bookingEquipment').innerHTML = '<div class="text-danger">Failed to load booking equipment</div>';
    }
  }

  window.openBookingModal = function(key) {
    const group = bookingGroups.get(key);
    if (!group) return;
    currentBookingKey = key;
    const info = bookingInfo(group);
    document.getElementById('beModalTitle').textContent = info.ref;
    document.getElementById('beModalSub').innerHTML = info.sub;
    const returnableCount = group.items.filter(e => e.status === 'checked_out' || e.status === 'in_use').length;
    let headerBtn = '';
    if (returnableCount > 1) {
      headerBtn = `<button class="btn btn-sm btn-outline-danger" style="border-radius:8px;font-size:0.75rem;font-weight:600;" onclick="returnAllBookingEquipment('${key}')"><i class="bi bi-arrow-return-left me-1"></i>Return All (${returnableCount})</button>`;
    }
    document.getElementById('beModalHeaderBtn').innerHTML = headerBtn;
    document.getElementById('beModalBody').innerHTML = renderItems(group.items);
    bootstrap.Modal.getOrCreateInstance(document.getElementById('bookingEquipmentModal')).show();
  };

  window.returnBookingEquipment = async function(id, name) {
    const good = confirm(`Return ${name} in good condition? OK = Good, Cancel = Damaged`);
    const condition = good ? 'good' : 'damaged';
    let damageDescription = '';
    if (!good) {
      const reason = prompt(`Describe the issue with ${name}:`, '');
      if (reason === null) return;
      damageDescription = reason;
    }
    try {
      const res = await fetch(`/api/technician/equipment/${id}/return`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ condition, damageDescription }) });
      const data = await res.json();
      if (res.ok) {
        alert(`${name} returned as ${condition}.`);
        loadBookingEquipment().then(() => {
          const group = bookingGroups.get(currentBookingKey);
          if (group) document.getElementById('beModalBody').innerHTML = renderItems(group.items);
        });
      } else {
        alert(data.error || 'Failed to return equipment.');
      }
    } catch(e) { alert('Please try again.'); }
  };

  window.returnAllBookingEquipment = async function(key) {
    const group = bookingGroups.get(key);
    if (!group) return;
    const returnable = group.items.filter(e => e.status === 'checked_out' || e.status === 'in_use');
    if (!returnable.length) return;
    const good = confirm(`Return all ${returnable.length} items in good condition?\nOK = Good\nCancel = Damaged`);
    const condition = good ? 'good' : 'damaged';
    let damageDescription = '';
    if (!good) {
      const reason = prompt('Describe the issue with these items:', '');
      if (reason === null) return;
      damageDescription = reason;
    }
    const btn = document.querySelector('#beModalHeaderBtn .btn');
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Returning...'; }
    let returned = 0, failed = 0;
    for (const item of returnable) {
      try {
        const res = await fetch(`/api/technician/equipment/${item._id}/return`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ condition, damageDescription }) });
        if (res.ok) returned++; else failed++;
      } catch(e) { failed++; }
    }
    const msg = failed ? `${returned} returned, ${failed} failed.` : `All ${returned} items returned as ${condition}.`;
    alert(msg);
    loadBookingEquipment().then(() => {
      const group2 = bookingGroups.get(currentBookingKey);
      if (group2) {
        const returnableCount = group2.items.filter(e => e.status === 'checked_out' || e.status === 'in_use').length;
        document.getElementById('beModalHeaderBtn').innerHTML = returnableCount > 1
          ? `<button class="btn btn-sm btn-outline-danger" style="border-radius:8px;font-size:0.75rem;font-weight:600;" onclick="returnAllBookingEquipment('${currentBookingKey}')"><i class="bi bi-arrow-return-left me-1"></i>Return All (${returnableCount})</button>`
          : '';
        document.getElementById('beModalBody').innerHTML = renderItems(group2.items);
      }
    });
  };

  loadTools();
  loadHistory();
  loadBookingEquipment();
  loadEquipmentUsage();
})();

// ── Equipment Usage Per Date ────────────────────────────────────────
let allEquipment = [];

async function loadEquipmentUsage() {
  try {
    const res = await fetch('/api/technician/equipment-usage', { credentials: 'same-origin' });
    const data = await res.json();
    const container = document.getElementById('equipmentUsage');
    const items = data.items || [];

    if (!items.length) {
      container.innerHTML = '<div class="text-center py-4 text-muted"><i class="bi bi-calendar-check" style="font-size:2rem;"></i><br>No equipment usage logged yet</div>';
      return;
    }

    // Group by date
    const groups = new Map();
    for (const item of items) {
      const dateKey = new Date(item.date).toISOString().split('T')[0];
      if (!groups.has(dateKey)) groups.set(dateKey, []);
      groups.get(dateKey).push(item);
    }

    let html = '';
    for (const [dateKey, dayItems] of groups) {
      const dateLabel = new Date(dateKey + 'T00:00:00').toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
      html += `<div style="margin-bottom:14px;">
        <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#94a3b8;margin-bottom:6px;">${dateLabel}</div>`;
      for (const item of dayItems) {
        const eq = item.equipmentId || {};
        const name = item.equipmentName || eq.itemName || 'Unknown';
        const code = item.equipmentCode || eq.assetCode || '';
        html += `<div class="tool-card" style="border-left:3px solid #10b981;">
          <div class="tool-icon" style="background:#f0fdf4;color:#059669;"><i class="bi bi-tools"></i></div>
          <div class="tool-info" style="flex:1;">
            <h6>${escHtml(name)}${code ? ' <span class="text-muted fw-normal">(' + escHtml(code) + ')</span>' : ''}</h6>
            ${item.notes ? '<p style="font-size:0.75rem;color:#64748b;margin:2px 0 0;"><i class="bi bi-chat-left-text me-1"></i>' + escHtml(item.notes) + '</p>' : ''}
          </div>
          <button class="btn btn-sm" style="border:none;color:#dc2626;padding:4px 8px;" onclick="deleteEquipmentUsage('${item._id}', '${escHtml(name)}')" title="Delete"><i class="bi bi-trash3"></i></button>
        </div>`;
      }
      html += '</div>';
    }
    container.innerHTML = html;
  } catch(e) {
    document.getElementById('equipmentUsage').innerHTML = '<div class="text-danger">Failed to load</div>';
  }
}

async function loadEquipmentDropdown() {
  try {
    const res = await fetch('/api/technician/tools/assigned', { credentials: 'same-origin' });
    const data = await res.json();
    const items = data.items || [];
    const sel = document.getElementById('logEquipment');
    sel.innerHTML = '<option value="">Select equipment...</option>';
    for (const t of items) {
      const name = t.toolName || 'Tool';
      const code = t.toolBarcode || '';
      sel.innerHTML += `<option value="${t.toolId || t._id}">${escHtml(name)}${code ? ' (' + escHtml(code) + ')' : ''}</option>`;
    }
  } catch(e) { console.error('Failed to load equipment list'); }
}

function openLogEquipmentModal() {
  document.getElementById('logEquipment').value = '';
  document.getElementById('logDate').value = new Date().toISOString().split('T')[0];
  document.getElementById('logNotes').value = '';
  loadEquipmentDropdown();
  new bootstrap.Modal(document.getElementById('logEquipmentModal')).show();
}

async function saveEquipmentUsage() {
  const equipmentId = document.getElementById('logEquipment').value;
  const date = document.getElementById('logDate').value;
  const notes = document.getElementById('logNotes').value;
  if (!equipmentId || !date) { alert('Please select equipment and date.'); return; }

  try {
    const res = await fetch('/api/technician/equipment-usage', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ equipmentId, date, notes })
    });
    const data = await res.json();
    if (!res.ok) { alert(data.error || 'Failed to save.'); return; }
    bootstrap.Modal.getInstance(document.getElementById('logEquipmentModal')).hide();
    loadEquipmentUsage();
  } catch(e) { alert('Network error. Please try again.'); }
}

async function deleteEquipmentUsage(id, name) {
  if (!confirm(`Remove "${name}" from usage log?`)) return;
  try {
    const res = await fetch('/api/technician/equipment-usage/' + id, { method: 'DELETE', credentials: 'same-origin' });
    if (res.ok) loadEquipmentUsage();
  } catch(e) { alert('Failed to delete.'); }
}

function escHtml(str) {
  const d = document.createElement('div');
  d.textContent = str || '';
  return d.innerHTML;
}
</script>
