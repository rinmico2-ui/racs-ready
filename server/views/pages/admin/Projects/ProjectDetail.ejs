    .rec-badge.ok { background:#dcfce7; color:#16a34a; }
    .rec-badge.warn { background:#fef3c7; color:#d97706; }

    /* ══ WORK ORDER PROGRESS ══ */
    .wop-row { margin-bottom:0.5rem; }
