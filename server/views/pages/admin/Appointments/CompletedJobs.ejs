<div class="main-content">
  <div class="container-fluid py-4">
    <div class="au-hero mb-4">
      <div class="au-hero-inner">
        <div class="au-hero-left">
          <div class="au-hero-icon"><i class="bi bi-check-circle"></i></div>
          <div>
            <h1>Completed Jobs</h1>
            <p>All successfully completed service bookings</p>
          </div>
        </div>
        <div class="au-hero-actions">
          <input type="date" class="form-control form-control-sm" id="dateFilter" style="width:160px;" onchange="loadList()">
          <input type="text" class="form-control form-control-sm" placeholder="Search..." id="searchInput" style="width:200px;">
          <button class="btn btn-sm btn-outline-secondary" onclick="loadList()"><i class="bi bi-arrow-clockwise"></i></button>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4" id="statsRow">
      <div class="col-md-3">
        <div class="card border-0 shadow-sm">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center" style="width:44px;height:44px;"><i class="bi bi-check-circle-fill text-success"></i></div>
            <div><div class="fw-bold fs-5" id="statTotal">0</div><div class="text-muted" style="font-size:0.75rem;">Total Completed</div></div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width:44px;height:44px;"><i class="bi bi-cash-stack text-primary"></i></div>
            <div><div class="fw-bold fs-5" id="statRevenue">₱0</div><div class="text-muted" style="font-size:0.75rem;">Total Revenue</div></div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle bg-info bg-opacity-10 d-flex align-items-center justify-content-center" style="width:44px;height:44px;"><i class="bi bi-calendar-check text-info"></i></div>
            <div><div class="fw-bold fs-5" id="statToday">0</div><div class="text-muted" style="font-size:0.75rem;">Completed Today</div></div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle bg-warning bg-opacity-10 d-flex align-items-center justify-content-center" style="width:44px;height:44px;"><i class="bi bi-star-fill text-warning"></i></div>
            <div><div class="fw-bold fs-5" id="statAvg">0</div><div class="text-muted" style="font-size:0.75rem;">Avg. Rating</div></div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-3" id="jobsContainer">
      <div class="col-12 text-center py-5"><div class="spinner-border text-primary"></div></div>
    </div>
    <div class="d-flex justify-content-center mt-3" id="pagination"></div>
  </div>
</div>

<!-- Detail Modal -->
<div class="modal fade" id="detailModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" style="max-width:480px;margin:auto;">
    <div class="modal-content ent-modal">
      <div class="modal-header ent-modal-header">
        <div class="d-flex align-items-center gap-3">
          <div class="ent-modal-icon bg-success-subtle"><i class="bi bi-check-circle text-success"></i></div>
          <div>
            <h6 class="modal-title fw-bold mb-0" id="detailTitle">Job Details</h6>
            <small class="text-muted">Completed booking information</small>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body ent-modal-body" id="detailBody">
        <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
      </div>
    </div>
  </div>
</div>

<style>
  .ent-modal { border: none; border-radius: 16px; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.25); }
  .ent-modal-header { background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%); color: #fff; padding: 20px 24px; border: none; }
  .ent-modal-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
  .ent-modal-body { padding: 24px; }
  .ent-detail-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .ent-detail-card { display: flex; align-items: flex-start; gap: 12px; padding: 16px; background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0; }
  .ent-detail-card-wide { grid-column: span 2; }
  .ent-detail-card-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }
  .ent-detail-card-content { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ent-detail-label { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; }
  .ent-detail-value { font-size: 0.95rem; font-weight: 600; color: #1e293b; }
  .ent-detail-sub { font-size: 0.8rem; color: #64748b; }
  @media (max-width: 767px) { .ent-detail-grid { grid-template-columns: 1fr; } .ent-detail-card-wide { grid-column: span 1; } }

  .job-card { border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; transition: all 0.2s; background: #fff; }
  .job-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); transform: translateY(-2px); }
  .job-card-header { padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; }
  .job-card-body { padding: 0 16px 12px; }
  .job-completed { background: #d1fae5; color: #065f46; }
</style>

<script>
  const PAGE_SIZE = 12;
  let currentPage = 1;

  async function loadList() {
    const search = document.getElementById('searchInput')?.value || '';
    const date = document.getElementById('dateFilter')?.value || '';
    try {
      let url = `/api/admin/appointments/list?stage=completed&page=${currentPage}&limit=${PAGE_SIZE}`;
      if (search) url += `&search=${encodeURIComponent(search)}`;
      if (date) url += `&date=${date}`;
      const [listRes, statsRes] = await Promise.all([
        fetch(url),
        fetch('/api/admin/appointments/flow-stats')
      ]);
      const listData = await listRes.json();
      const statsData = await statsRes.json();
      renderStats(statsData);
      renderJobs(listData.bookings);
      renderPagination(listData.pagination);
    } catch (e) { console.error(e); }
  }

  function renderStats(stats) {
    const stages = stats.stages || {};
    document.getElementById('statTotal').textContent = stages.COMPLETED?.count || 0;
    document.getElementById('statToday').textContent = stats.summary?.todayBookings || 0;
    const rev = stats.summary?.totalRevenue || 0;
    document.getElementById('statRevenue').textContent = '₱' + Number(rev).toLocaleString();
    document.getElementById('statAvg').textContent = '—';
  }

  function renderJobs(bookings) {
    const container = document.getElementById('jobsContainer');
    if (!bookings.length) {
      container.innerHTML = `<div class="col-12 text-center py-5 text-muted"><i class="bi bi-inbox" style="font-size:3rem;"></i><div class="mt-2 fw-semibold">No completed jobs</div><div class="small">Completed jobs will appear here</div></div>`;
      return;
    }
    container.innerHTML = bookings.map(b => {
      const date = new Date(b.bookingDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      const completedDate = b.updatedAt ? new Date(b.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
      return `<div class="col-md-6 col-xl-4">
        <div class="job-card">
          <div class="job-card-header bg-white">
            <code class="small">${b.bookingReference || b.workOrderNumber || 'N/A'}</code>
            <span class="job-completed" style="padding:3px 10px;border-radius:20px;font-size:0.7rem;font-weight:700;text-transform:uppercase;">Completed</span>
          </div>
          <div class="job-card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div class="fw-semibold small">${b.customer?.name || 'N/A'}</div>
                <div class="text-muted" style="font-size:0.7rem;">${b.customer?.phone || ''}</div>
              </div>
              <div class="text-end">
                <div class="fw-bold text-success">₱${(b.totalPrice || b.estimatedFee || 0).toLocaleString()}</div>
                <div class="text-muted" style="font-size:0.65rem;">${(b.paymentMethod || 'cod').toUpperCase()}</div>
              </div>
            </div>
            <div class="d-flex justify-content-between align-items-center">
              <div class="small text-muted"><i class="bi bi-tools me-1"></i>${b.service?.name || (b.services?.[0]?.name) || (b.serviceModel === 'RepairService' || b.serviceType === 'repair' ? 'Repair Service' : 'N/A')}</div>
              <div class="small text-muted"><i class="bi bi-calendar me-1"></i>${date}</div>
            </div>
            ${b.technician?.name ? `<div class="mt-2 small"><i class="bi bi-person me-1 text-success"></i><span class="fw-semibold">${b.technician.name}</span></div>` : ''}
            ${completedDate ? `<div class="mt-1 small text-muted"><i class="bi bi-check2 me-1"></i>Completed ${completedDate}</div>` : ''}
            <div class="mt-3">
              <button class="btn btn-sm btn-outline-success w-100" onclick="viewDetail('${b._id}')"><i class="bi bi-eye me-1"></i>View Details</button>
            </div>
          </div>
        </div>
      </div>`;
    }).join('');
  }

  function renderPagination(pag) {
    const el = document.getElementById('pagination');
    if (!pag || pag.pages <= 1) { el.innerHTML = ''; return; }
    let html = '<ul class="pagination pagination-sm">';
    for (let i = 1; i <= pag.pages; i++) {
      html += `<li class="page-item ${i === pag.page ? 'active' : ''}"><button class="page-link" onclick="goPage(${i})">${i}</button></li>`;
    }
    el.innerHTML = html + '</ul>';
  }

  function goPage(p) { currentPage = p; loadList(); }

  async function viewDetail(id) {
    try {
      const res = await fetch(`/api/admin/appointments/${id}`);
      const data = await res.json();
      const b = data.booking;
      const date = new Date(b.bookingDate).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
      const completedAt = b.updatedAt ? new Date(b.updatedAt).toLocaleString('en-US', { dateStyle: 'long', timeStyle: 'short' }) : '—';
      document.getElementById('detailTitle').textContent = `Job ${b.bookingReference || b.workOrderNumber || '#' + b._id.toString().slice(-8).toUpperCase()}`;
      document.getElementById('detailBody').innerHTML = `
        <div class="ent-detail-grid">
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon bg-primary-subtle"><i class="bi bi-person-fill text-primary"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Customer</span>
              <span class="ent-detail-value">${b.customer?.name || 'N/A'}</span>
              <span class="ent-detail-sub">${b.customer?.phone || ''}</span>
              <span class="ent-detail-sub">${b.customer?.email || ''}</span>
            </div>
          </div>
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon bg-success-subtle"><i class="bi bi-tools text-success"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Service</span>
              <span class="ent-detail-value">${b.service?.name || (b.services?.map(s=>s.name).join(', ')) || (b.serviceModel === 'RepairService' || b.serviceType === 'repair' ? 'Repair Service' : 'N/A')}</span>
              <span class="ent-detail-sub">${date}</span>
              <span class="ent-detail-sub">${b.startTime || ''} - ${b.endTime || ''}</span>
            </div>
          </div>
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon bg-info-subtle"><i class="bi bi-person-badge text-info"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Technician</span>
              <span class="ent-detail-value">${b.technician?.name || 'Unassigned'}</span>
              <span class="ent-detail-sub">${b.technician?.phone || '—'}</span>
            </div>
          </div>
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon bg-warning-subtle"><i class="bi bi-cash-stack text-warning"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Payment</span>
              <span class="ent-detail-value fw-bold">₱${(b.totalPrice || b.estimatedFee || 0).toLocaleString()}</span>
              <span class="ent-detail-sub">${(b.paymentMethod || 'cod').toUpperCase()} &middot; ${b.paymentStatus || 'paid'}</span>
            </div>
          </div>
          <div class="ent-detail-card ent-detail-card-wide">
            <div class="ent-detail-card-icon bg-secondary-subtle"><i class="bi bi-geo-alt-fill text-secondary"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Service Location</span>
              <span class="ent-detail-value">${b.location?.address || 'N/A'}</span>
            </div>
          </div>
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon bg-success-subtle"><i class="bi bi-check-circle-fill text-success"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Completed</span>
              <span class="ent-detail-value">${completedAt}</span>
            </div>
          </div>
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon bg-dark-subtle"><i class="bi bi-flag-fill text-dark"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Status</span>
              <span class="ent-detail-value"><span class="badge bg-success">Completed</span></span>
            </div>
          </div>
        </div>`;
      new bootstrap.Modal(document.getElementById('detailModal')).show();
    } catch (e) {
      showNotification({ type: 'error', title: 'Error', message: 'Failed to load job details.', duration: 4000 });
    }
  }

  function showNotification({ type = 'info', title = '', message = '', duration = 3000 }) {
    const colors = {
      success: { bg: '#f0fdf4', border: '#22c55e', icon: 'bi-check-circle-fill', iconColor: '#16a34a' },
      error: { bg: '#fef2f2', border: '#ef4444', icon: 'bi-x-circle-fill', iconColor: '#dc2626' },
      warning: { bg: '#fffbeb', border: '#f59e0b', icon: 'bi-exclamation-triangle-fill', iconColor: '#d97706' },
      info: { bg: '#eff6ff', border: '#3b82f6', icon: 'bi-info-circle-fill', iconColor: '#2563eb' }
    };
    const c = colors[type] || colors.info;
    const el = document.createElement('div');
    el.style.cssText = `position:fixed;top:20px;right:20px;z-index:99999;min-width:340px;max-width:420px;background:${c.bg};border:1px solid ${c.border};border-left:4px solid ${c.border};border-radius:12px;padding:16px 20px;box-shadow:0 10px 40px rgba(0,0,0,0.15);display:flex;align-items:flex-start;gap:12px;animation:slideInRight 0.3s ease;`;
    el.innerHTML = `<i class="bi ${c.icon}" style="font-size:1.3rem;color:${c.iconColor};margin-top:2px;"></i><div style="flex:1;"><div style="font-weight:700;font-size:0.9rem;color:#1e293b;margin-bottom:2px;">${title}</div><div style="font-size:0.82rem;color:#64748b;">${message}</div></div><button onclick="this.parentElement.remove()" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:1.1rem;padding:0;line-height:1;">&times;</button>`;
    document.body.appendChild(el);
    if (!document.getElementById('notif-styles')) {
      const style = document.createElement('style'); style.id = 'notif-styles';
      style.textContent = '@keyframes slideInRight{from{transform:translateX(100%);opacity:0;}to{transform:translateX(0);opacity:1;}}';
      document.head.appendChild(style);
    }
    setTimeout(() => { el.style.transition='all 0.3s ease'; el.style.opacity='0'; el.style.transform='translateX(100%)'; setTimeout(()=>el.remove(),300); }, duration);
  }

  loadList();
  let st; document.getElementById('searchInput')?.addEventListener('input', () => { clearTimeout(st); st = setTimeout(loadList, 400); });
</script>
