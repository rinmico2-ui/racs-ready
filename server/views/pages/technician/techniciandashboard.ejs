</style>

<script>
(function() {
  const API = '/api/technician/dashboard/overview';
  const token = document.cookie.split('; ').find(c => c.startsWith('XSRF-TOKEN='))?.split('=')[1];

  async function fetchOverview() {
    try {
      const res = await fetch(API, {
        headers: { 'X-XSRF-TOKEN': token || '' },
        credentials: 'same-origin'
      });
      if (!res.ok) throw new Error('Failed to load');
      return await res.json();
    } catch(e) {
      console.error('Dashboard load error:', e);
      return null;
    }
  }

  function formatPeso(n) {
    return '₱' + Number(n || 0).toLocaleString('en-PH', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function renderAssignmentCard(a, showActions, expenses) {
    const statusColors = {
      pending_acceptance: 'bg-warning text-dark',
      accepted: 'bg-primary',
      en_route: 'bg-info text-dark',
      on_site: 'bg-dark',
      in_progress: 'bg-primary',
      completed: 'bg-success',
      cancelled: 'bg-secondary',
      declined: 'bg-danger',
    };
    const repairStatusColors = {
      inspection_scheduled: '#f59e0b',
      inspection_completed: '#3b82f6',
      awaiting_approval: '#8b5cf6',
      repair_approved: '#10b981',
      repair_declined: '#ef4444',
      waiting_parts: '#f97316',
      parts_reserved: '#06b6d4',
      ready_for_repair: '#22c55e',
      repair_in_progress: '#3b82f6',
      repair_completed: '#10b981',
    };
    const icons = {
      pending_acceptance: 'bi-clock',
      accepted: 'bi-check2',
      en_route: 'bi-geo-alt',
      on_site: 'bi-building',
      in_progress: 'bi-gear',
      completed: 'bi-check-circle',
    };

    // Today detection
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const isToday = a.bookingDate && new Date(a.bookingDate).toDateString() === today.toDateString();

    // Determine if this is a repair job
    const isRepair = a.serviceType === 'repair' || a.bookingStatus?.startsWith('inspection_') || a.bookingStatus?.startsWith('repair_') || a.bookingStatus === 'awaiting_approval' || a.bookingStatus === 'waiting_parts' || a.bookingStatus === 'parts_reserved' || a.bookingStatus === 'ready_for_repair';

    // For repair jobs, use booking status; otherwise assignment status
    let displayStatus, statusBadgeClass, statusBadgeStyle;
    if (isRepair && a.bookingStatus) {
      displayStatus = a.bookingStatus.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
      const rc = repairStatusColors[a.bookingStatus] || '#6b7280';
      statusBadgeClass = '';
      statusBadgeStyle = `background:${rc};color:#fff;font-size:0.72rem;padding:3px 10px;border-radius:6px;`;
    } else {
      displayStatus = (a.status || '').replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
      statusBadgeClass = statusColors[a.status] || 'bg-secondary';
      statusBadgeStyle = 'font-size:0.72rem;padding:3px 10px;border-radius:6px;';
    }
    const iconBg = a.status === 'completed' ? '#f0fdf4' : '#eff6ff';
    const iconColor = a.status === 'completed' ? '#22c55e' : '#3b82f6';

    let actions = '';
    if (showActions && a.status === 'pending_acceptance') {
      actions = `
        <button class="btn btn-sm btn-success" onclick="tdAccept('${a._id}')"><i class="bi bi-check-lg"></i></button>
        <button class="btn btn-sm btn-outline-danger" onclick="tdDecline('${a._id}')"><i class="bi bi-x-lg"></i></button>
      `;
    }

    // Expense indicator for this job
    let expenseBadge = '';
    if (expenses && expenses.length > 0) {
      const total = expenses.reduce((s, e) => s + (e.amount || 0), 0);
      const pending = expenses.filter(e => e.status === 'pending').reduce((s, e) => s + (e.amount || 0), 0);
      expenseBadge = `<div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap;">
        <span class="badge bg-warning text-dark" style="font-size:0.68rem;"><i class="bi bi-receipt me-1"></i>${expenses.length} expense${expenses.length > 1 ? 's' : ''} · ₱${Number(total).toLocaleString()}</span>
        ${pending > 0 ? '<span class="badge bg-light text-warning border" style="font-size:0.65rem;">₱' + Number(pending).toLocaleString() + ' pending</span>' : ''}
      </div>`;
    }

    const todayLabel = isToday ? '<span class="pulse-today" style="font-size:0.6rem;font-weight:800;letter-spacing:0.08em;padding:3px 8px;border-radius:6px;background:#f59e0b;color:#fff;text-transform:uppercase;"><i class="bi bi-star-fill me-1"></i>Today</span>' : '';

    return `
      <div class="td-assign-card${isToday ? ' today-booking' : ''}">
        <div class="td-assign-icon" style="background:${iconBg};color:${iconColor};">
          <i class="bi ${icons[a.status] || 'bi-circle'}"></i>
        </div>
        <div class="td-assign-info">
          <h6>${a.customerName || 'Customer'} - ${a.serviceName || 'Service'}</h6>
          <p><i class="bi bi-clock me-1"></i>${a.startTime || ''} ${a.bookingDate ? new Date(a.bookingDate).toLocaleDateString('en-PH', {month:'short',day:'numeric'}) : ''}</p>
          ${a.address ? '<p><i class="bi bi-geo-alt me-1"></i>' + a.address.substring(0, 50) + '</p>' : ''}
          ${expenseBadge}
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;">
          ${todayLabel}
          <span class="${statusBadgeClass}" style="${statusBadgeStyle}">${displayStatus}</span>
          ${actions}
        </div>
      </div>`;
  }

  async function loadDashboard() {
    const data = await fetchOverview();
    if (!data) return;
    window.__dashboardData = data;

    // KPI Elements removed as requested.

    // Pending List
    const pendingEl = document.getElementById('pendingList');
    if (data.pendingJobs && data.pendingJobs.length > 0) {
      pendingEl.innerHTML = data.pendingJobs.map(a => renderAssignmentCard(a, true, null)).join('');
    } else {
      pendingEl.innerHTML = '<div class="td-empty-state"><i class="bi bi-check-circle"></i><p>No pending assignments</p></div>';
    }

    // Today's Jobs List
    const todayEl = document.getElementById('todayList');
    if (data.todayJobs && data.todayJobs.length > 0) {
      todayEl.innerHTML = data.todayJobs.map(a => renderAssignmentCard(a, false, null)).join('');
    } else {
      todayEl.innerHTML = '<div class="td-empty-state"><i class="bi bi-calendar-check"></i><p>No jobs scheduled for today</p></div>';
    }

    // Active Job
    const activeEl = document.getElementById('activeJob');
    if (data.activeJob) {
      const a = data.activeJob;
      const activeExpenses = data.activeJobExpenses || [];
      const isRepair = a.bookingServiceType === 'repair' || a.serviceType === 'repair' || a.repairInfo;

      // For repair jobs, show booking status label; otherwise show assignment status
      let statusLabel;
      let statusColor = '#3b82f6';
      if (isRepair && a.repairInfo) {
        const rs = a.repairInfo.bookingStatus || a.bookingStatus;
        statusLabel = rs.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        const repairColors = {inspection_scheduled:'#f59e0b',inspection_completed:'#3b82f6',awaiting_approval:'#8b5cf6',repair_approved:'#10b981',waiting_parts:'#f97316',parts_reserved:'#06b6d4',ready_for_repair:'#22c55e',repair_scheduled:'#22c55e',on_the_way:'#3b82f6',arrived:'#8b5cf6',repair_in_progress:'#3b82f6',repair_completed:'#10b981'};
        statusColor = repairColors[rs] || '#6b7280';
      } else if (isRepair && a.bookingStatus) {
        statusLabel = a.bookingStatus.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        const repairColors = {inspection_scheduled:'#f59e0b',inspection_completed:'#3b82f6',awaiting_approval:'#8b5cf6',repair_approved:'#10b981',waiting_parts:'#f97316',parts_reserved:'#06b6d4',ready_for_repair:'#22c55e',repair_scheduled:'#22c55e',on_the_way:'#3b82f6',arrived:'#8b5cf6',repair_in_progress:'#3b82f6',repair_completed:'#10b981'};
        statusColor = repairColors[a.bookingStatus] || '#6b7280';
      } else {
        statusLabel = (a.status || '').replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        if (a.status === 'completed') statusColor = '#22c55e';
      }

      // Determine repair info banner text
      let repairBanner = '';
      if (isRepair && a.repairInfo) {
        const rs = a.repairInfo.bookingStatus;
        if (rs === 'waiting_parts') {
          const partsNeeded = a.repairInfo.quotation?.parts?.length || 0;
          repairBanner = `<div class="td-repair-banner" style="background:#fff7ed;border:1px solid #fed7aa;color:#c2410c;">
            <i class="bi bi-hourglass-split"></i>
            <div><strong>Waiting for Parts & Schedule</strong><br><span>Admin is procuring ${partsNeeded} part(s). You'll be notified when ready.</span></div>
          </div>`;
        } else if (rs === 'parts_reserved') {
          repairBanner = `<div class="td-repair-banner" style="background:#ecfeff;border:1px solid #a5f3fc;color:#0e7490;">
            <i class="bi bi-box-seam"></i>
            <div><strong>Parts Reserved</strong><br><span>Waiting for admin to schedule the repair date.</span></div>
          </div>`;
        } else if (rs === 'repair_approved' || rs === 'awaiting_approval') {
          repairBanner = `<div class="td-repair-banner" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;">
            <i class="bi bi-clock-history"></i>
            <div><strong>Awaiting Admin Processing</strong><br><span>Quotation submitted. Waiting for parts check and repair schedule.</span></div>
          </div>`;
        } else if (rs === 'repair_scheduled' || rs === 'ready_for_repair') {
          const schedDate = a.repairInfo.repairSchedule?.decidedAt ? new Date(a.repairInfo.repairSchedule.decidedAt).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' }) : '';
          repairBanner = `<div class="td-repair-banner" style="background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;">
            <i class="bi bi-check-circle"></i>
            <div><strong>Ready for Repair</strong><br><span>Parts reserved${schedDate ? '. Scheduled ' + schedDate : ''}. You can go En Route!</span></div>
          </div>`;
        } else if (rs === 'on-the-way') {
          repairBanner = `<div class="td-repair-banner" style="background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;">
            <i class="bi bi-geo-alt"></i>
            <div><strong>En Route</strong><br><span>Heading to customer location.</span></div>
          </div>`;
        } else if (rs === 'arrived') {
          repairBanner = `<div class="td-repair-banner" style="background:#f5f3ff;border:1px solid #ddd6fe;color:#6d28d9;">
            <i class="bi bi-building"></i>
            <div><strong>Arrived at Location</strong><br><span>Ready to start repair work.</span></div>
          </div>`;
        } else if (rs === 'repair_in_progress') {
          repairBanner = `<div class="td-repair-banner" style="background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;">
            <i class="bi bi-tools"></i>
            <div><strong>Repair In Progress</strong><br><span>Completing the repair work.</span></div>
          </div>`;
        }
      }

      let actions = '';
      if (isRepair && a.repairInfo) {
        const rs = a.repairInfo.bookingStatus;
        // Repair-specific action buttons based on booking status
        if (rs === 'repair_scheduled' || rs === 'ready_for_repair') {
          actions = `<button class="btn btn-sm btn-primary" onclick="tdRepairEnRoute('${a.repairInfo.bookingId}')"><i class="bi bi-geo-alt me-1"></i>En Route</button>`;
        } else if (rs === 'on-the-way' || a.status === 'en_route') {
          actions = `<button class="btn btn-sm btn-primary" onclick="tdRepairTransition('${a.repairInfo.bookingId}','on_site')"><i class="bi bi-building me-1"></i>Arrived</button>`;
        } else if (rs === 'arrived' || a.status === 'on_site') {
          actions = `<button class="btn btn-sm btn-primary" onclick="tdRepairTransition('${a.repairInfo.bookingId}','in_progress')"><i class="bi bi-gear me-1"></i>Start Work</button>`;
        } else if (rs === 'repair_in_progress' || a.status === 'in_progress') {
          actions = `<button class="btn btn-sm btn-success" onclick="tdRepairTransition('${a.repairInfo.bookingId}','completed')"><i class="bi bi-check-circle me-1"></i>Complete</button>`;
        }
        // For waiting_parts, parts_reserved, awaiting_approval — no action buttons (just the banner)
      } else {
        // Standard (non-repair) assignment actions
        if (a.status === 'accepted') {
          const canGo = true;
          actions = `<button class="btn btn-sm btn-primary" ${!canGo ? 'disabled title="You can go En Route 30 minutes before the scheduled time"' : ''} onclick="tdTransition('${a._id}','en_route')"><i class="bi bi-geo-alt me-1"></i>En Route</button>`;
        } else if (a.status === 'en_route') {
          actions = `<button class="btn btn-sm btn-primary" onclick="tdTransition('${a._id}','on_site')"><i class="bi bi-building me-1"></i>Arrived</button>`;
        } else if (a.status === 'on_site') {
          actions = `<button class="btn btn-sm btn-primary" onclick="tdTransition('${a._id}','in_progress')"><i class="bi bi-gear me-1"></i>Start Work</button>`;
        } else if (a.status === 'in_progress') {
          const isCODWithBalance = ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && !a.balanceCollected && (a.balanceAmount || 0) > 0;
          if (isCODWithBalance) {
            actions = `<button class="btn btn-sm btn-warning" onclick="tdCollectAndComplete('${a._id}')"><i class="bi bi-cash me-1"></i>Collect ₱${Number(a.balanceAmount).toLocaleString()} & Complete</button>`;
          } else {
            actions = `<button class="btn btn-sm btn-success" onclick="tdTransition('${a._id}','completed')"><i class="bi bi-check-circle me-1"></i>Complete</button>`;
          }
        }
      }
      const paymentInfo = ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && !a.balanceCollected && (a.balanceAmount || 0) > 0
        ? `<div class="td-active-detail" style="color:#d97706;"><i class="bi bi-exclamation-triangle"></i> Balance ₱${Number(a.balanceAmount).toLocaleString()} due on completion</div>`
        : ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && a.balanceCollected
        ? '<div class="td-active-detail" style="color:#16a34a;"><i class="bi bi-check-circle"></i> Fully Paid</div>'
        : '';
      // Expense summary for active job
      let activeExpenseInfo = '';
      if (activeExpenses.length > 0) {
        const totalExp = activeExpenses.reduce((s, e) => s + (e.amount || 0), 0);
        const approvedExp = activeExpenses.filter(e => e.status === 'approved').reduce((s, e) => s + (e.amount || 0), 0);
        const pendingExp = activeExpenses.filter(e => e.status === 'pending').reduce((s, e) => s + (e.amount || 0), 0);
        activeExpenseInfo = `<div class="td-active-detail" style="color:#92400e;"><i class="bi bi-receipt"></i> ${activeExpenses.length} expense${activeExpenses.length > 1 ? 's' : ''} logged · ₱${Number(totalExp).toLocaleString()}${pendingExp > 0 ? ' (₱' + Number(pendingExp).toLocaleString() + ' pending)' : ''}</div>`;
      }
      // Unit info for repairs
      let unitInfoHtml = '';
      if (isRepair && a.repairInfo?.unitInfo) {
        const u = a.repairInfo.unitInfo;
        const unitLabel = `${u.brand || ''} ${u.unitType || ''}`.trim();
        if (unitLabel) {
          unitInfoHtml = `<div class="td-active-detail"><i class="bi bi-tag"></i> ${unitLabel}${u.model ? ' · ' + u.model : ''}${u.serialNumber ? ' · SN: ' + u.serialNumber : ''}</div>`;
        }
      }
      activeEl.innerHTML = `
        <div class="td-active-card">
          <h5><i class="bi bi-lightning-charge me-2"></i>${a.customerName || 'Customer'} - ${a.serviceName || 'Service'}</h5>
          <div class="td-active-detail"><i class="bi bi-clock"></i> ${a.startTime || 'N/A'} | ${a.bookingDate ? new Date(a.bookingDate).toLocaleDateString('en-PH', {weekday:'short',month:'short',day:'numeric'}) : ''}</div>
          <div class="td-active-detail"><i class="bi bi-geo-alt"></i> ${a.address || 'No address'}</div>
          ${unitInfoHtml}
          <div class="td-active-detail"><i class="bi bi-tag"></i> <span class="badge" style="background:${statusColor};font-size:0.78rem;padding:4px 10px;">${statusLabel}</span></div>
          ${repairBanner}
          ${paymentInfo}
          ${activeExpenseInfo}
          <div class="td-active-actions">
            ${actions}
            ${actions.includes('onclick') || actions.includes('href') ? '' : `<a href="/technician/assignments?id=${a._id}" class="btn btn-sm btn-outline-secondary">Details</a>`}
            <a href="/technician/expenses" class="btn btn-sm btn-outline-warning" title="Log expense for this job"><i class="bi bi-receipt me-1"></i>Log Expense</a>
          </div>
        </div>`;
    }

    // Completed Today & Repair Queue panels removed.

    // Job Expenses Panel (active job)
    const jobExpPanel = document.getElementById('jobExpensesPanel');
    const jobExpList = document.getElementById('jobExpensesList');
    if (data.activeJob && data.activeJobExpenses && data.activeJobExpenses.length > 0) {
      jobExpPanel.style.display = '';
      const expenses = data.activeJobExpenses;
      const totalExp = expenses.reduce((s, e) => s + (e.amount || 0), 0);
      const byType = {};
      expenses.forEach(e => {
        if (!byType[e.type]) byType[e.type] = { count: 0, total: 0 };
        byType[e.type].count++;
        byType[e.type].total += e.amount || 0;
      });
      const typeLabels = { fuel: 'Fuel', material: 'Materials', transport: 'Transport', meal: 'Meal', other: 'Other' };
      const typeIcons = { fuel: 'bi-fuel-pump', material: 'bi-box', transport: 'bi-truck', meal: 'bi-cup-hot', other: 'bi-three-dots' };
      let breakdown = Object.entries(byType).map(([type, data]) =>
        `<div class="td-expense-row">
          <span><i class="bi ${typeIcons[type] || 'bi-circle'} me-1"></i>${typeLabels[type] || type} (${data.count})</span>
          <strong>₱${Number(data.total).toLocaleString()}</strong>
        </div>`
      ).join('');
      jobExpList.innerHTML = `
        <div class="td-expense-row" style="border-bottom:1px solid #f1f5f9;padding-bottom:8px;margin-bottom:4px;">
          <span class="fw-bold" style="color:#1e293b;">Total for this job</span>
          <strong class="text-warning" style="font-size:1rem;">₱${Number(totalExp).toLocaleString()}</strong>
        </div>
        ${breakdown}
        <div style="margin-top:10px;">
          <a href="/technician/expenses" class="btn btn-sm btn-outline-warning w-100"><i class="bi bi-plus-lg me-1"></i>Add Expense</a>
        </div>`;
    } else {
      jobExpPanel.style.display = 'none';
    }

    // Expense Summary
    if (data.expenseSummary) {
      const el1 = document.getElementById('expApproved');
      const el2 = document.getElementById('expPending');
      const el3 = document.getElementById('expFuel');
      const el4 = document.getElementById('expCount');
      if (el1) el1.textContent = formatPeso(data.expenseSummary.approvedTotal);
      if (el2) el2.textContent = formatPeso(data.expenseSummary.pendingTotal);
      if (el3) el3.textContent = formatPeso(data.expenseSummary.fuelTotal);
      if (el4) el4.textContent = (data.expenseSummary.approvedCount || 0) + (data.expenseSummary.pendingCount || 0);
    }

    // SLA Panel
    if (data.counts?.slaBreached > 0) {
      const slaPanelEl = document.getElementById('slaPanel');
      const slaListEl = document.getElementById('slaList');
      if (slaPanelEl) slaPanelEl.style.display = '';
      if (slaListEl) slaListEl.innerHTML = `<div class="td-empty-state"><i class="bi bi-exclamation-triangle text-danger"></i><p class="text-danger fw-bold">${data.counts.slaBreached} job(s) past SLA deadline</p></div>`;
    }

    // ── Hero Stats ────────────────────────────────────────────────────────
    const todayCount = data.todayJobs?.length ?? 0;
    const activeCount = data.activeJob ? 1 : 0;
    const completedTodayCount = data.counts?.completedToday ?? 0;
    const todayNumEl = document.getElementById('heroTodayNum');
    const activeNumEl = document.getElementById('heroActiveNum');
    const completedNumEl = document.getElementById('heroCompletedNum');
    if (todayNumEl) todayNumEl.textContent = todayCount;
    if (activeNumEl) activeNumEl.textContent = activeCount;
    if (completedNumEl) completedNumEl.textContent = completedTodayCount;

    // ── Daily Progress Widget ─────────────────────────────────────────────
    const totalToday = todayCount;
    const doneToday = completedTodayCount;
    const pct = totalToday > 0 ? Math.round((doneToday / totalToday) * 100) : 0;
    const dpBar = document.getElementById('dpProgressBar');
    const dpText = document.getElementById('dpProgressText');
    const dpPending = document.getElementById('dpPending');
    const dpDone = document.getElementById('dpDone');
    const dpEarnings = document.getElementById('dpEarnings');
    if (dpBar) dpBar.style.width = pct + '%';
    if (dpText) dpText.textContent = `${doneToday} / ${totalToday}`;
    if (dpPending) dpPending.textContent = data.counts?.pendingAcceptance ?? 0;
    if (dpDone) dpDone.textContent = doneToday;
    // Rough today earnings estimate from completed today jobs
    const todayEarnings = (data.completedToday || []).reduce((sum, j) => sum + (j.computedRevenue || j.totalPrice || j.bookingTotalPrice || 0), 0);
    if (dpEarnings) dpEarnings.textContent = '\u20b1' + Number(todayEarnings).toLocaleString('en-PH', { minimumFractionDigits: 0 });
  }

  // ── Today's Expenses Widget ──────────────────────────────────────────────
  async function loadTodayExpenses() {
    try {
      const today = new Date().toISOString().split('T')[0];
      const res = await fetch(`/api/technician/expenses?startDate=${today}&endDate=${today}&limit=100`);
      const data = await res.json();
      const items = data.items || [];
      const total = items.reduce((s, e) => s + (e.amount || 0), 0);
      const countEl = document.getElementById('todayExpCount');
      const totalEl = document.getElementById('todayExpTotal');
      const breakdownEl = document.getElementById('todayExpBreakdown');
      if (countEl) countEl.textContent = items.length;
      if (totalEl) totalEl.textContent = '\u20b1' + Number(total).toLocaleString('en-PH', { minimumFractionDigits: 2 });
      if (breakdownEl) {
        if (items.length === 0) {
          breakdownEl.innerHTML = '<div style="color:#94a3b8;font-size:0.82rem;"><i class="bi bi-inbox me-1"></i>No expenses logged today yet.</div>';
        } else {
          const byType = {};
          const typeLabels = { fuel:'Fuel', material:'Materials', transport:'Transport', meal:'Meal', other:'Other' };
          const typeIcons  = { fuel:'bi-fuel-pump', material:'bi-box', transport:'bi-truck', meal:'bi-cup-hot', other:'bi-three-dots' };
          items.forEach(e => {
            if (!byType[e.type]) byType[e.type] = 0;
            byType[e.type] += e.amount || 0;
          });
          breakdownEl.innerHTML = Object.entries(byType).map(([t, amt]) =>
            `<div class="d-flex justify-content-between py-1" style="border-bottom:1px solid #f1f5f9;">
              <span><i class="bi ${typeIcons[t] || 'bi-circle'} me-1 text-muted"></i>${typeLabels[t] || t}</span>
              <strong>\u20b1${Number(amt).toLocaleString('en-PH', { minimumFractionDigits: 2 })}</strong>
            </div>`
          ).join('');
        }
      }
    } catch(e) { /* silent */ }
  }

  // ── Daily Expense Quick Log Modal ─────────────────────────────────────────
  window.openDailyExpenseModal = function() {
    document.getElementById('dailyExpenseForm').reset();
    document.getElementById('dailyExpType').value = 'fuel';
    document.getElementById('dailyFuelFields').style.display = '';
    document.querySelectorAll('.exp-type-pill').forEach(b => b.classList.remove('active'));
    document.querySelector('.exp-type-pill[data-val="fuel"]').classList.add('active');
    new bootstrap.Modal(document.getElementById('dailyExpenseModal')).show();
  };

  document.querySelectorAll('.exp-type-pill').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.exp-type-pill').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      document.getElementById('dailyExpType').value = this.dataset.val;
      document.getElementById('dailyFuelFields').style.display = this.dataset.val === 'fuel' ? '' : 'none';
    });
  });

  window.submitDailyExpense = async function(e) {
    e.preventDefault();
    const body = {
      type: document.getElementById('dailyExpType').value,
      amount: parseFloat(document.getElementById('dailyExpAmount').value),
      description: document.getElementById('dailyExpDesc').value,
      expenseDate: new Date().toISOString().split('T')[0],
    };
    if (body.type === 'fuel') {
      body.fuelLiters = parseFloat(document.getElementById('dailyExpLiters').value) || 0;
      body.pricePerLiter = parseFloat(document.getElementById('dailyExpPricePerLiter').value) || 0;
      body.odometerReading = parseFloat(document.getElementById('dailyExpOdometer').value) || 0;
      body.gasStation = document.getElementById('dailyExpStation').value;
    }
    try {
      const res = await fetch('/api/technician/expenses', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();
      if (res.ok) {
        bootstrap.Modal.getInstance(document.getElementById('dailyExpenseModal')).hide();
        showToast('Expense logged!', 'success');
        loadTodayExpenses();
      } else {
        showToast(data.error || 'Failed to save', 'danger');
      }
    } catch(err) { showToast('Network error', 'danger'); }
  };

  // ── Action Handlers ────────────────────────────────────────────────────
  window.tdAccept = async function(id) {
    if (!confirm('Accept this assignment?')) return;
    try {
      const res = await fetch(`/api/technician/assignments/${id}/accept`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-XSRF-TOKEN': token || '' },
        credentials: 'same-origin'
      });
      const data = await res.json();
      if (res.ok) {
        showToast('Assignment accepted!', 'success');
        loadDashboard();
      } else {
        showToast(data.error || 'Failed', 'danger');
      }
    } catch(e) { showToast('Network error', 'danger'); }
  };

  window.tdDecline = async function(id) {
    const reason = prompt('Reason for declining (optional):');
    if (reason === null) return;
    try {
      const res = await fetch(`/api/technician/assignments/${id}/decline`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-XSRF-TOKEN': token || '' },
        credentials: 'same-origin',
        body: JSON.stringify({ reason })
      });
      const data = await res.json();
      if (res.ok) {
        showToast('Assignment declined.', 'info');
        loadDashboard();
      } else {
        showToast(data.error || 'Failed', 'danger');
      }
    } catch(e) { showToast('Network error', 'danger'); }
  };

  window.tdTransition = async function(id, status) {
    const labels = { en_route: 'mark as En Route', on_site: 'mark as Arrived', in_progress: 'start work', completed: 'mark as Completed' };
    if (!confirm(`Are you sure you want to ${labels[status] || status}?`)) return;
    try {
      const res = await fetch(`/api/technician/assignments/${id}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'X-XSRF-TOKEN': token || '' },
        credentials: 'same-origin',
        body: JSON.stringify({ status })
      });
      const data = await res.json();
      if (res.ok) {
        showToast(`Status updated to ${status.replace(/_/g, ' ')}`, 'success');
        loadDashboard();
      } else {
        showToast(data.error || 'Failed', 'danger');
      }
    } catch(e) { showToast('Network error', 'danger'); }
  };

  // ── Collect Payment & Complete (Dashboard) ─────────────────────────────
  window.tdCollectAndComplete = function(id) {
    const activeJob = window.__dashboardData?.activeJob;
    if (!activeJob || activeJob._id !== id) { tdTransition(id, 'completed'); return; }
    const total = activeJob.totalPrice || activeJob.estimatedFee || 0;
    const dp = activeJob.downpaymentAmount || 400;
    const balance = activeJob.balanceAmount || Math.max(0, total - dp);
    if (balance <= 0) { tdTransition(id, 'completed'); return; }

    let modal = document.getElementById('tdCollectModal');
    if (!modal) {
      const html = `
      <div class="modal fade" id="tdCollectModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-sm">
          <div class="modal-content" style="border:none;border-radius:16px;overflow:hidden;">
            <div class="modal-header" style="background:linear-gradient(135deg,#059669,#047857);color:#fff;padding:1rem 1.25rem;border-bottom:none;">
              <h6 class="modal-title fw-bold"><i class="bi bi-cash-coin me-2"></i>Collect Payment</h6>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:1.25rem;background:#f8fafc;">
              <div style="background:#ecfdf5;border:1px solid #a7f3d0;border-radius:10px;padding:12px;margin-bottom:12px;">
                <div class="d-flex justify-content-between mb-1" style="font-size:0.82rem;"><span class="text-muted">Total:</span><span id="tdPayTotal" class="fw-bold">₱0</span></div>
                <div class="d-flex justify-content-between mb-1" style="font-size:0.82rem;"><span class="text-muted">Downpayment:</span><span id="tdPayDP" class="text-primary fw-bold">₱0</span></div>
                <div class="d-flex justify-content-between pt-1 border-top" style="border-color:#a7f3d0 !important;font-size:0.9rem;"><span class="fw-bold">Balance Due:</span><span id="tdPayBal" class="text-success fw-bold">₱0</span></div>
              </div>
              <div class="mb-2">
                <label class="form-label fw-bold" style="font-size:0.82rem;">Amount <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="tdPayAmount" style="border-radius:8px;font-weight:600;" />
              </div>
              <div class="mb-2">
                <input type="text" class="form-control" id="tdPayNotes" placeholder="Notes (optional)" style="border-radius:8px;font-size:0.85rem;" />
              </div>
              <div id="tdPayError" class="alert alert-danger d-none mb-0" style="font-size:0.82rem;"></div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #e2e8f0;padding:0.75rem 1.25rem;background:#fff;">
              <button class="btn btn-sm btn-light" data-bs-dismiss="modal">Skip</button>
              <button class="btn btn-sm btn-success" id="tdPayConfirm"><i class="bi bi-check-circle me-1"></i>Collect & Complete</button>
            </div>
          </div>
        </div>
      </div>`;
      document.body.insertAdjacentHTML('beforeend', html);
      modal = document.getElementById('tdCollectModal');
    }
    document.getElementById('tdPayTotal').textContent = '₱' + total.toLocaleString();
    document.getElementById('tdPayDP').textContent = '₱' + dp.toLocaleString();
    document.getElementById('tdPayBal').textContent = '₱' + balance.toLocaleString();
    document.getElementById('tdPayAmount').value = balance;
    document.getElementById('tdPayNotes').value = '';
    document.getElementById('tdPayError').classList.add('d-none');

    const confirmBtn = document.getElementById('tdPayConfirm');
    confirmBtn.disabled = false;
    confirmBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Collect & Complete';

    confirmBtn.onclick = async function() {
      const amt = parseFloat(document.getElementById('tdPayAmount').value);
      const notes = document.getElementById('tdPayNotes').value.trim();
      if (!amt || amt <= 0) { document.getElementById('tdPayError').textContent = 'Enter a valid amount.'; document.getElementById('tdPayError').classList.remove('d-none'); return; }
      confirmBtn.disabled = true;
      confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing...';
      try {
        const payRes = await fetch(`/api/technician/assignments/${id}/collect-payment`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
          body: JSON.stringify({ amount: amt, notes })
        });
        const payData = await payRes.json();
        if (payRes.ok) {
          bootstrap.Modal.getInstance(modal).hide();
          showToast('Payment collected: ' + payData.message, 'success');
          tdTransition(id, 'completed');
        } else {
          document.getElementById('tdPayError').textContent = payData.error || 'Failed';
          document.getElementById('tdPayError').classList.remove('d-none');
          confirmBtn.disabled = false;
          confirmBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Collect & Complete';
        }
      } catch(e) {
        document.getElementById('tdPayError').textContent = 'Network error';
        document.getElementById('tdPayError').classList.remove('d-none');
        confirmBtn.disabled = false;
        confirmBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Collect & Complete';
      }
    };

    new bootstrap.Modal(modal).show();
  };

  // ── Repair En Route Handler ──────────────────────────────────────────────
  window.tdRepairEnRoute = async function(bookingId) {
    if (!confirm('Are you sure you want to go En Route for this repair?')) return;
    try {
      const res = await fetch(`/api/technician/repairs/${bookingId}/en-route`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-XSRF-TOKEN': token || '' },
        credentials: 'same-origin'
      });
      const data = await res.json();
      if (res.ok) {
        showToast('En Route! Navigating to customer...', 'success');
        loadDashboard();
      } else {
        showToast(data.error || 'Failed to start', 'danger');
      }
    } catch(e) { showToast('Network error', 'danger'); }
  };

  // ── Repair Status Transition Handler ──────────────────────────────────────
  window.tdRepairTransition = async function(bookingId, status) {
    const labels = { on_site: 'mark as Arrived', in_progress: 'start work', completed: 'mark as Completed', no_show: 'mark as No Show' };
    if (!confirm(`Are you sure you want to ${labels[status] || status}?`)) return;
    try {
      const res = await fetch(`/api/technician/repairs/${bookingId}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-XSRF-TOKEN': token || '' },
        credentials: 'same-origin',
        body: JSON.stringify({ status })
      });
      const data = await res.json();
      if (res.ok) {
        showToast(`Status updated to ${status.replace(/_/g, ' ')}`, 'success');
        loadDashboard();
      } else {
        showToast(data.error || 'Failed', 'danger');
      }
    } catch(e) { showToast('Network error', 'danger'); }
  };

  function showToast(msg, type) {
    var container = document.getElementById('globalToastContainer');
    if (!container) return;
    var id = 'toast_' + Date.now();
    var bgClass = type === 'success' ? 'bg-success' : type === 'danger' ? 'bg-danger' : 'bg-primary';
    var html = '<div id="' + id + '" class="toast align-items-center text-white ' + bgClass + ' border-0 show" role="alert" aria-live="assertive" aria-atomic="true">' +
      '<div class="d-flex"><div class="toast-body">' + msg + '</div>' +
      '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div></div>';
    container.insertAdjacentHTML('beforeend', html);
    setTimeout(function() { var el = document.getElementById(id); if (el) el.remove(); }, 4000);
  }

  // Initial load
  loadDashboard();
  loadTodayExpenses();

  // Refresh every 30s
  setInterval(() => { loadDashboard(); loadTodayExpenses(); }, 30000);
})();
</script>
