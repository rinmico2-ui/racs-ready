            <span class="es-day-date"><i class="bi bi-calendar3"></i> ${new Date(date+'T00:00:00').toLocaleDateString('en-PH',{weekday:'long',month:'long',day:'numeric',year:'numeric'})}</span>
            <span class="es-day-caps">${capPills}</span>
