          <p class="text-muted small mb-3 px-3">
            Bookings that have been assigned to a technician but are awaiting their confirmation.
          </p>
          <div id="waitingAcceptContainer" class="workflow-record-list">
            <div class="text-center py-5 text-muted"><div class="spinner-border text-primary"></div><p class="mt-2">Loading...</p></div>
