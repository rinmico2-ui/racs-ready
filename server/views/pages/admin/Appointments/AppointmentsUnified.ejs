  AU.Queue.openAssignModal=function(bookingId,customerName,serviceName,bookingDate,startTime){
    _qCurrentBookingId=bookingId;_qSelectedTechId=null;_qRecommendedTechId=null;_qEquipment=[];

    var modalEl=document.getElementById('assignModal');
    var mapEl=document.getElementById('assignMapContainer');

    document.getElementById('assignCustomerName').textContent=customerName;
    document.getElementById('assignServiceInfo').textContent=serviceName;
    document.getElementById('assignNotes').value='';
    document.getElementById('assignPriority').value='normal';
    document.getElementById('assignDate').value=bookingDate||'';
    document.getElementById('assignTimeSlot').value=startTime||'';
    document.getElementById('btnConfirmAssign').disabled=true;

    document.getElementById('aiRecommendName').textContent='—';
    document.getElementById('aiRecommendReason').textContent='—';
    document.getElementById('aiRecommendSection').style.display='';
    document.getElementById('assignFooterSub').textContent='—';
    document.getElementById('techCountBadge').textContent='—';
    document.getElementById('assignAvailabilityHint').textContent='';
    document.getElementById('assignMapTechCount').textContent='0 technicians';
    // Core and repair bookings use the same dispatch modal. Inventory is
    // prepared by the technician only after accepting the assignment.
    var adminEqSection=document.getElementById('adminAssignmentEquipmentSection');
    if(adminEqSection) adminEqSection.style.display='none';

    document.getElementById('techListContainer').innerHTML='<div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></div>';

    if(mapEl){ mapEl.innerHTML=''; }
    document.getElementById('assignLocationSub').textContent='Loading map...';

    new bootstrap.Modal(modalEl).show();

    function ensureAssignLeaflet(){
      if(window.L&&mapEl&&document.getElementById('leaflet-css')) return Promise.resolve();
      if(!document.getElementById('leaflet-css')){
        var css=document.createElement('link');
        css.id='leaflet-css';
        css.rel='stylesheet';
        css.href='https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(css);
      }
      if(window.L) return Promise.resolve();
      return new Promise(function(resolve){
        var s=document.createElement('script');
        s.src='https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js';
        s.onload=function(){resolve();};
        document.head.appendChild(s);
      });
    }

    function parseCoords(c){
      if(!c) return null;
      try{
        if(Array.isArray(c)&&c.length>=2){
          var lng=Number(c[0]),lat=Number(c[1]);
          if(!isFinite(lng)||!isFinite(lat)) return null;
          return {lat:lat,lng:lng};
        }
        if(typeof c==='object'){
          if(c.coordinates) return parseCoords(c.coordinates);
          if(c.lat!=null&&c.lng!=null){
            var la=Number(c.lat),lo=Number(c.lng);
            if(!isFinite(la)||!isFinite(lo)) return null;
            return {lat:la,lng:lo};
          }
        }
      }catch(e){}
      return null;
    }

    fetch('/api/admin/appointments/'+bookingId+'/eligible-technicians').then(function(r){return r.json();}).then(function(data){
      var container=document.getElementById('techListContainer');
      var avail=data.available||[];
      var unavail=data.offlinePresent||[];

      document.getElementById('techCountBadge').textContent=avail.length;
      document.getElementById('assignAvailabilityHint').textContent=avail.length+' available'+(unavail.length?' · '+unavail.length+' unavailable':'');

      var ai=data.aiRecommendation||data.ai||data.recommendation||null;

      // Resolve AI recommended technician id from different response shapes
      function resolveAiTechId(aiObj){
        if(!aiObj) return null;

        // direct / common shapes
        var candidate = aiObj.technicianId || aiObj.technician_id || aiObj.techId || aiObj._id || aiObj.id;
        if(candidate){
          if(typeof candidate === 'object'){
            return String(candidate._id || candidate.id || candidate.technicianId || candidate.value || '');
          }
          return String(candidate);
        }

        // nested shapes
        if(aiObj.technician){
          if(aiObj.technician._id) return String(aiObj.technician._id);
          if(aiObj.technician.id) return String(aiObj.technician.id);
          if(aiObj.technician.technicianId) return String(aiObj.technician.technicianId);
          if(typeof aiObj.technician === 'string') return aiObj.technician;
        }

        // occasionally: technicianId may itself be { _id: ... }
        if(aiObj.technicianId && typeof aiObj.technicianId === 'object'){
          if(aiObj.technicianId._id) return String(aiObj.technicianId._id);
          if(aiObj.technicianId.id) return String(aiObj.technicianId.id);
        }

        return null;
      }
      var aiTechId=resolveAiTechId(ai);

      // ── AI recommendation (uses server-side ranking: availability, rating, workload, proximity) ──
      if(!ai && avail.length > 0){
        // Server returns `available` already sorted best-first by the AI score.
        var best = avail[0];
        if(best){
          aiTechId = String(best._id);
          var reasonParts = [];
          if(best.availabilityStatus === 'Available') reasonParts.push('Available now');
          else if(best.availabilityStatus === 'Online') reasonParts.push('Online');
          if(best.distanceKm != null) reasonParts.push(best.distanceKm + ' km away');
          if(best.etaMin != null) reasonParts.push('ETA ~' + best.etaMin + ' min');
          if(best.rating >= 4.5) reasonParts.push('Top rated (' + Number(best.rating).toFixed(1) + ')');
          if(best.currentWorkload === 0) reasonParts.push('No current jobs');
          else if(best.currentWorkload) reasonParts.push(best.currentWorkload + ' active job' + (best.currentWorkload > 1 ? 's' : ''));
          document.getElementById('aiRecommendName').textContent = best.name;
          document.getElementById('aiRecommendReason').textContent = reasonParts.join(' · ');
          document.getElementById('aiRecommendSection').style.display = '';
        }
      }

      // AI section (server-side, if provided)
      if(ai){
        var aiName=ai.name||ai.technicianName||ai.technician||'Recommended';
        var aiReason=ai.reason||ai.reasons||ai.explanation||'Based on workload, distance, and availability';
        document.getElementById('aiRecommendName').textContent=aiName;
        document.getElementById('aiRecommendReason').textContent=aiReason;

        // if API returns aiTechId but not matching _id string format, try matching by name
        if(aiTechId){
          var aiMatch = avail.find(function(t){ return t && t._id && String(t._id)===String(aiTechId); });
          if(!aiMatch){
            var aiNameLower = String(aiName||'').toLowerCase();
            aiMatch = avail.find(function(t){ return t && t.name && String(t.name).toLowerCase()===aiNameLower; });
          }
          if(aiMatch && aiMatch._id) aiTechId = String(aiMatch._id);
        }

        // show only when we have at least something useful
        if(aiTechId || aiName || aiReason) document.getElementById('aiRecommendSection').style.display='';
        else document.getElementById('aiRecommendSection').style.display='none';
      }else if(!aiTechId){
        // No server AI and no client-side proximity match
        document.getElementById('aiRecommendName').textContent='—';
        document.getElementById('aiRecommendReason').textContent='—';
        document.getElementById('aiRecommendSection').style.display='none';
      }
      _qRecommendedTechId=aiTechId?String(aiTechId):null;

      if(!avail.length&&!unavail.length){
        container.innerHTML='<div class="alert alert-warning small mb-0">No eligible technicians found.</div>';
        document.getElementById('assignAvailabilityHint').textContent='No technicians are eligible for this schedule';
      }

      // Render technician cards
      var html=!avail.length&&!unavail.length?'<div class="alert alert-warning small mb-0">No eligible technicians found. Review attendance, leave, schedule conflicts, and capacity.</div>':'';
      if(avail.length>0){
        html+='<div class="aq-tech-list">'+avail.map(function(t){
          var isRecommended=(aiTechId&&String(t._id)===String(aiTechId));
          var selectedClass='';
          var statusColor=t.availabilityStatus==='Available'?'#22c55e':(t.availabilityStatus==='Online'?'#f59e0b':'#94a3b8');
          var recommendedBadge=isRecommended?'<span class="badge" style="background:#eef2ff;color:#4f46e5;border:1px solid #c7d2fe;font-weight:600;font-size:0.65rem;padding:2px 6px;border-radius:6px;">AI Recommended</span>':'';
          var dist=t.distanceKm!=null?'<span class="aq-tech-badge"><i class="bi bi-geo me-1"></i>'+t.distanceKm+' km</span>':'';
          var eta=t.etaMin!=null?'<span class="aq-tech-badge"><i class="bi bi-clock me-1"></i>'+t.etaMin+' min</span>':'';
          var rating=t.rating?'<div class="aq-tech-card-rating">\u2605 '+Number(t.rating).toFixed(1)+'</div>':'';
          var jobs='<span class="aq-tech-badge"><i class="bi bi-briefcase me-1"></i>'+(t.currentWorkload||0)+' jobs</span>';
          var radioChecked='';
          return '<div class="aq-tech-option'+selectedClass+'" onclick="AU.Queue.selectTech(\''+t._id+'\',this)" data-tech-id="'+t._id+'">'+
            '<div class="aq-tech-card-top">'+
              '<div class="aq-tech-avatar" style="--status-color:'+statusColor+';">'+((t.name||'?')[0].toUpperCase())+'</div>'+
              '<div class="aq-tech-card-info">'+
                '<div class="aq-tech-name">'+t.name+' '+recommendedBadge+'</div>'+
                '<div class="aq-tech-status"><span style="color:'+statusColor+';font-size:10px;">&#9679;</span> '+(t.availabilityStatus||'Offline')+'</div>'+
              '</div>'+
              rating+
            '</div>'+
            '<div class="aq-tech-card-meta">'+
              dist+eta+jobs+
            '</div>'+
            '<div class="aq-tech-card-footer">'+
              '<input type="radio" name="qTechSelect" class="form-check-input" '+radioChecked+'>'+
              '<span class="small text-muted">Select</span>'+
            '</div>'+
          '</div>';
        }).join('')+'</div>';
      }
      if(unavail.length>0){
        html+='<div class="mt-2 mb-1"><small class="fw-semibold text-muted" style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.5px;">Unavailable</small></div>';
        html+='<div class="aq-tech-list">'+unavail.map(function(t){
          var statusColor='#6c757d';
          return '<div class="aq-tech-option disabled" title="'+(t.reason||'Unavailable')+'" data-tech-id="'+t._id+'">'+
            '<div class="aq-tech-card-top">'+
              '<div class="aq-tech-avatar" style="--status-color:'+statusColor+';background:#f1f5f9;color:#64748b;">'+((t.name||'?')[0].toUpperCase())+'</div>'+
              '<div class="aq-tech-card-info">'+
                '<div class="aq-tech-name">'+t.name+'</div>'+
                '<div class="aq-tech-status text-danger"><i class="bi bi-x-circle me-1"></i>'+(t.reason||'Unavailable')+'</div>'+
              '</div>'+
            '</div>'+
          '</div>';
        }).join('')+'</div>';
      }
      container.innerHTML=html;

      // Keep assignment explicit. The recommendation is highlighted, but the
      // admin must select it (or another technician) before confirmation.
      _qSelectedTechId=null;
      document.getElementById('btnConfirmAssign').disabled=true;
      document.getElementById('assignFooterSub').textContent='Select a technician to continue';

      // Leaflet map
      ensureAssignLeaflet().then(function(){
        if(!mapEl) return;

        var bookingLoc=parseCoords(data.bookingLocation||data.location||data.serviceLocation||data.service_location||data.coordinates||data.coords);
        if(!bookingLoc && data.bookingLat!=null && data.bookingLng!=null){
          bookingLoc={lat:Number(data.bookingLat),lng:Number(data.bookingLng)};
        }
        if(!bookingLoc && avail && avail[0] && (avail[0].bookingLat!=null && avail[0].bookingLng!=null)){
          bookingLoc={lat:Number(avail[0].bookingLat),lng:Number(avail[0].bookingLng)};
        }
        if(!bookingLoc){
          bookingLoc=parseCoords(data.serviceCoordinates||data.service_coordinates);
        }

        // Plot both eligible and unavailable technicians so dispatch sees the
        // full field picture without treating an unavailable tech as assignable.
        var techsToPlot=avail.concat(unavail).slice(0,12);
        var markers=[];
        techsToPlot.forEach(function(t){
          var loc=parseCoords(t.location||t.coords||t.coordinates||t.geo||t.position);
          if(loc) markers.push({tech:t,loc:loc});
        });
        document.getElementById('assignMapTechCount').textContent=markers.length+' technician'+(markers.length===1?'':'s')+' on map';

        if(bookingLoc||markers.length){
          document.getElementById('assignLocationSub').textContent='Technician locations relative to the service address';

          // create map (destroy if already exists)
          if(window.__assignMap){
            try{ window.__assignMap.remove(); }catch(e){}
            window.__assignMap=null;
          }
          window.__assignMap=L.map(mapEl,{zoomControl:true,attributionControl:false});

          var bounds=[];
          if(bookingLoc) bounds.push([bookingLoc.lat,bookingLoc.lng]);
          markers.forEach(function(m){ bounds.push([m.loc.lat,m.loc.lng]); });

          if(bounds.length){
            window.__assignMap.setView(bounds[0], bookingLoc ? 12 : 13);
          }else{
            window.__assignMap.setView([14.5995,120.9842], 12);
          }

          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; <a href="https://openstreetmap.org/copyright">OSM</a>'}).addTo(window.__assignMap);

          if(bookingLoc){
            var bookingIcon=L.divIcon({className:'',html:'<div style="position:relative;"><div style="width:38px;height:38px;background:#2563eb;border-radius:50%;border:3px solid #fff;box-shadow:0 3px 14px rgba(37,99,235,0.5);display:flex;align-items:center;justify-content:center;"><i class="bi bi-geo-alt-fill" style="color:#fff;font-size:17px;"></i></div><div style="position:absolute;top:-22px;left:50%;transform:translateX(-50%);background:#2563eb;color:#fff;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;white-space:nowrap;box-shadow:0 1px 4px rgba(0,0,0,0.2);">Customer</div></div>',iconSize:[38,38],iconAnchor:[19,19]});
            L.marker([bookingLoc.lat,bookingLoc.lng],{icon:bookingIcon}).addTo(window.__assignMap).bindPopup('<b>Booking Location</b><br>Customer scheduled location');
          }

          // Find nearest tech for highlight
          var techsWithDist = markers.filter(function(m){ return m.tech && m.tech.distanceKm != null && m.tech.availabilityStatus === 'Available'; });
          var nearestTech = techsWithDist.length > 0 ? techsWithDist.reduce(function(a,b){ return a.tech.distanceKm <= b.tech.distanceKm ? a : b; }) : null;

          markers.forEach(function(m){
            var isRec=(aiTechId&&m.tech && m.tech._id && String(m.tech._id)===String(aiTechId));
            var isNearest=nearestTech && m.tech && nearestTech.tech && m.tech._id === nearestTech.tech._id;
            var isUnavailable=!!m.tech.reason;
            var iconColor=isUnavailable?'#94a3b8':isRec?'#4f46e5':isNearest?'#22c55e':'#16a34a';
            var size=isNearest?36:32;
            var border=isNearest?'3px solid #fbbf24':'3px solid #fff';
            var labelHtml=isNearest?'<div style="position:absolute;top:-18px;left:50%;transform:translateX(-50%);background:#f59e0b;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:8px;white-space:nowrap;">Nearest</div>':'';
            var iconHtml='<div style="position:relative;"><div style="width:'+size+'px;height:'+size+'px;background:'+iconColor+';border-radius:50%;border:'+border+';box-shadow:0 3px 12px rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:center;"><i class="bi bi-person-fill" style="color:#fff;font-size:'+(isNearest?16:14)+'px;"></i></div>'+labelHtml+'</div>';
            var ti=L.divIcon({className:'',html:iconHtml,iconSize:[size,size],iconAnchor:[size/2,size/2]});
            var popupContent='<b>'+m.tech.name+'</b>'+(isNearest?' <span style="color:#f59e0b;">★ Nearest</span>':'')+'<br/><span style="font-size:0.8rem;color:#666;">'+(isUnavailable?(m.tech.reason||'Unavailable'):(m.tech.availabilityStatus||''))+'</span>'+(m.tech.distanceKm!=null?'<br/>'+m.tech.distanceKm+' km away':'')+(m.tech.etaMin!=null?'<br/>ETA ~'+m.tech.etaMin+' min':'');
            L.marker([m.loc.lat,m.loc.lng],{icon:ti}).addTo(window.__assignMap).bindPopup(popupContent);
          });

          if(bounds.length>1){
            window.__assignMap.fitBounds(L.latLngBounds(bounds).pad(0.15));
          }

          // Bootstrap modal/show class handling can differ depending on DOM + timing.
          // Always invalidate after render so Leaflet computes correct size.
          setTimeout(function(){
            try{
              if(window.__assignMap && mapEl){
                window.__assignMap.invalidateSize();
              }
            }catch(e){}
          }, 200);

          // extra invalidate to cover first-tick sizing issues
          setTimeout(function(){
            try{
              if(window.__assignMap && mapEl){
                window.__assignMap.invalidateSize();
              }
            }catch(e){}
          }, 600);
        }else{
          document.getElementById('assignLocationSub').textContent='Map not available';
          document.getElementById('assignMapTechCount').textContent='0 technicians';
        }
      }).catch(function(){
        document.getElementById('assignLocationSub').textContent='Map unavailable';
        document.getElementById('assignMapTechCount').textContent='0 technicians';
      });

      // If no AI auto-selected, disable confirm unless user picks
      // (selectTech enables it)
      if(!aiTechId) {
        _qSelectedTechId=null;
        document.getElementById('btnConfirmAssign').disabled=true;
      }
    }).catch(function(){
      container.innerHTML='<div class="alert alert-danger small">Failed to load technicians</div>';
      document.getElementById('assignLocationSub').textContent='Map not available';
      document.getElementById('assignMapTechCount').textContent='0 technicians';
    });
  };

  AU.Queue.selectTech=function(techId,el){
    _qSelectedTechId=techId;
    document.querySelectorAll('.aq-tech-option').forEach(function(o){o.classList.remove('selected');});
    el.classList.add('selected');
    document.querySelectorAll('input[name="qTechSelect"]').forEach(function(r){r.checked=false;});
    var radio=el.querySelector('input[name="qTechSelect"]');
    if(radio) radio.checked=true;
    document.getElementById('btnConfirmAssign').disabled=false;
    var nameEl=(el.querySelector('.aq-tech-card-info .aq-tech-name')||{}).firstChild;
    var techName=nameEl?nameEl.textContent.trim():'Technician';
    document.getElementById('assignFooterSub').textContent='Selected: '+techName;
  };

  AU.Queue.selectRecommended=function(){
    if(!_qRecommendedTechId){
      showNotification({type:'warning',title:'Recommendation Unavailable',message:'Select a technician from the available list.',duration:3000});
      return;
    }
    var card=document.querySelector('#assignModal .aq-tech-option[data-tech-id="'+String(_qRecommendedTechId)+'"]');
    if(!card||card.classList.contains('disabled')){
      showNotification({type:'warning',title:'Technician Unavailable',message:'The recommended technician is no longer eligible. Choose another technician.',duration:4000});
      return;
    }
    AU.Queue.selectTech(String(_qRecommendedTechId),card);
  };

  AU.Queue.updateSelectedToolId=function(){
    var input=document.getElementById('assignEquipmentToolInput');
    var hidden=document.getElementById('assignEquipmentTool');
    if(!input||!hidden)return;
    var v=input.value.trim().toLowerCase();
    hidden.value='';
    for(var i=0;i<_qEquipmentCache.length;i++){
      var t=_qEquipmentCache[i];
      if((t.itemName+' (avail '+t.availableQuantity+')').toLowerCase()===v || t.itemName.toLowerCase()===v){ hidden.value=t._id; break; }
    }
  };

  AU.Queue.addEquipment=function(){
    var hidden=document.getElementById('assignEquipmentTool');
    var input=document.getElementById('assignEquipmentToolInput');
    var qty=document.getElementById('assignEquipmentQty');
    var toolId=hidden?hidden.value:'';
    if(!toolId && input && input.value.trim()){
      var typed=input.value.trim().toLowerCase();
      var t=_qEquipmentCache.find(function(x){return x.itemName.toLowerCase()===typed;}); // strict match to avoid partials
      if(t) toolId=t._id;
    }
    if(!qty||!toolId){showNotification({type:'warning',title:'Select Equipment',message:'Please select a tool from suggestions and quantity.',duration:3000});return;}
    var tool=_qEquipmentCache.find(function(t){return t._id===toolId;});
    if(!tool){showNotification({type:'warning',title:'Invalid Tool',message:'Choose a tool from the list or use Add New Tool.',duration:3000});return;}
    var requested=parseInt(qty.value)||1;
    var available=tool.availableQuantity!=null?tool.availableQuantity:Math.max(0,(tool.quantity||0)-(tool.reservedQuantity||0));
    var already=_qEquipment.filter(function(e){return e.equipmentId===toolId;}).reduce(function(a,b){return a+b.quantity;},0);
    if(requested+already>available){showNotification({type:'error',title:'Not Enough Stock',message:'Available: '+available,duration:3000});return;}
    _qEquipment.push({equipmentId:toolId,equipmentName:tool.itemName,quantity:requested});
    if(input) input.value='';
    if(hidden) hidden.value='';
    qty.value=1;
    AU.Queue.renderEquipmentList();
  };

  AU.Queue.removeEquipment=function(index){
    _qEquipment.splice(index,1);
    AU.Queue.renderEquipmentList();
  };

  AU.Queue.renderEquipmentList=function(){
    var list=document.getElementById('assignEquipmentList');
    var empty=document.getElementById('assignEquipmentEmpty');
    if(!list||!empty)return;
    if(!_qEquipment.length){list.innerHTML='';empty.style.display='block';return;}
    empty.style.display='none';
    list.innerHTML=_qEquipment.map(function(e,i){
      return '<div class="d-flex justify-content-between align-items-center p-2 border rounded"><div><strong>'+e.equipmentName+'</strong><div class="small text-muted">Qty: '+e.quantity+'</div></div><button class="btn btn-sm btn-outline-danger" onclick="AU.Queue.removeEquipment('+i+')"><i class="bi bi-trash"></i></button></div>';
    }).join('');
  };

  AU.Queue.renderRecommendedTools=function(recommended){
    var container=document.getElementById('assignEquipmentRecommended');
    var empty=document.getElementById('assignEquipmentRecommendedEmpty');
    if(!container||!empty)return;
    if(!recommended||!recommended.length){container.innerHTML='';empty.classList.remove('d-none');return;}
    empty.classList.add('d-none');
    container.innerHTML=recommended.map(function(t){
      return '<button type="button" class="btn btn-sm btn-outline-info me-1 mb-1" onclick="AU.Queue.addRecommendedEquipment(\''+t._id+'\')"><i class="bi bi-magic me-1"></i>'+t.itemName+' (avail '+t.availableQuantity+')</button>';
    }).join('');
  };

  AU.Queue.addRecommendedEquipment=function(toolId){
    var tool=_qEquipmentCache.find(function(t){return t._id===toolId;});
    if(!tool)return;
    var available=tool.availableQuantity!=null?tool.availableQuantity:Math.max(0,(tool.quantity||0)-(tool.reservedQuantity||0));
    var already=_qEquipment.filter(function(e){return e.equipmentId===toolId;}).reduce(function(a,b){return a+b.quantity;},0);
    if(1+already>available){showNotification({type:'error',title:'Not Enough Stock',message:'Available: '+available,duration:3000});return;}
    _qEquipment.push({equipmentId:toolId,equipmentName:tool.itemName,quantity:1});
    AU.Queue.renderEquipmentList();
  };

  AU.Queue.toggleNewToolForm=function(){
    var form=document.getElementById('newToolForm');
    if(form) form.classList.toggle('d-none');
  };

  AU.Queue.saveNewTool=function(){
    var nameEl=document.getElementById('assignNewToolName');
    var qtyEl=document.getElementById('assignNewToolQty');
    var unitEl=document.getElementById('assignNewToolUnit');
    var typeEl=document.getElementById('assignNewToolType');
    var catEl=document.getElementById('assignNewToolCategory');
    var name=(nameEl&&nameEl.value||'').trim();
    var qty=parseInt(qtyEl&&qtyEl.value)||0;
    var itemType=(typeEl&&typeEl.value)||'equipment';
    if(!name){showNotification({type:'warning',title:'Tool Name Required',message:'Enter a tool name.',duration:3000});return;}
    var btn=document.getElementById('btnSaveNewTool');
    btn.disabled=true;btn.innerHTML='Saving...';
    fetch('/api/admin/tools',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({itemName:name,quantity:qty,unit:(unitEl&&unitEl.value)||'pcs',type:itemType,category:(catEl&&catEl.value)||itemType})})
    .then(function(r){return r.json().then(function(d){if(!r.ok)throw new Error(d.error||'Failed to save tool');return d;});})
    .then(function(d){
      showNotification({type:'success',title:'Tool Created',message:d.tool.itemName+' added to inventory.',duration:3000});
      var tool=d.tool;
      tool.availableQuantity=Math.max(0,(tool.quantity||0)-(tool.reservedQuantity||0));
      _qEquipmentCache.push(tool);
      var input=document.getElementById('assignEquipmentToolInput');
      var hidden=document.getElementById('assignEquipmentTool');
      var dl=document.getElementById('assignEquipmentDatalist');
      var display=tool.itemName+' (avail '+tool.availableQuantity+')';
      if(dl){ var o=document.createElement('option'); o.value=display; dl.appendChild(o); }
      if(input){ input.value=display; input.disabled=false; }
      if(hidden) hidden.value=tool._id;
      nameEl.value='';qtyEl.value=1;if(unitEl) unitEl.value='pcs';if(typeEl) typeEl.value='equipment';if(catEl) catEl.value='General';
      AU.Queue.toggleNewToolForm();
    })
    .catch(function(e){showNotification({type:'error',title:'Failed to Save Tool',message:e.message||'Could not add tool.',duration:5000});})
    .finally(function(){btn.disabled=false;btn.innerHTML='Save Tool to Inventory';});
  };

  AU.Queue.confirmAssign=function(){
    if(!_qCurrentBookingId||!_qSelectedTechId)return;
    var btn=document.getElementById('btnConfirmAssign');
    var orig=btn.innerHTML;
    btn.disabled=true;btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Assigning...';
    fetch('/api/admin/appointments/'+_qCurrentBookingId+'/assign',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({technicianId:_qSelectedTechId,priority:document.getElementById('assignPriority').value,notes:document.getElementById('assignNotes').value})})
    .then(function(r){return r.json().then(function(d){if(!r.ok)throw new Error(d.error||'Failed');return d;});})
    .then(function(){bootstrap.Modal.getInstance(document.getElementById('assignModal')).hide();showNotification({type:'success',title:'Technician Assigned',message:'Booking has been assigned successfully.',duration:4000});AU.Queue.loadQueue(_qPage);AU.Queue.loadStats();})
    .catch(function(e){showNotification({type:'error',title:'Assignment Failed',message:e.message||'An error occurred.',duration:5000});btn.disabled=false;btn.innerHTML=orig;});
  };

  AU.Queue.viewBooking=function(id){
    var body=document.getElementById('detailBody');
    var subtitle=document.getElementById('detailModalSubtitle');
    body.innerHTML='<div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Loading booking details...</p></div>';
    subtitle.textContent='Loading...';
    document.getElementById('detailTitle').textContent='Booking Details';
    new bootstrap.Modal(document.getElementById('detailModal')).show();
    fetch('/api/admin/appointments/'+id).then(function(r){return r.json();}).then(function(data){
      var b=data.booking;
      if(!b){body.innerHTML='<div class="alert alert-danger">Booking not found</div>';return;}
      var refText=b.bookingReference||b.workOrderNumber||'#'+b._id.toString().slice(-8).toUpperCase();
      document.getElementById('detailTitle').textContent='Booking '+refText;
      var needsResolution=bookingNeedsResolution(b);
      subtitle.textContent=needsResolution?'Past schedule \u00b7 Needs resolution':refText;
      body.innerHTML=buildDetailHTML(b,data);
      if(needsResolution){
        var resolutionFooter=document.createElement('div');resolutionFooter.className='pm-footer';
        resolutionFooter.innerHTML='<a class="btn btn-warning btn-sm fw-semibold" href="'+bookingResolutionUrl(b)+'"><i class="bi bi-exclamation-diamond me-1"></i>Open Resolution Center</a><button class="btn btn-light btn-sm" data-bs-dismiss="modal">Close</button>';
        body.appendChild(resolutionFooter);
      }else if(['awaiting_assignment','pending_reassignment'].indexOf(b.status)!==-1){
        var footer=document.createElement('div');footer.className='pm-footer';
        var isRepair=b.serviceModel==='RepairService'||b.serviceType==='repair';
        var detailScheduleDate=b.bookingDate?new Date(b.bookingDate).toISOString().slice(0,10):'';
        var detailScheduleTime=String(b.startTime||'').replace(/'/g,"\\'");
        footer.innerHTML='<button class="btn btn-primary btn-sm fw-semibold" onclick="bootstrap.Modal.getInstance(document.getElementById(\'detailModal\')).hide();setTimeout(function(){AU.Queue.openAssignModal(\''+b._id+'\',\''+(b.customer?b.customer.name:'').replace(/'/g,"\\'")+'\',\''+((b.service?b.service.name:'')||(isRepair?'Repair Service':'')).replace(/'/g,"\\'")+'\',\''+detailScheduleDate+'\',\''+detailScheduleTime+'\');},300);"><i class="bi bi-person-plus me-1"></i>Assign Technician</button><button class="btn btn-light btn-sm" data-bs-dismiss="modal">Close</button>';
        body.appendChild(footer);
      }
    }).catch(function(e){body.innerHTML='<div class="alert alert-danger">Failed to load booking details: '+e.message+'</div>';});
  };

