<div class="admin-dashboard container-fluid py-4">
  <%- include('../../../partials/dashboard-styles') %>
    <style>
      /* ═══ Service Analytics — Enterprise Overrides ═══ */
      .kpi-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
        margin-bottom: 1.5rem;
      }
      @media (max-width: 1199px) { .kpi-grid { grid-template-columns: repeat(3, 1fr); } }
      @media (max-width: 767px)  { .kpi-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
      @media (max-width: 480px)  { .kpi-grid { grid-template-columns: 1fr; } }
      .kpi-enterprise {
        position:relative;background:#fff;border-radius:16px;
        padding:18px 18px 14px;
        box-shadow:0 1px 3px rgba(15,23,42,0.04),0 4px 16px rgba(15,23,42,0.04);
        border:1px solid rgba(226,232,240,0.6);
        transition:transform 0.25s cubic-bezier(0.4,0,0.2,1),box-shadow 0.25s cubic-bezier(0.4,0,0.2,1);
        overflow:hidden;display:flex;flex-direction:column;cursor:default;
      }
      .kpi-enterprise:hover{transform:translateY(-4px);box-shadow:0 8px 32px rgba(15,23,42,0.08),0 2px 8px rgba(15,23,42,0.04);}
      .kpi-enterprise::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;opacity:0;transition:opacity 0.3s ease;}
      .kpi-enterprise:hover::before{opacity:1;}
      .kpi-enterprise[data-accent="blue"]::before{background:linear-gradient(90deg,#1e3a5f,#3b82f6);}
      .kpi-enterprise[data-accent="amber"]::before{background:linear-gradient(90deg,#d97706,#fbbf24);}
      .kpi-enterprise[data-accent="purple"]::before{background:linear-gradient(90deg,#7c3aed,#a855f7);}
      .kpi-enterprise[data-accent="green"]::before{background:linear-gradient(90deg,#059669,#10b981);}
      .kpi-enterprise[data-accent="cyan"]::before{background:linear-gradient(90deg,#0891b2,#22d3ee);}
      .kpi-enterprise-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:8px;}
      .kpi-enterprise-icon{width:38px;height:38px;min-width:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem;box-shadow:0 4px 10px rgba(0,0,0,0.08);flex-shrink:0;}
      .kpi-enterprise-icon.blue{background:linear-gradient(135deg,#1e3a5f,#3b82f6);color:#fff;}
      .kpi-enterprise-icon.amber{background:linear-gradient(135deg,#d97706,#fbbf24);color:#fff;}
      .kpi-enterprise-icon.purple{background:linear-gradient(135deg,#7c3aed,#a855f7);color:#fff;}
      .kpi-enterprise-icon.green{background:linear-gradient(135deg,#059669,#10b981);color:#fff;}
      .kpi-enterprise-icon.cyan{background:linear-gradient(135deg,#0891b2,#22d3ee);color:#fff;}
      .kpi-enterprise-badge{display:inline-flex;align-items:center;gap:4px;font-size:0.6rem;font-weight:600;letter-spacing:0.04em;padding:2px 8px;border-radius:999px;white-space:nowrap;}
      .kpi-enterprise-badge.blue{background:rgba(59,130,246,0.10);color:#2563eb;}
      .kpi-enterprise-badge.amber{background:rgba(245,158,11,0.10);color:#d97706;}
      .kpi-enterprise-badge.purple{background:rgba(168,85,247,0.10);color:#7c3aed;}
      .kpi-enterprise-badge.green{background:rgba(16,185,129,0.10);color:#059669;}
      .kpi-enterprise-badge.cyan{background:rgba(6,182,212,0.10);color:#0891b2;}
      .kpi-enterprise-body{flex:1;display:flex;flex-direction:column;justify-content:space-between;}
      .kpi-enterprise-label{font-size:0.72rem;font-weight:500;color:#64748b;margin:0 0 2px;line-height:1.3;}
      .kpi-enterprise-value{font-size:1.4rem;font-weight:700;color:#0f172a;line-height:1.2;letter-spacing:-0.02em;margin-bottom:6px;}
      .kpi-enterprise-sparkline{margin-top:4px;height:28px;position:relative;}
      .kpi-enterprise-sparkline canvas{width:100%!important;height:100%!important;}



      /* override some card colours for reports page */
      .admin-dashboard .card {
        border-radius: 16px;
        box-shadow: 0 8px 32px rgba(2, 6, 23, 0.07), 0 2px 6px rgba(2, 6, 23, 0.03);
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: box-shadow 0.3s ease;
      }

      .admin-dashboard .card:hover {
        box-shadow: 0 12px 40px rgba(2, 6, 23, 0.09), 0 4px 10px rgba(2, 6, 23, 0.05);
      }

      /* reduce the page container min-height so content doesn't stretch to full viewport */
      .admin-dashboard {
        min-height: auto !important;
        padding-top: 0.5rem !important;
        padding-bottom: 0.5rem !important;
      }

      .admin-dashboard .card-header {
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        font-weight: 700;
        border-bottom: 2px solid rgba(0, 0, 0, 0.04);
      }

      /* filter controls smaller, consistent margin */
      .admin-dashboard .card-body.row .form-label {
        font-size: 0.75rem;
        letter-spacing: 0.03em;
      }

      .admin-dashboard .card-body.row .form-select {
        font-size: 0.875rem;
      }

      /* table styling */
      .admin-dashboard table {
        font-size: 0.875rem;
      }

      .admin-dashboard table thead {
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        text-transform: uppercase;
        font-weight: 700;
        font-size: 0.78rem;
        letter-spacing: 0.3px;
        color: #334155;
      }

      .admin-dashboard table tbody tr {
        transition: background 0.2s ease;
      }

      .admin-dashboard table tbody tr:hover {
        background: rgba(59, 130, 246, 0.04);
      }

      /* enterprise chart and modal enhancements */
      canvas {
        cursor: pointer;
        transition: transform .2s ease;
      }

      canvas:hover {
        transform: scale(1.02);
      }

      .modal-content {
        background: #ffffff !important;
        border-radius: 12px;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.15);
      }

      .modal-backdrop.show {
        background-color: rgba(0, 0, 0, 0.15);
      }

      .modal,
      .modal-backdrop,
      .modal .modal-dialog,
      .modal .modal-content {
        pointer-events: auto !important;
      }

      /* enterprise look for modal */
      .modal-header {
        background: linear-gradient(90deg, #0d6efd, #6610f2);
        color: #fff;
      }

      .modal-header .modal-title {
        font-weight: 700;
      }

      #chartDataTable th {
        background: #f1f3f5;
        font-weight: 600;
      }

      #chartDataTable td {
        vertical-align: middle;
      }

      /* premium chart container cards */
      .dash-card {
        border-radius: 16px !important;
        box-shadow: 0 8px 32px rgba(2, 6, 23, 0.07), 0 2px 6px rgba(2, 6, 23, 0.03) !important;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
        transition: box-shadow 0.3s ease, transform 0.3s ease;
      }

      .dash-card:hover {
        box-shadow: 0 12px 40px rgba(2, 6, 23, 0.09), 0 4px 10px rgba(2, 6, 23, 0.05) !important;
      }

      .card-header-custom {
        padding: 16px 20px !important;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9) !important;
        border-bottom: 2px solid rgba(0, 0, 0, 0.04) !important;
      }

      .card-header-custom h6 {
        font-size: 1.05rem !important;
        font-weight: 700 !important;
        color: #1e3a5f !important;
      }
    </style>

    <div class="dashboard-hero mb-4">
      <div class="row align-items-center">
        <div class="col-md-8">
          <h1 class="page-title">
            <i class="bi bi-bar-chart-line-fill me-2"></i>Service Analytics
          </h1>
          <p class="hero-sub">
            Track service demand, completion efficiency, and technician output
            trends
          </p>
        </div>
      </div>
    </div>

    <div class="section-label">Key Metrics</div>
    <style>
      /* reduce spacing below section labels on this page */
      .admin-dashboard .section-label {
        margin-bottom: 0.25rem;
      }
    </style>
    <div class="kpi-grid">
      <div class="kpi-enterprise" data-accent="blue" data-aos="fade-up" data-aos-delay="0">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon blue"><i class="bi bi-calendar-check-fill"></i></div>
          <span class="kpi-enterprise-badge blue"><%= analytics ? Math.round((analytics.completedBookings / (analytics.totalBookings || 1)) * 100) : 0 %>% rate</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Total Bookings (60d)</p>
          <div class="kpi-enterprise-value"><span id="kpiTotalBookings"><%= analytics ? analytics.totalBookings.toLocaleString() : "0" %></span></div>
        </div>
        <div class="kpi-enterprise-sparkline"><canvas id="kpiSparkTotalBookings"></canvas></div>
      </div>
      <div class="kpi-enterprise" data-accent="green" data-aos="fade-up" data-aos-delay="50">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon green"><i class="bi bi-check-circle-fill"></i></div>
          <span class="kpi-enterprise-badge green"><%= analytics ? analytics.avgRating : "0.0" %> ★</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Completion Rate</p>
          <div class="kpi-enterprise-value"><span id="kpiCompletionRate"><%= analytics ? Math.round((analytics.completedBookings / (analytics.totalBookings || 1)) * 100) : 0 %>%</span></div>
        </div>
        <div class="kpi-enterprise-sparkline"><canvas id="kpiSparkCompletion"></canvas></div>
      </div>
      <div class="kpi-enterprise" data-accent="amber" data-aos="fade-up" data-aos-delay="100">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon amber"><i class="bi bi-currency-dollar"></i></div>
          <span class="kpi-enterprise-badge amber">₱<%= analytics ? Math.round(analytics.avgBookingValue) : 0 %> avg</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Total Revenue (60d)</p>
          <div class="kpi-enterprise-value"><span id="kpiTotalRevenue">₱<%= analytics ? (analytics.totalRevenue / 1000).toFixed(1) : "0.0" %>K</span></div>
        </div>
        <div class="kpi-enterprise-sparkline"><canvas id="kpiSparkRevenue"></canvas></div>
      </div>
      <div class="kpi-enterprise" data-accent="purple" data-aos="fade-up" data-aos-delay="150">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon purple"><i class="bi bi-graph-up-arrow"></i></div>
          <span class="kpi-enterprise-badge purple"><%= analytics ? analytics.cancelledBookings : 0 %> cancelled</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Pending / Active</p>
          <div class="kpi-enterprise-value"><span id="kpiProjectedBookings"><%= analytics ? analytics.pendingBookings.toLocaleString() : "0" %></span></div>
        </div>
        <div class="kpi-enterprise-sparkline"><canvas id="kpiSparkProjected"></canvas></div>
      </div>
      <div class="kpi-enterprise" data-accent="cyan" data-aos="fade-up" data-aos-delay="200">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon cyan"><i class="bi bi-people-fill"></i></div>
          <span class="kpi-enterprise-badge cyan"><%= analytics && analytics.technicians ? analytics.technicians.length : 0 %> active</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Active Technicians</p>
          <div class="kpi-enterprise-value"><span id="kpiTechCount"><%= analytics && analytics.technicians ? analytics.technicians.length : "0" %></span></div>
        </div>
        <div class="kpi-enterprise-sparkline"><canvas id="kpiSparkTechs"></canvas></div>
      </div>
    </div>

<div class="admin-filter-bar">
  <div class="filter-group">
    <div class="filter-item">
      <i class="bi bi-calendar3"></i>
      <select class="form-select">
        <option>Last 30 Days</option>
        <option>Last 90 Days</option>
        <option>This Year</option>
      </select>
    </div>
    <div class="filter-item">
      <i class="bi bi-tools"></i>
      <select class="form-select">
        <option>All Services</option>
        <option>Cleaning</option>
        <option>Installation</option>
        <option>Repair</option>
      </select>
    </div>
    <div class="filter-item">
      <i class="bi bi-geo-alt"></i>
      <select class="form-select">
        <option>All Areas</option>
        <option>Metro Manila</option>
        <option>North Cluster</option>
        <option>South Cluster</option>
      </select>
    </div>
  </div>
  <div class="filter-actions">
    <button class="btn btn-outline">
      <i class="bi bi-funnel"></i> Apply
    </button>
    <button id="exportReportBtn" class="btn btn-primary">
      <i class="bi bi-download"></i> Export CSV
    </button>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-lg-8" data-aos="fade-up" data-aos-delay="200">
    <div class="dash-card bg-white h-100 mb-0">
      <div class="card-header-custom border-0 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold" style="color: #1e3a5f; font-size: 1.1rem;">Booking Volume Trend</h6>
        <span class="kpi-badge positive"
          style="position: relative; top: 0; right: 0; font-size: 0.75rem; padding: 4px 10px;">+12.5%</span>
      </div>
      <div class="card-body px-4 pb-4">
        <div style="height: 260px">
          <canvas id="serviceBookingTrendChart"></canvas> <!-- click to view details in modal -->
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-4" data-aos="fade-up" data-aos-delay="300">
    <div class="dash-card bg-white h-100" data-aos="fade-up">
      <div class="card-header-custom border-0 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold" style="color: #1e3a5f; font-size: 1.1rem;">Service Mix</h6>
        <span class="kpi-badge neutral"
          style="position: relative; top: 0; right: 0; font-size: 0.75rem; padding: 4px 10px;">stable</span>
      </div>
      <div class="card-body px-4 pb-4 d-flex flex-column justify-content-center">
        <div style="height: 180px">
          <canvas id="serviceMixChart"></canvas> <!-- click to view details in modal -->
        </div>
        <ul class="list-unstyled small mb-0 mt-3 px-2">
          <li class="d-flex justify-content-between py-2 border-bottom"
            style="border-color: rgba(226, 232, 240, 0.4) !important;">
            <span class="text-muted"><i class="bi bi-circle-fill me-2"
                style="color: #06b6d4; font-size: 0.6rem;"></i>Cleaning</span><strong
              style="color: #1e3a5f;">42%</strong>
          </li>
          <li class="d-flex justify-content-between py-2 border-bottom"
            style="border-color: rgba(226, 232, 240, 0.4) !important;">
            <span class="text-muted"><i class="bi bi-circle-fill me-2"
                style="color: #8b5cf6; font-size: 0.6rem;"></i>Repair</span><strong style="color: #1e3a5f;">35%</strong>
          </li>
          <li class="d-flex justify-content-between py-2">
            <span class="text-muted"><i class="bi bi-circle-fill me-2"
                style="color: #db2777; font-size: 0.6rem;"></i>Installation</span><strong
              style="color: #1e3a5f;">23%</strong>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
<!-- chart data modal -->
<div class="modal fade" id="chartDataModal" tabindex="-1" aria-labelledby="chartDataModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="chartDataModalLabel">Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p id="modalDescription" class="text-muted small mb-3"></p>
        <div class="table-responsive">
          <table id="chartDataTable" class="table table-striped table-hover mb-0">
            <thead>
              <tr>
                <th>Item</th>
                <th>Value</th>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-lg-12" data-aos="fade-up" data-aos-delay="200">
    <div class="dash-card bg-white h-100" data-aos="fade-up">
      <div class="card-header-custom border-0 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold" style="color: #1e3a5f; font-size: 1.1rem;">Booking Forecast</h6>
        <span class="kpi-badge positive"
          style="position: relative; top: 0; right: 0; font-size: 0.75rem; padding: 4px 10px;">+9.9%</span>
      </div>
      <div class="card-body px-4 pb-4">
        <div style="height: 260px">
          <canvas id="bookingForecastChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-lg-6" data-aos="fade-up" data-aos-delay="300">
    <div class="dash-card bg-white h-100" data-aos="fade-up">
      <div class="card-header-custom border-0 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold" style="color: #1e3a5f; font-size: 1.1rem;">Technician Utilization</h6>
        <span class="kpi-badge positive"
          style="position: relative; top: 0; right: 0; font-size: 0.75rem; padding: 4px 10px;">+4.5%</span>
      </div>
      <div class="card-body px-4 pb-4">
        <div style="height: 220px">
          <canvas id="techUtilizationChart"></canvas>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-6" data-aos="fade-up" data-aos-delay="400">
    <div class="dash-card bg-white h-100" data-aos="fade-up">
      <div class="card-header-custom border-0 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold" style="color: #1e3a5f; font-size: 1.1rem;">Customer Satisfaction Trend</h6>
        <span class="kpi-badge positive"
          style="position: relative; top: 0; right: 0; font-size: 0.75rem; padding: 4px 10px;">+1.2%</span>
      </div>
      <div class="card-body px-4 pb-4">
        <div style="height: 220px">
          <canvas id="serviceCsatChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- additional breakdown row -->
<div class="row g-3 mb-4">
  <div class="col-lg-6" data-aos="fade-up" data-aos-delay="200">
    <div class="dash-card bg-white h-100" data-aos="fade-up">
      <div class="card-header-custom border-0 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold" style="color: #1e3a5f; font-size: 1.1rem;">Status Distribution</h6>
        <span class="kpi-badge neutral"
          style="position: relative; top: 0; right: 0; font-size: 0.75rem; padding: 4px 10px;">stable</span>
      </div>
      <div class="card-body px-4 pb-4">
        <div style="height: 220px">
          <canvas id="statusChart"></canvas>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-6" data-aos="fade-up" data-aos-delay="300">
    <div class="dash-card bg-white h-100" data-aos="fade-up">
      <div class="card-header-custom border-0 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold" style="color: #1e3a5f; font-size: 1.1rem;">Payment Method Mix</h6>
        <span class="kpi-badge negative"
          style="position: relative; top: 0; right: 0; font-size: 0.75rem; padding: 4px 10px;">-2.1%</span>
      </div>
      <div class="card-body px-4 pb-4">
        <div style="height: 220px">
          <canvas id="paymentMethodChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- AI-Powered Service Insights Section -->
<div class="row g-3 mb-4">
  <div class="col-12" data-aos="fade-up" data-aos-delay="200">
    <div class="dash-card bg-white" style="border-left: 4px solid #8b5cf6;">
      <div class="card-header-custom border-0 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold" style="color: #1e3a5f; font-size: 1.1rem;">
          <i class="bi bi-robot me-2" style="color: #8b5cf6;"></i>AI-Powered Service Intelligence
        </h6>
        <span class="badge bg-purple-subtle border border-purple-subtle" style="color: #8b5cf6;">Schema-Based Analysis</span>
      </div>
      <div class="card-body px-4 pb-4">
        <div class="row g-4">
          <!-- Demand Analysis -->
          <div class="col-lg-3">
            <div class="insight-card p-3 rounded-3 h-100" style="background: linear-gradient(135deg, #ede9fe 0%, #ddd6fe 100%);">
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-graph-up-arrow me-2" style="color: #8b5cf6;"></i>
                <strong class="text-dark">Demand Analysis</strong>
              </div>
              <p class="small text-muted mb-2">
                <strong><%= analytics ? analytics.totalBookings.toLocaleString() : "0" %></strong> total bookings (60d)
              </p>
              <div class="progress mb-2" style="height: 6px;">
                <div class="progress-bar" role="progressbar" data-completion-rate 
                     data-value="<%= analytics ? Math.round((analytics.completedBookings / (analytics.totalBookings || 1)) * 100) : 0 %>"
                     style="background-color: #8b5cf6;"></div>
              </div>
              <small class="text-muted">
                <%= analytics ? Math.round((analytics.completedBookings / (analytics.totalBookings || 1)) * 100) : 0 %>% completion rate
              </small>
            </div>
          </div>
          
          <!-- Resource Utilization -->
          <div class="col-lg-3">
            <div class="insight-card p-3 rounded-3 h-100" style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);">
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-people-fill text-warning me-2"></i>
                <strong class="text-dark">Resource Utilization</strong>
              </div>
              <p class="small text-muted mb-2">
                <strong><%= analytics ? Object.keys(analytics.technicianStats || {}).length : 0 %></strong> of <%= analytics && analytics.technicians ? analytics.technicians.length : 0 %> techs assigned
              </p>
              <div class="progress mb-2" style="height: 6px;">
                <div class="progress-bar bg-warning" role="progressbar" data-resource-utilization
                     data-value="<%= analytics && analytics.technicians ? Math.round((Object.keys(analytics.technicianStats || {}).length / analytics.technicians.length) * 100) : 0 %>"></div>
              </div>
              <small class="text-muted">
                <%= analytics ? analytics.pendingBookings : 0 %> pending bookings
              </small>
            </div>
          </div>
          
          <!-- Customer Satisfaction -->
          <div class="col-lg-3">
            <div class="insight-card p-3 rounded-3 h-100" style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);">
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-star-fill text-primary me-2"></i>
                <strong class="text-dark">Customer Satisfaction</strong>
              </div>
              <p class="small text-muted mb-2">
                Average Rating: <strong><%= analytics ? analytics.avgRating : "0.0" %>/5.0</strong>
              </p>
              <div class="progress mb-2" style="height: 6px;">
                <div class="progress-bar bg-primary" role="progressbar" data-csat-score
                     data-value="<%= analytics ? (analytics.avgRating / 5) * 100 : 0 %>"></div>
              </div>
              <small class="text-muted">
                <%= analytics ? (analytics.avgRating >= 4 ? "Excellent" : analytics.avgRating >= 3 ? "Good" : "Needs Improvement") : "N/A" %>
              </small>
            </div>
          </div>
          
          <!-- Revenue Metrics -->
          <div class="col-lg-3">
            <div class="insight-card p-3 rounded-3 h-100" style="background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);">
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-currency-dollar text-success me-2"></i>
                <strong class="text-dark">Revenue Metrics</strong>
              </div>
              <p class="small text-muted mb-2">
                Total: <strong>₱<%= analytics ? (analytics.totalRevenue / 1000).toFixed(1) : "0.0" %>K</strong> (60d)
              </p>
              <div class="progress mb-2" style="height: 6px;">
                <div class="progress-bar bg-success" role="progressbar" data-revenue-target
                     data-value="<%= analytics ? Math.min((analytics.totalRevenue / 500000) * 100, 100) : 0 %>"></div>
              </div>
              <small class="text-muted">
                ₱<%= analytics ? Math.round(analytics.avgBookingValue) : 0 %> average per booking
              </small>
            </div>
          </div>
        </div>
        
        <!-- Data-Driven Recommendations -->
        <div class="mt-4 p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
          <h6 class="fw-bold mb-3" style="color: #1e3a5f;"><i class="bi bi-magic me-2"></i>AI-Generated Recommendations</h6>
          <div class="row g-3">
            <% if (analytics && analytics.pendingBookings > 10) { %>
              <div class="col-md-6">
                <div class="d-flex align-items-start">
                  <span class="badge me-2 mt-1" style="background-color: #8b5cf6;">1</span>
                  <div>
                    <strong>Address Pending Backlog</strong>
                    <p class="small text-muted mb-0">
                      <%= analytics.pendingBookings %> bookings pending. Consider assigning additional technicians or extending shifts to clear backlog.
                    </p>
                  </div>
                </div>
              </div>
            <% } %>
            
            <% if (analytics && analytics.avgRating < 4) { %>
              <div class="col-md-6">
                <div class="d-flex align-items-start">
                  <span class="badge me-2 mt-1" style="background-color: #8b5cf6;"><%= analytics && analytics.pendingBookings > 10 ? "2" : "1" %></span>
                  <div>
                    <strong>Improve Customer Satisfaction</strong>
                    <p class="small text-muted mb-0">
                      Current rating <%= analytics.avgRating %>/5.0. Review customer feedback and address common complaints to boost ratings.
                    </p>
                  </div>
                </div>
              </div>
            <% } %>
            
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <span class="badge me-2 mt-1" style="background-color: #8b5cf6;">
                  <%= (analytics && analytics.pendingBookings > 10 ? 1 : 0) + (analytics && analytics.avgRating < 4 ? 1 : 0) + 1 %>
                </span>
                <div>
                  <strong>Service Mix Optimization</strong>
                  <p class="small text-muted mb-0">
                    <%= analytics ? analytics.coreServiceBookings : 0 %> core services vs <%= analytics ? analytics.repairBookings : 0 %> repairs. 
                    <%= analytics && analytics.coreServiceBookings > analytics.repairBookings ? "Core services dominate. Consider promoting repair packages." : "Repairs are high. Ensure adequate parts inventory." %>
                  </p>
                </div>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <span class="badge me-2 mt-1" style="background-color: #8b5cf6;">
                  <%= (analytics && analytics.pendingBookings > 10 ? 1 : 0) + (analytics && analytics.avgRating < 4 ? 1 : 0) + 2 %>
                </span>
                <div>
                  <strong>Payment Method Analysis</strong>
                  <p class="small text-muted mb-0">
                    <%= analytics ? analytics.gcashBookings : 0 %> GCash (<%= analytics ? Math.round((analytics.gcashBookings / (analytics.totalBookings || 1)) * 100) : 0 %>%) vs 
                    <%= analytics ? analytics.codBookings : 0 %> COD (<%= analytics ? Math.round((analytics.codBookings / (analytics.totalBookings || 1)) * 100) : 0 %>%). 
                    <%= analytics && analytics.gcashBookings > analytics.codBookings ? "Digital payments preferred." : "Cash handling remains significant." %>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

