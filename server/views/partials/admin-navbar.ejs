          <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.6rem; padding: 2px 5px; min-width: 16px; line-height: 1;">
            0
          </span>
        </button>

        <!-- Notification Dropdown Panel -->
        <div id="notifPanel" class="d-none position-absolute" style="top: calc(100% + 8px); right: 0; width: min(380px, 92vw); max-height: 480px; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 20px 50px rgba(0,0,0,0.15); z-index: 9999; overflow: hidden; transform-origin: top right;">
          <!-- Header -->
          <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom" style="background: #f8fafc;">
            <span class="fw-bold" style="font-size: 0.85rem; color: #1e293b;">Notifications</span>
            <div class="d-flex gap-2">
              <button id="markAllReadBtn" class="btn btn-sm text-primary" style="font-size: 0.75rem; padding: 2px 8px;">Mark all read</button>
              <button id="deleteAllBtn" class="btn btn-sm text-danger" style="font-size: 0.75rem; padding: 2px 8px;">Delete all</button>
            </div>
          </div>
          <!-- Notification List -->
          <div id="notifList" class="overflow-auto" style="max-height: 380px;">
            <div class="text-center py-4 text-muted" style="font-size: 0.85rem;">
              <i class="bi bi-bell-slash" style="font-size: 1.5rem;"></i>
              <div class="mt-1">No notifications</div>
            </div>
          </div>
          <!-- Footer -->
          <div class="text-center border-top py-2" style="background: #f8fafc;">
            <button id="viewAllNotifBtn" class="btn btn-sm text-primary" style="font-size: 0.78rem; font-weight: 600; padding: 0; background: transparent; border: none;">View All</button>
          </div>
        </div>
      </div>

      <!-- Profile Dropdown -->
      <div class="nav-item dropdown profile-dropdown">
        <a
          class="profile-dropdown-toggle d-flex align-items-center text-decoration-none"
