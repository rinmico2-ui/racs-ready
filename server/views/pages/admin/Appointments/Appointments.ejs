          // guard: ensure only cancelled items are rendered even if API misbehaves
          appts = (appts || []).filter((a) => statusLabel(a.status) === "cancelled");
          const tbody = document.getElementById("cancelledAppointmentsBody");
          if (tbody) {
            tbody.innerHTML = "";
            if (!appts.length) {
              tbody.innerHTML =
                '<tr><td colspan="7" class="text-center text-muted py-4">No cancelled appointments found.</td></tr>';
            } else {
              appts.slice(0, 200).forEach((a) => {
                const tr = document.createElement("tr");
                const bookingDate = a.bookingDate || a.date || a.start || new Date();
                const startTimeStr = a.startTime || a.time || "";
                const startMinNum = Number(a.startTime || a.time);
                const endMinRaw = Number(a.endTime);
                const fallbackDur = (Number(a.serviceDurationMinutes) || 0) + Math.max(0, Number(a.travelTime) || 0);
                const endMinNum =
                  Number.isFinite(endMinRaw) && endMinRaw > startMinNum
                    ? endMinRaw
                    : Number.isFinite(startMinNum) && fallbackDur > 0
                    ? startMinNum + fallbackDur
                    : NaN;
                const timeRange =
                  Number.isFinite(startMinNum) && Number.isFinite(endMinNum)
                    ? `${formatTime(startMinNum)} – ${formatTime(endMinNum)}`
                    : formatTime(startMinNum) || startTimeStr;
                const badge = `<span class='badge bg-${statusBadgeClass(a.status)}'>${statusLabel(a.status)}</span>`;
                const paymentBadge = `<span class='badge bg-${a.paymentStatus === "paid" ? "success" : a.paymentStatus === "failed" ? "danger" : "warning"} text-uppercase'>${a.paymentStatus || "pending"}</span>`;
