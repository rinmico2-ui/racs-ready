    .pos-aircon-card { background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 12px; cursor: pointer; transition: all 0.15s; position: relative; overflow: hidden; }
    .pos-aircon-card:hover { border-color: #3b82f6; transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,0.2); }
    .pos-aircon-card.oos { opacity: 0.4; cursor: not-allowed; }
    .pos-aircon-img { width: 100%; height: 80px; object-fit: contain; border-radius: 8px; background: #0f172a; margin-bottom: 8px; }
    .pos-aircon-name { font-size: 0.8rem; font-weight: 700; color: #f1f5f9; line-height: 1.2; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pos-aircon-brand { font-size: 0.7rem; color: #94a3b8; margin-bottom: 4px; }
    .pos-aircon-specs { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 6px; }
    .pos-aircon-badge { font-size: 0.6rem; padding: 1px 5px; border-radius: 4px; font-weight: 600; }
    .pos-aircon-badge.inv { background: #22c55e20; color: #22c55e; }
    .pos-aircon-badge.non { background: #f59e0b20; color: #f59e0b; }
