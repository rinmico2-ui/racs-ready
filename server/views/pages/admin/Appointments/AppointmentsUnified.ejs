<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function() {
  'use strict';

  var PIPELINE_STAGES = [
    { key: 'pending', label: 'Pending Payment', icon: 'bi-hourglass-split', color: '#f59e0b', bg: '#fef3c7' },
    { key: 'awaiting_assignment', label: 'In Queue', icon: 'bi-clipboard-check', color: '#8b5cf6', bg: '#ede9fe' },
    { key: 'assigned', label: 'Assigned', icon: 'bi-person-check', color: '#6366f1', bg: '#e0e7ff' },
    { key: 'confirmed', label: 'Confirmed', icon: 'bi-check2-circle', color: '#10b981', bg: '#d1fae5' },
    { key: 'on-the-way', label: 'On The Way', icon: 'bi-geo-alt', color: '#06b6d4', bg: '#cffafe' },
    { key: 'in-progress', label: 'In Progress', icon: 'bi-tools', color: '#2563eb', bg: '#dbeafe' },
    { key: 'completed', label: 'Completed', icon: 'bi-trophy', color: '#059669', bg: '#d1fae5' },
    { key: 'expired', label: 'Expired', icon: 'bi-clock-history', color: '#d97706', bg: '#fef3c7' },
  ];

  var STATUS_CLASSES = {
    'pending':'st-pending','payment_verified':'st-payment_verified','awaiting_assignment':'st-awaiting_assignment',
    'assigned':'st-assigned','confirmed':'st-confirmed','on-the-way':'st-on-the-way',
    'arrived':'st-arrived','in-progress':'st-in-progress','completed':'st-completed',
    'rejected':'st-rejected','cancelled':'st-cancelled','expired':'st-expired','no-show':'st-no-show',
    'waiting-for-customer':'st-waiting','no-show-reported':'st-no-show'
  };

  var RQ_STATUS_LABELS = {
    repair_requested:'New Request',pending_inspection:'Pending Inspection',
    inspection_scheduled:'Inspection Scheduled',inspection_in_progress:'Inspection In Progress',
    inspection_completed:'Diagnosis Completed',awaiting_approval:'Awaiting Approval',
    repair_approved:'Repair Approved',repair_declined:'Repair Declined',
    waiting_parts:'Waiting Parts',parts_reserved:'Parts Reserved',
    ready_for_repair:'Ready for Repair',repair_scheduled:'Repair Scheduled',
    repair_in_progress:'Repair In Progress',repair_completed:'Repair Completed',closed:'Closed'
  };

  var RQ_STATUS_BADGES = {
    repair_requested:'bg-warning text-dark',pending_inspection:'bg-warning text-dark',
    inspection_scheduled:'bg-info text-dark',inspection_in_progress:'bg-primary',
    inspection_completed:'bg-success',awaiting_approval:'bg-danger',
    repair_approved:'bg-success',repair_declined:'bg-danger',
    waiting_parts:'bg-warning text-dark',ready_for_repair:'bg-success',
    repair_scheduled:'bg-primary',repair_in_progress:'bg-primary',
    repair_completed:'bg-success',closed:'bg-secondary'
  };

  var STATUS_LABELS = {
    'confirmed':'Confirmed','scheduled':'Scheduled','on-the-way':'On The Way',
    'arrived':'Arrived','waiting-for-customer':'Waiting for Customer','no-show-reported':'No-Show Reported',
    'in-progress':'In Progress','no-show':'No Show','pending':'Pending',
    'awaiting_assignment':'Awaiting Assignment','assigned':'Assigned',
    'rejected':'Rejected','cancelled':'Cancelled','expired':'Expired'
  };

  var STATUS_CLASSES_ACTIVE = {
    'confirmed':'job-confirmed','scheduled':'job-confirmed',
    'on-the-way':'job-on-the-way','arrived':'job-arrived','in-progress':'job-in-progress'
  };

  function formatDate(d) {
    return d ? new Date(d).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '\u2014';
  }
  function formatTime(t) {
    if (!t) return '\u2014';
    var raw=String(t).trim();
    if (/^\d{1,2}:\d{2}\s*(AM|PM)$/i.test(raw)) return raw.replace(/\s+/g,' ').toUpperCase();
    var hm=raw.match(/^(\d{1,2}):(\d{2})$/);
    if (hm) {
      var hour=Number(hm[1]), minute=Number(hm[2]);
      if (hour<24&&minute<60) {
        var suffix=hour>=12?'PM':'AM';
        return (hour%12||12)+':'+String(minute).padStart(2,'0')+' '+suffix;
      }
    }
    if (!/^\d{1,4}$/.test(raw)) return raw;
    var mins = Number(raw);
    if (!Number.isFinite(mins)||mins<0||mins>1439) return raw;
    var h = Math.floor(mins/60), m = mins % 60;
    var ampm = h >= 12 ? 'PM' : 'AM';
    return (h % 12 || 12) + ':' + String(m).padStart(2,'0') + ' ' + ampm;
  }
  function statusLabel(s) {
    return (s||'').replace(/_/g,' ').replace(/-/g,' ').replace(/\b\w/g,function(l){return l.toUpperCase();});
  }

  function bookingNeedsResolution(b) {
    if (!b) return false;
    if (b.isReviewOverdue===true||b.autoReschedulePending===true||b.status==='reschedule-required') return true;
    var actionableStatuses=[
      'pending','payment_verified','awaiting_assignment','assigned','pending_reassignment',
      'confirmed','scheduled','re-scheduled','repair_requested','pending_inspection',
      'inspection_scheduled','ready_for_repair','repair_scheduled'
    ];
    if (actionableStatuses.indexOf(b.status)===-1) return false;
    var rawDate=b.preferredDate||b.bookingDate;
    if (!rawDate) return false;
    var cutoff=new Date(rawDate);
    if (Number.isNaN(cutoff.getTime())) return false;
    function toMinutes(value) {
      if (!value) return NaN;
      var match=String(value).trim().match(/^(\d{1,2})(?::(\d{2}))?\s*(AM|PM)?$/i);
      if (!match) return NaN;
      var hours=Number(match[1]);
      var minutes=Number(match[2]||0);
      if (minutes>59||hours>24) return NaN;
      if (match[3]) {
        hours=hours%12;
        if (/pm/i.test(match[3])) hours+=12;
      }
      return hours*60+minutes;
    }
    var endMinutes=toMinutes(b.endTime);
    if (!Number.isFinite(endMinutes)) {
      var startMinutes=toMinutes(b.startTime||b.preferredTime);
      endMinutes=Number.isFinite(startMinutes)?startMinutes+(Number(b.serviceDurationMinutes||b.duration)||60):NaN;
    }
    if (Number.isFinite(endMinutes)) cutoff.setHours(Math.floor(endMinutes/60),endMinutes%60,0,0);
    else cutoff.setHours(23,59,59,999);
    return cutoff.getTime()<Date.now();
  }

  function bookingResolutionUrl(b) {
    var reference=b.bookingReference||b.workOrderNumber||b._id||'Booking';
    var params=new URLSearchParams({
      source:'booking',
      issue:'past_date',
      q:String(reference),
      focus:'booking:'+String(b._id||''),
      open:'resolve'
    });
    return ('/admin/operations/resolution-center?'+params.toString()).replace(/&/g,'&amp;');
  }

  function showNotification(opts) {
    var type=opts.type||'info',title=opts.title||'',message=opts.message||'',duration=opts.duration||3000;
    var colors={
      success:{bg:'#f0fdf4',border:'#22c55e',icon:'bi-check-circle-fill',iconColor:'#16a34a'},
      error:{bg:'#fef2f2',border:'#ef4444',icon:'bi-x-circle-fill',iconColor:'#dc2626'},
      warning:{bg:'#fffbeb',border:'#f59e0b',icon:'bi-exclamation-triangle-fill',iconColor:'#d97706'},
      info:{bg:'#eff6ff',border:'#3b82f6',icon:'bi-info-circle-fill',iconColor:'#2563eb'}
    };
    var c=colors[type]||colors.info;
    var el=document.createElement('div');
    el.style.cssText='position:fixed;top:20px;right:20px;z-index:99999;min-width:340px;max-width:420px;background:'+c.bg+';border:1px solid '+c.border+';border-left:4px solid '+c.border+';border-radius:12px;padding:16px 20px;box-shadow:0 10px 40px rgba(0,0,0,0.15);display:flex;align-items:flex-start;gap:12px;animation:slideInRight 0.3s ease;';
    el.innerHTML='<i class="bi '+c.icon+'" style="font-size:1.3rem;color:'+c.iconColor+';margin-top:2px;"></i><div style="flex:1;"><div style="font-weight:700;font-size:0.9rem;color:#1e293b;margin-bottom:2px;">'+title+'</div><div style="font-size:0.82rem;color:#64748b;">'+message+'</div></div><button onclick="this.parentElement.remove()" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:1.1rem;padding:0;line-height:1;">&times;</button>';
    document.body.appendChild(el);
    if (!document.getElementById('notif-styles')) {
      var style=document.createElement('style');style.id='notif-styles';
      style.textContent='@keyframes slideInRight{from{transform:translateX(100%);opacity:0;}to{transform:translateX(0);opacity:1;}}';
      document.head.appendChild(style);
    }
    setTimeout(function(){el.style.transition='all 0.3s ease';el.style.opacity='0';el.style.transform='translateX(100%)';setTimeout(function(){el.remove();},300);},duration);
  }
  window.showNotification=showNotification;

  function buildDetailHTML(b,data) {
    var date=new Date(b.preferredDate||b.bookingDate).toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'});
    var time=(b.startTime&&b.endTime?formatTime(b.startTime)+' \u2013 '+formatTime(b.endTime):(b.selectedTimeLabel||formatTime(b.preferredTime||b.startTime||'')));
    var isRepair=b.serviceType==='repair'||b.serviceModel==='RepairService';
    var serviceNames=(Array.isArray(b.services)&&b.services.length)
      ? b.services.map(function(s){return s.name||'';})
      : (b.service?[(b.service.name||'')]:[]);
    if (!serviceNames.length) serviceNames=[isRepair?'Repair Service':'N/A'];
    var uniqueNames=serviceNames.filter(function(n,i,a){return n&&a.indexOf(n)===i;});
    var serviceName=uniqueNames.length>1?uniqueNames.join(', '):uniqueNames[0];
    var customer=b.customer||{};
    if ((!customer.name||!customer.email) && b.customerId && typeof b.customerId==='object') {
      customer={
        name:customer.name||((b.customerId.firstName||'')+' '+(b.customerId.lastName||'')).trim(),
        email:customer.email||b.customerId.email||'',
        phone:customer.phone||b.customerId.phone||'',
        address:customer.address||b.customerId.address||''
      };
    }

    var unitType=b.applianceTypeName||b.applianceType||(b.unitInfo&&b.unitInfo.unitType)||'—';
    var unitBrand=b.brand||(b.unitInfo&&b.unitInfo.brand)||'—';
    var unitQty=Number(b.quantity)||(Array.isArray(b.services)?b.services.reduce(function(sum,s){return sum+(Number(s.quantity)||0);},0):0)||1;
    var unitHp=b.hpDescription||(b.hp?b.hp+' HP':'')||(b.unitInfo&&b.unitInfo.hpDescription?b.unitInfo.hpDescription:'')||(b.unitInfo&&b.unitInfo.hp?b.unitInfo.hp+' HP':'')||((Array.isArray(b.services)&&b.services[0]&&b.services[0].hpDescription)?b.services[0].hpDescription:((Array.isArray(b.services)&&b.services[0]&&b.services[0].hp)?b.services[0].hp+' HP':'—'))||'—';
    var stL=statusLabel(b.status);
    var isCOD=b.paymentMethod==='cod';
    var total=b.totalPrice||b.estimatedFee||0;
    var travelFee=Number(b.travelFare)||0;
    var paymentList=Array.isArray(data.payments)?data.payments:[];
    var recordedDownpayment=paymentList.filter(function(p){return p.type==='downpayment'||p.type==='inspection';}).reduce(function(sum,p){return sum+(Number(p.amount)||0);},0);
    var dp=Number(b.downpaymentAmount)||recordedDownpayment||0;
    var bal=isCOD?Math.max(0,total-dp):0;
    var photos=[];
    function addPhoto(p,label){
      if(!p) return;
      p=String(p);
      var already=false;
      photos.forEach(function(x){ if(x.src===p) already=true; });
      if(!already) photos.push({src:p,label:label||''});
    }
    addPhoto(b.paymentProof,'Customer Payment Proof');
    if (data.payment&&data.payment.proofUrl) addPhoto(data.payment.proofUrl,'Payment Proof');
    addPhoto(b.imageUrl,'Booking Image');
    addPhoto(b.repairPaymentProof,'Repair Payment Proof');
    addPhoto(b.proofPhoto,'Proof of Completion');
    if (data.assignment){
      addPhoto(data.assignment.startProofUrl,'Start Work Proof');
      addPhoto(data.assignment.proofPhoto,'Proof of Completion');
      if (data.assignment.damagePhoto) addPhoto(data.assignment.damagePhoto,'Damaged Item Photo');
    }
    if (Array.isArray(data.payments)) data.payments.forEach(function(pm,i){
      if (pm.proofUrl) addPhoto(pm.proofUrl,'Payment Proof ('+(String(pm.method||'').toUpperCase()||('#'+(i+1)))+')');
      if (pm.customerPhotoUrl) addPhoto(pm.customerPhotoUrl,'Customer Confirmation Photo'+(pm.type?' ('+statusLabel(pm.type)+')':''));
      if (pm.remittanceProofUrl) addPhoto(pm.remittanceProofUrl,'Remittance Proof');
    });
    if (b.unitInfo&&Array.isArray(b.unitInfo.photos)) b.unitInfo.photos.forEach(function(p){addPhoto(p,'Unit Photo');});
    if (b.inspection&&Array.isArray(b.inspection.photos)) b.inspection.photos.forEach(function(p){addPhoto(p,'Inspection Photo');});
    if (Array.isArray(b.services)) b.services.forEach(function(s){ if(s&&Array.isArray(s.units)) s.units.forEach(function(u){ if(u&&u.inspection&&Array.isArray(u.inspection.photos)) u.inspection.photos.forEach(function(p){addPhoto(p,'Inspection Photo');}); }); });

    var ref = b.bookingReference||b.workOrderNumber||b._id.toString().slice(-8).toUpperCase();
    var needsResolution=bookingNeedsResolution(b);
