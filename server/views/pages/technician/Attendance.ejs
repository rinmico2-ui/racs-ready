      padding: 1.5rem 1.25rem;
      border-radius: 12px;
      margin-bottom: 1.25rem;
    }
    .td-hero-content { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .td-hero-icon { width: 48px; height: 48px; font-size: 1.3rem; border-radius: 12px; }
    .td-hero-title { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.25rem; }
    .td-hero-sub { font-size: 0.85rem; line-height: 1.5; opacity: 0.85; }
    .td-hero-right { width: 100%; flex-direction: column; align-items: flex-start; }
    .td-hero-clock { padding: 8px 14px; font-size: 0.8rem; }
    .att-status-icon { width: 40px; height: 40px; font-size: 1.1rem; }
    .att-status-title { font-size: 0.9rem; }
    .att-status-sub { font-size: 0.72rem; }
    .att-detail-row { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    .att-detail-value { text-align: left; }
    .att-timer-value { font-size: 1.25rem; }
    .att-scanner-box { max-width: 260px; }
    .att-scanner-controls { flex-direction: column; align-items: center; }
    .att-sm-btn { width: 100%; max-width: 260px; justify-content: center; }
    .att-timeline { padding-left: 1rem; }
    .att-timeline-item::before { left: -16px; width: 8px; height: 8px; }
    .att-history-table { font-size: 0.72rem; }
    .att-history-table th, .att-history-table td { padding: 0.5rem; }
  }

  @media (max-width: 400px) {
    .td-hero { padding: 1.25rem 0.875rem; border-radius: 12px; }
    .td-hero-content { gap: 0.75rem; }
    .td-hero-icon { width: 44px; height: 44px; font-size: 1.1rem; }
    .td-hero-title { font-size: 1.2rem; }
    .td-hero-sub { font-size: 0.78rem; }
    .td-hero-clock { font-size: 0.75rem; padding: 6px 12px; }
    .att-status-icon { width: 38px; height: 38px; font-size: 1rem; }
    .att-status-title { font-size: 0.85rem; }
    .att-status-sub { font-size: 0.7rem; }
    .att-sm-btn { padding: 0.625rem 1rem; font-size: 0.75rem; }
    .att-history-table th, .att-history-table td { padding: 0.5rem 0.35rem; font-size: 0.68rem; }
  }

  /* Mobile: attendance history as labeled cards (like orders) */
  @media (max-width: 767px) {
    .att-history-table { border: 0; }
    .att-history-table thead { display: none; }
    .att-history-table tbody, .att-history-table tr { display: block; }
    .att-history-table tr {
      margin-bottom: 0.75rem;
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: 0.75rem 1rem;
      box-shadow: 0 1px 3px rgba(15,23,42,0.04);
    }
    .att-history-table td {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 0.85rem;
    }
    .att-history-table td:last-child { border-bottom: none; }
    .att-history-table td::before {
      content: attr(data-label);
      font-weight: 600;
      color: #64748b;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .att-history-table td .badge { font-size: 0.7rem; }
  }

</style>

<script>
(function() {
  let html5Qrcode = null;
  let timerInterval = null;
  let checkInTime = null;

  // ── Init ──────────────────────────────────────────────────────────────
  document.getElementById('todayDate').textContent = new Date().toLocaleString('en-PH', { weekday:'short', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', hour12:true });
  document.getElementById('detailDate').textContent = new Date().toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
  document.getElementById('leaveStart').min = new Date().toISOString().split('T')[0];
  document.getElementById('leaveEnd').min = new Date().toISOString().split('T')[0];

  // ── Load Status ───────────────────────────────────────────────────────
  async function loadStatus() {
    try {
      const res = await fetch('/api/technician/attendance/status');
      if (!res.ok) throw new Error();
      const data = await res.json();

      const status = data.attendanceStatus || 'Not Checked In';
      const record = data.record;
      const isCheckedIn = ['Present', 'Late'].includes(status) && record && !record.checkOutTime;
      const isCheckedOut = status === 'Checked Out' || (record && record.checkOutTime);
      const isOnLeave = data.isOnLeave;

      // Update status icon
      const iconEl = document.getElementById('statusIcon');
      iconEl.className = 'att-status-icon';
      if (isOnLeave) {
        iconEl.classList.add('on-leave');
        iconEl.innerHTML = '<i class="bi bi-calendar-x"></i>';
        document.getElementById('statusTitle').textContent = data.leaveType || 'On Leave';
        document.getElementById('statusSub').textContent = 'QR scanning is disabled today';
      } else if (isCheckedIn) {
        iconEl.classList.add(status === 'Late' ? 'late' : 'checked-in');
        iconEl.innerHTML = '<i class="bi bi-check-circle-fill"></i>';
        document.getElementById('statusTitle').textContent = status === 'Late' ? 'Checked In (Late)' : 'Checked In';
        document.getElementById('statusSub').textContent = 'You are on the clock';
      } else if (isCheckedOut) {
        iconEl.classList.add('checked-out');
        iconEl.innerHTML = '<i class="bi bi-patch-check-fill"></i>';
        document.getElementById('statusTitle').textContent = 'Checked Out';
        document.getElementById('statusSub').textContent = 'Your work day has ended';
      } else {
        iconEl.innerHTML = '<i class="bi bi-qr-code"></i>';
        document.getElementById('statusTitle').textContent = 'Scan QR to Check In';
        document.getElementById('statusSub').textContent = 'Point your camera at the admin\'s QR code';
      }

      // Detail card
      document.getElementById('detailStatus').innerHTML = isOnLeave
        ? '<span class="badge bg-purple" style="background:#7c3aed;">On Leave</span>'
        : isCheckedIn
          ? `<span class="badge ${status === 'Late' ? 'bg-warning text-dark' : 'bg-success'}">${status}</span>`
          : isCheckedOut
            ? '<span class="badge bg-indigo" style="background:#4f46e5;">Checked Out</span>'
            : '<span class="badge bg-secondary">Not Checked In</span>';

      document.getElementById('detailCheckIn').textContent = record && record.checkInTime
        ? new Date(record.checkInTime).toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' })
        : '--';

      document.getElementById('detailCheckOut').textContent = record && record.checkOutTime
        ? new Date(record.checkOutTime).toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' })
        : '--';

      // Total hours
      if (record && record.checkInTime && record.checkOutTime) {
        const total = (new Date(record.checkOutTime) - new Date(record.checkInTime)) / 3600000;
        document.getElementById('detailTotalHours').textContent = total.toFixed(1) + ' hours';
        document.getElementById('totalHoursRow').style.display = '';
      } else {
        document.getElementById('totalHoursRow').style.display = 'none';
      }

      // Checkout button
      document.getElementById('checkoutWrap').style.display = isCheckedIn ? '' : 'none';

      // On leave banner or already checked in
      if (isOnLeave) {
        document.getElementById('bannerOnLeave').style.display = '';
        document.getElementById('scannerSection').style.display = 'none';
        document.getElementById('leaveTitle').textContent = data.leaveType || 'On Leave';
      } else if (isCheckedIn || isCheckedOut) {
        document.getElementById('bannerOnLeave').style.display = 'none';
        document.getElementById('scannerSection').style.display = 'none';
      } else {
        document.getElementById('bannerOnLeave').style.display = 'none';
        document.getElementById('scannerSection').style.display = '';
      }

      // Timer
      if (isCheckedIn && record && record.checkInTime) {
        checkInTime = new Date(record.checkInTime);
        startTimer();
        document.getElementById('timerCard').style.display = '';
      } else {
        stopTimer();
        document.getElementById('timerCard').style.display = 'none';
      }

      // Timeline
      renderTimeline(record);
    } catch(e) {
      console.error('Status load error:', e);
    }
  }

  // ── Timer ─────────────────────────────────────────────────────────────
  function startTimer() {
    stopTimer();
    timerInterval = setInterval(() => {
      if (!checkInTime) return;
      const now = new Date();
      const diff = now - checkInTime;
      const hrs = Math.floor(diff / 3600000);
      const mins = Math.floor((diff % 3600000) / 60000);
      const secs = Math.floor((diff % 60000) / 1000);
      document.getElementById('timerValue').textContent =
        String(hrs).padStart(2, '0') + ':' + String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
    }, 1000);
  }

  function stopTimer() {
    if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
  }

  // ── Timeline ──────────────────────────────────────────────────────────
  function renderTimeline(record) {
    const container = document.getElementById('timelineContainer');
    if (!record || (!record.checkInTime && !record.checkOutTime)) {
      container.innerHTML = '<div class="att-empty-timeline"><i class="bi bi-clock"></i><p>No activity recorded yet</p></div>';
      return;
    }

    let items = [];
    if (record.checkInTime) {
      const t = new Date(record.checkInTime);
      items.push(`
        <div class="att-timeline-item check-in">
          <div class="att-timeline-time">${t.toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' })}</div>
          <div class="att-timeline-label"><i class="bi bi-box-arrow-in-right text-success me-1"></i>Check-In</div>
          <div class="att-timeline-detail">${record.method === 'qr_scan' ? 'QR Code' : 'Button'} | ${record.status}</div>
        </div>`);
    }
    if (record.checkOutTime) {
      const t = new Date(record.checkOutTime);
      items.push(`
        <div class="att-timeline-item check-out">
          <div class="att-timeline-time">${t.toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' })}</div>
          <div class="att-timeline-label"><i class="bi bi-box-arrow-right text-indigo me-1"></i>Check-Out</div>
          <div class="att-timeline-detail">Work day ended</div>
        </div>`);
    }

    container.innerHTML = items.length > 0
      ? '<div class="att-timeline">' + items.join('') + '</div>'
      : '<div class="att-empty-timeline"><i class="bi bi-clock"></i><p>No activity recorded yet</p></div>';
  }

  // ── Check Out ─────────────────────────────────────────────────────────
  window.handleCheckOut = async function() {
    if (!confirm('Are you sure you want to check out? Your availability will be set to Offline.')) return;

    const btn = document.getElementById('checkoutBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Checking Out...';

    try {
      const res = await fetch('/api/technician/attendance/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });
      const data = await res.json();

      if (!res.ok && data.code === 'EXPENSE_CONFIRMATION_REQUIRED') {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-box-arrow-right"></i> Check Out';
        const hasCompletedJobs = data.completedJobsToday > 0;
        const choice = await Swal.fire({
          icon: hasCompletedJobs ? 'warning' : 'question',
          title: hasCompletedJobs ? 'Expenses required' : 'Any expenses today?',
          html: `<div style="font-size:.9rem;color:#475569;">You have not logged any expenses today.${data.completedJobsToday ? `<br><strong>You completed ${data.completedJobsToday} booking${data.completedJobsToday === 1 ? '' : 's'}.</strong>` : ''}</div>`,
          showCancelButton: true,
          showDenyButton: !hasCompletedJobs,
          confirmButtonText: '<i class="bi bi-receipt me-1"></i> Log Expenses',
          denyButtonText: 'No Expenses Today',
          cancelButtonText: 'Cancel',
          confirmButtonColor: '#2563eb',
          denyButtonColor: '#059669'
        });
        if (choice.isConfirmed) window.location.href = '/technician/expenses?new=1';
        if (choice.isDenied) {
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Checking Out...';
          const confirmedRes = await fetch('/api/technician/attendance/checkout', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ noExpensesToday:true }) });
          const confirmedData = await confirmedRes.json();
          if (!confirmedRes.ok) { showToast(confirmedData.error || 'Check-out failed', 'danger'); btn.disabled=false; btn.innerHTML='<i class="bi bi-box-arrow-right"></i> Check Out'; return; }
          showToast('No expenses recorded. Checked out successfully!', 'success'); stopTimer(); checkInTime=null; loadStatus();
        }
        return;
      }

      if (!res.ok) {
        showToast(data.error || 'Check-out failed', 'danger');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-box-arrow-right"></i> Check Out';
        return;
      }

      const hours = data.hoursWorked ? ` (${data.hoursWorked}h)` : '';
      showToast('Checked out successfully!' + hours, 'success');
      stopTimer();
      checkInTime = null;
      loadStatus();
    } catch(e) {
      showToast('Network error', 'danger');
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-box-arrow-right"></i> Check Out';
    }
  };

  // ── QR Scanner ────────────────────────────────────────────────────────
  window.startScanner = function() {
    document.getElementById('scannerPlaceholder').style.display = 'none';
    document.getElementById('reader').style.display = 'block';
    document.getElementById('btnStartScanner').style.display = 'none';
    document.getElementById('btnStopScanner').style.display = 'inline-flex';
    document.getElementById('scanStatusBadge').textContent = 'Scanning...';
    document.getElementById('scanStatusBadge').className = 'badge bg-warning text-dark';

    html5Qrcode = new Html5Qrcode('reader');
    html5Qrcode.start(
      { facingMode: 'environment' },
      { fps: 10, qrbox: { width: 250, height: 250 } },
      (decodedText) => {
        try {
          const payload = JSON.parse(decodedText);
          processQRScan(payload.token || decodedText);
        } catch(e) {
          processQRScan(decodedText);
        }
      },
      () => {}
    ).catch(err => {
      showToast('Camera access denied', 'warning');
      stopScanner();
    });
  };

  window.stopScanner = function() {
    if (html5Qrcode) {
      html5Qrcode.stop().then(() => { html5Qrcode.clear(); html5Qrcode = null; }).catch(() => {});
    }
    document.getElementById('scannerPlaceholder').style.display = 'flex';
    document.getElementById('reader').style.display = 'none';
    document.getElementById('btnStartScanner').style.display = 'inline-flex';
    document.getElementById('btnStopScanner').style.display = 'none';
    document.getElementById('scanStatusBadge').textContent = 'Ready';
    document.getElementById('scanStatusBadge').className = 'badge bg-success';
  };

  async function processQRScan(token) {
    stopScanner();
    document.getElementById('scanStatusBadge').textContent = 'Verifying...';
    document.getElementById('scanStatusBadge').className = 'badge bg-info';

    try {
      const res = await fetch('/api/technician/attendance/scan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Scan failed');
      showToast('Check-in verified! Status: ' + (data.attendanceStatus || 'Present'), 'success');
      loadStatus();
    } catch(e) {
      showToast(e.message, 'danger');
      document.getElementById('scanStatusBadge').textContent = 'Ready';
      document.getElementById('scanStatusBadge').className = 'badge bg-success';
    }
  }

  // ── Load History ──────────────────────────────────────────────────────
  async function loadHistory() {
    try {
      const res = await fetch('/api/technician/attendance/history');
      if (!res.ok) throw new Error();
      const data = await res.json();
      const container = document.getElementById('historyContainer');
      document.getElementById('historyCount').textContent = data.count + ' records';

      if (!data.records || data.records.length === 0) {
        container.innerHTML = '<div class="text-center py-4 text-muted">No attendance records found.</div>';
        return;
      }

      container.innerHTML = `<div class="table-responsive"><table class="att-history-table">
        <thead><tr><th>Date</th><th>Check-In</th><th>Check-Out</th><th>Hours</th><th>Status</th></tr></thead>
        <tbody>${data.records.map(r => {
          const date = new Date(r.date).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' });
          const cin = r.checkInTime ? new Date(r.checkInTime).toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' }) : '--';
          const cout = r.checkOutTime ? new Date(r.checkOutTime).toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' }) : '--';
          let hours = '--';
          if (r.checkInTime && r.checkOutTime) {
            hours = ((new Date(r.checkOutTime) - new Date(r.checkInTime)) / 3600000).toFixed(1) + 'h';
          }
          const badgeClass = r.status === 'Present' ? 'bg-success' : r.status === 'Late' ? 'bg-warning text-dark' : 'bg-secondary';
          return `<tr>
            <td data-label="Date"><strong>${date}</strong></td>
            <td data-label="In">${cin}</td>
            <td data-label="Out">${cout}</td>
            <td data-label="Hours"><span class="fw-semibold">${hours}</span></td>
            <td data-label="Status"><span class="badge ${badgeClass}">${r.status}</span></td>
          </tr>`;
        }).join('')}</tbody>
      </table></div>`;
    } catch(e) {
      document.getElementById('historyContainer').innerHTML = '<div class="text-center text-danger py-4">Failed to load history</div>';
    }
  }

  // ── Load Leave Requests ───────────────────────────────────────────────
  async function loadLeaves() {
    try {
      const res = await fetch('/api/technician/leave-requests');
      if (!res.ok) throw new Error();
      const data = await res.json();
      const container = document.getElementById('leaveContainer');

      if (!data.items || data.items.length === 0) {
        container.innerHTML = '<p class="text-muted text-center small mb-0">No leave requests yet.</p>';
        return;
      }

      container.innerHTML = data.items.slice(0, 5).map(l => {
        const s = new Date(l.startDate).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' });
        const e = new Date(l.endDate).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' });
        const range = s === e ? s : s + ' – ' + e;
        const badge = l.status === 'approved' ? 'bg-success' : l.status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark';
        return `<div class="d-flex justify-content-between align-items-center py-2 border-bottom">
          <div>
            <div class="fw-semibold small">${range}</div>
            ${l.reason ? '<div class="text-muted" style="font-size:0.78rem;">' + l.reason + '</div>' : ''}
          </div>
          <span class="badge ${badge}">${l.status}</span>
        </div>`;
      }).join('');
    } catch(e) {
      document.getElementById('leaveContainer').innerHTML = '<p class="text-danger small text-center">Failed to load</p>';
    }
  }

  // ── Leave Modal ───────────────────────────────────────────────────────
  window.openLeaveModal = function() {
    document.getElementById('leaveForm').reset();
    new bootstrap.Modal(document.getElementById('leaveModal')).show();
  };

  window.submitLeave = async function(e) {
    e.preventDefault();
    const start = document.getElementById('leaveStart').value;
    const end = document.getElementById('leaveEnd').value || start;
    const reason = document.getElementById('leaveReason').value;

    try {
      const res = await fetch('/api/technician/leave-requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ startDate: start, endDate: end, reason })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed');
      bootstrap.Modal.getInstance(document.getElementById('leaveModal')).hide();
      showToast('Leave request submitted!', 'success');
      loadLeaves();
    } catch(e) {
      showToast(e.message, 'danger');
    }
  };

  // ── Toast ─────────────────────────────────────────────────────────────
  function showToast(msg, type) {
    var container = document.getElementById('globalToastContainer');
    if (!container) return;
    var id = 'toast_' + Date.now();
    var bgClass = type === 'success' ? 'bg-success' : type === 'danger' ? 'bg-danger' : 'bg-primary';
    var html = '<div id="' + id + '" class="toast align-items-center text-white ' + bgClass + ' border-0 show" role="alert">' +
      '<div class="d-flex"><div class="toast-body">' + msg + '</div>' +
      '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>';
    container.insertAdjacentHTML('beforeend', html);
    setTimeout(function() { var el = document.getElementById(id); if (el) el.remove(); }, 4000);
  }

  // ── Init Load ─────────────────────────────────────────────────────────
  loadStatus();
  loadHistory();
  loadLeaves();

  // Refresh status every 30s
  setInterval(loadStatus, 30000);
})();
</script>
