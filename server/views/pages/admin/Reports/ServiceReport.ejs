        </div>
        <div class="dash-card-body">
          <div class="chart-container" style="height:240px;"><canvas id="statusBreakdownChart"></canvas></div>
        </div>
      </div>
    </div>
    <div class="col-lg-8">
      <div class="dash-card h-100" data-aos="fade-up">
        <div class="dash-card-header">
          <h6><i class="bi bi-activity me-1" style="color:#0891b2;"></i>Recent Booking Activity</h6>
          <span class="kpi-enterprise-badge cyan">Last <%= analytics && analytics.recentBookings ? analytics.recentBookings.length : 0 %></span>
        </div>
        <div class="dash-card-body">
          <% if (analytics && analytics.recentBookings && analytics.recentBookings.length > 0) { %>
            <div class="table-responsive" style="max-height:280px;overflow-y:auto;">
              <table class="table-dash">
                <thead>
                  <tr>
                    <th>Reference</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Technician</th>
                    <th style="text-align:right;">Amount</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% analytics.recentBookings.forEach(function(booking) { %>
                    <tr>
                      <td style="font-family:monospace;font-size:0.75rem;color:#64748b;"><%= booking.reference || 'N/A' %></td>
                      <td style="font-weight:600;"><%= booking.customer %></td>
                      <td><span class="badge-status neutral"><%= booking.service %></span></td>
                      <td style="color:#64748b;"><%= booking.technician %></td>
                      <td style="text-align:right;font-weight:700;">?<%= booking.amount ? booking.amount.toLocaleString() : 0 %></td>
                      <td>
                        <span class="badge-status <%= ({completed:'success',pending:'warning',pending_review:'warning',confirmed:'info',scheduled:'purple','in-progress':'purple',cancelled:'danger','on-the-way':'cyan'})[booking.status] || 'neutral' %>"><%= booking.status %></span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="dash-empty"><i class="bi bi-inbox" style="font-size:1.5rem;display:block;margin-bottom:8px;"></i>No recent booking activity</div>
          <% } %>
        </div>
      </div>
