<div class="admin-dashboard container-fluid py-4 settings-system-page">
  <%- include('../../../partials/dashboard-styles') %>

  <style>
    /* ═══════════════════════════════════════════
       SYSTEM SETTINGS — Premium Light-Blue Theme
       ═══════════════════════════════════════════ */
    .settings-system-page {
      --ss-primary: #0ea5e9;
      --ss-primary-dark: #0284c7;
      --ss-primary-deeper: #0369a1;
      --ss-accent: #38bdf8;
      --ss-light: #e0f2fe;
      --ss-pale: #f0f9ff;
      --ss-text: #0c4a6e;
      --ss-muted: #94a3b8;
      --ss-border: #e2e8f0;
      --ss-radius: 16px;
      --ss-shadow: 0 4px 6px -1px rgba(14,165,233,0.07), 0 2px 4px -2px rgba(14,165,233,0.04);
      --ss-shadow-hover: 0 10px 25px -5px rgba(14,165,233,0.12), 0 4px 6px -4px rgba(14,165,233,0.06);
    }

    /* hero text tweaks */
    .settings-system-page .dashboard-hero .hero-sub { color: var(--ss-muted); }

    /* ── Cards ── */
    .settings-system-page .ss-card {
      background: var(--ss-pale);
      border: 1px solid var(--ss-border);
      border-radius: var(--ss-radius);
      box-shadow: var(--ss-shadow);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      margin-bottom: 1.25rem;
      overflow: hidden;
    }
    .settings-system-page .ss-card:hover {
      transform: translateY(-2px); box-shadow: var(--ss-shadow-hover);
    }
    .settings-system-page .ss-card-head {
      display: flex; align-items: center; gap: 0.55rem;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid #e2e8f0;
      background: #fff;
    }
    .settings-system-page .ss-card-head .ch-icon {
      width: 32px; height: 32px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.9rem; color: #fff; flex-shrink: 0;
    }
    .settings-system-page .ch-icon.sky { background: linear-gradient(135deg, var(--ss-primary), var(--ss-accent)); box-shadow: 0 3px 10px rgba(14,165,233,0.25); }
    .settings-system-page .ch-icon.emerald { background: linear-gradient(135deg, #059669, #10b981); box-shadow: 0 3px 10px rgba(5,150,105,0.25); }
    .settings-system-page .ch-icon.purple { background: linear-gradient(135deg, #7c3aed, #a78bfa); box-shadow: 0 3px 10px rgba(124,58,237,0.25); }
    .settings-system-page .ch-icon.amber { background: linear-gradient(135deg, #d97706, #f59e0b); box-shadow: 0 3px 10px rgba(217,119,6,0.25); }
    .settings-system-page .ch-icon.rose { background: linear-gradient(135deg, #e11d48, #fb7185); box-shadow: 0 3px 10px rgba(225,29,72,0.25); }
    .settings-system-page .ss-card-head h3 {
      font-size: 0.92rem; font-weight: 700 !important;
      color: var(--ss-text); margin: 0; font-family: 'Outfit', sans-serif;
    }
    .settings-system-page .ss-card-body {
      padding: 1.25rem; background: #fff;
    }

    /* ── Form Styling ── */
    .settings-system-page .form-label {
      font-size: 0.72rem; font-weight: 600 !important;
      text-transform: uppercase; letter-spacing: 0.05em;
      color: var(--ss-muted); margin-bottom: 0.3rem;
    }
    .settings-system-page .form-control,
    .settings-system-page .form-select {
      border: 1.5px solid var(--ss-border);
      border-radius: 10px; font-size: 0.875rem;
      padding: 0.55rem 0.85rem; color: var(--ss-text);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .settings-system-page .form-control:focus,
    .settings-system-page .form-select:focus {
      border-color: var(--ss-primary);
      box-shadow: 0 0 0 3px rgba(14,165,233,0.12);
    }
    .settings-system-page textarea.form-control { resize: vertical; }

    /* ── Toggle Items ── */
    .settings-system-page .toggle-item {
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; padding: 0.75rem 0;
      border-bottom: 1px solid #f1f5f9;
    }
    .settings-system-page .toggle-item:last-child { border-bottom: none; }
    .settings-system-page .toggle-item .ti-icon {
      width: 36px; height: 36px; border-radius: 9px;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.9rem; flex-shrink: 0;
      background: var(--ss-light); color: var(--ss-primary);
    }
    .settings-system-page .toggle-item h6 {
      font-size: 0.85rem; font-weight: 600 !important;
      color: var(--ss-text); margin: 0 0 0.1rem;
    }
    .settings-system-page .toggle-item p {
      font-size: 0.75rem; color: var(--ss-muted); margin: 0;
    }
    .settings-system-page .form-switch .form-check-input {
      width: 2.5rem; height: 1.3rem; cursor: pointer;
    }
    .settings-system-page .form-switch .form-check-input:checked {
      background-color: var(--ss-primary);
      border-color: var(--ss-primary);
    }

    /* ── Status Row ── */
    .settings-system-page .status-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.6rem 0; border-bottom: 1px solid #f1f5f9;
    }
    .settings-system-page .status-row:last-child { border-bottom: none; }
    .settings-system-page .status-row .sr-label {
      font-size: 0.78rem; font-weight: 600 !important;
      color: var(--ss-muted); display: flex; align-items: center; gap: 0.4rem;
    }
    .settings-system-page .status-row .sr-label i { font-size: 0.85rem; color: var(--ss-primary); }
    .settings-system-page .status-row .sr-value {
      font-size: 0.82rem; font-weight: 600 !important; color: var(--ss-text);
    }
    .settings-system-page .online-badge {
      background: rgba(16,185,129,0.12); color: #059669;
      font-weight: 700 !important; font-size: 0.72rem;
      padding: 0.2rem 0.65rem; border-radius: 999px;
      display: inline-flex; align-items: center; gap: 0.3rem;
    }
    .settings-system-page .online-badge::before {
      content: ''; width: 6px; height: 6px; border-radius: 50%;
      background: #10b981; display: inline-block;
    }
    .settings-system-page .online-badge.offline { background: rgba(225,29,72,0.1); color:#be123c; }
    .settings-system-page .online-badge.offline::before { background:#e11d48; }
    .settings-system-page .form-check-input:disabled { opacity: 0.75; cursor: not-allowed; }

    /* ── Buttons ── */
    .settings-system-page .btn-ss {
      padding: 0.55rem 1.1rem; border-radius: 10px;
      font-weight: 600 !important; font-size: 0.82rem;
      display: inline-flex; align-items: center; gap: 0.4rem;
      transition: all 0.25s ease; border: none; cursor: pointer;
      text-decoration: none;
    }
    .settings-system-page .btn-ss.primary {
      background: linear-gradient(135deg, var(--ss-primary), var(--ss-accent));
      color: #fff; box-shadow: 0 4px 14px rgba(14,165,233,0.3);
    }
    .settings-system-page .btn-ss.primary:hover {
      transform: translateY(-1px); box-shadow: 0 6px 20px rgba(14,165,233,0.35);
      color: #fff;
    }
    .settings-system-page .btn-ss.outline {
      background: #fff; color: var(--ss-text);
      border: 1.5px solid var(--ss-border);
    }
    .settings-system-page .btn-ss.outline:hover {
      border-color: var(--ss-primary); color: var(--ss-primary);
      background: var(--ss-pale); transform: translateY(-1px);
    }
    .settings-system-page .btn-ss.danger {
      background: linear-gradient(135deg, #e11d48, #fb7185);
      color: #fff; box-shadow: 0 4px 14px rgba(225,29,72,0.25);
    }
    .settings-system-page .btn-ss.danger:hover {
      transform: translateY(-1px); box-shadow: 0 6px 20px rgba(225,29,72,0.35);
      color: #fff;
    }

    /* ── Danger Zone ── */
    .settings-system-page .danger-zone {
      border: 1.5px solid #fecdd3 !important;
      background: #fff5f5 !important;
    }
    .settings-system-page .danger-zone .ss-card-head {
      background: #fff1f2;
      border-bottom-color: #fecdd3;
    }
    .settings-system-page .danger-zone .ss-card-body {
      background: #fff5f5;
    }

    @media (max-width: 768px) {
      .settings-system-page .ss-hero { padding: 1.25rem; }
      .settings-system-page .ss-hero h1 { font-size: 1.15rem; }
    }
  </style>

  <!-- ═══ HERO ═══ -->
  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-gear-fill"></i></div>
        <div>
          <h1>System Settings</h1>
          <p>Manage global configuration, security, feature flags, and maintenance mode.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <!-- ═══ LEFT COLUMN ═══ -->
    <div class="col-lg-8">

      <!-- Business Profile -->
      <div class="ss-card">
        <div class="ss-card-head">
          <div class="ch-icon sky"><i class="bi bi-building"></i></div>
          <h3>Business Profile</h3>
        </div>
        <div class="ss-card-body">
          <div id="bpAlert" class="alert d-none" role="alert"></div>
          <form id="businessProfileForm">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Business Name</label>
                <input type="text" class="form-control" name="businessName" id="bpName" maxlength="100" placeholder="CALIDRO RACS">
              </div>
              <div class="col-md-6">
                <label class="form-label">Contact Email</label>
                <input type="email" class="form-control" name="email" id="bpEmail" maxlength="100" placeholder="calidroracs@gmail.com">
              </div>
              <div class="col-md-6">
                <label class="form-label">Support Phone</label>
                <input type="text" class="form-control" name="phone" id="bpPhone" maxlength="30" placeholder="0965 605 6495">
              </div>
              <div class="col-md-6">
                <label class="form-label">Tagline</label>
                <input type="text" class="form-control" name="tagline" id="bpTagline" maxlength="300" placeholder="Premium air conditioning & appliance care...">
              </div>
              <div class="col-md-6">
                <label class="form-label" for="bpFoundedYear">Founded Year</label>
                <input type="number" class="form-control" name="foundedYear" id="bpFoundedYear" min="1900" max="<%= new Date().getFullYear() %>" step="1" placeholder="e.g. 2016">
                <div class="form-text">Used to calculate the public Years Experience statistic.</div>
              </div>
              <div class="col-md-6">
                <label class="form-label">Business Address</label>
                <textarea class="form-control" name="address" id="bpAddress" rows="2" maxlength="500" placeholder="San Leonardo, Nueva Ecija"></textarea>
              </div>
              <div class="col-12 text-end mt-3">
                <button type="button" class="btn-ss primary" id="bpSaveBtn"><i class="bi bi-floppy"></i> Save Changes</button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Payment Policy -->
      <div class="ss-card">
        <div class="ss-card-head">
          <div class="ch-icon amber"><i class="bi bi-percent"></i></div>
          <h3>Payment Policy</h3>
        </div>
        <div class="ss-card-body">
          <div id="paymentPolicyAlert" class="alert d-none" role="alert"></div>
          <form id="paymentPolicyForm">
            <div class="row g-3 align-items-end">
              <div class="col-md-7">
                <label class="form-label" for="downpaymentPercentage">Required Downpayment</label>
                <div class="input-group">
                  <input type="number" class="form-control" id="downpaymentPercentage" min="1" max="100" step="0.01" value="10" required>
                  <span class="input-group-text">%</span>
                </div>
                <div class="form-text">Applied to the total cost of new product orders and customer service bookings. Existing records keep their original rate.</div>
              </div>
              <div class="col-md-5 text-md-end">
                <button type="submit" class="btn-ss primary" id="paymentPolicySaveBtn"><i class="bi bi-floppy"></i> Save Payment Policy</button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- No-Show Policy -->
      <div class="ss-card">
        <div class="ss-card-head">
          <div class="ch-icon amber"><i class="bi bi-person-exclamation"></i></div>
          <h3>No-Show Policy</h3>
        </div>
        <div class="ss-card-body">
          <div id="noShowPolicyAlert" class="alert d-none" role="alert"></div>
          <form id="noShowPolicyForm">
            <div class="row g-3 mb-3">
              <div class="col-md-4">
                <label class="form-label" for="noShowWaitMinutes">Customer Waiting Period</label>
                <div class="input-group">
                  <input type="number" class="form-control" id="noShowWaitMinutes" min="1" max="120" step="1" value="15" required>
                  <span class="input-group-text">min</span>
                </div>
                <div class="form-text">How long the technician waits after arriving before they can report a no-show.</div>
              </div>
              <div class="col-md-8">
                <label class="form-label">No-Show Fee Policy</label>
                <div class="d-flex flex-column gap-2">
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="noShowFeeMode" id="noShowModeNone" value="none">
                    <label class="form-check-label" for="noShowModeNone">No charge to the customer</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="noShowFeeMode" id="noShowModeTravel" value="travel_fee">
                    <label class="form-check-label" for="noShowModeTravel">Charge the travel fee (<span id="noShowTravelFeeHint">booking travel fare</span>)</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="noShowFeeMode" id="noShowModeFixed" value="fixed_fee">
                    <label class="form-check-label" for="noShowModeFixed">Charge a fixed fee</label>
                    <div class="input-group input-group-sm mt-1" style="max-width:220px;">
                      <span class="input-group-text">&#8369;</span>
                      <input type="number" class="form-control" id="noShowFixedFee" min="0" step="0.01" value="150" placeholder="Amount">
                    </div>
                  </div>
                </div>
                <div class="form-text">Applied when an admin confirms a customer no-show. The fee is added to the booking's total.</div>
              </div>
            </div>
            <div class="d-flex justify-content-end">
              <button type="submit" class="btn-ss primary" id="noShowPolicySaveBtn"><i class="bi bi-floppy"></i> Save No-Show Policy</button>
            </div>
          </form>
        </div>
      </div>
      <div class="ss-card">
        <div class="ss-card-head">
          <div class="ch-icon purple"><i class="bi bi-sliders"></i></div>
          <h3>App Configuration</h3>
        </div>
        <div class="ss-card-body">
          <div id="appConfigAlert" class="alert d-none" role="alert"></div>

          <div class="toggle-item">
            <div class="d-flex align-items-center gap-3">
              <div class="ti-icon"><i class="bi bi-person-plus-fill"></i></div>
              <div>
                <h6>Allow Customer Registrations</h6>
                <p>Enable or disable new users signing up from the portal.</p>
              </div>
            </div>
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="cfgAllowRegistrations">
            </div>
          </div>

          <div class="toggle-item">
            <div class="d-flex align-items-center gap-3">
              <div class="ti-icon"><i class="bi bi-envelope-check-fill"></i></div>
              <div>
                <h6>Require Email Verification</h6>
                <p>Require new customers to verify a one-time email code before their account is activated.</p>
              </div>
            </div>
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="cfgRequireVerification">
            </div>
          </div>

          <div class="toggle-item">
            <div class="d-flex align-items-center gap-3">
              <div class="ti-icon"><i class="bi bi-shield-lock-fill"></i></div>
              <div>
                <h6>Staff Email OTP</h6>
                <p>Admins and secretaries must complete an email OTP challenge at every sign-in.</p>
              </div>
            </div>
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="secStaffOtp" checked disabled>
            </div>
          </div>

          <div class="toggle-item">
            <div class="d-flex align-items-center gap-3">
              <div class="ti-icon"><i class="bi bi-bell-fill"></i></div>
              <div>
                <h6>Real-Time In-App Notifications</h6>
                <p>Socket-based alerts are delivered to signed-in users and role inboxes.</p>
              </div>
            </div>
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="secRealtimeNotifications" checked disabled>
            </div>
          </div>

          <div class="toggle-item">
            <div class="d-flex align-items-center gap-3">
              <div class="ti-icon"><i class="bi bi-clock-history"></i></div>
              <div>
                <h6>Sliding Session Expiration</h6>
                <p>Standard sessions expire after 30 minutes and are renewed only during authenticated activity.</p>
              </div>
            </div>
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="secSessionExpiration" checked disabled>
            </div>
          </div>
          <div class="text-end mt-3">
            <button type="button" class="btn-ss primary" id="appConfigSaveBtn"><i class="bi bi-floppy"></i> Save App Configuration</button>
          </div>

        </div>
      </div>

      <!-- Security & Access -->
      <div class="ss-card">
        <div class="ss-card-head">
          <div class="ch-icon emerald"><i class="bi bi-lock-fill"></i></div>
          <h3>Security &amp; Access Control</h3>
        </div>
        <div class="ss-card-body">
          <div class="alert alert-info py-2 small"><i class="bi bi-shield-check me-1"></i>These safeguards reflect active backend enforcement and cannot be weakened from the dashboard.</div>

          <div class="toggle-item">
            <div class="d-flex align-items-center gap-3">
              <div class="ti-icon"><i class="bi bi-braces-asterisk"></i></div>
              <div>
                <h6>Registration Password Policy</h6>
                <p>New customer passwords receive server-side complexity and bounded-length validation.</p>
              </div>
            </div>
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="secStrongPasswords" checked disabled>
            </div>
          </div>

          <div class="toggle-item">
            <div class="d-flex align-items-center gap-3">
              <div class="ti-icon"><i class="bi bi-ban"></i></div>
              <div>
                <h6>Rate Limit Login Attempts</h6>
                <p>Progressive lockouts increase from 3 to 30 minutes after repeated failures.</p>
              </div>
            </div>
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="secLoginThrottle" checked disabled>
            </div>
          </div>

          <div class="toggle-item">
            <div class="d-flex align-items-center gap-3">
              <div class="ti-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
              <div>
                <h6>Audit Logging</h6>
                <p>Record critical administrative, financial, settings, and security actions for review.</p>
              </div>
            </div>
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="secAuditTrail" checked disabled>
            </div>
          </div>

          <div class="toggle-item">
            <div class="d-flex align-items-center gap-3">
              <div class="ti-icon"><i class="bi bi-globe"></i></div>
              <div>
                <h6>Trusted-Origin Protection</h6>
                <p>Reject state-changing browser requests that do not originate from this application.</p>
              </div>
            </div>
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="secTrustedOrigin" checked disabled>
            </div>
          </div>

        </div>
      </div>

      <!-- Notification Preferences -->
      <div class="ss-card">
        <div class="ss-card-head">
          <div class="ch-icon amber"><i class="bi bi-megaphone-fill"></i></div>
          <h3>Notification Preferences</h3>
        </div>
        <div class="ss-card-body">
          <div id="notificationAlert" class="alert d-none" role="alert"></div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="notificationEmail">Admin Alert Email</label>
              <input type="email" class="form-control" id="notificationEmail" maxlength="254" placeholder="alerts@example.com">
            </div>
            <div class="col-md-6">
              <label class="form-label d-block">Critical Email Alerts</label>
              <div class="form-check form-switch pt-2">
                <input class="form-check-input" type="checkbox" role="switch" id="notificationEmailEnabled">
                <label class="form-check-label" for="notificationEmailEnabled">Email high-priority admin notifications</label>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="notificationPriority">Minimum Email Priority</label>
              <select class="form-select" id="notificationPriority">
                <option value="urgent">Urgent only</option>
                <option value="high">High and urgent</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Active Channels</label>
              <input type="text" class="form-control" value="In-app real time + configured email" readonly>
            </div>
            <div class="col-12 d-flex justify-content-end gap-2 mt-3">
              <button type="button" class="btn-ss outline" id="notificationTestBtn"><i class="bi bi-send-check"></i> Send Test Alert</button>
              <button type="button" class="btn-ss primary" id="notificationSaveBtn"><i class="bi bi-floppy"></i> Save Notifications</button>
            </div>
            <div class="col-12"><div class="form-text">The system always stores in-app notifications. Email delivery uses the configured local SMTP or production Brevo provider.</div></div>
          </div>
        </div>
      </div>

    </div>

    <!-- ═══ RIGHT COLUMN ═══ -->
    <div class="col-lg-4">

      <!-- System Health -->
      <div class="ss-card">
        <div class="ss-card-head">
          <div class="ch-icon emerald"><i class="bi bi-heart-pulse-fill"></i></div>
          <h3>System Health</h3>
        </div>
        <div class="ss-card-body">
          <div class="status-row">
            <span class="sr-label"><i class="bi bi-database-fill"></i> Database</span>
            <span class="online-badge" id="healthDatabase">Checking</span>
          </div>
          <div class="status-row">
            <span class="sr-label"><i class="bi bi-speedometer2"></i> Database Latency</span>
            <span class="sr-value" id="healthDbLatency">—</span>
          </div>
          <div class="status-row">
            <span class="sr-label"><i class="bi bi-memory"></i> Process Memory</span>
            <span class="sr-value" id="healthMemory">—</span>
          </div>
          <div class="status-row">
            <span class="sr-label"><i class="bi bi-cpu-fill"></i> Server Load</span>
            <span class="sr-value" id="healthLoad">—</span>
          </div>
          <div class="status-row">
            <span class="sr-label"><i class="bi bi-file-earmark-text"></i> Application Logs</span>
            <span class="sr-value" id="healthLogs">—</span>
          </div>
          <div class="status-row">
            <span class="sr-label"><i class="bi bi-arrow-repeat"></i> Uptime</span>
            <span class="sr-value" id="healthUptime">—</span>
          </div>
          <div class="mt-3 d-flex gap-2">
            <a class="btn-ss outline flex-fill justify-content-center" id="healthLogsBtn" href="/api/admin/settings/system-logs"><i class="bi bi-cloud-download"></i> Export Logs</a>
            <button type="button" class="btn-ss outline flex-fill justify-content-center" id="healthRefreshBtn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
          </div>
        </div>
      </div>

      <!-- Quick Info -->
      <div class="ss-card">
        <div class="ss-card-head">
          <div class="ch-icon sky"><i class="bi bi-info-circle-fill"></i></div>
          <h3>Platform Info</h3>
        </div>
        <div class="ss-card-body">
          <div class="status-row">
            <span class="sr-label"><i class="bi bi-code-slash"></i> Version</span>
            <span class="sr-value" id="platformVersion">—</span>
          </div>
          <div class="status-row">
            <span class="sr-label"><i class="bi bi-node-plus-fill"></i> Node.js</span>
            <span class="sr-value" id="platformNode">—</span>
          </div>
          <div class="status-row">
            <span class="sr-label"><i class="bi bi-database"></i> ODM Driver</span>
            <span class="sr-value" id="platformMongoose">—</span>
          </div>
          <div class="status-row">
            <span class="sr-label"><i class="bi bi-hdd-network"></i> Environment</span>
            <span class="sr-value" id="platformEnvironment">—</span>
          </div>
        </div>
      </div>

      <!-- Maintenance Mode -->
      <div class="ss-card danger-zone">
        <div class="ss-card-head">
          <div class="ch-icon rose"><i class="bi bi-cone-striped"></i></div>
          <h3 style="color:#e11d48;">Danger Zone</h3>
        </div>
        <div class="ss-card-body text-center">
          <i class="bi bi-exclamation-triangle" style="font-size:2.5rem; color:#fb7185; display:block; margin-bottom:0.75rem; opacity:0.7;"></i>
          <h6 style="font-weight:700 !important; color:#0c4a6e; font-size:0.92rem; margin-bottom:0.3rem;">Maintenance Mode</h6>
          <p style="font-size:0.78rem; color:#94a3b8; margin-bottom:0.75rem;">Blocks non-admin pages and APIs with a 503 maintenance response. Administrators and sign-in remain available for recovery.</p>
          <div id="maintenanceStatus" class="alert alert-success py-2 small">Loading maintenance status…</div>
          <label class="form-label text-start d-block" for="maintenanceMessage">Customer Message</label>
          <textarea class="form-control mb-3" id="maintenanceMessage" rows="3" maxlength="300" placeholder="Explain when service will resume."></textarea>
          <button type="button" class="btn-ss danger w-100 justify-content-center" id="maintenanceToggleBtn"><i class="bi bi-power"></i> Enable Maintenance Mode</button>
          <div class="mt-3 pt-3" style="border-top:1px solid #fecdd3;">
            <button type="button" class="btn-ss outline w-100 justify-content-center" id="cacheClearBtn" style="color:#e11d48; border-color:#fecdd3;">
              <i class="bi bi-arrow-repeat"></i> Clear Runtime Caches
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
(function() {
  var btn = document.getElementById('bpSaveBtn');
  var alertBox = document.getElementById('bpAlert');

  function showAlert(msg, type) {
    if (!alertBox) return;
    alertBox.className = 'alert alert-' + (type || 'info') + ' py-2 small';
    alertBox.textContent = msg;
    alertBox.classList.remove('d-none');
    setTimeout(function() { alertBox.classList.add('d-none'); }, 4000);
  }

  // Load existing values
  fetch('/api/admin/settings/business-profile', { credentials: 'same-origin' })
    .then(function(r) { return r.ok ? r.json() : null; })
    .then(function(data) {
      if (!data) return;
      if (data.businessName) document.getElementById('bpName').value = data.businessName;
      if (data.email) document.getElementById('bpEmail').value = data.email;
      if (data.phone) document.getElementById('bpPhone').value = data.phone;
      if (data.tagline) document.getElementById('bpTagline').value = data.tagline;
      if (data.address) document.getElementById('bpAddress').value = data.address;
      if (data.foundedYear) document.getElementById('bpFoundedYear').value = data.foundedYear;
    })
    .catch(function() {});

  if (btn) {
    btn.addEventListener('click', function() {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';
      var payload = {
        businessName: document.getElementById('bpName').value,
        email: document.getElementById('bpEmail').value,
        phone: document.getElementById('bpPhone').value,
        tagline: document.getElementById('bpTagline').value,
        address: document.getElementById('bpAddress').value,
        foundedYear: document.getElementById('bpFoundedYear').value ? Number(document.getElementById('bpFoundedYear').value) : undefined,
      };
      fetch('/api/admin/settings/business-profile', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(payload),
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.message) {
            showAlert('Business profile saved successfully.', 'success');
          } else {
            showAlert(data.error || 'Failed to save.', 'danger');
          }
        })
        .catch(function() { showAlert('Network error.', 'danger'); })
        .finally(function() {
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-floppy"></i> Save Changes';
        });
    });
  }
})();

(function() {
  var form = document.getElementById('paymentPolicyForm');
  var input = document.getElementById('downpaymentPercentage');
  var btn = document.getElementById('paymentPolicySaveBtn');
  var alertBox = document.getElementById('paymentPolicyAlert');

  function showPaymentAlert(message, type) {
    if (!alertBox) return;
    alertBox.className = 'alert alert-' + (type || 'info') + ' py-2 small';
    alertBox.textContent = message;
    alertBox.classList.remove('d-none');
  }

  fetch('/api/admin/settings/payment-policy', { credentials: 'same-origin' })
    .then(function(response) { return response.ok ? response.json() : null; })
    .then(function(data) {
      if (data && data.downpaymentPercentage != null) input.value = data.downpaymentPercentage;
    })
    .catch(function() { showPaymentAlert('Unable to load the payment policy.', 'warning'); });

  if (form) form.addEventListener('submit', function(event) {
    event.preventDefault();
    var percentage = Number(input.value);
    if (!Number.isFinite(percentage) || percentage < 1 || percentage > 100) {
      showPaymentAlert('Enter a percentage from 1 to 100.', 'danger');
      input.focus();
      return;
    }
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';
    fetch('/api/admin/settings/payment-policy', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ downpaymentPercentage: percentage }),
    })
      .then(function(response) {
        return response.json().then(function(data) { return { ok: response.ok, data: data }; });
      })
      .then(function(result) {
        if (!result.ok) throw new Error(result.data.error || 'Failed to save payment policy.');
        input.value = result.data.downpaymentPercentage;
        showPaymentAlert('Payment policy saved. New orders and bookings will use ' + result.data.downpaymentPercentage + '%.', 'success');
      })
      .catch(function(error) { showPaymentAlert(error.message || 'Unable to save the payment policy.', 'danger'); })
      .finally(function() {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-floppy"></i> Save Payment Policy';
      });
  });
})();

(function() {
  var form = document.getElementById('noShowPolicyForm');
  var waitInput = document.getElementById('noShowWaitMinutes');
  var feeRadios = document.querySelectorAll('input[name="noShowFeeMode"]');
  var fixedInput = document.getElementById('noShowFixedFee');
  var btn = document.getElementById('noShowPolicySaveBtn');
  var alertBox = document.getElementById('noShowPolicyAlert');

  function showNoShowAlert(message, type) {
    if (!alertBox) return;
    alertBox.className = 'alert alert-' + (type || 'info') + ' py-2 small';
    alertBox.textContent = message;
    alertBox.classList.remove('d-none');
  }

  function applyPolicy(policy) {
    if (!policy) return;
    if (policy.noShowWaitMinutes != null) waitInput.value = policy.noShowWaitMinutes;
    var mode = policy.noShowPolicy && policy.noShowPolicy.mode ? policy.noShowPolicy.mode : 'none';
    var fee = policy.noShowPolicy && policy.noShowPolicy.fixedFeeAmount;
    document.querySelectorAll('input[name="noShowFeeMode"]').forEach(function(r) {
      r.checked = (r.value === mode);
    });
    if (fee != null) fixedInput.value = fee;
  }

  fetch('/api/admin/settings/no-show-policy', { credentials: 'same-origin' })
    .then(function(response) { return response.ok ? response.json() : null; })
    .then(applyPolicy)
    .catch(function() { showNoShowAlert('Unable to load the no-show policy.', 'warning'); });

  if (form) form.addEventListener('submit', function(event) {
    event.preventDefault();
    var minutes = Number(waitInput.value);
    if (!Number.isFinite(minutes) || minutes < 1 || minutes > 120) {
      showNoShowAlert('Enter a waiting period from 1 to 120 minutes.', 'danger');
      waitInput.focus();
      return;
    }
    var mode = 'none';
    feeRadios.forEach(function(r) { if (r.checked) mode = r.value; });
    var fixedFeeAmount = mode === 'fixed_fee' ? Number(fixedInput.value) : undefined;
    if (mode === 'fixed_fee' && (!Number.isFinite(fixedFeeAmount) || fixedFeeAmount < 0)) {
      showNoShowAlert('Enter a valid fixed fee amount.', 'danger');
      fixedInput.focus();
      return;
    }
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';
    fetch('/api/admin/settings/no-show-policy', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ noShowWaitMinutes: minutes, noShowPolicy: { mode: mode, fixedFeeAmount: fixedFeeAmount } }),
    })
      .then(function(response) {
        return response.json().then(function(data) { return { ok: response.ok, data: data }; });
      })
      .then(function(result) {
        if (!result.ok) throw new Error(result.data.error || 'Failed to save no-show policy.');
        applyPolicy(result.data);
        showNoShowAlert('No-show policy saved. It applies to new no-show confirmations.', 'success');
      })
      .catch(function(error) { showNoShowAlert(error.message || 'Unable to save the no-show policy.', 'danger'); })
      .finally(function() {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-floppy"></i> Save No-Show Policy';
      });
  });
})();

(function() {
  var state = { configuration: null };

  function alertIn(id, message, type) {
    var box = document.getElementById(id);
    if (!box) return;
    box.className = 'alert alert-' + (type || 'info') + ' py-2 small';
    box.textContent = message;
    box.classList.remove('d-none');
  }

  function setBusy(button, busy, label) {
    if (!button) return;
    if (busy) {
      button.dataset.originalHtml = button.innerHTML;
      button.disabled = true;
      button.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Working…';
    } else {
      button.disabled = false;
      button.innerHTML = label || button.dataset.originalHtml || button.innerHTML;
    }
  }

  async function api(url, options) {
    var response = await fetch(url, Object.assign({ credentials: 'same-origin' }, options || {}));
    var data = await response.json().catch(function() { return {}; });
    if (!response.ok) throw new Error(data.error || 'The request could not be completed.');
    return data;
  }

  function applyConfiguration(configuration) {
    state.configuration = configuration;
    document.getElementById('cfgAllowRegistrations').checked = configuration.application.allowCustomerRegistrations;
    document.getElementById('cfgRequireVerification').checked = configuration.application.requireEmailVerification;
    document.getElementById('notificationEmail').value = configuration.notifications.adminAlertEmail || '';
    document.getElementById('notificationEmailEnabled').checked = configuration.notifications.criticalEmailAlerts;
    document.getElementById('notificationPriority').value = configuration.notifications.minimumPriority || 'urgent';
    document.getElementById('maintenanceMessage').value = configuration.maintenance.message || '';
    renderMaintenance(configuration.maintenance);
  }

  function renderMaintenance(maintenance) {
    var enabled = maintenance && maintenance.enabled;
    var status = document.getElementById('maintenanceStatus');
    var button = document.getElementById('maintenanceToggleBtn');
    status.className = 'alert alert-' + (enabled ? 'danger' : 'success') + ' py-2 small';
    status.textContent = enabled ? 'Maintenance mode is ACTIVE for non-admin users.' : 'System is available to users.';
    button.className = 'btn-ss ' + (enabled ? 'outline' : 'danger') + ' w-100 justify-content-center';
    button.innerHTML = enabled
      ? '<i class="bi bi-play-circle"></i> Disable Maintenance Mode'
      : '<i class="bi bi-power"></i> Enable Maintenance Mode';
  }

  async function loadConfiguration() {
    try {
      var data = await api('/api/admin/settings/system-configuration');
      applyConfiguration(data.configuration);
    } catch (error) {
      alertIn('appConfigAlert', error.message, 'danger');
      alertIn('notificationAlert', error.message, 'danger');
    }
  }

  document.getElementById('appConfigSaveBtn').addEventListener('click', async function() {
    var button = this;
    var requireVerification = document.getElementById('cfgRequireVerification').checked;
    if (!requireVerification && window.Swal) {
      var decision = await Swal.fire({
        icon: 'warning',
        title: 'Allow unverified new accounts?',
        text: 'New customers will be activated immediately without an email OTP. Existing pending accounts remain pending.',
        showCancelButton: true,
        confirmButtonText: 'Save configuration',
        confirmButtonColor: '#0284c7'
      });
      if (!decision.isConfirmed) return;
    }
    setBusy(button, true);
    try {
      var data = await api('/api/admin/settings/system-configuration', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          application: {
            allowCustomerRegistrations: document.getElementById('cfgAllowRegistrations').checked,
            requireEmailVerification: requireVerification
          }
        })
      });
      applyConfiguration(data.configuration);
      alertIn('appConfigAlert', 'App configuration saved and now enforced for new registrations.', 'success');
    } catch (error) {
      alertIn('appConfigAlert', error.message, 'danger');
    } finally {
      setBusy(button, false);
    }
  });

  document.getElementById('notificationSaveBtn').addEventListener('click', async function() {
    var button = this;
    setBusy(button, true);
    try {
      var data = await api('/api/admin/settings/system-configuration', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          notifications: {
            adminAlertEmail: document.getElementById('notificationEmail').value,
            criticalEmailAlerts: document.getElementById('notificationEmailEnabled').checked,
            minimumPriority: document.getElementById('notificationPriority').value
          }
        })
      });
      applyConfiguration(data.configuration);
      alertIn('notificationAlert', 'Notification preferences saved.', 'success');
    } catch (error) {
      alertIn('notificationAlert', error.message, 'danger');
    } finally {
      setBusy(button, false);
    }
  });

  document.getElementById('notificationTestBtn').addEventListener('click', async function() {
    var button = this;
    setBusy(button, true);
    try {
      var data = await api('/api/admin/settings/system-configuration/test-alert', { method: 'POST' });
      alertIn('notificationAlert', data.message, 'success');
    } catch (error) {
      alertIn('notificationAlert', error.message, 'danger');
    } finally {
      setBusy(button, false);
    }
  });

  function bytes(value) {
    var number = Number(value || 0);
    if (number < 1024) return number + ' B';
    if (number < 1024 * 1024) return (number / 1024).toFixed(1) + ' KB';
    return (number / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function duration(seconds) {
    var total = Math.max(0, Number(seconds || 0));
    var days = Math.floor(total / 86400);
    var hours = Math.floor((total % 86400) / 3600);
    var minutes = Math.floor((total % 3600) / 60);
    return (days ? days + 'd ' : '') + (hours ? hours + 'h ' : '') + minutes + 'm';
  }

  async function loadHealth() {
    var button = document.getElementById('healthRefreshBtn');
    setBusy(button, true);
    try {
      var data = await api('/api/admin/settings/system-health');
      var db = document.getElementById('healthDatabase');
      var online = data.database.status === 'online';
      db.textContent = online ? 'Online' : 'Offline';
      db.classList.toggle('offline', !online);
      document.getElementById('healthDbLatency').textContent = data.database.latencyMs == null ? 'Unavailable' : data.database.latencyMs + ' ms';
      document.getElementById('healthMemory').textContent = bytes(data.server.memoryRssBytes) + ' RSS';
      document.getElementById('healthLoad').textContent = data.server.loadAverage1m + ' (1 min avg)';
      document.getElementById('healthLogs').textContent = bytes(data.logs.combinedBytes + data.logs.errorBytes);
      document.getElementById('healthUptime').textContent = duration(data.server.uptimeSeconds);
      document.getElementById('platformVersion').textContent = 'v' + data.platform.applicationVersion;
      document.getElementById('platformNode').textContent = data.platform.nodeVersion;
      document.getElementById('platformMongoose').textContent = 'Mongoose ' + data.platform.mongooseVersion;
      document.getElementById('platformEnvironment').textContent = data.platform.environment;
    } catch (error) {
      var db = document.getElementById('healthDatabase');
      db.textContent = 'Unavailable';
      db.classList.add('offline');
    } finally {
      setBusy(button, false);
    }
  }
  document.getElementById('healthRefreshBtn').addEventListener('click', loadHealth);

  document.getElementById('maintenanceToggleBtn').addEventListener('click', async function() {
    var button = this;
    var enable = !(state.configuration && state.configuration.maintenance.enabled);
    if (window.Swal) {
      var decision = await Swal.fire({
        icon: enable ? 'warning' : 'question',
        title: enable ? 'Enable maintenance mode?' : 'Restore customer access?',
        text: enable ? 'Non-admin pages and APIs will immediately return a maintenance response.' : 'Customers and staff will regain normal access immediately.',
        showCancelButton: true,
        confirmButtonText: enable ? 'Enable maintenance' : 'Disable maintenance',
        confirmButtonColor: enable ? '#e11d48' : '#059669'
      });
      if (!decision.isConfirmed) return;
    }
    setBusy(button, true);
    try {
      var data = await api('/api/admin/settings/maintenance-mode', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: enable, message: document.getElementById('maintenanceMessage').value })
      });
      state.configuration.maintenance = data.maintenance;
      renderMaintenance(data.maintenance);
      if (window.Swal) Swal.fire({ icon: 'success', title: enable ? 'Maintenance enabled' : 'System restored', text: data.message });
    } catch (error) {
      if (window.Swal) Swal.fire({ icon: 'error', title: 'Unable to change maintenance mode', text: error.message });
    } finally {
      setBusy(button, false);
      if (state.configuration) renderMaintenance(state.configuration.maintenance);
    }
  });

  document.getElementById('cacheClearBtn').addEventListener('click', async function() {
    var button = this;
    setBusy(button, true);
    try {
      var data = await api('/api/admin/settings/runtime-cache/clear', { method: 'POST' });
      await loadConfiguration();
      if (window.Swal) Swal.fire({ icon: 'success', title: 'Caches cleared', text: data.message });
    } catch (error) {
      if (window.Swal) Swal.fire({ icon: 'error', title: 'Cache clear failed', text: error.message });
    } finally {
      setBusy(button, false);
    }
  });

  loadConfiguration();
  loadHealth();
})();
</script>
