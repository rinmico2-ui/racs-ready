            <span class="kpi-enterprise-badge orange">Accepted</span>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">Accepted</p>
            <div class="kpi-enterprise-value" id="kpiAccepted">-</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2" style="animation: mwFadeInUp 0.5s ease-out 0.25s both;">
        <div class="kpi-enterprise" data-accent="cyan">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon cyan"><i class="bi bi-truck"></i></div>
            <span class="kpi-enterprise-badge cyan">Delivery</span>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">En Route</p>
            <div class="kpi-enterprise-value" id="kpiDelivery">-</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2" style="animation: mwFadeInUp 0.5s ease-out 0.3s both;">
        <div class="kpi-enterprise" data-accent="purple">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon purple"><i class="bi bi-tools"></i></div>
            <span class="kpi-enterprise-badge purple">Installing</span>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">Installing</p>
            <div class="kpi-enterprise-value" id="kpiInstalling">-</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2" style="animation: mwFadeInUp 0.5s ease-out 0.35s both;">
        <div class="kpi-enterprise" data-accent="green">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon green"><i class="bi bi-check2-all"></i></div>
            <span class="kpi-enterprise-badge green">Completed</span>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">Completed</p>
            <div class="kpi-enterprise-value" id="kpiCompleted">-</div>
          </div>
        </div>
      </div>
    </div>

    <%- include('../../partials/technician-order-daily-kit') %>

    <!-- Enterprise Filter Bar -->
    <div class="mw-filter-bar mw-animate-fade-in">
      <div class="mw-search">
        <i class="bi bi-search"></i>
        <input type="text" id="toSearch" placeholder="Search ref, customer, model...">
      </div>
      <div class="mw-tabs" id="toStatusTabs">
        <button class="mw-tab active" data-status="all">All</button>
        <button class="mw-tab" data-status="technician_assigned">Needs Response</button>
        <button class="mw-tab" data-status="technician_accepted,preparing_unit">Accepted</button>
        <button class="mw-tab" data-status="out_for_delivery">En Route</button>
        <button class="mw-tab" data-status="arrived">Arrived</button>
        <button class="mw-tab" data-status="installing">Installing</button>
        <button class="mw-tab" data-status="completed">Done</button>
      </div>
    </div>

    <!-- Split Layout: Order List + Detail Panel -->
    <div class="mw-split-layout" id="splitLayout">
      <!-- Left Pane: Order Cards -->
      <div class="mw-split-left" id="leftPane">
        <div id="toOrdersList">
          <div class="to-empty"><div class="to-empty-icon"><i class="bi bi-hourglass-split spin"></i></div><h6>Loading orders...</h6><p>Please wait</p></div>
        </div>
      </div>

      <!-- Right Pane: Detail Tracker -->
      <div class="mw-split-right" id="rightPane">
        <div class="mw-split-right-inner">
          <div class="detail-panel-header" id="detailPanelHeader" style="display:none;">
            <div class="detail-panel-header-top">
              <div class="detail-panel-header-left">
                <button class="detail-panel-back" onclick="closeDetailPanel()" aria-label="Back to orders"><i class="bi bi-arrow-left"></i></button>
                <div class="detail-panel-avatar"><i class="bi bi-box-seam"></i></div>
                <div>
                  <h5 class="detail-panel-title" id="detailPanelCustomer">Customer Name</h5>
                  <div class="detail-panel-subtitle">
                    <span id="detailPanelRef">Order #---</span>
                    <span style="margin:0 6px;opacity:0.4;">|</span>
                    <span class="detail-status-badge" id="detailPanelStatusBadge">STATUS</span>
                  </div>
                </div>
              </div>
              <button class="detail-panel-close" onclick="closeDetailPanel()"><i class="bi bi-x-lg" style="font-size:0.8rem;"></i></button>
            </div>
            <div class="detail-panel-workflow" id="detailPanelWorkflow"></div>
          </div>

          <div class="detail-panel-body" id="detailPanelBody">
            <div class="detail-panel-empty" id="detailPanelEmpty">
              <i class="bi bi-hand-index-thumb"></i>
              <h6>Select an Order</h6>
              <p>Click on any order card to view its details and track progress.</p>
            </div>
            <div id="detailPanelContent" style="display:none;"></div>
          </div>

          <div class="detail-panel-actions" id="detailPanelActions" style="display:none;"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var _page=1,_status='all',_search='',_orders=[],_selectedId=null;
  var SCFG={
    pending_payment:{label:'Pending Payment',cls:'pending'}, preparing_unit:{label:'Preparing Unit',cls:'preparing'},
    technician_assigned:{label:'Needs Response',cls:'assigned'}, technician_accepted:{label:'Accepted',cls:'accepted'},
    technician_declined:{label:'Declined',cls:'declined'}, out_for_delivery:{label:'En Route',cls:'delivery'},
    arrived:{label:'Arrived',cls:'arrived'}, installing:{label:'Installing',cls:'installing'},
    completed:{label:'Completed',cls:'completed'}, cancelled:{label:'Cancelled',cls:'cancelled'}
  };
  var FFLOW=['Accept','Daily Prep','En Route','Arrived','Installation','Done'];
  var FDEL=['Accept','En Route','Arrived','Done'];
  
  function getFlow(t) { return t==='delivery_only' ? FDEL : FFLOW; }
  
  function getFlowIndex(s, fulfillmentType) {
    if(s==='technician_assigned') return 0;
    if(s==='technician_accepted' || s==='preparing_unit') return fulfillmentType==='delivery_installation' ? 1 : 0;
    if(s==='out_for_delivery') return fulfillmentType==='delivery_installation' ? 2 : 1;
    if(s==='arrived') return fulfillmentType==='delivery_installation' ? 3 : 2;
    if(s==='installing' && fulfillmentType==='delivery_installation') return 4;
    if(s==='completed') return getFlow(fulfillmentType).length - 1;
    return -1;
  }

  function statusBadgeClass(status) {
    var sc=SCFG[status]||{cls:'pending'};
    if(sc.cls==='pending' || sc.cls==='preparing') return 'pending';
    if(sc.cls==='assigned') return 'scheduled';
    if(sc.cls==='accepted') return 'confirmed';
    if(sc.cls==='declined') return 'cancelled';
    if(sc.cls==='delivery') return 'on-the-way';
    if(sc.cls==='arrived') return 'scheduled';
    if(sc.cls==='installing') return 'in-progress';
    if(sc.cls==='completed') return 'completed';
    if(sc.cls==='cancelled') return 'cancelled';
    return 'pending';
  }

  var ORDER_PROGRESS_ACTIONS = {
    technician_assigned: { t:'Order assigned', s:'A new order has been assigned to you.', icon:'bi-bell-fill' },
    technician_accepted: { t:'Order accepted', s:'You have accepted the order.', icon:'bi-check-circle-fill' },
    preparing_unit: { t:'Order accepted', s:'You have accepted the order.', icon:'bi-check-circle-fill' },
    out_for_delivery: { t:'Heading to delivery location', s:'You are on the way to the delivery location.', icon:'bi-truck' },
    arrived: { t:'Arrived at delivery location', s:'You have arrived at the delivery location.', icon:'bi-geo-alt-fill' },
    installing: { t:'Installing unit', s:'Installation is in progress.', icon:'bi-tools' },
    completed: { t:'Order completed', s:'Order completed. Great job!', icon:'bi-check2-all' },
    cancelled: { t:'Order cancelled', s:'This order has been cancelled.', icon:'bi-x-circle' }
  };

  var ORDER_STEP_DESCRIPTIONS = {
    'Accept':'Review and accept the assigned order.',
    'Daily Prep':'Review and confirm the shared equipment and consumables kit.',
    'En Route':'Travel to the customer delivery location.',
    'Arrived':'Confirm arrival at the customer location.',
    'Installation':'Install, test, and document the ordered units.',
    'Done':'Delivery and service work are finished.'
  };

  function esc(s) {
    if(s === null || s === undefined) return '';
    return String(s).replace(/[&<>"']/g, function(ch) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch];
    });
  }

  function orderItemName(item) {
    item = item || {};
    return [item.brand, item.modelLine || item.name || item.productName].filter(Boolean).join(' ') || 'Air-conditioning unit';
  }

  function orderItemMeta(item) {
    item = item || {};
    var parts = [];
    if(item.capacity) parts.push(String(item.capacity) + (item.capacityUnit ? ' ' + item.capacityUnit : ''));
    parts.push('Qty ' + Math.max(1, Number(item.quantity) || 1));
    if((item.serialNumbers || []).length) parts.push((item.serialNumbers || []).length + ' serial recorded');
    return parts.join(' · ');
  }

  function peso(value) {
    return '₱' + Number(value || 0).toLocaleString('en-PH', {minimumFractionDigits:2, maximumFractionDigits:2});
  }

  function displayDate(value, includeTime) {
    if(!value) return 'Not scheduled';
    var d = new Date(value);
    if(Number.isNaN(d.getTime())) return 'Not scheduled';
    return d.toLocaleDateString('en-PH', {year:'numeric', month:'short', day:'numeric'}) +
      (includeTime ? ' · ' + d.toLocaleTimeString('en-PH', {hour:'numeric', minute:'2-digit'}) : '');
  }

  function orderDateKey(value) {
    var d = value ? new Date(value) : new Date();
    if(Number.isNaN(d.getTime())) return '';
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }

  function fulfillmentLabel(type) {
    if(type === 'delivery_installation') return 'Delivery & Installation';
    if(type === 'delivery_only') return 'Delivery Only';
    if(type === 'customer_pickup') return 'Customer Pickup';
    return 'Order Fulfillment';
  }

  function paymentMethodLabel(method) {
    var labels = {cod:'Cash on Delivery',cash:'Cash',cash_onsite:'Cash On-site',gcash:'GCash',gcash_full:'GCash Full Payment',gcash_downpayment:'GCash Downpayment',paymongo:'PayMongo',downpayment:'Downpayment',other:'Other'};
    return labels[method] || String(method || 'Not specified').replace(/_/g, ' ');
  }

  function phoneHref(value) {
    var normalized = String(value || '').trim().replace(/[^+\d]/g, '');
    return normalized ? normalized : '';
  }

  window.fetchOrders = function() {
    _search = document.getElementById('toSearch').value.trim();
    // Build URL — handle comma-separated multi-status by NOT sending to server; filter client-side
    var _statuses = _status!=='all' ? _status.split(',').map(s=>s.trim()) : [];
    var url = '/api/orders/technician/all?page='+_page+'&limit=200';
    if(_search) url+='&search='+encodeURIComponent(_search);
    
    document.getElementById('toOrdersList').innerHTML = '<div class="to-empty"><div class="to-empty-icon"><i class="bi bi-arrow-repeat spin"></i></div><h6>Loading orders...</h6></div>';
    
    fetch(url)
    .then(async function(r) {
      var payload = await r.json();
      if(!r.ok) throw new Error(payload.error || 'Unable to load technician orders.');
      return payload;
    })
    .then(data=>{
      var allOrders = (data.orders||[]).filter(function(order) {
        return order.fulfillmentType === 'delivery_only' || order.fulfillmentType === 'delivery_installation';
      });
      // Client-side filter for comma-separated statuses
      _orders = _statuses.length ? allOrders.filter(o=>_statuses.includes(o.status)) : allOrders;
      updateKPIs(data.kpi||{});
      renderCards();
      if(_selectedId) {
        var found = _orders.find(o=>o._id===_selectedId);
        if(found) openDetailPanel(found);
        else closeDetailPanel();
      }
    })
    .catch(e=>{
      document.getElementById('toOrdersList').innerHTML = '<div class="alert alert-danger">Error loading orders: '+e.message+'</div>';
    });
  };

  function renderCards() {
    var c = document.getElementById('toOrdersList');
    if (!_orders.length) {
      c.innerHTML = '<div class="to-empty"><div class="to-empty-icon"><i class="bi bi-inbox"></i></div><h6>No Orders Found</h6><p>Try adjusting your filters.</p></div>';
      return;
    }
    var PILL = {
      assigned:   { bg: '#dbeafe', text: '#1e40af' },
      accepted:   { bg: '#dcfce7', text: '#166534' },
      declined:   { bg: '#fee2e2', text: '#991b1b' },
      preparing:  { bg: '#fef9c3', text: '#713f12' },
      delivery:   { bg: '#cffafe', text: '#155e75' },
      arrived:    { bg: '#ede9fe', text: '#4c1d95' },
      installing: { bg: '#fef3c7', text: '#92400e' },
      completed:  { bg: '#dcfce7', text: '#065f46' },
      cancelled:  { bg: '#fee2e2', text: '#7f1d1d' },
      pending:    { bg: '#f1f5f9', text: '#334155' }
    };
    var h = '';
    _orders.forEach(function(o) {
      var id = esc(o._id);
      var sel = (_selectedId === o._id) ? ' selected' : '';
      var items = (o.items || []).map(function(i) { return esc(orderItemName(i)); }).join(', ') || 'Order item';
      var cust = esc((o.customer && o.customer.name) || 'Customer');
      var sc = SCFG[o.status] || { label: o.status, cls: 'pending' };
      var p = PILL[sc.cls] || PILL.pending;
      var dObj = (o.delivery && o.delivery.preferredDate) ? new Date(o.delivery.preferredDate) : null;
      if(dObj && Number.isNaN(dObj.getTime())) dObj = null;
      var day = dObj ? dObj.getDate() : '—';
      var month = dObj ? dObj.toLocaleDateString('en-PH', { month: 'short' }) : '';
      var dtime = esc(o.timeSlot || 'TBD');
      var addr = (o.delivery && o.delivery.address) ? esc(o.delivery.address.length > 26 ? o.delivery.address.slice(0, 26) + '…' : o.delivery.address) : 'No address';
      var live = ['out_for_delivery', 'arrived', 'installing'].includes(o.status);
      h += '<div class="to-order-card tjc' + sel + (live ? ' tjc-live' : '') + '" data-id="' + id + '" role="button" tabindex="0">';
      h += '<div class="tjc-date"><div class="tjc-date-day">' + day + '</div><div class="tjc-date-month">' + month + '</div></div>';
      h += '<div class="tjc-main">';
      h += '<div class="tjc-top"><div class="tjc-title">' + items + '</div><span class="tjc-status" style="background:' + p.bg + ';color:' + p.text + ';">' + esc(sc.label) + '</span></div>';
      h += '<div class="tjc-meta"><span><i class="bi bi-clock me-1"></i>' + dtime + '</span><span><i class="bi bi-geo-alt me-1"></i>' + addr + '</span></div>';
      h += '<div class="tjc-meta"><span><i class="bi bi-person me-1"></i>' + cust + '</span>' + (live ? '<span class="tjc-live-badge"><span class="tjc-pulse"></span>Live</span>' : '') + '</div>';
      h += '</div>';
      h += '<div class="tjc-action"><button class="tjc-view" onclick="event.stopPropagation();window.viewOrder(\'' + id + '\')">View <i class="bi bi-arrow-right"></i></button></div>';
      h += '</div>';
    });
    c.innerHTML = h;
  }
  
  function updateKPIs(s) {
    function setT(id,v){if(document.getElementById(id)) document.getElementById(id).textContent=v!=null?v:'-';}
    setT('kpiTotal',    s.totalOrders);
    setT('kpiAwaiting', s.awaitingAcceptance);
    setT('kpiAccepted', s.pendingPrep);
    setT('kpiDelivery', s.outForDelivery);
    setT('kpiInstalling',s.installing);
    setT('kpiCompleted', s.completed);
    setT('heroTotal',   s.totalOrders);
    setT('heroActive',  Number(s.outForDelivery||0) + Number(s.installing||0));
  }

  window.viewOrder = function(id) {
    _selectedId = id;
    var order = _orders.find(o=>o._id===id);
    if(order) openDetailPanel(order);
    renderCards();
  };
  
  window.closeDetailPanel = function() {
    _selectedId = null;
    document.getElementById('leftPane').classList.remove('panel-open');
    document.getElementById('rightPane').classList.remove('open');
    document.body.classList.remove('order-sheet-open');
    document.getElementById('detailPanelEmpty').style.display = 'flex';
    document.getElementById('detailPanelHeader').style.display = 'none';
    document.getElementById('detailPanelContent').style.display = 'none';
    document.getElementById('detailPanelActions').style.display = 'none';
    renderCards();
  };

  function openDetailPanel(o) {
    document.getElementById('leftPane').classList.add('panel-open');
    document.getElementById('rightPane').classList.add('open');
    document.body.classList.add('order-sheet-open');
    document.getElementById('detailPanelEmpty').style.display = 'none';
    
    var header = document.getElementById('detailPanelHeader');
    header.classList.add('to-order-detail-header');
    header.style.display = 'block';
    document.getElementById('detailPanelCustomer').textContent = o.customer?.name || 'Customer';
    document.getElementById('detailPanelRef').textContent = 'Order #' + (o.orderReference||o._id.substring(o._id.length-6).toUpperCase());
    var b=SCFG[o.status]||{label:o.status,cls:''};
    document.getElementById('detailPanelStatusBadge').textContent = b.label;
    document.getElementById('detailPanelStatusBadge').className = 'detail-status-badge to-detail-status ' + statusBadgeClass(o.status);
    
    var flow = getFlow(o.fulfillmentType);
    var ai = getFlowIndex(o.status, o.fulfillmentType);
    var liveStatuses = ['out_for_delivery','arrived','installing'];
    var isLive = liveStatuses.indexOf(o.status) !== -1;
    var act = ORDER_PROGRESS_ACTIONS[o.status] || { t: b.label, s: 'In progress', icon: 'bi-circle' };
    if(o.fulfillmentType === 'delivery_installation' && ['technician_accepted','preparing_unit'].includes(o.status)) {
      var kitState = o.preparation?.installation?.status || 'pending';
      act = ['confirmed','completed'].includes(kitState)
        ? { t:'Daily Preparation confirmed', s:'The installation kit is ready. Confirm dispatch readiness before departure.', icon:'bi-briefcase-fill' }
        : { t:'Complete Daily Preparation', s:'Review and confirm equipment and consumables before going En Route.', icon:'bi-briefcase' };
    }

    var opHtml = '<div class="trk-card-header"><h6 class="trk-card-title"><i class="bi bi-activity"></i> Work Progress</h6>';
    if(isLive) opHtml += '<span class="trk-live-tag"><span class="trk-pulse-dot"></span> LIVE</span>';
    opHtml += '</div><div class="trk-card-body">';
    opHtml += '<div class="trk-current-action '+(isLive?'live':'')+'"><div class="trk-current-action-icon"><i class="bi '+esc(isLive?'bi-arrow-repeat':act.icon)+'"></i></div><div class="trk-current-action-text"><div class="trk-current-action-title">'+esc(act.t)+'</div><div class="trk-current-action-sub">'+esc(act.s)+'</div></div></div>';
    opHtml += '<div class="trk-task-list">';
    flow.forEach(function(step, i) {
      var state = i < ai ? 'done' : (i === ai ? 'active' : '');
      var icon = 'bi-circle';
      if(i < ai) icon = 'bi-check-lg';
      else if(i === ai) {
        if(step==='Accept') icon='bi-check-circle-fill';
        else if(step==='Daily Prep') icon='bi-briefcase-fill';
        else if(step==='En Route') icon='bi-sign-turn-right';
        else if(step==='Arrived') icon='bi-geo-alt';
        else if(step==='Installation') icon='bi-tools';
        else icon='bi-check-circle';
      } else if(step==='Accept') icon='bi-check-lg';
      else if(step==='Daily Prep') icon='bi-briefcase';
      else if(step==='En Route') icon='bi-sign-turn-right';
      else if(step==='Arrived') icon='bi-geo-alt';
      else if(step==='Installation') icon='bi-tools';
      else icon='bi-check-circle';
      var desc = ORDER_STEP_DESCRIPTIONS[step] || '';
      opHtml += '<div class="trk-task '+state+'"><div class="trk-task-dot"><i class="bi '+icon+'"></i></div><div class="trk-task-body"><div class="trk-task-label">'+esc(step)+'</div>'+(desc?'<div class="trk-task-desc">'+esc(desc)+'</div>':'')+'</div></div>';
    });
    opHtml += '</div></div>';
    var workflow = document.getElementById('detailPanelWorkflow');
    workflow.className = 'trk-card trk-work-progress compact-work-progress';
    workflow.innerHTML = opHtml;
    
    var prep = o.preparation || {};
    var dispatchPrep = prep.dispatch || {status:'pending'};
    var installPrep = prep.installation || {status:o.fulfillmentType === 'delivery_installation' ? 'pending' : 'not_required', blockers:[]};
    var dispatchReady = dispatchPrep.status === 'ready';
    var installReady = o.fulfillmentType !== 'delivery_installation' || installPrep.status === 'confirmed' || installPrep.status === 'completed';
    var preparationDate = orderDateKey(o.delivery?.preferredDate);
    var prepBlocked = installPrep.status === 'blocked';
    var prepBlockers = [];
    if(!dispatchReady) prepBlockers.push('Operations has not marked the ordered unit dispatch-ready.');
    if(!installReady) {
      var installationBlockers = Array.isArray(installPrep.blockers) && installPrep.blockers.length
        ? installPrep.blockers
        : ['Daily Preparation is not confirmed for this installation.'];
      prepBlockers = prepBlockers.concat(installationBlockers);
    }

    var reference = o.orderReference || o._id.substring(o._id.length - 6).toUpperCase();
    var itemsLabel = (o.items||[]).map(orderItemName).join(', ') || 'Order item';
    var schedule = displayDate(o.delivery?.preferredDate, false);
    if(o.timeSlot) schedule += ' · ' + o.timeSlot;
    var address = o.delivery?.address || 'No delivery address recorded';
    var phone = o.customer?.phone || o.delivery?.contactNumber || '';
    var phoneLink = phoneHref(phone);
    var coords = o.delivery?.coordinates?.coordinates || [];
    var destination = coords.length === 2 && Number.isFinite(Number(coords[0])) && Number.isFinite(Number(coords[1]))
      ? Number(coords[1]) + ',' + Number(coords[0]) : address;
    var mapsHref = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(destination);
    var paymentSettled = ['paid','verified','remitted'].includes(o.paymentStatus);
    var requiredItems = installPrep.requiredItems || [];
    var history = (o.statusHistory || []).slice().reverse().slice(0, 8);
    var h = '<div class="to-detail-shell">';
    h += '<section class="to-detail-overview"><div class="to-detail-overview-main"><div class="to-detail-overview-icon"><i class="bi bi-box-seam"></i></div><div><div class="to-detail-eyebrow">Assigned order</div><h4>'+esc(itemsLabel)+'</h4><p>Order #'+esc(reference)+' · '+esc(fulfillmentLabel(o.fulfillmentType))+'</p></div></div><div class="to-detail-total"><span>Order total</span><strong>'+esc(peso(o.total))+'</strong></div></section>';
    h += '<div class="to-detail-summary">';
    h += '<div class="to-summary-cell"><span>Schedule</span><strong>'+esc(schedule)+'</strong></div>';
    h += '<div class="to-summary-cell"><span>Fulfillment</span><strong>'+esc(fulfillmentLabel(o.fulfillmentType))+'</strong></div>';
    h += '<div class="to-summary-cell"><span>Customer</span><strong>'+esc(o.customer?.name || 'Customer')+'</strong></div>';
    h += '<div class="to-summary-cell"><span>Current status</span><strong>'+esc(b.label)+'</strong></div></div>';
    h += '<div class="to-detail-grid"><div class="to-detail-column">';

    h += '<section class="to-detail-card"><div class="to-detail-card-head"><h6 class="to-detail-card-title"><i class="bi bi-geo-alt-fill"></i>Customer &amp; Destination</h6></div><div class="to-detail-card-body"><div class="to-info-list">';
    h += '<div class="to-info-row"><div class="to-info-icon"><i class="bi bi-person"></i></div><div><div class="to-info-label">Customer contact</div><div class="to-info-value">'+esc(o.customer?.name || 'Customer')+(phone?' · '+esc(phone):'')+'</div></div></div>';
    h += '<div class="to-info-row"><div class="to-info-icon"><i class="bi bi-pin-map"></i></div><div><div class="to-info-label">Delivery address</div><div class="to-info-value">'+esc(address)+'</div></div></div>';
    h += '<div class="to-info-row"><div class="to-info-icon"><i class="bi bi-calendar3"></i></div><div><div class="to-info-label">Delivery schedule</div><div class="to-info-value">'+esc(schedule)+'</div></div></div>';
    if(o.delivery?.notes) h += '<div class="to-info-row"><div class="to-info-icon"><i class="bi bi-sticky"></i></div><div><div class="to-info-label">Customer instructions</div><div class="to-info-note">'+esc(o.delivery.notes)+'</div></div></div>';
    h += '</div><div class="to-contact-actions">';
    if(phoneLink) {
      h += '<a class="to-contact-action" href="tel:'+esc(phoneLink)+'"><i class="bi bi-telephone"></i>Call</a>';
      h += '<a class="to-contact-action" href="sms:'+esc(phoneLink)+'"><i class="bi bi-chat-dots"></i>Text</a>';
    }
    h += '<a class="to-contact-action" href="'+esc(mapsHref)+'" target="_blank" rel="noopener noreferrer"><i class="bi bi-sign-turn-right"></i>Directions</a>';
    h += '</div></div></section>';

    h += '<section class="to-detail-card"><div class="to-detail-card-head"><h6 class="to-detail-card-title"><i class="bi bi-boxes"></i>Order Items</h6><span class="to-detail-card-count">'+(o.items?.length || 0)+' line item'+((o.items?.length || 0)===1?'':'s')+'</span></div><div class="to-detail-card-body">';
    if((o.items || []).length) {
      (o.items || []).forEach(function(item) {
        var lineTotal = Number(item.totalPrice || (Number(item.unitPrice || 0) * Math.max(1, Number(item.quantity) || 1)));
        h += '<div class="to-item-row"><div class="to-item-icon"><i class="bi bi-snow"></i></div><div><div class="to-item-name">'+esc(orderItemName(item))+'</div><div class="to-item-meta">'+esc(orderItemMeta(item))+'</div></div><div class="to-item-amount">'+esc(peso(lineTotal))+'</div></div>';
      });
    } else h += '<div class="text-muted small">No item details were recorded.</div>';
    h += '</div></section>';

    h += '<section class="to-detail-card"><div class="to-detail-card-head"><h6 class="to-detail-card-title"><i class="bi bi-clock-history"></i>Execution History</h6></div><div class="to-detail-card-body">';
    if(history.length) {
      h += '<div class="to-timeline">';
      history.forEach(function(entry) {
        var historyStatus = SCFG[entry.status]?.label || String(entry.status || 'Status update').replace(/_/g, ' ');
        h += '<div class="to-timeline-item"><div class="to-timeline-dot"></div><div><div class="to-timeline-status">'+esc(historyStatus)+'</div><div class="to-timeline-time">'+esc(displayDate(entry.timestamp, true))+'</div>'+(entry.note?'<div class="to-timeline-note">'+esc(entry.note)+'</div>':'')+'</div></div>';
      });
      h += '</div>';
    } else h += '<div class="text-muted small">No status updates have been recorded yet.</div>';
    h += '</div></section></div><div class="to-detail-column">';

    h += '<section class="to-detail-card"><div class="to-detail-card-head"><h6 class="to-detail-card-title"><i class="bi bi-clipboard2-check"></i>Departure Readiness</h6></div><div class="to-detail-card-body">';
    h += '<div class="to-readiness-row"><div class="to-readiness-name"><i class="bi bi-box-seam"></i>Unit &amp; dispatch</div><span class="to-state-pill '+(dispatchReady?'ready':dispatchPrep.status==='blocked'?'blocked':'pending')+'">'+esc(String(dispatchPrep.status || 'pending').replace(/_/g,' '))+'</span></div>';
    if(o.fulfillmentType === 'delivery_installation') {
      h += '<div class="to-readiness-row"><div><div class="to-readiness-name"><i class="bi bi-tools"></i>Installation Daily Kit</div>'+(requiredItems.length?'<div class="to-item-meta">'+requiredItems.length+' required kit item'+(requiredItems.length===1?'':'s')+'</div>':'')+'</div><span class="to-state-pill '+(installReady?'ready':prepBlocked?'blocked':'pending')+'">'+esc(String(installPrep.status || 'pending').replace(/_/g,' '))+'</span></div>';
      h += '<button type="button" class="to-detail-link odk-inline-link" onclick="openOrderDailyKit(\''+esc(preparationDate)+'\')"><i class="bi bi-box2-heart"></i>Open Daily Preparation <i class="bi bi-arrow-right"></i></button>';
    }
    if(prepBlockers.length) h += '<ul class="to-blocker-list">'+prepBlockers.map(function(reason){return '<li>'+esc(reason)+'</li>';}).join('')+'</ul>';
    h += '</div></section>';

    h += '<section class="to-detail-card"><div class="to-detail-card-head"><h6 class="to-detail-card-title"><i class="bi bi-receipt"></i>Payment Snapshot</h6><span class="to-payment-status '+(paymentSettled?'settled':'unsettled')+'">'+esc(String(o.paymentStatus || 'pending').replace(/_/g,' '))+'</span></div><div class="to-detail-card-body">';
    h += '<div class="to-money-row"><span>Payment method</span><strong>'+esc(paymentMethodLabel(o.paymentMethod))+'</strong></div>';
    h += '<div class="to-money-row"><span>Products subtotal</span><strong>'+esc(peso(o.subtotal))+'</strong></div>';
    if(Number(o.deliveryFee || 0)) h += '<div class="to-money-row"><span>Delivery fee</span><strong>'+esc(peso(o.deliveryFee))+'</strong></div>';
    if(Number(o.installationFee || 0)) h += '<div class="to-money-row"><span>Installation fee</span><strong>'+esc(peso(o.installationFee))+'</strong></div>';
    if(Number(o.transportationFee || 0)) h += '<div class="to-money-row"><span>Transportation fee</span><strong>'+esc(peso(o.transportationFee))+'</strong></div>';
    if(Number(o.downpaymentAmount || 0)) h += '<div class="to-money-row"><span>Downpayment</span><strong>'+esc(peso(o.downpaymentAmount))+'</strong></div>';
    if(Number(o.balanceAmount || 0) && !paymentSettled) h += '<div class="to-money-row"><span>Recorded balance</span><strong>'+esc(peso(o.balanceAmount))+'</strong></div>';
    h += '<div class="to-money-row total"><span>Order total</span><strong>'+esc(peso(o.total))+'</strong></div></div></section>';

    if(o.arrivalProofUrl || o.startProofUrl || o.proofPhoto || o.startedAt || o.completedAt) {
      h += '<section class="to-detail-card"><div class="to-detail-card-head"><h6 class="to-detail-card-title"><i class="bi bi-shield-check"></i>Work Evidence</h6></div><div class="to-detail-card-body"><div class="to-info-list">';
      if(o.arrivalProofUrl) h += '<div class="to-info-row"><div class="to-info-icon"><i class="bi bi-camera"></i></div><div><div class="to-info-label">Arrival proof</div><div class="to-info-value">Recorded '+esc(displayDate(o.arrivalProofCapturedAt || o.arrivedAt, true))+'</div></div></div>';
      if(o.startProofUrl) h += '<div class="to-info-row"><div class="to-info-icon"><i class="bi bi-tools"></i></div><div><div class="to-info-label">Installation start proof</div><div class="to-info-value">Recorded '+esc(displayDate(o.startProofCapturedAt || o.startedAt, true))+'</div>'+(o.startProofNotes?'<div class="to-info-note">'+esc(o.startProofNotes)+'</div>':'')+'</div></div>';
      if(o.proofPhoto) h += '<div class="to-info-row"><div class="to-info-icon"><i class="bi bi-check2-circle"></i></div><div><div class="to-info-label">Completion proof</div><div class="to-info-value">Recorded '+esc(displayDate(o.completedAt, true))+'</div></div></div>';
      h += '</div></div></section>';
    }
    h += '</div></div></div>';

    document.getElementById('detailPanelContent').innerHTML = h;
    document.getElementById('detailPanelContent').style.display = 'block';
    document.getElementById('detailPanelBody').scrollTop = 0;
    
    var aHtml = '';
    var s = o.status;
    var ftype = o.fulfillmentType;
    var oid = esc(o._id);
    
    if(s === 'technician_assigned') {
      aHtml += '<button class="to-btn to-btn-accept" data-action="accept" data-id="'+oid+'"><i class="bi bi-check-lg"></i>Accept</button>';
      aHtml += '<button class="to-btn to-btn-decline" data-action="decline" data-id="'+oid+'"><i class="bi bi-x-lg"></i>Decline</button>';
    } else if(s === 'technician_accepted' || s === 'preparing_unit') {
      if(ftype === 'delivery_installation' && !installReady) {
        aHtml += '<button class="to-btn to-btn-enroute" data-action="open-kit" data-date="'+esc(preparationDate)+'"><i class="bi bi-briefcase"></i>Open Daily Preparation</button>';
      } else if(!dispatchReady) {
        aHtml += '<button class="to-btn to-btn-enroute" data-action="blocked" data-message="Operations must mark the ordered unit dispatch-ready before departure."><i class="bi bi-box-seam"></i>Awaiting Dispatch Readiness</button>';
      } else {
        aHtml += '<button class="to-btn to-btn-enroute" data-action="status" data-id="'+oid+'" data-status="out_for_delivery"><i class="bi bi-truck"></i>Mark En Route</button>';
      }
    } else if(s === 'out_for_delivery') {
      aHtml += '<button class="to-btn to-btn-arrived" data-action="status" data-id="'+oid+'" data-status="arrived"><i class="bi bi-geo-alt-fill"></i>Mark Arrived</button>';
    } else if(s === 'arrived') {
      if(ftype === 'delivery_installation') {
        aHtml += '<button class="to-btn to-btn-install" data-action="status" data-id="'+oid+'" data-status="installing"><i class="bi bi-tools"></i>Start Install</button>';
      } else {
        aHtml += '<button class="to-btn to-btn-done" data-action="status" data-id="'+oid+'" data-status="completed"><i class="bi bi-check2-all"></i>Mark Completed</button>';
      }
    } else if(s === 'installing') {
      aHtml += '<button class="to-btn to-btn-done" data-action="status" data-id="'+oid+'" data-status="completed"><i class="bi bi-check2-all"></i>Mark Completed</button>';
    }
    
    var actDiv = document.getElementById('detailPanelActions');
    if(aHtml) {
      actDiv.innerHTML = '<div class="to-actions-wrap">'+aHtml+'</div>';
      actDiv.style.display = 'flex';
    } else {
      actDiv.style.display = 'none';
    }
  }

  window.doAccept = async function(id) {
    try {
      const res = await fetch('/api/orders/'+id+'/accept', {method:'POST'});
      const data = await res.json();
      if(!res.ok) throw new Error(data.error || "Failed to accept");
      var acceptedOrder = _orders.find(o=>String(o._id)===String(id)) || {};
      var acceptedDate = orderDateKey(acceptedOrder.delivery?.preferredDate);
      if(data.preparationReview?.hasDelta) {
        const result = await Swal.fire({title:"Order Accepted — Kit Update Required",html:'<div class="text-start small">This installation added new Daily Kit requirements:<br><strong>'+data.preparationReview.deltaItems.map(i=>esc(i.name)+' × '+Number(i.quantity||1)).join('<br>')+'</strong></div>',icon:"warning",showCancelButton:true,confirmButtonText:"Open Daily Preparation",cancelButtonText:"Review Later"});
        if(result.isConfirmed) openOrderDailyKit(acceptedDate);
      } else if(acceptedOrder.fulfillmentType === 'delivery_installation') {
        const result = await Swal.fire({title:"Order Accepted",text:"Review and confirm the Daily Preparation kit before departure.",icon:"success",showCancelButton:true,confirmButtonText:"Open Daily Preparation",cancelButtonText:"Review Later"});
        if(result.isConfirmed) openOrderDailyKit(acceptedDate);
      } else {
        Swal.fire({title:"Accepted",text:"Order accepted and ready for the delivery workflow.",icon:"success",timer:2200,showConfirmButton:false});
      }
      fetchOrders();
    } catch(e) { Swal.fire("Error",e.message,"error"); }
  };
  
  window.doDecline = async function(id) {
    Swal.fire({
      title: 'Decline Assignment',
      input: 'text',
      inputLabel: 'Reason',
      inputPlaceholder: 'Enter reason...',
      showCancelButton: true,
      confirmButtonText: 'Decline',
      confirmButtonColor: '#ef4444'
    }).then(async (result) => {
      if (result.isConfirmed) {
        try {
          const res = await fetch('/api/orders/'+id+'/decline', {
            method:'POST',headers:{'Content-Type':'application/json'},
            body:JSON.stringify({reason:result.value||'No reason provided'})
          });
          if(!res.ok) throw new Error("Failed to decline");
          closeDetailPanel();
          Swal.fire({title:"Declined",text:"Order declined.",icon:"success",timer:1500,showConfirmButton:false});
          fetchOrders();
        } catch(e) { Swal.fire("Error",e.message,"error"); }
      }
    });
  };
  
  async function readOrderProof(file) {
    if(!file) throw new Error('A photo is required.');
    if(!['image/jpeg','image/jpg','image/png','image/webp'].includes(file.type)) throw new Error('Use a JPEG, PNG, or WebP image.');
    if(file.size > 5 * 1024 * 1024) throw new Error('Photo must be 5 MB or smaller.');
    return new Promise((resolve,reject)=>{var reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(new Error('Could not read the selected photo.'));reader.readAsDataURL(file);});
  }

  async function captureOrderStageProof(status) {
    var isArrival = status === 'arrived';
    var result = await Swal.fire({
      title: isArrival ? 'Proof of Arrival' : 'Proof of Starting Installation',
      html:'<div class="text-start"><p class="text-muted small">'+(isArrival?'Take or upload a photo showing that you reached the customer location.':'Take or upload a photo showing the site before installation work begins.')+'</p><label class="form-label fw-semibold">Photo <span class="text-danger">*</span></label><input id="orderStageProof" type="file" accept="image/*" capture="environment" class="form-control mb-3">'+(isArrival?'':'<label class="form-label">Starting notes (optional)</label><textarea id="orderStageNotes" class="form-control" rows="2" maxlength="500"></textarea>')+'</div>',
      showCancelButton:true,
      confirmButtonText:isArrival?'Submit & Mark Arrived':'Submit & Start Installation',
      preConfirm:async()=>{
        try {
          var proof=await readOrderProof(document.getElementById('orderStageProof').files[0]);
          return isArrival?{arrivalProofUrl:proof}:{startProofUrl:proof,startProofNotes:(document.getElementById('orderStageNotes').value||'').trim()};
        } catch(error) { Swal.showValidationMessage(error.message); return false; }
      }
    });
    return result.isConfirmed ? result.value : null;
  }

  async function captureOrderCompletion(order) {
    var required=(order.preparation?.installation?.requiredItems||[]).filter(i=>i.category==='consumable');
    var consumableHtml=required.length?'<hr><div class="fw-semibold mb-2">Installation consumables used</div>'+required.map((i,index)=>'<div class="d-flex align-items-center gap-2 mb-2"><div class="flex-grow-1"><div class="small fw-semibold">'+esc(i.name)+'</div><div class="text-muted" style="font-size:.7rem">Required coverage: '+Number(i.quantity||0)+' '+esc(i.unit||'pcs')+'</div></div><input id="orderUsage'+index+'" class="form-control form-control-sm" type="number" min="0" max="'+Number(i.quantity||0)+'" value="0" style="width:80px"></div>').join(''):'';
    var unitCount=(order.items||[]).reduce((sum,item)=>sum+((item.isHvac!==false||item.parentHvacId||item.capacity)?Math.max(1,Number(item.quantity)||1):0),0);
    var serialHtml=order.fulfillmentType==='delivery_installation'?'<label class="form-label fw-semibold mt-2">Installed unit serial numbers <span class="text-danger">*</span></label><textarea id="orderSerialNumbers" class="form-control" rows="3" placeholder="One serial number per line"></textarea><div class="form-text">Required: '+unitCount+' unique serial number(s), in the same order as the product list.</div>':'';
    var result=await Swal.fire({
      title:order.fulfillmentType==='delivery_installation'?'Complete Installation':'Complete Delivery',
      width:640,
      html:'<div class="text-start"><label class="form-label fw-semibold">Completion photo <span class="text-danger">*</span></label><input id="orderCompletionProof" type="file" accept="image/*" capture="environment" class="form-control">'+serialHtml+consumableHtml+'</div>',
      showCancelButton:true,
      confirmButtonText:'Submit Proof & Complete',
      confirmButtonColor:'#059669',
      preConfirm:async()=>{
        try {
          var completionProofUrl=await readOrderProof(document.getElementById('orderCompletionProof').files[0]);
          var serialEl=document.getElementById('orderSerialNumbers');
          var serialNumbers=serialEl?serialEl.value.split(/\r?\n/).map(v=>v.trim()).filter(Boolean):[];
          if(new Set(serialNumbers.map(v=>v.toLowerCase())).size!==serialNumbers.length) throw new Error('Serial numbers must be unique.');
          if(order.fulfillmentType==='delivery_installation'&&serialNumbers.length!==unitCount) throw new Error('Enter exactly '+unitCount+' installed unit serial number(s).');
          var consumables=required.map((item,index)=>({itemName:item.name,quantityUsed:Math.max(0,Number(document.getElementById('orderUsage'+index).value)||0)}));
          return {completionProofUrl,serialNumbers,consumables};
        } catch(error) { Swal.showValidationMessage(error.message); return false; }
      }
    });
    return result.isConfirmed ? result.value : null;
  }

  window.doStatus = async function(id, status) {
    try {
      const order = _orders.find(o => String(o._id) === String(id)) || {};
      var evidence={};
      if(status==='arrived'||status==='installing') {
        evidence=await captureOrderStageProof(status);
        if(!evidence) return;
      } else if(status==='completed') {
        evidence=await captureOrderCompletion(order);
        if(!evidence) return;
      } else {
        var confirmation=await Swal.fire({title:'Go En Route?',text:'Confirm that you are leaving for the customer location.',icon:'question',showCancelButton:true,confirmButtonText:'Mark En Route'});
        if(!confirmation.isConfirmed) return;
      }
      const res = await fetch('/api/orders/'+id+'/status', {
        method:'PATCH',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({status:status,note:'Status updated to '+SCFG[status].label,...evidence})
      });
      const data=await res.json();
      if(!res.ok && data.code === 'ORDER_PREPARATION_REQUIRED') {
        var kitBlocked = order.fulfillmentType === 'delivery_installation' && (data.blockers || []).some(function(reason) {
          return /daily preparation|daily kit|installation requirement|newly added/i.test(String(reason));
        });
        await Swal.fire({title:'Departure Preparation Required',text:data.error || 'Complete all departure checks before going En Route.',icon:'warning',confirmButtonText:kitBlocked?'Open Daily Preparation':'OK'});
        if(kitBlocked) openOrderDailyKit(orderDateKey(order.delivery?.preferredDate));
        fetchOrders();
        return;
      }
      if(!res.ok) throw new Error(data.error || "Failed to update status");
      await Swal.fire({title:status==='completed'?'Work Completed':'Status Updated',text:'Order is now '+SCFG[status].label+'.',icon:'success',timer:1800,showConfirmButton:false});
      if(status === 'completed' && ['cod','cash','cash_onsite','gcash_downpayment'].includes(order.paymentMethod) && !['paid','verified','remitted'].includes(order.paymentStatus)) await collectOrderPayment(id);
      fetchOrders();
    } catch(e) { Swal.fire("Error",e.message,"error"); }
  };

  async function collectOrderPayment(id) {
    var order=_orders.find(o=>String(o._id)===String(id))||{};
    const amountDue=Number(order.balanceAmount||order.total||0);
    const result=await Swal.fire({title:'Collect Payment',html:`<div class="text-start"><label class="form-label">Amount Due</label><input id="opAmount" type="number" class="form-control mb-2" value="${amountDue}" max="${amountDue}"><label class="form-label">Payment Method</label><select id="opMethod" class="form-select mb-2"><option value="cash">Cash</option><option value="gcash">GCash</option><option value="bank">Bank Transfer</option></select><label class="form-label">Reference Number</label><input id="opRef" class="form-control mb-2" placeholder="Required for GCash / Bank"><label class="form-label">Receipt Screenshot</label><input id="opProof" type="file" accept="image/*" class="form-control mb-2"><label class="form-label">Customer Signature</label><input id="opSignature" class="form-control" placeholder="Customer full name" required></div>`,showCancelButton:true,confirmButtonText:'Record Collection',preConfirm:async()=>{const method=document.getElementById('opMethod').value,reference=document.getElementById('opRef').value.trim(),customerSignature=document.getElementById('opSignature').value.trim(),file=document.getElementById('opProof').files[0];if(!customerSignature||((method==='gcash'||method==='bank')&&(!reference||!file))){Swal.showValidationMessage('Signature and required transfer evidence are missing.');return false;}const proofUrl=file?await new Promise((ok,bad)=>{const f=new FileReader();f.onload=()=>ok(f.result);f.onerror=bad;f.readAsDataURL(file);}):null;return {amount:Number(document.getElementById('opAmount').value),method,reference,proofUrl,customerSignature};}});
    if(!result.isConfirmed) return;
    const location=await new Promise(ok=>{if(!navigator.geolocation)return ok(null);navigator.geolocation.getCurrentPosition(p=>ok({lat:p.coords.latitude,lng:p.coords.longitude,accuracy:p.coords.accuracy}),()=>ok(null),{timeout:5000});});
    const r=await fetch('/api/orders/'+id+'/collect-payment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...result.value,location})});
    const d=await r.json();if(!r.ok)throw new Error(d.error||'Failed to record payment');
    await Swal.fire({title:'Payment Collected',text:'Waiting for admin remittance verification.',icon:'success'});
  }

  // Delegated click handlers — card list (view order)
  document.getElementById('toOrdersList').addEventListener('click', function(e) {
    var card = e.target.closest('[data-id]');
    if(card && card.classList.contains('to-order-card')) {
      window.viewOrder(card.dataset.id);
    }
  });

  document.getElementById('toOrdersList').addEventListener('keydown', function(e) {
    if(e.key !== 'Enter' && e.key !== ' ') return;
    var card = e.target.closest('.to-order-card[data-id]');
    if(!card) return;
    e.preventDefault();
    window.viewOrder(card.dataset.id);
  });

  // Delegated click handlers — action bar buttons
  document.getElementById('detailPanelActions').addEventListener('click', function(e) {
    var btn = e.target.closest('[data-action]');
    if(!btn) return;
    var action = btn.dataset.action;
    var id = btn.dataset.id;
    if(action === 'accept') window.doAccept(id);
    else if(action === 'decline') window.doDecline(id);
    else if(action === 'status') window.doStatus(id, btn.dataset.status);
    else if(action === 'open-kit') openOrderDailyKit(btn.dataset.date || '');
    else if(action === 'blocked') Swal.fire({title:'Preparation Required',text:btn.dataset.message||'Complete departure preparation before going En Route.',icon:'warning',confirmButtonText:'OK'});
  });

  // Setup tabs
  document.getElementById('toStatusTabs').addEventListener('click', function(e){
    if(e.target.tagName==='BUTTON') {
      document.querySelectorAll('#toStatusTabs button').forEach(b=>b.classList.remove('active','btn-primary'));
      document.querySelectorAll('#toStatusTabs button').forEach(b=>b.classList.add('btn-outline-secondary'));
      e.target.classList.add('active','btn-primary');
      e.target.classList.remove('btn-outline-secondary');
      _status = e.target.getAttribute('data-status');
      _page=1;
      fetchOrders();
    }
  });

  document.getElementById('toSearch').addEventListener('keyup', e=>{
    if(e.key==='Enter') { _page=1; fetchOrders(); }
  });

  document.addEventListener('keydown', function(e) {
    if(e.key === 'Escape' && document.getElementById('rightPane').classList.contains('open')) {
      window.closeDetailPanel();
    }
  });

  function updateClock() {
    var now = new Date();
    var h = String(now.getHours()).padStart(2, '0');
    var m = String(now.getMinutes()).padStart(2, '0');
    var el = document.getElementById('orderClock');
    if(el) el.textContent = h + ':' + m;
  }
  setInterval(updateClock, 1000);
  updateClock();

  // Init
  fetchOrders();

})();
</script>
