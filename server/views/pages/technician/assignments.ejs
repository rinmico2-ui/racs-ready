  // ── Photo upload helper ──────────────────────────────────────────────────
  async function uploadPhotos(files, endpoint) {
    if (!files || files.length === 0) return [];
    const formData = new FormData();
    for (const f of files) formData.append('photos', f);
    const resp = await fetch(endpoint, { method: 'POST', body: formData, credentials: 'same-origin' });
    if (!resp.ok) throw new Error('Photo upload failed');
    const data = await resp.json();
    return data.urls || [];
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // INSPECTION MODAL PROGRESS PERSISTENCE (sessionStorage)
  // ═══════════════════════════════════════════════════════════════════════════

  function _saveInspectionState(bookingId) {
    if (!bookingId) return;
    try {
      const state = {
        bookingId,
        savedAt: Date.now(),
        diagnoses: window._inspDiagnoses || [],
        parts: window._inspParts || [],
        inventoryStatus: window._inspInventoryStatus || {},
        wizardStep: window._inspWizardStep || 1,
        fields: {
          laborCost: document.getElementById('quotationLaborCost')?.value || '0',
          laborCategory: document.getElementById('quotationLaborCategory')?.value || 'standard',
          notes: document.getElementById('inspectionNotes')?.value || '',
        }
      };
      sessionStorage.setItem(`inspection_state_${bookingId}`, JSON.stringify(state));
    } catch (e) {
      console.warn('[InspectionState] Could not save state:', e.message);
    }
  }

  function _restoreInspectionState(bookingId) {
    if (!bookingId) return false;
    try {
      const raw = sessionStorage.getItem(`inspection_state_${bookingId}`);
      if (!raw) return false;
      const state = JSON.parse(raw);
      if (!state || !state.savedAt || (Date.now() - state.savedAt) > 4 * 60 * 60 * 1000) {
        sessionStorage.removeItem(`inspection_state_${bookingId}`);
        return false;
      }
      const hasData = (state.diagnoses?.length > 0) || (state.parts?.length > 0);
      if (!hasData) return false;

      window._inspDiagnoses = state.diagnoses || [];
      window._inspParts = state.parts || [];
      window._inspInventoryStatus = state.inventoryStatus || {};
      window._inspWizardStep = state.wizardStep || 1;

      const f = state.fields || {};
      if (f.laborCost) document.getElementById('quotationLaborCost').value = f.laborCost;
      if (f.laborCategory) document.getElementById('quotationLaborCategory').value = f.laborCategory;
      if (f.notes) document.getElementById('inspectionNotes').value = f.notes;

      return true;
    } catch (e) {
      console.warn('[InspectionState] Could not restore state:', e.message);
      return false;
    }
  }

  function _clearInspectionState(bookingId) {
    if (!bookingId) return;
    try {
      sessionStorage.removeItem(`inspection_state_${bookingId}`);
    } catch (e) { /* ignore */ }
  }

  // Auto-save form fields on change
  function _attachInspectionFieldSaveListeners(bookingId) {
    const fieldIds = ['quotationLaborCost', 'quotationLaborCategory', 'inspectionNotes'];
    fieldIds.forEach(id => {
      const el = document.getElementById(id);
      if (el && !el._inspSaveAttached) {
        el.addEventListener('input', () => _saveInspectionState(bookingId));
        el.addEventListener('change', () => _saveInspectionState(bookingId));
        el._inspSaveAttached = true;
      }
    });

    // Save state when inspection modal is closed (X button, backdrop, escape)
    const inspModal = document.getElementById('inspectionModal');
    if (inspModal && !inspModal._closeSaveAttached) {
      inspModal.addEventListener('hidden.bs.modal', function () {
        if (_repairBookingId) _saveInspectionState(_repairBookingId);
      });
      inspModal._closeSaveAttached = true;
    }
  }

  function openInspectionModal(bookingId, customerName, serviceName, assignment) {
    _repairBookingId = bookingId;
    // Always prefer the passed assignment, then _detailAssignment, then fetch from API
    const ctx = assignment || window._detailAssignment;
    if (ctx && ctx.bookingId) {
      window._inspAssignmentContext = ctx;
      _initInspectionModalUI(ctx, serviceName, customerName);
    } else if (ctx) {
      window._inspAssignmentContext = ctx;
      _initInspectionModalUI(ctx, serviceName, customerName);
    } else {
      // Fallback: fetch full assignment data from the API to ensure we have all booking fields
      window._inspAssignmentContext = { serviceName, customerName, address: '' };
      _initInspectionModalUI(window._inspAssignmentContext, serviceName, customerName);
      fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' })
        .then(r => r.json())
        .then(detail => {
          const booking = detail.booking || detail;
          // Merge booking data into the context so payment modal has all required fields
          window._inspAssignmentContext = {
            ...window._inspAssignmentContext,
            bookingId: booking,
            paymentMethod: booking.paymentMethod,
            downpaymentAmount: booking.downpaymentAmount,
            initialCost: booking.initialCost,
            totalPrice: booking.totalPrice,
            estimatedFee: booking.estimatedFee,
            travelFare: booking.travelFare,
            balanceAmount: booking.balanceAmount,
          };
        })
        .catch(() => { });
    }
