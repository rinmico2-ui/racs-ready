    if (!window.Swal || !window.EnterpriseCalendar) {
      showToast('error', 'The scheduling calendar is unavailable. Reload the page and try again.');
      return;
    }
    if (openingOrderSchedule) return;
    openingOrderSchedule = true;
    try {
      const availabilityUrl = `/api/orders/${encodeURIComponent(item.id)}/admin-reschedule-availability`;
      const availability = await fetch(availabilityUrl, { cache:'no-store' });
      const context = await availability.json();
      if (!availability.ok) throw new Error(context.error || 'Could not load scheduling details.');
      const workload = context.scheduling;
      if (!workload) throw new Error('Scheduling details are unavailable. Reload the page and try again.');
      const isProject = workload.isProject === true;
      const customerContact = contactActions(item);
      const result = await Swal.fire({
        title:`${isProject ? 'Reschedule large-scale installation' : item.fulfillmentType === 'delivery_installation' ? 'Reschedule delivery and installation' : 'Reschedule delivery'} · ${escapeHtml(item.reference || 'Order')}`,
        customClass:{ popup:'rc-dialog rc-dialog-schedule' },
