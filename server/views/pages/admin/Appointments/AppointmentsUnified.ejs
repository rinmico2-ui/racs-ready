  <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" style="max-width:720px;margin:auto;">
    <div class="modal-content ent-modal">
      <div class="modal-header ent-modal-header">
        <div class="d-flex align-items-center gap-3">
          <div class="ent-modal-icon bg-warning-subtle"><i class="bi bi-calendar-event text-warning"></i></div>
          <div><h6 class="modal-title fw-bold mb-0">Reschedule Appointment</h6><small class="text-white-50" id="rescheduleBookingRef">--</small></div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body ent-modal-body">
        <div id="rescheduleBody">
          <div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Loading available slots...</p></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function() {
  'use strict';

  var PIPELINE_STAGES = [
    { key: 'pending', label: 'Pending Payment', icon: 'bi-hourglass-split', color: '#f59e0b', bg: '#fef3c7' },
    { key: 'awaiting_assignment', label: 'In Queue', icon: 'bi-clipboard-check', color: '#8b5cf6', bg: '#ede9fe' },
    { key: 'assigned', label: 'Assigned', icon: 'bi-person-check', color: '#6366f1', bg: '#e0e7ff' },
    { key: 'confirmed', label: 'Confirmed', icon: 'bi-check2-circle', color: '#10b981', bg: '#d1fae5' },
    { key: 'on-the-way', label: 'On The Way', icon: 'bi-geo-alt', color: '#06b6d4', bg: '#cffafe' },
    { key: 'in-progress', label: 'In Progress', icon: 'bi-tools', color: '#2563eb', bg: '#dbeafe' },
    { key: 'completed', label: 'Completed', icon: 'bi-trophy', color: '#059669', bg: '#d1fae5' },
    { key: 'expired', label: 'Expired', icon: 'bi-clock-history', color: '#d97706', bg: '#fef3c7' },
  ];

  var STATUS_CLASSES = {
    'pending':'st-pending','payment_verified':'st-payment_verified','awaiting_assignment':'st-awaiting_assignment',
    'assigned':'st-assigned','confirmed':'st-confirmed','on-the-way':'st-on-the-way',
    'arrived':'st-arrived','in-progress':'st-in-progress','completed':'st-completed',
    'rejected':'st-rejected','cancelled':'st-cancelled','expired':'st-expired'
  };

  var RQ_STATUS_LABELS = {
    repair_requested:'New Request',pending_inspection:'Pending Inspection',
    inspection_scheduled:'Inspection Scheduled',inspection_in_progress:'Inspection In Progress',
    inspection_completed:'Diagnosis Completed',awaiting_approval:'Awaiting Approval',
    repair_approved:'Repair Approved',repair_declined:'Repair Declined',
    waiting_parts:'Waiting Parts',parts_reserved:'Parts Reserved',
    ready_for_repair:'Ready for Repair',repair_scheduled:'Repair Scheduled',
    repair_in_progress:'Repair In Progress',repair_completed:'Repair Completed',closed:'Closed'
  };

  var RQ_STATUS_BADGES = {
    repair_requested:'bg-warning text-dark',pending_inspection:'bg-warning text-dark',
    inspection_scheduled:'bg-info text-dark',inspection_in_progress:'bg-primary',
    inspection_completed:'bg-success',awaiting_approval:'bg-danger',
    repair_approved:'bg-success',repair_declined:'bg-danger',
    waiting_parts:'bg-warning text-dark',ready_for_repair:'bg-success',
    repair_scheduled:'bg-primary',repair_in_progress:'bg-primary',
    repair_completed:'bg-success',closed:'bg-secondary'
  };

  var STATUS_LABELS = {
    'confirmed':'Confirmed','scheduled':'Scheduled','on-the-way':'On The Way',
    'arrived':'Arrived','in-progress':'In Progress'
  };

  var STATUS_CLASSES_ACTIVE = {
    'confirmed':'job-confirmed','scheduled':'job-confirmed',
    'on-the-way':'job-on-the-way','arrived':'job-arrived','in-progress':'job-in-progress'
  };

  function formatDate(d) {
    return d ? new Date(d).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '\u2014';
  }
  function formatTime(t) {
    if (!t) return '\u2014';
    var mins = parseInt(t);
    if (isNaN(mins)) return t;
    var h = Math.floor(mins/60), m = mins % 60;
    var ampm = h >= 12 ? 'PM' : 'AM';
    return (h % 12 || 12) + ':' + String(m).padStart(2,'0') + ' ' + ampm;
  }
  function statusLabel(s) {
    return (s||'').replace(/_/g,' ').replace(/-/g,' ').replace(/\b\w/g,function(l){return l.toUpperCase();});
  }

  function showNotification(opts) {
    var type=opts.type||'info',title=opts.title||'',message=opts.message||'',duration=opts.duration||3000;
    var colors={
      success:{bg:'#f0fdf4',border:'#22c55e',icon:'bi-check-circle-fill',iconColor:'#16a34a'},
      error:{bg:'#fef2f2',border:'#ef4444',icon:'bi-x-circle-fill',iconColor:'#dc2626'},
      warning:{bg:'#fffbeb',border:'#f59e0b',icon:'bi-exclamation-triangle-fill',iconColor:'#d97706'},
      info:{bg:'#eff6ff',border:'#3b82f6',icon:'bi-info-circle-fill',iconColor:'#2563eb'}
    };
    var c=colors[type]||colors.info;
    var el=document.createElement('div');
    el.style.cssText='position:fixed;top:20px;right:20px;z-index:99999;min-width:340px;max-width:420px;background:'+c.bg+';border:1px solid '+c.border+';border-left:4px solid '+c.border+';border-radius:12px;padding:16px 20px;box-shadow:0 10px 40px rgba(0,0,0,0.15);display:flex;align-items:flex-start;gap:12px;animation:slideInRight 0.3s ease;';
    el.innerHTML='<i class="bi '+c.icon+'" style="font-size:1.3rem;color:'+c.iconColor+';margin-top:2px;"></i><div style="flex:1;"><div style="font-weight:700;font-size:0.9rem;color:#1e293b;margin-bottom:2px;">'+title+'</div><div style="font-size:0.82rem;color:#64748b;">'+message+'</div></div><button onclick="this.parentElement.remove()" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:1.1rem;padding:0;line-height:1;">&times;</button>';
    document.body.appendChild(el);
    if (!document.getElementById('notif-styles')) {
      var style=document.createElement('style');style.id='notif-styles';
      style.textContent='@keyframes slideInRight{from{transform:translateX(100%);opacity:0;}to{transform:translateX(0);opacity:1;}}';
      document.head.appendChild(style);
    }
    setTimeout(function(){el.style.transition='all 0.3s ease';el.style.opacity='0';el.style.transform='translateX(100%)';setTimeout(function(){el.remove();},300);},duration);
  }
  window.showNotification=showNotification;

  function buildDetailHTML(b,data) {
    var date=new Date(b.preferredDate||b.bookingDate).toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'});
    var isRepair=b.serviceType==='repair'||b.serviceModel==='RepairService';
    var serviceName=b.service?(b.service.name||''):(b.services?b.services.map(function(s){return s.name;}).join(', '):(isRepair?'Repair Service':'N/A'));
    if (!serviceName) serviceName='N/A';
    var stL=statusLabel(b.status);
    var isCOD=b.paymentMethod==='cod';
    var total=b.totalPrice||b.estimatedFee||0;
    var dp=b.downpaymentAmount||(isCOD?400:0);
    var bal=b.balanceAmount>0?b.balanceAmount:(isCOD?Math.max(0,total-dp):0);
    var photos=[];
    if (b.paymentProof) photos.push(b.paymentProof);
    if (data.payment&&data.payment.proofUrl&&photos.indexOf(data.payment.proofUrl)===-1) photos.push(data.payment.proofUrl);
    if (b.imageUrl&&photos.indexOf(b.imageUrl)===-1) photos.push(b.imageUrl);
    if (b.unitInfo&&Array.isArray(b.unitInfo.photos)) b.unitInfo.photos.forEach(function(p){if(p&&photos.indexOf(p)===-1)photos.push(p);});
    var html='<div class="bd-compact-grid">'+
      '<div class="bd-compact-card"><div class="bd-compact-icon bg-primary-subtle"><i class="bi bi-person-fill text-primary"></i></div><div class="bd-compact-content"><span class="bd-compact-label">Customer</span><span class="bd-compact-value">'+(b.customer?b.customer.name:'N/A')+'</span><span class="bd-compact-sub">'+(b.customer?b.customer.email:'')+'</span><span class="bd-compact-sub">'+(b.customer?b.customer.phone:'')+'</span></div></div>'+
      '<div class="bd-compact-card"><div class="bd-compact-icon bg-success-subtle"><i class="bi bi-tools text-success"></i></div><div class="bd-compact-content"><span class="bd-compact-label">Service</span><span class="bd-compact-value">'+serviceName+'</span><span class="bd-compact-sub">'+date+'</span><span class="bd-compact-sub">'+(b.startTime&&b.endTime?b.startTime+' \u2013 '+b.endTime:(b.preferredTime||b.startTime||''))+'</span></div></div>'+
      '<div class="bd-compact-card"><div class="bd-compact-icon bg-warning-subtle"><i class="bi bi-cash-stack text-warning"></i></div><div class="bd-compact-content"><span class="bd-compact-label">Payment</span><span class="bd-compact-value fw-bold">\u20B1'+total.toLocaleString()+'</span><span class="bd-compact-sub">'+(b.paymentMethod||'N/A').toUpperCase()+' \u00B7 '+(b.paymentStatus||'pending')+'</span>'+
      (isCOD?'<div style="margin-top:4px;padding:4px 6px;background:#fffbeb;border-radius:6px;border:1px solid #fde68a;"><div style="font-size:0.68rem;color:#92400e;"><div class="d-flex justify-content-between"><span>Downpayment:</span><span class="fw-semibold">\u20B1'+dp.toLocaleString()+'</span></div><div class="d-flex justify-content-between"><span>Balance (on-site):</span><span class="fw-semibold">\u20B1'+bal.toLocaleString()+'</span></div>'+(b.amountPaid?'<div class="d-flex justify-content-between mt-1 pt-1 border-top" style="border-color:#fde68a !important;"><span>Collected so far:</span><span class="fw-bold text-success">\u20B1'+b.amountPaid.toLocaleString()+'</span></div>':'')+'</div></div>':'')+
      '</div></div>'+
      '<div class="bd-compact-card"><div class="bd-compact-icon bg-dark-subtle"><i class="bi bi-flag-fill text-dark"></i></div><div class="bd-compact-content"><span class="bd-compact-label">Status</span><span class="bd-compact-value"><span class="badge bg-'+(b.paymentStatus==='paid'?'success':'warning')+'">'+stL+'</span></span></div></div>'+
      '<div class="bd-compact-card bd-compact-card-wide"><div class="bd-compact-icon bg-secondary-subtle"><i class="bi bi-geo-alt-fill text-secondary"></i></div><div class="bd-compact-content"><span class="bd-compact-label">Service Location</span><span class="bd-compact-value">'+(b.location?b.location.address:'N/A')+'</span></div></div>';
    if (isRepair&&b.unitInfo) {
      html+='<div class="bd-compact-card bd-compact-card-wide"><div class="bd-compact-icon bg-info-subtle"><i class="bi bi-wrench text-info"></i></div><div class="bd-compact-content"><span class="bd-compact-label">Unit Information</span><span class="bd-compact-value">'+(b.unitInfo.unitType||'')+' '+(b.unitInfo.brand||'')+' '+(b.unitInfo.model||'')+'</span>'+(b.unitInfo.problemDescription?'<span class="bd-compact-sub">'+b.unitInfo.problemDescription+'</span>':'')+'</div></div>';
    }
    if (b.issueDescription) {
      html+='<div class="bd-compact-card bd-compact-card-wide"><div class="bd-compact-icon bg-danger-subtle"><i class="bi bi-exclamation-triangle text-danger"></i></div><div class="bd-compact-content"><span class="bd-compact-label">Issue Description</span><span class="bd-compact-value">'+b.issueDescription+'</span></div></div>';
    }
    if (photos.length>0) {
      html+='<div class="bd-compact-card bd-compact-card-wide"><div class="bd-compact-icon bg-success-subtle"><i class="bi bi-images text-success"></i></div><div class="bd-compact-content" style="width:100%;"><span class="bd-compact-label">Payment Receipt / Photos ('+photos.length+')</span><div class="bd-photo-strip">';
      photos.forEach(function(src,i){
        html+='<div style="background:#f8fafc;padding:6px;border-radius:8px;border:1px solid #e2e8f0;flex:0 0 auto;"><img src="'+src+'" alt="Photo '+(i+1)+'" class="bd-photo-thumb" onclick="showImgLightbox(\''+src+'\')" onerror="this.closest(\'div\').innerHTML=\'Image unavailable\'"><div class="bd-photo-caption">Photo '+(i+1)+' \u00B7 Click to enlarge</div></div>';
      });
      html+='</div></div></div>';
    }
    html+='</div>';
    return html;
  }

  window.showImgLightbox=function(src){
    var overlay=document.createElement('div');
    overlay.className='bd-lightbox-overlay';
    overlay.innerHTML='<div class="bd-lightbox-content"><button class="bd-lightbox-close">&times;</button><img src="'+src+'" alt="Enlarged" onerror="this.parentElement.innerHTML=\'Image unavailable\'"></div>';
    overlay.addEventListener('click',function(e){ if(e.target===overlay){ overlay.remove(); } });
    overlay.querySelector('.bd-lightbox-close').addEventListener('click',function(){ overlay.remove(); });
    document.body.appendChild(overlay);
  };

  var loaded={overview:false,pending:false,queue:false,waiting:false,active:false,completed:false};
  function switchTab(name){
    var p=new URLSearchParams(window.location.search);p.set('tab',name);
    history.replaceState(null,'',window.location.pathname+'?'+p.toString());
    loaded[name]=true;
    loadTab(name);
  }
  function loadTab(tab){
    switch(tab){
      case'overview':AU.Overview.load();break;
      case'pending':AU.Pending.load();AU.Pending.loadRepairStats();AU.Pending.loadRepairRequests();break;
      case'queue':AU.Queue.loadStats();AU.Queue.loadQueue(1);break;
      case'waiting':loadWaitingAcceptTab();break;
      case'active':AU.Active.load();break;
      case'completed':AU.Completed.load();break;
    }
  }

  function loadWaitingAcceptTab(){
    var container=document.getElementById('waitingAcceptContainer');
    container.innerHTML='<div class="text-center py-5 text-muted"><div class="spinner-border text-primary"></div><p class="mt-2">Loading...</p></div>';
    fetch('/api/admin/appointments/waiting-acceptance/list?limit=50').then(function(r){return r.json();}).then(function(data){
      var bookings=data.bookings||[];
      var total=data.pagination?.total||0;
      document.getElementById('waitingAcceptCount').textContent=total+' bookings';
      var badge=document.getElementById('tabWaitingBadge');
      if(badge){badge.textContent=total;badge.style.display=total>0?'inline-block':'none';}

      // KPIs
      var now=Date.now();
      var overdue=bookings.filter(function(b){return b.acceptanceDeadline&&now>new Date(b.acceptanceDeadline).getTime();}).length;
      var kpi=document.getElementById('waitingKpiContainer');
      if(kpi){
        kpi.innerHTML=
          '<div class="col-lg-6 col-md-6"><div class="stat-card h-100" data-spark-color="#f59e0b"><div class="d-flex justify-content-between align-items-start mb-2"><div><h6 class="text-muted mb-1" style="font-size:0.85rem;font-weight:500;">Waiting for Acceptance</h6><div class="d-flex align-items-baseline gap-2"><span class="h3 mb-0 fw-bold text-dark">'+total+'</span><span class="kpi-trend up"><i class="bi bi-arrow-up"></i> 0%</span><span class="kpi-percent-badge">Waiting</span></div><small class="text-muted">Awaiting tech confirmation</small></div><div class="stat-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);"><i class="bi bi-hourglass-split text-white"></i></div></div><div class="stat-sparkline"><canvas height="40"></canvas></div></div></div>'+
          '<div class="col-lg-6 col-md-6"><div class="stat-card h-100" data-spark-color="#ef4444"><div class="d-flex justify-content-between align-items-start mb-2"><div><h6 class="text-muted mb-1" style="font-size:0.85rem;font-weight:500;">Past Deadline</h6><div class="d-flex align-items-baseline gap-2"><span class="h3 mb-0 fw-bold text-dark">'+overdue+'</span><span class="kpi-trend up"><i class="bi bi-arrow-up"></i> 0%</span><span class="kpi-percent-badge">Urgent</span></div><small class="text-muted">Expired acceptance window</small></div><div class="stat-icon" style="background:linear-gradient(135deg,#ef4444,#dc2626);"><i class="bi bi-clock-history text-white"></i></div></div><div class="stat-sparkline"><canvas height="40"></canvas></div></div></div>';
        if(window.AU && window.AU.drawStatSparklines) window.AU.drawStatSparklines(kpi);
      }
      if(!bookings.length){
        container.innerHTML='<div class="text-center py-5 text-muted"><i class="bi bi-check-circle fs-1 d-block mb-2"></i><p>All assigned bookings have been accepted.</p></div>';
        return;
      }
      container.innerHTML='<div style="display:flex;flex-direction:column;gap:10px;">'+bookings.map(function(b){
        var tech=b.technician;
        var assignedAt=b.assignedAt?new Date(b.assignedAt).toLocaleString():'—';
        var bDate=b.bookingDate?new Date(b.bookingDate).toLocaleDateString():'—';
        var deadline=b.acceptanceDeadline?new Date(b.acceptanceDeadline):null;
        var remaining=deadline?(deadline.getTime()-Date.now()):null;
        var deadlineText='No deadline set';
        var deadlineClass='bg-light text-dark';
        if(deadline){
          if(remaining<0){deadlineText='Deadline passed';deadlineClass='bg-danger text-white';}
          else if(remaining<30*60*1000){deadlineText='Expires in '+Math.ceil(remaining/60000)+' min';deadlineClass='bg-warning text-dark';}
          else {deadlineText='Accept by '+deadline.toLocaleString(undefined,{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});deadlineClass='bg-info text-dark';}
        }
        var assignmentId=b.assignmentId||'';
        return '<div style="background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:14px 16px;">'+
          '<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:8px;">'+
            '<div>'+
              '<div style="font-size:.72rem;color:#94a3b8;font-weight:600;">'+(b.bookingReference||b._id.slice(-8).toUpperCase())+'</div>'+
              '<div style="font-size:.95rem;font-weight:700;color:#1e293b;">'+(b.customer?.name||'Unknown')+'</div>'+
              '<div style="font-size:.82rem;color:#64748b;">'+(b.service?.name||'—')+'</div>'+
            '</div>'+
            '<span class="badge '+deadlineClass+'" style="white-space:nowrap;"><i class="bi bi-clock me-1"></i>'+deadlineText+'</span>'+
          '</div>'+
          '<div style="display:flex;flex-wrap:wrap;gap:12px;font-size:.8rem;color:#475569;">'+
            '<span><i class="bi bi-calendar3 me-1" style="color:#94a3b8;"></i>'+bDate+'</span>'+
            '<span><i class="bi bi-clock me-1" style="color:#94a3b8;"></i>'+(b.startTime||'—')+' - '+(b.endTime||'—')+'</span>'+
            '<span><i class="bi bi-geo-alt me-1" style="color:#94a3b8;"></i>'+(b.address||'—')+'</span>'+
          '</div>'+
          (tech?'<div style="display:flex;align-items:center;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid #f1f5f9;">'+
            '<div style="width:28px;height:28px;border-radius:50%;background:#f59e0b;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.7rem;flex-shrink:0;">'+(tech.name||'T')[0].toUpperCase()+'</div>'+
            '<div style="font-size:.78rem;">'+
              '<div style="font-weight:600;color:#1e293b;">'+tech.name+'</div>'+
              '<div style="font-size:.7rem;color:#64748b;">'+(tech.phone||tech.email||'—')+'</div>'+
            '</div>'+
            '<div style="margin-left:auto;display:flex;gap:8px;">'+
              '<button class="au-btn au-btn-outline au-btn-sm" onclick="extendDeadline(\''+assignmentId+'\')"><i class="bi bi-clock-history me-1"></i>Extend</button>'+
              '<button class="au-btn au-btn-primary au-btn-sm" onclick="forceReassign(\''+b._id+'\')"><i class="bi bi-person-plus me-1"></i>Reassign</button>'+
            '</div>'+
          '</div>':'')+
        '</div>';
      }).join('')+'</div>';
    }).catch(function(){
      container.innerHTML='<div class="alert alert-danger small">Failed to load bookings</div>';
    });
  }

  window.extendDeadline = async function(assignmentId){
    var minutes = prompt('Extend deadline by how many minutes?', '60');
    if(!minutes) return;
    try{
      var res = await fetch('/api/admin/appointments/assignments/' + assignmentId + '/extend-deadline', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({minutes: parseInt(minutes)})
      });
      var data = await res.json();
      if(res.ok){ showNotification({type:'success',title:'Deadline Extended',message:'New acceptance deadline saved.',duration:3000}); loadWaitingAcceptTab(); }
      else { showNotification({type:'error',title:'Failed',message:data.error||'Could not extend deadline',duration:4000}); }
    }catch(e){ showNotification({type:'error',title:'Error',message:'Network error',duration:4000}); }
  };

  window.forceReassign = async function(bookingId){
    if(!confirm('Reassign this booking? The current assignment will be expired.')) return;
    try{
      var res = await fetch('/api/admin/appointments/' + bookingId + '/force-reassign', {method:'POST'});
      var data = await res.json();
      if(res.ok){
        showNotification({type:'success',title:'Reassigned',message:'Booking is now available for reassignment.',duration:3000});
        loadWaitingAcceptTab();
        if(AU.Queue){ AU.Queue.loadQueue(1); AU.Queue.loadStats(); }
      } else { showNotification({type:'error',title:'Failed',message:data.error||'Could not reassign',duration:4000}); }
    }catch(e){ showNotification({type:'error',title:'Error',message:'Network error',duration:4000}); }
  };

  window.AU={};

  // â•â•â• OVERVIEW â•â•â•
  AU.Overview={};
  var _ovPage=1,_ovLimit=10;
  var _overviewSearchTimeout=null;

  AU.Overview.load=function(){
    var date=(document.getElementById('filterDate')||{}).value||'';
    Promise.all([
      fetch('/api/admin/appointments/flow-stats').then(function(r){return r.json();}),
      fetch('/api/admin/appointments/list?page=1&limit='+_ovLimit+'&date='+date).then(function(r){return r.json();})
    ]).then(function(res){
      AU.Overview.renderPipeline(res[0].stages);
      AU.Overview.renderKPIs(res[0]);
      AU.Overview.renderTable(res[1].bookings);
      AU.Overview.renderPagination(res[1].pagination);
    }).catch(function(e){console.error('Overview load error:',e);});
  };

  AU.Overview.loadRecent=function(page){
    page=page||1;
    var status=(document.getElementById('statusFilter')||{}).value||'';
    var date=(document.getElementById('filterDate')||{}).value||'';
    var search=(document.getElementById('overviewSearchInput')||{}).value||'';
    fetch('/api/admin/appointments/list?page='+page+'&limit='+_ovLimit+'&status='+status+'&date='+date+'&search='+encodeURIComponent(search))
    .then(function(r){return r.json();}).then(function(data){
      AU.Overview.renderTable(data.bookings);
      AU.Overview.renderPagination(data.pagination);
      _ovPage=data.pagination.page;
    }).catch(function(e){console.error(e);});
  };
  AU.Overview.searchRecent=function(){
    clearTimeout(_overviewSearchTimeout);
    _overviewSearchTimeout=setTimeout(function(){AU.Overview.loadRecent(1);},300);
  };

  AU.Overview.renderPipeline=function(stages){
    var el=document.getElementById('pipeline');if(!el)return;
    el.innerHTML=PIPELINE_STAGES.map(function(s,i){
      var count=(stages[s.key]||{}).count||0;
