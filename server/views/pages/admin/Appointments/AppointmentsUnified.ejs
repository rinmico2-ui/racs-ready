  // ═══ EQUIPMENT ASSIGNMENT ═══
  AU.Equipment={_page:1,_search:'',_loading:false,_toolCache:[]};
  AU.Equipment.load=function(page){
    if(page) this._page=page;
    if(this._loading) return;
    this._loading=true;
    var container=document.getElementById('equipmentTableBody');
    var countEl=document.getElementById('equipmentCount');
    if(container) container.innerHTML='<tr><td colspan="8" class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Loading...</p></td></tr>';
    var params=new URLSearchParams();
    params.set('page',this._page);
    params.set('limit',20);
    var s=document.getElementById('equipmentSearchInput');
    if(s&&s.value) params.set('search',s.value);
    fetch('/api/admin/appointments/equipment-bookings?'+params.toString()).then(function(r){return r.json();}).then(function(d){
      AU.Equipment._loading=false;
      var bookings=d.bookings||[];
      var total=d.pagination?.total||0;
      if(countEl) countEl.textContent=total;
      var badge=document.getElementById('tabEquipmentBadge');
      if(badge){badge.textContent=total;badge.style.display=total>0?'inline-flex':'none';}
      if(!container) return;
      if(!bookings.length){container.innerHTML='<tr><td colspan="8" class="text-center py-5 text-muted"><i class="bi bi-check-circle d-block mb-2" style="font-size:2rem;"></i><p>No bookings need equipment.</p></td></tr>';return;}
      container.innerHTML=bookings.map(function(b){
        var ref=b.bookingReference||b._id.slice(-8).toUpperCase();
        var bDate=b.bookingDate?new Date(b.bookingDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}):'--';
        var time=(b.startTime||'--')+' \u2013 '+(b.endTime||'--');
        var tech=b.technician?.name||'—';
        var assigned=(b.equipmentCount||0)+' item'+(b.equipmentCount===1?'':'s');
        return '<tr>'+
          '<td><strong>'+ref+'</strong></td>'+
          '<td>'+(b.customer?.name||'N/A')+'</td>'+
          '<td>'+(b.service?.name||'--')+'</td>'+
          '<td>'+tech+'</td>'+
          '<td>'+bDate+'</td>'+
          '<td>'+time+'</td>'+
          '<td>'+assigned+'</td>'+
          '<td class="text-center">'+
            '<button class="au-btn au-btn-primary au-btn-sm" onclick="AU.Equipment.openAssignModal(\''+b._id+'\',\''+String(ref).replace(/'/g,'\\\'')+'\')" title="Assign Equipment"><i class="bi bi-tools"></i></button>'+
          '</td></tr>';
      }).join('');
      var pages=d.pagination?.pages||1;
      var page=d.pagination?.page||1;
      var pEl=document.getElementById('equipmentPagination');
      if(pEl){
        var html='';
        if(pages>1){
          html+='<ul class="pagination pagination-sm">';
          for(var i=1;i<=pages;i++){
            html+='<li class="page-item'+(i===page?' active':'')+'"><button class="page-link" onclick="AU.Equipment.load('+i+')">'+i+'</button></li>';
          }
          html+='</ul>';
        }
        pEl.innerHTML=html;
      }
    }).catch(function(){
      AU.Equipment._loading=false;
      if(container) container.innerHTML='<tr><td colspan="8" class="text-center py-3 text-danger">Failed to load equipment bookings</td></tr>';
    });
  };
  AU.Equipment.openAssignModal=function(bookingId, ref){
    document.getElementById('assignEquipmentBookingId').value=bookingId;
    document.getElementById('assignEquipmentSubtitle').textContent='Booking: '+ref;
    document.getElementById('assignEquipmentToolSearch').value='';
    document.getElementById('assignEquipmentToolList').innerHTML='<div class="text-center text-muted py-3">Start typing to search tools</div>';
    document.getElementById('assignEquipmentQty').value=1;
    document.getElementById('assignEquipmentNotes').value='';
    new bootstrap.Modal(document.getElementById('assignEquipmentModal')).show();
