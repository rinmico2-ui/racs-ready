
# App & DB
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname
# Optional local-only fallback when Node cannot resolve Atlas SRV records.
# Obtain these values from the cluster's SRV and TXT DNS records. Do not set on Render unless needed.
# MONGODB_DIRECT_HOSTS=shard-00-00.example.mongodb.net:27017,shard-00-01.example.mongodb.net:27017,shard-00-02.example.mongodb.net:27017
# MONGODB_REPLICA_SET=atlas-example-shard-0
# MONGODB_AUTH_SOURCE=admin

# JWT
JWT_SECRET=your-long-random-secret-here

# Email provider
# Provider selection is automatic: Brevo on Render/production, SMTP locally.
BREVO_API_KEY=your-brevo-api-key
FROM_EMAIL=racsready396@gmail.com
FROM_NAME=CALIDRO RACS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
APP_BASE_URL=http://localhost:5000
APP_URL=http://localhost:5000

# Cal.com
CALCO_API_KEY=cal_live_your_key_here
CALCO_BASE_URL=https://api.cal.com/v2

# ReCAPTCHA
RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET=your-secret-key
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_MAPS_API_KEY=your-maps-key

# OpenRouter
OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# PayMongo
PAYMONGO_SECRET_KEY=sk_live_your_key
PAYMONGO_PUBLIC_KEY=pk_live_your_key
PAYMONGO_WEBHOOK_SECRET=your-webhook-secret

# AI Keys
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=4500
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_OUTPUT_TOKENS=3000
TAVILY_API_KEY=your-tavily-key
