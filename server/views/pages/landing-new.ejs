<%# ══════════════════════════════════════════════════════════════════════════════
    CALIDRO RACS — Enterprise Landing Page
    Modern, animated, professional design
    ══════════════════════════════════════════════════════════════════════════════ %>

<link rel="stylesheet" href="/css/landing-enterprise.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<% const landingStats = (typeof publicStats === 'object' && publicStats) ? publicStats : { servicesCompleted:0, satisfactionPercentage:0, activeTechnicians:0, yearsExperience:0 }; %>

<%# ══════════════════════════════════════════════════════════════════════════════
    SECTION 1: HERO — Immersive Dark Theme with 3D Elements
    ══════════════════════════════════════════════════════════════════════════════ %>
<section class="ent-hero">
  <!-- Background effects -->
  <div class="ent-hero-bg"></div>
  <div class="ent-hero-orb ent-hero-orb-1"></div>
  <div class="ent-hero-orb ent-hero-orb-2"></div>
  <div class="ent-hero-orb ent-hero-orb-3"></div>
  <div class="ent-hero-grid"></div>
  
  <!-- Floating particles -->
  <div class="ent-hero-particles">
    <div class="ent-particle"></div>
    <div class="ent-particle"></div>
    <div class="ent-particle"></div>
    <div class="ent-particle"></div>
    <div class="ent-particle"></div>
    <div class="ent-particle"></div>
    <div class="ent-particle"></div>
    <div class="ent-particle"></div>
    <div class="ent-particle"></div>
    <div class="ent-particle"></div>
  </div>

  <div class="container">
    <div class="row align-items-center">
      <!-- Text Column -->
      <div class="col-lg-6 ent-hero-content">
        <div class="ent-status-badge">
          <span class="ent-status-dot"></span>
          <span class="ent-status-text">Now Accepting Bookings</span>
        </div>
        
        <h1 class="ent-hero-title">
          Smart Appointment Scheduling for
          <span class="ent-gradient-text">Aircon & Home Services</span>
        </h1>
        
        <p class="ent-hero-subtitle">
          CALIDRO RACS delivers reliable air conditioning, CCTV installation, and
          appliance repair — powered by intelligent scheduling and inventory-backed operations.
        </p>
        
        <div class="ent-hero-cta">
          <a href="/services" class="ent-btn-primary">
            Book a Service <i class="bi bi-arrow-right"></i>
          </a>
          <a href="/products" class="ent-btn-secondary">
            <i class="bi bi-box-seam"></i> Browse Products
          </a>
        </div>

        <% const heroStars = Math.round(Number(displayRating) || 0); %>
        <div class="ent-hero-trust">
          <span class="ent-trust-item">
            <span class="ent-trust-stars">
              <% for (let s = 1; s <= 5; s++) { %><i class="bi <%= s <= heroStars ? 'bi-star-fill' : 'bi-star' %>"></i><% } %>
            </span>
            <%= displayRating %>/5 · <%= displayCount %> reviews
          </span>
          <span class="ent-trust-divider"></span>
          <span class="ent-trust-item">
            <i class="bi bi-patch-check-fill"></i> Certified Technicians
          </span>
          <span class="ent-trust-divider"></span>
          <span class="ent-trust-item">
            <i class="bi bi-shield-lock-fill"></i> Licensed & Insured
          </span>
        </div>
      </div>

      <!-- Image Column -->
      <div class="col-lg-6 mt-5 mt-lg-0">
        <div class="ent-hero-visual">
          <div class="ent-hero-image-wrap">
            <img src="/images/technicianWork/tech1.jpg" alt="Professional Technician" class="img-fluid">
            
            <!-- Floating Cards -->
            <div class="ent-float-card ent-float-card-top">
              <div class="ent-float-icon ent-float-icon-green">
                <i class="bi bi-shield-check"></i>
              </div>
              <div class="ent-float-card-text">
                <div class="ent-float-card-title">Certified</div>
                <div class="ent-float-card-sub">Professionals</div>
              </div>
            </div>
            
            <div class="ent-float-card ent-float-card-bottom">
              <div class="ent-float-icon ent-float-icon-blue">
                <i class="bi bi-star-fill"></i>
              </div>
              <div class="ent-float-card-text">
                <div class="ent-float-card-title"><%= displayRating %>/5 Rating</div>
                <div class="ent-float-card-sub"><%= displayCount %> Reviews</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════════════════════
    SECTION 2: STATS — Animated Counters
    ══════════════════════════════════════════════════════════════════════════════ %>
<section class="ent-stats">
  <div class="container">
    <div class="ent-stats-grid">
      <div class="ent-stat-item ent-reveal">
        <div class="ent-stat-number" data-count="<%= landingStats.servicesCompleted %>" data-suffix=""><%= Number(landingStats.servicesCompleted || 0).toLocaleString('en-PH') %></div>
        <div class="ent-stat-label">Services Completed</div>
      </div>
      <div class="ent-stat-item ent-reveal ent-delay-1">
        <div class="ent-stat-number" data-count="<%= landingStats.satisfactionPercentage %>" data-suffix="%"><%= Number(landingStats.satisfactionPercentage || 0) %>%</div>
        <div class="ent-stat-label">Customer Satisfaction</div>
      </div>
      <div class="ent-stat-item ent-reveal ent-delay-2">
        <div class="ent-stat-number" data-count="<%= landingStats.activeTechnicians %>" data-suffix=""><%= Number(landingStats.activeTechnicians || 0).toLocaleString('en-PH') %></div>
        <div class="ent-stat-label">Expert Technicians</div>
      </div>
      <div class="ent-stat-item ent-reveal ent-delay-3">
        <div class="ent-stat-number" data-count="<%= landingStats.yearsExperience %>" data-suffix=""><%= Number(landingStats.yearsExperience || 0).toLocaleString('en-PH') %></div>
        <div class="ent-stat-label">Years Experience</div>
      </div>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════════════════════
    SECTION 3: HOW IT WORKS — Process Flow
    ══════════════════════════════════════════════════════════════════════════════ %>
<section class="ent-section ent-section-light">
  <div class="container">
    <div class="ent-section-header ent-reveal">
      <span class="ent-section-badge">
        <i class="bi bi-diagram-3"></i> Simple Process
      </span>
      <h2 class="ent-section-title">How It <span class="ent-gradient-text">Works</span></h2>
      <p class="ent-section-subtitle">
        Getting professional service is easy. Book in minutes, and we handle the rest.
      </p>
    </div>

    <div class="ent-process-grid">
      <div class="ent-process-card ent-reveal">
        <div class="ent-process-number">1</div>
        <div class="ent-process-icon">
          <i class="bi bi-calendar-check"></i>
        </div>
        <h5 class="ent-process-title">Book Online</h5>
        <p class="ent-process-desc">Choose your service, pick a date and time, and submit your booking request in under 2 minutes.</p>
      </div>

      <div class="ent-process-card ent-reveal ent-delay-1">
        <div class="ent-process-number">2</div>
        <div class="ent-process-icon">
          <i class="bi bi-shield-check"></i>
        </div>
        <h5 class="ent-process-title">Payment Verification</h5>
        <p class="ent-process-desc">Our team verifies your payment and confirms the booking. You'll receive instant notification.</p>
      </div>

      <div class="ent-process-card ent-reveal ent-delay-2">
        <div class="ent-process-number">3</div>
        <div class="ent-process-icon">
          <i class="bi bi-person-gear"></i>
        </div>
        <h5 class="ent-process-title">Technician Assigned</h5>
        <p class="ent-process-desc">A certified technician is assigned and you can track their arrival in real-time.</p>
      </div>

      <div class="ent-process-card ent-reveal ent-delay-3">
        <div class="ent-process-number">4</div>
        <div class="ent-process-icon" style="background: linear-gradient(135deg, #dcfce7, #bbf7d0); border-color: rgba(16,185,129,0.15); color: #16a34a;">
          <i class="bi bi-check2-circle"></i>
        </div>
        <h5 class="ent-process-title">Service Complete</h5>
        <p class="ent-process-desc">Your service is completed, payment is settled, and you can rate your experience.</p>
      </div>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════════════════════
    SECTION 4: FEATURES — Why Choose Us
    ══════════════════════════════════════════════════════════════════════════════ %>
<section class="ent-section ent-section-dark">
  <div class="container">
    <div class="ent-section-header ent-reveal">
      <span class="ent-section-badge ent-section-badge-dark">
        <i class="bi bi-award"></i> Why Choose Us
      </span>
      <h2 class="ent-section-title ent-section-title-dark">Expert Technicians <span class="ent-gradient-text">You Can Trust</span></h2>
      <p class="ent-section-subtitle ent-section-subtitle-dark">
        CALIDRO RACS technicians are trained professionals dedicated to delivering exceptional service.
      </p>
    </div>

    <div class="ent-features-grid">
      <div class="ent-feature-card ent-reveal">
        <div class="ent-feature-icon">
          <i class="bi bi-patch-check-fill"></i>
        </div>
        <h5 class="ent-feature-title">Verified Professionals</h5>
        <p class="ent-feature-desc">Fully trained and certified experts handling your equipment with care and precision.</p>
      </div>

      <div class="ent-feature-card ent-reveal ent-delay-1">
        <div class="ent-feature-icon">
          <i class="bi bi-clock-history"></i>
        </div>
        <h5 class="ent-feature-title">Real-Time Tracking</h5>
        <p class="ent-feature-desc">Stay informed with live updates on your service request and technician arrival.</p>
      </div>

      <div class="ent-feature-card ent-reveal ent-delay-2">
        <div class="ent-feature-icon">
          <i class="bi bi-tag-fill"></i>
        </div>
        <h5 class="ent-feature-title">Transparent Pricing</h5>
        <p class="ent-feature-desc">Clear, upfront costs with no hidden charges or surprises on your bill.</p>
      </div>

      <div class="ent-feature-card ent-reveal ent-delay-3">
        <div class="ent-feature-icon">
          <i class="bi bi-headset"></i>
        </div>
        <h5 class="ent-feature-title">24/7 Support</h5>
        <p class="ent-feature-desc">Our customer support team is always ready to assist you with any questions.</p>
      </div>

      <div class="ent-feature-card ent-reveal ent-delay-4">
        <div class="ent-feature-icon">
          <i class="bi bi-tools"></i>
        </div>
        <h5 class="ent-feature-title">Quality Parts</h5>
        <p class="ent-feature-desc">We use only genuine, high-quality parts for all repairs and installations.</p>
      </div>

      <div class="ent-feature-card ent-reveal ent-delay-5">
        <div class="ent-feature-icon">
          <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h5 class="ent-feature-title">Service Warranty</h5>
        <p class="ent-feature-desc">All our services come with a satisfaction guarantee and warranty coverage.</p>
      </div>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════════════════════
    SECTION 5: SERVICES — What We Offer
    ══════════════════════════════════════════════════════════════════════════════ %>
<section class="ent-section ent-section-light">
  <div class="container">
    <div class="ent-section-header ent-reveal">
      <span class="ent-section-badge">
        <i class="bi bi-snow2"></i> Our Services
      </span>
      <h2 class="ent-section-title">Everything Your <span class="ent-gradient-text">Home Needs</span></h2>
      <p class="ent-section-subtitle">
        From professional air conditioning solutions to expert appliance repairs, we keep your home running comfortably.
      </p>
    </div>

    <div class="ent-services-grid">
      <% 
      const services = [
        { name: 'Aircon Installation', img: '/images/technicianWork/tech2.jpg', type: 'Core Service' },
        { name: 'Aircon Cleaning', img: '/images/technicianWork/tech1.jpg', type: 'Core Service' },
        { name: 'Freon Recharging', img: '/images/technicianWork/tech3.jpg', type: 'Core Service' },
        { name: 'Aircon Relocation', img: '/images/technicianWork/tech4.jpg', type: 'Core Service' },
        { name: 'Refrigerator Repair', img: '/images/bgphotos/ref.jpg', type: 'Repair' },
        { name: 'Washing Machine', img: '/images/bgphotos/washing machine.jpg', type: 'Repair' },
        { name: 'Microwave Oven', img: '/images/bgphotos/microwave.jpg', type: 'Repair' },
        { name: 'Water Dispenser', img: '/images/bgphotos/waterdispenser.jpg', type: 'Repair' }
      ];
      services.forEach((svc, idx) => { %>
        <div class="ent-service-card ent-reveal ent-delay-<%= idx % 4 %>">
          <div class="ent-service-image">
            <img src="<%= svc.img %>" alt="<%= svc.name %>" loading="lazy">
            <span class="ent-service-chip"><%= svc.type %></span>
            <div class="ent-service-overlay">
              <a href="/services" class="ent-btn-primary" style="padding: 10px 20px; font-size: 0.85rem;">
                Book Now <i class="bi bi-arrow-right"></i>
              </a>
            </div>
          </div>
          <div class="ent-service-body">
            <h5 class="ent-service-title"><%= svc.name %></h5>
            <span class="ent-service-price">View Details →</span>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="text-center mt-5 ent-reveal">
      <a href="/services" class="ent-btn-primary">
        View All Services <i class="bi bi-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════════════════════
    SECTION 6: TESTIMONIALS
    ══════════════════════════════════════════════════════════════════════════════ %>
<section class="ent-section ent-section-dark">
  <div class="container">
    <div class="ent-section-header ent-reveal">
      <span class="ent-section-badge ent-section-badge-dark">
        <i class="bi bi-chat-quote"></i> Testimonials
      </span>
      <h2 class="ent-section-title ent-section-title-dark">What Our <span class="ent-gradient-text">Customers Say</span></h2>
      <p class="ent-section-subtitle ent-section-subtitle-dark">
        Don't just take our word for it — hear from our satisfied customers.
      </p>
    </div>

    <div class="row g-4">
      <% 
      const testimonials = [
        { name: 'Maria Santos', role: 'Homeowner', text: 'Excellent service! The technician arrived on time and fixed my aircon quickly. Very professional and courteous.', initials: 'MS' },
        { name: 'Juan dela Cruz', role: 'Business Owner', text: 'We use CALIDRO RACS for all our office AC maintenance. Reliable, affordable, and always on schedule.', initials: 'JC' },
        { name: 'Ana Reyes', role: 'Homeowner', text: 'My refrigerator was repaired same day. Great communication throughout the process. Highly recommend!', initials: 'AR' }
      ];
      testimonials.forEach((t, idx) => { %>
        <div class="col-md-4 ent-reveal ent-delay-<%= idx %>">
          <div class="ent-testimonial-card h-100">
            <div class="ent-testimonial-stars">
              <i class="bi bi-star-fill"></i>
              <i class="bi bi-star-fill"></i>
              <i class="bi bi-star-fill"></i>
              <i class="bi bi-star-fill"></i>
              <i class="bi bi-star-fill"></i>
            </div>
            <p class="ent-testimonial-text">"<%= t.text %>"</p>
            <div class="ent-testimonial-author">
              <div class="ent-testimonial-avatar"><%= t.initials %></div>
              <div>
                <div class="ent-testimonial-name"><%= t.name %></div>
                <div class="ent-testimonial-role"><%= t.role %></div>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════════════════════
    SECTION 7: FAQ
    ══════════════════════════════════════════════════════════════════════════════ %>
<section class="ent-section ent-section-light">
  <div class="container">
    <div class="ent-section-header ent-reveal">
      <span class="ent-section-badge">
        <i class="bi bi-question-circle"></i> FAQ
      </span>
      <h2 class="ent-section-title">Frequently Asked <span class="ent-gradient-text">Questions</span></h2>
      <p class="ent-section-subtitle">
        Find answers to common questions about our services.
      </p>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="accordion" id="faqAccordion">
          <% 
          const faqs = [
            { q: 'How do I book a service?', a: 'Simply visit our Services page, select the service you need, choose your preferred date and time, and complete the booking form. You\'ll receive a confirmation email once your booking is verified.' },
            { q: 'What areas do you serve?', a: 'We currently serve San Leonardo, Nueva Ecija and surrounding areas. Contact us to check if we cover your location.' },
            { q: 'How much does aircon cleaning cost?', a: 'Pricing varies based on the type and size of your aircon unit. Visit our Services page for detailed pricing or request a quote.' },
            { q: 'Do you offer emergency services?', a: 'Yes, we offer emergency repair services for urgent situations. Contact us directly for immediate assistance.' },
            { q: 'What payment methods do you accept?', a: 'We accept cash, GCash, bank transfer, and major credit/debit cards for your convenience.' }
          ];
          faqs.forEach((faq, idx) => { %>
            <div class="accordion-item border-0 mb-3 rounded-4 overflow-hidden shadow-sm ent-reveal ent-delay-<%= idx % 3 %>" style="background: #fff;">
              <h2 class="accordion-header">
                <button class="accordion-button <%= idx !== 0 ? 'collapsed' : '' %> fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq<%= idx %>" style="background: #fff; color: #0f172a;">
                  <i class="bi bi-question-circle me-2 text-primary"></i>
                  <%= faq.q %>
                </button>
              </h2>
              <div id="faq<%= idx %>" class="accordion-collapse collapse <%= idx === 0 ? 'show' : '' %>" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-secondary">
                  <%= faq.a %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════════════════════
    SECTION 8: CONTACT / FIND US
    ══════════════════════════════════════════════════════════════════════════════ %>
<section class="ent-section ent-section-dark" style="padding-bottom: 120px;">
  <div class="container">
    <div class="ent-section-header ent-reveal">
      <span class="ent-section-badge ent-section-badge-dark">
        <i class="bi bi-geo-alt"></i> Contact Us
      </span>
      <h2 class="ent-section-title ent-section-title-dark">Find <span class="ent-gradient-text">Us</span></h2>
      <p class="ent-section-subtitle ent-section-subtitle-dark">
        Visit our location in <%= locals.companyAddress || 'San Leonardo, Nueva Ecija' %>
      </p>
    </div>

    <div class="row g-4 align-items-stretch">
      <!-- Contact Info -->
      <div class="col-lg-5 ent-reveal">
        <div class="h-100 p-4 rounded-4" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); backdrop-filter: blur(10px);">
          <div class="d-flex align-items-center gap-3 mb-4 pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.06);">
            <div class="d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; border-radius: 1rem; background: linear-gradient(135deg, #3b82f6, #2563eb); box-shadow: 0 8px 20px rgba(59,130,246,0.4);">
              <i class="bi bi-geo-alt-fill fs-4 text-white"></i>
            </div>
            <h3 class="fw-bold mb-0 text-white" style="font-size: 1.25rem;">Our Location</h3>
          </div>

          <div class="d-flex flex-column gap-3">
            <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
              <div class="d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; border-radius: 0.75rem; background: rgba(59,130,246,0.15); border: 1px solid rgba(59,130,246,0.2);">
                <i class="bi bi-geo-alt-fill" style="color: #60a5fa;"></i>
              </div>
              <div>
                <h6 class="fw-bold mb-0 text-white" style="font-size: 0.9rem;">Address</h6>
                <span style="color: rgba(203,213,225,0.6); font-size: 0.82rem;"><%= locals.companyAddress || 'San Leonardo, Nueva Ecija' %></span>
              </div>
            </div>

            <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
              <div class="d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; border-radius: 0.75rem; background: rgba(59,130,246,0.15); border: 1px solid rgba(59,130,246,0.2);">
                <i class="bi bi-telephone-fill" style="color: #60a5fa;"></i>
              </div>
              <div>
                <h6 class="fw-bold mb-0 text-white" style="font-size: 0.9rem;">Phone</h6>
                <a href="tel:<%= (locals.companyPhone || '09656056495').replace(/\s/g, '') %>" class="text-decoration-none" style="color: rgba(203,213,225,0.6); font-size: 0.82rem;"><%= locals.companyPhone || '09656056495' %></a>
              </div>
            </div>

            <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
              <div class="d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; border-radius: 0.75rem; background: rgba(59,130,246,0.15); border: 1px solid rgba(59,130,246,0.2);">
                <i class="bi bi-envelope-fill" style="color: #60a5fa;"></i>
              </div>
              <div>
                <h6 class="fw-bold mb-0 text-white" style="font-size: 0.9rem;">Email</h6>
                <a href="mailto:<%= locals.companyEmail || 'calidroracs@gmail.com' %>" class="text-decoration-none" style="color: rgba(203,213,225,0.6); font-size: 0.82rem;"><%= locals.companyEmail || 'calidroracs@gmail.com' %></a>
              </div>
            </div>

            <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
              <div class="d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; border-radius: 0.75rem; background: rgba(59,130,246,0.15); border: 1px solid rgba(59,130,246,0.2);">
                <i class="bi bi-clock-fill" style="color: #60a5fa;"></i>
              </div>
              <div>
                <h6 class="fw-bold mb-0 text-white" style="font-size: 0.9rem;">Working Hours</h6>
                <span style="color: rgba(203,213,225,0.6); font-size: 0.82rem;"><%= (locals.businessHours && businessHours.summary) || 'Mon–Sat · 8:00 AM – 6:00 PM' %></span>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3" style="border-top: 1px solid rgba(255,255,255,0.04);">
            <a href="#" class="ent-btn-primary w-100 justify-content-center">
              <i class="bi bi-facebook"></i> Visit our Facebook Page
            </a>
          </div>
        </div>
      </div>

      <!-- Map -->
      <div class="col-lg-7 ent-reveal ent-delay-1">
        <div class="h-100 rounded-4 overflow-hidden" style="min-height: 450px; border: 1px solid rgba(255,255,255,0.06);">
          <iframe
