        </div>
      </div>
      ${!scheduledDate && schedulingStatus === 'pending' ? `<div class="alert alert-info py-2 px-3 mb-0" style="font-size:0.8rem;border-radius:8px;"><i class="bi bi-info-circle me-1"></i>Waiting for admin to confirm the repair schedule. The customer's preferred dates have been submitted.</div>` : ''}
      ${scheduledDate ? `<div class="alert alert-success py-2 px-3 mb-0" style="font-size:0.8rem;border-radius:8px;"><i class="bi bi-check-circle me-1"></i>Repair has been scheduled. Proceed to the job on the scheduled date.</div>` : ''}
    </div>`;
    }

    function fmtAddr(addr) {
      if (!addr) return '—';
      if (typeof addr === 'string') {
        if (addr === '[object Object]' || addr.startsWith('{')) return '—';
        return addr;
      }
      if (typeof addr === 'object') {
        return [addr.barangay, addr.city, addr.province, addr.postalCode].filter(Boolean).join(', ') || '—';
      }
      return String(addr);
    }

    function renderInvoicePage(a) {
      const b = a.bookingId || {};
      const isRepair = (a.bookingId?.serviceType === 'repair') || (a.services && a.services.some(s => s.type === 'repair'));
      const workOrder = b.workOrderNumber || 'N/A';
      const serviceName = b.service?.name || b.serviceId?.name || a.serviceName || 'Service';

      let grandTotal = 0;
      let chargesHtml = '';

      if (isRepair) {
        const q = b.quotation || {};
        const inspFee = b.inspectionFeeTotalCollected || b.initialCost || a.initialCost || 0;
        const travelFee = b.travelFare || 0;
        const laborCost = q.laborCost || 0;
        const partsTotal = (q.parts || []).reduce((sum, p) => sum + ((p.cost || p.unitPrice || p.price || 0) * (p.quantity || 1)), 0);
        const quotationTotal = q.totalCost || (partsTotal + laborCost);
        grandTotal = inspFee + travelFee + quotationTotal;

        const insp = b.inspection || {};
        const diag = b.diagnosis || {};

        chargesHtml = `
          ${inspFee > 0 ? `<div class="detail-row"><label><i class="bi bi-search me-1"></i>Inspection Fee</label><span>₱${Number(inspFee).toLocaleString()}</span></div>` : ''}
          ${travelFee > 0 ? `<div class="detail-row"><label><i class="bi bi-geo-alt me-1"></i>Travel Fee</label><span>₱${Number(travelFee).toLocaleString()}</span></div>` : ''}
          ${(q.parts || []).length ? q.parts.map(p => {
            const unitPrice = p.cost || p.unitPrice || p.price || 0;
            const qty = p.quantity || 1;
            return `<div class="detail-row"><label>${p.name || p.partName || 'Part'}</label><span>${qty} × ₱${Number(unitPrice).toLocaleString()} = ₱${Number(unitPrice * qty).toLocaleString()}</span></div>`;
          }).join('') : ''}
          ${laborCost > 0 ? `<div class="detail-row"><label><i class="bi bi-tools me-1"></i>Labor</label><span>₱${Number(laborCost).toLocaleString()}</span></div>` : ''}
          ${q.notes ? `<div class="detail-row"><label>Quotation Notes</label><span style="font-size:0.82rem;color:#64748b;">${q.notes}</span></div>` : ''}`;
      } else {
        // For non-repair bookings, try booking fields first, then fall back to
        // the sum of actual Payment records (totalPrice is only set for multi-service).
        const svcPrice = a.totalPrice || a.estimatedFee || b.totalPrice || b.estimatedFee || b.totalCost || 0;
        grandTotal = svcPrice;
        chargesHtml = `<div class="detail-row"><label><i class="bi bi-wrench me-1"></i>Service Fee</label><span>₱${Number(grandTotal).toLocaleString()}</span></div>`;
      }

      // ── Compute paid/balance from Payment records when totals are zero ──
      const payments = a.payments || [];
      const paymentsTotal = payments.reduce((s, p) => s + Number(p.amount || 0), 0);

      // If grandTotal is 0 but payments exist, derive total from payments
      if (grandTotal <= 0 && paymentsTotal > 0) {
        grandTotal = paymentsTotal;
        if (!isRepair) {
          chargesHtml = `<div class="detail-row"><label><i class="bi bi-wrench me-1"></i>Service Fee</label><span>₱${Number(grandTotal).toLocaleString()}</span></div>`;
        }
      }

      const storedBalance = a.balanceAmount ?? b.balanceAmount;
      const amountPaid = b.amountPaid || a.amountPaid || 0;
      const calculatedBalance = Math.max(0, grandTotal - paymentsTotal);
      const balanceDue = paymentsTotal > 0
        ? calculatedBalance
        : (Number.isFinite(storedBalance) && storedBalance > 0 ? storedBalance : Math.max(0, grandTotal - amountPaid));
      const totalPaid = grandTotal - balanceDue;
      const warrantyEnd = b.warranty?.endDate ? new Date(b.warranty.endDate).toLocaleDateString('en-PH') : null;
      const serviceIcon = isRepair ? 'bi-tools' : 'bi-wrench';

      // Build individual payment records from a.payments
      const payTypeLabels = { downpayment: 'Downpayment', final: 'Final Payment', inspection: 'Inspection Fee', adjustment: 'Adjustment' };
      const payStatusColors = { verified: '#059669', paid: '#059669', waiting_for_remittance: '#d97706', remitted: '#2563eb', rejected: '#dc2626', refunded: '#64748b', pending: '#94a3b8', partial: '#d97706', payment_collected: '#059669', failed: '#dc2626' };
      const payStatusLabels = { waiting_for_remittance: 'Awaiting Remittance', payment_collected: 'Collected', verified: 'Verified', paid: 'Paid', remitted: 'Remitted', rejected: 'Rejected', refunded: 'Refunded', pending: 'Pending', partial: 'Partial', failed: 'Failed' };

      let paymentsHtml = '';
      if (payments.length > 0) {
        paymentsHtml = payments.map(p => {
          const pType = payTypeLabels[p.type] || p.type || 'Payment';
          const pMethod = (p.method || 'cash').toUpperCase();
          const pAmount = Number(p.amount || 0);
          const pDate = p.collectedAt ? new Date(p.collectedAt).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
          const pStatus = payStatusLabels[p.status] || p.status || '—';
          const pColor = payStatusColors[p.status] || '#64748b';
          const pRef = p.reference ? `<span style="font-size:0.72rem;color:#94a3b8;">Ref: ${p.reference}</span>` : '';
          return `<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f1f5f9;">
            <div>
              <div style="font-size:0.82rem;font-weight:600;color:#334155;">${pType} <span style="font-size:0.72rem;font-weight:500;color:#94a3b8;">via ${pMethod}</span></div>
              <div style="font-size:0.72rem;color:#94a3b8;">${pDate} ${pRef}</div>
            </div>
            <div style="text-align:right;">
              <div style="font-size:0.85rem;font-weight:700;color:#059669;">₱${pAmount.toLocaleString()}</div>
              <span style="font-size:0.68rem;font-weight:600;color:${pColor};background:${pColor}18;padding:1px 6px;border-radius:4px;">${pStatus}</span>
            </div>
          </div>`;
        }).join('');
      } else {
        // Fallback: show summary from booking fields if no payment records
        const downpayment = b.downpaymentAmount || a.downpaymentAmount || 0;
        const inspPaid = b.inspectionFeeTotalCollected || 0;
        const repairPaid = b.repairPaymentAmount || 0;
        const hasAnyPaid = downpayment > 0 || inspPaid > 0 || repairPaid > 0 || amountPaid > 0;
        if (hasAnyPaid) {
          paymentsHtml = '';
          if (downpayment > 0) paymentsHtml += `<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f1f5f9;"><div><div style="font-size:0.82rem;font-weight:600;color:#334155;">Downpayment <span style="font-size:0.72rem;font-weight:500;color:#94a3b8;">via ${(b.paymentMethod || 'cash').toUpperCase()}</span></div></div><div style="font-size:0.85rem;font-weight:700;color:#059669;">₱${Number(downpayment).toLocaleString()}</div></div>`;
          if (inspPaid > 0) paymentsHtml += `<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f1f5f9;"><div><div style="font-size:0.82rem;font-weight:600;color:#334155;">Inspection Fee</div></div><div style="font-size:0.85rem;font-weight:700;color:#059669;">₱${Number(inspPaid).toLocaleString()}</div></div>`;
          if (repairPaid > 0) paymentsHtml += `<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f1f5f9;"><div><div style="font-size:0.82rem;font-weight:600;color:#334155;">Repair Payment</div></div><div style="font-size:0.85rem;font-weight:700;color:#059669;">₱${Number(repairPaid).toLocaleString()}</div></div>`;
        } else {
          paymentsHtml = '<div style="text-align:center;padding:12px;color:#94a3b8;font-size:0.82rem;">No payments recorded yet</div>';
        }
      }

      return `<div>
      <div class="detail-section" style="border-color:#c7d2fe;background:#eef2ff;">
        <div class="detail-section-header"><i class="bi bi-file-earmark-text" style="color:#4f46e5;"></i><h6 style="color:#4f46e5;">Invoice</h6></div>
        <div class="detail-section-body">
          <div class="detail-row"><label>Work Order</label><span style="font-weight:700;font-size:0.85rem;">${workOrder}</span></div>
          <div class="detail-row"><label>Service</label><span style="font-size:0.82rem;"><i class="bi ${serviceIcon} me-1"></i>${serviceName}</span></div>
          <div class="detail-row"><label>Date</label><span style="font-size:0.82rem;">${b.completedAt ? new Date(b.completedAt).toLocaleDateString('en-PH') : new Date().toLocaleDateString('en-PH')}</span></div>
          <div class="detail-row"><label>Customer</label><span style="font-size:0.82rem;">${b.customer?.name || a.customerName || 'N/A'}</span></div>
          <div class="detail-row"><label>Address</label><span style="font-size:0.82rem;">${fmtAddr(b.customer?.address || b.address || a.address || '')}</span></div>
        </div>
      </div>

      <div class="detail-section">
        <div class="detail-section-header"><i class="bi bi-receipt" style="color:#2563eb;"></i><h6>Charges</h6></div>
        <div class="detail-section-body">
          ${chargesHtml}
          <div class="detail-row" style="border-top:2px solid #f1f5f9;padding-top:8px;margin-top:4px;"><label style="font-weight:800;color:#334155;">Total Amount</label><span style="font-weight:800;font-size:1.05rem;color:#2563eb;">₱${Number(grandTotal).toLocaleString()}</span></div>
        </div>
      </div>

      <div class="detail-section">
        <div class="detail-section-header"><i class="bi bi-cash-stack" style="color:#059669;"></i><h6>Payments Received</h6></div>
        <div class="detail-section-body">
          ${paymentsHtml}
          <div style="margin-top:8px;padding-top:8px;border-top:2px solid #f1f5f9;">
            <div class="detail-row"><label style="font-weight:700;">Total Paid</label><span style="font-weight:700;color:${balanceDue <= 0 ? '#059669' : '#d97706'};">₱${Number(totalPaid).toLocaleString()} / ₱${Number(grandTotal).toLocaleString()}</span></div>
            ${balanceDue > 0
              ? `<div class="detail-row"><label style="font-weight:700;">Balance Due</label><span style="font-weight:700;color:#d97706;">₱${Number(balanceDue).toLocaleString()}</span></div>`
              : `<div class="detail-row"><label style="font-weight:700;">Status</label><span style="font-weight:700;color:#059669;">Fully Paid</span></div>`
            }
          </div>
        </div>
      </div>

      ${warrantyEnd ? `<div class="alert alert-success py-2 px-3 mb-0" style="font-size:0.8rem;border-radius:8px;"><i class="bi bi-shield-check me-1"></i>Warranty valid until ${warrantyEnd}</div>` : ''}
    </div>`;
    }

    function renderRatingPage(a) {
      const b = a.bookingId || {};
      const rating = a.customerRating || b.customerRating;
      const comment = a.customerRatingComment || b.customerRatingComment;
      if (!rating) {
        return `<div><div class="wizard-empty-state"><i class="bi bi-star"></i><div class="ws-title">No Rating Yet</div><div class="ws-desc">The customer has not submitted a rating for this service.</div></div></div>`;
      }
      const stars = '★'.repeat(rating) + '☆'.repeat(5 - rating);
      const ratingColor = rating >= 4 ? '#059669' : rating >= 3 ? '#d97706' : '#dc2626';
      return `<div>
      <div class="detail-section" style="border-color:#fef3c7;background:#fffbeb;">
        <div class="detail-section-header"><i class="bi bi-star-fill" style="color:#f59e0b;"></i><h6>Customer Rating</h6></div>
        <div class="detail-section-body" style="text-align:center;padding:20px;">
          <div style="font-size:2.5rem;letter-spacing:4px;color:${ratingColor};margin-bottom:8px;">${stars}</div>
          <div style="font-size:1.5rem;font-weight:800;color:${ratingColor};margin-bottom:4px;">${rating}/5</div>
          ${comment ? `<div style="margin-top:12px;padding:12px 16px;background:#fff;border:1px solid #e2e8f0;border-radius:10px;font-size:0.82rem;color:#475569;line-height:1.5;text-align:left;">"${comment}"</div>` : ''}
        </div>
      </div>
    </div>`;
    }

    /**
     * Returns true if the technician is allowed to go "en route" for this assignment.
     * Rule: booking date must be today (or in the past), AND current time >= startTime.
     */
    function canEnRoute(a) {
      return true; // TEMPORARILY DISABLED - always allow en route
    }

    /**
     * Returns a human-readable label for when en route becomes available.
     */
    function enRouteAvailableLabel(a) {
      if (!a.bookingDate) return '';
      const bookingDate = new Date(a.bookingDate);
      const now = new Date();
      const todayMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0, 0);
      const bookingMidnight = new Date(bookingDate.getFullYear(), bookingDate.getMonth(), bookingDate.getDate(), 0, 0, 0, 0);
      if (bookingMidnight > todayMidnight) {
        return bookingDate.toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric' }) + (a.startTime ? ' at ' + a.startTime : '');
      }
      return a.startTime ? 'at ' + a.startTime : '';
    }

    const PILL = {
      pending_acceptance: { bg: '#fef3c7', text: '#92400e' },
      accepted: { bg: '#dbeafe', text: '#1e40af' },
      en_route: { bg: '#cffafe', text: '#155e75' },
      on_site: { bg: '#ede9fe', text: '#4c1d95' },
      in_progress: { bg: '#dbeafe', text: '#1e40af' },
      completed: { bg: '#dcfce7', text: '#065f46' },
      cancelled: { bg: '#f1f5f9', text: '#334155' },
      declined: { bg: '#fee2e2', text: '#991b1b' },
      no_show: { bg: '#f1f5f9', text: '#334155' },
      available: { bg: '#dcfce7', text: '#065f46' }
    };
    const esc = (s) => s ? String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;') : '';
    const getDayMonth = (v) => {
      if (!v) return { day: '—', month: '' };
      const d = new Date(v);
      if (isNaN(d.getTime())) return { day: '—', month: '' };
      return { day: d.getDate(), month: d.toLocaleDateString('en-PH', { month: 'short' }) };
    };

    function renderCard(a, isCurrentJob) {
      const date = a.bookingDate ? new Date(a.bookingDate).toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric' }) : '';
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const isToday = a.bookingDate && new Date(a.bookingDate).toDateString() === today.toDateString();
      const isRepair = isRepairAssignment(a);
      const bs = a.bookingId?.status || a.bookingStatus;

      // Determine accent color based on status
      const accentColors = {
        pending_acceptance: '#f59e0b',
        accepted: '#3b82f6',
        en_route: '#06b6d4',
        on_site: '#8b5cf6',
        in_progress: '#2563eb',
        completed: '#10b981',
        cancelled: '#94a3b8',
        declined: '#ef4444',
        no_show: '#94a3b8'
      };
      const accentColor = accentColors[a.status] || '#e2e8f0';

      // Service type badge
      const serviceItems = Array.isArray(a.services) ? a.services : [];
      const isMixed = a.serviceType === 'mixed' ||
        (serviceItems.some(item => item.type === 'core') && serviceItems.some(item => item.type === 'repair'));
      const serviceBadge = a.serviceType === 'project'
        ? '<span class="mw-service-badge" style="background:rgba(99,102,241,0.12);color:#4338ca;"><i class="bi bi-building me-1"></i>Project</span>'
        : isMixed
          ? '<span class="mw-service-badge" style="background:#f3e8ff;color:#6b21a8;"><i class="bi bi-layers me-1"></i>Core + Repair</span>'
          : isRepair
          ? '<span class="mw-service-badge repair"><i class="bi bi-tools me-1"></i>Repair</span>'
          : '<span class="mw-service-badge core"><i class="bi bi-wrench me-1"></i>Core</span>';

      // Active/Today label chips
      let labelChips = '';
      if (isCurrentJob) labelChips += '<span style="font-size:0.58rem;font-weight:800;letter-spacing:0.08em;padding:3px 8px;border-radius:6px;background:rgba(59,130,246,0.15);color:#1e40af;text-transform:uppercase;">Active</span>';
      if (a.bookingReference) labelChips += `<span style="font-size:0.58rem;font-weight:800;letter-spacing:0.06em;padding:3px 8px;border-radius:6px;background:#f1f5f9;color:#475569;text-transform:uppercase;">${esc(a.bookingReference)}</span>`;
      if (isToday && !isCurrentJob) labelChips += '<span class="pulse-today" style="font-size:0.65rem;font-weight:800;letter-spacing:0.08em;padding:4px 10px;border-radius:6px;background:#f59e0b;color:#fff;text-transform:uppercase;"><i class="bi bi-star-fill me-1"></i> Today</span>';
      if (a.serviceType === 'project') labelChips += '<span style="font-size:0.58rem;font-weight:800;letter-spacing:0.08em;padding:3px 8px;border-radius:6px;background:rgba(99,102,241,0.15);color:#4338ca;text-transform:uppercase;"><i class="bi bi-building me-1"></i>Project Assignment</span>';
      // Show "Repair Execution" chip for Phase 2 assignments (booking status starts with repair_ or is ready_for_repair)
      const isPhase2 = isRepair && (bs?.startsWith?.('repair_') || bs === 'ready_for_repair');
      if (isPhase2) labelChips += '<span style="font-size:0.58rem;font-weight:800;letter-spacing:0.08em;padding:3px 8px;border-radius:6px;background:rgba(220,38,38,0.12);color:#991b1b;text-transform:uppercase;border:1px solid rgba(220,38,38,0.2);"><i class="bi bi-tools me-1"></i>Execution</span>';
      // Past-date handling (mirrors admin overdue logic)
      const _terminal = ['completed', 'cancelled', 'declined', 'no_show', 'no_show_reported'];
      const _effStatus = a.isRepairBooking ? (a.bookingStatus || bs) : a.status;
      let missedSchedule = false;
      if (a.bookingDate && !_terminal.includes(_effStatus)) {
        const _dayEnd = new Date(a.bookingDate); _dayEnd.setHours(23, 59, 59, 999);
        if (_dayEnd.getTime() < Date.now()) missedSchedule = true;
      }
      if (missedSchedule) labelChips += '<span style="font-size:0.58rem;font-weight:800;letter-spacing:0.08em;padding:3px 8px;border-radius:6px;background:#fef3c7;color:#92400e;text-transform:uppercase;"><i class="bi bi-alarm-fill me-1"></i>Missed Schedule</span>';

      return `
      <div class="assign-card ${isCurrentJob ? 'active-assignment' : ''} ${isToday ? 'today-booking' : ''}" 
           style="--card-accent:${accentColor};" onclick="showDetail('${a._id}')">
        <div class="assign-card-inner">
          <div class="assign-card-header">
            <div style="flex:1;min-width:0;">
              <div class="d-flex align-items-center gap-2 flex-wrap" style="margin-bottom:4px;">
                <span class="priority-dot priority-${a.priority || 'normal'}"></span>
                <h6 class="assign-card-title">${a.customerName || 'Customer'}</h6>
                ${labelChips}
              </div>
              <div class="d-flex align-items-center gap-2">
                <p class="assign-card-subtitle" style="margin:0;">${isMixed ? `${serviceItems.length} Services` : (a.serviceName || 'Service')}</p>
                ${serviceBadge}
              </div>
            </div>
            <span class="badge ${a.isRepairBooking ? (statusColors[a.bookingStatus] || 'bg-secondary') : (statusColors[a.status] || 'bg-secondary')}">${a.isRepairBooking ? (statusLabels[a.bookingStatus] || a.bookingStatus) : (statusLabels[a.status] || a.status)}</span>
          </div>
          <div class="assign-card-meta">
            ${a.isRepairBooking && a.unitInfo ? `<div class="assign-card-detail"><i class="bi bi-cpu"></i> <strong>${a.unitInfo.brand || ''} ${a.unitInfo.unitType || ''}</strong></div>` : ''}
            ${a.isRepairBooking && a.quotation?.totalCost ? `<div class="assign-card-detail"><i class="bi bi-cash"></i> <strong>₱${Number(a.quotation.totalCost).toLocaleString()}</strong></div>` : ''}
            ${!a.isRepairBooking ? `<div class="assign-card-detail"><i class="bi bi-calendar-event"></i> <strong>${date || 'TBD'}</strong></div>` : ''}
            ${!a.isRepairBooking ? `<div class="assign-card-detail"><i class="bi bi-clock"></i> ${a.startTime || 'N/A'}</div>` : ''}
            ${a.address ? `<div class="assign-card-detail"><i class="bi bi-geo-alt"></i> <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${a.address.substring(0, 40)}${a.address.length > 40 ? '...' : ''}</span></div>` : ''}
            ${(() => {
          // Compute correct revenue: repairs = inspectionFee + quotation, core = totalPrice
          const _isRepair = a.serviceType === 'repair' || (a.services && Array.isArray(a.services) && a.services.some(s => s.type === 'repair'));
          let _revenue = 0;
          if (a.computedRevenue) {
            _revenue = a.computedRevenue;
          } else if (_isRepair) {
            const inspFee = a.bookingInspectionFeeCollected || a.bookingInitialCost || a.initialCost || 0;
            const quotTotal = a.bookingQuotationTotal || 0;
            _revenue = inspFee + quotTotal;
          } else {
            _revenue = a.bookingTotalPrice || a.totalPrice || a.estimatedFee || 0;
          }
          return _revenue > 0 ? `<div class="assign-card-detail"><i class="bi bi-cash"></i> <strong>₱${Number(_revenue).toLocaleString()}</strong></div>` : '';
        })()}
            ${(() => {
              const _pmtTotal = (a.payments || []).reduce((s, p) => s + Number(p.amount || 0), 0);
              const _isR = a.serviceType === 'repair' || (a.services && Array.isArray(a.services) && a.services.some(s => s.type === 'repair'));
              let _totalAmt = 0;
              if (a.computedRevenue) { _totalAmt = a.computedRevenue; }
              else if (_isR) { _totalAmt = (a.bookingInspectionFeeCollected || a.bookingInitialCost || a.initialCost || 0) + (a.bookingQuotationTotal || 0); }
              else { _totalAmt = a.bookingTotalPrice || a.totalPrice || a.estimatedFee || 0; }
              const _calcBal = _pmtTotal > 0 ? Math.max(0, _totalAmt - _pmtTotal) : (a.balanceAmount || 0);
              const _isPaid = _calcBal <= 0 && _pmtTotal > 0;
              if (_pmtTotal > 0 && !_isPaid) return `<div class="assign-card-detail" style="color:#d97706;"><i class="bi bi-exclamation-triangle" style="background:#fef3c7;color:#d97706;"></i> <strong>₱${Number(_calcBal).toLocaleString()} due</strong></div>`;
              if (_isPaid || (['cod','cash','cash_onsite','gcash_downpayment'].includes(a.paymentMethod) && a.balanceCollected)) return '<div class="assign-card-detail" style="color:#16a34a;"><i class="bi bi-check-circle-fill" style="background:#dcfce7;color:#16a34a;"></i> Fully Paid</div>';
              return '';
            })()}
          </div>
          ${a.cancellationReason && a.status === 'cancelled' ? `<div class="mt-3 p-2" style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;font-size:0.78rem;color:#991b1b;"><i class="bi bi-exclamation-circle me-1"></i>${a.cancellationReason}</div>` : ''}
          <div class="assign-card-actions">
            ${(() => {
          // ── Repair Booking Actions (unified enterprise workflow) ──
          if (a.isRepairBooking || isRepair) {
            const ta = a.techAction;
            const bs = a.bookingId?.status || a.bookingStatus;
            const bookingId = a.bookingId?._id || a.bookingId;
            // Determine techAction from booking status for regular assignments
            let effectiveAction = ta;
            if (!effectiveAction && bs) {
              if (['repair_scheduled', 'ready_for_repair', 'parts_reserved'].includes(bs)) effectiveAction = 'ready';
              else if (bs === 'waiting_parts') effectiveAction = 'waiting_parts';
              else if (['awaiting_approval', 'repair_approved'].includes(bs)) effectiveAction = 'waiting_schedule';
              else if (['repair_in_progress'].includes(bs)) effectiveAction = 'in_progress';
              else if (['on-the-way', 'arrived'].includes(bs) && !['en_route', 'on_site'].includes(a.status)) effectiveAction = 'in_progress';
            }
            if (effectiveAction === 'ready') {
              return `<button class="btn btn-sm btn-primary" onclick="event.stopPropagation();repairEnRoute('${bookingId}')"><i class="bi bi-geo-alt me-1"></i>En Route</button>
                          <button class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-eye me-1"></i>Details</button>`;
            } else if (effectiveAction === 'waiting_parts') {
              return `<span class="badge" style="background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;font-size:0.72rem;padding:5px 10px;"><i class="bi bi-hourglass-split me-1"></i>Waiting for Parts</span>
                          <button class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-eye me-1"></i>Details</button>`;
            } else if (effectiveAction === 'waiting_schedule') {
              return `<span class="badge" style="background:#fffbeb;color:#92400e;border:1px solid #fde68a;font-size:0.72rem;padding:5px 10px;"><i class="bi bi-calendar-clock me-1"></i>Awaiting Schedule</span>
                          <button class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-eye me-1"></i>Details</button>`;
            } else if (effectiveAction === 'in_progress') {
              return `<button class="btn btn-sm btn-success" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-tools me-1"></i>Continue</button>`;
            }
            // Fallback: for en_route / on_site in repair workflow
            if (a.status === 'en_route') {
              return `<button type="button" class="btn btn-sm btn-primary" onclick="event.stopPropagation();repairTransition('${bookingId}','on_site',this)"><i class="bi bi-building me-1"></i>Arrived</button>`;
            }
            if (a.status === 'on_site') {
              const hasQuotation = !!(a.quotation?.createdAt || a.bookingId?.quotation?.createdAt) ||
                ['repair_scheduled', 'ready_for_repair', 'repair_in_progress', 'repair_completed', 'under_warranty'].includes(bs);
              if (hasQuotation) {
                return `<button type="button" class="btn btn-sm btn-primary" onclick="event.stopPropagation();repairTransition('${bookingId}','in_progress',this)"><i class="bi bi-gear me-1"></i>Start Work</button>`;
              } else {
                return `<button class="btn btn-sm btn-primary" onclick="event.stopPropagation();transitionStatus('${a._id}','in_progress',this)"><i class="bi bi-gear me-1"></i>Start Work</button>`;
              }
            }
            return `<button class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-eye me-1"></i>Details</button>`;
          }

          // ── Regular Assignment Actions ──
          const hideCardBtns = a.status === 'en_route' && isRepair;
          if (hideCardBtns) {
            return `<button class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-eye me-1"></i>View Details</button>`;
          }
          const needsPayment2 = ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && !a.balanceCollected && (a.balanceAmount || 0) > 0;
          let btns = '';
          if (a.status === 'pending_acceptance') {
            btns += `<button class="btn btn-sm btn-success" onclick="event.stopPropagation();acceptAssign('${a._id}',this);"><i class="bi bi-check-lg me-1"></i>Accept</button>`;
            btns += `<button class="btn btn-sm btn-outline-danger" onclick="event.stopPropagation();declineAssign('${a._id}',this);"><i class="bi bi-x-lg me-1"></i>Decline</button>`;
          } else if (a.status === 'accepted') {
            if (missedSchedule) {
              btns += `<span class="badge bg-warning text-dark" style="font-size:0.72rem;padding:5px 10px;"><i class="bi bi-alarm-fill me-1"></i>Missed Schedule — awaiting reschedule</span>`;
            } else {
              const kitReady = ['confirmed', 'in_progress'].includes(window._dailyKitStatus);
              if (kitReady) {
                btns += `<button class="btn btn-sm btn-success" onclick="event.stopPropagation();transitionStatus('${a._id}','en_route',this);"><i class="bi bi-sign-turn-right me-1"></i>En Route</button>`;
              } else {
                btns += `<button class="btn btn-sm btn-primary" onclick="event.stopPropagation();openDailyKitModal();" title="Complete Daily Preparation before going En Route"><i class="bi bi-briefcase me-1"></i>Open Daily Preparation</button>`;
              }
            }
          } else if (a.status === 'on_site') {
            btns += `<button class="btn btn-sm btn-success" onclick="event.stopPropagation();transitionStatus('${a._id}','in_progress',this);"><i class="bi bi-play-fill me-1"></i>Start Work</button>`;
            btns += `<button class="btn btn-sm btn-warning text-dark" onclick="event.stopPropagation();openCustomerNotAvailable('${a._id}',this);"><i class="bi bi-person-x me-1"></i>Customer Not Available</button>`;
          } else if (a.status === 'waiting_for_customer') {
            btns += `<button class="btn btn-sm btn-outline-warning" onclick="event.stopPropagation();openCustomerNotAvailable('${a._id}',this,'resume');"><i class="bi bi-clock-history me-1"></i>Waiting Timer</button>`;
          } else if (a.status === 'no_show_reported') {
            btns += `<span class="badge bg-danger" style="font-size:0.72rem;padding:5px 10px;"><i class="bi bi-person-exclamation me-1"></i>No-Show Reported</span>`;
          } else if (a.status === 'in_progress' && needsPayment2) {
            btns += `<button class="btn btn-sm btn-warning" onclick="event.stopPropagation();showDetail('${a._id}');"><i class="bi bi-cash-stack me-1"></i>Collect & Complete</button>`;
          } else if (a.status === 'in_progress') {
            btns += `<button class="btn btn-sm btn-success" onclick="event.stopPropagation();showDetail('${a._id}');"><i class="bi bi-check-circle me-1"></i>Complete</button>`;
          }
          btns += `<button class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-eye me-1"></i>Details</button>`;
          return btns;
        })()}
          </div>
        </div>
      </div>`;
    }

    function renderCustomerCard(a, isCurrentJob) {
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const isToday = a.bookingDate && new Date(a.bookingDate).toDateString() === today.toDateString();
      const dm = getDayMonth(a.bookingDate);
      const title = a.serviceName || 'Service';
      // Mixed/repair bookings can span multiple visits (Phase 1 install +
      // inspection, Phase 2 scheduled repair), each with its own Assignment.
      // A finished Phase 1 visit's Assignment is "completed", but the booking
      // itself is still in progress — fall back to the booking-level status
      // so the card doesn't falsely read "Completed". However, once a newer
      // sibling Assignment exists for the same booking (e.g. the Phase 2
      // repair visit) and is still active, that sibling already carries the
      // current status — so this completed visit should keep showing
      // "Completed" instead of duplicating the sibling's status text.
      const hasActiveSiblingAssignment = Array.isArray(window.allItems) && window.allItems.some(other =>
        String(other._id) !== String(a._id) &&
        String(other.bookingId?._id || other.bookingId || '') === String(a.bookingId?._id || a.bookingId || '') &&
        other.status !== 'completed'
      );
      const usesBookingStatus = (a.status !== 'completed' || !hasActiveSiblingAssignment) &&
        (a.isRepairBooking || isRepairAssignment(a) || isMixedAssignment(a));
      const s = usesBookingStatus ? (a.bookingStatus || a.bookingId?.status || a.status) : (a.status || 'available');
      const statusText = statusLabels[s] || s;
      const p = PILL[s] || { bg: '#f1f5f9', text: '#334155' };
      // Past-date handling (mirrors admin AppointmentsUnified overdue logic):
      // if the scheduled day has fully passed and the job isn't finished
      // (completed/cancelled/declined/no-show), surface it as missed.
      const TERMINAL_STATUSES = ['completed', 'cancelled', 'declined', 'no_show', 'no_show_reported'];
      let missedSchedule = false;
      if (a.bookingDate && !TERMINAL_STATUSES.includes(s)) {
        const dayEnd = new Date(a.bookingDate); dayEnd.setHours(23, 59, 59, 999);
        if (dayEnd.getTime() < Date.now()) missedSchedule = true;
      }
      const time = a.startTime || 'N/A';
      const address = a.address ? (a.address.length > 26 ? a.address.slice(0, 26) + '…' : a.address) : 'No address';
      const cust = a.customerName || 'Customer';
      return `
      <div class="assign-card tjc ${isCurrentJob ? 'tjc-live' : ''} ${isToday ? 'today' : ''}" data-id="${a._id}" onclick="showDetail('${a._id}')">
        <div class="tjc-date"><div class="tjc-date-day">${dm.day}</div><div class="tjc-date-month">${dm.month}</div></div>
        <div class="tjc-main">
          <div class="tjc-top"><div class="tjc-title">${esc(title)}</div><span class="tjc-status" style="background:${p.bg};color:${p.text};">${esc(statusText)}</span>${missedSchedule ? '<span class="tjc-status" style="background:#fef3c7;color:#92400e;"><i class="bi bi-alarm-fill me-1"></i>Missed Schedule</span>' : ''}</div>
          <div class="tjc-meta"><span><i class="bi bi-clock me-1"></i>${esc(time)}</span><span><i class="bi bi-geo-alt me-1"></i>${esc(address)}</span></div>
          <div class="tjc-meta"><span><i class="bi bi-person me-1"></i>${esc(cust)}</span>${isCurrentJob ? '<span class="tjc-live-badge"><span class="tjc-pulse"></span>Live</span>' : ''}${missedSchedule ? '<span style="font-size:0.68rem;color:#92400e;"><i class="bi bi-info-circle me-1"></i>Scheduled time passed — awaiting reschedule</span>' : ''}</div>
        </div>
        <div class="tjc-action"><button class="tjc-view" onclick="event.stopPropagation();showDetail('${a._id}')">View <i class="bi bi-arrow-right"></i></button></div>
      </div>`;
    }

    function renderAvailableJob(b) {
      const date = b.bookingDate ? new Date(b.bookingDate).toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric' }) : '';
      return `
      <div class="assign-card" style="--card-accent:#10b981;">
        <div class="assign-card-inner">
          <div class="assign-card-header">
            <div style="flex:1;min-width:0;">
              <div class="d-flex align-items-center gap-2 flex-wrap" style="margin-bottom:4px;">
                <span class="priority-dot priority-${b.priority || 'normal'}"></span>
                <h6 class="assign-card-title">${b.customerName || 'Customer'}</h6>
                <span style="font-size:0.58rem;font-weight:800;letter-spacing:0.08em;padding:3px 8px;border-radius:6px;background:rgba(16,185,129,0.12);color:#065f46;text-transform:uppercase;">Available</span>
              </div>
              <div class="d-flex align-items-center gap-2">
                <p class="assign-card-subtitle" style="margin:0;">${b.serviceName || 'Service'}</p>
                <span class="mw-service-badge core"><i class="bi bi-wrench me-1"></i>${b.serviceType === 'repair' ? 'Repair' : 'Core'}</span>
              </div>
            </div>
          </div>
          <div class="assign-card-meta">
            <div class="assign-card-detail"><i class="bi bi-calendar-event"></i> <strong>${date || 'TBD'}</strong></div>
            <div class="assign-card-detail"><i class="bi bi-clock"></i> ${b.startTime || 'N/A'}</div>
            ${b.address ? `<div class="assign-card-detail"><i class="bi bi-geo-alt"></i> <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${b.address.substring(0, 40)}${b.address.length > 40 ? '...' : ''}</span></div>` : ''}
            ${(() => {
          const _isRepairB = b.serviceType === 'repair' || (b.services && Array.isArray(b.services) && b.services.some(s => s.type === 'repair'));
          let _revenueB = 0;
          if (_isRepairB) {
            const inspFeeB = b.inspectionFeeTotalCollected || b.initialCost || 0;
            const quotTotalB = (b.quotation && b.quotation.totalCost) || 0;
            _revenueB = inspFeeB + quotTotalB;
          } else {
            _revenueB = b.totalPrice || b.estimatedFee || 0;
          }
          return _revenueB > 0 ? `<div class="assign-card-detail"><i class="bi bi-cash"></i> <strong>₱${Number(_revenueB).toLocaleString()}</strong></div>` : '';
        })()}
          </div>
          <div class="assign-card-actions">
            <button class="btn btn-sm btn-success" onclick="event.stopPropagation();acceptAvailableJob('${b._id}','${(b.customerName || '').replace(/'/g, "\\'")}',this)">
              <i class="bi bi-check-lg me-1"></i>Accept Job
            </button>
          </div>
        </div>
      </div>`;
    }

    function renderEmpty() {
      return `<div class="mw-animate-fade-in" style="text-align:center;padding:56px 24px;background:#fff;border:1px solid #e2e8f0;border-radius:16px;">
        <div style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,#f1f5f9,#e2e8f0);display:inline-flex;align-items:center;justify-content:center;margin-bottom:20px;">
          <i class="bi bi-inbox" style="font-size:1.8rem;color:#94a3b8;"></i>
        </div>
        <h6 style="font-weight:700;color:#334155;margin-bottom:6px;font-size:1rem;">No assignments found</h6>
        <p style="color:#94a3b8;font-size:0.85rem;margin:0 0 16px;max-width:320px;margin-left:auto;margin-right:auto;">Try adjusting your search or filter criteria to find what you're looking for.</p>
        <button class="btn btn-sm btn-outline-primary" onclick="document.getElementById('searchInput').value='';document.getElementById('sortSelect').value='newest';document.getElementById('dateFilter').value='';document.getElementById('todayBtn')?.classList.remove('active');loadAssignments('all',1,'');" style="border-radius:10px;font-weight:600;">
          <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
        </button>
      </div>`;
    }

    let assignmentsLoadSequence = 0;
    let repairQueueCache = { items: [], loadedAt: 0, promise: null };
    let tabCountsCache = { loadedAt: 0, promise: null };
    const ASSIGNMENTS_CACHE_TTL = 30000;

    async function getSupplementalRepairItems(force = false) {
      const cacheIsFresh = Date.now() - repairQueueCache.loadedAt < ASSIGNMENTS_CACHE_TTL;
      if (!force && cacheIsFresh) return repairQueueCache.items;
      if (repairQueueCache.promise) return repairQueueCache.promise;

      repairQueueCache.promise = fetch('/api/technician/dashboard/overview', { credentials: 'same-origin' })
        .then(response => response.ok ? response.json() : { repairQueue: [] })
        .then(dashData => {
          repairQueueCache.items = (dashData.repairQueue || []).map(r => ({
            _id: r._id,
            bookingId: r.bookingId,
            customerName: r.customerName,
            serviceName: r.serviceName || 'Repair Service',
            serviceType: 'repair',
            status: r.assignmentStatus || 'pending_acceptance',
            bookingStatus: r.bookingStatus,
            address: '',
            startTime: '',
            bookingDate: r.createdAt,
            unitInfo: r.unitInfo,
            quotation: r.quotation,
            techAction: r.techAction,
            isRepairBooking: true,
          }));
          repairQueueCache.loadedAt = Date.now();
          return repairQueueCache.items;
        })
        .catch(() => repairQueueCache.items)
        .finally(() => { repairQueueCache.promise = null; });

      return repairQueueCache.promise;
    }

    async function loadAssignments(status = 'all', page = 1, search = '') {
      if (status === 'available') return loadAvailableJobs();
      const loadSequence = ++assignmentsLoadSequence;
      try {
        const container = document.getElementById('assignmentsContainer');
        container.innerHTML = '<div class="text-center py-5 text-muted"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 mb-0 small">Loading assignments...</p></div>';
        document.getElementById('jobCardNav').style.display = 'none';

        const dateFilter = document.getElementById('dateFilter')?.value || '';
        const sortValue = document.getElementById('sortSelect')?.value || 'newest';
        let url = `/api/technician/assignments?status=${status}&page=${page}&limit=20&sort=${encodeURIComponent(sortValue)}`;
        if (search) url += `&search=${encodeURIComponent(search)}`;
        if (dateFilter) url += `&date=${encodeURIComponent(dateFilter)}`;

        // Supplemental repair stages are only displayed by these three tabs.
        // Other tabs no longer wait for the dashboard overview endpoint.
        const needsSupplementalRepairs = status === 'all' || status === 'pending_acceptance' || status === 'active';
        const [assignRes, repairItems] = await Promise.all([
          fetch(url, { credentials: 'same-origin' }),
          needsSupplementalRepairs ? getSupplementalRepairItems() : Promise.resolve([]),
        ]);

        if (!assignRes.ok) throw new Error('Failed');
        const data = await assignRes.json();
        if (loadSequence !== assignmentsLoadSequence) return;
        allItems = data.items || [];

        // Filter repairs based on current filter
        let filteredRepairs = repairItems;
        if (status === 'pending_acceptance') {
          filteredRepairs = repairItems.filter(r => r.techAction === 'waiting_parts' || r.techAction === 'waiting_schedule');
        } else if (status === 'active') {
          filteredRepairs = repairItems.filter(r => r.techAction === 'ready' || r.techAction === 'in_progress');
        } else if (status && status !== 'all' && status !== 'available') {
          filteredRepairs = [];
        }

        // Apply date filter to supplemental repairs (same as API does for real assignments)
        if (dateFilter && filteredRepairs.length) {
          const dStart = new Date(dateFilter); dStart.setHours(0, 0, 0, 0);
          const dEnd = new Date(dateFilter); dEnd.setHours(23, 59, 59, 999);
          filteredRepairs = filteredRepairs.filter(r => {
            const bd = r.bookingDate ? new Date(r.bookingDate) : null;
            return bd && bd >= dStart && bd <= dEnd;
          });
        }

        // Apply search filter to supplemental repairs
        if (search && filteredRepairs.length) {
          const q = search.toLowerCase();
          filteredRepairs = filteredRepairs.filter(r =>
            (r.customerName && r.customerName.toLowerCase().includes(q)) ||
            (r.serviceName && r.serviceName.toLowerCase().includes(q)) ||
            (r.address && r.address.toLowerCase().includes(q))
          );
        }

        // The dashboard repair queue is a supplemental feed for repair stages
        // that have no live Assignment. Never synthesize a second card for a
        // booking already returned by /assignments.
        const assignedBookingIds = new Set(allItems.map(item => String(item.bookingId?._id || item.bookingId || '')).filter(Boolean));
        filteredRepairs = filteredRepairs.filter(item => !assignedBookingIds.has(String(item.bookingId?._id || item.bookingId || '')));

        // Merge: supplemental repairs first, then real assignments.
        allItems = [...filteredRepairs, ...allItems];

        // Filter out completed assignments when there's an active sibling assignment
        // for the same booking (e.g., Phase 1 completed, Phase 2 active)
        const completedToHide = new Set();
        for (const item of allItems) {
          if (item.status === 'completed') {
            const bookingId = String(item.bookingId?._id || item.bookingId || '');
            const hasActiveSibling = allItems.some(other =>
              String(other._id) !== String(item._id) &&
              String(other.bookingId?._id || other.bookingId || '') === bookingId &&
              other.status !== 'completed'
            );
            if (hasActiveSibling) {
              completedToHide.add(String(item._id));
            }
          }
        }
        allItems = allItems.filter(item => !completedToHide.has(String(item._id)));

        window.allItems = allItems;
        window._allAssignments = allItems;

        if (allItems.length === 0) {
          container.innerHTML = renderEmpty();
          document.getElementById('jobCardNav').style.display = 'none';
        } else {
          cardPage = 0;
          renderCardPage();
        }

        document.getElementById('countAll').textContent = (data.total || 0) + filteredRepairs.length;
        fetchTabCounts(true);
        if (window._updateWorkKpis) window._updateWorkKpis();
      } catch (e) {
        if (loadSequence !== assignmentsLoadSequence) return;
        document.getElementById('assignmentsContainer').innerHTML = '<div class="alert alert-danger">Failed to load assignments</div>';
      }
    }

    async function loadAvailableJobs() {
      const loadSequence = ++assignmentsLoadSequence;
      try {
        const container = document.getElementById('assignmentsContainer');
        container.innerHTML = '<div style="text-align:center;padding:48px 24px;background:#fff;border:1px solid #e8ecf1;border-radius:16px;"><div class="spinner-border" style="width:2rem;height:2rem;color:#10b981;" role="status"></div><p style="color:#94a3b8;font-size:0.82rem;margin:12px 0 0;">Loading available jobs...</p></div>';

        const res = await fetch('/api/technician/available-jobs', { credentials: 'same-origin' });
        if (!res.ok) throw new Error('Failed');
        const data = await res.json();
        if (loadSequence !== assignmentsLoadSequence) return;
        allItems = data.items || [];

        document.getElementById('countAvailable').textContent = data.total || 0;

        if (data.reason === 'capacity_full') {
          container.innerHTML = '<div class="text-center py-5 text-muted"><i class="bi bi-exclamation-circle" style="font-size:2.5rem;color:#f59e0b;"></i><p class="mt-2 fw-bold">Maximum Capacity Reached</p><p class="text-muted" style="font-size:0.85rem;">You already have 3 active assignments. Complete or cancel one before accepting new jobs.</p></div>';
          document.getElementById('jobCardNav').style.display = 'none';
        } else if (data.reason === 'on_leave') {
          container.innerHTML = '<div class="text-center py-5 text-muted"><i class="bi bi-calendar-x" style="font-size:2.5rem;color:#dc2626;"></i><p class="mt-2 fw-bold">On Leave</p><p class="text-muted" style="font-size:0.85rem;">You are currently on approved leave. No jobs can be accepted.</p></div>';
          document.getElementById('jobCardNav').style.display = 'none';
        } else if (allItems.length === 0) {
          container.innerHTML = '<div style="text-align:center;padding:48px 24px;background:#fff;border:1px solid #e8ecf1;border-radius:16px;"><div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#f0fdf4,#dcfce7);display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;"><i class="bi bi-briefcase" style="font-size:1.6rem;color:#10b981;"></i></div><h6 style="font-weight:700;color:#1e293b;margin-bottom:4px;">No available jobs</h6><p style="color:#94a3b8;font-size:0.82rem;margin:0;">When a booking becomes available, it will appear here.</p></div>';
          document.getElementById('jobCardNav').style.display = 'none';
        } else {
          cardPage = 0;
          renderCardPage();
        }
      } catch (e) {
        if (loadSequence !== assignmentsLoadSequence) return;
        document.getElementById('assignmentsContainer').innerHTML = '<div class="alert alert-danger">Failed to load available jobs</div>';
      }
    }

    async function fetchTabCounts(force = false) {
      const cacheIsFresh = Date.now() - tabCountsCache.loadedAt < ASSIGNMENTS_CACHE_TTL;
      if (!force && cacheIsFresh) return;
      if (tabCountsCache.promise) return tabCountsCache.promise;

      tabCountsCache.promise = Promise.all([
          fetch('/api/technician/assignments?limit=1').then(r => r.json()),
          fetch('/api/technician/assignments?status=pending_acceptance&limit=1').then(r => r.json()),
          fetch('/api/technician/assignments?status=active&limit=1').then(r => r.json()),
          fetch('/api/technician/assignments?status=completed&limit=1').then(r => r.json()),
          fetch('/api/technician/assignments?status=declined&limit=1').then(r => r.json()),
          fetch('/api/technician/assignments?status=cancelled&limit=1').then(r => r.json()),
          fetch('/api/technician/available-jobs').then(r => r.json()),
        ]).then(([all, pending, active, completed, declined, cancelled, available]) => {
        document.getElementById('countAll').textContent = all.total || 0;
        document.getElementById('countPending').textContent = pending.total || 0;
        document.getElementById('countActive').textContent = active.total || 0;
        document.getElementById('countCompleted').textContent = completed.total || 0;
        document.getElementById('countDeclined').textContent = declined.total || 0;
        document.getElementById('countCancelled').textContent = cancelled.total || 0;
        document.getElementById('countAvailable').textContent = available.total || 0;
        tabCountsCache.loadedAt = Date.now();
      }).catch(() => {}).finally(() => { tabCountsCache.promise = null; });

      return tabCountsCache.promise;
    }

    let cardPage = 0;
    const CARDS_PER_PAGE = 3;

    function renderCardPage() {
      const container = document.getElementById('assignmentsContainer');
      const nav = document.getElementById('jobCardNav');
      const rangeEl = document.getElementById('jobCardRange');
      const prevBtn = document.getElementById('jobCardPrev');
      const nextBtn = document.getElementById('jobCardNext');

      if (!allItems || allItems.length === 0) {
        container.innerHTML = renderEmpty();
        nav.style.display = 'none';
        return;
      }

      const totalPages = Math.ceil(allItems.length / CARDS_PER_PAGE);
      if (cardPage >= totalPages) cardPage = totalPages - 1;
      if (cardPage < 0) cardPage = 0;

      const start = cardPage * CARDS_PER_PAGE;
      const end = Math.min(start + CARDS_PER_PAGE, allItems.length);
      const pageItems = allItems.slice(start, end);

      container.innerHTML = pageItems.map(a => {
        const isCurrentJob = a.status === 'en_route' || a.status === 'in_progress' || a.status === 'on_site';
        return renderCustomerCard(a, isCurrentJob);
      }).join('');

      if (totalPages <= 1) {
        nav.style.display = 'none';
      } else {
        nav.style.display = 'flex';
        rangeEl.textContent = `${start + 1} – ${end} of ${allItems.length}`;
        prevBtn.disabled = cardPage === 0;
        nextBtn.disabled = cardPage >= totalPages - 1;
      }
    }

    // Daily Preparation loads independently from assignments. This hook lets
    // its result refresh accepted cards without duplicating assignment logic.
    window.refreshAssignmentCardsForPreparation = renderCardPage;

    window.jobCardPage = function (dir) {
      cardPage += dir;
      renderCardPage();
    };

    function renderPagination() {
      renderCardPage();
    }

    function updateCurrentJobBanner_deleted() {
      // Removed - workflow tracker is now in the detail panel
    }


    window.goPage = function (p) { currentPage = p; loadAssignments(currentFilter, currentPage, document.getElementById('searchInput').value); };
    window.reloadAssignments = function () {
      return loadAssignments(currentFilter, currentPage, document.getElementById('searchInput').value);
    };

    // Tab clicks
    document.querySelectorAll('#assignTabs .mw-tab').forEach(btn => {
      btn.addEventListener('click', function () {
        document.querySelectorAll('#assignTabs .mw-tab').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentFilter = this.dataset.filter;
        currentPage = 1;
        loadAssignments(currentFilter, currentPage, document.getElementById('searchInput').value);
      });
    });

    // Date Filter change
    document.getElementById('dateFilter')?.addEventListener('change', function () {
      // If user manually changes the date picker, deactivate Today button
      const todayBtn = document.getElementById('todayBtn');
      if (todayBtn && todayBtn.classList.contains('active') && this.value !== todayISO()) {
        todayBtn.classList.remove('active');
      }
      currentPage = 1;
      loadAssignments(currentFilter, currentPage, document.getElementById('searchInput').value);
    });

    // Sort change
    document.getElementById('sortSelect')?.addEventListener('change', function () {
      currentPage = 1;
      loadAssignments(currentFilter, currentPage, document.getElementById('searchInput').value);
    });

    // ── Today's Jobs Button ──
    function todayISO() {
      const d = new Date();
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }
    function updateTodayBadge(count) {
      const badge = document.getElementById('todayBadge');
      const btn = document.getElementById('todayBtn');
      if (badge) badge.textContent = count || 0;
      if (btn) {
        btn.classList.toggle('has-jobs', count > 0);
      }
    }
    window.toggleTodayFilter = function () {
      const btn = document.getElementById('todayBtn');
      const dateInput = document.getElementById('dateFilter');
      if (!btn || !dateInput) return;

      if (btn.classList.contains('active')) {
        // Deactivate — clear date filter
        btn.classList.remove('active');
        dateInput.value = '';
      } else {
        // Activate — set date filter to today
        btn.classList.add('active');
        dateInput.value = todayISO();
      }
      currentPage = 1;
      loadAssignments(currentFilter, currentPage, document.getElementById('searchInput').value);
    };
    // Expose badge updater for KPI refresh
    window._updateTodayBadge = updateTodayBadge;

    // Search
    let searchTimeout;
    document.getElementById('searchInput').addEventListener('input', function () {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        currentPage = 1;
        loadAssignments(currentFilter, currentPage, this.value);
      }, 300);
    });

    // ── Repair En Route Action ────────────────────────────────────────────
    window.repairEnRoute = async function (bookingId, btn) {
      if (!confirm('Are you sure you want to go En Route for this repair?')) {
        if (btn) { btn.classList.remove('btn-loading'); btn.disabled = false; btn._btnLoadingActive = false; }
        return;
      }
      if (btn) { btn.classList.add('btn-loading'); btn.disabled = true; }
      try {
        // Check out any reserved repair parts first
        await checkoutReservedParts(bookingId);

        const res = await fetch(`/api/technician/repairs/${bookingId}/en-route`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin'
        });
        const data = await res.json();
        if (res.ok) {
          showNotification({ type: 'success', title: 'En Route', message: 'Heading to customer. Safe travels!', duration: 4000 });
          // ── Auto-open route map ──
          let a = allItems.find(function (item) { return String(item.bookingId?._id || item.bookingId) === String(bookingId); });
          if (!a && window._detailAssignment && String(window._detailAssignment.bookingId?._id || window._detailAssignment.bookingId) === String(bookingId)) {
            a = window._detailAssignment;
          }
          if (a) {
            var bookingGeo = a.bookingId?.location?.coordinates?.coordinates || a.bookingId?.location?.coordinates || [];
            var assignmentGeo = a.location?.coordinates?.coordinates || a.location?.coordinates || [];
            var custLat = a.customerLat ?? a.customerLocation?.lat ?? a.location?.lat ?? a.bookingId?.customerLocation?.lat ?? a.bookingId?.location?.lat ?? assignmentGeo[1] ?? bookingGeo[1] ?? null;
            var custLng = a.customerLng ?? a.customerLocation?.lng ?? a.location?.lng ?? a.bookingId?.customerLocation?.lng ?? a.bookingId?.location?.lng ?? assignmentGeo[0] ?? bookingGeo[0] ?? null;
            if (Number.isFinite(Number(custLat)) && Number.isFinite(Number(custLng))) {
              setTimeout(function () {
                if (window.openRouteMapModal) window.openRouteMapModal(custLat, custLng, a.customerName || 'Customer', a.customerLocation?.address || a.location?.address || a.bookingId?.customerLocation?.address || a.bookingId?.location?.address || a.bookingId?.address || a.address || '');
              }, 500);
            }
          }
          loadAssignments(currentFilter, currentPage, document.getElementById('searchInput').value);
          if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
            await showDetail(window._currentDetailId);
            if (status === 'in_progress' && isMixedAssignment(window._detailAssignment)) {
              switchDetailTab('core-service');
            }
          }
        } else {
          showNotification({ type: 'error', title: 'Failed', message: data.error || 'Could not start en route', duration: 5000 });
        }
      } catch (e) { showNotification({ type: 'error', title: 'Network Error', message: 'Please try again', duration: 5000 }); }
      finally { if (btn) { btn.classList.remove('btn-loading'); btn.disabled = false; btn._btnLoadingActive = false; } }
    };

    // ── Reserve / check out parts ─────────────────────────────────────────
    window.reservePartFromAI = async function (partName, quantity, bookingId) {
      if (!bookingId) { showNotification({ type: 'error', title: 'Cannot Reserve', message: 'Booking not loaded.', duration: 3000 }); return; }
      await reservePart(partName, quantity, bookingId);
    };

    window.reservePart = async function (partName, quantity, bookingId) {
      try {
        const res = await fetch(`/api/technician/bookings/${bookingId}/reserve-parts`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ partName, quantity }),
        });
        const data = await res.json();
        if (res.ok) {
          showNotification({ type: 'success', title: 'Part Reserved', message: `${partName} ×${quantity} reserved.`, duration: 3000 });
          if (window._currentDetailId) showDetail(window._currentDetailId);
        } else if (['PART_OUT_OF_STOCK', 'PART_NOT_IN_INVENTORY'].includes(data.code)) {
          const request = await Swal.fire({ icon: 'warning', title: 'Part Unavailable', text: data.error, showCancelButton: true, confirmButtonText: 'Create Parts Request', confirmButtonColor: '#d97706' });
          if (request.isConfirmed) await handleRequestPartsAndWait(bookingId, [data.partName || partName]);
        } else {
          showNotification({ type: 'error', title: 'Reserve Failed', message: data.error || 'Could not reserve part.', duration: 5000 });
        }
      } catch (e) { showNotification({ type: 'error', title: 'Network Error', message: 'Please try again.', duration: 3000 }); }
    };

    window.reserveRecommendedParts = async function (partNames, bookingId) {
      if (!Array.isArray(partNames) || !partNames.length) return;
      Swal.fire({ title: 'Reserving Recommended Parts...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
      const failed = [];
      const unavailable = [];
      for (const partName of partNames) {
        try {
          const res = await fetch(`/api/technician/bookings/${bookingId}/reserve-parts`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
            body: JSON.stringify({ partName, quantity: 1 })
          });
          const data = await res.json();
          if (!res.ok && ['PART_OUT_OF_STOCK', 'PART_NOT_IN_INVENTORY'].includes(data.code)) unavailable.push(data.partName || partName);
          else if (!res.ok) failed.push(`${partName}: ${data.error || 'failed'}`);
        } catch (e) { failed.push(`${partName}: network error`); }
      }
      Swal.close();
      if (unavailable.length) await handleRequestPartsAndWait(bookingId, [...new Set(unavailable)]);
      else if (failed.length) Swal.fire('Some Parts Could Not Be Reserved', failed.join('\n'), 'warning');
      else Swal.fire('Parts Reserved', 'All AI-recommended parts are reserved.', 'success');
      if (window._currentDetailId) showDetail(window._currentDetailId);
    };

    window.openRepairPartsModal = async function (bookingId) {
      if (!bookingId) return;
      Swal.fire({ title:'Loading Repair Parts...', html:'Fetching AI suggestions and current reservations.', allowOutsideClick:false, didOpen:()=>Swal.showLoading() });
      try {
        const [bookingResp, reservationsResp] = await Promise.all([
          fetch(`/api/technician/appointments/${bookingId}`, { credentials:'same-origin' }),
          fetch(`/api/technician/bookings/${bookingId}/reserved-parts`, { credentials:'same-origin' }),
        ]);
        const bookingData = await bookingResp.json();
        const reservationsData = await reservationsResp.json();
        if (!bookingResp.ok) throw new Error(bookingData.error || 'Could not load AI suggestions.');
        if (!reservationsResp.ok) throw new Error(reservationsData.error || 'Could not load reserved parts.');

        const booking = bookingData.booking || bookingData;
        const activeReservations = (reservationsData.reservations || []).filter(row => ['reserved', 'checked_out'].includes(row.status));
        if (booking.partsRequest?.status === 'procuring') {
          await Swal.fire({ icon:'info', title:'Admin Processing Parts', text:'Admin has started procurement. The submitted repair-parts list is now locked.', confirmButtonColor:'#2563eb' });
          return;
        }
        const candidates = [];
        const byName = new Map();
        const addCandidate = (part) => {
          const name = String(part.name || '').trim();
          if (!name) return;
          const key = name.toLowerCase();
          const existing = byName.get(key);
          if (existing) {
            existing.quantity = Math.max(existing.quantity, Math.max(1, Number(part.quantity) || 1));
            existing.reservedQuantity = Math.max(existing.reservedQuantity || 0, Number(part.reservedQuantity) || 0);
            existing.reserved = existing.reservedQuantity >= existing.quantity;
            existing.toolId = existing.toolId || part.toolId || null;
            return;
          }
          const quantity = Math.max(1,Number(part.quantity)||1);
          const reservedQuantity = Math.max(0,Number(part.reservedQuantity)||0);
          const row = { name, quantity, reservedQuantity, toolId:part.toolId||null, source:part.source||'Technician', reserved:reservedQuantity >= quantity, status:part.status||'' };
          candidates.push(row); byName.set(key, row);
        };
        activeReservations.forEach(row => addCandidate({
          name:row.itemName || row.toolId?.itemName || 'Repair part', quantity:row.quantity,
          reservedQuantity:row.quantity, toolId:row.toolId?._id || row.toolId, source:'Reserved', reserved:true, status:row.status,
        }));
        (booking.technicianAssistant?.possibleParts || []).forEach(part => addCandidate({
          name:typeof part === 'string' ? part : part?.name,
          quantity:typeof part === 'object' ? part.quantity : 1,
          toolId:typeof part === 'object' ? part.toolId : null,
          source:'AI suggested', reserved:false,
        }));
        (booking.partsRequest?.items || []).forEach(item => addCandidate({
          name:item.itemName, quantity:item.requestedQty, toolId:item.toolId,
          source:'Saved admin request', reserved:false, status:item.status,
        }));

        const modalHtml = `<div style="text-align:left;font-size:.84rem;">
          <div class="alert alert-info py-2 px-3 mb-3"><i class="bi bi-robot me-1"></i>AI suggestions are included automatically. Add any other repair part required by your professional assessment.</div>
          <div id="repairPartsCandidateList" style="display:flex;flex-direction:column;gap:7px;max-height:280px;overflow:auto;"></div>
          <div style="border-top:1px solid #e2e8f0;margin-top:14px;padding-top:12px;">
            <div class="fw-semibold mb-2"><i class="bi bi-plus-circle me-1"></i>Add Technician-Identified Part</div>
            <div class="d-flex gap-2"><input id="repairPartCustomName" class="form-control form-control-sm" placeholder="Repair part name"><input id="repairPartCustomQty" type="number" min="1" value="1" class="form-control form-control-sm" style="max-width:82px"><button type="button" id="repairPartAddBtn" class="btn btn-sm btn-outline-primary">Add</button></div>
          </div>
          <div class="text-muted mt-3" style="font-size:.72rem;"><i class="bi bi-send me-1"></i>Submitting sends the complete list to Admin → Repair Parts &amp; Scheduling. Phase 1 requests do not create a repair schedule.</div>
        </div>`;

        const renderCandidates = () => {
          const holder = document.getElementById('repairPartsCandidateList');
          if (!holder) return;
          holder.innerHTML = candidates.length ? candidates.map((part,index) => `
            <div style="display:flex;align-items:center;gap:10px;border:1px solid ${part.reserved ? '#bbf7d0' : '#dbeafe'};background:#fff;border-radius:9px;padding:9px 11px;">
              <i class="bi ${part.reserved ? 'bi-check-circle-fill text-success' : 'bi-stars text-primary'}"></i>
              <div style="flex:1;min-width:0;"><div class="fw-semibold">${preparationEscapeHtml(part.name)}</div><small class="text-muted">${part.reserved ? (part.status === 'checked_out' ? 'Checked out' : 'Already reserved') : part.reservedQuantity > 0 ? `${part.reservedQuantity} reserved · ${Math.max(0,part.quantity-part.reservedQuantity)} still needed` : preparationEscapeHtml(part.source)}</small></div>
              <input class="form-control form-control-sm repair-part-modal-qty" data-index="${index}" type="number" min="${Math.max(1,part.reservedQuantity||1)}" value="${part.quantity}" style="width:72px" ${part.reserved ? 'readonly' : ''}>
              ${part.source === 'Technician' && !part.reserved ? `<button type="button" class="btn btn-sm btn-outline-danger repair-part-remove" data-index="${index}"><i class="bi bi-trash"></i></button>` : ''}
            </div>`).join('') : '<div class="text-center text-muted py-3">AI did not suggest a part. Add the required repair part below.</div>';
          holder.querySelectorAll('.repair-part-remove').forEach(button => button.onclick = () => {
            const removed = candidates.splice(Number(button.dataset.index), 1)[0];
            if (removed) byName.delete(removed.name.toLowerCase());
            renderCandidates();
          });
          holder.querySelectorAll('.repair-part-modal-qty').forEach(input => input.onchange = () => {
            const row = candidates[Number(input.dataset.index)];
            if (row && !row.reserved) row.quantity=Math.max(row.reservedQuantity||1,Number(input.value)||1);
          });
        };

        const result = await Swal.fire({
          title:'Reserved Repair Parts', html:modalHtml, width:680, showCancelButton:true,
          confirmButtonText:'<i class="bi bi-send me-1"></i> Reserve & Send to Admin', confirmButtonColor:'#2563eb',
          cancelButtonText:'Cancel', focusConfirm:false,
          didOpen:() => {
            renderCandidates();
            document.getElementById('repairPartAddBtn').onclick = () => {
              const input = document.getElementById('repairPartCustomName');
              const qtyInput = document.getElementById('repairPartCustomQty');
              const name = input.value.trim();
              if (!name) return;
              addCandidate({ name, quantity:Math.max(1,Number(qtyInput.value)||1), source:'Technician' });
              input.value=''; qtyInput.value='1'; renderCandidates();
            };
          },
          preConfirm:() => {
            document.querySelectorAll('.repair-part-modal-qty').forEach(input => {
              const row = candidates[Number(input.dataset.index)];
              if (row && !row.reserved) row.quantity=Math.max(1,Number(input.value)||1);
            });
            if (!candidates.length) return Swal.showValidationMessage('Add at least one repair part.');
            return candidates.map(row => ({ name:row.name, quantity:row.quantity, reservedQuantity:row.reservedQuantity||0, toolId:row.toolId, reserved:row.reserved }));
          }
        });
        if (!result.isConfirmed) return;

        Swal.fire({ title:'Submitting Repair Parts...', html:'Reserving available stock and sending the complete list to admin.', allowOutsideClick:false, didOpen:()=>Swal.showLoading() });
        const selectedParts = result.value;
        const reservationWarnings = [];
        for (const part of selectedParts.filter(row => Number(row.reservedQuantity||0) < Number(row.quantity||1))) {
          try {
            const quantityToReserve = Math.max(1, Number(part.quantity||1) - Number(part.reservedQuantity||0));
            const reserveResp = await fetch(`/api/technician/bookings/${bookingId}/reserve-parts`, {
              method:'POST', headers:{'Content-Type':'application/json'}, credentials:'same-origin',
              body:JSON.stringify({ partName:part.name, quantity:quantityToReserve, toolId:part.toolId || null }),
            });
            const reserveData = await reserveResp.json();
            if (!reserveResp.ok && !['PART_OUT_OF_STOCK','PART_NOT_IN_INVENTORY'].includes(reserveData.code)) reservationWarnings.push(`${part.name}: ${reserveData.error || 'reservation failed'}`);
          } catch (error) { reservationWarnings.push(`${part.name}: network error`); }
        }
        const submitResp = await fetch(`/api/technician/bookings/${bookingId}/submit-parts-review`, {
          method:'POST', headers:{'Content-Type':'application/json'}, credentials:'same-origin',
          body:JSON.stringify({ parts:selectedParts }),
        });
        const submitData = await submitResp.json();
        if (!submitResp.ok) throw new Error(submitData.error || 'Could not send repair parts to admin.');
        const securedMessage = submitData.allPartsSecured
          ? 'All repair parts are secured. The list was sent to admin for Phase 1 review, and technician preparation can continue now.'
          : 'The list was sent to admin. Preparation will resume after the unavailable parts are procured.';
        await Swal.fire({ icon:reservationWarnings.length?'warning':'success', title:submitData.allPartsSecured?'Parts Secured':'Sent to Admin', text:reservationWarnings.length ? `${securedMessage} Admin review notes: ${reservationWarnings.join('; ')}` : securedMessage, confirmButtonColor:'#2563eb' });
        loadAssignments(currentFilter,currentPage,document.getElementById('searchInput').value);
        if (window._currentDetailId) showDetail(window._currentDetailId);
      } catch (error) {
        Swal.fire('Repair Parts Unavailable', error.message || 'Could not load the repair-parts workflow.', 'error');
      }
    };

    window.addAdditionalRepairPart = async function (bookingId) {
      const result = await Swal.fire({
        title: 'Add Additional Part',
        html: '<input id="extraPartName" class="swal2-input" placeholder="Part name"><input id="extraPartQty" type="number" min="1" value="1" class="swal2-input" placeholder="Quantity">',
        showCancelButton: true, confirmButtonText: 'Reserve Part',
        preConfirm: () => {
          const partName = document.getElementById('extraPartName').value.trim();
          const quantity = Math.max(1, parseInt(document.getElementById('extraPartQty').value) || 1);
          if (!partName) return Swal.showValidationMessage('Enter a part name.');
          return { partName, quantity };
        }
      });
      if (result.isConfirmed) await reservePart(result.value.partName, result.value.quantity, bookingId);
    };

    window.confirmRepairPreparation = async function (bookingId) {
      const result = await Swal.fire({ icon: 'question', title: 'Confirm Preparation', text: 'Confirm the AI diagnosis was reviewed and all required parts are reserved.', showCancelButton: true, confirmButtonText: 'Confirm Preparation', confirmButtonColor: '#059669' });
      if (!result.isConfirmed) return;
      const res = await fetch(`/api/technician/bookings/${bookingId}/confirm-preparation`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin' });
      const data = await res.json();
      if (!res.ok) return Swal.fire('Preparation Incomplete', data.error || 'Could not confirm preparation.', 'error');
      await Swal.fire('Preparation Confirmed', 'The repair is ready for departure.', 'success');
      if (window._currentDetailId) showDetail(window._currentDetailId);
    };

    window.checkoutReservedParts = async function (bookingId) {
      try {
        const res = await fetch(`/api/technician/bookings/${bookingId}/check-out-parts`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
        });
        const data = await res.json();
        if (res.ok) {
          if (data.checkedOut && data.checkedOut.length) {
            showNotification({ type: 'success', title: 'Parts Checked Out', message: `${data.checkedOut.length} reserved part(s) checked out.`, duration: 4000 });
          }
          return data;
        } else {
          showNotification({ type: 'error', title: 'Part Checkout Failed', message: data.error || 'Could not check out parts.', duration: 5000 });
          return null;
        }
      } catch (e) {
        showNotification({ type: 'error', title: 'Network Error', message: 'Please try again.', duration: 3000 });
        return null;
      }
    };

    // ── Repair Status Transition ──────────────────────────────────────────
    async function captureStartWorkProof(triggerButton) {
      const result = await Swal.fire({
        title: 'Proof of Starting Work',
        html: '<div class="text-start"><p class="text-muted small">Take or upload a photo showing the customer/site before work begins.</p><label class="form-label fw-bold">Starting Photo <span class="text-danger">*</span></label><input id="startWorkProofFile" type="file" accept="image/*" capture="environment" class="form-control mb-3"><label class="form-label">Notes (optional)</label><textarea id="startWorkProofNotes" class="form-control" rows="2" maxlength="500"></textarea></div>',
        showCancelButton: true,
        confirmButtonText: 'Submit Proof & Start Work',
        confirmButtonColor: '#059669',
        preConfirm: async () => {
          const file = document.getElementById('startWorkProofFile').files[0];
          if (!file) return Swal.showValidationMessage('A starting-work photo is required.');
          if (!file.type.startsWith('image/')) return Swal.showValidationMessage('Please select an image file.');
          const startProofUrl = await new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.onerror = reject; reader.readAsDataURL(file); });
          return { startProofUrl, startProofNotes: document.getElementById('startWorkProofNotes').value.trim() };
        }
      });
      if (!result.isConfirmed && triggerButton) {
        triggerButton.classList.remove('btn-loading');
        triggerButton.disabled = false;
        triggerButton._btnLoadingActive = false;
      }
      return result.isConfirmed ? result.value : null;
    }

    window.repairTransition = async function (bookingId, status, btn) {
      const labels = { on_site: 'mark as Arrived', in_progress: 'start work', completed: 'mark as Completed' };
      let startProof = null;
      let arrivalProof = null;
      if (status === 'on_site') {
        arrivalProof = await captureArrivalProof(btn);
        if (!arrivalProof) { if (btn) { btn.classList.remove('btn-loading'); btn.disabled = false; } return; }
      } else if (status === 'in_progress') {
        startProof = await captureStartWorkProof(btn);
        if (!startProof) { if (btn) { btn.classList.remove('btn-loading'); btn.disabled = false; } return; }
      } else if (!confirm(`Are you sure you want to ${labels[status] || status}?`)) {
        if (btn) { btn.classList.remove('btn-loading'); btn.disabled = false; }
        return;
      }
      if (btn) { btn.classList.add('btn-loading'); btn.disabled = true; }
      try {
        const res = await fetch(`/api/technician/repairs/${bookingId}/status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ status, ...(startProof || {}), ...(arrivalProof || {}) })
        });
        const data = await res.json();
        if (res.ok) {
          showNotification({ type: 'success', title: 'Status Updated', message: `Status changed to ${status.replace(/_/g, ' ')}`, duration: 4000 });
          if (status === 'on_site' && window.hideRoutePanel) {
            window.hideRoutePanel();
          }
          loadAssignments(currentFilter, currentPage, document.getElementById('searchInput').value);
          if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
            showDetail(window._currentDetailId);
          }
        } else {
          showNotification({ type: 'error', title: 'Update Failed', message: data.error || 'Failed to update status', duration: 5000 });
        }
      } catch (e) { showNotification({ type: 'error', title: 'Network Error', message: 'Please try again', duration: 5000 }); }
      finally { if (btn) { btn.classList.remove('btn-loading'); btn.disabled = false; } }
    };

    async function captureArrivalProof(triggerButton) {
      const result = await Swal.fire({
        title: 'Proof of Arrival',
        html: '<div class="text-start"><p class="text-muted small">Take or upload a photo showing you have arrived at the customer\u2019s location.</p><label class="form-label fw-bold">Arrival Photo <span class="text-danger">*</span></label><input id="arrivalProofFile" type="file" accept="image/*" capture="environment" class="form-control mb-3"><label class="form-label">Notes (optional)</label><textarea id="arrivalProofNotes" class="form-control" rows="2" maxlength="500"></textarea></div>',
        showCancelButton: true,
        confirmButtonText: 'Submit Proof & Mark Arrived',
        confirmButtonColor: '#2563eb',
        preConfirm: async () => {
          const file = document.getElementById('arrivalProofFile').files[0];
          if (!file) return Swal.showValidationMessage('An arrival photo is required.');
          if (!file.type.startsWith('image/')) return Swal.showValidationMessage('Please select an image file.');
          const arrivalProofUrl = await new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.onerror = reject; reader.readAsDataURL(file); });
          return { arrivalProofUrl };
        }
      });
      if (!result.isConfirmed && triggerButton) {
        triggerButton.classList.remove('btn-loading');
        triggerButton.disabled = false;
        triggerButton._btnLoadingActive = false;
      }
      return result.isConfirmed ? result.value : null;
    }

    // Actions
    window.acceptAssign = async function (id, btn) {
      if (!confirm('Accept this assignment?')) return;
      const doAccept = async () => {
        const res = await fetch(`/api/technician/assignments/${id}/accept`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin' });
        const data = await res.json();
        if (res.ok) {
          showNotification({ type: 'success', title: 'Assignment Accepted', message: 'Use the Daily Preparation bar above to prepare equipment and consumables for all of today\'s jobs.', duration: 5000 });
          loadAssignments(currentFilter, currentPage);
          loadPreparation();
          if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
            showDetail(window._currentDetailId);
          }
          // Late-accepted booking: surface new Daily Kit requirements immediately
          if (data.preparationReview && data.preparationReview.hasDelta) {
            setTimeout(() => openDailyKitModal(), 600);
          }
        } else {
          showNotification({ type: 'error', title: 'Accept Failed', message: data.error || 'Failed to accept assignment', duration: 5000 });
        }
      };
      if (btn && window._btnLoading) window._btnLoading(btn, doAccept); else await doAccept();
    };

    let _standardPreparationAssignmentId = null;
    let _standardPreparationCatalog = [];
    let _standardPreparationItems = [];
    let _standardPreparationReservedParts = [];
    let _standardPreparationIsRepair = false;
    let _standardPreparationAiParts = [];

function preparationEscapeHtml(value) {
      return String(value == null ? '' : value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }
    window.preparationEscapeHtml = preparationEscapeHtml;

    function renderStandardPreparation() {
      const holder = document.getElementById('standardPreparationItems');
      const empty = document.getElementById('standardPreparationEmpty');
      const confirm = document.getElementById('confirmPreparationBtn');
      const reservedSection = document.getElementById('standardPreparationReservedSection');
      const reservedHolder = document.getElementById('standardPreparationReservedParts');
      if (!holder) return;
      empty.classList.toggle('d-none', _standardPreparationItems.length > 0);
      confirm.disabled = _standardPreparationItems.length === 0;
      if (reservedSection && reservedHolder) {
      reservedSection.classList.toggle('d-none', _standardPreparationReservedParts.length === 0);
      reservedHolder.innerHTML = _standardPreparationReservedParts.map(part => `
        <div class="card border-primary-subtle shadow-sm"><div class="card-body py-3">
          <div class="d-flex align-items-center gap-3">
            <span class="rounded-circle d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary" style="width:40px;height:40px"><i class="bi bi-box-seam"></i></span>
            <div class="flex-grow-1">
              <div class="fw-bold">${preparationEscapeHtml(part.name || 'Repair part')}</div>
              <small class="text-muted">Qty ${Math.max(1, Number(part.quantity) || 1)} ${preparationEscapeHtml(part.unit || 'pcs')} · ${part.status === 'checked_out' ? 'Checked out' : 'Reserved for this repair'}</small>
            </div>
            <span class="badge ${part.status === 'checked_out' ? 'bg-success' : 'bg-primary'}">${part.status === 'checked_out' ? 'Checked out' : 'Reserved'}</span>
          </div>
        </div></div>`).join('');
      }
      holder.innerHTML = _standardPreparationItems.map((item, index) => `
        <div class="card border-0 shadow-sm"><div class="card-body py-3">
          <div class="d-flex align-items-center gap-3">
            <span class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width:40px;height:40px;background:${item.kind === 'equipment' ? '#dbeafe' : '#dcfce7'};color:${item.kind === 'equipment' ? '#2563eb' : '#15803d'}"><i class="bi ${item.kind === 'equipment' ? 'bi-tools' : 'bi-droplet'}"></i></span>
            <div class="flex-grow-1"><div class="fw-bold">${preparationEscapeHtml(item.name)}</div><small class="text-muted">${item.kind === 'equipment' ? 'Reusable equipment · review for this visit' : 'Consumable · expected quantity; actual use recorded after service'}${item.recommended ? ' · Recommended' : ''}</small></div>
            <div style="width:90px"><input class="form-control form-control-sm" type="number" min="1" max="${item.available || 1}" value="${item.quantity}" onchange="updatePreparationQty(${index},this.value)"></div>
            <button class="btn btn-sm btn-outline-danger" onclick="removePreparationItem(${index})"><i class="bi bi-trash"></i></button>
          </div>
        </div></div>`).join('');
    }

    window.openStandardPreparation = async function (assignmentId) {
      _standardPreparationAssignmentId = assignmentId;
      document.getElementById('standardPreparationLoading').classList.remove('d-none');
      document.getElementById('standardPreparationBody').classList.add('d-none');
      document.getElementById('confirmPreparationBtn').disabled = true;
      new bootstrap.Modal(document.getElementById('standardPreparationModal')).show();
      try {
        const res = await fetch(`/api/technician/assignments/${assignmentId}/preparation`, { credentials: 'same-origin' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not load preparation');
        _standardPreparationCatalog = data.catalog || [];
        _standardPreparationItems = (data.recommendations || []).map(x => ({ ...x }));
        _standardPreparationReservedParts = (data.reservedParts || []).map(x => ({ ...x }));
        _standardPreparationIsRepair = data.serviceType === 'repair' || data.serviceType === 'mixed';
        const confirmedNames = new Set((data.aiReview?.confirmedContingencyParts || []).map(part => String(part.name || '').toLowerCase()));
        _standardPreparationAiParts = (data.aiReview?.possibleParts || []).map(part => {
          const name = typeof part === 'string' ? part : part?.name || 'Possible part';
          return {
            name,
            serviceName: typeof part === 'object' ? part?.serviceName || part?.unitType || '' : '',
            quantity: 1,
            brought: confirmedNames.has(String(name).toLowerCase()),
          };
        });
        document.getElementById('standardPreparationService').textContent = data.serviceName || 'Service';
        const aiCarry = document.getElementById('standardPreparationAiCarry');
        if (aiCarry) {
          aiCarry.classList.toggle('d-none', !_standardPreparationIsRepair);
          aiCarry.innerHTML = `<div class="fw-semibold mb-1"><i class="bi bi-box2-heart me-1"></i>Optional AI Contingency Parts</div>
            <div class="small mb-2">Check a part only when it is physically with you for this visit. This does not confirm the diagnosis, reserve stock, or charge the customer.</div>
            ${_standardPreparationAiParts.length ? _standardPreparationAiParts.map((part, index) => `
              <label class="d-flex align-items-center gap-2 bg-white border rounded p-2 mb-2">
                <input class="form-check-input mt-0" type="checkbox" ${part.brought ? 'checked' : ''} onchange="setPreparationAiPartBrought(${index}, this.checked)">
                <span class="flex-grow-1"><strong>${preparationEscapeHtml(part.name)}</strong>${part.serviceName ? `<small class="d-block text-muted">${preparationEscapeHtml(part.serviceName)}</small>` : ''}</span>
                <span class="badge ${part.brought ? 'bg-success' : 'bg-secondary'}">${part.brought ? 'Brought' : 'Not brought'}</span>
              </label>`).join('') : '<div class="small text-muted">AI did not suggest any contingency parts.</div>'}`;
        }
        document.getElementById('standardPreparationLoading').classList.add('d-none');
        document.getElementById('standardPreparationBody').classList.remove('d-none');
        renderStandardPreparation();
      } catch (error) {
        bootstrap.Modal.getInstance(document.getElementById('standardPreparationModal'))?.hide();
        showNotification({ type:'error', title:'Preparation Unavailable', message:error.message, duration:5000 });
      }
    };
    window.updatePreparationQty = function(index, value) { const item=_standardPreparationItems[index]; if(item) item.quantity=Math.max(1,Math.min(Number(item.available||1),parseInt(value)||1)); renderStandardPreparation(); };
    window.setPreparationAiPartBrought = function(index, brought) {
      if (_standardPreparationAiParts[index]) _standardPreparationAiParts[index].brought = Boolean(brought);
      const aiCarry = document.getElementById('standardPreparationAiCarry');
      if (aiCarry) aiCarry.querySelectorAll('.badge').forEach((badge, badgeIndex) => {
        const selected = Boolean(_standardPreparationAiParts[badgeIndex]?.brought);
        badge.className = `badge ${selected ? 'bg-success' : 'bg-secondary'}`;
        badge.textContent = selected ? 'Brought' : 'Not brought';
      });
    };
    window.removePreparationItem = function(index) { _standardPreparationItems.splice(index,1); renderStandardPreparation(); };
    window.addPreparationItem = async function() {
      const choices = _standardPreparationCatalog.filter(c => !_standardPreparationItems.some(i => String(i.inventoryId) === String(c.inventoryId)));
      if (!choices.length) return showNotification({type:'info',title:'No More Items',message:'All available preparation items are already selected.',duration:3000});
      const options = choices.map(c => `<option value="${c.inventoryId}">${c.name} · ${c.kind} · ${c.available} available</option>`).join('');
      const result = await Swal.fire({ title:'Add Preparation Item', html:`<select id="prepCatalogChoice" class="form-select">${options}</select>`, showCancelButton:true, confirmButtonText:'Add Item', confirmButtonColor:'#0d9488', preConfirm:()=>document.getElementById('prepCatalogChoice').value });
      if (result.isConfirmed) { const selected=choices.find(c=>String(c.inventoryId)===String(result.value)); if(selected){_standardPreparationItems.push({...selected,quantity:1,recommended:false});renderStandardPreparation();} }
    };
    window.confirmStandardPreparation = async function() {
      const btn=document.getElementById('confirmPreparationBtn'); btn.disabled=true;
      try {
        const carriedPossibleParts = _standardPreparationAiParts.filter(part => part.brought).map(part => ({ name:part.name, serviceName:part.serviceName, quantity:part.quantity || 1 }));
        const res=await fetch(`/api/technician/assignments/${_standardPreparationAssignmentId}/preparation/confirm`,{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({items:_standardPreparationItems,carriedPossibleParts})});
        const data=await res.json(); if(!res.ok) throw new Error(data.error||'Could not confirm preparation');
        bootstrap.Modal.getInstance(document.getElementById('standardPreparationModal'))?.hide();
        showNotification({type:'success',title:'Preparation Confirmed',message:`Equipment and consumables reviewed. ${carriedPossibleParts.length} optional AI contingency part(s) confirmed as physically brought. No repair parts were reserved and no inventory was deducted.`,duration:5000});
        loadAssignments(currentFilter,currentPage);
        if(window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) showDetail(window._currentDetailId);
      } catch(error){showNotification({type:'error',title:'Confirmation Failed',message:error.message,duration:5000});btn.disabled=false;}
    };

    window.checkoutAssignmentEquipment = async function (id, btn) {
      const a = window._detailAssignment || allItems.find(x => String(x._id) === String(id));
      const equipmentItems = a?.equipmentItems || [];
      const listEl = document.getElementById('checkoutEquipmentList');
      const noEqEl = document.getElementById('checkoutNoEquipment');
      const confirmBtn = document.getElementById('confirmCheckoutBtn');
      const confirmCheck = document.getElementById('checkoutConfirmReceived');
      const isRepair = a?.serviceType === 'repair' || a?.bookingId?.serviceType === 'repair' || a?.bookingId?.status?.startsWith?.('repair_');

      // Set modal title & icon for inspection kit vs general equipment
      document.getElementById('checkoutModalTitle').textContent = isRepair ? 'Check Out Inspection Kit' : 'Check Out Equipment';
      document.getElementById('checkoutModalSubtitle').textContent = isRepair ? 'Verify the inspection tools assigned by admin' : 'Confirm receipt of assigned tools & equipment';
      document.getElementById('checkoutModalIcon').className = isRepair ? 'bi bi-tools' : 'bi bi-box-seam';

      // Reset confirmation checkbox
      confirmCheck.checked = false;
      confirmBtn.disabled = true;

      // Toggle confirm button based on checkbox
      confirmCheck.onchange = function () { confirmBtn.disabled = !this.checked; };

      // Load reserved repair parts for the modal
      let reservedParts = [];
      const bookingId = a?.bookingId?._id || (typeof a?.bookingId === 'string' ? a.bookingId : '');
      if (bookingId && isRepair) {
        try {
          const rpRes = await fetch(`/api/technician/bookings/${bookingId}/reserved-parts`, { credentials: 'same-origin' });
          if (rpRes.ok) { const rpData = await rpRes.json(); reservedParts = rpData.reservations || []; }
        } catch (e) {}
      }

      // Build equipment rows
      const equipmentRows = equipmentItems.map(eq => `
        <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:#fff;border:1.5px solid #e2e8f0;border-radius:12px;">
          <i class="bi bi-check-circle-fill" style="font-size:1.2rem;color:#059669;flex-shrink:0;"></i>
          <div style="flex:1;">
            <div style="font-weight:700;font-size:0.88rem;color:#0f172a;">${eq.equipmentName || 'Tool'}</div>
            <div style="font-size:0.72rem;color:#64748b;">Qty: ${eq.quantity || 1}${eq.status === 'checked_out' || eq.status === 'in_use' ? ' · Already checked out' : ''}</div>
          </div>
        </div>
      `).join('');

      // Build reserved-parts rows
      const reservedRows = reservedParts.length ? `
        <div style="margin-top:6px;">
          <div style="font-size:0.75rem;font-weight:600;color:#7c3aed;margin-bottom:8px;"><i class="bi bi-box-seam me-1"></i>Reserved Repair Parts</div>
          ${reservedParts.map(part => `
            <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:#fff;border:1.5px solid #e9d5ff;border-radius:12px;margin-bottom:8px;">
              <i class="bi bi-${part.status === 'checked_out' ? 'check-circle-fill' : 'hourglass-split'}" style="font-size:1.2rem;color:${part.status === 'checked_out' ? '#059669' : '#7c3aed'};flex-shrink:0;"></i>
              <div style="flex:1;">
                <div style="font-weight:700;font-size:0.88rem;color:#0f172a;">${part.itemName || (part.toolId && part.toolId.itemName) || 'Part'}</div>
                <div style="font-size:0.72rem;color:#64748b;">Qty: ${part.quantity || 1} · ${part.status === 'checked_out' ? 'Checked out' : 'Reserved'}</div>
              </div>
            </div>
          `).join('')}
        </div>
      ` : '';

      // Populate equipment list
      if (equipmentItems.length === 0 && reservedParts.length === 0) {
        listEl.innerHTML = '';
        noEqEl.style.display = '';
        confirmBtn.innerHTML = '<i class="bi bi-arrow-right me-1"></i>Proceed Without Equipment';
      } else {
        noEqEl.style.display = 'none';
        listEl.innerHTML = equipmentRows + reservedRows;
        confirmBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Confirm Checkout';
      }

      // Store assignment ID for the confirm handler
      confirmBtn.dataset.assignmentId = id;

      // Show modal
      const modalEl = document.getElementById('equipmentCheckoutModal');
      const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
      modal.show();
    };

    // Confirm checkout handler
    document.getElementById('confirmCheckoutBtn').addEventListener('click', async function () {
      const id = this.dataset.assignmentId;
      if (!id) return;
      const modalEl = document.getElementById('equipmentCheckoutModal');
      const modal = bootstrap.Modal.getInstance(modalEl);
      if (modal) modal.hide();

      const doCheckout = async () => {
        try {
          const res = await fetch(`/api/technician/assignments/${id}/checkout`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin' });
          const data = await res.json();
          if (res.ok) {
            showNotification({ type: 'success', title: 'Equipment Checked Out', message: 'You can now head to the job site.', duration: 4000 });
            loadAssignments(currentFilter, currentPage);
            loadPreparation();
            if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
              showDetail(window._currentDetailId);
            }
          } else {
            showNotification({ type: 'error', title: 'Checkout Failed', message: data.error || 'Failed to check out equipment', duration: 5000 });
          }
        } catch (err) {
          showNotification({ type: 'error', title: 'Checkout Error', message: err.message || 'Network error', duration: 5000 });
        }
      };
      await doCheckout();
    });

    window.declineAssign = async function (id, btn) {
      const reason = prompt('Reason for declining (optional):');
      if (reason === null) return;
      window._btnLoading(btn, async () => {
        const res = await fetch(`/api/technician/assignments/${id}/decline`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
          body: JSON.stringify({ reason })
        });
        const data = await res.json();
        if (res.ok) {
          showNotification({ type: 'warning', title: 'Assignment Declined', message: 'You have declined this assignment. It will be reassigned.', duration: 4000 });
          loadAssignments(currentFilter, currentPage);
        } else {
          showNotification({ type: 'error', title: 'Decline Failed', message: data.error || 'Failed to decline assignment', duration: 5000 });
        }
      });
    };

    window.transitionStatus = async function (id, status, btn) {
      // Completion is committed only after outstanding payment (if any) and
      // a successful proof upload. Opening or cancelling a modal is read-only.
      if (status === 'completed') {
        const assignment = allItems.find(item => String(item._id) === String(id)) ||
          (window._detailAssignment && String(window._detailAssignment._id) === String(id) ? window._detailAssignment : null);
        if (!assignment) {
          showNotification({ type: 'error', title: 'Assignment Not Found', message: 'Refresh the page and try again.', duration: 5000 });
          return;
        }
        const needsPayment = ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(assignment.paymentMethod) &&
          !assignment.balanceCollected && Number(assignment.balanceAmount || 0) > 0;
        if (needsPayment) openCollectPaymentModal(id, assignment, true);
        else openProofModal(id, assignment.customerName, assignment.serviceName, assignment.totalPrice || assignment.estimatedFee || 0);
        return;
      }
      // ── Front-end En Route Time Guard ────────────────────────────────────
      if (status === 'en_route') {
        let a = allItems.find(item => String(item._id) === String(id));
        if (!a && window._detailAssignment && String(window._detailAssignment._id) === String(id)) {
          a = window._detailAssignment;
        }
        if (a && !canEnRoute(a)) {
          const label = enRouteAvailableLabel(a);
          showNotification({
            type: 'warning',
            title: 'Too Early to Go En Route',
            message: `You can only mark yourself as "En Route" on the day of the booking and at or after the scheduled time${label ? ' (' + label + ')' : '.'}.`,
            duration: 6000
          });
          return;
        }
      }

      const labels = { en_route: 'mark as En Route', on_site: 'mark as Arrived', in_progress: 'start work', completed: 'mark as Completed' };
      let startProof = null;
      let arrivalProof = null;
      if (status === 'on_site') {
        arrivalProof = await captureArrivalProof(btn);
        if (!arrivalProof) {
          if (btn) { btn.classList.remove('btn-loading'); btn.disabled = false; btn._btnLoadingActive = false; }
          return;
        }
      } else if (status === 'in_progress') {
        startProof = await captureStartWorkProof(btn);
        if (!startProof) {
          if (btn) { btn.classList.remove('btn-loading'); btn.disabled = false; btn._btnLoadingActive = false; }
          return;
        }
      } else if (!confirm(`Confirm: ${labels[status] || status}?`)) return;

      window._btnLoading(btn, async () => {
        const res = await fetch(`/api/technician/assignments/${id}/status`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
          body: JSON.stringify({ status, ...(startProof || {}), ...(arrivalProof || {}) })
        });
        const data = await res.json();
        if (res.ok) {
          const statusLabels = { en_route: 'En Route', on_site: 'Arrived On Site', in_progress: 'Work In Progress', completed: 'Job Completed' };
          showNotification({
            type: status === 'completed' ? 'success' : 'info',
            title: 'Status Updated',
            message: `Status changed to "${statusLabels[status] || status}".`,
            duration: 4000
          });
          // ── Auto-open route map when going en route ──
          if (status === 'en_route') {
            let a = allItems.find(item => String(item._id) === String(id));
            if (!a && window._detailAssignment && String(window._detailAssignment._id) === String(id)) {
              a = window._detailAssignment;
            }
            if (a) {
              const assignmentGeo = a.location?.coordinates?.coordinates || a.location?.coordinates || [];
              const bookingGeo = a.bookingId?.location?.coordinates?.coordinates || a.bookingId?.location?.coordinates || [];
              const custLat = a.customerLat ?? a.customerLocation?.lat ?? a.location?.lat ?? a.bookingId?.customerLocation?.lat ?? a.bookingId?.location?.lat ?? assignmentGeo[1] ?? bookingGeo[1] ?? '';
              const custLng = a.customerLng ?? a.customerLocation?.lng ?? a.location?.lng ?? a.bookingId?.customerLocation?.lng ?? a.bookingId?.location?.lng ?? assignmentGeo[0] ?? bookingGeo[0] ?? '';
              setTimeout(() => {
                if (window.openRouteMapModal) {
                  window.openRouteMapModal(custLat, custLng, a.customerName || 'Customer', a.customerLocation?.address || a.location?.address || a.bookingId?.customerLocation?.address || a.bookingId?.location?.address || a.bookingId?.address || a.address || '');
                }
              }, 500);
            }
          }
          // ── Auto-hide route map when arriving on site ──
          if (status === 'on_site' && window.hideRoutePanel) {
            window.hideRoutePanel();
          }
          loadAssignments(currentFilter, currentPage);
          // Also refresh detail panel if it's currently open
          if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
            showDetail(window._currentDetailId);
          }
        } else {
          // Handle TOO_EARLY specifically for better UX
          if (data.code === 'TOO_EARLY') {
            showNotification({
              type: 'warning',
              title: 'Not Yet Time',
              message: data.error || 'You cannot go en route yet.',
              duration: 7000
            });
          } else if (data.code === 'DAILY_KIT_DELTA_REQUIRED' || data.code === 'DAILY_KIT_REQUIRED') {
            showNotification({
              type: 'warning',
              title: 'Daily Preparation Needed',
              message: data.error || 'Complete your Daily Preparation before going En Route.',
              duration: 7000
            });
            openDailyKitModal();
          } else {
            showNotification({ type: 'error', title: 'Update Failed', message: data.error || 'Failed to update status', duration: 5000 });
          }
        }
      });
    };

    window.markNoShow = async function (id, btn) {
      return openCustomerNotAvailable(id, btn);
    };

    // ── Customer Not Available Flow (waiting window → report no-show) ─────────
    // Opens the modal in "start" mode (collect contact attempts + arrival proof,
    // begin the waiting window) or "resume" mode (show live countdown and the
    // Report No-Show button once the wait has elapsed).
    async function openCustomerNotAvailable(assignmentId, btn, mode) {
      mode = mode || 'start';
      let assignment = (window._allAssignments || []).find(a => String(a._id) === String(assignmentId));
      if (!assignment && window._detailAssignment && String(window._detailAssignment._id) === String(assignmentId)) {
        assignment = window._detailAssignment;
      }

      const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');

      // Fetch the assignment (fresh, with noShowReport + wait config)
      let fresh = null;
      try {
        const r = await fetch(`/api/technician/assignments/${assignmentId}`, { credentials: 'same-origin' });
        if (r.ok) fresh = await r.json();
      } catch (e) { /* ignore */ }
      const a = fresh || assignment;
      const report = a.noShowReport || a.bookingId?.noShowReport || {};
      const waitMinutes = Number(a.noShowWaitMinutes || report.waitMinutes || 15);
      const arrivedAt = new Date(report.arrivedAt || a.arrivedAt || Date.now());
      const waitingUntil = report.waitingUntil ? new Date(report.waitingUntil) : new Date(arrivedAt.getTime() + waitMinutes * 60000);

      const renderTimer = () => {
        const now = new Date();
        const diff = waitingUntil - now;
        const remaining = Math.max(0, Math.ceil(diff / 1000));
        const mins = Math.floor(remaining / 60);
        const secs = remaining % 60;
        const fmt = new Intl.DateTimeFormat('en-PH', { hour: '2-digit', minute: '2-digit' }).format;
        const arrivedLabel = fmt(arrivedAt);
        const untilLabel = fmt(waitingUntil);
        const nowLabel = fmt(now);
        const done = diff <= 0;
        return `
          <div class="row g-2 text-start">
            <div class="col-12">
              <div class="alert alert-warning py-2 px-3 mb-2" style="font-size:0.85rem;"><i class="bi bi-hourglass-split me-1"></i><strong>Waiting for Customer</strong></div>
              <div class="d-flex justify-content-between text-muted small mb-1">
                <span><i class="bi bi-geo-alt me-1"></i>Arrived: <strong>${arrivedLabel}</strong></span>
                <span><i class="bi bi-clock me-1"></i>Now: <strong>${nowLabel}</strong></span>
                <span><i class="bi bi-hourglass me-1"></i>Wait until: <strong>${untilLabel}</strong></span>
              </div>
              <div class="progress mb-2" style="height:10px;">
                <div class="progress-bar progress-bar-striped ${done ? 'bg-success' : 'bg-warning'}" style="width:${done ? '100%' : '100%'}"></div>
              </div>
              <div class="text-center" style="font-size:1.6rem;font-weight:800;color:${done ? '#16a34a' : '#d97706'};font-variant-numeric:tabular-nums;">
                ${done ? '<i class="bi bi-check-circle me-1"></i>Waiting period complete' : `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')} remaining`}
              </div>
              <small class="text-muted d-block text-center mt-1">Attempted contact: ${(report.contactAttempts || a.contactAttempts || []).map(x => esc(x)).join(', ') || '—'}</small>
            </div>
          </div>`;
      };

      // ── START MODE: collect attempts + arrival proof, then begin waiting ──
      if (mode === 'start') {
        const startRes = await Swal.fire({
          title: 'Customer Not Available',
          html: `
            <div class="text-start">
              <p class="text-muted small mb-3">You are at the customer\u2019s location but they are not available. Confirm your contact attempts and upload your arrival proof.</p>
              <label class="form-label fw-bold">Have you attempted to contact the customer?</label>
              <div class="d-flex gap-2 flex-wrap mb-2">
                <label class="form-check" style="flex:1;"><input class="form-check-input contact-attempt" type="checkbox" value="Call"> <span class="form-check-label"><i class="bi bi-telephone me-1"></i>Call</span></label>
                <label class="form-check" style="flex:1;"><input class="form-check-input contact-attempt" type="checkbox" value="SMS"> <span class="form-check-label"><i class="bi bi-chat-dots me-1"></i>SMS</span></label>
                <label class="form-check" style="flex:1;"><input class="form-check-input contact-attempt" type="checkbox" value="In-app notification"> <span class="form-check-label"><i class="bi bi-bell me-1"></i>In-app</span></label>
              </div>
              <label class="form-label fw-bold">Arrival proof <span class="text-danger">*</span></label>
              <input type="file" id="cnaArrivalProof" accept="image/*" capture="environment" class="form-control mb-2">
              <div class="alert alert-light border py-2 px-3" style="font-size:0.8rem;"><i class="bi bi-info-circle me-1"></i>Waiting period: <strong>${waitMinutes} minutes</strong> starting from your arrival (${fmt(arrivedAt)} → ${fmt(waitingUntil)}).</div>
            </div>`,
          icon: 'question',
          showCancelButton: true,
          confirmButtonText: '<i class="bi bi-hourglass-split me-1"></i> Start Waiting',
          cancelButtonText: 'Go Back',
          confirmButtonColor: '#d97706',
          preConfirm: async () => {
            const attempts = [...document.querySelectorAll('.contact-attempt:checked')].map(c => c.value);
            if (!attempts.length) return Swal.showValidationMessage('Select at least one contact attempt.');
            const file = document.getElementById('cnaArrivalProof')?.files?.[0];
            if (!file) return Swal.showValidationMessage('Upload your arrival proof photo.');
            if (!file.type.startsWith('image/')) return Swal.showValidationMessage('Please select an image file.');
            const arrivalProofUrl = await new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.onerror = reject; reader.readAsDataURL(file); });
            return { contactAttempts: attempts, arrivalProofUrl };
          }
        });

        if (!startRes.isConfirmed) {
          if (btn) { btn.classList.remove('btn-loading'); btn.disabled = false; btn._btnLoadingActive = false; }
          return;
        }

        Swal.fire({ title: 'Starting Wait...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
        try {
          const res = await fetch(`/api/technician/assignments/${assignmentId}/customer-not-available`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
            body: JSON.stringify(startRes.value)
          });
          const data = await res.json();
          Swal.close();
          if (!res.ok) {
            Swal.fire('Action Failed', data.error || 'Failed to start waiting.', 'error');
            return;
          }
          showNotification({ type: 'info', title: 'Waiting for Customer', message: `Waiting until ${new Date(data.waitingUntil).toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' })}.`, duration: 5000 });
          loadAssignments(currentFilter, currentPage);
          if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
            showDetail(window._currentDetailId);
          }
        } catch (e) {
          Swal.close();
          Swal.fire('Error', 'Network error.', 'error');
        }
        return;
      }

      // ── RESUME MODE: live countdown + Report No-Show once elapsed ──
      const runCountdown = (timerEl, btnEl) => {
        const tick = () => {
          const now = new Date();
          const diff = waitingUntil - now;
          const remaining = Math.max(0, Math.ceil(diff / 1000));
          const mins = Math.floor(remaining / 60);
          const secs = remaining % 60;
          const done = diff <= 0;
          if (timerEl) {
            timerEl.innerHTML = renderTimer();
            const big = timerEl.querySelector('.text-center[style*="1.6rem"]');
            if (big) big.textContent = done ? '<i class="bi bi-check-circle me-1"></i>Waiting period complete' : `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')} remaining`;
          }
          if (btnEl) {
            btnEl.disabled = !done;
            btnEl.innerHTML = done
              ? '<i class="bi bi-person-exclamation me-1"></i>Report Customer No-Show'
              : `<i class="bi bi-hourglass-split me-1"></i>Wait ${mins}:${String(secs).padStart(2,'0')}`;
          }
          if (!done) { clearTimeout(window.__cnaTimer); window.__cnaTimer = setTimeout(tick, 1000); }
        };
        tick();
      };

      const resumeRes = await Swal.fire({
        title: 'Customer Not Available',
        html: `<div id="cnaTimerBody"></div>`,
        icon: 'question',
        showCancelButton: true,
        showConfirmButton: true,
        confirmButtonText: '<i class="bi bi-hourglass-split me-1"></i> Wait...',
        cancelButtonText: 'Close',
        confirmButtonColor: '#dc2626',
        allowOutsideClick: false,
        didOpen: () => {
          const body = document.getElementById('cnaTimerBody');
          if (body) {
            body.innerHTML = renderTimer();
            const btn = Swal.getConfirmButton();
            runCountdown(body, btn);
          }
        }
      });

      clearTimeout(window.__cnaTimer);
      if (!resumeRes.isConfirmed) return;

      // Report no-show
      Swal.fire({ title: 'Reporting No-Show...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
      try {
        const res = await fetch(`/api/technician/assignments/${assignmentId}/report-no-show`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin'
        });
        const data = await res.json();
        Swal.close();
        if (!res.ok) {
          if (data.code === 'WAITING_PERIOD_NOT_ELAPSED') {
            Swal.fire('Too Early', data.error || 'The waiting period has not elapsed yet.', 'warning');
            return;
          }
          Swal.fire('Action Failed', data.error || 'Failed to report no-show.', 'error');
          return;
        }
        showNotification({ type: 'warning', title: 'No-Show Reported', message: 'Waiting for an admin decision in the Booking Resolution Center.', duration: 5000 });
        loadAssignments(currentFilter, currentPage);
        if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
          showDetail(window._currentDetailId);
        }
      } catch (e) {
        Swal.close();
        Swal.fire('Error', 'Network error.', 'error');
      }
    }
    window.openCustomerNotAvailable = openCustomerNotAvailable;

    // ── No-Show Reschedule Flow ────────────────────────────────────────────
    async function openNoShowReschedule(assignmentId) {
      // Find the assignment to get duration
      const assignment = (window._allAssignments || []).find(a => String(a._id) === String(assignmentId));
      const duration = assignment?.bookingId?.technicianAssistant?.estimatedDurationMinutes
        || assignment?.bookingId?.service?.durationMinutes
        || assignment?.bookingId?.service?.estimatedDurationMinutes
        || 90;

      // Load available dates
      Swal.fire({ title: 'Loading Available Dates...', html: 'Checking schedule capacity...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
      let availableDates = [];
      try {
        const resp = await fetch(`/api/technician/appointments/available-dates?duration=${duration}`, { credentials: 'same-origin' });
        const data = await resp.json();
        Swal.close();
        if (resp.ok && data.dates) {
          availableDates = data.dates;
        } else {
          Swal.fire('Error', 'Failed to load available dates.', 'error');
          return;
        }
      } catch (e) {
        Swal.close();
        Swal.fire('Error', 'Network error loading dates.', 'error');
        return;
      }

      // Build date grid
      const dateHtml = availableDates.map(d => {
        const dt = new Date(d.date + 'T00:00:00');
        const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        const dayLabel = dayNames[dt.getDay()];
        const monthDay = `${monthNames[dt.getMonth()]} ${dt.getDate()}`;

        if (d.available) {
          const slotsText = d.remainingSlots === 1 ? '1 slot left' : `${d.remainingSlots} slots left`;
          return `<label class="nsched-date-card available" data-date="${d.date}">
            <input type="radio" name="nsSchedDate" value="${d.date}" class="d-none">
            <div class="nsched-date-day">${dayLabel}</div>
            <div class="nsched-date-md">${monthDay}</div>
            <div class="nsched-date-slots"><i class="bi bi-check-circle-fill"></i> ${slotsText}</div>
          </label>`;
        } else {
          return `<label class="nsched-date-card unavailable" title="${d.reason}">
            <div class="nsched-date-day">${dayLabel}</div>
            <div class="nsched-date-md">${monthDay}</div>
            <div class="nsched-date-slots"><i class="bi bi-x-circle-fill"></i> ${d.reason}</div>
          </label>`;
        }
      }).join('');

      const { value: formValues } = await Swal.fire({
        title: 'Reschedule Booking',
        html: `<div style="text-align:left;font-size:0.9rem;">
          <style>
            .nsched-date-card{display:flex;flex-direction:column;align-items:center;gap:4px;padding:14px 10px;border:2px solid #e2e8f0;border-radius:14px;cursor:pointer;transition:all 0.2s;min-width:90px;text-align:center;}
            .nsched-date-card.available{background:#eff6ff;border-color:#bfdbfe;}
            .nsched-date-card.available:hover{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,0.15);}
            .nsched-date-card.available:has(input:checked){border-color:#2563eb;background:#dbeafe;box-shadow:0 0 0 3px rgba(59,130,246,0.2);}
            .nsched-date-card.unavailable{background:#f8fafc;border-color:#e2e8f0;opacity:0.55;cursor:not-allowed;}
            .nsched-date-day{font-weight:700;font-size:0.82rem;color:#1e293b;}
            .nsched-date-md{font-size:0.75rem;color:#64748b;}
            .nsched-date-slots{font-size:0.68rem;color:#2563eb;margin-top:2px;}
            .nsched-date-card.unavailable .nsched-date-slots{color:#94a3b8;}
          </style>
          <p style="color:#475569;margin-bottom:12px;">Select a new date and time window for this booking:</p>
          <div class="mb-3">
            <label class="form-label fw-bold" style="font-size:0.82rem;"><i class="bi bi-calendar3 me-1" style="color:#2563eb;"></i>Available Dates</label>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:10px;" id="nsAvailDates">${dateHtml}</div>
          </div>
          <div class="mb-2">
            <label class="form-label fw-bold" style="font-size:0.82rem;"><i class="bi bi-clock me-1" style="color:#2563eb;"></i>Preferred Time Window</label>
            <div class="d-flex flex-wrap gap-2">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="nsSchedTime" value="any" id="ns_time_any" checked>
                <label class="form-check-label" for="ns_time_any" style="font-size:0.82rem;">Any Time (8AM-5PM)</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="nsSchedTime" value="morning" id="ns_time_morning">
                <label class="form-check-label" for="ns_time_morning" style="font-size:0.82rem;">Morning (8AM-12PM)</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="nsSchedTime" value="afternoon" id="ns_time_afternoon">
                <label class="form-check-label" for="ns_time_afternoon" style="font-size:0.82rem;">Afternoon (12PM-5PM)</label>
              </div>
            </div>
          </div>
        </div>`,
        showCancelButton: true,
        confirmButtonText: '<i class="bi bi-arrow-right me-1"></i> Pick Time Slot',
        cancelButtonText: 'Back',
        confirmButtonColor: '#2563eb',
        focusConfirm: false,
        allowOutsideClick: false,
        didOpen: () => {
          document.querySelectorAll('.nsched-date-card.available').forEach(card => {
            card.addEventListener('click', () => {
              document.querySelectorAll('.nsched-date-card.available').forEach(c => c.classList.remove('selected'));
              card.classList.add('selected');
              card.querySelector('input[type="radio"]').checked = true;
            });
          });
        },
        preConfirm: () => {
          const selected = document.querySelector('input[name="nsSchedDate"]:checked');
          const timeRadio = document.querySelector('input[name="nsSchedTime"]:checked');
          if (!selected) { Swal.showValidationMessage('Please select an available date'); return false; }
          return { preferredDate: selected.value, preferredTimeWindow: timeRadio ? timeRadio.value : 'any' };
        }
      });

      if (!formValues) return;

      // Now show time slots for the selected date
      const selectedDateStr = formValues.preferredDate;
      const timeWindow = formValues.preferredTimeWindow;

      Swal.fire({ title: 'Loading Time Slots...', html: `Fetching slots for ${selectedDateStr}...`, allowOutsideClick: false, didOpen: () => Swal.showLoading() });

      let timeSlots = [];
      try {
        const slotUrl = `/api/schedule/time-slots?date=${selectedDateStr}&duration=${duration}&preferredTimeWindow=${timeWindow}`;
        const slotResp = await fetch(slotUrl, { credentials: 'same-origin' });
        const slotData = await slotResp.json();
        Swal.close();
        if (slotResp.ok && slotData.slots) {
          timeSlots = slotData.slots;
        } else {
          Swal.fire('Error', 'Failed to load time slots.', 'error');
          return;
        }
      } catch (e) {
        Swal.close();
        Swal.fire('Error', 'Network error loading time slots.', 'error');
        return;
      }

      // Build time slot grid
      const slotHtml = timeSlots.map(s => {
        const booked = !s.available && !s.isPast;
        const isDisabled = s.isPast || booked;
        return `<label class="nsched-slot${isDisabled ? ' unavailable' : ''}" data-start="${s.startTime}" ${!isDisabled ? 'role="button"' : ''}>
          <input type="radio" name="nsSchedSlot" value="${s.startTime}" class="d-none" ${isDisabled ? 'disabled' : ''}>
          <div class="nsched-slot-time">${s.startTime}</div>
          <div class="nsched-slot-status">${s.isPast ? 'Passed' : (booked ? 'Fully Booked' : 'Open')}</div>
        </label>`;
      }).join('');

      const dateObj = new Date(selectedDateStr + 'T00:00:00');
      const formattedDate = dateObj.toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

      const { value: slotValues } = await Swal.fire({
        title: 'Select Time Slot',
        html: `<div style="text-align:left;font-size:0.9rem;">
          <style>
            .nsched-slot{display:flex;flex-direction:column;align-items:center;gap:2px;padding:12px 10px;border:2px solid #e2e8f0;border-radius:12px;cursor:pointer;transition:all 0.2s;min-width:80px;text-align:center;}
            .nsched-slot:not(.unavailable):hover{border-color:#2563eb;box-shadow:0 0 0 3px rgba(59,130,246,0.15);}
            .nsched-slot:has(input:checked){border-color:#2563eb;background:#dbeafe;box-shadow:0 0 0 3px rgba(59,130,246,0.2);}
            .nsched-slot.unavailable{opacity:0.45;cursor:not-allowed;background:#f8fafc;}
            .nsched-slot-time{font-weight:700;font-size:0.82rem;color:#1e293b;}
            .nsched-slot-status{font-size:0.68rem;color:#64748b;}
            .nsched-slot.unavailable .nsched-slot-status{color:#94a3b8;}
          </style>
          <p style="color:#475569;margin-bottom:4px;">${formattedDate}</p>
          <p style="color:#94a3b8;font-size:0.82rem;margin-bottom:12px;">Choose an available time slot:</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:10px;" id="nsSlotGrid">${slotHtml}</div>
        </div>`,
        showCancelButton: true,
        confirmButtonText: '<i class="bi bi-check-lg me-1"></i> Confirm Reschedule',
        cancelButtonText: 'Pick Another Date',
        confirmButtonColor: '#2563eb',
        focusConfirm: false,
        allowOutsideClick: false,
        didOpen: () => {
          document.querySelectorAll('.nsched-slot:not(.unavailable)').forEach(card => {
            card.addEventListener('click', () => {
              document.querySelectorAll('.nsched-slot').forEach(c => c.classList.remove('selected'));
              card.classList.add('selected');
              card.querySelector('input[type="radio"]').checked = true;
            });
          });
        },
        preConfirm: () => {
          const selectedSlot = document.querySelector('input[name="nsSchedSlot"]:checked');
          if (!selectedSlot) { Swal.showValidationMessage('Please select a time slot'); return false; }
          return { startTime: selectedSlot.value };
        }
      });

      if (!slotValues) {
        // User clicked "Pick Another Date" — restart
        return openNoShowReschedule(assignmentId);
      }

      // Final confirmation
      const finalDateObj = new Date(selectedDateStr + 'T00:00:00');
      const finalFormatted = finalDateObj.toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

      const finalConfirm = await Swal.fire({
        title: 'Confirm Reschedule',
        html: `<div style="text-align:left;font-size:0.9rem;">
          <p>Please confirm the new schedule:</p>
          <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:14px 16px;">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
              <i class="bi bi-calendar-check" style="color:#2563eb;font-size:1.2rem;"></i>
              <strong style="color:#1e40af;">${finalFormatted}</strong>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
              <i class="bi bi-clock" style="color:#2563eb;font-size:1.1rem;"></i>
              <span style="color:#1e40af;">${slotValues.startTime}</span>
            </div>
          </div>
        </div>`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: '<i class="bi bi-check-lg me-1"></i> Yes, Reschedule',
        cancelButtonText: 'Go Back',
        confirmButtonColor: '#2563eb',
      });

      if (!finalConfirm.isConfirmed) {
        return openNoShowReschedule(assignmentId);
      }

      // Submit reschedule
      Swal.fire({ title: 'Rescheduling...', html: 'Updating booking...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
      try {
        const res = await fetch(`/api/technician/assignments/${assignmentId}/no-show-reschedule`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
          body: JSON.stringify({ newDate: selectedDateStr, newTime: slotValues.startTime })
        });
        const data = await res.json();
        if (res.ok) {
          Swal.fire('Rescheduled!', 'Booking has been rescheduled successfully.', 'success');
          loadAssignments(currentFilter, currentPage);
        } else {
          Swal.fire('Error', data.error || 'Failed to reschedule.', 'error');
        }
      } catch (e) {
        Swal.close();
        Swal.fire('Error', 'Network error.', 'error');
      }
    }

    // ── Collect Payment Modal ─────────────────────────────────────────────
    let collectTargetId = null;
    let collectTargetAssignment = null;
    let collectSubmitting = false;

    window.openCollectPaymentModal = async function (id, assignment, autoComplete = false, postPaymentAction = null) {
      // Opening a modal is never a status transition. When `autoComplete` is
      // requested, payment is saved first and completion is committed only by
      // the proof-of-completion endpoint after the technician submits proof.
      collectTargetId = id;
      collectTargetAssignment = assignment;
      collectSubmitting = false;
      window._completeAfterPayment = autoComplete;
      window._postPaymentAction = postPaymentAction;
      const _b = assignment?.bookingId || {};
      // Compute correct total: repairs = inspectionFee + travelFee + quotation, core = totalPrice
      const _paymentItems = Array.isArray(_b.services || assignment.services) ? (_b.services || assignment.services) : [];
      const _isMixedPay = _b.serviceType === 'mixed'
        || (_paymentItems.some(s => s.type === 'core') && _paymentItems.some(s => s.type === 'repair'));
      const _isRepairPay = (_b.serviceType === 'repair') || _paymentItems.some(s => s.type === 'repair');
      let total = 0;
      if (_isMixedPay) {
        total = Number(_b.totalPrice || assignment.totalPrice || _b.estimatedFee || assignment.estimatedFee || 0)
          + Number(_b.quotation?.totalCost || 0);
      } else if (_isRepairPay) {
        const inspFee = _b.inspectionFeeTotalCollected || _b.initialCost || assignment.initialCost || 0;
        const travelFee = _b.travelFare || 0;
        const quotTotal = (_b.quotation && _b.quotation.totalCost) || 0;
        total = _b.inspectionFeeCollected ? quotTotal : (inspFee + travelFee + quotTotal);
      }
      if (!total) total = assignment.totalPrice || assignment.estimatedFee || _b.totalPrice || _b.totalCost || 0;
      // Downpayment already collected at booking — show it so the technician
      // isn't confused about the remaining balance to collect on-site.
      const downpayment = _b.inspectionFeeCollected ? 0 : Number(_b.downpaymentAmount || assignment.downpaymentAmount || 0);
      const dpRow = document.getElementById('paymentDownpaymentRow');
      const dpEl = document.getElementById('paymentDownpayment');
      if (downpayment > 0) {
        dpRow.style.display = 'flex';
        dpEl.textContent = '-₱' + downpayment.toLocaleString();
      } else {
        dpRow.style.display = 'none';
        dpEl.textContent = '-₱0';
      }
      // Remaining balance = stored balance, but fall back to (total - downpayment)
      // so the technician collects only what's actually left.
      const storedBalance = Number(assignment.balanceAmount ?? _b.balanceAmount);
      const calculatedBalance = Math.max(0, total - Number(_b.amountPaid ?? assignment.amountPaid ?? downpayment));
      let balance = Math.max(Number.isFinite(storedBalance) ? storedBalance : 0, calculatedBalance);
      document.getElementById('paymentTotalFee').textContent = '₱' + total.toLocaleString();
      document.getElementById('paymentBalanceDue').textContent = '₱' + balance.toLocaleString();
      document.getElementById('paymentPartsTotal').textContent = '₱0';
      document.getElementById('paymentLaborCost').textContent = '₱0';
      document.getElementById('paymentAmountInput').value = balance;
      document.getElementById('paymentAmountInput').max = balance;
      document.getElementById('paymentAmountHint').textContent = `Enter the full balance amount (max ₱${balance.toLocaleString()})`;
      document.getElementById('paymentNotesInput').value = '';
      document.getElementById('collectionReference').value = '';
      document.getElementById('collectionProof').value = '';
      document.getElementById('collectionSignature').value = '';
      document.getElementById('collectionCustomerPhoto').value = '';
      document.getElementById('collectionMethod').value = 'cash';
      document.getElementById('collectionReferenceWrap').classList.add('d-none');
      document.getElementById('collectionProofRequired').classList.add('d-none');
      document.getElementById('paymentErrorBox').classList.add('d-none');
      document.getElementById('confirmCollectBtn').disabled = false;
      document.getElementById('confirmCollectBtn').innerHTML = '<i class="bi bi-check-circle me-1"></i>Collect Payment';
      document.getElementById('paymentModalSubtitle').textContent = `${assignment.customerName || 'Customer'} — ${assignment.serviceName || 'Service'}`;

      // Service & Customer Summary
      document.getElementById('paymentServiceName').textContent = assignment.serviceName || '—';
      document.getElementById('paymentCustomerName').textContent = assignment.customerName || '—';
      document.getElementById('paymentCustomerAddress').textContent = assignment.address ? (assignment.address.length > 60 ? assignment.address.substring(0, 60) + '...' : assignment.address) : '—';

      // Fetch quotation data from booking
      const bookingId = assignment.bookingId?._id || assignment.bookingId;
      const quotationBox = document.getElementById('paymentQuotationBox');
      const quotationParts = document.getElementById('paymentQuotationParts');
      const repairBox = document.getElementById('paymentRepairBox');
      const repairParts = document.getElementById('paymentRepairParts');
      const repairActions = document.getElementById('paymentRepairActions');
      const repairNotes = document.getElementById('paymentRepairNotes');
      const inspectionBox = document.getElementById('paymentInspectionBox');
      const inspectionFindings = document.getElementById('paymentInspectionFindings');
      const inspectionDiagnosis = document.getElementById('paymentInspectionDiagnosis');
      if (bookingId) {
        fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' })
          .then(r => r.json())
          .then(detail => {
            const booking = detail.booking || detail;

            // Populate inspection findings
            const insp = booking.inspection || {};
            const diag = booking.diagnosis || {};
            const hasInspection = insp.findings || diag.findings || insp.recommendedAction || insp.severity;
            if (hasInspection) {
              inspectionBox.style.display = 'block';
              inspectionFindings.textContent = insp.findings || diag.findings || '—';
              // Severity
              const severityRow = document.getElementById('paymentInspectionSeverityRow');
              if (insp.severity) {
                severityRow.style.display = 'block';
                const sevEl = document.getElementById('paymentInspectionSeverity');
                const sevColors = { minor: '#16a34a', major: '#d97706', critical: '#dc2626' };
                sevEl.innerHTML = `<span style="color:${sevColors[insp.severity] || '#334155'};font-weight:600;text-transform:capitalize;">${insp.severity}</span>`;
              } else { severityRow.style.display = 'none'; }
              // Damaged Parts
              const damagedRow = document.getElementById('paymentInspectionDamagedRow');
              const damagedParts = insp.damagedParts || diag.damagedParts;
              if (damagedParts && damagedParts.length) {
                damagedRow.style.display = 'block';
                document.getElementById('paymentInspectionDamagedParts').innerHTML = damagedParts.map(p => `<span style="background:#fef2f2;color:#991b1b;padding:2px 8px;border-radius:6px;font-size:0.78rem;margin-right:4px;">${p}</span>`).join('');
              } else { damagedRow.style.display = 'none'; }
              // Diagnosis
              inspectionDiagnosis.textContent = diag.findings || insp.diagnosis || '—';
              // Recommended Action
              const actionRow = document.getElementById('paymentInspectionActionRow');
              if (insp.recommendedAction) {
                actionRow.style.display = 'block';
                document.getElementById('paymentInspectionRecommendedAction').textContent = insp.recommendedAction;
              } else { actionRow.style.display = 'none'; }
            } else {
              inspectionBox.style.display = 'none';
            }

            // Populate quotation
            const q = booking.quotation || {};
            const qParts = q.parts || [];
            if (qParts.length > 0 || q.laborCost) {
              const partsTotal = qParts.reduce((sum, p) => sum + ((p.cost || p.unitPrice || p.price || 0) * (p.quantity || 1)), 0);
              document.getElementById('paymentPartsTotal').textContent = '₱' + partsTotal.toLocaleString();
              document.getElementById('paymentLaborCost').textContent = '₱' + (q.laborCost || 0).toLocaleString();
              quotationParts.innerHTML = qParts.map(p => {
                const unitPrice = p.cost || p.unitPrice || p.price || 0;
                const qty = p.quantity || 1;
                return `<div class="d-flex justify-content-between mb-1" style="font-size:0.82rem;">
                <span>${p.name || p.partName || 'Part'} × ${qty}</span>
                <span class="fw-semibold">₱${(unitPrice * qty).toLocaleString()}</span>
              </div>`;
              }).join('');
              document.getElementById('paymentQuotationLabor').textContent = '₱' + (q.laborCost || 0).toLocaleString();
              const qTotal = q.totalCost || (partsTotal + (q.laborCost || 0));
              document.getElementById('paymentQuotationTotal').textContent = '₱' + qTotal.toLocaleString();
              // Update Total Service Fee: for repairs, add inspection fee + travel fee to quotation total
              const _phase1Settled = Boolean(booking.inspectionFeeCollected);
              const _inspFee = booking.inspectionFeeAmount || booking.initialCost || 0;
              const _travelFee = booking.inspectionFeeDistanceFare || booking.travelFare || 0;
              const _isRepairPayment = booking.serviceType === 'repair' || (booking.services && booking.services.some(s => s.type === 'repair'));
              const _fullTotal = _isRepairPayment && !_phase1Settled ? (_inspFee + _travelFee + qTotal) : qTotal;
              // Reflect any downpayment already collected
              const _dp = _phase1Settled ? 0 : Number(booking.downpaymentAmount || collectTargetAssignment?.downpaymentAmount || 0);
              const _dpRow = document.getElementById('paymentDownpaymentRow');
              const _dpEl = document.getElementById('paymentDownpayment');
              if (_dp > 0) {
                _dpRow.style.display = 'flex';
                _dpEl.textContent = '-₱' + _dp.toLocaleString();
              } else {
                _dpRow.style.display = 'none';
              }
              const _storedBal = Number(booking.balanceAmount);
              const _paid = _phase1Settled ? 0 : Number(booking.amountPaid ?? collectTargetAssignment?.amountPaid ?? _dp);
              const _calculatedBal = Math.max(0, _fullTotal - _paid);
              const _bal = _phase1Settled ? qTotal : Math.max(Number.isFinite(_storedBal) ? _storedBal : 0, _calculatedBal);
              document.getElementById('paymentTotalFee').textContent = '₱' + _fullTotal.toLocaleString();
              document.getElementById('paymentBalanceDue').textContent = '₱' + _bal.toLocaleString();
              document.getElementById('paymentAmountInput').value = _bal;
              document.getElementById('paymentAmountInput').max = _bal;
              document.getElementById('paymentAmountHint').textContent = `Enter the full balance amount (max ₱${_bal.toLocaleString()})`;
              // Quotation notes
              const notesRow = document.getElementById('paymentQuotationNotesRow');
              if (q.notes) {
                notesRow.style.display = 'block';
                document.getElementById('paymentQuotationNotes').textContent = q.notes;
              } else { notesRow.style.display = 'none'; }
              quotationBox.style.display = 'block';
            } else {
              quotationBox.style.display = 'none';
            }

            // Populate repair completion materials if available
            const rc = booking.repairCompletion || {};
            if (rc.partsInstalled?.length || rc.actionsPerformed?.length) {
              repairBox.style.display = 'block';
              if (rc.partsInstalled?.length) {
                repairParts.innerHTML = rc.partsInstalled.map(p =>
                  `<div class="d-flex justify-content-between mb-1" style="font-size:0.82rem;">
                  <span>${p.name || 'Part'} × ${p.quantity || 1} ${p.unit || 'pcs'}</span>
                  <span class="fw-semibold">₱${((p.cost || p.unitPrice || p.price || 0) * (p.quantity || 1)).toLocaleString()}</span>
                </div>`
                ).join('');
              } else { repairParts.innerHTML = ''; }
              if (rc.actionsPerformed?.length) {
                repairActions.innerHTML = `<div style="font-size:0.82rem;"><strong>Actions:</strong> ${rc.actionsPerformed.join(', ')}</div>`;
              } else { repairActions.innerHTML = ''; }
              if (rc.completionNotes) {
                repairNotes.innerHTML = `<div style="font-size:0.82rem;"><strong>Notes:</strong> ${rc.completionNotes}</div>`;
              } else { repairNotes.innerHTML = ''; }
            } else { repairBox.style.display = 'none'; }
          })
          .catch(() => { quotationBox.style.display = 'none'; repairBox.style.display = 'none'; inspectionBox.style.display = 'none'; });
      } else {
        quotationBox.style.display = 'none';
        repairBox.style.display = 'none';
        inspectionBox.style.display = 'none';
      }

      // Use getOrCreateInstance to prevent duplicate modal instances
      const modalEl = document.getElementById('collectPaymentModal');
      bootstrap.Modal.getOrCreateInstance(modalEl).show();
    };

    document.getElementById('collectionMethod').addEventListener('change', function(){const manual=this.value==='gcash'||this.value==='bank';document.getElementById('collectionReferenceWrap').classList.toggle('d-none',!manual);document.getElementById('collectionProofRequired').classList.toggle('d-none',!manual);});
    document.getElementById('confirmCollectBtn').addEventListener('click', async function () {
      const amount = parseFloat(document.getElementById('paymentAmountInput').value);
      const notes = document.getElementById('paymentNotesInput').value.trim();
      const method = document.getElementById('collectionMethod').value;
      const reference = document.getElementById('collectionReference').value.trim();
      const customerSignature = document.getElementById('collectionSignature').value.trim();
      const proofFile = document.getElementById('collectionProof').files[0];
      const customerPhotoFile = document.getElementById('collectionCustomerPhoto').files[0];
      const errorBox = document.getElementById('paymentErrorBox');
      const balance = collectTargetAssignment.balanceAmount || 0;

      if (!amount || amount <= 0) {
        errorBox.textContent = 'Please enter a valid amount.';
        errorBox.classList.remove('d-none');
        return;
      }
      if ((method === 'cash' && !customerSignature && !proofFile && !customerPhotoFile) || ((method === 'gcash' || method === 'bank') && (!reference || !proofFile))) { errorBox.textContent = method === 'cash' ? 'Add at least one proof: customer signature, receipt photo, or customer confirmation photo.' : 'Reference number and receipt screenshot are required.'; errorBox.classList.remove('d-none'); return; }

      this.disabled = true;
      this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing...';
      collectSubmitting = true;

      try {
        const proofUrl = proofFile ? await new Promise((resolve,reject)=>{const fr=new FileReader();fr.onload=()=>resolve(fr.result);fr.onerror=reject;fr.readAsDataURL(proofFile);}) : null;
        const customerPhotoUrl = customerPhotoFile ? await new Promise((resolve,reject)=>{const fr=new FileReader();fr.onload=()=>resolve(fr.result);fr.onerror=reject;fr.readAsDataURL(customerPhotoFile);}) : null;
        const location = await new Promise(resolve=>{if(!navigator.geolocation)return resolve(null);navigator.geolocation.getCurrentPosition(p=>resolve({lat:p.coords.latitude,lng:p.coords.longitude,accuracy:p.coords.accuracy}),()=>resolve(null),{timeout:5000,enableHighAccuracy:true});});
        const res = await fetch(`/api/technician/assignments/${collectTargetId}/collect-payment`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ amount, method, reference, proofUrl, customerSignature, customerPhotoUrl, notes, location })
        });
        const data = await res.json();
        if (res.ok) {
          // Keep the open assignment in sync immediately. A zero balance must
          // remain zero while the refreshed list is loading.
          collectTargetAssignment.balanceAmount = Number(data.balanceAmount ?? 0);
          collectTargetAssignment.amountPaid = Number(data.amountPaid ?? collectTargetAssignment.amountPaid ?? amount);
          collectTargetAssignment.balanceCollected = data.balanceCollected ?? (collectTargetAssignment.balanceAmount <= 0);
          collectTargetAssignment.repairPaymentCollected = data.repairPaymentCollected ?? collectTargetAssignment.repairPaymentCollected;
          collectTargetAssignment.repairPaymentAmount = data.repairPaymentAmount ?? collectTargetAssignment.repairPaymentAmount;
          collectTargetAssignment.paymentStatus = data.paymentStatus || 'waiting_for_remittance';
          const collectedBooking = collectTargetAssignment.bookingId && typeof collectTargetAssignment.bookingId === 'object'
            ? collectTargetAssignment.bookingId
            : (collectTargetAssignment.booking && typeof collectTargetAssignment.booking === 'object' ? collectTargetAssignment.booking : null);
          if (collectedBooking) {
            collectedBooking.balanceAmount = collectTargetAssignment.balanceAmount;
            collectedBooking.amountPaid = collectTargetAssignment.amountPaid;
            collectedBooking.balanceCollected = collectTargetAssignment.balanceCollected;
            collectedBooking.repairPaymentCollected = collectTargetAssignment.repairPaymentCollected;
            collectedBooking.repairPaymentAmount = collectTargetAssignment.repairPaymentAmount;
            collectedBooking.paymentStatus = collectTargetAssignment.paymentStatus;
          }
          if (window._detailAssignment && String(window._detailAssignment._id) === String(collectTargetId)) {
            window._detailAssignment = collectTargetAssignment;
            const activePage = document.querySelector('#detailPanelContent .mw-detail-tab.active')?.dataset?.tab || 'overview';
            const actionBar = document.getElementById('detailPanelActions');
            if (actionBar) {
              const nextActions = getWizardPageActions(activePage, collectTargetAssignment);
              actionBar.innerHTML = nextActions;
              actionBar.style.display = nextActions ? 'flex' : 'none';
            }
          }
          collectSubmitting = false;
          bootstrap.Modal.getOrCreateInstance(document.getElementById('collectPaymentModal')).hide();
          showNotification({ type: 'success', title: 'Payment Collected', message: data.message, duration: 5000 });

          if (window._postPaymentAction) {
            setTimeout(() => { window._postPaymentAction(); window._postPaymentAction = null; }, 300);
          } else if (window._completeAfterPayment) {
            // Open Proof of Completion modal so technician uploads photo to complete
            setTimeout(() => {
              openProofModal(
                collectTargetId,
                collectTargetAssignment.customerName,
                collectTargetAssignment.serviceName,
                collectTargetAssignment.totalPrice || collectTargetAssignment.estimatedFee || 0,
                true
              );
            }, 300);
          } else {
            // Re-open details modal with updated payment details
            setTimeout(() => {
              showDetail(collectTargetId);
            }, 300);
          }
          loadAssignments(currentFilter, currentPage);
        } else {
          collectSubmitting = false;
          errorBox.textContent = data.error || 'Failed to collect payment.';
          errorBox.classList.remove('d-none');
          document.getElementById('confirmCollectBtn').disabled = false;
          document.getElementById('confirmCollectBtn').innerHTML = '<i class="bi bi-check-circle me-1"></i>Collect Payment';
        }
      } catch (e) {
        collectSubmitting = false;
        errorBox.textContent = 'An error occurred while processing payment.';
        errorBox.classList.remove('d-none');
        document.getElementById('confirmCollectBtn').disabled = false;
        document.getElementById('confirmCollectBtn').innerHTML = '<i class="bi bi-check-circle me-1"></i>Collect Payment';
      }
    });

    // ── Collect Repair Payment (Quotation) ──────────────────────────────────
    window.collectRepairPayment = async function (bookingId, totalAmount) {
      let paymentBooking = {};
      try {
        const detailResponse = await fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' });
        const detailData = await detailResponse.json();
        if (!detailResponse.ok) throw new Error(detailData.error || 'Could not load payment ledger');
        paymentBooking = detailData.booking || detailData;
      } catch (error) {
        Swal.fire('Payment Unavailable', error.message, 'error');
        return;
      }
      const repairTotal = Number(paymentBooking.quotation?.totalCost || totalAmount) || 0;
      const paymentItems = Array.isArray(paymentBooking.services) ? paymentBooking.services : [];
      const isMixedPayment = paymentBooking.serviceType === 'mixed'
        || (paymentItems.some(item => item.type === 'core') && paymentItems.some(item => item.type === 'repair'));
      const mixedInspectionFee = isMixedPayment
        ? paymentItems.filter(item => item.type === 'repair')
          .reduce((sum, item) => sum + Number(item.totalPrice || ((item.unitPrice || 0) * (item.quantity || 1))) || 0, 0)
        : 0;
      const inspectionFee = Number(paymentBooking.inspectionFeeAmount || mixedInspectionFee || paymentBooking.initialCost || paymentBooking.totalInitialCost || paymentBooking.servicePrice || paymentBooking.estimatedFee) || 0;
      const distanceFare = Number(paymentBooking.inspectionFeeDistanceFare || paymentBooking.travelFare) || 0;
      const phase1Settled = Boolean(paymentBooking.inspectionFeeCollected);
      const downpaymentCredit = phase1Settled
        ? Number(paymentBooking.downpaymentAppliedToInspection || 0)
        : Math.min(Number(paymentBooking.downpaymentAmount || 0), inspectionFee + distanceFare);
      const phase1Balance = phase1Settled ? 0 : Math.max(0, inspectionFee + distanceFare - downpaymentCredit);
      const initialBookingTotal = Number(paymentBooking.totalPrice || paymentBooking.estimatedFee) || 0;
      const amountPaid = Number(paymentBooking.amountPaid || 0);
      totalAmount = isMixedPayment
        ? Math.max(0, initialBookingTotal + repairTotal - amountPaid)
        : phase1Settled ? repairTotal : repairTotal + phase1Balance;
      const esc = (s) => (s || '').replace(/'/g, "\\'");
      const html = `
        <div style="text-align:left;padding:8px 0;">
          <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:16px;margin-bottom:16px;">
            ${isMixedPayment ? `
              <div style="font-size:0.72rem;font-weight:800;color:#166534;margin-bottom:8px;letter-spacing:.04em;">SHARED BOOKING LEDGER</div>
              <div style="display:flex;justify-content:space-between;font-size:0.8rem;"><span>Initial Core + Inspection + Travel</span><strong>₱${initialBookingTotal.toLocaleString()}</strong></div>
              <div style="display:flex;justify-content:space-between;font-size:0.8rem;margin-top:5px;color:#2563eb;"><span>Paid So Far</span><strong>−₱${amountPaid.toLocaleString()}</strong></div>
              <hr class="my-2">` : ''}
            ${phase1Settled
              ? `<div style="font-size:0.76rem;color:#166534;margin-bottom:7px;"><i class="bi bi-check-circle me-1"></i>Phase 1 was settled separately. Its downpayment does not reduce the repair quotation.</div>
                 <div style="display:flex;justify-content:space-between;font-size:0.8rem;"><span>Inspection Fee</span><strong>₱${inspectionFee.toLocaleString()}</strong></div>
                 ${distanceFare ? `<div style="display:flex;justify-content:space-between;font-size:0.8rem;margin-top:5px;"><span>Travel Fare</span><strong>₱${distanceFare.toLocaleString()}</strong></div>` : ''}
                 ${downpaymentCredit ? `<div style="display:flex;justify-content:space-between;font-size:0.8rem;margin-top:5px;color:#2563eb;"><span>Downpayment Applied to Inspection</span><strong>−₱${downpaymentCredit.toLocaleString()}</strong></div>` : ''}
                 <div style="display:flex;justify-content:space-between;font-size:0.8rem;margin-top:5px;color:#166534;"><span>Inspection Cash Collected</span><strong>₱${Number(paymentBooking.inspectionFeeTotalCollected || 0).toLocaleString()}</strong></div>`
              : `<div style="display:flex;justify-content:space-between;font-size:0.8rem;"><span>Inspection Fee</span><strong>₱${inspectionFee.toLocaleString()}</strong></div>${distanceFare ? `<div style="display:flex;justify-content:space-between;font-size:0.8rem;margin-top:5px;"><span>Travel Fare</span><strong>₱${distanceFare.toLocaleString()}</strong></div>` : ''}`}
            <div style="display:flex;justify-content:space-between;font-size:0.8rem;margin-top:5px;"><span>Repair Quotation</span><strong>₱${repairTotal.toLocaleString()}</strong></div>
            ${!phase1Settled && downpaymentCredit > 0 ? `<div style="display:flex;justify-content:space-between;font-size:0.8rem;margin-top:5px;color:#2563eb;"><span>Downpayment Applied to Inspection</span><strong>−₱${downpaymentCredit.toLocaleString()}</strong></div>` : ''}
            ${!phase1Settled ? `<div style="display:flex;justify-content:space-between;font-size:0.8rem;margin-top:5px;"><span>Inspection Balance</span><strong>₱${phase1Balance.toLocaleString()}</strong></div>` : ''}
            <hr class="my-2">
            <div style="font-size:0.78rem;color:#64748b;">Final Balance Due</div>
            <div style="font-size:1.6rem;font-weight:800;color:#166534;">₱${(totalAmount || 0).toLocaleString()}</div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Payment Method</label>
            <select id="rpMethod" class="form-select" style="border-radius:8px;">
              <option value="cash">Cash</option>
              <option value="gcash">GCash</option>
              <option value="card">Card</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Amount Collected</label>
            <input type="number" id="rpAmount" class="form-control" value="${totalAmount || 0}" min="0" style="border-radius:8px;font-weight:700;">
          </div>
          <div class="mb-3" id="rpProofGroup">
            <label class="form-label fw-semibold">Proof of Payment <span class="text-danger">*</span></label>
            <input type="file" id="rpProofInput" class="form-control" accept="image/*" style="border-radius:8px;">
            <small class="text-muted">Upload a receipt, transaction screenshot, or signed cash-payment acknowledgement.</small>
          </div>
          <label class="form-check mb-0"><input id="rpCustomerConfirmed" class="form-check-input" type="checkbox"><span class="form-check-label" style="font-size:0.82rem;">Customer confirmed the final amount and payment.</span></label>
        </div>`;

      const result = await Swal.fire({
        title: 'Collect Final Payment',
        html,
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: '<i class="bi bi-check-circle me-1"></i>Collect Payment',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#059669',
        preConfirm: () => {
          const method = document.getElementById('rpMethod').value;
          const amount = parseFloat(document.getElementById('rpAmount').value);
          if (!amount || amount <= 0) { Swal.showValidationMessage('Enter a valid amount'); return; }
          if (Math.abs(amount - totalAmount) > 0.01) { Swal.showValidationMessage(`Amount must equal the final balance of ₱${totalAmount.toLocaleString()}`); return; }
          if (!document.getElementById('rpCustomerConfirmed')?.checked) { Swal.showValidationMessage('Confirm that the customer acknowledged the final amount and payment.'); return; }
          const proof = document.getElementById('rpProofInput').files[0];
          if (!proof) { Swal.showValidationMessage('Upload proof of payment before collecting.'); return; }
          return { amount, method, proofFile: proof };
        }
      });

      if (!result.isConfirmed) return;

      const { amount, method, proofFile } = result.value;
      Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

      try {
        let proofUrl = '';
        if (proofFile) {
          const proofForm = new FormData();
          proofForm.append('proofPhoto', proofFile);
          const uploadRes = await fetch(`/api/technician/appointments/${bookingId}/upload-proof`, {
            method: 'POST', credentials: 'same-origin', body: proofForm
          });
          const uploadData = await uploadRes.json();
          if (!uploadRes.ok || !uploadData.url) throw new Error(uploadData.error || 'Proof of payment upload failed. Payment was not recorded.');
          proofUrl = uploadData.url;
        }

        const res = await fetch(`/api/technician/appointments/${bookingId}/collect-repair-payment`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ amount, method, proofUrl }),
        });

        const data = await res.json();
        Swal.close();
        if (res.ok) {
          Swal.fire({ icon: 'success', title: 'Payment Collected', text: data.message || 'Repair payment collected successfully.', timer: 1200, showConfirmButton: false });
          let a = (window._allAssignments || window.allItems || []).find(item => String(item.bookingId?._id || item.bookingId) === String(bookingId));
          if (!a && window._detailAssignment && String(window._detailAssignment.bookingId?._id || window._detailAssignment.bookingId) === String(bookingId)) {
            a = window._detailAssignment;
          }
          if (a) {
            a.repairPaymentCollected = true;
            a.repairPaymentAmount = Number(data.booking?.repairPaymentAmount ?? amount);
            if (a.bookingId && typeof a.bookingId === 'object') {
              a.bookingId.repairPaymentCollected = true;
              a.bookingId.repairPaymentAmount = a.repairPaymentAmount;
              a.bookingId.paymentStatus = a.bookingId.paymentStatus || 'waiting_for_remittance';
            }
          }
          if (window._currentDetailId && document.getElementById('rightPanel')?.classList.contains('open')) {
            await refreshOpenAssignmentDetail('overview');
          } else {
            await loadAssignments(currentFilter, currentPage);
          }
          setTimeout(() => completeRepair(bookingId), 300);
        } else {
          Swal.fire('Error', data.error || 'Failed to collect payment.', 'error');
        }
      } catch (e) {
        Swal.close();
        Swal.fire('Error', 'Network error.', 'error');
      }
    };
    // Show/hide proof field based on payment method
    document.addEventListener('change', function (e) {
      if (e.target && e.target.id === 'rpMethod') {
        const proofGroup = document.getElementById('rpProofGroup');
        if (proofGroup) proofGroup.style.display = e.target.value === 'gcash' ? '' : 'none';
      }
    });

    // ── Proof of Completion ────────────────────────────────────────────────
    let proofTargetId = null;
    let proofFile = null;
    let proofSubmitting = false;
    let proofSubmissionCompleted = false;
    let technicianAftercarePolicyPromise = null;

    async function loadTechnicianAftercarePolicy() {
      if (!technicianAftercarePolicyPromise) {
        technicianAftercarePolicyPromise = fetch('/api/technician/aftercare-policy', { credentials:'same-origin', cache:'no-store' })
          .then(async function (response) {
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Unable to load aftercare policy.');
            return data.maintenance || {};
          })
          .catch(function () { return { bookingsEnabled:true, bookingIntervalDays:90, allowTechnicianRecommendation:true }; });
      }
      return technicianAftercarePolicyPromise;
    }

    window.openProofModal = async function (id, customerName, serviceName, fee, paymentJustCollected = false) {
      // Block if balance not collected (unless payment was just collected in the flow)
      let a = allItems.find(item => String(item._id) === String(id));
      if (!a && window._detailAssignment && String(window._detailAssignment._id) === String(id)) {
        a = window._detailAssignment;
      }
      const balanceStillDue = a && ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && !a.balanceCollected && (a.balanceAmount || 0) > 0;
      if (!paymentJustCollected && balanceStillDue) {
        showNotification({ type: 'warning', title: 'Payment Required', message: 'You must collect the remaining balance before completing this job.', duration: 5000 });
        openCollectPaymentModal(id, a, true);
        return;
      }
      proofTargetId = id;
      proofFile = null;
      proofSubmitting = false;
      proofSubmissionCompleted = false;
      document.getElementById('proofFileInput').value = '';
      document.getElementById('proofUploadPlaceholder').classList.remove('d-none');
      document.getElementById('proofPreviewContainer').classList.add('d-none');
      document.getElementById('proofError').classList.add('d-none');
      const maintenanceSelect = document.getElementById('nextMaintenanceDays');
      const maintenanceHint = document.getElementById('nextMaintenancePolicyHint');
      maintenanceSelect.value = '';
      const aftercarePolicy = await loadTechnicianAftercarePolicy();
      maintenanceSelect.options[0].textContent = `Use admin default (${Number(aftercarePolicy.bookingIntervalDays || 90)} days)`;
      maintenanceSelect.disabled = !aftercarePolicy.bookingsEnabled || !aftercarePolicy.allowTechnicianRecommendation;
      maintenanceHint.textContent = !aftercarePolicy.bookingsEnabled
        ? 'Automatic maintenance cycles are disabled by the administrator.'
        : aftercarePolicy.allowTechnicianRecommendation
          ? 'The admin default is used unless you recommend another interval.'
          : 'The administrator requires the configured default interval for this completion.';
      document.getElementById('nextMaintenanceNotes').value = '';
      document.getElementById('submitProofBtn').disabled = true;
      const area = document.getElementById('proofUploadArea');
      area.style.padding = '40px 24px';
      const proofEl = document.getElementById('proofModal');
      bootstrap.Modal.getOrCreateInstance(proofEl).show();
      // Load consumables for this booking
      await loadProofConsumables(id);
      updateProofSubmitState();
    };

    // Load consumables from daily kit that are tied to this assignment's booking
    async function loadProofConsumables(assignmentId) {
      const section = document.getElementById('proofConsumablesSection');
      const listEl = document.getElementById('proofConsumablesList');
      const emptyEl = document.getElementById('proofConsumablesEmpty');
      const countEl = document.getElementById('proofConsumablesCount');
      const hintEl = document.getElementById('proofConsumablesHint');
      section.style.display = 'none';
      listEl.innerHTML = '';
      emptyEl.style.display = 'none';
      if (hintEl) hintEl.style.display = 'none';
      const _esc = (s) => s ? String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&#039;') : '';
      try {
        const res = await fetch('/api/technician/daily-kit', { credentials: 'same-origin' });
        if (!res.ok) return;
        const data = await res.json();
        const kit = data.kit;
        if (!kit || !kit.items) return;
        // Find the assignment to get its bookingId
        const assignment = allItems.find(i => String(i._id) === String(assignmentId))
          || (window._detailAssignment && String(window._detailAssignment._id) === String(assignmentId) ? window._detailAssignment : null);
        if (!assignment) return;
        const bookingId = assignment.bookingId;
        // Filter kit items: consumables that include this bookingId
        const consumables = kit.items.filter(item =>
          item.category === 'consumable'
          && item.bookingIds
          && item.bookingIds.some(bid => String(bid) === String(bookingId))
        );
        if (consumables.length === 0) {
          section.style.display = '';
          emptyEl.style.display = '';
          listEl.style.display = 'none';
          countEl.textContent = '0 items';
          updateProofSubmitState();
          return;
        }
        section.style.display = '';
        listEl.style.display = '';
        if (hintEl) hintEl.style.display = '';
        countEl.textContent = consumables.length + ' item' + (consumables.length > 1 ? 's' : '');
        listEl.innerHTML = consumables.map(item => {
          const issued = item.quantityIssued || item.quantity || 0;
          const alreadyUsed = item.quantityUsed || 0;
          const maxAvail = Math.max(0, issued - alreadyUsed);
          return `<div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #f1f5f9;">
            <div style="flex:1;min-width:0;">
              <div style="font-size:0.8rem;font-weight:600;color:#1e293b;">${_esc(item.name)} <span style="color:#dc2626;">*</span></div>
              <div style="font-size:0.68rem;color:#64748b;">Available: ${maxAvail} ${_esc(item.unit || 'pcs')}</div>
            </div>
            <input type="number" class="form-control form-control-sm proof-consumable-input"
              data-name="${_esc(item.name)}" data-max="${maxAvail}" data-unit="${_esc(item.unit || 'pcs')}"
              min="1" max="${maxAvail}" value=""
              placeholder="0"
              style="width:60px;text-align:center;border-radius:8px;font-size:0.8rem;" oninput="validateProofConsumable(this)">
          </div>`;
        }).join('');
        updateProofSubmitState();
      } catch (e) {
        section.style.display = 'none';
        updateProofSubmitState();
      }
    }
    window.validateProofConsumable = function(el) {
      const max = parseInt(el.dataset.max) || 0;
      let val = parseInt(el.value) || 0;
      if (val > max) { el.value = max; val = max; }
      if (val < 0) { el.value = ''; val = 0; }
      el.style.borderColor = val >= 1 ? '#059669' : '#fecaca';
      updateProofSubmitState();
    };

    // Submit is only allowed when a photo is attached AND every required
    // consumable row has a recorded quantity (>= 1).
    window.updateProofSubmitState = function () {
      const btn = document.getElementById('submitProofBtn');
      if (!btn || proofSubmitting) return;
      const inputs = document.querySelectorAll('.proof-consumable-input');
      let missing = 0;
      inputs.forEach(input => {
        const v = parseInt(input.value) || 0;
        input.style.borderColor = v >= 1 ? '#059669' : '#fecaca';
        if (v < 1) missing++;
      });
      btn.disabled = !proofFile || missing > 0;
    };

    window.handleProofFile = function (e) {
      const file = e.target.files[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) {
        showProofError('File size must be under 5MB');
        return;
      }
      if (!['image/jpeg', 'image/jpg', 'image/png', 'image/webp'].includes(file.type)) {
        showProofError('Only JPEG, PNG, or WebP images are accepted');
        return;
      }
      proofFile = file;
      const reader = new FileReader();
      reader.onload = function (ev) {
        document.getElementById('proofPreviewImg').src = ev.target.result;
        document.getElementById('proofFileName').textContent = file.name;
        document.getElementById('proofUploadPlaceholder').classList.add('d-none');
        document.getElementById('proofPreviewContainer').classList.remove('d-none');
        document.getElementById('proofError').classList.add('d-none');
        updateProofSubmitState();
      };
      reader.readAsDataURL(file);
    };

    window.clearProofUpload = function () {
      proofFile = null;
      document.getElementById('proofFileInput').value = '';
      document.getElementById('proofUploadPlaceholder').classList.remove('d-none');
      document.getElementById('proofPreviewContainer').classList.add('d-none');
      updateProofSubmitState();
    };

    function showProofError(msg) {
      document.getElementById('proofErrorMsg').textContent = msg;
      document.getElementById('proofError').classList.remove('d-none');
      document.getElementById('submitProofBtn').disabled = true;
    }

    // Drag and drop handlers
    (function () {
      const area = document.getElementById('proofUploadArea');
      if (!area) return;
      ['dragenter', 'dragover'].forEach(evt => {
        area.addEventListener(evt, function (e) { e.preventDefault(); e.stopPropagation(); area.classList.add('drag-over'); });
      });
      ['dragleave', 'drop'].forEach(evt => {
        area.addEventListener(evt, function (e) { e.preventDefault(); e.stopPropagation(); area.classList.remove('drag-over'); });
      });
      area.addEventListener('drop', function (e) {
        const file = e.dataTransfer.files[0];
        if (file) {
          const input = document.getElementById('proofFileInput');
          const dt = new DataTransfer();
          dt.items.add(file);
          input.files = dt.files;
          input.dispatchEvent(new Event('change'));
        }
      });
    })();

    window.submitProofOfCompletion = async function () {
      if (!proofFile || !proofTargetId) return;
      // Required-consumables guard: every listed kit consumable for this
      // booking must have a recorded usage quantity before completing.
      const missing = [];
      document.querySelectorAll('.proof-consumable-input').forEach(input => {
        const qty = parseInt(input.value) || 0;
        if (qty < 1) missing.push(input.dataset.name);
      });
      if (missing.length > 0) {
        showProofError('Record consumables used: ' + missing.join(', '));
        document.getElementById('submitProofBtn').disabled = true;
        return;
      }
      const btn = document.getElementById('submitProofBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Uploading...';
      proofSubmitting = true;

      try {
        // Log consumables used (before uploading proof)
        const consumableInputs = document.querySelectorAll('.proof-consumable-input');
        const assignment = allItems.find(i => String(i._id) === String(proofTargetId))
          || (window._detailAssignment && String(window._detailAssignment._id) === String(proofTargetId) ? window._detailAssignment : null);
        const bookingId = assignment?.bookingId;
        if (bookingId && consumableInputs.length > 0) {
          for (const input of consumableInputs) {
            const qty = parseInt(input.value) || 0;
            if (qty <= 0) continue;
            await fetch('/api/technician/daily-kit/consume', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({
                itemName: input.dataset.name,
                quantityUsed: qty,
                bookingId: bookingId,
              }),
            }).catch(() => {});
          }
        }

        // Upload proof photo
        const formData = new FormData();
        formData.append('proofPhoto', proofFile);
        formData.append('nextMaintenanceDays', document.getElementById('nextMaintenanceDays')?.value || '');
        formData.append('nextMaintenanceNotes', document.getElementById('nextMaintenanceNotes')?.value?.trim() || '');

        const uploadRes = await fetch(`/api/technician/assignments/${proofTargetId}/proof-of-completion`, {
          method: 'POST',
          credentials: 'same-origin',
          body: formData
        });
        const uploadData = await uploadRes.json();
        if (!uploadRes.ok) throw new Error(uploadData.error || 'Upload failed');

        proofSubmitting = false;
        proofSubmissionCompleted = true;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('proofModal')).hide();
        showNotification({ type: 'success', title: 'Job Completed', message: 'Proof uploaded and job marked as completed.', duration: 5000 });

        // Refresh data (proof endpoint already sets status to completed)
        loadAssignments(currentFilter, currentPage);
        if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
          showDetail(window._currentDetailId);
        }
      } catch (e) {
        proofSubmitting = false;
        showProofError(e.message || 'Failed to upload proof photo');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-circle"></i><span>Submit & Complete</span>';
      }
    };

    // Do not let Cancel/close/reload create an ambiguous state while a
    // payment or proof request is already in flight. Before submission,
    // dismissing either modal remains read-only and safe.
    document.getElementById('collectPaymentModal')?.addEventListener('hide.bs.modal', event => {
      if (collectSubmitting) event.preventDefault();
    });
    document.getElementById('proofModal')?.addEventListener('hide.bs.modal', event => {
      if (proofSubmitting) event.preventDefault();
    });
    document.getElementById('proofModal')?.addEventListener('hidden.bs.modal', () => {
      if (proofSubmissionCompleted) {
        proofSubmissionCompleted = false;
        return;
      }
      // Payment is an independent committed step. If the technician cancels
      // proof, reload the action state so Collect Payment cannot reappear.
      if (window._currentDetailId && document.getElementById('rightPanel')?.classList.contains('open')) {
        refreshOpenAssignmentDetail('overview');
      }
    });
    window.addEventListener('beforeunload', event => {
      if (!collectSubmitting && !proofSubmitting && !window._repairCompletionSubmitting) return;
      event.preventDefault();
      event.returnValue = '';
    });

    // ── Cancel Assignment ──────────────────────────────────────────────────
    let cancelTargetId = null;

    window.openCancelModal = function (id, customerName, serviceName) {
      cancelTargetId = id;
      document.getElementById('cancelReasonSelect').value = '';
      document.getElementById('customReasonText').value = '';
      document.getElementById('customReasonCount').textContent = '0';
      document.getElementById('customReasonGroup').classList.add('d-none');
      document.getElementById('confirmCancelBtn').disabled = true;
      document.getElementById('cancelModalSubtitle').textContent = `${serviceName} for ${customerName}`;
      document.getElementById('cancelAlertBox').classList.remove('d-none');
      const cancelEl = document.getElementById('cancelModal');
      bootstrap.Modal.getOrCreateInstance(cancelEl).show();
    };

    document.getElementById('cancelReasonSelect').addEventListener('change', function () {
      const isOther = this.value === 'other';
      document.getElementById('customReasonGroup').classList.toggle('d-none', !isOther);
      document.getElementById('confirmCancelBtn').disabled = !this.value;
      if (isOther) {
        document.getElementById('customReasonText').focus();
      }
    });

    document.getElementById('customReasonText').addEventListener('input', function () {
      document.getElementById('customReasonCount').textContent = this.value.length;
      const reason = document.getElementById('cancelReasonSelect').value;
      document.getElementById('confirmCancelBtn').disabled = reason !== 'other' || !this.value.trim();
    });

    document.getElementById('confirmCancelBtn').addEventListener('click', async function () {
      if (!cancelTargetId) return;
      const reason = document.getElementById('cancelReasonSelect').value;
      const customReason = document.getElementById('customReasonText').value.trim();
      if (!reason) return;

      this.disabled = true;
      this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Cancelling...';

      try {
        const res = await fetch(`/api/technician/assignments/${cancelTargetId}/cancel`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ reason, customReason }),
        });
        const data = await res.json();
        if (res.ok) {
          bootstrap.Modal.getOrCreateInstance(document.getElementById('cancelModal')).hide();
          showNotification({
            type: 'warning',
            title: 'Assignment Cancelled',
            message: 'The booking has been returned to the reassignment queue.',
            duration: 5000
          });
          loadAssignments(currentFilter, currentPage);
        } else {
          showNotification({ type: 'error', title: 'Cancel Failed', message: data.error || 'Failed to cancel assignment', duration: 5000 });
        }
      } catch (e) {
        showNotification({ type: 'error', title: 'Cancel Failed', message: 'Network error. Please try again.', duration: 5000 });
      } finally {
        this.disabled = false;
        this.innerHTML = '<i class="bi bi-x-circle me-1"></i>Confirm Cancellation';
      }
    });

    // ── Accept Available Job ───────────────────────────────────────────────
    window.acceptAvailableJob = async function (bookingId, customerName, btn) {
      if (!confirm(`Accept this job for ${customerName}?`)) return;
      window._btnLoading(btn, async () => {
        try {
          const res = await fetch(`/api/technician/available-jobs/${bookingId}/accept`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
          });
          const data = await res.json();
          if (res.ok) {
            showNotification({
              type: 'success',
              title: 'Job Accepted',
              message: `You have accepted the job for ${customerName}. It is now in your pending assignments.`,
              duration: 5000
            });
            loadAssignments(currentFilter, currentPage);
          } else {
            showNotification({ type: 'error', title: 'Accept Failed', message: data.error || 'Failed to accept job', duration: 5000 });
          }
        } catch (e) {
          showNotification({ type: 'error', title: 'Accept Failed', message: 'Network error. Please try again.', duration: 5000 });
        }
      });
    };

    // ── Socket.io Listeners (uses window.socket from technician layout) ─────
    (function initAssignmentSocketListeners() {
      try {
        if (!window.socket) return;
        window.socket.on('assignment:vacancy', (data) => {
          showNotification({
            type: 'info',
            title: 'New Job Available',
            message: data.message || `${data.serviceName} for ${data.customerName}`,
            duration: 8000
          });
          if (currentFilter === 'available') {
            loadAvailableJobs();
          }
          fetchTabCounts();
        });
        window.socket.on('assignment:new', (data) => {
          const isProject = data.isProject;
          showNotification({
            type: 'success',
            title: isProject ? 'New Project Assignment' : 'New Assignment',
            message: data.message || (isProject
              ? `You have been assigned to a project: ${data.serviceName || 'Project'} for ${data.customerName || 'a customer'}. Open to Accept or Decline.`
              : `New job: ${data.serviceName} for ${data.customerName}`),
            duration: 10000
          });
          if (currentFilter === 'pending' || currentFilter === 'all') {
            loadAssignments();
          }
          if (isProject && typeof window.__loadProjectWork === 'function') {
            window.__loadProjectWork();
          }
          fetchTabCounts();
        });
        window.socket.on('project:team_assigned', (data) => {
          showNotification({
            type: 'info',
            title: 'Commercial Project — Accept or Decline',
            message: data.message || `You have been assigned to a commercial project. Lead: ${data.lead || 'N/A'}. Open My Work to Accept or Decline.`,
            duration: 10000
          });
          if (currentFilter === 'pending' || currentFilter === 'all') {
            loadAssignments();
          }
          if (typeof window.__loadProjectWork === 'function') {
            window.__loadProjectWork();
          }
          fetchTabCounts();
        });
        window.socket.on('daily_kit:updated', (data) => {
          showNotification({
            type: 'success',
            title: 'Daily Kit Updated',
            message: data.message || `Your daily kit has been updated by admin. ${data.itemName ? '"' + data.itemName + '" — ' + data.resolution : ''}`,
            duration: 8000
          });
          if (typeof loadDailyKit === 'function') {
            loadDailyKit();
          }
        });
      } catch (e) { }
    })();

    window.switchDetailTab = function (tabName) {
      const contentEl = document.getElementById('detailPanelContent');
      if (!contentEl) return;
      const tab = contentEl.querySelector(`.mw-detail-tab[data-tab="${tabName}"]`);
      if (!tab) return;
      contentEl.querySelectorAll('.mw-detail-tab').forEach(b => b.classList.remove('active'));
      contentEl.querySelectorAll('.mw-detail-panel').forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      // Ensure the active tab is horizontally visible in the sticky bar
      tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      const panel = contentEl.querySelector(`.mw-detail-panel[data-tab="${tabName}"]`);
      if (panel) {
        panel.classList.add('active');
        window._activeDetailTab = tabName;
        const body = document.getElementById('detailPanelBody');
        if (body) body.scrollTop = 0;
        const actionBar = document.getElementById('detailPanelActions');
        if (actionBar && window._detailAssignment) {
          const actions = getWizardPageActions(tabName, window._detailAssignment);
          actionBar.innerHTML = actions;
          actionBar.style.display = actions ? 'flex' : 'none';
        }
      }
    };

    window.closeDetailPanel = function () {
      if (window._routeMapWatcher) { navigator.geolocation.clearWatch(window._routeMapWatcher); window._routeMapWatcher = null; }
      const panel = document.getElementById('rightPanel');
      const left = document.getElementById('leftPanel');
      panel.classList.remove('open');
      left.classList.remove('panel-open');
      left.classList.remove('list-hidden');
      window._activeDetailTab = null;
      if (window.hideRoutePanel) window.hideRoutePanel();
    };

    window.refreshOpenAssignmentDetail = async function (preferredTab) {
      const detailId = window._currentDetailId;
      if (!detailId) return loadAssignments(currentFilter, currentPage);
      if (preferredTab) window._activeDetailTab = preferredTab;
      await loadAssignments(currentFilter, currentPage, document.getElementById('searchInput')?.value || '');
      await showDetail(detailId);
      if (preferredTab) switchDetailTab(preferredTab);
    };

    window.showDetail = async function (id) {
      try {
        const isRefreshingSameJob = String(window._currentDetailId || '') === String(id || '');
        const activeTabBeforeRefresh = isRefreshingSameJob
          ? (document.querySelector('#detailPanelContent .mw-detail-tab.active')?.dataset?.tab || window._activeDetailTab)
          : null;
        // Show loading state
        document.getElementById('detailPanelHeader').style.display = 'none';
        document.getElementById('detailPanelEmpty').style.display = 'none';
        document.getElementById('detailPanelContent').style.display = 'none';
        document.getElementById('detailPanelActions').style.display = 'none';
        document.getElementById('detailPanelLoading').style.display = '';

        // Open panel and focus on the active job (hide the list)
        const panel = document.getElementById('rightPanel');
        const left = document.getElementById('leftPanel');
        panel.classList.add('open');
        left.classList.add('panel-open');
        left.classList.add('list-hidden');

        const res = await fetch(`/api/technician/assignments/${id}`, { credentials: 'same-origin' });
        if (!res.ok) { const errData = await res.json().catch(() => ({})); throw new Error(errData.error || `HTTP ${res.status}`); }
        const { assignment: a, techLocation } = await res.json();
        window._detailAssignment = a;
        window._currentDetailId = id;
        window._detailTechLocation = techLocation;

        // Auto-generate the AI diagnosis for accepted repair jobs — the
        // technician only needs to review it, not manually trigger it.
        const aiBookingId = a.bookingId?._id || (typeof a.bookingId === 'string' ? a.bookingId : '');
        if (isRepairAssignment(a) && a.status === 'accepted' && aiBookingId && !a.bookingId?.technicianAssistant?.summary) {
          window._aiGenInProgress = window._aiGenInProgress || new Set();
          if (!window._aiGenInProgress.has(aiBookingId)) {
            window._aiGenInProgress.add(aiBookingId);
            generateAiDiagnosis(aiBookingId, true).finally(() => window._aiGenInProgress.delete(aiBookingId));
          }
        }

        // Load assigned equipment for this booking
        a.equipmentItems = [];
        const eqBookingId = a.bookingId?._id || (typeof a.bookingId === 'string' ? a.bookingId : '');
        if (eqBookingId) {
          try {
            const eqRes = await fetch(`/api/technician/equipment/${eqBookingId}`, { credentials: 'same-origin' });
            if (eqRes.ok) { const eqData = await eqRes.json(); a.equipmentItems = eqData.items || []; }
          } catch (e) {}
        }

        // Load payment history for this booking
        a.payments = [];
        const payBookingId = a.bookingId?._id || (typeof a.bookingId === 'string' ? a.bookingId : '');
        if (payBookingId) {
          try {
            const payRes = await fetch(`/api/technician/bookings/${payBookingId}/payments`, { credentials: 'same-origin' });
            if (payRes.ok) { const payData = await payRes.json(); a.payments = payData.payments || []; }
          } catch (e) {}
        }

        // Load reserved repair parts for this booking
        a.reservedParts = [];
        const rpBookingId = a.bookingId?._id || (typeof a.bookingId === 'string' ? a.bookingId : '');
        if (rpBookingId && isRepairAssignment(a)) {
          try {
            const rpRes = await fetch(`/api/technician/bookings/${rpBookingId}/reserved-parts`, { credentials: 'same-origin' });
            if (rpRes.ok) { const rpData = await rpRes.json(); a.reservedParts = rpData.reservations || []; }
          } catch (e) {}
        }

        // Recover Phase 1 requests created by the older logic that remained in
        // waiting_parts even after every requested quantity became reserved.
        const savedPartsRequest = a.bookingId?.partsRequest;
        if (rpBookingId && a.bookingId?.status === 'waiting_parts' && !a.bookingId?.inspection?.completedAt && savedPartsRequest?.status === 'pending' && savedPartsRequest.items?.length) {
          const reservedByName = (a.reservedParts || []).filter(row => ['reserved','checked_out'].includes(row.status)).reduce((map,row) => {
            const name = String(row.itemName || row.toolId?.itemName || '').trim().toLowerCase();
            if (name) map.set(name,(map.get(name)||0)+(Number(row.quantity)||0));
            return map;
          },new Map());
          const allSecured = savedPartsRequest.items.every(item => (reservedByName.get(String(item.itemName||'').trim().toLowerCase())||0) >= (Number(item.requestedQty)||1));
          if (allSecured) {
            try {
              const reconcileResp = await fetch(`/api/technician/bookings/${rpBookingId}/submit-parts-review`, {
                method:'POST', headers:{'Content-Type':'application/json'}, credentials:'same-origin',
                body:JSON.stringify({ parts:savedPartsRequest.items.map(item => ({ name:item.itemName, quantity:item.requestedQty, toolId:item.toolId })) }),
              });
              const reconcileData = await reconcileResp.json();
              if (reconcileResp.ok && reconcileData.allPartsSecured) {
                a.bookingId.status = reconcileData.status;
                a.bookingStatus = reconcileData.status;
              }
            } catch (e) { console.error('[Parts] Status reconciliation failed:',e); }
          }
        }

        // A failed legacy Repair Now attempt may have changed the booking to
        // waiting_parts even though the technician already holds every quoted
        // part. Keep the decision action available; the server revalidates the
        // reservation quantities before moving the real status forward.
        if (a.bookingId?.status === 'waiting_parts' && a.bookingId?.inspection?.completedAt) {
          const quotedParts = (a.bookingId?.quotation?.parts || a.quotation?.parts || [])
            .filter(part => part.source !== 'external_purchase');
          const heldPool = (a.reservedParts || [])
            .filter(row => ['reserved', 'checked_out'].includes(row.status))
            .map(row => ({
              toolId: String(row.toolId?._id || row.toolId || ''),
              name: String(row.itemName || row.toolId?.itemName || '').trim().toLowerCase(),
              remaining: Math.max(0, Number(row.quantity) || 0),
            }));
          const allQuotedPartsHeld = quotedParts.every(part => {
            let needed = Math.max(1, Number(part.quantity) || 1);
            const partToolId = String(part.toolId?._id || part.toolId || '');
            const partName = String(part.name || part.itemName || '').trim().toLowerCase();
            heldPool.forEach(held => {
              if (needed <= 0 || held.remaining <= 0) return;
              if ((partToolId && held.toolId === partToolId) || (partName && held.name === partName)) {
                const covered = Math.min(needed, held.remaining);
                needed -= covered;
                held.remaining -= covered;
              }
            });
            return needed <= 0;
          });
          if (quotedParts.length && allQuotedPartsHeld) {
            a.bookingId.status = 'inspection_completed';
            a.bookingStatus = 'inspection_completed';
          }
        }

        const date = a.bookingDate ? new Date(a.bookingDate).toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) : '';
        const bookingRef = a.bookingReference || a._id?.toString().slice(-6).toUpperCase() || 'N/A';

        // ── Panel Header ──
        const headerEl = document.getElementById('detailPanelHeader');
        headerEl.classList.add('booking-order-detail-header');
        headerEl.dataset.status = a.status;
        const isMaintenanceJob = Boolean(a.bookingId?.maintenance?.isMaintenance);
        document.getElementById('detailPanelName').textContent = a.customerName || 'Customer';
        document.getElementById('detailPanelRef').textContent = `Booking #${bookingRef}${isMaintenanceJob ? ' | Preventive Maintenance' : ''}`;
        const stBadge = document.getElementById('detailPanelStatusBadge');
        stBadge.textContent = statusLabels[a.status] || a.status;
        stBadge.className = 'trk-status-pill ' + statusBadgeClass(a.status);

        // Panel avatar icon based on status
        const avatarEl = document.getElementById('detailPanelAvatar');
        avatarEl.innerHTML = a.status === 'completed' ? '<i class="bi bi-check-circle" style="color:#4ade80;"></i>' :
          a.status === 'in_progress' ? '<i class="bi bi-gear" style="color:#60a5fa;"></i>' :
            a.status === 'en_route' ? '<i class="bi bi-geo-alt" style="color:#c084fc;"></i>' :
              a.status === 'on_site' ? '<i class="bi bi-building" style="color:#fbbf24;"></i>' :
                a.status === 'pending_acceptance' ? '<i class="bi bi-clock" style="color:#fbbf24;"></i>' :
                  '<i class="bi bi-person" style="color:#94a3b8;"></i>';

        // ── Service Hero (inside tracker card) ──
        // Restore workflow children if they were destroyed by a previous showDetail call
        const wfContainer = document.getElementById('detailPanelWorkflow');
        if (wfContainer && !document.getElementById('detailPanelWorkflowHero')) {
          wfContainer.innerHTML = '<div class="dpw-hero" id="detailPanelWorkflowHero"></div><div class="dpw-steps" id="detailPanelWorkflowSteps"></div>';
        }
        const heroEl = document.getElementById('detailPanelWorkflowHero');
        const isRepairH = isRepairAssignment(a);
        const heroBadge = `${isMaintenanceJob ? '<span class="mw-sh-badge" style="background:#ccfbf1;color:#115e59;">MAINTENANCE</span>' : ''}<span class="mw-sh-badge priority-${(a.priority || 'normal')}">${(a.priority || 'normal').toUpperCase()}</span>`;
        const heroFee = Number(a.servicePrice || (a.serviceDetail && a.serviceDetail.basePrice) || 0).toLocaleString();
        heroEl.innerHTML = `
          <div class="mw-sh-left">
            <div class="mw-sh-icon"><i class="bi bi-${isRepairH ? 'wrench' : 'gear-wide-connected'}"></i></div>
            <div class="mw-sh-meta">
              <div class="mw-sh-name">${a.serviceName || 'Service'}</div>
              <div class="mw-sh-sub">${isMaintenanceJob ? 'PREVENTIVE MAINTENANCE' : (a.serviceType ? a.serviceType.toUpperCase() + ' SERVICE' : 'SERVICE')}</div>
            </div>
          </div>
          <div class="mw-sh-right">
            ${heroBadge}
            <div class="mw-sh-fee">₱${heroFee}</div>
            <div class="mw-sh-feelabel">Service Fee</div>
          </div>`;

        // ── Workflow Tracker ──
        const workflowEl = document.getElementById('detailPanelWorkflowSteps');
        const isRepair = isRepairAssignment(a);
        const isMixed = isMixedAssignment(a);
        const bookingStatus = a.bookingId?.status || a.bookingStatus;

        if (isMixed) {
          const mixedItems = a.bookingId?.services || [];
          const mixedFinished = mixedItems.length > 0
            && mixedItems.every(item => ['completed', 'cancelled', 'repair_declined'].includes(item.status));
          const mixedSteps = [
            { key: 'accepted', label: 'Accepted', icon: 'bi-check-lg' },
            { key: 'en_route', label: 'En Route', icon: 'bi-sign-turn-right' },
            { key: 'on_site', label: 'Arrived', icon: 'bi-geo-alt' },
            { key: 'in_progress', label: 'Service Work', icon: 'bi-layers' },
            { key: 'completed', label: 'Done', icon: 'bi-check-circle' }
          ];
          const mixedCurrent = mixedFinished ? 'completed'
            : ['in_progress', 'completed'].includes(a.status) ? 'in_progress'
              : a.status === 'on_site' ? 'on_site'
                : a.status === 'en_route' ? 'en_route' : 'accepted';
          const mixedStepIndex = mixedSteps.findIndex(step => step.key === mixedCurrent);
          document.getElementById('detailPanelWorkflow').className = 'trk-card trk-work-progress compact-work-progress';
          document.getElementById('detailPanelWorkflow').innerHTML = renderWorkProgress(mixedSteps, mixedStepIndex, mixedCurrent);
        } else if (isRepair) {
          const hasQuotation = !!(a.quotation?.createdAt || a.bookingId?.quotation?.createdAt) ||
            ['repair_scheduled', 'ready_for_repair', 'repair_in_progress', 'repair_completed', 'under_warranty'].includes(bookingStatus);
          let repairSteps, currentStep;

          if (hasQuotation) {
            repairSteps = [
              { key: 'en_route', label: 'En Route', icon: 'bi-sign-turn-right' },
              { key: 'arrived', label: 'Arrived', icon: 'bi-geo-alt' },
              { key: 'repair', label: 'Repair', icon: 'bi-tools' },
              { key: 'completed', label: 'Done', icon: 'bi-check-circle' }
            ];
            if (a.status === 'completed' || bookingStatus === 'repair_completed' || bookingStatus === 'under_warranty') currentStep = 'completed';
            else if (bookingStatus === 'repair_in_progress' || a.status === 'in_progress') currentStep = 'repair';
            else if (a.status === 'on_site') currentStep = 'arrived';
            else if (a.status === 'en_route') currentStep = 'en_route';
            else currentStep = 'en_route';
          } else {
            repairSteps = [
              { key: 'accepted', label: 'Technician Accepts', icon: 'bi-check-lg' },
              { key: 'ai_review', label: 'Review AI Diagnosis', icon: 'bi-clipboard2-pulse' },
              { key: 'daily_prep', label: 'Daily Preparation', icon: 'bi-briefcase' },
              { key: 'en_route', label: 'En Route', icon: 'bi-sign-turn-right' }
            ];
            if (a.status === 'en_route' || a.status === 'on_site' || a.status === 'in_progress') currentStep = 'en_route';
            else if (a.bookingId?.technicianAssistant?.verifiedByTechnician) currentStep = 'daily_prep';
            else if (a.status === 'accepted') currentStep = 'ai_review';
            else currentStep = 'accepted';
          }

          const stepIdx = repairSteps.findIndex(s => s.key === currentStep);
          document.getElementById('detailPanelWorkflow').className = 'trk-card trk-work-progress compact-work-progress';
          document.getElementById('detailPanelWorkflow').innerHTML = renderWorkProgress(repairSteps, stepIdx, currentStep);
        } else {
          const steps = [
            { key: 'accepted', label: 'Accept', icon: 'bi-check-lg' },
            { key: 'daily_prep', label: 'Daily Prep', icon: 'bi-briefcase' },
            { key: 'en_route', label: 'En Route', icon: 'bi-geo-alt' },
            { key: 'on_site', label: 'Arrived', icon: 'bi-pin-map' },
            { key: 'in_progress', label: 'Work', icon: 'bi-gear' },
            { key: 'completed', label: 'Done', icon: 'bi-check-circle' }
          ];
          let curIdx;
          if (a.status === 'accepted') curIdx = steps.findIndex(s => s.key === 'daily_prep');
          else curIdx = steps.findIndex(s => s.key === a.status);
          const stepIdx2 = curIdx >= 0 ? curIdx : 0;
          document.getElementById('detailPanelWorkflow').className = 'trk-card trk-work-progress compact-work-progress';
          document.getElementById('detailPanelWorkflow').innerHTML = renderWorkProgress(steps, stepIdx2, steps[stepIdx2]?.key || 'accepted');
        }

        document.getElementById('detailPanelHeader').style.display = '';

        // ── Customer location ──
        const bookingGeo = a.bookingId?.location?.coordinates?.coordinates || a.bookingId?.location?.coordinates || [];
        const assignmentGeo = a.location?.coordinates?.coordinates || a.location?.coordinates || [];
        const custLat = a.coordinates?.lat ?? a.customerLocation?.lat ?? a.location?.lat ?? a.bookingId?.customerLocation?.lat ?? a.bookingId?.location?.lat ?? assignmentGeo[1] ?? bookingGeo[1] ?? null;
        const custLng = a.coordinates?.lng ?? a.customerLocation?.lng ?? a.location?.lng ?? a.bookingId?.customerLocation?.lng ?? a.bookingId?.location?.lng ?? assignmentGeo[0] ?? bookingGeo[0] ?? null;
        const hasCoords = Number.isFinite(Number(custLat)) && Number.isFinite(Number(custLng));

        // ── Activity log ──
        let activityHtml = '';
        if (a.notes && a.notes.length > 0) {
          activityHtml = `
          <div class="dminfo-activity ent-timeline" style="padding-left:18px;">
            ${a.notes.map(n => `
              <div class="ent-timeline-item" style="padding:6px 0 6px 14px;">
                <div class="ent-timeline-dot" style="left:-23px;top:10px;width:8px;height:8px;"></div>
                <div>
                  <div style="font-size:0.8rem;color:#334155;">${n.text}</div>
                  <div class="ent-timeline-time" style="font-size:0.68rem;">${n.byName || 'System'} &middot; ${n.createdAt ? new Date(n.createdAt).toLocaleString('en-PH') : ''}</div>
                </div>
              </div>
            `).join('')}
          </div>`;
        }

        // ── Payment section (for COD) ──
        let paymentHtml = '';
        const isRepairBooking = isRepairAssignment(a);
        const isRepairComplete = isRepairBooking && (a.status === 'completed' || ['repair_completed', 'completed'].includes(a.bookingId?.status || a.bookingStatus));

        if (['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod)) {
          if (!isRepairBooking || isRepairComplete) {
            const qTotal = a.bookingId?.quotation?.totalCost || a.quotation?.totalCost;
            const inspFee = a.bookingId?.inspectionFeeTotalCollected || a.bookingId?.initialCost || a.initialCost || 0;
            const total = isRepairBooking
              ? Number(inspFee + (qTotal || 0)).toLocaleString()
              : Number(qTotal || a.totalPrice || a.estimatedFee || 0).toLocaleString();
            const dp = Number(a.bookingId?.downpaymentAmount || a.downpaymentAmount || 0).toLocaleString();
            const bal = Number(a.bookingId?.balanceAmount || a.balanceAmount || 0).toLocaleString();
            const payStatus = a.paymentStatus === 'paid' ? 'Paid in Full' : a.balanceCollected ? 'Paid' : 'Balance Pending';
            const payBadgeCls = a.paymentStatus === 'paid' ? 'bg-success' : 'bg-warning text-dark';
            const paymentTitle = isRepairBooking ? 'Quotation Payment' : 'Payment';
            const paymentIcon = isRepairBooking ? 'bi-receipt-cutoff' : 'bi-cash-coin';

            paymentHtml = `
            <div class="detail-section" style="border-color:#bbf7d0;background:linear-gradient(to right, #f0fdf4, #f8fafc);">
              <div class="detail-section-header"><i class="bi ${paymentIcon}" style="color:#059669;"></i><h6 style="color:#059669;font-weight:700;letter-spacing:-0.01em;">${paymentTitle}</h6></div>
              <div class="detail-section-body">
                <div class="detail-row"><label>Total</label><span style="font-weight:800;color:#0f172a;">₱${total}</span></div>
                ${!isRepairBooking ? `<div class="detail-row"><label>Down</label><span style="color:#2563eb;font-weight:700;">₱${dp}</span></div>` : ''}
                <div class="detail-row"><label>Balance</label><span style="${a.balanceCollected ? 'color:#16a34a' : 'color:#d97706'};font-weight:700;">₱${bal}</span></div>
                <div class="detail-row mt-1"><label>Status</label><span class="badge ${payBadgeCls}" style="font-size:0.68rem;padding:4px 8px;">${payStatus}</span></div>
              </div>
            </div>`;
          }
        }

        // ── Build tab categories for panel ──
        const nonRepairPages = ['overview', 'invoice', 'rating'];
        const visiblePages = isRepair ? REPAIR_PAGES.filter(p => PAGE_REGISTRY[p].visible(a)) : nonRepairPages.filter(p => PAGE_REGISTRY[p].visible(a));
        const tabDefs = {
          'overview': { icon: 'bi-info-circle', label: 'Overview' },
          'core-service': { icon: 'bi-gear-wide-connected', label: 'Core Service' },
          'repair-service': { icon: 'bi-tools', label: 'Repair Service' },
          'ai-assistant': { icon: 'bi-robot', label: 'AI' },
          'inspection': { icon: 'bi-clipboard-check', label: 'Inspect' },
          'quotation': { icon: 'bi-receipt', label: 'Quote' },
          'repair': { icon: 'bi-tools', label: 'Repair' },
          'scheduling': { icon: 'bi-calendar-event', label: 'Schedule' },
          'completion': { icon: 'bi-check-circle', label: 'Done' },
          'invoice': { icon: 'bi-file-earmark-text', label: 'Invoice' },
          'rating': { icon: 'bi-star', label: 'Rating' },
        };

        // Compute per-tab status badge and attention class
        function getTabStatus(pageId, assignment) {
          const booking = assignment.bookingId || {};
          const services = booking.services || [];
          if (pageId === 'core-service') {
            const coreItems = services.filter(s => s.type === 'core');
            if (!coreItems.length) return null;
            const allDone = coreItems.every(s => s.status === 'completed');
            const anyActive = coreItems.some(s => s.status === 'in_progress');
            if (allDone) return { badge: 'Done', cls: 'badge-done', attention: false };
            if (anyActive) return { badge: 'Active', cls: 'badge-active', attention: false };
            return { badge: 'To Do', cls: 'badge-pending', attention: true };
          }
          if (pageId === 'repair-service') {
            const repairItems = services.filter(s => s.type === 'repair');
            if (!repairItems.length) return null;
            const allDone = repairItems.every(s => ['completed', 'repair_declined', 'cancelled'].includes(s.status));
            const anyActive = repairItems.some(s => ['in_progress', 'repair_in_progress', 'inspection_in_progress'].includes(s.status));
            if (allDone) return { badge: 'Done', cls: 'badge-done', attention: false };
            if (anyActive) return { badge: 'Active', cls: 'badge-active', attention: false };
            return { badge: 'To Do', cls: 'badge-pending', attention: true };
          }
          if (pageId === 'ai-assistant') {
            const ta = booking.technicianAssistant;
            if (!ta?.summary) return { badge: 'New', cls: 'badge-pending', attention: true };
            if (!ta.verifiedByTechnician) return { badge: 'Review', cls: 'badge-pending', attention: true };
            return { badge: 'Done', cls: 'badge-done', attention: false };
          }
          if (pageId === 'inspection') {
            if (booking.inspection?.completedAt) return { badge: 'Done', cls: 'badge-done', attention: false };
            return { badge: 'To Do', cls: 'badge-pending', attention: true };
          }
          if (pageId === 'quotation') {
            if (booking.quotation?.totalCost > 0) return { badge: 'Done', cls: 'badge-done', attention: false };
            return { badge: 'To Do', cls: 'badge-pending', attention: true };
          }
          if (pageId === 'completion') {
            if (assignment.status === 'completed') return { badge: 'Done', cls: 'badge-done', attention: false };
            return { badge: 'To Do', cls: 'badge-pending', attention: true };
          }
          return null;
        }

        // Build tab bar + tab panels
        let tabsHtml = '';
        let panelsHtml = '';
        visiblePages.forEach((p, idx) => {
          const d = tabDefs[p] || { icon: 'bi-circle', label: p };
          const active = idx === 0 ? 'active' : '';
          const ts = getTabStatus(p, a);
          const attentionCls = ts?.attention ? 'needs-action' : '';
          const badgeHtml = ts ? `<span class="mw-tab-badge ${ts.cls}">${ts.badge}</span>` : '';
          tabsHtml += `<button class="mw-detail-tab ${active} ${attentionCls}" data-tab="${p}"><i class="bi ${d.icon}"></i><span>${d.label}</span>${badgeHtml}</button>`;
          let pageHtml = '';
          if (p === 'overview') pageHtml = renderCustomerDetails(a, date, bookingRef, hasCoords, custLat, custLng, activityHtml);
          else if (p === 'core-service') pageHtml = renderMixedCorePage(a);
          else if (p === 'repair-service') pageHtml = renderMixedRepairPage(a);
          else if (p === 'ai-assistant') pageHtml = renderAiAssistantPage(a);
          else if (p === 'inspection') pageHtml = renderInspectionPage(a);
          else if (p === 'quotation') pageHtml = renderQuotationPage(a);
          else if (p === 'repair') pageHtml = renderRepairPage(a);
          else if (p === 'scheduling') pageHtml = renderSchedulingPage(a);
          else if (p === 'completion') pageHtml = renderCompletionPage(a);
          else if (p === 'invoice') pageHtml = renderInvoicePage(a);
          else if (p === 'rating') pageHtml = renderRatingPage(a);
          panelsHtml += `<div class="mw-detail-panel ${active}" data-tab="${p}">${pageHtml}</div>`;
        });

        const contentEl = document.getElementById('detailPanelContent');
        contentEl.classList.add('booking-order-detail-content');
        // Remove previous tab listener to avoid stacking
        contentEl._tabListener && contentEl.removeEventListener('click', contentEl._tabListener);
        if (visiblePages.length > 1) {
          contentEl.innerHTML = `<div class="mw-detail-tabs">${tabsHtml}</div><div class="mw-detail-panels">${panelsHtml}</div>`;
          contentEl._tabListener = function onTabClick(e) {
            const btn = e.target.closest('.mw-detail-tab');
            if (!btn) return;
            switchDetailTab(btn.dataset.tab);
          };
          contentEl.addEventListener('click', contentEl._tabListener);
        } else {
          contentEl.innerHTML = panelsHtml;
        }
        if (activeTabBeforeRefresh && visiblePages.includes(activeTabBeforeRefresh)) {
          switchDetailTab(activeTabBeforeRefresh);
        } else {
          window._activeDetailTab = visiblePages[0] || null;
        }
        contentEl.style.display = '';
        document.getElementById('detailPanelLoading').style.display = 'none';

        // ── Action bar ──
        const actionBar = document.getElementById('detailPanelActions');
        const actionPage = isMixed ? (window._activeDetailTab || 'overview') : 'overview';
        const actionsHtml = getWizardPageActions(actionPage, a);
        if (actionsHtml) {
          actionBar.innerHTML = actionsHtml;
          actionBar.style.display = 'flex';
        } else {
          actionBar.style.display = 'none';
        }

        // ── Route Map — embedded in detail panel ──
        // Preserve a live map reference across detail refreshes. Clearing this
        // without calling Leaflet.remove() leaves the container initialized.
        window._routeMapInstance = window._routeMapInstance || null;
        window._routeMapInitToken = window._routeMapInitToken || 0;

        window.openRouteMapModal = function (custLat, custLng, customerName, address) {
          const mapInitToken = ++window._routeMapInitToken;
          if (window._routeMapInitTimer) {
            clearTimeout(window._routeMapInitTimer);
            window._routeMapInitTimer = null;
          }
          const da = window._detailAssignment || {};
          const bookingLocation = da.bookingId?.location || {};
          const assignmentCoordinates = da.coordinates || {};
          const geoJsonCoordinates = bookingLocation.coordinates?.coordinates || bookingLocation.coordinates || [];
          const firstValidCoordinate = function (values, min, max) {
            for (const value of values) {
              if (value === null || value === undefined || value === '') continue;
              const number = Number(value);
              if (Number.isFinite(number) && number >= min && number <= max) return number;
            }
            return null;
          };
          // Explicit coordinates are preferred, but some legacy callers pass
          // empty values. Always fall back through every persisted location
          // shape before considering address geocoding.
          custLat = firstValidCoordinate([
            custLat,
            da.customerLat,
            assignmentCoordinates.lat,
            bookingLocation.lat,
            geoJsonCoordinates[1],
            da.location?.lat
          ], -90, 90);
          custLng = firstValidCoordinate([
            custLng,
            da.customerLng,
            assignmentCoordinates.lng,
            bookingLocation.lng,
            geoJsonCoordinates[0],
            da.location?.lng
          ], -180, 180);
          if (!customerName) customerName = da.customerName || 'Customer';
          if (!address) address = da.customerLocation?.address || da.address || bookingLocation.address || da.bookingId?.customerLocation?.address || da.bookingId?.address || '';

          // Store for Refresh / Open Maps
          window._routeMapCoords = {
            lat: custLat,
            lng: custLng,
            customerName: customerName,
            address: address
          };

          if (window._routeMapInstance) {
            window._routeMapInstance.remove();
            window._routeMapInstance = null;
          }
          var existingMapEl = document.getElementById('routeMapModalMap');
          if (existingMapEl && existingMapEl._leaflet_id) {
            existingMapEl.innerHTML = '';
            delete existingMapEl._leaflet_id;
          }

          // Open Bootstrap route map modal and hide any open detail modal
          var modalEl = document.getElementById('routeMapModal');
          if (modalEl) {
            bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop: 'static' }).show();
          }

          var assignDetailModalEl = document.getElementById('assignDetailModal');
          if (assignDetailModalEl) {
            var assignBsModal = bootstrap.Modal.getInstance(assignDetailModalEl);
            if (assignBsModal) assignBsModal.hide();
          }

          // Populate header / footer info
          const companyLoc = window._companyLocation || { lat: 14.676049, lng: 121.043731, address: 'Company Office', name: 'Company' };
          var compEl = document.getElementById('routeMapModalCompany');
          var compAddrEl = document.getElementById('routeMapModalCompanyAddress');
          var custEl = document.getElementById('routeMapModalCustomer');
          var addrEl = document.getElementById('routeMapModalAddress');
          var techEl = document.getElementById('routeMapModalTechnician');
          var statusEl = document.getElementById('routeMapModalStatus');
          var refEl = document.getElementById('routeMapModalRef');
          var subtitleEl = document.getElementById('routeMapModalSubtitle');
          if (compEl) compEl.textContent = companyLoc.name || 'Company';
          if (compAddrEl) compAddrEl.textContent = companyLoc.address || 'Office';
          if (custEl) custEl.textContent = customerName;
          if (addrEl) addrEl.textContent = address;
          if (techEl) techEl.textContent = 'You';
          if (statusEl) statusEl.textContent = 'En Route';
          if (refEl) refEl.textContent = da.bookingId?.bookingRef || da.bookingRef || '—';
          if (subtitleEl) subtitleEl.textContent = address || 'Live location tracking';

          var distEl = document.getElementById('routeMapModalDistance');
          var durEl = document.getElementById('routeMapModalDuration');
          var etaEl = document.getElementById('routeMapModalETA');
          if (distEl) distEl.innerHTML = '<i class="bi bi-compass me-1"></i>Calculating route...';
          if (durEl) durEl.textContent = '-- min';
          if (etaEl) etaEl.style.display = 'none';

          window._routeMapInitTimer = setTimeout(async function () {
              window._routeMapInitTimer = null;
              if (mapInitToken !== window._routeMapInitToken) return;
              var mapEl = document.getElementById('routeMapModalMap');
              if (!mapEl) return;

              // A stale or externally-created Leaflet instance must not be
              // initialized a second time on the same DOM element.
              if (window._routeMapInstance) {
                window._routeMapInstance.remove();
                window._routeMapInstance = null;
              }
              if (mapEl._leaflet_id) {
                mapEl.innerHTML = '';
                delete mapEl._leaflet_id;
              }

              var detailMap = L.map(mapEl, { zoomControl: true });
              window._routeMapInstance = detailMap;

              // Abort rendering if the modal was closed or the map refreshed
              // while any async step (geocoding / geolocation / OSRM) is running.
              const _mapAlive = function () {
                return window._routeMapInstance === detailMap &&
                  !!detailMap._container && detailMap._container.isConnected;
              };

              var hybridBase = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri — Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community',
                maxZoom: 18
              });
              var hybridLabels = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Transportation/MapServer/tile/{z}/{y}/{x}', {
                attribution: '&copy; Esri', maxZoom: 18
              });
              var hybridGroup = L.layerGroup([hybridBase, hybridLabels]);
              hybridGroup.addTo(detailMap);

              let finalLat = custLat;
              let finalLng = custLng;
              const companyLoc = window._companyLocation || { lat: 14.676049, lng: 121.043731, address: 'Company Office' };
              let companyLat = parseFloat(companyLoc.lat) || 14.676049;
              let companyLng = parseFloat(companyLoc.lng) || 121.043731;

              if (finalLat === null || finalLng === null) {
                document.getElementById('routeMapModalDistance').innerHTML =
                  '<i class="bi bi-search me-1"></i>Searching address location...';
                const geocodeAddress = async (addr) => {
                  const parts = addr.split(',').map(p => p.trim()).filter(Boolean);
                  for (let i = 0; i < parts.length; i++) {
                    const query = parts.slice(i).join(', ');
                    if (query.length < 5) continue;
                    try {
                      const geoUrl = 'https://nominatim.openstreetmap.org/search?format=json&q=' +
                        encodeURIComponent(query) + '&limit=1';
                      const geoRes = await fetch(geoUrl);
                      if (geoRes.ok) {
                        const geoData = await geoRes.json();
                        if (geoData && geoData.length > 0)
                          return { lat: parseFloat(geoData[0].lat), lng: parseFloat(geoData[0].lon) };
                      }
                    } catch (e) {
                      console.warn('Geocoding attempt failed for query: ' + query, e);
                    }
                  }
                  return null;
                };
                const result = await geocodeAddress(address);
                if (!_mapAlive()) return;
                if (result) { finalLat = result.lat; finalLng = result.lng; }
              }

              const techLocation = window._detailTechLocation;
              const dbTechLng = techLocation?.coordinates?.[0] || null;
              const dbTechLat = techLocation?.coordinates?.[1] || null;

              const getTechLoc = () => {
                return new Promise((resolve) => {
                  if (!navigator.geolocation) {
                    resolve(dbTechLat && dbTechLng ? { lat: dbTechLat, lng: dbTechLng } : null);
                    return;
                  }
                  let resolved = false;
                  const done = (pos) => {
                    if (resolved) return;
                    resolved = true;
                    clearTimeout(fallbackTimer);
                    resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude });
                  };
                  const fail = () => {
                    if (resolved) return;
                    resolved = true;
                    clearTimeout(fallbackTimer);
                    resolve(dbTechLat && dbTechLng ? { lat: dbTechLat, lng: dbTechLng } : null);
                  };
                  const fallbackTimer = setTimeout(() => {
                    if (!resolved) { resolved = true; resolve(dbTechLat && dbTechLng ? { lat: dbTechLat, lng: dbTechLng } : null); }
                  }, 12000);
                  navigator.geolocation.getCurrentPosition(done, fail, { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 });
                });
              };
              const techLoc = await getTechLoc();

              if (!_mapAlive()) return;

              window._routeTechMarker = null;
              const distEl = document.getElementById('routeMapModalDistance');
              const durEl = document.getElementById('routeMapModalDuration');
              const etaEl = document.getElementById('routeMapModalETA');
              const etaText = document.getElementById('routeMapModalETAText');

              if (finalLat !== null && finalLng !== null) {
                const sameCustomerSite = !!techLoc &&
                  Math.abs(Number(techLoc.lat) - Number(finalLat)) < 0.00005 &&
                  Math.abs(Number(techLoc.lng) - Number(finalLng)) < 0.00005;
                // Customer marker — enterprise purple with shadow
                const custMarker = L.marker([finalLat, finalLng], {
                  icon: L.divIcon({
                    className: '',
                    html: '<div style="filter:drop-shadow(0 3px 5px rgba(0,0,0,.45))"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="40" viewBox="0 0 28 40"><path d="M14 0C6.3 0 0 6.3 0 14c0 10.5 14 26 14 26s14-15.5 14-26C28 6.3 21.7 0 14 0z" fill="#7c3aed"/><circle cx="14" cy="14" r="5" fill="#fff"/></svg></div>',
                    iconSize: [28, 40], iconAnchor: [sameCustomerSite ? 22 : 14, 40]
                  })
                }).addTo(detailMap).bindPopup(
                  '<div style="font-family:inherit;text-align:center;"><strong>' + customerName + '</strong><br><span style="font-size:0.8rem;color:#64748b;">' + address + '</span></div>'
                );

                // Company marker — enterprise amber building
                const companyMarker = L.marker([companyLat, companyLng], {
                  icon: L.divIcon({
                    className: '',
                    html: '<div style="filter:drop-shadow(0 3px 5px rgba(0,0,0,.45))"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="40" viewBox="0 0 28 40"><path d="M14 0C6.3 0 0 6.3 0 14c0 10.5 14 26 14 26s14-15.5 14-26C28 6.3 21.7 0 14 0z" fill="#f59e0b"/><circle cx="14" cy="14" r="5" fill="#fff"/></svg></div>',
                    iconSize: [28, 40], iconAnchor: [14, 40]
                  })
                }).addTo(detailMap).bindPopup(
                  '<div style="font-family:inherit;text-align:center;"><strong>' + (companyLoc.name || 'Company') + '</strong><br><span style="font-size:0.8rem;color:#64748b;">' + (companyLoc.address || 'Office') + '</span></div>'
                );

                if (techLoc) {
                  // Technician marker — blue gradient with pulse ring
                  const techMarker = L.marker([techLoc.lat, techLoc.lng], {
                    icon: L.divIcon({
                      className: '',
                      html: '<div style="filter:drop-shadow(0 3px 5px rgba(0,0,0,.45))"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="40" viewBox="0 0 28 40"><path d="M14 0C6.3 0 0 6.3 0 14c0 10.5 14 26 14 26s14-15.5 14-26C28 6.3 21.7 0 14 0z" fill="#3b82f6"/><circle cx="14" cy="14" r="5" fill="#fff"/></svg></div>',
                      iconSize: [28, 40], iconAnchor: [sameCustomerSite ? 6 : 14, 40]
                    })
                  }).addTo(detailMap).bindPopup(
                    '<div style="font-family:inherit;text-align:center;"><strong>You</strong><br><span style="font-size:0.8rem;color:#64748b;">Technician</span></div>'
                  );
                  window._routeTechMarker = techMarker;

                  if (sameCustomerSite) {
                    L.tooltip({ permanent: true, direction: 'top', offset: [0, -42], className: 'route-shared-location-label' })
                      .setLatLng([finalLat, finalLng])
                      .setContent('Customer site and technician are at the same location')
                      .addTo(detailMap);
                  }

                  const group = new L.featureGroup([companyMarker, custMarker, techMarker]);
                  detailMap.fitBounds(group.getBounds().pad(0.2));

                  // Fetch OSRM routes (company → customer & technician → customer)
                  try {
                    const companyUrl = 'https://router.project-osrm.org/route/v1/driving/' +
                      companyLng + ',' + companyLat + ';' + finalLng + ',' + finalLat +
                      '?overview=full&geometries=geojson';
                    const techUrl = 'https://router.project-osrm.org/route/v1/driving/' +
                      techLoc.lng + ',' + techLoc.lat + ';' + finalLng + ',' + finalLat +
                      '?overview=full&geometries=geojson';
                    const [companyRes, techRes] = await Promise.all([fetch(companyUrl), fetch(techUrl)]);
                    if (!_mapAlive()) return;
                    let totalDistKm = null, totalDurMin = null, remDistKm = null, remDurMin = null;

                    if (companyRes.ok) {
                      const companyData = await companyRes.json();
                      if (companyData.routes && companyData.routes.length > 0) {
                        const cRoute = companyData.routes[0];
                        totalDistKm = (cRoute.distance / 1000).toFixed(1);
                        totalDurMin = Math.round(cRoute.duration / 60);
                        // Full planned route
                        L.geoJSON(cRoute.geometry, {
                          style: { color: '#2563eb', weight: 4, opacity: 0.8 }
                        }).addTo(detailMap);
                      }
                    }

                    if (techRes.ok) {
                      const techData = await techRes.json();
                      if (techData.routes && techData.routes.length > 0) {
                        const tRoute = techData.routes[0];
                        remDistKm = (tRoute.distance / 1000).toFixed(1);
                        remDurMin = Math.round(tRoute.duration / 60);
                        // Remaining route from technician to customer
                        L.geoJSON(tRoute.geometry, {
                          style: { color: '#0ea5e9', weight: 4, opacity: 0.85, dashArray: '8, 8' }
                        }).addTo(detailMap);
                        // ETA based on technician location
                        const eta = new Date(Date.now() + tRoute.duration * 1000);
                        etaEl.style.display = '';
                        etaText.textContent = 'ETA ' + eta.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                      }
                    }

                    if (totalDistKm != null && totalDurMin != null) {
                      distEl.innerHTML = '<i class="bi bi-building me-1"></i><strong>' + totalDistKm + ' km</strong> <span style="font-weight:400;color:#64748b;">(' + totalDurMin + ' min)</span>';
                    } else {
                      distEl.innerHTML = '<i class="bi bi-compass me-1"></i>Route unavailable';
                    }
                    if (remDurMin != null) {
                      durEl.innerHTML = '<i class="bi bi-clock me-1"></i>' + remDurMin + ' min away';
                    } else {
                      durEl.textContent = '-- min';
                    }
                  } catch (err) {
                    console.warn('OSRM routing failed', err);
                    if (!_mapAlive()) return;
                    try {
                      const hDist = function (lat1, lng1, lat2, lng2) {
                        const R = 6371;
                        const dLat = (lat2 - lat1) * Math.PI / 180;
                        const dLng = (lng2 - lng1) * Math.PI / 180;
                        const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                          Math.sin(dLng / 2) * Math.sin(dLng / 2) *
                          Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180);
                        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                      };
                      // Fallback straight-line estimates
                      L.polyline([[companyLat, companyLng], [finalLat, finalLng]], {
                        color: '#2563eb', weight: 3, opacity: 0.5, dashArray: '5, 5'
                      }).addTo(detailMap);
                      L.polyline([[techLoc.lat, techLoc.lng], [finalLat, finalLng]], {
                        color: '#0ea5e9', weight: 3, opacity: 0.5, dashArray: '5, 5'
                      }).addTo(detailMap);
                      const companyDist = hDist(companyLat, companyLng, finalLat, finalLng);
                      const techDist = hDist(techLoc.lat, techLoc.lng, finalLat, finalLng);
                      const techDur = Math.round(techDist / 30 * 60);
                      distEl.innerHTML = '<i class="bi bi-building me-1"></i><strong>' + companyDist.toFixed(1) + ' km</strong> <span style="font-weight:400;color:#64748b;">(Est.)</span>';
                      durEl.textContent = '~' + techDur + ' min';
                      const eta = new Date(Date.now() + techDur * 60000);
                      etaEl.style.display = '';
                      etaText.textContent = 'ETA ' + eta.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                    } catch (renderErr) {
                      console.warn('Route fallback rendering failed', renderErr);
                      distEl.innerHTML = '<i class="bi bi-compass me-1"></i>Route unavailable';
                    }
                  }
                } else {
                  detailMap.setView([finalLat, finalLng], 16);
                  L.circleMarker([finalLat, finalLng], {
                    radius: 8, color: '#7c3aed', fillColor: '#7c3aed', fillOpacity: 0.3, weight: 2
                  }).addTo(detailMap);
                }
              } else {
                if (techLoc) {
                  detailMap.setView([techLoc.lat, techLoc.lng], 14);
                  L.marker([techLoc.lat, techLoc.lng], {
                    icon: L.divIcon({
                      className: '',
                      html: '<div style="background:linear-gradient(135deg,#2563eb,#60a5fa);width:34px;height:34px;border-radius:50%;border:2.5px solid #fff;box-shadow:0 4px 16px rgba(37,99,235,0.5);display:flex;align-items:center;justify-content:center;"><i class="bi bi-geo-alt-fill" style="color:#fff;font-size:14px;"></i></div>',
                      iconSize: [34, 34], iconAnchor: [17, 17]
                    })
                  }).addTo(detailMap).bindPopup('<strong>You (Technician)</strong>');
                } else {
                  detailMap.setView([15.48, 120.97], 10);
                }
                distEl.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Could not locate address on map';
                durEl.textContent = 'N/A';
              }
              // Live position watcher + polling fallback (after initial marker exists)
              if (window._routeMapWatcher) { navigator.geolocation.clearWatch(window._routeMapWatcher); window._routeMapWatcher = null; }
              if (window._routeMapInterval) { clearInterval(window._routeMapInterval); window._routeMapInterval = null; }

              if (navigator.geolocation) {
                const updateTechMarker = function (lat, lng) {
                  const activeMap = window._routeMapInstance;
                  if (!activeMap || !activeMap._container || !activeMap._container.isConnected) return;
                  window._lastTechLoc = { lat, lng };
                  if (window._routeTechMarker) {
                    window._routeTechMarker.setLatLng([lat, lng]);
                  } else {
                    window._routeTechMarker = L.marker([lat, lng], {
                      icon: L.divIcon({
                        className: '',
                        html: '<div style="filter:drop-shadow(0 3px 5px rgba(0,0,0,.45))"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="40" viewBox="0 0 28 40"><path d="M14 0C6.3 0 0 6.3 0 14c0 10.5 14 26 14 26s14-15.5 14-26C28 6.3 21.7 0 14 0z" fill="#3b82f6"/><circle cx="14" cy="14" r="5" fill="#fff"/></svg></div>',
                        iconSize: [28, 40], iconAnchor: [14, 40]
                      })
                    }).addTo(detailMap).bindPopup('<div style="font-family:inherit;text-align:center;"><strong>You</strong><br><span style="font-size:0.8rem;color:#64748b;">Technician</span></div>');
                  }
                  fetch('/api/auth/technician/location', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ lat, lng }) }).catch(function () {});
                };

                window._routeMapWatcher = navigator.geolocation.watchPosition(
                  function (pos) { updateTechMarker(pos.coords.latitude, pos.coords.longitude); },
                  function (err) { console.warn('Route map geolocation watch failed', err); },
                  { enableHighAccuracy: true, maximumAge: 0, timeout: 10000 }
                );

                window._routeMapInterval = setInterval(function () {
                  navigator.geolocation.getCurrentPosition(
                    function (pos) { updateTechMarker(pos.coords.latitude, pos.coords.longitude); },
                    function (err) { console.warn('Route map geolocation poll failed', err); },
                    { enableHighAccuracy: true, maximumAge: 0, timeout: 8000 }
                  );
                }, 8000);
              }

              if (detailMap._container && detailMap._container.isConnected) detailMap.invalidateSize();
              [100, 300, 700, 1200].forEach(function (ms) {
                setTimeout(function () { const map = window._routeMapInstance; if (map && map._container && map._container.isConnected) map.invalidateSize(); }, ms);
              });
          }, 350);
        };

        window.hideRoutePanel = function () {
          var panel = document.getElementById('routePanelMap');
          if (!panel) return;
          panel.style.display = 'none';
          panel.classList.add('collapsed');
          if (window._routeMapWatcher) { navigator.geolocation.clearWatch(window._routeMapWatcher); window._routeMapWatcher = null; }
          if (window._routeMapInterval) { clearInterval(window._routeMapInterval); window._routeMapInterval = null; }
          if (window._routeMapInstance) {
            window._routeMapInstance.remove();
            window._routeMapInstance = null;
          }
          window._routeTechMarker = null;
        };

        window.toggleRoutePanel = function () {
          var panel = document.getElementById('routePanelMap');
          var icon = document.getElementById('routePanelToggleIcon');
          if (!panel) return;
          if (panel.classList.contains('collapsed')) {
            panel.classList.remove('collapsed');
            if (icon) icon.className = 'bi bi-dash-lg';
            if (window._routeMapInstance) {
              setTimeout(function () { const map = window._routeMapInstance; if (map && map._container && map._container.isConnected) map.invalidateSize(); }, 100);
            }
          } else {
            panel.classList.add('collapsed');
            if (icon) icon.className = 'bi bi-arrows-expand';
          }
        };

        window.closeRouteMapModal = function () {
          window._routeMapInitToken = (window._routeMapInitToken || 0) + 1;
          if (window._routeMapInitTimer) { clearTimeout(window._routeMapInitTimer); window._routeMapInitTimer = null; }
          if (window._routeMapWatcher) { navigator.geolocation.clearWatch(window._routeMapWatcher); window._routeMapWatcher = null; }
          if (window._routeMapInterval) { clearInterval(window._routeMapInterval); window._routeMapInterval = null; }
          if (window._routeMapInstance) { window._routeMapInstance.remove(); window._routeMapInstance = null; }
          window._routeTechMarker = null;
          var modalEl = document.getElementById('routeMapModal');
          if (modalEl) {
            var bsModal = bootstrap.Modal.getInstance(modalEl);
            if (bsModal) bsModal.hide();
          }
        };

        window.refreshRouteMapModal = function () {
          const c = window._routeMapCoords;
          if (!c || !c.lat || !c.lng) return;
          openRouteMapModal(c.lat, c.lng, c.customerName, c.address);
        };

        window.openFullRouteMap = function () {
          const c = window._routeMapCoords;
          if (!c || !c.lat || !c.lng) return;
          const url = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(c.lat + ',' + c.lng);
          window.open(url, '_blank');
        };

      } catch (e) {
        console.error('[showDetail] Error:', e);
        showNotification({ type: 'error', title: 'Load Failed', message: 'Failed to load assignment details.', duration: 5000 });
        document.getElementById('detailPanelLoading').style.display = 'none';
        document.getElementById('detailPanelEmpty').style.display = '';
      }
    };

    function showNotification({ type = 'info', title = '', message = '', duration = 4000 }) {
      const container = document.getElementById('technicianNotificationContainer');
      if (!container) return;
      const icons = { success: 'bi-check-circle-fill', error: 'bi-x-circle-fill', warning: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' };
      const notif = document.createElement('div');
      notif.className = `ent-notification ent-notif-${type}`;
      notif.innerHTML = `
      <div class="ent-notification-icon"><i class="bi ${icons[type] || icons.info}"></i></div>
      <div class="ent-notification-body">
        <p class="ent-notification-title">${title}</p>
        <p class="ent-notification-message">${message}</p>
      </div>
      <button class="ent-notification-close" onclick="this.closest('.ent-notification').classList.add('removing');setTimeout(()=>this.closest('.ent-notification')?.remove(),300);">&times;</button>`;
      container.appendChild(notif);
      setTimeout(() => { notif.classList.add('removing'); setTimeout(() => notif.remove(), 300); }, duration);
    }

    // Check URL for pre-selected status
    const params = new URLSearchParams(window.location.search);
    const statusParam = params.get('status');
    if (statusParam) {
      currentFilter = statusParam;
      document.querySelectorAll('#assignTabs .mw-tab').forEach(b => {
        b.classList.toggle('active', b.dataset.filter === statusParam);
      });
    }
    const idParam = params.get('id');
    if (idParam) {
      setTimeout(() => showDetail(idParam), 500);
    }

    const ACTIVE_STATUSES = ['en_route', 'in_progress', 'on_site'];
    let _hasAutoOpenedActiveJob = false;

    loadAssignments(currentFilter, 1).then(() => {
      if (_hasAutoOpenedActiveJob || idParam) return;
      const activeJob = (window.allItems || []).find(a => ACTIVE_STATUSES.includes(a.status));
      if (activeJob) {
        _hasAutoOpenedActiveJob = true;
        const jobIndex = (window.allItems || []).indexOf(activeJob);
        if (jobIndex >= 0 && typeof cardPage !== 'undefined') {
          cardPage = Math.floor(jobIndex / CARDS_PER_PAGE);
        }
        if (typeof renderCardPage === 'function') renderCardPage();
        showDetail(activeJob._id);
      }
    });
    const prepDP = document.getElementById('prepDatePicker');
    if (prepDP) { const d = new Date(); d.setDate(d.getDate()); prepDP.value = d.toISOString().slice(0,10); }
    loadPreparation();
    window._showNotification = showNotification;
  })();

  // ═══ Preparation Bar (All Upcoming Jobs) ═══
  async function loadPreparation(dateStr) {
    const _esc = (s) => s ? String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;') : '';
    try {
      const resp = await fetch('/api/technician/daily-kit' + (dateStr ? '?date=' + encodeURIComponent(dateStr) : ''), { credentials: 'same-origin' });
      if (!resp.ok) return;
      const data = await resp.json();
      const kit = data.kit;

      // Update global kit status for detail panel button logic
      window._dailyKitStatus = kit ? kit.status : null;
      if (typeof window.refreshAssignmentCardsForPreparation === 'function') {
        window.refreshAssignmentCardsForPreparation();
      }

      const summaryText = document.getElementById('preparationSummaryText');
      const statusBadge = document.getElementById('prepStatusBadge');
      const detailsDiv = document.getElementById('preparationDetails');
      const tagsDiv = document.getElementById('preparationResourceTags');

      if (!kit || !kit.items || kit.items.length === 0) {
        summaryText.textContent = 'No jobs assigned for today';
        statusBadge.style.display = 'none';
        detailsDiv.style.display = 'none';
        return;
      }

      const jobCount = (kit.assignmentIds || []).length;
      const equipCount = kit.items.filter(i => i.category === 'equipment').length;
      const consCount = kit.items.filter(i => i.category === 'consumable').length;
      const unavailable = kit.items.filter(i => i.checkoutStatus === 'unavailable').length;

      summaryText.textContent = `${jobCount} job${jobCount !== 1 ? 's' : ''} • ${equipCount} equipment • ${consCount} consumables`;

      // Status badge
      const statusMap = {
        draft: { bg: '#dbeafe', color: '#1e40af', label: 'Needs Prep' },
        prepared: { bg: '#fef3c7', color: '#92400e', label: 'Prepared' },
        confirmed: { bg: '#dcfce7', color: '#166534', label: 'Ready' },
        in_progress: { bg: '#dbeafe', color: '#1e40af', label: 'In Progress' },
        completed: { bg: '#dcfce7', color: '#166534', label: 'Done' },
      };
      const stInfo = statusMap[kit.status] || statusMap.draft;
      statusBadge.style.display = '';
      statusBadge.style.background = stInfo.bg;
      statusBadge.style.color = stInfo.color;
      statusBadge.textContent = stInfo.label;

      // Show item tags
      if (kit.items.length > 0) {
        detailsDiv.style.display = '';
        tagsDiv.innerHTML = '';

        // Equipment tags
        const equip = kit.items.filter(i => i.category === 'equipment');
        if (equip.length > 0) {
          const header = document.createElement('div');
          header.style.cssText = 'width:100%;font-size:0.7rem;font-weight:700;color:#1e40af;margin-top:4px;';
          header.textContent = 'Equipment (' + equip.length + ')';
          tagsDiv.appendChild(header);

          equip.forEach(item => {
            const tag = document.createElement('span');
            const cls = item.checkoutStatus === 'checked_out' ? 'bg-success-subtle text-success' : 'bg-primary-subtle text-primary';
            tag.style.cssText = 'display:inline-flex;align-items:center;gap:3px;padding:3px 8px;border-radius:6px;font-size:0.65rem;font-weight:600;margin:2px;';
            tag.className = cls;
            tag.innerHTML = '<i class="bi bi-tools" style="font-size:0.55rem;"></i>' + _esc(item.name) + (item.quantity > 1 ? ' x' + item.quantity : '');
            tagsDiv.appendChild(tag);
          });
        }

        // Consumables tags
        const cons = kit.items.filter(i => i.category === 'consumable');
        if (cons.length > 0) {
          const header = document.createElement('div');
          header.style.cssText = 'width:100%;font-size:0.7rem;font-weight:700;color:#166534;margin-top:6px;';
          header.textContent = 'Consumables (' + cons.length + ')';
          tagsDiv.appendChild(header);

          cons.forEach(item => {
            const tag = document.createElement('span');
            tag.style.cssText = 'display:inline-flex;align-items:center;gap:3px;padding:3px 8px;border-radius:6px;font-size:0.65rem;font-weight:600;margin:2px;background:#f0fdf4;color:#166534;';
            tag.innerHTML = '<i class="bi bi-box" style="font-size:0.55rem;"></i>' + _esc(item.name) + ' x' + item.quantity;
            tagsDiv.appendChild(tag);
          });
        }
      } else {
        detailsDiv.style.display = 'none';
      }
    } catch (err) {
      console.error('Failed to load preparation:', err);
    }
  }

  window.openPrepModal = async function(assignmentId, bookingId, serviceName) {
    const _esc2 = (s) => s ? String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;') : '';
    const modal = document.getElementById('standardPreparationModal');
    if (!modal) return;
    const body = modal.querySelector('.modal-body') || modal.querySelector('#prepModalBody');
    if (!body) return;
    body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-success"></div><p class="mt-2 text-muted">Loading reserved resources...</p></div>';
    new bootstrap.Modal(modal).show();
    try {
      const res = await fetch(`/api/technician/assignments/${assignmentId}/preparation`, { credentials: 'same-origin' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to load preparation');
      const eq = data.equipment || [];
      const parts = data.parts || [];
      const allItems = [...eq, ...parts];
      if (!allItems.length) {
        body.innerHTML = '<div class="text-center py-4"><i class="bi bi-check-circle-fill text-success" style="font-size:2rem;"></i><h6 class="mt-2">No Resources Required</h6><p class="text-muted small">This job doesn\'t require equipment checkout.</p><button class="btn btn-sm btn-primary mt-2" onclick="bootstrap.Modal.getInstance(document.getElementById(\'standardPreparationModal\')).hide();transitionStatus(\'' + assignmentId + '\',\'en_route\',null);">Continue to En Route</button></div>';
        return;
      }
      let html = '<div style="margin-bottom:12px;"><h6 class="fw-bold"><i class="bi bi-box-seam me-2 text-success"></i>' + _esc2(serviceName) + '</h6><p class="text-muted small mb-0">Review and confirm the resources below before heading out.</p></div>';
      html += '<div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Item</th><th>Qty</th><th>Status</th></tr></thead><tbody>';
      allItems.forEach(function(item) {
        const isReserved = item.status === 'reserved';
        const isConsumable = item.consumable;
        const icon = isConsumable ? 'bi-droplet' : 'bi-tools';
        const badge = isReserved ? '<span class="badge bg-warning text-dark">Reserved</span>' : '<span class="badge bg-success">Checked Out</span>';
        html += '<tr><td><i class="bi ' + icon + ' me-2 text-muted"></i>' + _esc2(item.equipmentName || item.itemName || 'Item') + '</td><td>' + (item.quantity || 1) + '</td><td>' + badge + '</td></tr>';
      });
      html += '</tbody></table></div>';
      const hasReserved = allItems.some(function(i) { return i.status === 'reserved'; });
      html += '<div class="d-flex gap-2 mt-3">';
      if (hasReserved) {
        html += '<button class="btn btn-success flex-grow-1 fw-bold" onclick="checkoutJobResources(\'' + assignmentId + '\',\'' + bookingId + '\')"><i class="bi bi-box-arrow-in-right me-1"></i>Check Out All Resources</button>';
      }
      html += '<button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button></div>';
      body.innerHTML = html;
    } catch (err) {
      body.innerHTML = '<div class="alert alert-danger m-3">' + _esc2(err.message) + '</div>';
    }
  };

  window.checkoutJobResources = async function(assignmentId, bookingId) {
    const _esc3 = (s) => s ? String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;') : '';
    const body = document.querySelector('#standardPreparationModal .modal-body');
    if (body) body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-success"></div><p class="mt-2 text-muted">Checking out resources...</p></div>';
    try {
      const res = await fetch('/api/technician/assignments/' + assignmentId + '/checkout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin' });
      const data = await res.json();
      if (res.ok) {
        if (body) body.innerHTML = '<div class="text-center py-4"><i class="bi bi-check-circle-fill text-success" style="font-size:2rem;"></i><h6 class="mt-2">Resources Checked Out</h6><p class="text-muted small">You\'re ready to head to the job site.</p><button class="btn btn-sm btn-primary mt-2" onclick="bootstrap.Modal.getInstance(document.getElementById(\'standardPreparationModal\')).hide();transitionStatus(\'' + assignmentId + '\',\'en_route\',null);">Go En Route</button></div>';
        loadPreparation();
        if (window._currentDetailId) showDetail(window._currentDetailId);
      } else {
        if (body) body.innerHTML = '<div class="alert alert-danger m-3">' + _esc3(data.error || 'Checkout failed') + '</div>';
      }
    } catch (err) {
      if (body) body.innerHTML = '<div class="alert alert-danger m-3">' + _esc3(err.message) + '</div>';
    }
  };

  // ── Daily Dispatch Kit Modal ──────────────────────────────────────────

  // Event delegation for daily kit issue action buttons
  document.getElementById('dailyKitModal').addEventListener('click', function(e) {
    const resolveBtn = e.target.closest('.kit-resolve-btn');
    if (resolveBtn) {
      const name = resolveBtn.dataset.name;
      const action = resolveBtn.dataset.action;
      if (name && action) window.dailyKitResolveItem(name, action);
      return;
    }
    const notifyBtn = e.target.closest('.kit-notify-admin-btn');
    if (notifyBtn) {
      const name = notifyBtn.dataset.name;
      if (name) window.dailyKitNotifyAdminItem(name);
      return;
    }
    const deltaAddBtn = e.target.closest('.kit-delta-add');
    if (deltaAddBtn) {
      window.kitDeltaHighlightConfirm();
      return;
    }
    const deltaResolveBtn = e.target.closest('.kit-delta-resolve');
    if (deltaResolveBtn) {
      const name = deltaResolveBtn.dataset.name;
      const category = deltaResolveBtn.dataset.category || '';
      const action = deltaResolveBtn.dataset.action;
      if (name && action) window.kitDeltaDecision(name, category, action);
      return;
    }
    const deltaReportBtn = e.target.closest('.kit-delta-report');
    if (deltaReportBtn) {
      const name = deltaReportBtn.dataset.name;
      if (name && window.dailyKitNotifyAdminItem) window.dailyKitNotifyAdminItem(name);
      return;
    }
  });

  window.openDailyKitModal = function() {
    loadDailyKit();
    new bootstrap.Modal(document.getElementById('dailyKitModal')).show();
  };

  async function loadDailyKit() {
    const _esc = (s) => s ? String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;') : '';
    const jobSummaryEl = document.getElementById('kitJobSummary');
    const dateLabel = document.getElementById('kitDateLabel');
    const statusBadge = document.getElementById('kitStatusBadge');
    const jobsListEl = document.getElementById('kitJobsList');
    const jobsContentEl = document.getElementById('kitJobsContent');
    const equipSection = document.getElementById('kitEquipmentSection');
    const equipListEl = document.getElementById('kitEquipmentList');
    const equipCountEl = document.getElementById('kitEquipCount');
    const consSection = document.getElementById('kitConsumablesSection');
    const consListEl = document.getElementById('kitConsumablesList');
    const consCountEl = document.getElementById('kitConsCount');
    const repairSection = document.getElementById('kitRepairSection');
    const repairListEl = document.getElementById('kitRepairList');
    const partsCountEl = document.getElementById('kitPartsCount');
    const aiSection = document.getElementById('kitAiContingencySection');
    const aiListEl = document.getElementById('kitAiContingencyList');
    const aiCountEl = document.getElementById('kitAiCount');
    const unavailableSection = document.getElementById('kitUnavailableSection');
    const unavailableListEl = document.getElementById('kitUnavailableList');
    const deltaSection = document.getElementById('kitDeltaSection');
    const summarySection = document.getElementById('kitSummarySection');
    const summaryContent = document.getElementById('kitSummaryContent');
    const confirmBtn = document.getElementById('kitConfirmBtn');

    jobSummaryEl.innerHTML = '<div class="spinner-border spinner-border-sm text-primary"></div> Loading kit...';
    statusBadge.style.display = 'none';

    try {
      const kitDateQuery = window._dailyKitRequestedDate ? '?date=' + encodeURIComponent(window._dailyKitRequestedDate) : '';
      const resp = await fetch('/api/technician/daily-kit' + kitDateQuery, { credentials: 'same-origin' });
      if (!resp.ok) throw new Error('Failed to load');
      const data = await resp.json();
      const kit = data.kit;
      const jobDetails = data.jobDetails || [];
      const aiSuggestions = data.aiContingencySuggestions || [];

      // Track kit status globally for detail panel button logic
      window._dailyKitStatus = kit ? kit.status : null;

      if (!kit || !kit.items || kit.items.length === 0) {
        jobSummaryEl.innerHTML = '<span style="color:#64748b;">No jobs assigned for today</span>';
        if (dateLabel) dateLabel.textContent = '';
        equipSection.style.display = 'none';
        consSection.style.display = 'none';
        repairSection.style.display = 'none';
        if (aiSection) aiSection.style.display = 'none';
        unavailableSection.style.display = 'none';
        if (summarySection) summarySection.style.display = 'none';
        confirmBtn.style.display = 'none';
        return;
      }

      // Build a lookup map: assignmentId -> job detail, bookingId -> job detail
      const jobByAssignment = new Map();
      const jobByBooking = new Map();
      const jobByOrder = new Map();
      const jobByDailyAssignment = new Map();
      (data.jobDetails || []).forEach(j => {
        if (j.assignmentId) jobByAssignment.set(String(j.assignmentId), j);
        if (j.bookingId) jobByBooking.set(String(j.bookingId), j);
        if (j.orderId) jobByOrder.set(String(j.orderId), j);
        if (j.dailyAssignmentId) jobByDailyAssignment.set(String(j.dailyAssignmentId), j);
      });

      // Date label
      if (dateLabel) dateLabel.textContent = new Date(kit.workDate).toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

      // Status badge
      const statusMap = {
        draft: { bg: '#dbeafe', color: '#1e40af', label: 'Draft' },
        prepared: { bg: '#fef3c7', color: '#92400e', label: 'Prepared' },
        confirmed: { bg: '#dcfce7', color: '#166534', label: 'Confirmed' },
        in_progress: { bg: '#dbeafe', color: '#1e40af', label: 'In Progress' },
        completed: { bg: '#dcfce7', color: '#166534', label: 'Completed' },
      };
      const stInfo = statusMap[kit.status] || statusMap.draft;
      statusBadge.style.display = '';
      statusBadge.style.background = stInfo.bg;
      statusBadge.style.color = stInfo.color;
      statusBadge.textContent = stInfo.label;

      // Job summary
      const jobCount = jobDetails.length;
      jobSummaryEl.innerHTML = '<strong>' + jobCount + ' job' + (jobCount !== 1 ? 's' : '') + '</strong> for ' + new Date(kit.workDate).toLocaleDateString('en-PH', { weekday: 'long', month: 'short', day: 'numeric' });

      // Jobs list with job names + expandable per-job item breakdown
      const unavailable = kit.items.filter(i => i.checkoutStatus === 'unavailable');
      // Group every kit item (incl. undecided deltas) under its job(s)
      const itemsByAssignment = new Map();
      [...kit.items, ...((kit.hasDelta && kit.deltaItems) || [])].forEach(item => {
        (item.assignmentIds || []).forEach(aid => {
          const k = String(aid);
          if (!itemsByAssignment.has(k)) itemsByAssignment.set(k, []);
          itemsByAssignment.get(k).push(item);
        });
        (item.orderIds || []).forEach(orderId => {
          const k = String(orderId);
          if (!itemsByAssignment.has(k)) itemsByAssignment.set(k, []);
          itemsByAssignment.get(k).push(item);
        });
        (item.dailyAssignmentIds || []).forEach(dailyAssignmentId => {
          const k = String(dailyAssignmentId);
          if (!itemsByAssignment.has(k)) itemsByAssignment.set(k, []);
          itemsByAssignment.get(k).push(item);
        });
      });
      const KIT_CAT_META = {
        equipment: { icon: 'bi-tools', color: '#2563eb' },
        consumable: { icon: 'bi-droplet', color: '#16a34a' },
        repair_part: { icon: 'bi-gear-wide-connected', color: '#b45309' },
      };
      function kitItemStatusChip(item) {
        const rs = item.resolution && item.resolution.status;
        if (rs === 'not_required') return '<span style="font-size:0.6rem;color:#94a3b8;">Not Required</span>';
        if (rs === 'confirmed_available') return '<span style="font-size:0.6rem;color:#94a3b8;">Alternative In Use</span>';
        if (rs === 'admin_notified') return '<span style="font-size:0.6rem;color:#d97706;">Reported to Admin</span>';
        if (item.checkoutStatus === 'unavailable') return '<span style="font-size:0.6rem;color:#dc2626;font-weight:600;">Unavailable</span>';
        if (['checked_out', 'issued', 'reserved', 'standard_kit', 'in_custody'].includes(item.checkoutStatus)) return '<span style="font-size:0.6rem;color:#059669;">✓ Ready</span>';
        return '';
      }
      window.kitToggleJobItems = function (aid) {
        const el = document.getElementById('kitJobItems_' + aid);
        if (!el) return;
        el.classList.toggle('d-none');
        const chev = document.getElementById('kitJobChev_' + aid);
        if (chev) chev.style.transform = el.classList.contains('d-none') ? '' : 'rotate(180deg)';
      };
      if (jobCount > 0 && data.jobDetails && data.jobDetails.length > 0) {
        jobsListEl.style.display = '';

        // Determine per-job readiness: a job needs attention if any of its required items are unresolved unavailable
        const jobHasIssues = new Map();
        data.jobDetails.forEach(j => jobHasIssues.set(String(j.assignmentId || j.orderId || j.dailyAssignmentId), false));
        unavailable.forEach(item => {
          if (item.resolution?.status) return; // resolved
          (item.assignmentIds || []).forEach(aid => {
            if (jobHasIssues.has(String(aid))) jobHasIssues.set(String(aid), true);
          });
          (item.orderIds || []).forEach(orderId => {
            if (jobHasIssues.has(String(orderId))) jobHasIssues.set(String(orderId), true);
          });
          (item.dailyAssignmentIds || []).forEach(dailyAssignmentId => {
            if (jobHasIssues.has(String(dailyAssignmentId))) jobHasIssues.set(String(dailyAssignmentId), true);
          });
        });

        let jhtml = '';
        let readyCount = 0;
        data.jobDetails.forEach((j, i) => {
          const timeLabel = j.startTime ? j.startTime + ' — ' : '';
          const typeBadge = j.serviceType === 'repair' ? '<span class="badge bg-warning text-dark" style="font-size:0.6rem;padding:2px 5px;">REPAIR</span>' : j.serviceType === 'order_installation' ? '<span class="badge bg-info-subtle text-info-emphasis" style="font-size:0.6rem;padding:2px 5px;">ORDER INSTALL</span>' : j.serviceType === 'project' ? '<span class="badge bg-secondary-subtle text-secondary-emphasis" style="font-size:0.6rem;padding:2px 5px;">PROJECT</span>' : '<span class="badge bg-primary-subtle text-primary" style="font-size:0.6rem;padding:2px 5px;">CORE</span>';
          const hasIssue = jobHasIssues.get(String(j.assignmentId || j.orderId || j.dailyAssignmentId));
          const statusIcon = hasIssue
            ? '<i class="bi bi-exclamation-triangle" style="color:#d97706;font-size:0.72rem;"></i>'
            : '<i class="bi bi-check-circle-fill" style="color:#059669;font-size:0.72rem;"></i>';
          if (!hasIssue) readyCount++;
          const aid = String(j.assignmentId || j.orderId || j.dailyAssignmentId);
          const jItems = itemsByAssignment.get(aid) || [];
          const eqN = jItems.filter(x => x.category === 'equipment').length;
          const coN = jItems.filter(x => x.category === 'consumable').length;
          let breakdown = '';
          if (jItems.length > 0) {
            const order = ['equipment', 'consumable', 'repair_part'];
            breakdown = order.map(cat => {
              const rows = jItems.filter(x => x.category === cat);
              if (!rows.length) return '';
              return '<div style="margin-bottom:5px;"><div style="font-size:0.62rem;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:2px;">' + cat.replace('_', ' ') + '</div>' +
                rows.map(x => {
                  const meta = KIT_CAT_META[cat];
                  return '<div style="display:flex;align-items:center;gap:6px;padding:2px 0;">' +
                    '<i class="bi ' + meta.icon + '" style="font-size:0.68rem;color:' + meta.color + ';"></i>' +
                    '<span style="flex:1;font-size:0.72rem;color:#334155;">' + _esc(x.name) + (x.quantity > 1 ? ' <strong style="color:' + meta.color + ';">×' + x.quantity + '</strong>' : '') + '</span>' +
                    kitItemStatusChip(x) +
                    '</div>';
                }).join('') + '</div>';
            }).join('');
          } else {
            breakdown = '<div style="font-size:0.7rem;color:#94a3b8;">No specific kit requirements generated for this job</div>';
          }
          jhtml += '<div style="border-bottom:1px solid #f1f5f9;">' +
            '<div style="display:flex;align-items:center;gap:8px;padding:5px 0;font-size:0.78rem;cursor:pointer;" onclick="kitToggleJobItems(\'' + aid + '\')" title="Show required tools & consumables">' +
            '<span style="color:#94a3b8;font-size:0.7rem;min-width:16px;">' + (i + 1) + '.</span>' +
            '<span style="flex:1;color:#1e293b;font-weight:500;">' + _esc(j.serviceName) + '</span>' +
            typeBadge +
            (jItems.length > 0 ? '<span style="font-size:0.6rem;color:#2563eb;background:#eff6ff;border-radius:8px;padding:1px 6px;white-space:nowrap;">' + jItems.length + ' item' + (jItems.length > 1 ? 's' : '') + '</span>' : '') +
            statusIcon +
            (timeLabel ? '<span style="font-size:0.68rem;color:#64748b;">' + timeLabel + '</span>' : '') +
            '<i class="bi bi-chevron-down" id="kitJobChev_' + aid + '" style="font-size:0.6rem;color:#94a3b8;transition:transform .15s;"></i>' +
            '</div>' +
            '<div id="kitJobItems_' + aid + '" class="d-none" style="padding:2px 0 8px 24px;background:#f8fafc;border-radius:8px;margin-bottom:4px;">' + breakdown + '</div>' +
            '</div>';
        });
        jhtml += '<div style="font-size:0.68rem;color:#94a3b8;margin-top:6px;">' +
          '<span style="color:#059669;">✓ ' + readyCount + ' Ready</span>' +
          (readyCount < jobCount ? ' · <span style="color:#d97706;">⚠ ' + (jobCount - readyCount) + ' Needs Attention</span>' : '') +
          ' · ' + jobCount + ' Total</div>';
        jobsContentEl.innerHTML = jhtml;
      } else if (jobCount > 0) {
        jobsListEl.style.display = '';
        jobsContentEl.innerHTML = '<div style="font-size:0.78rem;color:#64748b;">' + jobCount + ' assigned job' + (jobCount !== 1 ? 's' : '') + ' for today</div>';
      } else {
        jobsListEl.style.display = 'none';
      }

      // Helper: resolve job names for an item's assignmentIds
      function itemJobNames(item) {
        const names = [];
        (item.assignmentIds || []).forEach(aid => {
          const j = jobByAssignment.get(String(aid));
          if (j) names.push(j.serviceName);
        });
        (item.orderIds || []).forEach(orderId => {
          const j = jobByOrder.get(String(orderId));
          if (j) names.push(j.serviceName);
        });
        (item.dailyAssignmentIds || []).forEach(dailyAssignmentId => {
          const j = jobByDailyAssignment.get(String(dailyAssignmentId));
          if (j) names.push(j.serviceName);
        });
        return [...new Set(names)];
      }

      // Equipment — expandable items showing which jobs require each
      const equipment = kit.items.filter(i => i.category === 'equipment' && i.checkoutStatus !== 'unavailable');
      if (equipment.length > 0) {
        equipSection.style.display = '';
        equipCountEl.textContent = equipment.length + ' item' + (equipment.length !== 1 ? 's' : '');
        let ehtml = '';
        equipment.forEach((item, idx) => {
          const jobNames = itemJobNames(item);
          const jobCount2 = (item.bookingIds || []).length;
          let statusCls, statusText, icon;
          if (item.checkoutStatus === 'checked_out') {
            statusCls = 'border-success'; statusText = 'Checked Out'; icon = 'bi-check-circle-fill';
          } else if (item.checkoutStatus === 'in_custody') {
            statusCls = 'border-success'; statusText = 'Already in Custody'; icon = 'bi-check-circle-fill';
          } else if (item.source === 'standard') {
            statusCls = 'border-info'; statusText = 'Standard Kit'; icon = 'bi-star';
          } else if (item.checkoutStatus === 'unavailable') {
            statusCls = 'border-danger'; statusText = 'Unavailable'; icon = 'bi-exclamation-triangle';
          } else {
            statusCls = 'border-primary'; statusText = 'Available'; icon = 'bi-tools';
          }
          ehtml += '<div class="kit-equip-item" style="border:1px solid ' + (item.checkoutStatus === 'checked_out' ? '#bbf7d0' : '#bfdbfe') + ';border-radius:8px;padding:8px 10px;margin-bottom:6px;background:#fff;cursor:pointer;" onclick="this.querySelector(\'.kit-equip-detail\').classList.toggle(\'d-none\')">' +
            '<div style="display:flex;align-items:center;gap:8px;">' +
            '<i class="bi ' + icon + '" style="font-size:0.85rem;color:' + (item.checkoutStatus === 'checked_out' ? '#16a34a' : '#2563eb') + ';flex-shrink:0;"></i>' +
            '<span style="flex:1;font-weight:600;font-size:0.8rem;">' + _esc(item.name) + (item.quantity > 1 ? ' x' + item.quantity : '') + '</span>' +
            '<span style="font-size:0.65rem;color:' + (item.checkoutStatus === 'checked_out' ? '#16a34a' : '#64748b') + ';">' + statusText + '</span>' +
            '<i class="bi bi-chevron-down kit-expand-icon" style="font-size:0.6rem;color:#94a3b8;"></i>' +
            '</div>' +
            '<div class="kit-equip-detail d-none" style="margin-top:6px;padding-top:6px;border-top:1px solid #f1f5f9;font-size:0.72rem;color:#64748b;">' +
            (jobNames.length ? '<div><strong>Required by:</strong> ' + jobNames.map(n => '<span class="badge bg-light text-dark border" style="font-size:0.65rem;padding:2px 6px;margin:1px;">' + _esc(n) + '</span>').join(' ') + '</div>' : '<div>No specific job requirement</div>') +
            '</div></div>';
        });
        equipListEl.innerHTML = ehtml;
      } else {
        equipSection.style.display = 'none';
      }

      // Consumables — with estimated quantities
      const consumables = kit.items.filter(i => i.category === 'consumable');
      if (consumables.length > 0) {
        consSection.style.display = '';
        consCountEl.textContent = consumables.length + ' item' + (consumables.length !== 1 ? 's' : '');
        let chtml = '';
        consumables.forEach(item => {
          const jobNames = itemJobNames(item);
          const issued = item.quantityIssued || 0;
          const used = item.quantityUsed || 0;
          chtml += '<div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid #f1f5f9;">' +
            '<i class="bi bi-box" style="font-size:0.8rem;color:#16a34a;flex-shrink:0;"></i>' +
            '<span style="flex:1;font-size:0.8rem;">' + _esc(item.name) + ' <strong style="color:#166534;">x' + item.quantity + '</strong></span>' +
            (used > 0 ? '<span style="font-size:0.65rem;color:#64748b;">' + used + ' used</span>' : '') +
            (jobNames.length ? '<span style="font-size:0.65rem;color:#94a3b8;" title="' + jobNames.join(', ') + '">' + jobNames.length + ' job' + (jobNames.length > 1 ? 's' : '') + '</span>' : '') +
            '</div>';
        });
        consListEl.innerHTML = chtml;
      } else {
        consSection.style.display = 'none';
      }

      // Repair parts (Phase 2 approved quotation)
      const repairParts = kit.items.filter(i => i.category === 'repair_part');
      if (repairParts.length > 0) {
        repairSection.style.display = '';
        partsCountEl.textContent = repairParts.length + ' item' + (repairParts.length !== 1 ? 's' : '');
        let rhtml = '';
        repairParts.forEach(item => {
          let icon, statusLabel;
          if (item.checkoutStatus === 'reserved' || item.checkoutStatus === 'issued') {
            icon = 'bi-check-circle'; statusLabel = 'Ready';
          } else if (item.checkoutStatus === 'unavailable') {
            icon = 'bi-exclamation-triangle'; statusLabel = 'Unavailable';
          } else {
            icon = 'bi-box-seam'; statusLabel = 'Reserved';
          }
          rhtml += '<div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid #fef3c7;">' +
            '<i class="bi ' + icon + '" style="font-size:0.8rem;color:#92400e;flex-shrink:0;"></i>' +
            '<span style="flex:1;font-size:0.8rem;">' + _esc(item.name) + ' x' + item.quantity + '</span>' +
            '<span style="font-size:0.65rem;color:#92400e;">' + statusLabel + '</span>' +
            '</div>';
        });
        repairListEl.innerHTML = rhtml;
      } else {
        repairSection.style.display = '';
        partsCountEl.textContent = 'Not included';
        repairListEl.innerHTML = '<div class="small text-muted" style="padding:4px 0;"><i class="bi bi-shield-check me-1"></i>Added only after on-site inspection and an approved, scheduled quotation.</div>';
      }

      // AI Contingency Parts (Optional)
      const unconfirmedAi = aiSuggestions.filter(s => !s.alreadyConfirmed);
      if (aiSection && unconfirmedAi.length > 0) {
        aiSection.style.display = '';
        aiCountEl.textContent = unconfirmedAi.length + ' suggestion' + (unconfirmedAi.length !== 1 ? 's' : '');
        // Group by service name
        const grouped = {};
        unconfirmedAi.forEach(s => {
          if (!grouped[s.serviceName]) grouped[s.serviceName] = [];
          grouped[s.serviceName].push(s);
        });
        let ahtml = '';
        Object.entries(grouped).forEach(([svcName, parts]) => {
          ahtml += '<div style="margin-bottom:8px;">' +
            '<div style="font-size:0.72rem;font-weight:600;color:#4c1d95;margin-bottom:4px;">' + _esc(svcName) + '</div>';
          parts.forEach(p => {
            ahtml += '<label style="display:flex;align-items:center;gap:6px;padding:3px 0;font-size:0.78rem;cursor:pointer;">' +
              '<input type="checkbox" class="form-check-input kit-ai-part" data-name="' + _esc(p.name) + '" data-booking="' + _esc(p.bookingId) + '" style="margin:0;">' +
              '<span>' + _esc(p.name) + '</span>' +
              '</label>';
          });
          ahtml += '</div>';
        });
        ahtml += '<div style="font-size:0.68rem;color:#7c3aed;font-style:italic;">Optional — bring only if already available and practical.</div>';
        aiListEl.innerHTML = ahtml;
      } else if (aiSection) {
        aiSection.style.display = 'none';
      }

      // Unavailable items — with resolution actions
      const unresolvedCount = unavailable.filter(i => !i.resolution?.status).length;
      const issueCountEl = document.getElementById('kitIssueCount');
      if (issueCountEl) issueCountEl.textContent = unavailable.length;
      if (unavailable.length > 0) {
        unavailableSection.style.display = '';
        let uhtml = '';
        unavailable.forEach(item => {
          const jobNames = itemJobNames(item);
          const isNotLinked = item.conflict?.message?.includes('not linked');
          const status = item.resolution?.status;
          const isResolved = status === 'confirmed_available' || status === 'not_required'
                          || status === 'assigned_from_stock' || status === 'procured';
          const isAwaitingAdmin = status === 'admin_notified';
          const resolutionLabel = status === 'confirmed_available' ? '✓ Confirmed Available'
            : status === 'not_required' ? '⊘ Not Required'
            : status === 'admin_notified' ? '⏳ Awaiting Admin Action'
            : status === 'assigned_from_stock' ? '✓ Assigned from Stock'
            : status === 'procured' ? '✓ Procured'
            : status === 'rescheduled' ? '📅 Job Rescheduled'
            : null;
          const cardBorder = isResolved ? '#d1fae5' : isAwaitingAdmin ? '#fef3c7' : '#fecaca';
          const cardBg = isResolved ? '#f0fdf4' : isAwaitingAdmin ? '#fffbeb' : '#fff';
          const iconClass = isResolved ? 'bi-check-circle-fill'
                          : isAwaitingAdmin ? 'bi-hourglass-split'
                          : 'bi-exclamation-triangle';
          const iconColor = isResolved ? '#059669'
                          : isAwaitingAdmin ? '#d97706'
                          : '#dc2626';
          const textColor = isResolved ? '#065f46'
                          : isAwaitingAdmin ? '#92400e'
                          : '#991b1b';
          uhtml += '<div class="kit-issue-card" style="padding:10px;margin-bottom:8px;background:' + cardBg + ';border-radius:8px;border:1px solid ' + cardBorder + ';">' +
            '<div style="display:flex;align-items:center;gap:6px;">' +
            '<i class="bi ' + iconClass + '" style="color:' + iconColor + ';font-size:0.85rem;"></i>' +
            '<strong style="font-size:0.8rem;color:' + textColor + ';">' + _esc(item.name) + '</strong>' +
            '</div>' +
            '<div style="font-size:0.72rem;color:' + textColor + ';margin-top:4px;">' +
            (resolutionLabel || _esc(item.conflict?.message || 'Unavailable')) +
            '</div>' +
            (jobNames.length ? '<div style="font-size:0.68rem;color:#64748b;margin-top:4px;"><i class="bi bi-link-45deg me-1"></i>Required by: ' + jobNames.map(n => '<span class="badge bg-light text-dark border" style="font-size:0.62rem;padding:2px 5px;">' + _esc(n) + '</span>').join(' ') + '</div>' : '') +
            (!isResolved && !isAwaitingAdmin ? '<div style="display:flex;gap:4px;margin-top:8px;flex-wrap:wrap;">' +
              '<button class="btn btn-sm btn-outline-success kit-resolve-btn" data-action="confirmed_available" data-name="' + _esc(item.name) + '" style="font-size:0.68rem;padding:3px 8px;"><i class="bi bi-check-lg me-1"></i>Confirm I Have This</button>' +
              '<button class="btn btn-sm btn-outline-primary kit-notify-admin-btn" data-name="' + _esc(item.name) + '" style="font-size:0.68rem;padding:3px 8px;"><i class="bi bi-bell me-1"></i>Notify Admin</button>' +
              '<button class="btn btn-sm btn-outline-secondary kit-resolve-btn" data-action="not_required" data-name="' + _esc(item.name) + '" style="font-size:0.68rem;padding:3px 8px;"><i class="bi bi-x-lg me-1"></i>Not Required</button>' +
            '</div>' : '') +
            (isAwaitingAdmin ? '<div style="margin-top:8px;"><span class="badge" style="background:#fef3c7;color:#92400e;border:1px solid #fcd34d;font-size:0.65rem;"><i class="bi bi-hourglass-split me-1"></i>Admin has been notified — waiting for resolution</span></div>' : '') +
            '</div>';
        });
        unavailableListEl.innerHTML = uhtml;
      } else {
        unavailableSection.style.display = 'none';
      }

      // Delta items — field-level decision cards for late-accepted bookings.
      // Every undecided item blocks En Route until resolved or checked out
      // via "Prepare Additional Items".
      if (kit.hasDelta && kit.deltaItems && kit.deltaItems.length > 0) {
        deltaSection.style.display = '';
        const DECISION_LABELS = {
          not_required: 'NOT REQUIRED — Technician Confirmed',
          confirmed_available: 'ALTERNATIVE IN USE',
          admin_notified: 'REPORTED — waiting for admin',
        };
        let dhtml = '<div style="font-weight:600;font-size:0.75rem;color:#92400e;margin-bottom:6px;">New requirements from newly accepted booking(s):</div>';
        kit.deltaItems.forEach(item => {
          const decided = item.resolution && item.resolution.status;
          const catIcon = item.category === 'equipment' ? 'bi-tools' : item.category === 'repair_part' ? 'bi-gear' : 'bi-droplet';
          dhtml += '<div class="kit-issue-card" style="padding:10px;margin-bottom:8px;background:#fffbeb;border-radius:8px;border:1px solid #fde68a;">';
          if (!decided) {
            dhtml += '<div style="display:flex;align-items:center;gap:6px;">' +
              '<i class="bi ' + catIcon + '" style="color:#b45309;font-size:0.85rem;"></i>' +
              '<strong style="font-size:0.8rem;color:#92400e;">' + _esc(item.name) + ' ×' + _esc(item.quantity || 1) + '</strong>' +
              '</div>';
            if (item.conflict?.message) {
              dhtml += '<div style="font-size:0.72rem;color:#b45309;margin-top:3px;"><i class="bi bi-exclamation-triangle me-1"></i>' + _esc(item.conflict.message) + '</div>';
            }
            dhtml += '<div style="font-size:0.68rem;color:#78716c;margin-top:4px;">Decide how to handle this before going En Route:</div>';
            dhtml += '<div style="display:flex;gap:4px;margin-top:8px;flex-wrap:wrap;">' +
              '<button class="btn btn-sm btn-success kit-delta-add" data-name="' + _esc(item.name) + '" data-category="' + _esc(item.category || '') + '" style="font-size:0.68rem;padding:3px 8px;"><i class="bi bi-plus-circle me-1"></i>Add to Kit</button>' +
              '<button class="btn btn-sm btn-outline-secondary kit-delta-resolve" data-action="not_required" data-name="' + _esc(item.name) + '" data-category="' + _esc(item.category || '') + '" style="font-size:0.68rem;padding:3px 8px;"><i class="bi bi-x-lg me-1"></i>Not Needed</button>' +
              '<button class="btn btn-sm btn-outline-primary kit-delta-resolve" data-action="confirmed_available" data-name="' + _esc(item.name) + '" data-category="' + _esc(item.category || '') + '" style="font-size:0.68rem;padding:3px 8px;"><i class="bi bi-arrow-repeat me-1"></i>Use Alternative</button>' +
              '<button class="btn btn-sm btn-outline-warning kit-delta-report" data-name="' + _esc(item.name) + '" style="font-size:0.68rem;padding:3px 8px;"><i class="bi bi-bell me-1"></i>Report Issue</button>' +
              '</div>';
            dhtml += '<div style="font-size:0.65rem;color:#a8a29e;margin-top:6px;"><i class="bi bi-info-circle me-1"></i>"Add to Kit" items will be issued when you press Prepare Additional Items.</div>';
          } else {
            const lbl = DECISION_LABELS[item.resolution.status] || item.resolution.status;
            const ok = item.resolution.status !== 'admin_notified';
            dhtml += '<div style="display:flex;align-items:center;gap:6px;">' +
              '<i class="bi ' + (ok ? 'bi-check-circle-fill' : 'bi-hourglass-split') + '" style="color:' + (ok ? '#059669' : '#d97706') + ';font-size:0.85rem;"></i>' +
              '<strong style="font-size:0.8rem;color:' + (ok ? '#166534' : '#92400e') + ';">' + _esc(item.name) + '</strong>' +
              '</div>' +
              '<div style="font-size:0.72rem;color:#64748b;margin-top:3px;">' + _esc(lbl) + (item.resolution.resolutionNote ? ' · ' + _esc(item.resolution.resolutionNote) : '') + '</div>';
          }
          dhtml += '</div>';
        });
        document.getElementById('kitDeltaList').innerHTML = dhtml;
      } else {
        deltaSection.style.display = 'none';
      }

      // Preparation Summary
      if (summarySection) {
        const totalEquip = equipment.length;
        const totalCons = consumables.length;
        const totalRepair = repairParts.length;
        const totalAi = unconfirmedAi.length;
        const totalIssues = unavailable.length;
        summarySection.style.display = '';
        let shtml = '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px;">';
        shtml += '<div style="text-align:center;padding:8px;background:#eff6ff;border-radius:8px;"><div style="font-size:1.1rem;font-weight:700;color:#1e40af;">' + totalEquip + '</div><div style="font-size:0.68rem;color:#1e40af;">Equipment</div></div>';
        shtml += '<div style="text-align:center;padding:8px;background:#f0fdf4;border-radius:8px;"><div style="font-size:1.1rem;font-weight:700;color:#166534;">' + totalCons + '</div><div style="font-size:0.68rem;color:#166534;">Consumables</div></div>';
        if (totalRepair > 0) shtml += '<div style="text-align:center;padding:8px;background:#fefce8;border-radius:8px;"><div style="font-size:1.1rem;font-weight:700;color:#92400e;">' + totalRepair + '</div><div style="font-size:0.68rem;color:#92400e;">Repair Parts</div></div>';
        if (totalAi > 0) shtml += '<div style="text-align:center;padding:8px;background:#f5f3ff;border-radius:8px;"><div style="font-size:1.1rem;font-weight:700;color:#7c3aed;">' + totalAi + '</div><div style="font-size:0.68rem;color:#7c3aed;">AI Suggestions</div></div>';
        if (totalIssues > 0) shtml += '<div style="text-align:center;padding:8px;background:#fef2f2;border-radius:8px;"><div style="font-size:1.1rem;font-weight:700;color:#dc2626;">' + totalIssues + '</div><div style="font-size:0.68rem;color:#dc2626;">Issues</div></div>';
        shtml += '</div>';
        summaryContent.innerHTML = shtml;
      }

      // Confirm button — only blocked by truly unresolved unavailable items
      if (kit.status === 'draft' || (kit.hasDelta && kit.deltaItems && kit.deltaItems.length)) {
        confirmBtn.style.display = '';
        const unavailableDeltas = ((kit.hasDelta && kit.deltaItems) || []).filter(i => i.checkoutStatus === 'unavailable' && !i.resolution?.status && !(i.exception && i.exception.approved));
        const unresolvedItems = unavailable.filter(i => !i.resolution?.status).concat(unavailableDeltas);
        confirmBtn.disabled = unresolvedItems.length > 0;
        if (unresolvedItems.length > 0) {
          confirmBtn.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Resolve ' + unresolvedItems.length + ' Issue' + (unresolvedItems.length > 1 ? 's' : '');
        } else {
          confirmBtn.innerHTML = kit.hasDelta
            ? '<i class="bi bi-plus-circle me-1"></i>Prepare Additional Items'
            : '<i class="bi bi-check2-circle me-1"></i>Confirm Daily Preparation';
        }
      } else {
        confirmBtn.style.display = 'none';
      }

      // Store kit data for add-item
      window._currentKit = kit;

    } catch (err) {
      console.error('Daily kit load error:', err);
      jobSummaryEl.innerHTML = '<span class="text-danger">Failed to load kit</span>';
    }
  }

  window.dailyKitConfirm = async function() {
    const btn = document.getElementById('kitConfirmBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Confirming...';
    try {
      const resp = await fetch('/api/technician/daily-kit/confirm', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(window._dailyKitRequestedDate ? { date: window._dailyKitRequestedDate } : {}),
      });
      const data = await resp.json();
      if (resp.ok) {
        // Update global status immediately so detail panel shows En Route button
        window._dailyKitStatus = 'confirmed';
        (window._showNotification || showNotification)({ type: 'success', title: 'Daily Preparation Confirmed', message: 'Equipment checked out and consumables issued for all of today\'s jobs. You\'re ready to go En Route!', duration: 5000 });
        loadDailyKit();
        loadPreparation();
        if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) showDetail(window._currentDetailId);
      } else {
        (window._showNotification || showNotification)({ type: 'error', title: 'Confirmation Failed', message: data.error || 'Failed to confirm daily preparation', duration: 5000 });
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Confirm Daily Preparation';
      }
    } catch (err) {
      (window._showNotification || showNotification)({ type: 'error', title: 'Confirmation Failed', message: 'Failed to confirm daily preparation', duration: 5000 });
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Confirm Daily Preparation';
    }
  };

  // ── Daily Kit: Inventory Search Dropdown ────────────────────────────────
  window._selectedKitItem = null;
  let _kitSearchTimeout = null;

  const kitSearchInput = document.getElementById('kitInventorySearch');
  const kitSearchResults = document.getElementById('kitInventoryResults');
  const kitAddBtn = document.getElementById('kitAddItemBtn');
  const kitSelectedItemEl = document.getElementById('kitSelectedItem');

  if (kitSearchInput) {
    kitSearchInput.addEventListener('input', function() {
      clearTimeout(_kitSearchTimeout);
      const q = this.value.trim();
      if (q.length < 2) { kitSearchResults.style.display = 'none'; kitSearchResults.innerHTML = ''; return; }
      _kitSearchTimeout = setTimeout(async () => {
        try {
          const resp = await fetch('/api/technician/daily-kit/inventory-search?q=' + encodeURIComponent(q), { credentials: 'same-origin' });
          if (!resp.ok) return;
          const data = await resp.json();
          const items = data.items || [];
          if (items.length === 0) {
            kitSearchResults.innerHTML = '<div style="padding:8px 12px;font-size:0.78rem;color:#64748b;">No results found</div>';
            kitSearchResults.style.display = '';
            return;
          }
          let html = '';
          items.forEach(item => {
            const typeIcon = item.type === 'equipment' ? 'bi-tools' : item.type === 'consumable' ? 'bi-box' : item.type === 'part' ? 'bi-box-seam' : 'bi-gear';
            const typeCls = item.type === 'equipment' ? 'text-primary' : item.type === 'consumable' ? 'text-success' : item.type === 'part' ? 'text-warning' : 'text-secondary';
            html += '<div class="kit-inv-result" data-id="' + item._id + '" data-name="' + (item.name || item.itemName) + '" data-type="' + item.type + '" style="padding:8px 12px;cursor:pointer;display:flex;align-items:center;gap:8px;border-bottom:1px solid #f1f5f9;font-size:0.78rem;">' +
              '<i class="bi ' + typeIcon + ' ' + typeCls + '" style="font-size:0.8rem;"></i>' +
              '<span style="flex:1;">' + (item.name || item.itemName) + '</span>' +
              '<span style="font-size:0.65rem;color:#94a3b8;">' + item.type + '</span>' +
              '</div>';
          });
          kitSearchResults.innerHTML = html;
          kitSearchResults.style.display = '';
          // Bind click handlers
          kitSearchResults.querySelectorAll('.kit-inv-result').forEach(el => {
            el.addEventListener('click', function() {
              window._selectedKitItem = { _id: this.dataset.id, name: this.dataset.name, type: this.dataset.type };
              kitSearchInput.value = this.dataset.name;
              kitSearchResults.style.display = 'none';
              kitAddBtn.disabled = false;
              kitSelectedItemEl.classList.remove('d-none');
              kitSelectedItemEl.innerHTML = '<span class="badge bg-primary-subtle text-primary border border-primary" style="font-size:0.73rem;padding:4px 8px;"><i class="bi bi-check2 me-1"></i>' + this.dataset.name.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</span>';
            });
          });
        } catch (err) {
          console.error('Inventory search error:', err);
        }
      }, 300);
    });
    // Close on click outside
    document.addEventListener('click', function(e) {
      if (!e.target.closest('#kitInventorySearch') && !e.target.closest('#kitInventoryResults')) {
        kitSearchResults.style.display = 'none';
      }
    });
  }

  window.dailyKitAddSelected = async function() {
    if (!window._selectedKitItem) return;
    const qtyInput = document.getElementById('kitNewItemQty');
    const qty = Number(qtyInput.value) || 1;
    const category = window._selectedKitItem.type === 'part' ? 'repair_part' : (window._selectedKitItem.type || 'consumable');
    try {
      const resp = await fetch('/api/technician/daily-kit/add-item', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ name: window._selectedKitItem.name, inventoryItemId: window._selectedKitItem._id, category, quantity: qty }),
      });
      if (resp.ok) {
        window._selectedKitItem = null;
        kitSearchInput.value = '';
        qtyInput.value = '1';
        kitAddBtn.disabled = true;
        kitSelectedItemEl.classList.add('d-none');
        loadDailyKit();
      }
    } catch (err) {
      console.error('Add item error:', err);
    }
  };

  window.dailyKitNotifyAdmin = async function() {
    try {
      const resp = await fetch('/api/technician/daily-kit/notify-admin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin' });
      if (resp.ok) {
        (window._showNotification || showNotification)({ type: 'success', title: 'Notified', message: 'Admin has been notified about unavailable items.', duration: 3000 });
      }
    } catch (err) {
      console.error('Notify admin error:', err);
    }
  };

  window.dailyKitResolveItem = async function(itemName, resolution) {
    try {
      const resp = await fetch('/api/technician/daily-kit/resolve-item', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ itemName, resolution }),
      });
      if (resp.ok) {
        const label = resolution === 'confirmed_available' ? 'Confirmed Available' : 'Marked Not Required';
        if (window._showNotification) window._showNotification({ type: 'success', title: label, message: itemName + ' has been resolved.', duration: 3000 });
        loadDailyKit();
      } else {
        const data = await resp.json();
        if (window._showNotification) window._showNotification({ type: 'error', title: 'Failed', message: data.error || 'Could not resolve item', duration: 4000 });
      }
    } catch (err) {
      console.error('Resolve item error:', err);
    }
  };

  window.dailyKitNotifyAdminItem = async function(itemName) {
    try {
      const resp = await fetch('/api/technician/daily-kit/notify-admin-item', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ itemName }),
      });
      if (resp.ok) {
        if (window._showNotification) window._showNotification({ type: 'success', title: 'Admin Notified', message: 'Admin has been notified about "' + itemName + '".', duration: 3000 });
        loadDailyKit();
      }
    } catch (err) {
      console.error('Notify admin item error:', err);
    }
  };

  // ── Delta item field decisions (late-accepted bookings) ──────────────────
  const KIT_NOT_NEEDED_REASONS = [
    { code: 'existing_equipment_sufficient', label: 'Existing equipment can perform the task' },
    { code: 'job_condition_not_required', label: 'Job condition does not require it' },
    { code: 'alternative_approved_material', label: 'Alternative approved tool/material available' },
    { code: 'recommendation_not_applicable', label: 'Recommendation is not applicable' },
    { code: 'other', label: 'Other (explain below)' },
  ];

  window.kitDeltaHighlightConfirm = function() {
    const btn = document.getElementById('kitConfirmBtn');
    if (btn && btn.style.display !== 'none') {
      btn.scrollIntoView({ behavior: 'smooth', block: 'center' });
      btn.style.transition = 'box-shadow 0.3s';
      btn.style.boxShadow = '0 0 0 3px rgba(16,185,129,0.5)';
      setTimeout(() => { if (btn) btn.style.boxShadow = ''; }, 1600);
    }
    if (window._showNotification) window._showNotification({ type: 'info', title: 'Added to Kit List', message: 'Press "Prepare Additional Items" to check it out.', duration: 4000 });
  };

  window.kitDeltaDecision = async function(itemName, category, action) {
    if (action === 'not_required') {
      const result = await Swal.fire({
        title: 'Not Needed for This Job',
        html: '<div class="text-start"><p class="small text-muted mb-2">Why is <strong>' + String(itemName).replace(/</g,'&lt;') + '</strong> not needed?</p>' +
          KIT_NOT_NEEDED_REASONS.map((r, idx) =>
            '<div class="form-check mb-1"><input class="form-check-input" type="radio" name="kitNnReason" id="knnr_' + idx + '" value="' + r.code + '"' + (idx === 0 ? ' checked' : '') + '><label class="form-check-label small" for="knnr_' + idx + '">' + r.label + '</label></div>'
          ).join('') +
          '<textarea id="kitNnNote" class="form-control form-control-sm mt-2" rows="2" placeholder="Details (required for Other)"></textarea></div>',
        showCancelButton: true,
        confirmButtonText: 'Confirm Decision',
        confirmButtonColor: '#2563eb',
        preConfirm: () => {
          const reasonCode = (document.querySelector('input[name="kitNnReason"]:checked') || {}).value;
          const note = (document.getElementById('kitNnNote').value || '').trim();
          if (reasonCode === 'other' && !note) { Swal.showValidationMessage('Please explain why this item is not needed.'); return false; }
          return { reasonCode, note };
        },
      });
      if (!result.isConfirmed) return;
      await kitDeltaPostResolve({ itemName, category, resolution: 'not_required', reasonCode: result.value.reasonCode, note: result.value.note });
    } else if (action === 'confirmed_available') {
      const result = await Swal.fire({
        title: 'Use Available Alternative',
        input: 'textarea',
        inputPlaceholder: 'What will you use instead? (e.g., personal digital multimeter)',
        showCancelButton: true,
        confirmButtonText: 'Record Alternative',
        confirmButtonColor: '#2563eb',
        preConfirm: (value) => {
          if (!value || !value.trim()) { Swal.showValidationMessage('Please describe the alternative you will use.'); return false; }
          return value.trim();
        },
      });
      if (!result.isConfirmed) return;
      await kitDeltaPostResolve({ itemName, category, resolution: 'confirmed_available', source: 'alternative_available', note: result.value });
    }
  };

  async function kitDeltaPostResolve(payload) {
    try {
      const resp = await fetch('/api/technician/daily-kit/resolve-item', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(payload),
      });
      const data = await resp.json().catch(() => ({}));
      if (resp.ok) {
        const label = payload.resolution === 'not_required' ? 'Marked Not Required' : 'Alternative Recorded';
        if (window._showNotification) window._showNotification({ type: 'success', title: label, message: data.item?.name || payload.itemName + ' — decision saved.', duration: 3000 });
        loadDailyKit();
      } else {
        if (window._showNotification) window._showNotification({ type: 'error', title: 'Failed', message: data.error || 'Could not save your decision.', duration: 4000 });
      }
    } catch (err) {
      console.error('Kit delta resolve error:', err);
    }
  }

  window.briefingBatchCheckout = async function() {
    const btn = document.getElementById('briefingBatchCheckout');
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Checking out...'; }
    try {
      const dateInput = document.getElementById('briefingDate');
      const url = '/api/technician/assignments/preparation/next-jobs' + (dateInput.value ? '?date=' + encodeURIComponent(dateInput.value) : '');
      const resp = await fetch(url, { credentials: 'same-origin' });
      if (!resp.ok) throw new Error('Failed to fetch');
      const data = await resp.json();
      const needCheckout = (data.jobs || []).filter(j => j.preparationStatus === 'ready_for_checkout' || j.preparationStatus === 'reserved');
      if (needCheckout.length === 0) { (window._showNotification || showNotification)({ type: 'success', title: 'Briefing', message: 'All resources already checked out.', duration: 3000 }); return; }
      const checkoutResp = await fetch('/api/technician/assignments/checkout-batch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ assignmentIds: needCheckout.map(j => j.assignmentId) }),
      });
      const result = await checkoutResp.json();
      if (checkoutResp.ok && result.success) {
        (window._showNotification || showNotification)({ type: 'success', title: 'Batch Checkout', message: 'Resources checked out for ' + result.results.length + ' job(s)!', duration: 4000 });
        loadJobBriefing(dateInput.value);
        loadPreparation(dateInput.value);
      } else {
        (window._showNotification || showNotification)({ type: 'error', title: 'Briefing', message: result.error || 'Checkout failed.', duration: 5000 });
      }
    } catch (err) {
      (window._showNotification || showNotification)({ type: 'error', title: 'Briefing', message: 'Checkout failed.', duration: 5000 });
    } finally {
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i>Check Out All Resources'; }
    }
  };
</script>

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.5/main.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@fullcalendar/daygrid@5.11.5/main.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@fullcalendar/timegrid@5.11.5/main.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@fullcalendar/list@5.11.5/main.global.min.js"></script>
<script>
  // ═══════════════════════════════════════════════════════════════════════════
  // VIEW TOGGLE, CALENDAR, KPIs — Enterprise Unified Page
  // ═══════════════════════════════════════════════════════════════════════════
  (function () {
    "use strict";

    const h = window.techHelpers || window.techHelpers;
    let calendarInstance = null;
    let currentView = 'cards';
    let calendarPage = 1;
    const CALENDAR_PAGE_SIZE = 5;
    let calendarTotalPages = 1;
    let allCalendarItems = [];

    // ── View Toggle (Enterprise Segmented Control) ──
    const toggleBtns = document.querySelectorAll('#viewToggle .mw-view-btn');
    const cardsContainer = document.getElementById('assignmentsContainer');
    const calendarContainer = document.getElementById('calendarViewContainer');
    const sbHero = document.getElementById('sbHero');
    const assignTabs = document.getElementById('assignTabs');
    const mwModeSwitch = document.getElementById('mwModeSwitch');

    toggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.view;
        if (view === currentView) return;
        currentView = view;
        toggleBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        if (view === 'calendar') {
          cardsContainer.style.display = 'none';
          calendarContainer.style.display = 'block';
          if (sbHero) sbHero.style.display = 'none';
          if (assignTabs) assignTabs.style.display = 'none';
          if (mwModeSwitch) mwModeSwitch.style.display = 'none';
          loadCalendarPage(1);
        } else {
          cardsContainer.style.display = 'block';
          calendarContainer.style.display = 'none';
          if (sbHero) sbHero.style.display = 'block';
          if (assignTabs) assignTabs.style.display = 'block';
          if (mwModeSwitch) mwModeSwitch.style.display = 'block';
        }
      });
    });

    // ── Live Clock (Enterprise Hero) ──
    function tick() {
      const el = document.getElementById('currentDateTime');
      if (el) {
        const span = el.querySelector('span');
        if (span) {
          span.textContent = new Date().toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        }
      }
    }
    tick(); setInterval(tick, 30000);

    // ── Hero Stats (Animated Counters) ──
    function animateHeroStat(id, target) {
      const el = document.getElementById(id);
      if (!el) return;
      const current = parseInt(el.textContent) || 0;
      if (current === target) return;
      const diff = target - current;
      const steps = Math.min(Math.abs(diff), 15);
      const inc = diff / steps;
      let step = 0;
      const timer = setInterval(() => {
        step++;
        const val = step >= steps ? target : Math.round(current + inc * step);
        el.textContent = val;
        if (step >= steps) clearInterval(timer);
      }, 40);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // KPI — Fetches from dedicated backend endpoint (enterprise-grade)
    // ═══════════════════════════════════════════════════════════════════════════
    let kpiLoading = false;

    function setKpiText(id, v) {
      const el = document.getElementById(id);
      if (el) el.textContent = v;
    }

    function animateKpiValue(el, target, prefix) {
      if (!el) return;
      prefix = prefix || '';
      const current = parseInt(el.textContent.replace(/[^0-9]/g, '')) || 0;
      if (current === target) { el.textContent = prefix + target.toLocaleString(); return; }
      const diff = target - current;
      const steps = Math.min(Math.abs(diff), 20);
      const inc = diff / steps;
      let step = 0;
      const timer = setInterval(() => {
        step++;
        const val = step >= steps ? target : Math.round(current + inc * step);
        el.textContent = prefix + val.toLocaleString();
        if (step >= steps) clearInterval(timer);
      }, 30);
    }

    async function updateKpis() {
      if (kpiLoading) return;
      kpiLoading = true;

      // Show loading shimmer
      ['kpiTotal', 'kpiCompleted', 'kpiPending', 'kpiToday', 'kpiRevenue', 'kpiPartsCost', 'kpiExpenses', 'kpiGrossProfit', 'kpiNetProfit', 'kpiCompletionRate'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.opacity = '0.4';
      });

      try {
        const res = await fetch('/api/technician/kpis', { credentials: 'same-origin' });
        if (!res.ok) throw new Error('KPI fetch failed');
        const kpi = await res.json();

        // Animate values with smooth transitions
        ['kpiTotal', 'kpiCompleted', 'kpiPending', 'kpiToday', 'kpiRevenue', 'kpiCompletionRate'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.style.opacity = '1';
        });

        animateKpiValue(document.getElementById('kpiTotal'), kpi.total, '');
        animateKpiValue(document.getElementById('kpiCompleted'), kpi.completed, '');
        animateKpiValue(document.getElementById('kpiPending'), kpi.pending, '');
        animateKpiValue(document.getElementById('kpiToday'), kpi.today, '');
        animateKpiValue(document.getElementById('kpiRevenue'), kpi.revenue, '\u20B1');
        animateKpiValue(document.getElementById('kpiPartsCost'), kpi.partsCost || 0, '\u20B1');
        animateKpiValue(document.getElementById('kpiExpenses'), kpi.expenses || 0, '\u20B1');
        animateKpiValue(document.getElementById('kpiGrossProfit'), kpi.grossProfit || 0, '\u20B1');
        animateKpiValue(document.getElementById('kpiNetProfit'), kpi.netProfit || 0, '\u20B1');
        setKpiText('kpiCompletionRate', kpi.completionRate + '%');

        // Update hero stats with animated counters
        animateHeroStat('heroActive', kpi.active || 0);
        animateHeroStat('heroPending', kpi.pending || 0);
        animateHeroStat('heroToday', kpi.today || 0);
        // Update Today button badge
        if (window._updateTodayBadge) window._updateTodayBadge(kpi.today || 0);
        // Hero uses bottom-line profit after parts COGS and operating expenses.
        const heroProfit = document.getElementById('heroProfit');
        if (heroProfit) {
          const gp = kpi.netProfit || 0;
          const absVal = Math.abs(gp);
          const formatted = absVal >= 1000 ? (absVal / 1000).toFixed(1) + 'K' : absVal.toLocaleString();
          heroProfit.textContent = gp >= 0 ? '\u20B1' + formatted : '-\u20B1' + formatted;
          heroProfit.style.color = gp >= 0 ? '#10b981' : '#ef4444';
        }

        // Update tab badges with real counts (auto-hide when 0)
        const setBadge = (id, v) => {
          const el = document.getElementById(id);
          if (el) {
            el.textContent = v;
            el.style.display = v > 0 ? '' : 'none';
          }
        };
        setBadge('countAll', kpi.total);
        setBadge('countPending', kpi.pending);
        setBadge('countActive', kpi.active);
        setBadge('countToday', kpi.today);
        setBadge('countCompleted', kpi.completed);
        setBadge('countDeclined', kpi.declined);
        setBadge('countCancelled', kpi.cancelled);
        setBadge('countAvailable', kpi.available);

        // Render sparklines
        if (h && h.renderSparkline) {
          h.renderSparkline('spark_kpiTotal', [kpi.total, kpi.total + 2, kpi.total + 1, kpi.total + 3, kpi.total], '#3b82f6');
          h.renderSparkline('spark_kpiCompleted', [kpi.completed, kpi.completed + 1, kpi.completed, kpi.completed + 2, kpi.completed], '#10b981');
          h.renderSparkline('spark_kpiPending', [kpi.pending, Math.max(0, kpi.pending - 1), kpi.pending, Math.max(0, kpi.pending - 1), kpi.pending], '#f59e0b');
          h.renderSparkline('spark_kpiToday', [kpi.today, kpi.today + 1, kpi.today, kpi.today + 1, kpi.today], '#ef4444');
          h.renderSparkline('spark_kpiRevenue', [kpi.revenue * 0.8, kpi.revenue * 0.9, kpi.revenue, kpi.revenue * 0.95, kpi.revenue], '#0891b2');
          h.renderSparkline('spark_kpiPartsCost', [kpi.partsCost * 0.8, kpi.partsCost * 0.9, kpi.partsCost, kpi.partsCost * 0.95, kpi.partsCost], '#ef4444');
          h.renderSparkline('spark_kpiExpenses', [kpi.expenses * 0.8, kpi.expenses * 0.9, kpi.expenses, kpi.expenses * 0.95, kpi.expenses], '#8b5cf6');
          h.renderSparkline('spark_kpiGrossProfit', [kpi.grossProfit * 0.8, kpi.grossProfit * 0.9, kpi.grossProfit, kpi.grossProfit * 0.95, kpi.grossProfit], '#10b981');
          h.renderSparkline('spark_kpiNetProfit', [kpi.netProfit * 0.8, kpi.netProfit * 0.9, kpi.netProfit, kpi.netProfit * 0.95, kpi.netProfit], '#2563eb');
          h.renderSparkline('spark_kpiCompletionRate', [kpi.completionRate, Math.min(100, kpi.completionRate + 5), kpi.completionRate, Math.min(100, kpi.completionRate + 3), kpi.completionRate], '#8b5cf6');
        }
      } catch (e) {
        console.warn('[KPI] Failed to load KPIs:', e);
        // Fallback: compute from client-side data
        const items = window._allAssignments || [];
        if (items.length) {
          const total = items.length;
          let completed = 0, pending = 0, today = 0, revenue = 0;
          const todayStr = new Date().toDateString();
          items.forEach(a => {
            const st = (a.status || '').toLowerCase();
            if (st === 'completed') {
              completed++;
              // Use computedRevenue if available, else compute correctly
              if (a.computedRevenue) {
                revenue += a.computedRevenue;
              } else {
                const isRepair = a.serviceType === 'repair' || (a.services && Array.isArray(a.services) && a.services.some(s => s.type === 'repair'));
                if (isRepair) {
                  const inspFee = a.bookingInspectionFeeCollected || a.bookingInitialCost || a.initialCost || 0;
                  const quotTotal = a.bookingQuotationTotal || 0;
                  revenue += inspFee + quotTotal;
                } else {
                  revenue += (a.bookingTotalPrice || a.totalPrice || a.estimatedFee || 0);
                }
              }
            }
            else if (st === 'pending_acceptance') pending++;
            const d = new Date(a.bookingDate || 0);
            if (d.toDateString() === todayStr) today++;
          });
          setKpiText('kpiTotal', total);
          setKpiText('kpiCompleted', completed);
          setKpiText('kpiPending', pending);
          setKpiText('kpiToday', today);
          setKpiText('kpiRevenue', '\u20B1' + revenue.toLocaleString(undefined, { maximumFractionDigits: 0 }));
          setKpiText('kpiCompletionRate', total > 0 ? Math.round((completed / total) * 100) + '%' : '0%');
        }
        ['kpiTotal', 'kpiCompleted', 'kpiPending', 'kpiToday', 'kpiRevenue', 'kpiPartsCost', 'kpiExpenses', 'kpiGrossProfit', 'kpiNetProfit', 'kpiCompletionRate'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.style.opacity = '1';
        });
      }
      kpiLoading = false;
    }

    // Expose for the main loader to call after data arrives
    window._updateWorkKpis = updateKpis;

    // ═══════════════════════════════════════════════════════════════════════════
    // CALENDAR — Server-side paginated with "Show More" button
    // ═══════════════════════════════════════════════════════════════════════════
    function parseMinuteValue(value) {
      if (value == null) return NaN;
      const raw = String(value).trim();
      if (!raw) return NaN;
      if (/^\d{1,4}$/.test(raw)) return Number(raw);
      const hm = raw.match(/^(\d{1,2}):(\d{2})$/);
      if (hm) return Number(hm[1]) * 60 + Number(hm[2]);
      const apm = raw.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
      if (apm) { let hh = Number(apm[1]) % 12; if (apm[3].toUpperCase() === 'PM') hh += 12; return hh * 60 + Number(apm[2]); }
      return NaN;
    }

    function toCalendarEvent(a) {
      const startMin = parseMinuteValue(a.startTime);
      const hasTime = Number.isFinite(startMin);
      const day = new Date(a.bookingDate || Date.now());
      const yyyy = day.getFullYear(), mo = String(day.getMonth() + 1).padStart(2, '0'), dd = String(day.getDate()).padStart(2, '0');
      const dateOnly = yyyy + '-' + mo + '-' + dd;
      let startStr = dateOnly, endStr = null;
      if (hasTime) {
        const sH = String(Math.floor(startMin / 60)).padStart(2, '0'), sM = String(startMin % 60).padStart(2, '0');
        startStr = dateOnly + 'T' + sH + ':' + sM + ':00';
        const fallEnd = startMin + 60;
        endStr = dateOnly + 'T' + String(Math.floor(fallEnd / 60)).padStart(2, '0') + ':' + String(fallEnd % 60).padStart(2, '0') + ':00';
      }
      const status = (a.status || '').toLowerCase();
      const STATUS_COLORS = { confirmed: '#22c55e', scheduled: '#22c55e', pending: '#f59e0b', completed: '#0ea5e9', cancelled: '#ef4444', 're-scheduled': '#6366f1', 'on-the-way': '#f59e0b', 'in-progress': '#f59e0b', arrived: '#22c55e', en_route: '#0ea5e9', on_site: '#22c55e', pending_acceptance: '#f59e0b', accepted: '#3b82f6' };
      const color = STATUS_COLORS[status] || '#64748b';
      const ev = { id: String(a._id || ''), title: (a.serviceName || 'Service') + ' - ' + (a.customerName || 'Customer'), start: startStr, allDay: !hasTime, backgroundColor: color, borderColor: color, extendedProps: { raw: a } };
      if (endStr) ev.end = endStr;
      return ev;
    }

    async function loadCalendarPage() {
      if (calendarInstance) {
        calendarInstance.render();
        setTimeout(() => calendarInstance.updateSize(), 0);
        return;
      }
      const calendarEl = document.getElementById('techCalendar');
      if (!calendarEl) return;
      calendarInstance = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        headerToolbar: {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
        },
        buttonText: { today: 'Today', month: 'Month', week: 'Week', day: 'Day', list: 'List' },
        buttonIcons: false,
        titleFormat: { year: 'numeric', month: 'long' },
        eventTimeFormat: { hour: 'numeric', minute: '2-digit', meridiem: 'short' },
        slotLabelFormat: { hour: 'numeric', meridiem: 'short' },
        height: 700,
        dayMaxEvents: 4,
        moreLinkClassNames: 'cal-more-link-btn',
        moreLinkContent: function (args) {
          const total = args.num;
          return { html: `<div class="cal-more-pill"><i class="bi bi-briefcase-fill" style="margin-right:4px;"></i>+${total} more</div>` };
        },
        moreLinkClick: function (info) {
          const dateStr = info.date.toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
          const dayEvents = info.allSegs
            .filter(seg => seg.event.display !== 'background' && seg.event.id)
            .map(seg => seg.event);
          openCalSlide(dateStr, dayEvents);
          return 'stop';
        },
        dayCellContent: function (args) {
          return { html: `<span class="fc-daygrid-day-number">${args.date.getDate()}</span>` };
        },
        dayCellDidMount: function (arg) {
          // Allow clicking on day cells to show all events for that day
          arg.el.style.cursor = 'pointer';
          arg.el.addEventListener('click', function (e) {
            // Don't trigger if clicking an event or more link
            if (e.target.closest('.fc-event') || e.target.closest('.cal-more-pill') || e.target.closest('.fc-daygrid-more-link')) return;
            const dateStr = arg.date.toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            const dayStr = arg.date.toISOString().split('T')[0];
            const allEvents = calendarInstance.getEvents().filter(ev => {
              if (ev.display === 'background' || !ev.id) return false;
              const evDate = ev.start ? ev.start.toISOString().split('T')[0] : null;
              return evDate === dayStr;
            });
            openCalSlide(dateStr, allEvents);
          });
        },
        events: async function (fetchInfo, successCallback, failureCallback) {
          try {
            const params = new URLSearchParams({
              start: fetchInfo.startStr,
              end: fetchInfo.endStr,
              limit: '500'
            });
            const res = await fetch(`/api/technician/calendar?${params.toString()}`, { credentials: 'same-origin' });
            if (!res.ok) throw new Error();
            const data = await res.json();
            const statusColors = { pending_acceptance: '#f59e0b', accepted: '#3b82f6', en_route: '#0ea5e9', on_site: '#22c55e', in_progress: '#2563eb', completed: '#10b981', cancelled: '#6b7280', declined: '#ef4444', no_show: '#6b7280' };
            const events = (data.items || []).map(a => {
              let startDateTime = a.bookingDate;
              let allDay = false;
              if (a.startTime) {
                const d = new Date(a.bookingDate);
                const timeParts = a.startTime.match(/(\d+):(\d+)\s*(AM|PM)?/i);
                if (timeParts) {
                  let hh = parseInt(timeParts[1], 10);
                  let mm = parseInt(timeParts[2], 10);
                  if (timeParts[3]) {
                    if (timeParts[3].toUpperCase() === 'PM' && hh < 12) hh += 12;
                    if (timeParts[3].toUpperCase() === 'AM' && hh === 12) hh = 0;
                  }
                  d.setHours(hh, mm, 0);
                  startDateTime = d.toISOString();
                }
              } else {
                startDateTime = (a.bookingDate || '').split('T')[0];
                allDay = true;
              }
              return {
                id: a._id,
                title: `${a.customerName || 'Customer'} - ${a.serviceName || 'Service'}`,
                start: startDateTime,
                allDay: allDay,
                color: statusColors[a.status] || '#6b7280',
                textColor: (statusColors[a.status] || '#6b7280'),
                display: 'block',
                extendedProps: { assignment: a }
              };
            });

            // Enterprise Schedule Integration
            if (data.schedule) {
              const formatTime = (mins) => {
                const h = Math.floor(mins / 60);
                const m = mins % 60;
                let h12 = h % 12 || 12;
                let ampm = h >= 12 ? 'PM' : 'AM';
                return `${h12}:${m.toString().padStart(2, '0')} ${ampm}`;
              };

              // 1. Add Working Days Shifts
              if (data.schedule.workingDays) {
                data.schedule.workingDays.forEach(w => {
                  events.push({
                    title: `Shift: ${formatTime(w.startMinutes)} - ${formatTime(w.endMinutes)}`,
                    daysOfWeek: [w.dayOfWeek],
                    display: 'background',
                    color: 'rgba(59, 130, 246, 0.08)' // light blue background
                  });
                });
              }
              // 2. Add Non-Working Weekdays
              if (data.schedule.nonWorkingWeekdays) {
                data.schedule.nonWorkingWeekdays.forEach(nw => {
                  events.push({
                    title: 'Day Off',
                    daysOfWeek: [nw.dayOfWeek || nw],
                    display: 'background',
                    color: 'rgba(239, 68, 68, 0.1)' // light red background
                  });
                });
              }
              // 3. Add Rest Dates (Leaves)
              if (data.schedule.restDates) {
                data.schedule.restDates.forEach(r => {
                  events.push({
                    title: `Leave: ${r.reason || 'Rest Day'}`,
                    start: new Date(r.date).toISOString().split('T')[0],
                    allDay: true,
                    display: 'background',
                    color: 'rgba(245, 158, 11, 0.15)' // amber background
                  });
                });
              }
            }

            successCallback(events);
          } catch (e) {
            failureCallback(e);
          }
        },
        eventClick: function (info) {
          if (info.event.display === 'background' || !info.event.id) return;
          window.showDetail(info.event.id);
        }
      });
      calendarInstance.render();
      setTimeout(() => calendarInstance.updateSize(), 0);
    }

    // ── Enterprise Day Slide Panel ──
    const STATUS_LABELS = { pending_acceptance: 'Pending', accepted: 'Accepted', en_route: 'En Route', on_site: 'On Site', in_progress: 'In Progress', completed: 'Completed', cancelled: 'Cancelled', declined: 'Declined', no_show: 'No Show' };
    const STATUS_COLORS = { pending_acceptance: '#f59e0b', accepted: '#3b82f6', en_route: '#0ea5e9', on_site: '#22c55e', in_progress: '#2563eb', completed: '#10b981', cancelled: '#6b7280', declined: '#ef4444', no_show: '#6b7280' };

    function openCalSlide(dateStr, events) {
      const overlay = document.getElementById('calSlideOverlay');
      const panel = document.getElementById('calSlidePanel');
      const title = document.getElementById('calSlideDateTitle');
      const subtitle = document.getElementById('calSlideSubtitle');
      const body = document.getElementById('calSlideBody');

      title.textContent = dateStr;
      subtitle.textContent = `${events.length} booking${events.length !== 1 ? 's' : ''} scheduled`;

      if (events.length === 0) {
        body.innerHTML = `
        <div class="text-center py-5" style="color:#94a3b8;">
          <i class="bi bi-calendar-x" style="font-size:2.5rem;display:block;margin-bottom:12px;opacity:0.5;"></i>
          <div style="font-weight:600;font-size:0.9rem;color:#64748b;">No bookings on this day</div>
          <div style="font-size:0.78rem;margin-top:4px;">This day appears to be free.</div>
        </div>`;
      } else {
        const sorted = [...events].sort((a, b) => (a.start || 0) > (b.start || 0) ? 1 : -1);
        body.innerHTML = sorted.map(ev => {
          const a = ev.extendedProps?.assignment || {};
          const color = STATUS_COLORS[a.status] || '#6b7280';
          const label = STATUS_LABELS[a.status] || a.status;
          const time = a.startTime || (ev.start ? ev.start.toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' }) : 'N/A');
          const badgeCls = a.status === 'completed' ? 'bg-success' : a.status === 'in_progress' ? 'bg-primary' : a.status === 'en_route' ? 'bg-info text-dark' : a.status === 'on_site' ? 'bg-dark' : a.status === 'cancelled' || a.status === 'declined' ? 'bg-danger' : a.status === 'pending_acceptance' ? 'bg-warning text-dark' : 'bg-secondary';
          const esc = (s) => (s || '').replace(/'/g, "\\'");
          return `
          <div class="cal-slide-card" style="--card-accent:${color};" onclick="closeCalSlide();setTimeout(()=>window.showDetail('${ev.id}'),250);">
            <div class="card-header-row">
              <div style="min-width:0;flex:1;">
                <div class="d-flex align-items-center gap-2">
                  <span class="priority-dot priority-${a.priority || 'normal'}"></span>
                  <p class="card-customer">${a.customerName || 'Customer'}</p>
                </div>
                <div class="card-service">${a.serviceName || 'Service'} ${a.serviceType ? '(' + a.serviceType + ')' : ''}</div>
              </div>
              <span class="badge ${badgeCls}" style="font-size:0.65rem;flex-shrink:0;">${label}</span>
            </div>
            <div class="card-details">
              <div class="card-detail"><i class="bi bi-clock"></i> ${time}</div>
              ${a.address ? `<div class="card-detail"><i class="bi bi-geo-alt"></i> ${a.address.substring(0, 35)}${a.address.length > 35 ? '...' : ''}</div>` : ''}
              ${a.estimatedFee ? `<div class="card-detail"><i class="bi bi-cash"></i> ₱${Number(a.estimatedFee).toLocaleString()}</div>` : ''}
              ${['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && !a.balanceCollected && (a.balanceAmount || 0) > 0 ? `<div class="card-detail" style="color:#d97706;"><i class="bi bi-exclamation-triangle"></i> Balance ₱${Number(a.balanceAmount).toLocaleString()}</div>` : ''}
            </div>
            <div class="card-footer">
              <span class="card-ref">${a.bookingReference || a._id?.slice(-6).toUpperCase() || ''}</span>
              <span class="card-view-link">View Details &rarr;</span>
            </div>
          </div>`;
        }).join('');
      }

      overlay.classList.add('show');
      requestAnimationFrame(() => panel.classList.add('open'));
    }

    function closeCalSlide() {
      const overlay = document.getElementById('calSlideOverlay');
      const panel = document.getElementById('calSlidePanel');
      panel.classList.remove('open');
      overlay.classList.remove('show');
    }
    window.closeCalSlide = closeCalSlide;

    document.getElementById('calSlideOverlay')?.addEventListener('click', closeCalSlide);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeCalSlide(); });

    // Initialize calendar on first view switch
    function initCalendar() {
      // Calendar is now list-based with "Show More" — no FullCalendar needed for the list view
      // FullCalendar still available if user wants month view
    }

    // ── Boot ──
    updateKpis();
    // Auto-refresh KPIs every 60 seconds
    setInterval(updateKpis, 60000);
  })();
</script>

