  <!-- --- FILTER BAR --- -->
  <% const filters = analytics && analytics.filterContext ? analytics.filterContext : { range:'90', from:'', to:'', segment:'all', status:'all', scale:'all', payment:'all', technician:'all', brand:'all', search:'' }; %>
  <form class="admin-filter-bar" method="get" action="/admin/reports/service" id="serviceReportFilters">
    <div class="filter-group">
      <div class="filter-item">
        <i class="bi bi-calendar3"></i>
        <select class="form-select" name="range" id="reportRange">
          <option value="7" <%= filters.range === '7' ? 'selected' : '' %>>Last 7 days</option><option value="30" <%= filters.range === '30' ? 'selected' : '' %>>Last 30 days</option><option value="90" <%= filters.range === '90' ? 'selected' : '' %>>Last 90 days</option><option value="365" <%= filters.range === '365' ? 'selected' : '' %>>Last 12 months</option><option value="custom" <%= filters.range === 'custom' ? 'selected' : '' %>>Custom dates</option>
        </select>
      </div>
      <div class="filter-item">
        <i class="bi bi-gear"></i>
        <select class="form-select" name="segment"><option value="all">All segments</option><option value="core" <%= filters.segment === 'core' ? 'selected' : '' %>>Core services</option><option value="repair" <%= filters.segment === 'repair' ? 'selected' : '' %>>Repair services</option></select>
      </div>
      <div class="filter-item">
        <i class="bi bi-activity"></i>
        <select class="form-select" name="status"><option value="all">All statuses</option><% ['pending','payment_verified','awaiting_assignment','assigned','pending_reassignment','confirmed','scheduled','on-the-way','arrived','in-progress','inspection_scheduled','inspection_in_progress','inspection_completed','awaiting_approval','repair_approved','waiting_parts','parts_reserved','ready_for_repair','repair_scheduled','repair_in_progress','completed','repair_completed','closed','cancelled','rejected','repair_declined','no-show'].forEach(function(s) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.replace(/[-_]/g,' ').replace(/\b\w/g, c => c.toUpperCase()) %></option><% }); %></select>
      </div>
      <div class="filter-item"><i class="bi bi-building-gear"></i><select class="form-select" name="scale"><option value="all">All booking scales</option><option value="standard" <%= filters.scale === 'standard' ? 'selected' : '' %>>Standard</option><option value="large" <%= filters.scale === 'large' ? 'selected' : '' %>>Large-scale projects</option></select></div>
      <div class="filter-item"><i class="bi bi-credit-card"></i><select class="form-select" name="payment"><option value="all">All payment methods</option><option value="gcash" <%= filters.payment === 'gcash' ? 'selected' : '' %>>GCash</option><option value="cod" <%= filters.payment === 'cod' ? 'selected' : '' %>>Cash / COD</option><option value="other" <%= filters.payment === 'other' ? 'selected' : '' %>>Other</option></select></div>
      <div class="filter-item"><i class="bi bi-person-gear"></i><select class="form-select" name="technician"><option value="all">All technicians</option><% (analytics && analytics.technicians || []).forEach(function(t) { %><option value="<%= t._id %>" <%= filters.technician === String(t._id) ? 'selected' : '' %>><%= t.name %></option><% }); %></select></div>
      <div class="filter-item"><i class="bi bi-award"></i><select class="form-select" name="brand"><option value="all">All brands</option><% (analytics && analytics.bookingBrands || []).forEach(function(brand) { %><option value="<%= brand %>" <%= filters.brand === brand ? 'selected' : '' %>><%= brand %></option><% }); %></select></div>
      <div class="filter-item"><i class="bi bi-search"></i><input class="form-control" type="search" name="search" value="<%= filters.search %>" placeholder="Reference, customer, issue…" style="min-width:210px;border:0;box-shadow:none;"></div>
      <div class="filter-item custom-date-filter" style="<%= filters.range === 'custom' ? '' : 'display:none;' %>"><span style="font-size:.72rem;color:#64748b;">From</span><input class="form-control" type="date" name="from" value="<%= filters.from %>" style="border:0;box-shadow:none;"></div>
      <div class="filter-item custom-date-filter" style="<%= filters.range === 'custom' ? '' : 'display:none;' %>"><span style="font-size:.72rem;color:#64748b;">To</span><input class="form-control" type="date" name="to" value="<%= filters.to %>" style="border:0;box-shadow:none;"></div>
    </div>
    <div class="filter-actions">
      <button type="submit" class="btn btn-outline" style="border-radius:8px;font-weight:600;padding:0.45rem 1.2rem;font-size:0.875rem;display:inline-flex;align-items:center;gap:6px;background:#fff;border:1px solid #e2e8f0;color:#0f172a;"><i class="bi bi-funnel"></i> Apply</button>
      <a href="/admin/reports/service" class="btn btn-outline" style="border-radius:8px;font-weight:600;padding:0.45rem .8rem;font-size:0.875rem;background:#fff;border:1px solid #e2e8f0;color:#64748b;">Reset</a>
      <button type="button" id="exportReportBtn" class="btn btn-primary" style="border-radius:8px;font-weight:600;padding:0.45rem 1.2rem;font-size:0.875rem;display:inline-flex;align-items:center;gap:6px;background:#2563eb;border-color:#2563eb;color:#fff;"><i class="bi bi-download"></i> Export CSV</button>
    </div>
  </form>

