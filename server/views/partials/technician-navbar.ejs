<style>
  .navbar-icon-btn {
    width: 40px; height: 40px; border-radius: 10px; border: 1px solid #e2e8f0;
    background: transparent; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    color: #64748b; display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .navbar-icon-btn:hover {
    background: #f1f5f9; border-color: #3b82f6; color: #2563eb;
    box-shadow: 0 2px 8px rgba(59,130,246,0.12);
  }
  .navbar-profile-btn {
    border-radius: 10px; padding: 0.5rem 1rem; border: 1px solid #e2e8f0;
    background: transparent; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    color: #334155; display: flex; align-items: center; gap: 0.5rem; font-family: inherit; font-size: 0.9rem;
    flex-shrink: 0;
  }
  .navbar-profile-btn:hover {
    background: #f1f5f9; border-color: #3b82f6; box-shadow: 0 2px 8px rgba(59,130,246,0.12);
  }
  .navbar-profile-btn:hover .chevron-icon {
    transform: rotate(180deg);
  }
  .dropdown-item-custom:hover {
    background: #f8fafc; color: #2563eb !important;
  }
  #sidebarToggleMobile {
    display: none;
  }
  @media (max-width: 767px) {
    #sidebarToggleMobile {
      display: flex;
    }
    .navbar-brand .brand-text {
      display: none;
    }
    .navbar-profile-btn .profile-text {
      display: none;
    }
    .navbar-profile-btn .chevron-icon {
      display: none;
    }
    .navbar-icon-btn {
      width: 32px;
      height: 32px;
    }
    .navbar-icon-btn i {
      font-size: 1rem;
    }
    .navbar-profile-btn {
      padding: 0.35rem 0.5rem;
    }
    .navbar-profile-btn i {
      font-size: 1rem;
    }
    .navbar-brand-logo {
      width: 24px;
      height: 24px;
    }
    .navbar-brand-logo {
      margin-right: 0 !important;
    }
    #technicianNavbar {
      padding: 0.5rem 0.75rem;
    }
    .container-fluid {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      display: grid !important;
      grid-template-columns: auto 1fr;
      gap: 0.5rem;
      align-items: center;
    }
    .container-fluid > div:first-child {
      gap: 0.25rem !important;
      display: flex !important;
      flex-wrap: nowrap !important;
    }
    .container-fluid > div:last-child {
      gap: 0.25rem !important;
      display: flex !important;
      flex-wrap: nowrap !important;
      justify-content: flex-end;
    }
    .container-fluid > div:last-child.gap-3 {
      gap: 0.25rem !important;
    }
    .navbar-brand {
      flex-shrink: 0;
    }
  }

  @media (max-width: 480px) {
    .navbar-icon-btn {
      width: 34px;
      height: 34px;
    }
    .navbar-icon-btn i {
      font-size: 1rem;
    }
    .navbar-profile-btn {
      padding: 0.35rem 0.5rem;
    }
    .navbar-profile-btn i {
      font-size: 1rem;
    }
    .navbar-brand-logo {
      width: 26px;
      height: 26px;
    }
    #notifBadge {
      font-size: 0.5rem;
      padding: 0.15em 0.35em;
      margin-left: -8px;
      margin-top: -2px;
    }
    #notifDropdown {
      right: 0;
      left: 0;
      width: 100%;
      border-radius: 0;
      border-left: none;
      border-right: none;
      max-height: 80vh;
    }
    #notifList {
      max-height: calc(80vh - 100px);
    }
  }

  /* Override Bootstrap dropdown-menu behavior for technician notifications */
  #notifDropdown {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
  }
  #notifDropdown.show {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
</style>
<nav id="technicianNavbar" class="navbar navbar-expand-lg border-bottom px-4 py-2 bg-white" style="border-color: rgba(226, 232, 240, 0.8) !important; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);">
  <div class="container-fluid d-flex align-items-center justify-content-between" style="padding-left: 1rem; padding-right: 1rem;">
    <!-- Brand Section -->
    <div class="d-flex align-items-center gap-2">
      <button id="sidebarToggleMobile" class="navbar-icon-btn" aria-label="Toggle sidebar" onclick="toggleMobileSidebar()">
        <i class="bi bi-list" style="font-size: 1.3rem;"></i>
      </button>
      <a class="navbar-brand fw-bold d-flex align-items-center text-decoration-none" href="/technician" style="font-family: 'Outfit', sans-serif;">
        <img
          src="/images/LOGO/RACS.png"
          alt="CALIDRO RACS"
          class="navbar-brand-logo me-2"
          style="width: 32px; height: 32px; object-fit: contain;"
        />
        <span class="brand-text" style="color: #0f172a; font-weight: 400; letter-spacing: 0.3px; font-size: 1.1rem;">CALIDRO RACS</span>
      </a>
    </div>

    <!-- Actions Section -->
    <div class="d-flex align-items-center gap-3">
      <div class="dropdown">
        <button
          class="navbar-icon-btn"
          id="notifDropdownBtn"
          aria-label="Notifications"
          type="button"
        >
          <i class="bi bi-bell" style="font-size: 1.15rem;"></i>
          <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill d-none" style="font-size: 0.55rem; background: #ef4444; padding: 0.2em 0.45em; border: 1.5px solid #fff; margin-left: -10px; margin-top: -2px;">0</span>
        </button>
        <div class="dropdown-menu dropdown-menu-end p-0 shadow-lg" id="notifDropdown" style="width: min(360px, 92vw); max-height: 70vh; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; display: none; visibility: hidden; opacity: 0; position: absolute; right: 0; top: 100%; margin-top: 8px;">
          <div class="d-flex justify-content-between align-items-center bg-light px-3 py-2 border-bottom flex-shrink-0">
            <h6 class="mb-0 fw-bold" style="color: #334155;">Notifications</h6>
            <span class="badge bg-secondary rounded-pill" id="notifCount" style="font-size: 0.7rem;">0</span>
          </div>
          <div id="notifList" style="max-height: calc(70vh - 90px); overflow-y: auto; flex: 1;">
            <div class="p-4 text-center" id="notifEmpty">
              <i class="bi bi-bell-slash text-muted mb-2 d-block" style="font-size: 2rem;"></i>
              <p class="text-muted small mb-0">No new notifications.</p>
            </div>
          </div>
          <div class="border-top text-center py-2 bg-light flex-shrink-0" id="notifFooter">
            <a href="/technician" class="text-decoration-none small fw-semibold" style="color: #2563eb;">View All</a>
          </div>
        </div>
      </div>
      
      <div class="dropdown">
        <button
          type="button"
          id="profileDropdown"
          data-bs-toggle="dropdown"
          aria-expanded="false"
          class="navbar-profile-btn"
        >
          <i class="bi bi-person-circle" style="font-size: 1.2rem;"></i>
          <span class="profile-text">Technician</span>
          <i class="bi bi-chevron-down chevron-icon" style="font-size: 0.75rem; transition: transform 0.2s;"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end py-1" aria-labelledby="profileDropdown" style="border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.10); min-width: 180px;">
          <li>
            <a class="dropdown-item dropdown-item-custom py-2" href="/technician/profile" style="color: #475569; font-size: 0.88rem; padding: 0.5rem 1rem; border-radius: 6px; transition: all 0.15s;">
              <i class="bi bi-person me-2"></i>Profile
            </a>
          </li>
          <li><hr class="dropdown-divider" style="border-color: #f1f5f9; margin: 0.25rem 0.5rem;"></li>
          <li>
            <a class="dropdown-item dropdown-item-custom py-2" href="#" onclick="event.preventDefault(); fetch('/api/auth/logout', {method: 'POST'}).then(() => window.location.href='/login');" style="color: #dc2626; font-size: 0.88rem; padding: 0.5rem 1rem; border-radius: 6px; transition: all 0.15s;">
              <i class="bi bi-box-arrow-right me-2"></i>Logout
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>

<script>
  /* ── Mobile sidebar: toggle .open + backdrop ── */
  window.toggleMobileSidebar = function() {
    var s = document.getElementById('adminSidebar');
    var btn = document.getElementById('sidebarToggleMobile');
    if (!s) return;
    var b = getBackdrop();
    if (s.classList.toggle('open')) {
      b.classList.add('show');
      document.body.style.overflow = 'hidden';
      if (btn) { var ic = btn.querySelector('i'); if (ic) { ic.classList.remove('bi-list'); ic.classList.add('bi-x-lg'); } }
    } else {
      b.classList.remove('show');
      document.body.style.overflow = '';
      if (btn) { var ic = btn.querySelector('i'); if (ic) { ic.classList.remove('bi-x-lg'); ic.classList.add('bi-list'); } }
    }
  };
  window.closeMobileSidebar = function() {
    var s = document.getElementById('adminSidebar');
    var btn = document.getElementById('sidebarToggleMobile');
    var b = getBackdrop();
    if (s) s.classList.remove('open');
    b.classList.remove('show');
    document.body.style.overflow = '';
    if (btn) { var ic = btn.querySelector('i'); if (ic) { ic.classList.remove('bi-x-lg'); ic.classList.add('bi-list'); } }
  };
  function getBackdrop() {
    var el = document.querySelector('.sidebar-backdrop');
    if (!el) {
      el = document.createElement('div');
      el.className = 'sidebar-backdrop';
      document.body.appendChild(el);
    }
    return el;
  }
  /* Wire backdrop + close button on first DOM ready */
  document.addEventListener('DOMContentLoaded', function() {
    getBackdrop().addEventListener('click', window.closeMobileSidebar);
  });

  /* ---- Notifications ---- */
  (function() {
    var badge = document.getElementById('notifBadge');
    var countEl = document.getElementById('notifCount');
    var listEl = document.getElementById('notifList');
    var emptyEl = document.getElementById('notifEmpty');
    var btn = document.getElementById('notifDropdownBtn');
    var panel = document.getElementById('notifDropdown');
    var isOpen = false;

    function timeAgo(dateStr) {
      var now = new Date();
      var d = new Date(dateStr);
      var diff = Math.floor((now - d) / 1000);
      if (diff < 60) return 'just now';
      if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
      return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
    }

    function fetchNotifications() {
      fetch('/api/technician/notifications', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var notifs = data.notifications || [];
          var unread = data.unread || 0;

          // Badge
          if (unread > 0) {
            badge.classList.remove('d-none');
            badge.textContent = unread > 999 ? '999+' : String(unread);
          } else {
            badge.classList.add('d-none');
          }

          countEl.textContent = unread;

          // List
          if (notifs.length === 0) {
            listEl.innerHTML = '<div class="p-4 text-center" id="notifEmpty"><i class="bi bi-bell-slash text-muted mb-2 d-block" style="font-size: 2rem;"></i><p class="text-muted small mb-0">No new notifications.</p></div>';
            return;
          }

          var html = '';
          notifs.forEach(function(n) {
            html +=
              '<a href="' + (n.link || '#') + '" class="dropdown-item border-bottom px-3 py-2" style="white-space: normal;">' +
                '<div class="d-flex gap-2 align-items-start">' +
                  '<i class="bi ' + n.icon + ' ' + n.iconClass + '" style="font-size: 1rem; margin-top: 2px;"></i>' +
                  '<div class="min-w-0">' +
                    '<div class="fw-semibold small" style="color: #0f172a;">' + n.title + '</div>' +
                    '<div class="text-muted" style="font-size: 0.75rem; line-height: 1.3;">' + n.message + '</div>' +
                    '<div class="text-muted" style="font-size: 0.65rem; margin-top: 2px;">' + timeAgo(n.time) + '</div>' +
                  '</div>' +
                '</div>' +
              '</a>';
          });
          listEl.innerHTML = html;
        })
        .catch(function() { /* silent */ });
    }

    // Toggle panel (same as admin navbar)
    if (btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        isOpen = !isOpen;
        if (isOpen) {
          panel.classList.add('show');
          panel.style.display = 'block';
          panel.style.visibility = 'visible';
          panel.style.opacity = '1';
          fetchNotifications();
        } else {
          panel.classList.remove('show');
          panel.style.display = 'none';
          panel.style.visibility = 'hidden';
          panel.style.opacity = '0';
        }
      });
    }

    // Close on outside click
    document.addEventListener('click', function(e) {
      if (panel && btn && !panel.contains(e.target) && !btn.contains(e.target)) {
        panel.classList.remove('show');
        panel.style.display = 'none';
        panel.style.visibility = 'hidden';
        panel.style.opacity = '0';
        isOpen = false;
      }
    });

    // Initial fetch (delay so page loads fully)
    setTimeout(fetchNotifications, 1500);

    // Poll every 60s
    setInterval(fetchNotifications, 60000);

    // Real-time: listen for new notifications via Socket.io
    if (window.socket) {
      window.socket.on('notification:new', function(data) {
        // Refresh the notification list
        fetchNotifications();
      });

      window.socket.on('assignment:new', function(data) {
        // New assignment received - refresh immediately
        fetchNotifications();
        // Show browser notification if permitted
        if (Notification && Notification.permission === 'granted') {
          new Notification('New Assignment', {
            body: data.customerName ? 'New job for ' + data.customerName : 'You have a new assignment',
            icon: '/images/LOGO/RACS.png',
          });
        }
      });

      window.socket.on('assignment:accepted', function(data) {
        fetchNotifications();
      });

      window.socket.on('assignment:declined', function(data) {
        fetchNotifications();
      });
    }
  })();
</script>
