    async function loadTechnicianSchedule() {
      if (!techEl.value) return;
      try {
        const r = await fetch(
          `/api/services/technician-schedule/${encodeURIComponent(techEl.value)}`,
          { cache: "no-store" },
        );
        const j = await r.json();
        state.calendar.nonWorkingWeekdays = Array.isArray(j.nonWorkingWeekdays)
          ? j.nonWorkingWeekdays
          : [];
