              <div class="ent-step-icon step-location"><i class="bi bi-geo-alt"></i></div>
              <div class="ent-step-info">
                <h5>Step 3</h5>
                <p>Set your service location</p>
              </div>
            </div>

            <script>
              window._companyBaseLocation = { configured: false, lat: 14.676049, lng: 121.043731, address: 'Company location not set' };
              window._companyBaseLocationPromise = fetch('/api/public/company/location', { credentials: 'same-origin' })
                .then(r => { if (!r.ok) throw new Error('Failed'); return r.json(); })
                .then(data => { window._companyBaseLocation = data || window._companyBaseLocation; return window._companyBaseLocation; })
                .catch(() => window._companyBaseLocation);
            </script>

