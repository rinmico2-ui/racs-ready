<div class="container-fluid py-4">
  <%- include('../../../partials/dashboard-styles') %>
  <link rel="stylesheet" href="/css/analytics.css">
  <style>
    /* Customer Ratings tabs */
    .nav-pills .nav-link { color: #64748b; font-weight: 600; border-radius: 10px; padding: 0.6rem 1.1rem; }
    .nav-pills .nav-link.active { background: #fff; color: #0f172a; box-shadow: inset -4px 0 0 0 #2563eb, 0 2px 6px rgba(0,0,0,0.06); }
    .nav-pills .nav-link:not(.active):hover { background: #f1f5f9; color: #334155; }
  </style>
  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-snow2"></i></div>
        <div>
          <h1>Aircon Ratings</h1>
          <p>Customer reviews and ratings for aircon products</p>
        </div>
      </div>
      <div class="au-hero-actions">
        <button class="btn btn-outline-info" onclick="exportProductReviews()">
          <i class="bi bi-download me-2"></i>Export Reviews
        </button>
        <button class="btn btn-primary" onclick="refreshAirconRatings()">
          <i class="bi bi-arrow-clockwise me-2"></i>Refresh
        </button>
      </div>
    </div>
  </div>

  <!-- Customer Ratings Tabs -->
  <ul class="nav nav-pills mb-4">
    <li class="nav-item"><a class="nav-link" href="/admin/ratings/service"><i class="bi bi-wrench-adjustable me-2"></i>Services</a></li>
    <li class="nav-item"><a class="nav-link active" href="/admin/ratings/aircons"><i class="bi bi-snow2 me-2"></i>Aircon Products</a></li>
  </ul>

  <!-- Product Rating Overview -->
  <div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1">
              <h6 class="text-muted mb-2">Total Products</h6>
              <h3 class="mb-0" id="totalProducts">0</h3>
              <small class="text-muted">With reviews</small>
            </div>
            <div class="ms-3">
              <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                <i class="bi bi-box-seam text-primary fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1">
              <h6 class="text-muted mb-2">Avg Product Rating</h6>
              <h3 class="mb-0" id="avgProductRating">0.0</h3>
              <div class="text-warning">
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-half"></i>
              </div>
            </div>
            <div class="ms-3">
              <div class="bg-success bg-opacity-10 rounded-circle p-3">
                <i class="bi bi-award text-success fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1">
              <h6 class="text-muted mb-2">Total Reviews</h6>
              <h3 class="mb-0" id="totalReviews">0</h3>
              <small class="text-success">
                <i class="bi bi-arrow-up"></i> 8% this month
              </small>
            </div>
            <div class="ms-3">
              <div class="bg-info bg-opacity-10 rounded-circle p-3">
                <i class="bi bi-chat-dots text-info fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1">
              <h6 class="text-muted mb-2">Verified Reviews</h6>
              <h3 class="mb-0" id="verifiedReviews">0</h3>
              <small class="text-muted">Customer verified</small>
            </div>
            <div class="ms-3">
              <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                <i class="bi bi-check-circle text-warning fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="row mb-4">
    <div class="col-lg-4 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Brand Performance</h5>
        </div>
        <div class="card-body">
          <canvas id="brandPerformanceChart" height="250"></canvas>
        </div>
      </div>
    </div>
    <div class="col-lg-4 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Rating Distribution</h5>
        </div>
        <div class="card-body">
          <canvas id="airconRatingDistChart" height="250"></canvas>
        </div>
      </div>
    </div>
    <div class="col-lg-4 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Top Products by Reviews</h5>
        </div>
        <div class="card-body">
          <canvas id="topProductsChart" height="250"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Top Rated Products -->
  <div class="row mb-4">
    <div class="col-lg-12 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Top Rated Products</h5>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Brand</th>
                  <th>Rating</th>
                  <th>Reviews</th>
                  <th>Price Range</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="topProductsTable">
                <tr>
                  <td colspan="6" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                      <span class="visually-hidden">Loading...</span>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters and Search -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-2">
          <label class="form-label">Brand</label>
          <select class="form-select" id="brandFilter">
            <option value="">All Brands</option>
            <option value="Carrier">Carrier</option>
            <option value="AUX">AUX</option>
            <option value="LG">LG</option>
            <option value="Samsung">Samsung</option>
            <option value="Panasonic">Panasonic</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Type</label>
          <select class="form-select" id="typeFilter">
            <option value="">All Types</option>
            <option value="split">Split Type</option>
            <option value="window">Window Type</option>
            <option value="portable">Portable</option>
            <option value="ceiling">Ceiling</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Rating</label>
          <select class="form-select" id="ratingFilter">
            <option value="">All Ratings</option>
            <option value="5">5 Stars</option>
            <option value="4">4+ Stars</option>
            <option value="3">3+ Stars</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Price Range</label>
          <select class="form-select" id="priceFilter">
            <option value="">All Prices</option>
            <option value="0-10000">Under ₱10,000</option>
            <option value="10000-25000">₱10,000 - ₱25,000</option>
            <option value="25000-50000">₱25,000 - ₱50,000</option>
            <option value="50000+">Above ₱50,000</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Sort By</label>
          <select class="form-select" id="sortBy">
            <option value="rating">Highest Rated</option>
            <option value="reviews">Most Reviews</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="newest">Newest First</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">&nbsp;</label>
          <div class="d-grid">
            <button class="btn btn-primary" onclick="applyFilters()">
              <i class="bi bi-funnel me-2"></i>Apply Filters
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Product Reviews Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0">
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Product Reviews</h5>
        <div class="d-flex gap-2">
          <span class="text-muted" id="reviewCount">Showing 0 reviews</span>
        </div>
      </div>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Product</th>
              <th>Customer</th>
              <th>Rating</th>
              <th>Review Title</th>
              <th>Comment</th>
              <th>Date</th>
              <th>Verified</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="productReviewsTable">
            <tr>
              <td colspan="8" class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2">Loading product reviews...</div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <nav aria-label="Product reviews pagination" class="mt-3">
        <ul class="pagination justify-content-center" id="pagination">
        </ul>
      </nav>
    </div>
  </div>

  <%- include('../../../partials/chart-drilldown-modal') %>
</div>

<!-- Review Details Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Product Review Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="reviewModalBody">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-warning" onclick="flagReview()">Flag Review</button>
        <button type="button" class="btn btn-danger" onclick="deleteReview()">Delete Review</button>
      </div>
    </div>
  </div>
</div>

<!-- Styles -->
<style>
  .rating-stars {
    color: #ffc107;
  }
  .product-image {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 4px;
  }
  .verified-badge {
    color: #198754;
  }
  .brand-logo {
    width: 24px;
    height: 24px;
    object-fit: contain;
    margin-right: 8px;
  }
  .review-title {
    font-weight: 600;
    color: #212529;
  }
  .review-comment {
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<!-- JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/chart-drilldown.js"></script>
<script>
  // @ts-nocheck
  let productReviews = [];
  let topProducts = [];
  let currentPage = 1;
  let totalPages = 1;
  let airconCharts = {};

  function openDrill(title, subtitle, chartCfg, details, filters, ff, summary) {
    if (typeof ChartDrilldown === 'undefined') return;
    ChartDrilldown.open({ title: title, subtitle: subtitle || 'Click any element to filter the details below', chartConfig: chartCfg, details: details, filters: filters || [], filterField: ff || 'category', summary: summary || {} });
  }

  document.addEventListener('DOMContentLoaded', function() {
    loadAirconRatings();
    loadTopProducts();
  });

  async function loadAirconRatings() {
    try {
      showLoadingState();
      const response = await fetch('/api/admin/ratings/aircons');
      if (response.ok) {
        const data = await response.json();
        productReviews = data.reviews || [];
        updateOverviewStats(data.stats || {});
        renderProductReviews();
        updateReviewCount();
        initializeAirconCharts(data);
      } else {
        showErrorState();
      }
    } catch (error) {
      console.error('Error loading aircon ratings:', error);
      showErrorState();
    }
  }

  async function loadTopProducts() {
    try {
      const response = await fetch('/api/admin/ratings/top-products');
      if (response.ok) {
        const data = await response.json();
        topProducts = data.products || [];
        renderTopProducts();
        updateTopProductsChart(data.products || []);
      }
    } catch (error) {
      console.error('Error loading top products:', error);
    }
  }

  function updateOverviewStats(stats) {
    document.getElementById('totalProducts').textContent = stats.totalProducts || 0;
    document.getElementById('avgProductRating').textContent = (stats.avgRating || 0).toFixed(1);
    document.getElementById('totalReviews').textContent = stats.totalReviews || 0;
    document.getElementById('verifiedReviews').textContent = stats.verifiedReviews || 0;
  }

  function initializeAirconCharts(data) {
    var brandPerformance = data.brandPerformance || {};
    var brandLabels = brandPerformance.labels || ['Carrier', 'AUX', 'LG', 'Samsung', 'Panasonic'];
    var brandData = brandPerformance.data || [4.5, 4.3, 4.6, 4.4, 4.7];
    var brandColors = brandPerformance.colors || [
      'rgba(13, 110, 253, 0.8)',
      'rgba(25, 135, 84, 0.8)',
      'rgba(255, 193, 7, 0.8)',
      'rgba(220, 53, 69, 0.8)',
      'rgba(108, 117, 125, 0.8)'
    ];

    var starBreakdown = data.starBreakdown || [45, 30, 15, 7, 3];
    var starLabels = ['5 Stars', '4 Stars', '3 Stars', '2 Stars', '1 Star'];
    var starColors = ['#198754', '#0d6efd', '#ffc107', '#fd7e14', '#dc3545'];

    // Brand Performance Bar Chart
    var brandCtx = document.getElementById('brandPerformanceChart').getContext('2d');
    var brandCfg = {
      type: 'bar',
      data: {
        labels: brandLabels,
        datasets: [{
          label: 'Average Rating',
          data: brandData,
          backgroundColor: brandColors
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: {
            beginAtZero: false,
            min: 3,
            max: 5
          }
        }
      }
    };
    var brandCanvas = brandCtx.canvas;
    brandCanvas.style.cursor = 'pointer';
    brandCanvas.onclick = function(evt) {
      var elements = airconCharts.brandPerformance.getElementsAtEventForMode(evt, 'nearest', { intersect: true }, true);
      if (typeof ChartDrilldown === 'undefined') return;
      var label = '';
      var val = 0;
      if (elements.length > 0) {
        var idx = elements[0].index;
        label = brandLabels[idx] || '';
        val = brandData[idx] || 0;
      }
      var details = starLabels.map(function(l, i) { return { category: l, value: starBreakdown[i] }; });
      var filters = starLabels.map(function(l, i) { return { id: 'star-' + (5 - i), label: l, active: i === 0 }; });
      openDrill(
        'Brand Performance - ' + label,
        'Star distribution for ' + (label || 'all brands'),
        brandCfg, details, filters, 'category',
        { total: starBreakdown.reduce(function(a, b) { return a + b; }, 0) }
      );
    };
    airconCharts.brandPerformance = new Chart(brandCtx, brandCfg);

    // Rating Distribution Doughnut
    var distCtx = document.getElementById('airconRatingDistChart').getContext('2d');
    var ratingDistCfg = {
      type: 'doughnut',
      data: {
        labels: starLabels,
        datasets: [{
          data: starBreakdown,
          backgroundColor: starColors
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' }
        }
      }
    };
    var distCanvas = distCtx.canvas;
    distCanvas.style.cursor = 'pointer';
    distCanvas.onclick = function(evt) {
      var elements = airconCharts.ratingDist.getElementsAtEventForMode(evt, 'nearest', { intersect: true }, true);
      if (typeof ChartDrilldown === 'undefined') return;
      var label = '';
      var clickedVal = 0;
      if (elements.length > 0) {
        var idx = elements[0].index;
        label = starLabels[idx] || '';
        clickedVal = starBreakdown[idx] || 0;
      }
      var details = [{ category: label, value: clickedVal }];
      var filters = starLabels.map(function(l, i) { return { id: 'star-' + (5 - i), label: l, active: l === label }; });
      openDrill(
        'Rating Distribution - ' + label,
        'Drilldown for ' + (label || 'all ratings'),
        ratingDistCfg, details, filters, 'category',
        { total: clickedVal }
      );
    };
    airconCharts.ratingDist = new Chart(distCtx, ratingDistCfg);

    // Top Products Bar Chart
    var topProductsData = data.topProducts || [];
    var tpLabels = topProductsData.slice(0, 5).map(function(p) { return p.name || p.productName || 'Product'; });
    var tpValues = topProductsData.slice(0, 5).map(function(p) { return p.reviewCount || 0; });
    var tpCtx = document.getElementById('topProductsChart').getContext('2d');
    var topProductsCfg = {
      type: 'bar',
      data: {
        labels: tpLabels,
        datasets: [{
          label: 'Review Count',
          data: tpValues,
          backgroundColor: 'rgba(13, 110, 253, 0.8)'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        indexAxis: 'y',
        scales: {
          x: {
            beginAtZero: true
          }
        }
      }
    };
    var tpCanvas = tpCtx.canvas;
    tpCanvas.style.cursor = 'pointer';
    tpCanvas.onclick = function(evt) {
      var elements = airconCharts.topProducts.getElementsAtEventForMode(evt, 'nearest', { intersect: true }, true);
      if (typeof ChartDrilldown === 'undefined') return;
      var label = '';
      var val = 0;
      if (elements.length > 0) {
        var idx = elements[0].index;
        label = tpLabels[idx] || '';
        val = tpValues[idx] || 0;
      }
      var details = [{ category: label, value: val }];
      var filters = tpLabels.map(function(l, i) { return { id: 'product-' + i, label: l, active: l === label }; });
      openDrill(
        'Top Product - ' + label,
        'Review count for ' + (label || 'selected product'),
        topProductsCfg, details, filters, 'category',
        { total: val }
      );
    };
    airconCharts.topProducts = new Chart(tpCtx, topProductsCfg);
  }

  function updateTopProductsChart(products) {
    if (!airconCharts.topProducts) return;
    var tp = (products || []).slice(0, 5);
    var labels = tp.map(function(p) { return p.name || p.productName || 'Product'; });
    var values = tp.map(function(p) { return p.reviewCount || 0; });
    airconCharts.topProducts.data.labels = labels;
    airconCharts.topProducts.data.datasets[0].data = values;
    airconCharts.topProducts.update();
  }

  function renderTopProducts() {
    const tbody = document.getElementById('topProductsTable');
    
    if (topProducts.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" class="text-center py-4">
            <div class="text-muted">
              <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
              No products found
            </div>
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = topProducts.map(product => `
      <tr>
        <td>
          <div class="d-flex align-items-center">
            <img src="${product.imageUrl || '/images/products/default.png'}" 
                 alt="${product.name}" 
                 class="product-image me-2">
            <div>
              <div class="fw-medium">${product.name}</div>
              <small class="text-muted">${product.model}</small>
            </div>
          </div>
        </td>
        <td>
          <div class="d-flex align-items-center">
            <span class="badge bg-secondary">${product.brand}</span>
          </div>
        </td>
        <td>
          <div class="rating-stars">
            ${generateStars(product.avgRating)}
          </div>
          <small class="text-muted">${product.avgRating.toFixed(1)}</small>
        </td>
        <td>
          <span class="badge bg-info">${product.reviewCount}</span>
        </td>
        <td>
          <small>₱${product.minPrice.toLocaleString()} - ₱${product.maxPrice.toLocaleString()}</small>
        </td>
        <td>
          <div class="btn-group btn-group-sm">
            <button class="btn btn-outline-primary" onclick="viewProduct('${product.id}')" title="View Product">
              <i class="bi bi-eye"></i>
            </button>
            <button class="btn btn-outline-info" onclick="viewProductReviews('${product.id}')" title="View Reviews">
              <i class="bi bi-chat-dots"></i>
            </button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  function renderProductReviews() {
    const tbody = document.getElementById('productReviewsTable');
    
    if (productReviews.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="8" class="text-center py-4">
            <div class="text-muted">
              <i class="bi bi-chat-dots fs-1 d-block mb-2"></i>
              No product reviews found
            </div>
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = productReviews.map(review => `
      <tr>
        <td>
          <div class="d-flex align-items-center">
            <img src="${review.productImageUrl || '/images/products/default.png'}" 
                 alt="${review.productName}" 
                 class="product-image me-2">
            <div>
              <div class="fw-medium">${review.productName}</div>
              <small class="text-muted">${review.brand}</small>
            </div>
          </div>
        </td>
        <td>
          <div>
            <div class="fw-medium">${review.customerName}</div>
            <small class="text-muted">${review.customerEmail}</small>
          </div>
        </td>
        <td>
          <div class="rating-stars">
            ${generateStars(review.rating)}
          </div>
        </td>
        <td>
          <div class="review-title">${review.title || 'No title'}</div>
        </td>
        <td>
          <div class="review-comment" title="${review.comment}">
            ${review.comment || 'No comment'}
          </div>
        </td>
        <td>
          <small>${formatDate(review.date)}</small>
        </td>
        <td>
          ${review.verified ? 
            '<i class="bi bi-check-circle-fill verified-badge" title="Verified Purchase"></i>' : 
            '<i class="bi bi-question-circle text-muted" title="Not Verified"></i>'
          }
        </td>
        <td>
          <div class="btn-group btn-group-sm">
            <button class="btn btn-outline-primary" onclick="viewReviewDetails('${review.id}')" title="View Details">
              <i class="bi bi-eye"></i>
            </button>
            <button class="btn btn-outline-success" onclick="approveReview('${review.id}')" title="Approve">
              <i class="bi bi-check"></i>
            </button>
            <button class="btn btn-outline-danger" onclick="deleteReview('${review.id}')" title="Delete">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        </td>
      </tr>
    `).join('');

    renderPagination();
  }

  function generateStars(rating) {
    let stars = '';
    for (let i = 1; i <= 5; i++) {
      if (i <= rating) {
        stars += '<i class="bi bi-star-fill"></i>';
      } else if (i - 0.5 <= rating) {
        stars += '<i class="bi bi-star-half"></i>';
      } else {
        stars += '<i class="bi bi-star"></i>';
      }
    }
    return stars;
  }

  function formatDate(dateString) {
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', { 
      year: 'numeric', 
      month: 'short', 
      day: 'numeric' 
    });
  }

  function updateReviewCount() {
    const count = productReviews.length;
    document.getElementById('reviewCount').textContent = `Showing ${count} review${count !== 1 ? 's' : ''}`;
  }

  function showLoadingState() {
    const tbody = document.getElementById('productReviewsTable');
    tbody.innerHTML = `
      <tr>
        <td colspan="8" class="text-center py-4">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <div class="mt-2">Loading product reviews...</div>
        </td>
      </tr>
    `;
  }

  function showErrorState() {
    const tbody = document.getElementById('productReviewsTable');
    tbody.innerHTML = `
      <tr>
        <td colspan="8" class="text-center py-4">
          <div class="text-danger">
            <i class="bi bi-exclamation-triangle fs-1 d-block mb-2"></i>
            Error loading product reviews
          </div>
        </td>
      </tr>
    `;
  }

  function refreshAirconRatings() {
    loadAirconRatings();
    loadTopProducts();
  }

  function applyFilters() {
    console.log('Applying filters...');
    loadAirconRatings();
