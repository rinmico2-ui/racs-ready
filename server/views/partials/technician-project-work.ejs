  // ── Equipment: Load today's equipment for all project cards ──
  window.pwInitEquipment = async function () {
    const placeholders = document.querySelectorAll('.pw-eq-placeholder');
    if (!placeholders.length) return;
    try {
      const r = await fetch('/api/technician/equipment/today');
      if (!r.ok) return;
      const d = await r.json();
      const byPid = {};
      (d.items || []).forEach(item => {
        const pid = item.projectId?._id || item.projectId;
        if (!byPid[pid]) byPid[pid] = [];
        byPid[pid].push(item);
      });
      placeholders.forEach(el => {
        const pid = el.id.replace('pwEq-', '');
        const items = byPid[pid] || [];
        el.innerHTML = equipmentHtml(pid, items, d.technician);
      });
    } catch (_) {}
  };

  function equipmentHtml(pid, items, tech) {
    if (!items.length) {
      return `<div class="pw-eq"><div class="pw-eq-head"><div class="t"><i class="bi bi-tools"></i> Equipment</div></div><div class="pw-eq-empty">No equipment checked out yet. <button class="pw-eq-btn mt-2" onclick="pwRequestEquipment('${pid}')"><i class="bi bi-plus-lg"></i> Request Equipment</button></div></div>`;
    }
    const checkedOut = items.filter(i => i.status === 'checked_out' || i.status === 'in_use');
    const returned = items.filter(i => i.status === 'returned');
    const damaged = items.filter(i => i.status === 'damaged');
    const consumables = items.filter(i => i.consumable);

    const topStatus = checkedOut.length ? 'checked_out' : (damaged.length ? 'damaged' : 'returned');
    const topLabel = { checked_out:'Checked Out', in_use:'In Use', returned:'Returned', damaged:'Damaged' }[topStatus] || 'Reserved';

    const eqItems = checkedOut.length ? checkedOut : (returned.length ? returned : items);

    let html = `<div class="pw-eq"><div class="pw-eq-head"><div class="t"><i class="bi bi-tools"></i> Equipment</div><span class="badge ${topStatus}">${topLabel}</span></div><div class="pw-eq-list">`;
    eqItems.forEach(item => {
      const st = item.status;
      const label = { reserved:'Ready', checked_out:'Issued', in_use:'In Use', returned:'Returned', damaged:'Damaged', lost:'Lost' }[st] || st;
      html += `<div class="pw-eq-item">
        <div class="ic"><i class="bi bi-wrench"></i></div>
        <div class="nm">${esc(item.equipmentName)}${item.equipmentCode ? ` <small>#${esc(item.equipmentCode)}</small>` : ''}${item.consumable ? ' <small style="color:#d97706;">(consumable)</small>' : ''}</div>
        <span class="st ${st}">${label}</span>
      </div>`;
    });
    // Show consumables separately
    if (consumables.length) {
      html += `<div class="pw-eq-consumable"><div class="t">Consumables</div><div class="pw-eq-list">`;
      consumables.forEach(item => {
        html += `<div class="pw-eq-item">
          <div class="ic"><i class="bi bi-droplet"></i></div>
          <div class="nm">${esc(item.equipmentName)}${item.equipmentCode ? ` <small>#${esc(item.equipmentCode)}</small>` : ''}</div>
          <span class="st ${item.status}">${item.consumableUsed > 0 ? `Used ${item.consumableUsed}` : '×'+item.quantity}</span>
        </div>`;
      });
      html += `</div></div>`;
    }
    // Action buttons
    if (checkedOut.length) {
      html += `<div class="pw-eq-actions">
        <button class="pw-eq-btn success" onclick="pwReturnEquipment('${pid}')"><i class="bi bi-box2-check"></i> Return All</button>
        <button class="pw-eq-btn danger" onclick="pwDamageEquipment('${pid}')"><i class="bi bi-exclamation-triangle"></i> Report Damage</button>
      </div>`;
    } else if (!items.length || items.every(i => i.status === 'returned' || i.status === 'damaged')) {
      html += `<div class="pw-eq-actions">
        <button class="pw-eq-btn" onclick="pwRequestEquipment('${pid}')"><i class="bi bi-plus-lg"></i> Request Equipment</button>
      </div>`;
    }
    html += `</div>`;
    return html;
  }

  // ── Request Equipment Modal ──
  window.pwRequestEquipment = async function (pid) {
    try {
      const tr = await fetch(`/api/projects/${pid}/equipment/available-tools`);
      const td = tr.ok ? await tr.json() : { tools: [] };
      if (!td.tools.length) { toast('No tools available in inventory', 'error'); return; }

      const overlay = document.createElement('div'); overlay.className = 'pw-modal-overlay';
      overlay.innerHTML = `
        <div class="pw-modal">
          <h5><i class="bi bi-tools me-2" style="color:var(--pw-brand);"></i>Request Equipment</h5>
          <p style="font-size:.78rem;color:var(--pw-muted);margin-bottom:.75rem;">Select tools and consumables needed for today.</p>
          <div style="max-height:300px;overflow-y:auto;border:1px solid var(--pw-line-2);border-radius:var(--pw-radius-xs);padding:.35rem;" id="eqToolList">
            ${td.tools.map(t => `
              <label style="display:flex;align-items:center;gap:.5rem;padding:.3rem .4rem;cursor:pointer;border-radius:4px;font-size:.78rem;transition:background .15s;" onmouseenter="this.style.background='#f8fafc'" onmouseleave="this.style.background=''">
                <input type="checkbox" class="eq-tool-cb" value='${JSON.stringify({ equipmentId: t._id, equipmentName: t.name, equipmentCode: t.code, consumable: (t.category||'').toLowerCase() === 'consumable' })}'>
                <span><b>${esc(t.name)}</b>${t.code ? ` <small style="color:var(--pw-muted);">#${esc(t.code)}</small>` : ''}<br><small style="color:var(--pw-muted);">${esc(t.category||'')} ${t.brand ? '· ' + esc(t.brand) : ''}</small></span>
              </label>
            `).join('')}
          </div>
          <div class="d-flex gap-2 justify-content-end mt-3">
            <button class="pw-btn" onclick="this.closest('.pw-modal-overlay').remove()">Cancel</button>
            <button class="pw-btn primary" id="eqRequestBtn"><i class="bi bi-send"></i> Request Selected</button>
          </div>
        </div>`;
      document.body.appendChild(overlay);
      overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
      overlay.querySelector('#eqRequestBtn').addEventListener('click', async () => {
        const items = [...overlay.querySelectorAll('.eq-tool-cb:checked')].map(cb => JSON.parse(cb.value));
        if (!items.length) { toast('Select at least one item', 'error'); return; }
        try {
          await api(`/api/projects/${pid}/equipment/request`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ items }) });
          toast('Equipment requested — awaiting issue from admin');
          overlay.remove();
          window.__loadProjectWork();
        } catch (e) { toast(e.message, 'error'); }
      });
    } catch (e) { toast('Failed to load tools', 'error'); }
  };

  // ── Return Equipment ──
  window.pwReturnEquipment = async function (pid) {
    try {
      const r = await fetch(`/api/projects/${pid}/equipment`);
      if (!r.ok) throw new Error('Failed to load');
      const d = await r.json();
      const active = d.assignments.filter(a => a.status === 'checked_out' || a.status === 'in_use');
      if (!active.length) { toast('No equipment to return', 'error'); return; }

      const overlay = document.createElement('div'); overlay.className = 'pw-modal-overlay';
      overlay.innerHTML = `
        <div class="pw-modal">
          <h5><i class="bi bi-box2-check me-2" style="color:var(--pw-ok);"></i>Return Equipment</h5>
          <p style="font-size:.78rem;color:var(--pw-muted);margin-bottom:.75rem;">Confirm return of the following items:</p>
          <div style="border:1px solid var(--pw-line-2);border-radius:var(--pw-radius-xs);padding:.5rem;">
            ${active.map(i => `
              <label style="display:flex;align-items:center;gap:.5rem;padding:.3rem .4rem;font-size:.78rem;">
                <input type="checkbox" class="eq-return-cb" value="${i._id}" checked>
                <span><b>${esc(i.equipmentName)}</b>${i.equipmentCode ? ` <small>#${esc(i.equipmentCode)}</small>` : ''}</span>
              </label>
            `).join('')}
          </div>
          <div class="mt-2">
            <label style="font-size:.7rem;font-weight:600;color:var(--pw-muted);">Condition</label>
            <select id="eqReturnCondition" class="form-select form-select-sm mt-1">
              <option value="good">Good — returned in good condition</option>
              <option value="fair">Fair — minor wear and tear</option>
              <option value="needs_repair">Needs repair</option>
            </select>
          </div>
          <div class="d-flex gap-2 justify-content-end mt-3">
            <button class="pw-btn" onclick="this.closest('.pw-modal-overlay').remove()">Cancel</button>
            <button class="pw-btn success" id="eqReturnBtn"><i class="bi bi-check-lg"></i> Return Selected</button>
          </div>
        </div>`;
      document.body.appendChild(overlay);
      overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
      overlay.querySelector('#eqReturnBtn').addEventListener('click', async () => {
        const ids = [...overlay.querySelectorAll('.eq-return-cb:checked')].map(cb => cb.value);
        if (!ids.length) { toast('Select items to return', 'error'); return; }
        const condition = overlay.querySelector('#eqReturnCondition').value;
        try {
          await api(`/api/projects/${pid}/equipment/return`, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ assignmentIds: ids, condition }) });
          toast('Equipment returned');
          overlay.remove();
          window.__loadProjectWork();
        } catch (e) { toast(e.message, 'error'); }
      });
    } catch (e) { toast('Failed', 'error'); }
  };

  // ── Report Damage ──
  window.pwDamageEquipment = async function (pid) {
    try {
      const r = await fetch(`/api/projects/${pid}/equipment`);
      if (!r.ok) throw new Error('Failed to load');
      const d = await r.json();
      const active = d.assignments.filter(a => a.status === 'checked_out' || a.status === 'in_use');
      if (!active.length) { toast('No equipment to report', 'error'); return; }

      const overlay = document.createElement('div'); overlay.className = 'pw-modal-overlay';
      overlay.innerHTML = `
        <div class="pw-modal">
          <h5 style="color:var(--pw-danger);"><i class="bi bi-exclamation-triangle me-2"></i>Report Damage</h5>
          <p style="font-size:.78rem;color:var(--pw-muted);margin-bottom:.75rem;">Select the damaged item and describe the issue.</p>
          <div style="border:1px solid var(--pw-line-2);border-radius:var(--pw-radius-xs);padding:.5rem;">
            ${active.map(i => `
              <label style="display:flex;align-items:center;gap:.5rem;padding:.3rem .4rem;font-size:.78rem;">
                <input type="radio" name="eqDamageItem" class="eq-damage-radio" value="${i._id}" ${active.length === 1 ? 'checked' : ''}>
                <span><b>${esc(i.equipmentName)}</b>${i.equipmentCode ? ` <small>#${esc(i.equipmentCode)}</small>` : ''}</span>
              </label>
            `).join('')}
          </div>
          <div class="mt-2">
            <label style="font-size:.7rem;font-weight:600;color:var(--pw-muted);">Describe the damage</label>
            <textarea id="eqDamageDesc" class="form-control form-control-sm mt-1" rows="2" placeholder="e.g., Broken handle, cracked casing..."></textarea>
          </div>
          <div class="d-flex gap-2 justify-content-end mt-3">
            <button class="pw-btn" onclick="this.closest('.pw-modal-overlay').remove()">Cancel</button>
            <button class="pw-btn danger" id="eqDamageBtn"><i class="bi bi-flag"></i> Report Damage</button>
          </div>
        </div>`;
      document.body.appendChild(overlay);
      overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
      overlay.querySelector('#eqDamageBtn').addEventListener('click', async () => {
        const sel = overlay.querySelector('.eq-damage-radio:checked');
        if (!sel) { toast('Select an item', 'error'); return; }
        const desc = overlay.querySelector('#eqDamageDesc').value.trim();
        try {
          await api(`/api/projects/${pid}/equipment/damage`, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ assignmentId: sel.value, description: desc || 'Damaged during work' }) });
          toast('Damage reported — admin notified');
          overlay.remove();
          window.__loadProjectWork();
        } catch (e) { toast(e.message, 'error'); }
      });
    } catch (e) { toast('Failed', 'error'); }
  };

  // ── Live updates from lead / team phase changes ──
  try {
    if (window.socket && typeof window.socket.on === 'function') {
      window.socket.on('project:phase', function () { if (typeof window.__loadProjectWork === 'function') window.__loadProjectWork(); });
      window.socket.on('project:team-status', function () { if (typeof window.__loadProjectWork === 'function') window.__loadProjectWork(); });
    }
  } catch (_) {}
})();
</script>

<script>
// Wrap load to (a) cache data for the drawer and (b) init live maps.
(function () {
  const real = window.__loadProjectWork;
  window.__loadProjectWork = async function () {
    await real();
    // Cache full payload for the details drawer.
    try {
      const data = await (await fetch('/api/technician/projects')).json();
      window.__pwData = data.assignments || [];
    } catch (_) {}
    // Initialize any queued maps now that cards are in the DOM.
    window.pwInitMaps();
    // Load equipment for each project card.
    if (typeof window.pwInitEquipment === 'function') window.pwInitEquipment();
  };
  // Re-init maps whenever the assignments page switches to projects mode.
  if (typeof window.__pwOnProjectMode === 'function') window.__pwOnProjectMode();
})();
</script>

