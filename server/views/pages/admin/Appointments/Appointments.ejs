              </div>
              <small class="text-muted">Awaiting confirmation</small>
            </div>
            <div class="kpi-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
              <i class="bi bi-hourglass-split text-white"></i>
            </div>
          </div>
          <div class="kpi-sparkline-container">
            <canvas id="kpiSparkPending" height="40"></canvas>
          </div>
        </div>
      </div>

      <!-- Completed KPI -->
      <div class="col-lg col-md-6">
        <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="300">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
              <h6 class="text-muted mb-1" style="font-size: 0.85rem; font-weight: 500;">Completed</h6>
              <div class="d-flex align-items-baseline gap-2">
                <span class="h3 mb-0 fw-bold text-dark" id="kpi-completed-combined">—</span>
              </div>
              <div class="badge bg-success-subtle text-success fs-7" id="badge-completed-combined">
                —
              </div>
              <small class="text-muted">Finished today</small>
            </div>
            <div class="kpi-icon" style="background: linear-gradient(135deg, #10b981, #059669);">
              <i class="bi bi-check-circle-fill text-white"></i>
            </div>
          </div>
          <div class="kpi-sparkline-container">
            <canvas id="kpiSparkCompleted" height="40"></canvas>
          </div>
        </div>
      </div>

      <!-- Cancelled KPI -->
      <div class="col-lg col-md-6">
        <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="400">
