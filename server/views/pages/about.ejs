<!-- About Us — Premium Hero -->
<section class="about-hero position-relative" style="overflow:hidden;">
  <div class="about-hero-bg"></div>
  <div class="about-hero-particles" id="aboutParticles"></div>
  <div class="about-grid-overlay"></div>
  <div class="container position-relative about-container" style="z-index:2;">
    <div class="row align-items-center g-5">
      <div class="col-lg-5" data-aos="fade-right" data-aos-duration="800">
        <div class="about-img-wrapper">
          <div class="about-img-glow"></div>
          <div class="about-img-frame">
            <img src="/images/staff/boss.jpg" alt="Owner — CALIDRO RACS" class="about-img" onerror="this.src='/images/technicianWork/tech2.jpg'">
            <div class="about-img-overlay"></div>
          </div>
          <div class="about-img-badge" data-aos="zoom-in" data-aos-delay="400">
            <div class="about-badge-icon"><i class="bi bi-award-fill"></i></div>
            <div class="about-badge-text">
              <span class="about-badge-number"><%= Number((typeof publicStats === 'object' && publicStats && publicStats.yearsExperience) || 0).toLocaleString('en-PH') %></span>
              <span class="about-badge-label">Years of Excellence</span>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-7" data-aos="fade-left" data-aos-duration="800" data-aos-delay="150">
        <div class="about-content">
          <div class="d-flex flex-wrap gap-2 mb-4">
            <span class="about-chip about-chip-primary" data-aos="fade-up" data-aos-delay="200">
              <i class="bi bi-star-fill"></i> Our Story
            </span>
            <span class="about-chip about-chip-outline" data-aos="fade-up" data-aos-delay="250">
              <i class="bi bi-shield-check"></i> Trusted Since 2014
            </span>
          </div>
          <h1 class="about-title" data-aos="fade-up" data-aos-delay="300">
            About <span class="about-title-accent"><%= locals.companyName || 'CALIDRO RACS' %></span>
          </h1>
          <p class="about-desc" data-aos="fade-up" data-aos-delay="350">
            Trusted cooling & technical services built on craftsmanship, transparent pricing, and responsive care. From humble beginnings, we now support thousands of homes and businesses across Nueva Ecija.
          </p>

          <div class="about-owner-card" data-aos="fade-up" data-aos-delay="400">
            <div class="d-flex flex-wrap gap-3 align-items-center">
              <div class="about-owner-avatar">
                <div class="about-avatar-ring"></div>
                <div class="about-avatar-icon"><i class="bi bi-person-badge"></i></div>
              </div>
              <div>
                <p class="about-owner-eyebrow">Meet the Owner</p>
                <h5 class="about-owner-name">Edmon Calidro</h5>
                <div class="d-flex flex-wrap gap-2">
                  <span class="about-role-pill">Proprietor</span>
                  <span class="about-role-pill">Technician</span>
                  <span class="about-role-pill">Owner</span>
                </div>
              </div>
            </div>
            <div class="about-quote-divider"></div>
            <p class="about-owner-quote">
              "Every project reflects our passion for quality workmanship. We pair technical expertise with genuine care so every client feels supported before, during, and after service."
            </p>
          </div>

          <div class="d-flex flex-wrap gap-3 align-items-center" data-aos="fade-up" data-aos-delay="450">
            <a href="/core-service" class="about-btn-primary">
              <span>Explore Services</span>
              <i class="bi bi-arrow-right"></i>
            </a>
            <div class="d-flex gap-2">
              <a href="#" class="about-social-pill" aria-label="Facebook">
                <i class="bi bi-facebook"></i>
              </a>
              <a href="#" class="about-social-pill" aria-label="Instagram">
                <i class="bi bi-instagram"></i>
              </a>
              <a href="#" class="about-social-pill" aria-label="YouTube">
                <i class="bi bi-youtube"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Enterprise Info Bar -->
<section class="about-info-bar">
  <div class="container">
    <div class="row g-3">
      <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
        <div class="about-info-card">
          <div class="about-info-icon about-info-icon-hours">
            <i class="bi bi-clock-fill"></i>
          </div>
          <div class="about-info-content">
            <p class="about-info-label">Business Hours</p>
            <p class="about-info-value"><%= locals.businessHours ? businessHours.summary : 'Mon–Sat · 8:00 AM – 6:00 PM' %></p>
            <p class="about-info-sub"><%= locals.businessHours ? businessHours.note : 'Reach us within business hours' %></p>
          </div>
          <div class="about-info-shine"></div>
        </div>
      </div>
      <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
        <div class="about-info-card">
          <div class="about-info-icon about-info-icon-address">
            <i class="bi bi-geo-alt-fill"></i>
          </div>
          <div class="about-info-content">
            <p class="about-info-label">Address</p>
            <p class="about-info-value"><%= locals.companyAddress || 'San Leonardo, Nueva Ecija' %></p>
            <p class="about-info-sub">Drop by or schedule on-site service</p>
          </div>
          <div class="about-info-shine"></div>
        </div>
      </div>
      <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
        <div class="about-info-card">
          <div class="about-info-icon about-info-icon-phone">
            <i class="bi bi-telephone-fill"></i>
          </div>
          <div class="about-info-content">
            <p class="about-info-label">Hotline</p>
            <p class="about-info-value"><%= locals.companyPhone || '0965 605 6495' %></p>
            <p class="about-info-sub">Quick bookings & urgent support</p>
          </div>
          <div class="about-info-shine"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mission + Values -->
<section class="about-body">
  <div class="container">
    <div class="row g-4 align-items-stretch mb-4">
      <div class="col-lg-6" data-aos="fade-right" data-aos-duration="700">
        <div class="about-card about-card-primary h-100">
          <div class="about-card-accent"></div>
          <div class="d-flex align-items-center gap-3 mb-4">
            <div class="about-card-icon about-card-icon-mission">
              <i class="bi bi-bullseye"></i>
            </div>
            <div>
              <p class="about-card-eyebrow">Our Mission</p>
              <h4 class="about-card-title">Craftsmanship & Care</h4>
            </div>
          </div>
          <p class="about-card-text">
            To provide dependable, efficient, and transparent air conditioning and appliance services backed by skilled technicians, premium materials, and intelligent scheduling.
          </p>
          <div class="about-values-list">
            <div class="about-value-item" data-aos="fade-up" data-aos-delay="100">
              <div class="about-value-icon"><i class="bi bi-check-circle-fill"></i></div>
              <span>Professionalism & training</span>
            </div>
            <div class="about-value-item" data-aos="fade-up" data-aos-delay="150">
              <div class="about-value-icon"><i class="bi bi-check-circle-fill"></i></div>
              <span>Honest, upfront pricing</span>
            </div>
            <div class="about-value-item" data-aos="fade-up" data-aos-delay="200">
              <div class="about-value-icon"><i class="bi bi-check-circle-fill"></i></div>
              <span>Customer-first support</span>
            </div>
            <div class="about-value-item" data-aos="fade-up" data-aos-delay="250">
              <div class="about-value-icon"><i class="bi bi-check-circle-fill"></i></div>
              <span>Warranty-backed work</span>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-6" data-aos="fade-left" data-aos-duration="700">
        <div class="about-card about-card-secondary h-100">
          <div class="d-flex align-items-center gap-3 mb-4">
            <div class="about-card-icon about-card-icon-who">
              <i class="bi bi-building"></i>
            </div>
            <div>
              <p class="about-card-eyebrow">Who We Are</p>
              <h4 class="about-card-title">Family-operated & Local</h4>
            </div>
          </div>
          <p class="about-card-text">
            CALIDRO RACS is a family-run team serving Nueva Ecija with aircon installation, maintenance, and appliance repair. We invest in new tools, continuous training, and respectful service.
          </p>
          <div class="about-values-list">
            <div class="about-value-item" data-aos="fade-up" data-aos-delay="100">
              <div class="about-value-icon about-value-icon-star"><i class="bi bi-star-fill"></i></div>
              <span>Experienced technicians</span>
            </div>
            <div class="about-value-item" data-aos="fade-up" data-aos-delay="150">
              <div class="about-value-icon about-value-icon-location"><i class="bi bi-geo-alt-fill"></i></div>
              <span>Local & responsive crew</span>
            </div>
            <div class="about-value-item" data-aos="fade-up" data-aos-delay="200">
              <div class="about-value-icon about-value-icon-clock"><i class="bi bi-clock-fill"></i></div>
              <span>Reliable scheduling & reminders</span>
            </div>
            <div class="about-value-item" data-aos="fade-up" data-aos-delay="250">
              <div class="about-value-icon about-value-icon-shield"><i class="bi bi-shield-lock-fill"></i></div>
              <span>Proof-of-work + warranty</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Our Story Timeline -->
    <div class="about-story-section" data-aos="fade-up" data-aos-delay="150">
      <div class="about-card about-card-full">
        <div class="about-card-accent-bar"></div>
        <div class="d-flex align-items-center gap-3 mb-4 mt-2">
          <div class="about-card-icon about-card-icon-story">
            <i class="bi bi-book"></i>
          </div>
          <h4 class="about-card-title mb-0">Our Story</h4>
        </div>
        
        <div class="about-timeline">
          <div class="about-timeline-item" data-aos="fade-up" data-aos-delay="100">
            <div class="about-timeline-marker">
              <div class="about-timeline-dot"></div>
            </div>
            <div class="about-timeline-content">
              <h5 class="about-timeline-title">The Beginning</h5>
              <p class="about-timeline-text">From humble beginnings we focused on trust, craftsmanship, and responsive support. What started as a small family venture has grown into a trusted regional team thanks to referrals and long-term relationships.</p>
            </div>
          </div>
          <div class="about-timeline-item" data-aos="fade-up" data-aos-delay="200">
            <div class="about-timeline-marker">
              <div class="about-timeline-dot"></div>
            </div>
            <div class="about-timeline-content">
              <h5 class="about-timeline-title">Today & Beyond</h5>
              <p class="about-timeline-text">We combine seasoned technicians with scheduling software, real-time updates, and strict QA checklists so every visit is predictable and premium. Each home we serve is a relationship we intend to keep.</p>
            </div>
          </div>
        </div>

        <div class="about-story-cta" data-aos="fade-up" data-aos-delay="300">
          <a href="/contact" class="about-btn-outline">
            <i class="bi bi-chat-dots"></i>
            <span>Get in Touch</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════════════════════ */
  .about-hero {
    background: linear-gradient(160deg, #e0f2fe 0%, #f0fdf4 35%, #e0e7ff 70%, #ede9fe 100%);
    color: #0f172a;
    padding: 100px 0 80px;
    min-height: 600px;
    display: flex;
    align-items: center;
  }

  .about-hero-bg {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 800px 600px at 5% 15%, rgba(37,99,235,.08) 0%, transparent 65%),
      radial-gradient(ellipse 700px 500px at 95% 90%, rgba(59,130,246,.05) 0%, transparent 65%),
      radial-gradient(ellipse 400px 400px at 50% 50%, rgba(96,165,250,.03) 0%, transparent 65%);
    pointer-events: none;
    animation: aboutBgPulse 8s ease-in-out infinite alternate;
  }

  @keyframes aboutBgPulse {
    0% { opacity: 1; }
    100% { opacity: 0.8; }
  }

  .about-hero-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .about-grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
  }

  .about-container { padding: 0 15px; }

  /* ── Image Section ── */
  .about-img-wrapper {
    position: relative;
    max-width: 440px;
    margin: 0 auto;
  }

  .about-img-glow {
    position: absolute;
    inset: -20px;
    border-radius: 28px;
    background: linear-gradient(135deg, rgba(96,165,250,.25), rgba(59,130,246,.15), rgba(37,99,235,.1));
    filter: blur(30px);
    z-index: -1;
    animation: aboutGlow 4s ease-in-out infinite alternate;
  }

  @keyframes aboutGlow {
    0% { filter: blur(30px); opacity: 0.8; }
    100% { filter: blur(40px); opacity: 1; }
  }

  .about-img-frame {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    border: 2px solid rgba(226,232,240,.8);
    transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .about-img-frame:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: rgba(96,165,250,.3);
    box-shadow: 0 30px 60px rgba(37,99,235,.3);
  }

  .about-img {
    width: 100%;
    height: 450px;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .about-img-frame:hover .about-img {
    transform: scale(1.05);
  }

  .about-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(2,6,23,.6) 100%);
    pointer-events: none;
  }

  .about-img-badge {
    position: absolute;
    bottom: -20px;
    right: -10px;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    border-radius: 16px;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 16px 40px rgba(37,99,235,.4);
    border: 2px solid rgba(255,255,255,.15);
    animation: aboutBadgeFloat 3s ease-in-out infinite;
  }

  @keyframes aboutBadgeFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .about-badge-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255,255,255,.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    color: #fbbf24;
  }

  .about-badge-text {
    display: flex;
    flex-direction: column;
  }

  .about-badge-number {
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1;
    color: #fff;
  }

  .about-badge-label {
    font-size: .7rem;
    font-weight: 600;
    color: rgba(255,255,255,.8);
    text-transform: uppercase;
    letter-spacing: .05em;
  }

  /* ── Content Section ── */
  .about-content { max-width: 580px; }

  .about-chip {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
    padding: 8px 18px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.3s ease;
  }

  .about-chip-primary {
    background: rgba(37,99,235,.1);
    border: 1px solid rgba(96,165,250,.3);
    color: #1d4ed8;
  }

  .about-chip-outline {
    background: rgba(15,23,42,.05);
    border: 1px solid rgba(15,23,42,.12);
    color: #475569;
  }

  .about-chip:hover {
    transform: translateY(-2px);
  }

  .about-chip-primary:hover {
    background: rgba(37,99,235,.3);
    box-shadow: 0 8px 20px rgba(37,99,235,.3);
  }

  .about-chip-outline:hover {
    background: rgba(37,99,235,.08);
    border-color: rgba(37,99,235,.25);
  }

  .about-title {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -1.5px;
    margin-bottom: 20px;
    line-height: 1.1;
  }

  .about-title-accent {
    background: linear-gradient(135deg, #60a5fa, #3b82f6, #2563eb);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    position: relative;
  }

  .about-title-accent::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #3b82f6, #60a5fa);
    border-radius: 999px;
    opacity: 0.5;
  }

  .about-desc {
    font-size: 1.1rem;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  /* ── Owner Card ── */
  .about-owner-card {
    background: rgba(255,255,255,.85);
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 28px;
    margin-bottom: 32px;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .about-owner-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #2563eb, #3b82f6, #60a5fa);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .about-owner-card:hover {
    background: #fff;
    border-color: rgba(96,165,250,.3);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,.08);
  }

  .about-owner-card:hover::before {
    opacity: 1;
  }

  .about-owner-avatar {
    position: relative;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
  }

  .about-avatar-ring {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #3b82f6);
    animation: aboutRingRotate 4s linear infinite;
  }

  @keyframes aboutRingRotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .about-avatar-icon {
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1e3a8a, #2563eb);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: #fff;
    z-index: 1;
  }

  .about-owner-eyebrow {
    text-transform: uppercase;
    letter-spacing: .15em;
    font-size: .68rem;
    font-weight: 800;
    color: #64748b;
    margin-bottom: 4px;
  }

  .about-owner-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 8px;
  }

  .about-role-pill {
    font-size: .72rem;
    font-weight: 600;
    color: #1d4ed8;
    background: rgba(37,99,235,.1);
    border-radius: 999px;
    padding: 4px 12px;
    transition: all 0.3s ease;
  }

  .about-role-pill:hover {
    background: rgba(37,99,235,.2);
    transform: translateY(-1px);
  }

  .about-quote-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, #cbd5e1, transparent);
    margin: 16px 0;
  }

  .about-owner-quote {
    color: #64748b;
    font-size: .92rem;
    line-height: 1.7;
    margin: 0;
    font-style: italic;
    position: relative;
    padding-left: 20px;
    border-left: 2px solid rgba(96,165,250,.3);
  }

  /* ── Buttons ── */
  .about-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #2563eb, #3b82f6);
    color: #fff;
    border: none;
    border-radius: 14px;
    padding: 14px 32px;
    font-weight: 600;
    font-size: .95rem;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 10px 30px rgba(37,99,235,.3);
    position: relative;
    overflow: hidden;
  }

  .about-btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.2), transparent);
    transition: left 0.5s ease;
  }

  .about-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(37,99,235,.4);
    color: #fff;
  }

  .about-btn-primary:hover::before {
    left: 100%;
  }

  .about-btn-primary i {
    transition: transform 0.3s ease;
  }

  .about-btn-primary:hover i {
    transform: translateX(4px);
  }

  .about-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: #3b82f6;
    border: 2px solid rgba(59,130,246,.3);
    border-radius: 14px;
    padding: 12px 28px;
    font-weight: 600;
    font-size: .9rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .about-btn-outline:hover {
    background: rgba(59,130,246,.1);
    border-color: #3b82f6;
    transform: translateY(-2px);
    color: #2563eb;
  }

  .about-social-pill {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    text-decoration: none;
    font-size: 1.1rem;
  }

  .about-social-pill:hover {
    background: rgba(37,99,235,.1);
    border-color: rgba(96,165,250,.4);
