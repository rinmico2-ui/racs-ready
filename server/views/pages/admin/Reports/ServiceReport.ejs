    var g8a = ctx8.getContext('2d').createLinearGradient(0, 0, 0, 300); g8a.addColorStop(0, 'rgba(6,182,212,0.35)'); g8a.addColorStop(1, 'rgba(6,182,212,0.02)');
    var g8b = ctx8.getContext('2d').createLinearGradient(0, 0, 0, 300); g8b.addColorStop(0, 'rgba(139,92,246,0.35)'); g8b.addColorStop(1, 'rgba(139,92,246,0.02)');
    var wtLabels = SA.weeklyData.map(function(d) { return d.week; });
