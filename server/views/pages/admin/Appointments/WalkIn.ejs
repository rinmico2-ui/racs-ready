        <div class="rv-row"><span class="text-muted">Account:</span> <span class="fw-semibold">${customerEmail} · ${state.customerAccountFound ? (state.customerAccountState === "active" ? "Existing verified account" : "Existing account · activation pending") : state.isNewCustomer === true ? "New invited account" : "Not checked"}</span></div>
        <div class="rv-row"><span class="text-muted">Services:</span> <span class="fw-semibold">${state.selectedServices.length ? state.selectedServices.map(item => `${item.name} ×${item.quantity}`).join(', ') : "—"}</span></div>
        <div class="rv-row"><span class="text-muted">Technician:</span> <span class="fw-semibold">${techLabel}</span></div>
        <div class="rv-row"><span class="text-muted">Schedule:</span> <span class="fw-semibold">${scheduleText}</span></div>
        <div class="rv-row"><span class="text-muted">Travel Fare:</span> <span class="fw-semibold">₱${Number(state.travelFare || 0).toFixed(2)}</span></div>
        <div class="rv-row rv-total" style="border-top:2px solid #e2e8f0;margin-top:0.5rem;padding-top:0.75rem"><span class="fw-bold">Estimated Total:</span> <span class="fw-bold text-primary">₱${total.toFixed(2)}</span></div>
        <div class="rv-row"><span class="text-muted">Payment Method:</span> <span class="fw-semibold">CASH (${state.cashPaymentMode === "full" ? "FULL" : "DOWNPAYMENT"})</span></div>
      </div>`;

      const servicesTotalDisplay = document.getElementById("servicesTotalDisplay");
      const travelFareDisplay = document.getElementById("travelFareDisplay");
      const totalFeeDisplay = document.getElementById("totalFeeDisplay");
