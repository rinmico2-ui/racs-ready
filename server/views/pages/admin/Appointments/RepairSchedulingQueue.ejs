        <!-- Preferred Dates -->
        <label class="form-label fw-semibold mb-2">Preferred Repair Dates</label>
        <div class="rsq-preferred-dates mb-3" id="assignPreferredDates"></div>

        <!-- Technician Selection -->
        <label class="form-label fw-semibold mb-2">Select Technician</label>
        <div id="assignTechList">
          <div class="text-muted small">Checking availability...</div>
        </div>

        <!-- Schedule Date/Time -->
        <label class="form-label fw-semibold mb-2" id="adminDateLabel">Repair Date <span class="text-danger">*</span></label>
        <div id="adminDateGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(95px,1fr));gap:8px;margin-bottom:12px;">
          <div class="text-muted small" id="adminDatePlaceholder"><i class="bi bi-hourglass-split me-1"></i>Select a technician to see available dates</div>
        </div>
        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Time Slot <span class="text-danger">*</span>
              <span id="adminTimeWindowHint" class="text-muted fw-normal small ms-1"></span>
            </label>
            <div class="admin-ts-grid" id="adminTimeGrid"></div>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Capacity</label>
            <div id="adminDateCapacity" class="form-control-plaintext text-muted small" style="font-size:0.85rem;padding-top:6px;">-</div>
          </div>
        </div>

        <div class="mt-3">
          <label class="form-label fw-semibold">Notes <small class="text-muted">(optional)</small></label>
