    background: #eff6ff;
    color: #2563eb;
  }
  .pickup-panel .flatpickr-day.selected {
    background: #2563eb;
    color: #fff;
    box-shadow: 0 4px 12px rgba(37,99,235,0.3);
    font-weight: 700;
  }
  .pickup-panel .flatpickr-day.selected:hover {
    background: #1d4ed8;
    color: #fff;
  }
  .pickup-panel .flatpickr-day.disabled,
  .pickup-panel .flatpickr-day.flatpickr-disabled {
    color: #d1d5db !important;
    background: #f9fafb !important;
    cursor: not-allowed !important;
    opacity: 0.5;
    text-decoration: none !important;
  }
</style>

