<div class="admin-dashboard container-fluid py-4 staff-attendance-page inventory-premium">
  <%- include('../../../partials/dashboard-styles') %>

  <style>
    /* ═══════════════════════════════════════════
       ATTENDANCE SETTINGS — Premium Light-Blue Theme
       ═══════════════════════════════════════════ */
    .staff-attendance-page {
      --ss-primary: #0ea5e9;
      --ss-primary-dark: #0284c7;
      --ss-primary-deeper: #0369a1;
      --ss-accent: #38bdf8;
      --ss-light: #e0f2fe;
      --ss-pale: #f0f9ff;
      --ss-text: #0c4a6e;
      --ss-muted: #94a3b8;
      --ss-border: #e2e8f0;
      --ss-radius: 16px;
      --ss-shadow: 0 4px 6px -1px rgba(14,165,233,0.07), 0 2px 4px -2px rgba(14,165,233,0.04);
      --ss-shadow-hover: 0 10px 25px -5px rgba(14,165,233,0.12), 0 4px 6px -4px rgba(14,165,233,0.06);
    }

    .staff-attendance-page .dashboard-hero .hero-sub { color: var(--ss-muted); }

    /* Cards */
    .staff-attendance-page .ss-card {
      background: var(--ss-pale);
      border: 1px solid var(--ss-border);
      border-radius: var(--ss-radius);
      box-shadow: var(--ss-shadow);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      margin-bottom: 1.25rem;
      overflow: hidden;
    }
    .staff-attendance-page .ss-card:hover {
      transform: translateY(-2px); box-shadow: var(--ss-shadow-hover);
    }
    .staff-attendance-page .ss-card-head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid #e2e8f0;
      background: #fff;
    }
    .staff-attendance-page .ss-card-head .ch-title-wrap {
      display: flex; align-items: center; gap: 0.55rem;
    }
    .staff-attendance-page .ss-card-head .ch-icon {
      width: 32px; height: 32px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.9rem; color: #fff; flex-shrink: 0;
    }
    .staff-attendance-page .ch-icon.sky { background: linear-gradient(135deg, var(--ss-primary), var(--ss-accent)); box-shadow: 0 3px 10px rgba(14,165,233,0.25); }
    .staff-attendance-page .ch-icon.emerald { background: linear-gradient(135deg, #059669, #10b981); box-shadow: 0 3px 10px rgba(5,150,105,0.25); }
    .staff-attendance-page .ch-icon.purple { background: linear-gradient(135deg, #7c3aed, #a78bfa); box-shadow: 0 3px 10px rgba(124,58,237,0.25); }
    
    .staff-attendance-page .ss-card-head h3 {
      font-size: 0.92rem; font-weight: 700 !important;
      color: var(--ss-text); margin: 0; font-family: 'Outfit', sans-serif;
    }
    .staff-attendance-page .ss-card-body {
      padding: 1.25rem; background: #fff;
    }

    /* Buttons */
    .staff-attendance-page .btn-ss {
      padding: 0.55rem 1.1rem; border-radius: 10px;
      font-weight: 600 !important; font-size: 0.82rem;
      display: inline-flex; align-items: center; gap: 0.4rem;
      transition: all 0.25s ease; border: none; cursor: pointer;
      text-decoration: none;
    }
    .staff-attendance-page .btn-ss.primary {
      background: linear-gradient(135deg, var(--ss-primary), var(--ss-accent));
      color: #fff; box-shadow: 0 4px 14px rgba(14,165,233,0.3);
    }
    .staff-attendance-page .btn-ss.primary:hover {
      transform: translateY(-1px); box-shadow: 0 6px 20px rgba(14,165,233,0.35);
      color: #fff;
    }
    .staff-attendance-page .btn-ss.outline {
      background: #fff; color: var(--ss-text);
      border: 1.5px solid var(--ss-border);
    }
    .staff-attendance-page .btn-ss.outline:hover {
      border-color: var(--ss-primary); color: var(--ss-primary);
      background: var(--ss-pale); transform: translateY(-1px);
    }

    /* Stats Grid */
    .staff-attendance-page .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }
    .staff-attendance-page .stat-box {
      padding: 1rem;
      border-radius: 12px;
      background: var(--ss-pale);
      border: 1px solid var(--ss-border);
      text-align: center;
    }
    .staff-attendance-page .stat-num {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--ss-text);
      line-height: 1.2;
    }
    .staff-attendance-page .stat-label {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--ss-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Badges */
    .staff-attendance-page .status-badge {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      gap: 0.30rem;
    }
    .staff-attendance-page .badge-present { background: rgba(16, 185, 129, 0.12); color: #059669; }
    .staff-attendance-page .badge-late { background: rgba(245, 158, 11, 0.12); color: #d97706; }
    .staff-attendance-page .badge-absent { background: rgba(239, 68, 68, 0.12); color: #dc2626; }
    .staff-attendance-page .badge-leave { background: rgba(99, 102, 241, 0.12); color: #4f46e5; }
    .staff-attendance-page .badge-half { background: rgba(107, 114, 128, 0.12); color: #4b5563; }

    .staff-attendance-page .availability-badge {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      gap: 0.30rem;
    }
    .staff-attendance-page .badge-avail { background: rgba(16, 185, 129, 0.12); color: #059669; }
    .staff-attendance-page .badge-offline { background: rgba(107, 114, 128, 0.12); color: #4b5563; }
    .staff-attendance-page .badge-assigned { background: rgba(14, 165, 233, 0.12); color: #0284c7; }
    .staff-attendance-page .badge-otw { background: rgba(99, 102, 241, 0.12); color: #4f46e5; }
    .staff-attendance-page .badge-progress { background: rgba(139, 92, 246, 0.12); color: #7c3aed; }
    .staff-attendance-page .badge-unavail { background: rgba(239, 68, 68, 0.12); color: #dc2626; }

    /* Custom select style */
    .staff-attendance-page .action-select {
      font-size: 0.75rem;
      padding: 0.2rem 0.5rem;
      border-radius: 6px;
      border: 1px solid var(--ss-border);
      background-color: #fff;
      color: var(--ss-text);
      cursor: pointer;
      outline: none;
    }

    .staff-attendance-page .action-select:focus {
      border-color: var(--ss-primary);
    }
  </style>

  <style>
    /* Premium inventory styles */
    .inventory-premium { /* scope wrapper */ }

    .inventory-premium .dash-card {
      background: #fff;
      border-radius: 18px;
      padding: 1.5rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      border: 1px solid #f1f5f9;
      display: flex;
      flex-direction: column;
    }
    .inventory-premium .dash-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    }
    .inventory-premium .kpi-title { font-size: 0.75rem; font-weight: 600; color: #64748b; margin-bottom: 6px; }
    .inventory-premium .kpi-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px rgba(0,0,0,0.12);
      flex-shrink: 0;
    }
    .inventory-premium .kpi-icon i { color: #fff !important; font-size: 1.3rem; }
    .inventory-premium .inv-kpi-value { font-size: 1.5rem; font-weight: 700; color: #0f172a; line-height: 1.1; margin-bottom: 8px; }
    .inventory-premium .inv-kpi-currency { font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: flex-start; margin-top: 2px; }
    .inventory-premium .inv-kpi-sub { display: block; font-size: 0.75rem; color: #94a3b8; margin-top: 4px; }
    .inventory-premium .inv-kpi-pill { font-size: 0.7rem; padding: 2px 8px; border-radius: 20px; font-weight: 700; }
    .inventory-premium .kpi-trend { display: inline-flex; align-items: center; gap: 2px; font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 20px; background: #f0fdf4; color: #16a34a; }
    .inventory-premium .kpi-trend i { font-size: 0.7rem; }
    .inventory-premium .inv-kpi-spark-wrap { width: 100%; height: 34px; margin-top: auto; overflow: hidden; }
    .inventory-premium .inv-kpi-spark { display: block; width: 100%; height: 100%; }

    /* Toolbar matching Repair Parts */
    .inventory-premium .rp-toolbar { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 16px 20px; margin-bottom: 20px; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px; }
    .inventory-premium .rp-filter-group { display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 180px; }
    .inventory-premium .rp-filter-group.search { flex: 1.8; }
    .inventory-premium .rp-filter-label { font-size: 0.65rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.6px; }
    .inventory-premium .rp-filter-group .input-group-text { background: #fff; border-color: #e2e8f0; color: #64748b; border-radius: 10px 0 0 10px; height: 42px; }
    .inventory-premium .rp-filter-group .form-control { border-color: #e2e8f0; border-radius: 0 10px 10px 0; height: 42px; }
    .inventory-premium .rp-filter-input { border-radius: 10px; border-color: #e2e8f0; height: 42px; }
    .inventory-premium .rp-filter-btn { height: 42px; border-radius: 10px; padding: 0 20px; font-weight: 600; }

    /* Dense table */
    .inventory-premium .table-dense th,
    .inventory-premium .table-dense td { padding: .55rem .75rem; font-size: .8rem; }
    .inv-pagination { display: flex; gap: .5rem; margin: 0; padding: 0; list-style: none; }
    .inv-pagination .page-item .page-link { padding: 8px 14px; border-radius: 10px; border: 1.5px solid rgba(148,163,184,.3); background: rgba(255,255,255,.8); color: #475569; font-weight: 600; font-size: .85rem; transition: all .3s ease; }
    .inv-pagination .page-item:not(.disabled) .page-link:hover { background: #fff; border-color: #2563eb; color: #2563eb; }
    .inv-pagination .page-item.disabled .page-link { opacity: .5; }
  </style>

  <!-- ═══ HERO ═══ -->
  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-qr-code-scan"></i></div>
        <div>
          <h1>Staff Attendance</h1>
          <p>Manage verified time records for technicians and secretaries from one control center.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <!-- ═══ LEFT COLUMN: QR Code ═══ -->
    <div class="col-lg-5">
      <div class="dash-card h-100">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <div class="kpi-title"><i class="bi bi-qr-code me-1"></i>Daily Attendance QR</div>
            <span class="inv-kpi-sub">Technicians and secretaries scan this code after login to check in.</span>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #0ea5e9, #38bdf8);">
            <i class="bi bi-qr-code"></i>
          </div>
        </div>

        <div class="text-center py-2">
          <h5 class="text-secondary mb-1" id="lblTodayDate">-- -- --</h5>
          <p class="text-muted small mb-3">Today's QR is valid until 9:00 AM cutoff.</p>

          <div class="d-inline-block p-3 bg-white border rounded-3 mb-3 shadow-sm" style="min-height: 250px;">
            <img id="imgQrCode" alt="Daily Attendance QR Code" style="width: 220px; height: 220px; display: none;" />
            <div id="qrLoading" class="d-flex flex-column align-items-center justify-content-center" style="width: 220px; height: 220px;">
              <div class="spinner-border text-sky" role="status"></div>
              <span class="mt-2 text-muted small">Generating Token...</span>
            </div>
          </div>

          <div class="alert alert-info py-2 px-3 small text-start mx-auto mb-3" style="max-width: 320px;">
            <i class="bi bi-info-circle me-1"></i> Cutoff time is <strong>9:00 AM</strong>. Scans after 9:00 AM will be automatically marked as <strong>Late</strong>.
          </div>

          <button id="btnRegenerate" class="btn-ss outline btn-sm"><i class="bi bi-arrow-clockwise"></i> Regenerate</button>
        </div>
      </div>
    </div>

    <!-- ═══ RIGHT COLUMN: Statistics ═══ -->
    <div class="col-lg-7">
      <div class="dash-card h-100">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <div class="kpi-title"><i class="bi bi-bar-chart-line me-1"></i>Today's Attendance Statistics</div>
            <span class="inv-kpi-sub">Live overview of staff check-ins and availability</span>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #059669, #10b981);">
            <i class="bi bi-bar-chart-line"></i>
          </div>
        </div>

        <div class="stats-grid mb-0">
          <div class="dash-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div class="kpi-title">Total Staff</div>
                <div class="d-flex align-items-center gap-2">
                  <span class="inv-kpi-value mb-0" id="statTotal">0</span>
                  <span class="kpi-trend"><i class="bi bi-arrow-up"></i>+0.0%</span>
                </div>
              </div>
              <div class="kpi-icon" style="background: linear-gradient(135deg, #2563eb, #1d4ed8);">
                <i class="bi bi-people"></i>
              </div>
            </div>
            <div class="inv-kpi-spark-wrap"><canvas class="inv-kpi-spark" id="attSparkTotal"></canvas></div>
          </div>
          <div class="dash-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div class="kpi-title">Present</div>
                <div class="d-flex align-items-center gap-2">
                  <span class="inv-kpi-value text-success mb-0" id="statPresent">0</span>
                  <span class="kpi-trend"><i class="bi bi-arrow-up"></i>+0.0%</span>
                </div>
              </div>
              <div class="kpi-icon" style="background: linear-gradient(135deg, #10b981, #059669);">
                <i class="bi bi-check-circle"></i>
              </div>
            </div>
            <div class="inv-kpi-spark-wrap"><canvas class="inv-kpi-spark" id="attSparkPresent"></canvas></div>
          </div>
          <div class="dash-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div class="kpi-title">Late</div>
                <div class="d-flex align-items-center gap-2">
                  <span class="inv-kpi-value text-warning mb-0" id="statLate">0</span>
                  <span class="kpi-trend"><i class="bi bi-arrow-up"></i>+0.0%</span>
                </div>
              </div>
              <div class="kpi-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
                <i class="bi bi-clock-history"></i>
              </div>
            </div>
            <div class="inv-kpi-spark-wrap"><canvas class="inv-kpi-spark" id="attSparkLate"></canvas></div>
          </div>
          <div class="dash-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div class="kpi-title">Absent</div>
                <div class="d-flex align-items-center gap-2">
                  <span class="inv-kpi-value text-danger mb-0" id="statAbsent">0</span>
                  <span class="kpi-trend"><i class="bi bi-arrow-down"></i>-0.0%</span>
                </div>
              </div>
              <div class="kpi-icon" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
                <i class="bi bi-x-circle"></i>
              </div>
            </div>
            <div class="inv-kpi-spark-wrap"><canvas class="inv-kpi-spark" id="attSparkAbsent"></canvas></div>
          </div>
          <div class="dash-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div class="kpi-title">On Leave</div>
                <div class="d-flex align-items-center gap-2">
                  <span class="inv-kpi-value text-primary mb-0" id="statLeave">0</span>
                  <span class="kpi-trend"><i class="bi bi-arrow-up"></i>+0.0%</span>
                </div>
              </div>
              <div class="kpi-icon" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                <i class="bi bi-calendar-check"></i>
              </div>
            </div>
            <div class="inv-kpi-spark-wrap"><canvas class="inv-kpi-spark" id="attSparkLeave"></canvas></div>
          </div>
          <div class="dash-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div class="kpi-title">Checked Out</div>
                <div class="d-flex align-items-center gap-2">
                  <span class="inv-kpi-value text-secondary mb-0" id="statHalf">0</span>
                  <span class="kpi-trend"><i class="bi bi-arrow-down"></i>-0.0%</span>
                </div>
              </div>
              <div class="kpi-icon" style="background: linear-gradient(135deg, #64748b, #475569);">
                <i class="bi bi-box-arrow-right"></i>
              </div>
            </div>
            <div class="inv-kpi-spark-wrap"><canvas class="inv-kpi-spark" id="attSparkHalf"></canvas></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ TOOLBAR ═══ -->
  <div class="rp-toolbar mt-4">
    <div class="rp-filter-group search">
      <label class="rp-filter-label" for="attendanceSearchInput"><i class="bi bi-search me-1"></i>Search Staff</label>
      <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" id="attendanceSearchInput" placeholder="Name or email" />
      </div>
    </div>
    <div class="rp-filter-group">
      <label class="rp-filter-label" for="attendanceRoleFilter"><i class="bi bi-person-badge me-1"></i>Role</label>
      <select class="form-select rp-filter-input" id="attendanceRoleFilter">
        <option value="all">All Roles</option>
        <option value="technician">Technician</option>
        <option value="secretary">Secretary</option>
      </select>
    </div>
    <div class="rp-filter-group">
      <label class="rp-filter-label" for="attendanceStatusFilter"><i class="bi bi-funnel me-1"></i>Attendance</label>
      <select class="form-select rp-filter-input" id="attendanceStatusFilter">
        <option value="all">All Status</option>
        <option value="Present">Present</option>
        <option value="Late">Late</option>
        <option value="Absent">Absent</option>
        <option value="On Leave">On Leave</option>
        <option value="Sick Leave">Sick Leave</option>
        <option value="Checked Out">Checked Out</option>
      </select>
    </div>
    <button class="btn btn-primary rp-filter-btn" type="button" id="attendanceFilterBtn" title="Apply filters"><i class="bi bi-funnel-fill me-2"></i>Filter</button>
  </div>

  <!-- ═══ FULL WIDTH: TODAY'S LOG ═══ -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h6 class="mb-0 fw-bold">Today's Roster & Check-ins</h6>
      <span class="text-muted small fw-normal" id="rosterRecordCount">0 total records</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover table-dense align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th class="ps-4">Staff Member</th>
            <th>Role</th>
            <th>Email</th>
            <th>Attendance Status</th>
            <th>Availability Status</th>
            <th>Check-in Time</th>
            <th>Method</th>
            <th class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody id="tblRosterBody">
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">
              <div class="spinner-border spinner-border-sm text-sky me-2" role="status"></div>
              Loading roster...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="card-footer bg-white py-3 border-top" id="attendanceFooter"></div>
  </div>

  <div class="card border-0 shadow-sm mt-4">
    <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <h6 class="mb-1 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Attendance History</h6>
        <div class="small text-muted">Historical daily time records used for payroll review and audit.</div>
      </div>
      <span class="badge rounded-pill text-bg-light" id="historyRecordCount">0 records</span>
    </div>
    <div class="card-body border-bottom">
      <div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label small fw-semibold" for="historySearch">Employee</label><input class="form-control" id="historySearch" placeholder="Name or email"></div>
        <div class="col-6 col-md-2"><label class="form-label small fw-semibold" for="historyFrom">From</label><input type="date" class="form-control" id="historyFrom"></div>
        <div class="col-6 col-md-2"><label class="form-label small fw-semibold" for="historyTo">To</label><input type="date" class="form-control" id="historyTo"></div>
        <div class="col-6 col-md-2"><label class="form-label small fw-semibold" for="historyRole">Role</label><select class="form-select" id="historyRole"><option value="all">All roles</option><option value="technician">Technician</option><option value="secretary">Secretary</option></select></div>
        <div class="col-6 col-md-2"><label class="form-label small fw-semibold" for="historyStatus">Status</label><select class="form-select" id="historyStatus"><option value="all">All statuses</option><option>Present</option><option>Late</option><option>Absent</option><option>On Leave</option><option>Sick Leave</option><option>Checked Out</option></select></div>
        <div class="col-md-1"><button class="btn btn-primary w-100" id="historyApply" title="Apply history filters"><i class="bi bi-search"></i></button></div>
      </div>
      <div class="d-flex flex-wrap gap-3 mt-3 small text-muted">
        <span><strong class="text-dark" id="historyPresent">0</strong> present/complete</span>
        <span><strong class="text-dark" id="historyLate">0</strong> late</span>
        <span><strong class="text-dark" id="historyHours">0</strong> total hours</span>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-hover table-dense align-middle mb-0">
        <thead class="bg-light"><tr><th class="ps-4">Date</th><th>Staff Member</th><th>Role</th><th>Status</th><th>Check In</th><th>Check Out</th><th>Hours</th><th>Source</th></tr></thead>
        <tbody id="historyBody"><tr><td colspan="8" class="text-center text-muted py-4">Loading attendance history...</td></tr></tbody>
      </table>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
      <button class="btn btn-sm btn-outline-secondary" id="historyPrev"><i class="bi bi-chevron-left"></i> Previous</button>
      <span class="small text-muted" id="historyPage">Page 1 of 1</span>
      <button class="btn btn-sm btn-outline-secondary" id="historyNext">Next <i class="bi bi-chevron-right"></i></button>
    </div>
  </div>
</div>

<script>
  let currentPage = 1;
  const pageSize = 10;
  let rosterData = [];
  let rosterFiltered = [];
  let historyPage = 1;
  let historyPages = 1;
  const attendanceFooter = document.getElementById('attendanceFooter');

  function createSparkline(canvas, data, color, lineWidth) {
    if (!canvas || !Array.isArray(data) || data.length < 2) return;
    const ctx = canvas.getContext('2d');
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    const w = rect.width;
    const h = rect.height;
    if (!w || !h) return;
    canvas.width = Math.max(1, Math.floor(w * dpr));
    canvas.height = Math.max(1, Math.floor(h * dpr));
    ctx.scale(dpr, dpr);
    const min = Math.min(...data);
    const max = Math.max(...data);
    const range = max - min || 1;
    ctx.clearRect(0, 0, w, h);
    ctx.beginPath();
    data.forEach((v, i) => {
      const x = (i / (data.length - 1)) * w;
      const y = h - ((v - min) / range) * (h - 4) - 2;
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.strokeStyle = color || '#0ea5e9';
    ctx.lineWidth = lineWidth || 2;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.stroke();
  }

  document.addEventListener("DOMContentLoaded", () => {
    const lblTodayDate = document.getElementById("lblTodayDate");
    const imgQrCode = document.getElementById("imgQrCode");
    const qrLoading = document.getElementById("qrLoading");
    const btnRegenerate = document.getElementById("btnRegenerate");
    const tblRosterBody = document.getElementById("tblRosterBody");
    const rosterRecordCount = document.getElementById("rosterRecordCount");
    const attendanceSearchInput = document.getElementById("attendanceSearchInput");
    const attendanceStatusFilter = document.getElementById("attendanceStatusFilter");
    const attendanceRoleFilter = document.getElementById("attendanceRoleFilter");
    const attendanceFilterBtn = document.getElementById("attendanceFilterBtn");

    // Stat boxes
    const statTotal = document.getElementById("statTotal");
    const statPresent = document.getElementById("statPresent");
    const statLate = document.getElementById("statLate");
    const statAbsent = document.getElementById("statAbsent");
    const statLeave = document.getElementById("statLeave");
    const statHalf = document.getElementById("statHalf");

    // Format local date header
    const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    lblTodayDate.textContent = new Date().toLocaleDateString(undefined, options);

    // Load QR code token
    async function loadQrToken() {
      try {
        qrLoading.classList.replace("d-none", "d-flex");
        if (!qrLoading.classList.contains("d-flex")) qrLoading.classList.add("d-flex");
        imgQrCode.style.display = "none";
        
        const res = await fetch("/api/admin/attendance/qr-token");
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `HTTP error ${res.status}: ${res.statusText}`);
        }
        
        const data = await res.json();
        
        if (data.qrImage) {
          imgQrCode.src = data.qrImage;
          qrLoading.classList.replace("d-flex", "d-none");
          imgQrCode.style.display = "inline";
        } else {
          throw new Error("No QR image returned from server.");
        }
      } catch (err) {
        console.error("loadQrToken error:", err);
        alert("Failed to load QR code token: " + err.message);
      }
    }

    // Regenerate QR Code token
    btnRegenerate.addEventListener("click", async () => {
      if (!confirm("Are you sure you want to regenerate today's QR Code? Previous QR codes scanned today will still have checked-in status, but future scans must use the new code.")) return;
      try {
        qrLoading.classList.replace("d-none", "d-flex");
        if (!qrLoading.classList.contains("d-flex")) qrLoading.classList.add("d-flex");
        imgQrCode.style.display = "none";
        
        const res = await fetch("/api/admin/attendance/regenerate-token", { method: "POST" });
        if (!res.ok) throw new Error("Failed to regenerate token");
        
        await loadQrToken();
      } catch (err) {
        console.error(err);
        alert("Failed to regenerate token.");
      }
    });

    // Load today's roster and check-ins
    async function loadRoster() {
      try {
        const res = await fetch("/api/admin/attendance/today");
        if (!res.ok) throw new Error("Failed to load today's attendance logs");
        
        const roster = await res.json();
        renderRoster(roster);
      } catch (err) {
        console.error(err);
        tblRosterBody.innerHTML = `<tr><td colspan="8" class="text-center text-danger py-4"><i class="bi bi-exclamation-triangle-fill me-1"></i> Failed to load roster.</td></tr>`;
      }
    }

    // Client-side roster filtering
    function applyFilters() {
      const term = attendanceSearchInput.value.trim().toLowerCase();
      const att = attendanceStatusFilter.value.toLowerCase();
      const role = attendanceRoleFilter.value;
      rosterFiltered = rosterData.filter(tech => {
        const haystack = ((tech.name || "") + " " + (tech.email || "")).toLowerCase();
        const matchTerm = !term || haystack.includes(term);
        const matchAtt = att === "all" || (tech.attendanceStatus || "").toLowerCase() === att;
        const matchRole = role === "all" || tech.role === role;
        return matchTerm && matchAtt && matchRole;
      });
      currentPage = 1;
      renderPage(1, rosterFiltered);
    }

    function renderRow(tech) {
      let attBadgeClass = "badge-absent";
      if (tech.attendanceStatus === "Present") attBadgeClass = "badge-present";
      else if (tech.attendanceStatus === "Late") attBadgeClass = "badge-late";
      else if (["On Leave", "Sick Leave"].includes(tech.attendanceStatus)) attBadgeClass = "badge-leave";
      else if (tech.attendanceStatus === "Checked Out") attBadgeClass = "badge-half";

      let availBadgeClass = "badge-offline";
      if (tech.availabilityStatus === "Available") availBadgeClass = "badge-avail";
      else if (tech.availabilityStatus === "Assigned") availBadgeClass = "badge-assigned";
      else if (tech.availabilityStatus === "On The Way") availBadgeClass = "badge-otw";
      else if (tech.availabilityStatus === "In Progress") availBadgeClass = "badge-progress";
      else if (tech.availabilityStatus === "Unavailable") availBadgeClass = "badge-unavail";

      const checkInStr = tech.checkInTime 
        ? new Date(tech.checkInTime).toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })
        : "—";

      const checkOutStr = tech.checkOutTime 
        ? new Date(tech.checkOutTime).toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })
        : "";

      const timeDisplay = checkOutStr ? `${checkInStr} / ${checkOutStr}` : checkInStr;

      const roleBadge = tech.role === "secretary"
        ? '<span class="badge rounded-pill" style="background:#fce7f3;color:#be185d">Secretary</span>'
        : '<span class="badge rounded-pill" style="background:#dbeafe;color:#1d4ed8">Technician</span>';

      const methodStr = tech.method === "qr_scan" 
        ? '<span class="text-success"><i class="bi bi-qr-code"></i> Scan</span>'
        : tech.method === "manual"
        ? '<span class="text-primary"><i class="bi bi-pencil-square"></i> Manual</span>'
        : "—";

      const safeName = (tech.name || "").toLowerCase().replace(/"/g, '&quot;');
      const safeEmail = (tech.email || "").toLowerCase().replace(/"/g, '&quot;');
      const safeAtt = (tech.attendanceStatus || "").toLowerCase().replace(/"/g, '&quot;');

      return `
          <tr data-name="${safeName}" data-email="${safeEmail}" data-attendance="${safeAtt}">
            <td class="ps-4 fw-semibold">${tech.name}</td>
            <td>${roleBadge}</td>
            <td class="text-muted small">${tech.email || "—"}</td>
            <td>
              <span class="status-badge ${attBadgeClass}">${tech.attendanceStatus}</span>
            </td>
            <td>
              ${tech.role === "technician" ? `<span class="availability-badge ${availBadgeClass}">${tech.availabilityStatus}</span>` : '<span class="text-muted small">Not applicable</span>'}
            </td>
            <td>${timeDisplay}</td>
            <td>${methodStr}</td>
            <td class="text-end pe-4">
              <div class="d-inline-flex gap-1 align-items-center">
                <select class="action-select attendance-select" data-staff-id="${tech.staffId}" data-staff-type="${tech.staffType}">
                  <option value="" disabled selected>Mark Attendance...</option>
                  <option value="Present" ${tech.attendanceStatus === "Present" ? "disabled" : ""}>Present</option>
                  <option value="Late" ${tech.attendanceStatus === "Late" ? "disabled" : ""}>Late</option>
                  <option value="Absent" ${tech.attendanceStatus === "Absent" ? "disabled" : ""}>Absent</option>
                  <option value="On Leave" ${tech.attendanceStatus === "On Leave" ? "disabled" : ""}>On Leave</option>
                  <option value="Sick Leave" ${tech.attendanceStatus === "Sick Leave" ? "disabled" : ""}>Sick Leave</option>
                  <option value="Checked Out" ${tech.attendanceStatus === "Checked Out" ? "disabled" : ""}>Checked Out</option>
                </select>

                ${tech.role === "technician" ? `<select class="action-select availability-select" data-staff-id="${tech.staffId}" data-staff-type="${tech.staffType}">
                  <option value="" disabled selected>Set Availability...</option>
                  <option value="Offline" ${tech.availabilityStatus === "Offline" ? "disabled" : ""}>Offline</option>
                  <option value="Available" ${tech.availabilityStatus === "Available" ? "disabled" : ""}>Available</option>
                  <option value="Assigned" ${tech.availabilityStatus === "Assigned" ? "disabled" : ""}>Assigned</option>
                  <option value="On The Way" ${tech.availabilityStatus === "On The Way" ? "disabled" : ""}>On The Way</option>
                  <option value="In Progress" ${tech.availabilityStatus === "In Progress" ? "disabled" : ""}>In Progress</option>
                  <option value="Unavailable" ${tech.availabilityStatus === "Unavailable" ? "disabled" : ""}>Unavailable</option>
                </select>` : ''}
              </div>
            </td>
          </tr>
        `;
    }

    function renderPage(page, items) {
      const start = (page - 1) * pageSize;
      const slice = items.slice(start, start + pageSize);
      if (!slice.length) {
        tblRosterBody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-muted">No matching records.</td></tr>`;
        attendanceFooter.innerHTML = '<nav aria-label="Attendance pagination"><ul class="inv-pagination justify-content-end mb-0"><li class="page-item disabled"><a class="page-link" href="javascript:void(0)">‹ Prev</a></li><li class="page-item active"><span class="page-link">1 / 1</span></li><li class="page-item disabled"><a class="page-link" href="javascript:void(0)">Next ›</a></li></ul></nav>';
        return;
      }
      tblRosterBody.innerHTML = slice.map(renderRow).join("");
      rosterRecordCount.textContent = items.length + " records";
      renderPagination(page, Math.ceil(items.length / pageSize) || 1, items.length);

      document.querySelectorAll(".attendance-select").forEach(select => {
        select.addEventListener("change", async (e) => {
          const techId = e.target.getAttribute("data-staff-id");
          const staffType = e.target.getAttribute("data-staff-type");
          const status = e.target.value;
          await updateTechnician(techId, { status, staffType });
        });
      });

      document.querySelectorAll(".availability-select").forEach(select => {
        select.addEventListener("change", async (e) => {
          const techId = e.target.getAttribute("data-staff-id");
          const staffType = e.target.getAttribute("data-staff-type");
          const availabilityStatus = e.target.value;
          await updateTechnician(techId, { availabilityStatus, staffType });
        });
      });
    }

    function renderPagination(page, pages, total) {
      const disabled = total === 0;
      const nav = `<nav aria-label="Attendance pagination">
  <ul class="inv-pagination justify-content-end mb-0">
    <li class="page-item ${page <= 1 || disabled ? 'disabled' : ''}">
      <a class="page-link" href="javascript:void(0)" data-page="${page - 1}">‹ Prev</a>
    </li>
    <li class="page-item active">
      <span class="page-link">${disabled ? '1 / 1' : `${page} / ${pages}`}</span>
    </li>
    <li class="page-item ${page >= pages || disabled ? 'disabled' : ''}">
      <a class="page-link" href="javascript:void(0)" data-page="${page + 1}">Next ›</a>
    </li>
  </ul>
</nav>`;
      attendanceFooter.innerHTML = nav;
      attendanceFooter.querySelectorAll('.page-link[data-page]').forEach(el => {
        el.addEventListener('click', e => {
          e.preventDefault();
          const target = e.target.closest('.page-link');
          const newPage = parseInt(target?.dataset.page);
          if (!target?.closest('.page-item.disabled') && newPage >= 1 && newPage <= pages) {
            currentPage = newPage;
            renderPage(currentPage, rosterFiltered);
          }
        });
      });
    }

    // Render table and stats
    function renderRoster(roster) {
      if (!roster || roster.length === 0) {
        tblRosterBody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-muted">No active technicians or secretaries are registered.</td></tr>`;
        rosterRecordCount.textContent = "0 total records";
        statTotal.textContent = 0;
        statPresent.textContent = 0;
        statLate.textContent = 0;
        statAbsent.textContent = 0;
        statLeave.textContent = 0;
        statHalf.textContent = 0;
        attendanceFooter.innerHTML = '<nav aria-label="Attendance pagination"><ul class="inv-pagination justify-content-end mb-0"><li class="page-item disabled"><a class="page-link" href="javascript:void(0)">‹ Prev</a></li><li class="page-item active"><span class="page-link">1 / 1</span></li><li class="page-item disabled"><a class="page-link" href="javascript:void(0)">Next ›</a></li></ul></nav>';
        return;
      }

      rosterData = roster;

      // Calculate stats
      let total = roster.length;
      let present = 0;
      let late = 0;
      let absent = 0;
      let leave = 0;
      let checkedOutCount = 0;
      roster.forEach(tech => {
        switch(tech.attendanceStatus) {
          case "Present": present++; break;
          case "Late": late++; break;
          case "Absent": absent++; break;
          case "On Leave":
          case "Sick Leave": leave++; break;
          case "Checked Out": checkedOutCount++; break;
        }
      });

      // Update counters
      statTotal.textContent = total;
      statPresent.textContent = present;
      statLate.textContent = late;
      statAbsent.textContent = absent;
      statLeave.textContent = leave;
      statHalf.textContent = checkedOutCount;

      // Render paged rows
      applyFilters();
    }
    // Call API to update status
    async function updateTechnician(techId, body) {
      try {
        const res = await fetch(`/api/admin/attendance/${techId}`, {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(body)
        });

        if (!res.ok) throw new Error("Failed to update status");

        // Reload data
        await loadRoster();
      } catch (err) {
        console.error(err);
        alert("Failed to update staff status.");
      }
    }

    function historyDateKey(value) {
      const parts = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Asia/Manila', year: 'numeric', month: '2-digit', day: '2-digit'
      }).formatToParts(value).reduce((result, part) => ({ ...result, [part.type]: part.value }), {});
      return `${parts.year}-${parts.month}-${parts.day}`;
    }

    function historyEscape(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, char => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      })[char]);
    }

    async function loadAttendanceHistory(page = 1) {
      const body = document.getElementById('historyBody');
      body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Loading attendance history...</td></tr>';
      const params = new URLSearchParams({
        page: String(page),
        limit: '25',
        from: document.getElementById('historyFrom').value,
        to: document.getElementById('historyTo').value,
        role: document.getElementById('historyRole').value,
        status: document.getElementById('historyStatus').value,
        search: document.getElementById('historySearch').value.trim(),
      });
      try {
        const response = await fetch(`/api/admin/attendance/history?${params.toString()}`);
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Could not load attendance history.');
        historyPage = data.pagination.page;
        historyPages = data.pagination.pages;
        document.getElementById('historyRecordCount').textContent = `${data.pagination.total} record${data.pagination.total === 1 ? '' : 's'}`;
        document.getElementById('historyPresent').textContent = data.summary.present;
        document.getElementById('historyLate').textContent = data.summary.late;
        document.getElementById('historyHours').textContent = Number(data.summary.hoursWorked || 0).toFixed(2);
        document.getElementById('historyPage').textContent = `Page ${historyPage} of ${historyPages}`;
        document.getElementById('historyPrev').disabled = historyPage <= 1;
        document.getElementById('historyNext').disabled = historyPage >= historyPages;
        if (!data.items.length) {
          body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No attendance records match these filters.</td></tr>';
          return;
        }
        body.innerHTML = data.items.map(row => {
          const badge = row.attendanceStatus === 'Late' ? 'badge-late'
            : row.attendanceStatus === 'Checked Out' || row.attendanceStatus === 'Present' ? 'badge-present'
            : ['On Leave','Sick Leave'].includes(row.attendanceStatus) ? 'badge-leave' : 'badge-absent';
          const localDate = new Date(row.date).toLocaleDateString('en-PH', { timeZone:'Asia/Manila', month:'short', day:'numeric', year:'numeric' });
          const localTime = value => value ? new Date(value).toLocaleTimeString('en-PH', { timeZone:'Asia/Manila', hour:'2-digit', minute:'2-digit' }) : '--';
          const source = row.method === 'qr_scan' && row.qrVerified
            ? '<span class="text-success"><i class="bi bi-shield-check me-1"></i>Verified QR</span>'
            : '<span class="text-primary"><i class="bi bi-person-gear me-1"></i>Admin entry</span>';
          return `<tr><td class="ps-4 fw-semibold">${localDate}</td><td><div class="fw-semibold">${historyEscape(row.name)}</div><div class="small text-muted">${historyEscape(row.email)}</div></td><td class="text-capitalize">${historyEscape(row.role)}</td><td><span class="status-badge ${badge}">${historyEscape(row.attendanceStatus)}</span></td><td>${localTime(row.checkInTime)}</td><td>${localTime(row.checkOutTime)}</td><td class="fw-semibold">${Number(row.hoursWorked || 0).toFixed(2)} h</td><td>${source}</td></tr>`;
        }).join('');
      } catch (error) {
        body.innerHTML = `<tr><td colspan="8" class="text-center text-danger py-4">${historyEscape(error.message)}</td></tr>`;
      }
    }

    function initializeHistory() {
      const now = new Date();
      document.getElementById('historyTo').value = historyDateKey(now);
      document.getElementById('historyFrom').value = historyDateKey(new Date(now.getTime() - 29 * 86400000));
      document.getElementById('historyApply').addEventListener('click', () => loadAttendanceHistory(1));
      document.getElementById('historySearch').addEventListener('keydown', event => {
        if (event.key === 'Enter') loadAttendanceHistory(1);
      });
      document.getElementById('historyPrev').addEventListener('click', () => loadAttendanceHistory(historyPage - 1));
      document.getElementById('historyNext').addEventListener('click', () => loadAttendanceHistory(historyPage + 1));
      loadAttendanceHistory(1);
    }

    // Toolbar filter listeners
    attendanceSearchInput.addEventListener("input", applyFilters);
    attendanceStatusFilter.addEventListener("change", applyFilters);
    attendanceRoleFilter.addEventListener("change", applyFilters);
    attendanceFilterBtn.addEventListener("click", applyFilters);

    // Initialize
    loadQrToken();
    loadRoster();
    initializeHistory();

    // Sparkline charts for KPI cards
    createSparkline(document.getElementById('attSparkTotal'), [12, 15, 13, 18, 20, 19, 22], '#0ea5e9');
    createSparkline(document.getElementById('attSparkPresent'), [8, 10, 12, 14, 16, 18, 20], '#16a34a');
    createSparkline(document.getElementById('attSparkLate'), [1, 2, 0, 3, 1, 2, 1], '#d97706');
    createSparkline(document.getElementById('attSparkAbsent'), [3, 2, 4, 1, 2, 3, 2], '#dc2626');
    createSparkline(document.getElementById('attSparkLeave'), [0, 1, 1, 2, 1, 0, 1], '#4f46e5');
    createSparkline(document.getElementById('attSparkHalf'), [0, 0, 1, 1, 2, 2, 3], '#64748b');
  });
</script>
