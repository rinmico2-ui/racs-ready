<div class="forgot-page-wrapper">
  <div class="forgot-panel-container">
    <div class="forgot-panel-inner">

      <!-- Brand -->
      <div class="forgot-brand">
        <a href="/" class="brand">
          <i class="bi bi-shield-lock-fill"></i>
          <span>CALIDRO RACS</span>
        </a>
      </div>

      <!-- Heading -->
      <div class="forgot-heading">
        <div class="forgot-icon-ring">
          <i class="bi bi-key"></i>
        </div>
        <h1>Create new password</h1>
        <p class="forgot-subtitle">
          Your new password must be different from previously used passwords.
        </p>
      </div>

      <!-- Alert -->
      <div id="resetAlert" class="alert d-none" role="alert"></div>

      <!-- Form -->
      <form
        id="resetForm"
        action="/api/auth/reset-password"
        method="POST"
        autocomplete="on"
        novalidate
      >
        <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
        <input type="hidden" name="token" value="<%= token %>" />

        <!-- Email -->
        <div class="forgot-field">
          <label for="email" class="forgot-label">Email address</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            <input
              id="email"
              name="email"
              type="email"
              class="form-control"
              placeholder="you@company.com"
              required
              autocomplete="email"
              maxlength="50"
            />
            <span class="field-icon success-icon d-none"><i class="bi bi-check-circle-fill"></i></span>
            <span class="field-icon error-icon d-none"><i class="bi bi-exclamation-circle-fill"></i></span>
          </div>
          <div class="field-feedback" id="emailFeedback"></div>
        </div>

        <!-- Math CAPTCHA -->
        <div class="forgot-field math-captcha">
          <div class="captcha-header">
            <label class="forgot-label" style="margin-bottom:0;">
              Verify you're human
            </label>
            <button type="button" class="refresh-captcha" title="New captcha">
              <i class="bi bi-arrow-clockwise"></i>
            </button>
          </div>
          <div class="dice-row">
            <span class="captcha-equation" id="resetEquation" style="font-size:22px;font-weight:700;color:#1e293b;"><%= num1 %> + <%= num2 %> =</span>
          </div>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-calculator"></i></span>
            <input
              id="reset-math"
              name="mathCaptcha"
              type="text"
              inputmode="numeric"
              pattern="[0-9]{1,3}"
              maxlength="3"
              title="Enter the sum"
              class="form-control"
              placeholder="Enter the sum"
              required
            />
            <span class="field-icon success-icon d-none"><i class="bi bi-check-circle-fill"></i></span>
            <span class="field-icon error-icon d-none"><i class="bi bi-exclamation-circle-fill"></i></span>
          </div>
          <div class="field-feedback" id="captchaFeedback"></div>
          <input type="hidden" name="mathAnswer" value="<%= mathAnswer %>" />
        </div>

        <!-- New Password -->
        <div class="forgot-field">
          <label for="password" class="forgot-label">New password</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input
              id="password"
              name="password"
              type="password"
              class="form-control"
              placeholder="Enter your new password"
              required
              autocomplete="new-password"
              maxlength="20"
            />
            <button
              class="btn input-toggle"
              type="button"
              id="togglePasswordReset"
              aria-label="Toggle password visibility"
            >
              <i class="bi bi-eye"></i>
            </button>
            <span id="reset-password-check" class="match-indicator d-none"></span>
          </div>
          <!-- Password Strength Meter -->
          <div class="pw-strength-meter" id="pwStrengthMeter">
            <div class="pw-strength-bar" id="pwStrengthBar"></div>
          </div>
          <div class="pw-strength-label" id="pwStrengthLabel"></div>
          <!-- Password Rules -->
          <div id="reset-password-suggestions" class="pw-rules">
            <div class="pw-rules-title">Your password must contain at least</div>
            <ul class="pw-rules-list">
              <li data-rule="letter">
                <i class="bi bi-circle"></i>
                <span>1 uppercase letter</span>
              </li>
              <li data-rule="digitOrSpecial">
                <i class="bi bi-circle"></i>
                <span>1 number or special character (!@#$)</span>
              </li>
              <li data-rule="length">
                <i class="bi bi-circle"></i>
                <span>At least 8 characters</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Confirm Password -->
        <div class="forgot-field">
          <label for="confirmPassword" class="forgot-label">Confirm password</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
            <input
              id="confirmPassword"
              name="confirmPassword"
              type="password"
              class="form-control"
              placeholder="Re-enter your new password"
              required
              autocomplete="new-password"
              maxlength="20"
            />
            <button
              class="btn input-toggle"
              type="button"
              id="toggleConfirmPasswordReset"
              aria-label="Toggle confirm password visibility"
            >
              <i class="bi bi-eye"></i>
            </button>
            <span id="reset-confirm-check" class="match-indicator d-none"></span>
          </div>
          <div class="field-feedback" id="confirmFeedback"></div>
        </div>

        <!-- Submit -->
        <button
          id="resetBtn"
          class="button primary"
          type="submit"
        >
          <i class="bi bi-check-circle-fill"></i>
          <span class="btn-text">Reset Password</span>
        </button>

        <!-- Footer link -->
        <div class="forgot-footer">
          Remembered your password?
          <a href="/login" class="forgot-link">Back to login</a>
        </div>
      </form>

      <!-- Success state (hidden by default) -->
      <div id="resetSuccess" class="forgot-success d-none">
        <div class="success-icon-ring">
          <i class="bi bi-check-lg"></i>
        </div>
        <h2>Password reset successful</h2>
        <p class="success-text">
          Your password has been updated. You can now sign in with your new password.
        </p>
        <div class="success-actions">
          <a href="/login" class="button primary" style="text-decoration:none;text-align:center;">
            <i class="bi bi-box-arrow-in-right"></i>
            <span class="btn-text">Sign In</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  /* ── Password Strength Meter ── */
  .pw-strength-meter {
    height: 4px;
    background: #e2e8f0;
    border-radius: 2px;
    margin: 8px 0 4px;
    overflow: hidden;
  }
  .pw-strength-bar {
    height: 100%;
    width: 0%;
    border-radius: 2px;
    transition: width 0.3s ease, background 0.3s ease;
  }
  .pw-strength-label {
    font-size: 0.72rem;
    font-weight: 600;
    margin-bottom: 8px;
    min-height: 16px;
    transition: color 0.3s ease;
  }

  /* ── Password Rules ── */
  .pw-rules {
    margin-bottom: 4px;
  }
  .pw-rules-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: #5a6a7e;
    margin-bottom: 6px;
  }
  .pw-rules-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pw-rules-list li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: #8a9aa8;
    padding: 2px 0;
    transition: color 0.2s ease;
  }
  .pw-rules-list li i {
    font-size: 0.5rem;
    transition: all 0.2s ease;
  }
  .pw-rules-list li.met {
    color: #198754;
  }
  .pw-rules-list li.met i {
    color: #198754;
  }

  /* ── Match Indicator ── */
  .match-indicator {
    position: absolute;
    right: 42px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1rem;
    pointer-events: none;
  }

  /* ── Input Toggle Button ── */
  .input-toggle {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #8a9aa8;
    cursor: pointer;
    padding: 4px 8px;
    font-size: 1rem;
    z-index: 4;
    transition: color 0.2s ease;
  }
  .input-toggle:hover {
    color: var(--auth-primary);
  }

  /* ── Success State ── */
  .forgot-success {
    text-align: center;
    padding: 20px 0;
  }
  .forgot-success h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--auth-text);
    margin: 0 0 8px;
  }
  .forgot-success .success-text {
    font-size: 0.9rem;
    color: var(--auth-text-secondary);
    margin: 0 0 24px;
    line-height: 1.6;
  }
  .forgot-success .success-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .success-icon-ring {
    width: 72px;
    height: 72px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(25, 135, 84, 0.12), rgba(25, 135, 84, 0.04));
    border: 2px solid rgba(25, 135, 84, 0.2);
    animation: successPulse 0.6s ease;
  }
  .success-icon-ring i {
    font-size: 2rem;
    color: #198754;
  }
  @keyframes successPulse {
    0% { transform: scale(0.8); opacity: 0; }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); opacity: 1; }
  }
</style>
