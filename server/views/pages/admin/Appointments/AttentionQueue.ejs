  async function reschedulePickupOrder(item) {
    if (!window.Swal) {
      showToast('error', 'The schedule form is unavailable. Reload the page and try again.');
      return;
    }
    const tomorrow = new Date(Date.now() + 86400000);
    const parts = Object.fromEntries(new Intl.DateTimeFormat('en-US', {
      timeZone:'Asia/Manila', year:'numeric', month:'2-digit', day:'2-digit'
    }).formatToParts(tomorrow).map(part => [part.type, part.value]));
    const minDate = `${parts.year}-${parts.month}-${parts.day}`;
    const customerContact = contactActions(item);
    const result = await Swal.fire({
      title:`Set pickup date · ${escapeHtml(item.reference || 'Order')}`,
      customClass:{ popup:'rc-dialog rc-dialog-pickup' },
      html:`<div class="text-start">${customerContact ? `<div class="rounded-3 border bg-light p-3 mb-3"><div class="small fw-bold text-uppercase text-muted mb-2">Customer contact</div><div class="d-flex flex-wrap gap-2">${customerContact}</div></div>` : ''}<label for="rcOrderDate" class="form-label small fw-bold">New pickup date</label><input id="rcOrderDate" type="date" min="${minDate}" class="form-control mb-2"><p class="small text-muted">Choose a future date when the store is open.</p><label for="rcOrderReason" class="form-label small fw-bold mt-2">Resolution note (optional)</label><textarea id="rcOrderReason" class="form-control" rows="2" maxlength="500"></textarea></div>`,
      showCancelButton:true,
      confirmButtonText:'Save pickup date',
      confirmButtonColor:'#2563eb',
      focusConfirm:false,
      showLoaderOnConfirm:true,
      allowOutsideClick:() => !Swal.isLoading(),
      preConfirm:async () => {
        const root = Swal.getHtmlContainer();
        const date = root.querySelector('#rcOrderDate').value;
        if (!date) { Swal.showValidationMessage('Choose a future pickup date.'); return false; }
        try {
          const response = await fetch(`/api/orders/${encodeURIComponent(item.id)}/admin-reschedule`, {
            method:'POST', headers:{'Content-Type':'application/json'},
            body:JSON.stringify({ scheduledDate:date, reason:root.querySelector('#rcOrderReason').value.trim() }),
          });
          const data = await response.json();
          if (!response.ok) { Swal.showValidationMessage(data.error || 'Could not save the pickup date.'); return false; }
