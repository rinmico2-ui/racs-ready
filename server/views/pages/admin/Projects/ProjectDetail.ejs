  ];

  function suggestToolsFor(p) {
    const hay = ((p.service?.name || '') + ' ' + (p.service?.category || '') + ' ' + (p.service?.description || '')).toLowerCase();
    const matched = TOOL_RULES.filter(r => r.match.test(hay));
    let items = [];
    if (matched.length) {
      matched.forEach(r => { items = items.concat(r.items); });
    } else {
      // default to general maintenance kit
      items = [
        { name: 'General Tool Kit', qty: 1, type: 'tool' },
        { name: 'Multi-tool', qty: 3, type: 'tool' },
        { name: 'Safety Gear Set', qty: 4, type: 'part' },
        { name: 'Ladder', qty: 1, type: 'equipment' },
      ];
    }
    // scale quantities by unit count for large jobs
    const units = Math.max(1, p.totalUnits || 1);
    const scale = units > 10 ? Math.ceil(units / 10) : 1;
    items = items.concat(TOOL_ESSENTIALS);
    return items.map(it => ({ ...it, qty: it.qty * scale }));
  }

