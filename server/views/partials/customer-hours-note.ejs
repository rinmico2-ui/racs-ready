<div class="d-flex align-items-start gap-3 rounded-3 border px-3 py-3 mb-3" role="note" style="border-color:#bfdbfe!important;background:#eff6ff;color:#1e3a8a;">
  <i class="bi bi-clock-history fs-5" aria-hidden="true"></i>
  <div>
    <div class="fw-bold" style="font-size:.88rem;"><%= hoursLabel %>: <%= hoursSummary %></div>
    <div class="small mt-1" style="color:#475569;"><%= hoursNote %></div>
  </div>
</div>
