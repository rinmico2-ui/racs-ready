<div class="admin-dashboard container-fluid py-4 walkin-page">
  <%- include('../../../partials/dashboard-styles') %>

  <style>
    .walkin-page .walkin-shell { position: relative; }

    /* ── Layout ─────────────────────────────────────────── */
    .walkin-page .booking-layout {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    /* ── Horizontal Progress Stepper ───────────────────── */
    .walkin-page .horizontal-stepper {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 1px 3px rgba(0,0,0,.04);
    }
    .walkin-page .stepper-list {
      margin: 0; padding: 0; list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }
    .walkin-page .stepper-step {
      flex: 1;
      border: none;
      background: transparent;
      text-align: center;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      color: #94a3b8;
      font-size: 0.75rem;
      cursor: pointer;
      position: relative;
      transition: all .25s ease;
    }
    .walkin-page .stepper-step:hover { color: #64748b; }
    .walkin-page .stepper-step.is-active { color: #2563eb; }
    .walkin-page .stepper-step.is-completed { color: #1e40af; }
    .walkin-page .stepper-icon {
      width: 36px; height: 36px; border-radius: 50%;
      border: 2px solid #e2e8f0;
      background: #fff;
      display: inline-flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 0.85rem;
      flex-shrink: 0;
      transition: all .25s ease;
      position: relative;
      z-index: 2;
    }
    .walkin-page .stepper-step.is-active .stepper-icon {
      border-color: #2563eb;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      color: #fff;
      box-shadow: 0 4px 12px rgba(37,99,235,.3);
    }
    .walkin-page .stepper-step.is-completed .stepper-icon {
      border-color: #2563eb;
      background: linear-gradient(135deg, #10b981, #059669);
      color: #fff;
      box-shadow: 0 2px 8px rgba(16,185,129,.3);
    }
    .walkin-page .stepper-text {
      font-weight: 500;
      font-size: 0.75rem;
      max-width: 80px;
      line-height: 1.2;
    }
    .walkin-page .stepper-step.is-active .stepper-text {
      font-weight: 600;
    }

    /* horizontal connector line */
    .walkin-page .stepper-list::before {
      content: "";
      position: absolute;
      top: 18px;
      left: 40px;
      right: 40px;
      height: 2px;
      background: #e2e8f0;
      z-index: 1;
    }
    .walkin-page .stepper-step:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 18px;
      left: 50%;
      width: 100%;
      height: 2px;
      background: #e2e8f0;
      z-index: 1;
    }
    .walkin-page .stepper-step.is-completed:not(:last-child)::after {
      background: linear-gradient(90deg, #10b981, #e2e8f0);
    }

    /* ── Booking Step Panels ────────────────────────────── */
    .walkin-page .booking-step {
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 1.5rem;
      margin-bottom: 1rem;
      background: #fff;
      box-shadow: 0 1px 3px rgba(0,0,0,.04);
      transition: box-shadow .3s ease;
      animation: stepFadeIn .35s ease both;
    }
    .walkin-page .booking-step:hover {
      box-shadow: 0 4px 16px rgba(0,0,0,.06);
    }
    .walkin-page .booking-step h5 {
      font-size: 1.05rem; font-weight: 700; color: #1e293b;
      margin-bottom: .25rem;
    }
    .walkin-page .booking-step h5 i { color: #2563eb; }
    @keyframes stepFadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Service Cards (enterprise style — matches services.ejs) ───────── */
    .walkin-page .service-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      border: 1px solid rgba(13, 110, 253, 0.12) !important;
      min-height: 280px;
      background: #ffffff;
      border-radius: 1.4rem;
      cursor: pointer;
    }
    .walkin-page .service-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 18px 45px rgba(13, 110, 253, 0.12) !important;
      border-color: rgba(13, 110, 253, 0.24) !important;
    }
    .walkin-page .service-card.active {
      border-color: #0d6efd !important;
      background: linear-gradient(145deg, rgba(13, 110, 253, 0.08), rgba(13, 110, 253, 0.02));
      box-shadow: 0 15px 35px rgba(13, 110, 253, 0.15) !important;
    }
    .walkin-page .service-icon {
      width: 54px; height: 54px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 16px;
      background: rgba(13, 110, 253, 0.12);
      color: #0d6efd;
      flex-shrink: 0;
    }
    .walkin-page .service-card .card-title {
      font-size: .95rem; font-weight: 600; color: #1e293b;
      margin-bottom: 4px;
    }
    .walkin-page .price-box {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 0.75rem 1rem; border-radius: 999px;
      background: rgba(13, 110, 253, 0.08);
      min-width: 130px;
      font-weight: 700; font-size: .88rem; color: #0d6efd;
    }
    .walkin-page .service-card-chip {
      padding: 0.45rem 0.8rem; border-radius: 999px;
      font-size: 0.8rem; letter-spacing: 0.01em;
    }

    /* ── Suggested Cards ────────────────────────────────── */
    .walkin-page .suggested-card {
      border: 1px solid #e2e8f0;
      border-radius: 12px; cursor: pointer;
      transition: all .2s ease;
      background: #fff;
      box-shadow: 0 1px 3px rgba(0,0,0,.04);
      padding: 1rem;
    }
    .walkin-page .suggested-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(0,0,0,.07);
    }
    .walkin-page .suggested-card.active {
      border-color: #2563eb;
      background: linear-gradient(135deg, #eff6ff, #dbeafe);
      box-shadow: 0 4px 14px rgba(37,99,235,.12);
    }

    /* ── Calendar ───────────────────────────────────────── */
    .walkin-page .calendar-grid {
      display: grid; grid-template-columns: repeat(7, minmax(0,1fr));
      gap: 6px;
    }
    .walkin-page .calendar-cell {
      border: 1px solid #e2e8f0;
      border-radius: 10px; min-height: 52px;
      background: #fff; font-weight: 600; font-size: .84rem;
      position: relative; transition: all .15s ease;
    }
    .walkin-page .calendar-cell:hover:not(.disabled):not([data-status="booked"]):not([data-status="blocked"]) {
      border-color: #93c5fd; background: #f0f7ff;
    }
    .walkin-page .calendar-cell.is-selected {
      border-color: #2563eb; background: #eff6ff; color: #1e40af;
      box-shadow: 0 0 0 3px rgba(37,99,235,.12);
    }
    .walkin-page .calendar-cell.disabled { opacity: .5; cursor: not-allowed; }
    .walkin-page .calendar-cell[data-status="booked"] {
      background: #fef2f2; border-color: #fecaca; color: #b91c1c;
    }
    .walkin-page .calendar-cell[data-status="blocked"],
    .walkin-page .calendar-cell[data-status="public"] {
      background: #f8fafc; color: #94a3b8;
    }

    /* ── Time Slots ─────────────────────────────────────── */
    .walkin-page #timeSlots { display: flex; flex-wrap: wrap; gap: 8px; }
    .walkin-page #timeSlots .time-slot {
      flex: 1 1 calc(33.333% - 8px); max-width: calc(33.333% - 8px);
      border-radius: 10px;
      border: 1px solid rgba(37,99,235,.1);
      background: #fff; text-align: left;
      transition: all .15s ease;
    }
    .walkin-page #timeSlots .time-slot:hover { border-color: #93c5fd; background: #f0f7ff; }
    .walkin-page #timeSlots .time-slot.active {
      background: #eff6ff; border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37,99,235,.1);
    }

    /* ── Map ────────────────────────────────────────────── */
    .walkin-page .map-wrap {
      border: 1px solid #e2e8f0;
      border-radius: 14px; overflow: hidden; background: #fff;
    }
    .walkin-page .technician-map { height: 290px; width: 100%; }

    /* ── Payment Tabs ───────────────────────────────────── */
    .walkin-page .payment-tabs {
      display: flex; gap: 10px; margin-bottom: 1rem; flex-wrap: wrap;
    }
    .walkin-page .payment-tab {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 12px 18px; border-radius: 12px;
      background: #fff; border: 2px solid #e2e8f0;
      cursor: pointer; font-weight: 500;
      transition: all .2s ease;
    }
    .walkin-page .payment-tab:hover { border-color: #93c5fd; background: #f8fafc; }
    .walkin-page .payment-tab.active {
      background: #eff6ff; border-color: #2563eb; color: #1e40af;
      box-shadow: 0 0 0 3px rgba(37,99,235,.08);
    }

    /* ── Summary Box ────────────────────────────────────── */
    .walkin-page .summary-box {
      background: #f8fafc; border: 1px solid #e2e8f0;
      border-radius: 12px; padding: 14px;
      font-size: .86rem; color: #334155;
    }

    /* ── Walkin Actions ─────────────────────────────────── */
    .walkin-page .walkin-actions {
      display: flex; flex-wrap: wrap; gap: 10px;
      margin-top: 1rem; padding-top: 1rem;
      border-top: 1px solid #f1f5f9;
    }
    .walkin-page .walkin-actions .btn {
      border-radius: 10px; font-weight: 600; font-size: .85rem;
      padding: 10px 24px;
      transition: all .2s ease;
    }

    /* ── Form Controls ──────────────────────────────────── */
    .walkin-page .form-label { font-weight: 600; font-size: .82rem; color: #475569; margin-bottom: 6px; }
    .walkin-page .form-control,
    .walkin-page .form-select {
      border-radius: 10px; border-color: #e2e8f0;
      padding: 10px 14px; font-size: .88rem;
      transition: border-color .2s, box-shadow .2s;
    }
    .walkin-page .form-control:focus,
    .walkin-page .form-select:focus {
      border-color: #93c5fd;
      box-shadow: 0 0 0 3px rgba(37,99,235,.1);
    }

    /* ── Nav Tabs (service categories) ──────────────────── */
    .walkin-page .nav-tabs { border-bottom: 2px solid #e2e8f0; gap: 4px; }
    .walkin-page .nav-tabs .nav-link {
      border: none; border-radius: 10px 10px 0 0;
      padding: 10px 20px; font-weight: 600; font-size: .84rem;
      color: #64748b; background: transparent;
      transition: all .2s ease;
    }
    .walkin-page .nav-tabs .nav-link:hover { color: #2563eb; background: #f1f5f9; }
    .walkin-page .nav-tabs .nav-link.active {
      color: #1e40af; background: #fff;
      border-bottom: 2px solid #2563eb; margin-bottom: -2px;
    }

    /* ── Responsive ─────────────────────────────────────── */
    @media (max-width: 768px) {
      .walkin-page .stepper-list {
        flex-wrap: wrap;
        justify-content: center;
      }
      .walkin-page .stepper-step {
        min-width: 60px;
      }
      .walkin-page .stepper-text {
        font-size: 0.65rem;
        max-width: 60px;
      }
      .walkin-page .stepper-icon {
        width: 32px; height: 32px; font-size: 0.75rem;
      }
      .walkin-page .stepper-list::before {
        display: none;
      }
      .walkin-page .stepper-step::after {
        display: none;
      }
      .walkin-page #timeSlots .time-slot { flex: 1 1 100%; max-width: 100%; }
    }
  </style>

  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-person-plus-fill"></i></div>
        <div>
          <h1>Create Walk-in Appointment</h1>
          <p>Fill in customer details, pick a service, schedule, and review before creating.</p>
        </div>
      </div>
      <div class="au-hero-actions" style="display:none;">
        <a href="/admin/appointments" class="btn btn-light btn-sm fw-semibold">
          <i class="bi bi-arrow-left me-1"></i>Back to Appointments
        </a>
      </div>
    </div>
  </div>

  <div class="modal fade" id="walkinAlert" tabindex="-1" aria-labelledby="walkinAlertLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
      <div class="modal-content" style="border: none; border-radius: 18px; overflow: hidden; box-shadow: 0 25px 70px rgba(0,0,0,0.18);">
        <div id="walkinAlertHeader" class="modal-header border-0 justify-content-center" style="padding: 28px 24px 12px;">
          <h5 class="modal-title fw-bold" id="walkinAlertLabel" style="font-size: 1.2rem; color: #fff;"></h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="position: absolute; top: 14px; right: 14px;"></button>
        </div>
        <div class="modal-body text-center" id="walkinAlertBody" style="padding: 0 28px 28px;">
        </div>
        <div class="modal-footer border-0 justify-content-center" style="padding: 0 28px 28px;">
          <button type="button" class="btn btn-light fw-semibold" data-bs-dismiss="modal" style="min-width: 120px; border-radius: 10px; padding: 10px 24px;">OK</button>
        </div>
      </div>
    </div>
  </div>

  <form
    id="walkinForm"
    class="walkin-shell booking-container bg-white"
    style="box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 8px 32px rgba(0,0,0,.04); border: 1px solid #e2e8f0; border-radius: 16px; padding: 1.5rem;">
    <div class="booking-layout">
      <!-- Horizontal Progress Stepper -->
      <div class="horizontal-stepper" id="walkinStepper" aria-label="Walk-in booking steps">
        <ol class="stepper-list" role="list" style="position: relative;">
          <li>
            <button type="button" class="stepper-step is-active" data-step="0">
              <span class="stepper-icon">1</span>
              <span class="stepper-text">Customer</span>
            </button>
          </li>
          <li>
            <button type="button" class="stepper-step" data-step="1">
              <span class="stepper-icon">2</span>
              <span class="stepper-text">Services</span>
            </button>
          </li>
          <li>
            <button type="button" class="stepper-step" data-step="2">
              <span class="stepper-icon">3</span>
              <span class="stepper-text">Location</span>
            </button>
          </li>
          <li>
            <button type="button" class="stepper-step" data-step="3">
              <span class="stepper-icon">4</span>
              <span class="stepper-text">Calendar</span>
            </button>
          </li>
          <li>
            <button type="button" class="stepper-step" data-step="4">
              <span class="stepper-icon">5</span>
              <span class="stepper-text">Fee</span>
            </button>
          </li>
          <li>
            <button type="button" class="stepper-step" data-step="5">
              <span class="stepper-icon">6</span>
              <span class="stepper-text">Payment</span>
            </button>
          </li>
          <li>
            <button type="button" class="stepper-step" data-step="6">
              <span class="stepper-icon">7</span>
              <span class="stepper-text">Review</span>
            </button>
          </li>
        </ol>
      </div>

      <div class="booking-body">
        <input id="serviceType" type="hidden" value="core" />
        <input id="serviceId" name="serviceId" type="hidden" />

        <div class="booking-step" data-step="0">
          <h5>
            <i class="bi bi-person-vcard me-2"></i>Customer
          </h5>
          <div class="mb-3">
            <label class="form-label fw-semibold">Customer Type</label>
            <div class="d-flex gap-3">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="customerType" id="custNew" value="new" checked />
                <label class="form-check-label" for="custNew">New customer</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="customerType" id="custExisting" value="existing" />
                <label class="form-check-label" for="custExisting">Existing customer</label>
              </div>
            </div>
          </div>
          <div id="existingCustomerNote" class="mb-2 text-muted d-none">
            Existing account detected; only the email is shown.
          </div>
          <div id="autoCreateAccountNote" class="mb-2 text-muted">
            For <strong>new customers</strong> an account will be automatically
            created when you complete the booking.
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="customerEmail">Email</label>
              <input id="customerEmail" name="customerEmail" type="email" class="form-control" maxlength="120" required />
            </div>
            <div class="col-md-6 existing-only">
              <label class="form-label" for="firstName">First Name</label>
              <input id="firstName" name="firstName" class="form-control" required maxlength="80" />
            </div>
            <div class="col-md-6 existing-only">
              <label class="form-label" for="lastName">Last Name</label>
              <input id="lastName" name="lastName" class="form-control" required maxlength="80" />
            </div>
            <div class="col-md-6 existing-only">
              <label class="form-label" for="customerPhone">Phone Number</label>
              <input id="customerPhone" name="customerPhone" class="form-control" required maxlength="40" />
            </div>
            <div class="col-md-3 existing-only">
              <label class="form-label" for="addrProvince">Province</label>
              <select id="addrProvince" name="addrProvince" class="form-select" required>
                <option value="">Select Province</option>
              </select>
            </div>
            <div class="col-md-4 existing-only">
              <label class="form-label" for="addrCity">City</label>
              <select id="addrCity" name="addrCity" class="form-select" disabled required>
                <option value="">Select City/Municipality</option>
              </select>
            </div>
            <div class="col-md-3 existing-only">
              <label class="form-label" for="addrBarangay">Barangay</label>
              <select id="addrBarangay" name="addrBarangay" class="form-select" disabled required>
                <option value="">Select Barangay</option>
              </select>
            </div>
            <div class="col-md-2 existing-only">
              <label class="form-label" for="addrPostalCode">Postal Code</label>
              <input id="addrPostalCode" name="addrPostalCode" class="form-control" maxlength="20" />
            </div>
          </div>
          <div class="walkin-actions">
            <button type="button" class="btn btn-primary btn-sm" data-next-step="1">
              Continue to Services
            </button>
          </div>
        </div>

        <div class="booking-step d-none" data-step="1">
          <h5 class="fw-semibold mb-2"><i class="bi bi-tools me-2"></i>Select Services</h5>
          <p class="text-muted small mb-3">Choose multiple services. For aircon services, HP rating will be selected per item.</p>

          <!-- Service Categories Tabs -->
          <ul class="nav nav-tabs mb-3" id="serviceTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="core-tab" data-bs-toggle="tab" data-bs-target="#core-services" type="button" role="tab" aria-controls="core-services" aria-selected="true">
                <i class="bi bi-gear-fill me-2"></i>Core Services
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="repair-tab" data-bs-toggle="tab" data-bs-target="#repair-services" type="button" role="tab" aria-controls="repair-services" aria-selected="false">
                <i class="bi bi-tools me-2"></i>Repair Services
              </button>
            </li>
          </ul>

          <!-- Tab Content -->
          <div class="tab-content" id="serviceTabContent">
            <div class="tab-pane fade show active" id="core-services" role="tabpanel" aria-labelledby="core-tab">
              <div class="row g-3" id="coreServiceCards"></div>
            </div>
            <div class="tab-pane fade" id="repair-services" role="tabpanel" aria-labelledby="repair-tab">
              <div class="row g-3" id="repairServiceCards"></div>
            </div>
          </div>

          <!-- Selected Services Summary -->
          <div class="mt-4" id="selectedServicesSummary">
            <div class="card border-0 bg-light">
              <div class="card-header bg-light">
                <h6 class="mb-0 fw-semibold">
                  <i class="bi bi-cart-check me-2"></i>Selected Services
                  <span class="badge bg-primary ms-2" id="selectedServiceCount">0</span>
                </h6>
              </div>
              <div class="card-body">
                <div id="selectedServicesList">
                  <p class="text-muted mb-0">No services selected yet</p>
                </div>
                <div class="mt-3 pt-3 border-top d-none" id="totalPricingSection">
                  <div class="row align-items-center">
                    <div class="col-md-6">
                      <div class="fw-semibold">Total Estimated Price:</div>
                    </div>
                    <div class="col-md-6 text-end">
                      <div class="fs-4 fw-bold text-primary" id="totalEstimatedPrice">₱0</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Issue Notes -->
          <div class="mt-3">
            <label class="form-label" for="issueDescription">Issue / Notes <span class="text-muted fw-normal">(optional)</span></label>
            <textarea id="issueDescription" name="issueDescription" rows="3" class="form-control" maxlength="600" placeholder="Describe the issue or any special instructions..."></textarea>
          </div>

          <div class="walkin-actions">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-prev-step="0">Back</button>
            <button type="button" class="btn btn-primary btn-sm" data-next-step="2">Continue to Location</button>
          </div>
        </div>

        <div class="booking-step d-none" data-step="2">
          <h5>
            <i class="bi bi-geo-alt me-2"></i>Technician & Location
          </h5>
          <div class="row g-3">
            <div class="col-lg-5">
              <label class="form-label" for="technicianId">Technician</label>
              <select
                id="technicianId"
                name="technicianId"
                class="form-select"
              ></select>

              <label class="form-label mt-3" for="locationInput"
                >Address or Coordinates</label
              >
              <input
                id="locationInput"
                class="form-control"
                placeholder="e.g. 14.676049,121.043731 or address"
              />
              <div id="locationSuggest" class="list-group mt-1 d-none"></div>

              <div class="d-flex gap-2 mt-2">
                <button
                  type="button"
                  id="detectLocationBtn"
                  class="btn btn-outline-primary btn-sm"
                >
                  <i class="bi bi-crosshair me-1"></i>Use Current Location
                </button>
                <button
                  type="button"
                  id="resolveAddressBtn"
                  class="btn btn-outline-secondary btn-sm"
                >
                  Resolve Address
                </button>
              </div>
              <p class="small mt-2 mb-0" id="locationStatus">
                Set customer location to compute travel fare and available
                slots.
              </p>

              <div
                class="alert alert-light border mt-3 mb-0 small"
                id="mapDistanceInfo"
              >
                Distance and ETA will appear here after setting location.
              </div>
            </div>
            <div class="col-lg-7">
              <div class="map-wrap">
                <div
                  id="technicianMap"
                  class="technician-map"
                  data-technician-lat="14.676049"
                  data-technician-lng="121.043731"
                ></div>
              </div>
            </div>
          </div>
          <div class="walkin-actions">
            <button
              type="button"
              class="btn btn-outline-secondary btn-sm"
              data-prev-step="1"
            >
              Back
            </button>
            <button
              type="button"
              class="btn btn-primary btn-sm"
              data-next-step="3"
            >
              Continue to Calendar
            </button>
          </div>
        </div>

        <div class="booking-step d-none" data-step="3">
          <h5>
            <i class="bi bi-calendar-check me-2"></i>Calendar & Available Time
          </h5>
          <p class="small text-muted mb-2">
            Only available times are listed. Double booking is blocked in UI and
            re-checked in backend.
          </p>

          <!-- AI Suggested Dates Section -->
          <div id="suggestedWrapper" class="d-none mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <h6 class="mb-0">
                <i class="bi bi-lightbulb me-2"></i>AI-Suggested Dates
              </h6>
              <small class="text-muted">Smart recommendations based on availability</small>
            </div>
            <div class="row g-3" id="suggestedCards">
              <!-- Suggested date cards will be inserted here -->
            </div>
          </div>

          <div class="calendar-widget border rounded-4 bg-light p-3">
            <div
              class="calendar-header d-flex align-items-center justify-content-between mb-2"
            >
              <button
                type="button"
                class="btn btn-sm btn-outline-secondary"
                data-calendar-nav="prev"
              >
                <i class="bi bi-chevron-left"></i>
              </button>
              <div class="fw-semibold" data-calendar-label></div>
              <button
                type="button"
                class="btn btn-sm btn-outline-secondary"
                data-calendar-nav="next"
              >
                <i class="bi bi-chevron-right"></i>
              </button>
            </div>
            <div
              class="calendar-grid"
              id="calendarGrid"
              role="grid"
              aria-live="polite"
            ></div>
          </div>

          <div id="timeSelection" class="mt-3 d-none">
            <div class="small text-muted mb-1" id="timeRangeInfo"></div>
            <div class="d-flex flex-wrap gap-2" id="timeSlots"></div>
          </div>
          <p class="small text-muted mt-2 mb-0" id="timeNotice"></p>

          <div class="walkin-actions">
            <button
              type="button"
              class="btn btn-outline-secondary btn-sm"
              data-prev-step="2"
            >
              Back
            </button>
            <button
              type="button"
              class="btn btn-primary btn-sm"
              data-next-step="4"
            >
              Continue to Fee
            </button>
          </div>
        </div>

        <div class="booking-step d-none" data-step="5">
          <h5><i class="bi bi-cash-coin me-2"></i>Cash Payment</h5>
          <div
            class="payment-tabs"
            role="tablist"
            aria-label="Cash payment mode"
          >
            <button
              type="button"
              class="payment-tab active"
              data-cash-mode="downpayment"
            >
              <i class="bi bi-cash-stack"></i>Downpayment
            </button>
            <button type="button" class="payment-tab" data-cash-mode="full">
              <i class="bi bi-cash"></i>Full Payment
            </button>
          </div>
          <input
            class="d-none"
            type="hidden"
            name="paymentMethod"
            id="payCod"
            value="cod"
          />

          <!-- amount input is shown; reference and mark-as-paid are removed -->
          <div class="row g-3">
            <div class="col-md-12" id="cashInfoNotice">
              <p class="small text-muted">
                Reference number will be generated automatically. For
                downpayment mode the booking will be marked
                <strong>partial</strong>; for full payment the status becomes
                <strong>paid</strong>.
              </p>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="downpaymentAmount"
                >Amount collected now (₱)</label
              >
              <input
                id="downpaymentAmount"
                name="downpaymentAmount"
                type="number"
                step="0.01"
                min="0"
                class="form-control"
              />
              <div
                id="paymentAmountHint"
                class="form-text small text-muted"
              ></div>
            </div>
          </div>

          <div class="walkin-actions">
            <button
              type="button"
              class="btn btn-outline-secondary btn-sm"
              data-prev-step="4"
            >
              Back
            </button>
            <button
              type="button"
              class="btn btn-primary btn-sm"
              data-next-step="6"
            >
              Continue to Review
            </button>
          </div>
        </div>

        <!-- Step 4: Total Fee Breakdown -->
        <div class="booking-step d-none" data-step="4">
          <h5><i class="bi bi-receipt me-2"></i>Total Fee Breakdown</h5>
          <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
              <div class="mb-3">
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Services Total:</span>
                  <span class="fw-semibold" id="servicesTotalDisplay">₱0</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Travel Fare:</span>
                  <span class="fw-semibold" id="travelFareDisplay">₱0</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between align-items-center">
                  <span class="fs-5 fw-bold">Total Amount:</span>
                  <span class="fs-3 fw-bold text-primary" id="totalFeeDisplay">₱0</span>
                </div>
              </div>
              <div id="feeServiceDetails" class="mt-3 small text-muted"></div>
              <div id="repairNote" class="alert alert-info mt-3 d-none" style="font-size: 0.9rem;">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Note:</strong> For repair services, the final cost will be determined by the technician after diagnosis.
              </div>
            </div>
          </div>
          <div class="walkin-actions">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-prev-step="3">Back</button>
            <button type="button" class="btn btn-primary btn-sm" data-next-step="5">Continue to Payment</button>
          </div>
        </div>

        <div class="booking-step d-none" data-step="6">
          <h5><i class="bi bi-receipt me-2"></i>Review & Create</h5>
          <div class="summary-box mb-3" id="walkinSummary">
            Complete previous steps to preview totals and schedule.
          </div>
          <div class="walkin-actions">
            <button
              type="button"
              class="btn btn-outline-secondary btn-sm"
              data-prev-step="5"
            >
              Back
            </button>
            <button
              id="saveWalkinBtn"
              type="submit"
              class="btn btn-primary btn-sm"
            >
              <i class="bi bi-check2-circle me-1"></i>Create Walk-in Appointment
            </button>
            <a
              href="/admin/appointments"
              class="btn btn-outline-secondary btn-sm"
              >Cancel</a
            >
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<script>
  (function () {
    const state = {
      coreServices: [],
      repairServices: [],
      technicians: [],
      currentStep: 0, // start at customer type step
      isNewCustomer: true,
      selectedServiceId: "",
      selectedDate: null,
      selectedStartMinutes: null,
      paymentMethod: "cod",
      cashPaymentMode: "downpayment",
      travelFare: 0,
      travelTime: 0,
      farePerKm: 40,
      customerCoords: null,
      techCoords: { lat: 14.676049, lng: 121.043731 },
      calendar: {
        activeMonth: new Date(
          new Date().getFullYear(),
          new Date().getMonth(),
          1,
        ),
        bookedDates: new Set(),
        blockedDates: new Set(),
        publicHolidays: new Map(),
        nonWorkingWeekdays: [],
        restDates: new Set(),
      },
      map: null,
      markers: { tech: null, customer: null },
      route: null,
    };

    const form = document.getElementById("walkinForm");
    const alertEl = document.getElementById("walkinAlert");
    let alertModal = null;
    const serviceTypeEl = document.getElementById("serviceType");
    const serviceIdEl = document.getElementById("serviceId");
    const serviceCardsEl = document.getElementById("serviceCards") || document.getElementById("coreServiceCards");
    const techEl = document.getElementById("technicianId");
    // sync state when customer type radio changes
    document.getElementById("custNew").addEventListener("change", () => {
      state.isNewCustomer = true;
      adjustCustomerDetailsStep();
    });
    document.getElementById("custExisting").addEventListener("change", () => {
      state.isNewCustomer = false;
      adjustCustomerDetailsStep();
    });
    const locationInputEl = document.getElementById("locationInput");
    const locationSuggestEl = document.getElementById("locationSuggest");
    const locationStatusEl = document.getElementById("locationStatus");
    const summaryEl = document.getElementById("walkinSummary");
    const saveBtn = document.getElementById("saveWalkinBtn");
    const mapDistanceInfoEl = document.getElementById("mapDistanceInfo");
    const calendarGridEl = document.getElementById("calendarGrid");
    const calendarLabelEl = document.querySelector("[data-calendar-label]");
    const timeSelectionEl = document.getElementById("timeSelection");
    const timeSlotsEl = document.getElementById("timeSlots");
    const timeRangeInfoEl = document.getElementById("timeRangeInfo");
    const timeNoticeEl = document.getElementById("timeNotice");

    function showAlert(type, message) {
      const titles = { warning: "Attention", danger: "Error", success: "Success", info: "Notice" };
      const icons = { warning: "exclamation-triangle-fill", danger: "x-circle-fill", success: "check-circle-fill", info: "info-circle-fill" };
      const colors = { warning: "#f59e0b", danger: "#dc2626", success: "#16a34a", info: "#2563eb" };
      const color = colors[type] || colors.info;
      const icon = (type === "success")
        ? (state.isNewCustomer ? "person-plus-fill" : "person-check-fill")
        : (icons[type] || icons.info);
      document.getElementById("walkinAlertLabel").textContent = titles[type] || "Notice";
      document.getElementById("walkinAlertHeader").style.background = color;
      document.getElementById("walkinAlertBody").innerHTML =
        '<div class="text-center"><i class="bi bi-' + icon + '" style="font-size:3.5rem;color:' + color + ';"></i></div>' +
        '<p class="text-center mb-0 mt-3" style="font-size:1rem;color:#334155;line-height:1.5;">' + message + '</p>';
      if (!alertModal) alertModal = new bootstrap.Modal(alertEl, { backdrop: true, keyboard: true });
      alertModal.show();
    }
    function hideAlert() {
      if (alertModal) alertModal.hide();
    }
    function pad2(n) {
      return String(n).padStart(2, "0");
    }
    function startOfDay(date) {
      return new Date(date.getFullYear(), date.getMonth(), date.getDate());
    }
    function startOfMonth(date) {
      return new Date(date.getFullYear(), date.getMonth(), 1);
    }
    function addMonths(date, amount) {
      const c = new Date(date);
      c.setMonth(c.getMonth() + amount);
      return startOfMonth(c);
    }
    function addDays(date, amount) {
      const c = new Date(date);
      c.setDate(c.getDate() + amount);
      return c;
    }
    function formatDateKey(date) {
      return `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())}`;
    }
    function isSameDate(a, b) {
      return (
        a &&
        b &&
        a.getFullYear() === b.getFullYear() &&
        a.getMonth() === b.getMonth() &&
        a.getDate() === b.getDate()
      );
    }
    function minutesToLabel(m) {
      const h = Math.floor(m / 60);
      const mm = m % 60;
      const ap = h >= 12 ? "PM" : "AM";
      const h12 = ((h + 11) % 12) + 1;
      return `${pad2(h12)}:${pad2(mm)} ${ap}`;
    }
    function minutesToHHMM(m) {
      return `${pad2(Math.floor(m / 60))}:${pad2(m % 60)}`;
    }

    function setSelectByText(selectEl, text) {
      if (!selectEl || !text) return false;
      const opt = Array.from(selectEl.options).find(
        (o) => o.textContent.trim().toLowerCase() === String(text).trim().toLowerCase()
      );
      if (opt) {
        selectEl.value = opt.value;
        selectEl.dispatchEvent(new Event("change"));
        return true;
      }
      return false;
    }

    function currentServiceList() {
      return serviceTypeEl.value === "repair"
        ? state.repairServices
        : state.coreServices;
    }
    function currentService() {
      return currentServiceList().find(
        (s) => String(s._id) === String(state.selectedServiceId),
      );
    }

    function goToStep(step) {
      state.currentStep = Number(step);
      document.querySelectorAll(".booking-step[data-step]").forEach((el) => {
        const isActive =
          Number(el.getAttribute("data-step")) === state.currentStep;
        el.classList.toggle("d-none", !isActive);
      });
      document.querySelectorAll(".stepper-step[data-step]").forEach((el) => {
        const stepNum = Number(el.getAttribute("data-step"));
        const isActive = stepNum === state.currentStep;
        const isCompleted = stepNum < state.currentStep;
        
        el.classList.toggle("is-active", isActive);
        el.classList.toggle("is-completed", isCompleted);
        const li = el.closest("li");
        if (li) li.classList.toggle("is-completed", isCompleted);
      });
      if (state.currentStep === 0) {
        // coming back to customer details, ensure inputs editable
        ["firstName", "lastName", "customerPhone", "customerEmail"].forEach((id) => {
          const el = document.getElementById(id);
          if (el) el.disabled = false;
        });
        // For address selects: enable province, keep city/barangay as-is (PSGC manages them)
        const provEl = document.getElementById("addrProvince");
        if (provEl) provEl.disabled = false;
        adjustCustomerDetailsStep();
      }
      if (state.currentStep === 2) initMap();
      if (state.currentStep === 3) {
        renderCalendar();
        if (state.selectedDate) renderTimeSlotsForDate(state.selectedDate);
      }
      updateSummary();
    }

    // show or hide fields on the customer details step depending on new/existing
    function adjustCustomerDetailsStep() {
      const show = state.isNewCustomer;
      // hide name/phone/address for existing users
      document.querySelectorAll(".existing-only").forEach((el) => {
        el.classList.toggle("d-none", !show);
      });
      // email field should always be editable here; we disable it only after an
      // existing user has been looked up (handled elsewhere if desired)
      const note = document.getElementById("existingCustomerNote");
      if (note) note.classList.toggle("d-none", show);
    }

    // Reusable async email check: validates email, looks up DB, populates or enables fields.
    // Returns true if navigation should proceed, false to abort.
    async function checkCustomerEmail() {
      const email = document.getElementById("customerEmail").value.trim();
      const isNew = document.getElementById("custNew").checked;
      if (!email) { showWarn("Email is required."); return false; }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showWarn("Please enter a valid email address.");
        return false;
      }

      try {
        const resp = await fetch(
          `/api/users?email=${encodeURIComponent(email)}`,
        );
        if (resp.ok) {
          const json = await resp.json();
          document.getElementById("customerEmail").value = email;

          if (json.user) {
            if (isNew) {
              if (!confirm(`Email "${email}" already exists in our system. Would you like to use the existing customer account instead?`)) {
                return false;
              }
              document.getElementById("custExisting").checked = true;
              document.getElementById("custNew").checked = false;
              state.isNewCustomer = false;
            } else if (!isNew) {
              state.isNewCustomer = false;
            }

            const u = json.user;
            document.getElementById("firstName").value = u.firstName || "";
            document.getElementById("lastName").value = u.lastName || "";
            document.getElementById("customerPhone").value = u.phone || "";
            if (u.address) {
              setSelectByText(document.getElementById("addrProvince"), u.address.province);
              setTimeout(() => {
                setSelectByText(document.getElementById("addrCity"), u.address.city);
                setTimeout(() => {
                  setSelectByText(document.getElementById("addrBarangay"), u.address.barangay);
                }, 300);
              }, 300);
              document.getElementById("addrPostalCode").value =
                u.address.postalCode || "";
            }
            ["firstName", "lastName", "customerPhone", "addrProvince", "addrCity", "addrBarangay", "addrPostalCode"].forEach((id) => {
              document.getElementById(id).disabled = true;
            });

            showSuccess("Existing customer account found and loaded.");
          } else {
            if (!isNew) {
              if (!confirm(`No account found for email "${email}". Would you like to create a new customer account instead?`)) {
                return false;
              }
              document.getElementById("custNew").checked = true;
              document.getElementById("custExisting").checked = false;
              state.isNewCustomer = true;
            } else if (isNew) {
              state.isNewCustomer = true;
            }

            ["firstName", "lastName", "customerPhone", "addrProvince", "addrPostalCode", "customerEmail"].forEach((id) => {
              document.getElementById(id).disabled = false;
            });

            showSuccess("Email is available for new customer account.");
          }
          adjustCustomerDetailsStep();
          return true;
        } else {
          showWarn("Failed to verify email. Please try again.");
          return false;
        }
      } catch (e) {
        console.warn("check email failed", e);
        showWarn("Network error while verifying email. Please try again.");
        return false;
      }
    }

    function validateStep(step) {
      if (step === 0) {
        // Validate customer details (combined type + details on this step)
        const email = document.getElementById("customerEmail").value.trim();
        const re = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
        if (!email || !re.test(email))
          return showWarn("Valid customer email is required.");
        if (state.isNewCustomer) {
          const first = document.getElementById("firstName").value.trim();
          const last = document.getElementById("lastName").value.trim();
          const phone = document.getElementById("customerPhone").value.trim();
          const city = document.getElementById("addrCity").value.trim();
          if (!first || !last || !phone || !city)
            return showWarn("First/last name, phone and city are required.");
        }
      }
      if (step === 1 && !state.selectedServiceId)
        return showWarn("Please select one service card.");
      if (step === 2) {
        if (!techEl.value) return showWarn("Please select a technician.");
        if (!state.customerCoords)
          return showWarn(
            "Please set customer location on map (address, coordinates, or current location).",
          );
      }
      if (step === 3) {
        if (!state.selectedDate || state.selectedStartMinutes == null)
          return showWarn("Please choose a date and available time slot.");
      }
      if (step === 5) {
        const amount = Number(
          document.getElementById("downpaymentAmount").value,
        );
        if (!Number.isFinite(amount) || amount <= 0)
          return showWarn("Please enter a valid amount collected now.");
      }
      hideAlert();
      return true;
    }

    function showWarn(message) {
      showAlert("warning", message);
      return false;
    }

    function showSuccess(message) {
      showAlert("success", message);
      return true;
    }

    function renderServiceCards() {
      const coreCardsEl = document.getElementById("coreServiceCards");
      const repairCardsEl = document.getElementById("repairServiceCards");

      function renderListInto(container, services, serviceType) {
        if (!container) return;
        if (!services.length) {
          container.innerHTML =
            '<div class="col-12 text-center py-4"><i class="bi bi-inbox fs-3 text-muted d-block mb-2"></i><span class="text-muted small">No active services in this category.</span></div>';
          return;
        }
        container.innerHTML = services
          .map((s) => {
            const selected = String(s._id) === String(state.selectedServiceId);
            const duration = Number(s.durationMinutes || s.estimatedDurationMinutes || s.duration || 60);
            const basePrice = Number(s.basePrice || s.price || 0);
            const priceRange = s.priceRange;
            const isAircon = s.isAirconService && s.hpPricing && s.hpPricing.length > 0;

            let priceDisplay = '';
            if (isAircon) {
              const minP = Math.min(...s.hpPricing.map(h => h.price));
              const maxP = Math.max(...s.hpPricing.map(h => h.price));
              priceDisplay = '\u20B1' + minP.toLocaleString() + ' - \u20B1' + maxP.toLocaleString();
            } else if (priceRange) {
              priceDisplay = '\u20B1' + Number(priceRange.min).toLocaleString() + ' - \u20B1' + Number(priceRange.max).toLocaleString();
            } else if (basePrice > 0) {
              priceDisplay = '\u20B1' + basePrice.toLocaleString();
            } else {
              priceDisplay = 'Price on quote';
            }

            const icon = s.icon || (serviceType === "repair" ? "bi bi-tools" : "bi bi-gear-fill");
            const typeBadge = isAircon
              ? '<span class="badge bg-info text-dark service-card-chip">HP-based</span>'
              : serviceType === "repair"
                ? '<span class="badge bg-secondary text-white service-card-chip">Repair</span>'
                : '<span class="badge bg-primary service-card-chip">Service</span>';
            const durationLabel = duration + ' min';
            return `
          <div class="col-md-6 col-lg-4">
            <article class="card service-card h-100 border-0 shadow-sm ${selected ? "active" : ""}" data-service-id="${s._id}" data-service-type="${serviceType}">
              <div class="card-body p-4 d-flex flex-column h-100">
                <div class="d-flex align-items-start gap-3 mb-4">
                  <div class="service-icon shadow-sm">
                    <i class="${icon} fs-4 text-primary"></i>
                  </div>
                  <div class="flex-grow-1">
                    <div class="service-card-header d-flex flex-column gap-2">
                      <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                        <div>
                          <h6 class="card-title fw-semibold mb-1 text-dark">${s.name || "Unnamed Service"}</h6>
                          <div class="small text-muted">Tap Add to Booking for details and pricing options.</div>
                        </div>
                        <div class="price-box rounded-pill px-3 py-2 fw-bold text-primary">
                          ${priceDisplay}
                        </div>
                      </div>
                      <div class="d-flex flex-wrap gap-2 align-items-center service-card-meta">
                        ${typeBadge}
                        <span class="badge bg-light text-muted service-card-chip">${durationLabel}</span>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="mt-auto pt-2">
                  <button class="btn btn-primary btn-sm w-100 add-service-btn"
                          data-service-id="${s._id}"
                          data-service-type="${serviceType}"
                          data-service-name="${s.name || ""}"
                          data-is-aircon="${isAircon}">
                    <i class="bi bi-plus-circle me-2"></i>Add to Booking
                  </button>
                </div>
              </div>
            </article>
          </div>`;
          })
          .join("");
      }

      renderListInto(coreCardsEl, state.coreServices || [], "core");
      renderListInto(repairCardsEl, state.repairServices || [], "repair");

      const allServices = [...(state.coreServices || []), ...(state.repairServices || [])];
      if (allServices.length && !allServices.some((s) => String(s._id) === String(state.selectedServiceId))) {
        state.selectedServiceId = String(allServices[0]._id);
      }

      if (!allServices.length) {
        state.selectedServiceId = "";
      }

      serviceIdEl.value = state.selectedServiceId;
      updateSummary();
    }

    function renderTechnicians() {
      techEl.innerHTML =
        '<option value="">Select technician</option>' +
        state.technicians
          .map(
            (t) =>
              `<option value="${t._id}">${t.name || "Unnamed"}${t.phone ? " • " + t.phone : ""}</option>`,
          )
          .join("");
    }

