              }
            }
            
            // Fallback to technician coordinates if available in different format
            if (!techCoords && appt.technicianCoords) {
              techCoords = parseCoords(appt.technicianCoords);
              console.log('Technician coords from technicianCoords:', techCoords);
            }
            
            // Use the _tlat and _tlng variables that were already calculated (most reliable)
            if (!techCoords && Number.isFinite(_tlat) && Number.isFinite(_tlng)) {
              techCoords = { lat: _tlat, lng: _tlng };
              techLocationInfo = 'Technician location';
              console.log('Technician coords from _tlat/_tlng:', techCoords);
            }
            
            // Additional fallback: try to extract from any nested location objects
            if (!techCoords) {
              const possibleTechFields = [
                'technicianLocation',
                'technician',
                'techLocation',
                'serviceProviderLocation'
              ];
              
              for (const field of possibleTechFields) {
                if (appt[field] && typeof appt[field] === 'object') {
