<div class="admin-dashboard container-fluid py-4">
  <%- include('../../../partials/dashboard-styles') %>
  <style>
    .sc-table{width:100%;border-collapse:separate;border-spacing:0}
    .sc-table th{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#64748b;padding:10px 16px;border-bottom:2px solid #e2e8f0;background:#f8fafc}
    .sc-table td{padding:12px 16px;border-bottom:1px solid #edf2f7;vertical-align:middle}
    .sc-table tr:hover td{background:#f8fafc}
    .sc-icon-badge{width:38px;height:38px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;font-size:1rem;color:#fff;flex-shrink:0}
    .sc-icon-badge.blue{background:linear-gradient(135deg,#2563eb,#1d4ed8)}
    .sc-icon-badge.amber{background:linear-gradient(135deg,#f59e0b,#d97706)}
    .sc-icon-badge.violet{background:linear-gradient(135deg,#8b5cf6,#6d28d9)}
    .sc-icon-badge.green{background:linear-gradient(135deg,#10b981,#059669)}
    .sc-icon-badge.red{background:linear-gradient(135deg,#ef4444,#dc2626)}
    .sc-icon-badge.cyan{background:linear-gradient(135deg,#06b6d4,#0891b2)}
    .sc-unit-chip{display:inline-flex;align-items:center;gap:4px;font-size:.7rem;font-weight:600;padding:3px 10px;border-radius:999px;background:#f1f5f9;color:#475569;margin:2px}
    .sc-unit-chip i{font-size:.65rem}
    .sc-badge{font-size:.62rem;font-weight:700;padding:3px 8px;border-radius:999px}
    .sc-badge.active{background:#ecfdf5;color:#059669}
    .sc-badge.inactive{background:#fef2f2;color:#dc2626}
    .sc-badge.custom{background:#eff6ff;color:#2563eb}
    .sc-add-btn{display:inline-flex;align-items:center;gap:6px;font-size:.78rem;font-weight:600;padding:6px 14px;border-radius:8px;border:2px dashed #cbd5e1;background:#fff;color:#475569;cursor:pointer;transition:all .2s}
    .sc-add-btn:hover{border-color:#2563eb;color:#2563eb;background:#eff6ff}
    .sc-modal .modal-content{border-radius:16px;border:none}
    .sc-modal .modal-header{border-bottom:1px solid #edf2f7;padding:18px 24px}
    .sc-modal .modal-body{padding:20px 24px}
    .sc-form-label{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#64748b;margin-bottom:6px}
    .sc-form-control{border-radius:10px;border-color:#e2e8f0;font-size:.85rem}
    .sc-form-control:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,0.1)}
    .sc-unit-row{display:flex;align-items:center;gap:8px;padding:8px 12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:6px}
    .sc-unit-row input{flex:1}
    .sc-unit-row .btn{flex-shrink:0}
    .icon-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:6px;max-height:200px;overflow-y:auto;padding:8px}
    .icon-option{width:100%;aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:8px;border:2px solid #e2e8f0;cursor:pointer;font-size:1rem;color:#475569;transition:all .15s}
    .icon-option:hover{border-color:#2563eb;color:#2563eb;background:#eff6ff}
    .icon-option.selected{border-color:#2563eb;background:#2563eb;color:#fff}
  </style>

  <% const cats = serviceCategories || []; %>

  <!-- Hero Header -->
  <div class="au-hero mb-4"><div class="au-hero-inner"><div class="au-hero-left"><div class="au-hero-icon"><i class="bi bi-grid-3x3-gap"></i></div><div><h1>Repair Service Categories</h1><p>Manage repair request categories and unit types shown to customers</p></div></div><div class="rr-actions"><a class="rr-btn" href="/admin/services/core"><i class="bi bi-gear me-1"></i> Core Services</a></div></div></div>

  <!-- KPI Summary -->
  <div class="kpi-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:24px;">
    <div class="kpi-enterprise" data-accent="blue"><div class="kpi-enterprise-top"><div class="kpi-enterprise-icon blue"><i class="bi bi-grid-3x3-gap"></i></div></div><div class="kpi-enterprise-body"><p class="kpi-enterprise-label">Total Categories</p><div class="kpi-enterprise-value"><%= cats.length %></div></div></div>
    <div class="kpi-enterprise" data-accent="green"><div class="kpi-enterprise-top"><div class="kpi-enterprise-icon green"><i class="bi bi-check-circle"></i></div></div><div class="kpi-enterprise-body"><p class="kpi-enterprise-label">Active</p><div class="kpi-enterprise-value"><%= cats.filter(c=>c.active).length %></div></div></div>
    <div class="kpi-enterprise" data-accent="amber"><div class="kpi-enterprise-top"><div class="kpi-enterprise-icon amber"><i class="bi bi-tags"></i></div></div><div class="kpi-enterprise-body"><p class="kpi-enterprise-label">Total Unit Types</p><div class="kpi-enterprise-value"><%= cats.reduce((s,c)=>s+c.unitTypes.length,0) %></div></div></div>
    <div class="kpi-enterprise" data-accent="purple"><div class="kpi-enterprise-top"><div class="kpi-enterprise-icon purple"><i class="bi bi-plus-circle"></i></div></div><div class="kpi-enterprise-body"><p class="kpi-enterprise-label">Custom Category</p><div class="kpi-enterprise-value"><%= cats.filter(c=>c.isCustom).length %></div></div></div>
  </div>

  <!-- Category Table -->
  <div class="dash-card">
    <div style="padding:16px 20px;border-bottom:1px solid #edf1f6;display:flex;justify-content:space-between;align-items:center;">
      <h6 style="margin:0;font-weight:700;"><i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Service Categories & Unit Types</h6>
      <button class="sc-add-btn" onclick="openAddModal()"><i class="bi bi-plus-lg"></i> Add Category</button>
    </div>
    <div style="overflow-x:auto;">
      <table class="sc-table" id="categoryTable">
        <thead><tr>
          <th style="width:50px;">#</th>
          <th>Category</th>
          <th>Slug</th>
          <th>Unit Types</th>
          <th style="text-align:center;">Status</th>
          <th style="text-align:right;width:160px;">Actions</th>
        </tr></thead>
        <tbody id="categoryTableBody">
          <% if (!cats.length) { %><tr><td colspan="6" style="text-align:center;color:#94a3b8;padding:40px;">No service categories found. Run the seed script or add one manually.</td></tr><% } %>
          <% cats.forEach(function(cat, i) { %>
          <tr data-id="<%= cat._id %>">
            <td style="font-weight:600;color:#94a3b8;"><%= i + 1 %></td>
            <td>
              <div style="display:flex;align-items:center;gap:10px;">
                <div class="sc-icon-badge <%= cat.iconColor %>"><i class="bi <%= cat.icon %>"></i></div>
                <div>
                  <div style="font-weight:700;color:#1e293b;"><%= cat.name %></div>
                  <% if (cat.isCustom) { %><span class="sc-badge custom">Custom Input</span><% } %>
                </div>
              </div>
            </td>
            <td><code style="font-size:.75rem;background:#f1f5f9;padding:2px 8px;border-radius:4px;"><%= cat.slug %></code></td>
            <td>
              <div style="display:flex;flex-wrap:wrap;gap:3px;max-width:400px;">
                <% cat.unitTypes.forEach(function(ut) { %>
                  <span class="sc-unit-chip"><i class="bi <%= ut.icon %>"></i> <%= ut.label %></span>
                <% }); %>
              </div>
            </td>
            <td style="text-align:center;"><span class="sc-badge <%= cat.active ? 'active' : 'inactive' %>"><%= cat.active ? 'Active' : 'Inactive' %></span></td>
            <td style="text-align:right;">
              <div style="display:flex;gap:6px;justify-content:flex-end;">
                <button class="btn btn-sm btn-outline-primary" style="border-radius:8px;font-size:.72rem;" onclick="openEditModal('<%= cat._id %>')"><i class="bi bi-pencil"></i> Edit</button>
                <% if (!cat.isCustom) { %>
                <button class="btn btn-sm btn-outline-danger" style="border-radius:8px;font-size:.72rem;" onclick="toggleCategory('<%= cat._id %>', <%= cat.active %>)"><i class="bi bi-<%= cat.active ? 'pause' : 'play' %>"></i></button>
                <% } %>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add/Edit Modal -->
  <div class="modal fade sc-modal" id="categoryModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title" id="modalTitle"><i class="bi bi-grid-3x3-gap me-2"></i>Add Service Category</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <input type="hidden" id="modalCatId" value="" />
      <div class="row g-3">
        <div class="col-md-6">
          <label class="sc-form-label">Category Name *</label>
          <input type="text" class="form-control sc-form-control" id="catName" placeholder="e.g. Air Conditioning" />
        </div>
        <div class="col-md-6">
          <label class="sc-form-label">Slug *</label>
          <input type="text" class="form-control sc-form-control" id="catSlug" placeholder="e.g. aircon" />
        </div>
        <div class="col-md-6">
          <label class="sc-form-label">Icon (Bootstrap Icons)</label>
          <input type="text" class="form-control sc-form-control" id="catIcon" placeholder="e.g. bi-snow" value="bi-grid" />
        </div>
        <div class="col-md-6">
          <label class="sc-form-label">Icon Color</label>
          <select class="form-select sc-form-control" id="catIconColor">
            <option value="blue">Blue</option><option value="amber">Amber</option><option value="violet">Violet</option>
            <option value="green">Green</option><option value="red">Red</option><option value="cyan">Cyan</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="sc-form-label"><input type="checkbox" id="catIsCustom" /> Custom Input Category (free-text, no unit types)</label>
        </div>
        <div class="col-12">
          <label class="sc-form-label">Unit Types</label>
          <div id="unitTypeRows"></div>
          <button type="button" class="sc-add-btn" onclick="addUnitTypeRow()" id="addUnitTypeBtn"><i class="bi bi-plus"></i> Add Unit Type</button>
        </div>
      </div>
    </div>
    <div class="modal-footer" style="border-top:1px solid #edf1f7;padding:14px 24px;">
      <button type="button" class="btn btn-outline-secondary btn-sm" style="border-radius:8px;" data-bs-dismiss="modal">Cancel</button>
      <button type="button" class="btn btn-primary btn-sm" style="border-radius:8px;" onclick="saveCategory()"><i class="bi bi-check-lg me-1"></i> Save Category</button>
    </div>
  </div></div></div>
</div>

<script>
(() => {
  const API = '/api/admin/service-categories';
  const PESO = n => '\u20B1' + Number(n || 0).toLocaleString();
  let allCategories = <%- JSON.stringify(cats) %>;

  function authFetch(url, opts = {}) {
    return fetch(url, { credentials: 'same-origin', headers: { 'Content-Type': 'application/json', ...opts.headers }, ...opts });
  }

  // ── Auto-generate slug from name ──
  document.getElementById('catName').addEventListener('input', function() {
    const slugField = document.getElementById('catSlug');
    if (!slugField.dataset.manual) {
      slugField.value = this.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }
  });
  document.getElementById('catSlug').addEventListener('input', function() {
    this.dataset.manual = '1';
  });

  // ── Toggle custom checkbox ──
  document.getElementById('catIsCustom').addEventListener('change', function() {
    document.getElementById('unitTypeRows').style.display = this.checked ? 'none' : '';
    document.getElementById('addUnitTypeBtn').style.display = this.checked ? 'none' : '';
  });

  // ── Unit type rows ──
  window.addUnitTypeRow = function(value = '', label = '', icon = 'bi-circle') {
    const container = document.getElementById('unitTypeRows');
    const row = document.createElement('div');
    row.className = 'sc-unit-row';
    row.innerHTML = `
      <input type="text" class="form-control form-control-sm" placeholder="Value (e.g. Split Type Aircon)" data-field="value" value="${value}" style="border-radius:8px;font-size:.82rem;" />
      <input type="text" class="form-control form-control-sm" placeholder="Label (e.g. Split Type)" data-field="label" value="${label}" style="border-radius:8px;font-size:.82rem;" />
      <input type="text" class="form-control form-control-sm" placeholder="Icon (bi-window)" data-field="icon" value="${icon}" style="border-radius:8px;font-size:.82rem;max-width:130px;" />
      <button type="button" class="btn btn-sm btn-outline-danger" style="border-radius:8px;" onclick="this.closest('.sc-unit-row').remove()"><i class="bi bi-trash"></i></button>
    `;
    container.appendChild(row);
  };

  function getUnitTypesFromForm() {
    const rows = document.querySelectorAll('#unitTypeRows .sc-unit-row');
    const types = [];
    rows.forEach(row => {
      const value = row.querySelector('[data-field="value"]').value.trim();
      const label = row.querySelector('[data-field="label"]').value.trim();
      const icon = row.querySelector('[data-field="icon"]').value.trim() || 'bi-circle';
      if (value && label) types.push({ value, label, icon });
    });
    return types;
  }

  // ── Open Add Modal ──
  window.openAddModal = function() {
    document.getElementById('modalCatId').value = '';
    document.getElementById('modalTitle').innerHTML = '<i class="bi bi-grid-3x3-gap me-2"></i>Add Service Category';
    document.getElementById('catName').value = '';
    document.getElementById('catSlug').value = '';
    document.getElementById('catSlug').dataset.manual = '';
    document.getElementById('catIcon').value = 'bi-grid';
    document.getElementById('catIconColor').value = 'blue';
    document.getElementById('catIsCustom').checked = false;
    document.getElementById('unitTypeRows').innerHTML = '';
    document.getElementById('unitTypeRows').style.display = '';
    document.getElementById('addUnitTypeBtn').style.display = '';
    addUnitTypeRow();
    new bootstrap.Modal(document.getElementById('categoryModal')).show();
  };

  // ── Open Edit Modal ──
  window.openEditModal = function(id) {
    const cat = allCategories.find(c => c._id === id);
    if (!cat) return;
    document.getElementById('modalCatId').value = cat._id;
    document.getElementById('modalTitle').innerHTML = '<i class="bi bi-pencil me-2"></i>Edit ' + cat.name;
    document.getElementById('catName').value = cat.name;
    document.getElementById('catSlug').value = cat.slug;
    document.getElementById('catSlug').dataset.manual = '1';
    document.getElementById('catIcon').value = cat.icon || 'bi-grid';
    document.getElementById('catIconColor').value = cat.iconColor || 'blue';
    document.getElementById('catIsCustom').checked = !!cat.isCustom;
    document.getElementById('unitTypeRows').innerHTML = '';
    document.getElementById('unitTypeRows').style.display = cat.isCustom ? 'none' : '';
    document.getElementById('addUnitTypeBtn').style.display = cat.isCustom ? 'none' : '';
    (cat.unitTypes || []).forEach(ut => addUnitTypeRow(ut.value, ut.label, ut.icon));
    if (!cat.unitTypes.length && !cat.isCustom) addUnitTypeRow();
    new bootstrap.Modal(document.getElementById('categoryModal')).show();
  };

  // ── Save Category ──
  window.saveCategory = async function() {
    const id = document.getElementById('modalCatId').value;
    const payload = {
      name: document.getElementById('catName').value.trim(),
      slug: document.getElementById('catSlug').value.trim(),
      icon: document.getElementById('catIcon').value.trim(),
      iconColor: document.getElementById('catIconColor').value,
      isCustom: document.getElementById('catIsCustom').checked,
      unitTypes: document.getElementById('catIsCustom').checked ? [] : getUnitTypesFromForm()
    };
    if (!payload.name || !payload.slug) return alert('Name and slug are required.');
    try {
      const url = id ? `${API}/${id}` : API;
      const method = id ? 'PATCH' : 'POST';
      const resp = await authFetch(url, { method, body: JSON.stringify(payload) });
      const data = await resp.json();
      if (data.success) { location.reload(); } else { alert(data.error || 'Save failed.'); }
    } catch (e) { alert('Network error.'); }
  };

  // ── Toggle Active/Inactive ──
  window.toggleCategory = async function(id, currentlyActive) {
    if (!confirm(currentlyActive ? 'Deactivate this category? It will be hidden from customers.' : 'Activate this category?')) return;
    try {
      const resp = await authFetch(`${API}/${id}`, { method: 'PATCH', body: JSON.stringify({ active: !currentlyActive }) });
      const data = await resp.json();
      if (data.success) location.reload(); else alert(data.error || 'Failed.');
    } catch (e) { alert('Network error.'); }
  };
})();
</script>
