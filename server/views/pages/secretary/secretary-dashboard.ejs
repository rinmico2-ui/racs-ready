              </div>
              <div class="kpi-icon" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
                <i class="bi bi-check-circle text-white fs-5"></i>
              </div>
            </div>
            <div class="kpi-sparkline-container">
              <canvas id="kpiSparkCompletedJobs" height="40"></canvas>
            </div>
          </div>
        </div>

        <!-- Low Stock KPI -->
        <div class="col-lg-2 col-md-4 col-sm-6">
          <div class="dash-card h-100" data-aos="fade-up" data-aos-duration="600" data-aos-delay="250">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <h6 class="text-muted mb-1" style="font-size: 0.85rem; font-weight: 500;">Low Stock</h6>
                <div class="d-flex align-items-baseline gap-2">
                  <span class="h3 mb-0 fw-bold text-dark" id="kpi-lowstock">3</span>
                </div>
                <div class="badge bg-secondary-subtle text-secondary fs-7" id="kpiBadgeLowStock">+0.0%</div>
              </div>
              <div class="kpi-icon" style="background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);">
                <i class="bi bi-exclamation-triangle text-white fs-5"></i>
              </div>
            </div>
            <div class="kpi-sparkline-container">
              <canvas id="kpiSparkLowStock" height="40"></canvas>
            </div>
          </div>
        </div>

        <!-- Revenue KPI -->
        <div class="col-lg-2 col-md-4 col-sm-6">
          <div class="dash-card h-100" data-aos="fade-up" data-aos-duration="600" data-aos-delay="300">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <h6 class="text-muted mb-1" style="font-size: 0.85rem; font-weight: 500;">Revenue</h6>
                <div class="d-flex align-items-baseline gap-2">
                  <span class="h3 mb-0 fw-bold text-dark" id="kpi-revenue-today">₱1,200</span>
                </div>
                <div class="badge bg-danger-subtle text-danger fs-7" id="kpiBadgeRevenueToday">-3.8%</div>
              </div>
