          <div class="d-grid gap-2">
            <button class="btn btn-success" onclick="checkRepairToday()">
              <i class="bi bi-lightning-charge me-2"></i>Yes, Repair Today
            </button>
            <button class="btn btn-outline-primary" onclick="showScheduleLaterStep()">
              <i class="bi bi-calendar3 me-2"></i>Schedule for Another Day
            </button>
          </div>
        </div>

        <!-- Step 2: Checking availability -->
        <div id="repairSchedChecking" style="display:none;">
          <div class="text-center py-3">
            <div class="spinner-border text-primary mb-2" role="status"></div>
            <p class="fw-semibold" style="font-size:0.85rem;">Checking technician availability...</p>
          </div>
        </div>

