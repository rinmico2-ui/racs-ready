    var g7a = ctx7.getContext('2d').createLinearGradient(0, 0, 0, 250); g7a.addColorStop(0, 'rgba(6,182,212,0.3)'); g7a.addColorStop(1, 'rgba(6,182,212,0.02)');
    var bfLabels = baseLabels.concat(baseLabels.map(function(d) { return d + "+"; }));
    var bfAllData = baseData.concat(predicted);
