  <!-- JavaScript for Badge Polling -->
  <script>
    async function updateSidebarBadges() {
      try {
        const response = await fetch('/api/notifications/counts', { credentials: 'same-origin' });
        if (response.ok) {
          const data = await response.json();

          const badges = [
            { id: 'pendingReviewCount', key: 'pendingBookings' },
            { id: 'expensesBadge', key: 'pendingExpenses' },
            { id: 'escalatedBadge', key: 'escalatedBookings' },
            { id: 'leavesBadge', key: 'pendingLeaveRequests' },
          ];

          // Combined appointments badge (pending + queue + active)
          try {
            const apptEl = document.getElementById('appointmentsBadge');
            if (apptEl) {
              const total = (data.pendingBookings || 0) + (data.assignmentQueue || 0) + (data.activeJobs || 0);
              apptEl.textContent = total > 0 ? total : '';
              apptEl.style.display = total > 0 ? 'inline-block' : 'none';
            }
          } catch(e) {}
          badges.forEach(({ id, key }) => {
            const el = document.getElementById(id);
            if (el) {
              const count = data[key] || 0;
              el.textContent = count > 0 ? count : '';
              el.style.display = count > 0 ? 'inline-block' : 'none';
            }
          });

          // Fetch repair queue count for the pending review page badge
          try {
            const rqRes = await fetch('/api/admin/repair-queue/stats');
            if (rqRes.ok) {
              const rqData = await rqRes.json();
              const totalActive = (rqData.repair_requested || 0) + (rqData.pending_inspection || 0) + (rqData.inspection_scheduled || 0) + (rqData.awaiting_approval || 0) + (rqData.waiting_parts || 0);
              const el = document.getElementById('pendingReviewCount');
              if (el) {
                const current = parseInt(el.textContent) || 0;
                el.textContent = current > 0 ? current : '';
              }
            }
          } catch(e) {}

          // Fetch project scheduling queue count
          try {
            const pRes = await fetch('/api/projects/dashboard');
            if (pRes.ok) {
              const pData = await pRes.json();
              const pEl = document.getElementById('projectsBadge');
              if (pEl) {
                const count = pData.stats?.pendingScheduling || 0;
                pEl.textContent = count > 0 ? count : '';
                pEl.style.display = count > 0 ? 'inline-block' : 'none';
              }
            }
          } catch(e) {}

          // Fetch repair scheduling queue count
          try {
            const rsRes = await fetch('/api/admin/repair-scheduling-queue/stats');
            if (rsRes.ok) {
              const rsData = await rsRes.json();
              const rsEl = document.getElementById('repairSchedBadge');
              if (rsEl) {
                const count = rsData.pendingScheduling || 0;
                rsEl.textContent = count > 0 ? count : '';
                rsEl.style.display = count > 0 ? 'inline-block' : 'none';
              }
            }
          } catch(e) {}
        }
      } catch (e) { /* badges not available */ }
    }

    async function updateRatingCounts() {
      try {
        const response = await fetch('/api/admin/ratings/stats');
        if (response.ok) {
          const stats = await response.json();
          const el = document.getElementById('ratingsCount');
          if (el) {
            const total = stats.totalRatings || 0;
            el.textContent = total > 0 ? total : '';
            el.style.display = total > 0 ? 'inline-block' : 'none';
          }
        }
      } catch (e) { /* ratings not available */ }
    }

    document.addEventListener('DOMContentLoaded', function() {
      updateSidebarBadges();
      updateRatingCounts();
      setInterval(updateSidebarBadges, 30000);
      setInterval(updateRatingCounts, 30000);
    });
  </script>
