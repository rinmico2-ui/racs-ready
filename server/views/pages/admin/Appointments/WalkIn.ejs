    function updateCoreConfigurationPrice() {
      const service = state.coreServices.find(item => String(item._id) === document.getElementById("configServiceId").value);
      const isAircon = Boolean(service?.isAirconService && ((service?.airconTypes || []).length || (service?.hpPricing || []).length));
      const quantity = Math.max(1, Number(document.getElementById("configQuantity").value) || 1);
      const unitPrice = Number(isAircon ? configuredCoreHp?.price : service?.basePrice || 0);
      document.getElementById("coreEstimatedPrice").textContent = `₱${(unitPrice * quantity).toLocaleString()}`;
    }

    function updateRepairConfigurationPrice() {
      const service = state.repairServices.find(item => String(item._id) === document.getElementById("configServiceId").value) || state.repairServices[0];
      const quantity = Math.max(1, Number(document.getElementById("repairConfigQuantity").value) || 1);
      const inspectionFee = Math.max(0, Number(service?.initialPrice ?? service?.basePrice ?? service?.price ?? 0));
      document.getElementById("coreEstimatedPrice").textContent = `₱${(inspectionFee * quantity).toLocaleString()}`;
    }

    function repairCategoryRecords() {
      if (state.serviceCategories.length) return state.serviceCategories;
      return [
        { slug: "aircon", name: "Air Conditioning", icon: "bi-snow", iconColor: "blue", unitTypes: repairUnitTypes.aircon },
        { slug: "appliance", name: "Home Appliances", icon: "bi-house-gear", iconColor: "amber", unitTypes: repairUnitTypes.appliance },
        { slug: "other", name: "Other", icon: "bi-plus-circle", iconColor: "violet", unitTypes: repairUnitTypes.other },
      ];
    }

    function renderRepairCategories() {
      const host = document.getElementById("walkinRepairCategories");
      if (!host) return;
      host.innerHTML = repairCategoryRecords().map(category => {
        const slug = escapeMarkup(category.slug);
        const name = escapeMarkup(category.name || category.slug);
        const icon = safeCssClasses(category.icon, "bi-grid");
        const color = safeCssClasses(category.iconColor, "blue");
        const count = category.isCustom ? "Custom description" : `${(category.unitTypes || []).length} unit types`;
        return `<div class="col-md-4"><button type="button" class="repair-category-card repair-category h-100" data-category="${slug}"><span class="unit-category-icon ${color}"><i class="bi ${icon}"></i></span><strong class="d-block">${name}</strong><small class="d-block mt-1">${escapeMarkup(count)}</small></button></div>`;
      }).join("");
    }

    function setupHpCard(card, hpOption, airconType) {
      const checkbox = card.querySelector('.hp-checkbox');
      const minus = card.querySelector('.hp-qty-minus');
      const plus = card.querySelector('.hp-qty-plus');
      const input = card.querySelector('.hp-qty-input');
      if (!checkbox) return;

      card.addEventListener('click', (e) => {
        if (e.target.closest('.hp-quantity-control') || e.target === checkbox) return;
        checkbox.checked = !checkbox.checked;
        checkbox.dispatchEvent(new Event('change', { bubbles: true }));
      });

      checkbox.addEventListener('change', () => {
        if (checkbox.checked) {
          document.querySelectorAll('#coreHpOptions .hp-option-card').forEach(other => {
            if (other !== card) {
              other.classList.remove('selected');
              const cb = other.querySelector('.hp-checkbox');
              const oInput = other.querySelector('.hp-qty-input');
              const oMinus = other.querySelector('.hp-qty-minus');
              const oPlus = other.querySelector('.hp-qty-plus');
              if (cb) cb.checked = false;
              if (oInput) { oInput.value = 1; oInput.disabled = true; }
              if (oMinus) oMinus.disabled = true;
              if (oPlus) oPlus.disabled = true;
            }
          });
          card.classList.add('selected');
          input.disabled = false;
          minus.disabled = false;
          plus.disabled = false;
          document.getElementById('configQuantity').value = input.value;
          configuredCoreHp = { hp: Number(hpOption.hp), price: Number(hpOption.price), durationMinutes: Number(hpOption.durationMinutes || 60) };
          const step2 = document.getElementById("cfgStep2");
          if (step2) step2.classList.add("is-done");
        } else {
          card.classList.remove('selected');
          input.disabled = true;
          minus.disabled = true;
          plus.disabled = true;
          input.value = 1;
          configuredCoreHp = null;
          document.getElementById('configQuantity').value = 1;
          const step2 = document.getElementById("cfgStep2");
          if (step2) step2.classList.remove("is-done");
        }
        updateCoreConfigurationPrice();
      });

      minus.addEventListener('click', () => {
        const val = Math.max(1, Number(input.value) - 1);
        input.value = val;
        document.getElementById('configQuantity').value = val;
        updateCoreConfigurationPrice();
      });

      plus.addEventListener('click', () => {
        const val = Math.min(40, Number(input.value) + 1);
        input.value = val;
        document.getElementById('configQuantity').value = val;
        updateCoreConfigurationPrice();
      });
    }

