  function teamMembersHtml(a) {
    return (a.project?.assignedTechnicians || []).map(t => {
      const isLeadT = a.project.leadTechnicianId && t._id.toString() === a.project.leadTechnicianId.toString();
      const tb = (a.teamBoard||[]).find(x => x._id && x._id.toString() === t._id.toString());
      let st = 'Awaiting', cls = '';
      if (tb) { if (tb.acknowledge === 'declined') { st = 'Declined'; cls = 'no'; } else if (tb.acknowledge === 'acknowledged') { st = STATUS_LABEL[tb.status] || 'Accepted'; cls = 'ok'; } }
      return `<div class="pw-d-member" style="flex:1 1 220px;max-width:100%;">
        <div class="pw-d-av ${isLeadT ? 'lead' : ''}">${esc(initials(t.name))}</div>
        <div style="min-width:0;flex:1;">
          <div class="nm">${esc(t.name||'Technician')}${isLeadT?' <span style="color:#818cf8;font-size:.6rem;font-weight:700;background:rgba(99,102,241,.1);padding:1px 5px;border-radius:4px;margin-left:3px;">LEAD</span>':''}</div>
          <div class="st ${cls}">${esc(st)}</div>
          <div style="font-size:.6rem;color:var(--pw-muted);margin-top:.25rem;">Works from the shared unit queue</div>
        </div>
      </div>`;
    }).join('');
  }

  window.pwCloseDrawer = function () {
    window.__openProjectId = null;
    const params = new URLSearchParams(window.location.search);
    if (window.opener && params.get('projectId')) {
      window.close();
      return;
    }
    document.getElementById('pwDrawerOverlay').classList.remove('show');
    document.getElementById('pwDrawer').classList.remove('open');
    document.getElementById('pwDrawerOverlay').classList.remove('page');
    document.getElementById('pwDrawer').classList.remove('page');
    document.getElementById('pwDrawer').setAttribute('aria-hidden','true');
  };

  // Lead-only operational snapshot inside the drawer.
