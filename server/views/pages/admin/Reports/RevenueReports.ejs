nger' %>"><%= peso(s.grossProfit) %><div class="rr-meta"><%= pct(s.grossProfitMargin) %></div></td></tr><% }); %></tbody></table></div></div><div class="modal-footer d-flex justify-content-between"><span class="small text-muted" id="profitabilityPageInfo"></span><nav aria-label="Completed service profitability pages"><ul class="pagination pagination-sm mb-0" id="profitabilityPagination"></ul></nav></div></div></div>
