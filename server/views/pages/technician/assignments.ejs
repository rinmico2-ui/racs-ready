        </div>
        <div style="font-size:0.75rem;color:#1e40af;">
          <strong>Available repair time:</strong> ${(() => {
            const now = new Date();
            const curStart = currentAssignment?.startTime ? parseTime(currentAssignment.startTime) : null;
            const nextStart = hasNextBookingSoon ? parseTime(nextBookingTime) : null;
            if (curStart && nextStart) {
              const remaining = nextStart - (now.getHours() * 60 + now.getMinutes());
              const rh = Math.floor(remaining / 60);
              const rm = remaining % 60;
              return `${rh}h ${rm}m`;
            }
            return 'Sufficient';
          })()}<br>
          <strong>Next scheduled booking:</strong> ${nextBookingTime || 'None'}
        </div>
      </div>`;
    }

    if (disableRepairNow && !canBuyLocally) {
      html += `<div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:10px 14px;margin-bottom:12px;">
        <div style="display:flex;align-items:center;gap:8px;">
          <i class="bi bi-lock-fill" style="color:#dc2626;font-size:0.85rem;"></i>
          <span style="font-size:0.82rem;color:#991b1b;font-weight:600;">Repair Now unavailable — not enough time for local purchase</span>
        </div>
      </div>`;
    }

    html += `</div>`;

    // Clear session state
    sessionStorage.removeItem('_postInspDecision');

    // ── Build the modal dynamically based on conditions ──
    let modalResult;

    try {
      if (canBuyLocally) {
        // Parts missing + enough time: show 4-button layout with custom HTML
        const fourBtnHtml = html + `
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:16px;" id="decisionBtnGrid">
          <button id="btnLocalPurchase" type="button" class="btn py-2" style="background:#2563eb;color:#fff;border:none;border-radius:8px;font-size:0.82rem;font-weight:600;grid-column:1/2;">
            <i class="bi bi-shop me-1"></i> Buy Parts Locally & Repair
          </button>
          <button id="btnScheduleLater" type="button" class="btn py-2" style="background:#fff;color:#2563eb;border:2px solid #2563eb;border-radius:8px;font-size:0.82rem;font-weight:600;grid-column:2/3;">
            <i class="bi bi-calendar me-1"></i> Schedule Later
          </button>
          <button id="btnCancelRepair" type="button" class="btn py-2" style="background:#fff;color:#dc2626;border:2px solid #dc2626;border-radius:8px;font-size:0.82rem;font-weight:600;grid-column:1/-1;">
            <i class="bi bi-x-circle me-1"></i> Cancel Repair
          </button>
        </div>`;

        window._decisionChoice = null;
        let resolveDecisionClosed;
        const decisionClosed = new Promise(resolve => { resolveDecisionClosed = resolve; });
        await Swal.fire({
          icon: 'question',
          title: `${outOfStockParts.length} Part${outOfStockParts.length > 1 ? 's' : ''} Unavailable — Choose Next Step`,
          html: fourBtnHtml,
          showConfirmButton: false,
          showCancelButton: false,
          allowOutsideClick: false,
          allowEscapeKey: false,
          didOpen: () => {
            // Prevent Swal from closing on backdrop/escape — our buttons handle it
            const choose = choice => {
              window._decisionChoice = choice;
              Swal.close();
            };
            document.getElementById('btnLocalPurchase')?.addEventListener('click', () => choose('localPurchase'), { once: true });
            document.getElementById('btnScheduleLater')?.addEventListener('click', () => choose('scheduleLater'), { once: true });
            document.getElementById('btnCancelRepair')?.addEventListener('click', () => choose('cancel'), { once: true });
          },
          didClose: () => resolveDecisionClosed(),
        });

        await decisionClosed;

        modalResult = window._decisionChoice;
        window._decisionChoice = null;

        if (modalResult === 'localPurchase') {
          await handleLocalPurchaseRepair(bookingId, outOfStockParts, notInInventoryParts, checkedParts, currentAssignment);
          return;
        } else if (modalResult === 'scheduleLater') {
          await handleScheduleLater(bookingId, [...outOfStockParts, ...notInInventoryParts]);
          return;
        } else {
          await handleDeclineRepair(bookingId);
          return;
        }

      } else {
        // Standard 3-button layout (all parts available, or not enough time)
        modalResult = await Swal.fire({
          icon: 'question',
          title: hasPartsUnavailable ? 'Parts Unavailable — Choose Next Step' : 'How would you like to proceed?',
          html: html,
          showCancelButton: true,
          showDenyButton: true,
          showConfirmButton: !disableRepairNow,
          confirmButtonText: '<i class="bi bi-tools me-1"></i> Repair Now',
          denyButtonText: '<i class="bi bi-calendar me-1"></i> Schedule Later',
          cancelButtonText: '<i class="bi bi-x-circle me-1"></i> Decline',
          confirmButtonColor: '#059669',
          denyButtonColor: '#2563eb',
          cancelButtonColor: '#dc2626',
          reverseButtons: false,
          allowOutsideClick: false,
          allowEscapeKey: false,
          showLoaderOnConfirm: true,
          showLoaderOnDeny: true,
        });

        if (modalResult.isConfirmed) {
          await handleRepairNow(bookingId);
        } else if (modalResult.isDenied) {
          await handleScheduleLater(bookingId, [...outOfStockParts, ...notInInventoryParts]);
        } else if (modalResult.isDismissed) {
          await handleDeclineRepair(bookingId);
        }
      }
    } finally {
      // Always clean up btn-loading state from the triggering button
      document.querySelectorAll('.btn-loading').forEach(b => {
        b.classList.remove('btn-loading');
        b.disabled = false;
      });
    }
  }

