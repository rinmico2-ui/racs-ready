              <div class="mt-3 p-2 bg-light rounded">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  Total usage value: <strong>₱<%= analytics ? analytics.toolUsageValue.toLocaleString() : 0 %></strong>
                </small>
              </div>
            <% } else { %>
              <div class="text-center py-4 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">No tool usage data available for the last 30 days</p>
