<%# ══════════════════════════════════════════════════════════════════════════════
    CALIDRO RACS — Enterprise Landing Page
    Modern, animated, professional design
    ══════════════════════════════════════════════════════════════════════════════ %>

<link rel="stylesheet" href="/css/landing-enterprise.css?v=20260929-service-details-prices-v2">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<% const landingStats = (typeof publicStats === 'object' && publicStats) ? publicStats : { servicesCompleted:0, satisfactionPercentage:0, activeTechnicians:0, yearsExperience:0 }; %>
<%
  const landingLocation = locals.companyLocation || {};
  const landingCoordinate = value => (typeof value === 'number' || typeof value === 'string') && String(value).trim() ? Number(value) : NaN;
  const landingLat = landingCoordinate(landingLocation.lat);
  const landingLng = landingCoordinate(landingLocation.lng);
  const landingLocationConfigured = landingLocation.configured !== false
    && Number.isFinite(landingLat) && Math.abs(landingLat) <= 90
    && Number.isFinite(landingLng) && Math.abs(landingLng) <= 180;
  const landingLocationQuery = landingLocationConfigured ? encodeURIComponent(`${landingLat},${landingLng}`) : '';
  const landingMapUrl = landingLocationConfigured ? `https://www.google.com/maps/search/?api=1&query=${landingLocationQuery}` : '';
  const landingCompanyAddress = landingLocationConfigured
    ? (landingLocation.address || locals.companyAddress || 'Company office')
    : 'Company location not configured yet';
%>

