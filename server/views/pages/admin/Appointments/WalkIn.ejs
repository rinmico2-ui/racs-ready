            <button type="button" class="ent-btn-outline" data-prev-step="3"><i class="bi bi-arrow-left"></i>Back</button>
            <button type="button" class="ent-btn-primary" data-next-step="5">Continue to Payment<i class="bi bi-arrow-right"></i></button>
          </div>
          </div>
        </div>

        <div class="booking-step d-none ent-step-card" data-step="6">
          <div class="ent-step-header">
            <div class="ent-step-icon step-review"><i class="bi bi-check2-circle"></i></div>
            <div class="ent-step-info">
              <h5>Step 7</h5>
