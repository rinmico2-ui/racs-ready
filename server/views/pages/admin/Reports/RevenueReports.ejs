  // ── Chart management ──
  function destroyCharts() {
    Object.values(charts).forEach(c => { try { c.destroy(); } catch(e){} });
    ['revenueTrend', 'revenueForecast', 'sourceMix', 'paymentMix', 'posPaymentMix', 'marginTrend', 'serviceProfitRanking', 'serviceEconomics', 'productChannelMix', 'brandRevenue', 'fulfillmentMix', 'kpiSparkRevenue', 'kpiSparkCash', 'kpiSparkAvgTxn'].forEach(id => {
      const existing = typeof Chart !== 'undefined' ? Chart.getChart(id) : null;
      if (existing) { try { existing.destroy(); } catch (e) {} }
    });
    charts = {};
  }

