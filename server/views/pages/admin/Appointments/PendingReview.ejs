<div class="main-content">
  <div class="container-fluid py-4">
    <div class="au-hero mb-4">
      <div class="au-hero-inner">
        <div class="au-hero-left">
          <div class="au-hero-icon"><i class="bi bi-hourglass-split"></i></div>
          <div>
            <h1>Pending Review</h1>
            <p>Review and manage pending bookings and repair requests</p>
          </div>
        </div>
        <div class="au-hero-actions">
          <button class="btn btn-sm btn-outline-secondary" onclick="window.location.reload()">
            <i class="bi bi-arrow-clockwise"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Tabs: Bookings | Repair Requests -->
    <ul class="nav nav-tabs mb-4" id="pendingTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="bookings-tab" data-bs-toggle="tab" data-bs-target="#bookings-panel" type="button" role="tab" aria-controls="bookings-panel" aria-selected="true">
          <i class="bi bi-calendar-check me-1"></i>Core Services Request
          <span class="badge bg-warning text-dark ms-1" id="bookingTabCount">0</span>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="repairs-tab" data-bs-toggle="tab" data-bs-target="#repairs-panel" type="button" role="tab" aria-controls="repairs-panel" aria-selected="false">
          <i class="bi bi-wrench-adjustable-circle me-1"></i>Repair Requests
          <span class="badge bg-danger ms-1" id="repairTabCount">0</span>
        </button>
      </li>
    </ul>

    <div class="tab-content">
      <!-- ═══ Core Services Request Tab ═══ -->
      <div class="tab-pane fade show active" id="bookings-panel" role="tabpanel" aria-labelledby="bookings-tab">
        <!-- Filter Bar -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body py-2 px-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
              <span class="text-muted small fw-semibold me-1"><i class="bi bi-funnel me-1"></i>Filters:</span>

              <select class="form-select form-select-sm" id="filterPaymentStatus" style="width:auto;min-width:140px;">
                <option value="">All Payment Status</option>
                <option value="pending">Pending</option>
                <option value="partial">Partial (Downpayment)</option>
                <option value="paid">Paid in Full</option>
              </select>

              <select class="form-select form-select-sm" id="filterPaymentMethod" style="width:auto;min-width:130px;">
                <option value="">All Payment Methods</option>
                <option value="cod">Cash on Delivery</option>
                <option value="gcash">GCash</option>
                <option value="maya">Maya</option>
              </select>

              <select class="form-select form-select-sm" id="filterDateRange" style="width:auto;min-width:140px;">
                <option value="">All Dates</option>
                <option value="today">Today</option>
                <option value="yesterday">Yesterday</option>
                <option value="this_week">This Week</option>
                <option value="this_month">This Month</option>
                <option value="last_month">Last Month</option>
              </select>

              <select class="form-select form-select-sm" id="filterSort" style="width:auto;min-width:150px;">
                <option value="newest">Newest First</option>
                <option value="oldest">Oldest First</option>
                <option value="amount_high">Amount: High to Low</option>
                <option value="amount_low">Amount: Low to High</option>
              </select>

              <button class="btn btn-sm btn-outline-danger d-none" id="clearFiltersBtn" onclick="clearFilters()">
                <i class="bi bi-x-circle me-1"></i>Clear
              </button>

              <span class="ms-auto text-muted small" id="filterResultCount"></span>
            </div>
          </div>
        </div>

        <!-- Status Summary Cards -->
        <div class="row g-3 mb-4" id="statsCards">
          <div class="col-md-3">
            <div class="card border-0 shadow-sm" style="border-left: 4px solid #f59e0b;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <div class="text-muted small">Pending Review</div>
                    <h4 class="fw-bold mb-0" id="pendingCount">-</h4>
                  </div>
                  <i class="bi bi-hourglass-split text-warning" style="font-size: 1.8rem;"></i>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card border-0 shadow-sm" style="border-left: 4px solid #3b82f6;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <div class="text-muted small">Awaiting Assignment</div>
                    <h4 class="fw-bold mb-0" id="awaitingCount">-</h4>
                  </div>
                  <i class="bi bi-clipboard-check text-primary" style="font-size: 1.8rem;"></i>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card border-0 shadow-sm" style="border-left: 4px solid #ef4444;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <div class="text-muted small">Rejected Today</div>
                    <h4 class="fw-bold mb-0" id="rejectedCount">-</h4>
                  </div>
                  <i class="bi bi-x-circle text-danger" style="font-size: 1.8rem;"></i>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card border-0 shadow-sm" style="border-left: 4px solid #8b5cf6;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <div class="text-muted small">In Queue</div>
                    <h4 class="fw-bold mb-0" id="queueCount">-</h4>
                  </div>
                  <i class="bi bi-clipboard-check text-purple" style="font-size: 1.8rem; color: #8b5cf6;"></i>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Pending Bookings Table -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold">Pending Bookings</h6>
            <span class="badge bg-warning text-dark" id="resultCount">0</span>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table rq-table mb-0 align-middle">
                <thead class="table-light">
                  <tr>
                    <th>Reference</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Payment</th>
                    <th class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody id="bookingsTableBody">
                  <tr>
                    <td colspan="7" class="text-center py-5 text-muted">
                      <div class="spinner-border text-primary mb-2" role="status"></div>
                      <div>Loading bookings...</div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
          <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
            <small class="text-muted" id="paginationInfo">Showing 0 of 0</small>
            <nav>
              <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
            </nav>
          </div>
        </div>
      </div>

      <!-- ═══ Repair Requests Tab ═══ -->
      <div class="tab-pane fade" id="repairs-panel" role="tabpanel" aria-labelledby="repairs-tab">
        <!-- Repair Queue Stats -->
        <div class="row g-3 mb-4" id="rqStatsContainer">
          <div class="col-md-2">
            <div class="rq-stat-card">
              <div class="rq-stat-icon" style="background:#fffbeb;color:#d97706;"><i class="bi bi-hourglass-split"></i></div>
              <div><div class="rq-stat-label">Pending</div><div class="rq-stat-value text-warning" id="rqStatPending">0</div></div>
            </div>
          </div>
          <div class="col-md-2">
            <div class="rq-stat-card">
              <div class="rq-stat-icon" style="background:#eff6ff;color:#3b82f6;"><i class="bi bi-search"></i></div>
              <div><div class="rq-stat-label">Inspections</div><div class="rq-stat-value text-primary" id="rqStatInspections">0</div></div>
            </div>
          </div>
          <div class="col-md-2">
            <div class="rq-stat-card">
              <div class="rq-stat-icon" style="background:#fef2f2;color:#ef4444;"><i class="bi bi-clock-history"></i></div>
              <div><div class="rq-stat-label">Awaiting</div><div class="rq-stat-value text-danger" id="rqStatApproval">0</div></div>
            </div>
          </div>
          <div class="col-md-2">
            <div class="rq-stat-card">
              <div class="rq-stat-icon" style="background:#f0fdf4;color:#22c55e;"><i class="bi bi-tools"></i></div>
              <div><div class="rq-stat-label">For Repair</div><div class="rq-stat-value text-success" id="rqStatRepair">0</div></div>
            </div>
          </div>
          <div class="col-md-2">
            <div class="rq-stat-card">
              <div class="rq-stat-icon" style="background:#f0f9ff;color:#0ea5e9;"><i class="bi bi-gear"></i></div>
              <div><div class="rq-stat-label">In Progress</div><div class="rq-stat-value text-info" id="rqStatInProgress">0</div></div>
            </div>
          </div>
          <div class="col-md-2">
            <div class="rq-stat-card">
              <div class="rq-stat-icon" style="background:#fffbeb;color:#f59e0b;"><i class="bi bi-box-seam"></i></div>
              <div><div class="rq-stat-label">Parts</div><div class="rq-stat-value text-warning" id="rqStatParts">0</div></div>
            </div>
          </div>
        </div>

        <!-- Repair Queue Filters -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body py-2 px-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
              <span class="text-muted small fw-semibold me-1"><i class="bi bi-funnel me-1"></i>Filters:</span>
              <div class="btn-group" id="rqStatusFilter">
                <button class="btn btn-sm btn-outline-secondary active" data-status="all">All</button>
                <button class="btn btn-sm btn-outline-secondary" data-status="repair_requested">New</button>
                <button class="btn btn-sm btn-outline-secondary" data-status="pending_inspection,inspection_scheduled">Inspections</button>
                <button class="btn btn-sm btn-outline-secondary" data-status="awaiting_approval">Approval</button>
                <button class="btn btn-sm btn-outline-secondary" data-status="repair_approved,ready_for_repair">For Repair</button>
                <button class="btn btn-sm btn-outline-secondary" data-status="waiting_parts">Parts</button>
                <button class="btn btn-sm btn-outline-secondary" data-status="repair_in_progress">Active</button>
              </div>
              <input type="text" class="form-control form-control-sm" id="rqSearchInput" placeholder="Search..." style="width:200px;">
            </div>
          </div>
        </div>

        <!-- Repair Queue Table -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold">Repair Requests</h6>
            <span class="badge bg-danger" id="rqResultCount">0</span>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table rq-table mb-0 align-middle">
                <thead class="table-light">
                  <tr>
                    <th>Reference</th>
                    <th>Customer</th>
                    <th>Issue</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Inspection Date</th>
                    <th>Technician</th>
                    <th>Created</th>
                    <th class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody id="rqTableBody">
                  <tr>
                    <td colspan="9" class="text-center py-5 text-muted">
                      <div class="spinner-border text-primary mb-2" role="status"></div>
                      <div>Loading repair requests...</div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ── Schedule Repair Modal ── -->
<div class="modal fade" id="rqScheduleModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:none;border-radius:14px;box-shadow:0 25px 60px rgba(0,0,0,0.25);">
      <div class="modal-header" style="background:linear-gradient(135deg,#1d4ed8 0%,#059669 100%);color:#fff;padding:18px 22px;border:none;">
        <h6 class="modal-title fw-bold mb-0"><i class="bi bi-calendar-plus me-2"></i>Schedule Repair</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" style="padding:22px;">
        <input type="hidden" id="rqScheduleBookingId">
        <div class="mb-3">
          <label class="form-label fw-semibold">Repair Date <span class="text-danger">*</span></label>
          <input type="date" class="form-control" id="rqScheduleDate" min="" required>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Time Slot</label>
          <select class="form-select" id="rqScheduleTime">
            <option value="08:00">8:00 AM</option>
            <option value="09:00">9:00 AM</option>
            <option value="10:00">10:00 AM</option>
            <option value="11:00">11:00 AM</option>
            <option value="13:00">1:00 PM</option>
            <option value="14:00">2:00 PM</option>
            <option value="15:00">3:00 PM</option>
            <option value="16:00">4:00 PM</option>
          </select>
        </div>
        <div class="mb-0">
          <label class="form-label fw-semibold">Notes <small class="text-muted">(optional)</small></label>
          <textarea class="form-control" id="rqScheduleNotes" rows="2" placeholder="Additional scheduling notes..."></textarea>
        </div>
      </div>
      <div class="modal-footer" style="padding:14px 22px;border-top:1px solid #e2e8f0;background:#fafbfc;">
        <button type="button" class="btn btn-light btn-sm fw-semibold" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success btn-sm fw-semibold" onclick="submitRqSchedule()">
          <i class="bi bi-check-lg me-1"></i> Confirm Schedule
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Confirm Repair Request Modal ── -->
<div class="modal fade" id="rqConfirmModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content" style="border:none;border-radius:14px;box-shadow:0 25px 60px rgba(0,0,0,0.25);">
      <div class="modal-header" style="background:linear-gradient(135deg,#1d4ed8 0%,#2563eb 100%);color:#fff;padding:18px 22px;border:none;">
        <h6 class="modal-title fw-bold mb-0"><i class="bi bi-check-circle me-2"></i>Confirm Repair Request</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" style="padding:22px;text-align:center;">
        <input type="hidden" id="rqConfirmBookingId">
        <i class="bi bi-clipboard-check text-primary" style="font-size:3rem;display:block;margin-bottom:12px;"></i>
        <p class="mb-1" style="font-size:0.95rem;">Confirm this repair request?</p>
        <p class="text-muted small">This will move the request to the Assignment Queue where a technician can be assigned for inspection.</p>
      </div>
      <div class="modal-footer" style="padding:14px 22px;border-top:1px solid #e2e8f0;background:#fafbfc;justify-content:center;">
        <button type="button" class="btn btn-light btn-sm fw-semibold" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success btn-sm fw-semibold" onclick="submitRqConfirm()">
          <i class="bi bi-check-lg me-1"></i> Yes, Confirm
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Reject Repair Request Modal ── -->
<div class="modal fade" id="rqRejectModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:none;border-radius:14px;box-shadow:0 25px 60px rgba(0,0,0,0.25);">
      <div class="modal-header" style="background:linear-gradient(135deg,#7f1d1d 0%,#dc2626 100%);color:#fff;padding:18px 22px;border:none;">
        <h6 class="modal-title fw-bold mb-0"><i class="bi bi-x-circle me-2"></i>Reject Repair Request</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" style="padding:22px;">
        <input type="hidden" id="rqRejectBookingId">
        <i class="bi bi-exclamation-triangle text-danger" style="font-size:2.5rem;display:block;margin-bottom:12px;text-align:center;"></i>
        <p class="mb-3" style="font-size:0.95rem;">This repair request will be rejected and the customer will be notified.</p>
        <div class="mb-0">
          <label class="form-label fw-semibold">Rejection Reason <span class="text-danger">*</span></label>
          <textarea class="form-control" id="rqRejectReason" rows="3" placeholder="Provide a reason for rejecting this repair request..."></textarea>
        </div>
      </div>
      <div class="modal-footer" style="padding:14px 22px;border-top:1px solid #e2e8f0;background:#fafbfc;justify-content:center;">
        <button type="button" class="btn btn-light btn-sm fw-semibold" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger btn-sm fw-semibold" onclick="submitRqReject()">
          <i class="bi bi-x-lg me-1"></i> Reject Request
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Decline Quotation Modal ── -->
<div class="modal fade" id="rqDeclineQuoteModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:none;border-radius:14px;box-shadow:0 25px 60px rgba(0,0,0,0.25);">
      <div class="modal-header" style="background:linear-gradient(135deg,#7f1d1d 0%,#dc2626 100%);color:#fff;padding:18px 22px;border:none;">
        <h6 class="modal-title fw-bold mb-0"><i class="bi bi-x-circle me-2"></i>Decline Quotation</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" style="padding:22px;">
        <input type="hidden" id="rqDeclineQuoteBookingId">
        <i class="bi bi-exclamation-triangle text-danger" style="font-size:2.5rem;display:block;margin-bottom:12px;text-align:center;"></i>
        <p class="mb-2" style="font-size:0.95rem;">Mark this quotation as <strong>declined by customer</strong>?</p>
        <p class="text-muted small mb-3">The booking will be closed and only the inspection fee will be collected.</p>
        <div class="mb-0">
          <label class="form-label fw-semibold">Reason <small class="text-muted">(optional)</small></label>
          <textarea class="form-control" id="rqDeclineQuoteReason" rows="2" placeholder="Reason for declining..."></textarea>
        </div>
      </div>
      <div class="modal-footer" style="padding:14px 22px;border-top:1px solid #e2e8f0;background:#fafbfc;justify-content:center;">
        <button type="button" class="btn btn-light btn-sm fw-semibold" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger btn-sm fw-semibold" onclick="submitRqDeclineQuote()">
          <i class="bi bi-x-lg me-1"></i> Confirm Decline
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Assign Technician Modal ── -->
<div class="modal fade" id="rqAssignModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:none;border-radius:14px;box-shadow:0 25px 60px rgba(0,0,0,0.25);">
      <div class="modal-header" style="background:linear-gradient(135deg,#1d4ed8 0%,#2563eb 100%);color:#fff;padding:18px 22px;border:none;">
        <h6 class="modal-title fw-bold mb-0"><i class="bi bi-person-plus me-2"></i>Assign Technician</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" style="padding:22px;">
        <input type="hidden" id="rqAssignBookingId">
        <div class="mb-3">
          <label class="form-label fw-semibold">Technician <span class="text-danger">*</span></label>
          <select class="form-select" id="rqAssignTech">
            <option value="">Loading technicians...</option>
          </select>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-6">
            <label class="form-label fw-semibold">Inspection Date <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="rqAssignDate">
          </div>
          <div class="col-6">
            <label class="form-label fw-semibold">Preferred Time</label>
            <select class="form-select" id="rqAssignTime">
              <option value="">Any time</option>
              <option value="08:00 AM">8:00 AM</option>
              <option value="09:00 AM">9:00 AM</option>
              <option value="10:00 AM">10:00 AM</option>
              <option value="11:00 AM">11:00 AM</option>
              <option value="12:00 PM">12:00 PM</option>
              <option value="01:00 PM">1:00 PM</option>
              <option value="02:00 PM">2:00 PM</option>
              <option value="03:00 PM">3:00 PM</option>
              <option value="04:00 PM">4:00 PM</option>
              <option value="05:00 PM">5:00 PM</option>
            </select>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Priority</label>
          <select class="form-select" id="rqAssignPriority">
            <option value="low">Low</option>
            <option value="normal" selected>Normal</option>
            <option value="high">High</option>
            <option value="critical">Critical</option>
          </select>
        </div>
        <div class="mb-0">
          <label class="form-label fw-semibold">Notes <small class="text-muted">(optional)</small></label>
          <textarea class="form-control" id="rqAssignNotes" rows="2" placeholder="Any additional notes for the technician..."></textarea>
        </div>
      </div>
      <div class="modal-footer" style="padding:14px 22px;border-top:1px solid #e2e8f0;background:#fafbfc;justify-content:center;">
        <button type="button" class="btn btn-light btn-sm fw-semibold" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm fw-semibold" onclick="submitAssignTech()">
          <i class="bi bi-check-lg me-1"></i> Confirm Assignment
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content ent-modal">
      <div class="modal-header ent-modal-header ent-modal-header-danger">
        <div class="d-flex align-items-center gap-3">
          <div class="ent-modal-icon bg-danger-subtle"><i class="bi bi-exclamation-triangle-fill text-danger"></i></div>
          <div>
            <h6 class="modal-title fw-bold mb-0">Reject Booking</h6>
            <small class="text-white-50">This action will notify the customer</small>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body ent-modal-body">
        <input type="hidden" id="rejectBookingId">
        <div class="mb-3">
          <label class="form-label fw-semibold">Rejection Reason <span class="text-danger">*</span></label>
          <select class="form-select" id="rejectReason">
            <option value="">Select reason...</option>
            <option value="invalid_payment">Invalid Payment</option>
            <option value="incomplete_info">Incomplete Information</option>
            <option value="duplicate_booking">Duplicate Booking</option>
            <option value="unavailable">Service Unavailable</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="mb-0">
          <label class="form-label fw-semibold">Note <small class="text-muted">(optional)</small></label>
          <textarea class="form-control" rows="3" id="rejectNote" placeholder="Provide additional context for the rejection..."></textarea>
        </div>
      </div>
      <div class="modal-footer ent-modal-footer">
        <button type="button" class="btn btn-light btn-sm fw-semibold" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger btn-sm fw-semibold" onclick="confirmReject()">
          <i class="bi bi-x-circle me-1"></i> Reject Booking
        </button>
      </div>
    </div>
  </div>
</div>

