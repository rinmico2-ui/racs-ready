<script>
"use strict";

// ── State ─────────────────────────────────────────────────────────────────────
let cart = [];
let selectedPayment = "cash";
let allTools = [];
let currentCategory = "";

// ── Init ──────────────────────────────────────────────────────────────────────
document.addEventListener("DOMContentLoaded", () => {
  loadCategories();
  loadTools();

  document.getElementById("posSearch").addEventListener("input", debounce(() => { if (currentTab === "tools") loadTools(); else loadAircons(); }, 300));

  // Barcode scanner: buffer characters, fire on terminator (Enter/Tab) or timeout
  let barcodeBuffer = "";
  let barcodeTimer = null;
  const barcodeInput = document.getElementById("posBarcode");

  function processBarcode() {
    const val = barcodeBuffer.replace(/[\r\n\x00-\x1f]/g, "").trim();
    barcodeBuffer = "";
    barcodeInput.value = "";
    if (val) {
      console.log("[POS] Barcode scanned:", val);
      lookupBarcode(val);
    }
  }

  barcodeInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === "Tab") {
      e.preventDefault();
      clearTimeout(barcodeTimer);
      barcodeBuffer = barcodeInput.value.trim();
      processBarcode();
      return;
    }
  });

  barcodeInput.addEventListener("input", (e) => {
    const val = e.target.value;
    if (!val) { barcodeBuffer = ""; clearTimeout(barcodeTimer); return; }
    barcodeBuffer = val;
    clearTimeout(barcodeTimer);
    // Fallback: if scanner doesn't send Enter/Tab, fire after 300ms of silence
    barcodeTimer = setTimeout(() => processBarcode(), 300);
  });

  // Focus barcode input on page load
  barcodeInput.focus();
});

// ── API Calls ─────────────────────────────────────────────────────────────────
async function loadCategories() {
  try {
    const res = await fetch("/api/pos/categories");
    const data = await res.json();
    const container = document.getElementById("posCategories");
    let html = '<button class="pos-cat-btn active" onclick="filterCategory(\'\', this)">All</button>';
    (data.categories || []).forEach(c => {
      html += `<button class="pos-cat-btn" onclick="filterCategory('${c.replace(/'/g, "\\'")}', this)">${escapeHtml(c)}</button>`;
    });
    container.innerHTML = html;
  } catch (e) { console.error("Categories load error:", e); }
}

async function loadTools() {
  try {
    const q = document.getElementById("posSearch").value.trim();
    const params = new URLSearchParams({ limit: 200 });
    if (q) params.set("q", q);
    if (currentCategory) params.set("category", currentCategory);

    const res = await fetch(`/api/pos/tools?${params}`);
    const data = await res.json();
    allTools = data.tools || [];
    renderTools();
    checkBarcodeStatus();
  } catch (e) { console.error("Tools load error:", e); }
}

function checkBarcodeStatus() {
  const withBarcode = allTools.filter(t => t.barcode && t.barcode.trim());
  const withoutBarcode = allTools.filter(t => !t.barcode || !t.barcode.trim());
  const notice = document.getElementById("barcodeNotice");
  if (withoutBarcode.length > 0 && withBarcode.length < allTools.length) {
    notice.innerHTML = `<i class="bi bi-exclamation-triangle me-1"></i>${withoutBarcode.length} item(s) missing barcodes. <button onclick="generateBarcodesPOS()" style="background:#f59e0b;color:#000;border:none;padding:2px 10px;border-radius:4px;font-weight:700;cursor:pointer;margin-left:8px;font-size:0.75rem;">Generate Now</button>`;
    notice.style.display = "flex";
  } else {
    notice.style.display = "none";
  }
}

async function generateBarcodesPOS() {
  try {
    const res = await fetch("/api/pos/tools/generate-barcodes", { method: "POST", credentials: "same-origin" });
    const data = await res.json();
    if (res.ok) {
      showToast(data.message || `Generated ${data.updated} barcodes`, "success");
      loadTools();
    } else {
      showToast(data.error || "Failed", "error");
    }
  } catch (e) { showToast("Failed to generate barcodes", "error"); }
}

// ── Tab Switching ─────────────────────────────────────────────────────────────
let currentTab = "tools";
let allAircons = [];

function switchTab(tab, btn) {
  currentTab = tab;
  document.querySelectorAll(".pos-tab").forEach(b => b.classList.remove("active"));
  btn.classList.add("active");

  const toolsGrid = document.getElementById("posGrid");
  const airconGrid = document.getElementById("posAirconGrid");
  const catsEl = document.getElementById("posCategories");
  const searchEl = document.getElementById("posSearch");

  if (tab === "tools") {
    toolsGrid.style.display = "";
    airconGrid.style.display = "none";
    catsEl.style.display = "";
    searchEl.placeholder = "Search parts, tools...";
  } else {
    toolsGrid.style.display = "none";
    airconGrid.style.display = "";
    catsEl.style.display = "none";
    searchEl.placeholder = "Search aircon models...";
    loadAircons();
  }
  searchEl.value = "";
}

async function loadAircons() {
  try {
    const q = document.getElementById("posSearch").value.trim();
    const params = new URLSearchParams();
    if (q) params.set("q", q);
    const res = await fetch(`/api/pos/aircons?${params}`);
    const data = await res.json();
    allAircons = data.items || [];
    renderAircons();
  } catch (e) { console.error("Aircons load error:", e); }
}

function renderAircons() {
  const grid = document.getElementById("posAirconGrid");
  if (!allAircons.length) {
    grid.innerHTML = '<div class="pos-empty"><i class="bi bi-snow"></i><p>No aircons in stock</p></div>';
    return;
  }
  let html = "";
  allAircons.forEach((a, idx) => {
    const oos = a.available <= 0;
    html += `
      <div class="pos-aircon-card${oos ? " oos" : ""}" data-aircon-idx="${idx}">
        ${a.imageUrl ? `<img class="pos-aircon-img" src="${escapeHtml(a.imageUrl)}" alt="" onerror="this.style.display='none'">` : `<div class="pos-aircon-img" style="display:flex;align-items:center;justify-content:center;color:#334155;font-size:2rem;"><i class="bi bi-snow"></i></div>`}
        <div class="pos-aircon-name" title="${escapeHtml(a.itemName)}">${escapeHtml(a.modelLine)}</div>
        <div class="pos-aircon-brand">${escapeHtml(a.brand || "")}</div>
        <div class="pos-aircon-specs">
          <span class="pos-aircon-badge type">${escapeHtml((a.capacity || "") + (a.capacityUnit || "HP"))}</span>
          ${a.inverter !== undefined ? `<span class="pos-aircon-badge ${a.inverter ? 'inv' : 'non'}">${a.inverter ? 'Inverter' : 'Non-Inverter'}</span>` : ""}
          ${a.btu ? `<span class="pos-aircon-badge type">${a.btu} BTU</span>` : ""}
        </div>
        <div class="pos-aircon-price">₱${Number(a.sellingPrice || 0).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</div>
        <div class="pos-aircon-stock">${oos ? "Out of stock" : `<strong>${a.available}</strong> unit(s) available`}</div>
      </div>`;
  });
  grid.innerHTML = html;
  // Bind click handlers after render
  grid.querySelectorAll("[data-aircon-idx]").forEach(el => {
    el.addEventListener("click", () => {
      const a = allAircons[parseInt(el.dataset.airconIdx)];
      if (a && a.available > 0) {
        addToCart({ _id: a._id, itemName: a.itemName, category: a.category, unit: a.unit, barcode: a.barcode, sellingPrice: a.sellingPrice, costPrice: a.costPrice, available: a.available, source: "aircon" });
      }
    });
  });
}

async function lookupBarcode(barcode) {
  if (!barcode) return;
  showToast(`Scanned: ${barcode}`, "info");
  try {
    const res = await fetch(`/api/pos/tools/barcode/${encodeURIComponent(barcode)}`);
    const data = await res.json();
    if (!res.ok) {
      showToast(data.error || "Item not found — try Manual Add", "error");
      return;
    }
    addToCart(data);
  } catch (e) {
    console.error("[POS] Barcode lookup error:", e);
    showToast("Barcode lookup failed — check connection", "error");
  }
}

// ── Render Products ───────────────────────────────────────────────────────────
function renderTools() {
  const grid = document.getElementById("posGrid");
  if (!allTools.length) {
    grid.innerHTML = '<div class="pos-empty"><i class="bi bi-box-seam"></i><p>No parts found</p></div>';
    return;
  }
  let html = "";
  allTools.forEach((t, idx) => {
    const oos = t.available <= 0;
    html += `
      <div class="pos-item${oos ? " oos" : ""}" data-tool-idx="${idx}">
        <div class="pos-item-name">${escapeHtml(t.itemName)}</div>
        <div class="pos-item-cat">${escapeHtml(t.category || "")}</div>
        ${t.serialNumber ? `<div class="pos-item-barcode"><i class="bi bi-qr-code"></i> SN: ${escapeHtml(t.serialNumber)}</div>` : ""}
        ${t.barcode ? `<div class="pos-item-barcode"><i class="bi bi-upc-scan"></i> ${escapeHtml(t.barcode)}</div>` : ""}
        <div class="pos-item-price">₱${Number(t.sellingPrice || 0).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</div>
        <div class="pos-item-stock">${oos ? "Out of stock" : `<strong>${t.available}</strong> ${t.unit || "pcs"} available`}</div>
      </div>`;
  });
  grid.innerHTML = html;
  grid.querySelectorAll("[data-tool-idx]").forEach(el => {
    el.addEventListener("click", () => {
      const t = allTools[parseInt(el.dataset.toolIdx)];
      if (t && t.available > 0) addToCart(t);
    });
  });
}

function filterCategory(cat, btn) {
  currentCategory = cat;
  document.querySelectorAll(".pos-cat-btn").forEach(b => b.classList.remove("active"));
  btn.classList.add("active");
  loadTools();
}

// ── Cart Operations ───────────────────────────────────────────────────────────
function addToCart(tool) {
  const existing = cart.find(i => i.toolId === tool._id);
  if (existing) {
    if (existing.quantity >= tool.available) { showToast("No more stock available", "warning"); return; }
    existing.quantity++;
    existing.totalPrice = existing.unitPrice * existing.quantity;
  } else {
    cart.push({
      toolId: tool._id,
      itemName: tool.itemName,
      category: tool.category || "",
      unit: tool.unit || "pcs",
      unitPrice: tool.sellingPrice || 0,
      costPrice: tool.costPrice || 0,
      available: tool.available,
      source: tool.source || "tool",
      quantity: 1,
      totalPrice: tool.sellingPrice || 0,
    });
  }
  renderCart();
  showToast(`Added "${tool.itemName}"`, "success");
}

function updateQty(idx, delta) {
  const item = cart[idx];
  if (!item) return;
  const newQty = item.quantity + delta;
  if (newQty <= 0) { cart.splice(idx, 1); }
  else if (newQty > item.available) { showToast("Insufficient stock", "warning"); return; }
  else { item.quantity = newQty; item.totalPrice = item.unitPrice * newQty; }
  renderCart();
}

function removeItem(idx) { cart.splice(idx, 1); renderCart(); }

function renderCart() {
  const itemsEl = document.getElementById("cartItems");
  const summaryEl = document.getElementById("cartSummary");
  const paymentEl = document.getElementById("posPayment");
  const countEl = document.getElementById("cartCount");

  countEl.textContent = cart.reduce((s, i) => s + i.quantity, 0);

  if (!cart.length) {
    itemsEl.innerHTML = '<div class="pos-cart-empty"><i class="bi bi-cart-x"></i><p>No items in cart</p></div>';
    summaryEl.style.display = "none";
    paymentEl.style.display = "none";
    return;
  }

  let html = "";
  cart.forEach((item, idx) => {
    html += `
      <div class="pos-cart-item">
        <div class="pos-cart-item-info">
          <div class="pos-cart-item-name">${escapeHtml(item.itemName)}</div>
          <div class="pos-cart-item-price">₱${item.unitPrice.toLocaleString("en-PH", { minimumFractionDigits: 2 })} × ${item.quantity}</div>
        </div>
        <div class="pos-cart-item-qty">
          <button onclick="updateQty(${idx}, -1)">−</button>
          <span>${item.quantity}</span>
          <button onclick="updateQty(${idx}, 1)">+</button>
        </div>
        <div class="pos-cart-item-total">₱${item.totalPrice.toLocaleString("en-PH", { minimumFractionDigits: 2 })}</div>
        <div class="pos-cart-item-remove" onclick="removeItem(${idx})"><i class="bi bi-trash3"></i></div>
      </div>`;
  });
  itemsEl.innerHTML = html;
  summaryEl.style.display = "block";
  paymentEl.style.display = "block";
  recalcCart();
}

function recalcCart() {
  const subtotal = cart.reduce((s, i) => s + i.totalPrice, 0);
  const discount = Math.max(0, parseFloat(document.getElementById("discountInput").value) || 0);
  const total = Math.max(0, subtotal - discount);

  document.getElementById("summarySubtotal").textContent = "₱" + subtotal.toLocaleString("en-PH", { minimumFractionDigits: 2 });
  document.getElementById("summaryDiscount").textContent = "-₱" + discount.toLocaleString("en-PH", { minimumFractionDigits: 2 });
  document.getElementById("summaryTotal").textContent = "₱" + total.toLocaleString("en-PH", { minimumFractionDigits: 2 });
  calcChange();
}

function selectPayment(method) {
  selectedPayment = method;
  document.querySelectorAll(".pos-pay-btn").forEach(b => b.classList.toggle("active", b.dataset.method === method));
  const cashRow = document.getElementById("cashInputRow");
  cashRow.style.display = method === "cash" ? "flex" : "none";
  if (method !== "cash") {
    document.getElementById("amountPaid").value = cart.reduce((s, i) => s + i.totalPrice, 0) - (parseFloat(document.getElementById("discountInput").value) || 0);
  }
  calcChange();
}

function calcChange() {
  const subtotal = cart.reduce((s, i) => s + i.totalPrice, 0);
  const discount = Math.max(0, parseFloat(document.getElementById("discountInput").value) || 0);
  const total = Math.max(0, subtotal - discount);
  const paid = parseFloat(document.getElementById("amountPaid").value) || 0;
  const change = paid - total;

  const changeRow = document.getElementById("changeRow");
  const checkoutBtn = document.getElementById("checkoutBtn");

  if (selectedPayment === "cash" && paid > 0) {
    changeRow.style.display = "flex";
    document.getElementById("changeValue").textContent = "₱" + Math.max(0, change).toLocaleString("en-PH", { minimumFractionDigits: 2 });
    changeRow.style.background = change >= 0 ? "#f0fdf4" : "#fef2f2";
    document.getElementById("changeValue").style.color = change >= 0 ? "#16a34a" : "#dc2626";
  } else {
    changeRow.style.display = "none";
  }

  checkoutBtn.disabled = cart.length === 0 || (selectedPayment === "cash" && paid < total);
}

// ── Checkout ──────────────────────────────────────────────────────────────────
async function processCheckout() {
  if (!cart.length) return;
  const btn = document.getElementById("checkoutBtn");
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner-border spinner-border-sm"></div>Processing...';

  const subtotal = cart.reduce((s, i) => s + i.totalPrice, 0);
  const discount = parseFloat(document.getElementById("discountInput").value) || 0;
  const total = subtotal - discount;
  const paid = parseFloat(document.getElementById("amountPaid").value) || 0;

  try {
    const res = await fetch("/api/pos/checkout", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        customerName: document.getElementById("customerName").value.trim(),
        customerPhone: document.getElementById("customerPhone").value.trim(),
        customerTin: document.getElementById("customerTin").value.trim(),
        customerAddress: document.getElementById("customerAddress").value.trim(),
        items: cart.map(i => ({ toolId: i.toolId, quantity: i.quantity, source: i.source || "tool" })),
        paymentMethod: selectedPayment,
        amountPaid: selectedPayment === "cash" ? paid : total,
        discount,
      }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "Checkout failed");

    showReceipt(data.sale);
    cart = [];
    document.getElementById("discountInput").value = "";
    document.getElementById("amountPaid").value = "";
    document.getElementById("customerName").value = "";
    document.getElementById("customerPhone").value = "";
    document.getElementById("customerTin").value = "";
    document.getElementById("customerAddress").value = "";
    renderCart();
    if (currentTab === "tools") loadTools(); else loadAircons();
    showToast("Sale completed!", "success");
  } catch (e) {
    showToast(e.message || "Checkout failed", "error");
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-check-circle"></i>Complete Sale';
  }
}

// ── Receipt ───────────────────────────────────────────────────────────────────
function showReceipt(sale) {
  const el = document.getElementById("receiptContent");
  const date = new Date(sale.completedAt || sale.createdAt);
  const itemsHtml = (sale.items || []).map(i =>
    `<tr>
      <td style="padding:6px 0;font-size:0.82rem;color:#0f172a;">${escapeHtml(i.itemName)}${i.serialNumber ? `<br><span style="font-size:0.65rem;color:#94a3b8;">SN: ${escapeHtml(i.serialNumber)}</span>` : ""}</td>
      <td style="padding:6px 0;font-size:0.82rem;text-align:center;color:#64748b;">${i.quantity} ${i.unit || "pcs"}</td>
      <td style="padding:6px 0;font-size:0.82rem;text-align:right;color:#0f172a;">₱${Number(i.totalPrice).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</td>
    </tr>`
  ).join("");

  el.innerHTML = `
    <div class="pos-receipt-header">
      <h4>CALIDRO RACS</h4>
      <p>Parts & Tools Point of Sale</p>
      <p style="margin-top:8px;font-size:0.7rem;opacity:0.7;">${date.toLocaleDateString("en-PH", { weekday: "long", year: "numeric", month: "long", day: "numeric" })} ${date.toLocaleTimeString("en-PH")}</p>
    </div>
    <div class="pos-receipt-body">
      <div style="font-size:0.78rem;color:#64748b;margin-bottom:4px;">
        <strong style="color:#0f172a;">${sale.invoiceNumber}</strong>
      </div>
      <div style="font-size:0.82rem;font-weight:600;color:#0f172a;margin-bottom:4px;">${sale.customerName || "Walk-In Customer"}</div>
      ${sale.customerPhone ? `<div style="font-size:0.72rem;color:#64748b;">Phone: ${escapeHtml(sale.customerPhone)}</div>` : ""}
      ${sale.customerTin ? `<div style="font-size:0.72rem;color:#64748b;">TIN: ${escapeHtml(sale.customerTin)}</div>` : ""}
      ${sale.customerAddress ? `<div style="font-size:0.72rem;color:#64748b;">Address: ${escapeHtml(sale.customerAddress)}</div>` : ""}
      <hr class="pos-receipt-divider">
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="border-bottom:1px solid #e2e8f0;">
            <th style="padding:6px 0;font-size:0.7rem;font-weight:700;text-transform:uppercase;color:#64748b;text-align:left;">Item</th>
            <th style="padding:6px 0;font-size:0.7rem;font-weight:700;text-transform:uppercase;color:#64748b;text-align:center;">Qty</th>
            <th style="padding:6px 0;font-size:0.7rem;font-weight:700;text-transform:uppercase;color:#64748b;text-align:right;">Amount</th>
          </tr>
        </thead>
        <tbody>${itemsHtml}</tbody>
      </table>
      <hr class="pos-receipt-divider">
      <div style="display:flex;justify-content:space-between;font-size:0.82rem;margin-bottom:4px;">
        <span style="color:#64748b;">Subtotal</span>
        <span style="font-weight:600;">₱${Number(sale.subtotal).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</span>
      </div>
      ${sale.discount > 0 ? `<div style="display:flex;justify-content:space-between;font-size:0.82rem;margin-bottom:4px;color:#ef4444;">
        <span>Discount</span><span style="font-weight:600;">-₱${Number(sale.discount).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</span>
      </div>` : ""}
      <div style="display:flex;justify-content:space-between;font-size:1rem;font-weight:800;margin-top:10px;padding-top:10px;border-top:2px solid #0f172a;">
        <span>TOTAL</span><span>₱${Number(sale.totalAmount).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</span>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:0.82rem;margin-top:8px;">
        <span style="color:#64748b;">Payment (${sale.paymentMethod.toUpperCase()})</span>
        <span>₱${Number(sale.amountPaid).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</span>
      </div>
      ${sale.change > 0 ? `<div style="display:flex;justify-content:space-between;font-size:0.82rem;color:#16a34a;font-weight:700;">
        <span>Change</span><span>₱${Number(sale.change).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</span>
      </div>` : ""}
    </div>
    <div class="pos-receipt-footer">
      <div style="margin-bottom:16px;padding-top:4px;text-align:center;">
        <div style="font-size:0.85rem;font-weight:600;color:#0f172a;margin-bottom:2px;">_______________________</div>
        <div style="font-size:0.72rem;color:#64748b;">Authorized Signature</div>
      </div>
      <p style="font-weight:700;color:#0f172a;">Thank you for your purchase!</p>
      <p>Processed by: ${escapeHtml(sale.processedByName || "Admin")}</p>
    </div>
    <div class="pos-receipt-actions">
      <button class="pos-receipt-print" onclick="printReceipt()"><i class="bi bi-printer me-1"></i>Print Receipt</button>
      <button class="pos-receipt-close" onclick="closeReceipt()"><i class="bi bi-x-lg me-1"></i>Close</button>
    </div>`;

  document.getElementById("receiptOverlay").classList.add("show");
}

function printReceipt() { window.print(); }
function closeReceipt() { document.getElementById("receiptOverlay").classList.remove("show"); }

// ── Sales History ─────────────────────────────────────────────────────────────
async function toggleSalesHistory() {
  const overlay = document.getElementById("historyOverlay");
  overlay.classList.toggle("show");
  if (overlay.classList.contains("show")) loadSalesHistory();
}

async function loadSalesHistory() {
  const el = document.getElementById("historyList");
  el.innerHTML = '<p class="text-muted text-center">Loading...</p>';
  try {
    const res = await fetch("/api/pos/sales?limit=50");
    const data = await res.json();
    if (!data.sales?.length) { el.innerHTML = '<p class="text-muted text-center">No sales yet</p>'; return; }

    let html = `<div style="margin-bottom:16px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;">
      <div style="background:#f0fdf4;padding:12px;border-radius:10px;text-align:center;">
        <div style="font-size:1.2rem;font-weight:800;color:#16a34a;">₱${Number(data.todayStats?.revenue || 0).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</div>
        <div style="font-size:0.7rem;color:#64748b;">Today's Revenue</div>
      </div>
      <div style="background:#eff6ff;padding:12px;border-radius:10px;text-align:center;">
        <div style="font-size:1.2rem;font-weight:800;color:#3b82f6;">${data.todayStats?.count || 0}</div>
        <div style="font-size:0.7rem;color:#64748b;">Today's Sales</div>
      </div>
      <div style="background:#fef3c7;padding:12px;border-radius:10px;text-align:center;">
        <div style="font-size:1.2rem;font-weight:800;color:#b45309;">₱${Number(data.todayStats?.profit || 0).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</div>
        <div style="font-size:0.7rem;color:#64748b;">Today's Profit</div>
      </div>
    </div>`;

    data.sales.forEach(s => {
      const d = new Date(s.createdAt);
      const statusBadge = s.status === "completed" ? '<span style="color:#16a34a;font-weight:600;">Completed</span>' :
        s.status === "voided" ? '<span style="color:#ef4444;font-weight:600;">Voided</span>' : '<span style="color:#f59e0b;">Pending</span>';
      html += `
        <div style="padding:12px;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;">
          <div>
            <div style="font-weight:700;font-size:0.85rem;color:#0f172a;">${s.invoiceNumber}</div>
            <div style="font-size:0.72rem;color:#64748b;">${d.toLocaleDateString("en-PH")} ${d.toLocaleTimeString("en-PH", { hour: "2-digit", minute: "2-digit" })}</div>
            <div style="font-size:0.72rem;color:#64748b;">${escapeHtml(s.customerName || "Walk-In")} · ${s.items?.length || 0} item(s)</div>
          </div>
          <div style="text-align:right;">
            <div style="font-weight:700;font-size:0.95rem;color:#0f172a;">₱${Number(s.totalAmount).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</div>
            ${statusBadge}
          </div>
        </div>`;
    });
    el.innerHTML = html;
  } catch (e) { el.innerHTML = '<p class="text-danger text-center">Failed to load history</p>'; }
}

// ── Utilities ─────────────────────────────────────────────────────────────────
function escapeHtml(str) { return String(str || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
function debounce(fn, ms) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }
function showToast(msg, type = "info") {
  if (typeof Swal !== "undefined") {
    Swal.fire({ toast: true, position: "top-end", icon: type, title: msg, showConfirmButton: false, timer: 2000 });
  }
}
