      </div>

      <!-- ══ 10. ACTIONS ══ -->
      <div class="pd-action-bar">
        <span style="font-size:0.72rem;font-weight:600;color:#64748b;">Actions:</span>
        ${stageOf(p) === 'planning' ? `<button class="pd-btn success" onclick="markReady(this)" ${!planningAllDone ? 'disabled' : ''} title="${!planningAllDone ? 'Complete all planning steps first' : ''}"><i class="bi bi-flag"></i> Mark Project Ready</button>` : ''}
        ${['planning','ready','in_progress'].includes(p.status) ? `<button class="pd-btn" onclick="showWorkOrderModal()"><i class="bi bi-list-check"></i> Work Orders</button>` : ''}
        ${['planning','ready','in_progress'].includes(p.status) ? `<button class="pd-btn" onclick="showTeamModal()"><i class="bi bi-person-plus"></i> Team</button>` : ''}
        ${stageOf(p) === 'planning' && p.schedulePlan?.status !== 'confirmed'
          ? `<button class="pd-btn" onclick="openScheduleModal()"><i class="bi bi-calendar3"></i> Schedule Dates</button>`
          : ['ready','in_progress','on_hold'].includes(p.status)
            ? `<button class="pd-btn" onclick="openRecoveryPlan('${defaultRecoveryMode(p)}')"><i class="bi bi-arrow-repeat"></i> Recovery Plan</button>`
            : ''}
        ${p.customer?.email ? `<button class="pd-btn" onclick="notifyCustomer()"><i class="bi bi-envelope"></i> Notify</button>` : ''}
        <button class="pd-btn" onclick="exportReport()"><i class="bi bi-download"></i> Export</button>
        ${['planning','ready','in_progress'].includes(p.status) ? `<button class="pd-btn danger" onclick="changeStatus('cancelled',this)"><i class="bi bi-x-circle"></i> Cancel</button>` : ''}
      </div>
    `;

    qs('#projectDetailContainer').innerHTML = html;
    window.__projectData = p;
    window.__projectBooking = data.booking;
    window.__materialsCount = materials.length;
    window.__lastMaterials = materials;
    window.__lastWorkOrders = workOrders || [];
    (workOrders || []).forEach(wo => refreshWoDaily(wo._id));
    applyStageVisibility(stageOf(p));
  }

  // Show only the cards relevant to the current enterprise stage.
  function applyStageVisibility(stage) {
    if (!stage) return;
    document.querySelectorAll('[data-stage-host] [data-stage]').forEach(card => {
      const allowed = (card.getAttribute('data-stage') || '').split(/\s+/);
      card.style.display = allowed.includes(stage) ? '' : 'none';
    });
  }

  function liveDotClass(s) {
    if (s === 'in_progress') return 'working';
    if (s === 'en_route') return 'en_route';
    if (s === 'arrived') return 'arrived';
    if (s === 'completed' || s === 'awaiting_review') return 'completed';
    return 'delayed';
  }
  function liveLabel(s) {
    return ({ accepted: 'Accepted', en_route: 'En Route', arrived: 'Arrived', in_progress: 'Working', partially_completed: 'Working', awaiting_review: 'Awaiting Lead Review', completed: 'Completed', pending: 'Waiting', assigned: 'Assigned' })[s] || s;
  }

  function renderLiveStatus(workOrders = []) {
    const container = qs('#liveStatusContainer');
    if (!container) return;
    const active = workOrders.filter(wo => ['accepted','en_route','arrived','in_progress','partially_completed','awaiting_review'].includes(wo.status));
    qs('#liveCount') && (qs('#liveCount').textContent = `${active.length} active`);
    if (active.length === 0) {
      container.innerHTML = '<div class="text-center py-3 text-muted" style="font-size:0.82rem;">No active work orders.</div>';
      return;
    }
    container.innerHTML = active.map(wo => {
      const crewSize = (wo.assignedTechnicians || []).length;
      return `<div class="live-row">
        <span class="live-dot ${liveDotClass(wo.status)}"></span>
        <div style="flex:1;">
          <div style="font-size:0.82rem;font-weight:600;">${crewSize ? `Project Team · ${crewSize}` : 'Team not assigned'}</div>
          <div class="wo-mini">${wo.title || wo.section || 'Work Order'} · ${liveLabel(wo.status)}</div>
        </div>
        <span class="wo-mini">${wo.completedUnitCount || 0}/${wo.unitCount}u</span>
      </div>`;
    }).join('');
    // socket-driven realtime updates
    if (window.__liveSocketBound) return;
    window.__liveSocketBound = true;
    const io = window.io;
    if (!io) return;
    const socket = io();
    socket.on('project:wo-status', (d) => {
      if (d.projectId === projectId) loadProject();
    });
    socket.on('project:issue', (d) => { if (d.projectId === projectId) loadProject(); });
    socket.on('expense:submitted', (d) => { if (d.projectId === projectId) loadProject(); });
    // ── Real-time team acceptance updates ───────────────────────────────────
    // When a technician accepts or declines a project assignment, the backend
    // emits this event so the admin page refreshes immediately.
    socket.on('project:team-status', (d) => {
      if (d.projectId === projectId) {
        if (d.action === 'accepted') {
          toast(`${d.techName} accepted the project assignment`, 'success');
        } else if (d.action === 'declined') {
          toast(`${d.techName} declined the project assignment`, 'error');
        }
        loadProject();
      }
    });
    socket.on('assignment:accepted', (d) => {
      loadProject();
    });
    socket.on('assignment:declined', (d) => {
      loadProject();
    });
  }

  // Daily Assignment plan: generate + display per-work-order daily targets.
  window.generateDailyPlan = async function(woId) {
    try {
      const r = await fetch(`/api/work-orders/${woId}/generate-daily`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
      if (r.ok) { toast('Daily plan generated'); await refreshWoDaily(woId); }
      else { const e = await r.json(); toast(e.error || 'Failed', 'error'); }
    } catch (e) { toast('Failed', 'error'); }
  };

  window.refreshWoDaily = async function(woId) {
    const el = document.getElementById('woDaily-' + woId);
    if (!el) return;
    try {
      const r = await fetch(`/api/work-orders/${woId}/daily-plan`);
      if (!r.ok) { el.innerHTML = ''; return; }
      const d = await r.json();
      const remaining = (d.workOrder.unitCount || 0) - (d.workOrder.completedUnitCount || 0);
      const today = d.today;
      const parts = [];
      parts.push(`<span class="wo-daily-pill"><i class="bi bi-grid-3x3-gap"></i> Total ${d.workOrder.unitCount}</span>`);
      parts.push(`<span class="wo-daily-pill"><i class="bi bi-check2-circle"></i> Done ${d.workOrder.completedUnitCount || 0}</span>`);
      parts.push(`<span class="wo-daily-pill"><i class="bi bi-hourglass-split"></i> Left ${remaining}</span>`);
      if (today) parts.push(`<span class="wo-daily-pill hl"><i class="bi bi-calendar-day"></i> Today target ${today.targetUnits}</span>`);
      // Aggregate daily assignments by date (sum across all techs for same date)
      const allDates = d.all || [];
      if (allDates.length > 0) {
        const byDate = {};
        allDates.forEach(a => {
          const key = new Date(a.date).toDateString();
          if (!byDate[key]) byDate[key] = { date: a.date, targetUnits: 0, completedUnits: 0 };
          byDate[key].targetUnits += (a.targetUnits || 0);
          byDate[key].completedUnits += (a.completedUnits || 0);
        });
        const dateRows = Object.values(byDate).sort((a,b) => new Date(a.date) - new Date(b.date)).map(a => {
          const dd = new Date(a.date);
          const ds = dd.toLocaleDateString('en-PH', { weekday:'short', month:'short', day:'numeric' });
          const isT = dd.toDateString() === new Date().toDateString();
          const done = a.completedUnits || 0;
          const target = a.targetUnits || 0;
          const pct = target > 0 ? Math.round((done/target)*100) : 0;
          return `<div class="wo-dd-row ${isT ? 'wo-dd-today' : ''}" title="${done}/${target} done">
            <span class="wo-dd-date">${ds}</span>
            <span class="wo-dd-bar"><span class="wo-dd-fill" style="width:${pct}%"></span></span>
            <span class="wo-dd-num">${done}/${target}</span>
          </div>`;
        }).filter(r => r.includes('0/0') === false || r.includes('wo-dd-today')).join('');
        if (dateRows) parts.push(`<div class="wo-dd-wrap">${dateRows}</div>`);
      }
      el.innerHTML = parts.join('');
    } catch (_) { el.innerHTML = ''; }
  };

  window.reassignWorkOrder = async function(woId) {
    try {
      const tr = await fetch(`/api/projects/${projectId}/eligible-technicians`);
      const td = tr.ok ? await tr.json() : { technicians: [] };
      const opts = (td.technicians || []).map(t => `<option value="${t._id}">${t.name || t.email || 'Unknown'}</option>`).join('');
      const modal = document.createElement('div');
      modal.className = 'pd-modal-overlay';
      modal.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);z-index:9999;display:flex;align-items:center;justify-content:center;';
      modal.innerHTML = `<div style="background:#fff;border-radius:16px;padding:1.5rem;width:400px;max-width:90vw;">
        <h4 style="font-size:1rem;font-weight:700;margin-bottom:1rem;">Reassign Work Order</h4>
        <label style="font-size:0.74rem;font-weight:600;color:#64748b;">New Technician</label>
        <select id="reassignTech" class="form-select form-select-sm mt-1" style="font-size:0.85rem;">${opts}</select>
        <div class="d-flex gap-2 justify-content-end mt-3">
          <button class="pd-btn" onclick="closeModal(this)">Cancel</button>
          <button class="pd-btn primary" id="reassignBtn">Reassign</button>
        </div></div>`;
      document.body.appendChild(modal);
      modal.querySelector('#reassignBtn').addEventListener('click', async () => {
        const techId = modal.querySelector('#reassignTech').value;
        if (!techId) { toast('Select a technician', 'error'); return; }
        try {
          const r = await fetch(`/api/work-orders/${woId}/reassign`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ technicianId: techId }) });
          if (r.ok) { toast('Work order reassigned'); modal.remove(); loadProject(); }
          else { const e = await r.json(); toast(e.error || 'Failed', 'error'); }
        } catch(e) { toast('Failed', 'error'); }
      });
      modal.addEventListener('click', e => { if (e.target === modal) modal.remove(); });
    } catch(e) { toast('Failed to load technicians', 'error'); }
  };

  window.resolveIssue = async function(issueId, btn) {
    const note = prompt('Resolution note (optional):') || '';
    const action = async () => {
      try {
        const r = await fetch(`/api/issues/${issueId}/resolve`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ resolutionNote: note }) });
        if (r.ok) { toast('Issue resolved'); loadProject(); }
        else { const e = await r.json(); toast(e.error || 'Failed', 'error'); }
      } catch(e) { toast('Failed', 'error'); }
    };
    if (btn) await withBtnLoading(btn, 'Saving…', action);
    else await action();
  };

  window.approveExpense = async function(expenseId, decision, btn) {
    const action = async () => {
      try {
        const r = await fetch(`/api/expenses/${expenseId}/approve`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ decision }) });
        if (r.ok) { toast(decision === 'approve' ? 'Expense approved' : 'Expense rejected'); loadProject(); }
        else { const e = await r.json(); toast(e.error || 'Failed', 'error'); }
      } catch(e) { toast('Failed', 'error'); }
    };
    if (btn) await withBtnLoading(btn, 'Saving…', action);
    else await action();
  };

  // Admin approves or rejects the lead's quotation (large-scale project phase)
  window.approveQuotation = async function(pid) {
    if (!confirm('Approve this quotation? The project will move to execution phase and the team can mobilize.')) return;
    try {
      const r = await fetch(`/api/projects/${pid}/review-quotation`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'approve' }),
      });
      if (r.ok) { toast('Quotation approved — execution phase started'); loadProject(); }
      else { const e = await r.json(); toast(e.error || 'Failed', 'error'); }
    } catch(e) { toast('Failed to approve quotation', 'error'); }
  };
  window.rejectQuotation = async function(pid) {
    const reason = prompt('Rejection reason (sent to lead technician for revision):');
    if (reason === null) return;
    try {
      const r = await fetch(`/api/projects/${pid}/review-quotation`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'reject', rejectionReason: reason }),
      });
      if (r.ok) { toast('Quotation rejected — returned to lead for revision'); loadProject(); }
      else { const e = await r.json(); toast(e.error || 'Failed', 'error'); }
    } catch(e) { toast('Failed to reject quotation', 'error'); }
  };

  window.changeStatus = async function(status, btn) {
    if (!confirm(`Change project status to "${status}"?`)) return;
    const action = async () => {
      try {
        const r = await fetch(`/api/projects/${projectId}/status`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status }),
        });
        if (r.ok) { toast('Status updated'); loadProject(); }
        else { const e = await r.json(); toast(e.error || 'Failed', 'error'); }
      } catch(e) { toast('Failed to update status', 'error'); }
    };
    if (btn) await withBtnLoading(btn, 'Saving…', action);
    else await action();
  };

  // Admin verifies/accepts a large-scale project before it can move to planning.
  window.verifyProject = async function(btn) {
    const p = window.__projectData;
    if (!p || p.status !== 'pending_project_scheduling') return;
    const label = p.isLargeScale ? 'Verify this large-scale project (details & payment checked) and accept it for planning?' : 'Approve this project and start planning?';
    if (!confirm(label)) return;
    const action = async () => {
      try {
        const r = await fetch(`/api/projects/${projectId}/verify`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
        if (r.ok) { toast('Project approved — planning started'); loadProject(); }
        else { const e = await r.json(); toast(e.error || 'Failed to verify', 'error'); }
      } catch(e) { toast('Failed to verify project', 'error'); }
    };
    if (btn) await withBtnLoading(btn, 'Approving…', action);
    else await action();
  };

  // Mark the project Ready: server validates the planning gate (team + schedule + work orders).
  window.markReady = async function(btn) {
    const p = window.__projectData;
    if (!p) return;
    // Client-side guard — buttons are disabled but double-check in case of stale state.
    const workOrders = window.__lastWorkOrders || [];
    const materials = window.__lastMaterials || [];
    const teamOk = (p.assignedTechnicians?.length || p.totalAssignedTechnicians || 0) > 0;
    // Team acceptance gate — all assigned technicians must accept
    const teamStatusArr = p.teamStatus || [];
    const allAssignedTechs = p.assignedTechnicians || [];
    const allTeamAccepted = !teamOk || allAssignedTechs.length === 0 || allAssignedTechs.every(t => {
      const ts = teamStatusArr.find(s => String(s._id || s.technicianId || '') === String(t._id || t.id || ''));
      return ts && ts.status === 'acknowledged';
    });
    const plannedResources = p.planningDraft?.resources || [];
    const matOk = plannedResources.some(resource => ['planned','required','confirmed'].includes(resource.recommendationState)) &&
      plannedResources.every(resource => ['planned','required','confirmed','optional','rejected'].includes(resource.recommendationState)) &&
      !(p.planningDraft?.readiness?.blockers || []).length;
    const schedOk = p.schedulePlan?.status === 'ready' && !(p.schedulePlan?.conflicts || []).some(c => c.blocking);
    const woOk = workOrders.length > 0;
    let covered = 0, total = 0, unassignedWos = 0;
    workOrders.forEach(wo => {
      total += (wo.unitCount || 0);
      const techs = (wo.assignedTechnicians || []).filter(t => t && (t._id || t.id));
      if (techs.length === 0) { unassignedWos++; return; }
      covered += (wo.unitCount || 0);
    });
    const coverOk = workOrders.length > 0 && unassignedWos === 0 && covered >= total;
    if (!allTeamAccepted) {
      toast('All team members must accept the assignment before marking the project ready', 'error');
      return;
    }
    if (!teamOk || !matOk || !schedOk || !woOk || !coverOk) {
      toast('Complete all planning steps before marking the project ready', 'error');
      return;
    }
    if (!confirm('Confirm this project plan? Required resources will now be reserved, the planning baseline will be locked, and work orders will be released to the accepted team.')) return;
    const action = async () => {
      try {
        const r = await fetch(`/api/projects/${projectId}/status`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: 'ready' }),
        });
        if (r.ok) { toast('Project marked ready — technicians will receive assignments'); loadProject(); }
        else {
          const e = await r.json().catch(() => ({}));
          toast(e.error || 'Cannot mark ready yet', 'error');
        }
      } catch(e) { toast('Failed to update status', 'error'); }
    };
    if (btn) await withBtnLoading(btn, 'Saving…', action);
    else await action();
  };

  // Request changes from the customer: park the project on hold with a note.
  window.requestChanges = async function(btn) {
    const note = prompt('Describe the changes needed from the customer:');
    if (note === null) return;
    const action = async () => {
      try {
        const r = await fetch(`/api/projects/${projectId}/status`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: 'on_hold', adminNotes: note ? 'CHANGES REQUESTED: ' + note : 'Changes requested' }),
        });
        if (r.ok) { toast('Changes requested — project on hold'); loadProject(); }
        else { const e = await r.json(); toast(e.error || 'Failed', 'error'); }
      } catch(e) { toast('Failed to update status', 'error'); }
    };
    if (btn) await withBtnLoading(btn, 'Requesting…', action);
    else await action();
  };
