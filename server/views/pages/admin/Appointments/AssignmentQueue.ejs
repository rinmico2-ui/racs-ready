  function showToast(msg, type) {
    const toast = document.getElementById('globalToast');
    if (toast) { toast.querySelector('.toast-body').innerHTML = msg; toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 3000); }
  }

  // Enterprise notification system
  function showNotification(opts) {
    var type = opts.type || 'info';
    var title = opts.title || '';
    var message = opts.message || '';
    var duration = opts.duration || 3000;
    var colors = {
      success: { bg: '#f0fdf4', border: '#22c55e', icon: 'bi-check-circle-fill', iconColor: '#16a34a' },
      error: { bg: '#fef2f2', border: '#ef4444', icon: 'bi-x-circle-fill', iconColor: '#dc2626' },
      warning: { bg: '#fffbeb', border: '#f59e0b', icon: 'bi-exclamation-triangle-fill', iconColor: '#d97706' },
      info: { bg: '#eff6ff', border: '#3b82f6', icon: 'bi-info-circle-fill', iconColor: '#2563eb' }
    };
    var c = colors[type] || colors.info;
    var el = document.createElement('div');
    el.style.cssText = 'position:fixed;top:20px;right:20px;z-index:99999;min-width:340px;max-width:420px;background:' + c.bg + ';border:1px solid ' + c.border + ';border-left:4px solid ' + c.border + ';border-radius:12px;padding:16px 20px;box-shadow:0 10px 40px rgba(0,0,0,0.15);display:flex;align-items:flex-start;gap:12px;animation:slideInRight 0.3s ease;';
    var html = '';
    html += '<i class="bi ' + c.icon + '" style="font-size:1.3rem;color:' + c.iconColor + ';margin-top:2px;"></i>';
    html += '<div style="flex:1;">';
    html += '<div style="font-weight:700;font-size:0.9rem;color:#1e293b;margin-bottom:2px;">' + title + '</div>';
    html += '<div style="font-size:0.82rem;color:#64748b;">' + message + '</div>';
    html += '</div>';
    html += '<button onclick="this.parentElement.remove()" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:1.1rem;padding:0;line-height:1;">&times;</button>';
    el.innerHTML = html;
    document.body.appendChild(el);

    if (!document.getElementById('notif-styles')) {
      const style = document.createElement('style');
      style.id = 'notif-styles';
      style.textContent = '@keyframes slideInRight{from{transform:translateX(100%);opacity:0;}to{transform:translateX(0);opacity:1;}}';
      document.head.appendChild(style);
    }

    setTimeout(() => {
      el.style.transition = 'all 0.3s ease';
      el.style.opacity = '0';
      el.style.transform = 'translateX(100%)';
      setTimeout(() => el.remove(), 300);
    }, duration);
  }

  // Auto-open assign modal if navigated from attention queue Reassign
  async function autoOpenAssignFromQuery() {
    const params = new URLSearchParams(window.location.search);
    const id = params.get('assign');
    if (!id) return;
    try {
      const res = await fetch('/api/admin/appointments/' + encodeURIComponent(id));
      if (!res.ok) throw new Error('Booking not found');
      const data = await res.json();
      const b = data.booking;
      if (!b) return;
      const customerName = (b.customer?.name || 'Customer').replace(/'/g, "\\'");
      const serviceName = (b.service?.name || (b.serviceModel === 'RepairService' ? 'Repair Service' : 'Service') || '').replace(/'/g, "\\'");
      openAssignModal(String(b._id || b.id), customerName, serviceName, formatDate(b.bookingDate), formatTime(b.startTime));
    } catch (e) {
      console.warn('Auto-open assign failed:', e.message);
    }
  }

  loadStats();
  loadQueue(1);
  autoOpenAssignFromQuery();

