<script>
(()=>{
  const A=<%- JSON.stringify(analytics||{}).replace(/</g,'\\u003c') %>;
  if (<%- JSON.stringify(isDeferred) %>) {
    // Start the database work before Chart.js downloads so network and server
    // latency overlap instead of making the user wait for them sequentially.
    window.__revenueInitialRequest = fetch('/api/<%= reportRole %>/reports/revenue', {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' },
    }).then(async response => ({ response, data: await response.json().catch(() => ({})) }));
  }
  const labels=Object.keys(A.monthlyRevenue||{}).reverse();
  const months=Object.values(A.monthlyRevenue||{}).reverse();
  const costs=Object.values(A.monthlyPartsCost||{}).reverse();
  document.getElementById('exportRevenue')?.addEventListener('click',()=>{
    const q=v=>'"'+String(v??'').replaceAll('"','""')+'"';
    const rows=[['Month','Booked Service Value','Booked Order Value','POS Revenue','Total Booking value','Completed sales after refunds','Payments received','Refunds','Payments after refunds','Saved job and product cost'],
      ...months.map((m,i)=>[labels[i],m.service||0,m.orders||0,m.pos||0,m.total||0,m.recognized||0,(m.collections||0)+(m.refunds||0),m.refunds||0,m.collections||0,costs[i]||0])];
    const b=new Blob([rows.map(r=>r.map(q).join(',')).join('\n')],{type:'text/csv;charset=utf-8'});
    const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='sales-and-payments.csv';a.click();URL.revokeObjectURL(a.href);
  });
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(() => {
  const pageSize = 10;
  let rows = Array.from(document.querySelectorAll('.profitability-modal-row'));
  const pagination = document.getElementById('profitabilityPagination');
  const pageInfo = document.getElementById('profitabilityPageInfo');
  let currentPage = 1;
  function showProfitabilityPage(page) {
    rows = Array.from(document.querySelectorAll('.profitability-modal-row'));
    const totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
    currentPage = Math.min(Math.max(1, page), totalPages);
    rows.forEach((row, index) => { row.style.display = Math.floor(index / pageSize) + 1 === currentPage ? '' : 'none'; });
    const first = rows.length ? ((currentPage - 1) * pageSize) + 1 : 0;
    const last = Math.min(currentPage * pageSize, rows.length);
    pageInfo.textContent = `Showing ${first}–${last} of ${rows.length} completed services`;
    pagination.innerHTML = '';
    const addButton = (label, page, disabled, active) => {
      const item = document.createElement('li'); item.className = `page-item${disabled ? ' disabled' : ''}${active ? ' active' : ''}`;
      const button = document.createElement('button'); button.className = 'page-link'; button.type = 'button'; button.innerHTML = label;
      button.disabled = disabled; button.addEventListener('click', () => showProfitabilityPage(page)); item.appendChild(button); pagination.appendChild(item);
    };
    addButton('<i class="bi bi-chevron-left"></i>', currentPage - 1, currentPage === 1, false);
    for (let pageNumber = 1; pageNumber <= totalPages; pageNumber += 1) addButton(String(pageNumber), pageNumber, false, pageNumber === currentPage);
    addButton('<i class="bi bi-chevron-right"></i>', currentPage + 1, currentPage === totalPages, false);
  }
  document.getElementById('serviceProfitabilityModal')?.addEventListener('show.bs.modal', () => showProfitabilityPage(1));
  showProfitabilityPage(1);
  window.refreshProfitabilityPagination = () => showProfitabilityPage(1);
})();
</script>

<!-- ═══ REVENUE FILTER LOGIC ═══ -->
<script>
(() => {
  const peso = n => '\u20B1' + Math.round(Number(n || 0)).toLocaleString('en-PH');
  const pct = n => Number(n || 0).toFixed(1) + '%';
  const esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  let charts = {};
  let activePosCategory = 'all';

  // ── Populate technician dropdown from initial analytics ──
  const initA = <%- JSON.stringify(analytics || {}).replace(/</g, '\\u003c') %>;
  const deferredAnalytics = <%- JSON.stringify(isDeferred) %>;
  if (initA.topTechnicians) {
    const techSelect = document.getElementById('filterTechnician');
    initA.topTechnicians.forEach(t => {
      const opt = document.createElement('option');
      opt.value = t.id; opt.textContent = t.name;
      techSelect.appendChild(opt);
    });
  }

  // ── Show/hide custom date range ──
  document.getElementById('filterPeriod').addEventListener('change', function() {
    const el = document.getElementById('customDateRange');
    el.style.display = this.value === 'custom' ? 'flex' : 'none';
  });

  // ── Apply filters ──
  document.getElementById('applyFilters').addEventListener('click', applyFilters);
  document.getElementById('resetFilters').addEventListener('click', resetFilters);

  async function applyFilters(options = {}) {
    const btn = document.getElementById('applyFilters');
    const dataState = document.getElementById('revenueDataState');
    btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Loading...';
    document.querySelector('.revenue-report')?.setAttribute('aria-busy', 'true');
    if (dataState && options.initialLoad) {
      dataState.hidden = false;
      dataState.classList.remove('error');
      dataState.innerHTML = '<span class="spinner-border" aria-hidden="true"></span><span>Loading live revenue, including completed walk-in and POS sales&hellip;</span>';
    }

    const params = new URLSearchParams();
    const period = document.getElementById('filterPeriod').value;
    if (period !== 'custom' && period !== 'last_12_months') params.set('period', period);
    if (period === 'custom') {
      const from = document.getElementById('filterFrom').value;
      const to = document.getElementById('filterTo').value;
      if (from) params.set('from', from);
      if (to) params.set('to', to);
    }
    const source = document.getElementById('filterSource').value;
    const serviceType = document.getElementById('filterServiceType').value;
    const payment = document.getElementById('filterPayment').value;
    const status = document.getElementById('filterStatus').value;
    const tech = document.getElementById('filterTechnician').value;

    if (source !== 'all') params.set('source', source);
    if (serviceType !== 'all') params.set('serviceType', serviceType);
    if (payment !== 'all') params.set('paymentMethod', payment);
    if (status !== 'all') params.set('paymentStatus', status);
    if (tech !== 'all') params.set('technician', tech);

    try {
      let resp;
      let data;
      if (options.initialLoad && window.__revenueInitialRequest && !params.toString()) {
        const initialResult = await window.__revenueInitialRequest;
        window.__revenueInitialRequest = null;
        resp = initialResult.response;
        data = initialResult.data;
      } else {
        resp = await fetch(`/api/<%= reportRole %>/reports/revenue?${params.toString()}`, { credentials: 'same-origin' });
        data = await resp.json().catch(() => ({}));
      }
      if (resp.ok && data.success) {
        updateDashboard(data.analytics, data.technicians);
        showFilterStatus(data.filters);
        if (dataState) dataState.hidden = true;
      } else {
        throw new Error(data.error || 'Failed to load filtered data.');
      }
    } catch (e) {
      console.error('Filter error:', e);
      if (dataState) {
        dataState.hidden = false;
        dataState.classList.add('error');
        dataState.innerHTML = '<i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>Revenue data could not be loaded. Use Apply to retry.</span>';
      }
      if (!options.initialLoad) alert(e.message || 'Network error.');
    }

    btn.disabled = false; btn.innerHTML = '<i class="bi bi-funnel me-1"></i> Apply';
    document.querySelector('.revenue-report')?.removeAttribute('aria-busy');
  }

  function resetFilters() {
    document.getElementById('filterPeriod').value = 'last_12_months';
    document.getElementById('filterSource').value = 'all';
    document.getElementById('filterServiceType').value = 'all';
    document.getElementById('filterPayment').value = 'all';
    document.getElementById('filterStatus').value = 'all';
    document.getElementById('filterTechnician').value = 'all';
    document.getElementById('customDateRange').style.display = 'none';
    document.getElementById('filterStatusBadge').style.display = 'none';
    applyFilters();
  }

  function showFilterStatus(filters) {
    const badge = document.getElementById('filterStatusBadge');
    const text = document.getElementById('filterStatusText');
    const parts = [];
    if (filters.startDate) parts.push(new Date(filters.startDate).toLocaleDateString('en-PH', { month: 'short', year: 'numeric' }) + ' – ' + new Date(filters.endDate).toLocaleDateString('en-PH', { month: 'short', year: 'numeric' }));
    if (filters.source !== 'all') parts.push('Source: ' + filters.source);
    if (filters.serviceType !== 'all') parts.push('Type: ' + filters.serviceType);
    if (filters.paymentMethod !== 'all') parts.push('Payment: ' + filters.paymentMethod);
    if (filters.paymentStatus !== 'all') parts.push('Status: ' + filters.paymentStatus);
    if (filters.technician !== 'all') parts.push('Technician filtered');
    text.textContent = parts.length ? 'Active filters: ' + parts.join(' · ') : 'Showing all data (rolling 12 months)';
    badge.style.display = 'block';
  }

  function renderPosCategorySection(A) {
    const categories = A.posCategoryBreakdown || [];
    const categoryGrid = document.getElementById('posCategoryBreakdown');
    if (categoryGrid) {
      categoryGrid.innerHTML = categories.map(category => {
        const icon = category.key === 'aircon_products' ? 'bi-snow' : category.key === 'consumables' ? 'bi-droplet-half' : 'bi-wrench-adjustable';
        return `<article class="rr-card rr-pos-category-card ${esc(category.key)}">
          <div class="rr-pos-category-icon"><i class="bi ${icon}"></i></div>
          <div class="rr-pos-category-copy"><small>${esc(category.label)}</small><strong>${peso(category.revenue)}</strong><p>${Number(category.units||0).toLocaleString('en-PH')} units · ${Number(category.transactionCount||0).toLocaleString('en-PH')} completed sales</p></div>
          <div class="rr-pos-category-finance"><span>Product cost <b>${peso(category.cost)}</b></span><span>Profit before expenses <b class="${Number(category.profit||0)>=0?'positive':'negative'}">${category.costComplete === false ? 'Incomplete costs' : peso(category.profit)}</b></span><span>Profit % <b>${category.costComplete === false ? '—' : pct(category.margin)}</b></span></div>
        </article>`;
      }).join('');
    }

    const allProducts = A.posCategoryProducts || [];
    const products = activePosCategory === 'all'
      ? allProducts
      : allProducts.filter(product => product.businessCategory === activePosCategory);
    const posBody = document.getElementById('topPosProductsBody');
    if (posBody) {
      posBody.innerHTML = products.length
        ? products.slice(0, 8).map(product => `<tr><td class="fw-bold">${esc(product.name)}<div class="rr-meta">${esc(product.category)}</div></td><td><span class="rr-pos-category-tag ${esc(product.businessCategory)}">${esc(product.businessCategoryLabel)}</span></td><td class="text-center">${Number(product.quantity||0).toLocaleString('en-PH')}</td><td class="text-end">${peso(product.revenue)}</td><td class="text-end">${peso(product.cost)}</td><td class="text-end fw-bold ${Number(product.profit||0)>=0?'text-success':'text-danger'}">${product.costComplete === false ? "Incomplete costs" : peso(product.profit)}</td></tr>`).join('')
        : '<tr><td colspan="6" class="rr-empty">No completed sales in this category for the selected dates.</td></tr>';
    }
    const posBadge = document.getElementById('posSummaryBadge');
    if (posBadge) posBadge.textContent = `${products.length} product${products.length===1?'':'s'}`;
    const slowProducts = (A.lowestSellingPosProducts || []).filter(product => activePosCategory === 'all' || product.businessCategory === activePosCategory);
    const slowBody = document.getElementById('lowestPosProductsBody');
    if (slowBody) slowBody.innerHTML = slowProducts.length
      ? slowProducts.slice(0, 8).map(product => `<tr><td class="fw-bold">${esc(product.name)}<div class="rr-meta">${esc(product.category)}</div></td><td><span class="rr-pos-category-tag ${esc(product.businessCategory)}">${esc(product.businessCategoryLabel)}</span></td><td class="text-center">${Number(product.quantity||0).toLocaleString('en-PH')}</td><td class="text-end">${peso(product.revenue)}</td><td>Check demand before replenishing</td></tr>`).join('')
      : '<tr><td colspan="5" class="rr-empty">No completed sales in this category for the selected dates.</td></tr>';
    const slowBadge = document.getElementById('lowestPosSummaryBadge');
    if (slowBadge) slowBadge.textContent = `${slowProducts.length} sold product${slowProducts.length===1?'':'s'}`;
  }

  // ── Update dashboard with new data ──
  function updateDashboard(A, technicians) {
    currentA = A;
    // Update KPIs — enterprise card style matching Service Report
    const kpiHtml = `
      <div class="kpi-enterprise" data-accent="blue" data-aos="fade-up" data-aos-delay="0">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon blue"><i class="bi bi-cash-stack"></i></div>
          <span class="kpi-enterprise-badge blue">${A.totalTransactions||0} txns</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Approved work value</p>
          <div class="kpi-enterprise-value"><span id="kpiTotalRevenue">${peso(A.totalRevenue)}</span></div>
          <small style="color:#64748b;">Approved services/projects + active orders + completed POS</small>
        </div>
        <div class="kpi-enterprise-sparkline"><canvas id="kpiSparkRevenue"></canvas></div>
      </div>
      <div class="kpi-enterprise" data-accent="cyan" data-aos="fade-up" data-aos-delay="50">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon cyan"><i class="bi bi-clipboard-check"></i></div>
          <span class="kpi-enterprise-badge cyan">${A.recognizedTransactions||0} completed</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Completed sales</p>
          <div class="kpi-enterprise-value"><span>${peso(A.recognizedRevenue)}</span></div>
          <small style="color:#64748b;">Completed work net of period refunds</small>
        </div>
      </div>
      <div class="kpi-enterprise" data-accent="amber" data-aos="fade-up" data-aos-delay="100">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon amber"><i class="bi bi-bank"></i></div>
          <span class="kpi-enterprise-badge amber">${peso(A.refunds)} refunds</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Payments after refunds</p>
          <div class="kpi-enterprise-value"><span>${peso(A.netCollections)}</span></div>
          <small style="color:#64748b;">Payments received less period refunds</small>
        </div>
      </div>
      <div class="kpi-enterprise" data-accent="red" data-aos="fade-up" data-aos-delay="120">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon red"><i class="bi bi-hourglass-split"></i></div>
          <span class="kpi-enterprise-badge red">${pct(A.collectionRate)} collected</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Unpaid balance</p>
          <div class="kpi-enterprise-value"><span>${peso(A.outstandingValue)}</span></div>
          <small style="color:#64748b;">Approved work value less payments after refunds</small>
        </div>
      </div>
      <div class="kpi-enterprise" data-accent="green" data-aos="fade-up" data-aos-delay="130">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon green"><i class="bi bi-boxes"></i></div>
          <span class="kpi-enterprise-badge green">${pct(A.costDataCoverage)} covered</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Saved job and product costs</p>
          <div class="kpi-enterprise-value"><span>${peso(A.totalPartsCost)}</span></div>
          <small style="color:#64748b;">Service, POS, order COGS and project materials</small>
        </div>
      </div>
      <div class="kpi-enterprise" data-accent="purple" data-aos="fade-up" data-aos-delay="140">
        <div class="kpi-enterprise-top">
          <div class="kpi-enterprise-icon purple"><i class="bi bi-calculator"></i></div>
          <span class="kpi-enterprise-badge ${Number(A.operatingProfit||0) >= 0 ? 'green' : 'red'}">${pct(A.operatingProfitMargin)} profit</span>
        </div>
        <div class="kpi-enterprise-body">
          <p class="kpi-enterprise-label">Profit after expenses</p>
          <div class="kpi-enterprise-value"><span style="color:${Number(A.operatingProfit||0) >= 0 ? '#059669' : '#dc2626'}">${peso(A.operatingProfit)}</span></div>
          <small style="color:#64748b;">After saved job and product costs, approved expenses and payroll</small>
        </div>
      </div>`;
    document.getElementById('kpiGrid').innerHTML = kpiHtml;

    const insightGrid = document.getElementById('executiveInsightsGrid');
    if (insightGrid) insightGrid.innerHTML = [...(A.executiveInsights || [])].sort((a, b) => ({danger:0,warning:1,info:2,success:3}[a.tone] ?? 2) - ({danger:0,warning:1,info:2,success:3}[b.tone] ?? 2)).slice(0, 3).map(x => {
      const tone = ['danger', 'warning', 'success'].includes(x.tone) ? x.tone : 'info';
      const icon = tone === 'danger' ? 'bi-exclamation-triangle' : tone === 'warning' ? 'bi-wallet2' : tone === 'success' ? 'bi-graph-up-arrow' : 'bi-pie-chart';
      return `<article class="rr-card rr-insight ${tone}"><div class="rr-insight-icon"><i class="bi ${icon}"></i></div><div><h4>${esc(x.title)}</h4><p>${esc(x.text)}</p></div></article>`;
    }).join('');

    const activitySnapshot = document.getElementById('revenueActivitySnapshot');
    if (activitySnapshot) activitySnapshot.innerHTML = `
      <article><span class="rr-activity-icon service"><i class="bi bi-calendar2-check"></i></span><div><small>Service bookings</small><strong>${Number(A.serviceTransactions||0).toLocaleString('en-PH')}</strong><p>${peso(A.avgServiceTicket)} average booking value</p></div></article>
      <article><span class="rr-activity-icon orders"><i class="bi bi-bag-check"></i></span><div><small>Product orders</small><strong>${Number(A.orderTransactions||0).toLocaleString('en-PH')}</strong><p>${Number(A.walkInOrderTransactions||0).toLocaleString('en-PH')} walk-in · ${peso(A.avgOrderValue)} average</p></div></article>
      <article><span class="rr-activity-icon pos"><i class="bi bi-shop"></i></span><div><small>Walk-in counter / POS</small><strong>${Number(A.posTransactions||0).toLocaleString('en-PH')}</strong><p>${peso(A.avgPosSale)} average sale</p></div></article>
      <article><span class="rr-activity-icon completed"><i class="bi bi-check2-circle"></i></span><div><small>Completed activity</small><strong>${Number(A.recognizedTransactions||0).toLocaleString('en-PH')}</strong><p>Completed sales records</p></div></article>`;

    const controlGrid = document.getElementById('revenueControlGrid');
    if (controlGrid) controlGrid.innerHTML = `
      <article class="${Number(A.atRiskServiceBookings||0) ? 'danger' : 'success'}"><i class="bi bi-calendar2-x"></i><div><small>Schedule needs a change</small><strong>${Number(A.atRiskServiceBookings||0).toLocaleString('en-PH')}</strong><p>of ${Number(A.openServiceBookings||0).toLocaleString('en-PH')} open service bookings need reassignment or rescheduling</p><a href="/<%= reportRole %>/operations/resolution-center">Open resolution center <i class="bi bi-arrow-right"></i></a></div></article>
      <article class="${Number(A.paymentExceptionCount||0) ? 'danger' : 'success'}"><i class="bi bi-receipt-cutoff"></i><div><small>Payments to check</small><strong>${Number(A.paymentExceptionCount||0).toLocaleString('en-PH')}</strong><p>${peso(A.paymentExceptionValue)} amount needing a check · ${Number(A.pendingLedgerCount||0).toLocaleString('en-PH')} pending records</p><a href="<%= reportLinks.remittance %>"><%= reportRole === "secretary" ? "Review payments" : "Review payment custody" %> <i class="bi bi-arrow-right"></i></a></div></article>
      <article class="${Number(A.costDataCoverage||0) < 95 ? 'warning' : 'success'}"><i class="bi bi-database-check"></i><div><small>Saved cost details</small><strong>${pct(A.costDataCoverage)}</strong><p>Overall coverage · ${pct(A.orderCostCoverage)} completed-order sales with saved costs</p><a href="/<%= reportRole %>/reports/inventory">Check product costs <i class="bi bi-arrow-right"></i></a></div></article>
      <article class="${Number(A.pendingExpenseCount||0) + Number(A.draftPayrollCount||0) ? 'warning' : 'success'}"><i class="bi bi-journal-check"></i><div><small>Costs waiting for approval</small><strong>${Number(A.pendingExpenseCount||0) + Number(A.draftPayrollCount||0)}</strong><p>${Number(A.pendingExpenseCount||0)} pending expenses · ${Number(A.draftPayrollCount||0)} draft payrolls excluded from profit</p><a href="<%= reportLinks.costs %>"><%= reportRole === "secretary" ? "Review expenses" : "Review unposted costs" %> <i class="bi bi-arrow-right"></i></a></div></article>`;
    const controlBadge = document.querySelector('.rr-control-center .rr-head > .rr-badge');
    if (controlBadge) controlBadge.textContent = `${pct(A.completionEvidenceCoverage === undefined ? 100 : A.completionEvidenceCoverage)} sales with a saved completion date`;

    // Update source cards
    const sourceCards = `<article class="rr-source-card service"><div class="rr-source-title"><i class="bi bi-wrench-adjustable me-2 text-primary"></i>Services</div><div class="rr-source-value">${peso(A.serviceRevenue)}</div><div class="rr-meta">${A.serviceTransactions || 0} bookings · ${peso(A.avgServiceTicket)} average ticket</div><div class="rr-progress"><span style="width:${Math.min(100, A.serviceShare || 0)}%;background:#2563eb"></span></div><div class="rr-meta">${pct(A.serviceShare)} of combined revenue · Core ${peso(A.coreRevenue)} · Repair ${peso(A.repairRevenue)}</div></article><article class="rr-source-card orders"><div class="rr-source-title"><i class="bi bi-bag-check me-2 text-success"></i>Product Orders</div><div class="rr-source-value">${peso(A.orderRevenue)}</div><div class="rr-meta">${A.onlineOrderTransactions || 0} online · ${A.walkInOrderTransactions || 0} walk-in orders</div><div class="rr-progress"><span style="width:${Math.min(100, A.orderShare || 0)}%;background:#10b981"></span></div><div class="rr-meta">${pct(A.orderShare)} of combined revenue · Online ${peso(A.onlineOrderRevenue)} · Walk-in ${peso(A.walkInOrderRevenue)}</div></article><article class="rr-source-card pos"><div class="rr-source-title"><i class="bi bi-shop me-2 text-warning"></i>Walk-in sales</div><div class="rr-source-value">${peso(A.posRevenue)}</div><div class="rr-meta">${A.posTransactions || 0} completed sales · ${peso(A.avgPosSale)} average sale</div><div class="rr-progress"><span style="width:${Math.min(100, A.posShare || 0)}%;background:#f59e0b"></span></div><div class="rr-meta">${pct(A.posShare)} of combined revenue · COGS ${peso(A.posCost)} · Profit ${peso(A.posProfit)} (${pct(A.posMargin)})</div></article>`;
    document.querySelector('.rr-source').innerHTML = sourceCards;

    const collectionBody = document.getElementById('collectionHealthBody');
    if (collectionBody) collectionBody.innerHTML = `<div class="rr-collection-grid"><div style="text-align:center;padding:12px;background:#f0fdf4;border-radius:8px"><div class="rr-label" style="color:#059669">Payments received</div><div class="rr-value" style="color:#059669">${peso(A.grossCollections)}</div></div><div style="text-align:center;padding:12px;background:#fef2f2;border-radius:8px"><div class="rr-label" style="color:#b91c1c">Refunds</div><div class="rr-value" style="color:#dc2626">${peso(A.refunds)}</div></div><div style="text-align:center;padding:12px;background:#fefce8;border-radius:8px"><div class="rr-label" style="color:#92400e">Outstanding</div><div class="rr-value" style="color:#d97706">${peso(A.outstandingValue)}</div></div><div style="text-align:center;padding:12px;background:#eff6ff;border-radius:8px"><div class="rr-label" style="color:#1d4ed8">Payments after refunds</div><div class="rr-value" style="color:#2563eb">${peso(A.netCollections)}</div></div></div><div style="font-size:.78rem;color:#475569;line-height:1.6"><div><strong>Share paid:</strong> ${pct(A.collectionRate)} of the approved work has been paid after refunds, up to the last report date.</div><div><strong>GCash:</strong> ${peso(A.gcashRevenue)} · <strong>Cash/COD:</strong> ${peso(A.codRevenue)} · <strong>Bank:</strong> ${peso(A.bankRevenue)}</div><div><strong>Unpaid balance:</strong> ${peso(A.outstandingValue)}</div></div>`;

    const technicianBody = document.getElementById('topTechniciansBody');
    if (technicianBody) technicianBody.innerHTML = (A.topTechnicians || []).length
      ? A.topTechnicians.map(t => `<tr><td class="fw-bold">${esc(t.name)}</td><td class="text-center">${Number(t.bookings||0)}</td><td class="text-end">${peso(t.revenue)}</td><td class="text-end">${peso(t.partsCost)}</td><td class="text-end fw-bold ${Number(t.profit||0)>=0?'text-success':'text-danger'}">${peso(t.profit)}</td></tr>`).join('')
      : '<tr><td colspan="5" class="rr-empty">No technician value in this period.</td></tr>';

    const transactionBody = document.getElementById('recentTransactionsBody');
    if (transactionBody) transactionBody.innerHTML = (A.recentTransactions || []).length
      ? A.recentTransactions.map(t => { const type=String(t.type||'service'); const status=String(t.status||'pending'); return `<tr><td>${new Date(t.date).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'})}</td><td><span class="rr-type ${type==='order'?'order':type==='pos'?'pos':''}">${esc(type)}</span></td><td class="fw-bold">${esc(t.reference||'—')}</td><td>${esc(t.customer||'Unknown')}</td><td>${esc(String(t.method||'—').replaceAll('_',' '))}</td><td><span class="rr-status ${esc(status)}">${esc(status.replaceAll('_',' '))}</span></td><td class="text-end fw-bold">${peso(t.amount)}</td></tr>`; }).join('')
      : '<tr><td colspan="7" class="rr-empty">No bookings or sales to show.</td></tr>';

    // Update cost breakdown summary
    const costGrid = document.getElementById('costBreakdownGrid');
    if (costGrid) {
      costGrid.innerHTML = `
        <div class="rr-cost-metric" style="border-top:3px solid #2563eb;"><div class="rr-label">Completed sales after refunds</div><div class="rr-value">${peso(A.recognizedRevenue)}</div></div>
        <div class="rr-cost-metric" style="border-top:3px solid #ef4444;"><div class="rr-label">Saved service costs</div><div class="rr-value">${peso(A.serviceDirectCost)}</div></div>
        <div class="rr-cost-metric" style="border-top:3px solid #f59e0b;"><div class="rr-label">Saved order costs</div><div class="rr-value">${peso(A.orderCost)}</div><div class="rr-meta">Products ${peso(A.orderProductCost)} · consumables ${peso(A.orderConsumablesCost)} · other installation ${peso(A.orderLinkedServiceCost)}</div></div>
        <div class="rr-cost-metric" style="border-top:3px solid #c2410c;"><div class="rr-label">Walk-in product costs</div><div class="rr-value">${peso(A.posCost)}</div></div>
        <div class="rr-cost-metric" style="border-top:3px solid #7c3aed;"><div class="rr-label">Project Materials</div><div class="rr-value">${peso(A.projectMaterialCost)}</div></div>
        <div class="rr-cost-metric" style="border-top:3px solid #64748b;"><div class="rr-label">Approved expenses</div><div class="rr-value">${peso(A.operatingExpenses)}</div><div class="rr-meta">Approved expenses + payroll</div></div>
        <div class="rr-cost-metric" style="border-top:3px solid #10b981;"><div class="rr-label">Profit before expenses</div><div class="rr-value" style="color:${(A.grossProfit||0)>=0?'#059669':'#dc2626'};">${peso(A.grossProfit)}</div></div>
        <div class="rr-cost-metric" style="border-top:3px solid #0891b2;"><div class="rr-label">Profit after expenses</div><div class="rr-value" style="color:${(A.operatingProfit||0)>=0?'#059669':'#dc2626'};">${peso(A.operatingProfit)}</div></div>
        <div class="rr-cost-metric" style="border-top:3px solid #0f766e;"><div class="rr-label">Profit after expenses (%)</div><div class="rr-value">${pct(A.operatingProfitMargin)}</div></div>`;
    }

    // Update service profitability deep dive
    const profitBody = document.getElementById('serviceProfitabilityBody');
    const completedServiceCosts = A.completedServiceCosts || [];
    if (profitBody) {
      profitBody.innerHTML = completedServiceCosts.length
        ? completedServiceCosts.slice(0, 5).map(s => `<tr><td><details class="rr-service-detail"><summary><strong>${esc(s.serviceName)}</strong> <i class="bi bi-chevron-down ms-1"></i><div class="rr-meta">${esc(s.reference)} · ${esc(s.customer)}</div></summary><div class="rr-resource-list"><div>Technician: ${esc(s.technician)} · Duration: ${Number(s.laborHours||0).toFixed(1)}h</div><div>Consumables: ${s.consumables && s.consumables.length ? s.consumables.map(i=>`${esc(i.name)} (${i.quantity} ${esc(i.unit)})`).join(', ') : 'None'}</div><div>Repair parts: ${s.repairParts && s.repairParts.length ? s.repairParts.map(i=>`${esc(i.name)} (${i.quantity} ${esc(i.unit)})`).join(', ') : 'None'}</div></div></details></td><td class="text-end">${peso(s.revenue)}</td><td class="text-end">${peso(s.partsCost)}</td><td class="text-end">${peso(s.consumablesCost)}</td><td class="text-end">${peso(s.laborCost)}</td><td class="text-end fw-bold ${Number(s.grossProfit||0)>=0?'text-success':'text-danger'}">${peso(s.grossProfit)}<div class="rr-meta">${pct(s.grossProfitMargin)}</div></td></tr>`).join('')
        : '<tr><td colspan="6" class="rr-empty">No completed services in this reporting period.</td></tr>';
    }
    const profitBadge = document.getElementById('serviceProfitabilityBadge');
    if (profitBadge) profitBadge.textContent = `Latest 5 of ${completedServiceCosts.length}`;
    const viewAllBtn = document.getElementById('serviceProfitabilityViewAllBtn');
    if (viewAllBtn) viewAllBtn.style.display = completedServiceCosts.length > 5 ? 'inline-flex' : 'none';
    const modalBody = document.getElementById('serviceProfitabilityRows');
    if (modalBody) {
      modalBody.innerHTML = completedServiceCosts.map((s, index) => `<tr class="profitability-modal-row" data-row-index="${index}"><td class="ps-4"><details class="rr-service-detail"><summary><strong>${esc(s.serviceName)}</strong> <i class="bi bi-chevron-down ms-1"></i><div class="rr-meta">${esc(s.reference)} · ${esc(s.customer)}</div></summary><div class="rr-resource-list"><div><strong>Technician:</strong> ${esc(s.technician)} · <strong>Duration:</strong> ${Number(s.laborHours||0).toFixed(1)}h</div><div><strong>Consumables:</strong> ${s.consumables && s.consumables.length ? s.consumables.map(i=>`${esc(i.name)} — ${i.quantity} ${esc(i.unit)} / ${peso(i.cost)}`).join(', ') : 'None recorded'}</div><div><strong>Repair parts:</strong> ${s.repairParts && s.repairParts.length ? s.repairParts.map(i=>`${esc(i.name)} — ${i.quantity} ${esc(i.unit)} / ${peso(i.cost)}`).join(', ') : 'None recorded'}</div></div></details></td><td class="text-end">${peso(s.revenue)}</td><td class="text-end">${peso(s.partsCost)}</td><td class="text-end">${peso(s.consumablesCost)}</td><td class="text-end">${peso(s.laborCost)}</td><td class="text-end pe-4 fw-bold ${Number(s.grossProfit||0)>=0?'text-success':'text-danger'}">${peso(s.grossProfit)}<div class="rr-meta">${pct(s.grossProfitMargin)}</div></td></tr>`).join('');
      if (window.refreshProfitabilityPagination) window.refreshProfitabilityPagination();
    }

    renderPosCategorySection(A);

    renderForecastSummary(A);
    renderServicePortfolio(A);

    // Update product intelligence section
    updateProductSection(A);

    // Update charts
    updateCharts(A);
    renderSparklines(A);

    // Update technician list if provided
    if (technicians) {
      const techSelect = document.getElementById('filterTechnician');
      const currentVal = techSelect.value;
      techSelect.innerHTML = '<option value="all">All Technicians</option>';
      technicians.forEach(t => {
        const opt = document.createElement('option');
        opt.value = t.id; opt.textContent = t.name;
        techSelect.appendChild(opt);
      });
      techSelect.value = currentVal;
    }
  }

  // ── Update product intelligence section ──
  function renderForecastSummary(A) {
    const forecast = A.salesForecast || {};
    const growth = forecast.projectedGrowthPercent;
    const kpis = document.getElementById('forecastKpis');
    if (kpis) kpis.innerHTML = `
      <article class="rr-card"><small>Projected booking value</small><strong>${peso(forecast.total)}</strong><p>Next ${forecast.horizonDays||30} days</p></article>
      <article class="rr-card"><small>Expected range</small><strong>${peso(forecast.lower)}–${peso(forecast.upper)}</strong><p>Estimated low and high amounts</p></article>
      <article class="rr-card"><small>Versus latest ${forecast.horizonDays||30} days</small><strong class="${Number(growth||0)>=0?'positive':'negative'}">${growth==null?'—':`${Number(growth)>=0?'+':''}${pct(growth)}`}</strong><p>${peso(forecast.comparisonTotal)} recent actual</p></article>
      <article class="rr-card"><small>Past dates used</small><strong>${Number(forecast.basisDays||0)} days</strong><p>${Number(forecast.activeDays||0)} days with sales</p></article>`;
    const confidence = document.getElementById('forecastConfidence');
    if (confidence) confidence.textContent = forecast.confidence ? `${forecast.confidence} confidence` : 'Insufficient history';
    const method = document.getElementById('forecastMethod');
    if (method) method.textContent = forecast.method || 'Forecast becomes available after revenue data loads.';
    const caveat = document.getElementById('forecastCaveat');
    if (caveat) caveat.innerHTML = `<i class="bi bi-info-circle"></i><span>${esc(forecast.caveat || 'This forecast is a planning aid and does not replace recognized-revenue reporting.')}</span>`;
  }

  function renderServicePortfolio(A) {
    const portfolio = A.serviceProfitability || {};
    const rows = portfolio.rows || [];
    const leader = portfolio.mostProfitable;
    const laggard = portfolio.leastProfitable;
    const highest = portfolio.highestMargin;
    const kpis = document.getElementById('servicePortfolioKpis');
    if (kpis) kpis.innerHTML = `
      <article class="rr-card"><span class="rr-profit-kpi-icon leader"><i class="bi bi-trophy"></i></span><div><small>Highest known profit</small><strong>${esc(leader?.serviceName||'No completed data')}</strong><p>${leader?`${peso(leader.grossProfit)} · ${pct(leader.grossProfitMargin)} profit`:'—'}</p></div></article>
      <article class="rr-card"><span class="rr-profit-kpi-icon review"><i class="bi bi-graph-down-arrow"></i></span><div><small>Lowest recorded profit</small><strong>${esc(laggard?.serviceName||'No completed data')}</strong><p>${laggard?`${peso(laggard.grossProfit)} · ${pct(laggard.grossProfitMargin)} profit`:'—'}</p></div></article>
      <article class="rr-card"><span class="rr-profit-kpi-icon margin"><i class="bi bi-percent"></i></span><div><small>Highest recorded profit %</small><strong>${esc(highest?.serviceName||'No completed data')}</strong><p>${highest?`${pct(highest.grossProfitMargin)} · ${highest.jobs} jobs`:'—'}</p></div></article>
      <article class="rr-card"><span class="rr-profit-kpi-icon risk"><i class="bi bi-exclamation-triangle"></i></span><div><small>Services requiring action</small><strong>${Number(portfolio.atRiskCount||0)}</strong><p>Recorded profit below zero or below 15% of sales</p></div></article>`;
    const badge = document.getElementById('servicePortfolioBadge');
    if (badge) badge.textContent = `${rows.length} service lines`;
    const body = document.getElementById('servicePortfolioBody');
    if (body) body.innerHTML = rows.length ? rows.map((row, index) => `<tr>
      <td><span class="rr-rank ${index<3?'top':''}">${row.rank}</span></td>
      <td><strong>${esc(row.serviceName)}</strong><div class="rr-meta">${esc(row.serviceCategory)} · ${pct(row.costEvidenceCoverage)} saved cost details</div></td>
      <td class="text-center">${Number(row.jobs||0)} / ${Number(row.units||0)}</td>
      <td class="text-end">${peso(row.revenue)}</td><td class="text-end">${peso(row.directCost)}</td>
      <td class="text-end fw-bold ${Number(row.grossProfit||0)>=0?'text-success':'text-danger'}">${peso(row.grossProfit)}<div class="rr-meta">${pct(row.grossProfitMargin)} profit</div></td>
      <td><span class="rr-action ${esc(row.action?.tone||'info')}">${esc(row.action?.label||'Monitor')}</span><div class="rr-meta rr-action-detail">${esc(row.action?.detail||'')}</div></td>
      <td><button type="button" class="btn btn-sm btn-outline-primary service-drilldown-btn" data-service-index="${index}">Details</button></td></tr>`).join('') : '<tr><td colspan="8" class="rr-empty">No finished jobs with profit details during these dates.</td></tr>';
    const insights = document.getElementById('serviceDecisionInsights');
    if (insights) insights.innerHTML = (portfolio.insights || []).length ? portfolio.insights.map(insight => {
      const tone = ['success','warning','danger'].includes(insight.tone) ? insight.tone : 'info';
      const icon = tone === 'danger' ? 'bi-exclamation-octagon' : tone === 'success' ? 'bi-arrow-up-right-circle' : 'bi-info-circle';
      return `<article class="${tone}"><i class="bi ${icon}"></i><div><strong>${esc(insight.title)}</strong><p>${esc(insight.text)}</p><span>Recommended: ${esc(insight.action)}</span></div></article>`;
    }).join('') : '<div class="rr-empty">Insights appear when completed service cost data is available.</div>';
  }

  function updateProductSection(A) {
    // Update product KPIs (enterprise style)
    const totalProdRev = A.totalProductRevenue || 1;
    const productKpiGrid = document.getElementById('productKpiGrid');
    if (productKpiGrid) {
      productKpiGrid.innerHTML = `
        <div class="kpi-enterprise" data-accent="cyan" data-aos="fade-up" data-aos-delay="0">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon cyan"><i class="bi bi-box-seam"></i></div>
            <span class="kpi-enterprise-badge cyan">${Number(A.totalProductUnits||0).toLocaleString()} units</span>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">Total Units Sold</p>
            <div class="kpi-enterprise-value">${Number(A.totalProductUnits||0).toLocaleString()}</div>
            <small style="color:#64748b;">Across online orders + POS</small>
          </div>
        </div>
        <div class="kpi-enterprise" data-accent="blue" data-aos="fade-up" data-aos-delay="50">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon blue"><i class="bi bi-cash-stack"></i></div>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">Product sales</p>
            <div class="kpi-enterprise-value">${peso(A.totalProductRevenue)}</div>
            <small style="color:#64748b;">Combined order + POS product sales</small>
          </div>
        </div>
        <div class="kpi-enterprise" data-accent="green" data-aos="fade-up" data-aos-delay="100">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon green"><i class="bi bi-bag-check"></i></div>
            <span class="kpi-enterprise-badge green">${A.orderTransactions||0} orders</span>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">Online Order Units</p>
            <div class="kpi-enterprise-value">${Number(A.onlineOrderProductUnits||0).toLocaleString('en-PH')}</div>
            <small style="color:#64748b;">${peso(A.onlineOrderProductRevenue)} merchandise revenue</small>
          </div>
        </div>`;
    }

    const onlineProductSummary = document.getElementById('onlineProductSummary');
    if (onlineProductSummary) onlineProductSummary.textContent = `${Number(A.onlineOrderProductUnits||0).toLocaleString('en-PH')} units · ${peso(A.onlineOrderProductRevenue)} merchandise`;

    // Update combined products table
    document.querySelectorAll('.rr-equal .rr-table tbody').forEach(tbody => {
      const headers = tbody.closest('table')?.querySelector('thead');
      if (headers && headers.textContent.includes('Channel')) {
        tbody.innerHTML = (A.combinedTopProducts||[]).slice(0,10).map((p,i) => `
          <tr>
            <td><span class="rr-badge" style="background:${i<3?'rgba(8,145,178,0.1);color:#0891b2':'#f1f5f9;color:#475569'};">${i+1}</span></td>
            <td class="fw-bold">${esc(p.name)}<div class="rr-meta">${esc(p.category)}</div></td>
            <td><span class="rr-badge" style="background:${p.channel==='POS'?'rgba(245,158,11,0.1);color:#d97706':'rgba(16,185,129,0.1);color:#059669'};">${esc(p.channel)}</span></td>
            <td class="text-center">${p.quantity}</td>
            <td class="text-end fw-bold">${peso(p.revenue)}</td>
            <td class="text-end">${peso(p.cost)}${p.costComplete === false ? '<div class="rr-meta text-warning">Some bought prices are missing</div>' : ''}</td>
            <td class="text-end">${p.costComplete === false ? 'Incomplete costs' : peso(p.profit)}</td>
            <td class="text-end">${pct(p.revenue/totalProdRev*100)}</td>
          </tr>`).join('') || '<tr><td colspan="8" class="rr-empty">No product sales in this period.</td></tr>';
      }
    });

    // Update order products table
    document.querySelectorAll('.rr-equal .rr-table tbody').forEach(tbody => {
