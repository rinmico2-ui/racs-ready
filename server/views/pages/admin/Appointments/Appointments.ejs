  <ul class="nav nav-tabs tabs" id="apptsTabs" role="tablist">
    <li class="nav-item">
      <button class="nav-link active" data-status="scheduled">Scheduled</button>
    </li>
    <li class="nav-item">
      <button class="nav-link" data-status="on-the-way">On the way</button>
    </li>
    <li class="nav-item">
      <button class="nav-link" data-status="completed">Completed</button>
    </li>
    <li class="nav-item">
      <button class="nav-link" data-tab="tab-requests">Booking Requests</button>
    </li>
    <li class="nav-item">
      <button class="nav-link" data-tab="tab-waiting-accept">Waiting for Acceptance <span class="nav-badge badge bg-warning text-dark" id="waitingAcceptTabBadge" style="display:none;">0</span></button>
    </li>
