      </div>
      ${sale.change > 0 ? `<div style="display:flex;justify-content:space-between;font-size:0.82rem;color:#16a34a;font-weight:700;">
        <span>Change</span><span>₱${Number(sale.change).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</span>
      </div>` : ""}
      ${sale.fulfillmentLabel ? `<div style="margin-top:12px;padding:9px 10px;border-radius:8px;background:#eff6ff;color:#1e40af;font-size:.75rem;"><strong>Fulfillment:</strong> ${escapeHtml(sale.fulfillmentLabel)} · ${escapeHtml(String(sale.orderStatus || "").replace(/_/g, " "))}</div>` : ""}
      ${sale.recordType === "order" ? '<div style="margin-top:8px;padding:9px 10px;border-radius:8px;background:#f0fdf4;color:#166534;font-size:.72rem;"><i class="bi bi-shield-check me-1"></i>Warranty and aftercare are linked to this customer order.</div>' : ""}
      ${sale.customerAccountCreated ? '<div style="margin-top:8px;padding:9px 10px;border-radius:8px;background:#fffbeb;color:#92400e;font-size:.72rem;">A customer account was created. The customer can use Forgot Password with their email to access orders and warranty.</div>' : ""}
    </div>
    <div class="pos-receipt-footer">
      <div style="margin-bottom:16px;padding-top:4px;text-align:center;">
        <div style="font-size:0.85rem;font-weight:600;color:#0f172a;margin-bottom:2px;">_______________________</div>
        <div style="font-size:0.72rem;color:#64748b;">Authorized Signature</div>
      </div>
      <p style="font-weight:700;color:#0f172a;">Thank you for your purchase!</p>
      <p>Processed by: ${escapeHtml(sale.processedByName || "Admin")}</p>
    </div>
    <div class="pos-receipt-actions">
      <button class="pos-receipt-print" onclick="printReceipt()"><i class="bi bi-printer me-1"></i>Print Receipt</button>
      <button class="pos-receipt-close" onclick="closeReceipt()"><i class="bi bi-x-lg me-1"></i>Close</button>
    </div>`;

  document.getElementById("receiptOverlay").classList.add("show");
}

function printReceipt() { window.print(); }
function closeReceipt() { document.getElementById("receiptOverlay").classList.remove("show"); }

// ── Sales History ─────────────────────────────────────────────────────────────
async function toggleSalesHistory() {
  if (currentTab === "aircons") {
    window.location.href = "/admin/appointments/orders";
    return;
  }
  const overlay = document.getElementById("historyOverlay");
  overlay.classList.toggle("show");
  if (overlay.classList.contains("show")) loadSalesHistory();
}

async function loadSalesHistory() {
  const el = document.getElementById("historyList");
  const pagination = document.getElementById("historyPagination");
  el.innerHTML = '<p class="text-muted text-center">Loading...</p>';
  try {
    const q = document.getElementById("historySearch")?.value.trim() || "";
    const category = document.getElementById("historyCategory")?.value || "";
    const params = new URLSearchParams({ page: historyPage, limit: historyLimit });
    if (q) params.set("q", q);
    if (category) params.set("category", category);
    const res = await fetch(`/api/pos/sales?${params}`);
    const data = await res.json();
    historyTotalPages = data.pages || 1;
    historySales = data.sales || [];
    if (!data.sales?.length) { el.innerHTML = '<p class="text-muted text-center">No sales found</p>'; pagination.innerHTML = ''; return; }

    let html = `<div style="margin-bottom:16px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;">
      <div style="background:#f0fdf4;padding:12px;border-radius:10px;text-align:center;">
        <i class="bi bi-cash-stack" style="display:block;font-size:1.3rem;color:#16a34a;margin-bottom:4px;"></i>
        <div style="font-size:1.2rem;font-weight:600;color:#16a34a;">₱${Number(data.todayStats?.revenue || 0).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</div>
        <div style="font-size:0.7rem;color:#64748b;">Today's Revenue</div>
      </div>
      <div style="background:#eff6ff;padding:12px;border-radius:10px;text-align:center;">
        <i class="bi bi-receipt" style="display:block;font-size:1.3rem;color:#3b82f6;margin-bottom:4px;"></i>
        <div style="font-size:1.2rem;font-weight:600;color:#3b82f6;">${data.todayStats?.count || 0}</div>
        <div style="font-size:0.7rem;color:#64748b;">Today's Sales</div>
      </div>
      <div style="background:#fef3c7;padding:12px;border-radius:10px;text-align:center;">
        <i class="bi bi-graph-up-arrow" style="display:block;font-size:1.3rem;color:#b45309;margin-bottom:4px;"></i>
        <div style="font-size:1.2rem;font-weight:600;color:#b45309;">₱${Number(data.todayStats?.profit || 0).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</div>
        <div style="font-size:0.7rem;color:#64748b;">Today's Profit</div>
      </div>
    </div>`;

    data.sales.forEach(s => {
      const d = new Date(s.createdAt);
      const statusBadge = s.status === "completed" ? '<span style="color:#16a34a;font-weight:600;">Completed</span>' :
        s.status === "voided" ? '<span style="color:#ef4444;font-weight:600;">Voided</span>' : '<span style="color:#f59e0b;">Pending</span>';
      html += `
        <div style="padding:12px;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;">
          <div>
            <div style="font-weight:700;font-size:0.85rem;color:#0f172a;">${s.invoiceNumber}</div>
            <div style="font-size:0.72rem;color:#64748b;">${d.toLocaleDateString("en-PH")} ${d.toLocaleTimeString("en-PH", { hour: "2-digit", minute: "2-digit" })}</div>
            <div style="font-size:0.72rem;color:#64748b;">${escapeHtml(s.customerName || "Walk-In")} · ${s.items?.length || 0} item(s)</div>
          </div>
          <div style="text-align:right;">
            <div style="font-weight:700;font-size:0.95rem;color:#0f172a;">₱${Number(s.totalAmount).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</div>
            <div style="display:flex;align-items:center;gap:6px;justify-content:flex-end;margin-top:4px;">
              ${statusBadge}
              <button style="padding:4px 10px;border-radius:6px;border:none;background:#3b82f6;color:#fff;font-size:0.72rem;font-weight:600;cursor:pointer;" onclick="showHistoryReceipt('${s.invoiceNumber}')">Receipt</button>
            </div>
          </div>
        </div>`;
    });
    el.innerHTML = html;
    renderHistoryPagination(data.page, data.pages, data.total);
  } catch (e) { el.innerHTML = '<p class="text-danger text-center">Failed to load history</p>'; }
}

function renderHistoryPagination(page, pages, total) {
  const el = document.getElementById("historyPagination");
  if (pages <= 1) { el.innerHTML = ''; return; }
  const start = Math.floor((page - 1) / 10) * 10 + 1;
  const end = Math.min(start + 9, pages);
  let html = `<button class="pos-history-page" ${page === 1 ? 'disabled' : ''} onclick="changeHistoryPage(${page - 1})">Prev</button>`;
  for (let i = start; i <= end; i++) {
    html += `<button class="pos-history-page ${i === page ? 'active' : ''}" onclick="changeHistoryPage(${i})">${i}</button>`;
  }
  html += `<button class="pos-history-page" ${page >= pages ? 'disabled' : ''} onclick="changeHistoryPage(${page + 1})">Next</button>`;
  el.innerHTML = html;
}

function changeHistoryPage(p) {
  if (p < 1 || p > historyTotalPages) return;
  historyPage = p;
  loadSalesHistory();
}

function showHistoryReceipt(invoice) {
  const s = historySales.find(x => x.invoiceNumber === invoice);
  if (s) showReceipt(s);
}

// ── Utilities ─────────────────────────────────────────────────────────────────
function escapeHtml(str) { return String(str || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
function debounce(fn, ms) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }
let posToastTimer;
function createPosToastModal() {
  const overlay = document.createElement('div');
  overlay.id = 'posToastModal';
  overlay.className = 'pos-toast-overlay';
  overlay.innerHTML = `
    <div class="pos-toast-modal">
      <div class="pos-toast-header">
        <span class="pos-toast-title">Success</span>
        <button class="pos-toast-close" onclick="closePosToast()"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="pos-toast-body">
        <div class="pos-toast-icon success"><i class="bi bi-check-circle-fill"></i></div>
        <p class="pos-toast-message"></p>
        <button class="pos-toast-ok" onclick="closePosToast()">OK</button>
      </div>
    </div>
  `;
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closePosToast(); });
  document.body.appendChild(overlay);
  return overlay;
}
function showToast(msg, type = "info") {
  let overlay = document.getElementById('posToastModal');
  if (!overlay) overlay = createPosToastModal();
  const titleMap = { success: 'Success', error: 'Error', warning: 'Warning', info: 'Info' };
  const iconMap = { success: 'bi-check-circle-fill', error: 'bi-x-circle-fill', warning: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' };
  const typeClass = { success: 'success', error: 'error', warning: 'warning', info: 'info' };
  const t = titleMap[type] ? type : 'info';
  overlay.querySelector('.pos-toast-title').textContent = titleMap[t];
  overlay.querySelector('.pos-toast-icon').className = `pos-toast-icon ${typeClass[t]}`;
  overlay.querySelector('.pos-toast-icon i').className = `bi ${iconMap[t]}`;
  overlay.querySelector('.pos-toast-message').textContent = msg;
  overlay.classList.add('show');
  if (posToastTimer) clearTimeout(posToastTimer);
  posToastTimer = setTimeout(() => closePosToast(), 2500);
}
function closePosToast() {
  const overlay = document.getElementById('posToastModal');
  if (overlay) overlay.classList.remove('show');
  if (posToastTimer) clearTimeout(posToastTimer);
}
</script>
