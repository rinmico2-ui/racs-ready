    row.innerHTML = `
      <div style="flex:1;">
        <input type="text" class="form-control form-control-sm pw-part-name" value="" placeholder="Part name" style="font-size:.82rem;">
        <input type="hidden" class="pw-part-toolid" value="">
        <input type="hidden" class="pw-part-cost" value="0">
      </div>
      <div style="width:70px;">
        <input type="number" class="form-control form-control-sm pw-part-qty" min="1" value="1" placeholder="Qty">
