<div class="admin-dashboard container-fluid py-4 appointments-calendar">
  <%- include('../../../partials/dashboard-styles') %>
  <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.css" rel="stylesheet" />

  <style>
    .appointments-calendar {
      font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      line-height: 1.45;
      background: #f3f4f6;
      min-height: 100vh;
      --cal-radius: 14px;
      --cal-border: rgba(0,0,0,0.06);
      --cal-muted: #6b7280;
      --cal-title: #0f172a;
      --cal-bg: #f8fafc;
      --blue-50: #eff6ff;
      --blue-100: #dbeafe;
      --blue-600: #2563eb;
      --blue-700: #1d4ed8;
      --slate-50: #f8fafc;
      --slate-100: #f1f5f9;
      --slate-200: #e2e8f0;
      --slate-300: #cbd5e1;
      --slate-400: #94a3b8;
      --slate-500: #64748b;
      --slate-600: #475569;
      --slate-700: #334155;
      --slate-800: #1e293b;
      --slate-900: #0f172a;
    }

    /* ── Hero Header ───────────────────────────────────────────── */
    .cal-hero {
      position: relative; padding: 28px 36px; border-radius: 20px; overflow: hidden;
      background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 40%, #2563eb 100%);
      box-shadow: 0 4px 24px rgba(37,99,235,0.2);
    }
    .cal-hero-bg {
      position: absolute; top: 0; right: 0; width: 100%; height: 100%; opacity: 0.06;
      background:
        radial-gradient(ellipse at 20% 50%, rgba(255,255,255,0.15) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 20%, rgba(59,130,246,0.15) 0%, transparent 50%);
      pointer-events: none;
    }
    .cal-hero-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; position: relative; z-index: 1; }
    .cal-hero-left { display: flex; align-items: center; gap: 18px; }
    .cal-hero-icon {
      width: 56px; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
      background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.15);
      backdrop-filter: blur(10px); font-size: 1.5rem; color: #fff; flex-shrink: 0;
    }
    .cal-hero-title { font-family: 'Outfit', sans-serif; font-size: 1.6rem; font-weight: 700; color: #fff; margin: 0; line-height: 1.2; letter-spacing: -0.02em; }
    .cal-hero-sub { font-size: 0.88rem; color: rgba(255,255,255,0.85); margin: 6px 0 0 0; line-height: 1.4; }
    .cal-hero-range {
      font-size: 0.8rem; font-weight: 600; color: rgba(255,255,255,0.7); padding: 5px 12px;
      background: rgba(255,255,255,0.08); border-radius: 8px; white-space: nowrap; backdrop-filter: blur(4px);
    }
    @media (max-width: 767px) {
      .cal-hero { padding: 22px 20px; }
      .cal-hero-icon { width: 48px; height: 48px; font-size: 1.3rem; }
      .cal-hero-title { font-size: 1.2rem; }
      .cal-hero-sub { font-size: 0.8rem; }
    }

    .appointments-calendar .fc-event.pending          { background: rgba(245,158,11,0.12) !important; color:#92400e !important; border-left: 3px solid #f59e0b !important; }
    .appointments-calendar .fc-event.payment_verified  { background: rgba(37,99,235,0.12) !important; color:#1e40af !important; border-left: 3px solid #2563eb !important; }
    .appointments-calendar .fc-event.awaiting_assignment,
    .appointments-calendar .fc-event.assigned,
    .appointments-calendar .fc-event.pending_reassignment { background: rgba(139,92,246,0.12) !important; color:#5b21b6 !important; border-left: 3px solid #8b5cf6 !important; }
    .appointments-calendar .fc-event.confirmed         { background: rgba(14,165,233,0.12) !important; color:#0e7490 !important; border-left: 3px solid #0ea5e9 !important; }
    .appointments-calendar .fc-event.scheduled         { background: rgba(99,102,241,0.12) !important; color:#4338ca !important; border-left: 3px solid #6366f1 !important; }
    .appointments-calendar .fc-event.on-the-way        { background: rgba(59,130,246,0.12) !important; color:#1e40af !important; border-left: 3px solid #3b82f6 !important; }
    .appointments-calendar .fc-event.arrived           { background: rgba(20,184,166,0.12) !important; color:#115e59 !important; border-left: 3px solid #14b8a6 !important; }
    .appointments-calendar .fc-event.in-progress       { background: rgba(34,197,94,0.12) !important; color:#166534 !important; border-left: 3px solid #22c55e !important; }
    .appointments-calendar .fc-event.completed         { background: rgba(22,163,74,0.12) !important; color:#14532d !important; border-left: 3px solid #16a34a !important; }
    .appointments-calendar .fc-event.repair_approved  { background: rgba(5,150,105,0.12) !important; color:#064e3b !important; border-left: 3px solid #059669 !important; }
    .appointments-calendar .fc-event.rejected          { background: rgba(220,38,38,0.12) !important; color:#991b1b !important; border-left: 3px solid #dc2626 !important; }
    .appointments-calendar .fc-event.cancelled         { background: rgba(107,114,128,0.12) !important; color:#4b5563 !important; border-left: 3px solid #6b7280 !important; }
    .appointments-calendar .fc-event.expired           { background: rgba(217,119,6,0.12) !important; color:#92400e !important; border-left: 3px solid #d97706 !important; }
    /* ── Order / Delivery Events ──────────────────────── */
    .appointments-calendar .fc-event.order-pending_payment,
    .appointments-calendar .fc-event.order-preparing_unit { background: rgba(245,158,11,0.12) !important; color:#92400e !important; border-left: 3px solid #f59e0b !important; border-style: solid !important; }
    .appointments-calendar .fc-event.order-technician_assigned { background: rgba(139,92,246,0.12) !important; color:#5b21b6 !important; border-left: 3px solid #8b5cf6 !important; }
    .appointments-calendar .fc-event.order-out_for_delivery { background: rgba(249,115,22,0.12) !important; color:#9a3412 !important; border-left: 3px solid #f97316 !important; }
    .appointments-calendar .fc-event.order-arrived { background: rgba(20,184,166,0.12) !important; color:#115e59 !important; border-left: 3px solid #14b8a6 !important; }
    .appointments-calendar .fc-event.order-installing { background: rgba(236,72,153,0.12) !important; color:#9d174d !important; border-left: 3px solid #ec4899 !important; }
    .appointments-calendar .fc-event.order-completed { background: rgba(22,163,74,0.12) !important; color:#14532d !important; border-left: 3px solid #16a34a !important; }
    .appointments-calendar .fc-event.order-cancelled { background: rgba(107,114,128,0.12) !important; color:#4b5563 !important; border-left: 3px solid #6b7280 !important; }
    .appointments-calendar .fc-event.order-event { border-radius: 7px !important; }
    .appointments-calendar .fc-event.order-event .event-content-wrapper { gap: 0; }
    .appointments-calendar .fc-event.order-event .event-customer { font-weight: 600; }
    .appointments-calendar .fc-event.order-event .event-service { font-style: italic; }
    .appointments-calendar .fc-event { border: none !important; border-radius: 7px !important; }
    .appointments-calendar .fc-event:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.12) !important; }

    .appointments-calendar .calendar-spinner {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: 44px; height: 44px; border: 3.5px solid rgba(0,0,0,0.08); border-top-color: var(--blue-600);
      border-radius: 50%; animation: spin 0.8s linear infinite; display: none; z-index: 10;
    }
    @keyframes spin { to { transform: translate(-50%, -50%) rotate(360deg); } }

    .appointments-calendar .page-shell { display: grid; grid-template-columns: 1fr; gap: 20px; }
    @media (min-width: 1200px) { .appointments-calendar .page-shell { grid-template-columns: minmax(0, 1fr) 400px; } }

    .appointments-calendar .cal-card,
    .appointments-calendar .list-card {
      background: #fff; border: none; border-radius: var(--cal-radius);
      box-shadow: 0 1px 6px rgba(0,0,0,0.06), 0 0 0 1px rgba(0,0,0,0.02);
      overflow: hidden; transition: box-shadow 0.2s ease;
    }
    .appointments-calendar .cal-card:hover,
    .appointments-calendar .list-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.06), 0 0 0 1px rgba(0,0,0,0.03); }

    .appointments-calendar .cal-body { padding: 16px; background: #fff; position: relative; }
    .appointments-calendar #adminAppointmentsCalendar { min-height: 620px; background: #fff; border-radius: 12px; padding: 4px; width: 100%; }

    /* ── Filter Bar ────────────────────────────────────────────── */
    .cal-filter-bar {
      display: flex; align-items: center; flex-wrap: wrap; gap: 12px;
      padding: 14px 22px; background: #fff;
      border-bottom: 1px solid var(--slate-200);
    }
    .cal-filter-bar .filter-left { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
    .cal-filter-bar .filter-label {
      font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
      color: var(--slate-400); margin-right: 2px; white-space: nowrap;
    }
    .cal-filter-chip {
      display: inline-flex; align-items: center; gap: 5px; padding: 5px 12px 5px 9px;
      border-radius: 8px; font-size: 0.76rem; font-weight: 600; color: #475569;
      background: #fff; border: 1px solid #e2e8f0; cursor: pointer;
      box-shadow: 0 1px 2px rgba(0,0,0,0.04);
      transition: all 0.2s ease; white-space: nowrap; user-select: none;
    }
    .cal-filter-chip:hover { background: #f8fafc; border-color: #cbd5e1; transform: translateY(-1px); box-shadow: 0 3px 8px rgba(15,23,42,0.06); }
    .cal-filter-chip.active { background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; border-color: transparent; box-shadow: 0 4px 12px rgba(37,99,235,0.25); }
    .cal-filter-chip.active:hover { box-shadow: 0 6px 16px rgba(37,99,235,0.3); }
    .cal-filter-chip .chip-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .cal-filter-chip.active .chip-dot { background: rgba(255,255,255,0.95) !important; }
    .cal-filter-chip .chip-count {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 19px; height: 19px; border-radius: 6px; font-size: 0.66rem; font-weight: 700;
      background: #f1f5f9; color: #64748b; padding: 0 5px; margin-left: 1px;
    }
    .cal-filter-chip.active .chip-count { background: rgba(255,255,255,0.2); color: #fff; }
    .cal-filter-divider { width: 1px; height: 22px; background: #e2e8f0; margin: 0 2px; }
    .cal-clear-filters {
      font-family: "Inter", sans-serif; font-size: 0.75rem; font-weight: 600; color: #64748b; background: none; border: none;
      cursor: pointer; padding: 5px 8px; border-radius: 6px; transition: all 0.15s;
    }
    .cal-clear-filters:hover { background: #f1f5f9; color: #1e293b; }

    /* ── Technician Filter ────────────────────────────────────── */
    .tech-filter-wrapper { position: relative; }
    .tech-filter-trigger {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 14px 6px 11px; border-radius: 8px;
      font-size: 0.8rem; font-weight: 600; color: #475569;
      background: #fff; border: 1px solid #e2e8f0; cursor: pointer;
      transition: all 0.2s ease; white-space: nowrap; user-select: none;
      box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }
    .tech-filter-trigger:hover { background: var(--slate-50); border-color: var(--slate-300); }
    .tech-filter-trigger.active { border-color: var(--blue-600); box-shadow: 0 0 0 2px rgba(37,99,235,0.15); }
    .tech-filter-trigger .trigger-count {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 19px; height: 19px; border-radius: 5px;
      background: var(--blue-600); color: #fff; font-size: 0.63rem; font-weight: 700; padding: 0 5px;
    }
    .tech-filter-trigger .trigger-arrow { font-size: 0.6rem; color: var(--slate-400); transition: transform 0.2s; }
    .tech-filter-trigger.active .trigger-arrow { transform: rotate(180deg); }

    .tech-filter-dropdown {
      position: absolute; top: calc(100% + 4px); left: 0; min-width: 250px; max-width: 300px;
      background: #fff; border: 1px solid var(--slate-200); border-radius: 12px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.12), 0 0 0 1px rgba(0,0,0,0.04);
      z-index: 100; display: none; overflow: hidden;
    }
    .tech-filter-dropdown.open { display: block; }
    .tech-filter-dropdown .tech-search {
      padding: 10px 12px; border-bottom: 1px solid var(--slate-200);
      display: flex; align-items: center; gap: 8px;
    }
    .tech-filter-dropdown .tech-search i { color: var(--slate-400); font-size: 0.85rem; }
    .tech-filter-dropdown .tech-search input {
      flex: 1; border: none; outline: none; font-size: 0.82rem;
      color: var(--slate-700); background: transparent;
    }
    .tech-filter-dropdown .tech-search input::placeholder { color: var(--slate-400); }
    .tech-filter-dropdown .tech-select-all {
      display: flex; align-items: center; gap: 8px; padding: 8px 12px;
      border-bottom: 1px solid var(--slate-100); cursor: pointer;
      font-size: 0.78rem; font-weight: 600; color: var(--slate-600);
      transition: background 0.1s; user-select: none;
    }
    .tech-filter-dropdown .tech-select-all:hover { background: var(--slate-50); }
    .tech-filter-dropdown .tech-options { max-height: 240px; overflow-y: auto; }
    .tech-filter-dropdown .tech-option {
      display: flex; align-items: center; gap: 8px; padding: 8px 12px;
      cursor: pointer; font-size: 0.82rem; color: var(--slate-700);
      transition: background 0.1s; user-select: none;
    }
    .tech-filter-dropdown .tech-option:hover { background: var(--slate-50); }
    .tech-filter-dropdown .tech-option.selected { background: rgba(37,99,235,0.06); }
    .tech-filter-dropdown .tech-color-dot {
      width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
      border: 2px solid transparent; transition: border-color 0.15s;
    }
    .tech-filter-dropdown .tech-option.selected .tech-color-dot { border-color: currentColor; }
    .tech-filter-dropdown .tech-checkbox {
      width: 16px; height: 16px; border-radius: 4px; border: 2px solid var(--slate-300);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
      transition: all 0.15s;
    }
    .tech-filter-dropdown .tech-option.selected .tech-checkbox {
      background: var(--blue-600); border-color: var(--blue-600);
    }
    .tech-filter-dropdown .tech-checkbox i { display: none; color: #fff; font-size: 0.55rem; }
    .tech-filter-dropdown .tech-option.selected .tech-checkbox i { display: block; }
    .tech-filter-dropdown .tech-name { flex: 1; }
    .tech-filter-dropdown .tech-status-dot {
      width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
    }
    .tech-filter-dropdown .tech-status-dot.available { background: #22c55e; }
    .tech-filter-dropdown .tech-status-dot.busy { background: #f59e0b; }
    .tech-filter-dropdown .tech-status-dot.offline { background: var(--slate-300); }

    /* ── View Toggle ──────────────────────────────────────────── */
    .filter-controls { display: flex; align-items: center; gap: 10px; margin-left: auto; flex-shrink: 0; }
    .view-toggle {
      display: flex; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;
      box-shadow: 0 1px 2px rgba(0,0,0,0.04); background: #fff;
    }
    .view-toggle button {
      background: #fff; border: none; border-right: 1px solid #e2e8f0;
      color: #64748b; font-size: 0.76rem; font-weight: 600;
      padding: 6px 14px; cursor: pointer; transition: all 0.2s;
      display: flex; align-items: center; gap: 4px;
    }
    .view-toggle button:last-child { border-right: none; }
    .view-toggle button:hover { background: #f8fafc; color: #334155; }
    .view-toggle button.active { background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; font-weight: 700; border-right-color: transparent; }
    .view-toggle button.active:hover { background: linear-gradient(135deg, #1d4ed8, #1e40af); }

    /* ── Working Hours Badge ───────────────────────────────────── */
    .cal-hours-badge {
      display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px;
      border-radius: 8px; font-size: 0.72rem; font-weight: 600; margin-left: auto;
      background: linear-gradient(135deg, #ecfdf5 0%, #f0fdf4 100%);
      border: 1px solid #bbf7d0; color: #166534; white-space: nowrap;
    }
    .cal-hours-badge i { font-size: 0.85rem; }
    .cal-hours-badge.off-hours {
      background: linear-gradient(135deg, #fef3c7 0%, #fef9c3 100%);
      border-color: #fde68a; color: #92400e;
    }

    /* ── Event Content ─────────────────────────────────────────── */
    #adminAppointmentsCalendar .event-content-wrapper { display: flex; flex-direction: column; gap: 1px; padding: 0; line-height: 1.25; }
    #adminAppointmentsCalendar .event-time { font-weight: 700; margin-right: 6px; color: inherit; font-size: 0.78rem; }
    #adminAppointmentsCalendar .event-customer {
      font-weight: 600; color: var(--slate-800);
      font-size: 0.8rem; white-space: normal; line-height: 1.2; word-break: break-word;
    }
    #adminAppointmentsCalendar .event-service {
      font-weight: 400; color: var(--slate-600);
      font-size: 0.73rem; white-space: normal; line-height: 1.2; word-break: break-word;
    }
    #adminAppointmentsCalendar .event-tech {
      font-size: 0.66rem; color: var(--slate-500); display: flex; align-items: center; gap: 3px; margin-top: 1px;
    }
    #adminAppointmentsCalendar .event-tech .tech-inline-dot { width: 5px; height: 5px; border-radius: 50%; display: inline-block; }
    /* TimeGrid: clip text to event box to prevent overlap */
    #adminAppointmentsCalendar .fc-timegrid .event-customer,
    #adminAppointmentsCalendar .fc-timegrid .event-service {
      white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important;
    }
    #adminAppointmentsCalendar .fc-timegrid-event { overflow: hidden !important; }
    #adminAppointmentsCalendar .fc-timegrid-event .fc-event-main { overflow: hidden !important; }
    /* List view: dark text on light/white rows */
    #adminAppointmentsCalendar .fc-list .event-time,
    #adminAppointmentsCalendar .fc-list .event-customer,
    #adminAppointmentsCalendar .fc-list .event-service,
    #adminAppointmentsCalendar .fc-list .event-tech { color: #0f172a !important; text-shadow: none !important; }
    #adminAppointmentsCalendar .fc-daygrid-event-harness { height: auto !important; }
    #adminAppointmentsCalendar .fc-daygrid-event { height: auto !important; min-height: auto; }
    #adminAppointmentsCalendar .fc-event-main { padding: 4px 6px; }

    /* ═══ FullCalendar — Enterprise ═══════════════════════════════ */
    #adminAppointmentsCalendar,
    #adminAppointmentsCalendar .fc,
    #adminAppointmentsCalendar .fc * { font-family: "Inter", system-ui, sans-serif !important; }
    #adminAppointmentsCalendar .fc { font-size: 0.9rem; width: 100%; }

    #adminAppointmentsCalendar .fc-toolbar {
      display: flex !important; align-items: center !important; justify-content: space-between !important;
      flex-wrap: wrap !important; background: #fff !important; border-radius: 12px !important;
      padding: 12px 16px !important; margin-bottom: 16px !important;
      box-shadow: 0 1px 4px rgba(0,0,0,0.05), 0 0 0 1px rgba(0,0,0,0.03) !important;
    }
    #adminAppointmentsCalendar .fc-toolbar-title { display: none !important; }

    #adminAppointmentsCalendar .fc-prev-button,
    #adminAppointmentsCalendar .fc-next-button {
      background-color: #fff !important; border: 1px solid var(--slate-200) !important;
      color: var(--slate-600) !important; border-radius: 8px !important;
      width: 34px !important; height: 34px !important; padding: 0 !important;
      display: inline-flex !important; align-items: center !important; justify-content: center !important;
      font-size: 0.85rem !important; margin-right: 4px !important;
      box-shadow: 0 1px 2px rgba(0,0,0,0.04) !important; transition: all 0.15s ease !important;
    }
    #adminAppointmentsCalendar .fc-prev-button:hover,
    #adminAppointmentsCalendar .fc-next-button:hover {
      background-color: var(--slate-100) !important; border-color: var(--slate-300) !important; color: var(--slate-800) !important;
    }

    #adminAppointmentsCalendar .fc-today-button {
      background-color: #fff !important; border: 1px solid var(--slate-200) !important;
      color: var(--slate-600) !important; border-radius: 8px !important; font-size: 0.78rem !important;
      font-weight: 600 !important; padding: 6px 14px !important; margin: 0 !important;
      box-shadow: 0 1px 2px rgba(0,0,0,0.04) !important; transition: all 0.15s ease !important;
    }
    #adminAppointmentsCalendar .fc-today-button:hover {
      background-color: var(--slate-100) !important; border-color: var(--slate-300) !important; color: var(--slate-800) !important;
    }
    #adminAppointmentsCalendar .fc-today-button:disabled { opacity: 0.5 !important; cursor: not-allowed !important; }

    #adminAppointmentsCalendar .fc-button-group { border: 1px solid var(--slate-200) !important; border-radius: 8px !important; overflow: hidden !important; box-shadow: 0 1px 2px rgba(0,0,0,0.04) !important; }
    #adminAppointmentsCalendar .fc-button-group .fc-button {
      background-color: #fff !important; border: none !important; border-right: 1px solid var(--slate-200) !important;
      color: var(--slate-500) !important; border-radius: 0 !important; font-size: 0.76rem !important;
      font-weight: 600 !important; padding: 6px 16px !important; margin: 0 !important;
      box-shadow: none !important; outline: none !important; transition: all 0.15s ease !important;
    }
    #adminAppointmentsCalendar .fc-button-group .fc-button:last-child { border-right: none !important; }
    #adminAppointmentsCalendar .fc-button-group .fc-button:hover { background-color: var(--slate-100) !important; color: var(--slate-700) !important; }
    #adminAppointmentsCalendar .fc-button-group .fc-button-active { background-color: var(--blue-600) !important; color: #fff !important; font-weight: 700 !important; }
    #adminAppointmentsCalendar .fc-button-group .fc-button-active:hover { background-color: var(--blue-700) !important; color: #fff !important; }

    #adminAppointmentsCalendar .fc-col-header-cell {
      background: linear-gradient(180deg, var(--slate-50) 0%, var(--slate-100) 100%) !important;
      font-weight: 700 !important; font-size: 0.76rem !important; color: var(--slate-600) !important;
      padding: 11px 0 !important; border-bottom: 2px solid var(--slate-200) !important;
      text-transform: uppercase; letter-spacing: 0.06em;
    }
    #adminAppointmentsCalendar .fc-col-header-cell a,
