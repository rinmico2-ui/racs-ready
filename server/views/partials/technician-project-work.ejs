          <div style="min-width:0;"><div style="font-size:.68rem;font-weight:750;color:var(--pw-ink);">${esc(unit.label || unit.unitKey)}</div><div style="font-size:.59rem;color:var(--pw-muted);">${esc([unit.brand, unit.model, unit.location].filter(Boolean).join(' · ') || 'Tracked project unit')} · ${esc((unit.status || 'pending').replace('_',' '))}</div></div>
          ${executionOpen && !done ? `<div style="display:flex;gap:.3rem;flex-shrink:0;">${!active ? `<button class="pw-btn" style="padding:.3rem .5rem;font-size:.61rem;" onclick="pwUpdateUnit('${wo._id}','${key}','in_progress')">Start Unit</button>` : ''}<button class="pw-btn success" style="padding:.3rem .5rem;font-size:.61rem;" onclick="pwUpdateUnit('${wo._id}','${key}','completed')">Mark Complete</button></div>` : done ? '<i class="bi bi-check-circle-fill" style="color:var(--pw-ok);"></i>' : ''}
        </div>`;
