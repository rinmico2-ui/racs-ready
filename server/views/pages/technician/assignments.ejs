           style="--card-accent:${accentColor};" onclick="showDetail('${a._id}')">
        <div class="assign-card-inner">
          <div class="assign-card-header">
            <div style="flex:1;min-width:0;">
              <div class="d-flex align-items-center gap-2 flex-wrap" style="margin-bottom:4px;">
                <span class="priority-dot priority-${a.priority || 'normal'}"></span>
                <h6 class="assign-card-title">${a.customerName || 'Customer'}</h6>
                ${labelChips}
              </div>
              <div class="d-flex align-items-center gap-2">
                <p class="assign-card-subtitle" style="margin:0;">${a.serviceName || 'Service'}</p>
                ${serviceBadge}
              </div>
            </div>
            <span class="badge ${a.isRepairBooking ? (statusColors[a.bookingStatus] || 'bg-secondary') : (statusColors[a.status] || 'bg-secondary')}">${a.isRepairBooking ? (statusLabels[a.bookingStatus] || a.bookingStatus) : (statusLabels[a.status] || a.status)}</span>
          </div>
          <div class="assign-card-meta">
            ${a.isRepairBooking && a.unitInfo ? `<div class="assign-card-detail"><i class="bi bi-cpu"></i> <strong>${a.unitInfo.brand || ''} ${a.unitInfo.unitType || ''}</strong></div>` : ''}
            ${a.isRepairBooking && a.quotation?.totalCost ? `<div class="assign-card-detail"><i class="bi bi-cash"></i> <strong>₱${Number(a.quotation.totalCost).toLocaleString()}</strong></div>` : ''}
            ${!a.isRepairBooking ? `<div class="assign-card-detail"><i class="bi bi-calendar-event"></i> <strong>${date || 'TBD'}</strong></div>` : ''}
            ${!a.isRepairBooking ? `<div class="assign-card-detail"><i class="bi bi-clock"></i> ${a.startTime || 'N/A'}</div>` : ''}
            ${a.address ? `<div class="assign-card-detail"><i class="bi bi-geo-alt"></i> <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${a.address.substring(0, 40)}${a.address.length > 40 ? '...' : ''}</span></div>` : ''}
            ${(() => {
          // Compute correct revenue: repairs = inspectionFee + quotation, core = totalPrice
          const _isRepair = a.serviceType === 'repair' || (a.services && Array.isArray(a.services) && a.services.some(s => s.type === 'repair'));
          let _revenue = 0;
          if (a.computedRevenue) {
            _revenue = a.computedRevenue;
          } else if (_isRepair) {
            const inspFee = a.bookingInspectionFeeCollected || a.bookingInitialCost || a.initialCost || 0;
            const quotTotal = a.bookingQuotationTotal || 0;
            _revenue = inspFee + quotTotal;
          } else {
            _revenue = a.bookingTotalPrice || a.totalPrice || a.estimatedFee || 0;
          }
          return _revenue > 0 ? `<div class="assign-card-detail"><i class="bi bi-cash"></i> <strong>₱${Number(_revenue).toLocaleString()}</strong></div>` : '';
        })()}
            ${['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && !a.balanceCollected && (a.balanceAmount || 0) > 0 ? `<div class="assign-card-detail" style="color:#d97706;"><i class="bi bi-exclamation-triangle" style="background:#fef3c7;color:#d97706;"></i> <strong>₱${Number(a.balanceAmount).toLocaleString()} due</strong></div>` : ''}
            ${['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && a.balanceCollected ? '<div class="assign-card-detail" style="color:#16a34a;"><i class="bi bi-check-circle-fill" style="background:#dcfce7;color:#16a34a;"></i> Fully Paid</div>' : ''}
          </div>
          ${a.cancellationReason && a.status === 'cancelled' ? `<div class="mt-3 p-2" style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;font-size:0.78rem;color:#991b1b;"><i class="bi bi-exclamation-circle me-1"></i>${a.cancellationReason}</div>` : ''}
          <div class="assign-card-actions">
            ${(() => {
          // ── Repair Booking Actions (unified enterprise workflow) ──
          if (a.isRepairBooking || isRepair) {
            const ta = a.techAction;
            const bs = a.bookingId?.status || a.bookingStatus;
            const bookingId = a.bookingId?._id || a.bookingId;
            // Determine techAction from booking status for regular assignments
            let effectiveAction = ta;
            if (!effectiveAction && bs) {
              if (['repair_scheduled', 'ready_for_repair', 'parts_reserved'].includes(bs)) effectiveAction = 'ready';
              else if (bs === 'waiting_parts') effectiveAction = 'waiting_parts';
              else if (['awaiting_approval', 'repair_approved'].includes(bs)) effectiveAction = 'waiting_schedule';
              else if (['repair_in_progress'].includes(bs)) effectiveAction = 'in_progress';
              else if (['on-the-way', 'arrived'].includes(bs) && !['en_route', 'on_site'].includes(a.status)) effectiveAction = 'in_progress';
            }
            if (effectiveAction === 'ready') {
              return `<button class="btn btn-sm btn-primary" onclick="event.stopPropagation();repairEnRoute('${bookingId}')"><i class="bi bi-geo-alt me-1"></i>En Route</button>
                          <button class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-eye me-1"></i>Details</button>`;
            } else if (effectiveAction === 'waiting_parts') {
              return `<span class="badge" style="background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;font-size:0.72rem;padding:5px 10px;"><i class="bi bi-hourglass-split me-1"></i>Waiting for Parts</span>
                          <button class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-eye me-1"></i>Details</button>`;
            } else if (effectiveAction === 'waiting_schedule') {
              return `<span class="badge" style="background:#fffbeb;color:#92400e;border:1px solid #fde68a;font-size:0.72rem;padding:5px 10px;"><i class="bi bi-calendar-clock me-1"></i>Awaiting Schedule</span>
                          <button class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-eye me-1"></i>Details</button>`;
            } else if (effectiveAction === 'in_progress') {
              return `<button class="btn btn-sm btn-success" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-tools me-1"></i>Continue</button>`;
            }
            // Fallback: for en_route / on_site in repair workflow
            if (a.status === 'en_route') {
              return `<button class="btn btn-sm btn-primary" onclick="event.stopPropagation();repairTransition('${bookingId}','on_site')"><i class="bi bi-building me-1"></i>Arrived</button>`;
            }
            if (a.status === 'on_site') {
              const hasQuotation = !!(a.quotation?.createdAt || a.bookingId?.quotation?.createdAt) ||
                ['repair_scheduled', 'ready_for_repair', 'repair_in_progress', 'repair_completed', 'under_warranty'].includes(bs);
              if (hasQuotation) {
                return `<button class="btn btn-sm btn-primary" onclick="event.stopPropagation();repairTransition('${bookingId}','in_progress')"><i class="bi bi-gear me-1"></i>Start Work</button>`;
              } else {
                return `<button class="btn btn-sm btn-primary" onclick="event.stopPropagation();transitionStatus('${a._id}','in_progress',this)"><i class="bi bi-gear me-1"></i>Start Work</button>`;
              }
            }
            return `<button class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-eye me-1"></i>Details</button>`;
          }

          // ── Regular Assignment Actions ──
          const hideCardBtns = a.status === 'en_route' && isRepair;
          if (hideCardBtns) {
            return `<button class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-eye me-1"></i>View Details</button>`;
          }
          const needsPayment2 = ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(a.paymentMethod) && !a.balanceCollected && (a.balanceAmount || 0) > 0;
          let btns = '';
          if (a.status === 'pending_acceptance') {
            btns += `<button class="btn btn-sm btn-success" onclick="event.stopPropagation();acceptAssign('${a._id}',this);"><i class="bi bi-check-lg me-1"></i>Accept</button>`;
            btns += `<button class="btn btn-sm btn-outline-danger" onclick="event.stopPropagation();declineAssign('${a._id}',this);"><i class="bi bi-x-lg me-1"></i>Decline</button>`;
          } else if (a.status === 'accepted') {
            btns += `<button class="btn btn-sm btn-primary" onclick="event.stopPropagation();transitionStatus('${a._id}','en_route',this);"><i class="bi bi-sign-turn-right me-1"></i>En Route</button>`;
          } else if (a.status === 'on_site') {
            btns += `<button class="btn btn-sm btn-success" onclick="event.stopPropagation();transitionStatus('${a._id}','in_progress',this);"><i class="bi bi-play-fill me-1"></i>Start Work</button>`;
            btns += `<button class="btn btn-sm btn-warning text-dark" onclick="event.stopPropagation();markNoShow('${a._id}',this);"><i class="bi bi-person-x me-1"></i>No Show</button>`;
          } else if (a.status === 'in_progress' && needsPayment2) {
            btns += `<button class="btn btn-sm btn-warning" onclick="event.stopPropagation();showDetail('${a._id}');"><i class="bi bi-cash-stack me-1"></i>Collect & Complete</button>`;
          } else if (a.status === 'in_progress') {
            btns += `<button class="btn btn-sm btn-success" onclick="event.stopPropagation();showDetail('${a._id}');"><i class="bi bi-check-circle me-1"></i>Complete</button>`;
          }
          btns += `<button class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();showDetail('${a._id}')"><i class="bi bi-eye me-1"></i>Details</button>`;
          return btns;
        })()}
          </div>
        </div>
      </div>`;
    }

    function renderAvailableJob(b) {
      const date = b.bookingDate ? new Date(b.bookingDate).toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric' }) : '';
      return `
