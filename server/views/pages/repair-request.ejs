                  <div id="locationSuggest" class="list-group position-absolute w-100 d-none"
                    style="z-index:1000;border-radius:12px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,0.12);border:1px solid #e5e7eb;">
