      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  let currentFilter = '';
  let _expenseData = {};

  const TYPE_LABELS = { fuel: 'Fuel', material: 'Material', transport: 'Transport', meal: 'Meal', other: 'Other' };
  const STATUS_CLASSES = { pending: 'bg-warning text-dark', approved: 'bg-success', rejected: 'bg-danger' };

  async function loadStats() {
    try {
      const res = await fetch('/api/admin/appointments/expenses/stats');
      const data = await res.json();
      document.getElementById('statPending').textContent = data.pendingCount || 0;
      document.getElementById('statApproved').textContent = data.approvedToday || 0;
      document.getElementById('statTotalPending').textContent = '₱' + (data.totalPending || 0).toLocaleString();
      document.getElementById('statTotalApproved').textContent = '₱' + (data.totalApprovedToday || 0).toLocaleString();
    } catch (e) {}
  }

  async function loadList() {
    const search = document.getElementById('searchInput')?.value || '';
    try {
      const res = await fetch(`/api/admin/appointments/expenses/list?status=${currentFilter}&search=${encodeURIComponent(search)}&limit=50`);
      const data = await res.json();
      renderTable(data.expenses);
    } catch (e) { console.error(e); }
  }

  function filterBy(btn, status) {
    currentFilter = status;
    document.querySelectorAll('.status-tab').forEach(t => { t.classList.remove('active', 'btn-primary'); t.classList.add('btn-outline-secondary'); });
    btn.classList.add('active', 'btn-primary');
    btn.classList.remove('btn-outline-secondary');
    loadList();
  }

  function renderTable(expenses) {
    const tbody = document.getElementById('tableBody');
    _expenseData = Object.fromEntries(expenses.map(e => [e._id, e]));
    if (!expenses?.length) {
      tbody.innerHTML = `<tr><td colspan="8" class="text-center py-5 text-muted"><i class="bi bi-inbox" style="font-size:2.5rem;"></i><div class="mt-2">No expenses found</div></td></tr>`;
      return;
    }
    tbody.innerHTML = expenses.map(e => {
      const date = new Date(e.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      let serviceLink = '<span class="text-muted small">—</span>';
      if (e.bookingId && typeof e.bookingId === 'object') {
        const bk = e.bookingId;
        const ref = bk.bookingReference || bk.workOrderNumber || '';
        const cust = (bk.customer && bk.customer.name) || '';
        const firstSvc = (bk.services && bk.services[0] && bk.services[0].name) || '';
        const svc = (bk.service && bk.service.name) || (bk.serviceId && bk.serviceId.name) || firstSvc || '';
        const label = [cust, svc].filter(Boolean).join(' - ') || ref || 'Linked';
        serviceLink = `<span class="badge bg-light text-dark border" style="font-size:0.72rem;" title="${ref}"><i class="bi bi-link-45deg me-1"></i>${label}</span>`;
      }
      return `<tr>
        <td class="fw-semibold small">${e.technicianName || 'N/A'}</td>
        <td><span class="badge bg-light text-dark">${TYPE_LABELS[e.type] || e.type}</span></td>
        <td class="small">${e.description || 'N/A'}</td>
        <td>${serviceLink}</td>
        <td class="fw-bold">₱${(e.amount || 0).toLocaleString()}</td>
        <td class="small">${date}</td>
        <td><span class="badge ${STATUS_CLASSES[e.status] || ''}">${e.status}</span></td>
        <td class="text-center">
          <div class="d-flex gap-1 justify-content-center">
            <button class="btn btn-sm btn-outline-info" onclick="viewExpense('${e._id}')" title="View Details"><i class="bi bi-eye"></i></button>
            ${e.status === 'pending' ? `
              <button class="btn btn-sm btn-outline-success" onclick="approveExpense('${e._id}')" title="Approve"><i class="bi bi-check-lg"></i></button>
              <button class="btn btn-sm btn-outline-danger" onclick="rejectExpense('${e._id}')" title="Reject"><i class="bi bi-x-lg"></i></button>
            ` : ''}
          </div>
        </td>
      </tr>`;
    }).join('');
  }

  async function approveExpense(id) {
    if (!confirm('Approve this expense?')) return;
    try {
      await fetch(`/api/admin/appointments/expenses/${id}/approve`, { method: 'POST' });
      showNotification({ type: 'success', title: 'Expense Approved', message: 'The expense has been approved successfully.', duration: 3000 });
      loadList(); loadStats();
    } catch (e) { showNotification({ type: 'error', title: 'Error', message: 'Failed to approve expense.', duration: 5000 }); }
  }

  async function rejectExpense(id) {
    const reason = prompt('Rejection reason:');
    if (!reason) return;
    try {
      await fetch(`/api/admin/appointments/expenses/${id}/reject`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason }) });
      showNotification({ type: 'success', title: 'Expense Rejected', message: 'The expense has been rejected.', duration: 3000 });
      loadList(); loadStats();
    } catch (e) { showNotification({ type: 'error', title: 'Error', message: 'Failed to reject expense.', duration: 5000 }); }
  }

  function viewExpense(id) {
    const e = _expenseData[id];
    if (!e) return showToast('Expense details not found', 'error');

    document.getElementById('viewTechName').textContent = e.technicianName || 'N/A';
    document.getElementById('viewType').textContent = (TYPE_LABELS[e.type] || e.type || 'N/A');
    document.getElementById('viewAmount').textContent = '₱' + (e.amount || 0).toLocaleString();
    document.getElementById('viewStatus').innerHTML = `<span class="badge ${STATUS_CLASSES[e.status] || 'bg-secondary'}">${e.status}</span>`;
    document.getElementById('viewDescription').textContent = e.description || '—';
    document.getElementById('viewCreated').textContent = e.createdAt ? new Date(e.createdAt).toLocaleString('en-PH', { dateStyle: 'medium', timeStyle: 'short' }) : '—';
    document.getElementById('viewExpenseDate').textContent = e.expenseDate ? new Date(e.expenseDate).toLocaleDateString('en-PH') : '—';

    const linked = document.getElementById('viewLinked');
    if (e.bookingId && typeof e.bookingId === 'object') {
      const bk = e.bookingId;
      const ref = bk.bookingReference || bk.workOrderNumber;
      const cust = (bk.customer && bk.customer.name) || '—';
      const firstServiceName = (bk.services && bk.services[0] && bk.services[0].name) ? bk.services[0].name : '';
      const serviceName = (bk.service && bk.service.name) || (bk.serviceId && bk.serviceId.name) || firstServiceName || '—';
      const serviceModelRaw = (bk.serviceModel || '').replace(/([A-Z])/g, ' $1').trim();
      const serviceType = serviceModelRaw ? serviceModelRaw.replace('Service', 'Service') : 'Unknown';
      const typeBadge = serviceType.toLowerCase().includes('repair')
        ? `<span class="badge bg-danger-subtle text-danger border" style="font-size:0.72rem;"><i class="bi bi-wrench me-1"></i>${serviceType}</span>`
        : `<span class="badge bg-primary-subtle text-primary border" style="font-size:0.72rem;"><i class="bi bi-gear me-1"></i>${serviceType}</span>`;
      linked.innerHTML = `
        <div class="row g-3">
          <div class="col-md-6">
            <div class="expense-detail-label">Reference</div>
            <div class="expense-detail-value">${ref || '—'}</div>
          </div>
          <div class="col-md-6">
            <div class="expense-detail-label">Customer</div>
            <div class="expense-detail-value">${cust}</div>
          </div>
          <div class="col-md-6">
            <div class="expense-detail-label">Service Type</div>
            <div class="mt-1">${typeBadge}</div>
          </div>
          <div class="col-md-6">
            <div class="expense-detail-label">Service</div>
            <div class="expense-detail-value">${serviceName}</div>
          </div>
          <div class="col-12">
            <div class="expense-detail-label">Booking Date</div>
            <div class="expense-detail-value">${bk.bookingDate ? new Date(bk.bookingDate).toLocaleDateString('en-PH') : '—'}</div>
          </div>
        </div>`;
    } else {
      linked.innerHTML = '<span class="text-muted">—</span>';
    }

    const fuelSection = document.getElementById('viewFuelSection');
    if (e.type === 'fuel') {
      fuelSection.style.display = '';
      document.getElementById('viewFuelLiters').textContent = e.fuelLiters || '—';
      document.getElementById('viewPricePerLiter').textContent = e.pricePerLiter ? '₱' + Number(e.pricePerLiter).toLocaleString() : '—';
      document.getElementById('viewOdometer').textContent = e.odometerReading || '—';
      document.getElementById('viewGasStation').textContent = e.gasStation || '—';
    } else {
      fuelSection.style.display = 'none';
    }

    const receiptImg = document.getElementById('viewReceiptImage');
    if (e.receiptImage) {
      receiptImg.src = e.receiptImage;
      receiptImg.style.display = '';
      document.getElementById('viewReceiptEmpty').style.display = 'none';
    } else {
      receiptImg.style.display = 'none';
      document.getElementById('viewReceiptEmpty').style.display = '';
    }

    document.getElementById('viewRejectionReason').textContent = e.rejectionReason || '—';
    document.getElementById('viewApprovedAt').textContent = e.approvedAt ? new Date(e.approvedAt).toLocaleString('en-PH', { dateStyle: 'medium', timeStyle: 'short' }) : '—';

    const modalEl = document.getElementById('expenseDetailModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();
  }

  function showToast(msg, type = 'success') {
    const t = document.createElement('div');
    t.className = `toast align-items-center text-white bg-${type === 'error' ? 'danger' : 'success'} border-0`;
    t.innerHTML = `<div class="d-flex"><div class="toast-body">${msg}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>`;
    document.body.appendChild(t); new bootstrap.Toast(t).show(); setTimeout(() => t.remove(), 4000);
  }

  // Enterprise notification system
  function showNotification({ type = 'info', title = '', message = '', duration = 3000 }) {
    const colors = {
      success: { bg: '#f0fdf4', border: '#22c55e', icon: 'bi-check-circle-fill', iconColor: '#16a34a' },
      error: { bg: '#fef2f2', border: '#ef4444', icon: 'bi-x-circle-fill', iconColor: '#dc2626' },
      warning: { bg: '#fffbeb', border: '#f59e0b', icon: 'bi-exclamation-triangle-fill', iconColor: '#d97706' },
      info: { bg: '#eff6ff', border: '#3b82f6', icon: 'bi-info-circle-fill', iconColor: '#2563eb' }
    };
    const c = colors[type] || colors.info;
    const el = document.createElement('div');
    el.style.cssText = `position:fixed;top:20px;right:20px;z-index:99999;min-width:340px;max-width:420px;background:${c.bg};border:1px solid ${c.border};border-left:4px solid ${c.border};border-radius:12px;padding:16px 20px;box-shadow:0 10px 40px rgba(0,0,0,0.15);display:flex;align-items:flex-start;gap:12px;animation:slideInRight 0.3s ease;`;
    el.innerHTML = `<i class="bi ${c.icon}" style="font-size:1.3rem;color:${c.iconColor};margin-top:2px;"></i><div style="flex:1;"><div style="font-weight:700;font-size:0.9rem;color:#1e293b;margin-bottom:2px;">${title}</div><div style="font-size:0.82rem;color:#64748b;">${message}</div></div><button onclick="this.parentElement.remove()" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:1.1rem;padding:0;line-height:1;">&times;</button>`;
    document.body.appendChild(el);
    if (!document.getElementById('notif-styles')) {
      const style = document.createElement('style'); style.id = 'notif-styles';
      style.textContent = '@keyframes slideInRight{from{transform:translateX(100%);opacity:0;}to{transform:translateX(0);opacity:1;}}';
      document.head.appendChild(style);
    }
    setTimeout(() => { el.style.transition='all 0.3s ease'; el.style.opacity='0'; el.style.transform='translateX(100%)'; setTimeout(()=>el.remove(),300); }, duration);
  }

  loadStats(); loadList();
  let st; document.getElementById('searchInput')?.addEventListener('input', () => { clearTimeout(st); st = setTimeout(loadList, 400); });

  // Stat card sparklines
  (function(){
    function spark(ctx, data, color){
      if(!ctx || !window.Chart) return null;
      var h = ctx.canvas.height || ctx.canvas.offsetHeight || 40;
      var g = ctx.createLinearGradient(0,0,0,h);
      g.addColorStop(0, color);
      g.addColorStop(1, 'rgba(255,255,255,0)');
      return new Chart(ctx, {
        type: 'line',
        data: {
          labels: data.map(function(_,i){ return i+1; }),
          datasets: [{ data: data, borderColor: color, backgroundColor: g, fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2 }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          animation: { duration: 600 },
          plugins: { legend: { display: false }, tooltip: { enabled: false } },
          scales: { x: { display: false }, y: { display: false } }
        }
      });
    }
    function randomData(n){
      var arr = [8 + Math.random()*12];
      for(var i=1; i<n; i++){ arr.push(Math.max(3, Math.min(30, arr[i-1] + (Math.random()-0.5)*12))); }
      return arr;
    }
    document.querySelectorAll('.stat-sparkline canvas').forEach(function(c){
      var card = c.closest('.stat-card');
      var color = card ? (card.dataset.sparkColor || '#2563eb') : '#2563eb';
      spark(c.getContext('2d'), randomData(10), color);
    });
  })();
</script>
