<section class="wa-shell" aria-labelledby="waTitle">
  <header class="wa-hero">
    <div><h2 id="waTitle">Walk-in Aircon Order</h2><p>Select a unit, collect payment, and assign installation to an available technician in one checkout.</p><div class="wa-flow" aria-label="Aircon order steps"><span><b>1</b>Select unit</span><span><b>2</b>Customer</span><span><b>3</b>Schedule</span><span><b>4</b>Payment</span></div></div>
    <div class="wa-hero-mark"><i class="bi bi-snow2"></i></div>
  </header>
  <div class="wa-layout">
    <section class="wa-panel">
      <div class="wa-toolbar">
        <div class="wa-search"><i class="bi bi-search"></i><input id="waSearch" type="search" placeholder="Search brand, model, capacity, or barcode" autocomplete="off"></div>
        <select id="waTypeFilter" aria-label="Filter aircon type"><option value="">All aircon types</option></select>
      </div>
      <div class="wa-products" id="waProducts"><div class="wa-empty"><span class="spinner-border spinner-border-sm"></span><p>Loading aircons…</p></div></div>
    </section>

    <aside class="wa-panel wa-checkout">
      <div class="wa-checkout-head"><div><h3><i class="bi bi-cart3 me-2 text-primary"></i>Order checkout</h3><span class="wa-checkout-sub">Complete the details below, then review the total.</span></div><span class="wa-count" id="waCartCount" aria-label="Cart unit count">0</span></div>
      <div class="wa-cart" id="waCart"><div class="wa-empty" style="padding:1.5rem .5rem"><i class="bi bi-cart"></i><p class="mb-0">Select an aircon to begin.</p></div></div>
      <form class="wa-form" id="waCheckoutForm" novalidate>
        <section class="wa-section">
          <h4 class="wa-section-title"><i class="bi bi-person"></i>Customer</h4>
          <div class="wa-fields">
            <div class="wa-wide"><label class="wa-label" for="waCustomerName">Full name</label><input class="wa-field" id="waCustomerName" maxlength="160" required></div>
            <div><label class="wa-label" for="waCustomerEmail">Email</label><input class="wa-field" id="waCustomerEmail" type="email" maxlength="254" required></div>
            <div><label class="wa-label" for="waCustomerPhone">Phone</label><input class="wa-field" id="waCustomerPhone" inputmode="tel" maxlength="20" required></div>
          </div>
        </section>
        <section class="wa-section">
          <h4 class="wa-section-title"><i class="bi bi-box-seam"></i>Fulfillment</h4>
          <div class="wa-choice" id="waFulfillmentChoices">
            <button type="button" data-value="delivery_installation" class="active" aria-pressed="true"><i class="bi bi-truck d-block"></i>Deliver + install<small>Assign technician</small></button>
            <button type="button" data-value="customer_pickup" aria-pressed="false"><i class="bi bi-calendar2-check d-block"></i>Pickup later<small>Choose pickup date</small></button>
            <button type="button" data-value="carry_out" aria-pressed="false"><i class="bi bi-bag-check d-block"></i>Carry out<small>Release today</small></button>
          </div>
        </section>
        <section class="wa-section" id="waDeliverySection">
          <h4 class="wa-section-title"><i class="bi bi-geo-alt"></i>Installation assignment</h4>
          <div class="wa-fields">
            <div class="wa-wide wa-address-wrap"><label class="wa-label" for="waAddress">Search and select installation address</label><input class="wa-field" id="waAddress" autocomplete="off" placeholder="Street, barangay, city"><div id="waAddressResults" class="wa-address-results wa-hidden"></div></div>
            <input type="hidden" id="waLat"><input type="hidden" id="waLng">
            <div class="wa-wide" id="waQuote"><div class="wa-quote"><span>Select an address for the route quote.</span><strong>—</strong></div></div>
            <div class="wa-wide"><label class="wa-label" for="waTechnician">Assign technician</label><select class="wa-field" id="waTechnician"><option value="">Loading technicians…</option></select><p class="wa-help"><i class="bi bi-info-circle me-1"></i>The calendar below is calculated specifically for the selected technician, cart quantity, and travel time.</p></div>
            <div class="wa-wide">
              <label class="wa-label">Installation date and time</label>
              <div class="wa-schedule-card">
                <div class="wa-calendar-head">
                  <button class="wa-cal-nav" id="waCalendarPrev" type="button" aria-label="Previous month"><i class="bi bi-chevron-left"></i></button>
                  <h5 id="waCalendarTitle">Available dates</h5>
                  <button class="wa-cal-nav" id="waCalendarNext" type="button" aria-label="Next month"><i class="bi bi-chevron-right"></i></button>
                </div>
                <div class="wa-weekdays" aria-hidden="true"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>
                <div class="wa-calendar" id="waCalendar" role="grid" aria-label="Technician availability calendar"></div>
                <div class="wa-calendar-state" id="waCalendarState" role="status"><i class="bi bi-person-check"></i>Select a technician and verified address first.</div>
              </div>
              <div class="wa-calendar-legend" aria-hidden="true"><span><i class="open"></i>Available</span><span><i class="closed"></i>Unavailable</span><span><i style="background:#2563eb"></i>Selected</span></div>
              <div class="wa-time-area">
                <div class="wa-time-heading"><strong>Available start times</strong><span id="waTimeDateLabel">Choose a date first</span></div>
                <input type="hidden" id="waTimeSlot" value="">
                <div class="wa-time-slots" id="waTimeSlots" role="group" aria-label="Available installation start times"><div class="wa-time-empty"><i class="bi bi-clock me-1"></i>Choose an available date from the calendar.</div></div>
                <div class="wa-schedule-summary wa-hidden" id="waScheduleSummary" aria-live="polite"></div>
              </div>
            </div>
          </div>
        </section>
        <section class="wa-section wa-hidden" id="waPickupSection"><label class="wa-label" for="waPickupDate">Pickup date</label><input class="wa-field" id="waPickupDate" type="date"></section>
        <section class="wa-section wa-hidden" id="waSerialSection"><label class="wa-label" for="waSerials">Serial numbers (one per unit)</label><textarea class="wa-field" id="waSerials" rows="3" placeholder="One serial number per line"></textarea><p class="wa-help">Required because the units are handed over immediately.</p></section>
        <section class="wa-section">
          <h4 class="wa-section-title"><i class="bi bi-credit-card"></i>Payment</h4>
          <div class="wa-fields">
            <div><label class="wa-label" for="waPayment">Method</label><select class="wa-field" id="waPayment"><option value="cash">Cash</option><option value="gcash">GCash</option><option value="maya">Maya</option><option value="card">Card</option></select></div>
            <div><label class="wa-label" for="waAmountPaid">Amount paid</label><input class="wa-field" id="waAmountPaid" type="number" min="0" step="0.01"></div>
            <div><label class="wa-label" for="waDiscount">Discount</label><input class="wa-field" id="waDiscount" type="number" min="0" step="0.01" value="0"></div>
            <div id="waReferenceWrap" class="wa-hidden"><label class="wa-label" for="waReference">Payment reference</label><input class="wa-field" id="waReference" maxlength="160"></div>
          </div>
        </section>
        <div class="wa-summary">
          <div class="wa-sum-row"><span>Products</span><strong id="waSubtotal">₱0.00</strong></div>
          <div class="wa-sum-row"><span>Installation</span><strong id="waInstallFee">₱0.00</strong></div>
          <div class="wa-sum-row"><span>Transportation</span><strong id="waTransportFee">₱0.00</strong></div>
          <div class="wa-sum-row"><span>Discount</span><strong id="waDiscountView">−₱0.00</strong></div>
          <div class="wa-sum-row wa-sum-total"><span>Total</span><strong id="waTotal">₱0.00</strong></div>
        </div>
        <button class="wa-submit mt-3" id="waSubmit" type="submit" disabled><i class="bi bi-check2-circle me-1"></i>Create paid order</button>
      </form>
    </aside>
  </div>
</section>

<script>
(() => {
  const today = new Date();
  const state = {
    products: [], cart: [], fulfillment: "delivery_installation", quote: {},
    date: "", time: "", availableDates: new Map(), availableSlots: [],
    calendarMonth: new Date(today.getFullYear(), today.getMonth(), 1),
    scheduleRequest: 0, slotRequest: 0, loaded: false, checkoutId: "",
  };
  const $ = (id) => document.getElementById(id);
  const money = (value) => `₱${Number(value || 0).toLocaleString("en-PH", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const esc = (value) => String(value ?? "").replace(/[&<>'"]/g, ch => ({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"})[ch]);
  const uuid = () => window.crypto?.randomUUID?.().replace(/-/g, "") || `${Date.now()}${Math.random().toString(36).slice(2)}`;
  const dateKey = (date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
  const localDate = (value) => { const [year, month, day] = String(value || "").slice(0, 10).split("-").map(Number); return new Date(year, month - 1, day); };
  const monthKey = (date) => date.getFullYear() * 12 + date.getMonth();
  const readableDate = (value) => localDate(value).toLocaleDateString("en-PH", { weekday: "short", month: "long", day: "numeric", year: "numeric" });
  state.checkoutId = uuid();

  function toast(message, type = "info") {
    if (window.Swal) return Swal.fire({ icon: type === "danger" ? "error" : type, title: type === "success" ? "Order created" : "Walk-in aircon order", text: message, confirmButtonColor: "#2563eb" });
    window.alert(message);
  }

  document.querySelectorAll("[data-walkin-mode]").forEach(button => button.addEventListener("click", () => {
    const aircon = button.dataset.walkinMode === "aircon";
    document.querySelectorAll("[data-walkin-mode]").forEach(tab => { tab.classList.toggle("active", tab === button); tab.setAttribute("aria-selected", String(tab === button)); });
    $("walkinServicesPane").classList.toggle("d-none", aircon);
    $("walkinAirconPane").classList.toggle("d-none", !aircon);
    if (aircon && !state.loaded) initialize();
  }));

  async function jsonFetch(url, options) {
    const response = await fetch(url, options);
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || "Request failed");
    return data;
  }

  async function initialize() {
    state.loaded = true;
    try {
      const [products, options] = await Promise.all([
        jsonFetch("/api/walk-in-aircon/products"),
        jsonFetch("/api/appointments/walk-in-options"),
      ]);
      state.products = products.items || [];
      const types = [...new Set(state.products.map(item => item.type).filter(Boolean))].sort();
      $("waTypeFilter").innerHTML = '<option value="">All aircon types</option>' + types.map(type => `<option value="${esc(type)}">${esc(type)}</option>`).join("");
      $("waTechnician").innerHTML = '<option value="">Choose technician</option>' + (options.technicians || []).map(tech => `<option value="${esc(tech._id)}">${esc(tech.name)}${tech.email ? ` · ${esc(tech.email)}` : ""}</option>`).join("");
      renderProducts();
    } catch (error) {
      $("waProducts").innerHTML = `<div class="wa-empty"><i class="bi bi-exclamation-circle"></i><p>${esc(error.message)}</p><button type="button" class="btn btn-sm btn-outline-primary" id="waRetry">Retry</button></div>`;
      $("waRetry")?.addEventListener("click", () => { state.loaded = false; initialize(); });
    }
  }

  function productGroups() {
    const q = $("waSearch").value.trim().toLowerCase();
    const type = $("waTypeFilter").value;
    const filtered = state.products.filter(item => (!type || item.type === type) && (!q || [item.brand,item.modelLine,item.itemName,item.barcode,item.sku,item.capacity].join(" ").toLowerCase().includes(q)));
    return [...filtered.reduce((map, item) => { const key = item.parentHvacId; if (!map.has(key)) map.set(key, []); map.get(key).push(item); return map; }, new Map()).entries()];
  }

  function renderProducts() {
    const groups = productGroups();
    if (!groups.length) { $("waProducts").innerHTML = '<div class="wa-empty"><i class="bi bi-snow"></i><p>No available aircons match this search.</p></div>'; return; }
    $("waProducts").innerHTML = groups.map(([id, variants]) => {
      const first = variants[0];
      const options = variants.map(item => `<option value="${esc(item._id)}">${esc(item.capacity)} ${esc(item.capacityUnit)} · ${money(item.sellingPrice)} · ${item.available} left</option>`).join("");
      return `<article class="wa-product" data-product="${esc(id)}"><div class="wa-product-image">${first.imageUrl ? `<img src="${esc(first.imageUrl)}" alt="${esc(first.modelLine)}" loading="lazy">` : '<i class="bi bi-snow2"></i>'}</div><div class="wa-product-body"><span class="wa-brand">${esc(first.brand || "Air conditioner")}</span><h3>${esc(first.modelLine)}</h3><div class="wa-chips"><span class="wa-chip">${esc(first.type || "Aircon")}</span>${first.inverter ? '<span class="wa-chip">Inverter</span>' : ""}</div><select class="wa-variant">${options}</select><div class="wa-price-row"><div><div class="wa-price">${money(first.sellingPrice)}</div><div class="wa-stock">${first.available} in stock</div></div><button type="button" class="wa-add"><i class="bi bi-plus-lg"></i> Add</button></div></div></article>`;
    }).join("");
    $("waProducts").querySelectorAll(".wa-product").forEach(card => {
      const select = card.querySelector(".wa-variant");
      const sync = () => { const item = state.products.find(row => row._id === select.value); card.querySelector(".wa-price").textContent = money(item?.sellingPrice); card.querySelector(".wa-stock").textContent = `${item?.available || 0} in stock`; };
      select.addEventListener("change", sync);
      card.querySelector(".wa-add").addEventListener("click", () => addToCart(select.value));
    });
  }

  function addToCart(id) {
    const item = state.products.find(row => row._id === id); if (!item) return;
    const existing = state.cart.find(row => row._id === id);
    if (existing) { if (existing.quantity >= item.available) return toast("No more stock is available for this capacity.", "danger"); existing.quantity++; }
    else state.cart.push({ ...item, quantity: 1 });
    scheduleInputsChanged(); renderCart();
  }

  function changeQuantity(id, delta) {
    const row = state.cart.find(item => item._id === id); if (!row) return;
    row.quantity = Math.min(row.available, row.quantity + delta);
    if (row.quantity <= 0) state.cart = state.cart.filter(item => item._id !== id);
    scheduleInputsChanged(); renderCart();
  }

  function totals() {
    const subtotal = state.cart.reduce((sum, item) => sum + item.sellingPrice * item.quantity, 0);
    const discount = Math.max(0, Number($("waDiscount").value) || 0);
    const delivery = state.fulfillment === "delivery_installation";
    const installation = delivery ? Number(state.quote.installationFee || 0) : 0;
    const transport = delivery ? Number(state.quote.transportationFee || 0) : 0;
    return { subtotal, discount, installation, transport, total: Math.max(0, subtotal - discount + installation + transport) };
  }

  function renderCart() {
    const units = state.cart.reduce((sum, item) => sum + item.quantity, 0); $("waCartCount").textContent = units;
    $("waCart").innerHTML = state.cart.length ? state.cart.map(item => `<div class="wa-cart-item"><div><div class="wa-cart-name">${esc(item.brand)} ${esc(item.modelLine)}</div><div class="wa-cart-meta">${esc(item.capacity)} ${esc(item.capacityUnit)} · ${money(item.sellingPrice)}</div><div class="wa-cart-controls mt-1"><button type="button" data-id="${esc(item._id)}" data-delta="-1">−</button><span>${item.quantity}</span><button type="button" data-id="${esc(item._id)}" data-delta="1">+</button></div></div><div class="wa-cart-total">${money(item.sellingPrice * item.quantity)}</div></div>`).join("") : '<div class="wa-empty" style="padding:1.5rem .5rem"><i class="bi bi-cart"></i><p class="mb-0">Select an aircon to begin.</p></div>';
    $("waCart").querySelectorAll("[data-delta]").forEach(button => button.addEventListener("click", () => changeQuantity(button.dataset.id, Number(button.dataset.delta))));
    renderTotals();
  }

  function renderTotals() {
    const t = totals(); $("waSubtotal").textContent = money(t.subtotal); $("waInstallFee").textContent = money(t.installation); $("waTransportFee").textContent = money(t.transport); $("waDiscountView").textContent = `−${money(t.discount)}`; $("waTotal").textContent = money(t.total); $("waSubmit").disabled = !state.cart.length;
    if ($("waPayment").value !== "cash") $("waAmountPaid").value = t.total.toFixed(2);
  }

  function syncPaymentMode() {
    const electronic = $("waPayment").value !== "cash";
    $("waReferenceWrap").classList.toggle("wa-hidden", !electronic);
    $("waAmountPaid").readOnly = electronic;
    if (electronic) $("waAmountPaid").value = totals().total.toFixed(2);
  }

  function setFulfillment(value) {
    state.fulfillment = value; state.date = "";
    document.querySelectorAll("#waFulfillmentChoices button").forEach(button => { const active = button.dataset.value === value; button.classList.toggle("active", active); button.setAttribute("aria-pressed", String(active)); });
    $("waDeliverySection").classList.toggle("wa-hidden", value !== "delivery_installation"); $("waPickupSection").classList.toggle("wa-hidden", value !== "customer_pickup"); $("waSerialSection").classList.toggle("wa-hidden", value !== "carry_out"); renderTotals(); scheduleInputsChanged();
  }

  function setCalendarStatus(message, type = "info", loading = false) {
    const icon = loading ? '<span class="spinner-border spinner-border-sm"></span>' : `<i class="bi ${type === "error" ? "bi-exclamation-circle" : "bi-info-circle"}"></i>`;
    $("waCalendarState").className = `wa-calendar-state${type === "error" ? " error" : ""}`;
    $("waCalendarState").innerHTML = `${icon}<span>${esc(message)}</span>`;
  }

  function resetTimeSlots(message = "Choose an available date from the calendar.") {
    state.time = "";
    state.availableSlots = [];
    $("waTimeSlot").value = "";
    $("waTimeDateLabel").textContent = state.date ? readableDate(state.date) : "Choose a date first";
    $("waTimeSlots").innerHTML = `<div class="wa-time-empty"><i class="bi bi-clock me-1"></i>${esc(message)}</div>`;
    $("waScheduleSummary").classList.add("wa-hidden");
    $("waScheduleSummary").innerHTML = "";
  }

  function renderAvailabilityCalendar() {
    const month = state.calendarMonth;
    $("waCalendarTitle").textContent = month.toLocaleDateString("en-PH", { month: "long", year: "numeric" });
    const firstWeekday = new Date(month.getFullYear(), month.getMonth(), 1).getDay();
    const daysInMonth = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
    const todayValue = dateKey(new Date());
    const cells = Array.from({ length: firstWeekday }, () => '<span class="wa-cal-blank" aria-hidden="true"></span>');
    for (let day = 1; day <= daysInMonth; day++) {
      const value = dateKey(new Date(month.getFullYear(), month.getMonth(), day));
      const availability = state.availableDates.get(value);
      const open = Number(availability?.availableSlots || 0) > 0;
      const selected = state.date === value;
      const past = value <= todayValue;
      const slotText = open ? `${availability.availableSlots} ${Number(availability.availableSlots) === 1 ? "slot" : "slots"}` : "";
      const aria = `${readableDate(value)}. ${open ? slotText + " available" : "Unavailable"}${selected ? ". Selected" : ""}`;
      cells.push(`<button type="button" class="wa-date ${open ? "available" : "unavailable"}${selected ? " active" : ""}${value === todayValue ? " today" : ""}" data-date="${value}" aria-label="${esc(aria)}" aria-pressed="${selected}" ${!open || past ? "disabled" : ""}><strong>${day}</strong>${open ? `<small>${esc(slotText)}</small>` : ""}</button>`);
    }
    $("waCalendar").innerHTML = cells.join("");
    $("waCalendar").querySelectorAll(".wa-date.available").forEach(button => button.addEventListener("click", () => selectDate(button.dataset.date)));

    const keys = [...state.availableDates.keys()].sort();
    const minMonth = keys.length ? monthKey(localDate(keys[0])) : monthKey(new Date(today.getFullYear(), today.getMonth(), 1));
    const maxMonth = keys.length ? monthKey(localDate(keys[keys.length - 1])) : minMonth;
    $("waCalendarPrev").disabled = monthKey(month) <= minMonth;
    $("waCalendarNext").disabled = monthKey(month) >= maxMonth;
  }

  function moveCalendarMonth(delta) {
    const candidate = new Date(state.calendarMonth.getFullYear(), state.calendarMonth.getMonth() + delta, 1);
    state.calendarMonth = candidate;
    renderAvailabilityCalendar();
  }

  function scheduleInputsChanged() {
    state.scheduleRequest += 1;
    state.slotRequest += 1;
    state.date = "";
    state.availableDates.clear();
    resetTimeSlots();
    renderAvailabilityCalendar();
    if (state.fulfillment !== "delivery_installation") return;
    if (!state.cart.length) return setCalendarStatus("Add an aircon before checking installation availability.");
    if (!$("waLat").value) return setCalendarStatus("Search and select a verified installation address.");
    if (!$("waTechnician").value) return setCalendarStatus("Choose a technician to view their available schedule.");
    loadDates();
  }

  async function searchAddress() {
    const query = $("waAddress").value.trim();
    if (query.length < 5) return $("waAddressResults").classList.add("wa-hidden");
    try {
      const rows = await jsonFetch(`/api/geocoding/search?q=${encodeURIComponent(query)}&limit=5`);
      $("waAddressResults").innerHTML = rows.length ? rows.map((row, index) => `<button type="button" data-index="${index}">${esc(row.display_name)}</button>`).join("") : '<p class="wa-help p-2">No matching address found.</p>';
      $("waAddressResults").classList.remove("wa-hidden");
      $("waAddressResults").querySelectorAll("button").forEach(button => button.addEventListener("click", () => selectAddress(rows[Number(button.dataset.index)])));
    } catch (error) { $("waAddressResults").innerHTML = `<p class="wa-help p-2 text-danger">${esc(error.message)}</p>`; $("waAddressResults").classList.remove("wa-hidden"); }
  }

  async function selectAddress(row) {
    $("waAddress").value = row.display_name || ""; $("waLat").value = row.lat || ""; $("waLng").value = row.lon || ""; $("waAddressResults").classList.add("wa-hidden"); $("waQuote").innerHTML = '<div class="wa-quote"><span>Calculating verified road route…</span><span class="spinner-border spinner-border-sm"></span></div>';
    try {
      state.quote = await jsonFetch("/api/walk-in-aircon/quote", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify({ fulfillmentType:"delivery_installation", coordinates:{lat:row.lat,lng:row.lon} }) });
      $("waQuote").innerHTML = `<div class="wa-quote"><span>${Number(state.quote.distanceKm || 0).toFixed(1)} km · about ${Number(state.quote.durationMin || 0)} min</span><strong>${money(state.quote.additionalTotal)}</strong></div>`; renderTotals(); scheduleInputsChanged();
    } catch (error) { state.quote = {}; $("waQuote").innerHTML = `<div class="wa-quote text-danger"><span>${esc(error.message)}</span><strong>Unavailable</strong></div>`; renderTotals(); }
  }

  async function loadDates() {
    const technicianId = $("waTechnician").value; if (!technicianId || !state.cart.length || !$("waLat").value) return;
    const requestId = ++state.scheduleRequest;
    setCalendarStatus("Checking the technician's latest schedule…", "info", true);
    try {
      const params = new URLSearchParams({ duration:"60", quantity:String(state.cart.reduce((sum,item)=>sum+item.quantity,0)), travelTime:String(Number(state.quote.durationMin || 0)), technicianId });
      const data = await jsonFetch(`/api/schedule/available-dates?${params}`);
      if (requestId !== state.scheduleRequest) return;
      state.availableDates = new Map((data.availableDates || []).map(row => [String(row.date).slice(0, 10), row]));
      const openDates = [...state.availableDates.entries()].filter(([, row]) => Number(row.availableSlots || 0) > 0).map(([key]) => key).sort();
      if (openDates.length && !openDates.some(key => monthKey(localDate(key)) === monthKey(state.calendarMonth))) {
        const first = localDate(openDates[0]);
        state.calendarMonth = new Date(first.getFullYear(), first.getMonth(), 1);
      }
      renderAvailabilityCalendar();
      if (openDates.length) setCalendarStatus(`${openDates.length} available day${openDates.length === 1 ? "" : "s"} found. Select a green date.`);
      else setCalendarStatus("No installation dates are available for this technician. Choose another technician.", "error");
    } catch (error) {
      if (requestId !== state.scheduleRequest) return;
      state.availableDates.clear();
      renderAvailabilityCalendar();
      setCalendarStatus(error.message || "Could not load technician availability.", "error");
    }
  }

  function renderTimeSlots(slots) {
    state.availableSlots = slots;
    if (!slots.length) {
      $("waTimeSlots").innerHTML = '<div class="wa-time-empty text-danger"><i class="bi bi-calendar-x me-1"></i>No start times remain for this date. Choose another date.</div>';
      return;
    }
    let currentGroup = "";
    const html = [];
    slots.forEach(slot => {
      const hour = Number(String(slot.startTime || "0").split(":")[0]);
      const group = hour < 12 ? "Morning" : (hour < 17 ? "Afternoon" : "Evening");
      if (group !== currentGroup) { html.push(`<div class="wa-time-group">${group}</div>`); currentGroup = group; }
      const label = slot.label || slot.startTime;
      html.push(`<button type="button" class="wa-time-slot" data-time="${esc(slot.startTime)}" data-label="${esc(label)}" aria-pressed="false">${esc(label)}</button>`);
    });
    $("waTimeSlots").innerHTML = html.join("");
    $("waTimeSlots").querySelectorAll(".wa-time-slot").forEach(button => button.addEventListener("click", () => {
      state.time = button.dataset.time;
      $("waTimeSlot").value = state.time;
      $("waTimeSlots").querySelectorAll(".wa-time-slot").forEach(row => { const active = row === button; row.classList.toggle("active", active); row.setAttribute("aria-pressed", String(active)); });
      const techName = $("waTechnician").selectedOptions[0]?.textContent?.split(" · ")[0] || "Selected technician";
      $("waScheduleSummary").innerHTML = `<i class="bi bi-check-circle-fill"></i><div><strong>Schedule selected</strong>${esc(readableDate(state.date))} at ${esc(button.dataset.label)} with ${esc(techName)}</div>`;
      $("waScheduleSummary").classList.remove("wa-hidden");
    }));
  }

  async function selectDate(date) {
    if (Number(state.availableDates.get(date)?.availableSlots || 0) <= 0) return;
    state.date = date;
    state.time = "";
    $("waTimeSlot").value = "";
    renderAvailabilityCalendar();
    resetTimeSlots("Loading the available start times…");
    $("waTimeDateLabel").textContent = readableDate(date);
    $("waTimeSlots").innerHTML = '<div class="wa-time-empty"><span class="spinner-border spinner-border-sm me-1"></span>Checking available start times…</div>';
    const requestId = ++state.slotRequest;
    try {
      const params = new URLSearchParams({ date, duration:"60", quantity:String(state.cart.reduce((sum,item)=>sum+item.quantity,0)), travelTime:String(Number(state.quote.durationMin || 0)), technicianId:$("waTechnician").value });
      const data = await jsonFetch(`/api/schedule/time-slots?${params}`); const slots = (data.timeSlots || []).filter(slot => slot.available === true);
      if (requestId !== state.slotRequest) return;
      renderTimeSlots(slots);
    } catch (error) {
      if (requestId !== state.slotRequest) return;
      $("waTimeSlots").innerHTML = `<div class="wa-time-empty text-danger"><i class="bi bi-exclamation-circle me-1"></i>${esc(error.message)}</div>`;
    }
  }

  function validate() {
    if (!state.cart.length) return "Add at least one aircon.";
    if ($("waCustomerName").value.trim().length < 2 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test($("waCustomerEmail").value.trim()) || $("waCustomerPhone").value.replace(/\D/g,"").length < 7) return "Enter the customer's complete name, email, and phone number.";
    if (state.fulfillment === "delivery_installation" && (!$("waLat").value || !$("waTechnician").value || !state.date || !$("waTimeSlot").value)) return "Select a verified address, technician, available date, and time.";
    if (state.fulfillment === "customer_pickup" && !$("waPickupDate").value) return "Choose the customer pickup date.";
    const units = state.cart.reduce((sum,item)=>sum+item.quantity,0), serials = $("waSerials").value.split(/\r?\n|,/).map(v=>v.trim()).filter(Boolean);
    if (state.fulfillment === "carry_out" && serials.length !== units) return `Enter exactly ${units} serial number(s) for immediate handover.`;
    if (Number($("waDiscount").value || 0) > totals().subtotal) return "Discount cannot exceed the product subtotal.";
    if (Number($("waAmountPaid").value || 0) < totals().total) return `Collect the full total of ${money(totals().total)}.`;
    if ($("waPayment").value !== "cash" && $("waReference").value.trim().length < 4) return "Enter the electronic payment reference.";
    return "";
  }

  async function submit(event) {
    event.preventDefault(); const error = validate(); if (error) return toast(error, "danger");
    const button = $("waSubmit"); button.disabled = true; button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Validating stock and schedule…';
    const payload = { checkoutRequestId:state.checkoutId, customer:{name:$("waCustomerName").value.trim(),email:$("waCustomerEmail").value.trim(),phone:$("waCustomerPhone").value.trim(),address:$("waAddress").value.trim()}, items:state.cart.map(item=>({toolId:item._id,quantity:item.quantity})), fulfillmentType:state.fulfillment, pickupDate:$("waPickupDate").value, technicianId:state.fulfillment === "delivery_installation" ? $("waTechnician").value : null, delivery:state.fulfillment === "delivery_installation" ? {address:$("waAddress").value.trim(),preferredDate:state.date,coordinates:{lat:$("waLat").value,lng:$("waLng").value}} : null, timeSlot:state.fulfillment === "delivery_installation" ? $("waTimeSlot").value : null, serialNumbers:$("waSerials").value.split(/\r?\n|,/).map(v=>v.trim()).filter(Boolean), paymentMethod:$("waPayment").value, paymentReference:$("waReference").value.trim(), amountPaid:Number($("waAmountPaid").value), discount:Number($("waDiscount").value || 0) };
    try {
      const result = await jsonFetch("/api/walk-in-aircon/checkout", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(payload) });
      const ref = result.order?.orderReference || "Order"; await toast(`${ref} was created and paid.${state.fulfillment === "delivery_installation" ? " The technician was assigned and the calendar was reserved." : ""}`, "success");
      state.cart = []; state.quote = {}; state.date = ""; state.checkoutId = uuid(); $("waCheckoutForm").reset(); setFulfillment("delivery_installation"); renderCart(); await initializeAfterCheckout();
    } catch (err) { toast(err.message || "Checkout failed.", "danger"); }
    finally { button.disabled = !state.cart.length; button.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Create paid order'; }
  }

  async function initializeAfterCheckout() {
    state.loaded = false;
    state.availableDates.clear();
    state.availableSlots = [];
    state.time = "";
    state.calendarMonth = new Date(today.getFullYear(), today.getMonth(), 1);
    await initialize();
    renderAvailabilityCalendar();
    resetTimeSlots();
    setCalendarStatus("Select a technician and verified address first.");
  }

  let productSearchTimer;
  let addressSearchTimer;
  $("waSearch").addEventListener("input", () => { clearTimeout(productSearchTimer); productSearchTimer = setTimeout(renderProducts, 180); });
  $("waTypeFilter").addEventListener("change", renderProducts);
  document.querySelectorAll("#waFulfillmentChoices button").forEach(button => button.addEventListener("click", () => setFulfillment(button.dataset.value)));
  $("waTechnician").addEventListener("change", scheduleInputsChanged);
  $("waDiscount").addEventListener("input", renderTotals);
  $("waPayment").addEventListener("change", syncPaymentMode);
  $("waAddress").addEventListener("input", () => {
    $("waLat").value = "";
    $("waLng").value = "";
    state.quote = {};
    $("waAddressResults").classList.add("wa-hidden");
    $("waQuote").innerHTML = '<div class="wa-quote"><span>Select an address suggestion to verify the route.</span><strong>—</strong></div>';
    scheduleInputsChanged();
    renderTotals();
    clearTimeout(addressSearchTimer);
    addressSearchTimer = setTimeout(searchAddress, 400);
  });
  $("waCalendarPrev").addEventListener("click", () => moveCalendarMonth(-1));
  $("waCalendarNext").addEventListener("click", () => moveCalendarMonth(1));
  $("waCheckoutForm").addEventListener("submit", submit);
  const tomorrow = new Date(Date.now() + 86400000);
  $("waPickupDate").min = tomorrow.toISOString().slice(0,10);
  renderAvailabilityCalendar();
  resetTimeSlots();
  renderCart();
})();
</script>
