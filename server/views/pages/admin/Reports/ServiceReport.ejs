  <!-- --- PRIORITY & APPLIANCE DISTRIBUTION --- -->
  <% const controls = analytics && analytics.serviceControls ? analytics.serviceControls : {}; %>
  <div class="section-label" id="section-controls">Enterprise Service Controls</div>
  <div class="kpi-grid mb-3">
    <% [
      {label:'Completion Cycle Time',value:Number(controls.avgCompletionCycleHours||0).toFixed(1)+'h',meta:(controls.cycleTimeSampleSize||0)+' completed assignment samples',color:'blue',icon:'bi-stopwatch'},
      {label:'Service Report Coverage',value:Number(controls.reportCoverage||0).toFixed(1)+'%',meta:'Completed jobs with a service report',color:'green',icon:'bi-file-earmark-check'},
      {label:'Report Approval Rate',value:Number(controls.approvedReportRate||0).toFixed(1)+'%',meta:'Non-draft reports approved',color:'cyan',icon:'bi-patch-check'},
      {label:'Follow-up Required',value:Number(controls.followUpRate||0).toFixed(1)+'%',meta:(controls.followUpRequiredCount||0)+' reports flagged',color:'amber',icon:'bi-arrow-repeat'},
      {label:'Parts Fulfillment',value:Number(controls.partsFulfillmentRate||0).toFixed(1)+'%',meta:(controls.partsRequestCount||0)+' parts requests in scope',color:'purple',icon:'bi-box-seam'},
      {label:'Equipment Return',value:Number(controls.equipmentReturnCompliance||0).toFixed(1)+'%',meta:(controls.equipmentAssignmentCount||0)+' completed-job assignments',color:'green',icon:'bi-arrow-return-left'},
      {label:'Reschedule Rate',value:Number(controls.rescheduleRate||0).toFixed(1)+'%',meta:(controls.rescheduledBookings||0)+' bookings with reschedule evidence',color:'amber',icon:'bi-calendar2-event'},
      {label:'Actual Labor Coverage',value:Number(controls.actualLaborCoverage||0).toFixed(1)+'%',meta:'Reports with internal labor expense',color:'red',icon:'bi-person-workspace'},
      {label:'Customer No-show Rate',value:Number(controls.noShowRate||0).toFixed(1)+'%',meta:'Bookings marked as customer no-show',color:'red',icon:'bi-person-x'},
      {label:'Operational Delay Rate',value:Number(controls.delayRate||0).toFixed(1)+'%',meta:'Bookings carrying a delay event',color:'amber',icon:'bi-clock-history'},
      {label:'Technician Reassignment',value:Number(controls.reassignmentRate||0).toFixed(1)+'%',meta:'Bookings reassigned at least once',color:'purple',icon:'bi-people'},
      {label:'Escalation Rate',value:Number(controls.escalationRate||0).toFixed(1)+'%',meta:'Booking or SLA escalation recorded',color:'red',icon:'bi-exclamation-octagon'},
      {label:'Recurring Repair Rate',value:Number(controls.recurringRepairRate||0).toFixed(1)+'%',meta:'Repair bookings flagged as recurring',color:'amber',icon:'bi-arrow-counterclockwise'},
      {label:'Feedback Coverage',value:Number(controls.feedbackCoverage||0).toFixed(1)+'%',meta:'Completed jobs with a customer rating',color:'cyan',icon:'bi-chat-square-heart'}
    ].forEach(function(k){ %>
      <div class="kpi-enterprise" data-accent="<%= k.color %>"><div class="kpi-enterprise-top"><div class="kpi-enterprise-icon <%= k.color %>"><i class="bi <%= k.icon %>"></i></div></div><div class="kpi-enterprise-body"><p class="kpi-enterprise-label"><%= k.label %></p><div class="kpi-enterprise-value"><%= k.value %></div><small style="color:#64748b;"><%= k.meta %></small></div></div>
    <% }); %>
  </div>
  <div class="alert alert-light border mb-4" style="font-size:.72rem;color:#64748b;"><i class="bi bi-info-circle me-1 text-primary"></i>Control percentages are operational indicators scoped to the active report filters. A zero with no samples means no qualifying records were captured, not necessarily zero performance.</div>

  <div class="section-label" id="section-priority">Priority & Appliance Distribution</div>

  <div class="row g-4 mt-1">
    <div class="col-lg-6">
      <div class="dash-card h-100" data-aos="fade-up">
        <div class="dash-card-header">
          <h6><i class="bi bi-exclamation-triangle me-1" style="color:#f59e0b;"></i>Booking Priority Distribution</h6>
        </div>
        <div class="dash-card-body">
          <div class="chart-container" style="height:200px;"><canvas id="priorityChart"></canvas></div>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="50">
        <div class="dash-card-header">
          <h6><i class="bi bi-fan me-1" style="color:#06b6d4;"></i>Appliance Type Breakdown</h6>
        </div>
        <div class="dash-card-body">
          <div class="chart-container" style="height:200px;"><canvas id="applianceChart"></canvas></div>
        </div>
      </div>
    </div>
  </div>

  <!-- --- FINANCIAL BREAKDOWN --- -->
  <div class="section-label" id="section-financial">Financial Breakdown</div>

  <div class="row g-4 mt-1">
    <div class="col-lg-4">
      <div class="dash-card h-100" data-aos="fade-up">
        <div class="dash-card-header">
          <h6><i class="bi bi-box-seam me-1" style="color:#f59e0b;"></i>Total Parts Cost</h6>
        </div>
        <div class="dash-card-body">
          <div style="font-size:1.5rem;font-weight:600;color:#0f172a;">₱<%= analytics ? analytics.totalQuotationPartsCost.toLocaleString() : "0" %></div>
          <span class="kpi-enterprise-badge amber mt-2 d-inline-block">From quotations</span>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="50">
        <div class="dash-card-header">
          <h6><i class="bi bi-person-bounding-box me-1" style="color:#3b82f6;"></i>Customer Labor Fees</h6>
        </div>
        <div class="dash-card-body">
          <div style="font-size:1.5rem;font-weight:600;color:#0f172a;">₱<%= analytics ? analytics.totalQuotationLaborCost.toLocaleString() : "0" %></div>
          <span class="kpi-enterprise-badge blue mt-2 d-inline-block">From quotations</span>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="100">
        <div class="dash-card-header">
          <h6><i class="bi bi-calculator me-1" style="color:#10b981;"></i>Total Quotation Value</h6>
        </div>
        <div class="dash-card-body">
          <div style="font-size:1.5rem;font-weight:600;color:#0f172a;">₱<%= analytics ? (analytics.totalQuotationPartsCost + analytics.totalQuotationLaborCost).toLocaleString() : "0" %></div>
          <span class="kpi-enterprise-badge green mt-2 d-inline-block">Parts + Labor</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Parts Cost by Service -->
  <div class="dash-card mt-3" data-aos="fade-up">
    <div class="dash-card-header">
      <h6><i class="bi bi-table me-1" style="color:#f59e0b;"></i>Quoted Parts Cost &amp; Customer Labor Fees by Service</h6>
    </div>
    <div class="dash-card-body">
      <% if (analytics && analytics.partsCostByServiceArray && analytics.partsCostByServiceArray.length > 0) { %>
        <div class="table-responsive">
          <table class="table-dash">
            <thead>
              <tr>
                <th>Service</th>
                <th style="text-align:center;">Jobs</th>
                <th style="text-align:right;">Parts Cost</th>
                <th style="text-align:right;">Customer Labor Fee</th>
                <th style="text-align:right;">Total</th>
                <th style="text-align:center;">Avg / Job</th>
              </tr>
            </thead>
            <tbody>
              <% analytics.partsCostByServiceArray.forEach(function(s) { %>
                <tr>
                  <td style="font-weight:600;"><%= s.name %></td>
                  <td style="text-align:center;"><%= s.jobCount %></td>
                  <td style="text-align:right;font-weight:600;color:#f59e0b;">₱<%= s.partsCost.toLocaleString() %></td>
                  <td style="text-align:right;font-weight:600;color:#3b82f6;">₱<%= s.laborCost.toLocaleString() %></td>
                  <td style="text-align:right;font-weight:700;">₱<%= (s.partsCost + s.laborCost).toLocaleString() %></td>
                  <td style="text-align:center;"><span class="badge-status info">₱<%= Math.round((s.partsCost + s.laborCost) / s.jobCount).toLocaleString() %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="dash-empty"><i class="bi bi-inbox" style="font-size:1.5rem;display:block;margin-bottom:8px;"></i>No quotation cost data available</div>
      <% } %>
    </div>
  </div>

  <!-- --- OPERATIONAL INSIGHTS --- -->
  <div class="section-label" id="section-ai">Operational Insights</div>

  <div class="dash-card mt-1" data-aos="fade-up" style="border-left:3px solid #8b5cf6;">
    <div class="dash-card-header">
      <h6><i class="bi bi-clipboard-data me-1" style="color:#8b5cf6;"></i>Rule-Based Service Intelligence</h6>
      <span class="kpi-enterprise-badge purple">Measured thresholds</span>
    </div>
    <div class="dash-card-body">
      <!-- Operational recommendations -->
      <div class="mt-3 p-3 rounded-3" style="background:#f8fafc;border:1px solid #e2e8f0;">
        <div style="font-size:0.85rem;font-weight:700;color:#0f172a;margin-bottom:12px;"><i class="bi bi-signpost-split me-2" style="color:#8b5cf6;"></i>Operational Recommendations</div>
          <%
            const aiRecs = [];
            if (analytics) {
              const core = analytics.coreServiceBookings || 0;
              const repair = analytics.repairBookings || 0;
              const orders = analytics.orderBookings || 0;
              const gcash = analytics.gcashBookings || 0;
              const cod = analytics.codBookings || 0;
              const other = analytics.otherPaymentBookings || 0;
              const total = analytics.totalBookings || 1;
              const avg = analytics.avgBookingValue || 0;

              if (analytics.pendingBookings > 10) {
                aiRecs.push({ title: 'Address Pending Backlog', summary: analytics.pendingBookings + ' bookings are currently pending.', advice: 'Assign additional technicians or extend shifts to clear the backlog.' });
              }
              if (analytics.avgRating < 4) {
                aiRecs.push({ title: 'Improve Customer Satisfaction', summary: 'Current average rating is ' + analytics.avgRating + '/5.0.', advice: 'Review customer feedback and address common complaints to boost ratings.' });
              }
              if (analytics.cancellationRate > 15) {
                aiRecs.push({ title: 'Reduce Cancellation Risk', summary: 'Cancellation rate is ' + analytics.cancellationRate.toFixed(1) + '%.', advice: 'Investigate common reasons and confirm bookings closer to the schedule.' });
              }
              if (analytics.retentionRate < 20) {
                aiRecs.push({ title: 'Boost Customer Retention', summary: 'Customer retention is ' + analytics.retentionRate.toFixed(1) + '%.', advice: 'Launch loyalty offers or follow-up campaigns to increase repeat bookings.' });
              }

              let smSummary = core + ' core, ' + repair + ' repair, ' + orders + ' product order' + (orders === 1 ? '' : 's') + '.';
              let smAdvice = '';
              if (orders > core + repair) smAdvice = 'Orders are the largest demand channel. Review product capacity and fulfillment performance.';
              else if (core > repair && repair < core * 0.25) smAdvice = 'Core services dominate. Upsell repair packages to improve per-booking value.';
              else if (repair > core) smAdvice = 'Repair demand is strong. Ensure parts inventory and technician skills keep up.';
              else smAdvice = 'Service mix is balanced. Maintain inventory for both core and repair lines.';
              aiRecs.push({ title: 'Service Mix Optimization', summary: smSummary, advice: smAdvice });

              let pmSummary = gcash + ' GCash (' + Math.round((gcash / total) * 100) + '%), ' + cod + ' COD (' + Math.round((cod / total) * 100) + '%), ' + other + ' other (' + Math.round((other / total) * 100) + '%).';
              let pmAdvice = '';
              if (gcash > cod + other) pmAdvice = 'Digital payments lead. Promote GCash incentives to reduce cash handling.';
              else if (cod > gcash + other) pmAdvice = 'Cash-on-delivery dominates. Prepare adequate float and collection workflows.';
              else if (other > gcash && other > cod) pmAdvice = 'Other payment methods are significant. Review payment partner performance.';
              else pmAdvice = 'Payment channels are mixed. Monitor fees and customer preference trends.';
              aiRecs.push({ title: 'Payment Method Analysis', summary: pmSummary, advice: pmAdvice });

              if (avg > 0) {
                let revSummary = 'Average booking value is ₱' + Math.round(avg).toLocaleString() + '.';
                let revAdvice = avg < 500 ? 'Average value is low. Review service bundles and add-ons that are relevant to customer needs.' : 'Average value is healthy. Continue tracking completion and direct costs to protect contribution.';
                aiRecs.push({ title: 'Booking Value', summary: revSummary, advice: revAdvice });
              }

              if (aiRecs.length < 3) {
                aiRecs.push({ title: 'Continue Monitoring', summary: 'No urgent issues detected for the selected period.', advice: 'Keep tracking bookings, ratings, and cancellations to catch trends early.' });
              }
            }
          %>
          <div class="row g-3">
            <% aiRecs.forEach(function(rec, i) { %>
              <div class="col-md-6">
                <div class="d-flex align-items-start gap-3 p-2 rounded-2" style="background:#fff;border:1px solid #f1f5f9;">
                  <span class="kpi-enterprise-badge purple" style="min-width:22px;height:22px;display:flex;align-items:center;justify-content:center;border-radius:50%;padding:0;font-size:0.7rem;"><%= i + 1 %></span>
                  <div>
                    <strong style="font-size:0.8rem;color:#0f172a;"><%= rec.title %></strong>
                    <p class="small mb-0" style="font-size:0.75rem;color:#64748b;margin-top:2px;"><%= rec.summary %></p>
                    <p class="small mb-0" style="font-size:0.75rem;color:#334155;font-weight:500;margin-top:4px;">Recommended action: <%= rec.advice %></p>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
      </div>
    </div>
  </div>

  <!-- --- GEOGRAPHIC DISTRIBUTION --- -->
  <div class="section-label" id="section-geographic">Geographic Analysis</div>

  <div class="dash-card mt-1 mb-1" data-aos="fade-up">
    <div class="dash-card-header">
      <h6><i class="bi bi-geo-alt me-1" style="color:#3b82f6;"></i>Top Service Areas</h6>
      <span class="kpi-enterprise-badge blue"><%= analytics && analytics.topAreas ? analytics.topAreas.length : 0 %> areas</span>
    </div>
    <div class="dash-card-body">
      <% if (analytics && analytics.topAreas && analytics.topAreas.length > 0) { %>
        <div class="table-responsive">
          <table class="table-dash">
            <thead>
              <tr>
                <th>Area</th>
                <th style="text-align:center;">Bookings</th>
                <th style="text-align:center;">% of Total</th>
                <th>Distribution</th>
              </tr>
            </thead>
            <tbody>
              <% analytics.topAreas.forEach(function(a) { %>
                <tr>
                  <td style="font-weight:600;"><i class="bi bi-geo-alt-fill me-1" style="color:#3b82f6;font-size:0.75rem;"></i><%= a.area %></td>
                  <td style="text-align:center;"><%= a.count %></td>
                  <td style="text-align:center;"><%= Math.round((a.count / (analytics.totalBookings || 1)) * 100) %>%</td>
                  <td>
                    <div class="pipeline-bar" style="width:140px;">
                      <div class="pipeline-bar-fill" style="width:<%= Math.round((a.count / (analytics.topAreas[0].count || 1)) * 100) %>%;background:linear-gradient(90deg,#3b82f6,#06b6d4);"></div>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="dash-empty"><i class="bi bi-geo-alt" style="font-size:1.5rem;display:block;margin-bottom:8px;"></i>No geographic data available</div>
      <% } %>
    </div>
  </div>

  <!-- Completed-service costs: consumables and repair parts are expenses; equipment is operational only. -->
  <div class="section-label" id="section-service-costs">Service Cost Breakdown</div>
  <% const serviceCosts = analytics && analytics.serviceCosts ? analytics.serviceCosts : {}; const costRows = analytics && analytics.completedServiceCosts ? analytics.completedServiceCosts : []; const allLocalPurchases = costRows.flatMap(s => (s.localPurchases || []).map(lp => ({ ...lp, serviceName: s.serviceName, reference: s.reference, technician: s.technician }))); %>
  <div class="kpi-grid" style="grid-template-columns:repeat(6,1fr);">
    <% [{label:'Completed Service Value',value:serviceCosts.revenue,color:'#2563eb',icon:'bi-cash-stack'},{label:'Actual Direct Labor',value:serviceCosts.laborCost,color:'#7c3aed',icon:'bi-people'},{label:'Consumables Cost',value:serviceCosts.consumablesCost,color:'#f59e0b',icon:'bi-droplet'},{label:'Repair Parts Cost',value:serviceCosts.partsCost,color:'#ef4444',icon:'bi-tools'},{label:'Local Purchase Cost',value:serviceCosts.localPurchaseCost,color:'#c2410c',icon:'bi-shop'},{label:'Service Contribution',value:serviceCosts.grossProfit,color:'#10b981',icon:'bi-graph-up-arrow'}].forEach(function(x){ %>
      <div class="kpi-enterprise" style="border-top:3px solid <%= x.color %>"><div class="kpi-enterprise-top"><div class="kpi-enterprise-icon" style="background:<%= x.color %>;color:#fff"><i class="bi <%= x.icon %>"></i></div></div><div class="kpi-enterprise-label"><%= x.label %></div><div class="kpi-enterprise-value">₱<%= Math.round(Number(x.value||0)).toLocaleString() %></div></div>
    <% }); %>
  </div>
  <div class="dash-card mb-3"><div class="dash-card-header"><h6><i class="bi bi-calculator me-1 text-primary"></i>Completed Services — Expand for Resources Used</h6><span class="kpi-enterprise-badge green"><%= Number(serviceCosts.grossProfitMargin||0).toFixed(1) %>% contribution margin</span></div><div class="dash-card-body table-responsive"><table class="table-dash"><thead><tr><th>Service</th><th style="text-align:right">Completed Value</th><th style="text-align:right">Labor</th><th style="text-align:right">Consumables</th><th style="text-align:right">Repair Parts</th><th style="text-align:right">Contribution</th></tr></thead><tbody id="completedServicesBody">
    <% if (!costRows.length) { %><tr><td colspan="6" class="dash-empty">No completed service cost records in this period.</td></tr><% } costRows.forEach(function(s, idx){ %><tr class="cs-row" data-idx="<%= idx %>"><td><details><summary style="cursor:pointer;font-weight:700;color:#334155"><%= s.serviceName %> <i class="bi bi-chevron-down ms-1"></i><div style="font-size:.66rem;color:#94a3b8;font-weight:400"><%= s.reference %> · <%= s.customer %></div></summary><div style="font-size:.7rem;color:#64748b;padding:8px 0 0 12px"><div><strong>Technician:</strong> <%= s.technician %> · <strong>Duration:</strong> <%= Number(s.laborHours||0).toFixed(1) %>h</div><div><strong>Consumables:</strong> <%= s.consumables.length ? s.consumables.map(i=>i.name+' — '+i.quantity+' '+i.unit+' / ₱'+Math.round(i.cost).toLocaleString()).join(', ') : 'None recorded' %></div><div><strong>Repair Parts:</strong> <%= s.repairParts.length ? s.repairParts.map(i=>i.name+' — '+i.quantity+' '+i.unit+' / ₱'+Math.round(i.cost).toLocaleString()).join(', ') : 'None recorded' %></div><% if (s.localPurchases && s.localPurchases.length) { %><div style="margin-top:6px;padding:6px 8px;background:#fff7ed;border:1px solid #fed7aa;border-radius:6px;"><strong style="color:#c2410c;"><i class="bi bi-shop me-1"></i>Local Purchases (External Shop):</strong><% s.localPurchases.forEach(function(lp) { %><div style="padding:2px 0;color:#92400e;">• <%= lp.partName %> — <span style="font-weight:600;">Cost: ₱<%= Math.round(lp.actualPurchaseCost).toLocaleString() %></span> · Quoted: ₱<%= Math.round(lp.quotedCustomerPrice).toLocaleString() %> · <span style="font-size:.65rem;"><%= lp.source %></span><% if (lp.receiptUrl) { %> <a href="<%= lp.receiptUrl %>" target="_blank" style="color:#2563eb;font-size:.65rem;"><i class="bi bi-receipt me-1"></i>Receipt</a><% } %></div><% }); %></div><% } %></div></details></td><td style="text-align:right">₱<%= Math.round(s.revenue).toLocaleString() %></td><td style="text-align:right">₱<%= Math.round(s.laborCost).toLocaleString() %></td><td style="text-align:right">₱<%= Math.round(s.consumablesCost).toLocaleString() %></td><td style="text-align:right">₱<%= Math.round(s.partsCost + (s.localPurchaseCost||0)).toLocaleString() %></td><td style="text-align:right;font-weight:700;color:<%= s.grossProfit>=0?'#059669':'#dc2626' %>">₱<%= Math.round(s.grossProfit).toLocaleString() %></td></tr><% }); %>
  </tbody></table><div id="completedServicesPagination" style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-top:1px solid #edf1f6;"><span id="csPageInfo" style="font-size:.72rem;color:#64748b;"></span><div id="csPageButtons" style="display:flex;gap:4px;"></div></div></div></div>

  <div class="section-label" id="section-equipment-used">Equipment Used <span style="font-size:.65rem;font-weight:500;color:#64748b;text-transform:none;letter-spacing:0">Operational tracking only — excluded from service cost and profit</span></div>
  <div class="dash-card mb-3"><div class="dash-card-header"><h6><i class="bi bi-hammer me-1" style="color:#0891b2"></i>Reusable Equipment Activity</h6><span class="kpi-enterprise-badge cyan"><%= analytics && analytics.equipmentUsage ? analytics.equipmentUsage.length : 0 %> assignments</span></div><div class="dash-card-body table-responsive"><table class="table-dash"><thead><tr><th>Equipment</th><th>Assigned Technician</th><th style="text-align:center">Times Used</th><th>Checkout Status</th><th>Return Status</th></tr></thead><tbody id="equipmentUsageBody"><% if (!(analytics && analytics.equipmentUsage && analytics.equipmentUsage.length)) { %><tr><td colspan="5" class="dash-empty">No equipment assignments recorded for completed services.</td></tr><% } (analytics && analytics.equipmentUsage ? analytics.equipmentUsage : []).forEach(function(e, idx){ %><tr class="eu-row" data-idx="<%= idx %>"><td style="font-weight:700"><%= e.name %></td><td><%= e.technician %></td><td style="text-align:center"><%= e.timesUsed %></td><td><span class="badge-status <%= e.checkoutStatus==='Checked out'?'info':'neutral' %>"><%= e.checkoutStatus %></span></td><td><span class="badge-status <%= e.returnStatus==='Returned'?'success':e.returnStatus==='Outstanding'?'warning':'danger' %>"><%= e.returnStatus %></span></td></tr><% }); %></tbody></table><div id="equipmentUsagePagination" style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-top:1px solid #edf1f6;"><span id="euPageInfo" style="font-size:.72rem;color:#64748b;"></span><div id="euPageButtons" style="display:flex;gap:4px;"></div></div></div></div>

  <% if (allLocalPurchases.length) { %>
  <div class="section-label" id="section-local-purchases">Local Purchases <span style="font-size:.65rem;font-weight:500;color:#64748b;text-transform:none;letter-spacing:0">Parts bought from external shops by technicians</span></div>
  <div class="dash-card mb-3"><div class="dash-card-header"><h6><i class="bi bi-shop me-1" style="color:#c2410c"></i>External Parts Purchase Records</h6><span class="kpi-enterprise-badge" style="background:#fff7ed;color:#c2410c;"><%= allLocalPurchases.length %> purchase<%= allLocalPurchases.length>1?'s':'' %></span></div><div class="dash-card-body table-responsive"><table class="table-dash"><thead><tr><th>Part Name</th><th>Service</th><th>Purchased By</th><th style="text-align:right">Customer Price</th><th style="text-align:right">Actual Cost</th><th style="text-align:right">Margin</th><th>Status</th><th>Date</th></tr></thead><tbody id="localPurchasesBody">
    <% allLocalPurchases.forEach(function(lp, idx){ %><tr class="lp-row" data-idx="<%= idx %>"><td style="font-weight:700"><%= lp.partName %><div style="font-size:.63rem;color:#94a3b8;"><%= lp.source %></div></td><td><%= lp.serviceName %><div style="font-size:.63rem;color:#94a3b8;"><%= lp.reference %></div></td><td><%= lp.purchasedBy %></td><td style="text-align:right">₱<%= Math.round(lp.quotedCustomerPrice).toLocaleString() %></td><td style="text-align:right;font-weight:700;color:#c2410c;">₱<%= Math.round(lp.actualPurchaseCost).toLocaleString() %></td><td style="text-align:right;font-weight:700;color:<%= (lp.quotedCustomerPrice - lp.actualPurchaseCost)>=0?'#059669':'#dc2626' %>">₱<%= Math.round(lp.quotedCustomerPrice - lp.actualPurchaseCost).toLocaleString() %></td><td><span class="badge-status <%= lp.purchaseStatus==='receipt_uploaded'?'success':'info' %>"><%= (lp.purchaseStatus||'purchased').replace(/_/g,' ') %></span><% if (lp.receiptUrl) { %> <a href="<%= lp.receiptUrl %>" target="_blank" style="font-size:.63rem;color:#2563eb;margin-left:4px;"><i class="bi bi-receipt"></i></a><% } %></td><td><%= lp.purchasedAt ? new Date(lp.purchasedAt).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—' %></td></tr><% }); %>
  </tbody></table><div id="localPurchasesPagination" style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-top:1px solid #edf1f6;"><span id="lpPageInfo" style="font-size:.72rem;color:#64748b;"></span><div id="lpPageButtons" style="display:flex;gap:4px;"></div></div></div></div>
  <% } %>

</div>
<%- include('../../../partials/chart-drilldown-modal') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script src="/js/chart-drilldown.js"></script>
<%
  const report = analytics || {};
  const finiteNumber = (value) => Number.isFinite(Number(value)) ? Number(value) : 0;
  const reportPayload = {
    weeklyData: report.weeklyData ? Object.entries(report.weeklyData).map(([key, val]) => ({ week: key, bookings: finiteNumber(val.bookings), revenue: finiteNumber(val.revenue), completed: finiteNumber(val.completed) })) : [],
    ratingDistribution: report.ratingDistribution ? [5,4,3,2,1].map(key => finiteNumber(report.ratingDistribution[key])) : [0,0,0,0,0],
    statusBreakdown: report.statusBreakdown ? Object.entries(report.statusBreakdown).map(([status, count]) => ({ status, count: finiteNumber(count) })) : [],
    dailyTrend: report.dailyTrend || [], bookingForecast: report.bookingForecast || [], topServices: report.topServices || [], techUtilization: report.techUtilization || [], weeklyCsat: report.weeklyCsat || [],
    totalBookings: finiteNumber(report.totalBookings), completedBookings: finiteNumber(report.completedBookings), pendingBookings: finiteNumber(report.pendingBookings), activeTechnicianCount: finiteNumber(report.activeTechnicianCount),
    cancelledBookings: finiteNumber(report.cancelledBookings), inProgressBookings: finiteNumber(report.inProgressBookings), avgRating: finiteNumber(report.avgRating),
    totalRevenue: finiteNumber(report.totalRevenue), avgBookingValue: finiteNumber(report.avgBookingValue), gcashBookings: finiteNumber(report.gcashBookings),
    codBookings: finiteNumber(report.codBookings), otherPaymentBookings: finiteNumber(report.otherPaymentBookings), coreServiceBookings: finiteNumber(report.coreServiceBookings),
    repairBookings: finiteNumber(report.repairBookings), orderBookings: finiteNumber(report.orderBookings), multiServiceBookings: finiteNumber(report.multiServiceBookings), technicians: report.technicians || [],
    bookingDrilldown: report.bookingDrilldown || [], orderDrilldown: report.orderDrilldown || [],
    technicianStats: report.technicianStats || {}, topTechnicians: report.topTechnicians || [], weeklyCancellation: report.weeklyCancellation || [],
    customerSegments: report.customerSegments || { oneTime: 0, returning: 0, loyal: 0 }, monthlyRevenueTrend: report.monthlyRevenueTrend || [],
    priorityBreakdown: report.priorityBreakdown || { low: 0, medium: 0, high: 0, critical: 0 }, applianceArray: report.applianceArray || [],
    reportEnd: report.reportEnd || null
  };
  const reportPayloadJson = JSON.stringify(reportPayload).replace(/</g, '\\u003c');
%>
<script>
var serviceAnalytics = <%- reportPayloadJson %>;

var reportRangeSelect = document.getElementById('reportRange');
if (reportRangeSelect) reportRangeSelect.addEventListener('change', function() {
  document.querySelectorAll('.custom-date-filter').forEach(function(el) { el.style.display = reportRangeSelect.value === 'custom' ? '' : 'none'; });
});

function initCharts() {
  if (typeof Chart === "undefined") { return; }
  if (window.__serviceReportChartsInitialized) return;
  window.__serviceReportChartsInitialized = true;
