<!-- Section 1 : Premium Hero -->
<link rel="stylesheet" href="/css/landing-custom.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
  :root {
    --sapphire-900: #0a1628;
    --sapphire-800: #0c1e3a;
    --sapphire-700: #0f2b5e;
    --sapphire-600: #1a4fd8;
    --sapphire-500: #2563eb;
    --sapphire-400: #3b82f6;
    --sapphire-300: #60a5fa;
    --sapphire-200: #93c5fd;
    --sapphire-100: #dbeafe;
    --sapphire-50:  #eff6ff;
  }
  * { font-family: 'Inter', sans-serif; }

  /* === GLOBAL ANIMATIONS === */
  @keyframes orbDrift {
    0%   { transform: translate(0,0) scale(1); }
    100% { transform: translate(40px,50px) scale(1.12); }
  }
  @keyframes floatCard {
    0%   { transform: translateY(0) translateZ(60px); }
    50%  { transform: translateY(-20px) translateZ(60px); }
    100% { transform: translateY(0) translateZ(60px); }
  }
  @keyframes shimmer {
    0%   { background-position: -200% center; }
    100% { background-position: 200% center; }
  }
  @keyframes pulseGlow {
    0%, 100% { box-shadow: 0 0 20px rgba(59,130,246,0.4), 0 8px 32px rgba(37,99,235,0.3); }
    50%      { box-shadow: 0 0 40px rgba(59,130,246,0.6), 0 12px 48px rgba(37,99,235,0.5); }
  }
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes scaleIn {
    from { opacity: 0; transform: scale(0.85); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes gradientShift {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* === HERO === */
  .hero-premium {
    position: relative;
    padding: 130px 0 120px;
    background: linear-gradient(145deg, #0a1628 0%, #0f2b5e 40%, #1a4fd8 100%);
    overflow: hidden;
  }
  .hero-premium::before {
    content: '';
    position: absolute;
    width: 800px; height: 800px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59,130,246,0.2) 0%, transparent 70%);
    top: -300px; right: -200px;
    animation: orbDrift 14s ease-in-out infinite alternate;
    z-index: 0; pointer-events: none;
  }
  .hero-premium::after {
    content: '';
    position: absolute;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(96,165,250,0.15) 0%, transparent 70%);
    bottom: -200px; left: -150px;
    animation: orbDrift 18s ease-in-out infinite alternate-reverse;
    z-index: 0; pointer-events: none;
  }
  /* Particle dots */
  .hero-particles {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background-image:
      radial-gradient(2px 2px at 15% 25%, rgba(147,197,253,0.5) 50%, transparent 50%),
      radial-gradient(2px 2px at 85% 15%, rgba(96,165,250,0.4) 50%, transparent 50%),
      radial-gradient(2px 2px at 45% 80%, rgba(147,197,253,0.3) 50%, transparent 50%),
      radial-gradient(3px 3px at 75% 65%, rgba(59,130,246,0.35) 50%, transparent 50%),
      radial-gradient(2px 2px at 25% 55%, rgba(96,165,250,0.4) 50%, transparent 50%),
      radial-gradient(2px 2px at 60% 35%, rgba(147,197,253,0.3) 50%, transparent 50%);
    animation: orbDrift 20s ease-in-out infinite alternate;
    z-index: 0; pointer-events: none;
  }
  .hero-content { position: relative; z-index: 1; }

  /* Badge */
  .premium-badge {
    display: inline-flex; align-items: center;
    padding: 8px 22px;
    background: rgba(255,255,255,0.1);
    color: #93c5fd;
    border-radius: 50px;
    font-weight: 700; font-size: 0.82rem;
    letter-spacing: 1px; text-transform: uppercase;
    border: 1px solid rgba(147,197,253,0.25);
    backdrop-filter: blur(10px);
    animation: fadeSlideUp 0.8s ease both;
  }

  /* Title */
  .premium-title {
    font-size: 4.2rem; font-weight: 900;
    line-height: 1.1; color: #ffffff;
    letter-spacing: -2px;
    animation: fadeSlideUp 1s ease 0.2s both;
  }
  .premium-title .gradient-text {
    background: linear-gradient(135deg, #60a5fa 0%, #93c5fd 50%, #3b82f6 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 4s linear infinite;
  }
  .premium-subtitle {
    font-size: 1.1rem;
    color: rgba(219,234,254,0.8);
    line-height: 1.85;
    max-width: 88%; font-weight: 400;
    animation: fadeSlideUp 1s ease 0.4s both;
  }

  /* Hero visual */
  .hero-visual {
    position: relative; z-index: 1;
    display: flex; justify-content: center; align-items: center;
    perspective: 1400px;
  }
  .hero-image-wrapper {
    position: relative;
    border-radius: 2.25rem;
    overflow: visible;
    box-shadow:
      0 0 0 4px rgba(59,130,246,0.3),
      0 0 0 10px rgba(37,99,235,0.15),
      0 40px 80px -20px rgba(0,0,0,0.6),
      0 0 60px rgba(59,130,246,0.2);
    transform: rotateY(-10deg) rotateX(5deg) translateZ(0);
    transition: all 0.7s cubic-bezier(0.165, 0.84, 0.44, 1);
    transform-style: preserve-3d;
    animation: scaleIn 1.2s ease 0.3s both;
  }
  .hero-image-wrapper:hover {
    transform: rotateY(0deg) rotateX(0deg) translateZ(40px);
    box-shadow:
      0 0 0 4px rgba(59,130,246,0.5),
      0 0 0 12px rgba(37,99,235,0.25),
      0 60px 120px -30px rgba(0,0,0,0.7),
      0 0 80px rgba(59,130,246,0.3);
  }
  .hero-image-wrapper img {
    width: 100%; height: auto; display: block;
    border-radius: 2rem;
    transition: transform 0.7s ease;
  }
  .hero-image-wrapper:hover img { transform: scale(1.04); }

  /* Floating cards */
  .floating-card {
    position: absolute;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: 1.5rem;
    padding: 1.1rem 1.4rem;
    box-shadow: 0 20px 50px rgba(0,0,0,0.25), inset 0 1px 0 rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.18);
    animation: floatCard 6s ease-in-out infinite;
    z-index: 5; display: flex; align-items: center; gap: 0.9rem;
    transform: translateZ(60px);
  }
  .fc-top  { top: -15px; right: -35px; animation-delay: 0s; }
  .fc-bottom { bottom: -15px; left: -35px; animation-delay: 3s; }
  .fc-icon-blue {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    box-shadow: 0 6px 20px rgba(59,130,246,0.5);
  }
  .fc-icon-emerald {
    background: linear-gradient(135deg, #34d399, #10b981);
    box-shadow: 0 6px 20px rgba(16,185,129,0.5);
  }

  /* Buttons */
  .btn-premium {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    color: white !important;
    border-radius: 50px;
    padding: 16px 38px; font-weight: 700; font-size: 1rem;
    border: none;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 8px 32px rgba(59,130,246,0.5);
    letter-spacing: 0.3px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    position: relative;
    overflow: hidden;
    opacity: 1;
    visibility: visible;
  }
  .btn-premium::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    transition: left 0.5s ease;
  }
  .btn-premium:hover {
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
    transform: translateY(-6px) scale(1.05);
    box-shadow: 0 20px 50px rgba(59,130,246,0.6);
    color: white !important;
  }
  .btn-premium:hover::before {
    left: 100%;
  }
  .btn-premium:active {
    transform: translateY(-2px) scale(0.98);
    box-shadow: 0 10px 30px rgba(59,130,246,0.4);
  }
  .btn-premium i {
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .btn-premium:hover i {
    transform: translateX(8px) scale(1.2);
  }
  .btn-premium-outline {
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(10px);
    color: #93c5fd !important;
    border-radius: 50px;
    padding: 15px 34px; font-weight: 700; font-size: 1rem;
    border: 1.5px solid rgba(147,197,253,0.35);
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    position: relative;
    overflow: hidden;
    opacity: 1;
    visibility: visible;
  }
  .btn-premium-outline::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s ease;
  }
  .btn-premium-outline:hover {
    background: rgba(255,255,255,0.15);
    border-color: rgba(147,197,253,0.8);
    color: #dbeafe !important;
    transform: translateY(-6px) scale(1.05);
    box-shadow: 0 20px 50px rgba(59,130,246,0.25);
  }
  .btn-premium-outline:hover::before {
    left: 100%;
  }
  .btn-premium-outline:active {
    transform: translateY(-2px) scale(0.98);
  }

  /* Section-wide 3D perspective */
  .perspective-container { perspective: 1400px; }

  @media (max-width: 991.98px) {
    .premium-title { font-size: 2.8rem; letter-spacing: -1px; }
    .hero-premium { padding: 90px 0 70px; }
    .hero-image-wrapper { transform: none; margin-top: 4rem; }
    .hero-image-wrapper:hover { transform: translateZ(10px); }
    .floating-card { transform: scale(0.82); }
    .fc-top { top: -20px; right: -10px; }
    .fc-bottom { bottom: -20px; left: -10px; }
  }

  /* Mobile responsive fixes */
  @media (max-width: 768px) {
    .hero-premium {
      padding: 60px 0 50px !important;
    }
    .premium-badge {
      padding: 6px 16px !important;
      font-size: 0.7rem !important;
      letter-spacing: 0.8px !important;
    }
    .premium-title {
      font-size: 2rem !important;
      letter-spacing: -1px !important;
      line-height: 1.2 !important;
    }
    .premium-subtitle {
      font-size: 0.95rem !important;
      line-height: 1.6 !important;
      max-width: 100% !important;
    }
    .btn-premium {
      padding: 12px 28px !important;
      font-size: 0.9rem !important;
    }
    .btn-premium-outline {
      padding: 12px 28px !important;
      font-size: 0.9rem !important;
    }
    .hero-image-wrapper {
      border-radius: 1.5rem !important;
    }
    .hero-image-wrapper img {
      border-radius: 1.25rem !important;
    }
    .floating-card {
      padding: 0.8rem 1rem !important;
      border-radius: 1rem !important;
      font-size: 0.85rem !important;
    }
    .fc-top {
      top: -10px !important;
      right: -20px !important;
    }
    .fc-bottom {
      bottom: -10px !important;
      left: -20px !important;
    }
  }

  @media (max-width: 480px) {
    .hero-premium {
      padding: 40px 0 35px !important;
    }
    .premium-badge {
      padding: 5px 12px !important;
      font-size: 0.65rem !important;
    }
    .premium-title {
      font-size: 1.6rem !important;
      letter-spacing: -0.5px !important;
    }
    .premium-subtitle {
      font-size: 0.85rem !important;
    }
    .btn-premium {
      padding: 10px 24px !important;
      font-size: 0.85rem !important;
      width: 100% !important;
      justify-content: center !important;
    }
    .btn-premium-outline {
      padding: 10px 24px !important;
      font-size: 0.85rem !important;
      width: 100% !important;
      justify-content: center !important;
    }
    .hero-image-wrapper {
      border-radius: 1.25rem !important;
    }
    .floating-card {
      padding: 0.6rem 0.8rem !important;
      font-size: 0.75rem !important;
    }
    .fc-top, .fc-bottom {
      display: none;
    }
  }
</style>

<!-- Section 1 : Premium Hero -->
<section class="hero-premium">
  <div class="hero-particles"></div>
  <div class="container hero-content">
    <div class="row align-items-center">
      <!-- Text Column -->
      <div class="col-lg-6" data-aos="fade-up" data-aos-duration="1000">
        <div class="pe-lg-5">
          <h1 class="premium-title mb-4">
            Smart Appointment<br>
            Scheduling<br>
            for <span class="gradient-text">Aircon & Home<br>Services</span>
          </h1>
          <p class="premium-subtitle mb-5">
            CALIDRO RACS delivers reliable air conditioning,<br>
            CCTV installation, and appliance repair services<br>
            powered by intelligent scheduling and inventory-<br>
            backed operations.
          </p>
          <div class="d-flex flex-wrap gap-3">
            <a href="/services" class="btn-premium d-flex align-items-center text-decoration-none">
              Core Service <i class="bi bi-arrow-right ms-2 fs-5"></i>
            </a>
            <a href="/products" class="btn-premium-outline d-flex align-items-center text-decoration-none">
              View Products
            </a>
          </div>
        </div>
      </div>
      <!-- Image Column -->
      <div class="col-lg-6 mt-5 mt-lg-0 hero-visual" data-aos="fade-left" data-aos-duration="1200" data-aos-delay="200">
        <div class="hero-image-wrapper">
          <img src="/images/technicianWork/tech1.jpg" alt="Professional Technician" class="img-fluid">
          
          <!-- Floating Cards -->
          <div class="floating-card fc-top">
            <div class="fc-icon-emerald text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
              <i class="bi bi-shield-check fs-5"></i>
            </div>
            <div>
              <div class="fw-bold lh-1 mb-1" style="color:#fff;font-size:0.9rem;">Certified</div>
              <div class="small lh-1" style="color:rgba(219,234,254,0.7);">Professionals</div>
            </div>
          </div>
          
          <div class="floating-card fc-bottom">
            <div class="fc-icon-blue text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
              <i class="bi bi-star-fill fs-5"></i>
            </div>
            <div>
              <div class="fw-bold lh-1 mb-1" style="color:#fff;font-size:0.9rem;"><%= displayRating %>/5 Rating</div>
              <div class="small lh-1" style="color:rgba(219,234,254,0.7);"><%= displayCount %> Reviews</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-divider {
    height: 48px;
    background: radial-gradient(circle, rgba(59,130,246,0.15), transparent);
  }
</style>

<!-- Section Separator -->
<div class="section-divider"></div>

<!-- Section 1.5: How It Works — Enterprise Process Flow -->
<section class="py-5 position-relative" style="background: linear-gradient(160deg, #f8fafc 0%, #f1f5f9 50%, #e2e8f0 100%); overflow: hidden;">
  <!-- Subtle grid pattern -->
  <div class="position-absolute top-0 start-0 w-100 h-100" style="background-image: radial-gradient(rgba(37,99,235,0.04) 1px, transparent 1px); background-size: 32px 32px; z-index: 0; pointer-events: none;"></div>
  <!-- Glow orbs -->
  <div class="position-absolute rounded-circle" style="width: 500px; height: 500px; background: radial-gradient(circle, rgba(37,99,235,0.06) 0%, transparent 70%); top: -200px; right: -150px; z-index: 0; pointer-events: none;"></div>

  <div class="container position-relative py-4" style="z-index: 1;">
    <!-- Section Header -->
    <div class="text-center mb-5" data-aos="fade-up" data-aos-duration="1000">
      <div class="d-inline-flex align-items-center gap-2 px-4 py-2 rounded-pill fw-bold mb-3 border shadow-sm" style="font-size: 0.82rem; letter-spacing: 1px; text-transform: uppercase; background: linear-gradient(135deg, rgba(37,99,235,0.08), rgba(59,130,246,0.04)); color: #2563eb; border-color: rgba(37,99,235,0.15) !important;">
        <i class="bi bi-diagram-3 fs-5"></i>
        <span>SIMPLE PROCESS</span>
      </div>
      <h2 class="display-5 fw-bold mb-3" style="letter-spacing: -1.5px; color: #0a1628;">
        How It <span style="background: linear-gradient(135deg, #2563eb, #3b82f6, #60a5fa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Works</span>
      </h2>
      <p class="fs-5 mx-auto" style="max-width: 600px; color: #64748b;">
        Getting professional service is easy. Book in minutes, and we handle the rest.
      </p>
    </div>

    <!-- 4-Step Process -->
    <div class="row g-4 align-items-stretch justify-content-center">
      <!-- Step 1 -->
      <div class="col-12 col-md-6 col-lg-3" data-aos="fade-up" data-aos-duration="800" data-aos-delay="0">
        <div class="process-card h-100 text-center position-relative">
          <div class="process-number">1</div>
          <div class="process-icon-wrap mx-auto mb-3">
            <div class="process-icon">
              <i class="bi bi-calendar-check"></i>
            </div>
            <div class="process-icon-ring"></div>
          </div>
          <h5 class="fw-bold mb-2" style="color: #0a1628; letter-spacing: -0.3px;">Book Online</h5>
          <p style="color: #64748b; font-size: 0.92rem; line-height: 1.65;">Choose your service, pick a date and time, and submit your booking request in under 2 minutes.</p>
          <div class="process-line d-none d-lg-block"></div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="col-12 col-md-6 col-lg-3" data-aos="fade-up" data-aos-duration="800" data-aos-delay="100">
        <div class="process-card h-100 text-center position-relative">
          <div class="process-number">2</div>
          <div class="process-icon-wrap mx-auto mb-3">
            <div class="process-icon">
              <i class="bi bi-shield-check"></i>
            </div>
            <div class="process-icon-ring"></div>
          </div>
          <h5 class="fw-bold mb-2" style="color: #0a1628; letter-spacing: -0.3px;">Payment Verification</h5>
          <p style="color: #64748b; font-size: 0.92rem; line-height: 1.65;">Our team verifies your payment and confirms the booking. You'll receive instant notification.</p>
          <div class="process-line d-none d-lg-block"></div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="col-12 col-md-6 col-lg-3" data-aos="fade-up" data-aos-duration="800" data-aos-delay="200">
        <div class="process-card h-100 text-center position-relative">
          <div class="process-number">3</div>
          <div class="process-icon-wrap mx-auto mb-3">
            <div class="process-icon">
              <i class="bi bi-person-gear"></i>
            </div>
            <div class="process-icon-ring"></div>
          </div>
          <h5 class="fw-bold mb-2" style="color: #0a1628; letter-spacing: -0.3px;">Technician Assigned</h5>
          <p style="color: #64748b; font-size: 0.92rem; line-height: 1.65;">A certified technician is assigned and you can track their arrival in real-time on the day of service.</p>
          <div class="process-line d-none d-lg-block"></div>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="col-12 col-md-6 col-lg-3" data-aos="fade-up" data-aos-duration="800" data-aos-delay="300">
        <div class="process-card h-100 text-center position-relative">
          <div class="process-number">4</div>
          <div class="process-icon-wrap mx-auto mb-3">
            <div class="process-icon process-icon-success">
              <i class="bi bi-check2-circle"></i>
            </div>
            <div class="process-icon-ring ring-success"></div>
          </div>
          <h5 class="fw-bold mb-2" style="color: #0a1628; letter-spacing: -0.3px;">Service Complete</h5>
          <p style="color: #64748b; font-size: 0.92rem; line-height: 1.65;">Your service is completed, payment is settled, and you can rate your experience with us.</p>
        </div>
      </div>
    </div>
  </div>

  <style>
    .process-card {
      background: #ffffff;
      border: 1px solid rgba(37,99,235,0.08);
      border-radius: 1.5rem;
      padding: 2.5rem 1.5rem 2rem;
      transition: all 0.45s cubic-bezier(0.165, 0.84, 0.44, 1);
      box-shadow: 0 4px 20px rgba(15,36,96,0.06);
      position: relative;
    }
    .process-card:hover {
      transform: translateY(-12px) translateZ(10px);
      box-shadow: 0 24px 48px rgba(37,99,235,0.12);
      border-color: rgba(37,99,235,0.2);
    }
    .process-number {
      position: absolute;
      top: 12px;
      right: 16px;
      font-size: 3.5rem;
      font-weight: 900;
      color: rgba(37,99,235,0.06);
      line-height: 1;
      pointer-events: none;
      transition: all 0.4s ease;
    }
    .process-card:hover .process-number {
      color: rgba(37,99,235,0.12);
      transform: translateY(-4px);
    }
    .process-icon-wrap {
      position: relative;
      width: 72px;
      height: 72px;
    }
    .process-icon {
      width: 72px;
      height: 72px;
      border-radius: 1.25rem;
      background: linear-gradient(135deg, #eff6ff, #dbeafe);
      border: 1.5px solid rgba(37,99,235,0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      color: #2563eb;
      position: relative;
      z-index: 1;
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .process-icon-success {
      background: linear-gradient(135deg, #f0fdf4, #dcfce7) !important;
      border-color: rgba(16,185,129,0.2) !important;
