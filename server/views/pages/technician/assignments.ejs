  async function _matchAiPartsToInventory() {
    // Collect names of parts that don't have toolId yet
    const unnamed = (window._inspParts || []).filter(p => !p.toolId);
    if (unnamed.length === 0) return;

    const names = unnamed.map(p => p.name);
    try {
      const resp = await fetch('/api/technician/tools/match-by-names', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ names }),
        credentials: 'same-origin'
      });
      const data = await resp.json();
      if (resp.ok && data.matches) {
        data.matches.forEach(m => {
          if (m._id) {
            // Find the part in _inspParts by name and assign toolId
            const part = window._inspParts.find(p => p.name === m.name && !p.toolId);
            if (part) {
              part.toolId = m._id;
              // Update cost if AI didn't provide one
              if (!part.cost && (m.sellingPrice || m.costPrice)) {
                part.cost = m.sellingPrice || m.costPrice || 0;
              }
            }
          }
        });
      }
    } catch (e) {
      console.error('[Inspection] Failed to match parts to inventory:', e);
    }
  }

  function _showInspectionFormSections() {
    document.getElementById('inspectionAiLoading').style.display = 'none';
    // Start on screen 1: AI Summary is shown; Review and Quote are hidden
    document.getElementById('inspectionSummarySection').style.display = 'block';
    document.getElementById('inspectionReviewSection').style.display = 'none';
    document.getElementById('inspectionQuoteSection').style.display = 'none';
    window._inspWizardStep = 1;
    _updateStepperUI();
  }

  // ── 3-Screen Wizard Navigation ────────────────────────────────────────
  const INSP_TOTAL_STEPS = 3;

  function _updateStepperUI() {
    const step = window._inspWizardStep || 1;
    for (let i = 1; i <= INSP_TOTAL_STEPS; i++) {
      const el = document.getElementById('inspStep' + i);
      if (!el) continue;
      const circle = el.querySelector('div:first-child');
      const label = el.querySelector('div:last-child');
      const active = i <= step;
      circle.style.background = active ? 'linear-gradient(135deg,#2563eb,#3b82f6)' : '#e2e8f0';
      circle.style.color = active ? '#fff' : '#64748b';
      circle.style.boxShadow = active ? '0 2px 8px rgba(37,99,235,0.3)' : 'none';
      label.style.color = active ? '#2563eb' : '#94a3b8';
      label.style.fontWeight = active ? '600' : '500';
    }

    // Update connector bars
    const conn1 = document.getElementById('stepConnector1');
    const conn2 = document.getElementById('stepConnector2');
    if (conn1) conn1.style.width = step >= 2 ? '100%' : '0%';
    if (conn2) conn2.style.width = step >= 3 ? '100%' : '0%';

    const stepSections = {
      1: 'inspectionSummarySection',
      2: 'inspectionReviewSection',
      3: 'inspectionQuoteSection'
    };
    Object.entries(stepSections).forEach(([s, id]) => {
      const el = document.getElementById(id);
      if (el) el.style.display = parseInt(s) === step ? 'block' : 'none';
    });

    // Update footer buttons
    const backBtn = document.getElementById('inspBackBtn');
    const nextBtn = document.getElementById('inspNextBtn');
    if (!backBtn || !nextBtn) return;

    backBtn.style.display = step > 1 ? '' : 'none';

    if (step === 1) {
      nextBtn.innerHTML = '<i class="bi bi-arrow-right me-1"></i>Start Inspection';
      nextBtn.style.display = '';
      nextBtn.disabled = false;
    } else if (step === 2) {
      nextBtn.innerHTML = '<i class="bi bi-receipt me-1"></i>Generate Quotation';
      nextBtn.style.display = '';
      nextBtn.disabled = false;
    } else if (step === 3) {
      nextBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Submit';
      nextBtn.style.display = '';
      nextBtn.disabled = false;
    }

    const modalBody = document.querySelector('#inspectionModal .modal-body');
    if (modalBody) modalBody.scrollTop = 0;
  }

  window.inspWizardNext = function () {
    const step = window._inspWizardStep || 1;
    if (step === 1) {
      // Screen 1 → Screen 2: AI Summary → Review
      window._inspWizardStep = 2;
      _updateStepperUI();
      // Render diagnosis + parts + labor on the review page
      _renderDiagnosisChecklist();
      _renderPartsList();
      _updatePartsInventoryStatus();
      // Pre-populate recommended action from checked diagnoses
      const checked = (window._inspDiagnoses || []).filter(d => d.checked);
      const actionText = checked.map(d => {
        const actionMap = {
          'capacitor': 'Test and replace capacitor as needed',
          'compressor': 'Inspect compressor; replace if faulty',
          'refrigerant': 'Check refrigerant levels; repair leaks and recharge',
          'fan': 'Inspect fan motor and blades; replace if damaged',
          'coil': 'Clean coils; replace if damaged',
          'wiring': 'Inspect wiring; repair or replace damaged connections',
          'thermostat': 'Test thermostat calibration; replace if necessary',
          'drain': 'Clear drainage line; clean drain pan',
          'airflow': 'Check airflow; clean or replace filters',
        };
        const matched = Object.entries(actionMap).find(([key]) => d.text.toLowerCase().includes(key));
        return matched ? `• ${matched[1]}` : `• Inspect and repair ${d.text}`;
      }).join('\n');
      document.getElementById('inspectionRecommendedAction').value = actionText || 'Perform diagnostic tests and repair as needed.';
      return;
    }
    if (step === 2) {
      // Screen 2 → Screen 3: validate parts + labor
      const parts = (window._inspParts || []).filter(p => p.checked);
      if (parts.length === 0) {
        Swal.fire({ icon: 'warning', title: 'Select Parts', text: 'Please select at least one required part.', confirmButtonColor: '#0f172a' });
        return;
      }
      const laborCost = parseFloat(document.getElementById('quotationLaborCost').value) || 0;
      if (laborCost <= 0) {
        Swal.fire({ icon: 'warning', title: 'Labor Cost', text: 'Labor cost must be greater than zero.', confirmButtonColor: '#0f172a' });
        return;
      }
      window._inspWizardStep = 3;
      _updateStepperUI();
      // Build quotation summary
      _buildQuotationSummary();
      return;
    }
    if (step === 3) {
      // Submit everything
      submitInspection();
    }
  };

  window.inspWizardBack = function () {
    const step = window._inspWizardStep || 1;
    if (step <= 1) return;
    window._inspWizardStep = step - 1;
    _updateStepperUI();
    const modalBody = document.querySelector('#inspectionModal .modal-body');
    if (modalBody) modalBody.scrollTop = 0;
  };

  function _updateStepIndicators() {
    _updateStepperUI();
  }

  function _renderDiagnosisChecklist() {
    const container = document.getElementById('aiDiagnosisChecklist');
    if (!window._inspDiagnoses || window._inspDiagnoses.length === 0) {
      container.innerHTML = `<div class="text-center py-2" style="font-size:0.82rem;color:#94a3b8;">
        <i class="bi bi-info-circle me-1"></i>No AI diagnoses available. Add your own diagnoses below.
      </div>`;
      return;
    }
    container.innerHTML = window._inspDiagnoses.map((d, i) => {
      const likelihoodColor = d.likelihood === 'high' ? '#dc2626' : d.likelihood === 'medium' ? '#d97706' : '#6b7280';
      const likelihoodBg = d.likelihood === 'high' ? '#fef2f2' : d.likelihood === 'medium' ? '#fffbeb' : '#f9fafb';
      return `<div class="d-flex align-items-start gap-2 p-2 mb-1 rounded" style="background:${likelihoodBg};border:1px solid ${likelihoodColor}20;cursor:pointer;" onclick="toggleDiagnosis(${i})">
        <div class="form-check mt-0" style="min-width:20px;">
          <input class="form-check-input" type="checkbox" ${d.checked ? 'checked' : ''} id="diag_${i}" style="cursor:pointer;" onclick="event.stopPropagation();toggleDiagnosis(${i})" />
        </div>
        <div class="flex-grow-1">
          <div class="d-flex align-items-center gap-1">
            <span class="fw-semibold" style="font-size:0.82rem;color:#1e293b;">${d.text}</span>
            <span class="badge" style="font-size:0.55rem;background:${likelihoodColor};color:#fff;">${d.likelihood}</span>
            ${d.source === 'custom' ? '<span class="badge bg-info" style="font-size:0.5rem;">CUSTOM</span>' : ''}
          </div>
          ${d.explanation ? `<div style="font-size:0.72rem;color:#64748b;margin-top:2px;">${d.explanation}</div>` : ''}
        </div>
        ${d.source === 'custom' ? `<button type="button" class="btn btn-sm p-0" onclick="event.stopPropagation();removeDiagnosis(${i})" style="color:#dc2626;font-size:0.7rem;"><i class="bi bi-trash"></i></button>` : ''}
      </div>`;
    }).join('');
  }

  function toggleDiagnosis(index) {
    if (window._inspDiagnoses[index]) {
      window._inspDiagnoses[index].checked = !window._inspDiagnoses[index].checked;
      _renderDiagnosisChecklist();
    }
  }

  function removeDiagnosis(index) {
    window._inspDiagnoses.splice(index, 1);
    _renderDiagnosisChecklist();
  }

  function confirmAddDiagnosis() {
    const input = document.getElementById('newDiagnosisInput');
    const text = input.value.trim();
    if (!text) return;
    window._inspDiagnoses.push({
      id: 'custom_' + Date.now(),
      text: text,
      explanation: '',
      likelihood: 'medium',
      checked: true,
      source: 'custom'
    });
    input.value = '';
    document.getElementById('addDiagnosisInput').style.display = 'none';
    _renderDiagnosisChecklist();
  }

  function _renderPartsList() {
    const container = document.getElementById('aiPartsList');
    if (!window._inspParts || window._inspParts.length === 0) {
      container.innerHTML = `<div class="text-center py-2" style="font-size:0.82rem;color:#94a3b8;">
        <i class="bi bi-info-circle me-1"></i>No AI-suggested parts. Add required parts below.
      </div>`;
      return;
    }
    container.innerHTML = window._inspParts.map((p, i) => {
      const likelihoodColor = p.likelihood === 'high' ? '#dc2626' : p.likelihood === 'medium' ? '#d97706' : '#6b7280';
      return `<div class="d-flex align-items-center gap-2 p-2 mb-1 rounded" style="background:#fff;border:1px solid #e2e8f0;">
        <div class="form-check mt-0" style="min-width:20px;">
          <input class="form-check-input" type="checkbox" ${p.checked ? 'checked' : ''} id="part_${i}" style="cursor:pointer;" onchange="togglePart(${i}, this.checked)" />
        </div>
        <div class="flex-grow-1">
          <div class="d-flex align-items-center gap-1">
            <span class="fw-semibold" style="font-size:0.82rem;color:#1e293b;">${p.name}</span>
            <span class="badge" style="font-size:0.55rem;background:${likelihoodColor};color:#fff;">${p.likelihood}</span>
            ${p.source === 'custom' ? '<span class="badge bg-info" style="font-size:0.5rem;">CUSTOM</span>' : ''}
          </div>
          ${p.purpose ? `<div style="font-size:0.7rem;color:#64748b;">${p.purpose}</div>` : ''}
        </div>
        <div class="d-flex align-items-center gap-1" style="min-width:120px;">
          <input type="number" class="form-control form-control-sm text-center" value="${p.quantity}" min="1" style="width:50px;border-radius:6px;font-size:0.78rem;" onchange="updatePartQty(${i}, this.value)" ${!p.checked ? 'disabled' : ''} />
          <span style="font-size:0.72rem;color:#64748b;">&#8369;</span>
          <input type="number" class="form-control form-control-sm text-center" value="${p.cost}" min="0" style="width:70px;border-radius:6px;font-size:0.78rem;" onchange="updatePartCost(${i}, this.value)" placeholder="Cost" ${!p.checked ? 'disabled' : ''} />
        </div>
        <div id="inventoryBadge_${i}" class="ms-1"></div>
        ${p.source === 'custom' ? `<button type="button" class="btn btn-sm p-0" onclick="removePart(${i})" style="color:#dc2626;font-size:0.7rem;"><i class="bi bi-trash"></i></button>` : ''}
      </div>`;
    }).join('');
  }

  function togglePart(index, checked) {
    if (window._inspParts[index]) {
      window._inspParts[index].checked = checked;
      _renderPartsList();
      _updatePartsInventoryStatus();
      _saveInspectionState(_repairBookingId);
    }
  }

  function updatePartQty(index, qty) {
    if (window._inspParts[index]) {
      window._inspParts[index].quantity = parseInt(qty) || 1;
      _saveInspectionState(_repairBookingId);
    }
  }

  function updatePartCost(index, cost) {
    if (window._inspParts[index]) {
      window._inspParts[index].cost = parseFloat(cost) || 0;
      _saveInspectionState(_repairBookingId);
    }
  }

  function removePart(index) {
    window._inspParts.splice(index, 1);
    _renderPartsList();
    _updatePartsInventoryStatus();
    _saveInspectionState(_repairBookingId);
  }

  function showAddPartInput() {
    document.getElementById('addPartInput').style.display = 'block';
    document.getElementById('newPartName').value = '';
    document.getElementById('newPartId').value = '';
    document.getElementById('newPartQty').value = 1;
    document.getElementById('newPartCost').value = '';
    document.getElementById('newPartName').focus();
    // Attach autocomplete
    const nameInput = document.getElementById('newPartName');
    if (!nameInput._acAttached) {
      attachInventoryAutocomplete(nameInput, function (item) {
        document.getElementById('newPartId').value = item._id;
        nameInput.value = item.itemName;
        document.getElementById('newPartCost').value = item.sellingPrice || item.costPrice || 0;
        document.getElementById('newPartQty').value = 1;
      });
      nameInput._acAttached = true;
    }
  }

  function confirmAddPart() {
    const name = document.getElementById('newPartName').value.trim();
    const qty = parseInt(document.getElementById('newPartQty').value) || 1;
    const cost = parseFloat(document.getElementById('newPartCost').value) || 0;
    const toolId = document.getElementById('newPartId').value.trim() || null;
    if (!name) return;
    window._inspParts.push({
      id: 'custom_part_' + Date.now(),
      name: name,
      cost: cost,
      quantity: qty,
      likelihood: 'medium',
      purpose: '',
      checked: true,
      source: 'custom',
      toolId: toolId
    });
    document.getElementById('addPartInput').style.display = 'none';
    _renderPartsList();
    _updatePartsInventoryStatus();
    _saveInspectionState(_repairBookingId);
  }

  function _updatePartsInventoryStatus() {
    const checkedParts = (window._inspParts || []).filter(p => p.checked);
    const hasToolParts = checkedParts.some(p => p.toolId);
    if (!hasToolParts || Object.keys(window._inspInventoryStatus || {}).length === 0) {
      document.getElementById('inventoryAllAvailable').style.display = 'none';
      document.getElementById('inventoryUnavailable').style.display = 'none';
      return;
    }
    const unavailable = checkedParts.some(p => {
      if (!p.toolId) return false;
      const inv = window._inspInventoryStatus[p.toolId];
      return inv && inv.quantity < p.quantity;
    });
    document.getElementById('inventoryAllAvailable').style.display = unavailable ? 'none' : '';
    document.getElementById('inventoryUnavailable').style.display = unavailable ? '' : 'none';
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // INSPECTION PAYMENT MODAL
  // ═════════════════════════════════════════════════════════════════════════════

  let _inspPayBookingId = null;
  let _inspPayAssignment = null;
  let _inspPayProceedFn = null;
  let _inspPayProceedFnCalled = false;

  function openInspectionPaymentModal(bookingId, assignment, findings, diagnosis, proceedFn) {
    _inspPayBookingId = bookingId;
    _inspPayAssignment = assignment;
    _inspPayProceedFn = proceedFn;
    _inspPayProceedFnCalled = false;

    const booking = assignment?.bookingId || assignment || {};
    const serviceName = assignment?.serviceName || 'Inspection Service';
    const customerName = assignment?.customerName || 'Customer';
    const address = assignment?.address || '';
    const paymentMethod = booking.paymentMethod || assignment?.paymentMethod || 'cash';
    const downpayment = booking.downpaymentAmount || assignment?.downpaymentAmount || 0;
    const travelFare = booking.travelFare || 0;
    const isCash = ['cod', 'cash', 'cash_onsite'].includes(paymentMethod);

    document.getElementById('inspPayService').textContent = serviceName;
    document.getElementById('inspPayCustomer').textContent = customerName;
    document.getElementById('inspPayAddress').textContent = address ? (address.length > 50 ? address.substring(0, 50) + '...' : address) : '—';

    // Show booking payment method
    const methodLabels = { cod: 'Cash on Delivery', cash: 'Cash', cash_onsite: 'Cash On-Site', gcash: 'GCash', maya: 'Maya', bank_transfer: 'Bank Transfer' };
    document.getElementById('inspPayBookingMethod').textContent = methodLabels[paymentMethod] || paymentMethod;

    // Show findings summary
    const findingsBox = document.getElementById('inspPayFindingsBox');
    if (findings || diagnosis) {
      findingsBox.style.display = 'block';
      document.getElementById('inspPayFindings').textContent = findings || '—';
      document.getElementById('inspPayDiagnosis').textContent = diagnosis || '—';
    } else {
      findingsBox.style.display = 'none';
    }

    // Set payment method dropdown to match booking
    document.getElementById('inspPayMethod').value = paymentMethod;

    // Default inspection fee from booking initialCost
    const defaultFee = booking.initialCost || assignment?.inspectionFee || 500;
    document.getElementById('inspPayTotalFee').textContent = '₱' + defaultFee.toLocaleString();
    document.getElementById('inspPayAmountInput').value = defaultFee;
    document.getElementById('inspPayDistanceInput').value = travelFare;
    document.getElementById('inspPayAmountHint').textContent = `Inspection/diagnosis fee (suggested: ₱${defaultFee.toLocaleString()})`;

    // Show downpayment row for cash bookings with downpayment
    const dpRow = document.getElementById('inspPayDownpaymentRow');
    if (downpayment > 0) {
      dpRow.style.display = 'flex';
      document.getElementById('inspPayDownpayment').textContent = '-₱' + downpayment.toLocaleString();
    } else {
      dpRow.style.display = 'none';
    }

    // Recalculate amount due
    recalcInspPayDue();

    document.getElementById('inspPayNotes').value = '';
    document.getElementById('inspPayErrorBox').classList.add('d-none');
    document.getElementById('inspPayConfirmBtn').disabled = false;
    document.getElementById('inspPayConfirmBtn').innerHTML = '<i class="bi bi-check-circle me-1"></i>Collect Payment';

    const modal = new bootstrap.Modal(document.getElementById('inspectionPaymentModal'));
    modal.show();
  }

  function recalcInspPayDue() {
    const fee = parseFloat(document.getElementById('inspPayAmountInput').value) || 0;
    const distance = parseFloat(document.getElementById('inspPayDistanceInput').value) || 0;
    const _booking = _inspPayAssignment?.bookingId || _inspPayAssignment || {};
    const downpayment = _booking.downpaymentAmount || _inspPayAssignment?.downpaymentAmount || 0;
    const dpDeduction = downpayment > 0 ? downpayment : 0;
    const due = Math.max(0, fee + distance - dpDeduction);

    document.getElementById('inspPayTotalFee').textContent = '₱' + fee.toLocaleString();
    document.getElementById('inspPayDistanceFare').textContent = '₱' + distance.toLocaleString();
    document.getElementById('inspPayDownpayment').textContent = '-₱' + dpDeduction.toLocaleString();
    document.getElementById('inspPayAmountDue').textContent = '₱' + due.toLocaleString();
  }

  document.getElementById('inspPayAmountInput')?.addEventListener('input', recalcInspPayDue);
  document.getElementById('inspPayDistanceInput')?.addEventListener('input', recalcInspPayDue);

  document.getElementById('inspPayConfirmBtn').addEventListener('click', async function () {
    const amount = parseFloat(document.getElementById('inspPayAmountInput').value) || 0;
    const distanceFare = parseFloat(document.getElementById('inspPayDistanceInput').value) || 0;
    const method = document.getElementById('inspPayMethod').value;
    const notes = document.getElementById('inspPayNotes').value.trim();
    const errorBox = document.getElementById('inspPayErrorBox');
    const _booking = _inspPayAssignment?.bookingId || _inspPayAssignment || {};
    const totalDue = amount + distanceFare - (_booking.downpaymentAmount || _inspPayAssignment?.downpaymentAmount || 0);

    if (totalDue <= 0 && amount <= 0) {
      errorBox.textContent = 'Please enter a valid inspection fee.';
      errorBox.classList.remove('d-none');
      return;
    }

    this.disabled = true;
    this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing...';

    try {
      const resp = await fetch(`/api/technician/appointments/${_inspPayBookingId}/collect-inspection-payment`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ amount, distanceFare, method, notes })
      });
      const data = await resp.json();
      if (resp.ok && data.success) {
        _inspPayProceedFnCalled = true;
        Swal.fire({ icon: 'success', title: 'Inspection Payment Collected', html: `<span style="font-size:0.9rem;">₱${amount.toLocaleString()}${distanceFare > 0 ? ' + ₱' + distanceFare.toLocaleString() + ' fare' : ''} collected via ${method}.</span>`, timer: 3000, showConfirmButton: false });
        const _payEl = document.getElementById('inspectionPaymentModal');
        const _onPayHidden = () => {
          _payEl.removeEventListener('hidden.bs.modal', _onPayHidden);
          document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
          document.body.classList.remove('modal-open');
          document.body.style.paddingRight = '';
          if (_inspPayProceedFn) _inspPayProceedFn();
        };
        _payEl.addEventListener('hidden.bs.modal', _onPayHidden);
        bootstrap.Modal.getOrCreateInstance(_payEl).hide();
      } else {
        errorBox.textContent = data.error || 'Failed to collect payment.';
        errorBox.classList.remove('d-none');
        this.disabled = false;
        this.innerHTML = '<i class="bi bi-check-circle me-1"></i>Collect Payment';
      }
    } catch (e) {
      console.error('Inspection payment error:', e);
      errorBox.textContent = 'An error occurred: ' + (e.message || 'Network error. Please check your connection and try again.');
      errorBox.classList.remove('d-none');
      this.disabled = false;
      this.innerHTML = '<i class="bi bi-check-circle me-1"></i>Collect Payment';
    }
  });

  // Skip button — proceed without collecting inspection payment
  document.getElementById('inspPaySkipBtn').addEventListener('click', function () {
    _inspPayProceedFnCalled = true;
    const _payEl = document.getElementById('inspectionPaymentModal');
    const _onSkipHidden = () => {
      _payEl.removeEventListener('hidden.bs.modal', _onSkipHidden);
      document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
      document.body.classList.remove('modal-open');
      document.body.style.paddingRight = '';
      if (_inspPayProceedFn) _inspPayProceedFn();
    };
    _payEl.addEventListener('hidden.bs.modal', _onSkipHidden);
    bootstrap.Modal.getOrCreateInstance(_payEl).hide();
  });

  // Handle X button / backdrop close: if the modal is closed without explicit skip/confirm,
  // still trigger the proceed function so the wizard shows the correct next state
  document.getElementById('inspectionPaymentModal').addEventListener('hidden.bs.modal', function () {
    if (!_inspPayProceedFnCalled && _inspPayProceedFn) {
      _inspPayProceedFnCalled = true;
      document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
      document.body.classList.remove('modal-open');
      document.body.style.paddingRight = '';
      setTimeout(() => _inspPayProceedFn(), 100);
    }
  });

  // NOTE: We intentionally do NOT clear _detailAssignment on detail modal close.
  // The inspection flow (openInspectionModal → openInspectionPaymentModal → showPostInspectionDecision)
  // depends on _detailAssignment persisting after the detail modal closes via openModalAfterClose.
  // Stale job bugs are handled by allItems-first lookup in transitionStatus and openProofModal.

  function _buildQuotationSummary() {
    const container = document.getElementById('quotationSummaryContent');
    const parts = (window._inspParts || []).filter(p => p.checked);
    const laborCost = parseFloat(document.getElementById('quotationLaborCost').value) || 0;
    const partsTotal = parts.reduce((sum, p) => sum + ((p.cost || 0) * (p.quantity || 1)), 0);
    const grandTotal = partsTotal + laborCost;
    const notes = document.getElementById('inspectionNotes')?.value?.trim() || '';

    let partsHtml = parts.map(p => `
      <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f1f5f9;">
        <div style="display:flex;align-items:center;gap:8px;">
          <i class="bi bi-box" style="color:#2563eb;font-size:0.7rem;"></i>
          <span style="font-size:0.82rem;color:#1e293b;">${p.name}</span>
          <span style="font-size:0.68rem;color:#94a3b8;">×${p.quantity || 1}</span>
        </div>
        <span style="font-size:0.82rem;font-weight:600;color:#0f172a;">₱${((p.cost || 0) * (p.quantity || 1)).toLocaleString()}</span>
      </div>
    `).join('') || '<div style="padding:12px;text-align:center;font-size:0.82rem;color:#94a3b8;">No parts selected</div>';

    container.innerHTML = `
      <div style="background:#fff;border:1px solid #e2e8f0;border-radius:var(--mw-radius-sm);overflow:hidden;">
        <div style="background:linear-gradient(135deg,#0f172a,#1e3a5f);padding:14px 18px;">
          <div style="display:flex;align-items:center;gap:8px;">
            <div style="width:28px;height:28px;border-radius:6px;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;">
              <i class="bi bi-receipt" style="color:#fff;font-size:0.75rem;"></i>
            </div>
            <span style="font-size:0.85rem;font-weight:700;color:#fff;">Quotation Summary</span>
          </div>
        </div>
        <div style="padding:16px 18px;">
          <div style="font-size:0.7rem;font-weight:600;color:#475569;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">
            <i class="bi bi-box-seam me-1" style="color:#2563eb;"></i>Parts
          </div>
          ${partsHtml}
          <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;">
            <div style="display:flex;align-items:center;gap:8px;">
              <i class="bi bi-tools" style="color:#2563eb;font-size:0.7rem;"></i>
              <span style="font-size:0.82rem;color:#1e293b;">Labor <span style="font-size:0.68rem;color:#94a3b8;">(${document.getElementById('quotationLaborCategory').value})</span></span>
            </div>
            <span style="font-size:0.82rem;font-weight:600;color:#0f172a;">₱${laborCost.toLocaleString()}</span>
          </div>
          <div style="border-top:2px solid #2563eb;margin:8px 0;border-radius:2px;"></div>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:4px 0;">
            <span style="font-size:0.9rem;font-weight:700;color:#0f172a;">Total</span>
            <span style="font-size:1.05rem;font-weight:800;color:#2563eb;">₱${grandTotal.toLocaleString()}</span>
          </div>
        </div>
        ${notes ? `<div style="margin:0 18px 16px;padding:10px 14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:var(--mw-radius-xs);font-size:0.78rem;color:#475569;display:flex;align-items:start;gap:6px;"><i class="bi bi-journal-text" style="color:#2563eb;margin-top:2px;flex-shrink:0;"></i>${notes}</div>` : ''}
      </div>
    `;

    window._quotationTotal = grandTotal;
  }

  async function submitInspection() {
    const confirmedDiagnoses = (window._inspDiagnoses || []).filter(d => d.checked).map(d => d.text);
    if (confirmedDiagnoses.length === 0) {
      Swal.fire({ icon: 'warning', title: 'Confirm Diagnosis', text: 'At least one diagnosis must be confirmed.', confirmButtonColor: '#0f172a' });
      return;
    }

    const parts = (window._inspParts || []).filter(p => p.checked).map(p => ({
      name: p.name,
      quantity: p.quantity || 1,
      cost: p.cost || 0,
      unitPrice: p.cost || 0,
      toolId: p.toolId || null
    }));
    if (parts.length === 0) {
      Swal.fire({ icon: 'warning', title: 'Select Parts', text: 'At least one part must be selected.', confirmButtonColor: '#0f172a' });
      return;
    }

    const hasUnavailable = parts.some(p => {
      if (!p.toolId) return false;
      const inv = window._inspInventoryStatus[p.toolId];
      return inv && inv.quantity < p.quantity;
    });

    const nextBtn = document.getElementById('inspNextBtn');
    if (nextBtn) { nextBtn.disabled = true; nextBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Submitting...'; }

    try {
      const photoFiles = document.getElementById('inspectionPhotos').files;
      let photoUrls = [];
      if (photoFiles && photoFiles.length > 0) {
        photoUrls = await uploadPhotos(photoFiles, '/api/technician/appointments/upload-repair-photos');
      }

      const laborCost = parseFloat(document.getElementById('quotationLaborCost').value) || 0;
      const fullDiagnosis = confirmedDiagnoses.join('; ');
      const notes = document.getElementById('inspectionNotes')?.value?.trim() || '';
      const laborCategory = document.getElementById('quotationLaborCategory').value || 'standard';

      const resp = await fetch(`/api/technician/appointments/${_repairBookingId}/complete-inspection`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          diagnosis: fullDiagnosis,
          confirmedDiagnoses,
          parts,
          laborCost,
          laborCategory,
          quotationNotes: notes,
          photos: photoUrls,
          estimatedDurationMinutes: window._aiDuration || 90,
          complexity: window._aiComplexity || 'moderate',
          hasUnavailableParts: hasUnavailable,
          recommendedAction: document.getElementById('inspectionRecommendedAction')?.value?.trim() || '',
        }),
        credentials: 'same-origin'
      });
      const data = await resp.json();
      if (resp.ok && data.success) {
        _clearInspectionState(_repairBookingId);

        let paymentMethod = 'cash';
        try {
          const bkResp = await fetch(`/api/technician/appointments/${_repairBookingId}`, { credentials: 'same-origin' });
          const bkData = await bkResp.json();
          const bk = bkData.booking || bkData;
          paymentMethod = bk.paymentMethod || window._inspAssignmentContext?.paymentMethod || 'cash';
          if (window._inspAssignmentContext) {
            window._inspAssignmentContext.paymentMethod = bk.paymentMethod || window._inspAssignmentContext.paymentMethod;
            window._inspAssignmentContext.bookingId = bk;
            window._inspAssignmentContext.downpaymentAmount = bk.downpaymentAmount || window._inspAssignmentContext.downpaymentAmount;
            window._inspAssignmentContext.initialCost = bk.initialCost || window._inspAssignmentContext.initialCost;
          }
        } catch (e) { paymentMethod = window._inspAssignmentContext?.paymentMethod || 'cash'; }

        function _hideInspModalAndProceed(cb) {
          const inspEl = document.getElementById('inspectionModal');
          const inspInst = bootstrap.Modal.getInstance(inspEl);
          if (inspInst) {
            const onHidden = () => {
              inspEl.removeEventListener('hidden.bs.modal', onHidden);
              document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
              document.body.classList.remove('modal-open');
              document.body.style.paddingRight = '';
              cb();
            };
            inspEl.addEventListener('hidden.bs.modal', onHidden);
            inspInst.hide();
          } else {
            document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            document.body.classList.remove('modal-open');
            document.body.style.paddingRight = '';
            cb();
          }
        }

        const isGcash = ['gcash'].includes(paymentMethod);
        const partsWithToolIds = parts.filter(p => p.toolId);

        // Fetch inventory status before showing decision modal
        if (partsWithToolIds.length > 0) {
          window._inspInventoryStatus = window._inspInventoryStatus || {};
          try {
            const invResp = await fetch('/api/technician/tools/check-inventory', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ partIds: partsWithToolIds.map(p => p.toolId) }),
              credentials: 'same-origin'
            });
            const invData = await invResp.json();
            if (invResp.ok && invData.items) {
              invData.items.forEach(item => { window._inspInventoryStatus[item._id] = item; });
            }
          } catch (e) { console.error('[Inspection] Inventory fetch error:', e); }
        }

        if (isGcash) {
          _hideInspModalAndProceed(() => showPostInspectionDecision(_repairBookingId, data.quotationTotal || 0));
        } else {
          _hideInspModalAndProceed(() => openInspectionPaymentModal(_repairBookingId, window._inspAssignmentContext || {}, fullDiagnosis, fullDiagnosis, function () {
            showPostInspectionDecision(_repairBookingId, data.quotationTotal || 0);
          }));
        }
      } else {
        Swal.fire({ icon: 'error', title: 'Error', text: data.error || 'Failed to submit.', confirmButtonColor: '#0f172a' });
        if (nextBtn) { nextBtn.disabled = false; nextBtn.textContent = 'Submit'; }
      }
    } catch (e) {
      Swal.fire({ icon: 'error', title: 'Error', text: 'Network error.', confirmButtonColor: '#0f172a' });
      if (nextBtn) { nextBtn.disabled = false; nextBtn.textContent = 'Submit'; }
    }
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // DIAGNOSIS FUNCTIONS
  // ═════════════════════════════════════════════════════════════════════════════

  // ═════════════════════════════════════════════════════════════════════════════
  // MATERIALS TRACKING
  // ═════════════════════════════════════════════════════════════════════════════

  let _repairMaterialsBookingId = null;

  function openMaterialsModal(bookingId) {
    _repairMaterialsBookingId = bookingId;
    document.getElementById('materialsList').innerHTML = '';
    document.getElementById('materialsActions').value = '';
    // Clear proof photo
    const proofInput = document.getElementById('materialsProofInput');
    if (proofInput) proofInput.value = '';
    const proofPreview = document.getElementById('materialsProofPreview');
    if (proofPreview) proofPreview.style.display = 'none';

    // Pre-populate with quotation parts if available
    fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' })
      .then(r => r.json())
      .then(detail => {
        const booking = detail.booking || detail;
        const q = booking.quotation;
        if (q && q.parts && q.parts.length > 0) {
          q.parts.forEach(p => {
            addMaterialRow(p.name || p.partName || '', p.quantity || 1, p.unit || 'pcs');
          });
        } else {
          addMaterialRow();
        }
        // Pre-fill actions from existing repairCompletion if present
        const rc = booking.repairCompletion;
        if (rc) {
          if (rc.actionsPerformed?.length) {
            document.getElementById('materialsActions').value = rc.actionsPerformed.join(', ');
          }
          if (rc.partsInstalled?.length && !(q?.parts?.length)) {
            document.getElementById('materialsList').innerHTML = '';
            rc.partsInstalled.forEach(p => addMaterialRow(p.name || '', p.quantity || 1, p.unit || 'pcs'));
          }
        }
      })
      .catch(() => addMaterialRow());

    new bootstrap.Modal(document.getElementById('materialsModal')).show();
  }

  // Materials proof photo preview
  document.getElementById('materialsProofInput')?.addEventListener('change', function (e) {
    const file = e.target.files[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) {
      Swal.fire('File Too Large', 'Proof photo must be under 5MB.', 'warning');
      this.value = '';
      return;
    }
    const reader = new FileReader();
    reader.onload = function (ev) {
      document.getElementById('materialsProofImg').src = ev.target.result;
      document.getElementById('materialsProofPreview').style.display = 'block';
    };
    reader.readAsDataURL(file);
  });

  function addMaterialRow(name = '', qty = 1, unit = 'pcs') {
    const list = document.getElementById('materialsList');
    const row = document.createElement('div');
    row.className = 'row g-2 mb-2 align-items-end';
    const unitOptions = ['pcs', 'meter', 'roll', 'set', 'bottle', 'kg', 'liter', 'tube', 'can', 'pack'];
    const unitOptsHtml = unitOptions.map(u => `<option value="${u}" ${unit === u ? 'selected' : ''}>${u}</option>`).join('');
    row.innerHTML = `
    <div class="col-5 inv-autocomplete-wrap">
      <input type="text" class="form-control form-control-sm mat-name" placeholder="Search parts from inventory..." value="${name}" style="border-radius:8px;" autocomplete="off" />
      <div class="inv-autocomplete-list"></div>
    </div>
    <div class="col-2"><input type="number" class="form-control form-control-sm mat-qty" value="${qty}" min="1" style="border-radius:8px;" /></div>
    <div class="col-3">
      <select class="form-select form-select-sm mat-unit" style="border-radius:8px;">
        ${unitOptsHtml}
      </select>
    </div>
    <div class="col-2"><button type="button" class="btn btn-sm btn-outline-danger w-100" onclick="this.closest('.row').remove();" style="border-radius:8px;"><i class="bi bi-trash"></i></button></div>`;
    list.appendChild(row);
    // Attach autocomplete
    const nameInput = row.querySelector('.mat-name');
    attachInventoryAutocomplete(nameInput, function (item) {
      nameInput.value = item.itemName;
      row.querySelector('.mat-qty').value = 1;
      const unitSel = row.querySelector('.mat-unit');
      const itemUnit = item.unit || 'pcs';
      if (unitSel.querySelector(`option[value="${itemUnit}"]`)) {
        unitSel.value = itemUnit;
      }
    });
  }

  async function saveMaterials() {
    const btn = document.getElementById('saveMaterialsBtn');

    // Require proof photo
    const proofFileInput = document.getElementById('materialsProofInput');
    if (proofFileInput && (!proofFileInput.files || proofFileInput.files.length === 0)) {
      Swal.fire('Photo Required', 'Please upload a proof of completion photo before finishing.', 'warning');
      return;
    }

    const materials = [];
    document.querySelectorAll('#materialsList .row').forEach(row => {
      const name = row.querySelector('.mat-name')?.value?.trim();
      const qty = parseInt(row.querySelector('.mat-qty')?.value) || 0;
      const unit = row.querySelector('.mat-unit')?.value || 'pcs';
      if (name && qty > 0) materials.push({ name, quantity: qty, unit });
    });
    const actionsPerformed = document.getElementById('materialsActions').value.trim();
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';
    try {
      const payload = {
        completionNotes: actionsPerformed || 'Repair completed',
        actionsPerformed: actionsPerformed ? [actionsPerformed] : [],
        partsInstalled: materials
      };

      // Then complete the repair
      const resp = await fetch(`/api/technician/appointments/${_repairMaterialsBookingId}/complete-repair`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        credentials: 'same-origin'
      });
      const data = await resp.json();
      bootstrap.Modal.getInstance(document.getElementById('materialsModal'))?.hide();

      if (resp.ok && data.success) {
        // Upload proof photo
        const proofFile = document.getElementById('materialsProofInput')?.files?.[0];
        if (proofFile) {
          try {
            const formData = new FormData();
            formData.append('proofPhoto', proofFile);
            let assignmentId = window._detailAssignment?._id;
            if (!assignmentId || String(window._detailAssignment?.bookingId?._id || window._detailAssignment?.bookingId) !== String(_repairMaterialsBookingId)) {
              const match = (window._allAssignments || []).find(x => String(x.bookingId?._id || x.bookingId) === String(_repairMaterialsBookingId));
              if (match) assignmentId = match._id;
            }
            if (assignmentId) {
              await fetch(`/api/technician/assignments/${assignmentId}/proof-of-completion`, {
                method: 'POST', credentials: 'same-origin', body: formData
              });
            }
          } catch (photoErr) { /* photo upload failed but repair is done */ }
        }

        if (data.invoice) {
          showRepairInvoice(data.invoice);
        } else {
          loadAssignments(currentFilter, currentPage);
          Swal.fire('Completed', 'Repair completed successfully.', 'success').then(() => {
            if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
              showDetail(window._currentDetailId);
            }
          });
        }
      } else {
        Swal.fire('Error', data.error || 'Failed to complete repair.', 'error');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-circle me-2"></i>Save Materials & Complete Repair';
      }
    } catch (e) {
      Swal.fire('Error', 'Network error: ' + e.message, 'error');
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-circle me-2"></i>Save Materials & Complete Repair';
    }
  }

  function showRepairInvoice(inv) {
    const partsHtml = (inv.parts || []).length > 0
      ? inv.parts.map(p => `<tr><td>${p.name}</td><td class="text-center">${p.quantity || 1}</td><td class="text-end">₱${Number(p.unitPrice || p.cost || 0).toLocaleString()}</td><td class="text-end">₱${Number(p.total || ((p.unitPrice || p.cost || 0) * (p.quantity || 1))).toLocaleString()}</td></tr>`).join('')
      : '<tr><td colspan="4" class="text-muted text-center">No parts recorded</td></tr>';
    const actionsHtml = (inv.actionsPerformed || []).length > 0
      ? `<div class="mt-2"><strong>Actions Performed:</strong> ${inv.actionsPerformed.join(', ')}</div>` : '';
    const notesHtml = inv.completionNotes ? `<div class="mt-1"><strong>Completion Notes:</strong> ${inv.completionNotes}</div>` : '';

    // Inspection section
    let inspectionHtml = '';
    const insp = inv.inspection || {};
    const diag = inv.diagnosis || {};
    const hasInsp = insp.findings || diag.findings || insp.severity;
    if (hasInsp) {
      const sevColors = { minor: '#16a34a', major: '#d97706', critical: '#dc2626' };
      inspectionHtml = `
      <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:10px;margin-top:12px;">
        <div style="font-weight:700;color:#059669;font-size:0.85rem;margin-bottom:6px;"><i class="bi bi-clipboard-check me-1"></i>Inspection Report</div>
        <div style="margin-bottom:4px;"><span style="color:#64748b;">Findings:</span> <strong>${insp.findings || diag.findings || '—'}</strong></div>
        ${insp.severity ? `<div style="margin-bottom:4px;"><span style="color:#64748b;">Severity:</span> <span style="color:${sevColors[insp.severity] || '#334155'};font-weight:600;text-transform:capitalize;">${insp.severity}</span></div>` : ''}
        ${insp.damagedParts?.length ? `<div style="margin-bottom:4px;"><span style="color:#64748b;">Damaged Parts:</span> ${insp.damagedParts.map(p => `<span style="background:#fef2f2;color:#991b1b;padding:1px 6px;border-radius:4px;font-size:0.75rem;margin-right:3px;">${p}</span>`).join('')}</div>` : ''}
        <div style="margin-bottom:4px;"><span style="color:#64748b;">Diagnosis:</span> <strong>${diag.findings || insp.diagnosis || '—'}</strong></div>
        ${insp.recommendedAction ? `<div><span style="color:#64748b;">Recommended Action:</span> ${insp.recommendedAction}</div>` : ''}
      </div>`;
    }

    const inspectionFee = inv.inspectionFee || 0;
    const travelFee = inv.travelFee || 0;
    const grandTotal = inspectionFee + travelFee + (inv.totalAmount || 0);
    const balanceDue = inv.balanceCollected ? 0 : grandTotal;

    const html = `
  <div style="text-align:left;font-size:0.85rem;max-width:520px;margin:0 auto;">
    <div style="background:linear-gradient(135deg,#059669,#047857);color:#fff;padding:14px 18px;border-radius:10px 10px 0 0;margin:-1.3rem -1.5rem 1rem;">
      <div style="font-size:1.15rem;font-weight:700;">RACS Repair Invoice</div>
      <div style="font-size:0.78rem;opacity:0.9;">${inv.workOrderNumber || 'N/A'} · ${inv.dateCompleted || 'N/A'}</div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:12px;">
      <div><span style="color:#64748b;">Customer:</span> <strong>${inv.customerName || '—'}</strong></div>
      <div><span style="color:#64748b;">Service:</span> <strong>${inv.serviceName || '—'}</strong></div>
      ${inv.serviceAddress ? `<div style="grid-column:span 2;"><span style="color:#64748b;">Address:</span> ${fmtAddr(inv.serviceAddress)}</div>` : ''}
      ${inv.technicianName ? `<div><span style="color:#64748b;">Technician:</span> <strong>${inv.technicianName}</strong></div>` : ''}
    </div>
    <table style="width:100%;border-collapse:collapse;font-size:0.82rem;margin-bottom:12px;">
      <thead><tr style="background:#f1f5f9;"><th style="padding:6px 8px;text-align:left;">Part</th><th style="padding:6px 8px;text-align:center;">Qty</th><th style="padding:6px 8px;text-align:right;">Price</th><th style="padding:6px 8px;text-align:right;">Total</th></tr></thead>
      <tbody>${partsHtml}</tbody>
    </table>
    <div style="border-top:2px solid #e2e8f0;padding-top:10px;">
      ${inspectionFee > 0 ? `<div class="d-flex justify-content-between mb-1"><span>Inspection Fee:</span><strong>₱${Number(inspectionFee).toLocaleString()}</strong></div>` : ''}
      ${travelFee > 0 ? `<div class="d-flex justify-content-between mb-1"><span>Travel Fee:</span><strong>₱${Number(travelFee).toLocaleString()}</strong></div>` : ''}
      <div class="d-flex justify-content-between mb-1"><span>Parts Total:</span><strong>₱${Number(inv.partsTotal || 0).toLocaleString()}</strong></div>
      <div class="d-flex justify-content-between mb-1"><span>Labor:</span><strong>₱${Number(inv.laborCost || 0).toLocaleString()}</strong></div>
      <div class="d-flex justify-content-between mb-1" style="font-size:1rem;border-top:2px solid #059669;padding-top:8px;"><span style="font-weight:700;">Grand Total:</span><strong style="color:#059669;">₱${Number(grandTotal).toLocaleString()}</strong></div>
      ${inv.balanceCollected
        ? `<div class="d-flex justify-content-between mb-1" style="color:#16a34a;"><span>Balance:</span><strong>Paid</strong></div>`
        : balanceDue > 0 ? `<div class="d-flex justify-content-between mb-1" style="color:#d97706;"><span>Balance Due:</span><strong>₱${Number(balanceDue).toLocaleString()}</strong></div>` : ''
      }
    </div>
    ${inspectionHtml}
    ${inv.warranty ? `<div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:10px;margin-top:12px;"><i class="bi bi-shield-check me-1" style="color:#059669;"></i><strong style="color:#059669;">Warranty:</strong> ${inv.warranty.duration} (${inv.warranty.startDate} — ${inv.warranty.endDate})</div>` : ''}
    ${actionsHtml}${notesHtml}
  </div>`;

    Swal.fire({
      title: 'Repair Completed',
      html,
      icon: 'success',
      confirmButtonText: '<i class="bi bi-check-circle me-1"></i> Done',
      confirmButtonColor: '#059669',
      width: 600,
      customClass: { popup: 'swal-wide' },
    }).then(() => {
      if (window.reloadAssignments) window.reloadAssignments();
      location.reload();
    });
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // IMMEDIATE REPAIR EVALUATION
  // ═════════════════════════════════════════════════════════════════════════════

  let _immediateRepairBookingId = null;

  function openImmediateRepairModal(bookingId, customerName) {
    _immediateRepairBookingId = bookingId;
    document.getElementById('immediateRepairInfo').innerHTML = `
    <div class="d-flex align-items-center gap-2 p-2 rounded" style="background:#f0fdf4;border:1px solid #bbf7d0;">
      <i class="bi bi-check-circle" style="color:#059669;"></i>
      <span class="fw-semibold" style="font-size:0.85rem;">${customerName || 'Customer'} — Quotation Approved</span>
    </div>`;
    document.getElementById('immediatePartsAvailable').checked = true;
    document.getElementById('immediateTechAvailable').checked = true;
    document.getElementById('immediateCustomerWants').checked = true;
    document.getElementById('immediateResult').style.display = 'none';
    document.getElementById('evaluateImmediateBtn').disabled = false;
    document.getElementById('evaluateImmediateBtn').innerHTML = '<i class="bi bi-search me-2"></i>Evaluate';
    new bootstrap.Modal(document.getElementById('immediateRepairModal')).show();
  }

  async function evaluateImmediateRepair() {
    const btn = document.getElementById('evaluateImmediateBtn');
    const partsAvail = document.getElementById('immediatePartsAvailable').checked;
    const techAvail = document.getElementById('immediateTechAvailable').checked;
    const custWants = document.getElementById('immediateCustomerWants').checked;
    const allMet = partsAvail && techAvail && custWants;
    const resultEl = document.getElementById('immediateResult');
    resultEl.style.display = 'block';
    if (allMet) {
      resultEl.innerHTML = `
      <div class="alert alert-success py-3" style="border-radius:10px;">
        <i class="bi bi-check-circle-fill me-2"></i><strong>All conditions met!</strong>
        <p class="mb-2 mt-1" style="font-size:0.85rem;">You can start the repair now.</p>
        <button class="btn btn-success btn-sm" onclick="startImmediateRepair()">
          <i class="bi bi-tools me-1"></i>Start Repair Now
        </button>
      </div>`;
      btn.disabled = true;
      btn.innerHTML = '<i class="bi bi-check me-2"></i>Ready';
    } else {
      const missing = [];
      if (!partsAvail) missing.push('Parts not available');
      if (!techAvail) missing.push('Technician not available');
      if (!custWants) missing.push('Customer prefers another day');
      resultEl.innerHTML = `
      <div class="alert alert-warning py-3" style="border-radius:10px;">
        <i class="bi bi-exclamation-triangle me-2"></i><strong>Cannot start immediately</strong>
        <ul class="mb-0 mt-1" style="font-size:0.85rem;">
          ${missing.map(m => `<li>${m}</li>`).join('')}
        </ul>
        <p class="mb-0 mt-2" style="font-size:0.82rem;">The repair will be scheduled for a later date.</p>
      </div>`;
      btn.disabled = true;
      btn.innerHTML = '<i class="bi bi-x me-2"></i>Cannot Proceed';
    }
  }

  async function startImmediateRepair() {
    try {
      const resp = await fetch(`/api/technician/appointments/${_immediateRepairBookingId}/start-repair`, {
        method: 'POST', credentials: 'same-origin'
      });
      const data = await resp.json();
      bootstrap.Modal.getInstance(document.getElementById('immediateRepairModal'))?.hide();
      if (resp.ok && data.success) {
        Swal.fire('Started', 'Repair work is now in progress.', 'success').then(() => location.reload());
      } else {
        Swal.fire('Error', data.error || 'Failed to start repair.', 'error');
      }
    } catch (e) { Swal.fire('Error', 'Network error.', 'error'); }
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // REPAIR SCHEDULING MODAL (Repair Today / Schedule Later)
  // ═════════════════════════════════════════════════════════════════════════════

  let _repairSchedBookingId = null;

  function openRepairSchedulingModal(bookingId, customerName) {
    _repairSchedBookingId = bookingId;
    document.getElementById('repairSchedInfo').innerHTML = `
    <div class="d-flex align-items-center gap-2 p-2 rounded" style="background:#f0fdf4;border:1px solid #bbf7d0;">
      <i class="bi bi-check-circle" style="color:#059669;"></i>
      <span class="fw-semibold" style="font-size:0.85rem;">${customerName || 'Customer'} — Quotation Approved</span>
    </div>`;
    // Reset all steps
    document.getElementById('repairSchedChoice').style.display = 'block';
    document.getElementById('repairSchedChecking').style.display = 'none';
    document.getElementById('repairSchedAvailable').style.display = 'none';
    document.getElementById('repairSchedNotAvailable').style.display = 'none';
    document.getElementById('repairSchedSuccess').style.display = 'none';
    new bootstrap.Modal(document.getElementById('repairSchedulingModal')).show();
  }

  async function checkRepairToday() {
    document.getElementById('repairSchedChoice').style.display = 'none';
    document.getElementById('repairSchedChecking').style.display = 'block';
    try {
      const resp = await fetch(`/api/technician/appointments/${_repairSchedBookingId}/repair-today-choice`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ choice: 'today' }),
        credentials: 'same-origin'
      });
      const data = await resp.json();
      document.getElementById('repairSchedChecking').style.display = 'none';
      if (resp.ok && data.success) {
        document.getElementById('repairSchedAvailable').style.display = 'block';
      } else {
        document.getElementById('repairSchedNotAvailable').style.display = 'block';
        document.getElementById('repairSchedNotAvailReason').textContent = data.message || 'Technician does not have enough remaining working hours today.';
        showScheduleLaterStep();
      }
    } catch (e) {
      document.getElementById('repairSchedChecking').style.display = 'none';
      document.getElementById('repairSchedChoice').style.display = 'block';
      Swal.fire('Error', 'Network error. Please try again.', 'error');
    }
  }

  function showScheduleLaterStep() {
    document.getElementById('repairSchedChoice').style.display = 'none';
    document.getElementById('repairSchedNotAvailable').style.display = 'block';
    document.getElementById('repairSchedNotAvailReason').textContent = document.getElementById('repairSchedNotAvailReason').textContent || 'Customer prefers another day.';
    // Generate next 7 days
    const form = document.getElementById('repairSchedLaterForm');
    const days = [];
    for (let i = 1; i <= 7; i++) {
      const d = new Date();
      d.setDate(d.getDate() + i);
      const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      days.push({ date: d, label: `${dayNames[d.getDay()]}, ${monthNames[d.getMonth()]} ${d.getDate()}`, value: d.toISOString().split('T')[0] });
    }
    form.innerHTML = `
    <div class="mb-3">
      <p class="fw-semibold mb-2" style="font-size:0.85rem;">Preferred Dates (select up to 3):</p>
      <div class="d-flex flex-wrap gap-2" id="repairSchedDates">
        ${days.map(day => `
          <div class="form-check" style="min-width:100px;">
            <input class="form-check-input" type="checkbox" value="${day.value}" id="rdate_${day.value}" onchange="limitRepairDates()">
            <label class="form-check-label" for="rdate_${day.value}" style="font-size:0.82rem;">${day.label}</label>
          </div>
        `).join('')}
      </div>
    </div>
    <div class="mb-3">
      <p class="fw-semibold mb-2" style="font-size:0.85rem;">Preferred Time Window:</p>
      <div class="d-flex flex-wrap gap-2">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="repairSchedTime" value="morning" id="rtime_morning">
          <label class="form-check-label" for="rtime_morning" style="font-size:0.82rem;">Morning (8AM-12PM)</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="repairSchedTime" value="afternoon" id="rtime_afternoon">
          <label class="form-check-label" for="rtime_afternoon" style="font-size:0.82rem;">Afternoon (12PM-5PM)</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="repairSchedTime" value="any" id="rtime_any" checked>
          <label class="form-check-label" for="rtime_any" style="font-size:0.82rem;">Any Time</label>
        </div>
      </div>
    </div>
  `;
  }

  function limitRepairDates() {
    const checkboxes = document.querySelectorAll('#repairSchedDates input[type="checkbox"]');
    const checked = document.querySelectorAll('#repairSchedDates input[type="checkbox"]:checked');
    if (checked.length > 3) {
      checkboxes.forEach(cb => { if (!cb.checked) cb.disabled = true; });
    } else {
      checkboxes.forEach(cb => cb.disabled = false);
    }
  }

  async function startRepairFromScheduling() {
    try {
      const resp = await fetch(`/api/technician/appointments/${_repairSchedBookingId}/start-repair`, {
        method: 'POST', credentials: 'same-origin'
      });
      const data = await resp.json();
      bootstrap.Modal.getInstance(document.getElementById('repairSchedulingModal'))?.hide();
      if (resp.ok && data.success) {
        Swal.fire('Started', 'Repair work is now in progress.', 'success').then(() => {
          loadAssignments(currentFilter, currentPage);
          if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
            showDetail(window._currentDetailId);
          }
        });
      } else {
        Swal.fire('Error', data.error || 'Failed to start repair.', 'error');
      }
    } catch (e) { Swal.fire('Error', 'Network error.', 'error'); }
  }

  async function submitRepairScheduleLater() {
    const checkedDates = document.querySelectorAll('#repairSchedDates input[type="checkbox"]:checked');
    const timeRadio = document.querySelector('input[name="repairSchedTime"]:checked');
    if (checkedDates.length === 0) {
      Swal.fire('Required', 'Please select at least one preferred date.', 'warning');
      return;
    }
    const preferredDates = Array.from(checkedDates).map(cb => cb.value);
    const preferredTime = timeRadio ? timeRadio.value : 'any';
    try {
      const resp = await fetch(`/api/technician/appointments/${_repairSchedBookingId}/repair-today-choice`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ choice: 'later', preferredDates, preferredTime }),
        credentials: 'same-origin'
      });
      const data = await resp.json();
      if (resp.ok && data.success) {
        document.getElementById('repairSchedNotAvailable').style.display = 'none';
        document.getElementById('repairSchedSuccess').style.display = 'block';
        document.getElementById('repairSchedSuccessTitle').textContent = 'Scheduling Request Submitted';
        document.getElementById('repairSchedSuccessMsg').textContent = 'Admin will confirm the final schedule. Customer will be notified.';
      } else {
        Swal.fire('Error', data.error || 'Failed to submit request.', 'error');
      }
    } catch (e) { Swal.fire('Error', 'Network error.', 'error'); }
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // INVENTORY AUTOCOMPLETE (shared by quotation + materials)
  // ═════════════════════════════════════════════════════════════════════════════

  let _invSearchTimer = null;

  function attachInventoryAutocomplete(input, onSelect) {
    const wrap = input.parentElement;
    let dropdown = wrap.querySelector('.inv-autocomplete-list');
    if (!dropdown) {
      dropdown = document.createElement('div');
      dropdown.className = 'inv-autocomplete-list';
      wrap.appendChild(dropdown);
    }
    let activeIdx = -1;

    input.addEventListener('input', function () {
      const q = this.value.trim();
      clearTimeout(_invSearchTimer);
      if (q.length < 1) { dropdown.classList.remove('show'); return; }
      _invSearchTimer = setTimeout(async () => {
        try {
          const resp = await fetch(`/api/technician/tools/search?q=${encodeURIComponent(q)}`, { credentials: 'same-origin' });
          const data = await resp.json();
          if (!data.items || data.items.length === 0) {
            dropdown.innerHTML = '<div class="inv-ac-item" style="color:#94a3b8;cursor:default;">No items found — type custom name</div>';
            dropdown.classList.add('show');
            return;
          }
          dropdown.innerHTML = data.items.map((item, i) => {
            const stockLabel = item.status === 'out_of_stock' ? 'Out of Stock' : item.status === 'low_stock' ? 'Low Stock' : `${item.quantity} in stock`;
            const stockCls = item.status || 'in_stock';
            return `<div class="inv-ac-item" data-idx="${i}">
            <div><span class="inv-ac-name">${item.itemName}</span><br><span class="inv-ac-meta">₱${(item.sellingPrice || item.costPrice || 0).toLocaleString()} · ${item.unit || 'pcs'}</span></div>
            <span class="inv-ac-stock ${stockCls}">${stockLabel}</span>
          </div>`;
          }).join('');
          dropdown.classList.add('show');
          activeIdx = -1;
          dropdown.querySelectorAll('.inv-ac-item[data-idx]').forEach(el => {
            el.addEventListener('mousedown', function (e) {
              e.preventDefault();
              const idx = parseInt(this.dataset.idx);
              onSelect(data.items[idx]);
              dropdown.classList.remove('show');
            });
          });
        } catch (e) { dropdown.classList.remove('show'); }
      }, 300);
    });

    input.addEventListener('keydown', function (e) {
      const items = dropdown.querySelectorAll('.inv-ac-item[data-idx]');
      if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, items.length - 1); items.forEach((el, i) => el.classList.toggle('active', i === activeIdx)); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); items.forEach((el, i) => el.classList.toggle('active', i === activeIdx)); }
      else if (e.key === 'Enter' && activeIdx >= 0 && items[activeIdx]) { e.preventDefault(); items[activeIdx].dispatchEvent(new Event('mousedown')); }
      else if (e.key === 'Escape') { dropdown.classList.remove('show'); }
    });

    input.addEventListener('blur', function () { setTimeout(() => dropdown.classList.remove('show'), 200); });
    input.addEventListener('focus', function () { if (this.value.trim().length >= 1) this.dispatchEvent(new Event('input')); });
  }

  function addQuotationPart(preset) {
    const list = document.getElementById('quotationPartsList');
    const idx = list.children.length;
    const row = document.createElement('div');
    row.className = 'row g-2 mb-2 align-items-end';
    const partId = preset ? (preset._id || '') : '';
    const partName = preset ? preset.itemName : '';
    const partCost = preset ? (preset.sellingPrice || preset.costPrice || 0) : '';
    const partQty = preset ? 1 : 1;
    const partUnit = preset ? (preset.unit || 'pcs') : 'pcs';
    row.innerHTML = `
    <div class="col-5 inv-autocomplete-wrap">
      <input type="hidden" class="part-id" value="${partId}" />
      <input type="text" class="form-control form-control-sm part-name" placeholder="Search parts from inventory..." value="${partName}" style="border-radius:8px;" autocomplete="off" />
      <div class="inv-autocomplete-list"></div>
    </div>
    <div class="col-1"><input type="number" class="form-control form-control-sm part-qty" value="${partQty}" min="1" style="border-radius:8px;" /></div>
    <div class="col-3"><input type="number" class="form-control form-control-sm part-cost" placeholder="₱ Cost" min="0" value="${partCost}" style="border-radius:8px;" /></div>
    <div class="col-1"><span class="form-control form-control-sm" style="border-radius:8px;font-size:0.78rem;background:#f1f5f9;border-color:#e2e8f0;">${partUnit}</span></div>
    <div class="col-2"><button type="button" class="btn btn-sm btn-outline-danger w-100" onclick="this.closest('.row').remove();updateQuotationTotal();" style="border-radius:8px;"><i class="bi bi-trash"></i></button></div>`;
    list.appendChild(row);
    row.querySelectorAll('input').forEach(inp => inp.addEventListener('input', updateQuotationTotal));
    const nameInput = row.querySelector('.part-name');
    attachInventoryAutocomplete(nameInput, function (item) {
      row.querySelector('.part-id').value = item._id;
      nameInput.value = item.itemName;
      row.querySelector('.part-cost').value = item.sellingPrice || item.costPrice || 0;
      row.querySelector('.part-qty').value = 1;
      updateQuotationTotal();
    });
  }

  function updateQuotationTotal() {
    let total = 0;
    document.querySelectorAll('#quotationPartsList .row').forEach(row => {
      const qty = parseInt(row.querySelector('.part-qty')?.value) || 1;
      const cost = parseFloat(row.querySelector('.part-cost')?.value) || 0;
      total += qty * cost;
    });
    total += parseFloat(document.getElementById('quotationLaborCost')?.value) || 0;
    document.getElementById('quotationTotalDisplay').textContent = '\u20B1' + total.toLocaleString();
  }

  document.getElementById('quotationLaborCost')?.addEventListener('input', updateQuotationTotal);

  // ═════════════════════════════════════════════════════════════════════════════
  // ENTERPRISE POST-INSPECTION DECISION: Schedule Later or Decline
  // ═════════════════════════════════════════════════════════════════════════════

  // On page load: restore decision modal if a refresh happened mid-flow
  (async function restoreDecisionModal() {
    try {
      const saved = sessionStorage.getItem('_postInspDecision');
      if (!saved) return;
      const { bookingId, quotationTotal, parts, inventoryStatus } = JSON.parse(saved);
      if (!bookingId) return;
      // Restore in-memory state
      window._inspParts = parts || [];
      window._inspInventoryStatus = inventoryStatus || {};
      // Wait for page to be ready, then re-open
      await new Promise(r => setTimeout(r, 600));
      window.showPostInspectionDecision(bookingId, quotationTotal);
    } catch (e) { sessionStorage.removeItem('_postInspDecision'); }
  })();

  async function showPostInspectionDecision(bookingId, quotationTotal) {
    // Persist state so a page refresh restores the modal
    try {
      sessionStorage.setItem('_postInspDecision', JSON.stringify({
        bookingId,
        quotationTotal,
        parts: window._inspParts || [],
        inventoryStatus: window._inspInventoryStatus || {}
      }));
    } catch (e) { }

    // Check parts availability
    const checkedParts = (window._inspParts || []).filter(p => p.checked);
    const partsWithToolId = checkedParts.filter(p => p.toolId);
    const partsWithoutToolId = checkedParts.filter(p => !p.toolId);
    const outOfStockParts = [];
    const notInInventoryParts = [];
    const availableParts = [];

    for (const p of partsWithToolId) {
      const inv = (window._inspInventoryStatus || {})[p.toolId];
      if (!inv || inv.quantity < p.quantity) {
        outOfStockParts.push(p.name);
      } else {
        availableParts.push(p.name);
      }
    }

    for (const p of partsWithoutToolId) {
      notInInventoryParts.push(p.name);
    }

    const hasOutOfStockParts = outOfStockParts.length > 0;
    const hasNotInInventoryParts = notInInventoryParts.length > 0;
    const hasPartsUnavailable = hasOutOfStockParts || hasNotInInventoryParts;

    // ── Time constraint check: is there a next booking soon? ──
    const parseTime = (t) => {
      if (!t) return null;
      const [h, m] = t.split(':').map(Number);
      return isNaN(h) ? null : h * 60 + (m || 0);
    };
    const currentAssignment = (window._allAssignments || []).find(
      a => (a.bookingId?._id || a.bookingId) === bookingId
    );
    let hasNextBookingSoon = false;
    let nextBookingTime = '';

    if (currentAssignment && currentAssignment.startTime) {
      const currentStart = parseTime(currentAssignment.startTime);
      const now = new Date();
      const nowMinutes = now.getHours() * 60 + now.getMinutes();
      const todayStr = now.toISOString().slice(0, 10);

      const todayBookings = (window._allAssignments || [])
        .filter(a => {
          const bd = new Date(a.bookingDate).toISOString().slice(0, 10);
          return bd === todayStr
            && a._id !== currentAssignment._id
            && a.status !== 'completed' && a.status !== 'cancelled';
        })
        .sort((a, b) => (parseTime(a.startTime) || 9999) - (parseTime(b.startTime) || 9999));

      const nextBooking = todayBookings.find(a => {
        const t = parseTime(a.startTime);
        return t && currentStart !== null && t > currentStart;
      });

      if (nextBooking) {
        const nextStart = parseTime(nextBooking.startTime);
        const elapsed = nowMinutes - currentStart;
        const slotDuration = nextStart - currentStart;
        if (slotDuration > 0 && elapsed > slotDuration * 0.7) {
          hasNextBookingSoon = true;
          nextBookingTime = nextBooking.startTime;
        }
      }
    }

    const disableRepairNow = hasPartsUnavailable || hasNextBookingSoon;

    // Build the HTML content
    let html = `<div style="text-align:left;font-size:0.88rem;">`;

    // ── Quotation summary ──
    if (quotationTotal > 0) {
      html += `<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:12px 16px;margin-bottom:12px;">
        <div style="display:flex;justify-content:space-between;align-items:center;">
          <span style="font-size:0.8rem;color:#475569;"><i class="bi bi-receipt me-1"></i>Quotation Total</span>
          <strong style="font-size:1.1rem;color:#0f172a;">₱${Number(quotationTotal).toLocaleString()}</strong>
        </div>
      </div>`;
    }

    // ── Parts availability list ──
    if (checkedParts.length > 0) {
      html += `<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:12px 16px;margin-bottom:12px;">
        <div style="font-size:0.8rem;font-weight:600;color:#0f172a;margin-bottom:8px;"><i class="bi bi-box-seam me-1"></i>Required Parts</div>`;

      checkedParts.forEach(p => {
        if (!p.toolId) {
          html += `<div style="display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid #f1f5f9;">
            <i class="bi bi-dash-circle" style="color:#94a3b8;font-size:0.82rem;"></i>
            <span style="font-size:0.78rem;color:#64748b;">${p.name}</span>
            <span class="badge bg-secondary" style="font-size:0.58rem;margin-left:auto;">Not in inventory</span>
          </div>`;
        } else {
          const inv = (window._inspInventoryStatus || {})[p.toolId];
          if (inv) {
            const isAvailable = inv.quantity >= p.quantity;
            html += `<div style="display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid #f1f5f9;">
              <i class="bi ${isAvailable ? 'bi-check-circle-fill' : 'bi-x-circle-fill'}" style="color:${isAvailable ? '#059669' : '#dc2626'};font-size:0.82rem;"></i>
              <span style="font-size:0.78rem;color:#1e293b;">${p.name}</span>
              <span style="font-size:0.68rem;color:${isAvailable ? '#059669' : '#dc2626'};font-weight:600;margin-left:auto;">${isAvailable ? 'Available' : 'Out of Stock'}</span>
            </div>`;
          } else {
            html += `<div style="display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid #f1f5f9;">
              <i class="bi bi-dash-circle" style="color:#94a3b8;font-size:0.82rem;"></i>
              <span style="font-size:0.78rem;color:#64748b;">${p.name}</span>
              <span style="font-size:0.68rem;color:#94a3b8;font-weight:500;margin-left:auto;">Status unknown</span>
            </div>`;
          }
        }
      });
      html += `</div>`;
    }

    // ── Out-of-stock / Not-in-inventory warning ──
    if (hasPartsUnavailable) {
      const allUnavailable = [...outOfStockParts, ...notInInventoryParts];
      html += `<div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:12px 16px;margin-bottom:12px;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <i class="bi bi-exclamation-triangle-fill" style="color:#dc2626;font-size:1rem;"></i>
          <strong style="color:#991b1b;font-size:0.85rem;">Immediate Repair Unavailable</strong>
        </div>
        <div style="font-size:0.8rem;color:#7f1d1d;margin-bottom:6px;">One or more required parts are currently unavailable:</div>
        <div style="margin-bottom:8px;">${allUnavailable.map(n => `<span style="display:inline-block;background:#fee2e2;border:1px solid #fca5a5;color:#991b1b;padding:2px 8px;border-radius:4px;font-size:0.7rem;font-weight:600;margin:2px;">${n}</span>`).join('')}</div>
        ${notInInventoryParts.length > 0 ? `<div style="background:#fafafa;border-radius:6px;padding:8px 10px;font-size:0.75rem;color:#7f1d1d;margin-bottom:6px;">
          <strong>Note:</strong> Some parts are not tracked in inventory and cannot be verified.
        </div>` : ''}
        <div style="background:#fafafa;border-radius:6px;padding:8px 10px;font-size:0.75rem;color:#7f1d1d;">
          <strong>What happens next:</strong><br>
          • A <strong>Parts Request</strong> will be automatically created for procurement<br>
          • Booking status will be set to <strong>Waiting for Parts</strong><br>
          • Customer will be notified of the delay<br>
          • Once parts arrive, the repair will be scheduled
        </div>
      </div>`;
    }

    // ── Time constraint warning ──
    if (hasNextBookingSoon && !hasPartsUnavailable) {
      html += `<div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:12px 16px;margin-bottom:12px;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
          <i class="bi bi-clock-history" style="color:#dc2626;font-size:1rem;"></i>
          <strong style="color:#991b1b;font-size:0.85rem;">Insufficient Time for Repair</strong>
        </div>
        <div style="font-size:0.8rem;color:#7f1d1d;">
          Your next booking is scheduled at <strong>${nextBookingTime}</strong>.
          There isn't enough time to complete this repair before then.
        </div>
        <div style="font-size:0.75rem;color:#92400e;margin-top:6px;">
          <strong>Recommendation:</strong> Schedule this repair for a later date.
        </div>
      </div>`;
    }

    if (disableRepairNow) {
      html += `<div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:10px 14px;margin-bottom:12px;">
        <div style="display:flex;align-items:center;gap:8px;">
          <i class="bi bi-lock-fill" style="color:#dc2626;font-size:0.85rem;"></i>
          <span style="font-size:0.82rem;color:#991b1b;font-weight:600;">Repair Now unavailable until parts are in stock</span>
        </div>
      </div>`;
    }

    html += `</div>`;

    // Clear session state
    sessionStorage.removeItem('_postInspDecision');

    // Show the decision modal with three buttons
    const result = await Swal.fire({
      icon: 'question',
      title: hasPartsUnavailable ? 'Parts Unavailable — Choose Next Step' : 'How would you like to proceed?',
      html: html,
      showCancelButton: true,
      showDenyButton: true,
      showConfirmButton: !disableRepairNow,
      confirmButtonText: '<i class="bi bi-tools me-1"></i> Repair Now',
      denyButtonText: '<i class="bi bi-calendar me-1"></i> Schedule Later',
      cancelButtonText: '<i class="bi bi-x-circle me-1"></i> Decline',
      confirmButtonColor: '#059669',
      denyButtonColor: '#2563eb',
      cancelButtonColor: '#dc2626',
      reverseButtons: false,
      allowOutsideClick: false,
      allowEscapeKey: false,
      showLoaderOnConfirm: true,
      showLoaderOnDeny: true,
    });

    if (result.isConfirmed) {
      await handleRepairNow(bookingId);
    } else if (result.isDenied) {
      await handleScheduleLater(bookingId);
