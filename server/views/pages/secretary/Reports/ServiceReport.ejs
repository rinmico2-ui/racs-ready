<!-- Status Breakdown & Recent Activity -->
<div class="row g-3 mb-4">
  <!-- Status Breakdown -->
  <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
    <div class="dash-card bg-white h-100" data-aos="fade-up">
      <div class="card-header-custom border-0 pb-0">
        <h6 class="mb-0 fw-bold" style="color: #1e3a5f; font-size: 1.1rem;">
          <i class="bi bi-pie-chart me-2"></i>Booking Status Breakdown
        </h6>
      </div>
      <div class="card-body px-4 pb-4">
        <div style="height: 220px">
          <canvas id="statusBreakdownChart"></canvas>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Recent Activity Feed -->
  <div class="col-lg-8" data-aos="fade-up" data-aos-delay="300">
    <div class="dash-card bg-white h-100" data-aos="fade-up">
      <div class="card-header-custom border-0 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold" style="color: #1e3a5f; font-size: 1.1rem;">
          <i class="bi bi-activity me-2"></i>Recent Booking Activity
        </h6>
        <span class="badge bg-info-subtle text-info border border-info-subtle">
          Last <%= analytics && analytics.recentBookings ? analytics.recentBookings.length : 0 %> bookings
        </span>
      </div>
      <div class="card-body px-4 pb-4">
        <% if (analytics && analytics.recentBookings && analytics.recentBookings.length > 0) { %>
          <div class="table-responsive" style="max-height: 260px; overflow-y: auto;">
            <table class="table table-sm table-hover">
              <thead class="sticky-top bg-white">
                <tr>
                  <th>Reference</th>
                  <th>Customer</th>
                  <th>Service</th>
                  <th>Technician</th>
                  <th class="text-end">Amount</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% analytics.recentBookings.forEach(function(booking) { %>
                  <tr>
                    <td class="font-monospace small"><%= booking.reference || 'N/A' %></td>
                    <td><%= booking.customer %></td>
                    <td><span class="badge bg-light text-dark"><%= booking.service %></span></td>
                    <td><%= booking.technician %></td>
                    <td class="text-end fw-bold">₱<%= booking.amount ? booking.amount.toLocaleString() : 0 %></td>
                    <td>
                      <% const statusColors = {
                        'completed': 'success',
                        'pending': 'warning',
                        'confirmed': 'info',
                        'scheduled': 'primary',
                        'cancelled': 'danger',
                        'in-progress': 'secondary'
                      }; %>
                      <span class="badge bg-<%= statusColors[booking.status] || 'secondary' %>-subtle text-<%= statusColors[booking.status] || 'secondary' %>">
                        <%= booking.status %>
                      </span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1"></i>
            <p class="mt-2">No recent booking activity</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Technician Performance Table -->
<div class="row g-3 mb-4">
  <div class="col-12" data-aos="fade-up" data-aos-delay="200">
    <div class="dash-card bg-white">
      <div class="card-header-custom border-0 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold" style="color: #1e3a5f; font-size: 1.1rem;">
          <i class="bi bi-people me-2"></i>Technician Performance Leaderboard
        </h6>
        <span class="badge bg-success-subtle text-success border border-success-subtle">
          <%= analytics && analytics.technicianStats ? Object.keys(analytics.technicianStats).length : 0 %> Active Technicians
        </span>
      </div>
      <div class="card-body px-4 pb-4">
        <% if (analytics && analytics.topTechnicians && analytics.topTechnicians.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead class="table-light">
                <tr>
                  <th>Rank</th>
                  <th>Technician</th>
                  <th class="text-center">Total Bookings</th>
                  <th class="text-center">Completed</th>
                  <th class="text-center">Cancelled</th>
                  <th class="text-center">Completion Rate</th>
                  <th class="text-center">Avg Rating</th>
                  <th class="text-end">Revenue Generated</th>
                </tr>
              </thead>
              <tbody>
                <% analytics.topTechnicians.forEach(function(tech, index) { %>
                  <tr>
                    <td>
                      <% if (index === 0) { %>
                        <i class="bi bi-trophy-fill text-warning fs-5"></i>
                      <% } else if (index === 1) { %>
                        <i class="bi bi-trophy-fill text-secondary fs-5"></i>
                      <% } else if (index === 2) { %>
                        <i class="bi bi-trophy-fill" style="color: #cd7f32; font-size: 1.25rem;"></i>
                      <% } else { %>
                        <span class="badge bg-light text-dark">#<%= index + 1 %></span>
                      <% } %>
                    </td>
                    <td class="fw-bold"><%= tech.name %></td>
                    <td class="text-center"><%= tech.totalBookings %></td>
                    <td class="text-center"><span class="badge bg-success-subtle text-success"><%= tech.completedBookings %></span></td>
                    <td class="text-center"><span class="badge bg-danger-subtle text-danger"><%= tech.cancelledBookings %></span></td>
                    <td class="text-center">
                      <div class="d-flex align-items-center justify-content-center">
                        <div class="progress flex-grow-1 me-2" style="height: 6px; width: 60px;">
                          <div class="progress-bar bg-primary tech-completion-bar" data-completion="<%= (tech.completionRate * 100).toFixed(0) %>"></div>
                        </div>
                        <span class="small"><%= (tech.completionRate * 100).toFixed(0) %>%</span>
                      </div>
                    </td>
                    <td class="text-center">
                      <% if (tech.avgRating > 0) { %>
                        <span class="badge bg-warning-subtle text-warning">
                          <i class="bi bi-star-fill me-1"></i><%= tech.avgRating.toFixed(1) %>
                        </span>
                      <% } else { %>
                        <span class="badge bg-light text-muted">No ratings</span>
                      <% } %>
                    </td>
                    <td class="text-end fw-bold text-success">₱<%= tech.revenue.toLocaleString() %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-people fs-1"></i>
            <p class="mt-2">No technician performance data available</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>


<script>
  // Service Analytics Data from Server
  var serviceAnalytics = {
    weeklyData: <%- JSON.stringify(analytics && analytics.weeklyData ? Object.entries(analytics.weeklyData).map(([key, val]) => ({ week: key, bookings: val.bookings, revenue: val.revenue, completed: val.completed })) : []) %>,
    ratingDistribution: <%- JSON.stringify(analytics && analytics.ratingDistribution ? [analytics.ratingDistribution[5], analytics.ratingDistribution[4], analytics.ratingDistribution[3], analytics.ratingDistribution[2], analytics.ratingDistribution[1]] : [0,0,0,0,0]) %>,
    statusBreakdown: <%- JSON.stringify(analytics && analytics.statusBreakdown ? Object.entries(analytics.statusBreakdown).map(([status, count]) => ({ status: status, count: count })) : []) %>,
    dailyTrend: <%- JSON.stringify(analytics && analytics.dailyTrend ? analytics.dailyTrend : []) %>,
    topServices: <%- JSON.stringify(analytics && analytics.topServices ? analytics.topServices : []) %>,
    techUtilization: <%- JSON.stringify(analytics && analytics.techUtilization ? analytics.techUtilization : []) %>,
    weeklyCsat: <%- JSON.stringify(analytics && analytics.weeklyCsat ? analytics.weeklyCsat : []) %>,
    totalBookings: <%= analytics ? analytics.totalBookings : 0 %>,
    completedBookings: <%= analytics ? analytics.completedBookings : 0 %>,
    pendingBookings: <%= analytics ? analytics.pendingBookings : 0 %>,
    cancelledBookings: <%= analytics ? analytics.cancelledBookings : 0 %>,
    inProgressBookings: <%= analytics ? analytics.inProgressBookings : 0 %>,
    avgRating: <%= analytics ? analytics.avgRating : 0 %>,
    totalRevenue: <%= analytics ? analytics.totalRevenue : 0 %>,
    avgBookingValue: <%= analytics ? analytics.avgBookingValue : 0 %>,
    gcashBookings: <%= analytics ? analytics.gcashBookings : 0 %>,
    codBookings: <%= analytics ? analytics.codBookings : 0 %>,
    otherPaymentBookings: <%= analytics ? analytics.otherPaymentBookings : 0 %>,
    coreServiceBookings: <%= analytics ? analytics.coreServiceBookings : 0 %>,
    repairBookings: <%= analytics ? analytics.repairBookings : 0 %>,
    multiServiceBookings: <%= analytics ? analytics.multiServiceBookings : 0 %>,
    technicians: <%- JSON.stringify(analytics && analytics.technicians ? analytics.technicians : []) %>,
    technicianStats: <%- JSON.stringify(analytics && analytics.technicianStats ? analytics.technicianStats : {}) %>,
    topTechnicians: <%- JSON.stringify(analytics && analytics.topTechnicians ? analytics.topTechnicians : []) %>
  };

  function initCharts() {
    document.querySelectorAll('.chart-overlay').forEach(el => el.remove());
    if (typeof Chart === "undefined") { return; }
    // enterprise-level chart styling defaults
    Chart.defaults.font.family = 'Montserrat, Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial';
    Chart.defaults.font.size = 12;
    Chart.defaults.color = '#1e3a5f';
    Chart.defaults.elements.line.borderWidth = 2.5;
    Chart.defaults.elements.point.radius = 4;
    Chart.defaults.elements.point.hoverRadius = 6;
    Chart.defaults.plugins.tooltip.cornerRadius = 6;
    Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(30,58,95,0.9)';
    Chart.defaults.plugins.legend.labels.usePointStyle = true;
    Chart.defaults.plugins.legend.labels.padding = 16;

    var bookingCtx = document.getElementById("serviceBookingTrendChart");
    if (bookingCtx) {
      var gradientBookings = bookingCtx.getContext('2d').createLinearGradient(0, 0, 0, 300);
      gradientBookings.addColorStop(0, 'rgba(6, 182, 212, 0.5)'); // Cyan semi-transparent
      gradientBookings.addColorStop(1, 'rgba(6, 182, 212, 0.05)');

      var gradientCompleted = bookingCtx.getContext('2d').createLinearGradient(0, 0, 0, 300);
      gradientCompleted.addColorStop(0, 'rgba(139, 92, 246, 0.5)'); // Purple semi-transparent
      gradientCompleted.addColorStop(1, 'rgba(139, 92, 246, 0.05)');

      var bookingChart = new Chart(bookingCtx, {
        type: "line",
        data: {
          labels: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
          datasets: [
            {
              label: "Bookings",
              data: [42, 51, 49, 58, 64, 72, 60],
              borderColor: "#06b6d4",
              backgroundColor: gradientBookings,
              borderWidth: 3,
              tension: 0.4,
              fill: true,
              pointBackgroundColor: "#fff",
              pointBorderColor: "#06b6d4",
              pointBorderWidth: 2,
              pointRadius: 4,
            },
            {
              label: "Completed",
              data: [38, 47, 45, 53, 59, 66, 56],
              borderColor: "#8b5cf6",
              backgroundColor: gradientCompleted,
              borderWidth: 3,
              tension: 0.4,
              fill: true,
              pointBackgroundColor: "#fff",
              pointBorderColor: "#8b5cf6",
              pointBorderWidth: 2,
              pointRadius: 4,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: {
            duration: 2000,
            easing: 'easeOutQuart',
            delay: (context) => context.dataIndex * 100
          },
          plugins: { legend: { position: "top", align: "end", labels: { usePointStyle: true, boxWidth: 8 } } },
          scales: {
            x: { grid: { display: false }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } },
            y: { grid: { color: '#CBDDE9', borderDash: [5, 5] }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } }
          },
          onClick: onChartClick.bind(bookingChart, 'Booking Trend Details'),
        },
      });
    }

    var mixCtx = document.getElementById("serviceMixChart");
    if (mixCtx) {
      mixCtx.style.cursor = 'pointer';
      var mixChart = new Chart(mixCtx, {
        type: "doughnut",
        data: {
          labels: ["Cleaning", "Repair", "Installation"],
          datasets: [
            {
              data: [42, 35, 23],
              backgroundColor: ["#06b6d4", "#8b5cf6", "#db2777"],
              borderWidth: 0,
              hoverOffset: 4,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 2000, easing: 'easeOutElastic' },
          plugins: { legend: { display: false } },
          cutout: "75%",
          onClick: onChartClick.bind(mixChart, 'Service Mix Details'),
        },
      });
    }
    // payment method mix
    var payCtx = document.getElementById("paymentMethodChart");
    if (payCtx) {
      payCtx.style.cursor = 'pointer';
      var payChart = new Chart(payCtx, {
        type: "doughnut",
        data: {
          labels: ["Cash", "Card", "Online"],
          datasets: [{
            data: [55, 30, 15],
            backgroundColor: ["#06b6d4", "#8b5cf6", "#db2777"],
            borderWidth: 0,
            hoverOffset: 4,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: "65%",
          animation: { duration: 2000, easing: 'easeOutElastic' },
          plugins: { legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 8 } } },
          onClick: onChartClick.bind(payChart, 'Payment Method Breakdown'),
        }
      });
    }

    // static data for each analytics view (enterprise style)
    const staticData = {
      'Booking Trend Details': [
        { label: 'Mon', value: '42' },
        { label: 'Tue', value: '51' },
        { label: 'Wed', value: '49' },
        { label: 'Thu', value: '58' },
        { label: 'Fri', value: '64' },
        { label: 'Sat', value: '72' },
        { label: 'Sun', value: '60' },
      ],
      'Service Mix Details': [
        { label: 'Cleaning', value: '42%' },
        { label: 'Repair', value: '35%' },
        { label: 'Installation', value: '23%' },
      ],
      'Status Distribution': [
        { label: 'Confirmed', value: '52%' },
        { label: 'Completed', value: '38%' },
        { label: 'Pending', value: '6%' },
        { label: 'Cancelled', value: '4%' },
      ],
      'Technician Utilization': [
        { label: 'Mike', value: '88%' },
        { label: 'Harvey', value: '82%' },
        { label: 'Donna', value: '79%' },
        { label: 'Rachel', value: '74%' },
        { label: 'Louis', value: '69%' },
      ],
      'CSAT Trend': [
        { label: 'W1', value: '4.3' },
        { label: 'W2', value: '4.4' },
        { label: 'W3', value: '4.5' },
        { label: 'W4', value: '4.6' },
        { label: 'W5', value: '4.5' },
        { label: 'W6', value: '4.7' },
      ],
      'Booking Forecast Details': [
        { label: 'Mon', value: '42' },
        { label: 'Tue', value: '51' },
        { label: 'Wed', value: '49' },
        { label: 'Thu', value: '58' },
        { label: 'Fri', value: '64' },
        { label: 'Sat', value: '72' },
        { label: 'Sun', value: '60' },
        { label: 'Mon+', value: '50' },
        { label: 'Tue+', value: '61' },
        { label: 'Wed+', value: '59' },
        { label: 'Thu+', value: '70' },
        { label: 'Fri+', value: '77' },
        { label: 'Sat+', value: '86' },
        { label: 'Sun+', value: '72' },
      ],
      'Payment Method Breakdown': [
        { label: 'Cash', value: '55%' },
        { label: 'Card', value: '30%' },
        { label: 'Online', value: '15%' },
      ],
    };

    // helper used by multiple charts
    function onChartClick(titleText, evt, elements) {
      // always show modal with full data regardless of click location
      const modalEl = document.getElementById('chartDataModal');
      // move modal to body to avoid stacking/transform issues
      if (modalEl.parentNode !== document.body) {
        document.body.appendChild(modalEl);
      }
      modalEl.style.zIndex = '12000';
      modalEl.querySelector('.modal-title').textContent = titleText;
      modalEl.querySelector('#modalDescription').textContent = 'Displaying static analytics details for ' + titleText.toLowerCase() + '.';
      const tbody = modalEl.querySelector('#chartDataTable tbody');
      tbody.innerHTML = '';
      const rows = staticData[titleText] || [];
      rows.forEach(r => {
        const tr = document.createElement('tr');
        const td1 = document.createElement('td'); td1.textContent = r.label;
        const td2 = document.createElement('td'); td2.textContent = r.value;
        tr.appendChild(td1);
        tr.appendChild(td2);
        tbody.appendChild(tr);
      });
      // try bootstrap modal first
      if (window.bootstrap && bootstrap.Modal) {
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
      } else {
        // fallback: manual show
        modalEl.classList.add('show');
        modalEl.style.display = 'block';
        // create backdrop
        const backdrop = document.createElement('div');
        backdrop.className = 'modal-backdrop fade show';
        document.body.appendChild(backdrop);
        // close handler
        modalEl.querySelector('.btn-close').addEventListener('click', () => {
          modalEl.classList.remove('show');
          modalEl.style.display = 'none';
          backdrop.remove();
        }, { once: true });
      }
    }

    // additional charts click handlers
    var statusCtx = document.getElementById("statusChart");
    if (statusCtx) {
      statusCtx.style.cursor = 'pointer';
      var statusChart = new Chart(statusCtx, {
        type: "doughnut",
        data: {
          labels: ["Confirmed", "Completed", "Pending", "Cancelled"],
          datasets: [{ data: [52, 38, 6, 4], backgroundColor: ["#06b6d4", "#8b5cf6", "#eab308", "#ef4444"], borderWidth: 0, hoverOffset: 4 }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: "65%",
          animation: { duration: 2000, easing: 'easeOutCubic' },
          plugins: { legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 8 } } },
          onClick: onChartClick.bind(statusChart, 'Status Distribution'),
        }
      });
    }

    var utilCtx = document.getElementById("techUtilizationChart");
    if (utilCtx) {
      utilCtx.style.cursor = 'pointer';
      var utilChart = new Chart(utilCtx, {
        type: "bar",
        data: {
          labels: ["Mike", "Harvey", "Donna", "Rachel", "Louis"],
          datasets: [
            {
              label: "Utilization %",
              data: [88, 82, 79, 74, 69],
              backgroundColor: "#e0e7ff",
              hoverBackgroundColor: "#6366f1",
              borderRadius: 6,
              barThickness: 12,
            },
          ],
        },
        options: {
          indexAxis: "y",
          maintainAspectRatio: false,
          animation: {
            duration: 1800,
            easing: 'easeOutQuart',
            delay: (context) => context.dataIndex * 150
          },
          plugins: { legend: { display: false } },
          scales: {
            x: { max: 100, grid: { display: false }, ticks: { display: false }, border: { display: false } },
            y: { grid: { display: false }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } }
          },
          onClick: onChartClick.bind(utilChart, 'Technician Utilization')
        },
      });
    }

    var csatCtx = document.getElementById("serviceCsatChart");
    if (csatCtx) {
      var gradientCsat = csatCtx.getContext('2d').createLinearGradient(0, 0, 0, 250);
      gradientCsat.addColorStop(0, 'rgba(219, 39, 119, 0.4)'); // Pink semi-transparent
      gradientCsat.addColorStop(1, 'rgba(219, 39, 119, 0.02)');

      csatCtx.style.cursor = 'pointer';
      var csatChart = new Chart(csatCtx, {
        type: "line",
        data: {
          labels: ["W1", "W2", "W3", "W4", "W5", "W6"],
          datasets: [
            {
              label: "CSAT",
              data: [4.3, 4.4, 4.5, 4.6, 4.5, 4.7],
              borderColor: "#db2777",
              backgroundColor: gradientCsat,
              borderWidth: 3,
              fill: true,
              tension: 0.4,
              pointBackgroundColor: "#fff",
              pointBorderColor: "#db2777",
              pointBorderWidth: 2,
              pointRadius: 4,
            },
          ],
        },
        options: {
          maintainAspectRatio: false,
          animation: {
            duration: 2000,
            easing: 'easeOutBounce'
          },
          plugins: { legend: { display: false } },
          scales: {
            y: { min: 3.5, max: 5.0, grid: { color: '#CBDDE9', borderDash: [5, 5] }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } },
            x: { grid: { display: false }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } }
          },
          onClick: onChartClick.bind(csatChart, 'CSAT Trend')
        },
      });
    }

    var baseData = [42, 51, 49, 58, 64, 72, 60];
    var predicted = baseData.map((v) => Math.round(v * 1.2));

    var forecastCtx = document.getElementById("bookingForecastChart");
    if (forecastCtx && bookingCtx) {
      var baseLabels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
      var forecastChart = new Chart(forecastCtx, {
        type: "line",
        data: {
          labels: baseLabels.concat(baseLabels.map((d) => d + "+")),
          datasets: [
            {
              label: "Historical",
              data: baseData.concat(Array(baseLabels.length).fill(null)),
              borderColor: "#06b6d4",
              borderWidth: 3,
              tension: 0.4,
              fill: false,
              pointBackgroundColor: "#fff",
              pointBorderColor: "#06b6d4",
              pointBorderWidth: 2,
              pointRadius: 4,
            },
            {
              label: "Forecast",
              data: Array(baseLabels.length).fill(null).concat(predicted),
              borderColor: "#db2777",
              borderDash: [5, 5],
              borderWidth: 3,
              tension: 0.4,
              fill: false,
              pointBackgroundColor: "#fff",
              pointBorderColor: "#db2777",
              pointBorderWidth: 2,
              pointRadius: 4,
            },
          ],
        },
        options: {
          maintainAspectRatio: false,
          animation: {
            duration: 2500,
            easing: 'easeOutQuart',
            delay: (context) => context.dataIndex * 50
          },
          plugins: { legend: { position: "top", align: "end", labels: { usePointStyle: true, boxWidth: 8 } } },
          scales: {
            x: { grid: { display: false }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } },
            y: { grid: { color: '#CBDDE9', borderDash: [5, 5] }, ticks: { color: '#829ab1', font: { weight: 'bold' } }, border: { display: false } }
          },
          onClick: onChartClick.bind(forecastChart, 'Booking Forecast Details'),
        },
      });
    }

    // Additional enterprise service analytics charts
    var qualityCtx = document.getElementById("serviceQualityChart");
    if (qualityCtx) {
      new Chart(qualityCtx, {
        type: "line",
        data: {
          labels: ["W1", "W2", "W3", "W4", "W5", "W6"],
          datasets: [{
            label: "First-Time Fix Rate",
            data: [82, 85, 84, 88, 87, 89],
            borderColor: "#8b5cf6",
            backgroundColor: "rgba(139, 92, 246, 0.1)",
            borderWidth: 2,
            fill: true,
            tension: 0.4
          }, {
            label: "Callback Rate",
            data: [8, 6, 7, 4, 5, 3],
            borderColor: "#ef4444",
            borderWidth: 2,
            borderDash: [5, 5],
            fill: false,
            tension: 0.4
          }]
        },
        options: {
          maintainAspectRatio: false,
          plugins: { legend: { position: "top", labels: { boxWidth: 12, font: { size: 10 } } } },
          scales: {
            x: { grid: { display: false } },
            y: { grid: { color: "#e5e7eb" }, beginAtZero: true, max: 100 }
          }
        }
      });
    }

    var responseCtx = document.getElementById("responseTimeChart");
    if (responseCtx) {
      new Chart(responseCtx, {
        type: "bar",
        data: {
          labels: ["<1h", "1-2h", "2-4h", "4-8h", ">8h"],
          datasets: [{
            label: "Bookings",
            data: [45, 82, 68, 34, 12],
            backgroundColor: ["#10b981", "#3b82f6", "#f59e0b", "#f97316", "#ef4444"],
            borderRadius: 4
          }]
        },
        options: {
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false } },
            y: { grid: { color: "#e5e7eb" }, beginAtZero: true }
          }
        }
      });
    }

    var retentionCtx = document.getElementById("retentionFunnelChart");
    if (retentionCtx) {
      new Chart(retentionCtx, {
        type: "bar",
        data: {
          labels: ["First Booking", "Repeat (30d)", "Repeat (90d)", "Loyalty Program", "Referrals"],
          datasets: [{
            label: "Customers",
            data: [1000, 650, 420, 280, 156],
            backgroundColor: ["#3b82f6", "#8b5cf6", "#a855f7", "#d946ef", "#ec4899"],
            borderRadius: 6,
            barThickness: 24
          }]
        },
        options: {
          indexAxis: "y",
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { color: "#e5e7eb" }, beginAtZero: true },
            y: { grid: { display: false } }
          }
        }
      });
    }

    // update projected KPI
    var total = baseData.reduce((a, b) => a + b, 0);
    var proj = predicted.reduce((a, b) => a + b, 0);

    // Initialize technician completion rate bars
    document.querySelectorAll('.tech-completion-bar').forEach(function(bar) {
      var completion = bar.getAttribute('data-completion') || 0;
      bar.style.width = completion + '%';
    });

    // Enterprise Charts - Weekly Trend Analysis
    var weeklyCtx = document.getElementById("weeklyTrendChart");
    if (weeklyCtx && serviceAnalytics.weeklyData.length > 0) {
      var weeklyGradient1 = weeklyCtx.getContext('2d').createLinearGradient(0, 0, 0, 300);
      weeklyGradient1.addColorStop(0, 'rgba(6, 182, 212, 0.5)');
      weeklyGradient1.addColorStop(1, 'rgba(6, 182, 212, 0.05)');
      var weeklyGradient2 = weeklyCtx.getContext('2d').createLinearGradient(0, 0, 0, 300);
      weeklyGradient2.addColorStop(0, 'rgba(139, 92, 246, 0.5)');
      weeklyGradient2.addColorStop(1, 'rgba(139, 92, 246, 0.05)');
      
      new Chart(weeklyCtx, {
        type: "line",
        data: {
          labels: serviceAnalytics.weeklyData.map(function(d) { return d.week; }),
          datasets: [
            {
              label: "Bookings",
              data: serviceAnalytics.weeklyData.map(function(d) { return d.bookings; }),
              borderColor: "#06b6d4",
              backgroundColor: weeklyGradient1,
              borderWidth: 3,
              tension: 0.4,
              fill: true
            },
            {
              label: "Completed",
              data: serviceAnalytics.weeklyData.map(function(d) { return d.completed; }),
              borderColor: "#8b5cf6",
              backgroundColor: weeklyGradient2,
              borderWidth: 3,
              tension: 0.4,
              fill: true
            }
          ]
        },
        options: {
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { position: 'top', align: 'end', labels: { usePointStyle: true } }
          },
          scales: {
            x: { grid: { display: false }, ticks: { color: '#6b7280' } },
            y: { grid: { color: '#e5e7eb' }, ticks: { color: '#6b7280' } }
          }
        }
      });
    }

    // Rating Distribution Chart
    var ratingCtx = document.getElementById("ratingDistributionChart");
    if (ratingCtx) {
      new Chart(ratingCtx, {
        type: "doughnut",
        data: {
          labels: ["5 Stars", "4 Stars", "3 Stars", "2 Stars", "1 Star"],
          datasets: [{
            data: serviceAnalytics.ratingDistribution,
            backgroundColor: ["#10b981", "#3b82f6", "#f59e0b", "#6b7280", "#ef4444"],
            borderWidth: 2,
            borderColor: "#fff"
          }]
        },
        options: {
          maintainAspectRatio: false,
          cutout: "60%",
          plugins: {
            legend: { display: false }
          }
        }
      });
    }

    // Status Breakdown Chart
    var statusBreakdownCtx = document.getElementById("statusBreakdownChart");
    if (statusBreakdownCtx && serviceAnalytics.statusBreakdown.length > 0) {
      var statusColors = {
        'completed': '#10b981',
        'pending': '#f59e0b',
        'confirmed': '#3b82f6',
        'scheduled': '#8b5cf6',
        'cancelled': '#ef4444',
        'in-progress': '#06b6d4',
        'on-the-way': '#ec4899'
      };
      
      new Chart(statusBreakdownCtx, {
        type: "pie",
        data: {
          labels: serviceAnalytics.statusBreakdown.map(function(s) { return s.status; }),
          datasets: [{
            data: serviceAnalytics.statusBreakdown.map(function(s) { return s.count; }),
            backgroundColor: serviceAnalytics.statusBreakdown.map(function(s) { return statusColors[s.status] || '#6b7280'; }),
            borderWidth: 2,
            borderColor: "#fff"
          }]
        },
        options: {
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'right', labels: { boxWidth: 12, font: { size: 10 } } }
          }
        }
      });
    }

    // helper: animate numeric value
    function animateValue(el, start, end, duration, formatFn) {
      var range = end - start;
      var startTime = null;
      function step(ts) {
        if (!startTime) startTime = ts;
        var progress = Math.min((ts - startTime) / duration, 1);
        var val = Math.round(start + range * progress);
        el.innerText = formatFn ? formatFn(val) : val;
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    // helper: create a compact sparkline chart
    function createSparkline(id, data, color) {
      var c = document.getElementById(id);
      if (!c) return null;
      return new Chart(c, {
        type: 'line',
        data: { labels: data.map((_, i) => i + 1), datasets: [{ data: data, borderColor: color, backgroundColor: color.replace('rgb', 'rgba').replace(')', ',0.12)'), fill: true, tension: 0.35 }] },
        options: {
          responsive: true, maintainAspectRatio: false, animation: { duration: 800 },
          plugins: { legend: { display: false }, tooltip: { enabled: false } },
          elements: { point: { radius: 0 } },
          scales: { x: { display: false }, y: { display: false } }
        }
      });
    }

    // render KPI values with animation and sparklines
    var revenuePerBooking = serviceAnalytics.avgBookingValue || 1500;
    var techCount = serviceAnalytics.technicians ? serviceAnalytics.technicians.length : 0;
    var actualTotal = serviceAnalytics.totalBookings || total;

    var elTotal = document.getElementById('kpiTotalBookings');
    var elProj = document.getElementById('kpiProjectedBookings');
    var elRev = document.getElementById('kpiTotalRevenue');
    var elTech = document.getElementById('kpiTechCount');
    var elCompletion = document.getElementById('kpiCompletionRate');

    if (elTotal) animateValue(elTotal, 0, actualTotal, 900, function (v) { return v.toLocaleString(); });
    if (elProj) animateValue(elProj, 0, predicted.reduce(function(a,b){return a+b;}, 0), 900, function (v) { return v.toLocaleString(); });
    if (elRev) animateValue(elRev, 0, serviceAnalytics.totalRevenue || 0, 900, function (v) { return '₱ ' + v.toLocaleString(); });
    if (elTech) animateValue(elTech, 0, techCount, 800, function (v) { return v; });

    // compute a simple completion rate from datasets
    var compRate = serviceAnalytics.totalBookings > 0 ? Math.round((serviceAnalytics.completedBookings / serviceAnalytics.totalBookings) * 1000) / 10 : 0;
    if (elCompletion) elCompletion.innerText = compRate + '%';

    // create sparklines using actual data when available
    var sparkDaily = serviceAnalytics.dailyTrend && serviceAnalytics.dailyTrend.length > 0 ? serviceAnalytics.dailyTrend.map(function(d){return d.bookings;}) : baseData;
    var sparkCompleted = serviceAnalytics.dailyTrend && serviceAnalytics.dailyTrend.length > 0 ? serviceAnalytics.dailyTrend.map(function(d){return d.completed;}) : (bookingChart ? bookingChart.data.datasets[1].data : [38, 47, 45, 53, 59, 66, 56]);
    var techSpark = techCount > 0 ? Array.apply(null, Array(7)).map(function(){return Math.max(1, Math.round(techCount * (0.7 + Math.random() * 0.6)));}) : [5, 5, 6, 5, 5, 4, 5];
    createSparkline('kpiSparkTotalBookings', sparkDaily, '#0d6efd');
    createSparkline('kpiSparkCompletion', sparkCompleted, '#198754');
    createSparkline('kpiSparkRevenue', sparkDaily.map(function(v){return v * revenuePerBooking;}), '#ffc107');
    createSparkline('kpiSparkProjected', predicted, '#0d6efd');
    createSparkline('kpiSparkTechs', techSpark, '#6c757d');

    // CSV export handler
    document.getElementById('exportReportBtn').addEventListener('click', function () {
      var rows = [];
      document.querySelectorAll('table tbody tr').forEach(function (tr) {
        var cols = Array.from(tr.querySelectorAll('td')).map(td => td.innerText.trim());
        rows.push(cols.join(','));
      });
      var csv = 'Service,Bookings,Completion Rate,Avg Revenue,Customer Rating,Status,Payment Method,Technician,Booking Date,Revenue\n' + rows.join('\n');
      var blob = new Blob([csv], { type: 'text/csv' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a'); a.href = url; a.download = 'service-report.csv'; a.click();
      URL.revokeObjectURL(url);
    });
  }

  function waitForInit() {
    if (typeof Chart === 'undefined') {
      setTimeout(waitForInit, 100);
      return;
    }
    requestAnimationFrame(function() { setTimeout(initCharts, 50); });
  }

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', waitForInit);
  } else {
    waitForInit();
  }
</script>


