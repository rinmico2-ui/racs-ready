      }
    } catch (e) { Swal.fire({ icon: 'error', title: 'Error', text: 'Network error.', confirmButtonColor: '#2563eb', confirmButtonText: '<i class="bi bi-check-lg"></i> OK', iconColor: '#dc2626' }); }
  };

  // ── POS-style toast for stock update feedback ─────────────────────────
  let _rpToastTimer;
  function createRpToastModal() {
    const overlay = document.createElement('div');
    overlay.id = 'rpToastModal';
    overlay.className = 'rp-toast-overlay';
    overlay.innerHTML = `
      <div class="rp-toast-modal">
        <div class="rp-toast-header">
          <span class="rp-toast-title">Success</span>
          <button class="rp-toast-close" onclick="closeRpToast()"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="rp-toast-body">
          <div class="rp-toast-icon success"><i class="bi bi-check-circle-fill"></i></div>
          <p class="rp-toast-message"></p>
          <button class="rp-toast-ok" onclick="closeRpToast()">OK</button>
        </div>
      </div>
    `;
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeRpToast(); });
    document.body.appendChild(overlay);
    return overlay;
  }

  function showRpToast(msg, type = 'info') {
    let overlay = document.getElementById('rpToastModal');
    if (!overlay) overlay = createRpToastModal();
    const titleMap = { success: 'Success', error: 'Error', warning: 'Warning', info: 'Info' };
    const iconMap = { success: 'bi-check-circle-fill', error: 'bi-x-circle-fill', warning: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' };
    const typeClass = { success: 'success', error: 'error', warning: 'warning', info: 'info' };
    const t = titleMap[type] ? type : 'info';
    overlay.querySelector('.rp-toast-title').textContent = titleMap[t];
    overlay.querySelector('.rp-toast-icon').className = `rp-toast-icon ${typeClass[t]}`;
    overlay.querySelector('.rp-toast-icon i').className = `bi ${iconMap[t]}`;
    overlay.querySelector('.rp-toast-message').textContent = msg;
    overlay.classList.add('show');
    if (_rpToastTimer) clearTimeout(_rpToastTimer);
    _rpToastTimer = setTimeout(() => closeRpToast(), 2500);
  }

  function closeRpToast() {
    const overlay = document.getElementById('rpToastModal');
    if (overlay) overlay.classList.remove('show');
    if (_rpToastTimer) clearTimeout(_rpToastTimer);
  }

  let _rpConfirmResolve;
  function showRpConfirm(title, message, confirmText, cancelText, type = 'warning') {
    return new Promise((resolve) => {
      _rpConfirmResolve = resolve;
      let overlay = document.getElementById('rpConfirmModal');
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.id = 'rpConfirmModal';
        overlay.className = 'rp-confirm-overlay';
        overlay.innerHTML = `
          <div class="rp-confirm-modal">
            <div class="rp-confirm-header">
              <span class="rp-confirm-title"></span>
              <button class="rp-confirm-close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="rp-confirm-body">
              <div class="rp-confirm-icon"><i class="bi"></i></div>
              <div class="rp-confirm-message"></div>
              <div class="rp-confirm-actions">
                <button class="rp-confirm-cancel"></button>
                <button class="rp-confirm-delete"></button>
              </div>
            </div>
          </div>
        `;
        overlay.addEventListener('click', (e) => { if (e.target === overlay) closeRpConfirm(false); });
        overlay.querySelector('.rp-confirm-close').addEventListener('click', () => closeRpConfirm(false));
        document.body.appendChild(overlay);
      }
      const typeMap = { success: 'success', error: 'error', warning: 'warning', info: 'info' };
      const iconMap = { success: 'bi-check-circle-fill', error: 'bi-x-circle-fill', warning: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' };
      const t = typeMap[type] ? type : 'warning';
      overlay.querySelector('.rp-confirm-title').textContent = title;
      overlay.querySelector('.rp-confirm-icon').className = `rp-confirm-icon ${t}`;
      overlay.querySelector('.rp-confirm-icon i').className = `bi ${iconMap[t]}`;
      overlay.querySelector('.rp-confirm-message').innerHTML = message;
      overlay.querySelector('.rp-confirm-cancel').textContent = cancelText || 'Cancel';
      overlay.querySelector('.rp-confirm-delete').textContent = confirmText || 'Delete';
      overlay.querySelector('.rp-confirm-cancel').onclick = () => closeRpConfirm(false);
      overlay.querySelector('.rp-confirm-delete').onclick = () => closeRpConfirm(true);
      overlay.classList.add('show');
    });
  }

  function closeRpConfirm(value) {
    const overlay = document.getElementById('rpConfirmModal');
    if (overlay) overlay.classList.remove('show');
    if (_rpConfirmResolve) { _rpConfirmResolve(value); _rpConfirmResolve = null; }
  }

  // ── Stock Adjustment Modal ────────────────────────────────────────────
  window.openStockModal = function(id) {
    const p = allParts.find(x => x._id === id);
    if (!p) return;
    document.getElementById('stockPartId').value = id;
    document.getElementById('stockPartName').textContent = p.itemName;
    document.getElementById('stockCurrentQty').textContent = p.quantity || 0;
    document.getElementById('stockAdjustQty').value = 1;
    document.getElementById('stockNotes').value = '';
    stockType = 'in';
    setStockType('in');
    updateAfterQty();
    new bootstrap.Modal(document.getElementById('stockModal')).show();
  };

  window.setStockType = function(type) {
    stockType = type;
    const inBtn = document.getElementById('stockInBtn');
    const outBtn = document.getElementById('stockOutBtn');
    if (type === 'in') {
      inBtn.style.borderColor = '#22c55e'; inBtn.style.background = '#f0fdf4'; inBtn.style.color = '#16a34a';
      outBtn.style.borderColor = '#e2e8f0'; outBtn.style.background = '#fff'; outBtn.style.color = '#64748b';
    } else {
      outBtn.style.borderColor = '#ef4444'; outBtn.style.background = '#fef2f2'; outBtn.style.color = '#dc2626';
      inBtn.style.borderColor = '#e2e8f0'; inBtn.style.background = '#fff'; inBtn.style.color = '#64748b';
    }
    updateAfterQty();
  };

  window.updateAfterQty = function() {
    const partId = document.getElementById('stockPartId').value;
    const p = allParts.find(x => x._id === partId);
    if (!p) return;
    const current = p.quantity || 0;
    const adj = parseInt(document.getElementById('stockAdjustQty').value) || 0;
    const after = stockType === 'in' ? current + adj : Math.max(0, current - adj);
    document.getElementById('stockAfterQty').textContent = after;
    document.getElementById('stockAfterQty').style.color = after <= (p.minStockLevel || 0) ? '#dc2626' : '#1e293b';
  };

  let _procureStockAdjusted = false;
  window.submitStockAdjustment = async function() {
    const partId = document.getElementById('stockPartId').value;
    const qty = parseInt(document.getElementById('stockAdjustQty').value) || 0;
    if (qty <= 0) { Swal.fire({ icon: 'warning', title: 'Required', text: 'Enter a quantity.', confirmButtonColor: '#2563eb', confirmButtonText: '<i class="bi bi-check-lg"></i> OK', iconColor: '#f59e0b' }); return; }

    const reasonEl = document.getElementById('stockReason');
    let reason = reasonEl ? reasonEl.value : null;
    // Ensure reason is always a valid enum value or null; never send empty string
    if (reason === '') reason = null;
    const notes = document.getElementById('stockNotes').value.trim();
    const type = stockType === 'in' ? 'stock_in' : 'stock_out';
    const delta = stockType === 'in' ? qty : -qty;

    const btn = document.getElementById('stockConfirmBtn');
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing...'; }

    try {
      const res = await fetch(`/api/admin/tools/${partId}/adjust-stock`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ type, delta, reason, notes })
      });
      if (res.ok) {
        const data = await res.json();
        const t = data.tool;
        _procureStockAdjusted = true;
        bootstrap.Modal.getInstance(document.getElementById('stockModal'))?.hide();
        showRpToast(`${stockType === 'in' ? '+' : '-'}${qty} → ${t.quantity} ${t.unit || 'pcs'}`, 'success');
        await loadParts();
        if (_procureBookingId && _currentProcurePart && t) {
          await window.linkProcuredPart(_procureBookingId, t._id, _currentProcurePart.name || t.itemName, t.quantity);
        }
      } else {
        const data = await res.json();
        console.error('[STOCK] Adjustment failed:', data);
        Swal.fire({ icon: 'error', title: 'Stock Adjustment Failed', html: `<div style="text-align:left;font-size:0.9rem;"><strong>Error:</strong> ${esc(data.error || 'Unknown error')}<br><br><strong>Details:</strong><br>Part ID: ${esc(partId)}<br>Type: ${esc(type)}<br>Delta: ${delta}<br>Reason: ${esc(reason || 'none')}</div>`, confirmButtonColor: '#2563eb', confirmButtonText: '<i class="bi bi-check-lg"></i> OK', iconColor: '#dc2626' });
      }
    } catch (e) { 
      console.error('[STOCK] Network error:', e);
      Swal.fire({ icon: 'error', title: 'Error', text: `Network error: ${e.message}`, confirmButtonColor: '#2563eb', confirmButtonText: '<i class="bi bi-check-lg"></i> OK', iconColor: '#dc2626' }); 
    }
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Confirm Adjustment'; }
  };

  // ── Helpers ───────────────────────────────────────────────────────────
  function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  // ── Booking-procure mode ──────────────────────────────────────────────
  let _procureBookingId = null;
  let _procureParts = [];
  let _procureQueue = [];
  let _currentProcurePart = null;
  let _procureProcessing = false;
  let _procureFinalizing = false;
  let _procureSkippedParts = [];

  // ── Project-procure mode ──────────────────────────────────────────────
  let _procureProjectId = null;

  function getQueryParam(name) {
    const p = new URLSearchParams(window.location.search);
    return p.get(name);
  }

  async function fetchQuotationParts(bookingId) {
    try {
      const res = await fetch(`/api/admin/repair-scheduling-queue/${bookingId}/quotation-parts`, {
        credentials: 'same-origin',
      });
      if (!res.ok) return null;
      const data = await res.json();
      return data.parts || [];
    } catch (e) {
      console.error('[PROCURE] Failed to fetch quotation parts:', e);
      return null;
    }
  }

  function openProcureAddPart(part) {
    const qty = part.quantity || 1;
    const cost = part.cost || 0;
    const sell = cost * 1.3;

    document.getElementById('partEditId').value = '';
    document.getElementById('partModalTitle').textContent = `Procure: ${part.name}`;
    document.getElementById('partModalSub').textContent = _procureProjectId
      ? `Reserved resource for project ${_procureProjectId.slice(-6).toUpperCase()}`
      : `Quotation part for booking ${_procureBookingId?.slice(-6)?.toUpperCase() || ''}`;
    document.getElementById('partSaveBtn').innerHTML = '<i class="bi bi-plus-lg me-1"></i>Add Part';
    document.getElementById('partName').value = part.name || '';
    document.getElementById('partUnit').value = 'pcs';
    document.getElementById('partCategory').value = 'General';
    document.getElementById('partSpec').value = '';
    document.getElementById('partCostPrice').value = cost;
    document.getElementById('partSellingPrice').value = sell.toFixed(2);
    document.getElementById('partQty').value = qty;
    document.getElementById('partMinStock').value = Math.max(1, qty);
    document.getElementById('partSupplier').value = '';
    document.getElementById('partDesc').value = _procureProjectId
      ? `Reserved resource for project ${_procureProjectId}`
      : `Needed for repair service${_procureBookingId ? ` (Booking: ${_procureBookingId})` : ''}`;
    document.getElementById('partType').value = 'part';
    const merchandiseClass = document.querySelector('input[name="partInventoryClass"][value="merchandise"]');
    if (merchandiseClass) merchandiseClass.checked = true;
    document.getElementById('partAssetCode').value = '';
    document.getElementById('partSerialNumber').value = '';
    updateInventoryClassForm();
    document.getElementById('partMargin').dispatchEvent(new Event('input'));
    new bootstrap.Modal(document.getElementById('partModal')).show();
  }

  function updateProcureBanner() {
    const el = document.getElementById('procureCount');
    if (el) el.textContent = _procureQueue.length;
    if (_procureQueue.length === 0) {
      const banner = document.getElementById('procureBanner');
      const hasSkipped = _procureSkippedParts.length > 0;
      if (banner) {
        const isProject = !!_procureProjectId;
        const returnLabel = isProject ? 'Return to Project' : 'Return to Queue';
        const returnAction = isProject ? `finalizeProcurement()` : 'finalizeProcurement()';
        if (hasSkipped) {
          const skippedList = _procureSkippedParts.map(name => `<li>${esc(name)}</li>`).join('');
          banner.innerHTML = `
            <i class="bi bi-exclamation-triangle-fill" style="font-size:1.2rem;color:#d97706;"></i>
            <div style="flex:1;">
              <div style="font-weight:600;color:#92400e;font-size:0.85rem;">Some Parts Were Skipped — Still Out of Stock</div>
              <div style="font-size:0.78rem;color:#92400e;">These parts were NOT procured and still have insufficient stock:<ul style="margin:4px 0 0 1rem;padding:0;">${skippedList}</ul>Reserving parts will keep failing until these are actually stocked.</div>
            </div>
            <button class="btn btn-sm btn-warning fw-semibold" id="returnToQueueBtn" onclick="${returnAction}" style="border-radius:8px;">
              <i class="bi bi-arrow-left me-1"></i>${returnLabel} Anyway
            </button>
          `;
          banner.style.background = '#fffbeb';
          banner.style.borderColor = '#fde68a';
        } else {
          banner.innerHTML = `
            <i class="bi bi-check-circle-fill" style="font-size:1.2rem;color:#16a34a;"></i>
            <div style="flex:1;">
              <div style="font-weight:600;color:#166534;font-size:0.85rem;">Procurement Items Processed</div>
              <div style="font-size:0.78rem;color:#16a34a;" id="procureFinalMsg">${isProject ? 'Items checked. Click below when ready to return to your project.' : 'Reserving stock and updating booking...'}</div>
            </div>
            <button class="btn btn-sm btn-primary fw-semibold" id="returnToQueueBtn" onclick="${returnAction}" style="border-radius:8px;">
              <i class="bi bi-arrow-left me-1"></i>${returnLabel}
            </button>
          `;
          banner.style.background = '#f0fdf4';
          banner.style.borderColor = '#bbf7d0';
        }
      }
      // Only auto-finalize (and auto-redirect) when every part actually got
      // stocked. If anything was skipped, wait for the admin to explicitly
      // acknowledge it above instead of silently treating skip as success.
      if (!hasSkipped && !_procureProjectId && _procureBookingId && !_procureFinalizing) {
        _procureFinalizing = true;
        setTimeout(window.finalizeProcurement, 150);
      }
    }
  }

  function processNextProcure() {
    if (_procureProcessing || _procureQueue.length === 0) {
      updateProcureBanner();
      return;
    }
    _procureProcessing = true;
    const part = _procureQueue.shift();
    _currentProcurePart = part;
    const neededQty = part.quantity || 1;
    const nameLower = (part.name || '').toLowerCase();
    const existing = allParts.find(p => p.itemName?.toLowerCase() === nameLower);
    if (!existing) {
      _procurePartSaved = false;
      openProcureAddPart(part);
      const onModalClose = () => {
        document.getElementById('partModal').removeEventListener('hidden.bs.modal', onModalClose);
        if (!_procurePartSaved) {
          _procureQueue.unshift(part);
          _procureProcessing = false;
          updateProcureBanner();
          Swal.fire({ icon: 'warning', title: 'Part Skipped', html: '<strong>' + esc(part.name) + '</strong> was not added to inventory.<br>The procurement queue will wait for this part.', confirmButtonText: '<i class="bi bi-arrow-repeat"></i> Re-open Form', showCancelButton: true, cancelButtonText: '<i class="bi bi-x-lg"></i> Skip for Now', confirmButtonColor: '#2563eb', cancelButtonColor: '#64748b', iconColor: '#f59e0b', reverseButtons: true }).then(result => {
            if (result.isConfirmed) { processNextProcure(); } else { if (!_procureSkippedParts.includes(part.name)) _procureSkippedParts.push(part.name); _procureQueue = _procureQueue.filter(p => p !== part); _procureProcessing = false; processNextProcure(); }
          });
        } else { _procureProcessing = false; processNextProcure(); }
      };
      document.getElementById('partModal').addEventListener('hidden.bs.modal', onModalClose);
    } else if (!!_procurePartName || (existing.quantity || 0) < neededQty) {
      _procureStockAdjusted = false;
      const shortfall = Math.max(1, neededQty - (existing.quantity || 0));
      document.getElementById('stockPartId').value = existing._id;
      document.getElementById('stockPartName').textContent = existing.itemName;
      document.getElementById('stockCurrentQty').textContent = existing.quantity || 0;
      document.getElementById('stockAdjustQty').value = shortfall;
      document.getElementById('stockNotes').value = _procureProjectId ? 'Procurement for project ' + _procureProjectId : 'Procurement for repair booking';
      stockType = 'in'; setStockType('in'); updateAfterQty();
      const modal = new bootstrap.Modal(document.getElementById('stockModal'));
      modal.show();
      const onStockModalClose = () => {
        document.getElementById('stockModal').removeEventListener('hidden.bs.modal', onStockModalClose);
        if (!_procureStockAdjusted) {
          _procureQueue.unshift(part); _procureProcessing = false; updateProcureBanner();
          Swal.fire({ icon: 'warning', title: 'Stock Not Adjusted', html: '<strong>' + esc(part.name) + '</strong> stock was not updated.<br>Current: ' + (existing.quantity || 0) + ', Needed: ' + neededQty, confirmButtonText: '<i class="bi bi-arrow-repeat"></i> Re-open Adjustment', showCancelButton: true, cancelButtonText: '<i class="bi bi-x-lg"></i> Skip for Now', confirmButtonColor: '#2563eb', cancelButtonColor: '#64748b', iconColor: '#f59e0b', reverseButtons: true }).then(result => {
            if (result.isConfirmed) { processNextProcure(); } else { if (!_procureSkippedParts.includes(part.name)) _procureSkippedParts.push(part.name); _procureQueue = _procureQueue.filter(p => p !== part); _procureProcessing = false; processNextProcure(); }
          });
        } else { _procureProcessing = false; processNextProcure(); }
      };
      document.getElementById('stockModal').addEventListener('hidden.bs.modal', onStockModalClose);
    } else { _procureProcessing = false; processNextProcure(); }
  }

  // ── Link Procured Part to Booking ─────────────────────────────────────
  window.linkProcuredPart = async function(bookingId, toolId, partName, quantity) {
    if (!bookingId || !toolId || !partName) return;
    try {
      const res = await fetch(`/api/admin/repair-scheduling-queue/${bookingId}/link-procured-part`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ toolId, partName, quantity }),
      });
      const data = await res.json();
      if (!res.ok) console.warn('[PROCURE] Link part warning:', data.error);
    } catch (e) {
      console.error('[PROCURE] Link part error:', e.message);
    }
  };

  // ── Finalize Procurement ──────────────────────────────────────────────
  window.finalizeProcurement = async function() {
    _procureFinalizing = true;
    const btn = document.getElementById('returnToQueueBtn');
    const msg = document.getElementById('procureFinalMsg');
    if (btn) btn.disabled = true;
    if (msg) msg.textContent = 'Reserving stock and updating...';
    try {
      let res, data;
      if (_procureProjectId) {
        res = await fetch(`/api/projects/${_procureProjectId}/materials`, {
          method: 'GET',
          credentials: 'same-origin',
        });
        data = await res.json();
        if (res.ok) {
          if (msg) msg.textContent = 'All parts ready. Redirecting to project...';
          if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Redirecting...'; }
          setTimeout(() => { window.location.href = `/admin/projects/${_procureProjectId}`; }, 1500);
        } else {
          if (msg) msg.textContent = 'Error: ' + (data.error || 'Failed');
          if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-left me-1"></i>Return to Project'; btn.onclick = () => { window.location.href = `/admin/projects/${_procureProjectId}`; }; }
        }
      } else {
        res = await fetch(`/api/admin/repair-scheduling-queue/${_procureBookingId}/check-and-procure-parts`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: '{}',
        });
        data = await res.json();
        if (res.ok) {
          const isAiPreparation = data.workflowPhase === 'phase_1_ai_preparation';
          if (msg) msg.textContent = data.allReady
            ? (isAiPreparation
                ? 'Stock reserved. Returning to Repair Parts & Scheduling; the technician workflow is ready to continue...'
                : 'Stock reserved. Returning to Repair Parts & Scheduling for phase 2...')
            : 'Some parts still require procurement. Returning to Repair Parts & Scheduling...';
          if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Redirecting...'; }
          // Replace the procurement URL so Back does not reopen the completed
          // stock-adjustment flow and accidentally process the same part again.
          setTimeout(() => {
            window.location.replace('/admin/appointments/repair-scheduling');
          }, 700);
        } else {
          if (msg) msg.textContent = 'Error: ' + (data.error || 'Failed to finalize') + ' — redirecting back...';
          if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Redirecting...'; }
          setTimeout(() => { window.location.href = '/admin/appointments/repair-scheduling'; }, 2000);
        }
      }
    } catch (e) {
      const returnUrl = _procureProjectId ? `/admin/projects/${_procureProjectId}` : '/admin/appointments/repair-scheduling';
      const returnLabel = _procureProjectId ? 'Return to Project' : 'Return to Queue';
      if (msg) msg.textContent = 'Network error. Redirecting back automatically...';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Redirecting...';
      }
      setTimeout(() => { window.location.href = returnUrl; }, 2000);
    }
  };

  // ── Fetch project reserved materials ──────────────────────────────────
  async function fetchProjectMaterials(projectId) {
    try {
      const res = await fetch(`/api/projects/${projectId}/materials`, { credentials: 'same-origin' });
      if (!res.ok) return null;
      const data = await res.json();
      return (data.materials || []).map(m => ({
        name: m.itemName,
        quantity: m.quantity || 1,
        toolId: m.sourceId || null,
      }));
    } catch (e) {
      console.error('[PROCURE] Failed to fetch project materials:', e);
      return null;
    }
  }

  // ── Initial Load ──────────────────────────────────────────────────────
  _procureBookingId = getQueryParam('bookingId');
  _procureProjectId = getQueryParam('projectId');
  const _procureMode = getQueryParam('procure');
  const _procurePartName = getQueryParam('partName');
  const _procurePartQty = parseInt(getQueryParam('partQty')) || 1;

  if (_procureProjectId && _procureMode === 'true') {
    // Project-procure mode
    loadParts().then(async () => {
      let materials = [];
      if (_procurePartName) {
        materials = [{ name: _procurePartName, quantity: _procurePartQty, toolId: null }];
      } else {
        const fetched = await fetchProjectMaterials(_procureProjectId);
        if (fetched) materials = fetched;
      }
      
      if (materials && materials.length > 0) {
        _procureParts = materials;
        _procureQueue = [...materials];
        _procureSkippedParts = [];
        const container = document.querySelector('.rp-inner');
        const banner = document.createElement('div');
        banner.id = 'procureBanner';
        banner.style.cssText = 'background:#eff6ff;border:1px solid #93c5fd;border-radius:12px;padding:14px 18px;margin-bottom:16px;display:flex;align-items:center;gap:12px;';
        banner.innerHTML = `
          <i class="bi bi-box-seam" style="font-size:1.2rem;color:#2563eb;"></i>
          <div style="flex:1;">
            <div style="font-weight:600;color:#1e40af;font-size:0.85rem;">Procuring Resources for Project</div>
            <div style="font-size:0.78rem;color:#1e40af;">
              <span id="procureCount">${materials.length}</span> resource(s) need to be added to inventory.
              Missing parts will auto-open the Add Part form.
            </div>
          </div>
          <a href="/admin/projects/${_procureProjectId}" style="font-size:0.78rem;font-weight:600;color:#1e40af;text-decoration:none;white-space:nowrap;">Back to Project</a>
          <button class="btn btn-sm btn-light fw-semibold" onclick="document.getElementById('procureBanner').remove();" style="border-radius:8px;border:1px solid #93c5fd;">
            <i class="bi bi-x-lg"></i>
          </button>
        `;
        container.insertBefore(banner, container.firstChild);
        setTimeout(processNextProcure, 500);
      } else {
        loadParts();
      }
    });
  } else if (_procureBookingId) {
    // Booking-procure mode
    loadParts().then(async () => {
      const parts = await fetchQuotationParts(_procureBookingId);
      if (parts && parts.length > 0) {
        _procureParts = parts;
        _procureQueue = [...parts];
        _procureSkippedParts = [];
        const container = document.querySelector('.rp-inner');
        const banner = document.createElement('div');
        banner.id = 'procureBanner';
        banner.style.cssText = 'background:#fef3c7;border:1px solid #fbbf24;border-radius:12px;padding:14px 18px;margin-bottom:16px;display:flex;align-items:center;gap:12px;';
        banner.innerHTML = `
          <i class="bi bi-truck" style="font-size:1.2rem;color:#b45309;"></i>
          <div style="flex:1;">
            <div style="font-weight:600;color:#92400e;font-size:0.85rem;">Procuring Parts for Booking</div>
            <div style="font-size:0.78rem;color:#92400e;">
              <span id="procureCount">${parts.length}</span> part(s) need to be added to inventory.
              Missing parts will auto-open the Add Part form.
            </div>
          </div>
          <button class="btn btn-sm btn-light fw-semibold" onclick="document.getElementById('procureBanner').remove();" style="border-radius:8px;border:1px solid #fbbf24;">
            <i class="bi bi-x-lg"></i>
          </button>
        `;
        container.insertBefore(banner, container.firstChild);
        setTimeout(processNextProcure, 500);
      } else if (parts) {
        _procureFinalizing = true;
        window.finalizeProcurement();
      }
    });
  } else if (getQueryParam('prefillName')) {
    // Daily-kit notification prefill: open Add Item modal with pre-filled values
    loadParts().then(() => {
      const name = getQueryParam('prefillName');
      const type = getQueryParam('prefillType') || 'equipment';
      const qty = getQueryParam('prefillQty') || '1';

      openPartModal();
      document.getElementById('partModalTitle').textContent = 'Add Equipment from Notification';
      document.getElementById('partModalSub').textContent = 'Requested by technician — fill in remaining details';
      document.getElementById('partName').value = name;
      document.getElementById('partType').value = type;
      document.getElementById('partQty').value = qty;
      if (type === 'equipment') {
        document.querySelector('input[name="partInventoryClass"][value="operational_asset"]').checked = true;
        updateInventoryClassForm();
        document.getElementById('partAssignable').checked = true;
      }
    });
  } else {
    loadParts();
  }
})();
</script>
