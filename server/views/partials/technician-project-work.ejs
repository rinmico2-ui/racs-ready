  };

  window.pwSubmitInspection = async (pid) => {
    // Fetch project to check for unitGroups
    let project = null;
    try {
      const resp = await api(`/api/projects/${pid}/repair-summary`);
      project = resp.project || resp;
    } catch (_) {}

    const unitGroups = project?.unitGroups || [];
    const hasMultipleTypes = unitGroups.length > 1;

    const findings = prompt('Inspection findings (describe what you observed on site):');
    if (findings === null) return;
    const notes = prompt('Additional notes (optional):') || '';

    let unitGroupInspections = [];

    if (hasMultipleTypes) {
      // Per-group inspection flow
      for (const group of unitGroups) {
        const groupFindings = prompt(`[${group.unitType}${group.brand ? ' (' + group.brand + ')' : ''}] — ${group.quantity} unit(s)\nInspection findings for this appliance type:`);
        if (groupFindings === null) continue;

        const groupNotes = prompt(`[${group.unitType}] Additional notes (optional):`) || '';

        // Quotation for this group
        const numItems = prompt(`[${group.unitType}] How many quotation items?`, '1');
        const count = parseInt(numItems) || 0;
        const parts = [];
        for (let i = 0; i < count; i++) {
          const desc = prompt(`[${group.unitType}] Item ${i+1} description:`);
          if (desc === null) break;
          const qty = parseFloat(prompt(`[${group.unitType}] Item ${i+1} quantity:`, '1') || '1');
          const price = parseFloat(prompt(`[${group.unitType}] Item ${i+1} unit price (₱):`, '0') || '0');
          parts.push({ name: desc, quantity: qty, cost: price });
        }
        const laborCost = parseFloat(prompt(`[${group.unitType}] Labor cost (₱):`, '0') || '0');
        const groupTotal = parts.reduce((s, p) => s + (p.quantity * p.cost), 0) + laborCost;

        unitGroupInspections.push({
          groupIndex: group.groupIndex,
          inspection: {
            findings: groupFindings,
            notes: groupNotes,
            severity: '',
            damagedParts: [],
            recommendedAction: '',
          },
          quotation: {
            parts,
            laborCost,
            totalCost: groupTotal,
            notes: groupNotes,
          },
        });
      }
    }

    // Top-level quotation items (for single-type or combined)
    const numItems = prompt('How many overall quotation items? (e.g. 3)', hasMultipleTypes ? '0' : '1');
    if (numItems === null) return;
    const count = parseInt(numItems) || 0;
    const items = [];
    for (let i = 0; i < count; i++) {
      const desc = prompt(`Item ${i+1} description:`);
      if (desc === null) break;
      const qty = parseFloat(prompt(`Item ${i+1} quantity:`, '1') || '1');
      const price = parseFloat(prompt(`Item ${i+1} unit price (₱):`, '0') || '0');
      items.push({ description: desc, quantity: qty, unitPrice: price });
    }
    const total = items.reduce((s, i) => s + (i.quantity * i.unitPrice), 0);

    // Calculate combined total from groups if applicable
    const groupTotal = unitGroupInspections.reduce((s, gi) => s + (gi.quotation?.totalCost || 0), 0);
    const combinedTotal = total > 0 ? total : groupTotal;

    if (!confirm(`Submit inspection with ${hasMultipleTypes ? unitGroupInspections.length + ' appliance group(s) and ' : ''}${items.length} overall item(s) totaling ${money(combinedTotal)}?`)) return;

    try {
      await api(`/api/projects/${pid}/submit-inspection`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          findings,
          notes,
          quotationItems: items,
          totalAmount: combinedTotal,
          unitGroupInspections: unitGroupInspections.length > 0 ? unitGroupInspections : undefined,
        }),
      });
      toast('Inspection submitted — awaiting admin review');
      window.__loadProjectWork();
    } catch (e) { toast(e.message, 'error'); }
  };

