        type: 'doughnut', data: {
          labels: ['Delivery Only', 'Delivery + Installation', 'Customer Pickup'],
          datasets: [{ data: [fm.delivery_only?.revenue || 0, fm.delivery_installation?.revenue || 0, fm.customer_pickup?.revenue || 0], backgroundColor: ['#2563eb', '#10b981', '#f59e0b'], borderColor: '#fff', borderWidth: 3 }]
        }, options: { responsive: true, maintainAspectRatio: false, cutout: '68%', onClick: (e, els) => { if (els.length > 0) showChartDetail(chartConfigs.fulfillmentMix, els[0].index, els[0].datasetIndex); }, onHover: (e, els) => { if (e.native) e.native.target.style.cursor = els.length > 0 ? 'pointer' : 'default'; }, plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 7, font: { size: 10 } } }, tooltip: { callbacks: { label: ctx => `${ctx.label}: ${pesoFmt(ctx.parsed)}` } } } }
