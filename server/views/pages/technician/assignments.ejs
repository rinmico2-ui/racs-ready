  .ent-panel .trk-payment-method { padding:2px 8px; background:#fff; border:1px solid #e2e8f0; border-radius:20px; font-size:0.66rem; font-weight:800; color:#0f172a; }

  /* ── Work Progress (Customer-Style) ──────────────────────────────── */
