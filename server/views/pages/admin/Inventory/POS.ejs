        <div class="pos-summary-row total"><span class="label">TOTAL</span><span class="value" id="summaryTotal">₱0.00</span></div>
      </div>
      <div class="pos-payment" id="posPayment" style="display:none;">
        <div class="pos-payment-methods">
          <button class="pos-pay-btn active" data-method="cash" onclick="selectPayment('cash')"><i class="bi bi-cash"></i>Cash</button>
          <button class="pos-pay-btn" data-method="gcash" onclick="selectPayment('gcash')"><i class="bi bi-phone"></i>GCash</button>
          <button class="pos-pay-btn" data-method="maya" onclick="selectPayment('maya')"><i class="bi bi-phone"></i>Maya</button>
