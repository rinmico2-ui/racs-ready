      chartData: () => {
        const fm = currentA.orderFulfillmentMap || {};
        return { labels: ['Delivery Only','Delivery + Installation','Customer Pickup'], datasets: [{ data: [fm.delivery_only?.revenue||0, fm.delivery_installation?.revenue||0, fm.customer_pickup?.revenue||0], backgroundColor: ['#2563eb','#10b981','#f59e0b'], borderColor: '#fff', borderWidth: 3 }] };
      },
      getFilterLabel: (i) => ['Delivery Only','Delivery + Installation','Customer Pickup'][i] || 'All',
      getSummary: (i) => {
        const fm = currentA.orderFulfillmentMap || {};
        if (i === null) return [{label:'Total Order Rev',value:pesoFmt(currentA.orderRevenue)},{label:'Orders',value:(currentA.orderTransactions||0)}];
        const keys = ['delivery_only','delivery_installation','customer_pickup'];
        const k = keys[i]; const v = fm[k] || {};
        return [{label:'Revenue',value:pesoFmt(v.revenue||0)},{label:'Orders',value:v.orders||0},{label:'Units',value:v.quantity||0}];
      },
      getRows: (i) => {
        let prods = currentA.topOrderProducts || [];
        return prods.map(p => [esc(p.name), esc(p.brand), esc(p.capacity||''), p.quantity, pesoFmt(p.revenue)]);
      }
    },
  };

  // Initialize charts on page load
  updateCharts(initA);
  renderSparklines(initA);
})();
</script>

<script>
function setupReportNav() {
  var nav = document.getElementById('reportNav');
  if (!nav) return;
  var buttons = nav.querySelectorAll('.report-nav-btn');
  buttons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var target = btn.dataset.target;
      if (target === 'top') {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        var el = document.getElementById(target);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      buttons.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
    });
  });
  var trigger = document.getElementById('reportNavTrigger');
  var icon = document.getElementById('reportNavTriggerIcon');
  var label = document.getElementById('reportNavTriggerLabel');
  if (trigger) {
    trigger.addEventListener('click', function() {
      nav.classList.toggle('open');
      if (icon) {
        icon.classList.toggle('bi-list');
        icon.classList.toggle('bi-x-lg');
      }
      if (label) {
        label.textContent = nav.classList.contains('open') ? 'Close' : 'Sections';
      }
    });
  }
  // Scroll spy
  var sectionIds = ['section-executive','section-performance','section-collection','section-cost','section-service-profit','section-pos','section-activity'];
  function onScroll() {
    var scrollY = window.scrollY + 140;
    var current = 'top';
    sectionIds.forEach(function(id) {
      var el = document.getElementById(id);
      if (el && el.offsetTop <= scrollY) current = id;
    });
    buttons.forEach(function(b) {
      b.classList.toggle('active', b.dataset.target === current);
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
}
if (document.readyState === 'loading') { window.addEventListener('DOMContentLoaded', setupReportNav); } else { setupReportNav(); }
</script>
