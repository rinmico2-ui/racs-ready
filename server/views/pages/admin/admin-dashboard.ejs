  <script>
    (function() {
      function updateHeroTime() {
        var now = new Date();
        var hours = now.getHours() % 12 || 12;
        var min = now.getMinutes().toString().padStart(2,'0');
        var ampm = now.getHours() < 12 ? 'AM' : 'PM';
        var d = document.getElementById('hero-time');
