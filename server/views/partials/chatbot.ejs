<script>
/* ══════════════════════════════════════════════════════════════════════════
   RACS AI Chatbot – ChatGPT-Style Engine with Streaming
   ══════════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  // ── State ──────────────────────────────────────────────────────────────
  const HISTORY_KEY = 'racs_chat_history';
  const SID_KEY = 'racs_chat_sid';

  let history = loadHistory();
  let isStreaming = false;
  let abortController = null;

  // ── DOM ────────────────────────────────────────────────────────────────
  const chatbot = document.getElementById('racsChatbot');
  if (!chatbot) return;

  const toggleBtn = document.getElementById('racbotToggle');
  const win = document.getElementById('racbotWindow');
  const closeBtn = document.getElementById('racbotClose');
  const newChatBtn = document.getElementById('racbotNewChat');
  const input = document.getElementById('racbotInput');
  const sendBtn = document.getElementById('racbotSend');
  const messages = document.getElementById('racbotMessages');

  // ── Init ───────────────────────────────────────────────────────────────
  function init() {
    toggleBtn.addEventListener('click', toggleChat);
    closeBtn.addEventListener('click', closeChat);
    newChatBtn.addEventListener('click', newChat);
    sendBtn.addEventListener('click', sendMessage);

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });

    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 120) + 'px';
      sendBtn.disabled = !input.value.trim();
    });

    // Draggable toggle button
    initDraggable();

    if (history.length > 0) {
      renderHistory();
    } else {
      renderWelcome();
    }
  }

  // ── Draggable Toggle Button ────────────────────────────────────────────
  function initDraggable() {
    const DRAG_KEY = 'racbot_drag_pos';
    let isDragging = false;
    let hasMoved = false;
    let startX, startY, startLeft, startTop;
    let clickTimeout = null;

    // Restore saved position
    try {
      const saved = JSON.parse(localStorage.getItem(DRAG_KEY));
      if (saved && typeof saved.bottom === 'number' && typeof saved.right === 'number') {
        chatbot.style.bottom = saved.bottom + 'px';
        chatbot.style.right = saved.right + 'px';
      }
    } catch (e) {}

    function savePosition() {
      try {
        const rect = chatbot.getBoundingClientRect();
        localStorage.setItem(DRAG_KEY, JSON.stringify({
          bottom: Math.round(window.innerHeight - rect.bottom),
          right: Math.round(window.innerWidth - rect.right)
        }));
      } catch (e) {}
    }

    function clamp(val, min, max) {
      return Math.max(min, Math.min(max, val));
    }

    toggleBtn.style.cursor = 'grab';

    toggleBtn.addEventListener('pointerdown', (e) => {
      if (e.target.closest('.racbot-window')) return;
      isDragging = true;
      hasMoved = false;
      startX = e.clientX;
      startY = e.clientY;
      const rect = chatbot.getBoundingClientRect();
      startLeft = rect.left;
      startTop = rect.top;
      chatbot.style.transition = 'none';
      toggleBtn.style.cursor = 'grabbing';
      e.preventDefault();
    });

    document.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) hasMoved = true;
      if (!hasMoved) return;

      const w = chatbot.offsetWidth;
      const h = chatbot.offsetHeight;
      const initialRight = window.innerWidth - startLeft - w;
      const initialBottom = window.innerHeight - startTop - h;
      let newRight = clamp(initialRight - dx, 0, window.innerWidth - w);
      let newBottom = clamp(initialBottom - dy, 0, window.innerHeight - h);

      chatbot.style.right = newRight + 'px';
      chatbot.style.bottom = newBottom + 'px';
      chatbot.style.left = 'auto';
      chatbot.style.top = 'auto';
    });

    document.addEventListener('pointerup', () => {
      if (!isDragging) return;
      isDragging = false;
      toggleBtn.style.cursor = 'grab';
      chatbot.style.transition = '';
      if (hasMoved) {
        savePosition();
      }
    });

    // Prevent click from firing after drag
    toggleBtn.addEventListener('click', (e) => {
      if (hasMoved) {
        e.preventDefault();
        e.stopPropagation();
        hasMoved = false;
      }
    }, true);
  }

  // ── Chat Toggle ────────────────────────────────────────────────────────
  function toggleChat() {
    win.classList.toggle('active');
    if (win.classList.contains('active')) {
      setTimeout(() => input.focus(), 100);
    }
  }

  function closeChat() {
    win.classList.remove('active');
  }

  // ── New Chat ───────────────────────────────────────────────────────────
  function newChat() {
    history = [];
    saveHistory();
    localStorage.removeItem(SID_KEY);
    messages.innerHTML = '';
    renderWelcome();
  }

  // ── Welcome Screen ─────────────────────────────────────────────────────
  function renderWelcome() {
    messages.innerHTML = `
      <div class="racbot-welcome">
        <div class="racbot-welcome-icon"><i class="bi bi-stars"></i></div>
        <h3>How can I help you today?</h3>
        <p>I'm RACS AI, your HVAC assistant. Ask me anything about air conditioning products, services, or booking.</p>
        <div class="racbot-suggestions">
          <button class="racbot-suggestion" data-q="What aircon services do you offer?">
            <i class="bi bi-tools"></i> Services & pricing
          </button>
          <button class="racbot-suggestion" data-q="I want to book a service appointment">
            <i class="bi bi-calendar-check"></i> Book a service
          </button>
          <button class="racbot-suggestion" data-q="What is my booking or project status?">
            <i class="bi bi-geo-alt"></i> My booking / project
          </button>
          <button class="racbot-suggestion" data-q="My AC is not cooling, what should I do?">
            <i class="bi bi-exclamation-triangle"></i> My AC isn't working
          </button>
        </div>
      </div>`;

    messages.querySelectorAll('.racbot-suggestion').forEach(btn => {
      btn.addEventListener('click', () => {
        input.value = btn.dataset.q;
        sendBtn.disabled = false;
        sendMessage();
      });
    });
  }

  // ── Render History ─────────────────────────────────────────────────────
  function renderHistory() {
    messages.innerHTML = '';
    for (const msg of history) {
      appendMessage(msg.role, msg.content, msg.timestamp, false);
    }
    scrollBottom();
  }

  // ── Send Message (Streaming) ───────────────────────────────────────────
  async function sendMessage() {
    const text = input.value.trim();
    if (!text || isStreaming) return;

    input.value = '';
    input.style.height = 'auto';
    sendBtn.disabled = true;
    isStreaming = true;

    const userTime = new Date().toISOString();
    appendMessage('user', text, userTime);
    history.push({ role: 'user', content: text, timestamp: userTime });

    // Show typing
    showTyping();

    try {
      abortController = new AbortController();
      const response = await fetch('/api/chat/stream', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: text,
          // Exclude the current message because `message` is added separately.
          history: history.slice(0, -1).slice(-20),
          sessionId: getOrCreateSessionId(),
        }),
        signal: abortController.signal,
      });

      hideTyping();

      if (!response.ok) {
        let detail = 'The assistant could not respond.';
        try { detail = (await response.json()).error || detail; } catch (_) {}
        throw new Error(detail);
      }

      // Create assistant message container
      const msgRow = document.createElement('div');
      msgRow.className = 'racbot-msg-row assistant';
      const msgInner = document.createElement('div');
      msgInner.className = 'racbot-msg-inner';
      const contentDiv = document.createElement('div');
      contentDiv.className = 'racbot-assistant-content';
      msgInner.appendChild(contentDiv);
      msgRow.appendChild(msgInner);
      messages.appendChild(msgRow);

      // Read stream
      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let fullText = '';
      let buffer = '';
      let lastSuggests = null;

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          if (line.startsWith('data: ')) {
            const data = line.slice(6);
            if (data === '[DONE]') break;

            try {
              const parsed = JSON.parse(data);
              if (parsed.text) {
                fullText += parsed.text;
                contentDiv.innerHTML = formatMarkdown(fullText);
                scrollBottom();
              }
              if (parsed.done) {
                if (parsed.suggests) lastSuggests = parsed.suggests;
                history.push({ role: 'bot', content: parsed.fullText || fullText, timestamp: new Date().toISOString() });
                saveHistory();
              }
            } catch (e) {}
          }
        }
      }

      if (lastSuggests && lastSuggests.length) {
        renderSuggestions(contentDiv.parentElement, lastSuggests);
      }

      // If stream didn't send a done event, save what we have
      if (fullText && !history.some(h => h.role === 'bot' && h.content === fullText)) {
        history.push({ role: 'bot', content: fullText, timestamp: new Date().toISOString() });
        saveHistory();
      }

      // Add timestamp and actions
      const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      const meta = document.createElement('div');
      meta.className = 'racbot-msg-meta';
      meta.innerHTML = `
        <span class="racbot-msg-time">${time}</span>
        <div class="racbot-msg-actions">
          <button class="racbot-action-btn" onclick="racbotCopyMsg(this)" title="Copy"><i class="bi bi-clipboard"></i></button>
          <button class="racbot-action-btn" onclick="racbotThumbsUp(this)" title="Good response"><i class="bi bi-hand-thumbs-up"></i></button>
          <button class="racbot-action-btn" onclick="racbotThumbsDown(this)" title="Bad response"><i class="bi bi-hand-thumbs-down"></i></button>
        </div>`;
      msgInner.appendChild(meta);

    } catch (err) {
      hideTyping();
      if (err.name !== 'AbortError') {
        const fallback = "I'm having trouble connecting. Please try again or call **+63 917 888 9999** for immediate help.";
        appendMessage('bot', fallback, new Date().toISOString());
        history.push({ role: 'bot', content: fallback, timestamp: new Date().toISOString() });
        saveHistory();
      }
    }

    isStreaming = false;
    abortController = null;
    input.focus();
  }

  // ── Append Message ─────────────────────────────────────────────────────
  function appendMessage(role, text, timestamp, animate = true) {
    const time = new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    const isUser = role === 'user';

    const row = document.createElement('div');
    row.className = `racbot-msg-row ${role}`;
    if (!animate) row.style.animation = 'none';

    const inner = document.createElement('div');
    inner.className = 'racbot-msg-inner';

    if (isUser) {
      inner.innerHTML = `<div class="racbot-user-bubble">${escapeHtml(text)}</div>`;
    } else {
      const content = document.createElement('div');
      content.className = 'racbot-assistant-content';
      content.innerHTML = formatMarkdown(text);
      inner.appendChild(content);

      const meta = document.createElement('div');
      meta.className = 'racbot-msg-meta';
      meta.innerHTML = `
        <span class="racbot-msg-time">${time}</span>
        <div class="racbot-msg-actions">
          <button class="racbot-action-btn" onclick="racbotCopyMsg(this)" title="Copy"><i class="bi bi-clipboard"></i></button>
          <button class="racbot-action-btn" onclick="racbotThumbsUp(this)" title="Good response"><i class="bi bi-hand-thumbs-up"></i></button>
          <button class="racbot-action-btn" onclick="racbotThumbsDown(this)" title="Bad response"><i class="bi bi-hand-thumbs-down"></i></button>
        </div>`;
      inner.appendChild(meta);
    }

    row.appendChild(inner);
    messages.appendChild(row);
    if (animate) scrollBottom();
  }

  // ── Typing Indicator ───────────────────────────────────────────────────
  function showTyping() {
    const html = `
      <div class="racbot-typing-row" id="racbotTyping">
        <div class="racbot-typing-inner">
          <div class="racbot-typing-avatar"><i class="bi bi-stars"></i></div>
          <div class="racbot-typing-dots">
            <div class="racbot-typing-dot"></div>
            <div class="racbot-typing-dot"></div>
            <div class="racbot-typing-dot"></div>
          </div>
        </div>
      </div>`;
    messages.insertAdjacentHTML('beforeend', html);
    scrollBottom();
  }

  function hideTyping() {
    const el = document.getElementById('racbotTyping');
    if (el) el.remove();
  }

  // ── Suggestion Chips (guided next steps) ────────────────────────────────
  function renderSuggestions(container, suggests) {
    if (!container || !suggests || !suggests.length) return;
    let chipBar = container.querySelector('.racbot-chips');
    if (!chipBar) {
      chipBar = document.createElement('div');
      chipBar.className = 'racbot-chips';
      container.appendChild(chipBar);
    }
    chipBar.innerHTML = '';
    suggests.forEach((q) => {
      const btn = document.createElement('button');
      btn.className = 'racbot-chip';
      btn.type = 'button';
      btn.textContent = q;
      btn.addEventListener('click', () => {
        input.value = q;
        sendBtn.disabled = false;
        sendMessage();
      });
      chipBar.appendChild(btn);
    });
  }

  // ── Markdown Formatter ─────────────────────────────────────────────────
  function formatMarkdown(text) {
    // Treat model output as text before adding the small supported markdown set.
    text = escapeHtml(String(text || ''));
    // Handle code blocks first
    let html = text.replace(/```(\w*)\n?([\s\S]*?)```/g, (match, lang, code) => {
      return `<pre><code>${code.trim()}</code></pre>`;
    });

    // Handle tables
    html = html.replace(/\|(.+)\|\n\|[-|\s]+\|\n((?:\|.+\|\n?)+)/g, (match, header, body) => {
      const headers = header.split('|').map(h => h.trim()).filter(Boolean);
      const rows = body.trim().split('\n').map(row =>
        row.split('|').map(c => c.trim()).filter(Boolean)
      );
      let table = '<div class="racbot-table-wrap"><table class="racbot-table"><thead><tr>';
      headers.forEach(h => { table += `<th>${inlineFormat(h)}</th>`; });
      table += '</tr></thead><tbody>';
      rows.forEach(row => {
        table += '<tr>';
        row.forEach(c => { table += `<td>${inlineFormat(c)}</td>`; });
        table += '</tr>';
      });
      table += '</tbody></table></div>';
      return table;
    });

    // Process line by line
    const lines = html.split('\n');
    const processed = [];
    let inList = false;
    let listType = '';

    for (let i = 0; i < lines.length; i++) {
      let line = lines[i];

      // Code blocks pass through
      if (line.startsWith('<pre>')) {
        if (inList) { processed.push(`</div>`); inList = false; }
        processed.push(line);
        continue;
      }

      // Headings
      if (/^###\s+/.test(line)) {
        if (inList) { processed.push('</div>'); inList = false; }
        processed.push(`<div class="racbot-h3">${inlineFormat(line.replace(/^###\s+/, ''))}</div>`);
        continue;
      }
      if (/^##\s+/.test(line)) {
        if (inList) { processed.push('</div>'); inList = false; }
        processed.push(`<div class="racbot-h2">${inlineFormat(line.replace(/^##\s+/, ''))}</div>`);
        continue;
      }
      if (/^#\s+/.test(line)) {
        if (inList) { processed.push('</div>'); inList = false; }
        processed.push(`<div class="racbot-h1">${inlineFormat(line.replace(/^#\s+/, ''))}</div>`);
        continue;
      }

      // Horizontal rule
      if (/^---+$/.test(line.trim())) {
        if (inList) { processed.push('</div>'); inList = false; }
        processed.push('<hr class="racbot-hr">');
        continue;
      }

      // Blockquote
      if (/^>\s+/.test(line)) {
        if (inList) { processed.push('</div>'); inList = false; }
        processed.push(`<div class="racbot-blockquote">${inlineFormat(line.replace(/^>\s+/, ''))}</div>`);
        continue;
      }

      // Bullet points
      if (/^[•\-\*]\s+/.test(line)) {
        if (!inList || listType !== 'bullet') {
          if (inList) processed.push('</div>');
          processed.push('<div class="racbot-list">');
          inList = true;
          listType = 'bullet';
        }
        processed.push(`<div class="racbot-list-item"><span class="racbot-list-bullet">•</span><span>${inlineFormat(line.replace(/^[•\-\*]\s+/, ''))}</span></div>`);
        continue;
      }

      // Numbered list
      if (/^\d+\.\s+/.test(line)) {
        if (!inList || listType !== 'number') {
          if (inList) processed.push('</div>');
          processed.push('<div class="racbot-list racbot-numbered-list">');
          inList = true;
          listType = 'number';
        }
        const num = line.match(/^(\d+)\.\s+/)[1];
        processed.push(`<div class="racbot-list-item racbot-numbered-item"><span class="racbot-list-bullet">${num}</span><span>${inlineFormat(line.replace(/^\d+\.\s+/, ''))}</span></div>`);
        continue;
      }

      // Close list
      if (inList) { processed.push('</div>'); inList = false; }

      // Empty line
      if (line.trim() === '') {
        continue;
      }

      // Regular paragraph
      processed.push(`<p>${inlineFormat(line)}</p>`);
    }

    if (inList) processed.push('</div>');
    return processed.join('');
  }

  function inlineFormat(text) {
    return text
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/`(.+?)`/g, '<code>$1</code>')
      .replace(/\[(.+?)\]\((.+?)\)/g, (match, label, href) => {
        const safeHref = /^(?:https?:\/\/|mailto:|\/(?!\/))/i.test(href) ? href : '#';
        const target = safeHref.startsWith('/') ? '' : ' target="_blank"';
        return `<a href="${safeHref}"${target} rel="noopener noreferrer">${label}</a>`;
      });
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // ── Scroll ─────────────────────────────────────────────────────────────
  function scrollBottom() {
    requestAnimationFrame(() => {
      messages.scrollTop = messages.scrollHeight;
    });
  }

  // ── Session ID ────────────────────────────────────────────────────────
  function getOrCreateSessionId() {
    let sid = localStorage.getItem(SID_KEY);
    if (!sid) {
      sid = 'cs_' + Date.now().toString(36) + '_' + Math.random().toString(36).substr(2, 8);
      localStorage.setItem(SID_KEY, sid);
    }
    return sid;
  }

  // ── Persistence ────────────────────────────────────────────────────────
  function loadHistory() {
    try {
      const h = JSON.parse(localStorage.getItem(HISTORY_KEY));
      if (h && h.length > 0) {
        const cutoff = Date.now() - 24 * 60 * 60 * 1000;
        return h.filter(m => new Date(m.timestamp).getTime() > cutoff);
      }
      return [];
    } catch { return []; }
  }

  function saveHistory() {
    try {
      localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(-100)));
    } catch {}
  }

  // ── Global Actions ─────────────────────────────────────────────────────
  window.racbotCopyMsg = function(btn) {
    const content = btn.closest('.racbot-msg-inner').querySelector('.racbot-assistant-content');
    if (content) {
      navigator.clipboard.writeText(content.textContent).catch(() => {});
      btn.innerHTML = '<i class="bi bi-check"></i>';
      setTimeout(() => { btn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 1500);
    }
  };

  window.racbotThumbsUp = function(btn) {
    btn.classList.toggle('active');
    const sibling = btn.parentElement.querySelector('[onclick*="ThumbsDown"]');
    if (sibling) sibling.classList.remove('active');
  };

  window.racbotThumbsDown = function(btn) {
    btn.classList.toggle('active');
    const sibling = btn.parentElement.querySelector('[onclick*="ThumbsUp"]');
    if (sibling) sibling.classList.remove('active');
  };

  // ── Start ──────────────────────────────────────────────────────────────
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>
