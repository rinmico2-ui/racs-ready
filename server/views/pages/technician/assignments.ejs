  /* ── Customer-Style Job Cards ───────────────────────────────────────── */
  .assign-card.tjc { display: flex; align-items: stretch; gap: 14px; padding: 14px 16px; border-radius: 16px; }
  .assign-card.tjc::before { width: 0; background: transparent; }
  .assign-card.tjc.tjc-live::before { width: 4px; background: #16a34a; }
  .tjc-date {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-width: 58px; padding: 6px 4px; border-radius: 12px;
    background: linear-gradient(135deg, #eff6ff, #f8fafc); color: #1d4ed8;
    flex-shrink: 0;
  }
  .tjc-date-day { font-size: 1.5rem; font-weight: 800; line-height: 1; }
  .tjc-date-month { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
  .tjc-main { flex: 1; min-width: 0; }
  .tjc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 6px; }
  .tjc-title { font-size: 0.95rem; font-weight: 700; color: #0f172a; line-height: 1.25; }
  .tjc-status {
    display: inline-flex; align-items: center; gap: 5px; padding: 5px 14px; border-radius: 20px;
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .tjc-meta { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 3px; }
  .tjc-meta span { font-size: 0.76rem; color: #64748b; display: inline-flex; align-items: center; }
  .tjc-meta i { color: #94a3b8; }
  .tjc-live-badge { color: #16a34a !important; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; }
  .tjc-pulse {
    width: 7px; height: 7px; border-radius: 50%; background: #22c55e;
    display: inline-block; animation: tjcPulse 2s ease-in-out infinite;
  }
  @keyframes tjcPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.8); } }
  .tjc-action { display: flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 8px; flex-shrink: 0; }
  .tjc-view {
    border: none; background: #2563eb; color: #fff; font-size: 0.78rem; font-weight: 700;
    padding: 8px 14px; border-radius: 10px; cursor: pointer; white-space: nowrap;
    transition: background 0.2s ease; display: inline-flex; align-items: center; gap: 6px;
  }
  .tjc-view:hover { background: #1d4ed8; }

  /* ── Customer-Style Detail Cards ───────────────────────────────────── */
  .trk-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
  .trk-card:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.06); }
  .trk-card-header { display:flex; align-items:center; justify-content:space-between; padding:14px 18px; border-bottom:1px solid rgba(226,232,240,0.6); background:rgba(248,250,252,0.5); }
  .trk-card-title { font-size:0.82rem; font-weight:700; color:#0f172a; margin:0; display:flex; align-items:center; gap:8px; text-transform:uppercase; letter-spacing:0.04em; }
  .trk-card-body { padding:14px 18px; }
  .trk-detail-hero { display:flex; align-items:center; gap:14px; padding:4px 0 14px; margin-bottom:6px; border-bottom:1px solid rgba(226,232,240,0.6); }
  .trk-detail-hero-icon { width:50px; height:50px; min-width:50px; border-radius:14px; background:linear-gradient(135deg,#2563eb,#1d4ed8); color:#fff; font-size:1.3rem; display:flex; align-items:center; justify-content:center; box-shadow:0 8px 20px rgba(37,99,235,0.28); }
  .trk-detail-hero-title { font-size:1.02rem; font-weight:800; color:#0f172a; line-height:1.2; }
  .trk-detail-hero-sub { font-size:0.72rem; color:#64748b; font-weight:600; margin-top:2px; }
  .trk-detail-row { display:flex; align-items:flex-start; gap:12px; padding:10px 0; border-bottom:1px solid rgba(226,232,240,0.5); }
  .trk-detail-row:last-child { border-bottom:none; }
  .trk-detail-icon { width:32px; height:32px; min-width:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:0.85rem; background:#eff6ff; color:#2563eb; }
  .trk-detail-content { flex:1; min-width:0; }
  .trk-detail-label { font-size:0.68rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:2px; }
  .trk-detail-value { font-size:0.88rem; font-weight:600; color:#0f172a; line-height:1.3; word-break:break-word; }
  .trk-detail-value a { color:#2563eb; text-decoration:none; }
  .trk-detail-subsection { padding:10px 12px; margin-bottom:8px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; }
  .trk-detail-subhead { font-size:0.74rem; font-weight:800; color:#1d4ed8; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:6px; display:flex; align-items:center; gap:6px; }
  .trk-detail-subtext { font-size:0.8rem; color:#475569; line-height:1.4; margin-bottom:2px; }
  .trk-payment-summary { margin-top:12px; padding:12px 14px; background:linear-gradient(135deg,#f0fdf4,#ecfdf5); border:1px solid #bbf7d0; border-radius:12px; }
