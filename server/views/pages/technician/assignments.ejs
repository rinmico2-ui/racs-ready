      const data = await resp.json();
      if (resp.ok && data.success) {
        Swal.fire('Started', 'Repair work is now in progress.', 'success').then(() => {
          loadAssignments(currentFilter, currentPage);
          if (window._currentDetailId && document.getElementById('rightPanel').classList.contains('open')) {
            showDetail(window._currentDetailId);
          }
        });
      } else {
        Swal.fire('Error', data.error || 'Failed to start repair.', 'error');
      }
    } catch (e) { Swal.fire('Error', 'Network error.', 'error'); }
  }

  async function completeRepair(bookingId) {
    try {
      // Fetch fresh booking data to check payment status
      const res = await fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' });
      const detail = await res.json();
      const booking = detail.booking || detail;

      const qTotal = booking.quotation?.totalCost || 0;
      const needsRepairPay = !booking.repairPaymentCollected && qTotal > 0;
      const needsPayment = ['cod', 'cash', 'cash_onsite', 'gcash_downpayment'].includes(booking.paymentMethod)
        && !booking.balanceCollected && (booking.balanceAmount || 0) > 0;

      // Step 1: If repair quotation payment needed, collect that first
      if (needsRepairPay) {
        Swal.fire({
          title: 'Collect Repair Payment',
          html: `The repair quotation of <strong>₱${qTotal.toLocaleString()}</strong> must be collected before completing.`,
          icon: 'info',
          confirmButtonText: 'Collect Payment',
          showCancelButton: true,
          cancelButtonText: 'Cancel',
        }).then(result => {
          if (result.isConfirmed) {
            collectRepairPayment(bookingId, qTotal);
          }
        });
        return;
      }

      // Find the assignment for this booking
      const a = window._detailAssignment || {};
      let assignmentId = a._id;
      if (!assignmentId || String(a.bookingId?._id || a.bookingId) !== String(bookingId)) {
        const listRes = await fetch(`/api/technician/assignments?status=in_progress&limit=50`, { credentials: 'same-origin' });
        const listData = await listRes.json();
        const match = (listData.items || []).find(x => String(x.bookingId?._id || x.bookingId) === String(bookingId));
        if (match) assignmentId = match._id;
      }
      if (!assignmentId) {
        Swal.fire('Error', 'Assignment not found for this booking.', 'error');
        return;
      }

      // Step 2: If inspection balance needed, collect that before materials
      if (needsPayment) {
        const paymentData = {
          ...booking,
          _id: assignmentId,
          bookingId: booking,
          customerName: booking.customer?.name || a.customerName || '',
          serviceName: a.serviceName || booking.serviceType || '',
          address: booking.customer?.address || a.address || '',
          paymentMethod: booking.paymentMethod,
        };
        openModalAfterClose('materialsModal', 'assignDetailModal', () => {
          openCollectPaymentModal(paymentData._id, paymentData, false, function () {
            openMaterialsModal(bookingId);
          });
        });
      } else {
        // Step 3: Go straight to materials modal, then proof modal
        openModalAfterClose('materialsModal', 'assignDetailModal', () => openMaterialsModal(bookingId));
      }
    } catch (e) {
      Swal.fire('Error', 'Network error.', 'error');
    }
  }

