<div class="technician-page">
  <div class="container-fluid px-3 px-md-4 py-3 py-md-4">

  <style>
    /* Page background (matches attendance / My Work) */
    .technician-page { background: #f1f5f9; min-height: 100vh; }
    .technician-page .container-fluid { display: block !important; }

    /* ── Hero (matches attendance td-hero) ── */
    .mp-hero {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 40%, #2563eb 100%);
      border-radius: 16px; padding: 28px 32px; color: #fff;
      position: relative; overflow: hidden;
      box-shadow: 0 20px 40px rgba(0,0,0,0.1), 0 8px 16px rgba(0,0,0,0.06);
      border: 1px solid rgba(255,255,255,0.08); margin-bottom: 24px;
    }
    .mp-hero::before {
      content: ''; position: absolute; top: -80%; right: -20%; width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(96,165,250,0.12) 0%, transparent 70%);
      border-radius: 50%; pointer-events: none;
    }
    .mp-hero::after {
      content: ''; position: absolute; bottom: -60%; left: -10%; width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(59,130,246,0.08) 0%, transparent 70%);
      border-radius: 50%; pointer-events: none;
    }
    .mp-hero-content { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .mp-hero-left { display: flex; align-items: center; gap: 18px; }
    .mp-hero-icon {
      width: 56px; height: 56px; border-radius: 16px;
      background: rgba(255,255,255,0.12); backdrop-filter: blur(8px);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem; border: 1px solid rgba(255,255,255,0.15); flex-shrink: 0;
    }
    .mp-hero-title { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 4px; text-shadow: 0 1px 2px rgba(0,0,0,0.1); }
    .mp-hero-sub { font-size: 0.82rem; opacity: 0.8; margin: 0; font-weight: 400; }
    .mp-hero-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .mp-hero-badge {
      padding: 10px 16px; background: rgba(255,255,255,0.1); border-radius: 12px;
      backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.12);
      font-size: 0.82rem; font-weight: 600; display: flex; align-items: center; gap: 8px;
    }
    .mp-hero-badge i { opacity: 0.8; }

    /* ── KPI Cards (matches att-status-card visual language) ── */
    .mp-kpi-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 24px; }
    .mp-kpi-card {
      background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 20px;
      box-shadow: 0 1px 3px rgba(15,23,42,0.04), 0 4px 16px rgba(15,23,42,0.04);
      transition: box-shadow 0.25s ease, transform 0.25s ease;
    }
    .mp-kpi-card:hover { box-shadow: 0 8px 32px rgba(15,23,42,0.08), 0 2px 8px rgba(15,23,42,0.04); transform: translateY(-2px); }
    .mp-kpi-header { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
    .mp-kpi-icon {
      width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem; color: #fff; flex-shrink: 0;
    }
    .mp-kpi-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #64748b; }
    .mp-kpi-value { font-size: 1.5rem; font-weight: 800; color: #0f172a; line-height: 1.1; margin: 0; }
    .mp-kpi-sub { font-size: 0.75rem; color: #94a3b8; margin-top: 6px; }

    /* ── Panel (matches att-panel) ── */
    .mp-panel { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; box-shadow: 0 1px 3px rgba(15,23,42,0.04), 0 4px 16px rgba(15,23,42,0.04); transition: box-shadow 0.25s ease, transform 0.25s ease; }
    .mp-panel:hover { box-shadow: 0 8px 32px rgba(15,23,42,0.08), 0 2px 8px rgba(15,23,42,0.04); transform: translateY(-2px); }
    .mp-panel-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 20px; border-bottom: 1px solid #f1f5f9; background: #fafbfc;
    }
    .mp-panel-title { font-size: 0.88rem; font-weight: 700; color: #1e293b; margin: 0; display: flex; align-items: center; gap: 10px; }
    .mp-panel-title-icon { width: 32px; height: 32px; border-radius: 8px; background: rgba(59,130,246,0.1); display: flex; align-items: center; justify-content: center; font-size: 0.9rem; color: #3b82f6; flex-shrink: 0; }
    .mp-panel-body { padding: 16px 20px; }

    /* ── History Table (matches att-history-table) ── */
    .mp-history-table { width: 100%; border-collapse: collapse; }
    .mp-history-table th {
      background: #fafbfc; color: #64748b; font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
      letter-spacing: 0.04em; padding: 12px 16px; border-bottom: 1px solid #e2e8f0; text-align: left; white-space: nowrap;
    }
    .mp-history-table td { padding: 12px 16px; font-size: 0.85rem; color: #334155; border-bottom: 1px solid #f1f5f9; }
    .mp-history-table tr:hover td { background: #fafbfc; cursor: pointer; }

    /* ── Status Badges ── */
    .mp-status-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 0.7rem; font-weight: 600; padding: 4px 10px; border-radius: 999px; }
    .mp-status-approved { background: rgba(59, 130, 246, 0.12); color: #2563eb; }
    .mp-status-paid { background: rgba(16, 185, 129, 0.12); color: #059669; }
    .mp-status-draft { background: rgba(245, 158, 11, 0.12); color: #d97706; }
    .mp-status-voided { background: rgba(239, 68, 68, 0.12); color: #dc2626; }

    /* ── Empty State ── */
    .mp-empty { text-align: center; padding: 3rem 1rem; color: #94a3b8; }
    .mp-empty i { font-size: 2.5rem; margin-bottom: 0.75rem; display: block; }
    .mp-empty p { font-size: 0.85rem; margin: 0; }

    /* ── Detail Modal ── */
    .mp-modal { border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 25px 60px rgba(15,23,42,0.18); }
    .mp-modal-header { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 1.25rem 1.75rem; display: flex; align-items: center; justify-content: space-between; }
    .mp-modal-header-left { display: flex; align-items: center; gap: 14px; }
    .mp-modal-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.2rem; box-shadow: 0 4px 14px rgba(0,0,0,0.25); flex-shrink: 0; }
    .mp-modal-title { margin: 0; font-weight: 700; font-size: 1.05rem; color: #fff; }
    .mp-modal-sub { margin: 0; font-size: 0.75rem; color: #94a3b8; }
    .mp-modal-body { overflow-y: auto; max-height: 70vh; padding: 1.5rem 1.75rem; }
    .mp-modal .btn-close { width: 36px; height: 36px; border-radius: 10px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15); color: #fff; opacity: 1; transition: all 0.2s; flex-shrink: 0; }
    .mp-modal .btn-close:hover { background: rgba(255,255,255,0.2); }

    .mp-section { margin-bottom: 1.25rem; }
    .mp-section:last-child { margin-bottom: 0; }
    .mp-section-header { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .mp-section-icon { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; color: #fff; flex-shrink: 0; }
    .mp-section-title { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin: 0; }

    .mp-info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .mp-info-card { background: #f8fafc; border: 1px solid #f1f5f9; border-radius: 10px; padding: 10px 14px; }
    .mp-info-label { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; margin-bottom: 3px; }
    .mp-info-value { font-size: 0.85rem; color: #0f172a; font-weight: 600; }

    .mp-att-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .mp-att-item { text-align: center; border-radius: 10px; padding: 10px 6px; border: 1px solid #f1f5f9; }
    .mp-att-num { font-size: 1.3rem; font-weight: 800; line-height: 1.1; }
    .mp-att-lbl { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 2px; }
    .mp-att-present .mp-att-num, .mp-att-present .mp-att-lbl { color: #059669; }
    .mp-att-present { background: rgba(16, 185, 129, 0.06); border-color: rgba(16, 185, 129, 0.15); }
    .mp-att-late .mp-att-num, .mp-att-late .mp-att-lbl { color: #d97706; }
    .mp-att-late { background: rgba(245, 158, 11, 0.06); border-color: rgba(245, 158, 11, 0.15); }
    .mp-att-absent .mp-att-num, .mp-att-absent .mp-att-lbl { color: #dc2626; }
    .mp-att-absent { background: rgba(239, 68, 68, 0.06); border-color: rgba(239, 68, 68, 0.15); }
    .mp-att-leave .mp-att-num, .mp-att-leave .mp-att-lbl { color: #2563eb; }
    .mp-att-leave { background: rgba(59, 130, 246, 0.06); border-color: rgba(59, 130, 246, 0.15); }
    .mp-att-sick .mp-att-num, .mp-att-sick .mp-att-lbl { color: #7c3aed; }
    .mp-att-sick { background: rgba(139, 92, 246, 0.06); border-color: rgba(139, 92, 246, 0.15); }
    .mp-att-hours .mp-att-num, .mp-att-hours .mp-att-lbl { color: #0369a1; }
    .mp-att-hours { background: rgba(14, 165, 233, 0.06); border-color: rgba(14, 165, 233, 0.15); }

    .mp-pay-box { background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 16px; }
    .mp-pay-row { display: flex; justify-content: space-between; align-items: center; padding: 5px 0; font-size: 0.82rem; gap: 12px; }
    .mp-pay-row .mp-pay-label { color: #64748b; }
    .mp-pay-row .mp-pay-amount { font-weight: 500; color: #334155; white-space: nowrap; }
    .mp-pay-divider { border-top: 1px dashed #e2e8f0; margin: 4px 0; }
    .mp-pay-total { display: flex; justify-content: space-between; align-items: center; padding: 10px 0 2px; font-size: 1rem; font-weight: 800; color: #0f172a; border-top: 2px solid #e2e8f0; margin-top: 6px; gap: 12px; }
    .mp-pay-total .mp-pay-amount { color: #059669; font-size: 1.1rem; white-space: nowrap; }

    .mp-allow-row { display: flex; justify-content: space-between; padding: 4px 0; font-size: 0.82rem; gap: 12px; }
    .mp-ded-row { display: flex; justify-content: space-between; padding: 4px 0; font-size: 0.82rem; gap: 12px; }
    .mp-ded-amount { color: #dc2626; white-space: nowrap; }

    .mp-payment-card { background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 12px; padding: 14px 16px; }
    .mp-notes { background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 10px 14px; font-size: 0.82rem; color: #92400e; word-break: break-word; }

    /* ═══ RESPONSIVE: ≤991px (tablet) ═══ */
    @media (max-width: 991px) {
      .mp-hero { padding: 24px 28px; margin-bottom: 24px; }
      .mp-hero-content { flex-direction: column; align-items: flex-start; gap: 1.75rem; }
      .mp-hero-title { font-size: 1.45rem; }
      .mp-hero-sub { font-size: 0.88rem; line-height: 1.5; }
      .mp-hero-right { width: 100%; flex-direction: column; align-items: flex-start; }
      .mp-kpi-card { padding: 1.25rem; }
      .mp-kpi-header { gap: 12px; margin-bottom: 1rem; }
      .mp-kpi-icon { width: 42px; height: 42px; font-size: 1.1rem; }
      .mp-kpi-value { font-size: 1.3rem; }
      .mp-panel-header { padding: 1rem 1.25rem; }
      .mp-panel-title { font-size: 0.82rem; }
      .mp-panel-body { padding: 1rem 1.25rem; }
    }

    /* ═══ RESPONSIVE: ≤767px (phone) ═══ */
    @media (max-width: 767px) {
      .container-fluid { padding-left: 0.75rem; padding-right: 0.75rem; }
      .mp-hero { padding: 1.75rem 1.5rem; border-radius: 16px; margin-bottom: 1.5rem; }
      .mp-hero-content { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
      .mp-hero-title { font-size: 1.5rem; margin-bottom: 0.25rem; }
      .mp-hero-sub { font-size: 0.88rem; line-height: 1.5; opacity: 0.85; }
      .mp-hero-icon { width: 52px; height: 52px; font-size: 1.4rem; border-radius: 14px; }
      .mp-hero-right { width: 100%; flex-direction: column; align-items: flex-start; }
      .mp-hero-badge { padding: 8px 14px; font-size: 0.8rem; }

      /* KPI: 3-col compact grid */
      .mp-kpi-row { grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 1.5rem; }
      .mp-kpi-card { padding: 14px 10px; text-align: center; }
      .mp-kpi-header { flex-direction: column; align-items: center; gap: 8px; margin-bottom: 8px; }
      .mp-kpi-icon { width: 36px; height: 36px; font-size: 0.95rem; border-radius: 10px; }
      .mp-kpi-label { font-size: 0.6rem; }
      .mp-kpi-value { font-size: 1rem; }
      .mp-kpi-sub { font-size: 0.58rem; margin-top: 1px; }

      /* Panel */
      .mp-panel { border-radius: 12px; }
      .mp-panel-header { padding: 0.875rem 1rem; flex-direction: column; align-items: stretch; gap: 10px; }
      .mp-panel-title { font-size: 0.78rem; }
      .mp-panel-body { padding: 0.875rem 1rem; }

      /* Table → stacked cards */
      .mp-history-table { border: 0; }
      .mp-history-table thead { display: none; }
      .mp-history-table tbody, .mp-history-table tr { display: block; }
      .mp-history-table tr {
        margin-bottom: 0.75rem; background: #fff; border: 1px solid #e2e8f0;
        border-radius: 14px; padding: 0.75rem 1rem;
        box-shadow: 0 1px 3px rgba(15,23,42,0.04);
      }
      .mp-history-table td {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.5rem 0; border-bottom: 1px solid #f1f5f9; font-size: 0.85rem; gap: 12px;
      }
      .mp-history-table td:last-child { border-bottom: none; }
      .mp-history-table td::before {
        content: attr(data-label); font-weight: 600; color: #64748b;
        font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; flex-shrink: 0;
      }
      .mp-status-badge { font-size: 0.65rem; padding: 3px 8px; }

      /* Modal: full-screen app feel */
      .mp-modal-dialog { margin: 0; max-width: none; min-height: 100%; }
      .mp-modal { border-radius: 0; min-height: 100vh; min-height: 100dvh; }
      .mp-modal-header { padding: 1rem 1.25rem; }
      .mp-modal-body { padding: 1.25rem; max-height: calc(100vh - 64px); max-height: calc(100dvh - 64px); }
      .mp-modal-icon { width: 40px; height: 40px; font-size: 1rem; }
      .mp-modal-title { font-size: 0.95rem; }
      .mp-modal-sub { font-size: 0.7rem; }
      .mp-info-grid { grid-template-columns: 1fr; }
      .mp-info-card { background: #fff; border: 1px solid #f1f5f9; }
    }

    /* ═══ RESPONSIVE: ≤480px (small phone) ═══ */
    @media (max-width: 480px) {
      .container-fluid { padding-left: 0.75rem; padding-right: 0.75rem; }
      .mp-hero { padding: 1.5rem 1.25rem; border-radius: 12px; margin-bottom: 1.25rem; }
      .mp-hero-content { flex-direction: column; align-items: flex-start; gap: 1rem; }
      .mp-hero-icon { width: 48px; height: 48px; font-size: 1.3rem; border-radius: 12px; }
      .mp-hero-title { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.25rem; }
      .mp-hero-sub { font-size: 0.85rem; line-height: 1.5; opacity: 0.85; }
      .mp-hero-badge { padding: 8px 14px; font-size: 0.8rem; }

      .mp-kpi-row { gap: 8px; margin-bottom: 1.25rem; }
      .mp-kpi-card { padding: 10px 6px; border-radius: 12px; }
      .mp-kpi-icon { width: 32px; height: 32px; font-size: 0.82rem; }
      .mp-kpi-label { font-size: 0.55rem; }
      .mp-kpi-value { font-size: 0.88rem; }
      .mp-kpi-sub { font-size: 0.52rem; }

      .mp-history-table tr { padding: 0.625rem 0.875rem; margin-bottom: 0.625rem; }
      .mp-history-table td { padding: 0.5rem 0; font-size: 0.78rem; }
      .mp-history-table td::before { font-size: 0.68rem; }
      .mp-panel-title { font-size: 0.75rem; }

      .mp-modal-header { padding: 14px 16px; }
      .mp-modal-body { padding: 14px; }
      .mp-modal-title { font-size: 0.88rem; }
      .mp-modal-icon { width: 36px; height: 36px; font-size: 0.9rem; }
      .mp-section-icon { width: 24px; height: 24px; font-size: 0.65rem; }
      .mp-section-title { font-size: 0.63rem; }
      .mp-info-card { padding: 8px 11px; border-radius: 8px; }
      .mp-info-label { font-size: 0.58rem; }
      .mp-info-value { font-size: 0.78rem; }
      .mp-att-item { padding: 8px 4px; border-radius: 8px; }
      .mp-att-num { font-size: 1.05rem; }
      .mp-att-lbl { font-size: 0.54rem; }
      .mp-pay-box { padding: 12px 14px; }
      .mp-pay-row { font-size: 0.73rem; padding: 4px 0; }
      .mp-pay-total { font-size: 0.88rem; }
      .mp-pay-total .mp-pay-amount { font-size: 0.98rem; }
    }

    /* ═══ RESPONSIVE: ≤400px (tiny phone) ═══ */
    @media (max-width: 400px) {
      .mp-hero { padding: 1.25rem 0.875rem; border-radius: 12px; }
      .mp-hero-content { gap: 0.75rem; }
      .mp-hero-icon { width: 44px; height: 44px; font-size: 1.1rem; }
      .mp-hero-title { font-size: 1.2rem; }
      .mp-hero-sub { font-size: 0.78rem; }
      .mp-hero-badge { font-size: 0.75rem; padding: 6px 12px; }

      .mp-kpi-row { gap: 6px; }
      .mp-kpi-card { padding: 8px 5px; }
      .mp-kpi-icon { width: 28px; height: 28px; font-size: 0.72rem; }
      .mp-kpi-label { font-size: 0.5rem; }
      .mp-kpi-value { font-size: 0.78rem; }
      .mp-kpi-sub { font-size: 0.48rem; }

      .mp-history-table tr { padding: 0.5rem 0.75rem; }
      .mp-history-table td { padding: 0.4rem 0; font-size: 0.72rem; }
      .mp-history-table td::before { font-size: 0.62rem; }
    }
  </style>

  <!-- Hero Header (matches attendance td-hero) -->
  <div class="mp-hero">
    <div class="mp-hero-content">
      <div class="mp-hero-left">
        <div class="mp-hero-icon"><i class="bi bi-cash-coin"></i></div>
        <div>
          <h1 class="mp-hero-title">My Payroll</h1>
          <p class="mp-hero-sub">View your payroll records and payment history</p>
        </div>
      </div>
      <div class="mp-hero-right">
        <div class="mp-hero-badge">
          <i class="bi bi-calendar-month"></i>
          <span id="payrollPeriod">—</span>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI Cards (matches att-status-card visual language) -->
  <div class="mp-kpi-row">
    <div class="mp-kpi-card">
      <div class="mp-kpi-header">
        <div class="mp-kpi-icon" style="background: linear-gradient(135deg, #10b981, #059669);"><i class="bi bi-cash-stack"></i></div>
        <div class="mp-kpi-label">Total Earned</div>
      </div>
      <div class="mp-kpi-value" id="kpiTotalEarned">--</div>
      <div class="mp-kpi-sub">Paid records only</div>
    </div>
    <div class="mp-kpi-card">
      <div class="mp-kpi-header">
        <div class="mp-kpi-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);"><i class="bi bi-hourglass-split"></i></div>
        <div class="mp-kpi-label">Pending Payment</div>
      </div>
      <div class="mp-kpi-value" id="kpiPending">--</div>
      <div class="mp-kpi-sub">Approved, awaiting payment</div>
    </div>
    <div class="mp-kpi-card">
      <div class="mp-kpi-header">
        <div class="mp-kpi-icon" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);"><i class="bi bi-calendar-check"></i></div>
        <div class="mp-kpi-label">Last Payment</div>
      </div>
      <div class="mp-kpi-value" id="kpiLastPay" style="font-size:1.1rem;">--</div>
      <div class="mp-kpi-sub" id="kpiLastPayDate">—</div>
    </div>
  </div>

  <!-- Payroll History Panel (matches att-panel) -->
  <div class="mp-panel">
    <div class="mp-panel-header">
      <h6 class="mp-panel-title"><span class="mp-panel-title-icon"><i class="bi bi-list-ul"></i></span>Payroll History</h6>
      <button id="btnRefresh" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;font-size:0.78rem;"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>
    </div>
    <div class="mp-panel-body p-0">
      <table class="mp-history-table">
        <thead>
          <tr>
            <th>Period</th>
            <th class="text-end">Basic Pay</th>
            <th class="text-end">OT</th>
            <th class="text-end">Allowances</th>
            <th class="text-end">Deductions</th>
            <th class="text-end">Net Pay</th>
            <th>Status</th>
            <th>Payment Date</th>
          </tr>
        </thead>
        <tbody id="recordsBody">
          <tr><td colspan="8" class="mp-empty"><i class="bi bi-wallet2"></i><p>Loading your payroll records...</p></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  </div>
</div>

<!-- View Detail Modal -->
<div class="modal fade" id="viewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered mp-modal-dialog">
    <div class="modal-content mp-modal">
      <div class="mp-modal-header">
        <div class="mp-modal-header-left">
          <div class="mp-modal-icon" style="background:linear-gradient(135deg,#3b82f6,#2563eb);"><i class="bi bi-receipt-cutoff"></i></div>
          <div>
            <h5 class="mp-modal-title" id="viewTitle">Payroll Detail</h5>
            <p class="mp-modal-sub" id="viewSub">Full breakdown</p>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="mp-modal-body" id="viewBody"></div>
    </div>
  </div>
</div>

<script>
(function() {
  const API = '/api/payroll';
  const fmt = (n) => '\u20B1' + Number(n || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fmtDate = (d) => { if (!d) return '\u2014'; return new Date(d).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }); };
  let records = [];

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('btnRefresh').addEventListener('click', loadRecords);
    loadRecords();

    // Auto-refresh when a notification arrives via Socket.io
    if (window.socket) {
      window.socket.on('notification:new', function(data) {
        if (data && (data.type === 'payroll_approved' || data.type === 'payroll_paid')) {
          loadRecords();
        }
      });
    }
    // Fallback: poll every 30s
    setInterval(loadRecords, 30000);
  });

  async function loadRecords() {
    try {
      const res = await fetch(API, { credentials: 'same-origin' });
      const data = await res.json();
      records = data.records || [];
      renderStats();
      renderRecords();
    } catch(e) {
      document.getElementById('recordsBody').innerHTML = '<tr><td colspan="8" class="mp-empty"><i class="bi bi-exclamation-circle"></i><p>Failed to load payroll records</p></td></tr>';
    }
  }

  function renderStats() {
    const paid = records.filter(r => r.status === 'paid');
    const approved = records.filter(r => r.status === 'approved');
    const totalEarned = paid.reduce((s, r) => s + (r.netPay || 0), 0);
    const pendingTotal = approved.reduce((s, r) => s + (r.netPay || 0), 0);
    const lastPaid = paid.length ? paid.reduce((latest, r) => !latest || new Date(r.paidAt) > new Date(latest.paidAt) ? r : latest, null) : null;

    document.getElementById('kpiTotalEarned').textContent = fmt(totalEarned);
    document.getElementById('kpiPending').textContent = fmt(pendingTotal);

    // Update hero badge with current month
    const now = new Date();
    document.getElementById('payrollPeriod').textContent = now.toLocaleDateString('en-PH', { month: 'long', year: 'numeric' });
    if (lastPaid) {
      document.getElementById('kpiLastPay').textContent = fmt(lastPaid.netPay);
      document.getElementById('kpiLastPayDate').textContent = 'Paid ' + fmtDate(lastPaid.paidAt || lastPaid.paidDate);
    } else {
      document.getElementById('kpiLastPay').textContent = '\u2014';
      document.getElementById('kpiLastPayDate').textContent = 'No payments yet';
    }
  }

  function renderRecords() {
    const tbody = document.getElementById('recordsBody');
    if (!records.length) {
      tbody.innerHTML = '<tr><td colspan="8" class="mp-empty"><i class="bi bi-wallet2"></i><p>No payroll records found yet</p></td></tr>';
      return;
    }
    tbody.innerHTML = records.map(r => {
      const allowTotal = (r.allowances || []).reduce((s, i) => s + i.amount, 0);
      const statusIcon = r.status === 'paid' ? '<i class="bi bi-check-circle-fill me-1"></i>' : r.status === 'approved' ? '<i class="bi bi-clock me-1"></i>' : '';
      return `<tr onclick="window._mp.viewDetail('${r._id}')" style="cursor:pointer;">
        <td data-label="Period" style="white-space:nowrap;font-weight:500;">${fmtDate(r.periodStart)} \u2013 ${fmtDate(r.periodEnd)}</td>
        <td data-label="Basic Pay" class="text-end">${fmt(r.basicPay)}</td>
        <td data-label="OT" class="text-end">${fmt(r.overtimePay)}</td>
        <td data-label="Allowances" class="text-end">${fmt(allowTotal)}</td>
        <td data-label="Deductions" class="text-end" style="color:#dc2626;">-${fmt(r.totalDeductions)}</td>
        <td data-label="Net Pay" class="text-end" style="font-weight:700;color:#0f172a;">${fmt(r.netPay)}</td>
        <td data-label="Status"><span class="mp-status-badge mp-status-${r.status}">${statusIcon}${r.status}</span></td>
        <td data-label="Payment Date" style="white-space:nowrap;">${r.status === 'paid' ? fmtDate(r.paidAt || r.paymentDate) : '\u2014'}</td>
      </tr>`;
    }).join('');
  }

  async function viewDetail(id) {
    try {
      const res = await fetch(API + '/' + id, { credentials: 'same-origin' });
      const data = await res.json();
      const r = data.record;
      if (!r) return;

      const statusColors = { paid: '#059669', approved: '#2563eb', draft: '#d97706', voided: '#dc2626' };
      const statusLabels = { paid: 'Paid', approved: 'Approved', draft: 'Draft', voided: 'Voided' };
      const stColor = statusColors[r.status] || '#64748b';

      document.getElementById('viewTitle').textContent = 'Payroll Detail';
      document.getElementById('viewSub').textContent = fmtDate(r.periodStart) + ' \u2013 ' + fmtDate(r.periodEnd);

      const att = r.attendanceSummary || {};
      const allowTotal = (r.allowances || []).reduce((s, i) => s + i.amount, 0);
      const dedTotal = (r.deductions || []).reduce((s, i) => s + i.amount, 0);

      let allowHtml = '';
      if (r.allowances && r.allowances.length) {
        allowHtml = r.allowances.map(a => `<div class="mp-allow-row"><span style="color:#64748b;">${esc(a.name)}</span><span style="font-weight:500;">${fmt(a.amount)}</span></div>`).join('');
      }

      let dedHtml = '';
      if (r.deductions && r.deductions.length) {
        dedHtml = r.deductions.map(d => `<div class="mp-ded-row"><span style="color:#64748b;">${esc(d.name)}</span><span class="mp-ded-amount" style="font-weight:500;">-${fmt(d.amount)}</span></div>`).join('');
      }

      let paymentHtml = '';
      if (r.status === 'paid') {
        paymentHtml = `
          <div class="mp-section">
            <div class="mp-section-header">
              <div class="mp-section-icon" style="background:linear-gradient(135deg,#10b981,#059669);"><i class="bi bi-credit-card"></i></div>
              <p class="mp-section-title">Payment Information</p>
            </div>
            <div class="mp-payment-card">
              <div class="mp-info-grid">
                <div class="mp-info-card"><div class="mp-info-label">Method</div><div class="mp-info-value" style="text-transform:capitalize;">${esc((r.paymentMethod || '\u2014').replace('_', ' '))}</div></div>
                <div class="mp-info-card"><div class="mp-info-label">Payment Date</div><div class="mp-info-value">${fmtDate(r.paymentDate || r.paidAt)}</div></div>
                <div class="mp-info-card"><div class="mp-info-label">Reference</div><div class="mp-info-value">${esc(r.paymentReference || '\u2014')}</div></div>
                <div class="mp-info-card"><div class="mp-info-label">Paid By</div><div class="mp-info-value">${r.paidBy ? esc(r.paidBy.firstName + ' ' + r.paidBy.lastName) : '\u2014'}</div></div>
                ${r.paymentProof ? `<div class="mp-info-card"><div class="mp-info-label">Payment Proof</div><div class="mp-info-value"><a href="${esc(r.paymentProof)}" target="_blank" rel="noopener noreferrer">Open proof <i class="bi bi-box-arrow-up-right"></i></a></div></div>` : ''}
              </div>
            </div>
          </div>`;
      }

      let notesHtml = '';
      if (r.notes) {
        notesHtml = `<div class="mp-section"><div class="mp-notes"><i class="bi bi-info-circle me-1"></i>${esc(r.notes)}</div></div>`;
      }

      document.getElementById('viewBody').innerHTML = `
        <!-- Status + Pay Type -->
        <div class="mp-section">
          <div class="mp-info-grid">
            <div class="mp-info-card">
              <div class="mp-info-label">Status</div>
              <div class="mp-info-value"><span class="mp-status-badge mp-status-${r.status}" style="font-size:0.72rem;padding:5px 12px;">${statusLabels[r.status] || r.status}</span></div>
            </div>
            <div class="mp-info-card">
              <div class="mp-info-label">Pay Type</div>
              <div class="mp-info-value">${r.payType ? esc(r.payType.charAt(0).toUpperCase() + r.payType.slice(1)) + ' @ ' + fmt(r.baseRate) : '\u2014'}</div>
            </div>
            <div class="mp-info-card">
              <div class="mp-info-label">Pay Period</div>
              <div class="mp-info-value" style="font-size:0.78rem;">${fmtDate(r.periodStart)} \u2013 ${fmtDate(r.periodEnd)}</div>
            </div>
            <div class="mp-info-card">
              <div class="mp-info-label">Pay Date</div>
              <div class="mp-info-value">${fmtDate(r.payDate)}</div>
            </div>
          </div>
        </div>

        <!-- Attendance -->
        <div class="mp-section">
          <div class="mp-section-header">
            <div class="mp-section-icon" style="background:linear-gradient(135deg,#0ea5e9,#0284c7);"><i class="bi bi-calendar-check"></i></div>
            <p class="mp-section-title">Attendance Summary</p>
          </div>
          <div class="mp-att-grid">
            <div class="mp-att-item mp-att-present"><div class="mp-att-num">${att.present || 0}</div><div class="mp-att-lbl">Present</div></div>
            <div class="mp-att-item mp-att-late"><div class="mp-att-num">${att.late || 0}</div><div class="mp-att-lbl">Late</div></div>
            <div class="mp-att-item mp-att-absent"><div class="mp-att-num">${att.absent || 0}</div><div class="mp-att-lbl">Absent</div></div>
            <div class="mp-att-item mp-att-leave"><div class="mp-att-num">${att.onLeave || 0}</div><div class="mp-att-lbl">Leave</div></div>
            <div class="mp-att-item mp-att-sick"><div class="mp-att-num">${att.sickLeave || 0}</div><div class="mp-att-lbl">Sick</div></div>
            <div class="mp-att-item mp-att-hours"><div class="mp-att-num">${att.hoursWorked || 0}</div><div class="mp-att-lbl">Hours</div></div>
          </div>
        </div>

        <!-- Pay Breakdown -->
        <div class="mp-section">
          <div class="mp-section-header">
            <div class="mp-section-icon" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);"><i class="bi bi-calculator"></i></div>
            <p class="mp-section-title">Pay Breakdown</p>
          </div>
          <div class="mp-pay-box">
            <div class="mp-pay-row"><span class="mp-pay-label">Basic Pay</span><span class="mp-pay-amount">${fmt(r.basicPay)}</span></div>
            <div class="mp-pay-row"><span class="mp-pay-label">Overtime Pay (${Number(r.overtimeHours || 0)} hrs)</span><span class="mp-pay-amount">${fmt(r.overtimePay)}</span></div>
            ${r.overtimeNote ? `<div class="mp-pay-row"><span class="mp-pay-label">OT Authorization</span><span class="mp-pay-amount" style="max-width:65%;white-space:normal;text-align:right;">${esc(r.overtimeNote)}</span></div>` : ''}
            ${allowHtml ? '<div class="mp-pay-divider"></div>' + allowHtml : ''}
            <div class="mp-pay-divider"></div>
            <div class="mp-pay-row"><span class="mp-pay-label" style="font-weight:600;color:#334155;">Gross Pay</span><span class="mp-pay-amount" style="font-weight:700;">${fmt(r.grossPay)}</span></div>
            ${dedHtml ? '<div class="mp-pay-divider"></div>' + '<div style="font-size:0.7rem;font-weight:600;color:#94a3b8;text-transform:uppercase;margin:4px 0 2px;">Deductions</div>' + dedHtml : ''}
            ${dedTotal > 0 ? `<div class="mp-pay-row"><span class="mp-pay-label" style="color:#dc2626;">Total Deductions</span><span class="mp-pay-amount" style="color:#dc2626;">-${fmt(dedTotal)}</span></div>` : ''}
            <div class="mp-pay-total"><span>Net Pay</span><span class="mp-pay-amount">${fmt(r.netPay)}</span></div>
          </div>
        </div>

        ${notesHtml}
        ${paymentHtml}
      `;

      new bootstrap.Modal(document.getElementById('viewModal')).show();
    } catch(e) {
      console.error('Failed to load payroll detail:', e);
    }
  }

  function esc(str) { const d = document.createElement('div'); d.textContent = str || ''; return d.innerHTML; }

  window._mp = { viewDetail };
})();
</script>
