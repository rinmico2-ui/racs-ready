<div class="admin-dashboard container-fluid py-4 inventory-premium">
  <%- include('../../../partials/dashboard-styles') %>
  <style>
    /* ── Enterprise KPI Card Styles (matching Appointments page) ── */
    .inventory-premium .dash-card {
      background: #fff;
      border-radius: 18px;
      padding: 1.5rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      border: 1px solid #f1f5f9;
    }
    .inventory-premium .dash-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    }
    .inventory-premium .kpi-title { font-size: 0.75rem; font-weight: 600; color: #64748b; margin-bottom: 6px; }
    .inventory-premium .kpi-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px rgba(0,0,0,0.12);
      flex-shrink: 0;
    }
    .inventory-premium .kpi-icon i { color: #fff !important; font-size: 1.3rem; }
    .inventory-premium .inv-kpi-value { font-size: 1.5rem; font-weight: 700; color: #0f172a; line-height: 1.1; margin-bottom: 8px; }
    .inventory-premium .inv-kpi-currency { font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: flex-start; margin-top: 2px; }
    .inventory-premium .inv-kpi-sub { display: block; font-size: 0.75rem; color: #94a3b8; margin-top: 4px; }
    .inventory-premium .inv-kpi-pill { font-size: 0.7rem; padding: 2px 8px; border-radius: 20px; font-weight: 700; }
    .inventory-premium .kpi-trend { display: inline-flex; align-items: center; gap: 2px; font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 20px; background: #f0fdf4; color: #16a34a; }
    .inventory-premium .kpi-trend i { font-size: 0.7rem; }
    .inventory-premium .dash-card { display: flex; flex-direction: column; }
    .inventory-premium .inv-kpi-spark-wrap { width: 100%; height: 40px; margin-top: auto; }
    .inventory-premium .inv-kpi-spark { width: 100% !important; height: 100% !important; display: block; }
    /* Toolbar matching Repair Parts */
    .inventory-premium .rp-toolbar { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 16px 20px; margin-bottom: 20px; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px; }
    .inventory-premium .rp-filter-group { display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 180px; }
    .inventory-premium .rp-filter-group.search { flex: 1.8; }
    .inventory-premium .rp-filter-label { font-size: 0.65rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.6px; }
    .inventory-premium .rp-filter-group .input-group-text { background: #fff; border-color: #e2e8f0; color: #64748b; border-radius: 10px 0 0 10px; height: 42px; }
    .inventory-premium .rp-filter-group .form-control { border-color: #e2e8f0; border-radius: 0 10px 10px 0; height: 42px; }
    .inventory-premium .rp-filter-input { border-radius: 10px; border-color: #e2e8f0; height: 42px; }
    .inventory-premium .rp-filter-btn { height: 42px; border-radius: 10px; padding: 0 20px; font-weight: 600; }
    .inventory-premium .bg-success-subtle { background-color: rgba(16, 185, 129, 0.15); }
    .inventory-premium .bg-info-subtle { background-color: rgba(8, 145, 178, 0.15); }
    .inventory-premium .bg-warning-subtle { background-color: rgba(245, 158, 11, 0.15); }
    .inventory-premium .bg-danger-subtle { background-color: rgba(220, 38, 38, 0.15); }
    .inventory-premium .bg-primary-subtle { background-color: rgba(59, 130, 246, 0.15); }
    .inventory-premium .bg-secondary-subtle { background-color: rgba(100, 116, 139, 0.15); }
    .inventory-premium .fs-7 { font-size: 0.75rem; }

    /* Product save toast (POS-style) */
    .inv-toast-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 999999; justify-content: center; align-items: center; }
    .inv-toast-overlay.show { display: flex; }
    .inv-toast-modal { background: #fff; border-radius: 16px; width: 420px; max-width: 90%; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.3); animation: inv-toast-in 0.2s ease; }
    @keyframes inv-toast-in { from { opacity: 0; transform: translateY(-20px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .inv-toast-header { padding: 18px 24px; background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 40%, #2563eb 100%); color: #fff; font-weight: 700; font-size: 1.05rem; text-align: center; position: relative; }
    .inv-toast-close { position: absolute; top: 50%; right: 16px; transform: translateY(-50%); background: none; border: none; color: #fff; font-size: 1.15rem; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; }
    .inv-toast-close:hover { background: rgba(255,255,255,0.15); }
    .inv-toast-body { padding: 24px; text-align: center; }
    .inv-toast-icon { width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; }
    .inv-toast-icon.success { background: #dcfce7; color: #16a34a; }
    .inv-toast-message { font-size: 0.95rem; color: #334155; margin: 0 0 20px; line-height: 1.5; }
    .inv-toast-ok { padding: 10px 36px; border-radius: 10px; border: none; background: #e2e8f0; color: #0f172a; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: all 0.15s; }
    .inv-toast-ok:hover { background: #cbd5e1; }

    /* Variant confirm modal (POS-style header) */
    .inv-confirm-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 999999; justify-content: center; align-items: center; }
    .inv-confirm-overlay.show { display: flex; }
    .inv-confirm-modal { background: #fff; border-radius: 16px; width: 420px; max-width: 90%; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.3); animation: inv-toast-in 0.2s ease; }
    .inv-confirm-header { padding: 18px 24px; background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 40%, #2563eb 100%); color: #fff; font-weight: 700; font-size: 1.05rem; text-align: center; position: relative; }
    .inv-confirm-close { position: absolute; top: 50%; right: 16px; transform: translateY(-50%); background: none; border: none; color: #fff; font-size: 1.15rem; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; }
    .inv-confirm-close:hover { background: rgba(255,255,255,0.15); }
    .inv-confirm-body { padding: 24px; text-align: center; }
    .inv-confirm-icon { width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; }
    .inv-confirm-icon.warning { background: #fef3c7; color: #f59e0b; }
    .inv-confirm-icon.success { background: #dcfce7; color: #16a34a; }
    .inv-confirm-icon.error { background: #fee2e2; color: #ef4444; }
    .inv-confirm-icon.info { background: #dbeafe; color: #3b82f6; }
    .inv-confirm-message { font-size: 1rem; color: #334155; margin: 0 0 20px; line-height: 1.5; }
    .inv-confirm-message strong { color: #0f172a; display: block; margin-bottom: 6px; }
    .inv-confirm-message small { color: #64748b; }
    .inv-confirm-actions { display: flex; justify-content: center; gap: 10px; }
    .inv-confirm-cancel { padding: 10px 24px; border-radius: 10px; border: none; background: #e2e8f0; color: #0f172a; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: all 0.15s; }
    .inv-confirm-cancel:hover { background: #cbd5e1; }
    .inv-confirm-delete { padding: 10px 24px; border-radius: 10px; border: none; background: #dc2626; color: #fff; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: all 0.15s; }
    .inv-confirm-delete:hover { background: #b91c1c; }
  </style>
  
  <!-- Standard Hero Header (match stock history) -->
  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-bar-chart-line"></i></div>
        <div>
          <h1>Inventory Management</h1>
          <p>Track and manage stock movement, tools, and product inventory details</p>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-lg col-md-6">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="0">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="kpi-title">Total Items</div>
            <div class="d-flex align-items-center gap-2">
              <span class="inv-kpi-value mb-0" id="kpiTotalItems">0</span>
              <span class="kpi-trend"><i class="bi bi-arrow-up"></i>0%</span>
              <span class="badge inv-kpi-pill bg-primary-subtle text-primary">All</span>
            </div>
            <span class="inv-kpi-sub">SKUs in catalog</span>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #2563eb, #1d4ed8);">
            <i class="bi bi-box-seam-fill"></i>
          </div>
        </div>
        <div class="inv-kpi-spark-wrap"><canvas class="inv-kpi-spark" id="kpiTotalSpark"></canvas></div>
      </div>
    </div>
    <div class="col-lg col-md-6">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="100">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="kpi-title">Low Stock Items</div>
            <div class="d-flex align-items-center gap-2">
              <span class="inv-kpi-value mb-0" id="kpiLowStock">0</span>
              <span class="kpi-trend"><i class="bi bi-arrow-up"></i>0%</span>
              <span class="badge inv-kpi-pill bg-danger-subtle text-danger">Alert</span>
            </div>
            <span class="inv-kpi-sub">Below threshold</span>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
            <i class="bi bi-exclamation-triangle-fill"></i>
          </div>
        </div>
        <div class="inv-kpi-spark-wrap"><canvas class="inv-kpi-spark" id="kpiLowStockSpark"></canvas></div>
      </div>
    </div>
    <div class="col-lg col-md-6">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="200">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="kpi-title">Total Value</div>
            <div class="d-flex align-items-start gap-1">
              <span class="inv-kpi-currency">₱</span>
              <span class="inv-kpi-value mb-0" id="kpiTotalValue">0.00</span>
            </div>
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="kpi-trend"><i class="bi bi-arrow-up"></i>0%</span>
              <span class="badge inv-kpi-pill bg-success-subtle text-success">Value</span>
            </div>
            <span class="inv-kpi-sub">Inventory worth</span>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #10b981, #059669);">
            <i class="bi bi-currency-dollar"></i>
          </div>
        </div>
        <div class="inv-kpi-spark-wrap"><canvas class="inv-kpi-spark" id="kpiTotalValueSpark"></canvas></div>
      </div>
    </div>
    <div class="col-lg col-md-6">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="300">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="kpi-title">Assigned to Techs</div>
            <div class="d-flex align-items-center gap-2">
              <span class="inv-kpi-value mb-0" id="kpiAssigned">0</span>
              <span class="kpi-trend"><i class="bi bi-arrow-up"></i>0%</span>
              <span class="badge inv-kpi-pill bg-warning-subtle text-warning">Assigned</span>
            </div>
            <span class="inv-kpi-sub">Units dispatched</span>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
            <i class="bi bi-people-fill"></i>
          </div>
        </div>
        <div class="inv-kpi-spark-wrap"><canvas class="inv-kpi-spark" id="kpiAssignedSpark"></canvas></div>
      </div>
    </div>
  </div>
  <!-- Inventory Header -->
  <div class="mb-3" style="border-bottom:2px solid rgba(37,99,235,0.15); padding-bottom: 0.5rem;">
    <h5 class="text-primary mb-0"><i class="bi bi-snow2 me-2"></i>Aircon Products</h5>
  </div>

  <div class="tab-content">
    <!-- ── AIRCON SECTION ───────────────────────────────────── -->
    <div class="tab-pane fade show active" id="pane-aircon" role="tabpanel">

  <!-- Premium Filters -->
  <div class="rp-toolbar">
    <div class="rp-filter-group search">
      <label class="rp-filter-label" for="airconSearchInput"><i class="bi bi-search me-1"></i>Search Aircon</label>
      <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" id="airconSearchInput" placeholder="Model, SKU, or Brand..." />
      </div>
    </div>
    <div class="rp-filter-group">
      <label class="rp-filter-label" for="airconStatusFilter"><i class="bi bi-funnel me-1"></i>Status</label>
      <select class="form-select rp-filter-input" id="airconStatusFilter" style="height:42px;">
        <option value="all">All Status</option>
        <option value="in_stock">In Stock</option>
        <option value="low_stock">Low Stock</option>
        <option value="out_of_stock">Out of Stock</option>
      </select>
    </div>
    <div class="rp-filter-group">
      <label class="rp-filter-label" for="airconSort"><i class="bi bi-arrow-down-up me-1"></i>Sort By</label>
      <select class="form-select rp-filter-input" id="airconSort" style="height:42px;">
        <option value="modelLine">Name A-Z</option>
        <option value="-modelLine">Name Z-A</option>
        <option value="totalQuantity">Stock Low-High</option>
        <option value="-totalQuantity">Stock High-Low</option>
        <option value="-createdAt">Newest</option>
      </select>
    </div>
    <button class="btn btn-primary rp-filter-btn" type="button" id="airconFilterBtn" title="Apply filters"><i class="bi bi-funnel-fill me-2"></i>Filter</button>
  </div>

  <!-- Aircon Table -->
  <div class="inv-table-card">
    <div class="inv-table-header">
      <h6><i class="bi bi-snow2"></i> Aircon Product Stock</h6>
      <div class="inv-table-actions">
        <button class="inv-btn-icon" title="Export"><i class="bi bi-download"></i></button>
        <button class="inv-btn-icon" title="Print"><i class="bi bi-printer"></i></button>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table inv-table">
        <thead>
          <tr>
            <th class="ps-4" style="min-width: 220px;"><i class="bi bi-box-seam me-2"></i> Product Details</th>
            <th style="min-width: 100px;"><i class="bi bi-info-circle me-2"></i> Specs</th>
            <th style="min-width: 100px;"><i class="bi bi-cpu me-2"></i> HP</th>
            <th style="min-width: 110px;"><i class="bi bi-currency-dollar me-2"></i> Price</th>
            <th style="min-width: 90px;"><i class="bi bi-graph-up me-2"></i> Stock</th>
            <th style="min-width: 90px;"><i class="bi bi-activity me-2"></i> Status</th>
            <th class="text-center" style="min-width: 110px;"><i class="bi bi-gear-wide-connected me-2"></i> Actions</th>
          </tr>
        </thead>
        <tbody id="inventoryTableBody">
          <tr>
            <td colspan="9" class="inv-loading-cell" id="loadingRow">
              <div class="inv-spinner">
                <div class="inv-spinner-ring"></div>
                <div class="inv-spinner-ring"></div>
                <div class="inv-spinner-ring"></div>
              </div>
              <span>Loading aircon products...</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="inv-table-footer">
      <div class="inv-summary" id="inventorySummary">&nbsp;</div>
      <nav aria-label="Inventory pagination">
        <ul id="inventory-pagination" class="inv-pagination"></ul>
      </nav>
    </div>
  </div>

    </div><!-- end #pane-aircon -->
  </div><!-- end tab-content -->

  <!-- Aircon Product Modal -->
  <div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" style="margin-top: 8vh">
      <div class="modal-content inv-modal-content">
        <div class="modal-header inv-modal-header">
          <h5 class="inv-modal-title" id="addItemModalTitle">
            <i class="bi bi-snow2"></i> Add Aircon Product
          </h5>
          <button type="button" class="inv-modal-close" data-bs-dismiss="modal">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
        <div class="modal-body inv-modal-body">
          <div id="inventoryFormAlert" class="alert d-none mb-3"></div>
          <form id="inventoryForm" class="row g-3">
            <!-- Model Line -->
            <div class="col-md-6">
              <label class="inv-field-label" for="invModelLine">Model Line <span class="text-danger">*</span></label>
              <div class="inv-input-wrapper">
                <i class="bi bi-snow2 inv-input-icon"></i>
                <input type="text" id="invModelLine" class="inv-input" placeholder="e.g. Carrier Nexus Inverter" required />
              </div>
            </div>
            <!-- Brand -->
            <div class="col-md-3">
              <label class="inv-field-label" for="invBrand">Brand</label>
              <div class="inv-select-wrapper">
                <i class="bi bi-building inv-select-icon-left"></i>
                <select class="inv-select" id="invBrand">
                  <option value="">Select Brand</option>
                </select>
                <i class="bi bi-chevron-down inv-select-icon-right"></i>
              </div>
            </div>
            <!-- Category -->
            <div class="col-md-3">
              <label class="inv-field-label" for="invCategory">Category</label>
              <div class="inv-select-wrapper">
                <i class="bi bi-tags inv-select-icon-left"></i>
                <select class="inv-select" id="invCategory">
                  <option value="">Select Category</option>
                </select>
                <i class="bi bi-chevron-down inv-select-icon-right"></i>
              </div>
            </div>
            <!-- Product Image -->
            <div class="col-12">
              <label class="inv-field-label" for="invImage"><i class="bi bi-image me-1"></i>Product Image</label>
              <div class="row align-items-center g-3">
                <div class="col-md-7">
                  <input type="file" id="invImage" class="d-none" accept="image/*" />
                  <div class="d-flex align-items-center gap-3 p-3 border rounded" style="background:#f8fafc;">
                    <label for="invImage" class="btn btn-outline-primary btn-sm">
                      <i class="bi bi-upload me-1"></i> Choose Image
                    </label>
                    <span id="invImageName" class="text-muted small">No file chosen</span>
                  </div>
                  <div class="inv-field-hint">Upload product image (JPG, PNG, max 5MB)</div>
                </div>
                <div class="col-md-5">
                  <div class="d-flex align-items-center gap-3" style="min-height:80px;">
                    <div class="inv-image-preview" id="invImagePreview" style="display:none;">
                      <img src="" alt="Product preview" class="rounded border" style="height:80px;width:80px;object-fit:cover;">
                    </div>
                    <div class="inv-image-placeholder" id="invImagePlaceholder">
                      <div class="text-center text-muted p-3 border rounded bg-light" style="height:80px;width:80px;display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-image fs-3"></i>
                      </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="removeImageBtn" style="display:none;">
                      <i class="bi bi-trash me-1"></i> Remove
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <!-- Type -->
            <div class="col-md-4">
              <label class="inv-field-label" for="invType">Aircon Type <span class="text-danger">*</span></label>
              <div class="inv-select-wrapper">
                <i class="bi bi-lightning inv-select-icon-left"></i>
                <select class="inv-select" id="invType" required>
                  <option value="split">Split Type</option>
                  <option value="split_ceiling">Split Type - Ceiling Suspended</option>
                  <option value="window_inverter">Window Type - Inverter</option>
                  <option value="window_non_inverter">Window Type - Non Inverter</option>
                  <option value="floor_mounted">Floor Mounted</option>
                </select>
                <i class="bi bi-chevron-down inv-select-icon-right"></i>
              </div>
            </div>
            <!-- Inverter Toggle -->
            <div class="col-md-6">
              <label class="inv-field-label">Inverter</label>
              <div class="form-check form-switch mt-1">
                <input class="form-check-input" type="checkbox" id="invInverter" style="width:3em;height:1.5em;">
                <label class="form-check-label text-muted" for="invInverter" style="margin-top:2px;">Inverter Tech</label>
              </div>
            </div>
            <!-- Status -->
            <div class="col-md-6">
              <label class="inv-field-label" for="invStatus">Status</label>
              <div class="inv-select-wrapper">
                <i class="bi bi-circle-fill inv-select-icon-left"></i>
                <select class="inv-select" id="invStatus">
                  <option value="">Auto-detect</option>
                  <option value="in_stock">In Stock</option>
                  <option value="low_stock">Low Stock</option>
                  <option value="out_of_stock">Out of Stock</option>
                  <option value="coming_soon">Coming Soon</option>
                  <option value="discontinued">Discontinued</option>
                </select>
                <i class="bi bi-chevron-down inv-select-icon-right"></i>
              </div>
            </div>
            <!-- Warranty -->
            <div class="col-md-6">
              <label class="inv-field-label" for="invWarranty">Warranty</label>
              <div class="inv-input-wrapper">
                <i class="bi bi-shield-check inv-input-icon"></i>
                <input type="text" id="invWarranty" class="inv-input" placeholder="e.g. 5 Years Compressor, 1 Year Parts" />
              </div>
            </div>
            <!-- Description -->
            <div class="col-12">
              <label class="inv-field-label" for="invDescription">Description</label>
              <textarea id="invDescription" class="inv-textarea" rows="3" placeholder="Enter product description..."></textarea>
            </div>
            
            <!-- HVAC Variants Section -->
            <div class="col-12 mt-4">
              <div class="border rounded p-3 bg-light">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h6 class="mb-0 fw-bold text-primary">
