          <h4 style="font-size:1rem;font-weight:700;margin-bottom:0.35rem;"><i class="bi bi-receipt me-2" style="color:#059669;"></i>Proof of Payment</h4>
          <p style="font-size:0.8rem;color:#64748b;margin-bottom:0.9rem;">Record the customer's payment and attach a receipt / proof reference.</p>
          <div class="row g-2">
            <div class="col-6">
              <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Total Amount (₱)</label>
              <input id="payTotal" type="number" class="form-control form-control-sm mt-1" min="0" value="${pay.totalAmount || ''}" placeholder="0">
            </div>
            <div class="col-6">
              <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Amount Paid (₱)</label>
              <input id="payPaid" type="number" class="form-control form-control-sm mt-1" min="0" value="${pay.amountPaid || ''}" placeholder="0">
            </div>
            <div class="col-6 mt-2">
              <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Balance (₱)</label>
              <input id="payBal" type="number" class="form-control form-control-sm mt-1" min="0" value="${pay.balanceAmount || ''}" placeholder="0">
            </div>
            <div class="col-6 mt-2">
              <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Method</label>
              <input id="payMethod" class="form-control form-control-sm mt-1" value="${pay.paymentMethod || ''}" placeholder="e.g., GCash, Bank, Cash">
            </div>
            <div class="col-6 mt-2">
              <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Status</label>
              <select id="payStatus" class="form-select form-select-sm mt-1">
                <option value="unpaid" ${pay.paymentStatus === 'unpaid' ? 'selected' : ''}>Unpaid</option>
                <option value="partial" ${pay.paymentStatus === 'partial' ? 'selected' : ''}>Partial</option>
                <option value="paid" ${pay.paymentStatus === 'paid' ? 'selected' : ''}>Paid</option>
                <option value="refunded" ${pay.paymentStatus === 'refunded' ? 'selected' : ''}>Refunded</option>
              </select>
            </div>
            <div class="col-12 mt-2">
              <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Proof of Payment (receipt photo)</label>
              <input type="file" id="payProofFile" class="form-control form-control-sm mt-1" accept="image/png,image/jpeg,image/webp" onchange="previewPaymentProof(this)">
              <div id="payProofPreview" class="mt-2" style="display:${pay.proofUrl ? 'block' : 'none'};">
                ${pay.proofUrl ? `<img src="${pay.proofUrl}" style="max-height:120px;border-radius:8px;border:1px solid #e2e8f0;"><div class="mt-1"><a href="${pay.proofUrl}" target="_blank" class="pw-tag" style="text-decoration:none;font-size:0.74rem;"><i class="bi bi-paperclip"></i> View current</a></div>` : ''}
              </div>
              <input type="hidden" id="payProofUrl" value="${pay.proofUrl || ''}">
              <small class="text-muted" style="font-size:0.7rem;">Upload a screenshot of the receipt, or paste a link below.</small>
              <input id="payUrl" class="form-control form-control-sm mt-1" value="${pay.proofUrl && !pay.proofUrl.startsWith('/uploads/') ? pay.proofUrl : ''}" placeholder="https://... or receipt no.">
            </div>
            <div class="col-12 mt-2">
              <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Note</label>
              <textarea id="payNote" class="form-control form-control-sm mt-1" rows="2" placeholder="Optional note">${pay.proofNote || ''}</textarea>
            </div>
          </div>
          <div class="d-flex gap-2 justify-content-end mt-3">
            <button class="pd-btn" onclick="closeModal(this)">Cancel</button>
            <button class="pd-btn primary" id="savePayBtn">Save Proof</button>
          </div>
        </div>`;
      document.body.appendChild(modal);

      // Show a preview of a freshly chosen file before upload.
      window.previewPaymentProof = function(input) {
        const preview = modal.querySelector('#payProofPreview');
        if (input.files && input.files[0]) {
          const url = URL.createObjectURL(input.files[0]);
          preview.innerHTML = `<img src="${url}" style="max-height:120px;border-radius:8px;border:1px solid #e2e8f0;">`;
          preview.style.display = 'block';
        }
      };

      modal.querySelector('#savePayBtn').addEventListener('click', async function() {
        // Upload the receipt image first (if one was chosen), then save.
        const fileInput = modal.querySelector('#payProofFile');
        let proofUrl = modal.querySelector('#payProofUrl').value.trim();
        if (fileInput.files && fileInput.files[0]) {
          const fd = new FormData();
          fd.append('proofPhoto', fileInput.files[0]);
          try {
            const up = await fetch(`/api/projects/${projectId}/upload-payment-proof`, { method: 'POST', body: fd });
            if (up.ok) { const ud = await up.json(); proofUrl = ud.url || proofUrl; }
            else { const ue = await up.json(); toast(ue.error || 'Upload failed', 'error'); return; }
          } catch(e) { toast('Upload failed', 'error'); return; }
        }
        // Manual URL overrides only if the user typed one.
        const typedUrl = modal.querySelector('#payUrl').value.trim();
        if (typedUrl) proofUrl = typedUrl;

        const body = {
          totalAmount: parseFloat(modal.querySelector('#payTotal').value) || 0,
          amountPaid: parseFloat(modal.querySelector('#payPaid').value) || 0,
          balanceAmount: parseFloat(modal.querySelector('#payBal').value) || 0,
          paymentMethod: modal.querySelector('#payMethod').value.trim(),
          paymentStatus: modal.querySelector('#payStatus').value,
          proofUrl,
          proofNote: modal.querySelector('#payNote').value.trim(),
        };
        await withBtnLoading(this, 'Saving…', async () => {
          try {
            const r = await fetch(`/api/projects/${projectId}/payment`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            const d = await r.json().catch(() => ({}));
            if (r.ok) { toast('Proof of payment saved'); modal.remove(); loadProject(); }
            else toast(d.error || 'Failed', 'error');
          } catch(e) { toast('Failed', 'error'); }
        });
      });
      modal.addEventListener('click', function(e) { if (e.target === this) this.remove(); });
    } catch(e) { toast('Failed to open', 'error'); }
  };

  // ── Team acceptance gate helper ──
  function teamAcceptancePending(p) {
    if (!p || !p.assignedTechnicians?.length) return false;
    const teamStatus = p.teamStatus || [];
    return (p.assignedTechnicians || []).some(t => {
      const tid = (t._id || '').toString();
      const ts = teamStatus.find(s => (s._id || '').toString() === tid);
      return !ts || ts.status !== 'acknowledged';
    });
  }

  window.showWorkOrderModal = async function() {
    const p = window.__projectData;

    const buildField = () => `
      <div class="wo-field mb-3 p-3" style="background:#f8fafc;border-radius:10px;">
        <div class="row g-2">
          <div class="col-md-6">
            <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Section / Location</label>
            <input type="text" class="form-control form-control-sm wo-section" placeholder="e.g., Building A" style="font-size:0.82rem;">
          </div>
          <div class="col-md-3">
            <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Unit Count</label>
            <input type="number" class="form-control form-control-sm wo-units" value="1" min="1" style="font-size:0.82rem;">
          </div>
          <div class="col-md-3">
            <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Est. Hours</label>
            <input type="number" class="form-control form-control-sm wo-hours" value="8" min="1" style="font-size:0.82rem;">
          </div>
          <div class="col-md-12 mt-2">
            <label style="font-size:0.72rem;font-weight:600;color:#64748b;">Title</label>
            <input type="text" class="form-control form-control-sm wo-title" placeholder="e.g., Aircon Cleaning - Building A" style="font-size:0.82rem;">
          </div>
        </div>
        <button class="btn btn-sm btn-link text-danger p-0 mt-2" onclick="this.closest('.wo-field').remove()" style="font-size:0.72rem;">Remove</button>
      </div>`;

    const modal = document.createElement('div');
    modal.className = 'pd-modal-overlay';
    modal.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);z-index:9999;display:flex;align-items:center;justify-content:center;';
    modal.innerHTML = `
      <div style="background:#fff;border-radius:16px;padding:1.5rem;width:680px;max-width:92vw;max-height:85vh;overflow-y:auto;">
        <h4 style="font-size:1rem;font-weight:700;margin-bottom:0.35rem;">Create Draft Work Orders</h4>
        <p style="font-size:0.82rem;color:#64748b;margin-bottom:1rem;">Create team-owned work batches from uncovered project units. The lead coordinates individual unit work during execution.</p>
        <div id="workOrderFields">${buildField()}</div>
        <button class="pd-btn mb-3" onclick="addWorkOrderField()"><i class="bi bi-plus-lg"></i> Add Another Work Order</button>
        <div class="d-flex gap-2 justify-content-end">
          <button class="pd-btn" onclick="closeModal(this)">Cancel</button>
          <button class="pd-btn primary" id="saveWorkOrdersBtn">Create Work Orders</button>
        </div>
      </div>
    `;
    document.body.appendChild(modal);
    window.addWorkOrderField = function() {
      qs('#workOrderFields').insertAdjacentHTML('beforeend', buildField());
    };
    modal.querySelector('#saveWorkOrdersBtn').addEventListener('click', async function() {
      const fields = [...modal.querySelectorAll('.wo-field')];
      const workOrders = fields.map(f => {
        return {
          section: f.querySelector('.wo-section')?.value || '',
          unitCount: parseInt(f.querySelector('.wo-units')?.value) || 1,
          estimatedHours: parseInt(f.querySelector('.wo-hours')?.value) || 8,
          title: f.querySelector('.wo-title')?.value || '',
          status: 'pending',
        };
      }).filter(wo => wo.section || wo.title);

      if (workOrders.length === 0) { toast('Add at least one work order', 'error'); return; }
      await withBtnLoading(this, 'Creating…', async () => {
        try {
          const r = await fetch(`/api/projects/${projectId}/work-orders`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ workOrders }),
          });
          if (r.ok) { toast('Work orders created'); modal.remove(); loadProject(); }
          else { const e = await r.json(); toast(e.error || 'Failed', 'error'); }
        } catch(e) { toast('Failed', 'error'); }
      });
    });
    modal.addEventListener('click', function(e) { if (e.target === this) this.remove(); });
  };

  // ── Schedule Wizard: interactive calendar with technician availability ──
  window.showScheduleWizard = async function() {
    const sp = window.__projectData;
    if (sp && teamAcceptancePending(sp)) { toast('All team members must accept the assignment before scheduling', 'error'); return; }
    const wos = (window.__lastWorkOrders || []).slice().sort((a,b) => (a.sortOrder||0)-(b.sortOrder||0));
    if (wos.length === 0) { toast('Create work orders first', 'error'); return; }
    const p = window.__projectData || {};
    const startStr = p.preferredStartDate ? new Date(p.preferredStartDate).toISOString().slice(0,10) : '';
    const endStr = p.preferredCompletionDeadline ? new Date(p.preferredCompletionDeadline).toISOString().slice(0,10) : '';

    // Local working copy of assignments: woId -> date string
    const assignments = {};
    wos.forEach(wo => { assignments[wo._id] = wo.scheduledDate ? new Date(wo.scheduledDate).toISOString().slice(0,10) : ''; });
    let activeWo = wos[0]._id;

    // Availability + calendar payload
    let cal = { days: [], technicians: [] };
    try {
      const r = await fetch(`/api/projects/${projectId}/schedule-calendar`);
      if (r.ok) { const d = await r.json(); cal = d.calendar || cal; }
    } catch (_) {}
    const dayMap = {};
    (cal.days || []).forEach(d => { dayMap[d.date] = d; });
    const techName = (id) => { const t = (cal.technicians||[]).find(t => t._id === id); return t ? t.name : 'Technician'; };

    const boundNote = (startStr || endStr)
      ? `Customer window: <strong>${startStr ? 'Start ' + startStr : '—'}</strong> → <strong>${endStr ? 'Due ' + endStr : '—'}</strong>. Pick a day inside this range.`
      : 'No customer window set — any date allowed.';

    const modal = document.createElement('div');
    modal.className = 'pd-modal-overlay';
    modal.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,0.45);z-index:9999;display:flex;align-items:center;justify-content:center;padding:1rem;';
    modal.innerHTML = `
      <div class="sched-wizard">
        <div class="sw-head">
          <div>
            <h4 style="font-size:1.02rem;font-weight:700;margin:0;"><i class="bi bi-calendar2-week me-2" style="color:#4f46e5;"></i>Plan Project Schedule</h4>
            <div style="font-size:0.78rem;color:#64748b;margin-top:0.2rem;">${boundNote}</div>
          </div>
          <button class="pd-btn" onclick="closeModal(this)">Close</button>
        </div>

        <div class="sw-body">
          <!-- LEFT: work order queue -->
          <div class="sw-left">
            <div class="sw-left-title">Work Orders <span class="sw-hint">— click to schedule</span></div>
            <div id="swQueue"></div>
            <div id="swActiveInfo" class="sw-active-info"></div>
            <div class="sw-legend">
              <div><span class="sw-dot free"></span> Team available</div>
              <div><span class="sw-dot tight"></span> Limited capacity</div>
              <div><span class="sw-dot busy"></span> Tech unavailable</div>
            </div>
          </div>

          <!-- RIGHT: calendar grid -->
          <div class="sw-right">
            <div class="sw-cal-head" id="swCalHead"></div>
            <div class="sw-weekdays"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
            <div class="sw-grid" id="swGrid"></div>
          </div>
        </div>

        <div id="swBanner" class="sw-banner" style="display:none;"></div>
        <div class="sw-foot">
          <div id="swProgress" class="sw-progress"></div>
          <div class="d-flex gap-2">
            <button class="pd-btn" onclick="closeModal(this)">Cancel</button>
            <button class="pd-btn primary" id="saveScheduleBtn">Save Schedule</button>
          </div>
        </div>
      </div>`;
    document.body.appendChild(modal);

    function fmtKey(d) { const x = new Date(d); return `${x.getFullYear()}-${String(x.getMonth()+1).padStart(2,'0')}-${String(x.getDate()).padStart(2,'0')}`; }
    function activeTech() { const wo = wos.find(w => w._id === activeWo); return wo && wo.assignedTechnicians && wo.assignedTechnicians[0] ? (wo.assignedTechnicians[0]._id || wo.assignedTechnicians[0]) : ''; }

    function renderQueue() {
      const q = modal.querySelector('#swQueue');
      q.innerHTML = wos.map(wo => {
        const set = assignments[wo._id];
        const active = wo._id === activeWo;
        const tech = (wo.assignedTechnicians && wo.assignedTechnicians[0]?.name) || 'Unassigned';
        const busy = set && dayMap[set] && activeTech() && (dayMap[set].matrix||[]).find(m => m._id === String(activeTech()) && m.status !== 'free');
        return `
          <button class="sw-wo ${active ? 'active' : ''} ${set ? 'done' : ''}" data-wo="${wo._id}" type="button">
            <div class="sw-wo-top"><span class="sw-wo-title">${wo.title || wo.section || 'Work Order'}</span>${set ? '<i class="bi bi-check-circle-fill sw-wo-check"></i>' : '<i class="bi bi-circle sw-wo-pending"></i>'}</div>
            <div class="sw-wo-sub">${tech}${set ? ' · <strong>'+set+'</strong>' : ''}</div>
            ${busy ? '<div class="sw-wo-warn"><i class="bi bi-exclamation-triangle-fill"></i> Tech busy that day</div>' : ''}
          </button>`;
      }).join('');
      q.querySelectorAll('.sw-wo').forEach(b => b.addEventListener('click', () => { activeWo = b.dataset.wo; renderQueue(); renderActiveInfo(); renderGrid(); }));
    }

    function renderActiveInfo() {
      const wo = wos.find(w => w._id === activeWo);
      const tech = (wo.assignedTechnicians && wo.assignedTechnicians[0]?.name) || 'Unassigned';
      const el = modal.querySelector('#swActiveInfo');
      el.innerHTML = `
        <div style="font-size:0.82rem;font-weight:700;margin-bottom:0.2rem;">Scheduling: ${wo.title || wo.section || 'Work Order'}</div>
        <div class="wo-mini">Assigned to <strong>${tech}</strong>${activeTech() ? '' : ' <em>(no tech assigned — availability not checked)</em>'}</div>
        <div class="wo-mini mt-1">Click an available day on the calendar to set this work order's date.</div>`;
    }

    function renderGrid() {
      const grid = modal.querySelector('#swGrid');
      const t = activeTech();
      // Build date range (customer window, else +/- 15 days around today)
      let s = startStr ? new Date(startStr) : new Date();
      let e = endStr ? new Date(endStr) : new Date(s.getTime() + 30*86400000);
      s = new Date(s); e = new Date(e);
      // Align start to Monday for clean weeks
      const startMon = new Date(s);
      const dow = (startMon.getDay() + 6) % 7; // 0=Mon
      startMon.setDate(startMon.getDate() - dow);
      const cells = [];
      let cur = new Date(startMon);
      while (cur <= e || cells.length % 7 !== 0) {
        cells.push(new Date(cur));
        cur.setDate(cur.getDate() + 1);
        if (cells.length > 200) break;
      }
      grid.innerHTML = cells.map(d => {
        const key = fmtKey(d);
        const inWindow = (!startStr || key >= startStr) && (!endStr || key <= endStr);
        const dayInfo = dayMap[key];
        let capClass = 'free', capLabel = 'Available';
        if (dayInfo) {
          if (dayInfo.remaining <= 0) { capClass = 'busy'; capLabel = 'No free tech'; }
          else if (dayInfo.remaining < dayInfo.required) { capClass = 'tight'; capLabel = dayInfo.remaining + '/' + dayInfo.required + ' free'; }
        }
        // Is the active tech busy this day?
        let techBusy = false, techReason = '';
        if (t && dayInfo) {
          const m = (dayInfo.matrix||[]).find(mm => mm._id === String(t));
          if (m && m.status !== 'free') { techBusy = true; techReason = m.detail; }
        }
        const assignedWos = wos.filter(wo => assignments[wo._id] === key);
        const isSelected = assignments[activeWo] === key;
        const cls = ['sw-cell'];
        if (!inWindow) cls.push('outside');
        if (capClass === 'busy') cls.push('cap-busy');
        if (techBusy) cls.push('tech-busy');
        if (isSelected) cls.push('selected');
        if (assignedWos.length) cls.push('has-wo');
        return `
          <div class="${cls.join(' ')}" data-date="${key}">
            <div class="sw-cell-num">${d.getDate()}</div>
            <div class="sw-cell-cap ${capClass}"><span class="sw-dot ${capClass}"></span>${capLabel}</div>
            ${techBusy ? `<div class="sw-cell-busy" title="${techReason}"><i class="bi bi-exclamation-triangle-fill"></i> ${techName(String(t))} busy</div>` : ''}
            <div class="sw-cell-wos">${assignedWos.map(wo => `<span class="sw-chip">${wo.title || wo.section || 'WO'}</span>`).join('')}</div>
          </div>`;
      }).join('');
      grid.querySelectorAll('.sw-cell:not(.outside)').forEach(cell => {
        cell.addEventListener('click', () => {
          assignments[activeWo] = cell.dataset.date;
          renderQueue(); renderGrid(); refreshBanner();
        });
      });
      // Mark which days the active tech is unavailable (subtle)
      modal.querySelector('#swCalHead').innerHTML = `<i class="bi bi-calendar3"></i> ${s.toLocaleDateString('en-PH',{month:'short',year:'numeric'})} – ${e.toLocaleDateString('en-PH',{month:'short',year:'numeric'})}`;
    }

    function refreshBanner() {
      const t = activeTech();
      let warn = 0;
      wos.forEach(wo => {
        const dt = assignments[wo._id];
        if (!dt) return;
        const tt = wo.assignedTechnicians && wo.assignedTechnicians[0] ? (wo.assignedTechnicians[0]._id || wo.assignedTechnicians[0]) : '';
        const di = dayMap[dt];
        if (tt && di) { const m = (di.matrix||[]).find(mm => mm._id === String(tt)); if (m && m.status !== 'free') warn++; }
      });
      const banner = modal.querySelector('#swBanner');
      const done = wos.filter(wo => assignments[wo._id]).length;
      modal.querySelector('#swProgress').textContent = `${done}/${wos.length} work orders scheduled`;
      if (warn > 0) {
        banner.style.display = 'block';
        banner.innerHTML = `<i class="bi bi-exclamation-triangle-fill"></i> ${warn} work order(s) land on a day where the assigned technician is already committed (booking / leave / another project). You can still save, but reassign or pick another date if the technician can't cover both.`;
      } else { banner.style.display = 'none'; }
    }

    renderQueue(); renderActiveInfo(); renderGrid(); refreshBanner();

    modal.querySelector('#saveScheduleBtn').addEventListener('click', async function() {
      const unscheduled = wos.filter(wo => !assignments[wo._id]);
      if (unscheduled.length) { toast(`Schedule all ${wos.length} work orders first (${unscheduled.length} remaining)`, 'error'); return; }
      // window bounds check
      for (const wo of wos) {
        const v = assignments[wo._id];
        if (startStr && v < startStr) { toast('Date before customer start', 'error'); return; }
        if (endStr && v > endStr) { toast('Date after customer due', 'error'); return; }
      }
      await withBtnLoading(this, 'Saving…', async () => {
        let warp = 0;
        for (const wo of wos) {
          try {
            const r = await fetch(`/api/work-orders/${wo._id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ scheduledDate: assignments[wo._id] }) });
            if (r.ok) warp++;
          } catch (_) {}
        }
        if (warp === wos.length) { toast('Schedule confirmed'); modal.remove(); loadProject(); }
        else toast('Some dates failed to save', 'error');
      });
    });
    modal.addEventListener('click', function(e) { if (e.target === this) this.remove(); });
  };

  window.addEditChecklistItem = function() {
    const d = document.createElement('div');
    d.className = 'edit-ck-item d-flex align-items-center gap-2';
    d.innerHTML = `<input type="text" class="form-control form-control-sm edit-ck-label" placeholder="Checklist item" style="font-size:0.82rem;">
      <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="this.closest('.edit-ck-item').remove()"><i class="bi bi-trash"></i></button>`;
    document.getElementById('editWoChecklist').appendChild(d);
  };

  window.viewWorkOrderDetails = async function(id) {
    const safe = value => String(value ?? '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
    try {
      const data = await studioApi(`/api/work-orders/${id}`);
      const wo = data.workOrder, project = data.project || {};
      const team = (wo.assignedTechnicians || []).map(member => safe(member.name || 'Technician')).join(', ') || 'Unassigned';
      const dependencyMap = new Map((window.__lastWorkOrders || []).map(order => [String(order._id), order.workOrderNumber || order.title]));
      const overlay = document.createElement('div'); overlay.className = 'pw-modal-overlay';
      overlay.innerHTML = `<div class="pw-modal" role="dialog" aria-modal="true" style="max-width:900px;">
        <div class="d-flex justify-content-between"><div><h4 style="font-size:1.05rem;font-weight:800;margin:0;">${safe(wo.workOrderNumber || 'Work Order')} — ${safe(wo.title || '')}</h4><div class="text-muted" style="font-size:.72rem;">${safe(project.customer?.name || 'Project')} · ${safe(String(wo.serviceType || 'core').toUpperCase())} workflow</div></div><button class="pw-modal-close" onclick="this.closest('.pw-modal-overlay').remove()"><i class="bi bi-x-lg"></i></button></div>
        <div class="resource-summary"><div><b>Status</b><span>${safe((wo.planningStatus === 'released' ? wo.status : wo.planningStatus || wo.status).replace(/_/g,' '))}</span></div><div><b>Scope</b><span>${wo.completedUnitCount||0}/${wo.unitCount||0} units · ${wo.estimatedHours||0}h</span></div><div><b>Priority</b><span>${safe(wo.priority || 'normal')}</span></div></div>
        <div class="resource-group-title">Overview & Scope</div><div class="studio-row"><span><b>Location</b><small class="d-block text-muted">${safe(wo.location?.label || wo.section || project.location?.address || 'Not set')}</small></span><span><b>Assigned</b><small class="d-block text-muted">${team}${wo.assignmentProvisional ? ' (Provisional)' : ''}</small></span></div>
        <div class="resource-group-title">Units</div>${(wo.units || []).map(unit => `<div class="studio-row"><span>${safe(unit.label || unit.unitKey)}<small class="d-block text-muted">${safe(unit.brand || '')} ${safe(unit.model || '')}</small></span><span class="resource-status ${unit.status === 'completed' ? 'available' : 'optional'}">${safe((unit.status||'pending').replace(/_/g,' ').toUpperCase())}</span></div>`).join('') || '<div class="text-muted py-2">Legacy quantity-based scope</div>'}
        <div class="resource-group-title">Schedule</div><div class="studio-row"><span>${wo.scheduledDate ? new Date(wo.scheduledDate).toLocaleDateString('en-PH',{dateStyle:'medium'}) : 'Not scheduled'}</span><span>${safe(wo.startTime || '')}${wo.endTime ? `–${safe(wo.endTime)}` : ''}</span></div>
