  AU.Pending.renderRepairRequests=function(){
    var filterEl=document.getElementById('rqFilterStatus');
    var searchEl=document.getElementById('rqSearchInput');
    var resultEl=document.getElementById('rqResultCount');
    var container=document.getElementById('rqContainer');
    var filter=filterEl?filterEl.value:'all';
    var search=searchEl?(searchEl.value||'').toLowerCase():'';
    var f=_rqAll.slice();
    if(filter!=='all'){
      if(filter==='pending')f=f.filter(function(b){return['repair_requested','pending_inspection'].indexOf(b.status)!==-1;});
      else f=f.filter(function(b){return b.status===filter;});
    }
    if(search)f=f.filter(function(b){return((b.customer?b.customer.name:'').toLowerCase().indexOf(search)!==-1)||((b.bookingReference||'').toLowerCase().indexOf(search)!==-1)||((b.issueDescription||'').toLowerCase().indexOf(search)!==-1);});
    if(resultEl)resultEl.textContent=f.length;
