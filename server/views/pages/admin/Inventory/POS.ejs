<script>
"use strict";

// ── State ─────────────────────────────────────────────────────────────────────
let cart = [];
let selectedPayment = "cash";
let allTools = [];
let currentCategory = "";
let historyPage = 1;
let historyTotalPages = 1;
const historyLimit = 10;
let historySales = [];
let posOrderFees = { installationFee: 0, transportationFee: 0, distanceKm: 0, durationMin: 0 };
let posCheckoutRequestId = createPosCheckoutRequestId();
let posAddressTimer = null;

function createPosCheckoutRequestId() {
  if (window.crypto?.randomUUID) return window.crypto.randomUUID().replace(/-/g, "");
  return `pos${Date.now()}${Math.random().toString(36).slice(2, 14)}`;
}

function cartHasAircon() { return cart.some(item => item.source === "aircon" || item.source === "aircon_legacy"); }
function cartUnitCount() { return cart.reduce((sum, item) => sum + Number(item.quantity || 0), 0); }

// ── Init ──────────────────────────────────────────────────────────────────────
document.addEventListener("DOMContentLoaded", () => {
  loadCategories();
  loadTools();

  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  const minimumDate = tomorrow.toISOString().slice(0, 10);
  document.getElementById("posPickupDate").min = minimumDate;
  document.getElementById("posDeliveryDate").min = minimumDate;

  document.getElementById("posSearch").addEventListener("input", debounce(() => { if (currentTab === "tools") loadTools(); else loadAircons(); }, 300));
  document.getElementById("historySearch").addEventListener("input", debounce(() => { historyPage = 1; loadSalesHistory(); }, 300));
  document.getElementById("historyCategory").addEventListener("change", () => { historyPage = 1; loadSalesHistory(); });

  // Barcode scanner: buffer characters, fire on terminator (Enter/Tab) or timeout
  let barcodeBuffer = "";
  let barcodeTimer = null;
  const barcodeInput = document.getElementById("posBarcode");

  function processBarcode() {
    const val = barcodeBuffer.replace(/[\r\n\x00-\x1f]/g, "").trim();
    barcodeBuffer = "";
    barcodeInput.value = "";
    if (val) {
      console.log("[POS] Barcode scanned:", val);
      lookupBarcode(val);
    }
  }

  barcodeInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === "Tab") {
      e.preventDefault();
      clearTimeout(barcodeTimer);
      barcodeBuffer = barcodeInput.value.trim();
      processBarcode();
      return;
    }
  });

  barcodeInput.addEventListener("input", (e) => {
    const val = e.target.value;
    if (!val) { barcodeBuffer = ""; clearTimeout(barcodeTimer); return; }
    barcodeBuffer = val;
    clearTimeout(barcodeTimer);
    // Fallback: if scanner doesn't send Enter/Tab, fire after 300ms of silence
    barcodeTimer = setTimeout(() => processBarcode(), 300);
  });

  // Focus barcode input on page load
  barcodeInput.focus();
});

// ── API Calls ─────────────────────────────────────────────────────────────────
async function loadCategories() {
  try {
    const res = await fetch("/api/pos/categories");
    const data = await res.json();
    const container = document.getElementById("posCategories");
    let html = '<button class="pos-cat-btn active" onclick="filterCategory(\'\', this)">All</button>';
    (data.categories || []).forEach(c => {
      html += `<button class="pos-cat-btn" onclick="filterCategory('${c.replace(/'/g, "\\'")}', this)">${escapeHtml(c)}</button>`;
    });
    container.innerHTML = html;

    const historyCategory = document.getElementById("historyCategory");
    if (historyCategory) {
      historyCategory.innerHTML = '<option value="">All Categories</option>';
      (data.categories || []).forEach(c => {
        historyCategory.innerHTML += `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`;
      });
    }
  } catch (e) { console.error("Categories load error:", e); }
}

async function loadTools() {
  try {
    const q = document.getElementById("posSearch").value.trim();
    const params = new URLSearchParams({ limit: 200 });
    if (q) params.set("q", q);
    if (currentCategory) params.set("category", currentCategory);

    const res = await fetch(`/api/pos/tools?${params}`);
    const data = await res.json();
    allTools = data.tools || [];
    renderTools();
    checkBarcodeStatus();
  } catch (e) { console.error("Tools load error:", e); }
}

function checkBarcodeStatus() {
  const withBarcode = allTools.filter(t => t.barcode && t.barcode.trim());
  const withoutBarcode = allTools.filter(t => !t.barcode || !t.barcode.trim());
  const notice = document.getElementById("barcodeNotice");
  if (withoutBarcode.length > 0 && withBarcode.length < allTools.length) {
    notice.innerHTML = `<i class="bi bi-exclamation-triangle me-1"></i>${withoutBarcode.length} item(s) missing barcodes. <button onclick="generateBarcodesPOS()" style="background:#f59e0b;color:#000;border:none;padding:2px 10px;border-radius:4px;font-weight:700;cursor:pointer;margin-left:8px;font-size:0.75rem;">Generate Now</button>`;
    notice.style.display = "flex";
  } else {
    notice.style.display = "none";
  }
}

async function generateBarcodesPOS() {
  try {
    const res = await fetch("/api/pos/tools/generate-barcodes", { method: "POST", credentials: "same-origin" });
    const data = await res.json();
    if (res.ok) {
      showToast(data.message || `Generated ${data.updated} barcodes`, "success");
      loadTools();
    } else {
      showToast(data.error || "Failed", "error");
    }
  } catch (e) { showToast("Failed to generate barcodes", "error"); }
}

// ── Tab Switching ─────────────────────────────────────────────────────────────
let currentTab = "tools";
let allAircons = [];

function switchTab(tab, btn) {
  currentTab = tab;
  document.querySelectorAll(".pos-tab").forEach(b => b.classList.remove("active"));
  btn.classList.add("active");

  const toolsGrid = document.getElementById("posGrid");
  const airconGrid = document.getElementById("posAirconGrid");
  const catsEl = document.getElementById("posCategories");
  const searchEl = document.getElementById("posSearch");

  if (tab === "tools") {
    toolsGrid.style.display = "";
    airconGrid.style.display = "none";
    catsEl.style.display = "";
    searchEl.placeholder = "Search parts, tools...";
  } else {
    toolsGrid.style.display = "none";
    airconGrid.style.display = "";
    catsEl.style.display = "none";
    searchEl.placeholder = "Search aircon models...";
    loadAircons();
  }
  searchEl.value = "";
}

async function loadAircons() {
  try {
    const q = document.getElementById("posSearch").value.trim();
    const params = new URLSearchParams();
    if (q) params.set("q", q);
    const res = await fetch(`/api/pos/aircons?${params}`);
    const data = await res.json();
    allAircons = data.items || [];
    renderAircons();
  } catch (e) { console.error("Aircons load error:", e); }
}

function renderAircons() {
  const grid = document.getElementById("posAirconGrid");
  if (!allAircons.length) {
    grid.innerHTML = '<div class="pos-empty"><i class="bi bi-snow"></i><p>No aircons in stock</p></div>';
    return;
  }
  let html = "";
  allAircons.forEach((a, idx) => {
    const oos = a.available <= 0;
    html += `
      <div class="pos-aircon-card${oos ? " oos" : ""}" data-aircon-idx="${idx}">
        ${a.imageUrl ? `<img class="pos-aircon-img" src="${escapeHtml(a.imageUrl)}" alt="" onerror="this.style.display='none'">` : `<div class="pos-aircon-img" style="display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:2rem;"><i class="bi bi-snow"></i></div>`}
        <div class="pos-aircon-name">${escapeHtml(a.itemName || a.modelLine)}</div>
        <div class="pos-aircon-cat">${escapeHtml(a.brand || "")}</div>
        <div class="pos-aircon-barcode"><i class="bi bi-snow"></i> ${escapeHtml((a.capacity || "") + (a.capacityUnit || "HP"))} ${a.inverter !== undefined ? (a.inverter ? "Inverter" : "Non-Inverter") : ""} ${a.btu ? a.btu + " BTU" : ""}</div>
        <div class="pos-aircon-price">₱${Number(a.sellingPrice || 0).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</div>
        <div class="pos-aircon-stock">${oos ? "Out of stock" : `<strong>${a.available}</strong> unit(s) available`}</div>
      </div>`;
  });
  grid.innerHTML = html;
  // Bind click handlers after render
  grid.querySelectorAll("[data-aircon-idx]").forEach(el => {
    el.addEventListener("click", () => {
      const a = allAircons[parseInt(el.dataset.airconIdx)];
      if (a && a.available > 0) {
        addToCart({ _id: a._id, itemName: a.itemName, category: a.category, unit: a.unit, barcode: a.barcode, sellingPrice: a.sellingPrice, costPrice: a.costPrice, available: a.available, source: "aircon" });
      }
    });
  });
}

async function lookupBarcode(barcode) {
  if (!barcode) return;
  showToast(`Scanned: ${barcode}`, "info");
  try {
    const res = await fetch(`/api/pos/tools/barcode/${encodeURIComponent(barcode)}`);
    const data = await res.json();
    if (!res.ok) {
      showToast(data.error || "Item not found — try Manual Add", "error");
      return;
    }
    addToCart(data);
  } catch (e) {
    console.error("[POS] Barcode lookup error:", e);
    showToast("Barcode lookup failed — check connection", "error");
  }
}

// ── Render Products ───────────────────────────────────────────────────────────
function renderTools() {
  const grid = document.getElementById("posGrid");
  if (!allTools.length) {
    grid.innerHTML = '<div class="pos-empty"><i class="bi bi-box-seam"></i><p>No parts found</p></div>';
    return;
  }
  let html = "";
  allTools.forEach((t, idx) => {
    const oos = t.available <= 0;
    html += `
      <div class="pos-item${oos ? " oos" : ""}" data-tool-idx="${idx}">
        ${t.imageUrl ? `<img class="pos-item-img" src="${escapeHtml(t.imageUrl)}" alt="" onerror="this.style.display='none'">` : `<div class="pos-item-img" style="display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:2rem;"><i class="bi bi-box-seam"></i></div>`}
        <div class="pos-item-name">${escapeHtml(t.itemName)}</div>
        <div class="pos-item-cat">${escapeHtml(t.category || "")}</div>
        ${t.serialNumber ? `<div class="pos-item-barcode"><i class="bi bi-qr-code"></i> SN: ${escapeHtml(t.serialNumber)}</div>` : ""}
        ${t.barcode ? `<div class="pos-item-barcode"><i class="bi bi-upc-scan"></i> ${escapeHtml(t.barcode)}</div>` : ""}
        <div class="pos-item-price">₱${Number(t.sellingPrice || 0).toLocaleString("en-PH", { minimumFractionDigits: 2 })}</div>
        <div class="pos-item-stock">${oos ? "Out of stock" : `<strong>${t.available}</strong> ${t.unit || "pcs"} available`}</div>
      </div>`;
  });
  grid.innerHTML = html;
  grid.querySelectorAll("[data-tool-idx]").forEach(el => {
    el.addEventListener("click", () => {
      const t = allTools[parseInt(el.dataset.toolIdx)];
      if (t && t.available > 0) addToCart(t);
    });
  });
}

function filterCategory(cat, btn) {
  currentCategory = cat;
  document.querySelectorAll(".pos-cat-btn").forEach(b => b.classList.remove("active"));
  btn.classList.add("active");
  loadTools();
}

// ── Cart Operations ───────────────────────────────────────────────────────────
function addToCart(tool) {
  const incomingAircon = tool.source === "aircon" || tool.source === "aircon_legacy";
  if (cart.length && incomingAircon !== cartHasAircon()) {
    showToast("Process aircons and parts as separate transactions so warranty and inventory records remain correct.", "warning");
    return;
  }
  const existing = cart.find(i => i.toolId === tool._id);
  if (existing) {
    if (existing.quantity >= tool.available) { showToast("No more stock available", "warning"); return; }
    existing.quantity++;
    existing.totalPrice = existing.unitPrice * existing.quantity;
  } else {
    cart.push({
      toolId: tool._id,
      itemName: tool.itemName,
      category: tool.category || "",
      unit: tool.unit || "pcs",
      unitPrice: tool.sellingPrice || 0,
      costPrice: tool.costPrice || 0,
      available: tool.available,
      source: tool.source || "tool",
      quantity: 1,
      totalPrice: tool.sellingPrice || 0,
    });
  }
  renderCart();
  showToast(`Added "${tool.itemName}"`, "success");
}

function updateQty(idx, delta) {
  const item = cart[idx];
  if (!item) return;
  const newQty = item.quantity + delta;
  if (newQty <= 0) { cart.splice(idx, 1); }
  else if (newQty > item.available) { showToast("Insufficient stock", "warning"); return; }
  else { item.quantity = newQty; item.totalPrice = item.unitPrice * newQty; }
  renderCart();
}

function removeItem(idx) { cart.splice(idx, 1); renderCart(); }

function renderCart() {
  const itemsEl = document.getElementById("cartItems");
  const summaryEl = document.getElementById("cartSummary");
  const paymentEl = document.getElementById("posPayment");
  const countEl = document.getElementById("cartCount");
  const airconOptions = document.getElementById("airconOrderOptions");
  const customerLabel = document.getElementById("posCustomerLabel");
  const isAirconOrder = cartHasAircon();

  airconOptions.style.display = isAirconOrder ? "block" : "none";
  customerLabel.innerHTML = isAirconOrder
    ? '<i class="bi bi-person-check"></i>Customer identity (required for warranty)'
    : '<i class="bi bi-person"></i>Customer (optional for parts)';

  countEl.textContent = cart.reduce((s, i) => s + i.quantity, 0);

  if (!cart.length) {
    itemsEl.innerHTML = '<div class="pos-cart-empty"><i class="bi bi-cart-x"></i><p>No items in cart</p></div>';
    summaryEl.style.display = "none";
    paymentEl.style.display = "none";
    posOrderFees = { installationFee: 0, transportationFee: 0, distanceKm: 0, durationMin: 0 };
    return;
  }

  let html = "";
  cart.forEach((item, idx) => {
    html += `
      <div class="pos-cart-item">
        <div class="pos-cart-item-info">
          <div class="pos-cart-item-name">${escapeHtml(item.itemName)}</div>
          <div class="pos-cart-item-price">₱${item.unitPrice.toLocaleString("en-PH", { minimumFractionDigits: 2 })} / ${item.unit || "pcs"}</div>
        </div>
        <div class="pos-cart-item-qty">
          <button onclick="updateQty(${idx}, -1)">−</button>
          <span>${item.quantity}</span>
          <button onclick="updateQty(${idx}, 1)">+</button>
        </div>
        <div class="pos-cart-item-total">₱${item.totalPrice.toLocaleString("en-PH", { minimumFractionDigits: 2 })}</div>
        <div class="pos-cart-item-remove" onclick="removeItem(${idx})"><i class="bi bi-trash3"></i></div>
      </div>`;
  });
  itemsEl.innerHTML = html;
  summaryEl.style.display = "block";
  paymentEl.style.display = "block";
  if (isAirconOrder) {
    onPosFulfillmentChange(false);
    document.getElementById("posPaymentReferenceGroup").style.display = selectedPayment !== "cash" ? "block" : "none";
  }
  recalcCart();
}

function recalcCart() {
  const subtotal = cart.reduce((s, i) => s + i.totalPrice, 0);
  const discount = Math.max(0, parseFloat(document.getElementById("discountInput").value) || 0);
  const isDeliveryInstall = cartHasAircon() && document.getElementById("posFulfillmentType").value === "delivery_installation";
  const installation = isDeliveryInstall ? Number(posOrderFees.installationFee || 0) : 0;
  const transportation = isDeliveryInstall ? Number(posOrderFees.transportationFee || 0) : 0;
  const total = Math.max(0, subtotal - discount) + installation + transportation;

  document.getElementById("summarySubtotal").textContent = "₱" + subtotal.toLocaleString("en-PH", { minimumFractionDigits: 2 });
  document.getElementById("summaryDiscount").textContent = "-₱" + discount.toLocaleString("en-PH", { minimumFractionDigits: 2 });
  document.getElementById("summaryInstallationRow").style.display = isDeliveryInstall ? "flex" : "none";
  document.getElementById("summaryTransportRow").style.display = isDeliveryInstall ? "flex" : "none";
  document.getElementById("summaryInstallation").textContent = "₱" + installation.toLocaleString("en-PH", { minimumFractionDigits: 2 });
  document.getElementById("summaryTransport").textContent = "₱" + transportation.toLocaleString("en-PH", { minimumFractionDigits: 2 });
  document.getElementById("summaryTotal").textContent = "₱" + total.toLocaleString("en-PH", { minimumFractionDigits: 2 });
  if (selectedPayment !== "cash") document.getElementById("amountPaid").value = total.toFixed(2);
  calcChange();
}

function selectPayment(method) {
  selectedPayment = method;
  document.querySelectorAll(".pos-pay-btn").forEach(b => b.classList.toggle("active", b.dataset.method === method));
  const cashRow = document.getElementById("cashInputRow");
  cashRow.style.display = method === "cash" ? "flex" : "none";
  document.getElementById("posPaymentReferenceGroup").style.display = cartHasAircon() && method !== "cash" ? "block" : "none";
  if (method !== "cash") {
    document.getElementById("amountPaid").value = cart.reduce((s, i) => s + i.totalPrice, 0) - (parseFloat(document.getElementById("discountInput").value) || 0);
  }
  calcChange();
}

function calcChange() {
  const subtotal = cart.reduce((s, i) => s + i.totalPrice, 0);
  const discount = Math.max(0, parseFloat(document.getElementById("discountInput").value) || 0);
  const deliveryInstall = cartHasAircon() && document.getElementById("posFulfillmentType").value === "delivery_installation";
  const total = Math.max(0, subtotal - discount)
    + (deliveryInstall ? Number(posOrderFees.installationFee || 0) + Number(posOrderFees.transportationFee || 0) : 0);
  const paid = parseFloat(document.getElementById("amountPaid").value) || 0;
  const change = paid - total;

  const changeRow = document.getElementById("changeRow");
  const checkoutBtn = document.getElementById("checkoutBtn");

  if (selectedPayment === "cash" && paid > 0) {
    changeRow.style.display = "flex";
    document.getElementById("changeValue").textContent = "₱" + Math.max(0, change).toLocaleString("en-PH", { minimumFractionDigits: 2 });
    changeRow.style.background = change >= 0 ? "#f0fdf4" : "#fef2f2";
    document.getElementById("changeValue").style.color = change >= 0 ? "#16a34a" : "#dc2626";
  } else {
    changeRow.style.display = "none";
  }

  checkoutBtn.disabled = cart.length === 0 || (selectedPayment === "cash" && paid < total);
}

function onPosFulfillmentChange(resetQuote = true) {
  if (!cartHasAircon()) return;
  const choice = document.getElementById("posFulfillmentType").value;
  document.getElementById("posPickupDateGroup").style.display = choice === "customer_pickup" ? "block" : "none";
  document.getElementById("posDeliveryFields").style.display = choice === "delivery_installation" ? "block" : "none";
  document.getElementById("posSerialGroup").style.display = choice === "carry_out" ? "block" : "none";
  if (choice !== "delivery_installation" || resetQuote) {
    posOrderFees = { installationFee: 0, transportationFee: 0, distanceKm: 0, durationMin: 0 };
    if (choice === "delivery_installation") {
      document.getElementById("posOrderQuote").innerHTML = "<span>Select an address to calculate travel and installation fees.</span>";
    }
  }
  if (choice === "delivery_installation" && document.getElementById("posDeliveryDate").value) loadPosTimeSlots();
  recalcCart();
}

function searchPosAddress() {
  clearTimeout(posAddressTimer);
  document.getElementById("posDeliveryLat").value = "";
  document.getElementById("posDeliveryLng").value = "";
  posOrderFees = { installationFee: 0, transportationFee: 0, distanceKm: 0, durationMin: 0 };
  recalcCart();
  const query = document.getElementById("posDeliveryAddress").value.trim();
  const results = document.getElementById("posAddressResults");
  if (query.length < 5) { results.style.display = "none"; return; }
  posAddressTimer = setTimeout(async () => {
    try {
      const response = await fetch(`/api/geocoding/search?q=${encodeURIComponent(query)}&limit=5`);
      const rows = await response.json();
      if (!response.ok || !Array.isArray(rows)) throw new Error("Address search failed");
      results.innerHTML = rows.length ? rows.map((row, index) =>
        `<button type="button" class="pos-address-result" data-address-index="${index}">${escapeHtml(row.display_name || "Address")}</button>`
      ).join("") : '<div style="padding:10px;color:#64748b;font-size:.75rem;">No matching address found.</div>';
      results.style.display = "block";
      results.querySelectorAll("[data-address-index]").forEach((button) => {
        button.addEventListener("click", () => selectPosAddress(rows[Number(button.dataset.addressIndex)]));
      });
    } catch (_) {
      results.innerHTML = '<div style="padding:10px;color:#b91c1c;font-size:.75rem;">Could not search addresses. Try again.</div>';
      results.style.display = "block";
    }
  }, 450);
}

async function selectPosAddress(row) {
  document.getElementById("posDeliveryAddress").value = row.display_name || "";
  document.getElementById("posDeliveryLat").value = row.lat || "";
  document.getElementById("posDeliveryLng").value = row.lon || "";
  document.getElementById("posAddressResults").style.display = "none";
  const quoteBox = document.getElementById("posOrderQuote");
  quoteBox.innerHTML = '<span><span class="spinner-border spinner-border-sm me-1"></span>Calculating authoritative route...</span>';
  try {
    const response = await fetch("/api/pos/aircon-quote", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ fulfillmentType: "delivery_installation", coordinates: { lat: row.lat, lng: row.lon } }),
    });
    const quote = await response.json();
    if (!response.ok) throw new Error(quote.error || "Quote failed");
    posOrderFees = quote;
    quoteBox.innerHTML = `<span>${Number(quote.distanceKm || 0).toFixed(1)} km · about ${Number(quote.durationMin || 0)} min</span><strong>Fees ₱${Number(quote.additionalTotal || 0).toLocaleString("en-PH")}</strong>`;
    recalcCart();
    loadPosTimeSlots();
  } catch (error) {
    posOrderFees = { installationFee: 0, transportationFee: 0, distanceKm: 0, durationMin: 0 };
    quoteBox.innerHTML = `<span style="color:#b91c1c;">${escapeHtml(error.message || "Could not calculate route")}</span>`;
    recalcCart();
  }
}

async function loadPosTimeSlots() {
  const date = document.getElementById("posDeliveryDate").value;
  const select = document.getElementById("posTimeSlot");
  if (!date) { select.innerHTML = '<option value="">Select date first</option>'; return; }
  select.innerHTML = '<option value="">Loading available times...</option>';
  try {
    const params = new URLSearchParams({
      date,
      duration: "60",
      quantity: String(cartUnitCount()),
      travelTime: String(Number(posOrderFees.durationMin || 0)),
    });
    const response = await fetch(`/api/schedule/time-slots?${params}`);
    const data = await response.json();
    const slots = (data.timeSlots || []).filter((slot) => slot.available === true);
    select.innerHTML = slots.length
      ? '<option value="">Select available time</option>' + slots.map((slot) => `<option value="${escapeHtml(slot.startTime)}">${escapeHtml(slot.startTime)}</option>`).join("")
      : '<option value="">No available times</option>';
  } catch (_) {
    select.innerHTML = '<option value="">Could not load times</option>';
  }
}

// ── Checkout ──────────────────────────────────────────────────────────────────
async function processCheckout() {
  if (!cart.length) return;
  if (cartHasAircon() && selectedPayment !== "cash" && document.getElementById("posPaymentReference").value.trim().length < 4) {
    showToast("Enter the electronic payment or card authorization reference.", "error");
    document.getElementById("posPaymentReference").focus();
    return;
  }
  const btn = document.getElementById("checkoutBtn");
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner-border spinner-border-sm"></div>Processing...';

  const subtotal = cart.reduce((s, i) => s + i.totalPrice, 0);
  const discount = parseFloat(document.getElementById("discountInput").value) || 0;
  const fulfillmentChoice = document.getElementById("posFulfillmentType").value;
  const deliveryInstall = cartHasAircon() && fulfillmentChoice === "delivery_installation";
  const total = subtotal - discount
    + (deliveryInstall ? Number(posOrderFees.installationFee || 0) + Number(posOrderFees.transportationFee || 0) : 0);
  const paid = parseFloat(document.getElementById("amountPaid").value) || 0;

  try {
    const isAirconOrder = cartHasAircon();
    const endpoint = isAirconOrder ? "/api/pos/aircon-checkout" : "/api/pos/checkout";
    const payload = isAirconOrder ? {
      checkoutRequestId: posCheckoutRequestId,
      customer: {
        name: document.getElementById("customerName").value.trim(),
        email: document.getElementById("customerEmail").value.trim(),
        phone: document.getElementById("customerPhone").value.trim(),
        address: document.getElementById("customerAddress").value.trim(),
      },
      items: cart.map(i => ({ toolId: i.toolId, quantity: i.quantity, source: i.source })),
      fulfillmentType: fulfillmentChoice,
      pickupDate: document.getElementById("posPickupDate").value,
      delivery: deliveryInstall ? {
        address: document.getElementById("posDeliveryAddress").value.trim(),
        preferredDate: document.getElementById("posDeliveryDate").value,
        coordinates: {
          lat: document.getElementById("posDeliveryLat").value,
          lng: document.getElementById("posDeliveryLng").value,
        },
      } : null,
      timeSlot: deliveryInstall ? document.getElementById("posTimeSlot").value : null,
      serialNumbers: fulfillmentChoice === "carry_out"
        ? document.getElementById("posSerialNumbers").value.split(/\r?\n|,/).map(value => value.trim()).filter(Boolean)
        : [],
      paymentMethod: selectedPayment,
      paymentReference: document.getElementById("posPaymentReference").value.trim(),
      amountPaid: selectedPayment === "cash" ? paid : total,
      discount,
    } : {
      customerName: document.getElementById("customerName").value.trim(),
      customerPhone: document.getElementById("customerPhone").value.trim(),
      customerTin: document.getElementById("customerTin").value.trim(),
      customerAddress: document.getElementById("customerAddress").value.trim(),
      items: cart.map(i => ({ toolId: i.toolId, quantity: i.quantity, source: i.source || "tool" })),
      paymentMethod: selectedPayment,
      amountPaid: selectedPayment === "cash" ? paid : total,
      discount,
    };
    const res = await fetch(endpoint, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "Checkout failed");

    if (isAirconOrder) showOrderReceipt(data);
    else showReceipt(data.sale);
    cart = [];
    document.getElementById("discountInput").value = "";
    document.getElementById("amountPaid").value = "";
    document.getElementById("customerName").value = "";
    document.getElementById("customerPhone").value = "";
    document.getElementById("customerEmail").value = "";
    document.getElementById("customerTin").value = "";
    document.getElementById("customerAddress").value = "";
    document.getElementById("posSerialNumbers").value = "";
    document.getElementById("posPaymentReference").value = "";
    posCheckoutRequestId = createPosCheckoutRequestId();
    renderCart();
    if (currentTab === "tools") loadTools(); else loadAircons();
    showToast(isAirconOrder
      ? (data.order?.status === "completed" ? "Aircon handover completed with warranty activated." : "Aircon order created and sent to the Orders workflow.")
      : "Sale completed!", "success");
  } catch (e) {
    showToast(e.message || "Checkout failed", "error");
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-check-circle"></i>Complete Transaction';
  }
}

// ── Receipt ───────────────────────────────────────────────────────────────────
function showOrderReceipt(result) {
  const order = result.order || {};
  const fulfillmentLabels = {
    customer_pickup: order.status === "completed" ? "Taken home now" : "Customer pickup",
    delivery_installation: "Delivery + installation",
  };
  showReceipt({
    recordType: "order",
    invoiceNumber: order.orderReference,
    customerName: order.customer?.name,
    customerPhone: order.customer?.phone,
    customerEmail: order.customer?.email,
    customerAddress: order.delivery?.address || document.getElementById("customerAddress").value.trim(),
    items: (order.items || []).map(item => ({
      itemName: [item.brand, item.modelLine, item.capacity ? `${item.capacity}${item.capacityUnit || "HP"}` : ""].filter(Boolean).join(" "),
      quantity: item.quantity,
      unit: "unit",
      totalPrice: item.totalPrice,
      serialNumber: (item.serialNumbers || []).join(", "),
    })),
    subtotal: order.subtotal,
    discount: order.discount || 0,
    installationFee: order.installationFee || 0,
    transportationFee: order.transportationFee || 0,
    totalAmount: order.total,
    paymentMethod: selectedPayment,
    amountPaid: result.amountPaid ?? order.total,
    change: result.change || 0,
    completedAt: order.completedAt,
    createdAt: order.createdAt,
    processedByName: "Walk-in POS",
    fulfillmentLabel: fulfillmentLabels[order.fulfillmentType] || order.fulfillmentType,
    orderStatus: order.status,
    customerAccountCreated: result.customerAccountCreated,
  });
}

