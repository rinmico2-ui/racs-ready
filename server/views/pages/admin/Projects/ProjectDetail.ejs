    .tl-milestone.done .tl-m-label { color:#16a34a; }
    .tl-m-line { width:100%; height:2px; background:#e2e8f0; align-self:center; margin-bottom:1.2rem; }
    .tl-milestone.done + .tl-m-line { background:#16a34a; }
    .tl-footer { display:flex; justify-content:space-between; flex-wrap:wrap; gap:0.5rem; padding-top:0.625rem; border-top:1px solid #e2e8f0; font-size:0.82rem; color:#334155; }

    /* ══ COLLAPSIBLE DETAILS ══ */
    .details-card summary { list-style:none; display:flex; align-items:center; justify-content:space-between; }
    .details-card summary::-webkit-details-marker { display:none; }
