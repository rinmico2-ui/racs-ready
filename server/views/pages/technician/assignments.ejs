        <div id="repairSchedNotAvailable" style="display:none;">
          <div class="alert alert-warning py-3 mb-3" style="border-radius:10px;">
            <i class="bi bi-exclamation-triangle me-2"></i><strong>Immediate repair unavailable.</strong>
            <p class="mb-0 mt-1" style="font-size:0.85rem;" id="repairSchedNotAvailReason"></p>
          </div>
          <p class="fw-semibold mb-2" style="font-size:0.85rem;">Schedule for another day:</p>
          <div id="repairSchedLaterForm"></div>
          <div class="d-grid mt-3">
            <button class="btn btn-primary" onclick="submitRepairScheduleLater()">
              <i class="bi bi-send me-2"></i>Submit Scheduling Request
            </button>
          </div>
        </div>

        <!-- Step 4: Success -->
        <div id="repairSchedSuccess" style="display:none;">
          <div class="text-center py-3">
            <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>
            <h6 class="fw-bold mt-2" id="repairSchedSuccessTitle">Repair Scheduled</h6>
            <p class="text-muted" style="font-size:0.85rem;" id="repairSchedSuccessMsg"></p>
          </div>
        </div>
      </div>
      <div class="modal-footer border-top" style="background:#f8fafc;">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<script>
  // ═════════════════════════════════════════════════════════════════════════════
  // REPAIR WORK ORDER FUNCTIONS
  // ═════════════════════════════════════════════════════════════════════════════

  let _repairBookingId = null;

  // Helper: Open a modal after ensuring all other modals are fully closed
  // usage: openModalAfterClose('inspectionModal', 'assignDetailModal', () => openInspectionModal(id, name, service))
  function openModalAfterClose(openModalId, closeModalId, callback) {
    // Keep the assignment detail panel open behind technician work forms.
    if (closeModalId === 'assignDetailModal') {
      // The detail view is a side panel, not a Bootstrap modal.
    } else {
      const closeEl = document.getElementById(closeModalId);
      if (closeEl && closeEl.classList.contains('show')) {
        closeEl.addEventListener('hidden.bs.modal', function onHidden() {
          closeEl.removeEventListener('hidden.bs.modal', onHidden);
          document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
          document.body.classList.remove('modal-open');
          document.body.style.overflow = '';
          document.body.style.paddingRight = '';
          setTimeout(doOpenInner, 150);
        });
        bootstrap.Modal.getOrCreateInstance(closeEl).hide();
        return;
      }
    }

    const doOpenInner = () => {
      const openEl = document.getElementById(openModalId);
      if (callback) callback();
      else if (openEl) new bootstrap.Modal(openEl).show();
    };

    if (openModalId || callback) {
      setTimeout(doOpenInner, 50);
    }
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // AI TECHNICIAN ASSISTANT
  // ═════════════════════════════════════════════════════════════════════════════


  async function generateAiDiagnosis(bookingId, silent = false) {
    try {
      if (!silent) {
        Swal.fire({ title: "Generating AI Report...", html: "Analyzing unit information and preparing recommendations...", allowOutsideClick: false, didOpen: () => Swal.showLoading() });
      }
      const resp = await fetch(`/api/technician/appointments/${bookingId}/ai-diagnose`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin"
      });
      const data = await resp.json();
      if (!silent) Swal.close();
      if (resp.ok && data.success) {
        if (!silent) {
          Swal.fire({ icon: "success", title: "AI Technician Assistant Ready", text: "AI recommendations generated.", confirmButtonColor: "#2563eb" }).then(() => {
            if (window._currentDetailId && window.refreshOpenAssignmentDetail) {
              window.refreshOpenAssignmentDetail('ai-assistant');
            } else if (window._currentDetailId) {
              showDetail(window._currentDetailId);
              setTimeout(() => switchDetailTab('ai-assistant'), 150);
            } else {
              location.reload();
            }
          });
        } else {
          if (window._currentDetailId && window.refreshOpenAssignmentDetail) {
            window.refreshOpenAssignmentDetail('ai-assistant');
          } else if (window._currentDetailId) {
            showDetail(window._currentDetailId);
            setTimeout(() => switchDetailTab('ai-assistant'), 150);
          } else {
            location.reload();
          }
        }
      } else {
        console.error('[AI Diagnosis] Failed:', data.error || 'Unknown error');
        if (!silent) {
          Swal.fire("Error", data.error || "Failed to generate AI recommendations.", "error");
        }
      }
    } catch (e) {
      console.error('[AI Diagnosis] Network error:', e);
      if (!silent) {
        Swal.close();
        Swal.fire("Error", "Network error generating AI recommendations.", "error");
      }
    }
  }

  // Expose to window for inline onclick handlers
  window.generateAiDiagnosis = generateAiDiagnosis;


  async function verifyAiAssistant(bookingId) {
    try {
      const assignment = (window.allItems || []).find(item => String(item.bookingId?._id || item.bookingId) === String(bookingId))
        || (String(window._detailAssignment?.bookingId?._id || window._detailAssignment?.bookingId) === String(bookingId) ? window._detailAssignment : null);
      let ta = assignment?.bookingId?.technicianAssistant || {};
      const latestResponse = await fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' });
      const latestData = await latestResponse.json().catch(() => ({}));
      if (!latestResponse.ok) throw new Error(latestData.error || 'Could not load the latest AI diagnosis.');
      ta = latestData.booking?.technicianAssistant || {};
      if (!ta.summary) throw new Error('The latest booking has no generated AI diagnosis. Please generate it again.');
      const possibleParts = ta.possibleParts || [];
      const previouslyCarried = new Set((ta.carriedPossibleParts || []).map(part => String(part.name || part).toLowerCase()));
      const diagnosisSummary = preparationEscapeHtml(ta.summary || 'No diagnosis summary was returned.');
      const causes = (ta.probableCauses || []).map(cause => preparationEscapeHtml(typeof cause === 'string' ? cause : cause?.cause || cause?.name || '')).filter(Boolean);
      const tools = (ta.suggestedTools || []).map(tool => preparationEscapeHtml(typeof tool === 'string' ? tool : tool?.name || '')).filter(Boolean);
      const checklist = (ta.inspectionChecklist || []).map(item => preparationEscapeHtml(typeof item === 'string' ? item : item?.action || '')).filter(Boolean);
      const diagnosisHtml = `<div class="border rounded p-3 mb-3" style="background:#f8fafc;max-height:280px;overflow:auto;">
        <div class="fw-semibold mb-1"><i class="bi bi-clipboard2-pulse me-1 text-primary"></i>Preliminary Diagnosis</div>
        <div class="mb-2" style="white-space:pre-line;">${diagnosisSummary}</div>
        ${causes.length ? `<div class="fw-semibold mt-2 mb-1">Probable Causes</div><ul class="mb-2 ps-3">${causes.map(cause => `<li>${cause}</li>`).join('')}</ul>` : ''}
        ${tools.length ? `<div class="fw-semibold mt-2 mb-1">Recommended Tools</div><div class="text-muted">${tools.join(', ')}</div>` : ''}
        ${checklist.length ? `<div class="fw-semibold mt-2 mb-1">Inspection Recommendations</div><ul class="mb-0 ps-3">${checklist.map(item => `<li>${item}</li>`).join('')}</ul>` : ''}
      </div>`;
      const partsHtml = possibleParts.length ? possibleParts.map((part, index) => {
        const name = typeof part === 'string' ? part : part?.name || 'Possible part';
        const service = typeof part === 'object' ? part?.serviceName || part?.unitType || '' : '';
        const checked = previouslyCarried.has(String(name).toLowerCase()) ? ' checked' : '';
        return `<label class="d-flex gap-2 align-items-start p-2 border rounded mb-2"><input class="form-check-input ai-carry-part" type="checkbox" value="${index}"${checked}><span><strong>${preparationEscapeHtml(name)}</strong>${service ? `<small class="d-block text-muted">${preparationEscapeHtml(service)}</small>` : ''}</span></label>`;
      }).join('') : '<div class="alert alert-light border py-2 mb-0 text-muted small"><i class="bi bi-info-circle me-1"></i>No contingency parts were suggested. You can still confirm the diagnosis review and continue.</div>';
      const { value: review } = await Swal.fire({
        title: 'Review AI Diagnosis',
        html: `<div style="text-align:left;font-size:0.85rem;"><div class="alert alert-info py-2">Review the preliminary AI diagnosis and recommendations. Your confirmation unlocks Equipment &amp; Consumables preparation; it does not create a final diagnosis or charge the customer.</div>${diagnosisHtml}<div class="fw-semibold mb-2">Optional contingency parts to bring</div>${partsHtml}<textarea id="swal-verify-notes" class="swal2-textarea" style="height:75px;font-size:0.82rem;margin:12px 0 0;width:100%;" placeholder="Review notes (optional)..."></textarea></div>`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: '<i class="bi bi-check2-circle me-1"></i>Confirm AI Review',
        confirmButtonColor: '#059669',
        cancelButtonText: 'Cancel',
        focusConfirm: false,
        preConfirm: () => ({
          notes: document.getElementById('swal-verify-notes')?.value || '',
          carriedPartIndexes: [...document.querySelectorAll('.ai-carry-part:checked')].map(input => Number(input.value)),
        })
      });
      if (review === undefined) return;

      Swal.fire({ title: 'Saving...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
      const resp = await fetch(`/api/technician/appointments/${bookingId}/ai-diagnose/verify`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ technicianNotes: review.notes, carriedPartIndexes: review.carriedPartIndexes, verified: true }),
        credentials: 'same-origin'
      });
      const data = await resp.json();
      Swal.close();
      if (resp.ok && data.success) {
        Swal.fire({ icon: 'success', title: 'AI Diagnosis Reviewed', text: 'Equipment & Consumables preparation is now unlocked.', confirmButtonColor: '#059669' }).then(() => {
          if (window._currentDetailId && window.refreshOpenAssignmentDetail) {
            window.refreshOpenAssignmentDetail('overview');
          } else if (window._currentDetailId) {
            showDetail(window._currentDetailId);
          }
        });
      } else {
        Swal.fire('Error', data.error || 'Failed to verify.', 'error');
      }
    } catch (e) {
      Swal.close();
      Swal.fire('Error', e?.message || 'Could not load the AI diagnosis.', 'error');
    }
  }

  // The AI panel renders inline onclick handlers, so expose the verifier.
  window.verifyAiAssistant = verifyAiAssistant;

  async function generateRepairNotes(bookingId) {
    try {
      Swal.fire({ title: 'Generating Repair Notes...', html: 'AI is drafting professional repair documentation...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
      const resp = await fetch(`/api/technician/appointments/${bookingId}/ai-generate-notes`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin'
      });
      const data = await resp.json();
      Swal.close();
      if (resp.ok && data.success) {
        await Swal.fire({
          title: 'Generated Repair Notes',
          html: `<div style="text-align:left;"><textarea id="swal-repair-notes" class="swal2-textarea" style="font-size:0.82rem;height:200px;">${data.notes || ''}</textarea></div>`,
          icon: 'info',
          showCancelButton: true,
          confirmButtonText: '<i class="bi bi-clipboard me-1"></i>Copy to Clipboard',
          confirmButtonColor: '#2563eb',
          cancelButtonText: 'Close',
          preConfirm: () => document.getElementById('swal-repair-notes')?.value
        }).then(async (result) => {
          if (result.isConfirmed && result.value) {
            try {
              await navigator.clipboard.writeText(result.value);
              Swal.fire('Copied!', 'Notes copied to clipboard.', 'success');
            } catch (e) {
              Swal.fire('Copy manually', 'Select and copy the text.', 'info');
            }
          }
        });
      } else {
        Swal.fire('Error', data.error || 'Failed to generate notes.', 'error');
      }
    } catch (e) {
      Swal.close();
      Swal.fire('Error', 'Network error generating notes.', 'error');
    }
  }

  // ── Photo upload helper ──────────────────────────────────────────────────
  async function uploadPhotos(files, endpoint) {
    if (!files || files.length === 0) return [];
    const formData = new FormData();
    for (const f of files) formData.append('photos', f);
    const resp = await fetch(endpoint, { method: 'POST', body: formData, credentials: 'same-origin' });
    if (!resp.ok) throw new Error('Photo upload failed');
    const data = await resp.json();
    return data.urls || [];
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // INSPECTION MODAL PROGRESS PERSISTENCE (sessionStorage)
  // ═══════════════════════════════════════════════════════════════════════════

  function _saveInspectionState(bookingId) {
    if (!bookingId) return;
    try {
      const state = {
        bookingId,
        savedAt: Date.now(),
        diagnoses: window._inspDiagnoses || [],
        parts: window._inspParts || [],
        inventoryStatus: window._inspInventoryStatus || {},
        replacementPartsRequired: Boolean(window._inspReplacementPartsRequired),
        wizardStep: window._inspWizardStep || 1,
        fields: {
          laborCost: document.getElementById('quotationLaborCost')?.value || '0',
          laborCategory: document.getElementById('quotationLaborCategory')?.value || 'standard',
          repairAction: document.getElementById('inspectionRecommendedAction')?.value || '',
          notes: document.getElementById('inspectionNotes')?.value || '',
          actualRepairDuration: window._actualRepairDuration || null,
          actualRepairDurationReason: document.getElementById('actualRepairDurationReason')?.textContent || '',
        }
      };
      sessionStorage.setItem(`inspection_state_${bookingId}`, JSON.stringify(state));
    } catch (e) {
      console.warn('[InspectionState] Could not save state:', e.message);
    }
  }

  function _restoreInspectionState(bookingId) {
    if (!bookingId) return false;
    try {
      const raw = sessionStorage.getItem(`inspection_state_${bookingId}`);
      if (!raw) return false;
      const state = JSON.parse(raw);
      if (!state || !state.savedAt || (Date.now() - state.savedAt) > 4 * 60 * 60 * 1000) {
        sessionStorage.removeItem(`inspection_state_${bookingId}`);
        return false;
      }
      const hasData = (state.diagnoses?.length > 0) || (state.parts?.length > 0);
      if (!hasData) return false;

      window._inspDiagnoses = state.diagnoses || [];
      window._inspParts = state.parts || [];
      window._inspInventoryStatus = state.inventoryStatus || {};
      window._inspReplacementPartsRequired = state.replacementPartsRequired === undefined
        ? (state.parts || []).some(part => part.checked)
        : Boolean(state.replacementPartsRequired);
      window._inspWizardStep = state.wizardStep || 1;

      const f = state.fields || {};
      if (f.laborCategory) document.getElementById('quotationLaborCategory').value = f.laborCategory;
      _applyOfficialLaborFee(f.laborCategory || 'standard');
      if (f.repairAction) document.getElementById('inspectionRecommendedAction').value = f.repairAction;
      if (f.notes) document.getElementById('inspectionNotes').value = f.notes;
      if (f.actualRepairDuration) {
        window._actualRepairDuration = Number(f.actualRepairDuration);
        window._aiDuration = window._actualRepairDuration;
        document.getElementById('actualRepairDuration').textContent = window._actualRepairDuration + ' minutes';
        document.getElementById('actualRepairDurationReason').textContent = f.actualRepairDurationReason || 'Estimated from the technician-confirmed repair scope.';
        const sourceEl = document.getElementById('actualRepairDurationSource');
        sourceEl.className = 'badge bg-success'; sourceEl.textContent = 'ACTUAL DIAGNOSIS';
      }
      _renderReplacementPartsChoice();

      return true;
    } catch (e) {
      console.warn('[InspectionState] Could not restore state:', e.message);
      return false;
    }
  }

  function _clearInspectionState(bookingId) {
    if (!bookingId) return;
    try {
      sessionStorage.removeItem(`inspection_state_${bookingId}`);
    } catch (e) { /* ignore */ }
  }

  // Auto-save form fields on change
  function _attachInspectionFieldSaveListeners(bookingId) {
    const fieldIds = ['quotationLaborCost', 'quotationLaborCategory', 'inspectionRecommendedAction', 'inspectionNotes'];
    fieldIds.forEach(id => {
      const el = document.getElementById(id);
      if (el && !el._inspSaveAttached) {
        el.addEventListener('input', () => _saveInspectionState(bookingId));
        el.addEventListener('change', () => _saveInspectionState(bookingId));
        el._inspSaveAttached = true;
      }
    });

    // Save state when inspection modal is closed (X button, backdrop, escape)
    const inspModal = document.getElementById('inspectionModal');
    if (inspModal && !inspModal._closeSaveAttached) {
      inspModal.addEventListener('hidden.bs.modal', function () {
        if (_repairBookingId) _saveInspectionState(_repairBookingId);
      });
      inspModal._closeSaveAttached = true;
    }
  }

  function openInspectionModal(bookingId, customerName, serviceName, assignment) {
    _repairBookingId = bookingId;
    // Always prefer the passed assignment, then _detailAssignment, then fetch from API
    const ctx = assignment || window._detailAssignment;
    if (ctx && ctx.bookingId) {
      window._inspAssignmentContext = ctx;
      _initInspectionModalUI(ctx, serviceName, customerName);
    } else if (ctx) {
      window._inspAssignmentContext = ctx;
      _initInspectionModalUI(ctx, serviceName, customerName);
    } else {
      // Fallback: fetch full assignment data from the API to ensure we have all booking fields
      window._inspAssignmentContext = { serviceName, customerName, address: '' };
      _initInspectionModalUI(window._inspAssignmentContext, serviceName, customerName);
      fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' })
        .then(r => r.json())
        .then(detail => {
          const booking = detail.booking || detail;
          // Merge booking data into the context so payment modal has all required fields
          window._inspAssignmentContext = {
            ...window._inspAssignmentContext,
            bookingId: booking,
            paymentMethod: booking.paymentMethod,
            downpaymentAmount: booking.downpaymentAmount,
            initialCost: booking.initialCost,
            totalPrice: booking.totalPrice,
            estimatedFee: booking.estimatedFee,
            travelFare: booking.travelFare,
            balanceAmount: booking.balanceAmount,
          };
        })
        .catch(() => { });
    }
  }

  function _initInspectionModalUI(assignmentContext, serviceName, customerName) {
    _repairBookingId = _repairBookingId;
    const info = document.getElementById('inspectionBookingInfo');
    info.innerHTML = `<div class="d-flex align-items-center gap-3" style="background:#fff;border:1px solid #e2e8f0;border-radius:var(--mw-radius-xs);padding:10px 14px;box-shadow:var(--mw-shadow-sm);">
    <div style="width:32px;height:32px;border-radius:6px;background:linear-gradient(135deg,#2563eb,#3b82f6);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
      <i class="bi bi-briefcase" style="color:#fff;font-size:0.78rem;"></i>
    </div>
    <div>
      <span class="fw-semibold" style="font-size:0.85rem;color:#0f172a;">${serviceName || 'Repair'}</span>
      <span style="font-size:0.72rem;color:#64748b;display:block;"><i class="bi bi-person me-1"></i>${customerName || 'Customer'}</span>
    </div>
  </div>`;

    // Reset all sections
    document.getElementById('inspectionAiLoading').style.display = 'block';
    document.getElementById('inspectionSummarySection').style.display = 'none';
    document.getElementById('inspectionReviewSection').style.display = 'none';
    document.getElementById('inspectionQuoteSection').style.display = 'none';
    document.getElementById('addDiagnosisInput').style.display = 'none';
    document.getElementById('addPartInput').style.display = 'none';
    clearTimeout(window._durationEstimateTimer);
    window._durationEstimateSequence = (window._durationEstimateSequence || 0) + 1;
    window._actualRepairDuration = null;
    document.getElementById('actualRepairDuration').textContent = 'Waiting for confirmed diagnosis';
    document.getElementById('actualRepairDurationReason').textContent = 'Based on confirmed diagnosis, repair action, selected parts, and complexity.';
    document.getElementById('actualRepairDurationSource').className = 'badge bg-secondary';
    document.getElementById('actualRepairDurationSource').textContent = 'NOT ESTIMATED';

    const reviewSection = document.getElementById('inspectionReviewSection');
    if (reviewSection && !reviewSection._durationListenerAttached) {
      reviewSection.addEventListener('input', _scheduleAutomaticRepairDurationEstimate);
      reviewSection.addEventListener('change', _scheduleAutomaticRepairDurationEstimate);
      reviewSection.addEventListener('click', function () {
        setTimeout(_scheduleAutomaticRepairDurationEstimate, 0);
      });
      reviewSection._durationListenerAttached = true;
    }

    // Attach auto-save for notes
    _attachInspectionFieldSaveListeners(_repairBookingId);

    // The technician confirms complexity; the official fee is never typed manually.
    const laborCatSelect = document.getElementById('quotationLaborCategory');
    if (laborCatSelect && !laborCatSelect._listenerAttached) {
      laborCatSelect.addEventListener('change', function () {
        _applyOfficialLaborFee(this.value);
        window._actualRepairDuration = null;
        document.getElementById('actualRepairDuration').textContent = 'Re-estimate when quotation is generated';
        document.getElementById('actualRepairDurationSource').className = 'badge bg-secondary';
        document.getElementById('actualRepairDurationSource').textContent = 'PENDING';
        _saveInspectionState(_repairBookingId);
      });
      laborCatSelect._listenerAttached = true;
    }

    // ── Try to restore saved progress ──────────────────────────────
    const restored = _restoreInspectionState(_repairBookingId);
    _loadRepairLaborFees().then(() => _applyOfficialLaborFee(document.getElementById('quotationLaborCategory')?.value || 'standard'));
    if (restored) {
      document.getElementById('inspectionPhotos').value = '';
      _updateStepperUI();
      _showInspectionFormSections();
      _renderDiagnosisChecklist();
      _renderPartsList();
      _updatePartsInventoryStatus();
      document.getElementById('inspectionAiLoading').style.display = 'none';
    } else {
      // Fresh start
      document.getElementById('inspectionPhotos').value = '';
      document.getElementById('quotationLaborCost').value = 0;
      document.getElementById('quotationLaborCategory').value = 'standard';
      document.getElementById('inspectionNotes').value = '';

      window._inspDiagnoses = [];
      window._inspParts = [];
      window._inspInventoryStatus = {};
      window._inspReplacementPartsRequired = false;
      window._inspWizardStep = 1;
      window._aiDuration = 90;
      window._aiComplexity = 'moderate';
      _renderReplacementPartsChoice();

      _updateStepperUI();
      _fetchAiDiagnosticsForInspection(_repairBookingId);
    }

    new bootstrap.Modal(document.getElementById('inspectionModal')).show();
  }


  async function _fetchAiDiagnosticsForInspection(bookingId) {
    try {
      await _loadRepairLaborFees();
      // First try to get existing AI data from the booking
      const resp = await fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' });
      const detail = await resp.json();
      const booking = detail.booking || detail;
      const ta = booking.technicianAssistant;

      if (ta && ta.probableCauses && ta.probableCauses.length > 0) {
        // AI data already exists, use it
        _populateInspectionFromAi(ta, booking);
      } else {
        // Generate new AI diagnosis
        const aiResp = await fetch(`/api/technician/appointments/${bookingId}/ai-diagnose`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin'
        });
        const aiData = await aiResp.json();
        if (aiResp.ok && aiData.success) {
          _populateInspectionFromAi(aiData.technicianAssistant, booking);
        } else {
          // No AI data available, show empty form
          _showInspectionFormSections();
        }
      }
    } catch (e) {
      console.error('[Inspection] Error fetching AI diagnostics:', e);
      _showInspectionFormSections();
    }
  }

  window._repairLaborFees = window._repairLaborFees || { minor: 300, standard: 500, complex: 800, major: 1500 };

  async function _loadRepairLaborFees() {
    try {
      const resp = await fetch('/api/technician/settings/repair-labor-fees', { credentials: 'same-origin' });
      const data = await resp.json();
      if (!resp.ok) throw new Error(data.error || 'Unable to load labor fees');
      window._repairLaborFees = { ...window._repairLaborFees, ...(data.fees || {}) };
    } catch (error) {
      console.error('[Inspection] Official labor fees unavailable; using configured defaults.', error);
    }
  }

  function _normalizeLaborCategory(complexity) {
    const value = String(complexity || '').toLowerCase();
    if (['minor', 'low', 'simple'].includes(value)) return 'minor';
    if (['complex', 'high', 'advanced'].includes(value)) return 'complex';
    if (['major', 'overhaul', 'major_overhaul'].includes(value)) return 'major';
    return 'standard';
  }

  function _applyOfficialLaborFee(category) {
    const confirmed = _normalizeLaborCategory(category);
    const fee = Number(window._repairLaborFees?.[confirmed]) || 0;
    const input = document.getElementById('quotationLaborCost');
    if (input) input.value = fee;
    window._aiLaborCost = fee;
    updateQuotationTotal();
    return fee;
  }

  function _laborComplexityReason(category, duration, partsCount) {
    if (category === 'minor') return 'Simple adjustment, cleaning, minor correction, no replacement part, or short repair duration.';
    if (category === 'complex') return `${partsCount > 1 ? 'Multiple possible components and ' : ''}extensive troubleshooting, difficult access, or advanced electrical/mechanical work.`;
    if (category === 'major') return 'Major component work, extensive disassembly, multiple major components, or a long overhaul.';
    return `${partsCount === 1 ? 'One possible component and ' : ''}a straightforward basic repair with normal access and duration (${Number(duration) || 90} minutes estimated).`;
  }

  function _populateInspectionFromAi(ta, booking) {
    // Build diagnosis checklist from AI probable causes
    window._inspDiagnoses = (ta.probableCauses || []).map((c, i) => ({
      id: 'ai_' + i,
      text: c.cause || c,
      explanation: c.explanation || '',
      likelihood: c.likelihood || 'medium',
      serviceIndex: c.serviceIndex,
      serviceName: c.serviceName || '',
      unitType: c.unitType || '',
      checked: false,
      source: 'ai'
    }));

    // Build parts list from AI suggested parts
    window._inspParts = (ta.possibleParts || []).map((p, i) => {
      const name = typeof p === 'string' ? p : (p.name || p);
      const cost = typeof p === 'object' ? (p.estimatedCostPHP || 0) : 0;
      const likelihood = typeof p === 'object' ? (p.likelihood || 'medium') : 'medium';
      const purpose = typeof p === 'object' ? (p.purpose || '') : '';
      return {
        id: 'ai_part_' + i,
        name, cost, quantity: 1, likelihood, purpose,
        serviceIndex: p.serviceIndex,
        serviceName: p.serviceName || '',
        unitType: p.unitType || '',
        checked: false, source: 'ai', toolId: null
      };
    });

    // Store AI duration and complexity
    const duration = ta.estimatedDurationMinutes || 90;
    const complexity = ta.repairComplexity || 'medium';
    window._aiDuration = duration;
    window._aiComplexity = complexity;

// AI recommends complexity only. Official pricing supplies the amount.
    const suggestedCategory = _normalizeLaborCategory(complexity);
    const laborCategoryInput = document.getElementById('quotationLaborCategory');
    if (laborCategoryInput) laborCategoryInput.value = suggestedCategory;
    _applyOfficialLaborFee(suggestedCategory);
    const labels = { minor:'Minor Repair', standard:'Standard Repair', complex:'Complex Repair', major:'Major Overhaul' };
    const complexitySuggestionEl = document.getElementById('aiLaborComplexitySuggestion');
    if (complexitySuggestionEl) complexitySuggestionEl.textContent = labels[suggestedCategory];
    const complexityReasonEl = document.getElementById('aiLaborComplexityReason');
    if (complexityReasonEl) complexityReasonEl.textContent = _laborComplexityReason(suggestedCategory, duration, window._inspParts.length);

    // Render AI summary screen
    _renderAiSummary(ta);
    _showInspectionFormSections();
    _matchAiPartsToInventory().then(() => {
      _saveInspectionState(_repairBookingId);
    });
  }

  function _renderAiSummary(ta) {
    const container = document.getElementById('aiSummaryContent');
    const safe = value => String(value == null ? '' : value).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
    const causes = ta.probableCauses || [];
    const parts = ta.possibleParts || [];
    const top3 = causes.slice(0, 3);
    const duration = ta.estimatedDurationMinutes || 90;
    const suggestedCategory = _normalizeLaborCategory(ta.repairComplexity || 'medium');
    const aiLaborCost = Number(window._repairLaborFees?.[suggestedCategory]) || 0;
    const complexityLabels = { minor:'Minor Repair', standard:'Standard Repair', complex:'Complex Repair', major:'Major Overhaul' };
