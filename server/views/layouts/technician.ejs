<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;800&display=swap"
      rel="stylesheet"
    />

    <!-- Shared admin/technician CSS -->
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/sidebaradmin.css" />

    <!-- Technician navbar responsive behavior -->
    <link rel="stylesheet" href="/css/technician/technician-navbar.css" />

    <!-- AOS Animation (CDN) -->
    <link
      href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css"
      rel="stylesheet"
    />

    <!-- Optional technician-specific style overrides -->
    <link rel="stylesheet" href="/css/technician/technician.css" />

    <!-- Leaflet CSS/JS for maps/tracking (use jsdelivr to satisfy CSP) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/leaflet/dist/leaflet.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/leaflet/dist/leaflet.js"></script>

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  </head>
  <body class="admin-layout technician-layout">
    <div class="admin-topbar"><%- include('../partials/technician-navbar') %></div>

    <div class="d-flex admin-root">
      <aside class="admin-sidebar" id="adminSidebar">
        <%- include('../partials/technician-sidebar') %>
      </aside>

      <button
        id="sidebarHandle"
        class="sidebar-handle"
        aria-controls="adminSidebar"
        aria-expanded="true"
        aria-label="Toggle sidebar"
        tabindex="0"
      >
        <i class="bi bi-chevron-left" aria-hidden="true"></i>
      </button>

      <div class="admin-content flex-grow-1">
        <main class="p-4"><%- body %></main>
      </div>
    </div>

    <!-- Toast container + global confirm/prompt modals (used by window.notify) -->
    <div
      id="globalToastContainer"
      aria-live="polite"
      aria-atomic="true"
      style="position: fixed; top: 1rem; right: 1rem; z-index: 10800"
    ></div>

    <!-- Confirm modal -->
    <div
      class="modal fade"
      id="globalConfirmModal"
      tabindex="-1"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Confirm</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body"></div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-sm btn-outline-secondary js-confirm-no"
              data-bs-dismiss="modal"
            >
              Cancel</button
            ><button
              type="button"
              class="btn btn-sm btn-primary js-confirm-yes"
            >
              Confirm
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Prompt modal -->
    <div
      class="modal fade"
      id="globalPromptModal"
      tabindex="-1"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Input</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <label class="form-label"></label
            ><input class="form-control js-prompt-input" />
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-sm btn-outline-secondary js-prompt-cancel"
              data-bs-dismiss="modal"
            >
              Cancel</button
            ><button type="button" class="btn btn-sm btn-primary js-prompt-ok">
              OK
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

    <!-- AOS Animation (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        if (window.AOS && typeof AOS.init === "function") {
          AOS.init({ duration: 800, easing: "ease-in-out", once: true });
        }
      });
    </script>

    <!-- GSAP for sidebar animations -->
    <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
      // Initialize socket connection for real-time tracking
      window.socket = io({ path: '/socket.io' });
      // Join technician room for targeted notifications
      <% if (technician && technician._id) { %>
        window.socket.emit('tech:join', '<%= technician._id %>');
      <% } %>
    </script>
    <script src="/js/admin.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <!-- Optional technician scripts -->
    <script src="/js/technician.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </body>
</html>
