  // ── Chart management ──
  function destroyCharts() {
    Object.values(charts).forEach(c => { try { c.destroy(); } catch(e){} });
    ['revenueTrend', 'sourceMix', 'paymentMix', 'posPaymentMix', 'marginTrend', 'serviceEconomics', 'productChannelMix', 'brandRevenue', 'fulfillmentMix', 'kpiSparkRevenue', 'kpiSparkCash', 'kpiSparkAvgTxn'].forEach(id => {
      const existing = typeof Chart !== 'undefined' ? Chart.getChart(id) : null;
      if (existing) { try { existing.destroy(); } catch (e) {} }
    });
    charts = {};
  }

  function updateCharts(A) {
    destroyCharts();
    const colors = ['#2563eb', '#10b981', '#f59e0b', '#8b5cf6', '#06b6d4', '#ef4444'];
    Chart.defaults.font.family = 'Inter,sans-serif';
    Chart.defaults.color = '#64748b';

    const labels = Object.keys(A.monthlyRevenue || {}).reverse();
    const months = Object.values(A.monthlyRevenue || {}).reverse();
    const costs = Object.values(A.monthlyPartsCost || {}).reverse();
    const scales = {
      x: { stacked: false, grid: { display: false }, ticks: { font: { size: 10 } } },
      y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 10 }, callback: v => '\u20B1' + Number(v).toLocaleString() } }
    };
    const legendOpts = { labels: { usePointStyle: true, boxWidth: 7, font: { size: 11 } } };
    const pesoFmt = v => '\u20B1' + Number(v).toLocaleString('en-PH');
    const tooltipFmt = { callbacks: { label: ctx => `${ctx.dataset.label || ctx.label}: ${pesoFmt(ctx.parsed.y ?? ctx.parsed)}` } };

    charts.revenueTrend = new Chart(document.getElementById('revenueTrend'), {
      type: 'bar', data: { labels, datasets: [
        { label: 'Services', data: months.map(x => x.service || 0), backgroundColor: '#2563eb', borderRadius: 5 },
        { label: 'Online Orders', data: months.map(x => x.orders || 0), backgroundColor: '#10b981', borderRadius: 5 },
        { label: 'POS', data: months.map(x => x.pos || 0), backgroundColor: '#f59e0b', borderRadius: 5 },
      ]}, options: { responsive: true, maintainAspectRatio: false, onClick: (e, els) => { if (els.length > 0) showChartDetail(chartConfigs.revenueTrend, els[0].index, els[0].datasetIndex); }, onHover: (e, els) => { if (e.native) e.native.target.style.cursor = els.length > 0 ? 'pointer' : 'default'; }, scales: { x: { ...scales.x, stacked: true }, y: { ...scales.y, stacked: true } }, plugins: { legend: legendOpts, tooltip: tooltipFmt } }
    });

    function donut(id, lbls, data) {
      const cfg = chartConfigs[id];
      charts[id] = new Chart(document.getElementById(id), {
        type: 'doughnut', data: { labels: lbls, datasets: [{ data, backgroundColor: colors, borderColor: '#fff', borderWidth: 3 }] },
        options: { responsive: true, maintainAspectRatio: false, cutout: '68%', onClick: cfg ? (e, els) => { if (els.length > 0) showChartDetail(cfg, els[0].index, els[0].datasetIndex); } : undefined, onHover: (e, els) => { if (e.native) e.native.target.style.cursor = els.length > 0 ? 'pointer' : 'default'; }, plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 7, font: { size: 10 } } }, tooltip: { callbacks: { label: ctx => `${ctx.label}: ${pesoFmt(ctx.parsed)}` } } } }
      });
    }

    donut('sourceMix', ['Services', 'Online Orders', 'POS'], [A.serviceRevenue || 0, A.orderRevenue || 0, A.posRevenue || 0]);
    const grossMethods = A.grossCollectionMethods || {};
    donut('paymentMix', ['GCash', 'COD / Cash', 'Bank', 'Other'], [grossMethods.gcash || 0, grossMethods.cash || 0, grossMethods.bank || 0, grossMethods.other || 0]);

    const posMethods = A.posPaymentMethods || {};
    donut('posPaymentMix', Object.keys(posMethods).map(x => x.replaceAll('_', ' ').replace(/\b\w/g, c => c.toUpperCase())), Object.values(posMethods));

    charts.marginTrend = new Chart(document.getElementById('marginTrend'), {
      type: 'line', data: { labels, datasets: [
        { label: 'Recognized Net Revenue', data: months.map(x => x.recognized || 0), borderColor: '#2563eb', backgroundColor: 'rgba(37,99,235,0.08)', fill: true, tension: 0.4, pointRadius: 3 },
        { label: 'Known Direct Cost', data: months.map((x, i) => costs[i] || 0), borderColor: '#ef4444', backgroundColor: 'rgba(239,68,68,0.08)', fill: true, tension: 0.4, pointRadius: 3 },
      ]}, options: { responsive: true, maintainAspectRatio: false, onClick: (e, els) => { if (els.length > 0) showChartDetail(chartConfigs.marginTrend, els[0].index, els[0].datasetIndex); }, onHover: (e, els) => { if (e.native) e.native.target.style.cursor = els.length > 0 ? 'pointer' : 'default'; }, scales, plugins: { legend: legendOpts, tooltip: tooltipFmt } }
    });

    // Service economics chart — computed from completedServiceCosts for consistency with modal table
    const completedByCat = { core: [], repair: [], mix: [] };
    (A.completedServiceCosts || []).forEach(s => { if (completedByCat[s.serviceCategory]) completedByCat[s.serviceCategory].push(s); });
