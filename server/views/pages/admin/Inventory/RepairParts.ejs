  // ── Edit Reserved Quantity (Quick Edit) ──────────────────────────────
  window.editReservedQty = async function(id, currentReserved, unit, itemName) {
    const p = allParts.find(x => x._id === id);
    if (!p) return;
    
    const onHand = p.quantity || 0;
    const maxReserved = onHand;
    
    let html = `
      <div style="text-align:center;">
        <div style="margin-bottom:16px;">
          <div style="font-size:0.9rem;color:#64748b;margin-bottom:4px;">On Hand: <strong>${onHand} ${unit}</strong></div>
          <div style="font-size:0.9rem;color:#64748b;">Current Reserved: <strong>${currentReserved} ${unit}</strong></div>
        </div>
        <div style="margin-bottom:16px;">
          <label style="display:block;font-size:0.8rem;color:#64748b;margin-bottom:6px;font-weight:600;">New Reserved Quantity</label>
          <input type="number" id="editReservedInput" min="0" max="${maxReserved}" value="${currentReserved}" style="width:100%;padding:10px;border:1px solid #e2e8f0;border-radius:8px;font-size:1rem;text-align:center;">
          <small style="display:block;margin-top:6px;color:#94a3b8;">Max: ${maxReserved} ${unit}</small>
        </div>
      </div>
    `;
    
    // Patch the confirm button to capture the input value BEFORE the modal closes
    const result = await new Promise((resolve) => {
      let overlay = document.getElementById('rpConfirmModal');
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.id = 'rpConfirmModal';
        overlay.className = 'rp-confirm-overlay';
        overlay.innerHTML = `
          <div class="rp-confirm-modal">
            <div class="rp-confirm-header">
              <span class="rp-confirm-title"></span>
              <button class="rp-confirm-close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="rp-confirm-body">
              <div class="rp-confirm-icon"><i class="bi"></i></div>
              <div class="rp-confirm-message"></div>
              <div class="rp-confirm-actions">
                <button class="rp-confirm-cancel"></button>
                <button class="rp-confirm-delete"></button>
              </div>
            </div>
          </div>
        `;
        overlay.addEventListener('click', (e) => { if (e.target === overlay) { overlay.classList.remove('show'); resolve(false); } });
        overlay.querySelector('.rp-confirm-close').addEventListener('click', () => { overlay.classList.remove('show'); resolve(false); });
        document.body.appendChild(overlay);
      }
      overlay.querySelector('.rp-confirm-title').textContent = 'Edit Reserved Quantity';
      overlay.querySelector('.rp-confirm-icon').className = 'rp-confirm-icon info';
      overlay.querySelector('.rp-confirm-icon i').className = 'bi bi-info-circle-fill';
      overlay.querySelector('.rp-confirm-message').innerHTML = html;
      overlay.querySelector('.rp-confirm-cancel').textContent = 'Cancel';
      overlay.querySelector('.rp-confirm-delete').textContent = 'Update';
      overlay.querySelector('.rp-confirm-cancel').onclick = () => { overlay.classList.remove('show'); resolve(false); };
      // Capture input value BEFORE closing
      overlay.querySelector('.rp-confirm-delete').onclick = () => {
        const input = document.getElementById('editReservedInput');
        const val = input ? parseInt(input.value) : currentReserved;
        overlay.classList.remove('show');
        resolve(val);
      };
      overlay.classList.add('show');
    });
    
    if (result === false) return;
    
    const newReserved = typeof result === 'number' ? result : currentReserved;
    console.log('[editReservedQty] New reserved value:', newReserved, 'for id:', id);
    
    if (newReserved < 0 || newReserved > maxReserved) {
      Swal.fire({ icon: 'warning', title: 'Invalid', text: `Reserved quantity must be between 0 and ${maxReserved}.`, confirmButtonColor: '#2563eb', confirmButtonText: '<i class="bi bi-check-lg"></i> OK' });
      return;
    }
    
    try {
      const res = await fetch(`/api/admin/tools/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ reservedQuantity: newReserved })
      });
      const data = await res.json();
      console.log('[editReservedQty] API response:', res.status, data);
      if (res.ok) {
        showRpToast(`Reserved quantity updated to ${newReserved} ${unit}`, 'success');
        await loadParts();
      } else {
        Swal.fire({ icon: 'error', title: 'Error', text: data.error || 'Failed to update reserved quantity.', confirmButtonColor: '#2563eb', confirmButtonText: '<i class="bi bi-check-lg"></i> OK', iconColor: '#dc2626' });
      }
    } catch (e) {
      Swal.fire({ icon: 'error', title: 'Error', text: 'Network error.', confirmButtonColor: '#2563eb', confirmButtonText: '<i class="bi bi-check-lg"></i> OK', iconColor: '#dc2626' });
    }
  };

  // ── Edit Asset Status (Quick Edit) ────────────────────────────────────
