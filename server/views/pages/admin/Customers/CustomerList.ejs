<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  (function(){
    function applyBadge(id,text){
      var el=document.getElementById(id);
      if(!el)return;
      el.innerHTML=text;
      el.classList.remove('positive','negative','neutral');
      if(/^[+]/.test(text))el.classList.add('positive');
      else if(/^[-]/.test(text))el.classList.add('negative');
      else el.classList.add('neutral');
    }
    var badgeData = { total: '+4.5%', active: '+3.2%', pending: '-1.1%', blocked: '+0.0%' };
    applyBadge('badgeCustTotal', badgeData.total);
    applyBadge('badgeCustActive', badgeData.active);
    applyBadge('badgeCustPending', badgeData.pending);
    applyBadge('badgeCustBlocked', badgeData.blocked);

    function createSparkline(id,data,color){
      var c=document.getElementById(id);
      if(!c||typeof Chart==='undefined')return;
      return new Chart(c,{type:'line',data:{labels:data.map((_,i)=>i+1),datasets:[{data:data,borderColor:color,backgroundColor:color.replace('rgb','rgba').replace(')',',0.12)'),fill:true,tension:0.35}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{enabled:false}},elements:{point:{radius:0}},scales:{x:{display:false},y:{display:false}}}});
    }
    createSparkline('custSparkTotal',[5,7,6,8,7,9,8],'#4361ee');
    createSparkline('custSparkActive',[4,6,5,7,6,8,7],'#2ec4b6');
    createSparkline('custSparkPending',[3,4,3,5,4,6,5],'#f59e0b');
    createSparkline('custSparkBlocked',[1,2,1,2,1,1,0],'#dc3545');
  })();
</script>
