<div class="container-fluid py-4">
  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-bar-chart-line"></i></div>
        <div>
          <h1>Rating Analytics</h1>
          <p>Detailed insights and trends for customer ratings and reviews</p>
        </div>
      </div>
      <div class="au-hero-actions">
        <button class="btn btn-outline-success" onclick="exportAnalytics()">
          <i class="bi bi-file-earmark-excel me-2"></i>Export Analytics
        </button>
        <button class="btn btn-outline-info" onclick="scheduleReport()">
          <i class="bi bi-calendar-check me-2"></i>Schedule Report
        </button>
        <button class="btn btn-primary" onclick="refreshAnalytics()">
          <i class="bi bi-arrow-clockwise me-2"></i>Refresh
        </button>
      </div>
    </div>
  </div>

  <!-- Analytics Period Selector -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <div class="row align-items-center">
        <div class="col-md-8">
          <div class="btn-group" role="group">
            <input type="radio" class="btn-check" name="period" id="period7" value="7" checked>
            <label class="btn btn-outline-primary" for="period7">Last 7 Days</label>
            
            <input type="radio" class="btn-check" name="period" id="period30" value="30">
            <label class="btn btn-outline-primary" for="period30">Last 30 Days</label>
            
            <input type="radio" class="btn-check" name="period" id="period90" value="90">
            <label class="btn btn-outline-primary" for="period90">Last 3 Months</label>
            
            <input type="radio" class="btn-check" name="period" id="period365" value="365">
            <label class="btn btn-outline-primary" for="period365">Last Year</label>
            
            <input type="radio" class="btn-check" name="period" id="periodcustom" value="custom">
            <label class="btn btn-outline-primary" for="periodcustom">Custom Range</label>
          </div>
        </div>
        <div class="col-md-4">
          <div class="d-flex gap-2">
            <input type="date" class="form-control" id="startDate" style="display: none;">
            <input type="date" class="form-control" id="endDate" style="display: none;">
            <button class="btn btn-primary" onclick="applyPeriod()">Apply</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Key Metrics -->
  <div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h6 class="text-muted mb-2">Total Ratings</h6>
              <h3 class="mb-0" id="totalRatings">0</h3>
              <div class="d-flex align-items-center mt-2">
                <span class="badge bg-success">+12.5%</span>
                <small class="text-muted ms-2">vs last period</small>
              </div>
            </div>
            <div class="ms-3">
              <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                <i class="bi bi-star-fill text-primary fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h6 class="text-muted mb-2">Average Rating</h6>
              <h3 class="mb-0" id="avgRating">0.0</h3>
              <div class="d-flex align-items-center mt-2">
                <span class="badge bg-success">+0.3</span>
                <small class="text-muted ms-2">improvement</small>
              </div>
            </div>
            <div class="ms-3">
              <div class="bg-success bg-opacity-10 rounded-circle p-3">
                <i class="bi bi-trophy text-success fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h6 class="text-muted mb-2">Response Rate</h6>
              <h3 class="mb-0" id="responseRate">0%</h3>
              <div class="d-flex align-items-center mt-2">
                <span class="badge bg-warning">-2.1%</span>
                <small class="text-muted ms-2">vs last period</small>
              </div>
            </div>
            <div class="ms-3">
              <div class="bg-info bg-opacity-10 rounded-circle p-3">
                <i class="bi bi-chat-dots text-info fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h6 class="text-muted mb-2">Sentiment Score</h6>
              <h3 class="mb-0" id="sentimentScore">0%</h3>
              <div class="d-flex align-items-center mt-2">
                <span class="badge bg-success">+5.2%</span>
                <small class="text-muted ms-2">positive</small>
              </div>
            </div>
            <div class="ms-3">
              <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                <i class="bi bi-emoji-smile text-warning fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent User Ratings -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0">
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Recent User Ratings</h5>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-primary" onclick="loadRecentRatings()">
            <i class="bi bi-arrow-clockwise"></i> Refresh
          </button>
          <button class="btn btn-sm btn-outline-success" onclick="exportRatings()">
            <i class="bi bi-download"></i> Export
          </button>
        </div>
      </div>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-lg-8">
          <div class="ratings-chart-container">
            <canvas id="recentRatingsChart" height="300"></canvas>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="recent-ratings-list" id="recentRatingsList">
            <h6 class="text-muted mb-3">Latest Reviews</h6>
            <div id="recentRatingsContent">
              <!-- Recent ratings will be loaded here -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="row mb-4">
    <div class="col-lg-8 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Rating Trends Over Time</h5>
        </div>
        <div class="card-body">
          <canvas id="ratingTrendsChart" height="300"></canvas>
        </div>
      </div>
    </div>
    
    <div class="col-lg-4 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Rating Distribution</h5>
        </div>
        <div class="card-body">
          <canvas id="ratingDistributionChart" height="300"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-lg-6 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Category Performance</h5>
        </div>
        <div class="card-body">
          <canvas id="categoryPerformanceChart" height="250"></canvas>
        </div>
      </div>
    </div>
    
    <div class="col-lg-6 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Monthly Comparison</h5>
        </div>
        <div class="card-body">
          <canvas id="monthlyComparisonChart" height="250"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Detailed Analytics Tables -->
  <div class="row mb-4">
    <div class="col-lg-6 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Top Rated Items</h5>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Item</th>
                  <th>Type</th>
                  <th>Rating</th>
                  <th>Reviews</th>
                  <th>Trend</th>
                </tr>
              </thead>
              <tbody id="topRatedTable">
                <tr>
                  <td colspan="5" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                      <span class="visually-hidden">Loading...</span>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-6 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <h5 class="mb-0">Rating Insights</h5>
        </div>
        <div class="card-body">
          <div class="insights-list" id="insightsList">
            <div class="d-flex align-items-center mb-3">
              <div class="bg-success bg-opacity-10 rounded-circle p-2 me-3">
                <i class="bi bi-arrow-up text-success"></i>
              </div>
              <div>
                <div class="fw-medium">Service ratings improved by 15%</div>
                <small class="text-muted">Compared to last month</small>
              </div>
            </div>
            <div class="d-flex align-items-center mb-3">
              <div class="bg-warning bg-opacity-10 rounded-circle p-2 me-3">
                <i class="bi bi-exclamation text-warning"></i>
              </div>
              <div>
                <div class="fw-medium">Product reviews decreased by 5%</div>
                <small class="text-muted">Needs attention</small>
              </div>
            </div>
            <div class="d-flex align-items-center mb-3">
              <div class="bg-info bg-opacity-10 rounded-circle p-2 me-3">
                <i class="bi bi-info text-info"></i>
              </div>
              <div>
                <div class="fw-medium">Technician ratings stable at 4.5</div>
                <small class="text-muted">Consistent performance</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Enhanced Sentiment Analysis -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0">
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Advanced Sentiment Analysis</h5>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-primary" onclick="refreshSentiment()">
            <i class="bi bi-arrow-clockwise"></i> Refresh
          </button>
          <button class="btn btn-sm btn-outline-success" onclick="exportSentiment()">
            <i class="bi bi-download"></i> Export
          </button>
        </div>
      </div>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-lg-8">
          <div class="mb-3">
            <h6 class="text-muted">Sentiment Score Timeline</h6>
            <div class="chart-fixed-container">
              <canvas id="sentimentTimelineChart"></canvas>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6">
              <h6 class="text-muted">Sentiment by Category</h6>
              <div class="chart-fixed-container">
                <canvas id="sentimentByCategoryChart"></canvas>
              </div>
            </div>
            <div class="col-md-6">
              <h6 class="text-muted">Sentiment Distribution</h6>
              <div class="chart-fixed-container">
                <canvas id="sentimentDistributionChart"></canvas>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="sentiment-metrics">
            <div class="text-center mb-4">
              <div class="sentiment-score-display">
                <div class="score-value" id="overallSentimentScore">0</div>
                <div class="score-label">Overall Sentiment Score</div>
                <div class="sentiment-indicator" id="sentimentIndicator">
                  <i class="bi bi-emoji-neutral"></i>
                </div>
              </div>
            </div>
            
            <div class="sentiment-breakdown">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                  <i class="bi bi-emoji-smile text-success me-2"></i>
                  <span>Positive</span>
                </div>
                <div class="text-end">
                  <span class="badge bg-success" id="positiveCount">0</span>
                  <small class="text-muted ms-1" id="positivePercent">0%</small>
                </div>
              </div>
              <div class="progress mb-3" style="height: 8px;">
                <div class="progress-bar bg-success" id="positiveProgress" style="width: 0%"></div>
              </div>
              
              <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                  <i class="bi bi-emoji-neutral text-warning me-2"></i>
                  <span>Neutral</span>
                </div>
                <div class="text-end">
                  <span class="badge bg-warning" id="neutralCount">0</span>
                  <small class="text-muted ms-1" id="neutralPercent">0%</small>
                </div>
              </div>
              <div class="progress mb-3" style="height: 8px;">
                <div class="progress-bar bg-warning" id="neutralProgress" style="width: 0%"></div>
              </div>
              
              <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                  <i class="bi bi-emoji-frown text-danger me-2"></i>
                  <span>Negative</span>
                </div>
                <div class="text-end">
                  <span class="badge bg-danger" id="negativeCount">0</span>
                  <small class="text-muted ms-1" id="negativePercent">0%</small>
                </div>
              </div>
              <div class="progress" style="height: 8px;">
                <div class="progress-bar bg-danger" id="negativeProgress" style="width: 0%"></div>
              </div>
            </div>

            <div class="sentiment-recommendations mt-4">
              <h6 class="text-muted mb-3">AI Recommendations</h6>
              <div id="recommendationsList">
                <div class="alert alert-info">
                  <i class="bi bi-lightbulb me-2"></i>
                  <strong>Insight:</strong> Loading sentiment analysis...
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Charts with Comments Panel -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0">
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Interactive Rating Analysis</h5>
        <div class="d-flex gap-2">
          <select class="form-select form-select-sm" id="chartType" style="width: 150px;">
            <option value="timeline">Timeline</option>
            <option value="distribution">Distribution</option>
            <option value="comparison">Comparison</option>
          </select>
          <button class="btn btn-sm btn-outline-primary" onclick="resetCharts()">
            <i class="bi bi-arrow-counterclockwise"></i> Reset
          </button>
        </div>
      </div>
    </div>
    <div class="card-body">
      <div class="row">
        <!-- Left Side: Charts -->
        <div class="col-lg-6">
          <div class="chart-container">
            <canvas id="mainInteractiveChart" height="400"></canvas>
            <div class="chart-overlay" id="chartOverlay" style="display: none;">
              <div class="overlay-content">
                <i class="bi bi-hand-index"></i>
                <p>Click on data points to view detailed comments</p>
              </div>
            </div>
          </div>
          
          <!-- Chart Legend -->
          <div class="chart-legend mt-3" id="chartLegend">
            <div class="d-flex flex-wrap gap-2">
              <span class="legend-item">
                <span class="legend-color bg-primary"></span>
                Service Ratings
              </span>
              <span class="legend-item">
                <span class="legend-color bg-success"></span>
                Product Ratings
              </span>
              <span class="legend-item">
                <span class="legend-color bg-warning"></span>
                Technician Ratings
              </span>
            </div>
          </div>
        </div>
        
        <!-- Right Side: Comments Panel -->
        <div class="col-lg-6">
          <div class="comments-panel">
            <div class="comments-header">
              <h6 class="mb-0">User Comments & Ratings</h6>
              <div class="d-flex gap-2">
                <span class="badge bg-primary" id="selectedDataPoint">No selection</span>
                <button class="btn btn-sm btn-outline-secondary" onclick="clearComments()">
                  <i class="bi bi-x"></i> Clear
                </button>
              </div>
            </div>
            
            <div class="comments-filters">
              <div class="row g-2">
                <div class="col-md-4">
                  <select class="form-select form-select-sm" id="sentimentFilter">
                    <option value="">All Sentiments</option>
                    <option value="positive">Positive</option>
                    <option value="neutral">Neutral</option>
                    <option value="negative">Negative</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <select class="form-select form-select-sm" id="ratingFilter">
                    <option value="">All Ratings</option>
                    <option value="5">5 Stars</option>
                    <option value="4">4 Stars</option>
                    <option value="3">3 Stars</option>
                    <option value="2">2 Stars</option>
                    <option value="1">1 Star</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <input type="text" class="form-control form-control-sm" id="commentSearch" placeholder="Search comments...">
                </div>
              </div>
            </div>
            
            <div class="comments-list" id="commentsList">
              <div class="text-center text-muted py-5">
                <i class="bi bi-bar-chart-line fs-1 d-block mb-2"></i>
                <p>Click on chart data points to view detailed comments and ratings</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- AI Insights and Recommendations -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0">
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0">AI-Powered Insights & Recommendations</h5>
        <button class="btn btn-sm btn-outline-primary" onclick="generateInsights()">
          <i class="bi bi-magic"></i> Generate Insights
        </button>
      </div>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-lg-8">
          <div class="insights-grid">
            <div class="insight-card">
              <div class="insight-header">
                <i class="bi bi-graph-up-arrow text-success"></i>
                <h6>Performance Trends</h6>
              </div>
              <div class="insight-content">
                <p id="trendInsight">Analyzing rating patterns...</p>
                <div class="insight-metrics">
                  <span class="metric">Trend: <strong id="trendMetric">--</strong></span>
                  <span class="metric">Confidence: <strong id="trendConfidence">--</strong></span>
                </div>
              </div>
            </div>
            
            <div class="insight-card">
              <div class="insight-header">
                <i class="bi bi-exclamation-triangle text-warning"></i>
                <h6>Areas for Improvement</h6>
              </div>
              <div class="insight-content">
                <p id="improvementInsight">Identifying improvement opportunities...</p>
                <div class="improvement-list" id="improvementList">
                  <!-- Dynamic improvement items -->
                </div>
              </div>
            </div>
            
            <div class="insight-card">
              <div class="insight-header">
                <i class="bi bi-star text-primary"></i>
                <h6>Key Strengths</h6>
              </div>
              <div class="insight-content">
                <p id="strengthInsight">Analyzing top performing areas...</p>
                <div class="strength-list" id="strengthList">
                  <!-- Dynamic strength items -->
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-lg-4">
          <div class="action-recommendations">
            <h6 class="text-muted mb-3">Recommended Actions</h6>
            <div class="action-list" id="actionList">
              <div class="action-item priority-high">
                <div class="action-priority">HIGH</div>
                <div class="action-content">
                  <h6>Address Negative Feedback</h6>
                  <p>Respond to 12 unresolved negative reviews</p>
                  <button class="btn btn-sm btn-outline-primary">Take Action</button>
                </div>
              </div>
              
              <div class="action-item priority-medium">
                <div class="action-priority">MEDIUM</div>
                <div class="action-content">
                  <h6>Improve Service Response Time</h6>
                  <p>Current average exceeds target by 2 hours</p>
                  <button class="btn btn-sm btn-outline-primary">View Details</button>
                </div>
              </div>
              
              <div class="action-item priority-low">
                <div class="action-priority">LOW</div>
                <div class="action-content">
                  <h6>Update Product Information</h6>
                  <p>3 products have outdated specifications</p>
                  <button class="btn btn-sm btn-outline-primary">Update</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Export Options -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0">
      <h5 class="mb-0">Export Options</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-3 mb-3">
          <div class="d-grid">
            <button class="btn btn-outline-primary" onclick="exportFormat('pdf')">
              <i class="bi bi-file-earmark-pdf me-2"></i>Export as PDF
            </button>
          </div>
        </div>
        <div class="col-md-3 mb-3">
          <div class="d-grid">
            <button class="btn btn-outline-success" onclick="exportFormat('excel')">
              <i class="bi bi-file-earmark-excel me-2"></i>Export as Excel
            </button>
          </div>
        </div>
        <div class="col-md-3 mb-3">
          <div class="d-grid">
            <button class="btn btn-outline-info" onclick="exportFormat('csv')">
              <i class="bi bi-file-earmark-csv me-2"></i>Export as CSV
            </button>
          </div>
        </div>
        <div class="col-md-3 mb-3">
          <div class="d-grid">
            <button class="btn btn-outline-warning" onclick="exportFormat('json')">
              <i class="bi bi-file-earmark-code me-2"></i>Export as JSON
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Styles -->
<style>
  .insights-list {
    max-height: 300px;
    overflow-y: auto;
  }
  .sentiment-summary {
    padding: 1rem;
    background: #f8f9fa;
    border-radius: 0.5rem;
  }
  .trend-indicator {
    font-size: 0.875rem;
  }
  .trend-up {
    color: #198754;
  }
  .trend-down {
    color: #dc3545;
  }
  .trend-stable {
    color: #6c757d;
  }

  /* Enhanced Sentiment Analysis Styles */
  .sentiment-score-display {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 2rem;
    border-radius: 1rem;
    margin-bottom: 1.5rem;
  }
  .score-value {
    font-size: 3rem;
