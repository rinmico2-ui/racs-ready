          <div style="width:1px;background:#e2e8f0;margin:4px 0;"></div>
          <div style="flex:1;min-width:0;padding:4px 6px;">
            <div style="font-size:0.55rem;font-weight:700;text-transform:uppercase;letter-spacing:0.4px;color:#94a3b8;margin-bottom:0;"><i class="bi bi-tools me-1"></i>Technician</div>
            <div id="routeMapModalTechnician" style="font-size:0.8rem;font-weight:700;color:#1e293b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">—</div>
