              <div class="mw-hero-stat-value" id="heroProfit" style="color:#10b981;">₱0</div>
              <div class="mw-hero-stat-label">Gross Profit</div>
            </div>
          </div>
          <div class="mw-hero-clock" id="currentDateTime">
            <i class="bi bi-clock"></i>
            <span>--:--</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Enterprise Filter Bar -->
    <div class="mw-filter-bar mw-animate-fade-in">
      <div class="mw-search">
