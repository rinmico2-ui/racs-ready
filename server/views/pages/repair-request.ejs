          <h6>Unit Specifications</h6>
          <p>Basic identifiers to help the technician prepare.</p>
        </div>
      </div>
      <div class='row g-3'>
        <div class='col-md-6'>
          <label class='form-label' for='unitBrand'><i class='bi bi-award me-2 text-primary'></i>Brand <span class='text-danger'>*</span></label>
          <input type='text' class='form-control' id='unitBrand' placeholder='e.g. Carrier, Samsung, LG' required />
        </div>
        <div class='col-md-6'>
          <label class='form-label' for='unitModel'><i class='bi bi-upc me-2 text-primary'></i>Model Number <span class='text-muted fw-normal'>(optional)</span></label>
          <input type='text' class='form-control' id='unitModel' placeholder='e.g. 42KDPV48' />
        </div>
        <div class='col-md-6'>
          <label class='form-label' for='unitQuantity'><i class='bi bi-stack me-2 text-primary'></i>Number of Units <span class='text-muted fw-normal'>(optional)</span></label>
          <div class='input-group quantity-stepper'>
            <button class='btn btn-outline-secondary' type='button' id='repairQtyMinus'>−</button>
            <input type='number' class='form-control text-center' id='unitQuantity' value='1' min='1' max='999' />
            <button class='btn btn-outline-secondary' type='button' id='repairQtyPlus'>+</button>
          </div>
