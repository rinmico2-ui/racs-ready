      paymentRows += '<div class="dv2-payment-row"><span class="dv2-payment-label">Downpayment '+(b.paymentStatus==='pending'?'Submitted':'Received')+'</span><span class="dv2-payment-value">\u20B1'+dp.toLocaleString()+'</span></div>'+
        '<div class="dv2-payment-row"><span class="dv2-payment-label">Balance '+(b.paymentStatus==='pending'?'after verification ':'')+'(on-site)</span><span class="dv2-payment-value">\u20B1'+bal.toLocaleString()+'</span></div>';
      if (b.amountPaid) paymentRows += '<div class="dv2-payment-row"><span class="dv2-payment-label">Collected so far</span><span class="dv2-payment-value" style="color:#16a34a;">\u20B1'+b.amountPaid.toLocaleString()+'</span></div>';
    }
    paymentRows += '<div class="dv2-payment-row"><span class="dv2-payment-label">Payment Status</span><span class="dv2-payment-value" style="color:'+(b.paymentStatus==='paid'?'#16a34a':(b.paymentStatus==='partial'?'#d97706':'#64748b'))+';">'+(b.paymentStatus==='paid'?'Paid in full':(b.paymentStatus==='partial'?'Partial payment received':'Payment pending'))+'</span></div>';

    var photosHtml = '';
    if (photos.length>0) {
      window._modalPhotos=photos;
      photosHtml = '<div class="dv2-card dv2-card-wide">'+
        '<div class="dv2-card-icon bg-success-subtle"><i class="bi bi-images text-success"></i></div>'+
        '<div class="dv2-card-content" style="width:100%;">'+
          '<span class="dv2-label">Photos & Proofs ('+photos.length+')</span>'+
          '<div class="dv2-photo-strip">';
      photos.forEach(function(item,i){
        photosHtml += '<div class="dv2-photo-item" style="width:160px;">'+
          '<img src="'+item.src+'" alt="'+((item.label||'Photo')+' '+(i+1))+' - Click to enlarge" class="dv2-photo-thumb" onclick="showImgLightboxIndex('+i+')" onerror="this.style.display=\'none\';this.parentElement.querySelector(\'.dv2-photo-missing\').style.display=\'flex\';">'+
          '<div class="dv2-photo-missing" style="display:none;height:100px;align-items:center;justify-content:center;flex-direction:column;color:#94a3b8;font-size:0.7rem;background:#f8fafc;border:1px dashed #e2e8f0;border-radius:8px;"><i class="bi bi-image" style="font-size:1.2rem;margin-bottom:4px;"></i>Image unavailable</div>'+
          '<div class="dv2-photo-caption">'+(item.label?item.label+' \u00B7 ':'')+'Click to enlarge</div>'+
        '</div>';
      });
      photosHtml += '</div></div></div>';
    }

    // ── Detect mixed service booking (both core & repair) ──
    var hasCore=false, hasRepair=false;
    if (Array.isArray(b.services)) {
      b.services.forEach(function(s){
        if (s.type==='repair') hasRepair=true; else hasCore=true;
      });
    }
    var isMixed = (b.isMultiService || b.serviceType==='mixed') && hasCore && hasRepair;

    function effectiveItemStatus(s) {
      var own=String(s.status||'pending');
      if (own!=='pending') return own;
      if (data.assignment&&data.assignment.status==='pending_acceptance') return 'assigned';
      if (data.assignment&&data.assignment.status==='accepted') return isRepair?'inspection_scheduled':'accepted';
      if (['assigned','confirmed','scheduled','on-the-way','arrived','in-progress','completed'].indexOf(b.status)>=0) return b.status;
      return own;
    }

    function buildServiceItemHTML(s,i){
      var t=s.applianceTypeName||s.airconTypeName||s.applianceType||s.airconType||'\u2014';
      var bnd=s.brand||'\u2014';
      var q=Number(s.quantity)||1;
      var h=s.hpDescription||(s.hp?s.hp+' HP':'\u2014');
      var sn=s.name||('Service '+(i+1));
      var model=s.model||'\u2014';
      var issue=s.problemDescription||s.repairIssue||s.issueDescription||'';
      var itemStatus=effectiveItemStatus(s);
      var stBadge=itemStatus==='completed'?'background:#dcfce7;color:#166534;':s.type==='repair'?'background:#fef3c7;color:#92400e;':'background:#dbeafe;color:#1e40af;';
      var sIcon=s.type==='repair'?'bi-wrench-adjustable':'bi-gear-wide-connected';
      var item='<div class="ms-service-item">'+
        '<div class="ms-service-head">'+
          '<div class="ms-service-name"><i class="bi '+sIcon+'"></i>'+sn+'</div>'+
          '<span class="ms-service-status" style="'+stBadge+'">'+statusLabel(itemStatus)+'</span>'+
        '</div>'+
        '<div class="ms-service-grid">'+
          '<div class="ms-meta-item"><span class="ms-meta-label">Type</span><span class="ms-meta-value">'+t+'</span></div>'+
          '<div class="ms-meta-item"><span class="ms-meta-label">Brand</span><span class="ms-meta-value">'+bnd+'</span></div>'+
          '<div class="ms-meta-item"><span class="ms-meta-label">Model</span><span class="ms-meta-value">'+model+'</span></div>'+
          '<div class="ms-meta-item"><span class="ms-meta-label">HP / Qty</span><span class="ms-meta-value">'+h+' / '+q+'</span></div>'+
        '</div>';
      if (issue) item+='<div class="ms-service-issue"><strong>Problem:</strong> '+issue+'</div>';
      var pricingParts='';
      if (s.unitPrice!=null) pricingParts+='<div class="ms-price-item"><span class="ms-price-label">Unit Price</span><span class="ms-price-value">\u20B1'+Number(s.unitPrice).toLocaleString()+'</span></div>';
      if (s.totalPrice!=null) pricingParts+='<div class="ms-price-item"><span class="ms-price-label">Total Price</span><span class="ms-price-value accent">\u20B1'+Number(s.totalPrice).toLocaleString()+'</span></div>';
      if (s.initialCost!=null) pricingParts+='<div class="ms-price-item"><span class="ms-price-label">Initial Cost</span><span class="ms-price-value">\u20B1'+Number(s.initialCost).toLocaleString()+'</span></div>';
      if (s.finalCost!=null) pricingParts+='<div class="ms-price-item"><span class="ms-price-label">Final Cost</span><span class="ms-price-value accent">\u20B1'+Number(s.finalCost).toLocaleString()+'</span></div>';
      if (s.duration) pricingParts+='<div class="ms-price-item"><span class="ms-price-label">Est. Duration</span><span class="ms-price-value">'+s.duration+' min</span></div>';
      if (pricingParts) item+='<div class="ms-service-pricing">'+pricingParts+'</div>';
      if (s.technicianName) item+='<div class="ms-service-tech"><i class="bi bi-person-fill"></i>Assigned: '+s.technicianName+'</div>';
      item+='</div>';
      return item;
    }

    function buildServiceSectionHTML(services,type){
      var icon=type==='repair'?'bi-wrench-adjustable-circle':'bi-gear-wide-connected';
      var title=type==='repair'?'Repair Services':'Core Services';
      var items=services.map(function(s,i){return buildServiceItemHTML(s,i);}).join('');
      var subtotal=services.reduce(function(sum,s){return sum+(Number(s.totalPrice)||Number(s.unitPrice)||0)*(Number(s.quantity)||1);},0);
      return '<div class="ms-section ms-section-'+(type==='repair'?'repair':'core')+'">'+
        '<div class="ms-section-header ms-section-header-'+(type==='repair'?'repair':'core')+'">'+
          '<i class="bi '+icon+'"></i>'+title+
          '<span class="ms-section-count">'+services.length+' service'+(services.length>1?'s':'')+'</span>'+
        '</div>'+
        '<div class="ms-section-body">'+items+'</div>'+
        '<div class="ms-section-subtotal">'+
          '<span class="ms-section-subtotal-label">Subtotal</span>'+
          '<span class="ms-section-subtotal-value">\u20B1'+subtotal.toLocaleString()+'</span>'+
        '</div>'+
      '</div>';
    }

    var unitDetailsHtml='';
    if (isMixed && Array.isArray(b.services) && b.services.length) {
      var coreServices=b.services.filter(function(s){return s.type!=='repair';});
      var repairServices=b.services.filter(function(s){return s.type==='repair';});
      var coreSubtotal=coreServices.reduce(function(sum,s){return sum+(Number(s.totalPrice)||Number(s.unitPrice)||0)*(Number(s.quantity)||1);},0);
      var repairSubtotal=repairServices.reduce(function(sum,s){return sum+(Number(s.totalPrice)||Number(s.unitPrice)||0)*(Number(s.quantity)||1);},0);
      var totalUnits=coreServices.reduce(function(sum,s){return sum+(Number(s.quantity)||1);},0)+repairServices.reduce(function(sum,s){return sum+(Number(s.quantity)||1);},0);

      unitDetailsHtml='<div class="dv2-card dv2-card-wide">'+
        '<div class="dv2-card-icon bg-info-subtle"><i class="bi bi-diagram-3 text-info"></i></div>'+
        '<div class="dv2-card-content" style="width:100%;">'+
          '<span class="dv2-label">Service Breakdown \u00B7 Mixed Booking ('+b.services.length+' services, '+totalUnits+' units)</span>'+
          '<div class="ms-wrap" style="margin-top:10px;">';
      if (coreServices.length) unitDetailsHtml+=buildServiceSectionHTML(coreServices,'core');
      if (repairServices.length) unitDetailsHtml+=buildServiceSectionHTML(repairServices,'repair');
      unitDetailsHtml+='<div class="ms-summary-bar">'+
          '<div class="ms-summary-cell"><div class="ms-summary-label">Core Subtotal</div><div class="ms-summary-value">\u20B1'+coreSubtotal.toLocaleString()+'</div></div>'+
          '<div class="ms-summary-cell"><div class="ms-summary-label">Repair Subtotal</div><div class="ms-summary-value">\u20B1'+repairSubtotal.toLocaleString()+'</div></div>'+
          '<div class="ms-summary-cell"><div class="ms-summary-label">Grand Total</div><div class="ms-summary-value" style="color:#059669;">\u20B1'+(coreSubtotal+repairSubtotal).toLocaleString()+'</div></div>'+
        '</div>'+
      '</div></div></div>';
    } else {
      var unitRows='';
      if (Array.isArray(b.services) && b.services.length) {
        b.services.forEach(function(s,i){
          var t=s.applianceTypeName||s.airconTypeName||s.applianceType||s.airconType||'\u2014';
          var bnd=s.brand||'\u2014';
          var q=Number(s.quantity)||1;
          var h=s.hpDescription||(s.hp?s.hp+' HP':'\u2014');
          var sn=s.name||('Service '+(i+1));
          var model=s.model||'\u2014';
          var issue=s.problemDescription||s.repairIssue||s.issueDescription||'';
          var itemStatus=effectiveItemStatus(s);
          var stBadge=itemStatus==='completed'?'background:#dcfce7;color:#166534;':s.type==='repair'?'background:#fef3c7;color:#92400e;':'background:#dbeafe;color:#1e40af;';
          unitRows+='<div style="padding:12px 0;border-bottom:1px solid rgba(226,232,240,0.5);">'+
            '<div style="display:flex;align-items:center;justify-content:space-between;">'+
              '<div style="font-weight:600;font-size:0.82rem;color:#1e293b;">'+sn+'</div>'+
              '<span style="'+stBadge+'padding:3px 8px;border-radius:6px;font-size:0.65rem;font-weight:600;">'+statusLabel(itemStatus)+'</span>'+
            '</div>'+
            '<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:6px;margin-top:8px;">'+
              '<div><span style="font-size:0.65rem;color:#64748b;">Type</span><div style="font-size:0.78rem;color:#334155;font-weight:500;">'+t+'</div></div>'+
              '<div><span style="font-size:0.65rem;color:#64748b;">Brand</span><div style="font-size:0.78rem;color:#334155;font-weight:500;">'+bnd+'</div></div>'+
              '<div><span style="font-size:0.65rem;color:#64748b;">Model</span><div style="font-size:0.78rem;color:#334155;font-weight:500;">'+model+'</div></div>'+
              '<div><span style="font-size:0.65rem;color:#64748b;">HP / Qty</span><div style="font-size:0.78rem;color:#334155;font-weight:500;">'+h+' / '+q+'</div></div>'+
            '</div>'+
            (issue?'<div style="margin-top:6px;"><span style="font-size:0.65rem;color:#64748b;">Problem</span><div style="font-size:0.75rem;color:#475569;line-height:1.4;">'+issue+'</div></div>':'')+
          '</div>';
        });
      } else {
        unitRows='<div style="margin-top:6px;display:grid;grid-template-columns:repeat(2,1fr);gap:8px;">'+
          '<div><span class="dv2-sub" style="font-size:0.65rem;color:#64748b;">Type</span><div class="dv2-value" style="font-size:0.8rem;">'+unitType+'</div></div>'+
          '<div><span class="dv2-sub" style="font-size:0.65rem;color:#64748b;">Brand</span><div class="dv2-value" style="font-size:0.8rem;">'+unitBrand+'</div></div>'+
          '<div><span class="dv2-sub" style="font-size:0.65rem;color:#64748b;">Quantity</span><div class="dv2-value" style="font-size:0.8rem;">'+unitQty+'</div></div>'+
          '<div><span class="dv2-sub" style="font-size:0.65rem;color:#64748b;">HP Rating</span><div class="dv2-value" style="font-size:0.8rem;">'+unitHp+'</div></div>'+
        '</div>';
      }
      unitDetailsHtml='<div class="dv2-card dv2-card-wide">'+
        '<div class="dv2-card-icon bg-info-subtle"><i class="bi bi-box-seam text-info"></i></div>'+
        '<div class="dv2-card-content" style="width:100%;">'+
          '<span class="dv2-label">Unit Details'+((Array.isArray(b.services)&&b.services.length>1)?(' ('+b.services.length+' items)'):'')+'</span>'+
          unitRows+
        '</div>'+
      '</div>';
    }

    var html='<div class="dv2-wrap">'+overdueReviewHtml+
      '<div class="dv2-hero" style="border-left:4px solid '+heroColor+';">'+
        '<div class="dv2-hero-main">'+
          '<div class="dv2-hero-icon" style="background:'+heroBg+';color:'+heroColor+';"><i class="bi bi-file-earmark-text"></i></div>'+
          '<div>'+
            '<div class="dv2-hero-ref">Booking Reference</div>'+
            '<div class="dv2-hero-title">#'+ref+'</div>'+
            '<div class="dv2-hero-sub">'+serviceName+' &nbsp;\u00B7&nbsp; '+date+(time?' &nbsp;\u00B7&nbsp; '+time:'')+'</div>'+
          '</div>'+
        '</div>'+
        '<div class="dv2-hero-side">'+
          '<div class="dv2-hero-amount">\u20B1'+total.toLocaleString()+'</div>'+
          '<span class="badge bg-'+statusColor+'" style="font-size:0.7rem;padding:6px 10px;">'+displayedStatus+'</span>'+
        '</div>'+
      '</div>'+
      '<div class="dv2-grid">'+
        '<div class="dv2-card">'+
          '<div class="dv2-card-icon bg-primary-subtle"><i class="bi bi-person-fill text-primary"></i></div>'+
          '<div class="dv2-card-content">'+
            '<span class="dv2-label">Customer</span>'+
            '<div class="dv2-value">'+(customer.name||'N/A')+'</div>'+
            '<span class="dv2-sub">'+(customer.email||'')+'</span>'+
            '<span class="dv2-sub">'+(customer.phone||'')+'</span>'+
          '</div>'+
        '</div>'+
        '<div class="dv2-card">'+
          '<div class="dv2-card-icon bg-success-subtle"><i class="bi bi-tools text-success"></i></div>'+
          '<div class="dv2-card-content">'+
            '<span class="dv2-label">Service & Schedule</span>'+
            '<div class="dv2-value">'+serviceName+'</div>'+
            '<span class="dv2-sub">'+date+'</span>'+
            '<span class="dv2-sub">'+(time||'No time set')+'</span>'+
          '</div>'+
        '</div>'+
        unitDetailsHtml+
        ((b.technicianId||b.technician||data.assignment)?'<div class="dv2-card dv2-card-wide">'+
          '<div class="dv2-card-icon bg-primary-subtle"><i class="bi bi-person-badge text-primary"></i></div>'+
          '<div class="dv2-card-content">'+
            '<span class="dv2-label">'+(data.assignment?'Technician Assignment':'Selected Technician')+'</span>'+
            '<div class="dv2-value">'+((b.technicianId&&b.technicianId.name)||(b.technician&&b.technician.name)||(data.assignment&&data.assignment.technicianId&&data.assignment.technicianId.name)||'Assigned technician')+'</div>'+
            '<span class="dv2-sub">'+(data.assignment?'Assignment: '+statusLabel(data.assignment.status):'No assignment has been dispatched yet')+'</span>'+
            (data.assignment&&data.assignment.acceptanceDeadline&&data.assignment.status==='pending_acceptance'?'<span class="dv2-sub">Accept by '+new Date(data.assignment.acceptanceDeadline).toLocaleString('en-PH',{month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit'})+'</span>':'')+
          '</div></div>':'')+
        '<div class="dv2-card dv2-card-wide">'+
          '<div class="dv2-card-icon bg-warning-subtle"><i class="bi bi-cash-stack text-warning"></i></div>'+
          '<div class="dv2-card-content" style="width:100%;">'+
            '<span class="dv2-label">Payment Breakdown</span>'+
            '<div style="margin-top:6px;">'+paymentRows+'</div>'+
          '</div>'+
        '</div>'+
        '<div class="dv2-card dv2-card-wide">'+
          '<div class="dv2-card-icon bg-secondary-subtle"><i class="bi bi-geo-alt-fill text-secondary"></i></div>'+
          '<div class="dv2-card-content">'+
            '<span class="dv2-label">Service Location</span>'+
            '<div class="dv2-value">'+(b.location?b.location.address:'N/A')+'</div>'+
          '</div>'+
        '</div>';
    if (isRepair&&b.unitInfo) {
      html+='<div class="dv2-card dv2-card-wide">'+
        '<div class="dv2-card-icon bg-info-subtle"><i class="bi bi-wrench text-info"></i></div>'+
        '<div class="dv2-card-content">'+
          '<span class="dv2-label">Unit Information</span>'+
          '<div class="dv2-value">'+(b.unitInfo.unitType||'')+' '+(b.unitInfo.brand||'')+' '+(b.unitInfo.model||'')+'</div>'+
          (b.unitInfo.problemDescription?'<span class="dv2-sub">'+b.unitInfo.problemDescription+'</span>':'')+
        '</div>'+
      '</div>';
    }
    if (b.issueDescription) {
      html+='<div class="dv2-card dv2-card-wide">'+
        '<div class="dv2-card-icon bg-danger-subtle"><i class="bi bi-exclamation-triangle text-danger"></i></div>'+
        '<div class="dv2-card-content">'+
          '<span class="dv2-label">Issue Description</span>'+
          '<div class="dv2-value">'+b.issueDescription+'</div>'+
        '</div>'+
      '</div>';
    }
    if (isRepair && data.reservedParts && data.reservedParts.length) {
      var reservedPartsHtml = '<div class="dv2-card dv2-card-wide">'+
        '<div class="dv2-card-icon bg-info-subtle"><i class="bi bi-box-seam text-info"></i></div>'+
        '<div class="dv2-card-content" style="width:100%;">'+
          '<span class="dv2-label">Reserved Parts</span>'+
          '<div style="margin-top:6px;display:flex;flex-direction:column;gap:6px;">';
      data.reservedParts.forEach(function(p){
        reservedPartsHtml += '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid rgba(226,232,240,0.5);">'+
          '<div style="font-size:0.8rem;font-weight:600;">'+(p.itemName || (p.toolId && p.toolId.itemName) || 'Part')+'</div>'+
          '<div style="font-size:0.75rem;color:#475569;">Qty '+(p.quantity || 1)+' · '+(p.status || 'reserved').replace(/_/g,' ')+'</div>'+
        '</div>';
      });
      reservedPartsHtml += '</div></div></div>';
      html += reservedPartsHtml;
    }

    // ── AUDIT TRAIL (statusHistory timeline) ──
    if (b.statusHistory && b.statusHistory.length) {
      var histSorted = b.statusHistory.slice().sort(function(x,y){
        return new Date(x.timestamp||0)-new Date(y.timestamp||0);
      });
      var histItems = histSorted.map(function(h,i){
        var isLast = i===histSorted.length-1;
        var actor = h.changedByName || (h.changedBy && typeof h.changedBy==='object' && h.changedBy.name) || (h.changedByModel || 'System');
        var when = h.timestamp ? new Date(h.timestamp).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '';
        var note = h.notes || h.reason || '';
        var meta = h.metadata && h.metadata.type ? ' <span class="at-actor"><i class="bi bi-tag"></i>'+String(h.metadata.type).replace(/_/g,' ')+'</span>' : '';
        return '<div class="at-item'+(isLast?' current':'')+'">'+
          '<div class="at-dot"></div>'+
          '<div class="at-head">'+
            '<span class="at-status">'+statusLabel(h.toStatus)+'</span>'+
            (h.fromStatus?'<span class="at-arrow"><i class="bi bi-arrow-right"></i></span><span class="at-prev">'+statusLabel(h.fromStatus)+'</span>':'')+
          '</div>'+
          (when?'<div class="at-meta">'+when+'</div>':'')+
          '<div class="at-meta" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:4px;">'+
            (actor?'<span class="at-actor"><i class="bi bi-person-fill"></i>'+actor+'</span>':'')+meta+
          '</div>'+
          (note?'<div class="at-note"><i class="bi bi-chat-left-text me-1"></i>'+note+'</div>':'')+
        '</div>';
      }).join('');
      html += '<div class="dv2-card dv2-card-wide">'+
        '<div class="dv2-card-icon" style="background:#f3e8ff;color:#7c3aed;"><i class="bi bi-clock-history"></i></div>'+
        '<div class="dv2-card-content" style="width:100%;">'+
          '<span class="dv2-label">Audit Trail · Status History</span>'+
          '<div class="at-wrap">'+histItems+'</div>'+
        '</div>'+
      '</div>';
    }

    // ── TECHNICIAN INSPECTION & DIAGNOSIS ──
    var insp = b.inspection || {};
    var diag = b.diagnosis || {};
    if (insp.findings || insp.severity || insp.recommendedAction || (insp.damagedParts && insp.damagedParts.length) || diag.diagnosisSummary || (diag.confirmedDiagnoses && diag.confirmedDiagnoses.length)) {
      var sevBg='#f1f5f9', sevColor='#475569';
      if (insp.severity==='critical'){sevBg='#fee2e2';sevColor='#b91c1c';}
      else if (insp.severity==='major'){sevBg='#fef3c7';sevColor='#92400e';}
      else if (insp.severity==='minor'){sevBg='#dbeafe';sevColor='#1e40af';}
      var inspKv = '';
      if (insp.severity) inspKv += '<div class="wf-kv-item"><span class="wf-kv-label">Severity</span><span class="wf-kv-value"><span class="wf-chip" style="background:'+sevBg+';color:'+sevColor+';">'+statusLabel(insp.severity)+'</span></span></div>';
      if (insp.completedAt) inspKv += '<div class="wf-kv-item"><span class="wf-kv-label">Inspected At</span><span class="wf-kv-value">'+new Date(insp.completedAt).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'})+'</span></div>';
      if (diag.laborCost != null) inspKv += '<div class="wf-kv-item"><span class="wf-kv-label">Labor Cost</span><span class="wf-kv-value">₱'+Number(diag.laborCost).toLocaleString()+'</span></div>';
      if (diag.laborDuration) inspKv += '<div class="wf-kv-item"><span class="wf-kv-label">Labor Duration</span><span class="wf-kv-value">'+diag.laborDuration+'</span></div>';
      if (inspKv) inspKv = '<div class="wf-kv">'+inspKv+'</div>';
      var inspDamaged = (insp.damagedParts && insp.damagedParts.length)? insp.damagedParts.map(function(p){return '<span class="wf-chip" style="background:#fee2e2;color:#b91c1c;"><i class="bi bi-bug-fill"></i>'+p+'</span>';}).join(' '):'';
      var inspDiagChips = (diag.confirmedDiagnoses && diag.confirmedDiagnoses.length)? diag.confirmedDiagnoses.map(function(d){return '<span class="wf-chip" style="background:#eff6ff;color:#1d4ed8;"><i class="bi bi-check2-circle"></i>'+d+'</span>';}).join(' '):'';
      html += '<div class="dv2-card dv2-card-wide">'+
        '<div class="dv2-card-icon bg-primary-subtle"><i class="bi bi-search-heart text-primary"></i></div>'+
        '<div class="dv2-card-content" style="width:100%;">'+
          '<span class="dv2-label">Technician Inspection & Diagnosis</span>'+
          (insp.findings?'<div class="dv2-value" style="margin-top:4px;">'+insp.findings+'</div>':'')+
          (diag.diagnosisSummary?'<span class="dv2-sub" style="margin-top:4px;"><strong>Diagnosis:</strong> '+diag.diagnosisSummary+'</span>':'')+
          (inspDamaged?'<div class="wf-list" style="flex-direction:row;flex-wrap:wrap;gap:6px;">'+inspDamaged+'</div>':'')+
          (inspDiagChips?'<div class="wf-list" style="flex-direction:row;flex-wrap:wrap;gap:6px;">'+inspDiagChips+'</div>':'')+
          (insp.recommendedAction?'<div class="wf-note-box"><i class="bi bi-lightbulb me-1"></i><strong>Recommended Action:</strong> '+insp.recommendedAction+'</div>':'')+
          (inspKv||'')+
        '</div>'+
      '</div>';
    }

    // ── QUOTATION ──
    var quot = b.quotation || {};
    if (quot.totalCost != null || (quot.parts && quot.parts.length) || quot.laborCost != null || quot.notes) {
      var quotRows = '';
      (quot.parts || []).forEach(function(p){
        var q=Number(p.quantity)||1, c=Number(p.cost)||0;
        quotRows += '<div class="wf-list-row"><div><span class="wfl-name">'+(p.name||'Part')+'</span> <span class="wfl-meta">× '+q+'</span></div><div class="wfl-meta" style="font-weight:600;">₱'+(c*q).toLocaleString()+'</div></div>';
      });
      if (quot.laborCost != null) quotRows += '<div class="wf-list-row"><span class="wfl-name">Labor</span><span class="wfl-meta" style="font-weight:600;">₱'+Number(quot.laborCost).toLocaleString()+'</span></div>';
      if (quotRows) quotRows = '<div class="wf-list">'+quotRows+'</div>';
      html += '<div class="dv2-card dv2-card-wide">'+
        '<div class="dv2-card-icon" style="background:#f3e8ff;color:#7c3aed;"><i class="bi bi-receipt-cutoff"></i></div>'+
        '<div class="dv2-card-content" style="width:100%;">'+
          '<span class="dv2-label">Quotation</span>'+
          (quot.totalCost!=null?'<div class="dv2-value" style="color:#7c3aed;">₱'+Number(quot.totalCost).toLocaleString()+'</div>':'')+
          (quotRows||'')+
          (quot.notes?'<div class="wf-note-box" style="background:#f5f3ff;border-color:#ddd6fe;color:#5b21b6;"><i class="bi bi-chat-left-quote me-1"></i>'+quot.notes+'</div>':'')+
        '</div>'+
      '</div>';
    }

    // ── REPAIR COMPLETION / WORK LOG ──
    var rc = b.repairCompletion || {};
    if ((rc.partsInstalled && rc.partsInstalled.length) || (rc.actionsPerformed && rc.actionsPerformed.length) || rc.completionNotes) {
      var rcRows = '';
      (rc.partsInstalled || []).forEach(function(p){
        rcRows += '<div class="wf-list-row"><div><span class="wfl-name">'+(p.name||'Part')+'</span> <span class="wfl-meta">× '+(Number(p.quantity)||1)+'</span></div><span class="wfl-meta">Installed</span></div>';
      });
      if (rcRows) rcRows = '<div class="wf-list">'+rcRows+'</div>';
      var rcActions = (rc.actionsPerformed && rc.actionsPerformed.length)? rc.actionsPerformed.map(function(a){return '<span class="wf-chip" style="background:#ecfdf5;color:#047857;"><i class="bi bi-wrench-adjustable"></i>'+a+'</span>';}).join(' '):'';
      html += '<div class="dv2-card dv2-card-wide">'+
        '<div class="dv2-card-icon bg-success-subtle"><i class="bi bi-clipboard-check text-success"></i></div>'+
        '<div class="dv2-card-content" style="width:100%;">'+
          '<span class="dv2-label">Work Performed & Completion</span>'+
          (rc.completedAt?'<span class="dv2-sub">Completed '+(rc.completedAt?new Date(rc.completedAt).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}):'')+'</span>':'')+
          (rcRows||'')+
          (rcActions?'<div class="wf-list" style="flex-direction:row;flex-wrap:wrap;gap:6px;">'+rcActions+'</div>':'')+
          (rc.completionNotes?'<div class="wf-note-box" style="background:#f0fdf4;border-color:#bbf7d0;color:#166534;"><i class="bi bi-chat-left-text me-1"></i>'+rc.completionNotes+'</div>':'')+
        '</div>'+
      '</div>';
    }

    // ── PAYMENT COLLECTION LEDGER (inspection fee / repair payment) ──
    var payLedgerRows = '';
    function fmtMoney(n){ return n==null?'—':'₱'+Number(n).toLocaleString(); }
    function fmtDT(d){ return d? new Date(d).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}):'—'; }
    if (!paymentList.some(function(pm){return pm.type==='inspection';}) && (b.inspectionFeeCollected || b.inspectionFeeTotalCollected || b.inspectionFeeAmount)) {
      payLedgerRows += '<div class="wf-list-row"><div><span class="wfl-name">Inspection Fee'+(b.inspectionFeeMethod?' · '+String(b.inspectionFeeMethod).toUpperCase():'')+'</span><span class="wfl-meta">'+fmtDT(b.inspectionFeeCollectedAt)+'</span></div><span class="wfl-meta" style="font-weight:700;">'+fmtMoney(b.inspectionFeeTotalCollected||b.inspectionFeeAmount)+'</span></div>';
    }
    if (!paymentList.some(function(pm){return pm.type==='final';}) && (b.repairPaymentCollected || b.repairPaymentAmount)) {
      payLedgerRows += '<div class="wf-list-row"><div><span class="wfl-name">Repair Payment'+(b.repairPaymentMethod?' · '+String(b.repairPaymentMethod).toUpperCase():'')+'</span><span class="wfl-meta">'+fmtDT(b.repairPaymentCollectedAt)+'</span></div><span class="wfl-meta" style="font-weight:700;">'+fmtMoney(b.repairPaymentAmount)+'</span></div>';
    }
    paymentList.forEach(function(pm){
      var typeLabel=pm.type==='downpayment'?'Downpayment':pm.type==='inspection'?'Inspection Fee':pm.type==='final'?'Final Payment':'Payment Adjustment';
      var paidAt=pm.collectedAt||pm.completedAt||pm.verifiedAt||pm.submittedAt;
      payLedgerRows += '<div class="wf-list-row"><div><span class="wfl-name">'+typeLabel+(pm.method?' · '+String(pm.method).toUpperCase():'')+'</span><span class="wfl-meta">'+fmtDT(paidAt)+' · '+statusLabel(pm.status)+'</span>'+(pm.reference?'<span class="wfl-meta">Reference: '+pm.reference+'</span>':'')+'</div><span class="wfl-meta" style="font-weight:700;">'+fmtMoney(pm.amount)+'</span></div>';
    });
    if (!paymentList.length && b.downpaymentAmount && b.downpaymentAmount>0) {
      payLedgerRows += '<div class="wf-list-row"><div><span class="wfl-name">Downpayment'+(b.paymentMethod?' · '+String(b.paymentMethod).toUpperCase():'')+'</span><span class="wfl-meta">'+fmtDT(b.createdAt)+'</span></div><span class="wfl-meta" style="font-weight:700;">'+fmtMoney(b.downpaymentAmount)+'</span></div>';
    }
    if (payLedgerRows) {
      html += '<div class="dv2-card dv2-card-wide">'+
        '<div class="dv2-card-icon bg-success-subtle"><i class="bi bi-cash-coin text-success"></i></div>'+
        '<div class="dv2-card-content" style="width:100%;">'+
          '<span class="dv2-label">Payment Collection Ledger</span>'+
          '<div class="wf-list">'+payLedgerRows+'</div>'+
          (!paymentList.length&&b.paymentReference?'<span class="dv2-sub" style="margin-top:8px;"><strong>Reference:</strong> '+b.paymentReference+'</span>':'')+
          (b.gcashNumber?'<span class="dv2-sub"><strong>GCash:</strong> '+b.gcashNumber+'</span>':'')+
        '</div>'+
      '</div>';
    }

    html += photosHtml;
    html += '</div></div>';
    return html;
  }

  window.showImgLightbox=function(src){
    var overlay=document.createElement('div');
    overlay.className='bd-lightbox-overlay';
    overlay.style.zIndex='999999';
    overlay.innerHTML='<div class="bd-lightbox-content"><button class="bd-lightbox-close">&times;</button><img src="'+src+'" alt="Enlarged" onerror="this.parentElement.innerHTML=\'Image unavailable\'"></div>';
    overlay.addEventListener('click',function(e){ if(e.target===overlay){ overlay.remove(); } });
    overlay.querySelector('.bd-lightbox-close').addEventListener('click',function(){ overlay.remove(); });
    document.body.appendChild(overlay);
  };

  window.showImgLightboxIndex=function(idx){
    var photos=window._modalPhotos||[];
    if (!photos[idx]) return;
    showImgLightbox(photos[idx].src);
  };

  var loaded={overview:false,pending:false,queue:false,waiting:false,active:false,completed:false};
  function switchTab(name){
    var p=new URLSearchParams(window.location.search);p.set('tab',name);
    history.replaceState(null,'',window.location.pathname+'?'+p.toString());
    loaded[name]=true;
    loadTab(name);
  }
  function loadTab(tab){
    switch(tab){
      case'overview':AU.Overview.load();break;
      case'pending':AU.Pending.load();break;
      case'queue':AU.Queue.loadStats();AU.Queue.loadWarnings();AU.Queue.loadQueue(1);break;
      case'waiting':loadWaitingAcceptTab();break;
      case'active':AU.Active.load();break;
      case'completed':AU.Completed.load();break;
    }
  }

  function loadBookingResolutionCount(){
    var badge=document.getElementById('bookingResolutionCount');
    if(!badge)return;
    fetch('/api/admin/resolution-center?source=booking&page=1&perPage=1')
      .then(function(r){if(!r.ok)throw new Error('Resolution count unavailable');return r.json();})
      .then(function(data){
        var count=Number(data&&data.summary&&data.summary.bySource&&data.summary.bySource.booking)||0;
        badge.textContent=count;
        badge.setAttribute('aria-label',count+' booking cases need resolution');
      })
      .catch(function(){badge.textContent='0';});
  }

  function loadWaitingAcceptTab(){
    var container=document.getElementById('waitingAcceptContainer');
    container.innerHTML='<div class="text-center py-5 text-muted"><div class="spinner-border text-primary"></div><p class="mt-2">Loading...</p></div>';
    fetch('/api/admin/appointments/waiting-acceptance/list?limit=50').then(function(r){return r.json();}).then(function(data){
      var bookings=data.bookings||[];
      var total=data.pagination?.total||0;
      document.getElementById('waitingAcceptCount').textContent=total+' bookings';
      var badge=document.getElementById('tabWaitingBadge');
      if(badge){badge.textContent=total;badge.style.display=total>0?'inline-block':'none';}

      // KPIs
      var now=Date.now();
      var overdue=bookings.filter(function(b){return b.acceptanceDeadline&&now>new Date(b.acceptanceDeadline).getTime();}).length;
      var kpi=document.getElementById('waitingKpiContainer');
      if(kpi){
        kpi.innerHTML=
          '<div class="col-lg-6 col-md-6"><div class="stat-card h-100" data-spark-color="#f59e0b"><div class="d-flex justify-content-between align-items-start mb-2"><div><h6 class="text-muted mb-1" style="font-size:0.85rem;font-weight:500;">Waiting for Acceptance</h6><div class="d-flex align-items-baseline gap-2"><span class="h3 mb-0 fw-bold text-dark">'+total+'</span><span class="kpi-trend up"><i class="bi bi-arrow-up"></i> 0%</span><span class="kpi-percent-badge">Waiting</span></div><small class="text-muted">Awaiting tech confirmation</small></div><div class="stat-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);"><i class="bi bi-hourglass-split text-white"></i></div></div><div class="stat-sparkline"><canvas height="40"></canvas></div></div></div>'+
          '<div class="col-lg-6 col-md-6"><div class="stat-card h-100" data-spark-color="#ef4444"><div class="d-flex justify-content-between align-items-start mb-2"><div><h6 class="text-muted mb-1" style="font-size:0.85rem;font-weight:500;">Past Deadline</h6><div class="d-flex align-items-baseline gap-2"><span class="h3 mb-0 fw-bold text-dark">'+overdue+'</span><span class="kpi-trend up"><i class="bi bi-arrow-up"></i> 0%</span><span class="kpi-percent-badge">Urgent</span></div><small class="text-muted">Expired acceptance window</small></div><div class="stat-icon" style="background:linear-gradient(135deg,#ef4444,#dc2626);"><i class="bi bi-clock-history text-white"></i></div></div><div class="stat-sparkline"><canvas height="40"></canvas></div></div></div>';
        if(window.AU && window.AU.drawStatSparklines) window.AU.drawStatSparklines(kpi);
      }
      if(!bookings.length){
        container.innerHTML='<div class="text-center py-5 text-muted"><i class="bi bi-check-circle fs-1 d-block mb-2"></i><p>All assigned bookings have been accepted.</p></div>';
        return;
      }
      container.innerHTML='<div class="workflow-record-list">'+bookings.map(function(b){
        var tech=b.technician;
        var assignedAt=b.assignedAt?new Date(b.assignedAt).toLocaleString():'—';
        var bDate=b.bookingDate?new Date(b.bookingDate).toLocaleDateString():'—';
        var deadline=b.acceptanceDeadline?new Date(b.acceptanceDeadline):null;
        var remaining=deadline?(deadline.getTime()-Date.now()):null;
        var deadlineText='No deadline set';
        var deadlineClass='bg-light text-dark';
        if(deadline){
          if(remaining<0){deadlineText='Deadline passed';deadlineClass='bg-danger text-white';}
          else if(remaining<30*60*1000){deadlineText='Expires in '+Math.ceil(remaining/60000)+' min';deadlineClass='bg-warning text-dark';}
          else {deadlineText='Accept by '+deadline.toLocaleString(undefined,{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});deadlineClass='bg-info text-dark';}
        }
        var assignmentId=b.assignmentId||'';
        return '<div class="workflow-record-card">'+
          '<div class="workflow-record-head">'+
            '<div>'+
              '<div class="workflow-record-ref">'+(b.bookingReference||b._id.slice(-8).toUpperCase())+'</div>'+
              '<div class="workflow-record-title">'+(b.customer?.name||'Unknown')+'</div>'+
              '<div style="font-size:.82rem;color:#64748b;">'+(b.service?.name||'—')+'</div>'+
            '</div>'+
            '<span class="badge '+deadlineClass+'" style="white-space:nowrap;"><i class="bi bi-clock me-1"></i>'+deadlineText+'</span>'+
          '</div>'+
          '<div class="workflow-record-grid">'+
            '<span><i class="bi bi-calendar3 me-1" style="color:#94a3b8;"></i>'+bDate+'</span>'+
            '<span><i class="bi bi-clock me-1" style="color:#94a3b8;"></i>'+(b.startTime||'—')+' - '+(b.endTime||'—')+'</span>'+
            '<span><i class="bi bi-geo-alt me-1" style="color:#94a3b8;"></i>'+(b.address||'—')+'</span>'+
          '</div>'+
          (tech?'<div class="workflow-record-actions">'+
            '<div style="width:28px;height:28px;border-radius:50%;background:#f59e0b;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.7rem;flex-shrink:0;">'+(tech.name||'T')[0].toUpperCase()+'</div>'+
            '<div style="font-size:.78rem;">'+
              '<div style="font-weight:600;color:#1e293b;">'+tech.name+'</div>'+
              '<div style="font-size:.7rem;color:#64748b;">'+(tech.phone||tech.email||'—')+'</div>'+
            '</div>'+
            '<div style="margin-left:auto;display:flex;gap:8px;">'+
              '<button class="au-btn au-btn-outline au-btn-sm" onclick="extendDeadline(\''+assignmentId+'\')"><i class="bi bi-clock-history me-1"></i>Extend</button>'+
              '<button class="au-btn au-btn-primary au-btn-sm" onclick="forceReassign(\''+b._id+'\')"><i class="bi bi-person-plus me-1"></i>Reassign</button>'+
            '</div>'+
          '</div>':'')+
        '</div>';
      }).join('')+'</div>';
    }).catch(function(){
      container.innerHTML='<div class="alert alert-danger small">Failed to load bookings</div>';
    });
  }

  window.extendDeadline = async function(assignmentId){
    var minutes = prompt('Extend deadline by how many minutes?', '60');
    if(!minutes) return;
    try{
      var res = await fetch('/api/admin/appointments/assignments/' + assignmentId + '/extend-deadline', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({minutes: parseInt(minutes)})
      });
      var data = await res.json();
      if(res.ok){ showNotification({type:'success',title:'Deadline Extended',message:'New acceptance deadline saved.',duration:3000}); loadWaitingAcceptTab(); }
      else { showNotification({type:'error',title:'Failed',message:data.error||'Could not extend deadline',duration:4000}); }
    }catch(e){ showNotification({type:'error',title:'Error',message:'Network error',duration:4000}); }
  };

  window.forceReassign = async function(bookingId){
    if(!confirm('Reassign this booking? The current assignment will be expired.')) return;
    try{
      var res = await fetch('/api/admin/appointments/' + bookingId + '/force-reassign', {method:'POST'});
      var data = await res.json();
      if(res.ok){
        showNotification({type:'success',title:'Reassigned',message:'Booking is now available for reassignment.',duration:3000});
        loadWaitingAcceptTab();
        if(AU.Queue){ AU.Queue.loadQueue(1); AU.Queue.loadStats(); }
      } else { showNotification({type:'error',title:'Failed',message:data.error||'Could not reassign',duration:4000}); }
    }catch(e){ showNotification({type:'error',title:'Error',message:'Network error',duration:4000}); }
  };

  window.AU={};

  // â•â•â• OVERVIEW â•â•â•
  AU.Overview={};
  var _ovPage=1,_ovLimit=10;
  var _overviewSearchTimeout=null;

  AU.Overview.load=function(){
    var startDate=(document.getElementById('filterStartDate')||{}).value||'';
    var endDate=(document.getElementById('filterEndDate')||{}).value||'';
    var statsUrl='/api/admin/appointments/flow-stats';
    var dateParams='';
    if(startDate||endDate){
      dateParams='?'+(startDate?'start='+startDate:'')+(startDate&&endDate?'&':'')+(endDate?'end='+endDate:'');
    }
    var listDate=startDate||endDate||'';
    Promise.all([
      fetch(statsUrl+dateParams).then(function(r){return r.json();}),
      fetch('/api/admin/appointments/list?page=1&limit='+_ovLimit+(listDate?'&date='+listDate:'')).then(function(r){return r.json();})
    ]).then(function(res){
      AU.Overview.renderPipeline(res[0].statusCounts||{});
      AU.Overview.renderKPIs(res[0]);
      AU.Overview.renderTable(res[1].bookings);
      AU.Overview.renderPagination(res[1].pagination);
    }).catch(function(e){console.error('Overview load error:',e);});
  };

  AU.Overview.loadRecent=function(page){
    page=page||1;
    var status=(document.getElementById('statusFilter')||{}).value||'';
    var startDate=(document.getElementById('filterStartDate')||{}).value||'';
    var endDate=(document.getElementById('filterEndDate')||{}).value||'';
    var search=(document.getElementById('overviewSearchInput')||{}).value||'';
    var dateParam='';
    if(startDate&&endDate){dateParam='&date='+startDate;}else if(startDate){dateParam='&date='+startDate;}else if(endDate){dateParam='&date='+endDate;}
    fetch('/api/admin/appointments/list?page='+page+'&limit='+_ovLimit+'&status='+status+'&search='+encodeURIComponent(search)+dateParam)
    .then(function(r){return r.json();}).then(function(data){
      AU.Overview.renderTable(data.bookings);
      AU.Overview.renderPagination(data.pagination);
      _ovPage=data.pagination.page;
    }).catch(function(e){console.error(e);});
  };
  AU.Overview.searchRecent=function(){
    clearTimeout(_overviewSearchTimeout);
    _overviewSearchTimeout=setTimeout(function(){AU.Overview.loadRecent(1);},300);
  };

  AU.Overview.renderPipeline=function(statusCounts){
    var el=document.getElementById('pipeline');if(!el)return;
    el.innerHTML=PIPELINE_STAGES.map(function(s,i){
      var count=(statusCounts[s.key]||0);
      return '<div class="pipeline-stage '+(count>0?'pipeline-active':'')+'"><div class="pipeline-icon" style="background:'+s.bg+';color:'+s.color+';"><i class="bi '+s.icon+'"></i></div><div class="pipeline-label">'+s.label+'</div><div class="pipeline-count">'+count+'</div></div>'+
        (i<PIPELINE_STAGES.length-1?'<div style="flex:0 0 20px;text-align:center;color:#cbd5e1;font-size:1.2rem;margin-top:14px;"><i class="bi bi-chevron-right"></i></div>':'');
    }).join('');
  };

  AU.Overview.renderKPIs=function(stats){
    var s=stats.stages||{};
    var sum=stats.summary||{};
    var today=sum.todayBookings||0;
    var total=sum.allTimeBookings||sum.totalBookings||0;
    var pending=s.PENDING_REVIEW?s.PENDING_REVIEW.count||0:0;
    var active=s.ACTIVE_JOBS?s.ACTIVE_JOBS.count||0:0;
    var revenue=sum.totalRevenue||0;
    var filteredRevenue=sum.filteredRevenue||0;
