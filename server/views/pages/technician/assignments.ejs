    // ── Repair En Route Action ────────────────────────────────────────────
    window.repairEnRoute = async function (bookingId) {
      if (!confirm('Are you sure you want to go En Route for this repair?')) return;
      try {
        const res = await fetch(`/api/technician/repairs/${bookingId}/en-route`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin'
        });
        const data = await res.json();
        if (res.ok) {
          showNotification({ type: 'success', title: 'En Route', message: 'Heading to customer. Safe travels!', duration: 4000 });
          // ── Auto-open route map ──
          let a = allItems.find(function (item) { return String(item.bookingId?._id || item.bookingId) === String(bookingId); });
          if (!a && window._detailAssignment && String(window._detailAssignment.bookingId?._id || window._detailAssignment.bookingId) === String(bookingId)) {
            a = window._detailAssignment;
          }
          if (a) {
            var custLat = a.customerLat || (a.bookingId?.location?.coordinates ? a.bookingId.location.coordinates[1] : null) || (a.coordinates?.coordinates ? a.coordinates.coordinates[1] : null);
            var custLng = a.customerLng || (a.bookingId?.location?.coordinates ? a.bookingId.location.coordinates[0] : null) || (a.coordinates?.coordinates ? a.coordinates.coordinates[0] : null);
            if (custLat && custLng) {
              setTimeout(function () {
