            <div class="ent-detail-card-icon" style="background:#eff6ff;color:#1d4ed8;"><i class="bi bi-envelope"></i></div>
            <div class="ent-detail-card-content"><div class="ent-detail-card-label">Email</div><div class="ent-detail-card-value" style="font-size:0.85rem;">${b.customer?.email || 'N/A'}</div></div>
          </div>
          <div class="ent-detail-card">
