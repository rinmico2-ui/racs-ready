              <img src="${p.src}" alt="${p.label}" onclick="window.open('${p.src.replace(/'/g, "\\'")}', '_blank')" onerror="this.closest('.pm-photo-item').innerHTML='<div style=\\'padding:20px;text-align:center;color:#94a3b8;font-size:.8rem;\\'>Image unavailable</div>'">
              <div style="margin-top:4px;text-align:center;font-size:.68rem;color:#94a3b8;">${p.label} ${i+1}</div>
            </div>`).join('')}
          </div>
        </div>` : ''}

        ${(b.statusHistory && b.statusHistory.length > 0) ? `
        <div style="margin-top:20px;">
          <div class="pm-section-hdr"><i class="bi bi-clock-history" style="color:#64748b;"></i><span class="pm-section-title">Status History</span></div>
          <div style="max-height:200px;overflow-y:auto;background:#f8fafc;border-radius:10px;border:1px solid #e2e8f0;padding:8px 12px;">
            ${b.statusHistory.slice().reverse().map(h => {
              const ts = h.timestamp || h.date || h.createdAt;
              const statusVal = h.toStatus || h.status || h.fromStatus || '—';
              const label = statusVal.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
              return `<div class="pm-history-item">
                <div style="flex:1;min-width:0;"><span class="badge bg-secondary" style="font-size:.65rem;">${label}</span>${h.reason || h.message || h.notes ? `<span style="color:#64748b;font-size:.8rem;margin-left:6px;">— ${(h.reason || h.message || h.notes).substring(0, 80)}</span>` : ''}</div>
                <div style="flex-shrink:0;text-align:right;">${h.changedByName ? `<span style="color:#94a3b8;font-size:.7rem;margin-right:6px;">by ${h.changedByName}</span>` : ''}<span style="color:#94a3b8;font-size:.7rem;">${ts ? new Date(ts).toLocaleString('en-PH', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—'}</span></div>
              </div>`;
            }).join('')}
          </div>
        </div>` : ''}

        ${b.cancellationHistory && b.cancellationHistory.length > 0 ? `
        <div style="margin-top:20px;">
          <div class="pm-section-hdr"><i class="bi bi-arrow-repeat" style="color:#dc2626;"></i><span class="pm-section-title">Technician Cancellation History</span></div>
          <div class="pm-alert" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;">
            ${b.cancellationHistory.slice().reverse().map(h => `
            <div style="display:flex;gap:6px;align-items:flex-start;padding:3px 0;">
              <span class="badge ${h.action === 'declined' ? 'bg-danger' : 'bg-warning text-dark'}" style="font-size:.65rem;flex-shrink:0;">${h.action}</span>
              <span style="font-size:.8rem;"><strong>${h.technicianName || 'Technician'}</strong> — ${h.reason || 'No reason'}</span>
              <span style="color:#94a3b8;font-size:.7rem;margin-left:auto;flex-shrink:0;">${h.timestamp ? new Date(h.timestamp).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' }) : ''}</span>
            </div>`).join('')}
          </div>
        </div>` : ''}

        ${b.rescheduleRequest && b.rescheduleRequest.requested ? `
        <div class="pm-alert" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;margin-top:16px;">
          <i class="bi bi-calendar-event"></i>
          <div><strong>Reschedule Request:</strong> ${b.rescheduleRequest.requestedDate || ''} ${b.rescheduleRequest.requestedTime || ''}${b.rescheduleRequest.reason ? ' — ' + b.rescheduleRequest.reason : ''} <small style="color:#94a3b8;">(${b.rescheduleRequest.status || 'pending'})</small></div>
        </div>` : ''}

        ${b.notes ? `<div class="pm-alert" style="background:#f8fafc;border:1px solid #e2e8f0;color:#475569;margin-top:16px;"><i class="bi bi-journal-text"></i><div><strong>Notes:</strong> ${b.notes}</div></div>` : ''}
        ${b.rejectionReason ? `<div class="pm-alert" style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;margin-top:16px;"><i class="bi bi-x-circle"></i><div><strong>Rejected:</strong> ${b.rejectionReason.replace(/_/g, ' ')}${b.rejectionNote ? ' — ' + b.rejectionNote : ''}${b.rejectedAt ? ' <small style="color:#94a3b8;">at ' + new Date(b.rejectedAt).toLocaleString('en-PH') + '</small>' : ''}</div></div>` : ''}
        ${b.cancellationReason ? `<div class="pm-alert" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;margin-top:16px;"><i class="bi bi-exclamation-triangle"></i><div><strong>Cancellation Reason:</strong> ${b.cancellationReason}</div></div>` : ''}
        ${b.noShowRescheduleToken ? `<div class="pm-alert" style="background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;margin-top:16px;"><i class="bi bi-clock"></i><div><strong>No-Show Reschedule:</strong> Status: ${b.noShowRescheduleStatus || 'pending'} ${b.noShowAt ? 'at ' + new Date(b.noShowAt).toLocaleString('en-PH') : ''}</div></div>` : ''}

        ${b.slaTracking ? `
        <div style="margin-top:16px;padding:10px 14px;background:#f8fafc;border-radius:8px;border:1px solid #e2e8f0;font-size:.82rem;">
          <i class="bi bi-speedometer2 me-1" style="color:#475569;"></i><strong style="color:#475569;">SLA:</strong>
          ${b.slaTracking.responseTarget ? `Response by: ${new Date(b.slaTracking.responseTarget).toLocaleString('en-PH')}${b.slaTracking.responseBreached ? ' <span style="color:#dc2626;">⚠ Breached</span>' : ''} | ` : ''}
          ${b.slaTracking.resolutionTarget ? `Resolution by: ${new Date(b.slaTracking.resolutionTarget).toLocaleString('en-PH')}${b.slaTracking.resolutionBreached ? ' <span style="color:#dc2626;">⚠ Breached</span>' : ''}` : ''}
          ${b.slaTracking.escalationLevel > 0 ? ` | Escalation: Level ${b.slaTracking.escalationLevel}` : ''}
        </div>` : ''}

        <div class="pm-footer">
          ${['confirmed', 'scheduled', 'assigned'].includes(b.status) ? `
            <button class="btn btn-primary btn-sm fw-semibold" onclick="bootstrap.Modal.getInstance(document.getElementById('detailModal')).hide();setTimeout(()=>{ trackingBookingId='${b._id}'; markEnRoute(); },300);">
              <i class="bi bi-truck me-1"></i>Mark En Route
            </button>
          ` : ''}
          ${['in-progress', 'on-the-way', 'arrived', 'confirmed', 'scheduled'].includes(b.status) ? `
            <button class="btn btn-outline-secondary btn-sm" onclick="bootstrap.Modal.getInstance(document.getElementById('detailModal')).hide();setTimeout(()=>trackOnMap('${b._id}'),300);">
              <i class="bi bi-geo-alt me-1"></i>Track on Map
            </button>
          ` : ''}
          <button class="btn btn-light btn-sm" data-bs-dismiss="modal">Close</button>
        </div>
      `;
    } catch(e) {
      body.innerHTML = '<div class="alert alert-danger">Failed to load job details: ' + e.message + '</div>';
    }
  }

  // ═══ Enterprise Tracking Drawer ═══════════════════════════════════════
  let trackMap = null;
  let trackMarkers = {};
  let trackPolyline = null;
  let trackingBookingId = null;
  let trackingData = null;
  let trackingInterval = null;
  let trackDrawerPinned = false;

  function ensureLeaflet() {
    return new Promise((resolve) => {
      if (window.L) { resolve(); return; }
      if (!document.getElementById('leaflet-css')) {
        const css = document.createElement('link');
        css.id = 'leaflet-css'; css.rel = 'stylesheet';
        css.href = 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(css);
      }
      const s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js';
      s.onload = resolve;
      document.head.appendChild(s);
    });
  }

  function parseCoords(coords) {
    if (!coords) return null;
    if (Array.isArray(coords) && coords.length >= 2) {
      const [lng, lat] = coords.map(Number);
      if (!isFinite(lng) || !isFinite(lat)) return null;
      return { lat, lng };
    }
    if (typeof coords === 'object' && coords.coordinates) return parseCoords(coords.coordinates);
    if (typeof coords === 'object' && coords.lat != null && coords.lng != null) {
      const lat = Number(coords.lat), lng = Number(coords.lng);
      if (!isFinite(lat) || !isFinite(lng)) return null;
      return { lat, lng };
    }
    return null;
  }

  function updateProgressBar(status) {
    const steps = ['confirmed', 'on-the-way', 'arrived', 'in-progress', 'completed'];
    const order = ['confirmed', 'scheduled', 'assigned', 'on-the-way', 'arrived', 'in-progress', 'completed'];
    const currentIdx = order.indexOf(status);
    steps.forEach((step, i) => {
      const stepIdx = order.indexOf(step);
      const el = document.getElementById('tdStep' + i);
      const line = document.getElementById('tdLine' + i);
      const isDone = currentIdx > stepIdx;
      const isCurrent = step === status || (step === 'confirmed' && ['confirmed', 'scheduled', 'assigned'].includes(status));
      el.className = 'td-progress-step';
      if (isDone) el.classList.add('done');
      if (isCurrent) el.classList.add('active');
      if (line) line.className = 'td-progress-line' + (isDone ? ' done' : '');
    });
  }

  function initMapInDrawer(custLoc, techLoc, custName, techName, serviceAddr) {
    const mapEl = document.getElementById('trackDrawerMap');
    if (trackMap) { trackMap.remove(); trackMap = null; }

    const defaultCenter = custLoc || techLoc || { lat: 14.5995, lng: 120.9842 };
    trackMap = L.map(mapEl, { zoomControl: true, attributionControl: false }).setView([defaultCenter.lat, defaultCenter.lng], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://openstreetmap.org/copyright">OSM</a>'
    }).addTo(trackMap);

    trackMarkers = {};

    if (custLoc) {
      const custIcon = L.divIcon({
        className: '',
        html: `<div style="width:34px;height:34px;background:#2563eb;border-radius:50%;border:3px solid #fff;box-shadow:0 3px 12px rgba(37,99,235,0.35);display:flex;align-items:center;justify-content:center;"><i class="bi bi-house-fill" style="color:#fff;font-size:15px;"></i></div>`,
        iconSize: [34, 34], iconAnchor: [17, 17]
      });
      trackMarkers.customer = L.marker([custLoc.lat, custLoc.lng], { icon: custIcon })
        .addTo(trackMap)
        .bindPopup(`<b>${custName}</b><br><span style="font-size:0.8rem;color:#666;">${serviceAddr}</span>`);
    }

    if (techLoc) {
      const techIcon = L.divIcon({
        className: '',
        html: `<div style="width:34px;height:34px;background:#16a34a;border-radius:50%;border:3px solid #fff;box-shadow:0 3px 12px rgba(22,163,74,0.35);display:flex;align-items:center;justify-content:center;"><i class="bi bi-tools" style="color:#fff;font-size:15px;"></i></div>`,
        iconSize: [34, 34], iconAnchor: [17, 17]
      });
      trackMarkers.technician = L.marker([techLoc.lat, techLoc.lng], { icon: techIcon })
        .addTo(trackMap)
        .bindPopup(`<b>${techName}</b><br><span style="font-size:0.8rem;color:#666;">Current location</span>`);
    }

    if (custLoc && techLoc) {
      trackPolyline = L.polyline([[custLoc.lat, custLoc.lng], [techLoc.lat, techLoc.lng]], {
        color: '#2563eb', weight: 3, dashArray: '8, 8', opacity: 0.7
      }).addTo(trackMap);
      trackMap.fitBounds(L.latLngBounds([custLoc, techLoc]).pad(0.2));
    } else {
      trackMap.setView([defaultCenter.lat, defaultCenter.lng], 14);
    }

    setTimeout(() => trackMap.invalidateSize(), 100);
  }

  function openTrackDrawer() {
    document.getElementById('trackDrawer').classList.add('open');
    document.body.style.overflow = 'hidden';
    if (trackMap) setTimeout(() => trackMap.invalidateSize(), 300);
  }

  function closeTrackDrawer() {
    if (trackDrawerPinned) return;
    document.getElementById('trackDrawer').classList.remove('open');
    document.body.style.overflow = '';
    stopTrackingRefresh();
  }

  function toggleTrackDrawerPin() {
    trackDrawerPinned = !trackDrawerPinned;
    const btn = document.getElementById('trackDrawerPinBtn');
    btn.classList.toggle('pinned', trackDrawerPinned);
    btn.title = trackDrawerPinned ? 'Unpin (allow close)' : 'Keep open';
  }

  async function loadTrackingData(id) {
    const res = await fetch(`/api/admin/appointments/${id}`);
    const data = await res.json();
    trackingData = data;
    const b = data.booking;

    const custLoc = parseCoords(b.location?.coordinates?.coordinates) ||
      (b.location?.lat && b.location?.lng ? { lat: Number(b.location.lat), lng: Number(b.location.lng) } : null) ||
      parseCoords(b.coordinates) ||
      (data.assignment?.coordinates ? parseCoords(data.assignment.coordinates) : null);

    const techLoc = data.technicianLocation ? parseCoords(data.technicianLocation) : null;
    const techName = b.technician?.name || 'Technician';
    const custName = b.customer?.name || 'Customer';
    const serviceAddr = b.location?.address || data.assignment?.address || 'Service location';
    const ref = b.bookingReference || b.workOrderNumber || '#' + b._id.toString().slice(-8).toUpperCase();

    document.getElementById('trackDrawerTitle').textContent = ref;
    document.getElementById('trackDrawerSubtitle').textContent = custName + (b.customer?.phone ? ' · ' + b.customer.phone : '');

    document.getElementById('tdInfoCustomer').textContent = custName;
    document.getElementById('tdInfoCustomerAddr').textContent = serviceAddr.length > 50 ? serviceAddr.substring(0, 47) + '...' : serviceAddr;
    document.getElementById('tdInfoTechnician').textContent = techName;
    document.getElementById('tdInfoTechStatus').textContent = techLoc ? '📍 Live' : (b.status === 'on-the-way' ? '🚚 En route' : '📍 Awaiting');
    document.getElementById('tdInfoStatus').textContent = (b.status || '').replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
    document.getElementById('tdInfoRef').textContent = ref;

    updateProgressBar(b.status);

    const enrouteBtn = document.getElementById('tdBtnEnroute');
    if (['confirmed', 'scheduled', 'assigned'].includes(b.status)) {
      enrouteBtn.style.display = 'inline-flex';
      enrouteBtn.dataset.id = b._id;
    } else {
      enrouteBtn.style.display = 'none';
    }

    await ensureLeaflet();
    initMapInDrawer(custLoc, techLoc, custName, techName, serviceAddr);
    if (document.getElementById('trackDrawer').classList.contains('open')) {
      setTimeout(() => trackMap?.invalidateSize(), 200);
    }
  }

  async function trackOnMap(id) {
    trackingBookingId = id;
    trackDrawerPinned = false;
    document.getElementById('trackDrawerPinBtn').classList.remove('pinned');
    document.getElementById('trackDrawerPinBtn').title = 'Keep open';
    await loadTrackingData(id);
    openTrackDrawer();
    startTrackingRefresh();
  }

  function startTrackingRefresh() {
    stopTrackingRefresh();
    if (!trackingBookingId) return;
    trackingInterval = setInterval(async () => {
      if (document.getElementById('trackDrawer').classList.contains('open')) {
        await loadTrackingData(trackingBookingId);
      }
    }, 15000);
  }

  function stopTrackingRefresh() {
    if (trackingInterval) { clearInterval(trackingInterval); trackingInterval = null; }
  }

  async function refreshTracking() {
    if (trackingBookingId) {
      showNotification({ type: 'info', title: 'Refreshing', message: 'Updating tracking data...', duration: 2000 });
      await loadTrackingData(trackingBookingId);
    }
  }

  async function markEnRoute() {
    const btn = document.getElementById('tdBtnEnroute');
    const id = btn.dataset.id || trackingBookingId;
    if (!id) return;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Setting...';
    try {
      const res = await fetch(`/api/appointments/${id}/on-the-way`, { method: 'POST' });
      if (!res.ok) throw new Error((await res.json()).error || 'Failed');
      showNotification({ type: 'success', title: 'En Route', message: 'Technician marked as en route', duration: 4000 });
      await loadTrackingData(id);
      loadList();
    } catch (e) {
      showNotification({ type: 'error', title: 'Error', message: e.message, duration: 4000 });
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-truck me-1"></i>Mark En Route';
    }
  }

  function openInFullMap() {
    if (trackingData && trackingData.booking) {
      const b = trackingData.booking;
      const loc = b.location;
      const coords = loc?.lat && loc?.lng ? `${loc.lat},${loc.lng}` : '';
      const addr = encodeURIComponent(loc?.address || 'Service Location');
      if (coords) window.open(`https://www.google.com/maps?q=${coords}`, '_blank');
      else window.open(`https://www.google.com/maps/search/${addr}`, '_blank');
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.getElementById('trackDrawer').classList.contains('open')) {
      closeTrackDrawer();
    }
  });

  function showToast(msg, type = 'success') {
    const t = document.createElement('div');
    t.className = `toast align-items-center text-white bg-${type === 'error' ? 'danger' : 'success'} border-0`;
    t.innerHTML = `<div class="d-flex"><div class="toast-body">${msg}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>`;
    document.body.appendChild(t); new bootstrap.Toast(t).show(); setTimeout(() => t.remove(), 4000);
  }

  // Enterprise notification system
  function showNotification({ type = 'info', title = '', message = '', duration = 3000 }) {
    const colors = {
      success: { bg: '#f0fdf4', border: '#22c55e', icon: 'bi-check-circle-fill', iconColor: '#16a34a' },
      error: { bg: '#fef2f2', border: '#ef4444', icon: 'bi-x-circle-fill', iconColor: '#dc2626' },
      warning: { bg: '#fffbeb', border: '#f59e0b', icon: 'bi-exclamation-triangle-fill', iconColor: '#d97706' },
      info: { bg: '#eff6ff', border: '#3b82f6', icon: 'bi-info-circle-fill', iconColor: '#2563eb' }
    };
    const c = colors[type] || colors.info;
    const el = document.createElement('div');
    el.style.cssText = `position:fixed;top:20px;right:20px;z-index:99999;min-width:340px;max-width:420px;background:${c.bg};border:1px solid ${c.border};border-left:4px solid ${c.border};border-radius:12px;padding:16px 20px;box-shadow:0 10px 40px rgba(0,0,0,0.15);display:flex;align-items:flex-start;gap:12px;animation:slideInRight 0.3s ease;`;
    el.innerHTML = `<i class="bi ${c.icon}" style="font-size:1.3rem;color:${c.iconColor};margin-top:2px;"></i><div style="flex:1;"><div style="font-weight:700;font-size:0.9rem;color:#1e293b;margin-bottom:2px;">${title}</div><div style="font-size:0.82rem;color:#64748b;">${message}</div></div><button onclick="this.parentElement.remove()" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:1.1rem;padding:0;line-height:1;">&times;</button>`;
    document.body.appendChild(el);
    if (!document.getElementById('notif-styles')) {
      const style = document.createElement('style'); style.id = 'notif-styles';
      style.textContent = '@keyframes slideInRight{from{transform:translateX(100%);opacity:0;}to{transform:translateX(0);opacity:1;}}';
      document.head.appendChild(style);
    }
    setTimeout(() => { el.style.transition='all 0.3s ease'; el.style.opacity='0'; el.style.transform='translateX(100%)'; setTimeout(()=>el.remove(),300); }, duration);
  }

  loadList();
  let st; document.getElementById('searchInput')?.addEventListener('input', () => { clearTimeout(st); st = setTimeout(loadList, 400); });
</script>
