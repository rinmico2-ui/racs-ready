<style>
  .racs-loader{background:linear-gradient(160deg,#1e3a8a 0%,#1e40af 50%,#312e81 100%);border-radius:24px;padding:40px 32px;max-width:480px;margin:0 auto;box-shadow:0 25px 60px -15px rgba(30,58,138,0.5);position:relative;overflow:hidden}
  .racs-scene{position:relative;height:230px;margin-bottom:28px;overflow:hidden;border-radius:16px;background:linear-gradient(180deg,rgba(255,255,255,0.06) 0%,rgba(255,255,255,0.02) 100%)}
  .racs-glow{position:absolute;top:45%;left:50%;transform:translate(-50%,-50%);width:300px;height:120px;background:radial-gradient(ellipse,rgba(96,165,250,0.2) 0%,transparent 70%);pointer-events:none}
  .racs-carwrap{position:absolute;bottom:30px;left:50%;transform:translateX(-50%);width:340px;animation:racsBob 0.6s ease-in-out infinite alternate}
  @keyframes racsBob{from{transform:translateX(-50%) translateY(0)}to{transform:translateX(-50%) translateY(-4px)}}
  .racs-carwrap svg{width:100%;height:auto;display:block}
  .racs-wheel{transform-box:fill-box;transform-origin:center;animation:racsSpin 0.5s linear infinite}
  @keyframes racsSpin{to{transform:rotate(360deg)}}
  .racs-track{position:absolute;bottom:0;left:0;width:100%;height:20px}
  .racs-track-dash{position:absolute;bottom:8px;left:0;width:200%;height:4px;background:repeating-linear-gradient(90deg,rgba(255,255,255,0.5) 0,rgba(255,255,255,0.5) 30px,transparent 30px,transparent 60px);animation:racsTrack 0.6s linear infinite}
  @keyframes racsTrack{from{transform:translateX(0)}to{transform:translateX(-60px)}}
  .racs-progress{width:100%;height:5px;background:rgba(255,255,255,0.12);border-radius:99px;overflow:hidden;margin-bottom:22px}
  .racs-progress-fill{height:100%;width:35%;border-radius:99px;background:linear-gradient(90deg,#60a5fa,#93c5fd,#60a5fa);background-size:200% 100%;animation:racsProg 1.5s ease-in-out infinite,racsShimmer 2s linear infinite}
  @keyframes racsProg{0%{transform:translateX(-100%)}100%{transform:translateX(386%)}}
  @keyframes racsShimmer{0%{background-position:0% 0}100%{background-position:200% 0}}
  .racs-title{display:block;text-align:center;font-size:1.2rem;font-weight:700;color:#fff;margin-bottom:8px;letter-spacing:0.3px}
  .racs-desc{display:block;text-align:center;font-size:0.88rem;color:rgba(255,255,255,0.6);margin-bottom:18px}
  .racs-pulse{display:flex;justify-content:center;gap:7px}
  .racs-pulse span{width:8px;height:8px;border-radius:50%;background:#60a5fa;animation:racsPulse 1.4s ease-in-out infinite}
  .racs-pulse span:nth-child(2){animation-delay:0.2s}
  .racs-pulse span:nth-child(3){animation-delay:0.4s}
  @keyframes racsPulse{0%,100%{opacity:0.3;transform:scale(0.7)}50%{opacity:1;transform:scale(1.15)}}
</style>

<script>
(function() {
  document.addEventListener("DOMContentLoaded", () => {
    ["repairLoadingModal"].forEach(function(id) {
      const m = document.getElementById(id);
      if (m && m.parentElement !== document.body) {
        document.body.appendChild(m);
      }
    });
  });
})();
</script>
