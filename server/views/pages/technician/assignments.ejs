  .trk-payment-total { border-top:1px dashed #a7f3d0; margin-top:4px; padding-top:8px !important; font-weight:700; color:#0f172a; }
  .trk-payment-total span:last-child { color:#2563eb !important; }

  /* ── Progress Timeline (Horizontal) ────────────────────────────── */
  .trk-timeline { margin-top:12px; padding:18px 14px; background:#f8fafc; border-radius:12px; border:1px solid #e2e8f0; overflow-x:auto; }
  .trk-timeline-track { display:flex; align-items:flex-start; gap:0; min-width:max-content; }
  .trk-timeline-step { display:flex; flex-direction:column; align-items:center; gap:6px; min-width:90px; position:relative; flex-shrink:0; }
  .trk-timeline-dot { width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; background:#e2e8f0; color:#94a3b8; font-size:0.85rem; z-index:1; border:2px solid #e2e8f0; transition:all 0.3s; }
  .trk-timeline-step.completed .trk-timeline-dot { background:linear-gradient(135deg,#22c55e,#16a34a); color:#fff; border-color:#22c55e; box-shadow:0 2px 8px rgba(34,197,94,0.3); }
  .trk-timeline-step.active .trk-timeline-dot { background:linear-gradient(135deg,#2563eb,#1d4ed8); color:#fff; border-color:#2563eb; box-shadow:0 2px 12px rgba(37,99,235,0.4); animation:trkStepPulse 2s ease-in-out infinite; }
  .trk-timeline-label { font-size:0.68rem; font-weight:600; color:#64748b; text-align:center; white-space:nowrap; transition:color 0.3s; }
  .trk-timeline-step.completed .trk-timeline-label, .trk-timeline-step.active .trk-timeline-label { color:#0f172a; font-weight:700; }
  .trk-timeline-connector { width:40px; height:2px; background:#e2e8f0; flex-shrink:0; margin-top:17px; transition:background 0.3s; }
  .trk-timeline-connector.completed { background:#22c55e; }
  .trk-timeline-connector.active { background:linear-gradient(90deg,#22c55e,#2563eb); }
  @keyframes trkStepPulse { 0%,100% { box-shadow:0 0 0 0 rgba(37,99,235,0.4); } 50% { box-shadow:0 0 0 10px rgba(37,99,235,0); } }

  /* ── Status Pill (matches customer tracking) ─────────────────────── */
  .trk-status-pill {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 5px 14px; border-radius: 20px;
    font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .trk-status-pill.pending { background: #fef3c7; color: #92400e; }
  .trk-status-pill.confirmed { background: #d1fae5; color: #065f46; }
  .trk-status-pill.scheduled { background: #dbeafe; color: #1e40af; }
  .trk-status-pill.on-the-way { background: #e0e7ff; color: #3730a3; }
  .trk-status-pill.in-progress { background: #ede9fe; color: #5b21b6; }
  .trk-status-pill.completed { background: #d1fae5; color: #065f46; }
  .trk-status-pill.re-scheduled { background: #cffafe; color: #155e75; }
  .trk-status-pill.cancelled { background: #fee2e2; color: #991b1b; }
  .trk-status-pill.expired { background: #fef3c7; color: #92400e; }

