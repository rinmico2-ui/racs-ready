<!-- Aircon Product Page — Premium E-Commerce Design -->
<link rel="stylesheet" href="/css/customer-payment.css?v=20260925-qr-actions-v4">
<%
  var airconGroups = (locals.grouped && Array.isArray(grouped)) ? grouped : [];
%>
<section class="products-aircons-premium position-relative" style="overflow: hidden;">
  <div class="position-relative" style="background: linear-gradient(160deg, #f0f7ff 0%, #dbeafe 50%, #eff6ff 100%); padding: 3.5rem 0 3rem; border-bottom: 1px solid rgba(37,99,235,0.08);">
    <style>
      @media (max-width: 768px) {
        .products-aircons-premium > div:first-child {
          padding: 1.5rem 0 1.25rem !important;
        }
        .products-aircons-premium h1 {
          font-size: 1.5rem !important;
        }
        .products-aircons-premium h1 br {
          display: none;
        }
        .products-aircons-premium p {
          font-size: 0.85rem !important;
        }
        .enterprise-filter-bar {
          padding: 0.5rem 0 0.5rem !important;
        }
        .ent-filter-pill {
          padding: 0.3rem 0.7rem !important;
          font-size: 0.72rem !important;
        }
        #productSearchInput {
          font-size: 0.85rem !important;
          padding: 0.45rem 1rem 0.45rem 2rem !important;
        }
      }
      @media (max-width: 480px) {
        .products-aircons-premium > div:first-child {
          padding: 1.25rem 0 1rem !important;
        }
        .products-aircons-premium h1 {
          font-size: 1.25rem !important;
        }
        .products-aircons-premium p {
          font-size: 0.8rem !important;
        }
        .ent-filter-pill {
          padding: 0.25rem 0.6rem !important;
          font-size: 0.68rem !important;
        }
        .ent-filter-pill i {
          display: none !important;
        }
      }
    </style>
    <div class="position-absolute top-0 start-0 w-100 h-100"
      style="background-image: radial-gradient(rgba(37,99,235,0.04) 1px, transparent 1px); background-size: 20px 20px; z-index: 0; pointer-events: none;"></div>
    <div class="position-absolute top-0 start-0 w-100 h-100" style="z-index: 0; pointer-events: none;">
      <div style="position: absolute; top: -30%; right: -10%; width: 400px; height: 400px; background: radial-gradient(circle, rgba(59,130,246,0.08) 0%, transparent 70%); border-radius: 50%;"></div>
      <div style="position: absolute; bottom: -20%; left: -5%; width: 300px; height: 300px; background: radial-gradient(circle, rgba(99,102,241,0.06) 0%, transparent 70%); border-radius: 50%;"></div>
    </div>
    <div class="container position-relative" style="z-index: 2;">
      <div class="row align-items-center">
        <div class="col-lg-7">
          <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3"
            style="font-size: 0.68rem; font-weight: 700; color: #2563eb; text-transform: uppercase; letter-spacing: 1.5px; border: 1px solid rgba(37,99,235,0.15); background: rgba(37,99,235,0.06); border-radius: 4px;">
            <i class="bi bi-snowflake" style="font-size: 0.75rem;"></i>
            RACS READY
          </div>
          <h1 class="fw-bold mb-2" style="color: #0f172a; font-size: 2.2rem; letter-spacing: -0.8px; line-height: 1.15;">
            Commercial & Residential<br>
            <span style="background: linear-gradient(135deg, #2563eb, #3b82f6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Air Conditioning</span> Systems
          </h1>
          <p class="mb-0" style="max-width: 500px; color: #64748b; font-size: 0.92rem; line-height: 1.6;">
            Premium HVAC solutions with professional installation, certified warranty, and 24/7 support.
          </p>
        </div>
        <div class="col-lg-5 d-none d-lg-block">
          <div class="d-flex gap-2 justify-content-end">
            <div class="text-center px-3 py-2" style="background: rgba(255,255,255,0.7); border: 1px solid rgba(37,99,235,0.1); border-radius: 8px; min-width: 100px; backdrop-filter: blur(8px);">
              <div class="fw-bold" style="color: #0f172a; font-size: 1.25rem; letter-spacing: -0.5px;">12mo</div>
              <div style="color: #64748b; font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Warranty</div>
            </div>
            <div class="text-center px-3 py-2" style="background: rgba(255,255,255,0.7); border: 1px solid rgba(37,99,235,0.1); border-radius: 8px; min-width: 100px; backdrop-filter: blur(8px);">
              <div class="fw-bold" style="color: #0f172a; font-size: 1.25rem; letter-spacing: -0.5px;">24/7</div>
              <div style="color: #64748b; font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Support</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ Products Content Area ═══ -->
  <div class="py-5"
    style="background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%); position: relative;">
    <!-- Floating Cart Button -->
    <div id="floatingCartBtn" class="position-fixed d-flex align-items-center gap-2" style="bottom: 24px; right: 24px; z-index: 9998;">
      <span id="cartLabel" class="d-none d-md-inline-block px-3 py-2 fw-semibold small"
        style="background: linear-gradient(135deg, #2563eb, #3b82f6); color: #fff; letter-spacing: 0.2px; cursor: pointer; border-radius: 8px; font-size: 0.78rem; transition: all 0.2s; box-shadow: 0 2px 8px rgba(37,99,235,0.25);"
        onclick="location.href='<%= locals.user ? '/aircon-cart' : '/login' %>'">
        <i class="bi bi-cart3 me-1"></i> Cart <span id="cartLabelCount">0</span>
      </span>
      <button class="btn d-flex align-items-center justify-content-center p-0"
        style="width: 48px; height: 48px; border-radius: 10px; background: linear-gradient(135deg, #2563eb, #3b82f6); color: #fff; border: none; font-size: 1rem; box-shadow: 0 3px 10px rgba(37,99,235,0.3); transition: transform 0.2s;"
        onclick="location.href='<%= locals.user ? '/aircon-cart' : '/login' %>'"
        onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
        <i class="bi bi-cart3"></i>
        <span id="cartBadgeCount"
          class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light"
          style="font-size: 0.6rem; display: none;">0</span>
      </button>
    </div>
    <div class="container position-relative" style="z-index: 1;">
      <!-- Search & Filter Bar -->
      <div class="enterprise-filter-bar mb-3" style="padding: 0 0 0.75rem; border-bottom: 1px solid rgba(37,99,235,0.1);">
        <div class="row align-items-center g-2">
          <div class="col-md-4 col-lg-3">
            <div class="position-relative">
              <input type="text" id="productSearchInput" class="form-control"
                placeholder="Search models, brands..."
                style="background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.85rem; font-weight: 500; color: #0f172a; padding: 0.5rem 1rem 0.5rem 2.25rem; transition: all 0.2s;"
                oninput="filterProductsBySearch()">
              <i class="bi bi-search position-absolute" style="left: 10px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.82rem;"></i>
              <button class="btn position-absolute border-0 p-0 d-flex align-items-center justify-content-center"
                id="searchClearBtn"
                style="right: 8px; top: 50%; transform: translateY(-50%); width: 20px; height: 20px; color: #94a3b8; display: none;"
                onclick="document.getElementById('productSearchInput').value='';filterProductsBySearch();this.style.display='none';">
                <i class="bi bi-x-lg" style="font-size: 0.6rem;"></i>
              </button>
            </div>
          </div>
          <div class="col-md-8 col-lg-9">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <div class="d-flex gap-1 flex-wrap" role="group" aria-label="Product type filters">
                <button class="btn ent-filter-pill active" data-filter="all">All</button>
                <button class="btn ent-filter-pill" data-filter="split"><i class="bi bi-columns-gap me-1 d-none d-sm-inline"></i>Split</button>
                <button class="btn ent-filter-pill" data-filter="window_inverter"><i class="bi bi-window me-1 d-none d-sm-inline"></i>Window Inverter</button>
                <button class="btn ent-filter-pill" data-filter="window_non_inverter"><i class="bi bi-window me-1 d-none d-sm-inline"></i>Window</button>
                <button class="btn ent-filter-pill" data-filter="floor_mounted"><i class="bi bi-layers me-1 d-none d-sm-inline"></i>Floor Mounted</button>
              </div>
              <div class="small d-flex align-items-center gap-1" style="color: #64748b; font-weight: 500; white-space: nowrap;">
                <span id="visibleProductCount" class="fw-bold" style="color: #2563eb; font-variant-numeric: tabular-nums;"><%= airconGroups.length %></span>
                <span>products</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <style>
        @keyframes fadeSlideUp {
          from { opacity: 0; transform: translateY(12px); }
          to { opacity: 1; transform: translateY(0); }
        }

        /* ═══ Enterprise Filter Pills ═══ */
        .ent-filter-pill {
          padding: 0.35rem 0.85rem;
          border-radius: 6px;
          font-size: 0.78rem;
          font-weight: 600;
          color: #64748b;
          background: #fff;
          border: 1px solid #e2e8f0;
          transition: all 0.2s ease;
          cursor: pointer;
        }

        .ent-filter-pill:hover {
          background: #eff6ff;
          color: #2563eb;
          border-color: #bfdbfe;
        }

        .ent-filter-pill.active {
          background: linear-gradient(135deg, #2563eb, #3b82f6);
          color: #fff;
          border-color: #3b82f6;
          box-shadow: 0 1px 4px rgba(37,99,235,0.35);
        }

        .ent-filter-pill:focus-visible {
          outline: 2px solid #3b82f6;
          outline-offset: 2px;
        }

        /* ═══ Featured Aircon Card (light enterprise) ═══ */
        .fp-card {
          background: #fff;
          border: 1px solid #e2e8f0;
          border-radius: 1rem;
          overflow: hidden;
          transition: all 0.45s cubic-bezier(0.165,0.84,0.44,1);
          display: flex; flex-direction: column;
          box-shadow: 0 1px 3px rgba(15,23,42,0.04);
        }
        .fp-card:hover { transform: translateY(-8px); border-color: #bfdbfe; box-shadow: 0 20px 40px rgba(37,99,235,0.1); }
        .fp-card-media { position: relative; aspect-ratio: 4/3; background: #f8fafc; overflow: hidden; }
        .fp-card-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
        .fp-card:hover .fp-card-media img { transform: scale(1.08); }
        .fp-tag { position: absolute; top: 12px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em; padding: 4px 10px; border-radius: 50px; text-transform: uppercase; }
        .fp-tag-inverter { left: 12px; background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; }
        .fp-tag-stock { right: 12px; }
        .fp-tag-stock.in { background: rgba(16,185,129,0.1); color: #059669; border: 1px solid rgba(16,185,129,0.2); }
        .fp-tag-stock.out { background: rgba(239,68,68,0.1); color: #dc2626; border: 1px solid rgba(239,68,68,0.2); }
        .fp-sold-overlay {
          position: absolute; inset: 0;
          display: flex; align-items: center; justify-content: center;
          background: rgba(255,255,255,0.6); backdrop-filter: blur(2px);
          z-index: 1;
        }
        .fp-sold-overlay span {
          font-weight: 700; font-size: 0.7rem; letter-spacing: 0.3px;
          background: rgba(239,68,68,0.1); color: #dc2626;
          padding: 4px 12px; border-radius: 4px;
        }
        .fp-card-body { padding: 1.1rem 1.2rem 1.3rem; display: flex; flex-direction: column; gap: 0.35rem; flex: 1; }
        .fp-brand { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #2563eb; }
        .fp-name { font-size: 1rem; font-weight: 700; color: #0f172a; letter-spacing: -0.3px; margin: 0; line-height: 1.3; }
        .fp-meta { font-size: 0.78rem; color: #64748b; display: flex; align-items: center; gap: 0.4rem; }
        .fp-dot { color: #cbd5e1; }
        .fp-foot { margin-top: auto; padding-top: 0.8rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
        .fp-price { color: #0f172a; font-weight: 800; font-size: 1.05rem; letter-spacing: -0.3px; }
        .fp-from { display: block; font-size: 0.65rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.06em; }
        .fp-buy { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.5rem 0.9rem; border-radius: 50px; background: #eff6ff; border: 1px solid #bfdbfe; color: #2563eb; font-weight: 700; font-size: 0.8rem; text-decoration: none; transition: all 0.3s ease; }
        .fp-buy:hover { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; border-color: transparent; transform: translateY(-2px); }

        /* ═══ Mobile Responsive Fixes for Product Cards ═══ */
        @media (max-width: 768px) {
          .fp-card {
            border-radius: 0.75rem;
          }
          .fp-card-media {
            aspect-ratio: 1 / 1;
          }
          .fp-card-body {
            padding: 0.9rem 1rem 1rem;
            gap: 0.25rem;
          }
          .fp-brand {
            font-size: 0.65rem;
          }
          .fp-name {
            font-size: 0.9rem;
            line-height: 1.25;
          }
          .fp-meta {
            font-size: 0.72rem;
          }
          .fp-price {
            font-size: 0.95rem;
          }
          .fp-from {
            font-size: 0.6rem;
          }
          .fp-buy {
            padding: 0.4rem 0.75rem;
            font-size: 0.75rem;
          }
          .fp-tag {
            font-size: 0.6rem;
            padding: 3px 8px;
            top: 8px;
          }
          .fp-tag-inverter {
            left: 8px;
          }
          .fp-tag-stock {
            right: 8px;
          }
        }

        @media (max-width: 480px) {
          .fp-card-body {
            padding: 0.75rem 0.85rem 0.85rem;
          }
          .fp-name {
            font-size: 0.85rem;
          }
          .fp-price {
            font-size: 0.9rem;
          }
          .fp-buy {
            padding: 0.35rem 0.65rem;
            font-size: 0.7rem;
          }
        }

        /* Keep wizard post-purchase button styled */
        .btn-add-cart {
          background: linear-gradient(135deg, #3b82f6, #2563eb);
          color: #fff;
          border: none;
          border-radius: 50px;
          font-weight: 700;
          text-decoration: none;
          transition: all 0.25s ease;
        }
        .btn-add-cart:hover { background: linear-gradient(135deg, #60a5fa, #3b82f6); color: #fff; transform: translateY(-2px); }

        .product-order-success-panel {
          margin: 1rem;
          padding: 3rem 1.5rem;
          border: 1px solid #86efac;
          border-radius: 20px;
          background: linear-gradient(145deg, #f0fdf4, #dcfce7);
          color: #14532d;
        }
        .product-order-success-icon {
          display: grid;
          width: 76px;
          height: 76px;
          place-items: center;
          margin: 0 auto 1rem;
          border-radius: 50%;
          background: #16a34a;
          color: #fff;
          font-size: 2.6rem;
          box-shadow: 0 12px 28px rgba(22,163,74,.28);
        }
        .product-order-success-panel h4 { color: #166534; }
        .product-order-success-reference {
          display: inline-block;
          padding: .65rem 1.25rem;
          border: 1px solid #86efac;
          border-radius: 999px;
          background: #fff;
          color: #15803d;
          font-size: 1.2rem;
          font-weight: 800;
          letter-spacing: 1px;
        }
        .product-order-success-panel a { color: #15803d; }
        .btn-order-success {
          border: 0;
          border-radius: 50px;
          background: linear-gradient(135deg,#16a34a,#15803d);
          color: #fff;
          font-weight: 700;
          text-decoration: none;
          box-shadow: 0 7px 18px rgba(22,163,74,.24);
        }
        .btn-order-success:hover { background: linear-gradient(135deg,#22c55e,#16a34a); color: #fff; transform: translateY(-1px); }

        /* ── Modal Wizard Styles ── */
        .wizard-modal>.modal-dialog {
          max-width: 960px;
        }

        .wizard-modal .modal-content {
          border: none;
          border-radius: 16px;
          overflow: hidden;
          box-shadow: 0 25px 80px rgba(0,0,0,0.2);
          background: #fff;
        }

        .wizard-modal .modal-header {
          background: linear-gradient(135deg, #f0f7ff 0%, #dbeafe 50%, #eff6ff 100%);
          border-bottom: 1px solid rgba(37,99,235,0.1);
          padding: 1.25rem 1.75rem 1rem;
          position: relative;
          z-index: 2;
        }

        .wizard-modal .modal-header::before {
          content: '';
          position: absolute;
          inset: 0;
          background-image: radial-gradient(rgba(37,99,235,0.04) 1px, transparent 1px);
          background-size: 16px 16px;
          pointer-events: none;
        }

        .wizard-modal .modal-header .modal-title {
          color: #0f172a;
          font-weight: 700;
          font-size: 1.1rem;
          letter-spacing: -0.3px;
          position: relative;
        }

        .wizard-modal .modal-header .btn-close {
          opacity: 0.5;
          transition: all 0.2s;
          width: 1.75rem;
          height: 1.75rem;
          padding: 0;
          filter: brightness(0) invert(1);
        }

        .wizard-modal .modal-header .btn-close:hover {
          opacity: 1;
          transform: rotate(90deg);
        }

        .wizard-modal .modal-body {
          padding: 0;
          background: #fafbfc;
        }

        .wizard-modal .modal-footer {
          border-top: 1px solid #e2e8f0;
          padding: 1.25rem 1.75rem;
          background: #fff;
        }
        #productOrderModal .checkout-focus-cue { outline: 3px solid rgba(220, 38, 38, .55); outline-offset: 3px; border-radius: 8px; }

        /* Progress indicator */
        .wizard-progress {
          display: flex;
          justify-content: center;
          gap: 0;
          padding: 1.5rem 1.75rem 1rem;
          background: linear-gradient(135deg, #f0f7ff 0%, #dbeafe 50%, #eff6ff 100%);
          border-bottom: 1px solid rgba(37,99,235,0.1);
          position: relative;
          z-index: 1;
        }

        .wizard-progress::before {
          content: '';
          position: absolute;
          inset: 0;
          background-image: radial-gradient(rgba(37,99,235,0.04) 1px, transparent 1px);
          background-size: 16px 16px;
          pointer-events: none;
        }

        .wizard-step-indicator {
          display: flex;
          align-items: center;
          position: relative;
          z-index: 2;
          flex-direction: column;
        }

        .wizard-step-dot {
          width: 34px;
          height: 34px;
          border-radius: 10px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 0.8rem;
          font-weight: 700;
          color: #94a3b8;
          background: #fff;
          border: 1.5px solid #e2e8f0;
          transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
          position: relative;
        }

        .wizard-step-dot.active {
          color: #fff;
          background: linear-gradient(135deg, #3b82f6, #2563eb);
          border-color: transparent;
          box-shadow: 0 4px 12px rgba(37,99,235,0.35);
          transform: scale(1.08);
        }

        .wizard-step-dot.completed {
          color: #fff;
          background: linear-gradient(135deg, #4ade80, #22c55e);
          border-color: transparent;
          box-shadow: 0 4px 12px rgba(34,197,94,0.35);
        }

        .wizard-step-line {
          width: 40px;
          height: 2px;
          background: #e2e8f0;
          margin: 0 0.4rem;
          transition: all 0.3s ease;
          position: relative;
          z-index: 2;
          margin-top: 17px;
        }

        .wizard-step-line.completed {
          background: linear-gradient(90deg, #4ade80, #22c55e);
        }

        .wizard-step-line.active {
          background: linear-gradient(90deg, #60a5fa, #3b82f6);
        }

        .wizard-step-label {
          font-size: 0.58rem;
          color: #94a3b8;
          text-align: center;
          margin-top: 0.5rem;
          font-weight: 600;
          transition: all 0.3s;
          text-transform: uppercase;
          letter-spacing: 0.8px;
          white-space: nowrap;
        }

        .wizard-step-label.active {
          color: #2563eb;
        }

        .wizard-step-label.completed {
          color: #16a34a;
        }

        /* Wizard content panels */
        .wizard-panel {
          display: none;
          padding: 1.75rem 2rem;
          animation: fadeSlideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .wizard-panel.active {
          display: block;
        }

        @keyframes fadeSlideUp {
          from { opacity: 0; transform: translateY(8px); }
          to { opacity: 1; transform: translateY(0); }
        }

        .wizard-panel .step-header {
          text-align: center;
          margin-bottom: 1.5rem;
        }

        .wizard-panel .step-header h4 {
          font-weight: 700;
          color: #0f172a;
          letter-spacing: -0.5px;
          font-size: 1.2rem;
          margin-bottom: 0.35rem;
        }

        .wizard-panel .step-header p {
          color: #64748b;
          font-weight: 500;
          font-size: 0.85rem;
          margin: 0;
        }

        .login-overlay {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: rgba(255,255,255,0.95);
          backdrop-filter: blur(6px);
          -webkit-backdrop-filter: blur(6px);
          z-index: 999;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          animation: fadeSlideUp 0.2s ease;
        }

        @keyframes floatImage {
          0% { transform: translateY(0px); }
          50% { transform: translateY(-6px); }
          100% { transform: translateY(0px); }
        }

        .floating-img {
          animation: floatImage 6s ease-in-out infinite;
        }

        /* HP variant selector — card grid */
        #wizardHpOptions {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 0.75rem;
        }

        .hp-card {
          cursor: pointer;
          padding: 1.25rem;
          border-radius: 12px;
          border: 1.5px solid #e2e8f0;
