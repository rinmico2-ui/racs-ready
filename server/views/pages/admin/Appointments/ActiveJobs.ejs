                <div class="pm-row"><span class="pm-lbl">Labor</span><span class="pm-val">₱${(b.quotation.laborCost||0).toLocaleString()}</span></div>
                <div class="pm-row" style="border-top:2px solid #e2e8f0;padding-top:8px;"><span class="pm-lbl">Total</span><span class="pm-val" style="font-size:1.05rem;">₱${(b.quotation.totalCost||0).toLocaleString()}</span></div>
                ${b.quotation.notes ? `<div class="pm-row"><span class="pm-lbl">Notes</span><span class="pm-val" style="font-weight:400;">${b.quotation.notes}</span></div>` : ''}
