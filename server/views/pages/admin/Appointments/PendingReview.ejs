  .ent-detail-card-content { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ent-detail-label { font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; }
  .ent-detail-value { font-size: 0.88rem; font-weight: 600; color: #1e293b; }
