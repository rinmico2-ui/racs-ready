<footer class="premium-footer text-white py-5 position-relative overflow-hidden">
  <!-- Animated glow orbs -->
  <div class="position-absolute rounded-circle footer-orb orb-1" style="width:400px;height:400px;background:radial-gradient(circle,rgba(59,130,246,0.15) 0%,transparent 70%);top:-150px;left:-100px;pointer-events:none;animation:orbDrift 20s ease-in-out infinite alternate;"></div>
  <div class="position-absolute rounded-circle footer-orb orb-2" style="width:300px;height:300px;background:radial-gradient(circle,rgba(96,165,250,0.1) 0%,transparent 70%);bottom:-100px;right:-50px;pointer-events:none;animation:orbDrift 24s ease-in-out infinite alternate-reverse;"></div>
  
  <div class="container position-relative" style="z-index:1;">
    <div class="row g-4">
      <div class="col-md-4">
        <div class="footer-brand d-flex align-items-center gap-2 mb-3">
          <div class="footer-brand-icon">
            <i class="bi bi-snow2 fs-3"></i>
          </div>
          <span class="fw-bold text-uppercase footer-brand-text"><%= locals.companyName || 'CALIDRO RACS' %></span>
        </div>
        <p class="mb-3 footer-description"><%= locals.companyTagline || 'Premium air conditioning & appliance care powered by transparent service and certified technicians.' %></p>
        <div class="d-flex gap-2">
          <a href="#" class="footer-pill" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
          <a href="#" class="footer-pill" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
          <a href="#" class="footer-pill" aria-label="Youtube"><i class="bi bi-youtube"></i></a>
        </div>
      </div>
      <div class="col-md-4">
        <h6 class="footer-heading text-uppercase small">Quick Links</h6>
        <ul class="list-unstyled footer-links">
          <li><a href="/services" class="footer-link"><i class="bi bi-arrow-right-short"></i> Services</a></li>
          <li><a href="/products" class="footer-link"><i class="bi bi-arrow-right-short"></i> Products</a></li>
          <li><a href="/about" class="footer-link"><i class="bi bi-arrow-right-short"></i> About Us</a></li>
          <li><a href="/contact" class="footer-link"><i class="bi bi-arrow-right-short"></i> Contact</a></li>
        </ul>
      </div>
      <div class="col-md-4">
        <h6 class="footer-heading text-uppercase small">Contact</h6>
        <div class="footer-contact-item">
          <i class="bi bi-geo-alt-fill"></i>
          <span><%= locals.companyAddress || 'San Leonardo, Nueva Ecija' %></span>
        </div>
        <div class="footer-contact-item">
          <i class="bi bi-telephone-fill"></i>
          <span><%= locals.companyPhone || '0965 605 6495' %></span>
        </div>
        <div class="footer-contact-item">
          <i class="bi bi-envelope-fill"></i>
          <span><%= locals.companyEmail || 'calidroracs@gmail.com' %></span>
        </div>
      </div>
    </div>
    <div class="footer-copyright text-center mt-5 pt-4">
      <div class="copyright-line"></div>
      <p class="mb-0 mt-3">&copy; <%= new Date().getFullYear() %> <%= locals.companyName || 'CALIDRO RACS' %>. All rights reserved.</p>
    </div>
  </div>

  <style>
    @keyframes orbDrift {
      0% { transform: translate(0, 0); }
      100% { transform: translate(30px, 20px); }
    }
    .premium-footer {
      background: linear-gradient(160deg, #050b1d 0%, #0a1628 50%, #0f2149 100%);
      border-top: 1px solid rgba(255,255,255,0.08);
      position: relative;
    }
    .footer-brand-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(37,99,235,0.4);
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .footer-brand-icon i {
      color: #fff;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
    }
    .footer-brand:hover .footer-brand-icon {
      transform: scale(1.1) rotate(-5deg);
      box-shadow: 0 12px 32px rgba(37,99,235,0.5);
    }
    .footer-brand-text {
      letter-spacing: 0.15em;
      font-size: 1.1rem;
      background: linear-gradient(135deg, #fff 0%, #93c5fd 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .footer-description {
      color: rgba(147,197,253,0.7);
      line-height: 1.7;
      font-size: 0.95rem;
    }
    .footer-heading {
      color: rgba(255,255,255,0.5);
      letter-spacing: 0.2em;
      font-weight: 700;
      margin-bottom: 1.25rem;
      position: relative;
      padding-bottom: 0.75rem;
    }
    .footer-heading::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 40px;
      height: 3px;
      background: linear-gradient(90deg, #3b82f6, #60a5fa);
      border-radius: 999px;
    }
    .footer-link {
      color: rgba(203,213,245,0.8);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 0;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
      font-weight: 500;
    }
    .footer-link i {
      opacity: 0;
      transform: translateX(-10px);
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      color: #60a5fa;
    }
    .footer-link:hover {
      color: #fff;
      transform: translateX(8px);
    }
    .footer-link:hover i {
      opacity: 1;
      transform: translateX(0);
    }
    .footer-contact-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.6rem 0;
      color: rgba(203,213,245,0.8);
      transition: all 0.3s ease;
    }
    .footer-contact-item i {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: rgba(59,130,246,0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #60a5fa;
      font-size: 0.9rem;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .footer-contact-item:hover {
      color: #fff;
      transform: translateX(5px);
    }
    .footer-contact-item:hover i {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      color: #fff;
      transform: scale(1.1);
      box-shadow: 0 8px 20px rgba(37,99,235,0.4);
    }
    .footer-pill {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1.5px solid rgba(255,255,255,0.2);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: rgba(255,255,255,0.8);
      background: rgba(255,255,255,0.05);
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
      overflow: hidden;
    }
    .footer-pill::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .footer-pill i {
      position: relative;
      z-index: 1;
      transition: transform 0.3s ease;
    }
    .footer-pill:hover {
      border-color: transparent;
      transform: translateY(-4px) scale(1.1);
      box-shadow: 0 12px 28px rgba(37,99,235,0.5);
    }
    .footer-pill:hover::before {
      opacity: 1;
    }
    .footer-pill:hover i {
      transform: scale(1.2);
    }
    .footer-copyright {
      position: relative;
    }
    .copyright-line {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    }
    .footer-copyright p {
      color: rgba(147,197,253,0.6);
      font-size: 0.85rem;
      letter-spacing: 0.05em;
    }
  </style>
</footer>
