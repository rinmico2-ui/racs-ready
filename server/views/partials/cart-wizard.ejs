<div class="modal fade wizard-modal" id="checkoutOrderModal" tabindex="-1" aria-hidden="true" aria-labelledby="wizardModalTitle">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
    <div class="modal-content border-0 shadow-lg checkout-wizard-shell">
      <div class="modal-header checkout-wizard-header">
        <div class="checkout-wizard-heading">
          <div class="checkout-wizard-eyebrow"><i class="bi bi-shield-check"></i> Your order</div>
          <h5 class="modal-title" id="wizardModalTitle" aria-live="polite">
            <i class="bi bi-truck me-2" style="color:#2563eb;"></i>Choose how to receive your order
          </h5>
        </div>
        <button type="button" class="btn-close checkout-wizard-close" data-bs-dismiss="modal" aria-label="Close checkout"></button>
      </div>

      <!-- Progress Steps -->
      <div class="wizard-progress" id="wizardProgress">
        <div class="wizard-ph">
          <span>Your progress</span>
          <span>Step <span id="wizardStepCurrent">1</span> of 4</span>
        </div>
        <div class="wizard-pt" role="navigation" aria-label="Checkout steps">
          <button type="button" class="wizard-ps active" data-step="1" aria-current="step" onclick="navigateWizardStep(1)">
            <span class="wizard-ps-icon"><i class="bi bi-truck"></i></span>
            <span>Get order</span>
          </button>
          <button type="button" class="wizard-ps" data-step="2" onclick="navigateWizardStep(2)">
            <span class="wizard-ps-icon"><i class="bi bi-calendar-check"></i></span>
            <span>Address &amp; date</span>
          </button>
          <button type="button" class="wizard-ps" data-step="3" onclick="navigateWizardStep(3)">
            <span class="wizard-ps-icon"><i class="bi bi-credit-card"></i></span>
            <span>Payment</span>
          </button>
          <button type="button" class="wizard-ps" data-step="4" onclick="navigateWizardStep(4)">
            <span class="wizard-ps-icon"><i class="bi bi-receipt"></i></span>
            <span>Check order</span>
          </button>
        </div>
        <p class="wizard-progress-help"><i class="bi bi-info-circle me-1"></i>Go one step at a time. Use Back if you need to change something.</p>
      </div>

      <div class="modal-body position-relative checkout-wizard-body">

        <!-- STEP 1 — Fulfillment Option -->
        <div class="wizard-panel active" id="wizardStep1">
          <div class="wizard-step-intro">
            <p>Choose delivery or store pickup. Installation is free with delivery, but a delivery fee applies.</p>
          </div>
          <div class="row g-3 justify-content-center checkout-choice-grid">
            <div class="col-12 col-md-6">
              <div class="fulfill-card h-100"
                data-fulfill="delivery_installation" role="button" tabindex="0" aria-pressed="false"
                onclick="selectFulfillment('delivery_installation')"
                onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();selectFulfillment('delivery_installation')}">
                <span class="checkout-choice-check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                <div class="fulfill-icon fulfill-icon-delivery">
                  <i class="bi bi-tools fs-2"></i></div>
                <div class="fulfill-copy">
                  <div class="fulfill-title">Delivery + Installation</div>
                  <div class="fulfill-desc">We bring the aircon to you and install it for free. The delivery fee depends on your address.</div>
                  <span class="fulfill-meta"><i class="bi bi-check-circle"></i> Free installation</span>
                </div>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="fulfill-card h-100"
                data-fulfill="customer_pickup" role="button" tabindex="0" aria-pressed="false"
                onclick="selectFulfillment('customer_pickup')"
                onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();selectFulfillment('customer_pickup')}">
                <span class="checkout-choice-check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                <div class="fulfill-icon fulfill-icon-pickup">
                  <i class="bi bi-shop fs-2"></i></div>
                <div class="fulfill-copy">
                  <div class="fulfill-title">Pick Up at Store</div>
                  <div class="fulfill-desc">Get your aircon from our store. Installation is not included.</div>
                  <span class="fulfill-meta"><i class="bi bi-calendar-check"></i> Choose a pickup date</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 2 — Delivery / Pickup Details -->
        <div class="wizard-panel" id="wizardStep2">
          <div class="px-md-2">
            <div class="wizard-step-intro">
              <p>Add your address and choose a date. Check the map pin so we can show your delivery fee.</p>
            </div>
            <!-- Delivery fields -->
            <div id="deliveryFields" class="checkout-form-card" style="display:none;">
              <div class="checkout-section-heading">
                <span class="checkout-section-number">1</span>
                <div><h6>Phone number and address</h6><p>Enter a number we can call, then check the delivery pin on the map.</p></div>
              </div>

              <!-- 1. Contact Number (auto-populated) -->
              <div class="col-md-6 mb-3">
                <label class="form-label small fw-bold"><i class="bi bi-telephone me-1 text-primary"></i> Contact
                  Number</label>
                <input type="tel" class="form-control form-control-sm rounded-3 py-2" id="wizardContact"
                  placeholder="09XXX XXX XXX" inputmode="tel" autocomplete="tel" maxlength="50">
              </div>

              <!-- 2. Delivery Address -->
              <div class="mb-3 position-relative">
                <label class="form-label small fw-bold"><i class="bi bi-house me-1 text-primary"></i> Full Delivery
                  Address</label>
                <div class="input-group input-group-sm">
                  <input type="text" class="form-control rounded-start-3 py-2" id="wizardAddress"
                    placeholder="Enter full street address..." autocomplete="street-address" maxlength="500">
                  <button class="btn btn-outline-primary border-start-0 rounded-end-3 px-3" type="button"
                    id="searchAddressBtn" aria-label="Search delivery address">
                    <i class="bi bi-search"></i>
                  </button>
                </div>
                <!-- Suggestions Dropdown -->
                <div id="addressSuggestions"
                  class="list-group position-absolute w-100 mt-1 shadow-lg border-0 rounded-3 overflow-hidden"
                  style="display: none; z-index: 1060; max-height: 200px; overflow-y: auto;"></div>
              </div>

              <!-- 3. Map for location pinning -->
              <div class="mb-3">
                <div class="checkout-map-card" id="checkoutMapCard">
                  <div class="checkout-map-toolbar">
                    <div>
                      <h6 class="checkout-map-title"><i class="bi bi-map me-2 text-primary"></i>Delivery Route Map</h6>
                      <div class="checkout-map-subtitle">Search for your address or move the red pin to your house.</div>
                    </div>
                    <div class="checkout-map-actions" aria-label="Map controls">
                      <button type="button" class="checkout-map-action" id="locateMeBtn" onclick="locateMe()" title="Use my current location" aria-describedby="mapAccessNotice">
                        <i class="bi bi-crosshair"></i><span>My Location</span>
                      </button>
                      <button type="button" class="checkout-map-action" id="fitRouteBtn" onclick="fitDeliveryRoute()" title="Show the full delivery route" disabled>
                        <i class="bi bi-arrows-fullscreen"></i><span>Fit Route</span>
                      </button>
                      <button type="button" class="checkout-map-action" id="expandMapBtn" onclick="toggleCheckoutMapSize()" title="Expand map">
                        <i class="bi bi-fullscreen"></i><span>Expand</span>
                      </button>
                    </div>
                  </div>

                  <div class="map-access-notice d-none" id="mapAccessNotice" role="status" aria-live="polite"></div>

                  <div class="checkout-map-stage">
                    <div id="wizardMap" role="application" tabindex="0" aria-label="Interactive delivery route map. Select a point or move the delivery pin."></div>
                    <div class="map-locating-spinner" id="mapLocatingSpinner">
                      <span class="spinner-border spinner-border-sm" role="status"></span>
                      <span id="mapSpinnerLabel">Checking delivery fee...</span>
                    </div>
                    <div class="checkout-map-legend" aria-label="Map legend">
                      <span><i class="map-legend-dot"></i>CALIDRO RACS</span>
                      <span><i class="map-legend-dot customer"></i>Delivery location</span>
                    </div>
                  </div>

                  <div class="map-selection-panel" id="mapSelectionPanel" aria-live="polite">
                    <div class="map-selection-address">
                      <span class="map-selection-icon"><i class="bi bi-geo-alt"></i></span>
                      <div class="min-w-0">
                        <div class="map-selection-status" id="mapSelectionStatus">Location not pinned</div>
                        <div class="map-address-preview" id="mapAddressPreview">Choose a search result or select an exact point on the map.</div>
                      </div>
                    </div>
                    <div class="map-coordinate-card" hidden>
                      <div class="map-coordinate-label">Coordinates</div>
                      <div class="map-coordinate-value" id="mapCoordinateDisplay">Not selected</div>
                      <div class="map-coordinate-source" id="mapCoordinateSource">Waiting for location</div>
                    </div>
                  </div>
                </div>

                <!-- ── Route Details Panel ───────────────────── -->
                <div class="route-info-panel" id="routeInfoPanel">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-bold" style="font-size:0.8rem;color:#1e293b;"><i class="bi bi-signpost-2 me-1" style="color:#6366f1;"></i> Delivery fee details</span>
                    <span class="route-method-badge" id="routeMethodBadge"><i class="bi bi-diagram-3 me-1"></i>By road</span>
                  </div>
                  <div class="d-flex gap-2 mb-1 route-stats-grid">
                    <div class="route-stat-card">
                      <span class="route-stat-icon text-primary"><i class="bi bi-rulers"></i></span>
                      <span class="route-stat-label">Distance</span>
                      <span class="route-stat-value" id="routeDistDisplay">— km</span>
                    </div>
                    <div class="route-stat-card">
                      <span class="route-stat-icon text-warning"><i class="bi bi-clock"></i></span>
                      <span class="route-stat-label">Travel time</span>
                      <span class="route-stat-value" id="routeDurDisplay">— min</span>
                    </div>
                    <div class="route-stat-card">
                      <span class="route-stat-icon" style="color:#4f46e5;"><i class="bi bi-tag"></i></span>
                      <span class="route-stat-label">Fee per km</span>
                      <span class="route-stat-value" id="routeRateDisplay" style="color:#4f46e5;">₱—/km</span>
                    </div>
                    <div class="route-stat-card" style="border-color:#a5b4fc;background:linear-gradient(135deg,#eef2ff,#f0f4ff);">
                      <span class="route-stat-icon" style="color:#4f46e5;"><i class="bi bi-truck"></i></span>
                      <span class="route-stat-label">Delivery Fee</span>
                      <span class="route-stat-value fare-value" id="routeFareDisplay">₱—</span>
                    </div>
                  </div>
                  <div class="route-calculation-detail" id="routeCalcFormula"></div>
                </div>

                <input type="hidden" id="wizardLat">
                <input type="hidden" id="wizardLng">
              </div>

              <div class="checkout-section-heading checkout-schedule-heading">
                <span class="checkout-section-number">2</span>
              <div><h6>Choose a date and time</h6><p>Pick an open date, then choose when we should start. We will confirm your requested time.</p></div>
              </div>
              <div id="checkoutCalendarContainer" class="checkout-calendar-wrap"></div>

              <!-- Hidden inputs to store selection -->
              <input type="hidden" id="wizardDate">
              <input type="hidden" id="wizardTimeSlot">
              <div class="small mt-1 text-danger fw-semibold" id="wizardDateError" style="display: none;"></div>

              <!-- 6. Notes -->
              <div class="checkout-notes-field">
                <label class="form-label small fw-bold"><i class="bi bi-chat-left-text me-1 text-primary"></i> Notes
                  (optional)</label>
                <textarea class="form-control form-control-sm rounded-3" id="wizardNotes" rows="2"
                  placeholder="Specific gate codes or delivery instructions..." maxlength="1000"></textarea>
              </div>
            </div>

            <!-- Pickup fields -->
            <div id="pickupFields" class="pickup-panel" style="display:none;">
              <div class="checkout-section-heading checkout-section-heading-pickup">
                <span class="checkout-section-number">1</span>
                <div><h6>Choose your pickup date</h6><p>Only available store days can be selected.</p></div>
              </div>

              <div class="pickup-store">
                <i class="bi bi-shop pickup-store-bg-icon"></i>
                <div class="pickup-store-name"><i class="bi bi-geo-alt-fill me-2"></i>CALIDRO RACS Main Store</div>
                <p class="pickup-store-note">We will send the store address after your order is confirmed.</p>
                <div id="storeHoursInfo" class="mt-2" style="font-size:0.78rem; color:#0369a1; font-weight:600;"></div>
              </div>

              <div class="pickup-date-wrap">
                <label class="pickup-date-label"><i class="bi bi-calendar-event me-1 text-success"></i> Pick a pickup date</label>
                <input type="text" class="pickup-date-input" id="wizardPickupDate" placeholder="Select a date...">
                <div class="pickup-calendar-wrapper"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 3 — Payment Option -->
        <div class="wizard-panel" id="wizardStep3">
          <div class="wizard-step-intro">
            <p>Choose how much to pay now, then choose how to send it. We will show the amount before you upload a receipt.</p>
          </div>

          <div id="cartCheckoutRestoreNotice" class="alert alert-info d-none mx-md-3" role="status">
            <i class="bi bi-arrow-clockwise me-2"></i><strong>Your details were saved.</strong>
            Enter your payment number again and upload your receipt photo to continue.
          </div>
          
          <div class="row g-3 px-md-3 customer-payment-options" id="paymentOptionsContainer">
             <!-- Options dynamically rendered by JS based on fulfillment type -->
          </div>
          <input type="hidden" id="wizardPaymentMethod" value="">

          <div id="orderPaymentChannelSection" class="payment-channel-section d-none mx-md-3">
            <div class="payment-channel-title"><i class="bi bi-wallet2 me-1"></i>Pay via</div>
            <div class="payment-channel-options" role="group" aria-label="Payment method">
              <button type="button" class="payment-channel-card" data-channel="gcash" aria-pressed="false">GCash</button>
              <button type="button" class="payment-channel-card" data-channel="maya" aria-pressed="false">Maya</button>
              <button type="button" class="payment-channel-card" data-channel="bank_transfer" aria-pressed="false">Bank Transfer</button>
              <button type="button" class="payment-channel-card" data-channel="other" aria-pressed="false">Other Transfer</button>
            </div>
            <input type="hidden" id="wizardPaymentChannel" value="">
            <div id="wizardPaymentChannelHelp" class="form-text mt-2">Select how you will send the payment.</div>
          </div>

          <div id="orderDownpaymentReason" class="downpayment-reason mx-md-3" role="note">
            <i class="bi bi-info-circle-fill"></i>
            <div><strong>Why pay part now?</strong><br>This holds your aircon and chosen date. This payment is part of your total, not an extra fee.</div>
          </div>

          <!-- Payment evidence panel -->
          <div id="gcashFieldsWizard" class="d-none mt-3 px-md-3">
            <div class="gcash-checkout-card customer-payment-panel">
              <h6 class="customer-payment-panel-title"><i class="bi bi-credit-card text-success"></i><span id="wizardGcashHeading">Payment</span></h6>

              <div class="rounded-3 p-3 mb-3 customer-payment-instructions" style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1px solid #16a34a;">
                <div class="d-flex align-items-center gap-2 mb-2">
                  <i class="bi bi-phone text-success fs-4"></i>
                  <span id="wizardPaymentInstructionTitle" class="fw-semibold">Send your payment</span>
                </div>
                <ol class="mb-0 ps-3 small text-muted" style="line-height:1.8;">
                  <li id="wizardPaymentInstructionFirst">Use the payment details provided by RACS.</li>
                  <li>Send the exact amount shown in the summary.</li>
                  <li>Upload a photo or screenshot of your payment receipt.</li>
                </ol>
              </div>

              <!-- QR Code -->
              <div id="wizardPaymentQrBlock" class="text-center mb-3 customer-payment-qr">
                <label data-gcash-qr-label class="form-label text-muted d-block fw-semibold d-none">Scan this GCash QR</label>
                <img id="gcashQrImageWizard" data-gcash-qr-image alt="CALIDRO GCash payment QR" class="img-thumbnail d-none" style="max-width:220px;border-radius:12px;" />
                <div class="customer-payment-recipient">GCash number: <strong id="gcashNumberDisplayWizard">Not configured</strong></div>
                <p data-gcash-qr-missing class="small text-muted mt-2 mb-0">Use the GCash number above to send your payment.</p>
                <div class="gcash-qr-actions"><a data-gcash-qr-download class="btn btn-outline-primary btn-sm d-none" href="#"><i class="bi bi-download me-1"></i>Download QR</a><a class="btn btn-outline-secondary btn-sm" href="https://gcash.com/getting-started" target="_blank" rel="noopener noreferrer"><i class="bi bi-box-arrow-up-right me-1"></i>GCash website</a></div>
                <p class="small text-muted mt-2 mb-0">On your phone, open GCash. If you saved the QR, tap QR and upload it. You can also send to the number above. Come back to upload your receipt.</p>
                <p class="small text-muted mt-1 mb-0">Check the recipient and any transfer fee in GCash before you send.</p>
              </div>

              <!-- Sender and receipt evidence -->
              <div class="customer-payment-fields">
              <div>
                <label id="wizardPaymentReferenceLabel" for="wizardGcashSenderNumber" class="form-label text-muted fw-bold">Payment Reference <span class="text-danger">*</span></label>
                <input id="wizardGcashSenderNumber" class="form-control" type="tel" inputmode="numeric" placeholder="Transaction or reference number" autocomplete="off" aria-describedby="wizardPaymentReferenceHelp wizardGcashSenderFeedback" />
                <div id="wizardPaymentReferenceHelp" class="form-text">Enter the reference shown on your payment receipt.</div>
                <div id="wizardGcashSenderFeedback" class="gcash-sender-feedback" role="status" aria-live="polite" hidden></div>
              </div>
              <div>
                <label class="form-label text-muted fw-bold">Payment receipt photo <span class="text-danger">*</span></label>
                <input id="gcashProofWizard" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required />
                <div class="form-text">Accepted: image files only (JPG, PNG, WEBP). Max 5MB.</div>
                <div id="gcashProofWarning" class="mt-2 p-2 rounded-3 d-none" style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;font-size:0.8rem;font-weight:600;">
                  <i class="bi bi-exclamation-triangle-fill me-1"></i>Please upload your payment receipt before proceeding.
                </div>
                <img id="gcashProofPreviewWizard" alt="GCash receipt preview" class="d-none customer-payment-proof-preview" />
              </div>
              </div>

              <!-- Payment Summary -->
              <div class="customer-payment-summary">
                <div class="customer-payment-summary-row">
                  <span>Order total</span>
                  <strong id="gcashTotalDisplayWizard">&mdash;</strong>
                </div>
                <div class="customer-payment-summary-row due">
                  <span id="wizardGcashLabel">Amount due now</span>
                  <strong id="gcashAmountDisplayWizard">&mdash;</strong>
                </div>
                <div class="customer-payment-summary-row" id="gcashBalanceRowWizard">
                  <span id="wizardGcashBalanceLabel">Amount to pay later</span>
                  <strong id="gcashBalanceDisplayWizard">&mdash;</strong>
                </div>
              </div>

              <div class="customer-payment-verification" role="status"><i class="bi bi-shield-check"></i><span><strong>We will check your receipt.</strong> Your order is not confirmed until our team checks your payment.</span></div>
            </div>
          </div>
        </div>

        <!-- STEP 4 — Review & Confirm -->
        <div class="wizard-panel" id="wizardStep4">
          <div class="wizard-step-intro">
            <p>Check your aircon, address or pickup date, and total. You can still go Back to change them.</p>
          </div>

          <div class="px-md-2">
            <div class="p-3 rounded-4 mb-3 bg-white border"
              style="border-color: #e2e8f0; box-shadow: 0 4px 15px rgba(15,36,96,0.03); max-height: 250px; overflow-y: auto;">
              <div id="cartItemsReviewList">
                <!-- Cart items will be listed here -->
              </div>
            </div>

            <div class="p-3 rounded-4 mb-2 bg-white border" style="border-color: #e2e8f0;">
              <h6 class="fw-bold fs-6 mb-2 border-bottom pb-2">Order Details</h6>
              <div id="reviewDetails" class="mb-1"></div>
            </div>

            <div class="p-4 rounded-4 position-relative overflow-hidden"
              style="background: linear-gradient(135deg, #eff6ff, #dbeafe); border: 1px solid rgba(59,130,246,0.2);">
              <div class="position-absolute rounded-circle"
                style="width: 150px; height: 150px; background: radial-gradient(circle, rgba(255,255,255,0.4) 0%, transparent 60%); top: -30px; right: -30px; pointer-events: none;">
              </div>
              <div class="position-relative z-index-1">
                <div class="review-row py-1">
                  <span class="review-label">Product Subtotal</span>
                  <span class="review-value" id="reviewSubtotal"></span>
                </div>
                <div id="transportBreakdownRow" style="display: none;">
                   <div class="review-row py-1 border-bottom-0 pb-0">
                      <span class="review-label">Delivery fee</span>
                      <span class="review-value" id="reviewTransportTotal">₱0</span>
                   </div>
                   <div class="ps-3 mb-2">
                      <span class="text-muted" style="font-size: 0.75rem;" id="reviewTransportCalc">0 km x ₱40/km</span>
                   </div>
                </div>
                <!-- Legacy/Backup row just in case -->
                <div class="review-row py-1" id="reviewDeliveryRow" style="display: none;">
                  <span class="review-label">Delivery Fee</span>
                  <span class="review-value" id="reviewDeliveryFee"></span>
                </div>
                <div class="review-row py-1" id="reviewInstallRow" style="display: none;">
                  <span class="review-label">Installation</span>
                  <span class="review-value" id="reviewInstallFee"></span>
                </div>
                <div
                  class="d-flex justify-content-between align-items-center mt-2 pt-3 border-top border-primary border-opacity-25">
                  <span class="text-uppercase fw-bold"
                    style="color: #475569; font-size: 0.8rem; letter-spacing: 1px;">Total to pay</span>
                  <span class="fw-bolder text-primary" style="font-size: 1.5rem; letter-spacing: -0.5px;"
                    id="reviewTotal"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer checkout-wizard-footer">
        <button type="button" class="btn btn-sm checkout-back-btn" id="wizardBackBtn" onclick="wizardBack()"
          style="border-radius: 8px; padding: 0.5rem 1.25rem; color: #64748b; font-weight: 600; display: none; border: 1.5px solid #e2e8f0; background: #fff; font-size: 0.82rem; transition: all 0.2s;"
          onmouseover="this.style.borderColor='#cbd5e1';this.style.background='#f8fafc'" onmouseout="this.style.borderColor='#e2e8f0';this.style.background='#fff'">
          <i class="bi bi-arrow-left me-1"></i>Back
        </button>
        <div class="ms-auto d-flex gap-2 checkout-footer-actions">
          <button type="button" class="btn btn-sm checkout-cancel-btn" data-bs-dismiss="modal"
            style="border-radius: 8px; padding: 0.5rem 1.25rem; font-weight: 600; color: #64748b; background: #fff; border: 1.5px solid #e2e8f0; font-size: 0.82rem; transition: all 0.2s;"
            onmouseover="this.style.borderColor='#cbd5e1';this.style.background='#f8fafc'" onmouseout="this.style.borderColor='#e2e8f0';this.style.background='#fff'">Cancel</button>
          <button type="button" class="btn btn-sm px-4 checkout-primary-btn" id="wizardNextBtn" onclick="wizardNext()"
            style="border-radius: 8px; padding: 0.55rem 1.75rem; font-weight: 600; background: linear-gradient(135deg, #2563eb, #3b82f6); color: #fff; border: none; font-size: 0.85rem; transition: all 0.2s; box-shadow: 0 4px 12px rgba(37,99,235,0.25);"
            onmouseover="this.style.transform='translateY(-1px)';this.style.boxShadow='0 6px 20px rgba(37,99,235,0.35)'" onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 12px rgba(37,99,235,0.25)'">
            Add address or pickup date <i class="bi bi-arrow-right ms-2"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/checkout-calendar.js?v=20260925-future-date-v3"></script>
<script src="/js/order-checkout-errors.js?v=20260925-valid-date-v3"></script>
<script src="/js/gcash-qr-actions.js?v=20260925-bundled-qr-v2"></script>
<script src="/js/gcash-sender-input.js?v=20260925-v1"></script>

<script>
  let cartObj = <%- JSON.stringify(typeof cart !== 'undefined' ? cart : {}).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026') %>;
  const USER_PHONE = <%- JSON.stringify((user && user.phone) ? user.phone : '').replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026') %>;

  // Fetch the delivery fare rate; installation is free with product delivery.
  window._farePerKm = 40;
  window.downpaymentPercentage = 10;
  window.gcashConfigurationLoaded = false;
  fetch('/api/services/fare-per-km')
    .then(r => r.json())
    .then(data => {
      if (data.farePerKm !== undefined) window._farePerKm = data.farePerKm;
    })
    .catch(() => console.warn('Failed to fetch pricing config'));
  fetch('/api/services/payment-policy')
    .then(r => r.json())
    .then(data => {
      const percentage = Number(data.downpaymentPercentage);
      window.paymentMethodsConfig = data.methods || {};
      if (Object.prototype.hasOwnProperty.call(data, 'gcashNumber')) {
        window.adminGcashNumber = String(data.gcashNumber || '');
      }
      window.gcashQrImageUrl = data.gcashQrImageUrl || '';
      window.GcashQrActions?.apply(window.gcashQrImageUrl);
      window.gcashConfigurationLoaded = true;
      document.querySelectorAll('#orderPaymentChannelSection .payment-channel-card').forEach(button => {
        const method = window.paymentMethodsConfig[button.dataset.channel];
        if (!method) return;
        button.disabled = method.available !== true;
        button.title = button.disabled ? `${method.label || 'This method'} is not currently available.` : '';
        if (button.dataset.channel === 'other' && method.label) button.textContent = method.label;
      });
      if (Number.isFinite(percentage) && percentage >= 1 && percentage <= 100) {
        window.downpaymentPercentage = percentage;
        const selectedMethod = document.getElementById('wizardPaymentMethod')?.value;
        if (selectedMethod && typeof window.selectPaymentMethods === 'function') window.selectPaymentMethods(selectedMethod);
      }
      if (typeof window.refreshCheckoutPaymentOptions === 'function') window.refreshCheckoutPaymentOptions();
    })
    .catch(() => {
      window.gcashConfigurationLoaded = true;
      console.warn('Using default downpayment policy');
    });

  // Company base location for distance calculation
  window._companyBaseLocation = { configured: false, lat: 14.676049, lng: 121.043731 };
  window._companyBaseLocationPromise = fetch('/api/public/company/location')
    .then(r => r.json())
    .then(d => { window._companyBaseLocation = d || window._companyBaseLocation; return window._companyBaseLocation; })
    .catch(() => window._companyBaseLocation);

  (function () {
    function escapeCheckoutHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' })[char]);
    }

    function safeCheckoutImageUrl(value) {
      const url = String(value || '').trim();
      if (/^\/(?!\/)/.test(url) || /^https:\/\//i.test(url)) return escapeCheckoutHtml(url);
      return '/images/products/default.png';
    }

    let currentStep = 1;
    let selectedFulfillment = null;
    let renderedPaymentFulfillment = null;
    let leafletMap = null;
    let leafletMarker = null;
    let fpDateDelivery = null;
    let fpDatePickup = null;
    let addressSearchTimeout = null;
    let checkoutCalendar = null;
    let _routeDistanceKm = 0;
    let _routeDurationMin = 0;
    let _transportFee = 0;
    let _customerLocationSelected = false;
    let _lastCustomerLat = null;
    let _lastCustomerLng = null;
    let _streetMapLayer = null;
    let _satelliteMapLayer = null;
    let _routeRequestId = 0;
    let _reverseGeocodeRequestId = 0;
    let _routeQuotePending = null;
    let _routeQuoteError = null;
    let _checkoutSubmitting = false;
    let _checkoutRequestId = '';
    let _guidedFocusTimer = null;
    let _autoAdvanceTimer = null;
    let _cartDraftSaveTimer = null;
    let _restoringCartDraft = false;

    const CART_CHECKOUT_DRAFT_KEY = 'racs_cart_checkout_draft_v1';
    const CART_CHECKOUT_DRAFT_MAX_AGE_MS = 30 * 60 * 1000;

    function cartCheckoutSignature() {
      return CART_ITEMS.map(item => {
        const inventoryId = item?.inventoryId?._id || item?.inventoryId || '';
        return `${inventoryId}:${Number(item?.quantity) || 1}`;
      }).sort().join('|');
    }

    function checkoutFieldValue(id) {
      return document.getElementById(id)?.value || '';
    }

    function readCartCheckoutDraft() {
      try {
        const raw = localStorage.getItem(CART_CHECKOUT_DRAFT_KEY);
        if (!raw) return null;
        const draft = JSON.parse(raw);
        const expired = !draft?.savedAt || Date.now() - Number(draft.savedAt) > CART_CHECKOUT_DRAFT_MAX_AGE_MS;
        if (expired || draft.cartSignature !== cartCheckoutSignature()) {
          localStorage.removeItem(CART_CHECKOUT_DRAFT_KEY);
          return null;
        }
        return draft;
      } catch (_) {
        try { localStorage.removeItem(CART_CHECKOUT_DRAFT_KEY); } catch (_) {}
        return null;
      }
    }

    function saveCartCheckoutDraft() {
      if (_checkoutSubmitting || _restoringCartDraft || !selectedFulfillment) return false;
      try {
        const draft = {
          savedAt: Date.now(),
          cartSignature: cartCheckoutSignature(),
          currentStep,
          selectedFulfillment,
          paymentMethod: checkoutFieldValue('wizardPaymentMethod'),
          paymentChannel: checkoutFieldValue('wizardPaymentChannel'),
          contactNumber: checkoutFieldValue('wizardContact'),
          address: checkoutFieldValue('wizardAddress'),
          notes: checkoutFieldValue('wizardNotes'),
          latitude: checkoutFieldValue('wizardLat'),
          longitude: checkoutFieldValue('wizardLng'),
          preferredDate: checkoutFieldValue('wizardDate'),
          timeSlot: checkoutFieldValue('wizardTimeSlot'),
          pickupDate: checkoutFieldValue('wizardPickupDate'),
          routeDistanceKm: _routeDistanceKm,
          routeDurationMin: _routeDurationMin,
          transportationFee: _transportFee,
          checkoutRequestId: _checkoutRequestId
        };
        // Payment references and receipt files are intentionally excluded.
        localStorage.setItem(CART_CHECKOUT_DRAFT_KEY, JSON.stringify(draft));
        return true;
      } catch (_) {
        return false;
      }
    }

    function scheduleCartCheckoutDraftSave() {
      clearTimeout(_cartDraftSaveTimer);
      _cartDraftSaveTimer = setTimeout(saveCartCheckoutDraft, 120);
    }

    function clearCartCheckoutDraft() {
      clearTimeout(_cartDraftSaveTimer);
      try { localStorage.removeItem(CART_CHECKOUT_DRAFT_KEY); } catch (_) {}
    }

    function prefersReducedCheckoutMotion() {
      return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    }

    function waitForOrderLoadingMinimum(startedAt, minimumMs) {
      const target = prefersReducedCheckoutMotion() ? 200 : (minimumMs || 900);
      const remaining = Math.max(0, target - (Date.now() - startedAt));
      return remaining ? new Promise(resolve => setTimeout(resolve, remaining)) : Promise.resolve();
    }

    function hideModalBeforeLoading(modalElement, modalInstance) {
      if (!modalElement || !modalInstance || !modalElement.classList.contains('show')) return Promise.resolve();
      return new Promise(resolve => {
        let finished = false;
        const done = () => {
          if (finished) return;
          finished = true;
          resolve();
        };
        modalElement.addEventListener('hidden.bs.modal', done, { once:true });
        modalInstance.hide();
        setTimeout(done, 500);
      });
    }

    function focusCheckoutControl(selector, delay) {
      clearTimeout(_guidedFocusTimer);
      _guidedFocusTimer = setTimeout(function() {
        const target = document.querySelector(selector);
        if (!target) return;
        target.scrollIntoView({ behavior: prefersReducedCheckoutMotion() ? 'auto' : 'smooth', block:'center' });
        if (target.matches('button, a, input, select, textarea, [tabindex]')) {
          target.focus({ preventScroll:true });
        }
      }, Number.isFinite(delay) ? delay : 160);
    }

    function scheduleCheckoutAdvance(expectedStep, delay) {
      clearTimeout(_autoAdvanceTimer);
      _autoAdvanceTimer = setTimeout(function() {
        if (currentStep === expectedStep && typeof window.wizardNext === 'function') {
          window.wizardNext();
        }
      }, Number.isFinite(delay) ? delay : 500);
    }

    function isCompletePhilippinePhone(value) {
      return /^(?:09\d{9}|639\d{9})$/.test(String(value || '').replace(/\D/g, ''));
    }

    function updateCartGcashSenderFeedback(required = false) {
      return window.GcashSenderInput.update(
        document.getElementById('wizardGcashSenderNumber'),
        document.getElementById('wizardGcashSenderFeedback'),
        { enabled: document.getElementById('wizardPaymentChannel')?.value === 'gcash', required }
      );
    }

    function createCheckoutRequestId() {
      if (window.crypto?.randomUUID) return window.crypto.randomUUID();
      if (window.crypto?.getRandomValues) {
        const bytes = new Uint8Array(24);
        window.crypto.getRandomValues(bytes);
        return Array.from(bytes, value => value.toString(16).padStart(2, '0')).join('');
      }
      return `${Date.now().toString(36)}_${Math.random().toString(36).slice(2)}_${Math.random().toString(36).slice(2)}`;
    }

    function receiptValidationMessage(file) {
      const allowedTypes = new Set(['image/jpeg', 'image/png', 'image/webp']);
      if (!file) return 'Upload a photo or screenshot of your payment receipt.';
      if (!allowedTypes.has(String(file.type || '').toLowerCase())) return 'Receipt must be a JPG, PNG, or WEBP image.';
      if (file.size > 5 * 1024 * 1024) return 'Receipt image must be 5 MB or smaller.';
      return '';
    }

    function validateReceiptFile(file, notify = false) {
      const message = receiptValidationMessage(file);
      if (message && notify) Swal.fire('Invalid receipt', message, 'warning');
      return !message;
    }

    const stepTitles = {
      1: '<i class="bi bi-truck me-2"></i>How will you get your order?',
      2: '<i class="bi bi-calendar-check me-2"></i>Where and when?',
      3: '<i class="bi bi-credit-card me-2"></i>How will you pay?',
      4: '<i class="bi bi-receipt me-2"></i>Check your order'
    };

    let CART_ITEMS = cartObj.items || [];
    let SUB_TOTAL = cartObj.totalAmount || 0;
    let _storeHoursData = null;

    // Fetch store open hours for pickup scheduling
    async function fetchStoreHours() {
      try {
        const r = await fetch('/api/public/company/store-open-hours');
        if (r.ok) {
          const data = await r.json();
          _storeHoursData = data.hours || null;
          renderStoreHoursInfo();
          applyPickupCalendarHours();
        }
      } catch(e) { console.warn('Failed to fetch store hours'); }
    }

    function renderStoreHoursInfo() {
      const el = document.getElementById('storeHoursInfo');
      if (!el || !_storeHoursData) return;
      const dayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
      const openDays = _storeHoursData.filter(h => h.open);
      if (openDays.length === 0) { el.textContent = 'Store is currently closed for pickup.'; return; }
      const fmtTime = (m) => { const h = Math.floor(m/60); const min = m%60; const p = h >= 12 ? 'PM' : 'AM'; return (h%12||12) + ':' + String(min).padStart(2,'0') + ' ' + p; };
      const summary = openDays.map(d => dayNames[d.dayOfWeek] + ' ' + fmtTime(d.startMinutes) + '–' + fmtTime(d.endMinutes)).join(', ');
      el.innerHTML = '<i class="bi bi-clock me-1"></i>Store Hours: ' + summary;
    }

    function applyPickupCalendarHours() {
      if (!fpDatePickup || !_storeHoursData) return;
      fpDatePickup.set('disable', [function(date) {
        const row = _storeHoursData.find(function(item) { return Number(item.dayOfWeek) === date.getDay(); });
        return !row || !row.open || Number(row.endMinutes) <= Number(row.startMinutes);
      }]);
    }

    function setCheckoutFieldValue(id, value) {
      const input = document.getElementById(id);
      if (input && value !== undefined && value !== null) input.value = String(value);
    }

    function restoreCartCheckoutDraft(draft) {
      if (!draft?.selectedFulfillment) return;
      _restoringCartDraft = true;
      try {
        window.selectFulfillment(draft.selectedFulfillment);
        clearTimeout(_autoAdvanceTimer);

        setCheckoutFieldValue('wizardContact', draft.contactNumber);
        setCheckoutFieldValue('wizardAddress', draft.address);
        setCheckoutFieldValue('wizardNotes', draft.notes);
        setCheckoutFieldValue('wizardLat', draft.latitude);
        setCheckoutFieldValue('wizardLng', draft.longitude);
        setCheckoutFieldValue('wizardDate', draft.preferredDate);
        setCheckoutFieldValue('wizardTimeSlot', draft.timeSlot);
        if (draft.selectedFulfillment !== 'customer_pickup') checkoutCalendar?.restoreSelection(draft.preferredDate, draft.timeSlot);
        setCheckoutFieldValue('wizardPickupDate', draft.pickupDate);
        if (fpDatePickup && draft.pickupDate) fpDatePickup.setDate(draft.pickupDate, false);

        _routeDistanceKm = Number(draft.routeDistanceKm) || 0;
        _routeDurationMin = Number(draft.routeDurationMin) || 0;
        _transportFee = Number(draft.transportationFee) || 0;
        _checkoutRequestId = draft.checkoutRequestId || _checkoutRequestId || createCheckoutRequestId();

        let targetStep = Math.min(4, Math.max(1, Number(draft.currentStep) || 1));
        const needsReceipt = ['gcash_full', 'cod'].includes(draft.paymentMethod);
        // Browsers do not allow a file input to be restored. Return manual
        // payments to the payment step so they cannot submit without evidence.
        if (needsReceipt && targetStep > 3) targetStep = 3;
        if (targetStep >= 3) {
          renderPaymentOptions();
          if (draft.paymentMethod) window.selectPaymentMethods(draft.paymentMethod);
          if (draft.paymentChannel) window.selectOrderPaymentChannel(draft.paymentChannel);
          setCheckoutFieldValue('wizardGcashSenderNumber', '');
          const notice = document.getElementById('cartCheckoutRestoreNotice');
          if (notice) notice.classList.toggle('d-none', !needsReceipt);
        }
        enterWizardStep(targetStep);
      } finally {
        clearTimeout(_autoAdvanceTimer);
        _restoringCartDraft = false;
      }
    }

    window.openCheckoutWizard = function (dynamicCart) {
      if (dynamicCart) {
        CART_ITEMS = dynamicCart.items || [];
        SUB_TOTAL = dynamicCart.totalAmount || 0;
      }
      if (CART_ITEMS.length === 0) {
        Swal.fire('Empty Cart', 'Please add items to your cart before checking out.', 'warning');
        return;
      }

      const savedDraft = dynamicCart ? null : readCartCheckoutDraft();

      currentStep = 1;
      clearTimeout(_guidedFocusTimer);
      clearTimeout(_autoAdvanceTimer);
      selectedFulfillment = null;
      renderedPaymentFulfillment = null;
      document.getElementById('wizardPaymentMethod').value = '';
      document.getElementById('wizardPaymentChannel').value = '';
      document.getElementById('paymentOptionsContainer').innerHTML = '';
      const receiptInput = document.getElementById('gcashProofWizard');
      if (receiptInput) receiptInput.value = '';
      _checkoutRequestId = savedDraft?.checkoutRequestId || _checkoutRequestId || createCheckoutRequestId();
      document.getElementById('cartCheckoutRestoreNotice')?.classList.add('d-none');

      // Reset status badges
      document.querySelectorAll('.fulfill-card').forEach(c => {
        c.classList.remove('selected');
        c.setAttribute('aria-pressed', 'false');
      });

      updateWizardUI();

      // Auto-populate contact number
      const contactInput = document.getElementById('wizardContact');
      if (contactInput && USER_PHONE) {
        contactInput.value = USER_PHONE;
      }
      if (contactInput && !contactInput.dataset.guidedProgressBound) {
        contactInput.dataset.guidedProgressBound = 'true';
        contactInput.addEventListener('input', function() {
          if (isCompletePhilippinePhone(contactInput.value)) {
            focusCheckoutControl('#wizardAddress', 420);
          } else {
            clearTimeout(_guidedFocusTimer);
          }
        });
        contactInput.addEventListener('keydown', function(event) {
          if (event.key === 'Enter' && isCompletePhilippinePhone(contactInput.value)) {
            event.preventDefault();
            focusCheckoutControl('#wizardAddress', 0);
          }
        });
      }

      // Calculate estimated installation duration based on total quantity
      const totalQty = CART_ITEMS.reduce((sum, it) => sum + (it.quantity || 1), 0);
      const estDuration = Math.max(60, totalQty * 60); // 60 min per unit, min 60

      if (!checkoutCalendar) {
        checkoutCalendar = new CheckoutCalendar('checkoutCalendarContainer', {
          fulfillmentType: selectedFulfillment,
          duration: estDuration,
          onDateSelect: (dateStr) => {
            document.getElementById('wizardDate').value = dateStr;
            document.getElementById('wizardDateError').style.display = 'none';
            if (dateStr) focusCheckoutControl('#coTimeSection', 240);
          },
          onTimeSelect: (timeStr) => {
            document.getElementById('wizardTimeSlot').value = timeStr;
            clearTimeout(_autoAdvanceTimer);
            scheduleCartCheckoutDraftSave();
          }
        });
      } else {
        checkoutCalendar.setDuration(estDuration);
      }

      // Fetch store hours for pickup
      fetchStoreHours();

      // Set min date for date pickers via Flatpickr for pickup
      // Disable today and past dates — only allow tomorrow onwards
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const minPickupDate = new Date(today);
      minPickupDate.setDate(minPickupDate.getDate() + 1);

      const fpConfig = {
        minDate: minPickupDate,
        dateFormat: "Y-m-d",
        altInput: true,
        altFormat: "F j, Y",
        disableMobile: true,
        inline: true,
        monthSelectorType: "static",
        position: "auto left",
        onChange: function(selectedDates) {
          if (selectedDates && selectedDates.length) scheduleCheckoutAdvance(2, 500);
          else clearTimeout(_autoAdvanceTimer);
        }
      };

      if (!fpDatePickup) {
        fpDatePickup = flatpickr("#wizardPickupDate", fpConfig);
      } else {
        fpDatePickup.set('minDate', minPickupDate);
        fpDatePickup.clear();
      }
      applyPickupCalendarHours();

      const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('checkoutOrderModal'));
      modal.show();
      if (savedDraft) setTimeout(() => restoreCartCheckoutDraft(savedDraft), 80);
    };
    window.selectFulfillment = function (type) {
      selectedFulfillment = type;
      document.querySelectorAll('.fulfill-card').forEach(c => {
        c.classList.toggle('selected', c.dataset.fulfill === type);
        c.setAttribute('aria-pressed', c.dataset.fulfill === type ? 'true' : 'false');
      });
      if (checkoutCalendar) {
        checkoutCalendar.setFulfillmentType(type);
        const totalQty = CART_ITEMS.reduce((sum, item) => sum + (Number(item.quantity) || 1), 0);
        checkoutCalendar.setDuration(type === 'delivery_installation' ? Math.max(60, totalQty * 60) : 60);
      }
      scheduleCartCheckoutDraftSave();
      scheduleCheckoutAdvance(1, 420);
    };

    function getCheckoutStepIssue(step) {
      if (step === 1 && !selectedFulfillment) {
        return {
          step: 1,
          title: 'Choose How to Receive Your Order',
          message: 'Select Delivery + Installation or Customer Pickup before continuing.',
          confirmButtonText: 'Choose an option',
          focusSelector: '.fulfill-card'
        };
      }

      if (step === 2 && selectedFulfillment === 'customer_pickup') {
        if (!window.OrderCheckoutErrors.isFutureDate(document.getElementById('wizardPickupDate').value.trim())) {
          return {
            step: 2,
            title: 'Choose a Pickup Date',
            message: 'Choose an available store pickup date after today.',
            confirmButtonText: 'Choose Pickup Date',
            focusSelector: '#wizardPickupDate'
          };
        }
      }

      if (step === 2 && selectedFulfillment !== 'customer_pickup') {
        const contact = document.getElementById('wizardContact').value.trim();
        const contactDigits = contact.replace(/\D/g, '');
        const address = document.getElementById('wizardAddress').value.trim();
        const date = document.getElementById('wizardDate').value;
        const timeSlot = document.getElementById('wizardTimeSlot').value;
        const lat = Number(document.getElementById('wizardLat').value);
        const lng = Number(document.getElementById('wizardLng').value);

        if (!contact || !/^[+\d().\-\s]+$/.test(contact) || contactDigits.length < 7 || contactDigits.length > 15) {
          return {
            step: 2,
            title: 'Enter a Valid Contact Number',
            message: 'Provide a phone number with 7 to 15 digits so the delivery team can reach you.',
            confirmButtonText: 'Enter Contact Number',
            focusSelector: '#wizardContact'
          };
        }
        if (address.length < 8) {
          return {
            step: 2,
            title: 'Check the Delivery Address',
            message: 'Enter a complete address with at least 8 characters so we can find the delivery location.',
            confirmButtonText: 'Enter Address',
            focusSelector: '#wizardAddress'
          };
        }
        if (!_customerLocationSelected || !Number.isFinite(lat) || !Number.isFinite(lng)) {
          return {
            step: 2,
            title: 'Confirm the Delivery Location',
            message: 'Choose an address from the list, use My Location, or put the pin on your house.',
            confirmButtonText: 'Set Map Location',
            focusSelector: '#checkoutMapCard'
          };
        }
        if (!window.OrderCheckoutErrors.isFutureDate(date)) {
          return {
            step: 2,
            title: 'Choose a Delivery Date',
            message: 'Choose an available date after today for delivery and installation.',
            confirmButtonText: 'Choose Date',
            focusSelector: '#checkoutCalendarContainer'
          };
        }
        if (!timeSlot) {
          return {
            step: 2,
            title: 'Choose a Delivery Time',
            message: 'Select an available time slot before choosing payment.',
            confirmButtonText: 'Choose Time',
            focusSelector: '#checkoutCalendarContainer'
          };
        }
        if (_routeQuoteError || !Number.isFinite(_routeDistanceKm) || _routeDistanceKm < 0) {
          return {
            step: 2,
            title: 'Could Not Check the Delivery Fee',
            message: _routeQuoteError || 'Choose your location on the map again so we can show the delivery fee.',
            confirmButtonText: 'Check the map',
            focusSelector: '#checkoutMapCard'
          };
        }
      }

      if (step === 3) {
        const paymentMethod = document.getElementById('wizardPaymentMethod').value;
        if (!paymentMethod) {
          return {
            step: 3,
            title: 'Choose a Payment Option',
            message: 'Choose to pay the full amount now or pay part now and the rest later.',
            confirmButtonText: 'Choose Payment',
            focusSelector: '.payment-method-card'
          };
        }
        if (paymentMethod === 'gcash_full' || paymentMethod === 'cod') {
          const paymentChannel = document.getElementById('wizardPaymentChannel').value;
          if (!['gcash', 'maya', 'bank_transfer', 'other'].includes(paymentChannel)) {
            return {
              step: 3,
              title: 'Choose a Payment Method',
              message: 'Select GCash, Maya, bank transfer, or another transfer method.',
              confirmButtonText: 'Choose Method',
              focusSelector: '#orderPaymentChannelSection'
            };
          }
          if (window.paymentMethodsConfig?.[paymentChannel]?.available === false) {
            return {
              step: 3,
              title: 'Payment Method Unavailable',
              message: 'Choose another payment method or contact the store.',
              confirmButtonText: 'Choose Method',
              focusSelector: '#orderPaymentChannelSection'
            };
          }
          if (paymentChannel === 'gcash' && !String(window.adminGcashNumber || '').trim()) {
            return {
              step: 3,
              title: 'GCash Is Not Configured',
              message: 'Choose another payment method or contact the store.',
              confirmButtonText: 'Choose Method',
              focusSelector: '#orderPaymentChannelSection'
            };
          }
          const reference = String(document.getElementById('wizardGcashSenderNumber')?.value || '').trim();
          const senderFeedback = paymentChannel === 'gcash' ? updateCartGcashSenderFeedback(true) : null;
          if ((paymentChannel === 'gcash' && !senderFeedback.valid) || (paymentChannel !== 'gcash' && reference.length < 3)) {
            return {
              step: 3,
              title: paymentChannel === 'gcash' ? 'Check the GCash number' : 'Enter the Payment Reference',
              message: paymentChannel === 'gcash' ? senderFeedback.message : 'Enter the transaction or reference number shown on your receipt.',
              confirmButtonText: paymentChannel === 'gcash' ? 'Fix the number' : 'Enter Reference',
              focusSelector: '#wizardGcashSenderNumber'
            };
          }
          const receiptMessage = receiptValidationMessage(document.getElementById('gcashProofWizard')?.files[0]);
          if (receiptMessage) {
            return {
              step: 3,
              title: 'Upload a Valid Payment Receipt',
              message: receiptMessage,
              confirmButtonText: 'Upload Receipt',
              focusSelector: '#gcashProofWizard'
            };
          }
        }
      }

      return null;
    }

    function enterWizardStep(step) {
      clearTimeout(_autoAdvanceTimer);
      currentStep = step;

      if (step === 2) {
        const isDelivery = selectedFulfillment !== 'customer_pickup';
        document.getElementById('deliveryFields').style.display = isDelivery ? 'block' : 'none';
        document.getElementById('pickupFields').style.display = isDelivery ? 'none' : 'block';
        if (isDelivery) setTimeout(() => initMap(), 500);
      }
      if (step === 3) {
        const paymentOptions = document.getElementById('paymentOptionsContainer');
        if (!paymentOptions.children.length || renderedPaymentFulfillment !== selectedFulfillment) renderPaymentOptions();
        updateNextButtonState();
      }
      if (step === 4) populateReview();
      updateWizardUI();
      scheduleCartCheckoutDraftSave();
    }

    function focusCheckoutRequirement(issue) {
      const panel = document.getElementById(`wizardStep${issue.step}`);
      if (panel) {
        panel.classList.add('wizard-needs-attention');
        setTimeout(() => panel.classList.remove('wizard-needs-attention'), 1800);
      }
      const focusTarget = document.querySelector(issue.focusSelector || '');
      if (!focusTarget) return;
      if (!focusTarget.matches('button, a, input, select, textarea, [tabindex]')) focusTarget.setAttribute('tabindex', '-1');
      focusTarget.classList.add('checkout-focus-cue');
      if (focusTarget.matches('input, select, textarea')) {
        focusTarget.classList.add('is-invalid');
        focusTarget.setAttribute('aria-invalid', 'true');
      }
      focusTarget.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => focusTarget.focus({ preventScroll: true }), 300);
      setTimeout(() => focusTarget.classList.remove('checkout-focus-cue'), 2200);
    }

    ['input', 'change'].forEach(eventName => {
      document.getElementById('checkoutOrderModal')?.addEventListener(eventName, event => {
        const field = event.target;
        if (!field?.classList?.contains('is-invalid')) return;
        field.classList.remove('is-invalid');
        field.removeAttribute('aria-invalid');
      });
    });

    async function presentCheckoutStepIssue(issue) {
      if (currentStep !== issue.step) enterWizardStep(issue.step);
      await Swal.fire({
        icon: 'warning',
        title: issue.title,
        text: issue.message,
        confirmButtonText: issue.confirmButtonText,
        allowOutsideClick: false,
        focusConfirm: true
      });
      focusCheckoutRequirement(issue);
    }

    async function validateCheckoutStep(step) {
      if (step === 2 && selectedFulfillment !== 'customer_pickup' && _routeQuotePending) {
        try { await _routeQuotePending; } catch (_) {}
      }
      if (step === 2 && selectedFulfillment !== 'customer_pickup' && checkoutCalendar
          && document.getElementById('wizardDate')?.value
          && document.getElementById('wizardTimeSlot')?.value) {
        const stillAvailable = await checkoutCalendar.validateSelectedSlot(
          document.getElementById('wizardDate').value,
          document.getElementById('wizardTimeSlot').value
        );
        if (!stillAvailable) {
          await presentCheckoutStepIssue({
            step: 2,
            title: 'Time Slot No Longer Available',
            message: 'That Philippine time slot has passed or was just reserved. Please choose a new available time.',
            confirmButtonText: 'Choose Another Time',
            focusSelector: '#checkoutCalendarContainer'
          });
          return false;
        }
      }
      const issue = getCheckoutStepIssue(step);
      if (!issue) return true;
      await presentCheckoutStepIssue(issue);
      return false;
    }

    window.wizardNext = async function () {
      if (!(await validateCheckoutStep(currentStep))) return;
      if (currentStep === 4) {
        for (let step = 1; step < 4; step += 1) {
          if (!(await validateCheckoutStep(step))) return;
        }
        submitCartOrder();
        return;
      }
      enterWizardStep(currentStep + 1);
    };

    window.wizardBack = function () {
      if (currentStep <= 1) return;
      enterWizardStep(currentStep - 1);
    };

    window.navigateWizardStep = async function (step) {
      if (!Number.isInteger(step) || step < 1 || step > 4 || step === currentStep) return;
      if (step < currentStep) {
        enterWizardStep(step);
        return;
      }
      for (let prerequisiteStep = 1; prerequisiteStep < step; prerequisiteStep += 1) {
        if (!(await validateCheckoutStep(prerequisiteStep))) return;
      }
      enterWizardStep(step);
    };

    function updateWizardUI() {
      for (let i = 1; i <= 4; i++) {
        const panel = document.getElementById(`wizardStep${i}`);
        if (panel) panel.classList.toggle('active', i === currentStep);
      }
      document.getElementById('wizardModalTitle').innerHTML = stepTitles[currentStep] || '';
      document.getElementById('wizardStepCurrent').textContent = currentStep;

      const modalBody = document.querySelector('#checkoutOrderModal .modal-body');
      if (modalBody) {
        const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        modalBody.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
      }

      document.querySelectorAll('.wizard-ps').forEach(p => {
        const step = parseInt(p.dataset.step);
        p.classList.remove('active', 'completed');
        p.removeAttribute('aria-current');
        if (step === currentStep) {
          p.classList.add('active');
          p.setAttribute('aria-current', 'step');
        } else if (step < currentStep) {
          p.classList.add('completed');
        }
      });

      document.getElementById('wizardBackBtn').style.display = currentStep > 1 ? 'inline-flex' : 'none';
      const nextBtn = document.getElementById('wizardNextBtn');
      const nextLabels = {
        1: 'Add address or pickup date <i class="bi bi-arrow-right ms-2"></i>',
        2: 'Choose payment <i class="bi bi-arrow-right ms-2"></i>',
        3: 'Check my order <i class="bi bi-arrow-right ms-2"></i>',
        4: '<i class="bi bi-bag-check me-2"></i>Place my order'
      };
      nextBtn.innerHTML = nextLabels[currentStep];
      nextBtn.classList.toggle('is-submit', currentStep === 4);
      nextBtn.removeAttribute('style');
    }

    function orderPaymentChannelLabel(channel) {
      const configured = window.paymentMethodsConfig?.[channel]?.label;
      return configured || ({ gcash: 'GCash', maya: 'Maya', bank_transfer: 'Bank Transfer', other: 'Other Transfer' })[channel] || 'Payment';
    }

    window.selectOrderPaymentChannel = function(channel) {
      if (!['gcash', 'maya', 'bank_transfer', 'other'].includes(channel)) return;
      const configuredMethod = window.paymentMethodsConfig?.[channel];
      if (configuredMethod && configuredMethod.available !== true) return;
      if (!configuredMethod && channel === 'gcash' && !String(window.adminGcashNumber || '').trim()) return;
      const label = orderPaymentChannelLabel(channel);
      const isGcash = channel === 'gcash';
      document.getElementById('wizardPaymentChannel').value = channel;
      document.querySelectorAll('#orderPaymentChannelSection .payment-channel-card').forEach(button => {
        const selected = button.dataset.channel === channel;
        button.classList.toggle('selected', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      const help = document.getElementById('wizardPaymentChannelHelp');
      if (help) help.textContent = isGcash
        ? 'Send to the displayed GCash number, then upload your receipt.'
        : `${configuredMethod?.accountName ? `${configuredMethod.accountName} · ` : ''}${configuredMethod?.accountNumber || `Use the ${label} receiving details`}. Enter the transaction reference and upload your receipt.`;
      document.getElementById('wizardPaymentQrBlock')?.classList.toggle('d-none', !isGcash);
      document.getElementById('gcashFieldsWizard')?.classList.remove('d-none');
      const referenceLabel = document.getElementById('wizardPaymentReferenceLabel');
      const referenceHelp = document.getElementById('wizardPaymentReferenceHelp');
      const referenceInput = document.getElementById('wizardGcashSenderNumber');
      if (referenceLabel) referenceLabel.innerHTML = `${isGcash ? 'GCash Sender Number' : `${label} Transaction Reference`} <span class="text-danger">*</span>`;
      if (referenceHelp) referenceHelp.textContent = isGcash
        ? 'Use the number on the GCash account that sent the payment, not the number shown above.'
        : 'Enter the transaction or reference number shown on your receipt.';
      if (referenceInput) {
        referenceInput.value = '';
        referenceInput.type = isGcash ? 'tel' : 'text';
        referenceInput.placeholder = isGcash ? '09XXXXXXXXX' : 'Transaction or reference number';
        referenceInput.inputMode = isGcash ? 'numeric' : 'text';
        referenceInput.autocomplete = isGcash ? 'tel' : 'off';
      }
      updateCartGcashSenderFeedback();
      const method = document.getElementById('wizardPaymentMethod').value;
      const heading = document.getElementById('wizardGcashHeading');
      if (heading) heading.textContent = method === 'cod' ? `Pay part now with ${label}` : `Pay all now with ${label}`;
      const instructionTitle = document.getElementById('wizardPaymentInstructionTitle');
      if (instructionTitle) instructionTitle.textContent = `Send your payment via ${label}`;
      const instructionFirst = document.getElementById('wizardPaymentInstructionFirst');
      if (instructionFirst) instructionFirst.textContent = isGcash
        ? 'Use the QR, if shown, or send to the GCash number below.'
        : `Use the ${label} payment details confirmed by RACS.`;
      updateNextButtonState();
      scheduleCartCheckoutDraftSave();
    };

    document.querySelectorAll('#orderPaymentChannelSection .payment-channel-card').forEach(button => {
      button.addEventListener('click', () => window.selectOrderPaymentChannel(button.dataset.channel));
    });

    window.selectPaymentMethods = function(method) {
      clearTimeout(_autoAdvanceTimer);
      document.getElementById('wizardPaymentMethod').value = method;
      document.querySelectorAll('.payment-method-card').forEach(c => {
        c.classList.toggle('selected', c.dataset.method === method);
        c.setAttribute('aria-pressed', c.dataset.method === method ? 'true' : 'false');
      });

      const showGcashPanel = method === 'gcash_full' || method === 'cod';
      const gcashPanel = document.getElementById('gcashFieldsWizard');
      if (gcashPanel) {
        gcashPanel.classList.toggle('d-none', !showGcashPanel);
      }
      const channelSection = document.getElementById('orderPaymentChannelSection');
      if (channelSection) channelSection.classList.toggle('d-none', !showGcashPanel);
      if (showGcashPanel) {
        const currentChannel = document.getElementById('wizardPaymentChannel').value;
        if (!currentChannel) {
          const preferred = ['gcash','maya','bank_transfer','other'].find(channel => window.paymentMethodsConfig?.[channel]?.available)
            || (String(window.adminGcashNumber || '').trim() ? 'gcash' : '');
          if (preferred) window.selectOrderPaymentChannel(preferred);
        }
        const gcashNum = (window.adminGcashNumber || '').trim();
        window.GcashQrActions?.apply(window.gcashQrImageUrl);
        document.getElementById('gcashNumberDisplayWizard').textContent = gcashNum || 'Contact the store';
        const itemTotal = SUB_TOTAL;
        const grandTotal = itemTotal + (selectedFulfillment !== 'customer_pickup' ? _transportFee : 0);
        const percentage = window.downpaymentPercentage || 10;
        const payAmount = method === 'cod' ? Math.round(grandTotal * percentage / 100) : grandTotal;
        const balance = Math.max(0, grandTotal - payAmount);
        const amountEl = document.getElementById('gcashAmountDisplayWizard');
        if (amountEl) {
          amountEl.textContent = '₱' + payAmount.toLocaleString();
          const labelEl = document.getElementById('wizardGcashLabel');
          if (labelEl) labelEl.textContent = method === 'cod' ? `Pay now (${percentage}%)` : 'Pay now';
        }
        const channelLabel = orderPaymentChannelLabel(document.getElementById('wizardPaymentChannel').value);
        document.getElementById('wizardGcashHeading').textContent = method === 'cod' ? `Pay part now with ${channelLabel}` : `Pay all now with ${channelLabel}`;
        document.getElementById('gcashTotalDisplayWizard').textContent = '₱' + grandTotal.toLocaleString();
        document.getElementById('gcashBalanceDisplayWizard').textContent = '₱' + balance.toLocaleString();
        document.getElementById('gcashBalanceRowWizard').style.display = method === 'cod' ? 'flex' : 'none';
        const balanceLabel = document.getElementById('wizardGcashBalanceLabel');
        if (balanceLabel) balanceLabel.textContent = selectedFulfillment === 'customer_pickup'
          ? 'Balance due at store pickup'
          : 'Amount to pay after installation';
        // Show proof warning if no file uploaded yet
        const proofInput = document.getElementById('gcashProofWizard');
        const warning = document.getElementById('gcashProofWarning');
        if (warning && proofInput && !proofInput.files[0]) {
          warning.classList.remove('d-none');
        }
      } else {
        // Hide warning for non-GCash methods
        const warning = document.getElementById('gcashProofWarning');
        if (warning) warning.classList.add('d-none');
      }
      // Update Next button state
      updateNextButtonState();
      scheduleCartCheckoutDraftSave();
      if (method === 'cash_onsite') {
        scheduleCheckoutAdvance(3, 450);
      } else if (showGcashPanel) {
        focusCheckoutControl('#wizardGcashSenderNumber', 220);
      }
    };

    // Preview uploaded receipt
    document.addEventListener('change', function(e) {
      if (e.target && e.target.id === 'gcashProofWizard') {
        clearTimeout(_autoAdvanceTimer);
        const file = e.target.files[0];
        const preview = document.getElementById('gcashProofPreviewWizard');
        const warning = document.getElementById('gcashProofWarning');
        if (file && !validateReceiptFile(file, true)) {
          e.target.value = '';
          if (preview) { preview.classList.add('d-none'); preview.removeAttribute('src'); }
          if (warning) warning.classList.remove('d-none');
          updateNextButtonState();
          return;
        }
        if (file && preview) {
          const reader = new FileReader();
          reader.onload = ev => { preview.src = ev.target.result; preview.classList.remove('d-none'); };
          reader.readAsDataURL(file);
          if (warning) warning.classList.add('d-none');
        } else if (preview) {
          preview.classList.add('d-none');
          if (warning) warning.classList.remove('d-none');
        }
        updateNextButtonState();
        const senderNumber = document.getElementById('wizardGcashSenderNumber')?.value;
        if (file && document.getElementById('wizardPaymentChannel')?.value === 'gcash' && window.GcashSenderInput.check(senderNumber, false).valid) scheduleCheckoutAdvance(3, 650);
      }
    });

