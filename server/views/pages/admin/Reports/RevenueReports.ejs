      });
    }

    // Fulfillment mix chart
    const fulfillEl = document.getElementById('fulfillmentMix');
    if (fulfillEl && A.orderFulfillmentMap) {
      const fm = A.orderFulfillmentMap;
      charts.fulfillmentMix = new Chart(fulfillEl, {
        type: 'doughnut', data: {
