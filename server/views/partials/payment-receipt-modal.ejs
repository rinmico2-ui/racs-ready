<div class="modal fade" id="paymentImageModal" tabindex="-1" aria-hidden="true" aria-labelledby="paymentImageModalLabel">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content bg-dark text-white border-0">
      <div class="modal-header border-0">
        <h5 class="modal-title" id="paymentImageModalLabel">Payment receipt</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close receipt"></button>
      </div>
      <div class="modal-body text-center">
        <p id="paymentImageStatus" class="d-none" role="status" aria-live="polite"></p>
        <img id="paymentImageModalImg" class="img-fluid d-none" alt="Uploaded payment receipt" style="max-height:75vh;object-fit:contain;" />
      </div>
    </div>
  </div>
</div>
