        const filtered = bookingRequests.filter((rq) => {
          const hay =
            `${rq.id} ${rq.customerName} ${rq.customerEmail} ${rq.service}`.toLowerCase();
          const matchSearch = !search || hay.includes(search);
          const matchStatus = rq.status === "pending";
          return matchSearch && matchStatus;
        });

        body.innerHTML = "";
        if (!filtered.length) {
          body.innerHTML =
            '<tr><td colspan="8" class="workflow-record-empty">No requests matched your current filters.</td></tr>';
        } else {
          filtered.forEach((rq) => {
            const tr = document.createElement("tr");
