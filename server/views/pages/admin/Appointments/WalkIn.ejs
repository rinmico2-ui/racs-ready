<div class="admin-dashboard container-fluid py-4 walkin-page">
  <%- include('../../../partials/dashboard-styles') %>

  <style>
    :root{--sv-b:#2563eb;--sv-bd:#1d4ed8;--sv-bl:#60a5fa;--sv-bs:rgba(37,99,235,0.08);--sv-g:#10b981;--sv-r:#ef4444;--sv-c:#f59e0b;--sv-f:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;--sv-r1:12px;--sv-r2:16px;--sv-sh:0 2px 16px rgba(15,23,42,0.04);--sv-sh2:0 8px 32px rgba(15,23,42,0.06);--sv-e:cubic-bezier(0.16,1,0.3,1)}
    .walkin-page{font-family:var(--sv-f);background:#f8fafc;min-height:100vh}
    .walkin-page .walkin-shell{position:relative}
    .walkin-page .walkin-mode-tabs{display:flex;gap:.5rem;max-width:1100px;margin:0 auto 1rem;padding:.4rem;background:#eaf0f8;border:1px solid #dbe4f0;border-radius:15px}
    .walkin-page .walkin-mode-tab{flex:1;display:flex;align-items:center;justify-content:center;gap:.55rem;padding:.8rem 1rem;border:0;border-radius:11px;background:transparent;color:#64748b;font-weight:750;transition:.2s ease}
    .walkin-page .walkin-mode-tab.active{background:#fff;color:#1d4ed8;box-shadow:0 4px 14px rgba(15,23,42,.08)}

    /* Enterprise Hero */
    .walkin-page .ent-hero{position:relative;overflow:hidden;padding:3.5rem 0 4rem;background:linear-gradient(160deg,#e0f2fe 0%,#f0fdf4 35%,#e0e7ff 70%,#ede9fe 100%);border-bottom:1px solid rgba(37,99,235,0.06);border-radius:20px;margin-bottom:1.5rem}
    .walkin-page .ent-hero-orb{position:absolute;border-radius:50%;pointer-events:none;filter:blur(60px)}
    .walkin-page .ent-hero-orb-1{width:400px;height:400px;background:radial-gradient(circle,rgba(37,99,235,0.08) 0%,transparent 70%);top:-120px;right:-60px}
    .walkin-page .ent-hero-orb-2{width:280px;height:280px;background:radial-gradient(circle,rgba(6,182,212,0.07) 0%,transparent 70%);bottom:-80px;left:20%}
    .walkin-page .ent-hero-badge{display:inline-flex;align-items:center;gap:8px;padding:7px 18px 7px 16px;border-radius:9999px;font-size:0.65rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;background:linear-gradient(135deg,rgba(37,99,235,0.1),rgba(37,99,235,0.04));color:#1d4ed8;border:1px solid rgba(37,99,235,0.12);margin-bottom:1.25rem;box-shadow:0 2px 8px rgba(15,23,42,0.03)}
    .walkin-page .ent-hero-title{font-size:clamp(2rem,4vw,2.8rem);font-weight:800;color:#0f172a;letter-spacing:-1.5px;line-height:1.1;margin:0 0 0.75rem}
    .walkin-page .ent-gradient-text{background:linear-gradient(135deg,#2563eb,#60a5fa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .walkin-page .ent-hero-subtitle{font-size:1.05rem;color:#475569;max-width:580px;line-height:1.7;margin:0 0 1.5rem}
    .walkin-page .ent-trust-badges{display:flex;align-items:center;justify-content:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
    .walkin-page .ent-trust-item{display:inline-flex;align-items:center;gap:6px;font-size:0.78rem;font-weight:600;color:#1e293b}
    .walkin-page .ent-trust-item i{color:#059669;font-size:0.85rem}
    .walkin-page .ent-trust-divider{width:3px;height:3px;border-radius:50%;background:#cbd5e1}

    /* Enterprise Stepper (Pill) */
    .walkin-page .ent-stepper{background:#fff;border-radius:var(--sv-r2);border:1px solid rgba(148,163,184,0.08);padding:1rem 1.25rem;margin-bottom:1.5rem;box-shadow:0 4px 24px rgba(15,23,42,0.04);position:sticky;top:84px;z-index:40}
    .walkin-page .ent-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:0.85rem}
    .walkin-page .ent-h span:first-child{font-size:0.8rem;font-weight:700;color:#0f172a;letter-spacing:0.3px;text-transform:uppercase}
    .walkin-page .ent-h span:last-child{font-size:0.72rem;color:#64748b;font-weight:600}
    .walkin-page .ent-h span:last-child span{color:var(--sv-b)}
    .walkin-page .ent-tr{display:flex;justify-content:space-between;background:#f1f5f9;border-radius:9999px;padding:3px;gap:2px;overflow-x:auto}
    .walkin-page .ent-n{display:flex;align-items:center;gap:5px;padding:6px 12px;border-radius:9999px;cursor:pointer;transition:all 0.3s var(--sv-e);font-size:0.72rem;font-weight:600;color:#94a3b8;white-space:nowrap;border:none;background:transparent}
    .walkin-page .ent-n.active{background:var(--sv-b);color:#fff;box-shadow:0 4px 12px rgba(37,99,235,0.2)}
    .walkin-page .ent-n.completed{background:#f0fdf4;color:#16a34a}
    .walkin-page .ent-n:hover{background:#e2e8f0;color:#475569}
    .walkin-page .ent-n.active:hover{background:var(--sv-b)}
    .walkin-page .ent-ni{font-size:0.85rem;display:flex}

    /* Enterprise Step Cards */
    .walkin-page .ent-step-card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;margin-bottom:1.5rem;overflow:hidden;box-shadow:0 4px 20px rgba(15,23,42,0.05);animation:stepFadeIn .35s ease both}
    @keyframes stepFadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
    .walkin-page .ent-step-card:hover{box-shadow:0 8px 32px rgba(15,23,42,0.08);border-color:#cbd5e1}
    .walkin-page .ent-step-header{display:flex;align-items:center;gap:12px;padding:1.15rem 1.5rem;background:linear-gradient(135deg,#fafbff,#f8fafc);border-bottom:1px solid #eef2f6}
    .walkin-page .ent-step-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1.15rem;color:#fff}
    .walkin-page .ent-step-icon.step-customer{background:linear-gradient(135deg,#2563eb,#1d4ed8)}
    .walkin-page .ent-step-icon.step-services{background:linear-gradient(135deg,#7c3aed,#6d28d9)}
    .walkin-page .ent-step-icon.step-location{background:linear-gradient(135deg,#10b981,#059669)}
    .walkin-page .ent-step-icon.step-calendar{background:linear-gradient(135deg,#f59e0b,#b45309)}
    .walkin-page .ent-step-icon.step-fee{background:linear-gradient(135deg,#ec4899,#be123c)}
    .walkin-page .ent-step-icon.step-payment{background:linear-gradient(135deg,#6366f1,#4f46e5)}
    .walkin-page .ent-step-icon.step-review{background:linear-gradient(135deg,#10b981,#047857)}
    .walkin-page .ent-step-info h5{font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#94a3b8;margin:0 0 3px}
    .walkin-page .ent-step-info p{font-size:1.1rem;font-weight:700;color:#0f172a;margin:0}
    .walkin-page .ent-step-body{padding:1.5rem}

    /* Enterprise Buttons */
    .walkin-page .ent-btn-primary{display:inline-flex;align-items:center;gap:8px;padding:0.65rem 1.5rem;border-radius:12px;font-weight:700;font-size:0.88rem;cursor:pointer;transition:all 0.25s var(--sv-e);text-decoration:none;border:none;background:linear-gradient(135deg,var(--sv-b),var(--sv-bd));color:#fff;box-shadow:0 4px 16px rgba(37,99,235,0.2)}
    .walkin-page .ent-btn-primary:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(37,99,235,0.3);color:#fff}
    .walkin-page .ent-btn-primary:disabled{opacity:0.5;cursor:not-allowed;transform:none}
    .walkin-page .ent-btn-outline{display:inline-flex;align-items:center;gap:8px;padding:0.65rem 1.5rem;border-radius:12px;font-weight:700;font-size:0.88rem;cursor:pointer;transition:all 0.25s var(--sv-e);text-decoration:none;border:1.5px solid #cbd5e1;background:transparent;color:#475569}
    .walkin-page .ent-btn-outline:hover{border-color:var(--sv-b);color:var(--sv-b);background:rgba(37,99,235,0.04)}

    /* Enterprise Service Section */
    .walkin-page .ent-svc-section{background:linear-gradient(135deg,#fafbff 0%,#f8fafc 100%);border:1px solid rgba(148,163,184,0.12);border-radius:16px;padding:1.25rem;margin-bottom:1rem}
    .walkin-page .ent-svc-section-header{display:flex;align-items:center;gap:12px;padding-bottom:1rem;margin-bottom:1rem;border-bottom:1px solid rgba(148,163,184,0.1)}
    .walkin-page .ent-svc-section-icon{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,rgba(139,92,246,0.12),rgba(139,92,246,0.04));border:1px solid rgba(139,92,246,0.1);display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:#7c3aed;flex-shrink:0}
    .walkin-page .ent-svc-section-title{font-size:0.92rem;font-weight:700;color:#0f172a;margin:0;letter-spacing:-0.2px}
    .walkin-page .ent-svc-section-sub{font-size:0.78rem;color:#64748b;margin:2px 0 0}

    /* Layout */
    .walkin-page .booking-layout{display:flex;flex-direction:column;gap:1.5rem}

    /* Service Cards */
    .walkin-page .service-card{transition:transform 0.2s ease,box-shadow 0.2s ease,border-color 0.2s ease;border:1px solid rgba(13,110,253,0.12)!important;min-height:280px;background:#fff;border-radius:1.4rem;cursor:pointer}
    .walkin-page .service-card:hover{transform:translateY(-6px);box-shadow:0 18px 45px rgba(13,110,253,0.12)!important;border-color:rgba(13,110,253,0.24)!important}
    .walkin-page .service-card.active{border-color:#0d6efd!important;background:linear-gradient(145deg,rgba(13,110,253,0.08),rgba(13,110,253,0.02));box-shadow:0 15px 35px rgba(13,110,253,0.15)!important}
    .walkin-page .service-icon{width:54px;height:54px;display:flex;align-items:center;justify-content:center;border-radius:16px;background:rgba(13,110,253,0.12);color:#0d6efd;flex-shrink:0}
    .walkin-page .service-card .card-title{font-size:.95rem;font-weight:600;color:#1e293b;margin-bottom:4px}
    .walkin-page .price-box{display:inline-flex;align-items:center;justify-content:center;padding:0.75rem 1rem;border-radius:999px;background:rgba(13,110,253,0.08);min-width:130px;font-weight:700;font-size:.88rem;color:#0d6efd}
    .walkin-page .service-card-chip{padding:0.45rem 0.8rem;border-radius:999px;font-size:0.8rem;letter-spacing:0.01em}
    .walkin-page .add-service-btn{border-radius:10px;font-weight:600;font-size:0.82rem;padding:8px 16px;transition:all 0.2s}

    /* Calendar */
    .walkin-page .calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}
    .walkin-page .calendar-cell{border:1px solid #e2e8f0;border-radius:10px;min-height:52px;background:#fff;font-weight:600;font-size:.84rem;position:relative;transition:all .15s ease}
    .walkin-page .calendar-cell:hover:not(.disabled):not([data-status=booked]):not([data-status=blocked]){border-color:#93c5fd;background:#f0f7ff}
    .walkin-page .calendar-cell.is-selected{border-color:#2563eb;background:linear-gradient(135deg,#2563eb,#3b82f6);color:#fff;box-shadow:0 6px 24px rgba(37,99,235,0.3)}
    .walkin-page .calendar-cell.disabled{opacity:.5;cursor:not-allowed}
    .walkin-page .calendar-cell[data-status=booked]{background:#fef2f2;border-color:#fecaca;color:#b91c1c}
    .walkin-page .calendar-cell[data-status=blocked],.walkin-page .calendar-cell[data-status=public]{background:#f8fafc;color:#94a3b8}

    /* Time Slots */
    .walkin-page #timeSlots{display:block}
    .walkin-page #timeSlots .time-slot{flex:1 1 calc(33.333% - 8px);max-width:calc(33.333% - 8px);border-radius:10px;border:1px solid rgba(37,99,235,.1);background:#fff;text-align:left;transition:all .15s ease}
    .walkin-page #timeSlots .time-slot:hover{border-color:#93c5fd;background:#f0f7ff}
    .walkin-page #timeSlots .time-slot.active{background:linear-gradient(135deg,#2563eb,#3b82f6);border-color:#2563eb;color:#fff;box-shadow:0 4px 16px rgba(37,99,235,0.25)}

    /* Map */
    .walkin-page .map-wrap{border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;background:#fff}
    .walkin-page .technician-map{height:340px;width:100%;border-radius:14px}
    .walkin-page .walkin-technician-card{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,420px);align-items:center;gap:1rem;padding:1rem 1.1rem;border:1px solid #dbe3ee;border-radius:14px;background:linear-gradient(135deg,#f8faff,#fff);box-shadow:0 3px 12px rgba(37,99,235,.05)}
    .walkin-page .service-map-search .form-label{font-size:.82rem;color:#334155;margin-bottom:.45rem}
    .walkin-page .service-map-input{overflow:hidden;border:1.5px solid #dbe3ee;border-radius:12px;background:#fff;box-shadow:0 2px 8px rgba(15,23,42,.05);transition:border-color .2s,box-shadow .2s}
    .walkin-page .service-map-input:focus-within{border-color:#60a5fa;box-shadow:0 0 0 4px rgba(37,99,235,.08)}
    .walkin-page .service-map-input .form-control{background:#fbfdff;font-size:.88rem;box-shadow:none}
    .walkin-page .service-map-suggestions{z-index:1080;border:1px solid #dbe3ee;border-radius:12px;overflow:auto;max-height:240px;box-shadow:0 12px 30px rgba(15,23,42,.14)}
    .walkin-page .location-hint{color:#64748b;font-size:.7rem}
    .walkin-page .service-checkout-map-card{overflow:hidden;border:1px solid #dbe3ee;border-radius:16px;background:#fff;box-shadow:0 8px 26px rgba(15,23,42,.07);transition:border-color .2s,box-shadow .2s}
    .walkin-page .service-checkout-map-card:hover,.walkin-page .service-checkout-map-card:focus-within{border-color:#93c5fd;box-shadow:0 10px 30px rgba(37,99,235,.1)}
    .walkin-page .service-map-toolbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.85rem 1rem;border-bottom:1px solid #e2e8f0;background:linear-gradient(180deg,#fff,#f8fafc)}
    .walkin-page .service-map-toolbar h6{margin:0;color:#0f172a;font-size:.82rem;font-weight:800}
    .walkin-page .service-map-toolbar p{margin:2px 0 0;color:#64748b;font-size:.67rem}
    .walkin-page .service-map-actions{display:flex;align-items:center;gap:.35rem;flex-wrap:wrap;justify-content:flex-end}
    .walkin-page .service-map-action{display:inline-flex;align-items:center;justify-content:center;gap:.35rem;min-height:34px;padding:.35rem .6rem;border:1px solid #dbe3ee;border-radius:8px;background:#fff;color:#334155;font-size:.67rem;font-weight:700;white-space:nowrap}
    .walkin-page .service-map-action:hover:not(:disabled){border-color:#93c5fd;background:#eff6ff;color:#1d4ed8}
    .walkin-page .service-map-action:disabled{cursor:not-allowed;opacity:.42}
    .walkin-page .service-map-stage{position:relative;background:#e8eef7}
    .walkin-page .service-checkout-map-card .technician-map{height:410px;width:100%;border-radius:0;background:#e8eef7;transition:height .25s ease}
    .walkin-page .service-checkout-map-card.map-expanded .technician-map{height:560px}
    .walkin-page .service-map-legend{position:absolute;left:10px;bottom:24px;z-index:800;display:flex;flex-direction:column;gap:5px;padding:8px 10px;border:1px solid rgba(203,213,225,.9);border-radius:9px;background:rgba(255,255,255,.94);color:#334155;font-size:.64rem;font-weight:700;box-shadow:0 4px 14px rgba(15,23,42,.12);backdrop-filter:blur(6px)}
    .walkin-page .service-map-legend span{display:flex;align-items:center;gap:6px}
    .walkin-page .service-map-dot{width:9px;height:9px;border-radius:50%;display:inline-block}
    .walkin-page .service-map-dot.company{background:#2563eb;box-shadow:0 0 0 2px #dbeafe}
    .walkin-page .service-map-dot.customer{background:#16a34a;box-shadow:0 0 0 2px #dcfce7}
    .walkin-page .service-map-selection{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.9rem;padding:.85rem 1rem;border-top:1px solid #e2e8f0;background:#fff}
    .walkin-page .service-map-selection-main{display:flex;align-items:flex-start;gap:.65rem;min-width:0}
    .walkin-page .service-map-selection-icon{display:inline-flex;align-items:center;justify-content:center;flex:0 0 32px;width:32px;height:32px;border-radius:9px;background:#f1f5f9;color:#64748b}
    .walkin-page .service-map-selection.has-location .service-map-selection-icon{background:#dcfce7;color:#15803d}
    .walkin-page .service-map-selection-status{color:#b45309;font-size:.66rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase}
    .walkin-page .service-map-selection.has-location .service-map-selection-status{color:#15803d}
    .walkin-page .service-map-address{margin-top:2px;overflow:hidden;color:#334155;font-size:.72rem;font-weight:600;line-height:1.4;text-overflow:ellipsis}
    .walkin-page .service-map-coordinate{min-width:168px;padding-left:.9rem;border-left:1px solid #e2e8f0;text-align:right}
    .walkin-page .service-map-coordinate span{display:block;color:#94a3b8;font-size:.6rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
    .walkin-page .service-map-coordinate strong{display:block;margin-top:3px;color:#334155;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.68rem}
    .walkin-page .service-map-coordinate small{display:block;margin-top:2px;color:#64748b;font-size:.62rem}
    .walkin-page .service-route-panel{padding:.9rem 1rem;border:1px solid #c7d2fe;border-radius:14px;background:linear-gradient(135deg,#f8faff,#f0f4ff);box-shadow:0 3px 12px rgba(99,102,241,.06)}
    .walkin-page .service-route-head{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:.7rem;color:#1e293b;font-size:.78rem}
    .walkin-page .service-route-head>span{display:inline-flex;align-items:center;padding:3px 9px;border-radius:999px;background:#e0e7ff;color:#4f46e5;font-size:.65rem;font-weight:700}
    .walkin-page .service-route-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:.55rem}
    .walkin-page .service-route-stat{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;padding:.6rem .5rem;border:1px solid #e0e7ef;border-radius:10px;background:#fff;text-align:center;box-shadow:0 1px 4px rgba(99,102,241,.05)}
    .walkin-page .service-route-stat>i{margin-bottom:2px;font-size:.9rem}
    .walkin-page .service-route-stat>span{color:#6b7280;font-size:.62rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
    .walkin-page .service-route-stat>strong{margin-top:2px;color:#1e293b;font-size:.95rem}
    .walkin-page .service-route-stat.fare{border-color:#a5b4fc;background:linear-gradient(135deg,#eef2ff,#f0f4ff)}
    .walkin-page .service-route-stat.fare i,.walkin-page .service-route-stat.fare strong{color:#4f46e5}
    .walkin-page .service-route-formula{margin-top:.55rem;color:#64748b;font-size:.68rem;text-align:center}

    /* Enterprise Payment Tabs */
    .walkin-page .ent-payment-tabs{display:flex;gap:10px;max-width:600px;margin:0 auto 1.5rem}
    .walkin-page .ent-payment-tab{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:0.75rem 1rem;border-radius:12px;border:2px solid #e2e8f0;background:#fff;color:#64748b;font-weight:600;font-size:0.85rem;cursor:pointer;transition:all 0.25s var(--sv-e)}
    .walkin-page .ent-payment-tab:hover{border-color:#94a3b8}
    .walkin-page .ent-payment-tab.active{border-color:var(--sv-b);background:rgba(37,99,235,0.04);color:var(--sv-b);box-shadow:0 0 0 3px rgba(37,99,235,0.08)}
    .walkin-page .ent-payment-tab i{font-size:1.1rem}

    /* RV Card (Fee/Review) */
    .walkin-page .rv-card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 4px 20px rgba(15,23,42,0.05);overflow:hidden;margin-bottom:1.25rem}
    .walkin-page .rv-card-body{padding:1.35rem}
    .walkin-page .rv-section-title{display:flex;align-items:center;gap:0.6rem;font-size:0.95rem;font-weight:700;color:#0f172a;margin-bottom:1.1rem}
    .walkin-page .rv-section-title i{color:#2563eb;font-size:1.1rem}
    .walkin-page .rv-box{background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;padding:1rem}
    .walkin-page .rv-row{display:flex;align-items:center;justify-content:space-between;padding:0.5rem 0;font-size:0.88rem}
    .walkin-page .rv-row:not(:last-child){border-bottom:1px solid #eef2f7}
    .walkin-page .rv-total .rv-row{font-size:1rem;font-weight:700;border-bottom:none;padding:0.35rem 0}

    /* Summary Box */
    .walkin-page .summary-box{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:14px;font-size:.86rem;color:#334155}

    /* Walkin Actions */
    .walkin-page .walkin-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:1rem;padding-top:1rem;border-top:1px solid #f1f5f9}

    /* Form Controls */
    .walkin-page .form-label{font-weight:600;font-size:.82rem;color:#475569;margin-bottom:6px}
    .walkin-page .form-control,.walkin-page .form-select{border-radius:10px;border-color:#e2e8f0;padding:10px 14px;font-size:.88rem;transition:border-color .2s,box-shadow .2s}
    .walkin-page .form-control:focus,.walkin-page .form-select:focus{border-color:#93c5fd;box-shadow:0 0 0 3px rgba(37,99,235,.1)}
    .walkin-page .customer-lookup-status{display:flex;align-items:flex-start;gap:9px;padding:10px 12px;border-radius:10px;font-size:.8rem;line-height:1.45;background:#f8fafc;border:1px solid #e2e8f0;color:#64748b}
    .walkin-page .customer-lookup-status.is-success{background:#f0fdf4;border-color:#bbf7d0;color:#166534}
    .walkin-page .customer-lookup-status.is-warning{background:#fffbeb;border-color:#fde68a;color:#92400e}
    .walkin-page .customer-lookup-status.is-loading{background:#eff6ff;border-color:#bfdbfe;color:#1e40af}
    .walkin-page .customer-lookup-status .spin{animation:walkinSpin .8s linear infinite}
    @keyframes walkinSpin{to{transform:rotate(360deg)}}
    .walkin-page .customer-detail-field.is-locked .form-control,.walkin-page .customer-detail-field.is-locked .form-select{background:#f8fafc;color:#475569}
    .walkin-page .customer-account-policy{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;margin-bottom:16px;border:1px solid #bfdbfe;border-radius:14px;background:linear-gradient(135deg,#eff6ff,#f8fafc);color:#334155;font-size:.82rem;line-height:1.5}
    .walkin-page .customer-account-policy>i{display:grid;place-items:center;width:34px;height:34px;flex:0 0 34px;border-radius:10px;background:#dbeafe;color:#1d4ed8;font-size:1rem}
    .walkin-page .customer-account-policy strong{display:block;color:#1e3a8a;font-size:.88rem;margin-bottom:2px}
    .walkin-page .existing-customer-card{display:flex;align-items:center;gap:12px;padding:13px 15px;margin-top:12px;border:1px solid #bbf7d0;border-radius:13px;background:#f0fdf4}
    .walkin-page .existing-customer-card>i{font-size:1.35rem;color:#15803d}
    .walkin-page .existing-customer-card strong{display:block;color:#166534;font-size:.86rem}
    .walkin-page .existing-customer-card span{display:block;color:#3f6212;font-size:.75rem;margin-top:2px}
    .walkin-page .new-customer-heading{display:flex;align-items:center;gap:9px;margin:16px 0 2px;padding:10px 12px;border-radius:11px;background:#fffbeb;color:#92400e;font-size:.8rem}
    .walkin-page .account-consent-panel{margin-top:16px;padding:14px 16px;border:1px solid #c7d2fe;border-radius:14px;background:#f5f7ff}
    .walkin-page .account-consent-panel .form-check{display:flex;align-items:flex-start;gap:10px;margin:0}
    .walkin-page .account-consent-panel .form-check-input{flex:0 0 auto;margin-top:3px}
    .walkin-page .account-consent-panel label{font-size:.8rem;line-height:1.45;color:#334155}
    .walkin-page .account-consent-panel label strong{display:block;color:#1e3a8a;margin-bottom:2px}

    /* Nav Tabs */
    .walkin-page .nav-tabs{border-bottom:2px solid #e2e8f0;gap:4px}
    .walkin-page .nav-tabs .nav-link{border:none;border-radius:10px 10px 0 0;padding:10px 20px;font-weight:600;font-size:.84rem;color:#64748b;background:transparent;transition:all .2s ease}
    .walkin-page .nav-tabs .nav-link:hover{color:#2563eb;background:#f1f5f9}
    .walkin-page .nav-tabs .nav-link.active{color:#1e40af;background:#fff;border-bottom:2px solid #2563eb;margin-bottom:-2px}

    /* Configure Service Modal — Enterprise */
    .walkin-page .cfg-header{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.25rem 1.5rem;background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 55%,#3b82f6 100%);color:#fff;position:relative}
    .walkin-page .cfg-header::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:14px;background:radial-gradient(120% 100% at 50% 0,rgba(37,99,235,0.25),transparent 70%)}
    .walkin-page .cfg-ico{width:46px;height:46px;border-radius:13px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.25);font-size:1.25rem;flex-shrink:0}
    .walkin-page .cfg-close{width:34px;height:34px;border-radius:50%;border:none;background:rgba(255,255,255,0.14);color:#fff;font-size:0.85rem;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s}
    .walkin-page .cfg-close:hover{background:rgba(255,255,255,0.28);transform:rotate(90deg)}
    .walkin-page .cfg-wizard{display:flex;align-items:center;gap:0.5rem;padding:1rem 1.75rem 0.25rem}
    .walkin-page .cfg-step{display:flex;align-items:center;gap:0.6rem}
    .walkin-page .cfg-dot{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.1rem;background:#f1f5f9;color:#94a3b8;border:2px solid #e2e8f0;transition:all .3s var(--sv-e)}
    .walkin-page .cfg-step.is-active .cfg-dot{background:#eff6ff;color:#2563eb;border-color:#2563eb;box-shadow:0 0 0 5px rgba(37,99,235,0.12)}
    .walkin-page .cfg-step.is-done .cfg-dot{background:linear-gradient(135deg,#10b981,#059669);color:#fff;border-color:#059669}
    .walkin-page .cfg-step-t{font-size:0.66rem;font-weight:800;text-transform:uppercase;letter-spacing:0.05em;color:#64748b}
    .walkin-page .cfg-step.is-active .cfg-step-t{color:#2563eb}
    .walkin-page .cfg-step-s{font-size:0.86rem;font-weight:700;color:#0f172a}
    .walkin-page .cfg-line{flex:1;height:3px;background:#e2e8f0;border-radius:99px;margin:0 0.4rem;transition:background .3s}
    .walkin-page .cfg-step.is-done + .cfg-line{background:linear-gradient(90deg,#10b981,#059669)}
    .walkin-page .cfg-note{border-radius:12px;background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.14);padding:0.8rem 1rem;color:#1e3a8a;font-size:0.85rem}
    .walkin-page .cfg-fl{display:block;font-size:0.82rem;font-weight:700;color:#334155;margin-bottom:0.3rem}
    .walkin-page .cfg-fl-sub{font-size:0.74rem;color:#94a3b8;font-weight:500}
    .walkin-page .cfg-f{width:100%;border:1.5px solid #e2e8f0;border-radius:12px;padding:0.6rem 0.8rem;font-size:0.85rem;resize:vertical;font-family:inherit;color:#0f172a;background:#fff}
    .walkin-page .cfg-f:focus{outline:none;border-color:#2563eb;box-shadow:0 0 0 4px rgba(37,99,235,0.1)}
    .walkin-page .cfg-qty-row{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:0.9rem 1rem;background:#f8fafc;border:1px solid #eef2f7;border-radius:14px}
    .walkin-page .cfg-stepper{display:inline-flex;align-items:center;background:#fff;border:1.5px solid #e2e8f0;border-radius:12px;overflow:hidden}
    .walkin-page .cfg-stepper button{width:40px;height:40px;border:none;background:#fff;color:#475569;font-size:1.05rem;cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center}
    .walkin-page .cfg-stepper button:hover{background:#eff6ff;color:#2563eb}
    .walkin-page .cfg-stepper input{width:56px;height:40px;border:none;text-align:center;font-weight:800;font-size:1.05rem;color:#0f172a;background:#fff;border-left:1px solid #eef2f7;border-right:1px solid #eef2f7}
    .walkin-page .cfg-price{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:0.9rem 1.1rem;border-radius:14px;background:#fff;border:1px solid #dbeafe}
    .walkin-page .cfg-price-inline{position:static;box-shadow:none;margin:0}
    .walkin-page .cfg-price-l{font-weight:700;color:#1e3a8a;font-size:0.9rem}
    .walkin-page .cfg-price-sub{display:block;font-size:0.7rem;color:#64748b;font-weight:500}
    .walkin-page .cfg-price-v{font-weight:800;color:#2563eb;font-size:1.35rem;letter-spacing:-0.02em}
    .walkin-page .cfg-footer{background:#f8fafc;border-top:1px solid #eef2f7!important;padding:1rem 1.5rem 1.25rem!important;display:flex!important;align-items:center;justify-content:flex-start;flex-wrap:wrap;gap:0.75rem 1rem}
    .walkin-page .cfg-btn-ghost{padding:0.65rem 1.3rem;border-radius:12px;border:1.5px solid #cbd5e1;background:#fff;color:#475569;font-weight:700;font-size:0.9rem;cursor:pointer;transition:all .2s}
    .walkin-page .cfg-btn-ghost:hover{background:#f1f5f9;color:#1e293b}
    .walkin-page .cfg-btn-primary{padding:0.65rem 1.5rem;border-radius:12px;border:none;background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;font-weight:700;font-size:0.9rem;box-shadow:0 6px 20px rgba(37,99,235,0.28);cursor:pointer;transition:all .2s;margin-left:auto;flex:0 0 auto;white-space:nowrap}
    .walkin-page .cfg-btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(37,99,235,0.34)}
    .walkin-page .cfg-btn-primary:disabled{opacity:0.55;cursor:not-allowed;transform:none;box-shadow:none}

    /* Aircon type & HP cards in modal */
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .cfg-step.is-done .cfg-dot{background:linear-gradient(135deg,#10b981,#059669);color:#fff;border-color:#059669}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .cfg-step.is-done + .cfg-line{background:linear-gradient(90deg,#10b981,#059669)}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .aircon-type-card{background:#fff!important;border:2px solid #e2e8f0!important;border-radius:16px!important;padding:1.1rem!important;cursor:pointer;transition:all .25s var(--sv-e);color:#0f172a!important;box-shadow:0 1px 3px rgba(15,23,42,0.05)!important;position:relative!important;overflow:hidden!important}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .aircon-type-card:hover{border-color:#3b82f6!important;background:rgba(59,130,246,0.03)!important;transform:translateY(-3px)!important;box-shadow:0 10px 26px rgba(37,99,235,0.14)!important}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .aircon-type-card.selected{border-color:#2563eb!important;background:linear-gradient(135deg,#eff6ff,#dbeafe)!important;box-shadow:0 8px 24px rgba(37,99,235,0.18)!important}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .aircon-type-card.selected::after{content:'\2713';position:absolute;top:10px;right:12px;width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;font-size:0.8rem;font-weight:900;display:flex;align-items:center;justify-content:center}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .aircon-type-card .bi{color:#2563eb!important}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .hp-option-card{background:#fff!important;border:2px solid #e2e8f0!important;border-radius:16px!important;padding:1rem!important;cursor:pointer;transition:all .25s var(--sv-e);color:#0f172a!important;box-shadow:0 1px 3px rgba(15,23,42,0.05)!important;position:relative!important;overflow:hidden!important}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .hp-option-card:hover{transform:translateY(-3px)!important;box-shadow:0 10px 26px rgba(37,99,235,0.14)!important}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .hp-option-card.selected{border-color:#3b82f6!important;background:linear-gradient(135deg,#eff6ff,#dbeafe)!important;box-shadow:0 4px 20px rgba(59,130,246,0.15)!important}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .hp-option-card .hp-checkbox{width:1.25rem;height:1.25rem;margin-right:1rem;accent-color:#3b82f6;cursor:pointer;flex-shrink:0}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .hp-option-card .hp-quantity-control{opacity:.5;pointer-events:none;transition:opacity .2s}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .hp-option-card.selected .hp-quantity-control{opacity:1;pointer-events:auto}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .hp-option-card .hp-qty-input{width:56px;height:40px;border:none;text-align:center;font-weight:800;font-size:1.05rem;color:#0f172a;background:#f8fafc;border-left:1px solid #eef2f7;border-right:1px solid #eef2f7}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .hp-option-card .badge.bg-primary{background:linear-gradient(135deg,#3b82f6,#2563eb)!important;color:#fff!important}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .hp-option-card .badge.bg-info.bg-opacity-10{background-color:#e0f2fe!important;color:#0369a1!important}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .hp-option-card .badge.bg-success.bg-opacity-10{background-color:#dcfce7!important;color:#15803d!important}

    /* Repair category cards */
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .repair-category-card{background:#fff;border:2px solid #e2e8f0;border-radius:16px;padding:1.1rem;cursor:pointer;transition:all .25s var(--sv-e);color:#0f172a;text-align:center;box-shadow:0 1px 3px rgba(15,23,42,0.05);position:relative;overflow:hidden;width:100%}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .repair-category-card:hover{border-color:#3b82f6;background:rgba(59,130,246,0.03);transform:translateY(-3px);box-shadow:0 10px 26px rgba(37,99,235,0.14)}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .repair-category-card.selected{border-color:#2563eb;background:linear-gradient(135deg,#eff6ff,#dbeafe);box-shadow:0 8px 24px rgba(37,99,235,0.18)}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .repair-category-card.selected::after{content:'\2713';position:absolute;top:10px;right:12px;width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;font-size:0.8rem;font-weight:900;display:flex;align-items:center;justify-content:center}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .unit-category-icon{width:48px;height:48px;border-radius:14px;display:inline-flex;align-items:center;justify-content:center;font-size:1.3rem;margin-bottom:.6rem}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .unit-category-icon.blue{background:linear-gradient(135deg,#dbeafe,#bfdbfe);color:#2563eb}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .unit-category-icon.amber{background:linear-gradient(135deg,#fef3c7,#fde68a);color:#d97706}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .unit-category-icon.violet{background:linear-gradient(135deg,#ede9fe,#ddd6fe);color:#7c3aed}

    /* Symptom chips */
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .symptom-chip{padding:0.45rem 0.9rem;border-radius:999px;border:1.5px solid #e2e8f0;background:#fff;color:#475569;font-size:0.8rem;font-weight:600;cursor:pointer;transition:all .2s var(--sv-e)}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .symptom-chip:hover{border-color:#f59e0b;background:#fffbeb;color:#92400e}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .symptom-chip.active{border-color:#f59e0b;background:linear-gradient(135deg,#fffbeb,#fef3c7);color:#92400e;box-shadow:0 4px 14px rgba(245,158,11,0.15)}

    /* Unit type chips */
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .unit-type-chip{padding:0.5rem 1rem;border-radius:12px;border:1.5px solid #e2e8f0;background:#fff;color:#475569;font-size:0.82rem;font-weight:600;cursor:pointer;transition:all .2s var(--sv-e)}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .unit-type-chip:hover{border-color:#93c5fd;background:#f0f7ff}
    .walkin-page :is(#serviceConfigModal,#repairInlineConfigurator) .unit-type-chip.active{border-color:#2563eb;background:linear-gradient(135deg,#eff6ff,#dbeafe);color:#1e40af;box-shadow:0 4px 14px rgba(37,99,235,0.15)}

    /* Customer booking-style repair panel when the shared configurator is mounted inline. */
    .walkin-page #repairInlineConfigurator #serviceConfigContent{box-shadow:none!important;border:0!important;border-radius:0!important;background:transparent!important;overflow:visible!important}
    .walkin-page #repairInlineConfigurator .cfg-header{background:linear-gradient(135deg,#eff6ff,#f0f9ff);border:1px solid #bfdbfe;border-radius:16px;margin-bottom:1rem;color:#0f172a}
    .walkin-page #repairInlineConfigurator .cfg-ico{background:linear-gradient(135deg,#3b82f6,#2563eb);border:0;color:#fff;box-shadow:0 4px 12px rgba(59,130,246,.3)}
    .walkin-page #repairInlineConfigurator .modal-body{padding:0!important;max-height:none!important;overflow:visible!important}
    .walkin-page #repairInlineConfigurator .repair-config{background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:1.25rem 1.5rem;margin-bottom:1rem!important}
    .walkin-page #repairInlineConfigurator .repair-config > .cfg-fl:first-child{font-size:.88rem;color:#0f172a}
    .walkin-page #repairInlineConfigurator .cfg-footer{border:1px solid #e2e8f0!important;border-radius:16px;background:linear-gradient(135deg,#f8fafc,#f1f5f9);margin-top:.25rem;padding:1rem 1.25rem!important}
    .walkin-page #repairInlineConfigurator .cfg-price{background:#fff}
    .walkin-page #repairInlineConfigurator .photo-upload-zone{border:2px dashed rgba(59,130,246,.25);border-radius:14px;padding:2rem;text-align:center;background:rgba(59,130,246,.02);cursor:pointer;transition:all .25s}
    .walkin-page #repairInlineConfigurator .photo-upload-zone:hover,.walkin-page #repairInlineConfigurator .photo-upload-zone.dragover{border-color:#3b82f6;background:rgba(59,130,246,.06)}
    .walkin-page #repairInlineConfigurator .photo-upload-icon{font-size:2rem;color:#94a3b8;margin-bottom:.5rem}
    .walkin-page #repairInlineConfigurator .photo-upload-text{font-weight:600;color:#475569;font-size:.9rem}
    .walkin-page #repairInlineConfigurator .photo-upload-text span{color:#2563eb;text-decoration:underline}
    .walkin-page #repairInlineConfigurator .photo-upload-hint{font-size:.78rem;color:#94a3b8;margin-top:4px}

    /* Responsive */
    @media(max-width:768px){
      .walkin-page .ent-hero{padding:2.5rem 0 3rem}
      .walkin-page .ent-stepper{position:relative;top:0}
      .walkin-page .ent-tr{overflow-x:auto;padding:4px}
      .walkin-page .ent-n{padding:5px 8px;font-size:0.65rem;white-space:nowrap}
      .walkin-page #timeSlots .time-slot{flex:1 1 100%;max-width:100%}
      .walkin-page .ent-step-body{padding:1rem}
      .walkin-page .walkin-technician-card{grid-template-columns:1fr}
      .walkin-page .service-map-toolbar{align-items:flex-start;flex-direction:column}
      .walkin-page .service-map-actions{display:grid;grid-template-columns:repeat(5,1fr);width:100%}
      .walkin-page .service-map-action{padding:.4rem}
      .walkin-page .service-map-action span{display:none}
      .walkin-page .service-checkout-map-card .technician-map{height:320px}
      .walkin-page .service-checkout-map-card.map-expanded .technician-map{height:440px}
      .walkin-page .service-map-selection{grid-template-columns:1fr}
      .walkin-page .service-map-coordinate{padding:.7rem 0 0 42px;border-top:1px solid #f1f5f9;border-left:0;text-align:left}
      .walkin-page .service-route-stats{grid-template-columns:repeat(2,1fr)}
    }
  </style>

  <% if (typeof airconOrdersEnabled !== 'undefined' && airconOrdersEnabled) { %>
    <nav class="walkin-mode-tabs" aria-label="Walk-in transaction type">
      <button type="button" class="walkin-mode-tab active" data-walkin-mode="services" aria-selected="true"><i class="bi bi-tools"></i>Services</button>
      <button type="button" class="walkin-mode-tab" data-walkin-mode="aircon" aria-selected="false"><i class="bi bi-snow"></i>Aircon Orders</button>
    </nav>
  <% } %>

  <div id="walkinServicesPane">
