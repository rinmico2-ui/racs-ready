  <div class="card border-0 shadow-sm mb-4 core-filter-card">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label small text-uppercase text-muted fw-bold"><i class="bi bi-search me-1 text-primary"></i>Search Service</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"
              ><i class="bi bi-search text-muted"></i
            ></span>
            <input
              type="text"
              class="form-control border-start-0 bg-light"
              placeholder="Service name, code, or category"
            />
          </div>
        </div>
        <div class="col-md-3">
          <label class="form-label small text-uppercase text-muted fw-bold"><i class="bi bi-tags me-1 text-primary"></i>Category</label>
          <select class="form-select">
            <option>All Categories</option>
            <option>Cleaning</option>
            <option>Installation</option>
            <option>Maintenance</option>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small text-uppercase text-muted fw-bold"><i class="bi bi-check2-circle me-1 text-primary"></i>Status</label>
          <select class="form-select">
            <option>All</option>
            <option>Active</option>
            <option>Draft</option>
            <option>Archived</option>
          </select>
        </div>
