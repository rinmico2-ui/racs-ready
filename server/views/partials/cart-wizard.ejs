  .pickup-panel .dayContainer {
    display: grid !important;
    grid-template-columns: repeat(7, 1fr);
    gap: 10px;
    width: 100% !important;
    min-width: 0 !important;
  }
  .pickup-panel .flatpickr-day {
    border-radius: 50%;
    color: #334155;
    font-weight: 600;
    transition: all 0.2s;
    width: 100%;
    max-width: 56px;
    aspect-ratio: 1;
    margin: 0;
    justify-self: center;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
