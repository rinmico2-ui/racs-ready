    let cardPage = 0;
    const CARDS_PER_PAGE = 3;

    function renderCardPage() {
      const container = document.getElementById('assignmentsContainer');
      const nav = document.getElementById('jobCardNav');
      const rangeEl = document.getElementById('jobCardRange');
      const prevBtn = document.getElementById('jobCardPrev');
      const nextBtn = document.getElementById('jobCardNext');

      if (!allItems || allItems.length === 0) {
        container.innerHTML = renderEmpty();
        nav.style.display = 'none';
        return;
      }

      const totalPages = Math.ceil(allItems.length / CARDS_PER_PAGE);
      if (cardPage >= totalPages) cardPage = totalPages - 1;
      if (cardPage < 0) cardPage = 0;

      const start = cardPage * CARDS_PER_PAGE;
      const end = Math.min(start + CARDS_PER_PAGE, allItems.length);
      const pageItems = allItems.slice(start, end);

      container.innerHTML = pageItems.map(a => {
        const isCurrentJob = a.status === 'en_route' || a.status === 'in_progress' || a.status === 'on_site';
        return renderCard(a, isCurrentJob);
      }).join('');

      if (totalPages <= 1) {
        nav.style.display = 'none';
      } else {
        nav.style.display = 'flex';
        rangeEl.textContent = `${start + 1} – ${end} of ${allItems.length}`;
        prevBtn.disabled = cardPage === 0;
        nextBtn.disabled = cardPage >= totalPages - 1;
      }
    }

