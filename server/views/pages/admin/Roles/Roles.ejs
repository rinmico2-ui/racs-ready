<div class="admin-dashboard container-fluid py-4 inventory-premium settings-roles-page">
  <%- include('../../../partials/dashboard-styles') %>

  <style>
    .settings-roles-page { font-family: "Inter", sans-serif; }
    .settings-roles-page h1,
    .settings-roles-page h2,
    .settings-roles-page h3,
    .settings-roles-page h4,
    .settings-roles-page h5,
    .settings-roles-page .role-name,
    .settings-roles-page .perm-group-title { font-family: "Outfit", sans-serif; }

    /* ── Role Cards ─────────────────────────────────────── */
    .role-card {
      cursor: pointer;
      position: relative;
      overflow: hidden;
      border: 2px solid transparent;
      min-height: 130px;
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s;
    }
    .role-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(15, 23, 42, .1); }
    .role-card.active { border-color: var(--dash-primary) !important; box-shadow: 0 0 0 4px rgba(37, 99, 235, .13) !important; }
    .role-card .role-icon {
      width: 56px; height: 56px; border-radius: 18px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.6rem; color: #fff; flex-shrink: 0;
      box-shadow: 0 6px 18px rgba(0, 0, 0, .1);
      transition: transform .2s ease;
    }
    .role-card:hover .role-icon { transform: scale(1.05); }
    .role-card .role-name { font-size: 1rem; font-weight: 600; color: #0f172a; line-height: 1.2; }
    .role-card .role-desc { font-size: .75rem; color: #64748b; line-height: 1.4; margin-top: 4px; min-height: 2.1rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .role-card .role-meta { font-size: .65rem; color: #64748b; display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; margin-top: auto; }
    .role-card .role-stat { display: inline-flex; align-items: center; }
    .role-card .role-bar {
      position: absolute; bottom: 0; left: 0; right: 0; height: 4px;
      border-radius: 0 0 var(--dash-card-radius) var(--dash-card-radius);
    }

    /* ── Permission Panel ───────────────────────────────── */
    .perm-group { margin-bottom: 1.5rem; }
    .perm-group-title {
      font-size: .85rem; font-weight: 700; color: #334155;
      text-transform: uppercase; letter-spacing: .04em;
      padding-bottom: .35rem; margin-bottom: .5rem;
      border-bottom: 1px solid var(--dash-border);
    }
    .perm-item {
      display: flex; align-items: center; justify-content: space-between;
      gap: .75rem; padding: .45rem .55rem; border-radius: 10px;
      transition: background .12s;
    }
    .perm-item:hover { background: #f8fafc; }
    .perm-label { font-size: .85rem; font-weight: 500; color: #1e293b; cursor: pointer; margin: 0; }
    .perm-label .perm-key { font-size: .65rem; color: #94a3b8; font-weight: 500; background: #f1f5f9; padding: .06rem .28rem; border-radius: 4px; }
    .perm-switch { padding-left: 0; margin: 0; }
    .perm-switch .form-check-input {
      width: 2.2em; height: 1.15em; cursor: pointer; border-color: #cbd5e1;
    }
    .perm-switch .form-check-input:checked {
      background-color: var(--dash-primary); border-color: var(--dash-primary);
    }

    /* ── Users Panel ────────────────────────────────────── */
    .user-row {
      display: flex; align-items: center; gap: .75rem;
      padding: .7rem .6rem; border-bottom: 1px solid var(--dash-border);
      transition: background .12s;
    }
    .user-row:hover { background: #f8fafc; }
    .user-row:last-child { border-bottom: none; }
    .user-avatar {
      width: 38px; height: 38px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-weight: 700; font-size: .8rem; flex-shrink: 0;
      text-transform: uppercase;
    }
    .user-name { font-size: .85rem; font-weight: 600; color: #0f172a; }
    .user-email { font-size: .75rem; color: #94a3b8; }
    .user-badge {
      font-size: .65rem; font-weight: 700; padding: .15rem .5rem;
      border-radius: 999px; letter-spacing: .03em;
    }
    .badge-custom { background: rgba(245, 158, 11, .14); color: #d97706; }
    .badge-default { background: rgba(16, 185, 129, .14); color: #059669; }

    /* ── Pagination ─────────────────────────────────────── */
    .inv-pagination { display: flex; gap: .5rem; margin: 0; padding: 0; list-style: none; }
    .inv-pagination .page-item .page-link {
      padding: 8px 14px; border-radius: 10px;
      border: 1.5px solid rgba(148, 163, 184, .3);
      background: rgba(255, 255, 255, .8); color: #475569;
      font-weight: 600; font-size: .85rem; transition: all .3s ease;
    }
    .inv-pagination .page-item:not(.disabled):not(.active) .page-link:hover {
      background: #fff; border-color: #2563eb; color: #2563eb;
    }
    .inv-pagination .page-item.disabled .page-link,
    .inv-pagination .page-item .page-link:disabled { opacity: .5; cursor: not-allowed; }
    .inv-pagination .page-item.active .page-link { background: #2563eb; border-color: #2563eb; color: #fff; }

    /* ── Toasts ─────────────────────────────────────────── */
    .toast-container {
      position: fixed; bottom: 24px; right: 24px; z-index: 9999;
      display: flex; flex-direction: column; gap: 8px;
    }
    .toast-msg {
      background: #0f172a; color: #fff; padding: 10px 20px;
      border-radius: 10px; font-size: .82rem; font-weight: 500;
      box-shadow: 0 4px 16px rgba(0,0,0,.18); animation: slideIn .3s ease;
    }
    .toast-msg.toast-error { background: var(--dash-danger); }
    @keyframes slideIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  </style>

  <div class="main-content">

    <!-- Hero -->
    <div class="au-hero mb-4">
      <div class="au-hero-inner">
        <div class="au-hero-left">
          <div class="au-hero-icon"><i class="bi bi-shield-check"></i></div>
          <div>
            <h1>Role Management</h1>
            <p>Manage roles, permissions, and user access in one place.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Role Cards -->
    <div class="row g-3 mb-3" id="roleCards">
      <% const colors = { admin: ['#2563eb','#1d4ed8'], secretary: ['#14b8a6','#0f766e'], technician: ['#f59e0b','#d97706'], customer: ['#8b5cf6','#6d28d9'] }; %>
      <% const icons  = { admin: 'bi-person-fill-gear', secretary: 'bi-person-badge', technician: 'bi-tools', customer: 'bi-person' }; %>
      <% (roles || []).forEach(function(r) { %>
        <div class="col-12 col-md-6 col-xl-3">
          <div class="role-card dash-card h-100" data-role-id="<%= r._id %>" data-role-name="<%= r.name %>">
            <div class="d-flex align-items-start gap-3">
              <div class="kpi-icon" style="background: linear-gradient(135deg, <%= (colors[r.name]||['#6b7280','#4b5563'])[0] %>, <%= (colors[r.name]||['#6b7280','#4b5563'])[1] %>)">
                <i class="bi <%= icons[r.name] || 'bi-person' %>"></i>
              </div>
              <div class="flex-grow-1 min-width-0">
                <div class="kpi-title">Role</div>
                <div class="inv-kpi-value text-truncate mb-1" style="font-size:1.05rem; font-weight:600 !important;"><%= r.label || r.name %></div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <span class="kpi-trend"><i class="bi bi-people-fill"></i><%= r.userCount || 0 %> user<%= (r.userCount||0) === 1 ? '' : 's' %></span>
                  <% if (r.isSystem) { %>
                    <span class="badge inv-kpi-pill bg-light text-secondary border"><i class="bi bi-lock-fill me-1"></i>system</span>
                  <% } %>
                </div>
                <span class="inv-kpi-sub d-block mt-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"><%= r.description || '' %></span>
                <span class="inv-kpi-sub d-block mt-1" id="role-<%= r._id %>-perms"><i class="bi bi-key me-1"></i><%= (r.permissions||[]).length %> permission<%= ((r.permissions||[]).length) === 1 ? '' : 's' %></span>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="row g-3 mt-3">
      <!-- Permissions Panel -->
      <div class="col-12 col-lg-7">
        <div id="permPanel" class="card border-0 shadow-sm h-100">
          <div class="card-header bg-white p-3 border-bottom">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
              <div>
                <h5 class="fw-bold mb-1"><span id="permPanelTitle">Role</span> — Permissions</h5>
                <p class="text-muted small mb-0" id="permPanelDesc"></p>
              </div>
              <div class="d-flex gap-2">
                <button class="btn btn-sm btn-light" id="btnSelectAll"><i class="bi bi-check-all me-1"></i>Select All</button>
                <button class="btn btn-sm btn-light" id="btnDeselectAll"><i class="bi bi-x-lg me-1"></i>Clear</button>
                <button class="btn btn-sm btn-primary" id="btnSavePerms"><i class="bi bi-floppy me-1"></i>Save</button>
              </div>
            </div>
          </div>
          <div class="card-body p-3">
            <div id="permMatrix" style="max-height: 520px; overflow-y: auto;"></div>
          </div>
        </div>
      </div>

      <!-- Users Panel -->
      <div class="col-12 col-lg-5">
        <div id="usersPanel" class="card border-0 shadow-sm h-100">
          <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0"><span id="usersPanelTitle">Role</span> — Users</h5>
            <span class="badge bg-primary rounded-pill" id="usersPanelCount">0</span>
          </div>
          <div class="card-body p-3">
            <div id="usersList"></div>
            <div class="mt-4 pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
              <div id="users-range" class="text-muted small"></div>
              <nav aria-label="Users pagination">
                <ul id="users-pagination" class="inv-pagination mb-0"></ul>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- User Permission Override Modal -->
    <div class="modal fade" id="userPermModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="userPermModalTitle">User Permission Overrides</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body" id="userPermBody"></div>
          <div class="modal-footer">
            <button class="btn btn-outline-secondary btn-sm" id="btnResetUserPerms"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Role Defaults</button>
            <button class="btn btn-primary btn-sm" id="btnSaveUserPerms"><i class="bi bi-floppy me-1"></i>Save Overrides</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastBox"></div>
  </div>
</div>

<script>
(function () {
  "use strict";

  /* ── Server-injected data ─────────────────────────────── */
  const ROLES   = <%- JSON.stringify(roles || []) %>;
  const CATALOG = <%- JSON.stringify(catalog || []) %>;
  const API     = "/api/admin";

  let selectedRoleId   = null;
  let selectedRoleName = null;
  let userPermUserId   = null;

  /* ── Toast helper ─────────────────────────────────────── */
  function toast(msg, isError) {
    const box = document.getElementById("toastBox");
    const el  = document.createElement("div");
    el.className = "toast-msg" + (isError ? " toast-error" : "");
    el.textContent = msg;
    box.appendChild(el);
    setTimeout(() => el.remove(), 3200);
  }

  /* ── Role colors for avatars ──────────────────────────── */
  function roleGradient(name) {
    const c = { admin: ['#2563eb','#1d4ed8'], secretary: ['#14b8a6','#0f766e'], technician: ['#f59e0b','#d97706'], customer: ['#8b5cf6','#6d28d9'] }[name];
    const def = ['#6b7280','#4b5563'];
    const pair = c || def;
    return 'linear-gradient(135deg, ' + pair[0] + ', ' + pair[1] + ')';
  }

  /* ── Permission matrix builder ────────────────────────── */
  function renderPermMatrix(activePerms, containerId, prefix) {
    const container = document.getElementById(containerId);
    container.innerHTML = "";
    CATALOG.forEach(function (group) {
      const div = document.createElement("div");
      div.className = "perm-group";
      let html = '<div class="perm-group-title">' + group.group + "</div>";
      group.permissions.forEach(function (p) {
        const checked = activePerms.includes(p.key) ? "checked" : "";
        const id = prefix + "-" + p.key.replace(/\./g, "-");
        html +=
          '<div class="perm-item">' +
            '<label class="perm-label" for="' + id + '">' +
              p.label + ' <code class="perm-key">' + p.key + '</code>' +
            '</label>' +
            '<div class="form-check form-switch perm-switch">' +
              '<input class="form-check-input" type="checkbox" role="switch" id="' + id + '" data-perm="' + p.key + '" ' + checked + '>' +
            '</div>' +
          '</div>';
      });
      div.innerHTML = html;
      container.appendChild(div);
    });
  }

  function getCheckedPerms(containerId) {
    var checks = document.querySelectorAll("#" + containerId + " input[data-perm]");
    var out = [];
    checks.forEach(function (cb) { if (cb.checked) out.push(cb.dataset.perm); });
    return out;
  }

  /* ── Role card click ──────────────────────────────────── */
  document.getElementById("roleCards").addEventListener("click", function (e) {
    var card = e.target.closest(".role-card");
    if (!card) return;
    document.querySelectorAll(".role-card").forEach(function (c) { c.classList.remove("active"); });
    card.classList.add("active");
    selectedRoleId   = card.dataset.roleId;
    selectedRoleName = card.dataset.roleName;
    loadRoleDetails(selectedRoleId);
  });

  async function loadRoleDetails(roleId) {
    try {
      var resp = await fetch(API + "/roles/" + roleId);
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || "Failed");
      var role = data.role;

      // permission panel
      document.getElementById("permPanelTitle").textContent = role.label || role.name;
      document.getElementById("permPanelDesc").textContent  = role.description || "Configure permissions for this role.";
      renderPermMatrix(role.permissions || [], "permMatrix", "rp");
      document.getElementById("permPanel").style.display = "";

      // users panel
      loadRoleUsers(roleId, role.label || role.name);
    } catch (err) {
      toast(err.message, true);
    }
  }

  let currentUsersData = [];
  let userPageSize = 5;
  let userCurrentPage = 1;

  function renderUsersPage(page) {
    var start = (page - 1) * userPageSize;
    var slice = currentUsersData.slice(start, start + userPageSize);
    var html = "";
    if (currentUsersData.length === 0) {
      html = '<div class="text-center text-muted py-5"><i class="bi bi-person-x fs-4 d-block mb-2"></i>No users with this role.</div>';
    } else {
      slice.forEach(function (u) {
        var initials = ((u.firstName || "")[0] || "") + ((u.lastName || "")[0] || "");
        var hasCustom = Array.isArray(u.permissions) && u.permissions.length > 0;
        var fullName = ((u.firstName || "") + " " + (u.lastName || "")).trim();
        var bg = roleGradient(selectedRoleName);
        html +=
          '<div class="user-row" data-user-id="' + u._id + '">' +
            '<div class="user-avatar" style="background: ' + bg + '">' + (initials || '<i class="bi bi-person"></i>') + '</div>' +
            '<div class="flex-grow-1 min-width-0">' +
              '<div class="user-name text-truncate">' + fullName + '</div>' +
              '<div class="user-email text-truncate text-micro">' + (u.email || "") + '</div>' +
            '</div>' +
            '<span class="user-badge ' + (hasCustom ? 'badge-custom' : 'badge-default') + ' me-2">' +
              (hasCustom ? 'Custom' : 'Default') +
            '</span>' +
            '<button class="btn btn-sm btn-outline-primary btn-edit-user-perms" data-user-id="' + u._id + '" data-user-name="' + fullName + '" data-user-perms=\'' + JSON.stringify(u.permissions || []) + '\' title="Edit permissions">' +
              '<i class="bi bi-sliders"></i>' +
            '</button>' +
          '</div>';
      });
    }
    document.getElementById("usersList").innerHTML = html;

    // pagination metadata
    const rangeEl = document.getElementById("users-range");
    const total = currentUsersData.length;
    if (total === 0) {
      rangeEl.textContent = "—";
      document.getElementById("users-pagination").innerHTML = "";
      return;
    }
    const from = start + 1;
    const to = Math.min(start + userPageSize, total);
    rangeEl.textContent = from + " to " + to + " of " + total;

    const pages = Math.ceil(total / userPageSize);
    const ul = document.getElementById('users-pagination');
    ul.innerHTML = '';

    const prevLi = document.createElement('li');
    prevLi.className = 'page-item' + (userCurrentPage <= 1 ? ' disabled' : '');
    prevLi.innerHTML = '<a class="page-link" href="#" aria-label="Previous"><i class="bi bi-chevron-left"></i></a>';
    prevLi.addEventListener('click', function (e) { e.preventDefault(); if (userCurrentPage > 1) { userCurrentPage--; renderUsersPage(userCurrentPage); } });
    ul.appendChild(prevLi);

    const indicatorLi = document.createElement('li');
    indicatorLi.className = 'page-item active';
    indicatorLi.innerHTML = '<span class="page-link">' + userCurrentPage + ' / ' + pages + '</span>';
    ul.appendChild(indicatorLi);

    const nextLi = document.createElement('li');
    nextLi.className = 'page-item' + (userCurrentPage >= pages ? ' disabled' : '');
    nextLi.innerHTML = '<a class="page-link" href="#" aria-label="Next"><i class="bi bi-chevron-right"></i></a>';
    nextLi.addEventListener('click', function (e) { e.preventDefault(); if (userCurrentPage < pages) { userCurrentPage++; renderUsersPage(userCurrentPage); } });
    ul.appendChild(nextLi);
  }

  async function loadRoleUsers(roleId, label) {
    try {
      var resp = await fetch(API + "/roles/" + roleId + "/users");
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || "Failed");

      currentUsersData = data.users || [];
      userCurrentPage = 1;

      document.getElementById("usersPanelTitle").textContent = label;
      document.getElementById("usersPanelCount").textContent = currentUsersData.length + " user" + (currentUsersData.length === 1 ? "" : "s");

      renderUsersPage(userCurrentPage);
      document.getElementById("usersPanel").style.display = "";
    } catch (err) {
      toast(err.message, true);
    }
  }

  /* ── Select All / Deselect All ────────────────────────── */
  document.getElementById("btnSelectAll").addEventListener("click", function () {
    document.querySelectorAll("#permMatrix input[data-perm]").forEach(function (cb) { cb.checked = true; });
  });
  document.getElementById("btnDeselectAll").addEventListener("click", function () {
    document.querySelectorAll("#permMatrix input[data-perm]").forEach(function (cb) { cb.checked = false; });
  });

  /* ── Save role permissions ────────────────────────────── */
  document.getElementById("btnSavePerms").addEventListener("click", async function () {
    if (!selectedRoleId) return;
    var perms = getCheckedPerms("permMatrix");
    try {
      var resp = await fetch(API + "/roles/" + selectedRoleId, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ permissions: perms }),
      });
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || "Failed to save");
      toast("Permissions saved for " + (data.role.label || data.role.name));
      // update the card permission count
      var countEl = document.getElementById('role-' + selectedRoleId + '-perms');
      if (countEl) {
        countEl.innerHTML = '<i class="bi bi-key me-1"></i>' + perms.length + " permission" + (perms.length === 1 ? "" : "s");
      }
    } catch (err) {
      toast(err.message, true);
    }
  });

  /* ── User permission override modal ───────────────────── */
  document.getElementById("usersList").addEventListener("click", function (e) {
    var btn = e.target.closest(".btn-edit-user-perms");
    if (!btn) return;
    userPermUserId = btn.dataset.userId;
    var userName   = btn.dataset.userName;
    var userPerms  = JSON.parse(btn.dataset.userPerms || "[]");

    document.getElementById("userPermModalTitle").textContent = "Permissions — " + userName.trim();

    // If user has custom overrides, use those; otherwise use the role's current perms as starting point
    var permsToRender = userPerms.length > 0 ? userPerms : getCheckedPerms("permMatrix");
    renderPermMatrix(permsToRender, "userPermBody", "up");

    var modal = new bootstrap.Modal(document.getElementById("userPermModal"));
    modal.show();
  });

  /* ── Save user permission overrides ───────────────────── */
  document.getElementById("btnSaveUserPerms").addEventListener("click", async function () {
    if (!userPermUserId) return;
    var perms = getCheckedPerms("userPermBody");
    try {
      var resp = await fetch(API + "/users/" + userPermUserId + "/permissions", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ permissions: perms }),
      });
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || "Failed to save");
      toast("User permissions saved");
      bootstrap.Modal.getInstance(document.getElementById("userPermModal")).hide();
      // refresh user list
      if (selectedRoleId) loadRoleUsers(selectedRoleId, document.getElementById("usersPanelTitle").textContent);
    } catch (err) {
      toast(err.message, true);
    }
  });

  /* ── Reset user to role defaults ──────────────────────── */
  document.getElementById("btnResetUserPerms").addEventListener("click", async function () {
    if (!userPermUserId) return;
    if (!confirm("Reset this user to the role's default permissions?")) return;
    try {
      var resp = await fetch(API + "/users/" + userPermUserId + "/permissions", {
        method: "DELETE",
      });
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || "Failed");
      toast("Permissions reset to role defaults");
      bootstrap.Modal.getInstance(document.getElementById("userPermModal")).hide();
      if (selectedRoleId) loadRoleUsers(selectedRoleId, document.getElementById("usersPanelTitle").textContent);
    } catch (err) {
      toast(err.message, true);
    }
  });

  /* ── Auto-select first role ───────────────────────────── */
  document.addEventListener("DOMContentLoaded", function () {
    var firstCard = document.querySelector(".role-card");
    if (firstCard) firstCard.click();
  });

})();
</script>
