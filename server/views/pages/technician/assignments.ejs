  async function _fetchAiDiagnosticsForInspection(bookingId) {
    try {
      // First try to get existing AI data from the booking
      const resp = await fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' });
      const detail = await resp.json();
      const booking = detail.booking || detail;
      const ta = booking.technicianAssistant;

      if (ta && ta.probableCauses && ta.probableCauses.length > 0) {
        // AI data already exists, use it
        _populateInspectionFromAi(ta, booking);
      } else {
        // Generate new AI diagnosis
        const aiResp = await fetch(`/api/technician/appointments/${bookingId}/ai-diagnose`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin'
        });
        const aiData = await aiResp.json();
        if (aiResp.ok && aiData.success) {
          _populateInspectionFromAi(aiData.technicianAssistant, booking);
        } else {
          // No AI data available, show empty form
          _showInspectionFormSections();
        }
      }
    } catch (e) {
      console.error('[Inspection] Error fetching AI diagnostics:', e);
      _showInspectionFormSections();
    }
  }

  function _populateInspectionFromAi(ta, booking) {
    // Build diagnosis checklist from AI probable causes
    window._inspDiagnoses = (ta.probableCauses || []).map((c, i) => ({
      id: 'ai_' + i,
      text: c.cause || c,
      explanation: c.explanation || '',
      likelihood: c.likelihood || 'medium',
      checked: true,
      source: 'ai'
    }));

    // Build parts list from AI suggested parts
    window._inspParts = (ta.possibleParts || []).map((p, i) => {
      const name = typeof p === 'string' ? p : (p.name || p);
      const cost = typeof p === 'object' ? (p.estimatedCostPHP || 0) : 0;
      const likelihood = typeof p === 'object' ? (p.likelihood || 'medium') : 'medium';
      const purpose = typeof p === 'object' ? (p.purpose || '') : '';
      return {
        id: 'ai_part_' + i,
        name, cost, quantity: 1, likelihood, purpose,
        checked: true, source: 'ai', toolId: null
      };
    });

    // Store AI duration and complexity
    const duration = ta.estimatedDurationMinutes || 90;
    const complexity = ta.repairComplexity || 'medium';
    window._aiDuration = duration;
    window._aiComplexity = complexity;

    // Set labor cost
    const laborRates = { low: 350, medium: 500, high: 700 };
    const laborRate = laborRates[complexity] || 500;
    const laborCost = Math.round((duration / 60) * laborRate);
    document.getElementById('quotationLaborCost').value = laborCost;

    const laborCatMap = { low: 'standard', medium: 'standard', high: 'complex' };
    document.getElementById('quotationLaborCategory').value = laborCatMap[complexity] || 'standard';

    // Render AI summary screen
    _renderAiSummary(ta);
    _showInspectionFormSections();
    _matchAiPartsToInventory().then(() => {
      _saveInspectionState(_repairBookingId);
    });
  }

