    async function loadServiceCalendarMonth() {
      if (!state.selectedServiceId) return;
      const start = startOfMonth(state.calendar.activeMonth);
      const end = addMonths(start, 1);
      const params = new URLSearchParams({
        start: formatDateKey(start),
        end: formatDateKey(end),
      });
      if (techEl.value) params.set("technicianId", techEl.value);

      try {
        const r = await fetch(
          `/api/services/${encodeURIComponent(state.selectedServiceId)}/calendar?${params.toString()}`,
          { cache: "no-store" },
        );
        const j = await r.json();
        state.calendar.bookedDates = new Set(j.bookedDates || []);
        state.calendar.blockedDates = new Set(j.blockedDates || []);
        state.calendar.publicHolidays = new Map(
          (j.publicHolidays || []).map((h) => [h.date, h.name || ""]),
        );
      } catch (e) {
        state.calendar.bookedDates = new Set();
        state.calendar.blockedDates = new Set();
        state.calendar.publicHolidays = new Map();
      }
    }

    function resolveDateStatus(date) {
      const key = formatDateKey(date);
      const now = new Date();
      const today = startOfDay(now);
      const totalCurrentMinutes = now.getHours() * 60 + now.getMinutes();
      const workingDayEndMinutes = 19 * 60; // 7 PM (includes overtime)
      
      // Block dates before today
      if (date < today) return "blocked";
      
      // Block current date if past working hours (5 PM)
      if (isSameDate(date, today) && totalCurrentMinutes > workingDayEndMinutes) {
        return "blocked";
      }
      
      // Block technician rest dates
      if (state.calendar.restDates.has(key)) return "blocked";
      
      // Block technician non-working weekdays
      if (state.calendar.nonWorkingWeekdays.includes(date.getDay()))
        return "blocked";
      
      // Block booked dates
      if (state.calendar.bookedDates.has(key)) return "booked";
      
      // Block public holidays
      if (state.calendar.publicHolidays.has(key)) return "public";
      
      // Block explicitly blocked dates
      if (state.calendar.blockedDates.has(key)) return "blocked";
      
      return "available";
    }

    async function renderLegacyCalendar() {
      if (!calendarGridEl) return;
      await loadServiceCalendarMonth();

      const month = state.calendar.activeMonth;
      calendarLabelEl.textContent = new Intl.DateTimeFormat("en-US", {
        month: "long",
        year: "numeric",
      }).format(month);

      calendarGridEl.innerHTML = "";
      const year = month.getFullYear();
      const m = month.getMonth();
      const lead = new Date(year, m, 1).getDay();
      for (let i = 0; i < lead; i++) {
        const filler = document.createElement("div");
        filler.className = "calendar-cell disabled";
        calendarGridEl.appendChild(filler);
      }

      const days = new Date(year, m + 1, 0).getDate();
      for (let day = 1; day <= days; day++) {
        const date = new Date(year, m, day);
        const status = resolveDateStatus(date);
        const cell = document.createElement("button");
        cell.type = "button";
        cell.className = "calendar-cell";
        cell.dataset.status = status;
        cell.textContent = String(day).padStart(2, "0");
        if (status !== "available") {
          cell.classList.add("disabled");
          cell.disabled = true;
        } else {
          cell.addEventListener("click", async () => {
            state.selectedDate = startOfDay(date);
            state.selectedStartMinutes = null;
            await renderLegacyCalendar();
            await renderLegacyTimeSlotsForDate(state.selectedDate);
            updateSummary();
          });
        }
        if (state.selectedDate && isSameDate(state.selectedDate, date))
          cell.classList.add("is-selected");
        calendarGridEl.appendChild(cell);
      }
    }

    async function renderLegacyTimeSlotsForDate(date) {
      if (!date) return;
      const dateKey = formatDateKey(date);

      timeSelectionEl.classList.remove("d-none");
      timeSlotsEl.innerHTML = "";
      timeNoticeEl.textContent = "Loading available slots...";

      const params = new URLSearchParams({
        date: dateKey,
        serviceId: state.selectedServiceId,
        durationMinutes: String(bookingDuration()),
      });
      if (techEl.value) params.set("technicianId", techEl.value);
      if (
        Number.isFinite(Number(state.travelTime)) &&
        Number(state.travelTime) > 0
      )
        params.set("travelTime", String(state.travelTime));

      try {
        const r = await fetch(
          `/api/services/availability?${params.toString()}`,
          { cache: "no-store" },
        );
        const j = await r.json();
        const slots = j.slots || [];

        if (!slots.length) {
          timeNoticeEl.textContent = "No available slots for this date.";
          timeRangeInfoEl.textContent = "";
          return;
        }

        timeNoticeEl.textContent = "";
        const available = slots.filter((s) => s.status === "available");
        if (available.length) {
          timeRangeInfoEl.textContent = `Available between ${minutesToLabel(available[0].startMinutes)} and ${minutesToLabel(available[available.length - 1].endMinutes)}`;
        } else {
          timeRangeInfoEl.textContent = "No available times";
        }

        // Enhanced past-time blocking with buffer
        const now = new Date();
        const today = startOfDay(now);
        const currentHour = now.getHours();
        const currentMinutes = now.getMinutes();
        const totalCurrentMinutes = currentHour * 60 + currentMinutes;
        const bufferMinutes = 30; // 30-minute buffer
        const isToday = isSameDate(date, today);

        slots.forEach((slot) => {
          // Check if this time slot is in the past for today
          let isPastTime = false;
          if (isToday && slot.status === "available") {
            // If the slot start time is earlier than current time plus buffer, mark as past
            if (slot.startMinutes <= (totalCurrentMinutes + bufferMinutes)) {
              isPastTime = true;
            }
          }

          // Skip past time slots completely - don't render them at all
          if (isPastTime) {
            return; // Skip this iteration, don't create the button
          }

          const btn = document.createElement("button");
          btn.type = "button";
          btn.className =
            "time-slot btn btn-sm d-flex flex-column align-items-start gap-0 px-3 py-2";
          btn.dataset.start = String(slot.startMinutes);

          const line1 = document.createElement("span");
          line1.className = "fw-semibold";
          line1.textContent =
            slot.label ||
            `${minutesToLabel(slot.startMinutes)} - ${minutesToLabel(slot.endMinutes)}`;
          btn.appendChild(line1);

          if (slot.detail) {
            const line2 = document.createElement("span");
            line2.className = "small text-muted";
            line2.style.fontSize = ".72rem";
            line2.textContent = slot.detail;
            btn.appendChild(line2);
          }

          if (slot.status !== "available") {
            btn.disabled = true;
            btn.classList.add("disabled");
            if (slot.status === "booked") {
              btn.title = "Already reserved";
            } else if (slot.status === "blocked") {
              btn.title = "Not working";
            }
          } else {
            btn.addEventListener("click", () => {
              timeSlotsEl
                .querySelectorAll(".time-slot")
                .forEach((n) => n.classList.remove("active"));
              btn.classList.add("active");
              state.selectedStartMinutes = Number(slot.startMinutes);
              updateSummary();
            });
          }

          if (
            state.selectedStartMinutes != null &&
            Number(state.selectedStartMinutes) === Number(slot.startMinutes)
          )
            btn.classList.add("active");
          timeSlotsEl.appendChild(btn);
        });
      } catch (e) {
        timeNoticeEl.textContent = "Failed to load availability.";
        timeRangeInfoEl.textContent = "";
      }
    }

    // Walk-ins use the same enterprise calendar and capacity APIs as the
    // customer booking page. The selected technician is passed only to the
    // time-slot request so the chosen start time is valid for that technician.
    async function renderCalendar() {
      if (!calendarGridEl) return;
      if (!state.selectedServices.length) {
        calendarGridEl.innerHTML = '<div class="alert alert-info mb-0">Select at least one service to load availability.</div>';
        timeSelectionEl.classList.add("d-none");
        return;
      }
      const isProject = isLargeScaleSelection();
      if (!isProject && !techEl.value) {
        calendarGridEl.innerHTML = '<div class="alert alert-info mb-0">Select a technician before choosing a schedule.</div>';
        timeSelectionEl.classList.add("d-none");
        return;
      }
      if (!window.EnterpriseCalendar) {
        calendarGridEl.innerHTML = '<div class="alert alert-danger mb-0">The booking calendar could not be loaded. Refresh the page and try again.</div>';
        return;
      }

      const totalUnits = Math.max(1, totalBookedUnits());
      const totalDuration = bookingDuration();
      const perUnitDuration = Math.max(1, totalDuration / totalUnits);
      const travelMinutes = Math.max(0, Number(state.travelTime) || 30);
      const signature = [state.selectedServiceId, totalUnits, totalDuration, travelMinutes, isProject ? "project" : techEl.value].join(":");

      if (state.enterpriseCalendarSignature === signature) {
        window.EnterpriseCalendar.render();
        return;
      }

      state.enterpriseCalendarSignature = signature;
      state.selectedDate = null;
      state.selectedStartMinutes = null;
      state.projectScheduling = null;
      timeSelectionEl.classList.add("d-none");
      timeRangeInfoEl.textContent = "";
      timeNoticeEl.textContent = "";
      calendarGridEl.innerHTML = '<div class="text-center py-5"><span class="spinner-border text-primary" role="status"></span><div class="small text-muted mt-2">Retrieving available dates…</div></div>';

      await window.EnterpriseCalendar.init({
        serviceId: state.selectedServiceId,
        technicianId: isProject ? null : techEl.value,
        duration: perUnitDuration,
        quantity: totalUnits,
        totalEstimatedMinutes: totalDuration,
        travelTime: travelMinutes,
        mode: isProject ? "project" : "appointment",
        showCommercialProjects: false,
        resetSelection: true,
        onSelect(selection) {
          if (!selection || !selection.date) return;
          state.selectedDate = startOfDay(new Date(selection.date));
          if (selection.slot) {
            state.projectScheduling = null;
            state.selectedStartMinutes = Number(selection.slot.startMinutes);
            timeRangeInfoEl.textContent = `Selected ${formatDateKey(state.selectedDate)} at ${selection.slot.label}`;
            timeNoticeEl.textContent = "This slot will be checked again when the walk-in appointment is created.";
          } else {
            state.projectScheduling = selection;
            state.selectedStartMinutes = null;
            const endLabel = selection.endDate ? formatDateKey(new Date(selection.endDate)) : "the selected end date";
            timeRangeInfoEl.textContent = `Project preference: ${formatDateKey(state.selectedDate)} to ${endLabel}`;
            timeNoticeEl.textContent = "Operations will confirm the final multi-day project schedule.";
          }
          updateSummary();
        },
      });
    }

