      // Handle reschedule decision (approve/reject)
      async function handleRescheduleDecision(appointmentId, decision) {
        let reason = '';
        if (decision === 'reject') {
          reason = prompt('Please provide a reason for rejection:');
          if (reason === null) return; // User cancelled
          if (!reason.trim()) {
            alert('Please provide a reason for rejection.');
            return;
          }
        }

        try {
          const response = await fetch(`/api/appointments/${appointmentId}/reschedule-${decision}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reason: reason.trim() })
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.error || `Failed to ${decision} reschedule request`);
          }

          alert(`Reschedule request ${decision}ed successfully!`);
          loadRescheduleRequests(); // Reload the list
        } catch (error) {
          console.error(`Error ${decision}ing reschedule request:`, error);
          alert(`Failed to ${decision} reschedule request: ${error.message}`);
        }
      }

      // reschedule calendar state and helpers
      const reschedCal = {
        activeMonth: new Date(),
        busyDates: new Set(),
        nonWorkingWeekdays: [],
        maintenanceDates: new Set(),
      };
      const reschedConfig = {
        publicHolidays: new Map(),
        nonWorkingWeekdays: [],
      };
      // utility to format YYYY-MM-DD
      function formatYMD(d) {
        const dt = new Date(d);
        const y = dt.getFullYear();
        const m = String(dt.getMonth() + 1).padStart(2, '0');
        const day = String(dt.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
      }
      function formatDateKey(d) {
        return formatYMD(d);
      }
      function renderReschedCalendar() {
        const grid = document.getElementById('reschedCalendarGrid');
        const label = document.getElementById('reschedCalLabel');
        if (!grid || !label) return;
        grid.innerHTML = '';
        const monthStart = new Date(reschedCal.activeMonth);
        monthStart.setDate(1);
        const year = monthStart.getFullYear();
        const month = monthStart.getMonth();
        const leading = new Date(year, month, 1).getDay();
        for (let i = 0; i < leading; i++) {
          const div = document.createElement('div');
          div.className = 'calendar-cell disabled';
          grid.appendChild(div);
        }
        const days = new Date(year, month + 1, 0).getDate();
        for (let d = 1; d <= days; d++) {
          const cur = new Date(year, month, d);
          const key = formatDateKey(cur);
          let status = 'available';
          if (reschedCal.busyDates.has(key)) status = 'booked';
          else if (reschedCal.maintenanceDates.has(key)) status = 'blocked';
          else if (reschedCal.nonWorkingWeekdays.includes(cur.getDay())) status = 'blocked';
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `calendar-cell ${status}`;
          btn.dataset.status = status;
          btn.textContent = String(d).padStart(2,'0');
          // highlight selected date
          const selectedVal = document.getElementById('rescheduleDate')?.value;
          if (selectedVal === formatYMD(cur)) {
            btn.classList.add('is-selected');
          }
          if (status === 'available') {
            btn.addEventListener('click', () => {
              document.getElementById('rescheduleDate').value = formatYMD(cur);
              renderReschedCalendar();
            });
          } else {
            btn.disabled = true;
          }
          // if this date matches the current appointment, show time range
          if (
            reschedCurrentAppt &&
            reschedCurrentAppt.bookingDate &&
            formatYMD(new Date(reschedCurrentAppt.bookingDate)) === formatYMD(cur)
          ) {
            const span = document.createElement('span');
            span.style.position = 'absolute';
            span.style.bottom = '2px';
            span.style.fontSize = '0.6rem';
            span.style.color = '#0d1b2a';
            span.textContent = `${reschedCurrentAppt.startTime || ''}${reschedCurrentAppt.endTime ? '–' + reschedCurrentAppt.endTime : ''}`;
            btn.appendChild(span);
            // show tooltip with booking info
            btn.title = `Ref: ${reschedCurrentAppt.bookingReference || ''} ${span.textContent}`;
          }
          grid.appendChild(btn);
        }
        label.textContent = monthStart.toLocaleString(undefined, { year:'numeric', month:'long'});
      }
      function addMonths(date, n) {
        const d = new Date(date);
        d.setMonth(d.getMonth() + n);
        return d;
      }
      async function loadReschedCalendar(techId) {
        if (!techId) return;
        const start = formatYMD(new Date(reschedCal.activeMonth.getFullYear(), reschedCal.activeMonth.getMonth(), 1));
        const endDate = addMonths(reschedCal.activeMonth,1);
        const end = formatYMD(new Date(endDate.getFullYear(), endDate.getMonth(), 0));
        try {
          const r = await fetch(`/api/secretary/technicians/${encodeURIComponent(techId)}/calendar?start=${start}&end=${end}`);
          if (r.ok) {
            const data = await r.json();
            const dates = new Set();
            (data.events||[]).forEach(e=>{
              if (e.start) {
                dates.add(formatDateKey(new Date(e.start)));
              }
            });
            reschedCal.busyDates = dates;
          } else {
            reschedCal.busyDates = new Set();
          }
        } catch (e) {
          reschedCal.busyDates = new Set();
        }
        // additionally fetch technician schedule for off days
        try {
          const r2 = await fetch(`/api/services/technician-schedule/${encodeURIComponent(techId)}`);
          if (r2.ok) {
            const j = await r2.json();
            reschedCal.nonWorkingWeekdays = Array.isArray(j.nonWorkingWeekdays) ? j.nonWorkingWeekdays : [];
            reschedCal.maintenanceDates = new Set(Array.isArray(j.restDates)? j.restDates : []);
          } else {
            reschedCal.nonWorkingWeekdays = [];
            reschedCal.maintenanceDates = new Set();
          }
        } catch (e) {
          reschedCal.nonWorkingWeekdays = [];
          reschedCal.maintenanceDates = new Set();
        }
        renderReschedCalendar();
      }
      // initial calendar render (after possible preselect)
      renderReschedCalendar();
      // calendar nav
      document.getElementById('reschedCalPrev').addEventListener('click', () => {
        reschedCal.activeMonth = addMonths(reschedCal.activeMonth, -1);
        renderReschedCalendar();
        // reload busy dates for current tech if selected
        const sel = document.getElementById('rescheduleSelect');
        if (sel && sel.value) {
          const appt = reschedAppointmentsMap.get(sel.value);
          if (appt && appt.technicianId) loadReschedCalendar(appt.technicianId);
        }
      });
      document.getElementById('reschedCalNext').addEventListener('click', () => {
        reschedCal.activeMonth = addMonths(reschedCal.activeMonth, 1);
        renderReschedCalendar();
        const sel = document.getElementById('rescheduleSelect');
        if (sel && sel.value) {
          const appt = reschedAppointmentsMap.get(sel.value);
          if (appt && appt.technicianId) loadReschedCalendar(appt.technicianId);
        }
      });

      // when appointment select changes, update date/time fields and load calendar
      document.getElementById('rescheduleSelect').addEventListener('change', function() {
        const val = this.value;
        const appt = reschedAppointmentsMap.get(val);
        reschedCurrentAppt = appt || null;
        if (appt) {
          if (appt.bookingDate) {
            document.getElementById('rescheduleDate').value = new Date(appt.bookingDate).toISOString().slice(0,10);
          }
          if (appt.startTime) document.getElementById('rescheduleTime').value = appt.startTime;
          if (appt.technicianId) {
            loadReschedCalendar(appt.technicianId);
          }
        }
        renderReschedCalendar();
      });

      // Reschedule submission
      document
        .getElementById("rescheduleSubmit")
        .addEventListener("click", async function (e) {
          e.preventDefault();
          const select = document.getElementById("rescheduleSelect");
          const val = select.value;
          if (!val) {
            window.notify.warn("Select an appointment first");
            return;
          }
          // date/time are populated by calendar interactions
          const date = document.getElementById("rescheduleDate").value;
          const time = document.getElementById("rescheduleTime").value;
          if (!date || !time) {
            alert("Please choose a valid date/time using the calendar above.");
            return;
          }
          const payload = {
            bookingDate: date,
            startTime: time,
            reason: document.getElementById("rescheduleReason").value || "",
          };
          // attempt to extract id
          const id = val.startsWith("{")
            ? JSON.parse(val)._id || JSON.parse(val).id
            : val;
          try {
            const r = await fetch("/appointments/" + encodeURIComponent(id), {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
              credentials: "same-origin",
            });
            if (r.ok) {
              window.notify.success("Appointment rescheduled");
              loadCombinedOverview();
            } else {
              const t = await r.text();
              window.notify.error("Failed: " + t);
            }
          } catch (err) {
            window.notify.error("Failed");
          }
        });

      // wire controls
      // filter/apply button for combined appointments
      const filterBtn = document.getElementById("btn-filter-combined");
      if (filterBtn) {
        filterBtn.addEventListener("click", () => {
          loadCombinedOverview();
        });
      }
      const refreshBtn = document.getElementById("btn-refresh-combined");
      if (refreshBtn) {
        refreshBtn.addEventListener("click", () => {
          loadCombinedOverview();
          loadBookingRequests();
        });
      }
      const refreshAllBtn = document.getElementById("apptsRefreshAll");
      if (refreshAllBtn) {
        refreshAllBtn.addEventListener("click", () => {
          loadCombinedOverview();
          loadBookingRequests();
        });
      }
      ["requestSearchCombined"].forEach((id) => {
        const node = document.getElementById(id);
        if (!node) return;
        node.addEventListener("input", renderBookingRequests);
      });      document
        .getElementById("requestRefreshCombined")
        ?.addEventListener("click", loadBookingRequests);

      // set title to match default status
      const pageTitle = document.querySelector(".dashboard-hero .page-title");
      if (pageTitle)
        pageTitle.innerHTML =
          '<i class="bi bi-calendar3-fill me-2"></i>Scheduled Appointments';
      // initial load of appointments list
      loadCombinedOverview(currentListStatus);

      // helper: create a compact sparkline chart (same as used in reports)
      function createSparkline(id, data, color){
        var c = document.getElementById(id);
        if (!c || typeof Chart === 'undefined') return null;
        return new Chart(c, {
          type: 'line',
          data: { labels: data.map((_,i)=>i+1), datasets: [{ data: data, borderColor: color, backgroundColor: color.replace('rgb','rgba').replace(')',',0.12)'), fill: true, tension: 0.35 }] },
          options: {
            responsive: true, maintainAspectRatio: false, animation:{duration:800},
            plugins:{legend:{display:false}, tooltip:{enabled:false}},
            elements:{point:{radius:0}},
            scales:{x:{display:false}, y:{display:false}}
          }
        });
      }

      // draw initial dummy sparklines for header KPIs
      createSparkline('kpiSparkScheduled', [4,6,5,7,6,8,7], '#2872A1');
      createSparkline('kpiSparkEnRoute',    [3,5,4,6,5,7,6], '#3b82f6');
      createSparkline('kpiSparkPending',    [2,3,4,3,5,4,3], '#f59e0b');
      createSparkline('kpiSparkCompleted',  [1,3,2,4,3,5,4], '#10b981');
      createSparkline('kpiSparkCancelled',  [1,1,2,1,1,0,1], '#dc3545');

      // also wire change events so filters auto-refresh
      [
        "filterSearchCombined",
        "filterStartCombined",
        "filterEndCombined",
        "filterTechCombined",
      ].forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.addEventListener(el.tagName === "INPUT" ? "input" : "change", () =>
          loadCombinedOverview(),
        );
      });

      // if URL contains ?sel=<id> open Reschedule tab and preselect the appointment
      (function preselectFromQuery() {
        try {
          const params = new URLSearchParams(location.search);
          const sel = params.get("sel") || params.get("id");
          if (!sel) return;
          let tries = 0;
          const trySelect = () => {
            tries++;
            if (
              typeof combinedAppointments !== "undefined" &&
              combinedAppointments.length
            ) {
              // reuse existing onEditAppt logic by simulating a click-event object
              try {
                onEditAppt({ currentTarget: { getAttribute: () => sel } });
              } catch (e) {
                /* ignore */
              }
              const tabBtn = document.querySelector(
                '#apptsTabs [data-tab="tab-reschedule"]',
              );
              if (tabBtn) tabBtn.click();
            } else if (tries < 20) {
              setTimeout(trySelect, 150);
            }
          };
          setTimeout(trySelect, 200);
        } catch (e) {
          /* ignore */
        }
      })();
    })();
  </script>
</div>
