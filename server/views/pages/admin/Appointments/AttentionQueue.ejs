        html:`<div class="text-start">${customerContact ? `<div class="rounded-3 border bg-light p-3 mb-3"><div class="small fw-bold text-uppercase text-muted mb-2">Customer contact</div><div class="d-flex flex-wrap gap-2">${customerContact}</div></div>` : ''}
          <div class="small fw-semibold mb-2">${isProject ? 'Large-scale installation' : 'Standard delivery'} &middot; ${workload.totalUnits} unit${workload.totalUnits === 1 ? '' : 's'} &middot; ${Math.round(workload.totalEstimatedMinutes / 6) / 10} estimated work hours</div>
          <p class="small text-muted mb-3">${isProject ? 'Choose a start date and finish-by date, just like customer services. Operations will confirm the final multi-day installation schedule.' : 'Choose an available delivery date and start time. Capacity and advance-notice rules match customer booking.'}</p>
          <div id="rcOrderCalendar"><div id="calendarGrid"></div><div id="timeSelection" class="mt-3 d-none"><div id="timeSlots"></div></div><div id="projectPrefs" class="mt-3 d-none"></div></div>
          <label for="rcOrderReason" class="form-label small fw-bold mt-3">Resolution note (optional)</label><textarea id="rcOrderReason" class="form-control" rows="2" maxlength="500" placeholder="Customer contacted; replacement schedule confirmed"></textarea></div>`,
        showCancelButton:true,
        confirmButtonText:isProject ? 'Save project window' : 'Save schedule',
        confirmButtonColor:'#2563eb', focusConfirm:false, showLoaderOnConfirm:true,
        allowOutsideClick:() => !Swal.isLoading(),
        didOpen:() => {
          EnterpriseCalendar.init({
            root:Swal.getHtmlContainer(), syncGlobalState:false, resetSelection:true,
            duration:isProject ? Math.ceil(workload.totalEstimatedMinutes / workload.totalUnits) : workload.totalEstimatedMinutes,
            quantity:isProject ? workload.totalUnits : 1,
            totalEstimatedMinutes:workload.totalEstimatedMinutes,
            travelTime:Math.max(1, Number(item.routeDurationMin) || 30),
            mode:isProject ? 'project' : 'appointment', autoDetectProject:false,
            availabilityUrl,
            projectAvailabilityUrl:`/api/orders/${encodeURIComponent(item.id)}/admin-project-window-availability`,
            showStartDatePrompt:false,
            projectPreferences:context.projectScheduling ? {
              workingDays:context.projectScheduling.preferredWorkingDays,
              preferredWorkingHours:context.projectScheduling.preferredWorkingHours?.start,
            } : null,
            onSelect:() => {},
          }).catch(error => {
            console.error('Order calendar failed to load:', error);
            Swal.showValidationMessage('Could not load availability. Close this window and try again.');
          });
        },
        preConfirm:async () => {
          const date = EnterpriseCalendar.getSelectedDate();
          const slot = EnterpriseCalendar.getSelectedSlot();
          if (!date || (isProject ? !(EnterpriseCalendar.getSelectedEndDate() && EnterpriseCalendar.getWindowVerdict()?.sufficient === true) : !slot?.startTime)) {
            Swal.showValidationMessage(isProject ? 'Choose a start date and finish-by date with enough capacity.' : 'Choose an available date and start time.');
            return false;
          }
          const payload = {
            scheduledDate:EnterpriseCalendar.formatDateKey(date),
            reason:Swal.getHtmlContainer().querySelector('#rcOrderReason').value.trim(),
          };
          if (isProject) {
            const selection = EnterpriseCalendar.getProjectSelection();
            payload.endDate = EnterpriseCalendar.formatDateKey(selection.endDate);
            payload.projectScheduling = { preferredStartDate:payload.scheduledDate, preferredCompletionDeadline:payload.endDate,
              preferredWorkingDays:selection.preferences.workingDays,
              preferredWorkingHours:{ start:selection.preferences.preferredWorkingHours, end:'' } };
          } else payload.timeSlot = slot.startTime;
          try {
            const response = await fetch(`/api/orders/${encodeURIComponent(item.id)}/admin-reschedule`, {
              method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload),
            });
            const data = await response.json();
            if (!response.ok) {
              Swal.showValidationMessage(data.error || 'Could not save the schedule. Choose another available schedule.');
              if (data.refreshSlots) await EnterpriseCalendar.refresh({ invalidateSelection:true });
              return false;
            }
            return data;
          } catch (error) { Swal.showValidationMessage(error.message || 'Could not save the schedule. Try again.'); return false; }
        },
      });
      if (result.isConfirmed) {
        showToast('success', result.value?.message || 'Order schedule updated.');
        await loadQueue();
      }
    } catch (error) { showToast('error', escapeHtml(error.message || 'Could not open the schedule form.')); }
