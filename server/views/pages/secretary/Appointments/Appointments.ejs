                techCoords = { lat: Number(appt.technician.lat), lng: Number(appt.technician.lng) };
                techLocationInfo = appt.technician.address || null;
                console.log('Technician coords from technician.lat/lng:', techCoords);
              } else if (appt.technician.coordinates) {
                techCoords = parseCoords(appt.technician.coordinates);
