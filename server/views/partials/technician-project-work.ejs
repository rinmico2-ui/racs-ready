  async function initProjectTracker(el, pid) {
    if (!window.L) return;
    if (el._pwInited) { try { el._pwMap.invalidateSize(); } catch(_){} return; }
    const a = (window.__pwData || []).find(x => x.project._id.toString() === pid.toString());
    const p = a?.project || {};
    const c = a?.customer || {};
    const cust = p.customer || c || {};
    const site = p.location || c || {};

    let customerLat = typeof cust.lat === 'number' ? cust.lat : null;
    let customerLng = typeof cust.lng === 'number' ? cust.lng : null;
    let siteLat = typeof site.lat === 'number' ? site.lat : null;
    let siteLng = typeof site.lng === 'number' ? site.lng : null;

    if ((customerLat == null || customerLng == null) && (siteLat == null || siteLng == null)) {
      const address = site.address || cust.address || c.address;
      if (address) {
        const geocodeAddress = async (addr) => {
          const parts = addr.split(',').map(part => part.trim()).filter(Boolean);
          for (let i = 0; i < parts.length; i++) {
            const query = parts.slice(i).join(', ');
            if (query.length < 5) continue;
            try {
              const geoUrl = 'https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(query) + '&limit=1';
              const geoRes = await fetch(geoUrl);
              if (geoRes.ok) {
                const geoData = await geoRes.json();
                if (geoData && geoData.length > 0) {
                  return { lat: parseFloat(geoData[0].lat), lng: parseFloat(geoData[0].lon) };
                }
              }
            } catch (e) { console.warn('Geocoding attempt failed for query: ' + query, e); }
          }
          return null;
        };
        const result = await geocodeAddress(address);
        if (result) { siteLat = result.lat; siteLng = result.lng; }
      }
    }

    const firstLat = customerLat ?? siteLat;
    const firstLng = customerLng ?? siteLng;
    if (firstLat == null || firstLng == null) return;

    el.innerHTML = '';
    const map = L.map(el, { zoomControl: true, attributionControl: false }).setView([firstLat, firstLng], 14);
    el._pwMap = map; el._pwInited = true;
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', { maxZoom: 19 }).addTo(map);

    const addMarker = (lat, lng, color, icon, title, body) => {
      const m = L.divIcon({ className: '', html: `<div style="background:${color};color:#fff;border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(0,0,0,.3);">${icon}</div>`, iconSize: [30,30], iconAnchor: [15,15] });
      L.marker([lat, lng], { icon: m }).addTo(map).bindPopup('<b>' + esc(title) + '</b><br>' + body);
    };

    if (customerLat != null && customerLng != null) {
      const body = [esc(cust.name || c.name || 'Customer'), esc(cust.address || c.address || '')].filter(Boolean).join('<br>');
      addMarker(customerLat, customerLng, '#7c3aed', '<i class="bi bi-house-fill"></i>', 'Customer', body);
    }

    if (siteLat != null && siteLng != null && (siteLat !== customerLat || siteLng !== customerLng)) {
      const body = [esc(site.address || c.address || ''), esc(site.name || '')].filter(Boolean).join('<br>');
      addMarker(siteLat, siteLng, '#f97316', '<i class="bi bi-geo-alt-fill"></i>', 'Site', body);
    }

    const destLat = siteLat ?? customerLat;
    const destLng = siteLng ?? customerLng;
    const techIcon = L.divIcon({ className:'', html:'<div style="background:#2563eb;color:#fff;border-radius:50%;width:26px;height:26px;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 4px rgba(37,99,235,.3);"><i class="bi bi-geo-alt-fill"></i></div>', iconSize:[26,26], iconAnchor:[13,13] });

    function drawTech(pos) {
      if (!pos) return;
      if (el._pwTech) { el._pwTech.setLatLng([pos.lat, pos.lng]); } else {
        el._pwTech = L.marker([pos.lat, pos.lng], { icon: techIcon }).addTo(map).bindPopup('Your live location');
      }
      if (typeof pos.acc === 'number' && pos.acc > 0 && pos.acc < 5000) {
        if (!el._pwAccCircle) {
          el._pwAccCircle = L.circle([pos.lat, pos.lng], { color:'#4361ee', fillColor:'#4361ee', fillOpacity:.08, weight:1.5, radius:pos.acc }).addTo(map);
        } else { el._pwAccCircle.setLatLng([pos.lat, pos.lng]).setRadius(pos.acc); }
      }
      const url = `https://router.project-osrm.org/route/v1/driving/${pos.lng},${pos.lat};${destLng},${destLat}?overview=full&geometries=geojson`;
      fetch(url).then(r => r.json()).then(route => {
        if (route && route.routes && route.routes[0]) {
          const geom = route.routes[0].geometry;
          if (el._pwRoute) map.removeLayer(el._pwRoute);
          el._pwRoute = L.geoJSON(geom, { style:{ color:'#2563eb', weight:3, dashArray:'6,8' } }).addTo(map);
          map.fitBounds(el._pwRoute.getBounds(), { padding:[40,40] });
        }
      }).catch(() => {});
    }

    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(p => drawTech({ lat:p.coords.latitude, lng:p.coords.longitude, acc:p.coords.accuracy }), () => {}, { enableHighAccuracy:true, timeout:8000 });
      if (navigator.geolocation.watchPosition) navigator.geolocation.watchPosition(p => drawTech({ lat:p.coords.latitude, lng:p.coords.longitude, acc:p.coords.accuracy }), () => {}, { enableHighAccuracy:true, timeout:8000 });
    }
    setTimeout(() => map.invalidateSize(), 200);
  }

  // ════════════════════ ACTIONS ════════════════════
  const pwLeadAcceptPending = new Set();
  window.pwLeadAccept = async (pid, btn) => {
    if (pwLeadAcceptPending.has(pid)) return;
