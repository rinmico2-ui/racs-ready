    .recovery-field .form-control:focus,.recovery-field .form-select:focus { border-color:#60a5fa; box-shadow:0 0 0 3px rgba(59,130,246,.12); }
    .recovery-time-grid { display:grid; grid-template-columns:1fr 1fr; gap:.55rem; }
    .recovery-days { display:flex; flex-wrap:wrap; gap:.42rem; }
