    var sbChartCfg = { type: "pie", data: { labels: sbLabels, datasets: [{ data: sbCounts, backgroundColor: sbColors, borderWidth: 3, borderColor: "#fff", hoverOffset: 6 }] }, options: { responsive: true, maintainAspectRatio: false, animation: { duration: 1200 }, plugins: { legend: { position: 'right', labels: { boxWidth: 10, font: { size: 10 }, padding: 8 } }, tooltip: { backgroundColor: '#0f172a', padding: 10, cornerRadius: 8 } } } };
    var sbDetails = bookingDetails('status');
    var sbFilters = sbLabels.map(function(l, i) { return { key: l, label: l, color: sbColors[i] }; });
