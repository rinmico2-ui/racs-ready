<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function() {
  'use strict';

  let allBookings = [];
  let selectedTechId = null;
  let selectedAdminDate = null;
  let currentAssignBooking = null;

  // ── Load Queue ────────────────────────────────────────────────────────
  window.loadQueue = async function() {
    const container = document.getElementById('queueContainer');
    container.innerHTML = '<div class="rsq-loading"><div class="spinner-border" role="status"></div><p class="mt-2 text-muted small">Loading...</p></div>';

    try {
      const [queueRes, statsRes] = await Promise.all([
        fetch('/api/admin/repair-scheduling-queue', { credentials: 'same-origin' }),
        fetch('/api/admin/repair-scheduling-queue/stats', { credentials: 'same-origin' })
      ]);

      if (!queueRes.ok) throw new Error('Failed to load queue');
      const queueData = await queueRes.json();
      const statsData = statsRes.ok ? await statsRes.json() : {};

      allBookings = queueData.bookings || [];

      // Update stats
      document.getElementById('statPending').textContent = statsData.pendingScheduling || 0;
      document.getElementById('statScheduled').textContent = statsData.scheduled || 0;
      document.getElementById('statTotal').textContent = statsData.total || 0;

      document.getElementById('statParts').textContent = statsData.waitingParts || 0;

      renderQueue();
    } catch (err) {
      console.error(err);
      container.innerHTML = '<div class="rsq-empty"><i class="bi bi-exclamation-triangle"></i><p>Failed to load parts and scheduling queue</p><p class="sub text-danger">' + err.message + '</p></div>';
    }
  };

  // ── Render Queue ──────────────────────────────────────────────────────
  function renderQueue() {
    const container = document.getElementById('queueContainer');
    const search = document.getElementById('searchInput').value.toLowerCase();
    const statusFilter = document.getElementById('filterStatus').value;
    const timeFilter = document.getElementById('filterTimeWindow').value;

    let filtered = allBookings.filter(b => {
      if (statusFilter && b.status !== statusFilter) return false;
      if (timeFilter && b.preferredTimeWindow !== timeFilter) return false;
      if (search) {
        const haystack = [
          b.workOrderNumber, b.customer?.name, b.originalInspector?.name,
          b.customer?.email, b.customer?.phone
        ].filter(Boolean).join(' ').toLowerCase();
        if (!haystack.includes(search)) return false;
      }
      return true;
    });

    if (filtered.length === 0) {
      container.innerHTML = '<div class="rsq-empty"><i class="bi bi-calendar2-check"></i><p>No scheduling requests found</p><p class="sub">Customers who choose "Schedule Repair Later" will appear here.</p></div>';
      return;
    }

    container.innerHTML = filtered.map(b => renderCard(b)).join('');
  }

  // ── Render Card ───────────────────────────────────────────────────────
  function renderCard(b) {
    const dates = (b.preferredDates || []).map(d => {
      const dt = new Date(d);
      const label = dt.toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric' });
      return `<span class="rsq-date-chip"><i class="bi bi-calendar3"></i> ${label}</span>`;
    }).join('');

    const timeLabel = { morning: 'Morning', afternoon: 'Afternoon', any: 'Any Time' }[b.preferredTimeWindow] || 'Any Time';

    const statusClass = b.status === 'repair_scheduled' ? 'rsq-status-scheduled' : (b.status === 'waiting_parts' ? 'rsq-priority-critical' : (b.status === 'ready_for_repair' ? 'rsq-status-scheduled' : 'rsq-status-pending'));
    const statusLabel = b.status === 'repair_scheduled' ? 'Scheduled' : (b.status === 'waiting_parts' ? 'Waiting Parts' : (b.status === 'ready_for_repair' ? 'Ready to Schedule' : 'Pending Scheduling'));

    const priorityClass = `rsq-priority-${b.priority || 'medium'}`;

    const unitInfo = b.unitInfo ? `${b.unitInfo.unitType || ''} ${b.unitInfo.brand ? '- ' + b.unitInfo.brand : ''}`.trim() : '';

    const submittedLabel = b.submittedAt ? new Date(b.submittedAt).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-';

    const canAssign = b.status === 'repair_approved' || b.status === 'ready_for_repair' || (b.status === 'waiting_parts' && b.stockAvailable !== false);
    const isScheduled = b.status === 'repair_scheduled';
    const isWaitingParts = b.status === 'waiting_parts';
    const partsReady = b.stockAvailable !== false;
    const partsStatusLabels = {
      reserved: { label: 'Parts Ready', class: 'rsq-status-scheduled', icon: 'bi-check-circle-fill' },
      waiting_parts: { label: 'Waiting Parts', class: 'rsq-priority-critical', icon: 'bi-exclamation-triangle-fill' },
      pending_check: { label: 'Parts Pending', class: 'rsq-priority-medium', icon: 'bi-hourglass-split' },
      none: { label: 'No Parts', class: 'rsq-status-scheduled', icon: 'bi-dash-circle' },
    };

    return `
      <div class="rsq-card" data-id="${b._id}">
        <div class="rsq-card-header">
          <div>
            <div class="rsq-card-id">${b.workOrderNumber}</div>
            <div class="rsq-card-customer">${b.customer?.name || 'Unknown Customer'}</div>
            ${unitInfo ? `<div class="rsq-card-unit">${unitInfo}</div>` : ''}
          </div>
          <div class="d-flex align-items-center gap-2">
            ${b.partsStatus ? `
            <span class="rsq-status-badge ${partsStatusLabels[b.partsStatus]?.class || 'rsq-status-pending'}" style="font-size:0.65rem;">
              <i class="bi ${partsStatusLabels[b.partsStatus]?.icon || 'bi-box'} me-1"></i>${partsStatusLabels[b.partsStatus]?.label || b.partsStatus}
            </span>
            ` : ''}
            <span class="rsq-priority-badge ${priorityClass}"><i class="bi bi-flag"></i> ${b.priority || 'medium'}</span>
            <span class="rsq-status-badge ${statusClass}">${statusLabel}</span>
          </div>
        </div>

        <div class="rsq-info-grid">
          <div class="rsq-info-item">
            <i class="bi bi-person-badge"></i>
            <span><strong>Inspector:</strong> ${b.originalInspector?.name || 'Unassigned'}</span>
          </div>
          <div class="rsq-info-item">
            <i class="bi bi-calendar-check"></i>
            <span><strong>Inspection:</strong> ${b.inspectionDate ? new Date(b.inspectionDate).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' }) : '-'}</span>
          </div>
          <div class="rsq-info-item">
            <i class="bi bi-clock-history"></i>
            <span><strong>Submitted:</strong> ${submittedLabel}</span>
          </div>
          <div class="rsq-info-item">
            <i class="bi bi-cash-stack"></i>
            <span><strong>Quotation:</strong> ${b.quotation?.totalCost ? '₱' + Number(b.quotation.totalCost).toLocaleString() : '-'}</span>
          </div>
        </div>

        <!-- Parts summary -->
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="text-muted small fw-semibold"><i class="bi bi-box-seam"></i> Parts:</span>
          ${renderPartsSummary(b)}
        </div>

        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="text-muted small fw-semibold">Preferred Dates:</span>
          ${dates || '<span class="text-muted small">None</span>'}
          <span class="rsq-time-badge"><i class="bi bi-clock"></i> ${timeLabel}</span>
        </div>

        <div class="rsq-action-bar">
          ${!partsReady && canAssign ? `
            <span class="text-danger small me-2" style="font-size:0.7rem;display:flex;align-items:center;">
              <i class="bi bi-exclamation-triangle-fill me-1"></i>Cannot schedule until parts are received
            </span>
          ` : ''}
          <button class="btn btn-sm btn-outline-secondary" onclick="showDetail('${b._id}')">
            <i class="bi bi-eye me-1"></i>Details
          </button>
          ${canAssign ? `
            <button class="btn btn-sm ${partsReady ? 'btn-primary' : 'btn-outline-danger'}" onclick="${partsReady ? `openAssignModal('${b._id}')` : 'showPartsRequest(\'' + b._id + '\')' }">
              <i class="bi ${partsReady ? 'bi-calendar-plus' : 'bi-box-seam'} me-1"></i>${partsReady ? 'Schedule Date' : 'Manage Parts'}
            </button>
          ` : isWaitingParts ? `
            <button class="btn btn-sm btn-outline-warning" onclick="showPartsRequest('${b._id}')">
              <i class="bi bi-box-seam me-1"></i>Manage Parts
            </button>
          ` : isScheduled ? `
            <button class="btn btn-sm btn-success" disabled>
              <i class="bi bi-check-circle me-1"></i>Scheduled
            </button>
          ` : `
            <button class="btn btn-sm btn-outline-secondary" disabled>
              <i class="bi bi-clock me-1"></i>${statusLabel}
            </button>
          `}
        </div>
      </div>
    `;
  }

  // ── Render Parts Summary ─────────────────────────────────────────────
  function renderPartsSummary(b) {
    const allParts = b.quotation?.parts || [];
    if (allParts.length === 0) return '<span class="text-muted small">No parts required</span>';

    const chips = allParts.map(p => {
      const qty = p.quantity || 1;
      const cost = p.cost || 0;
      const stock = p.currentStock || 0;
      const needsProc = p.needsProcurement !== false && stock < qty;
      if (needsProc) {
        return `<span class="rsq-date-chip" style="background:#fef2f2;color:#991b1b;border-color:#fecaca;font-size:0.72rem;">
          <i class="bi bi-exclamation-triangle"></i> ${p.name || 'Part'} x${qty} <span style="opacity:0.7;">(₱${Number(cost * qty).toLocaleString()})</span>
        </span>`;
      } else {
        return `<span class="rsq-date-chip" style="background:#f0fdf4;color:#166534;border-color:#bbf7d0;font-size:0.72rem;">
          <i class="bi bi-check-circle"></i> ${p.name || 'Part'} x${qty} <span style="opacity:0.7;">(₱${Number(cost * qty).toLocaleString()})</span>
        </span>`;
      }
    }).join('');

    return `<div class="d-flex flex-wrap gap-1">${chips}</div>`;
  }

  function isRepairSchedulingReady(booking) {
    if (!booking || booking.requestPhase === 'phase_1_ai_preparation') return false;
    const parts = booking.quotation?.parts || [];
    const hasUnprocuredPart = parts.some(part => part.needsProcurement !== false);
    if (hasUnprocuredPart) return false;
    if (parts.length === 0) return true;
    return booking.partsStatus === 'reserved'
      || booking.stockAvailable === true
      || booking.status === 'ready_for_repair'
      || booking.status === 'repair_scheduled'
      || booking.status === 'repair_approved';
  }

  // ── Open Assign Modal ─────────────────────────────────────────────────
  window.openAssignModal = async function(bookingId) {
    const booking = allBookings.find(b => b._id === bookingId);
    if (!booking) return;
    if (!isRepairSchedulingReady(booking)) {
      showToast('warning', 'Schedule & Assign is unavailable until every missing repair part has been procured and reserved.');
      showPartsRequest(bookingId);
      return;
    }

    currentAssignBooking = booking;
    selectedTechId = null;
    selectedAdminDate = null;
    selectedAdminTime = null;
    document.getElementById('assignBookingId').value = bookingId;
    document.getElementById('assignWorkOrder').textContent = booking.workOrderNumber;
    document.getElementById('assignCustomerName').textContent = booking.customer?.name || '-';
    document.getElementById('assignCustomerContact').textContent = [booking.customer?.email, booking.customer?.phone].filter(Boolean).join(' | ') || '-';
    document.getElementById('assignQuotationTotal').textContent = booking.quotation?.totalCost ? '₱' + Number(booking.quotation.totalCost).toLocaleString() : '-';

    // Populate parts list
    const partsCard = document.getElementById('assignPartsCard');
    const partsList = document.getElementById('assignPartsList');
    const parts = booking.quotation?.parts || [];
    if (parts.length > 0) {
      partsCard.style.display = '';
      partsList.innerHTML = parts.map(p => {
        const qty = p.quantity || 1;
        const cost = p.cost || 0;
        return `<span style="display:inline-block;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:6px;padding:3px 8px;margin:2px;font-size:0.78rem;white-space:nowrap;">
          <i class="bi bi-gear" style="font-size:0.65rem;"></i> ${p.name || 'Part'} ×${qty} <span style="opacity:0.6;">₱${Number(cost * qty).toLocaleString()}</span>
        </span>`;
      }).join(' ');
    } else {
      partsCard.style.display = 'none';
    }

    // Populate duration and complexity
    const duration = booking.technicianAssistant?.estimatedDurationMinutes || 90;
    const durationLabel = duration >= 60 ? Math.floor(duration/60) + 'h' + (duration%60 > 0 ? ' ' + duration%60 + 'm' : '') : duration + 'min';
    document.getElementById('assignDuration').textContent = durationLabel;
    const complexity = booking.diagnosis?.laborCategory || booking.repairComplexity || 'standard';
    const complexityLabels = { minor: 'Minor Repair', simple: 'Minor Repair', standard: 'Standard Repair', moderate: 'Standard Repair', complex: 'Complex Repair', major: 'Major Overhaul' };
    document.getElementById('assignComplexity').textContent = complexityLabels[complexity] || complexity;

    document.getElementById('assignOriginalInspector').textContent = booking.originalInspector?.name || 'Unassigned';

    // Reset date and time grids
    document.getElementById('adminDateGrid').innerHTML = '<div class="text-muted small" id="adminDatePlaceholder"><i class="bi bi-hourglass-split me-1"></i>Select a technician to see available dates</div>';
    document.getElementById('adminDateCapacity').textContent = '-';
    document.getElementById('adminTimeGrid').innerHTML = '';

    // Render preferred dates with time window info
    const datesHtml = (booking.preferredDates || []).map(d => {
      const dt = new Date(d);
      const label = dt.toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric' });
      return `<span class="rsq-date-chip"><i class="bi bi-calendar3"></i> ${label}</span>`;
    }).join('');

    const timeWindowLabels = { morning: 'Morning (8AM–12PM)', afternoon: 'Afternoon (12PM–5PM)', any: 'Any Time' };
    const twLabel = timeWindowLabels[booking.preferredTimeWindow] || 'Any Time';
    document.getElementById('assignPreferredDates').innerHTML = `
      ${datesHtml || '<span class="text-muted small">No dates</span>'}
      <span class="rsq-time-badge" style="background:#f0fdf4;color:#166534;border:1px solid #bbf7d0;">
        <i class="bi bi-clock"></i> ${twLabel}
      </span>
    `;

    // Load availability
    const techListEl = document.getElementById('assignTechList');
    techListEl.innerHTML = '<div class="text-muted small"><i class="bi bi-hourglass-split me-1"></i>Checking technician availability...</div>';

    const modal = new bootstrap.Modal(document.getElementById('assignModal'));
    modal.show();

    try {
      const res = await fetch(`/api/admin/repair-scheduling-queue/${bookingId}/availability`, { credentials: 'same-origin' });
      if (!res.ok) throw new Error('Failed to check availability');
      const data = await res.json();

      renderTechList(data);
      updatePreview();
      // If a tech was auto-selected, load their available dates
      if (selectedTechId) {
        const duration = currentAssignBooking?.technicianAssistant?.estimatedDurationMinutes || 90;
        const travelTime = currentAssignBooking?.travelDurationMinutes ?? currentAssignBooking?.travelTime ?? 30;
        fetchTechAvailableDates(selectedTechId, duration, travelTime);
      }
    } catch (err) {
      techListEl.innerHTML = '<div class="text-danger small"><i class="bi bi-exclamation-triangle me-1"></i>' + err.message + '</div>';
    }
  };

  // ── Render Technician List ────────────────────────────────────────────
  function renderTechList(data) {
    const techListEl = document.getElementById('assignTechList');
    let html = '';

    // Original inspector (recommended)
    if (data.originalInspector && data.originalAvailable) {
      const metaText = data.hasNoDates ? 'Select a date after choosing' : 'Available on preferred dates';
      html += `
        <div class="rsq-tech-card recommended selected" data-tech="${data.originalInspector._id}" onclick="selectTech(this, '${data.originalInspector._id}')">
          <div class="rsq-tech-avatar">${(data.originalInspector.name || '?')[0].toUpperCase()}</div>
          <div class="rsq-tech-info">
            <div class="rsq-tech-name">${data.originalInspector.name}</div>
            <div class="rsq-tech-meta">${metaText}</div>
          </div>
          <span class="rsq-tech-reason"><i class="bi bi-star-fill"></i> Original Inspector</span>
        </div>
      `;
      selectedTechId = data.originalInspector._id;
    } else if (data.originalInspector) {
      html += `
        <div class="rsq-tech-card" style="opacity:0.5;cursor:not-allowed;">
          <div class="rsq-tech-avatar">${(data.originalInspector.name || '?')[0].toUpperCase()}</div>
          <div class="rsq-tech-info">
            <div class="rsq-tech-name">${data.originalInspector.name}</div>
            <div class="rsq-tech-meta text-danger">Not available on preferred dates</div>
          </div>
          <span class="rsq-priority-badge rsq-priority-critical" style="font-size:0.65rem;">Unavailable</span>
        </div>
      `;
    }

    // Other available technicians
    if (data.availableTechnicians && data.availableTechnicians.length > 0) {
      html += '<div class="mt-2 mb-1"><small class="text-muted fw-semibold"><i class="bi bi-people me-1"></i>Other Available Technicians</small></div>';
      data.availableTechnicians.forEach(tech => {
        const availableDateCount = tech.availableDates ? tech.availableDates.length : 0;
        const metaText = data.hasNoDates
          ? (tech.rating ? '★ ' + tech.rating.toFixed(1) : 'Available')
          : `Available ${availableDateCount} of preferred date(s)${tech.rating ? ' | ★ ' + tech.rating.toFixed(1) : ''}`;
        html += `
          <div class="rsq-tech-card" data-tech="${tech._id}" onclick="selectTech(this, '${tech._id}')">
            <div class="rsq-tech-avatar">${(tech.name || '?')[0].toUpperCase()}</div>
            <div class="rsq-tech-info">
              <div class="rsq-tech-name">${tech.name}</div>
              <div class="rsq-tech-meta">${metaText}</div>
            </div>
          </div>
        `;
      });
    }

    if (!html) {
      html = '<div class="text-warning small"><i class="bi bi-exclamation-triangle me-1"></i>No technicians available for the preferred dates.</div>';
    }

    techListEl.innerHTML = html;
    updateAssignButton();
  }

  // ── Select Technician ─────────────────────────────────────────────────

  window.selectTech = function(el, techId) {
    if (el.style.opacity === '0.5') return; // unavailable
    document.querySelectorAll('.rsq-tech-card').forEach(c => c.classList.remove('selected'));
    el.classList.add('selected');
    selectedTechId = techId;
    selectedAdminDate = null;
    selectedAdminTime = null;
    // Clear time slot grid when tech changes
    document.getElementById('adminTimeGrid').innerHTML = '<div class="text-muted small" style="grid-column:1/-1;padding:12px;text-align:center;">Select a date to see available slots</div>';
    document.getElementById('adminDateCapacity').textContent = '-';
    updateAssignButton();
    updatePreview();
    // Fetch available dates for this technician using the booking's estimated duration
    const duration = currentAssignBooking?.technicianAssistant?.estimatedDurationMinutes || 90;
    const travelTime = currentAssignBooking?.travelDurationMinutes ?? currentAssignBooking?.travelTime ?? 30;
    fetchTechAvailableDates(techId, duration, travelTime);
  };

  // ── Fetch Technician Available Dates ──────────────────────────────────
  async function fetchTechAvailableDates(techId, duration, travelTime) {
    const gridEl = document.getElementById('adminDateGrid');
    const placeholderEl = document.getElementById('adminDatePlaceholder');
    const capacityEl = document.getElementById('adminDateCapacity');

    if (placeholderEl) placeholderEl.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Loading available dates...';
    gridEl.innerHTML = '';
    if (placeholderEl) gridEl.appendChild(placeholderEl);
    capacityEl.textContent = '-';

    try {
      const res = await fetch(`/api/admin/technicians/${techId}/available-dates?duration=${duration || 90}&travelTime=${Math.max(0, Number(travelTime) || 0)}`, { credentials: 'same-origin' });
      if (!res.ok) throw new Error('Failed to load dates');
      const data = await res.json();

      if (!data.dates || data.dates.length === 0) {
        gridEl.innerHTML = '<div class="text-muted small">No dates available</div>';
        return;
      }

      let html = '';
      data.dates.forEach(d => {
        const dt = new Date(d.date + 'T00:00:00');
        const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        const dayLabel = dayNames[dt.getDay()];
        const monthDay = `${monthNames[dt.getMonth()]} ${dt.getDate()}`;

        if (d.available) {
          const slotsText = d.remainingSlots === 1 ? '1 slot' : `${d.remainingSlots} slots`;
          html += `<div class="admin-date-card available" data-date="${d.date}" onclick="selectAdminDate(this, '${d.date}', ${d.remainingSlots})" title="${d.remainingSlots} of ${d.totalSlots} slots available">
            <div class="admin-date-day">${dayLabel}</div>
            <div class="admin-date-md">${monthDay}</div>
            <div class="admin-date-slots"><i class="bi bi-check-circle-fill"></i> ${slotsText}</div>
          </div>`;
        } else {
          html += `<div class="admin-date-card unavailable" title="${d.reason}">
            <div class="admin-date-day">${dayLabel}</div>
            <div class="admin-date-md">${monthDay}</div>
            <div class="admin-date-slots"><i class="bi bi-x-circle-fill"></i> ${d.reason}</div>
          </div>`;
        }
      });

      gridEl.innerHTML = html;
      if (placeholderEl) placeholderEl.remove();
    } catch (err) {
      gridEl.innerHTML = '<div class="text-danger small"><i class="bi bi-exclamation-triangle me-1"></i>' + err.message + '</div>';
    }
  }

  // ── Select Admin Date ─────────────────────────────────────────────────
  let selectedAdminTime = null;

  window.selectAdminDate = function(el, date, slots) {
    document.querySelectorAll('.admin-date-card').forEach(c => c.classList.remove('selected'));
    el.classList.add('selected');
    selectedAdminDate = date;
    selectedAdminTime = null;

    // Update capacity display
    const capacityEl = document.getElementById('adminDateCapacity');
    capacityEl.textContent = `${slots} slot${slots === 1 ? '' : 's'} remaining`;
    capacityEl.style.color = '#16a34a';
    capacityEl.style.fontWeight = '600';

    // Render time slots from real availability
    renderAdminTimeSlots(date);
    updateAssignButton();
    updatePreview();
  };

  // ── Render Time Slots ─────────────────────────────────────────────────
  async function renderAdminTimeSlots(date) {
    const gridEl = document.getElementById('adminTimeGrid');
    const duration = currentAssignBooking?.technicianAssistant?.estimatedDurationMinutes || 90;
    const preferredWindow = currentAssignBooking?.preferredTimeWindow || 'any';

    // Show time window hint next to the label
    const hintEl = document.getElementById('adminTimeWindowHint');
    if (hintEl) {
      const labels = { morning: '(Customer prefers morning)', afternoon: '(Customer prefers afternoon)', any: '' };
      hintEl.textContent = labels[preferredWindow] || '';
    }

    if (!selectedTechId || !date) {
      gridEl.innerHTML = '<div class="text-muted small" style="grid-column:1/-1;padding:12px;text-align:center;">Select a technician and date</div>';
      return;
    }

    // Show loading
    gridEl.innerHTML = '<div class="text-muted small" style="grid-column:1/-1;padding:12px;text-align:center;"><div class="spinner-border spinner-border-sm me-1"></div>Loading slots...</div>';

    try {
      // Call the SAME API as the customer service page, but with technicianId
      // to get that specific technician's schedule-based slots
      const resp = await fetch(`/api/schedule/time-slots?technicianId=${selectedTechId}&date=${date}&duration=${duration}`, { credentials: 'same-origin' });
      const data = await resp.json();

      if (data.blocked) {
        gridEl.innerHTML = `<div class="text-danger small" style="grid-column:1/-1;padding:12px;text-align:center;"><i class="bi bi-exclamation-triangle me-1"></i>${data.message || 'Booking exceeds working hours'}</div>`;
        return;
      }

      if (data.isNonWorkingDay || data.message === 'Non-working day') {
        gridEl.innerHTML = `<div class="text-muted small" style="grid-column:1/-1;padding:12px;text-align:center;"><i class="bi bi-calendar-x me-1"></i>${data.message || 'Non-working day'}</div>`;
        return;
      }

      const timeSlots = data.timeSlots || [];
      // Filter to only available slots (service page already filters past slots)
      const availableSlots = timeSlots.filter(slot => slot.available);

      if (availableSlots.length === 0) {
        gridEl.innerHTML = '<div class="text-muted small" style="grid-column:1/-1;padding:12px;text-align:center;"><i class="bi bi-exclamation-circle me-1"></i>No available time slots for this date</div>';
        return;
      }

      const windowLabels = { morning: 'Morning (8:00 AM – 12:00 PM)', afternoon: 'Afternoon (12:00 PM – 5:00 PM)', any: 'Any Time' };
      const windowLabel = windowLabels[preferredWindow] || 'Any Time';

      // Helper: parse "8:00 AM" → hour 8, to check window preference
      function parseHourFrom12h(timeStr) {
        const m = timeStr.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
        if (!m) return 0;
        let h = parseInt(m[1]);
        if (m[3].toUpperCase() === 'PM' && h < 12) h += 12;
        if (m[3].toUpperCase() === 'AM' && h === 12) h = 0;
        return h;
      }

      function slotInWindow(timeStr, window) {
        if (window === 'any') return true;
        const hour = parseHourFrom12h(timeStr);
        if (window === 'morning') return hour < 12;
        if (window === 'afternoon') return hour >= 12;
        return true;
      }

      // Helper: convert "8:00 AM" → "08:00" (24h format for the assign endpoint)
      function to24h(timeStr) {
        const m = timeStr.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
        if (!m) return timeStr;
        let h = parseInt(m[1]);
        if (m[3].toUpperCase() === 'PM' && h < 12) h += 12;
        if (m[3].toUpperCase() === 'AM' && h === 12) h = 0;
        return `${String(h).padStart(2, '0')}:${m[2]}`;
      }

      // Group slots: preferred first, then non-preferred
      const preferredSlots = [];
      const otherSlots = [];
      availableSlots.forEach(slot => {
        if (slotInWindow(slot.startTime, preferredWindow)) {
          preferredSlots.push(slot);
        } else {
          otherSlots.push(slot);
        }
      });

      let html = '';

      // Header showing preferred window
      html += `<div style="grid-column:1/-1;margin-bottom:6px;">
        <span class="badge bg-${preferredWindow === 'any' ? 'secondary' : 'info'}" style="font-size:0.7rem;padding:4px 10px;">
          <i class="bi bi-clock-history me-1"></i>Customer Preferred: ${windowLabel}
        </span>
      </div>`;

      // Render preferred slots section
      if (preferredSlots.length > 0) {
        if (preferredWindow !== 'any') {
          html += `<div style="grid-column:1/-1;font-size:0.72rem;font-weight:600;color:#166534;margin-bottom:4px;">
            <i class="bi bi-star-fill me-1" style="font-size:0.6rem;"></i>Recommended Slots
          </div>`;
        }
        preferredSlots.forEach(slot => {
          const time24 = to24h(slot.startTime);
          html += `<div class="admin-ts preferred"
            data-value="${time24}"
            onclick="selectAdminTime(this, '${time24}')"
            title="Preferred start time: ${slot.startTime}">
            <div class="admin-ts-label">${slot.startTime}</div>
            <div style="font-size:0.6rem;color:#64748b;margin-bottom:3px;">${duration >= 60 ? Math.floor(duration/60) + 'h' + (duration%60 > 0 ? ' ' + duration%60 + 'm' : '') : duration + 'min'}</div>
            <span class="admin-ts-status available">Available</span>
          </div>`;
        });
      }

      // If no preferred slots available and there are other slots, show a notice
      if (preferredSlots.length === 0 && otherSlots.length > 0) {
        html += `<div style="grid-column:1/-1;font-size:0.72rem;color:#92400e;background:#fffbeb;padding:6px 10px;border-radius:6px;margin:4px 0;">
          <i class="bi bi-exclamation-circle me-1"></i>No ${preferredWindow} slots available. Showing other available slots below.
        </div>`;
      }

      // Render other (outside preference) slots
      if (otherSlots.length > 0) {
        if (preferredWindow !== 'any' && preferredSlots.length > 0) {
          html += `<div style="grid-column:1/-1;font-size:0.72rem;font-weight:600;color:#64748b;margin-top:6px;margin-bottom:4px;border-top:1px dashed #e2e8f0;padding-top:8px;">
            Other Available Slots
          </div>`;
        }
        otherSlots.forEach(slot => {
          const time24 = to24h(slot.startTime);
          html += `<div class="admin-ts"
            data-value="${time24}"
            onclick="selectAdminTime(this, '${time24}')"
            title="Start time: ${slot.startTime}">
            <div class="admin-ts-label">${slot.startTime}</div>
            <div style="font-size:0.6rem;color:#64748b;margin-bottom:3px;">${duration >= 60 ? Math.floor(duration/60) + 'h' + (duration%60 > 0 ? ' ' + duration%60 + 'm' : '') : duration + 'min'}</div>
            <span class="admin-ts-status available">Available</span>
          </div>`;
        });
      }

      gridEl.innerHTML = html;
    } catch (err) {
      gridEl.innerHTML = '<div class="text-danger small" style="grid-column:1/-1;padding:12px;text-align:center;"><i class="bi bi-exclamation-triangle me-1"></i>Failed to load slots</div>';
    }
  }

  // ── Select Time Slot ──────────────────────────────────────────────────
  window.selectAdminTime = function(el, timeValue) {
    document.querySelectorAll('.admin-ts').forEach(c => c.classList.remove('selected'));
    el.classList.add('selected');
    selectedAdminTime = timeValue;
    updateAssignButton();
    updatePreview();
  };

  // ── Update Assign Button ──────────────────────────────────────────────
  function updateAssignButton() {
    const btn = document.getElementById('assignSubmitBtn');
    btn.disabled = !selectedTechId || !selectedAdminDate || !selectedAdminTime;
  }

  // ── Update Preview ────────────────────────────────────────────────────
  function updatePreview() {
    const preview = document.getElementById('assignPreview');

    if (selectedAdminDate && selectedTechId && selectedAdminTime) {
      const dt = new Date(selectedAdminDate + 'T00:00:00');
      document.getElementById('previewDate').textContent = dt.toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

      // Convert 24h to 12h format
      const [h, m] = selectedAdminTime.split(':');
      const hour = parseInt(h);
      const ampm = hour >= 12 ? 'PM' : 'AM';
      const h12 = hour > 12 ? hour - 12 : hour === 0 ? 12 : hour;
      document.getElementById('previewTime').textContent = `${h12}:${m || '00'} ${ampm}`;

      const techCard = document.querySelector(`.rsq-tech-card[data-tech="${selectedTechId}"]`);
      const techName = techCard ? techCard.querySelector('.rsq-tech-name')?.textContent : 'Unknown';
      document.getElementById('previewTech').textContent = techName;

      preview.style.display = 'block';
    } else {
      preview.style.display = 'none';
    }
  }

  // ── Submit Assignment ─────────────────────────────────────────────────
  window.submitAssignment = async function() {
    const bookingId = document.getElementById('assignBookingId').value;
    const date = selectedAdminDate;
    const time = selectedAdminTime;
    const notes = document.getElementById('assignNotes').value;

    if (!selectedTechId || !date || !time) return;

    const btn = document.getElementById('assignSubmitBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Scheduling...';

    try {
      const res = await fetch(`/api/admin/repair-scheduling-queue/${bookingId}/assign`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          technicianId: selectedTechId,
          scheduledDate: date,
          scheduledTime: time,
          notes
        })
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to assign');

      // Close modal and refresh
      bootstrap.Modal.getInstance(document.getElementById('assignModal')).hide();

      // Show success toast
      showToast('success', `Repair scheduled successfully! ${data.message || ''}`);

      loadQueue();
    } catch (err) {
      showToast('error', err.message);
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Assign & Schedule';
    }
  };

  // ── Show Parts Request Modal ─────────────────────────────────────────
  let _mpBookingId = null;
  window.showPartsRequest = async function(bookingId) {
    // Refresh queue data to ensure latest stock information
    // (in case stock was adjusted on the Repair Parts page)
    try {
      await loadQueue();
    } catch (e) {
      console.warn('[RSQ] Failed to refresh queue:', e);
    }
    
    const b = allBookings.find(x => x._id === bookingId);
    if (!b) return;
    _mpBookingId = bookingId;
    const isAiPreparationRequest = b.requestPhase === 'phase_1_ai_preparation';
    document.getElementById('mpModalTitle').textContent = isAiPreparationRequest
      ? 'AI Preparation Parts Reservation'
      : 'Phase 2 Repair Parts & Scheduling';
    document.getElementById('mpWorkOrder').textContent = `${b.workOrderNumber} · ${isAiPreparationRequest ? 'Phase 1 - Technician Preparation' : 'Phase 2 - Repair Visit'}`;
    document.getElementById('mpProcureResult').style.display = 'none';

    const allParts = b.quotation?.parts || [];
    // Show ALL parts — those in stock and those needing procurement
    const parts = allParts;
    const needingProcurement = allParts.filter(p => p.needsProcurement !== false);
    const partsListEl = document.getElementById('mpPartsList');

    const hasReadyParts = b.partsStatus === 'reserved' || b.partsStatus === 'none' || b.stockAvailable;
    const isReadyForScheduling = isRepairSchedulingReady(b);
    const isReadyForTechnician = isAiPreparationRequest && hasReadyParts;
    document.getElementById('mpStatusText').textContent = isAiPreparationRequest
      ? 'Parts reserved — technician preparation can continue. No scheduling is required.'
      : 'All parts received — ready for phase 2 repair scheduling.';
    const canReceive = b.partsStatus === 'waiting_parts';
    const canCheck = b.partsStatus === 'pending_check';
    const allInStock = needingProcurement.length === 0 && allParts.length > 0;

    if (allInStock && (canCheck || canReceive)) {
      partsListEl.innerHTML = `
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="fw-semibold" style="font-size:0.85rem;color:#0f172a;">All ${allParts.length} Part(s) In Stock</span>
          <span class="rsq-status-badge rsq-priority-medium" style="font-size:0.65rem;"><i class="bi bi-hourglass-split me-1"></i>Pending Reservation</span>
        </div>
        <div style="border:1px solid #bbf7d0;border-radius:10px;overflow:hidden;background:#f0fdf4;padding:12px 16px;">
          <div style="display:flex;align-items:center;gap:8px;font-size:0.82rem;color:#166534;">
            <i class="bi bi-check-circle-fill"></i>
            <span>${isAiPreparationRequest
              ? `This is an AI preparation request. Click <strong>"Reserve &amp; Return to Technician"</strong> to secure the stock and resume technician preparation. <strong>No repair scheduling is needed.</strong>`
              : `This is a phase 2 repair request. Click <strong>"Reserve Parts &amp; Schedule"</strong> to secure the stock and schedule the repair visit.`}</span>
          </div>
        </div>
      `;
      document.getElementById('mpReceiveBtn').style.display = 'none';
      document.getElementById('mpCheckBtn').style.display = 'none';
      document.getElementById('mpScheduleBtn').style.display = 'none';
      document.getElementById('mpStatusInfo').style.display = 'none';
      let reserveBtn = document.getElementById('mpReserveAndScheduleBtn');
      if (!reserveBtn) {
        reserveBtn = document.createElement('button');
        reserveBtn.id = 'mpReserveAndScheduleBtn';
        reserveBtn.className = 'btn btn-success btn-sm fw-semibold';
        document.querySelector('#managePartsModal .ent-modal-footer').insertBefore(reserveBtn, document.getElementById('mpScheduleBtn'));
      }
      reserveBtn.onclick = function() { reserveAndSchedule(bookingId); };
      reserveBtn.innerHTML = isAiPreparationRequest
        ? '<i class="bi bi-arrow-return-left me-1"></i> Reserve &amp; Return to Technician'
        : '<i class="bi bi-calendar-plus me-1"></i> Reserve Parts &amp; Schedule';
      reserveBtn.style.display = '';
    } else if (allInStock && !canCheck) {
      partsListEl.innerHTML = `<div class="text-muted small text-center py-4" style="color:#16a34a !important;"><i class="bi bi-check-circle-fill me-1"></i>All ${allParts.length} part(s) are available in stock. No procurement needed.</div>`;
      document.getElementById('mpReceiveBtn').style.display = 'none';
      document.getElementById('mpCheckBtn').style.display = 'none';
      const scheduleBtn = document.getElementById('mpScheduleBtn');
      scheduleBtn.style.display = '';
      scheduleBtn.disabled = !isReadyForScheduling;
      scheduleBtn.title = isReadyForScheduling ? '' : 'Procure and reserve all missing parts before scheduling.';
      document.getElementById('mpStatusInfo').style.display = (isReadyForScheduling || isReadyForTechnician) ? 'block' : 'none';
      const reserveBtn = document.getElementById('mpReserveAndScheduleBtn');
      if (reserveBtn) reserveBtn.style.display = 'none';
    } else {
      const statusLabels = {
        reserved: { label: 'Available', class: 'rsq-status-scheduled', icon: 'bi-check-circle-fill' },
        waiting_parts: { label: 'Waiting for Parts', class: 'rsq-priority-critical', icon: 'bi-exclamation-triangle-fill' },
        pending_check: { label: 'Pending Check', class: 'rsq-priority-medium', icon: 'bi-hourglass-split' },
        none: { label: 'Available', class: 'rsq-status-scheduled', icon: 'bi-check-circle-fill' },
      };
      const status = statusLabels[b.partsStatus] || statusLabels.none;

      const needingCount = needingProcurement.length;
      partsListEl.innerHTML = `
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="fw-semibold" style="font-size:0.85rem;color:#0f172a;">Repair Parts (${allParts.length} total${needingCount > 0 ? ' · ' + needingCount + ' need procurement' : ''})</span>
          <span class="rsq-status-badge ${status.class}" style="font-size:0.65rem;"><i class="bi ${status.icon} me-1"></i>${status.label}</span>
        </div>
        <div style="border:1px solid #e2e8f0;border-radius:10px;overflow:hidden;">
          <table style="width:100%;border-collapse:collapse;font-size:0.82rem;">
            <thead><tr style="background:#f8fafc;"><th style="padding:8px 12px;text-align:left;font-weight:600;color:#64748b;border-bottom:1px solid #e2e8f0;">Part</th><th style="padding:8px 12px;text-align:center;font-weight:600;color:#64748b;border-bottom:1px solid #e2e8f0;">Qty</th><th style="padding:8px 12px;text-align:center;font-weight:600;color:#64748b;border-bottom:1px solid #e2e8f0;">In Stock</th><th style="padding:8px 12px;text-align:right;font-weight:600;color:#64748b;border-bottom:1px solid #e2e8f0;">Cost</th><th style="padding:8px 12px;text-align:center;font-weight:600;color:#64748b;border-bottom:1px solid #e2e8f0;">Status</th></tr></thead>
            <tbody>${parts.map(p => {
              const qty = p.quantity || 1;
              const cost = p.cost || 0;
              const stock = p.currentStock || 0;
              const needsProc = p.needsProcurement !== false && stock < qty;
              const statusBadge = needsProc
                ? '<span style="color:#dc2626;font-weight:700;font-size:0.7rem;"><i class="bi bi-exclamation-triangle-fill me-1"></i>Need Procurement</span>'
                : '<span style="color:#16a34a;font-weight:700;font-size:0.7rem;"><i class="bi bi-check-circle-fill me-1"></i>In Stock</span>';
              const stockColor = needsProc ? '#dc2626' : '#16a34a';
              return `<tr><td style="padding:8px 12px;border-bottom:1px solid #f1f5f9;font-weight:600;">${p.name || 'Part'}</td><td style="padding:8px 12px;border-bottom:1px solid #f1f5f9;text-align:center;">${qty}</td><td style="padding:8px 12px;border-bottom:1px solid #f1f5f9;text-align:center;"><span style="color:${stockColor};font-weight:600;">${stock}</span></td><td style="padding:8px 12px;border-bottom:1px solid #f1f5f9;text-align:right;font-weight:600;">₱${Number(cost * qty).toLocaleString()}</td><td style="padding:8px 12px;border-bottom:1px solid #f1f5f9;text-align:center;">${statusBadge}</td></tr>`;
            }).join('')}</tbody>
          </table>
        </div>
      `;

      // Stock must be recorded in inventory before a technician request can be
      // resolved. Do not allow "mark received" to bypass the stock ledger.
      document.getElementById('mpReceiveBtn').style.display = 'none';
      document.getElementById('mpCheckBtn').style.display = (canCheck || canReceive) ? '' : 'none';
      const scheduleBtn = document.getElementById('mpScheduleBtn');
      scheduleBtn.style.display = '';
      scheduleBtn.disabled = !isReadyForScheduling;
      scheduleBtn.title = isReadyForScheduling ? '' : 'Procure and reserve all missing parts before scheduling.';
      if (canCheck || canReceive) {
        document.getElementById('mpCheckBtn').innerHTML = isAiPreparationRequest
          ? '<i class="bi bi-box-arrow-in-down me-1"></i> Procure / Restock &amp; Auto-Reserve'
          : '<i class="bi bi-cart-plus me-1"></i> Procure Repair Parts';
      }
      document.getElementById('mpStatusInfo').style.display = (isReadyForScheduling || isReadyForTechnician) ? 'block' : 'none';
      const reserveBtn = document.getElementById('mpReserveAndScheduleBtn');
      if (reserveBtn) reserveBtn.style.display = 'none';
    }

    new bootstrap.Modal(document.getElementById('managePartsModal')).show();
  };

  // ── Reserve available parts and refresh queue ───────────────────────
  window.reserveParts = async function(bookingId) {
    if (!bookingId) return;
    try {
      Swal.fire({ title: 'Reserving stock...', allowOutsideClick: false, showConfirmButton: false, willOpen: () => Swal.showLoading() });
      const res = await fetch(`/api/admin/repair-scheduling-queue/${bookingId}/check-and-procure-parts`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin'
      });
      const data = await res.json();
      Swal.close();
      if (!res.ok) throw new Error(data.error || 'Failed to reserve parts');
      await window.loadQueue();
      const newB = allBookings.find(x => x._id === bookingId);
      if (newB) window.showPartsRequest(bookingId);
    } catch (e) {
      Swal.fire('Error', e.message, 'error');
    }
  };

  // ── Reserve & Schedule (all parts in stock, just need reservation) ────
  window.reserveAndSchedule = async function(bookingId) {
    const btn = document.getElementById('mpReserveAndScheduleBtn');
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Reserving stock...'; }
    try {
      const res = await fetch(`/api/admin/repair-scheduling-queue/${bookingId}/check-and-procure-parts`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: '{}',
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to reserve parts');
      if (!data.allReady) {
        showToast('warning', 'Some parts could not be reserved. Please procure missing parts first.');
        bootstrap.Modal.getInstance(document.getElementById('managePartsModal')).hide();
        await loadQueue();
        return;
      }
      showToast('success', data.message || 'Parts reserved successfully.');
      bootstrap.Modal.getInstance(document.getElementById('managePartsModal')).hide();
      await loadQueue();
      if (data.readyForScheduling) {
        setTimeout(() => openAssignModal(bookingId), 300);
      }
    } catch (err) {
      showToast('error', err.message);
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-calendar-plus me-1"></i> Reserve Parts &amp; Schedule'; }
    }
  };

  // ── Check & Procure Parts ────────────────────────────────────────────
  window.submitCheckAndProcure = function() {
    if (!_mpBookingId) return;
    const b = allBookings.find(x => x._id === _mpBookingId);
    const allParts = b?.quotation?.parts || [];
    const needing = allParts.filter(p => p.needsProcurement !== false);
    if (needing.length === 0) {
      window.reserveParts(_mpBookingId);
    } else {
      window.location.href = `/admin/inventory/repair-parts?bookingId=${_mpBookingId}`;
    }
  };

  // ── Submit Receive Parts ─────────────────────────────────────────────
  window.submitReceiveParts = async function() {
    const btn = document.getElementById('mpReceiveBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Processing...';
    try {
      const res = await fetch(`/api/admin/repair-queue/${_mpBookingId}/receive-parts`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to receive parts');
      showToast('success', data.message || 'Parts received successfully!');
      bootstrap.Modal.getInstance(document.getElementById('managePartsModal')).hide();
      await loadQueue();
      // If all parts received, re-open modal with schedule button visible
      if (data.booking && data.booking.status === 'ready_for_repair') {
        setTimeout(() => showPartsRequest(_mpBookingId), 300);
      }
    } catch (err) {
      showToast('error', err.message);
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Mark All as Received';
    }
  };

  // ── Proceed to Schedule ──────────────────────────────────────────────
  window.proceedToSchedule = function() {
    if (!_mpBookingId) return;
    const booking = allBookings.find(item => item._id === _mpBookingId);
    if (booking?.requestPhase === 'phase_1_ai_preparation') {
      showToast('warning', 'This is a phase 1 AI preparation request. Repair scheduling is not required.');
      document.getElementById('mpScheduleBtn').style.display = 'none';
      return;
    }
    if (!isRepairSchedulingReady(booking)) {
      showToast('warning', 'Schedule & Assign is disabled until every missing repair part has been procured and reserved.');
      return;
    }
    bootstrap.Modal.getInstance(document.getElementById('managePartsModal')).hide();
    setTimeout(() => openAssignModal(_mpBookingId), 300);
  };

  // ── Show Detail ───────────────────────────────────────────────────────
  window.showDetail = function(bookingId) {
    const b = allBookings.find(x => x._id === bookingId);
    if (!b) return;

    document.getElementById('detailWorkOrder').textContent = b.workOrderNumber;

    const dates = (b.preferredDates || []).map(d => new Date(d).toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric' })).join(', ');
    const timeLabel = { morning: 'Morning', afternoon: 'Afternoon', any: 'Any Time' }[b.preferredTimeWindow] || 'Any Time';

    document.getElementById('detailBody').innerHTML = `
      <div class="ent-detail-grid">
        <div class="ent-detail-card">
          <div class="ent-detail-card-icon" style="background:#eff6ff;color:#3b82f6;"><i class="bi bi-person"></i></div>
          <div class="ent-detail-card-content">
            <span class="ent-detail-label">Customer</span>
            <span class="ent-detail-value">${b.customer?.name || '-'}</span>
            <span class="ent-detail-sub">${b.customer?.email || ''} ${b.customer?.phone ? '| ' + b.customer.phone : ''}</span>
          </div>
        </div>
        <div class="ent-detail-card">
          <div class="ent-detail-card-icon" style="background:#f0fdf4;color:#22c55e;"><i class="bi bi-person-badge"></i></div>
          <div class="ent-detail-card-content">
            <span class="ent-detail-label">Original Inspector</span>
            <span class="ent-detail-value">${b.originalInspector?.name || '-'}</span>
          </div>
        </div>
        <div class="ent-detail-card">
          <div class="ent-detail-card-icon" style="background:#fef3c7;color:#f59e0b;"><i class="bi bi-calendar-check"></i></div>
          <div class="ent-detail-card-content">
            <span class="ent-detail-label">Inspection Date</span>
            <span class="ent-detail-value">${b.inspectionDate ? new Date(b.inspectionDate).toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' }) : '-'}</span>
          </div>
        </div>
        <div class="ent-detail-card">
          <div class="ent-detail-card-icon" style="background:#f5f3ff;color:#7c3aed;"><i class="bi bi-cash-stack"></i></div>
          <div class="ent-detail-card-content">
            <span class="ent-detail-label">Quotation Total</span>
            <span class="ent-detail-value">${b.quotation?.totalCost ? '₱' + Number(b.quotation.totalCost).toLocaleString() : '-'}</span>
          </div>
        </div>
        <div class="ent-detail-card ent-detail-card-wide">
          <div class="ent-detail-card-icon" style="background:#ecfdf5;color:#059669;"><i class="bi bi-calendar3"></i></div>
          <div class="ent-detail-card-content">
            <span class="ent-detail-label">Preferred Dates & Time</span>
            <span class="ent-detail-value">${dates || 'None'}</span>
            <span class="ent-detail-sub">Time: ${timeLabel}</span>
          </div>
        </div>
        ${b.quotation?.parts?.length ? `
        <div class="ent-detail-card ent-detail-card-wide">
          <div class="ent-detail-card-icon" style="background:#f0fdf4;color:#059669;"><i class="bi bi-box-seam"></i></div>
          <div class="ent-detail-card-content">
            <span class="ent-detail-label">Requested Parts (${b.quotation.parts.length} item${b.quotation.parts.length > 1 ? 's' : ''})</span>
            <div class="ent-detail-value" style="font-weight:500;font-size:0.82rem;display:flex;flex-wrap:wrap;gap:4px;margin-top:4px;">
              ${b.quotation.parts.map(p => {
                const qty = p.quantity || 1;
                const cost = p.cost || 0;
                return `<span style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:6px;padding:3px 8px;font-size:0.78rem;">
                  ${p.name || 'Part'} ×${qty} <span style="opacity:0.6;">₱${Number(cost * qty).toLocaleString()}</span>
                </span>`;
              }).join('')}
            </div>
            <span class="ent-detail-sub" style="margin-top:4px;">
              Labor: ₱${Number(b.quotation.laborCost || 0).toLocaleString()} | 
              Total: ₱${Number(b.quotation.totalCost || 0).toLocaleString()}
            </span>
          </div>
        </div>
        ` : ''}
        ${b.unitInfo ? `
        <div class="ent-detail-card ent-detail-card-wide">
          <div class="ent-detail-card-icon" style="background:#fef2f2;color:#ef4444;"><i class="bi bi-tools"></i></div>
          <div class="ent-detail-card-content">
            <span class="ent-detail-label">Unit Information</span>
            <span class="ent-detail-value">${b.unitInfo.unitType || b.applianceTypeName || b.applianceType || '-'}</span>
            <span class="ent-detail-sub">Brand: ${b.unitInfo.brand || b.brand || '-'}</span>
            <span class="ent-detail-sub">Model: ${b.unitInfo.model || '-'}</span>
            <span class="ent-detail-sub">Quantity: ${b.quantity || 1}</span>
          </div>
        </div>
        ` : ''}
        ${(b.issueDescription || (b.unitInfo && b.unitInfo.problemDescription) || (Array.isArray(b.repairIssues) && b.repairIssues.length)) ? `
        <div class="ent-detail-card ent-detail-card-wide">
          <div class="ent-detail-card-icon" style="background:#fffbeb;color:#d97706;"><i class="bi bi-exclamation-triangle"></i></div>
          <div class="ent-detail-card-content">
            <span class="ent-detail-label">Issue / Problem Description</span>
            <span class="ent-detail-value">${b.issueDescription || (b.unitInfo && b.unitInfo.problemDescription) || b.repairIssues.join(', ') || '-'}</span>
          </div>
        </div>
        ` : ''}
      </div>
    `;

    new bootstrap.Modal(document.getElementById('detailModal')).show();
  };

  // ── Toast Notifications ───────────────────────────────────────────────
  function showToast(type, message) {
    const toast = document.createElement('div');
    const alertClass = type === 'success' ? 'success' : type === 'warning' ? 'warning' : 'danger';
    const iconClass = type === 'success' ? 'check-circle-fill' : type === 'warning' ? 'exclamation-triangle-fill' : 'exclamation-triangle-fill';
    toast.className = `alert alert-${alertClass} position-fixed`;
    toast.style.cssText = 'top:20px;right:20px;z-index:9999;min-width:300px;box-shadow:0 8px 24px rgba(0,0,0,0.15);border-radius:10px;';
    toast.innerHTML = `<div class="d-flex align-items-center gap-2"><i class="bi bi-${iconClass}"></i><span>${message}</span></div>`;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 4000);
  }

  // ── Event Listeners ───────────────────────────────────────────────────
  document.getElementById('searchInput').addEventListener('input', renderQueue);
  document.getElementById('filterStatus').addEventListener('change', renderQueue);
  document.getElementById('filterTimeWindow').addEventListener('change', renderQueue);

  // Clean up dynamic buttons when manage parts modal is closed
  document.getElementById('managePartsModal').addEventListener('hidden.bs.modal', function() {
    const reserveBtn = document.getElementById('mpReserveAndScheduleBtn');
    if (reserveBtn) reserveBtn.style.display = 'none';
  });

  // ── Initial Load ──────────────────────────────────────────────────────
  loadQueue();

  // Stat card sparklines
  (function(){
    function spark(ctx, data, color){
      if(!ctx || !window.Chart) return null;
      var h = ctx.canvas.height || ctx.canvas.offsetHeight || 40;
      var g = ctx.createLinearGradient(0,0,0,h);
      g.addColorStop(0, color);
      g.addColorStop(1, 'rgba(255,255,255,0)');
      return new Chart(ctx, {
        type: 'line',
        data: {
          labels: data.map(function(_,i){ return i+1; }),
          datasets: [{ data: data, borderColor: color, backgroundColor: g, fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2 }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          animation: { duration: 600 },
          plugins: { legend: { display: false }, tooltip: { enabled: false } },
          scales: { x: { display: false }, y: { display: false } }
        }
      });
    }
    function randomData(n){
      var arr = [8 + Math.random()*12];
      for(var i=1; i<n; i++){ arr.push(Math.max(3, Math.min(30, arr[i-1] + (Math.random()-0.5)*12))); }
      return arr;
    }
    document.querySelectorAll('.stat-sparkline canvas').forEach(function(c){
      var card = c.closest('.stat-card');
      var color = card ? (card.dataset.sparkColor || '#2563eb') : '#2563eb';
      spark(c.getContext('2d'), randomData(10), color);
    });
  })();
})();
</script>
