                </div>
                <div class="mb-3">
                  <div style="font-size: 0.65rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;">Select Horsepower</div>
                  <div id="wizardHpOptions"></div>
                </div>

                <!-- Unified Selection Summary -->
                <div class="mt-3 p-3" id="wizardSelectedInfo"
