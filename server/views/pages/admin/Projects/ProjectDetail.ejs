        const result = await studioApi(`/api/projects/${projectId}/resources/${row.dataset.resourceId}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ quantity:Number(quantity), recommendationState:'planned', adjustmentReason }) });
        reloadReview(result.message);
      }));
      overlay.querySelectorAll('.res-purchase').forEach(button => button.addEventListener('click', async () => {
        const row = button.closest('[data-resource-id]');
