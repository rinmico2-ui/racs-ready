    // ── Transport fare calculation ──────────────────────────────────────
    function updateRoutePanel(distKm, durMin, farePerKm, fee, isRoad) {
      var panel = document.getElementById('routeInfoPanel');
      var distEl  = document.getElementById('routeDistDisplay');
      var durEl   = document.getElementById('routeDurDisplay');
      var rateEl  = document.getElementById('routeRateDisplay');
      var fareEl  = document.getElementById('routeFareDisplay');
      var formulaEl = document.getElementById('routeCalcFormula');
      var badgeEl = document.getElementById('routeMethodBadge');
      var spinner = document.getElementById('mapLocatingSpinner');
      var fitRouteBtn = document.getElementById('fitRouteBtn');
      if (spinner) spinner.classList.remove('show');
      if (fitRouteBtn) fitRouteBtn.disabled = false;
      if (!panel) return;
      panel.classList.add('has-route');
      if (distEl)  distEl.textContent  = distKm.toFixed(1) + ' km';
      if (durEl)   durEl.textContent   = durMin + ' min';
      if (rateEl)  rateEl.textContent  = '\u20b1' + farePerKm.toFixed(2) + '/km';
      if (fareEl)  fareEl.textContent  = '\u20b1' + fee.toLocaleString('en-PH', {minimumFractionDigits:2, maximumFractionDigits:2});
      if (formulaEl) formulaEl.textContent = distKm.toFixed(1) + ' km \u00d7 \u20b1' + farePerKm.toFixed(2) + '/km = \u20b1' + fee.toLocaleString('en-PH', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' delivery fee';
      if (badgeEl) {
        if (isRoad) {
          badgeEl.innerHTML = '<i class="bi bi-diagram-3 me-1"></i>By road';
          badgeEl.className = 'route-method-badge';
        } else {
          badgeEl.innerHTML = '<i class="bi bi-calculator me-1"></i>Estimated fee';
          badgeEl.className = 'route-method-badge haversine';
        }
      }
      // Also update legacy meta element if present
      var meta = document.getElementById('reviewTransportCalc');
      if (meta) meta.textContent = distKm.toFixed(1) + ' km \u00d7 \u20b1' + farePerKm + '/km';
    }

    function calcTransportFare(custLat, custLng) {
      var routeRequestId = ++_routeRequestId;
      var spinner = document.getElementById('mapLocatingSpinner');
      var spinnerLabel = document.getElementById('mapSpinnerLabel');
      if (spinnerLabel) spinnerLabel.textContent = 'Calculating route...';
      if (spinner) spinner.classList.add('show');
      _routeQuoteError = null;
      _routeQuotePending = fetch('/api/orders/delivery-quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lat: custLat, lng: custLng })
      }).then(async function(response) {
        const data = await response.json().catch(function() { return {}; });
        if (!response.ok || !data.quote) throw new Error(data.error || 'Unable to calculate the delivery route.');
        if (routeRequestId !== _routeRequestId) return;
        const quote = data.quote;
        _routeDistanceKm = Number(quote.distanceKm);
        _routeDurationMin = Number(quote.durationMin);
        _transportFee = Number(quote.transportationFee);
        window._farePerKm = Number(quote.farePerKm) || window._farePerKm;
        if (leafletMap && quote.geometry) {
          if (window._routeLayer) leafletMap.removeLayer(window._routeLayer);
          window._routeLayer = L.geoJSON(quote.geometry, {
            style: { color: '#6366f1', weight: 5, opacity: 0.85 }
          }).addTo(leafletMap);
          leafletMap.fitBounds(window._routeLayer.getBounds(), { padding: [40, 40] });
        }
        updateRoutePanel(
          _routeDistanceKm,
          _routeDurationMin,
          Number(quote.farePerKm) || 0,
          _transportFee,
          quote.source === 'road'
        );
        if (checkoutCalendar) checkoutCalendar.setTravelTime(_routeDurationMin);
      }).catch(function(error) {
        if (routeRequestId !== _routeRequestId) return;
        _routeDistanceKm = NaN;
        _routeDurationMin = 0;
        _transportFee = 0;
        _routeQuoteError = error.message || 'Unable to calculate the delivery route.';
      }).finally(function() {
        if (routeRequestId === _routeRequestId && spinner) spinner.classList.remove('show');
      });
      return _routeQuotePending;
    }

    function populateReview() {
      let html = '';
      CART_ITEMS.forEach(it => {
        const inv = it.inventoryId && typeof it.inventoryId === 'object' ? it.inventoryId : {};
        const quantity = Math.max(1, Number(it.quantity) || 1);
        html += `
        <div class="d-flex align-items-center mb-2 pb-2 border-bottom">
          <img src="${safeCheckoutImageUrl(inv.imageUrl)}" alt="" style="width: 45px; height: 45px; object-fit: contain; background: #f8fafc; border-radius: 8px; padding: 4px;" class="me-3 border">
          <div class="flex-grow-1">
            <div class="fw-bold small text-dark lh-sm">${escapeCheckoutHtml(inv.modelLine || 'Air conditioner')}</div>
            <div class="text-muted" style="font-size: 0.75rem;">${escapeCheckoutHtml(inv.capacity || '')} ${escapeCheckoutHtml(inv.capacityUnit || 'HP')} · ${quantity}x</div>
          </div>
          <div class="fw-bolder small text-primary">₱${((Number(inv.sellingPrice) || 0) * quantity).toLocaleString()}</div>
        </div>
      `;
      });
      document.getElementById('cartItemsReviewList').innerHTML = html;

      const details = [];
      const fulfillLabels = { delivery_installation: '🔧 Delivery + Installation', customer_pickup: '🏪 Customer Pickup' };
      details.push({ label: 'Get order', value: fulfillLabels[selectedFulfillment] || '' });

      if (selectedFulfillment !== 'customer_pickup') {
        const addr = document.getElementById('wizardAddress').value.trim();
        const contact = document.getElementById('wizardContact').value.trim();
        const date = document.getElementById('wizardDate').value;
        const timeSlot = document.getElementById('wizardTimeSlot').value;
        details.push({ label: 'Address', value: addr });
        details.push({ label: 'Contact', value: contact });
        details.push({ label: selectedFulfillment === 'delivery_installation' ? 'Installation' : 'Delivery', value: `${date} ${timeSlot ? 'at ' + timeSlot : ''}` });
      } else {
        details.push({ label: 'Pickup Date', value: document.getElementById('wizardPickupDate').value });
        details.push({ label: 'Pickup Location', value: 'CALIDRO RACS Store' });
      }
      
      const payMethod = document.getElementById('wizardPaymentMethod').value;
      const selectedPaymentChannel = orderPaymentChannelLabel(document.getElementById('wizardPaymentChannel')?.value);
      const payLabels = {
        cash_onsite:  '💵 Pay in cash at store pickup',
        gcash_full:   `📱 Pay all now with ${selectedPaymentChannel}`,
        cod:          `💳 Pay ${window.downpaymentPercentage || 10}% now via ${selectedPaymentChannel}; pay the rest after installation`
      };
      details.push({ label: 'Payment', value: payLabels[payMethod] || payMethod.toUpperCase() });

      // Fallback: if SUB_TOTAL is 0 (API didn't compute it), derive from items
      let effectiveTotal = SUB_TOTAL;
      if (!effectiveTotal || effectiveTotal === 0) {
        effectiveTotal = CART_ITEMS.reduce((sum, it) => {
          const inv = it.inventoryId;
          const price = (inv && typeof inv === 'object') ? (inv.sellingPrice || 0) : 0;
          return sum + price * (it.quantity || 1);
        }, 0);
      }

      document.getElementById('reviewSubtotal').textContent = `₱${effectiveTotal.toLocaleString()}`;
      
      const transportRow = document.getElementById('transportBreakdownRow');
      const deliveryRow = document.getElementById('reviewDeliveryRow');
      if (deliveryRow) deliveryRow.style.display = 'none';

      if (selectedFulfillment !== 'customer_pickup') {
        document.getElementById('reviewTransportTotal').textContent = '₱' + _transportFee.toLocaleString();
        if (transportRow) transportRow.style.display = 'block';
      } else {
        if (transportRow) transportRow.style.display = 'none';
      }

      if (selectedFulfillment === 'delivery_installation') {
        document.getElementById('reviewInstallRow').style.display = 'flex';
        document.getElementById('reviewInstallFee').textContent = 'Free';
      } else {
        document.getElementById('reviewInstallRow').style.display = 'none';
      }
      const total = effectiveTotal + (selectedFulfillment !== 'customer_pickup' ? _transportFee : 0);
      const percentage = window.downpaymentPercentage || 10;
      const dueNow = payMethod === 'cash_onsite' ? 0 : (payMethod === 'cod' ? Math.round(total * percentage / 100) : total);
      const dueLater = Math.max(0, total - dueNow);
      details.push({ label: 'Pay now', value: `₱${dueNow.toLocaleString()}` });
      if (dueLater > 0) {
        details.push({
          label: payMethod === 'cash_onsite' ? 'Pay at store pickup' : 'Pay after installation',
          value: `₱${dueLater.toLocaleString()}`
        });
      }
      document.getElementById('reviewDetails').innerHTML = details.map(d => `<div class="review-row py-1"><span class="review-label small">${escapeCheckoutHtml(d.label)}</span><span class="review-value small">${escapeCheckoutHtml(d.value)}</span></div>`).join('');
      document.getElementById('reviewTotal').textContent = `₱${total.toLocaleString()}`;
    }

    function escapeMapText(value) {
      return String(value || '').replace(/[&<>"']/g, function(char) {
        return ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#039;' })[char];
      });
    }

    function showMapAccessNotice(message, tone) {
      const notice = document.getElementById('mapAccessNotice');
      if (!notice) return;
      notice.classList.remove('d-none', 'is-info');
      if (tone === 'info') notice.classList.add('is-info');
      notice.innerHTML = '<i class="bi ' + (tone === 'info' ? 'bi-info-circle' : 'bi-exclamation-triangle') + '"></i>' + escapeMapText(message);
    }

    function clearMapAccessNotice() {
      const notice = document.getElementById('mapAccessNotice');
      if (notice) notice.classList.add('d-none');
    }

    function focusManualAddress() {
      const input = document.getElementById('wizardAddress');
      if (input) setTimeout(function() { input.focus({ preventScroll: true }); }, 80);
    }

    function updateMapSelectionDetails(lat, lng, address, source) {
      clearMapAccessNotice();
      _customerLocationSelected = true;
      _lastCustomerLat = Number(lat);
      _lastCustomerLng = Number(lng);
      document.getElementById('wizardLat').value = _lastCustomerLat.toFixed(7);
      document.getElementById('wizardLng').value = _lastCustomerLng.toFixed(7);

      var panel = document.getElementById('mapSelectionPanel');
      var status = document.getElementById('mapSelectionStatus');
      var addressPreview = document.getElementById('mapAddressPreview');
      var coordinateDisplay = document.getElementById('mapCoordinateDisplay');
      var coordinateSource = document.getElementById('mapCoordinateSource');
      var fitRouteBtn = document.getElementById('fitRouteBtn');
      if (panel) panel.classList.add('has-location');
      if (status) status.textContent = 'Delivery pin confirmed';
      if (addressPreview) addressPreview.textContent = address || 'Resolving the selected street address...';
      if (coordinateDisplay) coordinateDisplay.textContent = _lastCustomerLat.toFixed(6) + ', ' + _lastCustomerLng.toFixed(6);
      if (coordinateSource) coordinateSource.textContent = source || 'Map selection';
      if (fitRouteBtn) fitRouteBtn.disabled = false;

      if (leafletMarker) {
        leafletMarker.setOpacity(1);
        var popupAddress = address || 'Selected delivery point';
        leafletMarker.bindPopup('<strong style="color:#991b1b;">Delivery Location</strong><br>' + escapeMapText(popupAddress) + '<br><small>' + _lastCustomerLat.toFixed(6) + ', ' + _lastCustomerLng.toFixed(6) + '</small>');
      }
    }

    function reverseGeocodeDeliveryPoint(lat, lng, source) {
      var requestId = ++_reverseGeocodeRequestId;
      var addressInput = document.getElementById('wizardAddress');
      return fetch('https://nominatim.openstreetmap.org/reverse?format=json&addressdetails=1&zoom=18&lat=' + encodeURIComponent(lat) + '&lon=' + encodeURIComponent(lng))
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (requestId !== _reverseGeocodeRequestId) return '';
          var resolvedAddress = data && data.display_name ? data.display_name : (Number(lat).toFixed(6) + ', ' + Number(lng).toFixed(6));
          if (addressInput) addressInput.value = resolvedAddress;
          updateMapSelectionDetails(lat, lng, resolvedAddress, source);
          return resolvedAddress;
        })
        .catch(function() {
          if (requestId !== _reverseGeocodeRequestId) return '';
          var coordinateAddress = Number(lat).toFixed(6) + ', ' + Number(lng).toFixed(6);
          if (addressInput) addressInput.value = coordinateAddress;
          updateMapSelectionDetails(lat, lng, coordinateAddress, source);
          return coordinateAddress;
        });
    }

    function setCustomerMapLocation(lat, lng, options) {
      options = options || {};
      lat = Number(lat); lng = Number(lng);
      if (!Number.isFinite(lat) || !Number.isFinite(lng) || !leafletMap || !leafletMarker) return;
      leafletMarker.setLatLng([lat, lng]);
      if (options.zoom !== false) leafletMap.flyTo([lat, lng], Number(options.zoom) || 16, { duration: .65 });
      updateMapSelectionDetails(lat, lng, options.address || '', options.source || 'Map selection');
      calcTransportFare(lat, lng);
      if (options.reverseGeocode === false) {
        var addressInput = document.getElementById('wizardAddress');
        if (addressInput && options.address) addressInput.value = options.address;
      } else {
        reverseGeocodeDeliveryPoint(lat, lng, options.source || 'Map selection');
      }
    }

    function applyDeviceLocation(pos, options) {
      const lat = Number(pos && pos.coords && pos.coords.latitude);
      const lng = Number(pos && pos.coords && pos.coords.longitude);
      if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
      if (leafletMap && leafletMarker) {
        setCustomerMapLocation(lat, lng, options);
        return;
      }
      updateMapSelectionDetails(lat, lng, '', options && options.source);
      calcTransportFare(lat, lng);
      reverseGeocodeDeliveryPoint(lat, lng, options && options.source);
      focusCheckoutControl('#checkoutCalendarContainer', 650);
    }

    function initMap() {
      const mapEl = document.getElementById('wizardMap');
      if (!mapEl) return;
      if (typeof L === 'undefined') {
        mapEl.classList.add('map-unavailable-state');
        mapEl.innerHTML = '<div><i class="bi bi-map d-block fs-3 mb-2"></i>The interactive map could not load.<br>Search for your full address above to continue.</div>';
        showMapAccessNotice('Map tiles are unavailable, but address search still works and will calculate your delivery route.', 'info');
        return;
      }
      mapEl.classList.remove('map-unavailable-state');
      mapEl.innerHTML = '';
      const savedLat = parseFloat(document.getElementById('wizardLat').value);
      const savedLng = parseFloat(document.getElementById('wizardLng').value);
      const hasSavedLocation = Number.isFinite(savedLat) && Number.isFinite(savedLng);
      const defaultBase = window._companyBaseLocation || { lat: 14.676049, lng: 121.043731 };
      const defaultLat = hasSavedLocation ? savedLat : Number(defaultBase.lat) || 14.676049;
      const defaultLng = hasSavedLocation ? savedLng : Number(defaultBase.lng) || 121.043731;

      if (leafletMap) leafletMap.remove();
      leafletMap = null; leafletMarker = null;
      window._routeLayer = null; window._companyMarker = null;

      try {
        leafletMap = L.map('wizardMap', { zoomControl:false, scrollWheelZoom:false, preferCanvas:true }).setView([defaultLat, defaultLng], hasSavedLocation ? 16 : 13);
      } catch (error) {
        console.warn('Checkout map initialization failed:', error);
        mapEl.classList.add('map-unavailable-state');
        mapEl.innerHTML = '<div><i class="bi bi-map d-block fs-3 mb-2"></i>The interactive map could not start.<br>Search for your full address above to continue.</div>';
        showMapAccessNotice('The interactive map is unavailable. Select an address search result to continue.', 'info');
        return;
      }
      L.control.zoom({ position:'bottomright' }).addTo(leafletMap);
      L.control.scale({ position:'bottomleft', imperial:false, maxWidth:120 }).addTo(leafletMap);

      _streetMapLayer = window.createEsriHybridLayer().addTo(leafletMap);

      const customPinIcon = L.divIcon({ className:'custom-map-pin', iconSize:[40,40], iconAnchor:[20,40], popupAnchor:[0,-38], html:'<div class="pin-body"></div>' });
      leafletMarker = L.marker([defaultLat, defaultLng], { icon:customPinIcon, draggable:true, keyboard:true, title:'Delivery location' }).addTo(leafletMap);
      leafletMarker.setOpacity(hasSavedLocation ? 1 : 0);
      leafletMarker.bindTooltip('Delivery location', { direction:'top', offset:[0,-34] });

      window._companyBaseLocationPromise.then(function(base) {
        if (!base || !Number(base.lat) || !Number(base.lng) || !leafletMap) return;
        const companyIcon = L.divIcon({ className:'custom-map-pin tech-pin', iconSize:[40,40], iconAnchor:[20,40], popupAnchor:[0,-38], html:'<div class="pin-body bg-primary border-primary"><i class="bi bi-building text-white" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(45deg);"></i></div>' });
        window._companyMarker = L.marker([Number(base.lat),Number(base.lng)], { icon:companyIcon, zIndexOffset:-100, keyboard:true, title:'CALIDRO RACS' }).addTo(leafletMap);
        window._companyMarker.bindTooltip('CALIDRO RACS', { direction:'top', offset:[0,-34] });
        window._companyMarker.bindPopup('<strong style="color:#1d4ed8;">CALIDRO RACS</strong><br>' + escapeMapText(base.address || 'Company location') + '<br><small>Delivery route starting point</small>');
        if (!_customerLocationSelected && !hasSavedLocation) leafletMap.setView([Number(base.lat),Number(base.lng)], 14);
      });

      leafletMarker.on('dragend', function() {
        const pos = leafletMarker.getLatLng();
        setCustomerMapLocation(pos.lat, pos.lng, { source:'Dragged delivery pin', zoom:false });
      });
      leafletMap.on('click', function(e) {
        setCustomerMapLocation(e.latlng.lat, e.latlng.lng, { source:'Point selected on map', zoom:false });
        focusCheckoutControl('#checkoutCalendarContainer', 650);
      });

      if (hasSavedLocation) {
        const savedAddress = document.getElementById('wizardAddress').value.trim();
        updateMapSelectionDetails(savedLat, savedLng, savedAddress, 'Saved checkout location');
        calcTransportFare(savedLat, savedLng);
      }
      setTimeout(function() { if (leafletMap) leafletMap.invalidateSize(); }, 180);
    }

    window.locateMe = function() {
      if (!window.isSecureContext && window.location.hostname !== 'localhost') {
        showMapAccessNotice('Automatic location requires HTTPS. Search for your address or tap the map instead.');
        focusManualAddress();
        return;
      }
      if (!navigator.geolocation) {
        showMapAccessNotice('Automatic location is unavailable in this browser. Search for your address or tap the map instead.');
        focusManualAddress();
        return;
      }
      const spinner = document.getElementById('mapLocatingSpinner');
      const spinnerLabel = document.getElementById('mapSpinnerLabel');
      if (spinnerLabel) spinnerLabel.textContent = 'Locating your device...';
      if (spinner) spinner.classList.add('show');
      navigator.geolocation.getCurrentPosition(function(pos) {
        applyDeviceLocation(pos, {
          source: pos.coords.accuracy ? 'Device GPS · ±' + Math.round(pos.coords.accuracy) + ' m' : 'Device GPS',
          zoom:17
        });
        focusCheckoutControl('#checkoutCalendarContainer', 650);
      }, function(error) {
        if (spinner) spinner.classList.remove('show');
        var message = error && error.code === 1
          ? 'Location access is blocked in your browser settings. Search for your address or select the point on the map instead.'
          : 'We could not read your location. Search for your address or select the point on the map instead.';
        showMapAccessNotice(message);
        focusManualAddress();
      }, { enableHighAccuracy:false, timeout:10000, maximumAge:300000 });
    };

    window.fitDeliveryRoute = function() {
      if (!leafletMap) return;
      if (window._routeLayer && window._routeLayer.getBounds && window._routeLayer.getBounds().isValid()) {
        leafletMap.fitBounds(window._routeLayer.getBounds(), { padding:[45,45] });
        return;
      }
      window._companyBaseLocationPromise.then(function(base) {
        if (_customerLocationSelected && base && Number(base.lat) && Number(base.lng)) {
          leafletMap.fitBounds([[Number(base.lat),Number(base.lng)],[_lastCustomerLat,_lastCustomerLng]], { padding:[45,45] });
        } else if (base && Number(base.lat) && Number(base.lng)) {
          leafletMap.setView([Number(base.lat),Number(base.lng)], 14);
        }
      });
    };

    window.toggleCheckoutMapSize = function() {
      var card = document.getElementById('checkoutMapCard');
      var button = document.getElementById('expandMapBtn');
      if (!card) return;
      var expanded = card.classList.toggle('map-expanded');
      if (button) button.innerHTML = expanded ? '<i class="bi bi-fullscreen-exit"></i><span>Collapse</span>' : '<i class="bi bi-fullscreen"></i><span>Expand</span>';
      setTimeout(function() { if (leafletMap) leafletMap.invalidateSize(); }, 280);
    };

    // Address Search
    const addrInput = document.getElementById('wizardAddress');
    const suggestBox = document.getElementById('addressSuggestions');
    const searchBtn = document.getElementById('searchAddressBtn');

    if (addrInput) {
      addrInput.addEventListener('input', function () {
        clearTimeout(addressSearchTimeout);
        const q = this.value.trim();
        const preview = document.getElementById('mapAddressPreview');
        if (_customerLocationSelected && preview && q) preview.textContent = q;
        if (q.length < 3) { suggestBox.style.display = 'none'; return; }
        addressSearchTimeout = setTimeout(() => searchAddress(q), 500);
      });
      addrInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); searchAddress(addrInput.value); } });
    }
    if (searchBtn) { searchBtn.onclick = () => searchAddress(addrInput.value); }

    async function searchAddress(q) {
      if (!q) return;
      if (searchBtn) {
        searchBtn.disabled = true;
        searchBtn.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>';
      }
      try {
        const res = await fetch(`/api/services/geocode-suggest?q=${encodeURIComponent(q)}`);
        const data = await res.json();
        if (data.suggestions && data.suggestions.length > 0) {
          suggestBox.innerHTML = '';
          data.suggestions.forEach(function(suggestion) {
            var button = document.createElement('button');
            button.type = 'button';
            button.className = 'list-group-item list-group-item-action border-0 py-2 small text-start d-flex align-items-start gap-2';
            var icon = document.createElement('i');
            icon.className = 'bi bi-geo-alt-fill text-primary mt-1';
            var text = document.createElement('span');
            text.textContent = suggestion.display_name;
            button.appendChild(icon);
            button.appendChild(text);
            button.addEventListener('click', function() { selectSuggestion(suggestion.lat, suggestion.lon, suggestion.display_name); });
            suggestBox.appendChild(button);
          });
          suggestBox.style.display = 'block';
        } else {
          suggestBox.innerHTML = '<div class="list-group-item border-0 py-3 small text-secondary"><i class="bi bi-search me-2"></i>No matching address found. Add a municipality or province.</div>';
          suggestBox.style.display = 'block';
        }
      } catch (e) {
        suggestBox.innerHTML = '<div class="list-group-item border-0 py-3 small text-danger"><i class="bi bi-wifi-off me-2"></i>Address search is temporarily unavailable. Select the location on the map.</div>';
        suggestBox.style.display = 'block';
      } finally {
        if (searchBtn) {
          searchBtn.disabled = false;
          searchBtn.innerHTML = '<i class="bi bi-search"></i>';
        }
      }
    }

    window.selectSuggestion = function (lat, lon, name) {
      addrInput.value = name;
      suggestBox.style.display = 'none';
      const flat = parseFloat(lat); const flon = parseFloat(lon);
      if (leafletMap && leafletMarker) {
        setCustomerMapLocation(flat, flon, { address:name, source:'Address search result', zoom:16, reverseGeocode:false });
      } else {
        updateMapSelectionDetails(flat, flon, name, 'Address search result');
        calcTransportFare(flat, flon);
      }
      focusCheckoutControl('#checkoutCalendarContainer', 550);
    }

    document.addEventListener('click', (e) => { if (suggestBox && !suggestBox.contains(e.target) && e.target !== addrInput) { suggestBox.style.display = 'none'; } });

    async function showCartOrderFailure(data, status, loadingStartedAt) {
      await waitForOrderLoadingMinimum(loadingStartedAt, 450);
      const loadingElement = document.getElementById('orderLoadingModal');
      await hideModalBeforeLoading(loadingElement, bootstrap.Modal.getInstance(loadingElement));
      const checkoutElement = document.getElementById('checkoutOrderModal');
      const checkoutInstance = bootstrap.Modal.getOrCreateInstance(checkoutElement);
      await new Promise(resolve => {
        if (checkoutElement.classList.contains('show')) return resolve();
        checkoutElement.addEventListener('shown.bs.modal', resolve, { once: true });
        checkoutInstance.show();
        setTimeout(resolve, 600);
      });
      const issue = window.OrderCheckoutErrors?.issueFor(data, 'cart');
      console.warn('Order checkout rejected', { status, code: data?.code || 'UNKNOWN' });
      if (data?.code === 'ORDER_CHECKOUT_REQUEST_ID_INVALID') _checkoutRequestId = createCheckoutRequestId();
      if (issue) await presentCheckoutStepIssue(issue);
      else await Swal.fire('Could not place your order', data?.error || 'Please check your details and try again.', 'error');
    }

    async function submitCartOrder() {
      if (_checkoutSubmitting) return;
      _checkoutSubmitting = true;
      const nextBtn = document.getElementById('wizardNextBtn');
      nextBtn.disabled = true;
      nextBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';

      // Show the van loading modal
      const checkoutModalElement = document.getElementById('checkoutOrderModal');
      const checkoutModal = bootstrap.Modal.getInstance(checkoutModalElement);
      await hideModalBeforeLoading(checkoutModalElement, checkoutModal);
      const loadingModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('orderLoadingModal'));
      const loadingStartedAt = Date.now();
      loadingModal.show();

      const orderItems = CART_ITEMS.map(it => ({
        inventoryId: it.inventoryId._id || it.inventoryId,
        quantity: it.quantity
      }));

      const payMethod = document.getElementById('wizardPaymentMethod').value;
      const needsGcashProof = payMethod === 'gcash_full' || payMethod === 'cod';

      // Build delivery / pickup data
      let deliveryData = null;
      if (selectedFulfillment !== 'customer_pickup') {
        deliveryData = {
          address: document.getElementById('wizardAddress').value.trim(),
          contactNumber: document.getElementById('wizardContact').value.trim(),
          preferredDate: document.getElementById('wizardDate').value,
          notes: document.getElementById('wizardNotes').value.trim(),
          coordinates: {
            lat: parseFloat(document.getElementById('wizardLat').value) || 0,
            lng: parseFloat(document.getElementById('wizardLng').value) || 0,
          }
        };
      }

      // Use FormData so we can attach the GCash receipt image
      const fd = new FormData();
      fd.append('items', JSON.stringify(orderItems));
      fd.append('fulfillmentType', selectedFulfillment);
      fd.append('paymentMethod', payMethod);
      fd.append('checkoutRequestId', _checkoutRequestId || (_checkoutRequestId = createCheckoutRequestId()));
      fd.append('technicianId', '');
      fd.append('timeSlot', document.getElementById('wizardTimeSlot')?.value || '');

      if (deliveryData) {
        fd.append('delivery', JSON.stringify(deliveryData));
      }
      if (selectedFulfillment === 'customer_pickup') {
        fd.append('pickupDate', document.getElementById('wizardPickupDate').value);
      }

      if (needsGcashProof) {
        const paymentChannel = document.getElementById('wizardPaymentChannel')?.value || '';
        const paymentReference = document.getElementById('wizardGcashSenderNumber')?.value.trim() || '';
        fd.append('paymentChannel', paymentChannel);
        fd.append('paymentReference', paymentReference);
        fd.append('gcashNumber', paymentChannel === 'gcash' ? paymentReference : '');
        const proofFile = document.getElementById('gcashProofWizard')?.files[0];
        if (proofFile) fd.append('gcashProof', proofFile);
      }

      try {
        const res = await fetch('/api/orders', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json' },
          body: fd  // No Content-Type header — browser sets multipart boundary automatically
        });
        const data = await res.json();

        if (!res.ok) {
          await showCartOrderFailure(data, res.status, loadingStartedAt);
          nextBtn.disabled = false;
          nextBtn.innerHTML = '<i class="bi bi-bag-check me-2"></i>Place Order';
          _checkoutSubmitting = false;
          return;
        }

        // Order success - clear cart
        await fetch('/api/aircon-cart/clear', { method: 'POST' });
        clearCartCheckoutDraft();
        // Keep the loader visible long enough to communicate progress even
        // when localhost responds almost immediately.
        await waitForOrderLoadingMinimum(loadingStartedAt, 900);

        // Hide loading modal and show success in checkout modal
        const loadingModalInstance = bootstrap.Modal.getInstance(document.getElementById('orderLoadingModal'));
        if (loadingModalInstance) loadingModalInstance.hide();

        // Show the checkout modal again with success content
        const successModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('checkoutOrderModal'));

        const modalBody = document.querySelector('#checkoutOrderModal .modal-body');
        modalBody.innerHTML = `
        <div class="text-center py-5" style="animation: fadeSlideUp 0.4s ease;">
          <div style="font-size: 4rem; color: #10b981; margin-bottom: 1rem;"><i class="bi bi-check-circle-fill"></i></div>
          <h4 class="fw-bold" style="color: #0a1628;">Order Placed!</h4>
          <p style="color: #64748b;">Your order reference is:</p>
          <div class="d-inline-block px-4 py-2 rounded-pill fw-bold mb-4" style="background: #f0fdf4; color: #059669; font-size: 1.25rem; letter-spacing: 1px;">
            ${escapeCheckoutHtml(data.order.orderReference)}
          </div>
          <p class="small text-muted mb-0">Check <a href="/my-orders" class="text-primary fw-bold text-decoration-none">My Orders</a> to track status.</p>
        </div>
      `;
        document.querySelector('#checkoutOrderModal .modal-footer').innerHTML = `
        <a href="/my-orders" class="btn btn-primary px-4 shadow-sm mx-auto" style="border-radius: 50px;">View My Orders</a>
      `;
        // Hide wizard progress on success
        const wizardProgress = document.getElementById('wizardProgress');
        if (wizardProgress) wizardProgress.style.display = 'none';
        _checkoutRequestId = '';

        successModal.show();
      } catch (e) {
        await showCartOrderFailure({ error: 'We could not connect. Your details are still here. Please try again.' }, 0, loadingStartedAt);
        nextBtn.disabled = false;
        nextBtn.innerHTML = '<i class="bi bi-bag-check me-2"></i>Place Order';
        _checkoutSubmitting = false;
      }
    }

    const cartCheckoutModalElement = document.getElementById('checkoutOrderModal');
    if (cartCheckoutModalElement) {
      const persistChangedCheckoutField = event => {
        if (event.target?.closest('#checkoutOrderModal')) scheduleCartCheckoutDraftSave();
      };
      cartCheckoutModalElement.addEventListener('input', persistChangedCheckoutField);
      cartCheckoutModalElement.addEventListener('change', persistChangedCheckoutField);
    }

    function reopenSavedCartCheckout() {
      const draft = readCartCheckoutDraft();
      const modal = document.getElementById('checkoutOrderModal');
      if (!draft || !modal || modal.classList.contains('show') || _checkoutSubmitting) return;
      window.openCheckoutWizard();
    }

    window.addEventListener('pagehide', saveCartCheckoutDraft);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') saveCartCheckoutDraft();
    });
    window.addEventListener('pageshow', () => setTimeout(reopenSavedCartCheckout, 80));
  })();
</script>
