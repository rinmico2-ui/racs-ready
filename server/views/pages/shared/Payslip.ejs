<%
  const peso = (value) => `₱${Number(value || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const date = (value, includeTime = false) => {
    if (!value) return '—';
    const options = includeTime
      ? { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }
      : { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', year: 'numeric' };
    return new Date(value).toLocaleString('en-PH', options);
  };
  const person = (value) => {
    if (!value) return '—';
    return [value.firstName, value.lastName].filter(Boolean).join(' ') || '—';
  };
  const employee = record.employee || {};
  const attendance = record.attendanceSummary || {};
  const allowances = record.allowances || [];
  const deductions = record.deductions || [];
  const statusLabel = String(record.status || '').charAt(0).toUpperCase() + String(record.status || '').slice(1);
  const roleLabel = String(employee.role || record.employeeRole || '').charAt(0).toUpperCase() + String(employee.role || record.employeeRole || '').slice(1);
%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, noarchive, nosnippet">
  <title>Payslip <%= payslipNumber %></title>
  <style>
    :root { color-scheme: light; --ink:#0f172a; --muted:#64748b; --line:#dbe3ee; --blue:#2563eb; --green:#047857; --paper:#fff; }
    * { box-sizing: border-box; }
    body { margin:0; background:#e8edf4; color:var(--ink); font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:1.45; }
    .toolbar { position:sticky; top:0; z-index:5; display:flex; justify-content:space-between; align-items:center; gap:12px; padding:12px max(16px, calc((100% - 794px) / 2)); background:#0f172a; color:#fff; }
    .toolbar-note { font-size:12px; color:#cbd5e1; }
    .toolbar-actions { display:flex; gap:8px; }
    .button { appearance:none; border:1px solid rgba(255,255,255,.25); border-radius:8px; background:transparent; color:#fff; padding:9px 13px; font:600 12px Arial, sans-serif; cursor:pointer; text-decoration:none; }
    .button.primary { background:#2563eb; border-color:#2563eb; }
    .sheet { position:relative; width:210mm; min-height:297mm; margin:24px auto; padding:16mm 17mm; background:var(--paper); box-shadow:0 16px 45px rgba(15,23,42,.15); overflow:hidden; }
    .watermark { display:none; position:absolute; inset:40% -10%; transform:rotate(-24deg); text-align:center; color:rgba(220,38,38,.10); font-size:82px; font-weight:900; letter-spacing:10px; pointer-events:none; }
    .sheet.voided .watermark { display:block; }
    .header { display:flex; justify-content:space-between; align-items:flex-start; gap:24px; padding-bottom:18px; border-bottom:3px solid var(--ink); }
    .company-name { font-size:21px; font-weight:800; letter-spacing:-.3px; }
    .company-details { margin-top:5px; color:var(--muted); font-size:11px; }
    .document-title { text-align:right; }
    .document-title h1 { margin:0; font-size:27px; letter-spacing:2px; }
    .document-number { margin-top:4px; color:var(--muted); font-weight:700; }
    .status { display:inline-block; margin-top:8px; padding:4px 10px; border-radius:999px; background:#dbeafe; color:#1d4ed8; font-weight:700; text-transform:uppercase; font-size:10px; letter-spacing:.6px; }
    .status.paid { background:#d1fae5; color:#047857; }
    .status.voided { background:#fee2e2; color:#b91c1c; }
    .section { margin-top:20px; }
    .section-title { margin:0 0 8px; color:#475569; font-size:10px; font-weight:800; letter-spacing:1px; text-transform:uppercase; }
    .info-grid { display:grid; grid-template-columns:repeat(4, 1fr); border:1px solid var(--line); border-radius:8px; overflow:hidden; }
    .info { min-height:54px; padding:9px 11px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); }
    .info:nth-child(4n) { border-right:0; }
    .info:nth-last-child(-n+4) { border-bottom:0; }
    .label { display:block; color:var(--muted); font-size:9px; font-weight:700; letter-spacing:.5px; text-transform:uppercase; }
    .value { display:block; margin-top:3px; font-weight:700; overflow-wrap:anywhere; }
    .summary-grid { display:grid; grid-template-columns:repeat(6,1fr); gap:7px; }
    .summary { padding:9px 4px; border:1px solid var(--line); border-radius:7px; text-align:center; background:#f8fafc; }
    .summary strong { display:block; font-size:15px; }
    .summary span { color:var(--muted); font-size:8px; font-weight:700; text-transform:uppercase; }
    .columns { display:grid; grid-template-columns:1fr 1fr; gap:18px; align-items:start; }
    table { width:100%; border-collapse:collapse; }
    th, td { padding:7px 8px; border-bottom:1px solid var(--line); text-align:left; }
    th { background:#f8fafc; color:#475569; font-size:9px; text-transform:uppercase; letter-spacing:.5px; }
    td:last-child, th:last-child { text-align:right; white-space:nowrap; }
    .subtotal td { border-top:2px solid #cbd5e1; font-weight:800; }
    .deduction { color:#b91c1c; }
    .net { display:flex; justify-content:space-between; align-items:center; margin-top:18px; padding:15px 17px; border-radius:9px; background:#0f172a; color:#fff; }
    .net span { font-size:12px; font-weight:700; letter-spacing:.8px; text-transform:uppercase; }
    .net strong { font-size:24px; }
    .payment { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; padding:12px; border:1px solid #a7f3d0; border-radius:8px; background:#f0fdf4; }
    .payment.pending { border-color:#bfdbfe; background:#eff6ff; }
    .notes { padding:10px 12px; border-left:3px solid #f59e0b; background:#fffbeb; white-space:pre-wrap; overflow-wrap:anywhere; }
    .signatures { display:grid; grid-template-columns:1fr 1fr; gap:45px; margin-top:38px; }
    .signature { padding-top:7px; border-top:1px solid #64748b; text-align:center; }
    .signature strong { display:block; }
    .signature small { color:var(--muted); }
    .footer { margin-top:24px; padding-top:10px; border-top:1px solid var(--line); display:flex; justify-content:space-between; gap:16px; color:var(--muted); font-size:9px; }
    @page { size:A4; margin:12mm; }
    @media print {
      body { background:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
      .toolbar { display:none !important; }
      .sheet { width:auto; min-height:0; margin:0; padding:0; box-shadow:none; overflow:visible; }
    }
    @media (max-width: 820px) {
      .toolbar { padding:10px 12px; }
      .toolbar-note { display:none; }
      .sheet { width:calc(100% - 20px); min-height:0; margin:10px; padding:22px 18px; }
      .header { flex-direction:column; }
      .document-title { text-align:left; }
      .info-grid { grid-template-columns:1fr 1fr; }
      .info:nth-child(4n) { border-right:1px solid var(--line); }
      .info:nth-child(2n) { border-right:0; }
      .info:nth-last-child(-n+4) { border-bottom:1px solid var(--line); }
      .info:nth-last-child(-n+2) { border-bottom:0; }
      .summary-grid { grid-template-columns:repeat(3,1fr); }
      .columns, .signatures { grid-template-columns:1fr; gap:18px; }
      .payment { grid-template-columns:1fr 1fr; }
      .footer { flex-direction:column; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <div class="toolbar-note">Confidential payroll document</div>
    <div class="toolbar-actions">
      <button type="button" class="button" onclick="history.back()">Back</button>
      <button type="button" class="button primary" onclick="window.print()">Print / Save PDF</button>
    </div>
  </div>

  <main class="sheet <%= record.status === 'voided' ? 'voided' : '' %>">
    <div class="watermark">VOIDED</div>
    <header class="header">
      <div>
        <div class="company-name"><%= company.name %></div>
        <div class="company-details">
          <div><%= company.address %></div>
          <% if (company.phone || company.email) { %><div><%= [company.phone, company.email].filter(Boolean).join(' · ') %></div><% } %>
        </div>
      </div>
      <div class="document-title">
        <h1>PAYSLIP</h1>
        <div class="document-number"><%= payslipNumber %> · Version <%= record.payslipVersion || 1 %></div>
        <span class="status <%= record.status %>"><%= statusLabel %></span>
      </div>
    </header>

    <section class="section">
      <h2 class="section-title">Employee and pay period</h2>
      <div class="info-grid">
        <div class="info"><span class="label">Employee</span><span class="value"><%= person(employee) %></span></div>
        <div class="info"><span class="label">Role</span><span class="value"><%= roleLabel %></span></div>
        <div class="info"><span class="label">Period start</span><span class="value"><%= date(record.periodStart) %></span></div>
        <div class="info"><span class="label">Period end</span><span class="value"><%= date(record.periodEnd) %></span></div>
        <div class="info"><span class="label">Email</span><span class="value"><%= employee.email || '—' %></span></div>
        <div class="info"><span class="label">Pay type / rate</span><span class="value"><%= record.payType ? `${record.payType} · ${peso(record.baseRate)}` : '—' %></span></div>
        <div class="info"><span class="label">Scheduled pay date</span><span class="value"><%= date(record.payDate) %></span></div>
        <div class="info"><span class="label">Issued</span><span class="value"><%= date(record.payslipIssuedAt || record.approvedAt, true) %></span></div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Attendance summary</h2>
      <div class="summary-grid">
        <div class="summary"><strong><%= attendance.present || 0 %></strong><span>Present</span></div>
        <div class="summary"><strong><%= attendance.late || 0 %></strong><span>Late</span></div>
        <div class="summary"><strong><%= attendance.absent || 0 %></strong><span>Absent</span></div>
        <div class="summary"><strong><%= attendance.onLeave || 0 %></strong><span>Leave</span></div>
        <div class="summary"><strong><%= attendance.sickLeave || 0 %></strong><span>Sick leave</span></div>
        <div class="summary"><strong><%= Number(attendance.hoursWorked || 0).toLocaleString('en-PH') %></strong><span>Hours</span></div>
      </div>
    </section>

    <section class="section columns">
      <div>
        <h2 class="section-title">Earnings</h2>
        <table aria-label="Earnings">
          <thead><tr><th>Description</th><th>Amount</th></tr></thead>
          <tbody>
            <tr><td>Basic pay</td><td><%= peso(record.basicPay) %></td></tr>
            <tr><td>Overtime pay (<%= Number(record.overtimeHours || 0) %> hrs)</td><td><%= peso(record.overtimePay) %></td></tr>
            <% allowances.forEach((item) => { %><tr><td><%= item.name %></td><td><%= peso(item.amount) %></td></tr><% }); %>
            <tr class="subtotal"><td>Gross pay</td><td><%= peso(record.grossPay) %></td></tr>
          </tbody>
        </table>
      </div>
      <div>
        <h2 class="section-title">Deductions</h2>
        <table aria-label="Deductions">
          <thead><tr><th>Description</th><th>Amount</th></tr></thead>
          <tbody>
            <% if (!deductions.length) { %><tr><td>No deductions</td><td>₱0.00</td></tr><% } %>
            <% deductions.forEach((item) => { %><tr><td><%= item.name %></td><td class="deduction">−<%= peso(item.amount) %></td></tr><% }); %>
            <tr class="subtotal"><td>Total deductions</td><td class="deduction">−<%= peso(record.totalDeductions) %></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <div class="net"><span>Net pay</span><strong><%= peso(record.netPay) %></strong></div>

    <section class="section">
      <h2 class="section-title">Payment information</h2>
      <% if (record.status === 'paid') { %>
        <div class="payment">
          <div><span class="label">Method</span><span class="value"><%= String(record.paymentMethod || '—').replace('_', ' ') %></span></div>
          <div><span class="label">Payment date</span><span class="value"><%= date(record.paymentDate || record.paidAt) %></span></div>
          <div><span class="label">Reference</span><span class="value"><%= record.paymentReference || '—' %></span></div>
        </div>
      <% } else { %>
        <div class="payment pending"><div><span class="label">Payment status</span><span class="value"><%= record.status === 'voided' ? 'This payslip has been voided' : 'Approved — awaiting payment' %></span></div></div>
      <% } %>
    </section>

    <% if (record.notes) { %><section class="section"><h2 class="section-title">Notes</h2><div class="notes"><%= record.notes %></div></section><% } %>

    <div class="signatures">
      <div class="signature"><strong><%= person(record.approvedBy) %></strong><small>Approved by · <%= date(record.approvedAt, true) %></small></div>
      <div class="signature"><strong><%= person(employee) %></strong><small>Employee</small></div>
    </div>

    <footer class="footer">
      <span>Confidential: intended only for the named employee and authorized payroll administrators.</span>
      <span>Calculation v<%= record.calculationVersion || 1 %> · Payslip v<%= record.payslipVersion || 1 %></span>
    </footer>
  </main>
</body>
</html>
