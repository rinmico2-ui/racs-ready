    var wtCompleted = SA.weeklyData.map(function(d) { return d.completed; });
    var wtChartCfg = { type: "line", data: { labels: wtLabels, datasets: [{ label: "Bookings", data: wtBookings, borderColor: "#06b6d4", backgroundColor: g8a, borderWidth: 2.5, tension: 0.4, fill: true, pointBackgroundColor: "#fff", pointBorderColor: "#06b6d4", pointBorderWidth: 2, pointRadius: 4, pointHoverRadius: 6 }, { label: "Completed", data: wtCompleted, borderColor: "#8b5cf6", backgroundColor: g8b, borderWidth: 2.5, tension: 0.4, fill: true, pointBackgroundColor: "#fff", pointBorderColor: "#8b5cf6", pointBorderWidth: 2, pointRadius: 4, pointHoverRadius: 6 }] }, options: { responsive: true, maintainAspectRatio: false, animation: { duration: 1200 }, interaction: { mode: 'index', intersect: false }, plugins: { legend: { position: 'top', align: 'end', labels: { usePointStyle: true, boxWidth: 8, padding: 16 } }, tooltip: { backgroundColor: '#0f172a', padding: 12, cornerRadius: 8 } }, scales: { x: { grid: { display: false }, ticks: { color: '#94a3b8' }, border: { display: false } }, y: { grid: { color: '#f1f5f9' }, ticks: { color: '#94a3b8' }, border: { display: false } } } } };
