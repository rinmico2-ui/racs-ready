      <h6><i class="bi bi-list-ul me-1" style="color:#ef4444;"></i>Cancellation Reasons Breakdown</h6>
    </div>
    <div class="dash-card-body">
      <% if (analytics && analytics.cancellationReasonsArray && analytics.cancellationReasonsArray.length > 0) { %>
        <div class="table-responsive">
          <table class="table-dash">
            <thead>
              <tr>
                <th>Reason</th>
                <th style="text-align:center;">Count</th>
                <th style="text-align:center;">% of Cancelled</th>
                <th>Distribution</th>
              </tr>
            </thead>
            <tbody>
              <% analytics.cancellationReasonsArray.forEach(function(r) { %>
                <tr>
                  <td style="font-weight:600;"><%= r.reason %></td>
                  <td style="text-align:center;"><%= r.count %></td>
                  <td style="text-align:center;"><%= Math.round((r.count / (analytics.cancelledBookings || 1)) * 100) %>%</td>
                  <td>
                    <div class="pipeline-bar" style="width:120px;">
                      <div class="pipeline-bar-fill" style="width:<%= Math.round((r.count / (analytics.cancelledBookings || 1)) * 100) %>%;background:#ef4444;"></div>
