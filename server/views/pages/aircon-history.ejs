<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aircon Order History - HVAC Solutions</title>
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  
  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --bg-gradient: linear-gradient(160deg, #0a1628 0%, #0f2b5e 45%, #1a4fd8 100%);
    }

    body {
      background: #f1f5f9;
      font-family: 'Inter', system-ui, sans-serif;
    }

    .hero-header {
      background: var(--bg-gradient);
      padding: 4rem 0 6rem;
      color: white;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .card-order {
      background: #fff;
      border: 1px solid rgba(0,0,0,0.05);
      border-radius: 1.25rem;
      margin-top: -2rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      margin-bottom: 2rem;
      overflow: hidden;
    }

    .header-order {
      padding: 1.25rem 1.5rem;
      background: #f8fafc;
      border-bottom: 1px solid #f1f5f9;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .status-badge {
      padding: 0.4rem 0.8rem;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .status-pending_payment { background: #fef3c7; color: #92400e; }
    .status-preparing_unit { background: #dbeafe; color: #1e40af; }
    .status-technician_assigned { background: #f3e8ff; color: #6b21a8; }
    .status-out_for_delivery { background: #ffedd5; color: #9a3412; }
    .status-completed { background: #dcfce7; color: #166534; }
    .status-cancelled { background: #fee2e2; color: #991b1b; }

    .item-row {
      display: flex;
      gap: 1.25rem;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid #f8fafc;
    }
    .item-img {
      width: 70px;
      height: 70px;
      object-fit: contain;
      background: #f1f5f9;
      border-radius: 0.75rem;
      padding: 0.5rem;
    }

    .details-box {
      background: #f8fafc;
      padding: 1rem;
      border-radius: 1rem;
      margin: 1.5rem;
      font-size: 0.875rem;
    }

    .btn-track {
      background: var(--primary);
      color: white;
      border: none;
      padding: 0.6rem 1.2rem;
      border-radius: 50px;
      font-weight: 600;
      font-size: 0.85rem;
      transition: all 0.2s;
    }
    .btn-track:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(37,99,235,0.2);
      color: white;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <%- include('../partials/navbar') %>

  <!-- Hero Header -->
  <header class="hero-header">
    <div class="container">
      <h1 class="display-5 fw-bold mb-2">My Aircon Orders</h1>
      <p class="fs-5 opacity-75">Track your purchases and installation schedules.</p>
    </div>
  </header>

  <main class="container py-4">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <% if (!orders || orders.length === 0) { %>
          <div class="card-order p-5 text-center">
            <i class="bi bi-box-seam display-1 text-muted mb-3 opacity-25"></i>
            <h3 class="fw-bold">No orders found</h3>
            <p class="text-muted">You haven't placed any aircon orders yet.</p>
            <a href="/aircons" class="btn btn-primary rounded-pill px-4 mt-2">Start Shopping</a>
          </div>
        <% } else { %>
          <% orders.forEach(order => { %>
            <div class="card-order">
              <div class="header-order">
                <div>
                  <div class="fw-bold text-primary mb-1">Order #<%= order.orderReference || order._id.toString().slice(-8).toUpperCase() %></div>
                  <div class="small text-muted"><%= new Date(order.createdAt).toLocaleDateString(undefined, { dateStyle: 'long' }) %></div>
                </div>
                <div class="text-end">
                  <div class="status-badge status-<%= order.status %> mb-2"><%= order.status.replace(/_/g, ' ') %></div>
                  <% if (order.status === 'out_for_delivery' || order.status === 'installing') { %>
                    <a href="/tracking/<%= order._id %>" class="btn btn-track d-block">
                      <i class="bi bi-geo-alt-fill me-1"></i>Track Order
                    </a>
                  <% } %>
                </div>
              </div>

              <!-- Items -->
              <div class="p-0">
                <% (order.items || []).forEach(item => { %>
                  <div class="item-row">
                    <img src="<%= item.imageUrl || '/images/products/default.png' %>" class="item-img" alt="Product">
                    <div class="flex-grow-1">
                      <div class="fw-bold"><%= item.modelLine || 'Aircon Unit' %></div>
                      <div class="small text-muted"><%= item.capacity %> <%= item.capacityUnit %> · Qty: <%= item.quantity %></div>
                    </div>
                    <div class="text-end fw-bold">₱<%= (item.price * item.quantity).toLocaleString() %></div>
                  </div>
                <% }) %>
              </div>

              <!-- Logistics Info -->
              <div class="details-box">
                <div class="row g-3">
                  <div class="col-sm-6">
                    <div class="small text-muted text-uppercase fw-bold mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">Fulfillment</div>
                    <div class="fw-medium"><%= order.fulfillmentType.replace(/_/g, ' ') %></div>
                  </div>
                  <% if (order.delivery && order.delivery.preferredDate) { %>
                    <div class="col-sm-6">
                      <div class="small text-muted text-uppercase fw-bold mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">Scheduled Date</div>
                      <div class="fw-medium">
                        <i class="bi bi-calendar3 me-1"></i><%= new Date(order.delivery.preferredDate).toLocaleDateString() %>
                        <% if (order.timeSlot) { %> · <i class="bi bi-clock ms-1"></i> <%= order.timeSlot %><% } %>
                      </div>
                    </div>
                  <% } %>
                  <% if (order.technician && order.technician.name) { %>
                    <div class="col-sm-12 border-top mt-2 pt-2">
                        <div class="small text-muted text-uppercase fw-bold mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">Assigned Technician</div>
                        <div class="fw-bold text-purple-700">
                          <i class="bi bi-person-badge-fill me-2"></i><%= order.technician.name %>
                          <% if (order.technician.phone) { %><span class="text-muted fw-normal ms-2">· <%= order.technician.phone %></span><% } %>
                        </div>
                    </div>
                  <% } %>
                </div>
              </div>

              <!-- Footer -->
              <div class="px-4 py-3 bg-light border-top d-flex justify-content-between align-items-center">
                <span class="text-muted small">Paid via <strong><%= order.paymentMethod.toUpperCase() %></strong></span>
                <div class="fs-5 fw-bold">Total: <span class="text-primary">₱<%= (order.totalAmount || 0).toLocaleString() %></span></div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
