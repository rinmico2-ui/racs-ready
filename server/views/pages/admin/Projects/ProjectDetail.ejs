        purchaseModal.innerHTML=`<div class="pw-modal" style="max-width:560px;"><h5 style="font-weight:800;">${item.type==='equipment'?'RENT / ACQUIRE EQUIPMENT':'PROCURE RESOURCE'}</h5><p class="text-muted">${safe(item.itemName)} · Inventory changes only when quantities are received.</p><form id="directPurchaseForm"><div class="resource-summary" style="grid-template-columns:repeat(2,minmax(0,1fr));"><label><b>Quantity *</b><input class="form-control" name="quantity" type="number" min="1" required value="${shortage}"></label><label><b>Supplier *</b><input class="form-control" name="supplier" required list="projectSupplierList" value="${safe(item.supplier||'')}"><datalist id="projectSupplierList">${(data.suppliers||[]).map(name=>`<option value="${safe(name)}">`).join('')}</datalist></label><label><b>Unit Purchase Cost</b><input class="form-control" name="unitPurchaseCost" type="number" min="0" step="0.01" value="${Number(item.purchaseCost||0)}"></label><label><b>Expected Delivery *</b><input class="form-control" name="expectedDelivery" type="date" required min="${new Date().toISOString().slice(0,10)}"></label></div><div class="d-flex justify-content-end gap-2 mt-3"><button type="button" class="pw-btn purchase-cancel">Cancel</button><button type="submit" class="pw-btn primary">${item.type==='equipment'?'Record Acquisition':'Purchase'}</button></div></form></div>`;
        document.body.appendChild(purchaseModal);purchaseModal.querySelector('.purchase-cancel').onclick=()=>purchaseModal.remove();purchaseModal.addEventListener('click',e=>{if(e.target===purchaseModal)purchaseModal.remove();});
        purchaseModal.querySelector('form').addEventListener('submit',async e=>{e.preventDefault();const fd=new FormData(e.target);try{const result=await studioApi(`/api/projects/${projectId}/resources/${item._id}/purchase`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({quantity:Number(fd.get('quantity')),supplier:fd.get('supplier'),unitPurchaseCost:Number(fd.get('unitPurchaseCost')||0),expectedDelivery:fd.get('expectedDelivery'),acquisitionMode:button.dataset.mode||'purchase'})});purchaseModal.remove();reloadReview(result.message);}catch(error){toast(error.message,'error');}});
      }));
      overlay.querySelectorAll('.res-receive').forEach(button => button.addEventListener('click', async () => {
