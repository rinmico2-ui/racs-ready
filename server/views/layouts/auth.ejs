<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title><%= title %></title>

  <!-- Bootstrap 5.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    @font-face {
      font-family: 'Montserrat';
      font-style: normal;
      font-weight: 400;
      src: local('Ubuntu Regular'), local('Ubuntu-Regular');
    }
    @font-face {
      font-family: 'Montserrat';
      font-style: normal;
      font-weight: 500;
      src: local('Ubuntu Medium'), local('Ubuntu-Medium');
    }
    @font-face {
      font-family: 'Montserrat';
      font-style: normal;
      font-weight: 700;
      src: local('Ubuntu Bold'), local('Ubuntu-Bold');
    }
    body {
      font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
  </style>

  <!-- Auth Styles -->
  <link rel="stylesheet" href="/css/auth/auth.css">
  <link rel="stylesheet" href="/css/fonts/fonts.css">

  <% if (typeof extraStyles !== 'undefined' && extraStyles) { %>
    <% extraStyles.forEach(function(s){ %>
      <link rel="stylesheet" href="<%= s %>">
    <% }) %>
  <% } %>

  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <!-- reCAPTCHA -->
  <script>window.recaptchaSiteKey = "<%= (typeof recaptchaSiteKey !== 'undefined' && recaptchaSiteKey) ? recaptchaSiteKey : '' %>";</script>
  <% if (typeof recaptchaSiteKey !== 'undefined' && recaptchaSiteKey) { %>
    <script src="https://www.google.com/recaptcha/api.js?onload=initRecaptcha&render=explicit" async defer></script>
  <% } else { %>
    <style>.grecaptcha-badge{display:none!important;}</style>
  <% } %>
</head>
<body>
  <% if (typeof fullWidth !== 'undefined' && fullWidth) { %>
    <main class="auth-page"><%- body %></main>
  <% } else { %>
    <main class="auth-page">
      <div class="container-fluid p-0">
        <%- body %>
      </div>
    </main>
  <% } %>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Auth JavaScript -->
  <script src="/js/auth-common.js"></script>

  <% if (typeof extraScripts !== 'undefined' && extraScripts) { %>
    <% extraScripts.forEach(function(s){ %>
      <script src="<%= s %>"></script>
    <% }) %>
  <% } %>
</body>
</html>
