      if (travelFareDisplay) travelFareDisplay.textContent = `₱${Number(state.travelFare || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      if (totalFeeDisplay) totalFeeDisplay.textContent = `₱${total.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      if (feeServiceDetails) feeServiceDetails.innerHTML = state.selectedServices.length
