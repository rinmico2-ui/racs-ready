        <div class="d-flex justify-content-end gap-2 mt-3">
          ${variantData ? `<button type="button" class="btn btn-outline-danger remove-variant2" data-variant-id="${variantId}" title="Remove this variant">
            <i class="bi bi-trash"></i> Remove
          </button>` : ''}
          <button type="button" class="btn btn-primary save-variant2" data-variant-id="${variantId}" title="Save this variant">
            <i class="bi bi-check-lg"></i> Save
          </button>
        </div>
      `;
      
      container.appendChild(variantRow);
      
      // Populate data if provided
      if (variantData) {
        const capacitySelect = variantRow.querySelector(`[data-field="capacity"]`);
        const btuInput = variantRow.querySelector(`[data-field="btu"]`);
        const sellingPriceInput = variantRow.querySelector(`[data-field="sellingPrice"]`);
        const costPriceInput = variantRow.querySelector(`[data-field="costPrice"]`);
        const quantityInput = variantRow.querySelector(`[data-field="quantity"]`);
        const minStockLevelInput = variantRow.querySelector(`[data-field="minStockLevel"]`);
        
        if (capacitySelect) {
          const cap = parseFloat(variantData.capacity);
          if (!isNaN(cap) && Number.isInteger(cap)) {
            capacitySelect.value = cap.toFixed(1);
          } else {
            capacitySelect.value = String(variantData.capacity || '');
