      try {
        const r = await fetch(`/api/projects/${projectId}/materials/${materialId}/confirm-pickup`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: '{}',
        });
        if (r.ok) { toast('Pickup confirmed'); loadProject(); }
        else { const e = await r.json(); toast(e.error || 'Failed', 'error'); }
      } catch(e) { toast('Failed to confirm', 'error'); }
    };
    if (btn) await withBtnLoading(btn, 'Saving…', action);
    else await action();
  };

  window.saveAdminNotes = async function(btn) {
    const notes = qs('#adminNotesInput')?.value || '';
    const action = async () => {
      try {
        const r = await fetch(`/api/projects/${projectId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ adminNotes: notes }),
