          <select id="filterTech" class="form-select form-select-sm">
            <option value="">All technicians</option>
          </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
          <button class="btn btn-sm btn-primary w-100" id="applyFilterBtn">Apply</button>
          <button class="btn btn-sm btn-outline-secondary w-100" id="clearFilterBtn">Clear</button>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
      <span>Tool Catalog</span>
      <div class="d-flex gap-2">
        <span class="small text-muted" id="toolUsageCount">—</span>
        <button class="btn btn-sm btn-primary" id="addToolBtn">
          <i class="bi bi-plus-circle me-1"></i>Add New Tool
        </button>
      </div>
    </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
      <span>Usage Records</span>
      <span class="small text-muted" id="toolUsageCount">—</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Tool Name</th>
            <th>Unit</th>
            <th>Cost Price (₱)</th>
            <th>Selling Price (₱)</th>
            <th>Quantity</th>
            <th>Status</th>
            <th>Min Stock Level</th>
            <th>Created Date</th>
            <th>Notes</th>
            <th style="width:180px">Actions</th>
          </tr>
        </thead>
        <tbody id="toolUsageBody">
          <tr><td colspan="10" class="text-center text-muted py-4">Loading tool usage…</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Custom Tool Management Modal -->
<div id="toolManagementModal" class="custom-modal" style="display: none;">
  <div class="custom-modal-backdrop" onclick="toolManagement.hideModal()"></div>
  <div class="custom-modal-dialog">
    <div class="custom-modal-content">
      <div class="custom-modal-header">
        <h5 class="custom-modal-title">
          <i class="bi bi-tools me-2"></i>
          <span id="modalTitle">Add New Tool</span>
        </h5>
        <button type="button" class="custom-modal-close" onclick="toolManagement.hideModal()">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <form id="toolManagementForm" novalidate>
        <div class="custom-modal-body">
          <!-- Basic Information Section -->
          <div class="row mb-4">
            <div class="col-12">
              <h6 class="text-primary fw-bold mb-3">
                <i class="bi bi-info-circle me-2"></i>Basic Information
              </h6>
            </div>
            <div class="col-md-8">
              <label class="form-label fw-semibold">Tool Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="toolName" name="itemName" required 
                     placeholder="e.g., Copper Wire, Refrigerant Gas, Wrench Set">
              <div class="invalid-feedback">Please provide a tool name</div>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Unit <span class="text-danger">*</span></label>
              <select class="form-select" id="toolUnit" name="unit" required>
                <option value="">Select Unit</option>
                <option value="pcs">Pieces (pcs)</option>
                <option value="kg">Kilograms (kg)</option>
                <option value="liters">Liters (L)</option>
                <option value="meters">Meters (m)</option>
                <option value="set">Set</option>
                <option value="box">Box</option>
                <option value="bottle">Bottle</option>
                <option value="roll">Roll</option>
              </select>
              <div class="invalid-feedback">Please select a unit</div>
            </div>
          </div>

          <!-- Stock Management Section -->
          <div class="row mb-4">
            <div class="col-12">
              <h6 class="text-success fw-bold mb-3">
                <i class="bi bi-box-seam me-2"></i>Stock Management
              </h6>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Initial Quantity <span class="text-danger">*</span></label>
              <input type="number" class="form-control" id="toolQuantity" name="quantity" 
                     min="0" step="1" required placeholder="0">
              <div class="invalid-feedback">Please provide a valid quantity</div>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Min Stock Level <span class="text-danger">*</span></label>
              <input type="number" class="form-control" id="toolMinStock" name="minStockLevel" 
                     min="0" step="1" required value="3" placeholder="3">
              <div class="invalid-feedback">Please provide minimum stock level</div>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Stock Status <span class="text-danger">*</span></label>
              <select class="form-select" id="toolStatus" name="status" required>
                <option value="">Select Status</option>
                <option value="in_stock">In Stock</option>
                <option value="low_stock">Low Stock</option>
                <option value="out_of_stock">Out of Stock</option>
                <option value="discontinued">Discontinued</option>
              </select>
              <div class="invalid-feedback">Please select stock status</div>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Is Stock Item</label>
              <div class="form-check form-switch mt-2">
                <input class="form-check-input" type="checkbox" id="toolIsStockItem" name="isStockItem" checked>
                <label class="form-check-label" for="toolIsStockItem">
                  Track as inventory item
                </label>
              </div>
            </div>
          </div>

          <!-- Pricing Section -->
          <div class="row mb-4">
            <div class="col-12">
              <h6 class="text-warning fw-bold mb-3">
                <i class="bi bi-currency-dollar me-2"></i>Pricing Information
              </h6>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Cost Price (₱) <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text">₱</span>
                <input type="number" class="form-control" id="toolCostPrice" name="costPrice" 
                       min="0" step="0.01" required placeholder="0.00">
              </div>
              <div class="invalid-feedback">Please provide a valid cost price</div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Selling Price (₱) <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text">₱</span>
                <input type="number" class="form-control" id="toolSellingPrice" name="sellingPrice" 
                       min="0" step="0.01" required placeholder="0.00">
              </div>
              <div class="invalid-feedback">Please provide a valid selling price</div>
            </div>
          </div>

          <!-- Additional Details Section -->
          <div class="row mb-4">
            <div class="col-12">
              <h6 class="text-info fw-bold mb-3">
                <i class="bi bi-clipboard-data me-2"></i>Additional Details
              </h6>
            </div>
            <div class="col-md-12">
              <label class="form-label fw-semibold">Supplier</label>
              <input type="text" class="form-control" id="toolSupplier" name="supplier" 
                     placeholder="Supplier name (optional)">
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Specification</label>
              <textarea class="form-control" id="toolSpecification" name="specification" 
                        rows="2" placeholder="Technical specifications (optional)"></textarea>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Description</label>
              <textarea class="form-control" id="toolDescription" name="description" 
                        rows="3" placeholder="Detailed description (optional)"></textarea>
            </div>
          </div>

          <!-- Active Status -->
          <div class="row">
            <div class="col-12">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="toolActive" name="active" checked>
                <label class="form-check-label" for="toolActive">
                  <strong>Active</strong> - Tool is available for use
                </label>
              </div>
            </div>
          </div>
        </div>
        <div class="custom-modal-footer">
          <button type="button" class="btn btn-secondary" onclick="toolManagement.hideModal()">
            <i class="bi bi-x-circle me-1"></i>Cancel
          </button>
          <button type="submit" class="btn btn-primary" id="saveToolBtn">
            <i class="bi bi-check-circle me-1"></i>Save Tool
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  window.TOOL_USAGE_CONTEXT = {
    apiBase: "<%= apiBase %>",
    roleLabel: "<%= roleLabel %>",
  };
</script>
<script src="/js/tool-management.js"></script>
