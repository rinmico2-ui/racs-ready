        '<div style="margin-top:16px;padding:14px 16px;background:#f0fdf4;border-radius:12px;border:1px solid #bbf7d0;display:flex;align-items:center;gap:12px;">'+
        '<i class="bi bi-check-circle-fill text-success" style="font-size:1.5rem;"></i>'+
        '<div><div style="font-weight:700;font-size:0.9rem;color:#065f46;">Completed</div>'+
        '<div style="font-size:0.8rem;color:#166534;">'+(b.updatedAt?new Date(b.updatedAt).toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}):'')+'</div></div></div>';
      new bootstrap.Modal(document.getElementById('detailModal')).show();
    }).catch(function(){showNotification({type:'error',title:'Error',message:'Failed to load job details.',duration:4000});});
  };

  // ═══ EVENT LISTENERS & INIT ═══
  var _cjSearchEl=document.getElementById('cjSearchInput');
  if(_cjSearchEl)_cjSearchEl.addEventListener('input',function(){clearTimeout(_cjSearchTimer);_cjSearchTimer=setTimeout(function(){_cjPage=1;AU.Completed.load();},400);});

  // ═══ EVENT LISTENERS & INIT ═══
  ['filterServiceType','filterPaymentStatus','filterPaymentMethod','filterDateRange','filterSort'].forEach(function(id){
    var el=document.getElementById(id);if(el)el.addEventListener('change',function(){AU.Pending.applyFilters(1);});
  });

  var rqFilterBtns=document.querySelectorAll('#rqStatusFilter button');
  rqFilterBtns.forEach(function(btn){
    btn.addEventListener('click',function(){
      rqFilterBtns.forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active');
      var v=btn.getAttribute('data-status');
      if(!document.getElementById('rqFilterStatus')){var h=document.createElement('input');h.type='hidden';h.id='rqFilterStatus';h.value=v;document.body.appendChild(h);}
      else document.getElementById('rqFilterStatus').value=v;
      AU.Pending.renderRepairRequests();
    });
  });
  var rqSearchEl=document.getElementById('rqSearchInput');
  if(rqSearchEl){var rqST;rqSearchEl.addEventListener('input',function(){clearTimeout(rqST);rqST=setTimeout(function(){AU.Pending.renderRepairRequests();},300);});}

  var aqSearchEl=document.getElementById('aqSearchInput');
  if(aqSearchEl){var aqST;aqSearchEl.addEventListener('input',function(){clearTimeout(aqST);aqST=setTimeout(function(){AU.Queue.loadQueue(1);},300);});}
  var actSearchEl=document.getElementById('activeSearchInput');
  if(actSearchEl){var actST;actSearchEl.addEventListener('input',function(){clearTimeout(actST);actST=setTimeout(function(){AU.Active.load();},400);});}

  // ═══ EQUIPMENT ASSIGNMENT ═══
  AU.Equipment={_page:1,_search:'',_loading:false,_toolCache:[]};
  AU.Equipment.load=function(page){
    if(page) this._page=page;
    if(this._loading) return;
    this._loading=true;
    var container=document.getElementById('equipmentTableBody');
    var countEl=document.getElementById('equipmentCount');
    if(container) container.innerHTML='<tr><td colspan="8" class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Loading...</p></td></tr>';
    var params=new URLSearchParams();
    params.set('page',this._page);
    params.set('limit',20);
    var s=document.getElementById('equipmentSearchInput');
    if(s&&s.value) params.set('search',s.value);
    fetch('/api/admin/appointments/equipment-bookings?'+params.toString()).then(function(r){return r.json();}).then(function(d){
      AU.Equipment._loading=false;
      var bookings=d.bookings||[];
      var total=d.pagination?.total||0;
      if(countEl) countEl.textContent=total;
      var badge=document.getElementById('tabEquipmentBadge');
      if(badge){badge.textContent=total;badge.style.display=total>0?'inline-flex':'none';}
      if(!container) return;
      if(!bookings.length){container.innerHTML='<tr><td colspan="8" class="text-center py-5 text-muted"><i class="bi bi-check-circle d-block mb-2" style="font-size:2rem;"></i><p>No bookings need equipment.</p></td></tr>';return;}
      container.innerHTML=bookings.map(function(b){
        var ref=b.bookingReference||b._id.slice(-8).toUpperCase();
        var bDate=b.bookingDate?new Date(b.bookingDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}):'--';
        var time=(b.startTime||'--')+' \u2013 '+(b.endTime||'--');
        var tech=b.technician?.name||'—';
        var assigned=(b.equipmentCount||0)+' item'+(b.equipmentCount===1?'':'s');
        return '<tr>'+
          '<td><strong>'+ref+'</strong></td>'+
          '<td>'+(b.customer?.name||'N/A')+'</td>'+
          '<td>'+(b.service?.name||'--')+'</td>'+
          '<td>'+tech+'</td>'+
          '<td>'+bDate+'</td>'+
          '<td>'+time+'</td>'+
          '<td>'+assigned+'</td>'+
          '<td class="text-center">'+
            '<button class="au-btn au-btn-primary au-btn-sm" onclick="AU.Equipment.openAssignModal(\''+b._id+'\',\''+String(ref).replace(/'/g,'\\\'')+'\')" title="Assign Equipment"><i class="bi bi-tools"></i></button>'+
          '</td></tr>';
      }).join('');
      var pages=d.pagination?.pages||1;
      var page=d.pagination?.page||1;
      var pEl=document.getElementById('equipmentPagination');
      if(pEl){
        var html='';
        if(pages>1){
          html+='<ul class="pagination pagination-sm">';
          for(var i=1;i<=pages;i++){
            html+='<li class="page-item'+(i===page?' active':'')+'"><button class="page-link" onclick="AU.Equipment.load('+i+')">'+i+'</button></li>';
          }
          html+='</ul>';
        }
        pEl.innerHTML=html;
      }
    }).catch(function(){
      AU.Equipment._loading=false;
      if(container) container.innerHTML='<tr><td colspan="8" class="text-center py-3 text-danger">Failed to load equipment bookings</td></tr>';
    });
  };
  AU.Equipment.openAssignModal=function(bookingId, ref){
    document.getElementById('assignEquipmentBookingId').value=bookingId;
    document.getElementById('assignEquipmentSubtitle').textContent='Booking: '+ref;
    document.getElementById('assignEquipmentToolSearch').value='';
    document.getElementById('assignEquipmentToolList').innerHTML='<div class="text-center text-muted py-3">Start typing to search tools</div>';
    document.getElementById('assignEquipmentQty').value=1;
    document.getElementById('assignEquipmentNotes').value='';
    new bootstrap.Modal(document.getElementById('assignEquipmentModal')).show();
    AU.Equipment._loadTools();
  };
  AU.Equipment._loadTools=function(){
    fetch('/api/admin/tools/available').then(function(r){return r.json();}).then(function(d){
      AU.Equipment._toolCache=(d.tools||[]);
    });
  };
  AU.Equipment.searchTools=function(){
    var q=document.getElementById('assignEquipmentToolSearch').value.toLowerCase();
    var list=document.getElementById('assignEquipmentToolList');
    var tools=AU.Equipment._toolCache.filter(function(t){return t.itemName.toLowerCase().includes(q);});
    if(!tools.length){list.innerHTML='<div class="text-center text-muted py-3">No tools found</div>';return;}
    list.innerHTML=tools.map(function(t){
      var stock=t.quantity||0;
      return '<div class="form-check" style="padding:0.35rem 1.5rem;">'+
        '<input class="form-check-input" type="radio" name="equipmentToolId" id="etool_'+t._id+'" value="'+t._id+'" data-name="'+t.itemName+'">'+
        '<label class="form-check-label d-block" for="etool_'+t._id+'"><strong>'+t.itemName+'</strong> <span class="text-muted">('+stock+' in stock)</span></label>'+
      '</div>';
    }).join('');
  };
  AU.Equipment.save=function(){
    var bookingId=document.getElementById('assignEquipmentBookingId').value;
    var qty=parseInt(document.getElementById('assignEquipmentQty').value)||1;
    var notes=document.getElementById('assignEquipmentNotes').value;
    var selected=document.querySelector('input[name="equipmentToolId"]:checked');
    if(!selected){showNotification({type:'warning',title:'Select Tool',message:'Please select a tool first.',duration:3000});return;}
    var btn=document.getElementById('btnSaveEquipmentAssignment');
    btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Saving...';
    fetch('/api/admin/appointments/'+bookingId+'/equipment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({equipmentId:selected.value,quantity:qty,notes:notes})}).then(function(r){return r.json();}).then(function(d){
      btn.disabled=false; btn.innerHTML='<i class="bi bi-check-lg me-1"></i>Assign Tool';
      if(d.success){
        showNotification({type:'success',title:'Assigned',message:d.assignment?.equipmentName+' assigned.',duration:3000});
        var modalEl=document.getElementById('assignEquipmentModal');
        var modal=bootstrap.Modal.getInstance(modalEl)||new bootstrap.Modal(modalEl);
        modal.hide();
        AU.Equipment.load();
      } else {
        showNotification({type:'error',title:'Failed',message:d.error||'Could not assign equipment.',duration:4000});
      }
    }).catch(function(){
      btn.disabled=false; btn.innerHTML='<i class="bi bi-check-lg me-1"></i>Assign Tool';
      showNotification({type:'error',title:'Error',message:'Network error',duration:4000});
    });
  };

  var tabBtns=document.querySelectorAll('.au-tab-btn[data-bs-target]');
  tabBtns.forEach(function(btn){
    btn.addEventListener('shown.bs.tab',function(){
      var target=btn.getAttribute('data-bs-target').replace('#tab-','');
      switchTab(target);
    });
  });

  function auInit(){
    var params=new URLSearchParams(window.location.search);
    var initialTab=params.get('tab')||'overview';
    if(initialTab==='equipment'||initialTab==='waiting-reassign'||initialTab==='waitingReassign') initialTab='queue';
    var tabEl=document.getElementById('tab-'+initialTab);
    if(tabEl&&typeof bootstrap!=='undefined'){
      var bsTab=new bootstrap.Tab(document.querySelector('.au-tab-btn[data-bs-target="#tab-'+initialTab+'"]'));
      bsTab.show();
    }
    loaded[initialTab]=true;
    loadTab(initialTab);
    loadBookingResolutionCount();
  }
  if(typeof bootstrap!=='undefined'){auInit();}
  else{window.addEventListener('load',auInit);}
})();

// ═══ Global tracking drawer helpers ═══
var _trackRefreshInterval=null;
function closeTrackDrawer(){
  if(window.trackDrawerPinned)return;
  document.getElementById('trackDrawer').classList.remove('open');
  document.body.style.overflow='';
  if(_trackRefreshInterval){clearInterval(_trackRefreshInterval);_trackRefreshInterval=null;}
}
function toggleTrackDrawerPin(){
  window.trackDrawerPinned=!window.trackDrawerPinned;
  var btn=document.getElementById('trackDrawerPinBtn');
  btn.classList.toggle('pinned',window.trackDrawerPinned);
  btn.title=window.trackDrawerPinned?'Unpin (allow close)':'Keep open';
}
function startTrackingRefresh(){
  if(_trackRefreshInterval){clearInterval(_trackRefreshInterval);}
  if(!window.trackingBookingId)return;
  _trackRefreshInterval=setInterval(function(){
    if(document.getElementById('trackDrawer').classList.contains('open')&&window.trackingBookingId){
      AU.Active.trackOnMap(window.trackingBookingId);
    }
  },15000);
}
function refreshTracking(){
  if(window.trackingBookingId){showNotification({type:'info',title:'Refreshing',message:'Updating tracking data...',duration:2000});AU.Active.trackOnMap(window.trackingBookingId);}
}
function markEnRoute(){
  var btn=document.getElementById('tdBtnEnroute');
  var id=btn?btn.dataset.id:(window.trackingBookingId||'');
  if(!id)return;
  btn.disabled=true;
  btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Setting...';
  fetch('/api/appointments/'+id+'/on-the-way',{method:'POST'}).then(function(r){if(!r.ok)throw new Error('Failed');return r.json();}).then(function(){
    showNotification({type:'success',title:'En Route',message:'Technician marked as en route',duration:4000});
    AU.Active.trackOnMap(id);
    if(window.startTrackingRefresh)startTrackingRefresh();
    if(typeof AU.Active.load==='function')AU.Active.load();
    else{if(document.querySelector('.aj-refresh-btn'))document.querySelector('.aj-refresh-btn').click();}
  }).catch(function(e){
    showNotification({type:'error',title:'Error',message:e.message,duration:4000});
  }).finally(function(){
    btn.disabled=false;
    btn.innerHTML='<i class="bi bi-truck me-1"></i>Mark En Route';
  });
}
function openInFullMap(){
  if(window.trackingData&&window.trackingData.booking){
    var b=window.trackingData.booking;
    var loc=b.location;
    var coords=loc&&loc.lat&&loc.lng?loc.lat+','+loc.lng:'';
    var addr=encodeURIComponent(loc&&loc.address?loc.address:'Service Location');
    if(coords)window.open('https://www.google.com/maps?q='+coords,'_blank');
    else window.open('https://www.google.com/maps/search/'+addr,'_blank');
  }
}
document.addEventListener('keydown',function(e){
  if(e.key==='Escape'&&document.getElementById('trackDrawer').classList.contains('open'))closeTrackDrawer();
});

// Stat card sparklines
window.AU = window.AU || {};
(function(){
  function spark(ctx, data, color){
    if(!ctx || !window.Chart) return null;
    var h = ctx.canvas.height || ctx.canvas.offsetHeight || 40;
    var g = ctx.createLinearGradient(0,0,0,h);
    g.addColorStop(0, color);
    g.addColorStop(1, 'rgba(255,255,255,0)');
    return new Chart(ctx, {
      type: 'line',
      data: {
        labels: data.map(function(_,i){ return i+1; }),
        datasets: [{ data: data, borderColor: color, backgroundColor: g, fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2 }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        animation: { duration: 600 },
        plugins: { legend: { display: false }, tooltip: { enabled: false } },
        scales: { x: { display: false }, y: { display: false } }
      }
    });
  }
  function randomData(n){
    var arr = [8 + Math.random()*12];
    for(var i=1; i<n; i++){ arr.push(Math.max(3, Math.min(30, arr[i-1] + (Math.random()-0.5)*12))); }
    return arr;
  }
  window.AU.drawStatSparklines = function(scope){
    scope = scope || document;
    if(!window.Chart) return;
    scope.querySelectorAll('.stat-sparkline canvas:not([data-spark-init])').forEach(function(c){
      c.setAttribute('data-spark-init','1');
      var card = c.closest('.stat-card');
      var color = card ? (card.dataset.sparkColor || '#2563eb') : '#2563eb';
      spark(c.getContext('2d'), randomData(10), color);
    });
  };
  window.AU.drawStatSparklines();
})();
</script>
<script>
(function(){
  const button=document.getElementById('openServiceChangeQueue'), badge=document.getElementById('serviceChangeCount'), body=document.getElementById('serviceChangeQueueBody'), modal=document.getElementById('serviceChangeQueueModal');
  if(!button||!body||!modal)return;
  const esc=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const itemRows=items=>(items||[]).map((item,index)=>`<div class="border rounded-3 p-2 mb-2"><strong>${index+1}. ${esc(item.name||item.type||'Service')}</strong><div class="small text-muted">${esc([item.type,item.brand,item.model,item.applianceTypeName].filter(Boolean).join(' · '))} · Qty ${Number(item.quantity||1)}</div>${item.problemDescription||item.repairIssue?`<div class="small mt-1">${esc(item.problemDescription||item.repairIssue)}</div>`:''}</div>`).join('')||'<div class="text-muted small">No service items</div>';
  const formatChangeSchedule=schedule=>{
    if(!schedule?.date||!schedule?.startTime)return'';
    const date=new Date(schedule.date);
    const dateLabel=Number.isNaN(date.getTime())?String(schedule.date):date.toLocaleDateString('en-PH',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
    return `${esc(dateLabel)} at ${esc(schedule.startTime)}${schedule.endTime?` - ${esc(schedule.endTime)}`:''}`;
  };

  const changeSchedulePanel=row=>{
    const requested=formatChangeSchedule(row.requestedSchedule);
    const adminProposed=formatChangeSchedule(row.proposedSchedule);
    if(!requested&&!adminProposed)return'';
    return `<div class="row g-3 mt-1">
      ${requested?`<div class="col-md-6"><div class="h-100 rounded-3 p-3" style="background:#eff6ff;border:1px solid #bfdbfe"><div class="small fw-bold text-uppercase text-primary mb-1"><i class="bi bi-calendar2-check me-1"></i>Customer Requested Schedule</div><div class="fw-semibold text-dark">${requested}</div>${row.requestedSchedule?.notes?`<div class="small text-muted mt-1">${esc(row.requestedSchedule.notes)}</div>`:''}</div></div>`:''}
      ${adminProposed?`<div class="col-md-6"><div class="h-100 rounded-3 p-3" style="background:#fffbeb;border:1px solid #fde68a"><div class="small fw-bold text-uppercase text-warning-emphasis mb-1"><i class="bi bi-calendar-event me-1"></i>Admin Proposed Schedule</div><div class="fw-semibold text-dark">${adminProposed}</div></div></div>`:''}
    </div>`;
  };
  async function load(){
    body.innerHTML='<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
    try {
      const response=await fetch('/api/appointments/service-change-requests/pending',{credentials:'include'});
      const data=await response.json();
      if(!response.ok)throw new Error(data.error||'Unable to load requests');
      const rows=data.requests||[];
      badge.textContent=rows.length;
      badge.style.display=rows.length?'inline-block':'none';
      body.innerHTML=rows.length?rows.map(row=>{
        const added=Number(row.summary?.added||0),edited=Number(row.summary?.edited||0),removed=Number(row.summary?.removed||0);
        const serviceSummary=added||edited||removed?`${added} added, ${edited} edited, ${removed} removed`:'No service-item changes';
        return `<article class="card border mb-3" data-booking="${row.bookingId}" data-request="${row._id}">
          <div class="card-header bg-white d-flex justify-content-between"><div><strong>${esc(row.bookingReference||row.bookingId)}</strong><div class="small text-muted">${esc(row.customer?.name||'Customer')} · ${new Date(row.requestedAt).toLocaleString()}</div></div><span class="badge bg-warning text-dark">${esc(row.status)}</span></div>
          <div class="card-body"><div class="row g-3"><div class="col-md-6"><div class="small fw-bold text-uppercase text-muted mb-2">Before</div>${itemRows(row.beforeServices)}</div><div class="col-md-6"><div class="small fw-bold text-uppercase text-primary mb-2">Proposed Services</div>${itemRows(row.proposedServices)}</div></div>${changeSchedulePanel(row)}<div class="small mt-3"><strong>Change:</strong> ${serviceSummary}${row.reason?' · '+esc(row.reason):''}</div></div>
          <div class="card-footer bg-white d-flex flex-wrap justify-content-end gap-2"><button class="btn btn-sm btn-outline-warning sc-schedule">Propose Different Schedule</button><button class="btn btn-sm btn-outline-danger sc-reject">Reject</button><button class="btn btn-sm btn-success sc-approve">Approve Requested Changes</button></div>
        </article>`;
      }).join(''):'<div class="text-center text-muted py-5"><i class="bi bi-check2-circle fs-2 d-block mb-2"></i>No pending service changes.</div>';
      attach();
    } catch(error) {
      body.innerHTML=`<div class="alert alert-danger">${esc(error.message)}</div>`;
    }
  }
  function attach(){body.querySelectorAll('article[data-request]').forEach(card=>{const decide=async(action,payload={})=>{const reason=payload.reason??prompt(action==='reject'?'Reason for rejection:':'Decision note (optional):','');if(reason===null)return;const response=await fetch(`/api/appointments/${card.dataset.booking}/service-change-requests/${card.dataset.request}/decision`,{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({action,reason,...payload})});const data=await response.json();if(!response.ok)throw new Error(data.error||'Decision failed');await load();};card.querySelector('.sc-approve').onclick=()=>decide('approve').catch(e=>alert(e.message));card.querySelector('.sc-reject').onclick=()=>decide('reject').catch(e=>alert(e.message));card.querySelector('.sc-schedule').onclick=()=>{const date=prompt('Proposed date (YYYY-MM-DD):');if(!date)return;const startTime=prompt('Proposed start time (HH:MM):');if(!startTime)return;decide('propose_schedule',{date,startTime}).catch(e=>alert(e.message));};});}
  button.onclick=()=>{bootstrap.Modal.getOrCreateInstance(modal).show();load();};load();
})();
</script>
