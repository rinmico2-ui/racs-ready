      AU.Pending.applyFilters(1);
    }).catch(function(e){console.error('Failed to load pending bookings:',e);});
  };

  AU.Pending.applyFilters=function(page){
    page=page||1;
    var ps=(document.getElementById('filterPaymentStatus')||{}).value||'';
    var pm=(document.getElementById('filterPaymentMethod')||{}).value||'';
    var dr=(document.getElementById('filterDateRange')||{}).value||'';
    var sort=(document.getElementById('filterSort')||{}).value||'newest';
    var hasF=ps||pm||dr;
    var cb=document.getElementById('clearFiltersBtn');if(cb)cb.classList.toggle('d-none',!hasF);
    var f=_pdAll.slice();
    if(ps) f=f.filter(function(b){return b.paymentStatus===ps;});
    if(pm) f=f.filter(function(b){return(b.paymentMethod||'').toLowerCase()===pm;});
    if(dr){
      var now=new Date(),today=new Date(now.getFullYear(),now.getMonth(),now.getDate());
      f=f.filter(function(b){
        var bd=new Date(b.preferredDate||b.bookingDate);
        var bd2=new Date(bd.getFullYear(),bd.getMonth(),bd.getDate());
        switch(dr){
          case'today':return bd2.getTime()===today.getTime();
          case'yesterday':var y=new Date(today);y.setDate(y.getDate()-1);return bd2.getTime()===y.getTime();
          case'this_week':var ws=new Date(today);ws.setDate(ws.getDate()-ws.getDay());return bd2>=ws;
          case'this_month':return bd.getMonth()===now.getMonth()&&bd.getFullYear()===now.getFullYear();
          case'last_month':var lm=new Date(now.getFullYear(),now.getMonth()-1,1);return bd.getMonth()===lm.getMonth()&&bd.getFullYear()===lm.getFullYear();
          default:return true;
        }
      });
    }
    switch(sort){
      case'oldest':f.sort(function(a,b){return new Date(a.preferredDate||a.bookingDate)-new Date(b.preferredDate||b.bookingDate);});break;
      case'amount_high':f.sort(function(a,b){return(b.totalPrice||b.estimatedFee||0)-(a.totalPrice||a.estimatedFee||0);});break;
      case'amount_low':f.sort(function(a,b){return(a.totalPrice||a.estimatedFee||0)-(b.totalPrice||b.estimatedFee||0);});break;
      default:f.sort(function(a,b){return new Date(b.preferredDate||b.bookingDate)-new Date(a.preferredDate||a.bookingDate);});break;
    }
    var fc=document.getElementById('filterResultCount');if(fc)fc.textContent=hasF?'Showing '+f.length+' of '+_pdAll.length:'';
    var ti=f.length,tp=Math.max(1,Math.ceil(ti/_pdLimit));
    _pdPage=Math.min(page,tp);
    var s=(_pdPage-1)*_pdLimit;
    AU.Pending.renderTable(f.slice(s,s+_pdLimit));
    AU.Pending.renderPagination({page:_pdPage,limit:_pdLimit,total:ti,pages:tp});
  };

