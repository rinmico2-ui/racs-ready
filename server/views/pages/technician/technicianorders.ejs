        </div>
      </div>
    </div>

    <!-- Enterprise KPI Row -->
    <div class="row g-3 mb-4 mw-animate-fade-in-up">
      <div class="col-6 col-md-4 col-lg-2" style="animation: mwFadeInUp 0.5s ease-out 0.1s both;">
        <div class="kpi-enterprise" data-accent="blue">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon blue"><i class="bi bi-box-seam"></i></div>
            <span class="kpi-enterprise-badge blue">Orders</span>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">All Orders</p>
            <div class="kpi-enterprise-value" id="kpiTotal">-</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2" style="animation: mwFadeInUp 0.5s ease-out 0.15s both;">
        <div class="kpi-enterprise" data-accent="amber">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon amber"><i class="bi bi-bell"></i></div>
            <span class="kpi-enterprise-badge amber">Awaiting</span>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">Needs Response</p>
            <div class="kpi-enterprise-value" id="kpiAwaiting">-</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2" style="animation: mwFadeInUp 0.5s ease-out 0.2s both;">
        <div class="kpi-enterprise" data-accent="orange">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon orange"><i class="bi bi-check-circle"></i></div>
            <span class="kpi-enterprise-badge orange">Accepted</span>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">Accepted</p>
            <div class="kpi-enterprise-value" id="kpiAccepted">-</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2" style="animation: mwFadeInUp 0.5s ease-out 0.25s both;">
        <div class="kpi-enterprise" data-accent="cyan">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon cyan"><i class="bi bi-truck"></i></div>
            <span class="kpi-enterprise-badge cyan">Delivery</span>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">En Route</p>
            <div class="kpi-enterprise-value" id="kpiDelivery">-</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2" style="animation: mwFadeInUp 0.5s ease-out 0.3s both;">
        <div class="kpi-enterprise" data-accent="purple">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon purple"><i class="bi bi-tools"></i></div>
            <span class="kpi-enterprise-badge purple">Installing</span>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">Installing</p>
            <div class="kpi-enterprise-value" id="kpiInstalling">-</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2" style="animation: mwFadeInUp 0.5s ease-out 0.35s both;">
        <div class="kpi-enterprise" data-accent="green">
          <div class="kpi-enterprise-top">
            <div class="kpi-enterprise-icon green"><i class="bi bi-check2-all"></i></div>
            <span class="kpi-enterprise-badge green">Completed</span>
          </div>
          <div class="kpi-enterprise-body">
            <p class="kpi-enterprise-label">Completed</p>
            <div class="kpi-enterprise-value" id="kpiCompleted">-</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Enterprise Filter Bar -->
    <div class="mw-filter-bar mw-animate-fade-in">
      <div class="mw-search">
        <i class="bi bi-search"></i>
        <input type="text" id="toSearch" placeholder="Search ref, customer, model...">
      </div>
      <div class="mw-tabs" id="toStatusTabs">
        <button class="mw-tab active" data-status="all">All</button>
        <button class="mw-tab" data-status="technician_assigned">Needs Response</button>
        <button class="mw-tab" data-status="technician_accepted,preparing_unit">Accepted</button>
        <button class="mw-tab" data-status="out_for_delivery">En Route</button>
        <button class="mw-tab" data-status="arrived">Arrived</button>
        <button class="mw-tab" data-status="installing">Installing</button>
        <button class="mw-tab" data-status="completed">Done</button>
      </div>
    </div>

    <!-- Split Layout: Order List + Detail Panel -->
    <div class="mw-split-layout" id="splitLayout">
      <!-- Left Pane: Order Cards -->
      <div class="mw-split-left" id="leftPane">
        <div id="toOrdersList">
          <div class="to-empty"><div class="to-empty-icon"><i class="bi bi-hourglass-split spin"></i></div><h6>Loading orders...</h6><p>Please wait</p></div>
        </div>
      </div>

      <!-- Right Pane: Detail Tracker -->
      <div class="mw-split-right" id="rightPane">
        <div class="mw-split-right-inner">
          <div class="detail-panel-header" id="detailPanelHeader" style="display:none;">
            <div class="detail-panel-header-top">
              <div class="detail-panel-header-left">
                <button class="detail-panel-back" onclick="closeDetailPanel()" aria-label="Back to orders"><i class="bi bi-arrow-left"></i></button>
                <div class="detail-panel-avatar"><i class="bi bi-box-seam"></i></div>
                <div>
                  <h5 class="detail-panel-title" id="detailPanelCustomer">Customer Name</h5>
                  <div class="detail-panel-subtitle">
                    <span id="detailPanelRef">Order #---</span>
                    <span style="margin:0 6px;opacity:0.4;">|</span>
                    <span class="detail-status-badge" id="detailPanelStatusBadge">STATUS</span>
                  </div>
                </div>
              </div>
              <button class="detail-panel-close" onclick="closeDetailPanel()"><i class="bi bi-x-lg" style="font-size:0.8rem;"></i></button>
            </div>
            <div class="detail-panel-workflow" id="detailPanelWorkflow"></div>
          </div>

          <div class="detail-panel-body" id="detailPanelBody">
            <div class="detail-panel-empty" id="detailPanelEmpty">
              <i class="bi bi-hand-index-thumb"></i>
              <h6>Select an Order</h6>
              <p>Click on any order card to view its details and track progress.</p>
            </div>
            <div id="detailPanelContent" style="display:none;"></div>
          </div>

          <div class="detail-panel-actions" id="detailPanelActions" style="display:none;"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var _page=1,_status='all',_search='',_orders=[],_selectedId=null;
  var SCFG={
    pending_payment:{label:'Pending Payment',cls:'pending'}, preparing_unit:{label:'Preparing Unit',cls:'preparing'},
    technician_assigned:{label:'Needs Response',cls:'assigned'}, technician_accepted:{label:'Accepted',cls:'accepted'},
    technician_declined:{label:'Declined',cls:'declined'}, out_for_delivery:{label:'En Route',cls:'delivery'},
    arrived:{label:'Arrived',cls:'arrived'}, installing:{label:'Installing',cls:'installing'},
    completed:{label:'Completed',cls:'completed'}, cancelled:{label:'Cancelled',cls:'cancelled'}
  };
  var SICONS={technician_assigned:'bi-bell-fill',technician_accepted:'bi-check-circle-fill',technician_declined:'bi-x-circle-fill',out_for_delivery:'bi-truck',arrived:'bi-geo-alt-fill',installing:'bi-tools',completed:'bi-check2-all',cancelled:'bi-x-circle'};

  var FFLOW=['Assigned','Accepted','En Route','Arrived','Installing','Completed'];
  var FDEL=['Assigned','Accepted','En Route','Arrived','Completed'];
  
  function getFlow(t) { return t==='delivery_only' ? FDEL : FFLOW; }
  
  function getFlowIndex(s) {
    if(s==='technician_assigned') return 0;
    if(s==='technician_accepted' || s==='preparing_unit') return 1;
    if(s==='out_for_delivery') return 2;
    if(s==='arrived') return 3;
    if(s==='installing') return 4;
    if(s==='completed') return 5;
    return -1;
  }

  function statusBadgeClass(status) {
    var sc=SCFG[status]||{cls:'pending'};
    if(sc.cls==='pending' || sc.cls==='preparing') return 'pending';
    if(sc.cls==='assigned') return 'scheduled';
    if(sc.cls==='accepted') return 'confirmed';
    if(sc.cls==='declined') return 'cancelled';
    if(sc.cls==='delivery') return 'on-the-way';
    if(sc.cls==='arrived') return 'scheduled';
    if(sc.cls==='installing') return 'in-progress';
    if(sc.cls==='completed') return 'completed';
    if(sc.cls==='cancelled') return 'cancelled';
    return 'pending';
  }

  var ORDER_PROGRESS_ACTIONS = {
    technician_assigned: { t:'Order assigned', s:'A new order has been assigned to you.', icon:'bi-bell-fill' },
    technician_accepted: { t:'Order accepted', s:'You have accepted the order.', icon:'bi-check-circle-fill' },
    preparing_unit: { t:'Order accepted', s:'You have accepted the order.', icon:'bi-check-circle-fill' },
    out_for_delivery: { t:'Heading to delivery location', s:'You are on the way to the delivery location.', icon:'bi-truck' },
    arrived: { t:'Arrived at delivery location', s:'You have arrived at the delivery location.', icon:'bi-geo-alt-fill' },
    installing: { t:'Installing unit', s:'Installation is in progress.', icon:'bi-tools' },
    completed: { t:'Order completed', s:'Order completed. Great job!', icon:'bi-check2-all' },
    cancelled: { t:'Order cancelled', s:'This order has been cancelled.', icon:'bi-x-circle' }
  };

  var ORDER_STEP_DESCRIPTIONS = {
    'Assigned':'Order is waiting for your response.',
    'Accepted':'You have accepted the order.',
    'En Route':'You are on the way to the delivery location.',
    'Arrived':'You have arrived at the delivery location.',
    'Installing':'Installation is in progress.',
    'Completed':'Order completed. Great job!'
  };

  function badge(s){
    var c=SCFG[s]||{label:s,cls:'pending'}, ic=SICONS[s]||'bi-circle';
    return '<span class="to-badge '+c.cls+'"><i class="bi '+ic+'"></i>'+c.label+'</span>';
  }
  
  function esc(s){return s?String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;'):'';}

  window.fetchOrders = function() {
    _search = document.getElementById('toSearch').value.trim();
    // Build URL — handle comma-separated multi-status by NOT sending to server; filter client-side
    var _statuses = _status!=='all' ? _status.split(',').map(s=>s.trim()) : [];
    var url = '/api/orders/technician/all?page='+_page+'&limit=200';
    if(_search) url+='&search='+encodeURIComponent(_search);
    
    document.getElementById('toOrdersList').innerHTML = '<div class="to-empty"><div class="to-empty-icon"><i class="bi bi-arrow-repeat spin"></i></div><h6>Loading orders...</h6></div>';
    
    fetch(url)
    .then(r=>r.json())
    .then(data=>{
      var allOrders = data.orders||[];
      // Client-side filter for comma-separated statuses
      _orders = _statuses.length ? allOrders.filter(o=>_statuses.includes(o.status)) : allOrders;
      updateKPIs(data.kpi||{});
      renderCards();
      if(_selectedId) {
        var found = _orders.find(o=>o._id===_selectedId);
        if(found) openDetailPanel(found);
        else closeDetailPanel();
      }
    })
    .catch(e=>{
      document.getElementById('toOrdersList').innerHTML = '<div class="alert alert-danger">Error loading orders: '+e.message+'</div>';
    });
  };

  function renderCards() {
    var c = document.getElementById('toOrdersList');
    if (!_orders.length) {
      c.innerHTML = '<div class="to-empty"><div class="to-empty-icon"><i class="bi bi-inbox"></i></div><h6>No Orders Found</h6><p>Try adjusting your filters.</p></div>';
      return;
    }
    var PILL = {
      assigned:   { bg: '#dbeafe', text: '#1e40af' },
      accepted:   { bg: '#dcfce7', text: '#166534' },
      declined:   { bg: '#fee2e2', text: '#991b1b' },
      preparing:  { bg: '#fef9c3', text: '#713f12' },
      delivery:   { bg: '#cffafe', text: '#155e75' },
      arrived:    { bg: '#ede9fe', text: '#4c1d95' },
      installing: { bg: '#fef3c7', text: '#92400e' },
      completed:  { bg: '#dcfce7', text: '#065f46' },
      cancelled:  { bg: '#fee2e2', text: '#7f1d1d' },
      pending:    { bg: '#f1f5f9', text: '#334155' }
    };
    var h = '';
    _orders.forEach(function(o) {
      var id = esc(o._id);
      var sel = (_selectedId === o._id) ? ' selected' : '';
      var items = (o.items || []).map(function(i) { return esc(i.brand + ' ' + i.modelLine); }).join(', ') || '1 Item';
      var cust = esc((o.customer && o.customer.name) || 'Customer');
      var sc = SCFG[o.status] || { label: o.status, cls: 'pending' };
      var p = PILL[sc.cls] || PILL.pending;
      var dObj = (o.delivery && o.delivery.preferredDate) ? new Date(o.delivery.preferredDate) : null;
      var day = dObj ? dObj.getDate() : '—';
      var month = dObj ? dObj.toLocaleDateString('en-PH', { month: 'short' }) : '';
      var dtime = esc((o.delivery && o.delivery.preferredTime) ? o.delivery.preferredTime : 'TBD');
      var addr = (o.delivery && o.delivery.address) ? esc(o.delivery.address.length > 26 ? o.delivery.address.slice(0, 26) + '…' : o.delivery.address) : 'No address';
      var live = ['out_for_delivery', 'arrived', 'installing'].includes(o.status);
      h += '<div class="to-order-card tjc' + sel + (live ? ' tjc-live' : '') + '" data-id="' + id + '" onclick="window.viewOrder(\'' + id + '\')">';
      h += '<div class="tjc-date"><div class="tjc-date-day">' + day + '</div><div class="tjc-date-month">' + month + '</div></div>';
      h += '<div class="tjc-main">';
      h += '<div class="tjc-top"><div class="tjc-title">' + items + '</div><span class="tjc-status" style="background:' + p.bg + ';color:' + p.text + ';">' + esc(sc.label) + '</span></div>';
      h += '<div class="tjc-meta"><span><i class="bi bi-clock me-1"></i>' + dtime + '</span><span><i class="bi bi-geo-alt me-1"></i>' + addr + '</span></div>';
      h += '<div class="tjc-meta"><span><i class="bi bi-person me-1"></i>' + cust + '</span>' + (live ? '<span class="tjc-live-badge"><span class="tjc-pulse"></span>Live</span>' : '') + '</div>';
      h += '</div>';
      h += '<div class="tjc-action"><button class="tjc-view" onclick="event.stopPropagation();window.viewOrder(\'' + id + '\')">View <i class="bi bi-arrow-right"></i></button></div>';
      h += '</div>';
    });
    c.innerHTML = h;
  }
  
  function updateKPIs(s) {
    function setT(id,v){if(document.getElementById(id)) document.getElementById(id).textContent=v!=null?v:'-';}
    setT('kpiTotal',    s.totalOrders);
    setT('kpiAwaiting', s.awaitingAcceptance);
    setT('kpiAccepted', s.pendingPrep);
    setT('kpiDelivery', s.outForDelivery);
    setT('kpiInstalling',s.installing);
    setT('kpiCompleted', s.completed);
    setT('heroTotal',   s.totalOrders);
    setT('heroActive',  Number(s.outForDelivery||0) + Number(s.installing||0));
  }

  window.viewOrder = function(id) {
    _selectedId = id;
    var order = _orders.find(o=>o._id===id);
    if(order) openDetailPanel(order);
    renderCards();
  };
  
  window.closeDetailPanel = function() {
    _selectedId = null;
    document.getElementById('leftPane').classList.remove('panel-open');
    document.getElementById('rightPane').classList.remove('open');
    if(window.innerWidth < 992) document.body.classList.remove('order-sheet-open');
    document.getElementById('detailPanelEmpty').style.display = 'flex';
    document.getElementById('detailPanelHeader').style.display = 'none';
    document.getElementById('detailPanelContent').style.display = 'none';
    document.getElementById('detailPanelActions').style.display = 'none';
    renderCards();
  };

  function openDetailPanel(o) {
    document.getElementById('leftPane').classList.add('panel-open');
    document.getElementById('rightPane').classList.add('open');
    if(window.innerWidth < 992) document.body.classList.add('order-sheet-open');
    document.getElementById('detailPanelEmpty').style.display = 'none';
    
    document.getElementById('detailPanelHeader').style.display = 'block';
    document.getElementById('detailPanelCustomer').textContent = o.customer?.name || 'Customer';
    document.getElementById('detailPanelRef').textContent = 'Order #' + (o.orderReference||o._id.substring(o._id.length-6).toUpperCase());
    var b=SCFG[o.status]||{label:o.status,cls:''};
    document.getElementById('detailPanelStatusBadge').textContent = b.label;
    document.getElementById('detailPanelStatusBadge').className = 'trk-status-pill ' + statusBadgeClass(o.status);
    
    var flow = getFlow(o.fulfillmentType);
    var ai = getFlowIndex(o.status);
    var liveStatuses = ['out_for_delivery','arrived','installing'];
    var isLive = liveStatuses.indexOf(o.status) !== -1;
    var act = ORDER_PROGRESS_ACTIONS[o.status] || { t: b.label, s: 'In progress', icon: 'bi-circle' };

    var opHtml = '<div class="trk-card-header"><h6 class="trk-card-title"><i class="bi bi-activity"></i> Work Progress</h6>' + (isLive ? '<span class="trk-live-tag"><span class="trk-pulse-dot live"></span> LIVE</span>' : '') + '</div>';
    opHtml += '<div class="trk-card-body">';
    opHtml += '<div class="trk-current-action '+(isLive?'live':'')+'"><div class="trk-current-action-icon"><i class="bi '+(isLive?'bi-arrow-repeat':act.icon)+'"></i></div><div class="trk-current-action-text"><div class="trk-current-action-title">'+esc(act.t)+'</div><div class="trk-current-action-sub">'+esc(act.s)+'</div></div></div>';
    opHtml += '<div class="trk-task-list">';
    flow.forEach(function(step, i) {
      var state = i < ai ? 'done' : (i === ai ? 'active' : '');
      var icon = 'bi-circle';
      if(i < ai) icon = 'bi-check-lg';
      else if(i === ai) {
        if(step==='Assigned') icon='bi-bell-fill';
        else if(step==='Accepted') icon='bi-check-circle-fill';
        else if(step==='En Route') icon='bi-truck';
        else if(step==='Arrived') icon='bi-geo-alt-fill';
        else if(step==='Installing') icon='bi-tools';
        else icon='bi-circle-fill';
      }
      var desc = ORDER_STEP_DESCRIPTIONS[step] || '';
      opHtml += '<div class="trk-task '+state+'"><div class="trk-task-dot"><i class="bi '+icon+'"></i></div><div class="trk-task-body"><div class="trk-task-label">'+esc(step)+'</div>'+(desc?'<div class="trk-task-desc">'+esc(desc)+'</div>':'')+'</div></div>';
    });
    opHtml += '</div></div>';
    document.getElementById('detailPanelWorkflow').className = 'trk-card trk-work-progress';
    document.getElementById('detailPanelWorkflow').innerHTML = opHtml;
    
    var itemsLabel = (o.items||[]).map(i => esc(i.brand + ' ' + i.modelLine)).join(', ') || '1 Item';
    var h = '<div class="trk-card" style="margin-bottom:20px;">';
    h += '<div class="trk-card-body">';
    h += '<div class="trk-detail-hero" style="margin-bottom:8px;padding-bottom:14px;">';
    h += '<div class="trk-detail-hero-icon"><i class="bi bi-box-seam"></i></div>';
    h += '<div class="trk-detail-hero-text">';
    h += '<div class="trk-detail-hero-title">' + esc(itemsLabel) + '</div>';
    h += '<div class="trk-detail-hero-sub">Order #' + esc(o.orderReference || o._id.substring(o._id.length - 6).toUpperCase()) + ' · ' + esc(o.fulfillmentType === 'delivery_installation' ? 'Delivery & Installation' : 'Delivery Only') + '</div>';
    h += '</div></div>';
    h += '<div class="trk-detail-row"><div class="trk-detail-icon"><i class="bi bi-truck"></i></div><div class="trk-detail-content"><div class="trk-detail-label">Service Type</div><div class="trk-detail-value">' + esc(o.fulfillmentType === 'delivery_installation' ? 'Delivery & Installation' : 'Delivery Only') + '</div></div></div>';
    h += '<div class="trk-detail-row"><div class="trk-detail-icon"><i class="bi bi-person"></i></div><div class="trk-detail-content"><div class="trk-detail-label">Customer Contact</div><div class="trk-detail-value">' + esc((o.customer?.name || 'Customer') + ' · ' + (o.customer?.phone || 'N/A')) + '</div></div></div>';
    h += '<div class="trk-detail-row"><div class="trk-detail-icon"><i class="bi bi-geo-alt"></i></div><div class="trk-detail-content"><div class="trk-detail-label">Delivery Address</div><div class="trk-detail-value" style="font-size:0.82rem;">' + esc(o.delivery?.address || 'N/A') + '</div></div></div>';
    h += '<div class="trk-detail-row"><div class="trk-detail-icon"><i class="bi bi-calendar3"></i></div><div class="trk-detail-content"><div class="trk-detail-label">Schedule</div><div class="trk-detail-value">' + (o.delivery?.preferredDate ? new Date(o.delivery.preferredDate).toLocaleDateString() : 'TBD') + (o.delivery?.preferredTime ? ' at ' + esc(o.delivery.preferredTime) : '') + '</div></div></div>';
    h += '</div></div>';
    
    h += '<div class="trk-card">';
    h += '<div class="trk-card-header"><h6 class="trk-card-title"><i class="bi bi-box"></i> Order Items (' + (o.items?.length || 0) + ')</h6></div>';
    h += '<div class="trk-card-body">';
    (o.items||[]).forEach(i => {
      h += '<div class="trk-detail-subsection" style="margin-bottom:8px;">';
      h += '<div class="trk-detail-subhead"><i class="bi bi-cpu"></i> ' + esc(i.brand + ' ' + i.modelLine) + '</div>';
      h += '<div class="trk-detail-subtext">Capacity: ' + esc(i.capacity + ' ' + i.capacityUnit) + '</div>';
      h += '</div>';
    });
    h += '</div></div>';
    
    if (o.resourcesReserved !== undefined || o.preparationStatus) {
      h += '<div class="trk-card" style="margin-bottom:16px;">';
      h += '<div class="trk-card-body">';
      h += '<div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1px solid #bbf7d0;border-radius:10px;">';
      h += '<div style="width:28px;height:28px;background:#16a34a;color:#fff;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="bi bi-box-seam" style="font-size:0.75rem;"></i></div>';
      h += '<div style="flex:1;">';
      h += '<div style="font-weight:700;font-size:0.82rem;color:#166534;">Resource Preparation</div>';
      h += '<div style="font-size:0.72rem;color:#166534cc;">Status: <span class="badge ' + (o.preparationStatus === 'reserved' ? 'bg-success' : o.preparationStatus === 'issue' ? 'bg-danger' : 'bg-secondary') + '" style="font-size:0.65rem;padding:3px 7px;">' + (o.preparationStatus || 'pending').replace(/_/g, ' ').toUpperCase() + '</span>';
      if (o.resourcesReservedAt) h += ' · Reserved: ' + new Date(o.resourcesReservedAt).toLocaleString('en-PH');
      h += '</div>';
      if (o.preparationIssue) h += '<div style="font-size:0.72rem;color:#dc2626;margin-top:2px;">' + esc(o.preparationIssue) + '</div>';
      h += '</div></div></div></div>';
    }
    
    document.getElementById('detailPanelContent').innerHTML = '<div class="ent-panel" style="padding:12px;">' + h + '</div>';
    document.getElementById('detailPanelContent').style.display = 'block';
    
    var aHtml = '';
    var s = o.status;
    var ftype = o.fulfillmentType;
    var oid = o._id;
    
    if(s === 'technician_assigned') {
      aHtml += '<button class="to-btn to-btn-accept" data-action="accept" data-id="'+oid+'"><i class="bi bi-check-lg"></i>Accept</button>';
      aHtml += '<button class="to-btn to-btn-decline" data-action="decline" data-id="'+oid+'"><i class="bi bi-x-lg"></i>Decline</button>';
    } else if(s === 'technician_accepted' || s === 'preparing_unit') {
      aHtml += '<button class="to-btn to-btn-enroute" data-action="status" data-id="'+oid+'" data-status="out_for_delivery"><i class="bi bi-truck"></i>Mark En Route</button>';
    } else if(s === 'out_for_delivery') {
      aHtml += '<button class="to-btn to-btn-arrived" data-action="status" data-id="'+oid+'" data-status="arrived"><i class="bi bi-geo-alt-fill"></i>Mark Arrived</button>';
    } else if(s === 'arrived') {
      if(ftype === 'delivery_installation') {
        aHtml += '<button class="to-btn to-btn-install" data-action="status" data-id="'+oid+'" data-status="installing"><i class="bi bi-tools"></i>Start Install</button>';
      } else {
        aHtml += '<button class="to-btn to-btn-done" data-action="status" data-id="'+oid+'" data-status="completed"><i class="bi bi-check2-all"></i>Mark Completed</button>';
      }
    } else if(s === 'installing') {
      aHtml += '<button class="to-btn to-btn-done" data-action="status" data-id="'+oid+'" data-status="completed"><i class="bi bi-check2-all"></i>Mark Completed</button>';
    }
    
    var actDiv = document.getElementById('detailPanelActions');
    if(aHtml) {
      actDiv.innerHTML = '<div class="to-actions-wrap">'+aHtml+'</div>';
      actDiv.style.display = 'flex';
    } else {
      actDiv.style.display = 'none';
    }
  }

  window.doAccept = async function(id) {
    try {
      const res = await fetch('/api/orders/'+id+'/accept', {method:'POST'});
      if(!res.ok) throw new Error("Failed to accept");
      Swal.fire({title:"Accepted",text:"Order accepted.",icon:"success",timer:1500,showConfirmButton:false});
      fetchOrders();
    } catch(e) { Swal.fire("Error",e.message,"error"); }
  };
  
  window.doDecline = async function(id) {
    Swal.fire({
      title: 'Decline Assignment',
      input: 'text',
      inputLabel: 'Reason',
      inputPlaceholder: 'Enter reason...',
      showCancelButton: true,
      confirmButtonText: 'Decline',
      confirmButtonColor: '#ef4444'
    }).then(async (result) => {
      if (result.isConfirmed) {
        try {
          const res = await fetch('/api/orders/'+id+'/decline', {
            method:'POST',headers:{'Content-Type':'application/json'},
            body:JSON.stringify({reason:result.value||'No reason provided'})
          });
          if(!res.ok) throw new Error("Failed to decline");
          closeDetailPanel();
          Swal.fire({title:"Declined",text:"Order declined.",icon:"success",timer:1500,showConfirmButton:false});
          fetchOrders();
        } catch(e) { Swal.fire("Error",e.message,"error"); }
      }
    });
  };
  
  window.doStatus = async function(id, status) {
    try {
      const res = await fetch('/api/orders/'+id+'/status', {
        method:'PATCH',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({status:status,note:'Status updated to '+SCFG[status].label})
      });
      if(!res.ok) throw new Error("Failed to update status");
      if(status === 'completed') await collectOrderPayment(id);
      fetchOrders();
    } catch(e) { Swal.fire("Error",e.message,"error"); }
  };

  async function collectOrderPayment(id) {
    var order=_orders.find(o=>String(o._id)===String(id))||{};
    const result=await Swal.fire({title:'Collect Payment',html:`<div class="text-start"><label class="form-label">Amount Due</label><input id="opAmount" type="number" class="form-control mb-2" value="${Number(order.total||0)}"><label class="form-label">Payment Method</label><select id="opMethod" class="form-select mb-2"><option value="cash">Cash</option><option value="gcash">GCash</option><option value="bank">Bank Transfer</option></select><label class="form-label">Reference Number</label><input id="opRef" class="form-control mb-2" placeholder="Required for GCash / Bank"><label class="form-label">Receipt Screenshot</label><input id="opProof" type="file" accept="image/*" class="form-control mb-2"><label class="form-label">Customer Signature</label><input id="opSignature" class="form-control" placeholder="Customer full name" required></div>`,showCancelButton:true,confirmButtonText:'Record Collection',preConfirm:async()=>{const method=document.getElementById('opMethod').value,reference=document.getElementById('opRef').value.trim(),customerSignature=document.getElementById('opSignature').value.trim(),file=document.getElementById('opProof').files[0];if(!customerSignature||((method==='gcash'||method==='bank')&&(!reference||!file))){Swal.showValidationMessage('Signature and required transfer evidence are missing.');return false;}const proofUrl=file?await new Promise((ok,bad)=>{const f=new FileReader();f.onload=()=>ok(f.result);f.onerror=bad;f.readAsDataURL(file);}):null;return {amount:Number(document.getElementById('opAmount').value),method,reference,proofUrl,customerSignature};}});
    if(!result.isConfirmed) return;
    const location=await new Promise(ok=>{if(!navigator.geolocation)return ok(null);navigator.geolocation.getCurrentPosition(p=>ok({lat:p.coords.latitude,lng:p.coords.longitude,accuracy:p.coords.accuracy}),()=>ok(null),{timeout:5000});});
    const r=await fetch('/api/orders/'+id+'/collect-payment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...result.value,location})});
    const d=await r.json();if(!r.ok)throw new Error(d.error||'Failed to record payment');
    await Swal.fire({title:'Payment Collected',text:'Waiting for admin remittance verification.',icon:'success'});
  }

  // Delegated click handlers — card list (view order)
  document.getElementById('toOrdersList').addEventListener('click', function(e) {
    var card = e.target.closest('[data-id]');
    if(card && card.classList.contains('to-order-card')) {
      window.viewOrder(card.dataset.id);
    }
  });

  // Delegated click handlers — action bar buttons
  document.getElementById('detailPanelActions').addEventListener('click', function(e) {
    var btn = e.target.closest('[data-action]');
    if(!btn) return;
    var action = btn.dataset.action;
    var id = btn.dataset.id;
    if(action === 'accept') window.doAccept(id);
    else if(action === 'decline') window.doDecline(id);
    else if(action === 'status') window.doStatus(id, btn.dataset.status);
  });

  // Setup tabs
  document.getElementById('toStatusTabs').addEventListener('click', function(e){
    if(e.target.tagName==='BUTTON') {
      document.querySelectorAll('#toStatusTabs button').forEach(b=>b.classList.remove('active','btn-primary'));
      document.querySelectorAll('#toStatusTabs button').forEach(b=>b.classList.add('btn-outline-secondary'));
      e.target.classList.add('active','btn-primary');
      e.target.classList.remove('btn-outline-secondary');
      _status = e.target.getAttribute('data-status');
      _page=1;
      fetchOrders();
    }
  });

  document.getElementById('toSearch').addEventListener('keyup', e=>{
    if(e.key==='Enter') { _page=1; fetchOrders(); }
  });

  function updateClock() {
    var now = new Date();
    var h = String(now.getHours()).padStart(2, '0');
    var m = String(now.getMinutes()).padStart(2, '0');
    var el = document.getElementById('orderClock');
    if(el) el.textContent = h + ':' + m;
  }
  setInterval(updateClock, 1000);
  updateClock();

  // Init
  fetchOrders();

})();
</script>
