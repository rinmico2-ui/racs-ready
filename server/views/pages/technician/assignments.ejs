  /* ── Inventory Autocomplete ── */
  .inv-autocomplete-wrap {
    position: relative;
  }

  .inv-autocomplete-list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 100025;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.12);
