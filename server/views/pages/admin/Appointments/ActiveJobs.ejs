            ${b.inspection ? `
            <div class="pm-card" style="border-left:3px solid #16a34a;">
              <div class="pm-card-head" style="background:#f0fdf4;"><div class="pm-icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-clipboard-check"></i></div><h3 class="pm-card-title">Inspection</h3></div>
              <div class="pm-card-body">
                <div class="pm-row"><span class="pm-lbl">Findings</span><span class="pm-val" style="font-weight:400;">${b.inspection.findings || '—'}</span></div>
