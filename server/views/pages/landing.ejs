  <script>
    (function() {
      var tracks = document.querySelectorAll('[data-cc-track]');
      tracks.forEach(function(track) {
        // Duplicate children once for a seamless loop
        var kids = Array.prototype.slice.call(track.children);
        kids.forEach(function(el) { track.appendChild(el.cloneNode(true)); });

        var pos = 0, paused = false;
        function step() {
          if (!paused) {
            pos -= 0.6;
            var half = track.scrollWidth / 2;
            if (-pos >= half) pos += half;
            track.style.transform = 'translateX(' + pos + 'px)';
          }
          requestAnimationFrame(step);
        }
        requestAnimationFrame(step);

        var carousel = track.closest('.cc-carousel');
        carousel.addEventListener('mouseenter', function() { paused = true; });
        carousel.addEventListener('mouseleave', function() { paused = false; });
      });
    })();
  </script>

