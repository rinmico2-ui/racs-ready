  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Move all modals to body to prevent z-index/backdrop issues in nested layouts
      document.querySelectorAll('.modal').forEach(modal => {
        if (modal && modal.parentElement !== document.body) {
          document.body.appendChild(modal);
        }
      });
    });
  </script>

<script>
  // ─── Aircon Inventory Admin Logic ────────────────────────────────────────────
  (function () {
    const tbody = document.getElementById("inventoryTableBody");
    const summary = document.getElementById("inventorySummary");
    const kpiTotal = document.getElementById("kpiTotalItems");
    const kpiLow = document.getElementById("kpiLowStock");
    const kpiValue = document.getElementById("kpiTotalValue");
    const kpiAssigned = document.getElementById("kpiAssigned");
    const airconSearchInput = document.getElementById("airconSearchInput");
    const airconStatusFilter = document.getElementById("airconStatusFilter");
    const airconSort = document.getElementById("airconSort");
    const airconFilterBtn = document.getElementById("airconFilterBtn");
    let inventoryData = [];
    let allInventoryData = [];
    let editingId = null;

    // ── Helpers ────────────────────────────────────────────────────────────────
    function fmtPrice(p) {
      if (!p) return '₱ 0.00';
      return '₱ ' + Number(p).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function makeSparkData(count) {
      const c = Math.max(0, count || 0);
      if (c === 0) return [0,0,0,0,0,0,0];
      return [Math.max(0, c-3), Math.max(0, c-2), Math.max(0, c-1), c-1, c, c, Math.max(0, c-1)];
    }

    const _invSparkCharts = {};

    async function waitForChart(timeout = 10000) {
      if (typeof Chart !== 'undefined') return;
      if (!document.querySelector('script[src*="chart.js"]')) {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/chart.js';
        s.async = true;
        document.head.appendChild(s);
      }
      const start = Date.now();
      while (typeof Chart === 'undefined' && Date.now() - start < timeout) {
        await new Promise(r => setTimeout(r, 100));
      }
    }

    function drawSpark(id, data, color) {
      if (typeof Chart === 'undefined') return;
      const canvas = document.getElementById(id);
      if (!canvas) return;
      if (_invSparkCharts[id]) { _invSparkCharts[id].destroy(); delete _invSparkCharts[id]; }
      const h = canvas.height || 40;
      const g = canvas.getContext('2d').createLinearGradient(0, 0, 0, h);
      g.addColorStop(0, color);
      g.addColorStop(1, 'rgba(255,255,255,0)');
      _invSparkCharts[id] = new Chart(canvas.getContext('2d'), {
        type: 'line',
        data: { labels: data.map((_, i) => i + 1), datasets: [{ data: data, borderColor: color, backgroundColor: g, fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2 }] },
        options: { responsive: true, maintainAspectRatio: false, animation: { duration: 600 }, plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { display: false }, y: { display: false } } }
      });
    }

    const TYPE_LABELS = {
      split: 'Split Type',
      split_ceiling: 'Split - Ceiling',
      window_inverter: 'Window (Inverter)',
      window_non_inverter: 'Window (Non-Inv)',
      floor_mounted: 'Floor Mounted',
    };

    const STATUS_BADGES = {
      in_stock:      { cls: 'bg-success-subtle text-success border border-success-subtle', label: 'In Stock' },
      low_stock:     { cls: 'bg-warning-subtle text-warning border border-warning-subtle', label: 'Low Stock' },
      out_of_stock:  { cls: 'bg-danger-subtle text-danger border border-danger-subtle', label: 'Out of Stock' },
      coming_soon:   { cls: 'bg-info-subtle text-info border border-info-subtle', label: 'Coming Soon' },
      discontinued:  { cls: 'bg-secondary-subtle text-secondary border border-secondary-subtle', label: 'Discontinued' },
    };

    function starHtml(rating, count) {
      if (!rating) return '<span class="text-muted text-micro">—</span>';
      const stars = Array.from({ length: 5 }).map((_, i) => {
        if (i + 1 <= Math.floor(rating)) return '<i class="bi bi-star-fill"></i>';
        if (i < rating) return '<i class="bi bi-star-half"></i>';
        return '<i class="bi bi-star"></i>';
      }).join('');
      return `<div class="text-warning">${stars}</div><div class="text-micro text-muted">${Number(rating).toFixed(1)} (${count || 0})</div>`;
    }

    // ── Group Aircons by Model Name ─────────────────────────────────────────────
    function groupAirconsByModel(items) {
      const grouped = {};
      
      items.forEach(item => {
        const modelName = item.modelLine || item.itemName || 'Unknown';
        const brandName = (item.brand && item.brand.name) || '';
        const key = `${brandName}-${modelName}`;
        
        if (!grouped[key]) {
          grouped[key] = {
            modelName,
            brandName,
            type: item.type,
            variants: [],
            totalQuantity: 0,
            imageUrl: item.imageUrl,
            status: item.status,
            lowestPrice: Infinity,
            highestPrice: 0,
            inverter: item.inverter
          };
        }
        
        grouped[key].variants.push({
          capacity: item.capacity,
          capacityUnit: item.capacityUnit || 'HP',
          btu: item.btu,
          sellingPrice: item.sellingPrice,
          quantity: item.quantity || 0,
          minStockLevel: item.minStockLevel || 3,
          _id: item._id
        });
        
        grouped[key].totalQuantity += (item.quantity || 0);
        grouped[key].lowestPrice = Math.min(grouped[key].lowestPrice, item.sellingPrice || 0);
        grouped[key].highestPrice = Math.max(grouped[key].highestPrice, item.sellingPrice || 0);
      });
      
      return Object.values(grouped);
    }

    // ── Pagination ─────────────────────────────────────────────────────────────
    let invPageSize = 10;
    let invCurrentPage = 1;

    function renderItemsPage(page) {
      const start = (page - 1) * invPageSize;
      const slice = inventoryData.slice(start, start + invPageSize);
      tbody.innerHTML = '';

      if (slice.length === 0 && inventoryData.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted text-micro">No aircon products found.</td></tr>';
        summary.innerText = '0 entries';
        document.getElementById('inventory-pagination').innerHTML = '';
        return;
      }

      slice.forEach(product => {
        const brandName = (product.brand && product.brand.name) || product.brand || 'Unknown';
        const modelName = product.modelLine || 'Unknown';
        const variants = product.variants || [];
        const totalQuantity = variants.reduce((sum, v) => sum + (v.quantity || 0), 0);
        const inStockVariants = variants.filter(v => v.status === 'in_stock').length;
        const stockCoverage = variants.length ? Math.round((inStockVariants / variants.length) * 100) : 0;
        const priceRange = variants.length > 0 ? {
          min: Math.min(...variants.map(v => v.sellingPrice || 0)),
          max: Math.max(...variants.map(v => v.sellingPrice || 0))
        } : { min: 0, max: 0 };

        const row = document.createElement('tr');
        row.innerHTML = 
          '<td class="ps-4">' +
            '<div class="inv-product-shell">' +
              '<div class="inv-product-media">' +
                (product.imageUrl && product.imageUrl !== '/images/products/default.png' ? 
                  '<img src="' + product.imageUrl + '" alt="' + modelName + '" class="img-fluid rounded" style="width:60px;height:60px;object-fit:cover;box-shadow:0 2px 8px rgba(0,0,0,0.1);" onerror="this.style.display=\'none\';this.parentElement.innerHTML=\'<i class=\\\'bi bi-snow2 fs-3 text-primary d-flex align-items-center justify-content-center\\\' style=\\\'width:60px;height:60px;background:#f8f9fa;border-radius:8px;\\\'></i>\';">' :
                  '<div class="d-flex align-items-center justify-content-center" style="width:60px;height:60px;background:#f8f9fa;border-radius:8px;"><i class="bi bi-snow2 fs-3 text-primary"></i></div>'
                ) +
              '</div>' +
              '<div class="flex-grow-1">' +
                '<div class="fw-bold text-dark mb-1" style="font-size:0.95rem;">' + modelName + '</div>' +
                '<div class="text-muted inv-meta-row">' +
                  '<span class="badge bg-light text-dark border" style="font-size:0.75rem;"><i class="bi bi-building me-1"></i>' + brandName + '</span>' +
                  '<span class="text-muted" style="font-size:0.8rem;">' + variants.length + ' HP Options</span>' +
                '</div>' +
                '<div class="d-flex flex-wrap gap-1">' +
                  (product.inverter ? '<span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:0.7rem;"><i class="bi bi-lightning-charge-fill me-1"></i>Inverter</span>' : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size:0.7rem;"><i class="bi bi-lightning me-1"></i>Standard</span>') +
                  '<span class="badge bg-info-subtle text-info border border-info-subtle" style="font-size:0.7rem;"><i class="bi bi-tag me-1"></i>' + (product.type || 'Split Type') + '</span>' +
                '</div>' +
              '</div>' +
            '</div>' +
          '</td>' +
          '<td>' +
            '<div class="text-muted small mb-1">Type: <strong>' + (product.type || 'Split Type') + '</strong></div>' +
            '<div class="text-muted small">Technology: <strong>' + (product.inverter ? 'Inverter' : 'Non-Inverter') + '</strong></div>' +
            (product.warranty ? '<div class="text-muted small">Warranty: <strong>' + product.warranty + '</strong></div>' : '') +
          '</td>' +
          '<td>' +
            '<div class="inv-variant-grid">' +
              variants.map(v => 
                '<span class="inv-variant-pill">' + 
                '<strong>' + (v.capacity || 'N/A') + ' HP</strong>' + 
                (v.btu ? '<small>' + v.btu + ' BTU</small>' : '') +
                '</span>'
              ).join('') +
            '</div>' +
          '</td>' +
          '<td>' +
            '<div class="fw-bold text-primary mb-1" style="font-size:0.95rem;">' +
              (priceRange.min === priceRange.max ? 
                '₱' + priceRange.min.toLocaleString() : 
                '₱' + priceRange.min.toLocaleString() + ' - ₱' + priceRange.max.toLocaleString()
              ) +
            '</div>' +
            '<div class="text-muted small">' + 
              (variants.length === 1 ? 'Single Price' : variants.length + ' Price Points') +
            '</div>' +
          '</td>' +
          '<td>' +
            '<div class="inv-stock-value">' +
              '<div class="fw-bold ' + (totalQuantity > 10 ? 'text-success' : totalQuantity > 5 ? 'text-warning' : 'text-danger') + '" style="font-size:1.1rem;">' + totalQuantity + '</div>' +
              '<div class="text-muted small">units</div>' +
            '</div>' +
            '<div class="progress" style="height:6px;">' +
              '<div class="progress-bar ' + (inStockVariants === variants.length ? 'bg-success' : inStockVariants > 0 ? 'bg-warning' : 'bg-danger') + '" style="width:' + stockCoverage + '%"></div>' +
            '</div>' +
            '<div class="text-muted small mt-1">' + inStockVariants + '/' + variants.length + ' variants in stock</div>' +
          '</td>' +
          '<td>' +
            (totalQuantity > 0 ? 
              '<div class="d-flex align-items-center gap-2"><span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i>In Stock</span></div>' : 
              '<div class="d-flex align-items-center gap-2"><span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle-fill me-1"></i>Out of Stock</span></div>'
            ) +
            (totalQuantity <= 5 && totalQuantity > 0 ? '<div class="text-warning small mt-1"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock</div>' : '') +
          '</td>' +
          '<td class="text-center">' +
            '<div class="inv-actions-stack">' +
              '<button class="btn btn-outline-primary btn-sm edit-grouped" ' +
                      'data-model="' + modelName + '" data-brand="' + brandName + '" title="Edit product details">' +
                '<i class="bi bi-pencil"></i>' +
              '</button>' +
              '<button class="btn btn-outline-info btn-sm manage-variants" ' +
                      'data-model="' + modelName + '" data-brand="' + brandName + '" title="Manage HP variants">' +
                '<i class="bi bi-layers"></i>' +
              '</button>' +
              '<button class="btn btn-outline-danger btn-sm delete-inventory" ' +
                      'data-id="' + product._id + '" title="Archive product">' +
                '<i class="bi bi-archive"></i>' +
              '</button>' +
            '</div>' +
          '</td>';
        tbody.appendChild(row);
      });

      const total = inventoryData.length;
      const from = start + 1;
      const to = Math.min(start + invPageSize, total);
      summary.innerText = `Showing ${from}–${to} of ${total} entries`;

      // Pagination
      const pages = Math.ceil(total / invPageSize);
      const ul = document.getElementById('inventory-pagination');
      ul.innerHTML = '';
      const prev = document.createElement('li');
      prev.className = 'page-item' + (invCurrentPage <= 1 ? ' disabled' : '');
      prev.innerHTML = '<a class="page-link" href="#">&laquo;</a>';
      prev.addEventListener('click', e => { e.preventDefault(); if (invCurrentPage > 1) { invCurrentPage--; renderItemsPage(invCurrentPage); } });
      ul.appendChild(prev);
      const ind = document.createElement('li');
      ind.className = 'page-item disabled mx-2';
      ind.innerHTML = `<span class="page-link">${invCurrentPage} of ${pages}</span>`;
      ul.appendChild(ind);
      const next = document.createElement('li');
      next.className = 'page-item' + (invCurrentPage >= pages ? ' disabled' : '');
      next.innerHTML = '<a class="page-link" href="#">&raquo;</a>';
      next.addEventListener('click', e => { e.preventDefault(); if (invCurrentPage < pages) { invCurrentPage++; renderItemsPage(invCurrentPage); } });
      ul.appendChild(next);
    }

    // ── Aircon Filter / Sort ───────────────────────────────────────────────────
    let filterTimeout;
    function applyAirconFilters() {
      if (!allInventoryData.length) return;
      const q = (airconSearchInput.value || '').toLowerCase().trim();
      const status = airconStatusFilter.value;
      const sort = airconSort.value;

      let list = allInventoryData.filter(product => {
        const modelName = (product.modelLine || '').toLowerCase();
        const brandName = ((product.brand && product.brand.name) || product.brand || '').toLowerCase();
        const skuMatch = (product.variants || []).some(v => (v.sku || '').toLowerCase().includes(q));
        const textMatch = q ? (modelName.includes(q) || brandName.includes(q) || skuMatch) : true;
        const statusMatch = status === 'all' || (product.variants || []).some(v => v.status === status);
        return textMatch && statusMatch;
      });

      list.forEach(product => {
        product.totalQuantity = (product.variants || []).reduce((sum, v) => sum + (v.quantity || 0), 0);
      });

      list.sort((a, b) => {
        if (sort === 'modelLine') return (a.modelLine || '').localeCompare(b.modelLine || '');
        if (sort === '-modelLine') return (b.modelLine || '').localeCompare(a.modelLine || '');
        if (sort === 'totalQuantity') return a.totalQuantity - b.totalQuantity;
        if (sort === '-totalQuantity') return b.totalQuantity - a.totalQuantity;
        if (sort === '-createdAt') return new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
        return 0;
      });

      inventoryData = list;
      invCurrentPage = 1;
      renderItemsPage(invCurrentPage);
    }

    airconSearchInput.addEventListener('input', () => {
      clearTimeout(filterTimeout);
      filterTimeout = setTimeout(applyAirconFilters, 300);
    });
    airconStatusFilter.addEventListener('change', applyAirconFilters);
    airconSort.addEventListener('change', applyAirconFilters);
    airconFilterBtn.addEventListener('click', applyAirconFilters);

    // ── KPI Rendering ──────────────────────────────────────────────────────────
    async function renderItems(items) {
      allInventoryData = items;
      let totalValue = 0, lowCount = 0, totalVariants = 0;
      
      items.forEach((product) => {
        // Count variants
        totalVariants += (product.variants || []).length;
        
        // Calculate total value across all variants
        (product.variants || []).forEach(variant => {
          totalValue += (variant.sellingPrice || 0) * (variant.quantity || 0);
          if (variant.status === 'low_stock' || variant.status === 'out_of_stock') lowCount++;
        });
      });
      
      const assignedCount = 0; // place-holder until dispatch data available
      kpiTotal.innerText = totalVariants; // Total variants instead of items
      kpiLow.innerText = lowCount;
      kpiValue.innerText = Number(totalValue).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      kpiAssigned.innerText = assignedCount;

      await waitForChart();
      drawSpark('kpiTotalSpark', makeSparkData(totalVariants), '#3b82f6');
      drawSpark('kpiLowStockSpark', makeSparkData(lowCount), '#ef4444');
      drawSpark('kpiTotalValueSpark', makeSparkData(Math.round(totalValue / 1000)), '#10b981');
      drawSpark('kpiAssignedSpark', makeSparkData(assignedCount), '#f59e0b');

      applyAirconFilters();
    }

    // ── Data Fetch ─────────────────────────────────────────────────────────────
    async function loadInventory() {
      try {
        const r = await fetch('/api/admin/hvac');
        if (!r.ok) throw new Error('fail');
        const j = await r.json();
        await renderItems(j.products || []);
      } catch (e) {
        console.error(e);
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 small text-muted text-danger">Failed to load</td></tr>';
      }
    }
    loadInventory();

    // ── Load Brands and Categories ─────────────────────────────────────────────
    async function loadBrandsAndCategories() {
      try {
        // Load brands
        const brandsResponse = await fetch('/api/admin/hvac/brands/all');
        if (brandsResponse.ok) {
          const brandsData = await brandsResponse.json();
          const brandSelect = document.getElementById('invBrand');
          if (brandSelect) {
            brandSelect.innerHTML = '<option value="">Select Brand</option>';
            brandsData.brands.forEach(brand => {
              brandSelect.innerHTML += `<option value="${brand._id}">${brand.name}</option>`;
            });
          }
        }

        // Load categories
        const categoriesResponse = await fetch('/api/admin/hvac/categories/all');
        if (categoriesResponse.ok) {
          const categoriesData = await categoriesResponse.json();
          const categorySelect = document.getElementById('invCategory');
          if (categorySelect) {
            categorySelect.innerHTML = '<option value="">Select Category</option>';
            categoriesData.categories.forEach(category => {
              categorySelect.innerHTML += `<option value="${category._id}">${category.name}</option>`;
            });
          }
        }
      } catch (error) {
        console.error('Error loading brands and categories:', error);
      }
    }
    loadBrandsAndCategories();

    // ── Add New Item Button Event Listener ───────────────────────────────────────
    const addBtn = document.getElementById('openAddItemBtn');
    if (addBtn) {
      addBtn.addEventListener('click', function() {
        openModal(null); // Open modal with null for adding new item
      });
    }

    // ── Variant Management ───────────────────────────────────────────────────────
    let variantIdCounter = 0;

    // Add variant button event listener
    const addVariantBtn = document.getElementById('addVariantBtn');
    if (addVariantBtn) {
      addVariantBtn.addEventListener('click', function() {
        addVariantRow();
      });
    }

    // Add variant row function
    function addVariantRow(variantData = null) {
      const variantId = variantData?._id || `variant_${++variantIdCounter}`;
      const container = document.getElementById('variantsContainer');
      const variantNumber = container.children.length + 1;
      
      const variantRow = document.createElement('div');
      variantRow.className = 'col-12';
      variantRow.id = `variant_${variantId}`;
      
      variantRow.innerHTML = `
        <div class="border rounded p-3 bg-white">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0 fw-bold text-primary">
              <i class="bi bi-box me-1"></i>Variant ${variantNumber}
            </h6>
            <div class="d-flex gap-2">
              ${variantData ? `<button type="button" class="btn btn-sm btn-outline-danger remove-variant" data-variant-id="${variantId}" title="Remove this variant">
                <i class="bi bi-trash"></i> Remove
              </button>` : ''}
            </div>
          </div>
          <div class="row g-3">
            <div class="col-md-3">
              <label class="inv-field-label small">Capacity (HP) <span class="text-danger">*</span></label>
