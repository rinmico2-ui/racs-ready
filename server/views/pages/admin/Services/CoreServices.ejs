          <button class="btn core-filter-btn w-100">
            <i class="bi bi-funnel-fill me-2"></i>Filter
          </button>
        </div>
      </div>
    </div>
  </div>

  <% /* helpers */ %>
  <% function fmtPrice(p) {
    if (p == null) return '';
    return '₱ ' + Number(p).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  } %>
  <% function fmtDuration(mins) {
    if (!mins && mins !== 0) return '';
    const h = Math.floor(mins / 60);
    const m = mins % 60;
    let out = '';
    if (h) out += h + 'h';
    if (m) out += (out ? ' ' : '') + m + 'm';
    return out || '0m';
  } %>
  <% function badgeClass(cat) {
    // simple generic badge style – categories can be customized as needed
    return 'badge bg-secondary-subtle text-secondary border border-secondary-subtle';
  } %>

  <div class="card border-0 shadow-sm mb-4 core-table-card">
    <div
      class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center"
    >
      <h6 class="mb-0 fw-bold"><i class="bi bi-grid-3x3-gap-fill me-2 text-primary"></i>Core Service Definitions</h6>
      <span class="text-muted small">Updated with category structure</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover table-dense align-middle mb-0 core-table">
        <thead class="bg-light">
          <tr>
            <th class="ps-4"><i class="bi bi-box-seam"></i>Service</th>
            <th><i class="bi bi-upc-scan"></i>Code</th>
            <th><i class="bi bi-tags"></i>Category/Type</th>
            <th class="text-center"><i class="bi bi-list-check"></i>Features</th>
            <th class="text-center"><i class="bi bi-basket2"></i>Inclusions</th>
            <th><i class="bi bi-journal-check"></i>Bookings</th>
            <th><i class="bi bi-check2-circle"></i>Status</th>
            <th class="text-end pe-4"><i class="bi bi-gear"></i>Actions</th>
          </tr>
        </thead>
        <tbody id="coreTableBody">
          <% if (coreServices && coreServices.length) { %>
            <% coreServices.forEach(function(svc) { %>
              <tr data-svc="<%= encodeURIComponent(JSON.stringify(svc)) %>">
                <td class="ps-4">
                  <div class="core-service-cell">
                    <span class="core-service-icon"><i class="bi bi-tools"></i></span>
                    <div>
                      <div class="core-service-title"><%= svc.name %></div>
                      <div class="core-service-sub"><%= svc.description || 'No description provided.' %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="core-code-badge"><i class="bi bi-hash"></i><%= svc.slug || svc._id %></span>
                </td>
                <td>
                  <span class="<%= badgeClass(svc.category) %> mb-1 d-inline-block"><%= svc.category || '-' %></span>
                  <% if (svc.isAirconService) { %>
                    <br><span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-snow me-1"></i>Aircon</span>
                  <% } %>
                </td>
                <td class="text-center"><span class="badge bg-light text-dark border core-count-badge"><%= (svc.features && svc.features.length) || 0 %></span></td>
                <td class="text-center"><span class="badge bg-light text-dark border core-count-badge"><%= (svc.includedItems && svc.includedItems.length) || 0 %></span></td>
                <td><span class="core-booking-badge"><i class="bi bi-graph-up-arrow"></i><%= svc.bookingCount || 0 %></span></td>
                <td>
                  <span class="badge <%= svc.active ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border border-secondary-subtle' %>"><%= svc.active ? 'Active' : 'Inactive' %></span>
                </td>
                <td class="text-end pe-4">
                  <button class="btn btn-sm btn-light border edit-core-service core-edit-btn"><i class="bi bi-pencil-square me-1"></i>Edit</button>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center core-empty-state">
                <i class="bi bi-inboxes"></i>
                <div>No core services defined.</div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
      <div class="core-table-footer">
        <small class="core-pag-info" id="corePaginationInfo">Showing 0 of 0</small>
        <nav>
          <ul class="pagination pagination-sm mb-0" id="corePagination"></ul>
        </nav>
      </div>
    </div>
  </div>


<!-- modal to create/edit core service -->
<div class="modal fade" id="coreServiceModal" tabindex="-1" aria-labelledby="coreServiceModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form id="coreServiceForm" class="modal-content">
      <div class="modal-header au-hero text-white" style="background: linear-gradient(135deg,#0f172a 0%,#1d4ed8 50%,#2563eb 100%) !important;">
        <div class="d-flex align-items-center gap-3">
          <div class="modal-icon"><i class="bi bi-gear"></i></div>
          <div>
            <h5 class="modal-title mb-0" id="coreServiceModalLabel">Core Service</h5>
            <small class="text-white-50">Configure service catalog details</small>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body core-modal-body">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm">
              <div class="card-header bg-white border-bottom-0 p-3">
                <h6 class="mb-0 d-flex align-items-center gap-2"><i class="bi bi-card-text text-primary"></i> Basic Info</h6>
              </div>
              <div class="card-body p-3 d-flex flex-column">
                <div class="mb-3">
                  <label for="coreServiceName" class="form-label">Service Name</label>
                  <div class="input-group">
                    <span class="input-group-text core-input-icon"><i class="bi bi-card-heading"></i></span>
                    <input type="text" id="coreServiceName" name="name" class="form-control" required placeholder="e.g. Standard Cleaning" />
                  </div>
                </div>
                <div class="mb-3">
                  <label for="coreServiceSlug" class="form-label">Slug / Code</label>
                  <div class="input-group">
                    <span class="input-group-text core-input-icon"><i class="bi bi-hash"></i></span>
                    <input type="text" id="coreServiceSlug" name="slug" class="form-control" required placeholder="e.g. std-cleaning" />
                  </div>
                </div>
                <div class="mb-3">
                  <label for="coreServiceCategory" class="form-label">Category</label>
                  <div class="input-group">
                    <span class="input-group-text core-input-icon"><i class="bi bi-folder"></i></span>
                    <input type="text" id="coreServiceCategory" name="category" class="form-control" required placeholder="e.g. Cleaning" />
                  </div>
                </div>
                <div class="mb-0">
                  <label for="coreServiceDescription" class="form-label">Description</label>
                  <div class="input-group">
                    <span class="input-group-text core-input-icon"><i class="bi bi-file-text"></i></span>
                    <textarea id="coreServiceDescription" name="description" class="form-control" rows="3" style="resize: none;" placeholder="Describe the core service..."></textarea>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm">
              <div class="card-header bg-white border-bottom-0 p-3">
                <h6 class="mb-0 d-flex align-items-center gap-2"><i class="bi bi-cash-coin text-success"></i> Pricing &amp; Details</h6>
              </div>
              <div class="card-body p-3 d-flex flex-column">
                <div class="card border-0 bg-light rounded mb-3">
                  <div class="card-body py-2 px-3">
                    <div class="form-check form-switch">
                      <input class="form-check-input" type="checkbox" name="isAirconService" id="isAirconServiceCheckCore" />
                      <label class="form-check-label fw-semibold" for="isAirconServiceCheckCore">Is Aircon Service?</label>
                      <div class="form-text small text-muted mb-0">Enables aircon specific workflows like HP pricing categories.</div>
                    </div>
                  </div>
                </div>

                <div class="mb-3">
                  <label for="coreServiceFeatures" class="form-label">Features (Comma separated)</label>
                  <div class="input-group">
                    <span class="input-group-text core-input-icon"><i class="bi bi-list-stars"></i></span>
                    <textarea id="coreServiceFeatures" name="features" class="form-control" rows="2" maxlength="100" style="resize: none;" placeholder="Feature 1, Feature 2..."></textarea>
                  </div>
                  <div class="form-text small">Maximum 100 characters</div>
                </div>
                <div class="mb-3">
                  <label for="coreServiceIncluded" class="form-label">Included Items (Comma separated)</label>
                  <div class="input-group">
                    <span class="input-group-text core-input-icon"><i class="bi bi-box2-heart"></i></span>
                    <textarea id="coreServiceIncluded" name="includedItems" class="form-control" rows="2" maxlength="100" style="resize: none;" placeholder="Item 1, Item 2..."></textarea>
                  </div>
                  <div class="form-text small">Maximum 100 characters</div>
                </div>
                <div class="mb-3">
                  <label for="coreServiceExclusions" class="form-label">Exclusions (Comma separated)</label>
                  <div class="input-group">
                    <span class="input-group-text core-input-icon"><i class="bi bi-x-octagon"></i></span>
                    <textarea id="coreServiceExclusions" name="exclusions" class="form-control" rows="2" maxlength="100" style="resize: none;" placeholder="Exclusion 1, Exclusion 2..."></textarea>
                  </div>
                  <div class="form-text small">Maximum 100 characters</div>
                </div>

                <div class="card border-0 bg-light rounded mt-3">
                  <div class="card-body py-2 px-3">
                    <div class="form-check form-switch">
                      <input class="form-check-input" type="checkbox" name="active" id="activeCheck" checked />
                      <label class="form-check-label fw-semibold" for="activeCheck">Active in Catalog</label>
                      <div class="form-text small text-muted mb-0">Make this service available for booking.</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-12 d-none" id="airconConfigSection">
            <div class="card border-0 shadow-sm">
              <div class="card-header bg-white d-flex justify-content-between align-items-center border-bottom-0 p-3">
                <h6 class="mb-0 d-flex align-items-center gap-2"><i class="bi bi-snow text-info"></i> Aircon Types &amp; HP Matrix</h6>
                <button type="button" class="btn btn-sm btn-primary fw-bold" id="btnAddAirconType"><i class="bi bi-plus-lg me-1"></i>Add Type</button>
              </div>
              <div class="card-body p-3">
