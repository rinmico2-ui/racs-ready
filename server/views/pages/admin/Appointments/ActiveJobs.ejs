            ${b.approval ? `
            <div class="pm-card" style="border-left:3px solid ${b.approval.status === 'approved' ? '#16a34a' : '#dc2626'};">
              <div class="pm-card-head" style="background:${b.approval.status === 'approved' ? '#f0fdf4' : '#fef2f2'};"><div class="pm-icon" style="background:${b.approval.status === 'approved' ? '#dcfce7' : '#fee2e2'};color:${b.approval.status === 'approved' ? '#16a34a' : '#dc2626'};"><i class="bi ${b.approval.status === 'approved' ? 'bi-check-circle' : 'bi-x-circle'}"></i></div><h3 class="pm-card-title">Customer Approval</h3></div>
              <div class="pm-card-body">
                <div class="pm-row"><span class="pm-lbl">Status</span><span class="pm-val">${b.approval.status === 'approved' ? 'Approved' : b.approval.status === 'declined' ? 'Declined' : 'Pending'}</span></div>
                ${b.approval.decidedAt ? `<div class="pm-row"><span class="pm-lbl">Decided</span><span class="pm-val">${new Date(b.approval.decidedAt).toLocaleString('en-PH')}</span></div>` : ''}
                ${b.approval.reason ? `<div class="pm-row"><span class="pm-lbl">Reason</span><span class="pm-val" style="font-weight:400;">${b.approval.reason}</span></div>` : ''}
              </div>
            </div>` : ''}
          </div>
        </div>` : ''}

        ${allPhotos.length > 0 ? `
        <div style="margin-top:20px;">
          <div class="pm-section-hdr"><i class="bi bi-images" style="color:#0891b2;"></i><span class="pm-section-title">Photos & Proof (${allPhotos.length})</span></div>
          <div class="pm-photo-grid">
            ${allPhotos.map((p, i) => `
