              </select>
              <select class="form-select form-select-sm rounded-pill border-0" style="background:#f4f7fe; color:#2872A1; font-weight:600; width:auto; padding: 4px 12px;">
                <option>Monthly</option>
              </select>
            </div>
          </div>
          <div style="height: 300px; width: 100%;">
            <canvas id="chart-appointments"></canvas>
          </div>
        </div>

        <!-- Secondary Charts Row -->
        <div class="row g-4 mb-4">
          <div class="col-md-6" data-aos="fade-up" data-aos-delay="300">
             <div class="dash-card bg-white" style="height: 100%;">
               <div class="card-header-custom border-0 pb-0">
                  <h6 class="fw-bold m-0" style="color: var(--dash-dark); font-size: 0.95rem;">New Customers</h6>
               </div>
               <div id="new-customers-list" style="padding: 16px 24px;">
                 <div class="dash-list-item" style="padding: 6px 0;">
                   <div class="dash-list-icon shadow-sm" style="border-radius:50%; background: #e0f2fe; color: #0284c7; width: 38px; height: 38px;">
                     <span style="font-weight:700; font-size:0.85rem;">EW</span>
                   </div>
                   <div class="flex-grow-1 ms-3">
                     <div class="item-title" style="font-size:0.9rem;">Elena Wood</div>
                     <div class="item-sub" style="font-size:0.75rem;">Registered today</div>
                   </div>
                   <a href="#" class="btn btn-sm" style="background:var(--dash-primary-light); color:var(--dash-primary); font-size:0.75rem; font-weight:600; border-radius:6px; padding:4px 10px;">View</a>
                 </div>
                 <div class="dash-list-item" style="padding: 6px 0;">
                   <div class="dash-list-icon shadow-sm" style="border-radius:50%; background: #fef08a; color: #a16207; width: 38px; height: 38px;">
                     <span style="font-weight:700; font-size:0.85rem;">RC</span>
                   </div>
                   <div class="flex-grow-1 ms-3">
                     <div class="item-title" style="font-size:0.9rem;">Robert Chen</div>
                     <div class="item-sub" style="font-size:0.75rem;">Registered yesterday</div>
                   </div>
                   <a href="#" class="btn btn-sm" style="background:var(--dash-primary-light); color:var(--dash-primary); font-size:0.75rem; font-weight:600; border-radius:6px; padding:4px 10px;">View</a>
                 </div>
                 <div class="dash-list-item border-0" style="padding: 6px 0;">
                   <div class="dash-list-icon shadow-sm" style="border-radius:50%; background: #f3e8ff; color: #7e22ce; width: 38px; height: 38px;">
                     <span style="font-weight:700; font-size:0.85rem;">MJ</span>
                   </div>
                   <div class="flex-grow-1 ms-3">
                     <div class="item-title" style="font-size:0.9rem;">Maria Johnson</div>
                     <div class="item-sub" style="font-size:0.75rem;">Registered 2 days ago</div>
                   </div>
                   <a href="#" class="btn btn-sm" style="background:var(--dash-primary-light); color:var(--dash-primary); font-size:0.75rem; font-weight:600; border-radius:6px; padding:4px 10px;">View</a>
                 </div>
               </div>
             </div>
          </div>
          <div class="col-md-6" data-aos="fade-up" data-aos-delay="400">
             <div class="dash-card bg-white" style="height: 100%;">
                <div class="card-header-custom border-0 pb-0">
                   <h6 class="fw-bold m-0" style="color: var(--dash-dark); font-size: 0.95rem;">Schedule Overview</h6>
                </div>
                <!-- Mini Calendar -->
                <div id="mini-calendar" class="w-100" style="padding: 24px;">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <span style="font-weight:700;font-size:1rem;color:#1e3a5f">April 2024</span>
                    <div class="d-flex gap-1">
                      <button class="btn btn-sm btn-light rounded-circle p-0" style="width:28px;height:28px; background: #f4f7fe; border: 1px solid #CBDDE9;"><i class="bi bi-chevron-left" style="font-size:.7rem; color:#2872A1;"></i></button>
                      <button class="btn btn-sm btn-light rounded-circle p-0" style="width:28px;height:28px; background: #f4f7fe; border: 1px solid #CBDDE9;"><i class="bi bi-chevron-right" style="font-size:.7rem; color:#2872A1;"></i></button>
                    </div>
                  </div>
                  <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-bottom:8px">
                    <% ['Su','Mo','Tu','We','Th','Fr','Sa'].forEach(d=>{ %>
                      <div style="text-align:center;font-size:.7rem;font-weight:600;color:#a3aed1;padding:2px 0"><%= d %></div>
                    <% }) %>
                  </div>
                  <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px">
                    <% for(var d=1; d<=31; d++){ %>
                      <div class="cal-day<%= d===23?' text-white today':'' %>" style="<%= d===23?'background:#2872A1;border-radius:50%;font-weight:bold;':('color:#1e3a5f;font-weight:500;')%> text-align:center; padding: 6px 0; font-size: 0.85rem;"><%= d %></div>
                    <% } %>
                  </div>
                </div>
             </div>
          </div>
        </div>

      </div><!-- /left -->

      <!-- RIGHT col -->
      <div class="col-xl-4 col-lg-5 d-flex flex-column gap-4" data-aos="fade-left" data-aos-delay="300">

        <!-- Today's Appointments -->
        <div class="dash-card bg-white mb-2">
          <div class="card-header-custom">
            <div>
              <h6 class="fw-bold mb-0" style="color: var(--dash-dark); font-size: 0.95rem;">Today's Appointments</h6>
            </div>
            <span class="status-pill text-primary" style="background:var(--dash-primary-light);">Live</span>
          </div>
          <div id="today-appointments" style="padding: 6px 24px 16px;">
            <div class="dash-list-item">
              <div class="dash-list-icon shadow-sm" style="background: rgba(37,99,235,0.08); color: var(--dash-primary); width: 42px; height: 42px; border: 1px solid rgba(37,99,235,0.15);">
                <i class="bi bi-person-circle"></i>
              </div>
              <div class="flex-grow-1 ms-3">
                <div class="item-title" style="font-size:0.9rem;">John Smith</div>
                <div class="item-sub" style="font-size:0.75rem;"><i class="bi bi-clock me-1"></i>10:00 AM - AC Cleaning</div>
              </div>
              <span class="status-badge status-on-track">Confirmed</span>
            </div>
            <div class="dash-list-item">
              <div class="dash-list-icon shadow-sm" style="background: rgba(34,197,94,0.08); color: var(--dash-success); width: 42px; height: 42px; border: 1px solid rgba(34,197,94,0.15);">
                <i class="bi bi-person-circle"></i>
              </div>
              <div class="flex-grow-1 ms-3">
                <div class="item-title" style="font-size:0.9rem;">Sarah Johnson</div>
                <div class="item-sub" style="font-size:0.75rem;"><i class="bi bi-clock me-1"></i>2:00 PM - Repair Service</div>
              </div>
              <span class="status-badge status-on-track">Confirmed</span>
            </div>
          </div>
        </div>

        <!-- Active Jobs -->
        <div class="dash-card bg-white mb-2">
          <div class="card-header-custom">
            <div>
              <h6 class="fw-bold mb-0" style="color: var(--dash-dark); font-size: 0.95rem;">Active Jobs</h6>
            </div>
            <span class="status-pill text-warning" style="background:#fef3c7;">In Progress</span>
          </div>
          <div id="active-jobs-list" style="padding: 6px 24px 16px;">
            <div class="dash-list-item">
              <div class="dash-list-icon shadow-sm" style="background: rgba(245,158,11,0.08); color: var(--dash-warning); width: 42px; height: 42px; border: 1px solid rgba(245,158,11,0.15);">
                <i class="bi bi-tools"></i>
              </div>
              <div class="flex-grow-1 ms-3">
                <div class="item-title" style="font-size:0.9rem;">Installation Project</div>
                <div class="item-sub" style="font-size:0.75rem;"><i class="bi bi-person-circle me-1"></i>Tech Wilson</div>
              </div>
              <div class="text-end ms-3">
                <div style="font-size:0.75rem; font-weight:700; color:var(--dash-dark);">75%</div>
                <div class="progress mt-1" style="height:5px; width:70px; border-radius:3px; background: #e2e8f0;">
                  <div class="progress-bar bg-success" style="width: 75%; border-radius:3px;"></div>
                </div>
              </div>
            </div>
            <div class="dash-list-item border-0" style="padding-bottom: 0;">
              <div class="dash-list-icon shadow-sm" style="background: rgba(245,158,11,0.08); color: var(--dash-warning); width: 42px; height: 42px; border: 1px solid rgba(245,158,11,0.15);">
                <i class="bi bi-tools"></i>
              </div>
              <div class="flex-grow-1 ms-3">
                <div class="item-title" style="font-size:0.9rem;">Warehouse Ventilation</div>
                <div class="item-sub" style="font-size:0.75rem;"><i class="bi bi-person-circle me-1"></i>Tech Davis</div>
              </div>
              <div class="text-end ms-3">
                <div style="font-size:0.75rem; font-weight:700; color:var(--dash-dark);">30%</div>
                <div class="progress mt-1" style="height:5px; width:70px; border-radius:3px; background: #e2e8f0;">
                  <div class="progress-bar bg-warning" style="width: 30%; border-radius:3px;"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Inventory Alerts -->
        <div class="dash-card bg-white mb-2">
          <div class="card-header-custom">
            <div>
              <h6 class="fw-bold mb-0" style="color: var(--dash-dark); font-size: 0.95rem;">Inventory Alerts</h6>
            </div>
            <span class="status-pill text-danger" style="background:#fee2e2;">Alerts</span>
          </div>
          <div id="lowstock-list" style="padding: 6px 24px 16px;">
