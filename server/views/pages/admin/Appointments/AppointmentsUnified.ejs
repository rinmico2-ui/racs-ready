  AU.Pending.submitReviewReschedule=function(){
    var id=document.getElementById('reviewRescheduleBookingId').value;
    var newDate=document.getElementById('reviewRescheduleDate').value;
    var newTime=document.getElementById('reviewRescheduleTime').value;
    var notes=document.getElementById('reviewRescheduleNotes').value.trim();
    var contactConfirmed=document.getElementById('reviewRescheduleConfirmed').checked;
    if(!newDate||!newTime||!contactConfirmed){showNotification({type:'warning',title:'Confirmation Required',message:'Choose a future schedule and confirm that the customer agreed.',duration:4000});return;}
    var button=document.getElementById('reviewRescheduleSubmit');button.disabled=true;
    fetch('/api/admin/appointments/'+id+'/review-reschedule',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({newDate:newDate,newTime:newTime,notes:notes,contactConfirmed:contactConfirmed})})
    .then(function(r){return r.json().then(function(data){if(!r.ok)throw new Error(data.error||'Failed to update schedule.');return data;});})
    .then(function(data){bootstrap.Modal.getInstance(document.getElementById('reviewRescheduleModal')).hide();showNotification({type:'success',title:'Schedule Updated',message:data.message||'The booking remains Pending Review.',duration:4500});AU.Pending.load();})
    .catch(function(error){showNotification({type:'error',title:'Reschedule Failed',message:error.message,duration:5000});})
    .finally(function(){button.disabled=false;});
