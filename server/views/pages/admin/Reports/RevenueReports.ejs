    charts.serviceEconomics = new Chart(document.getElementById('serviceEconomics'), {
      type: 'bar', data: { labels: ['Core', 'Repair', 'Mix'], datasets: [
        { label: 'Revenue', data: [catRevenue('core'), catRevenue('repair'), catRevenue('mix')], backgroundColor: '#2563eb', borderRadius: 5 },
        { label: 'Known Parts Cost', data: [catPartsCost('core'), catPartsCost('repair'), catPartsCost('mix')], backgroundColor: '#ef4444', borderRadius: 5 },
      ]}, options: { responsive: true, maintainAspectRatio: false, onClick: (e, els) => { if (els.length > 0) showChartDetail(chartConfigs.serviceEconomics, els[0].index, els[0].datasetIndex); }, onHover: (e, els) => { if (e.native) e.native.target.style.cursor = els.length > 0 ? 'pointer' : 'default'; }, scales, plugins: { legend: legendOpts, tooltip: tooltipFmt } }
    });

    // Product channel mix
