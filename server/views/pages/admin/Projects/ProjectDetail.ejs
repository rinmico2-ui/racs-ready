    .recovery-quality { padding:.24rem .48rem; border:1px solid rgba(148,163,184,.35); border-radius:999px; background:#fff; color:#475569; font-size:.6rem; font-weight:800; }
    .recovery-check-conflicts { display:grid; gap:.28rem; margin-top:.65rem; padding-top:.6rem; border-top:1px solid #fecaca; color:#991b1b; font-size:.67rem; }
    .recovery-footer { flex:0 0 auto; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:.75rem; padding:.85rem 1.25rem; border-top:1px solid #dbe3ed; background:#fff; box-shadow:0 -8px 20px rgba(15,23,42,.04); }
    .recovery-gate-state { max-width:500px; font-size:.68rem; color:#64748b; line-height:1.4; }
    .recovery-gate-state.is-ready { color:#166534; font-weight:700; }
    .recovery-footer-actions { display:flex; gap:.5rem; }
    .project-recovery-dialog .pw-btn { min-height:38px; padding:.48rem .8rem; }
    .project-recovery-dialog .pw-btn.primary { min-width:145px; }
    @keyframes adminModalFade { from { opacity:0; } to { opacity:1; } }
    @keyframes adminModalRise { from { opacity:0; transform:translateY(10px) scale(.99); } to { opacity:1; transform:none; } }
    @media(max-width:700px){
      .pw-modal-overlay { padding:.5rem; align-items:flex-end; }
