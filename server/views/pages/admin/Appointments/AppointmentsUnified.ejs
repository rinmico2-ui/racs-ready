  AU.Active={};
  var _actStatus='';

  AU.Active.load=function(){
    var searchEl=document.getElementById('activeSearchInput');
    var search=searchEl?searchEl.value:'';
    Promise.all([
      fetch('/api/admin/appointments/list?stage=active&status='+_actStatus+'&search='+encodeURIComponent(search)+'&limit=50').then(function(r){return r.json();}),
      fetch('/api/admin/appointments/list?stage=active&limit=1000').then(function(r){return r.json();}).catch(function(){return{bookings:[]};})
    ]).then(function(res){
      AU.Active._updateCounts(res[1].bookings||[]);
      var bookings=res[0].bookings||[];
      if(_actStatus){ bookings=bookings.filter(function(b){return b.status===_actStatus;}); }
      AU.Active.renderJobs(bookings);
    }).catch(function(e){console.error(e);});
  };

  AU.Active._updateCounts=function(bookings){
    var counts={all:0,confirmed:0,'on-the-way':0,arrived:0,'in-progress':0};
    bookings.forEach(function(b){counts.all++;if(counts[b.status]!==undefined)counts[b.status]++;});
    document.getElementById('pillAll').textContent=counts.all;
    document.getElementById('pillConfirmed').textContent=counts.confirmed;
    document.getElementById('pillOnWay').textContent=counts['on-the-way'];
    document.getElementById('pillArrived').textContent=counts.arrived;
    document.getElementById('pillProgress').textContent=counts['in-progress'];
    document.getElementById('activeStatTotal').textContent=counts.all;
    document.getElementById('activeStatOngoing').textContent=counts['in-progress']+counts['on-the-way'];
    document.getElementById('activeStatTechs').textContent=new Set(bookings.map(function(b){return b.technicianId;}).filter(Boolean)).size;
  };

