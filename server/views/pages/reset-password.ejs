<style>
  /* ══════════════════════════════════════════════════════════════════════════
     RESET PASSWORD — Enterprise UI (matches auth system)
     ══════════════════════════════════════════════════════════════════════════ */
  :root {
    --reset-primary: #2563eb;
    --reset-primary-hover: #1d4ed8;
    --reset-accent: #7c3aed;
    --reset-surface: rgba(255,255,255,0.97);
    --reset-text: #0f172a;
    --reset-text-secondary: #475569;
    --reset-text-muted: #94a3b8;
    --reset-border: #e2e8f0;
    --reset-error: #ef4444;
    --reset-success: #22c55e;
    --reset-radius: 16px;
    --reset-transition: 0.3s cubic-bezier(0.4,0,0.2,1);
  }

  .reset-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 1100px 750px at 12% -10%, rgba(37,99,235,.28), transparent 62%),
      radial-gradient(ellipse 950px 650px at 88% 108%, rgba(8,145,178,.24), transparent 62%),
      radial-gradient(ellipse 750px 550px at 55% 45%, rgba(109,40,217,.16), transparent 66%),
      linear-gradient(160deg, #020617 0%, #0a1424 48%, #0e1a30 78%, #111f3a 100%);
  }

  /* Animated aurora */
  .reset-page::before {
    content: '';
    position: absolute;
    inset: -25%;
    background:
      radial-gradient(closest-side at 28% 32%, rgba(59,130,246,.20), transparent),
      radial-gradient(closest-side at 72% 62%, rgba(34,211,238,.17), transparent),
      radial-gradient(closest-side at 52% 22%, rgba(20,184,166,.12), transparent);
    filter: blur(70px);
    pointer-events: none;
    animation: resetAurora 22s ease-in-out infinite alternate;
  }
  @keyframes resetAurora {
    0%   { transform: translate3d(-3%, -2%, 0) scale(1); opacity: .95; }
    50%  { transform: translate3d(3%, 2%, 0) scale(1.07); opacity: 1; }
    100% { transform: translate3d(-2%, 3%, 0) scale(1.03); opacity: .9; }
  }

  /* Grid overlay */
  .reset-page::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(148,163,184,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148,163,184,.06) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(ellipse 95% 85% at 50% 42%, #000 25%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 95% 85% at 50% 42%, #000 25%, transparent 100%);
  }

  /* Card */
  .reset-card {
    width: 100%;
    max-width: 460px;
    background: var(--reset-surface);
    border: 1px solid rgba(148,163,184,0.22);
    border-radius: var(--reset-radius);
    box-shadow:
      0 24px 64px rgba(2,6,23,.5),
      0 8px 24px rgba(2,6,23,.35),
      inset 0 1px 0 rgba(255,255,255,.9);
    padding: 40px 36px;
    position: relative;
    z-index: 1;
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    animation: resetCardEnter .5s cubic-bezier(.4,0,.2,1) both;
  }
  .reset-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 3px;
    border-radius: 0 0 4px 4px;
    background: linear-gradient(90deg, transparent, var(--reset-primary), #06b6d4, transparent);
    opacity: .85;
  }
  @keyframes resetCardEnter {
    from { opacity: 0; transform: translateY(16px) scale(.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (max-width: 480px) {
    .reset-card { padding: 32px 20px; border-radius: 14px; }
  }

  /* Header */
  .reset-header {
    text-align: center;
    margin-bottom: 28px;
  }
  .reset-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 20px;
  }
  .reset-logo-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--reset-primary), var(--reset-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: #fff;
    box-shadow: 0 8px 24px rgba(37,99,235,.3);
    transition: var(--reset-transition);
  }
  .reset-logo:hover .reset-logo-icon {
    transform: scale(1.06) rotate(-4deg);
  }
  .reset-logo-text {
    font-size: 18px;
    font-weight: 800;
    color: var(--reset-text);
    letter-spacing: -.02em;
  }
  .reset-icon-ring {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(37,99,235,0.12), rgba(124,58,237,0.08));
    border: 2px solid rgba(37,99,235,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
    animation: resetIconPulse 2s ease-in-out infinite;
  }
  @keyframes resetIconPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(37,99,235,0.2); }
    50% { box-shadow: 0 0 0 12px rgba(37,99,235,0); }
  }
  .reset-icon-ring i {
    font-size: 2rem;
    background: linear-gradient(135deg, var(--reset-primary), var(--reset-accent));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .reset-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--reset-text);
    margin: 0 0 8px;
    letter-spacing: -.02em;
  }
  .reset-subtitle {
    font-size: 0.9rem;
    color: var(--reset-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  /* Alert */
  .reset-alert {
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 0.85rem;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .reset-alert.error {
    background: rgba(239,68,68,0.1);
    border: 1px solid rgba(239,68,68,0.2);
    color: #dc2626;
  }
  .reset-alert.success {
    background: rgba(34,197,94,0.1);
    border: 1px solid rgba(34,197,94,0.2);
    color: #16a34a;
  }

  /* Fields */
  .reset-field {
    margin-bottom: 18px;
  }
  .reset-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--reset-text-secondary);
    margin-bottom: 6px;
    letter-spacing: .02em;
  }
  .reset-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .reset-input {
    width: 100%;
    padding: 12px 14px 12px 42px;
    border: 1.5px solid rgba(226,232,240,0.7);
    border-radius: 10px;
    font-size: 0.95rem;
    color: var(--reset-text);
    background: rgba(255,255,255,0.8);
    backdrop-filter: blur(8px);
    outline: none;
    transition: var(--reset-transition);
  }
  .reset-input:focus {
    border-color: var(--reset-primary);
    box-shadow: 0 0 0 3px rgba(37,99,235,0.1), 0 0 12px rgba(37,99,235,.08);
    background: rgba(255,255,255,0.95);
  }
  .reset-input::placeholder {
    color: var(--reset-text-muted);
    font-size: 0.88rem;
  }
  .reset-input.error {
    border-color: var(--reset-error);
    box-shadow: 0 0 0 3px rgba(239,68,68,0.1);
  }
  .reset-input.success {
    border-color: var(--reset-success);
    box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
  }
  .reset-field-icon {
    position: absolute;
    left: 14px;
    color: var(--reset-text-muted);
    font-size: 1rem;
    pointer-events: none;
    transition: var(--reset-transition);
  }
  .reset-input:focus ~ .reset-field-icon {
    color: var(--reset-primary);
  }
  .reset-toggle {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    color: var(--reset-text-muted);
    cursor: pointer;
    padding: 4px;
    font-size: 1.1rem;
    transition: var(--reset-transition);
  }
  .reset-toggle:hover {
    color: var(--reset-primary);
  }
  .reset-feedback {
    font-size: 0.75rem;
    margin-top: 4px;
    min-height: 18px;
  }
  .reset-feedback.error {
    color: var(--reset-error);
  }
  .reset-feedback.success {
    color: var(--reset-success);
  }

  /* Captcha */
  .reset-captcha {
    background: rgba(248,250,252,0.9);
    border: 1px solid rgba(226,232,240,0.6);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 18px;
  }
  .reset-captcha-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .reset-captcha-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--reset-text-muted);
    text-transform: uppercase;
    letter-spacing: .5px;
  }
  .reset-captcha-refresh {
    background: none;
    border: none;
    color: var(--reset-text-muted);
    cursor: pointer;
    padding: 6px;
    border-radius: 6px;
    font-size: 1rem;
    transition: var(--reset-transition);
  }
  .reset-captcha-refresh:hover {
    color: var(--reset-primary);
    background: rgba(37,99,235,0.08);
  }
  .reset-captcha-equation {
    font-size: 1.35rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--reset-primary), #0891b2);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 12px;
    text-align: center;
    letter-spacing: .04em;
  }

  /* Password Strength */
  .reset-strength-meter {
    height: 4px;
    background: var(--reset-border);
    border-radius: 2px;
    margin: 10px 0 6px;
    overflow: hidden;
  }
  .reset-strength-bar {
    height: 100%;
    width: 0%;
    border-radius: 2px;
    transition: width 0.3s ease, background 0.3s ease;
  }
  .reset-strength-bar.weak { width: 25%; background: var(--reset-error); }
  .reset-strength-bar.fair { width: 50%; background: #f59e0b; }
  .reset-strength-bar.good { width: 75%; background: #3b82f6; }
  .reset-strength-bar.strong { width: 100%; background: var(--reset-success); }
  .reset-strength-label {
    font-size: 0.72rem;
    font-weight: 600;
    min-height: 16px;
    transition: color 0.3s ease;
  }

  /* Password Rules */
  .reset-rules {
    margin-top: 10px;
  }
  .reset-rules-title {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--reset-text-muted);
    margin-bottom: 8px;
  }
  .reset-rules-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .reset-rules-list li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--reset-text-muted);
    transition: color 0.2s ease;
  }
  .reset-rules-list li i {
    font-size: 0.5rem;
    transition: all 0.2s ease;
  }
  .reset-rules-list li.met {
    color: var(--reset-success);
  }
  .reset-rules-list li.met i::before {
    content: "\F26B";
  }

  /* Field validation icons (JS compatibility) */
  .field-icon {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1rem;
    z-index: 5;
  }
  .field-icon.success-icon { color: var(--reset-success); }
  .field-icon.error-icon { color: var(--reset-error); }
  .reset-input-wrap.input-group { position: relative; }
  .reset-input-wrap.input-group .reset-input { padding-right: 40px; }

  /* Submit Button */
  .reset-submit {
    width: 100%;
    padding: 14px;
    background: linear-gradient(135deg, var(--reset-primary), var(--reset-accent));
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: var(--reset-transition);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(37,99,235,.3);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 6px;
  }
  .reset-submit::before {
    content: '';
    position: absolute;
    top: 0;
    left: -80%;
    width: 60%;
    height: 100%;
    background: linear-gradient(105deg, transparent, rgba(255,255,255,.25), transparent);
    transform: skewX(-20deg);
    transition: left .5s ease;
  }
  .reset-submit:hover::before {
    left: 130%;
  }
  .reset-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37,99,235,.4);
  }
  .reset-submit:active {
    transform: translateY(0);
  }
  .reset-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }
  .reset-submit.loading {
    color: transparent;
  }
  .reset-submit.loading::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2.5px solid rgba(255,255,255,.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: resetSpin .6s linear infinite;
  }
  @keyframes resetSpin {
    to { transform: rotate(360deg); }
  }

  /* Footer */
  .reset-footer {
    text-align: center;
    margin-top: 20px;
    font-size: 0.88rem;
    color: var(--reset-text-secondary);
  }
  .reset-link {
    color: var(--reset-primary);
    text-decoration: none;
    font-weight: 600;
    transition: var(--reset-transition);
  }
  .reset-link:hover {
    color: var(--reset-primary-hover);
    text-decoration: underline;
  }

  /* Success State */
  .reset-success {
    text-align: center;
    padding: 20px 0;
  }
  .reset-success-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(34,197,94,0.15), rgba(34,197,94,0.05));
    border: 2px solid rgba(34,197,94,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    animation: resetSuccessPop 0.5s cubic-bezier(.4,0,.2,1);
  }
  @keyframes resetSuccessPop {
    0% { transform: scale(0.5); opacity: 0; }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); opacity: 1; }
  }
  .reset-success-icon i {
    font-size: 2.5rem;
    color: var(--reset-success);
  }
  .reset-success h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--reset-text);
    margin: 0 0 10px;
  }
  .reset-success p {
    font-size: 0.92rem;
    color: var(--reset-text-secondary);
    margin: 0 0 28px;
    line-height: 1.6;
  }
</style>

<div class="reset-page">
  <div class="reset-card">

    <!-- Header -->
    <div class="reset-header">
      <a href="/" class="reset-logo">
        <div class="reset-logo-icon"><i class="bi bi-shield-lock-fill"></i></div>
        <span class="reset-logo-text">CALIDRO RACS</span>
      </a>
      <div class="reset-icon-ring">
        <i class="bi bi-key-fill"></i>
      </div>
      <h1 class="reset-title">Create new password</h1>
      <p class="reset-subtitle">Your new password must be different from previously used passwords.</p>
    </div>

    <!-- Alert -->
    <div id="resetAlert" class="reset-alert d-none" role="alert"></div>

    <!-- Form -->
    <form id="resetForm" action="/api/auth/reset-password" method="POST" autocomplete="on" novalidate>
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
      <input type="hidden" name="token" value="<%= token %>" />

      <!-- Email -->
      <div class="reset-field">
        <label for="email" class="reset-label">Email address</label>
        <div class="reset-input-wrap input-group">
          <input id="email" name="email" type="email" class="reset-input form-control" placeholder="you@company.com" required autocomplete="email" maxlength="50" />
          <i class="bi bi-envelope reset-field-icon"></i>
          <span class="field-icon success-icon d-none"><i class="bi bi-check-circle-fill"></i></span>
          <span class="field-icon error-icon d-none"><i class="bi bi-exclamation-circle-fill"></i></span>
        </div>
        <div class="reset-feedback" id="emailFeedback"></div>
      </div>

      <!-- Captcha -->
      <div class="reset-captcha math-captcha">
        <div class="reset-captcha-header">
          <span class="reset-captcha-label"><i class="bi bi-shield-check me-1"></i>Verify you're human</span>
          <button type="button" class="reset-captcha-refresh refresh-captcha" title="New captcha"><i class="bi bi-arrow-clockwise"></i></button>
        </div>
        <div class="reset-captcha-equation captcha-equation" id="resetEquation"><%= num1 %> + <%= num2 %> = ?</div>
        <div class="reset-input-wrap input-group">
          <input id="reset-math" name="mathCaptcha" type="text" inputmode="numeric" pattern="[0-9]{1,3}" maxlength="3" class="reset-input form-control" placeholder="Enter the sum" required oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
          <i class="bi bi-calculator reset-field-icon"></i>
          <span class="field-icon success-icon d-none"><i class="bi bi-check-circle-fill"></i></span>
          <span class="field-icon error-icon d-none"><i class="bi bi-exclamation-circle-fill"></i></span>
        </div>
        <input type="hidden" name="mathAnswer" value="<%= mathAnswer %>" />
        <div class="reset-feedback" id="captchaFeedback"></div>
      </div>

      <!-- New Password -->
      <div class="reset-field">
        <label for="password" class="reset-label">New password</label>
        <div class="reset-input-wrap">
          <input id="password" name="password" type="password" class="reset-input" placeholder="Enter your new password" required autocomplete="new-password" maxlength="30" style="padding-right:44px;" />
          <i class="bi bi-lock reset-field-icon"></i>
          <button class="reset-toggle" type="button" id="togglePasswordReset" aria-label="Toggle password visibility"><i class="bi bi-eye"></i></button>
        </div>
        <div class="reset-strength-meter">
          <div class="reset-strength-bar" id="pwStrengthBar"></div>
        </div>
        <div class="reset-strength-label" id="pwStrengthLabel"></div>
        <div class="reset-rules" id="reset-password-suggestions">
          <div class="reset-rules-title">Password must contain:</div>
          <ul class="reset-rules-list">
            <li data-rule="letter"><i class="bi bi-circle"></i><span>1 uppercase letter</span></li>
            <li data-rule="digitOrSpecial"><i class="bi bi-circle"></i><span>1 number or symbol</span></li>
            <li data-rule="length"><i class="bi bi-circle"></i><span>8+ characters</span></li>
          </ul>
        </div>
      </div>

      <!-- Confirm Password -->
      <div class="reset-field">
        <label for="confirmPassword" class="reset-label">Confirm password</label>
        <div class="reset-input-wrap">
          <input id="confirmPassword" name="confirmPassword" type="password" class="reset-input" placeholder="Re-enter your new password" required autocomplete="new-password" maxlength="30" style="padding-right:44px;" />
          <i class="bi bi-shield-lock reset-field-icon"></i>
          <button class="reset-toggle" type="button" id="toggleConfirmPasswordReset" aria-label="Toggle confirm password visibility"><i class="bi bi-eye"></i></button>
        </div>
        <div class="reset-feedback" id="confirmFeedback"></div>
      </div>

      <!-- Submit -->
      <button id="resetBtn" class="reset-submit" type="submit">
        <i class="bi bi-check-circle-fill"></i>
        <span class="btn-text">Reset Password</span>
      </button>

      <!-- Footer -->
      <div class="reset-footer">
        Remembered your password? <a href="/login" class="reset-link">Back to login</a>
      </div>
    </form>

    <!-- Success State -->
    <div id="resetSuccess" class="reset-success d-none">
      <div class="reset-success-icon"><i class="bi bi-check-lg"></i></div>
      <h2>Password reset successful!</h2>
      <p>Your password has been updated. You can now sign in with your new password.</p>
      <a href="/login" class="reset-submit" style="text-decoration:none;display:inline-flex;width:auto;padding:14px 32px;">
        <i class="bi bi-box-arrow-in-right"></i>
        <span>Sign In</span>
      </a>
    </div>

  </div>
</div>

