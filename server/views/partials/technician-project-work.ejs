  .pw-wo-card::before { border-radius: 3px 0 0 3px; width: 4px; }

  /* Daily banner */
  .pw-daily-banner {
    border-radius: 14px;
    padding: 1rem 1.15rem;
    border: 1px solid #fde68a;
    background: linear-gradient(135deg, #fffbeb, #fef3c7);
  }
  .pw-daily-banner .ic { border-radius: 11px; }

  /* Schedule banner */
  .pw-schedule-banner {
    border-radius: 14px;
    padding: 1rem 1.15rem;
    border: 1px solid #bfdbfe;
    background: linear-gradient(135deg, #eff6ff, #f0fdf4);
  }

  /* Modal */
  .pw-modal { border-radius: 20px; padding: 0; overflow: hidden; }
  .sm-header {
    background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #d1fae5;
  }
  .sm-header-icon { border-radius: 14px; }

  /* Empty state */
  .pw-empty { border-radius: 18px; padding: 3.5rem 1.25rem; border: 1px dashed #cbd5e1; }
  .pw-empty i { font-size: 2.4rem; margin-bottom: 0.85rem; color: #94a3b8; }
</style>

<div class="pw-wrap" id="pwRoot">
  <div class="pw-hero">
    <span class="eyebrow"><i class="bi bi-kanban"></i> Field Operations</span>
    <h2>Large-Scale Projects</h2>
    <div class="sub">Your assigned commercial projects. The lead technician mobilizes the crew — focus on today's assignment while the office handles planning and scheduling.</div>
  </div>
  <!-- Status Filter Tabs (mirrors Standard Bookings tabs) -->
  <div class="pw-filters" id="pwFilters" style="display:flex;gap:0;background:#f1f5f9;padding:3px;border-radius:12px;width:fit-content;border:1px solid #e2e8f0;margin-bottom:1rem;flex-wrap:wrap;">
    <button class="pw-filter-btn active" data-pwf="all" onclick="pwFilterCards('all')" style="border:none;background:#fff;color:#0f172a;font-weight:700;font-size:0.72rem;padding:0.4rem 0.9rem;border-radius:9px;cursor:pointer;display:flex;align-items:center;gap:0.35rem;box-shadow:0 1px 3px rgba(15,23,42,.06);transition:all .2s;">
      <i class="bi bi-list-ul" style="font-size:.75rem;"></i> All <span class="pw-filter-count" data-fc="all" style="background:#e2e8f0;color:#475569;border-radius:6px;padding:0 5px;font-size:.65rem;font-weight:700;">0</span>
    </button>
    <button class="pw-filter-btn" data-pwf="pending" onclick="pwFilterCards('pending')" style="border:none;background:transparent;color:#64748b;font-weight:600;font-size:0.72rem;padding:0.4rem 0.9rem;border-radius:9px;cursor:pointer;display:flex;align-items:center;gap:0.35rem;transition:all .2s;">
      <i class="bi bi-clock" style="font-size:.75rem;"></i> Pending <span class="pw-filter-count" data-fc="pending" style="background:#e2e8f0;color:#475569;border-radius:6px;padding:0 5px;font-size:.65rem;font-weight:700;">0</span>
    </button>
    <button class="pw-filter-btn" data-pwf="active" onclick="pwFilterCards('active')" style="border:none;background:transparent;color:#64748b;font-weight:600;font-size:0.72rem;padding:0.4rem 0.9rem;border-radius:9px;cursor:pointer;display:flex;align-items:center;gap:0.35rem;transition:all .2s;">
      <i class="bi bi-lightning-charge" style="font-size:.75rem;"></i> Active <span class="pw-filter-count" data-fc="active" style="background:#e2e8f0;color:#475569;border-radius:6px;padding:0 5px;font-size:.65rem;font-weight:700;">0</span>
    </button>
    <button class="pw-filter-btn" data-pwf="completed" onclick="pwFilterCards('completed')" style="border:none;background:transparent;color:#64748b;font-weight:600;font-size:0.72rem;padding:0.4rem 0.9rem;border-radius:9px;cursor:pointer;display:flex;align-items:center;gap:0.35rem;transition:all .2s;">
      <i class="bi bi-check-circle" style="font-size:.75rem;"></i> Completed <span class="pw-filter-count" data-fc="completed" style="background:#e2e8f0;color:#475569;border-radius:6px;padding:0 5px;font-size:.65rem;font-weight:700;">0</span>
    </button>
    <button class="pw-filter-btn" data-pwf="declined" onclick="pwFilterCards('declined')" style="border:none;background:transparent;color:#64748b;font-weight:600;font-size:0.72rem;padding:0.4rem 0.9rem;border-radius:9px;cursor:pointer;display:flex;align-items:center;gap:0.35rem;transition:all .2s;">
      <i class="bi bi-x-circle" style="font-size:.75rem;"></i> Declined <span class="pw-filter-count" data-fc="declined" style="background:#e2e8f0;color:#475569;border-radius:6px;padding:0 5px;font-size:.65rem;font-weight:700;">0</span>
    </button>
  </div>
  <div id="pwContainer">
    <div class="text-center py-5">
      <div class="spinner-border" style="width:2rem;height:2rem;border-width:.2rem;color:var(--pw-brand);"></div>
      <div style="margin-top:.75rem;font-size:.8rem;color:var(--pw-muted);font-weight:500;">Loading projects...</div>
    </div>
  </div>
</div>

<!-- Slide-in details drawer — matches standard booking detail panel -->
<div class="pw-drawer-overlay" id="pwDrawerOverlay" onclick="pwCloseDrawer()"></div>
<aside class="pw-drawer" id="pwDrawer" aria-hidden="true">
  <div class="pw-d-hero">
    <div class="pw-d-top">
      <div class="pw-d-top-left">
        <button class="pw-d-back" onclick="pwCloseDrawer()" title="Back to projects">
          <i class="bi bi-arrow-left"></i>
          <span>Back to projects</span>
        </button>
        <div class="pw-d-avatar" id="pwDrawerAvatar"><i class="bi bi-person"></i></div>
        <div style="min-width:0;">
          <h2 class="pw-d-title" id="pwDrawerTitle">Project Details</h2>
          <div class="pw-d-subtitle">
            <span class="pw-d-ref" id="pwDrawerRef">Project #---</span>
            <span class="pw-d-status" id="pwDrawerStatus">Status</span>
          </div>
        </div>
      </div>
      <button class="pw-d-close" onclick="pwCloseDrawer()" aria-label="Close"><i class="bi bi-x-lg" style="font-size:0.75rem;"></i></button>
    </div>
  </div>
  <div class="pw-d-workflow" id="pwDrawerWorkflow">
    <div class="pw-d-wo-hero" id="pwDrawerWfHero"><i class="bi bi-kanban"></i><div style="min-width:0;"><div id="pwDrawerWfTitle">Large-Scale Project</div><div class="pw-d-wo-meta" id="pwDrawerWfMeta">Project workflow</div></div></div>
    <div class="pw-d-steps" id="pwDrawerSteps"></div>
  </div>
  <div class="pw-d-body" id="pwDrawerBody"></div>
  <div class="pw-d-actions" id="pwDrawerActions"></div>
</aside>

<script>
(function () {
  const qs = (s) => document.querySelector(s);
  const API = '/api/technician/projects';
  let ME_ID = null;
  let PW_ASSIGNMENTS = [];
  let PW_CURRENT_FILTER = 'all';

  const STATUS_LABEL = { assigned:'Waiting', accepted:'Accepted', en_route:'En Route', arrived:'Arrived', in_progress:'Working', completed:'Done' };
  const PHASE_LABEL = { assessment:'Site Assessment', quotation_review:'Quotation Review', ready:'Ready to Mobilize', en_route:'En Route', arrived:'Arrived', execution:'Execution', in_progress:'On Site — Working', daily_acceptance:'Daily Confirmation', completed:'Completed' };

  function esc(s){ return (s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
  function fmt(d){ if(!d) return 'TBD'; const x=new Date(d); return x.toLocaleDateString('en-PH',{month:'short',day:'numeric'}); }
  function fmtFull(d){ if(!d) return 'TBD'; const x=new Date(d); return x.toLocaleDateString('en-PH',{weekday:'short',month:'short',day:'numeric',year:'numeric'}); }
  function fmtShort(d){ if(!d) return ''; const x=new Date(d); return x.toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}); }
  function money(n){ return '₱' + (Number(n||0)).toLocaleString('en-PH',{maximumFractionDigits:2}); }
  function isToday(d){ if(!d) return false; const x=new Date(d), t=new Date(); return x.toDateString()===t.toDateString(); }
  function isPast(d){ if(!d) return false; return new Date(d) < new Date(new Date().toDateString()); }

  function toast(msg, type = 'success') {
    let t = qs('#pwToast');
    if (!t) { t = document.createElement('div'); t.id = 'pwToast'; t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;padding:.7rem 1.1rem;border-radius:12px;font-weight:600;font-size:.8rem;color:#fff;display:flex;align-items:center;gap:.5rem;box-shadow:0 8px 24px rgba(15,23,42,.15);font-family:Inter,system-ui,-apple-system,sans-serif;'; document.body.appendChild(t); }
    t.style.background = type === 'error' ? 'linear-gradient(135deg,#dc2626,#ef4444)' : 'linear-gradient(135deg,#059669,#10b981)';
    t.innerHTML = `<i class="bi ${type === 'error' ? 'bi-exclamation-circle-fill' : 'bi-check-circle-fill'}"></i>${msg}`;
    t.style.display = 'flex';
    t.style.animation = 'pwSlideUp .25s cubic-bezier(.4,0,.2,1)';
    setTimeout(() => { t.style.display = 'none'; }, 3200);
  }

  async function api(path, opts) {
    const r = await fetch(path, opts);
    const data = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(data.error || 'Request failed');
    return data;
  }

  // ── Live GPS post (shared by every en-route) ──
  function postLocation() {
    if (!navigator.geolocation) return;
    navigator.geolocation.getCurrentPosition(async (pos) => {
      try { await fetch('/api/technician/location', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude }) }); } catch (_) {}
    }, () => {}, { enableHighAccuracy: true, timeout: 8000 });
  }

  window.__loadProjectWork = async function () {
    try {
      try { const me = await (await fetch('/api/auth/verify')).json(); ME_ID = me.user?.technicianId || me.user?._id || null; } catch (_) {}
      const data = await api(API);
      if (data && data.me) ME_ID = data.me;
      const assignments = data.assignments || [];
      PW_ASSIGNMENTS = assignments;
      if (assignments.length === 0) {
        qs('#pwContainer').innerHTML = '<div class="pw-empty"><i class="bi bi-folder2-open"></i>You have no large-scale project assignments yet.</div>';
        pwUpdateCounts([]);
        return;
      }
      pwUpdateCounts(assignments);
      pwRenderCards(PW_CURRENT_FILTER);
    } catch (e) {
      qs('#pwContainer').innerHTML = '<div class="pw-empty text-danger">Failed to load project work.</div>';
    }
  };

  function pwProjectFilterStatus(a) {
    const phase = a.phase || 'ready';
    if (a.leadDeclinedReason || (a.teamBoard || []).some(t => t.acknowledge === 'declined')) return 'declined';
    if (phase === 'completed') return 'completed';
    if (phase === 'in_progress' || phase === 'en_route' || phase === 'arrived' || phase === 'daily_acceptance' || phase === 'execution') return 'active';
    if (phase === 'assessment' || phase === 'quotation_review') return 'active';
    if (phase === 'ready' || a.leadAccepted === false) return 'pending';
    return 'active';
  }

  function pwUpdateCounts(assignments) {
    const counts = { all: assignments.length, pending: 0, active: 0, completed: 0, declined: 0 };
    for (const a of assignments) {
      const s = pwProjectFilterStatus(a);
      if (counts[s] !== undefined) counts[s]++;
    }
    document.querySelectorAll('.pw-filter-count').forEach(el => {
      const f = el.dataset.fc;
      if (counts[f] !== undefined) el.textContent = counts[f];
    });
  }

  window.pwFilterCards = function (filter) {
    PW_CURRENT_FILTER = filter;
    document.querySelectorAll('.pw-filter-btn').forEach(b => {
      const active = b.dataset.pwf === filter;
      b.classList.toggle('active', active);
      b.style.background = active ? '#fff' : 'transparent';
      b.style.color = active ? '#0f172a' : '#64748b';
      b.style.fontWeight = active ? '700' : '600';
      b.style.boxShadow = active ? '0 1px 3px rgba(15,23,42,.06)' : 'none';
    });
    pwRenderCards(filter);
  };

  function pwRenderCards(filter) {
    const filtered = filter === 'all' ? PW_ASSIGNMENTS : PW_ASSIGNMENTS.filter(a => pwProjectFilterStatus(a) === filter);
    if (filtered.length === 0) {
      qs('#pwContainer').innerHTML = '<div class="pw-empty"><i class="bi bi-folder2-open"></i>No projects in this category.</div>';
      return;
    }
    const parts = [];
    for (const a of filtered) {
      const isLead = !!a.isLead;
      const myAck = (a.teamBoard || []).find(t => t._id && ME_ID && t._id.toString() === ME_ID.toString());
      const acknowledged = myAck ? myAck.acknowledge === 'acknowledged' : false;
      const myDeclined = myAck ? myAck.acknowledge === 'declined' : false;
      if (isLead) parts.push(renderLeadCard(a));
      else parts.push(renderMemberCard(a, acknowledged, myDeclined));
    }
    qs('#pwContainer').innerHTML = parts.join('');
  }

  // ════════════════════ LEAD CARD ════════════════════
  function renderLeadCard(a) {
    const p = a.project;
    const phase = a.phase || 'ready';

    if (!a.leadParticipationAccepted) {
      const canAccept = a.canLeadAccept === true;
      const blocker = a.leadAcceptanceBlocker || 'Project preparation must be completed by operations.';
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Assigned to you (Lead)', 'assigned', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, true)}
          <div class="pw-wait mt-3">
            <div class="ic"><i class="bi bi-clipboard-check"></i></div>
            <div><div class="t">${canAccept ? 'Review & accept team participation' : 'Project acceptance is not available yet'}</div><div class="d">${canAccept ? 'Confirm that you can join this project. This does not start work or release Work Orders.' : blocker}</div></div>
          </div>
          <div class="d-flex gap-2 mt-3">
            ${canAccept ? `<button class="pw-btn primary" onclick="pwLeadAccept('${p._id}', this)"><i class="bi bi-check-lg"></i> Accept Participation</button>` : `<button class="pw-btn" disabled><i class="bi bi-hourglass-split"></i> Awaiting Verification</button>`}
            <button class="pw-btn danger" onclick="pwLeadDecline('${p._id}')"><i class="bi bi-x-circle"></i> Decline</button>
            <button class="pw-link ms-auto" onclick="pwViewDetails('${p._id}')">View Details</button>
          </div>
        </div>
      ${pwCardClose()}`;
    }

    if (!a.leadAccepted && p.status !== 'ready') {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Participation accepted', 'accepted', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, true)}
          <div class="pw-wait mt-3"><div class="ic"><i class="bi bi-check-circle"></i></div><div><div class="t">Your participation is confirmed</div><div class="d">Operations is completing the final plan. Work Orders remain provisional until Step 6 confirmation.</div></div></div>
          <div class="d-flex gap-2 mt-3"><button class="pw-link" onclick="pwViewDetails('${p._id}')">View Planning Details</button></div>
        </div>
      ${pwCardClose()}`;
    }

    if (!a.leadAccepted && p.status === 'ready') {
      const canStart = a.canLeadAccept === true;
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Final plan confirmed', 'ready', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, true)}
          <div class="pw-wait mt-3"><div class="ic"><i class="bi bi-play-circle"></i></div><div><div class="t">Project is ready to mobilize</div><div class="d">${canStart ? 'The final plan is committed. Start the project when the crew is ready.' : (a.leadAcceptanceBlocker || 'Waiting for the complete team.')}</div></div></div>
          <div class="d-flex gap-2 mt-3">${canStart ? `<button class="pw-btn primary" onclick="pwLeadAccept('${p._id}', this)"><i class="bi bi-play-fill"></i> Start Project</button>` : `<button class="pw-btn" disabled>Awaiting Team</button>`}<button class="pw-link ms-auto" onclick="pwViewDetails('${p._id}')">View Details</button></div>
        </div>
      ${pwCardClose()}`;
    }

    if (!a.allAccepted) {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Accepted — awaiting team', 'accepted', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, true)}
          <div class="pw-wait mt-3">
            <div class="ic"><i class="bi bi-people"></i></div>
            <div><div class="t">Waiting for team members to accept</div><div class="d">${teamAcceptStatus(a)}</div></div>
          </div>
          <div class="d-flex gap-2 mt-3">
            <button class="pw-link" onclick="pwViewDetails('${p._id}')">View Details</button>
          </div>
        </div>
      ${pwCardClose()}`;
    }

    // ── Phase 1: Site Assessment ──
    if (phase === 'assessment') {
      const report = p.inspectionReport || {};
      const hasSubmitted = report.submittedAt;
      const unitGroups = p.unitGroups || [];
      const hasMultipleTypes = unitGroups.length > 1;
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Phase 1 — Site Assessment', 'assessment', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, true)}
          ${hasSubmitted ? `
          <div class="pw-wait mt-3">
            <div class="ic"><i class="bi bi-check-circle-fill" style="color:#059669;"></i></div>
            <div><div class="t">Inspection submitted</div><div class="d">Awaiting admin review of your quotation.</div></div>
          </div>
          <div class="pw-report-box mt-3">
            <div style="font-size:0.78rem;font-weight:700;color:#0f172a;margin-bottom:.4rem;"><i class="bi bi-clipboard-data me-1"></i>Your Inspection Report</div>
            <div style="font-size:.75rem;color:#475569;background:#f8fafc;padding:.6rem .8rem;border-radius:8px;border:1px solid #e2e8f0;">
              <div><b>Findings:</b> ${esc(report.findings || '—')}</div>
              <div><b>Notes:</b> ${esc(report.notes || '—')}</div>
              ${report.submittedAt ? `<div style="margin-top:.3rem;color:#94a3b8;font-size:.7rem;">Submitted ${new Date(report.submittedAt).toLocaleString()}</div>` : ''}
            </div>
          </div>
          ${hasMultipleTypes ? `
          <div class="pw-report-box mt-2">
            <div style="font-size:0.78rem;font-weight:700;color:#0f172a;margin-bottom:.4rem;"><i class="bi bi-grid-3x3 me-1"></i>Per-Appliance Inspection</div>
            ${unitGroups.map(g => `
            <div style="font-size:.73rem;color:#475569;background:#f0fdf4;padding:.5rem .7rem;border-radius:6px;border:1px solid #bbf7d0;margin-bottom:.4rem;">
              <div style="font-weight:600;color:#166534;">${esc(g.unitType)}${g.brand ? ' (' + esc(g.brand) + ')' : ''} — ${g.quantity} unit(s)</div>
              ${g.inspection && g.inspection.findings ? `<div style="margin-top:.2rem;"><b>Findings:</b> ${esc(g.inspection.findings)}</div>` : '<div style="margin-top:.2rem;color:#94a3b8;">Inspection pending</div>'}
              ${g.quotation && g.quotation.totalCost > 0 ? `<div><b>Quotation:</b> ₱${g.quotation.totalCost.toLocaleString()}</div>` : ''}
            </div>
            `).join('')}
          </div>
          ` : ''}
          ` : `
          <div class="pw-wait mt-3">
            <div class="ic"><i class="bi bi-clipboard-data"></i></div>
            <div><div class="t">Inspect the site</div><div class="d">Visit the site, assess all units, and submit your inspection report with a quotation for admin approval.</div></div>
          </div>
          ${hasMultipleTypes ? `
          <div class="pw-report-box mt-3">
            <div style="font-size:0.78rem;font-weight:700;color:#0f172a;margin-bottom:.4rem;"><i class="bi bi-grid-3x3 me-1"></i>Appliance Groups to Inspect</div>
            ${unitGroups.map(g => `
            <div style="font-size:.73rem;color:#475569;background:#fffbeb;padding:.5rem .7rem;border-radius:6px;border:1px solid #fde68a;margin-bottom:.4rem;">
              <div style="font-weight:600;color:#92400e;">${esc(g.unitType)}${g.brand ? ' (' + esc(g.brand) + ')' : ''} — ${g.quantity} unit(s)</div>
              <div style="margin-top:.15rem;color:#a16207;">${esc(g.problemDescription || g.repairIssue || 'No issue description')}</div>
            </div>
            `).join('')}
          </div>
          ` : ''}
          <button class="pw-btn primary mt-3" onclick="pwSubmitInspection('${p._id}')"><i class="bi bi-file-earmark-text"></i> Submit Inspection Report</button>
          `}
          <button class="pw-link ms-3 mt-3" onclick="pwViewDetails('${p._id}')">View Details</button>
        </div>
      ${pwCardClose()}`;
    }

    // ── Quotation Review ──
    if (phase === 'quotation_review') {
      const qr = p.quotationReview || {};
      const totalAmount = qr.totalAmount || 0;
      const items = qr.items || [];
      const unitGroups = p.unitGroups || [];
      const hasMultipleTypes = unitGroups.length > 1;
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Quotation Under Review', 'quotation_review', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, true)}
          <div class="pw-wait mt-3">
            <div class="ic"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="t">Awaiting admin approval</div><div class="d">Your quotation is being reviewed by the admin. You'll be notified once approved.</div></div>
          </div>
          ${hasMultipleTypes ? `
          <div class="pw-report-box mt-3">
            <div style="font-size:0.78rem;font-weight:700;color:#0f172a;margin-bottom:.4rem;"><i class="bi bi-grid-3x3 me-1"></i>Per-Appliance Quotation</div>
            ${unitGroups.map(g => {
              const gTotal = g.quotation?.totalCost || 0;
              const gParts = g.quotation?.parts || [];
              return `
            <div style="font-size:.73rem;color:#475569;background:#f0fdf4;padding:.5rem .7rem;border-radius:6px;border:1px solid #bbf7d0;margin-bottom:.4rem;">
              <div style="font-weight:600;color:#166534;display:flex;justify-content:space-between;">
                <span>${esc(g.unitType)}${g.brand ? ' (' + esc(g.brand) + ')' : ''} — ${g.quantity} unit(s)</span>
                <span>${money(gTotal)}</span>
              </div>
              ${gParts.length > 0 ? `<div style="margin-top:.2rem;color:#64748b;">${gParts.map(p => esc(p.name)).join(', ')}</div>` : ''}
              ${g.quotation?.laborCost ? `<div style="color:#64748b;">Labor: ${money(g.quotation.laborCost)}</div>` : ''}
            </div>`;
            }).join('')}
          </div>
          ` : ''}
          <div class="pw-report-box mt-3">
            <div style="font-size:0.78rem;font-weight:700;color:#0f172a;margin-bottom:.4rem;"><i class="bi bi-file-check me-1"></i>${hasMultipleTypes ? 'Combined' : 'Your'} Quotation</div>
            <div style="font-size:.75rem;color:#475569;background:#f8fafc;padding:.6rem .8rem;border-radius:8px;border:1px solid #e2e8f0;">
              ${items.length > 0 ? `<table style="width:100%;border-collapse:collapse;font-size:.73rem;">
                <thead><tr style="border-bottom:1px solid #e2e8f0;"><th style="text-align:left;padding:.3rem .5rem;">Item</th><th style="text-align:center;padding:.3rem .5rem;">Qty</th><th style="text-align:right;padding:.3rem .5rem;">Price</th><th style="text-align:right;padding:.3rem .5rem;">Total</th></tr></thead>
                <tbody>${items.map(i => `<tr><td style="padding:.3rem .5rem;">${esc(i.description||'')}</td><td style="text-align:center;padding:.3rem .5rem;">${i.quantity}</td><td style="text-align:right;padding:.3rem .5rem;">${money(i.unitPrice)}</td><td style="text-align:right;padding:.3rem .5rem;">${money(i.total)}</td></tr>`).join('')}</tbody>
                <tfoot><tr style="border-top:1px solid #e2e8f0;"><td colspan="3" style="text-align:right;padding:.3rem .5rem;font-weight:700;">Total</td><td style="text-align:right;padding:.3rem .5rem;font-weight:700;">${money(totalAmount)}</td></tr></tfoot>
              </table>` : `<div style="color:#64748b;">Quotation details submitted</div>`}
            </div>
          </div>
          <button class="pw-link mt-3" onclick="pwViewDetails('${p._id}')">View Details</button>
        </div>
      ${pwCardClose()}`;
    }

    // Crew accepted → mobilize flow based on phase.
    if (phase === 'ready') {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Team ready — your move', 'accepted', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, true)}
          ${leadProgressRow(a)}
          <div class="pw-wait mt-3">
            <div class="ic"><i class="bi bi-truck"></i></div>
            <div><div class="t">Ready to mobilize the crew</div><div class="d">Press En Route to start today's on-site work.</div></div>
          </div>
          <div class="d-flex gap-2 mt-3">
            <button class="pw-btn primary" onclick="pwLeadMobilize('${p._id}','en-route')"><i class="bi bi-truck"></i> En Route</button>
            <button class="pw-link" onclick="pwViewDetails('${p._id}')">View Details</button>
          </div>
        </div>
      ${pwCardClose()}`;
    }

    if (phase === 'en_route') {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Crew en route', 'en_route', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, true)}
          ${leadProgressRow(a)}
          ${trackerHtml(p, a)}
          <div class="d-flex gap-2 mt-3">
            <button class="pw-btn primary" onclick="pwLeadMobilize('${p._id}','arrived')"><i class="bi bi-geo-alt"></i> Arrived</button>
            <button class="pw-link" onclick="pwViewDetails('${p._id}')">View Details</button>
          </div>
        </div>
      ${pwCardClose()}`;
    }

    if (phase === 'arrived') {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Crew on site', 'arrived', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, true)}
          ${leadProgressRow(a)}
          <div class="pw-wait mt-3"><div class="ic"><i class="bi bi-geo-alt"></i></div><div><div class="t">Crew has arrived on site</div><div class="d">Start work when ready, or mark No Show if unable to proceed.</div></div></div>
          <div class="d-flex gap-2 mt-3">
            <button class="pw-btn primary" onclick="pwLeadMobilize('${p._id}','start')"><i class="bi bi-play-fill"></i> Start Work</button>
            <button class="pw-btn danger" onclick="pwNoShow('${p._id}')"><i class="bi bi-exclamation-triangle"></i> No Show</button>
            <button class="pw-link" onclick="pwViewDetails('${p._id}')">View Details</button>
          </div>
        </div>
      ${pwCardClose()}`;
    }

    if (phase === 'in_progress') {
      const done = a.projectUnits?.allDone;
      const allSubmitted = a.projectUnits?.allSubmitted;
      const hasPayment = p.payment?.paymentStatus === 'paid';
      const hasProof = p.completionProofUrl;
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Work in progress', 'in_progress', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, true)}
          ${leadProgressRow(a)}
          ${quotaHtml(a, true)}
          <div id="pwEq-${p._id}" class="pw-eq-placeholder"></div>
          <div class="pw-progress-steps mt-3">
            <div class="pw-step ${done ? 'done' : 'active'}"><i class="bi bi-tools"></i><span>Install Units</span></div>
            <div class="pw-step-arrow"><i class="bi bi-chevron-right"></i></div>
            <div class="pw-step ${hasPayment ? 'done' : done ? 'active' : ''}"><i class="bi bi-cash-coin"></i><span>Collect Payment</span></div>
            <div class="pw-step-arrow"><i class="bi bi-chevron-right"></i></div>
            <div class="pw-step ${hasProof ? 'done' : hasPayment ? 'active' : ''}"><i class="bi bi-camera"></i><span>Proof of Completion</span></div>
          </div>
          <div class="d-flex gap-2 flex-wrap mt-3">
            ${!done
              ? `<button class="pw-btn primary" onclick="pwOpenSubmitUnits('${p._id}',this)"><i class="bi bi-check2-square"></i> Submit Done Units</button>`
              : !allSubmitted
                ? `<button class="pw-btn success" onclick="pwViewDetails('${p._id}')"><i class="bi bi-clipboard-check"></i> Review Completed Work Orders</button>`
              : !hasPayment
                ? `<button class="pw-btn success" onclick="pwOpenPayment('${p._id}')"><i class="bi bi-cash-coin"></i> Collect Payment</button>`
                : !hasProof
                  ? `<button class="pw-btn success" onclick="pwOpenCompletionProof('${p._id}')"><i class="bi bi-camera"></i> Upload Proof of Completion</button>`
                  : `<button class="pw-btn success" onclick="pwFinalSubmit('${p._id}')"><i class="bi bi-send"></i> Final Submit</button>`}
            ${!done ? `<button class="pw-btn" onclick="pwCompleteToday('${p._id}')"><i class="bi bi-calendar-check"></i> Complete Today's Work</button>` : ''}
            ${(p.repair?.serviceType === 'repair' || p.laborType === 'repair') && !done ? `<button class="pw-btn" onclick="pwOpenPartsModal('${p._id}')"><i class="bi bi-box-seam"></i> Record Parts</button>` : ''}
            <button class="pw-link" onclick="pwViewDetails('${p._id}')">View Details</button>
          </div>
        </div>
      ${pwCardClose()}`;
    }

    if (phase === 'daily_acceptance') {
      const da = a.dailyAcceptance || {};
      const leadDone = da.leadAccepted;
      const memberAccepted = (da.membersAccepted || []).filter(m => m.accepted);
      const memberDeclined = (da.declined || []);
      const teamCount = (p.assignedTechnicians || []).length;
      const allMembersOk = teamCount > 1 ? memberAccepted.length >= (teamCount - 1) : true;
      return `
      <div class="pw-project pw-daily-card" id="pwCard-${p._id}">
        ${cardHead(p, 'Daily Confirmation Required', 'daily_acceptance', phase)}
        <div class="pw-project-body">
          <div class="pw-daily-banner">
            <div class="ic"><i class="bi bi-calendar-check"></i></div>
            <div class="info">
              <div class="title">Confirm availability for tomorrow</div>
              <div class="desc">End of day reached. All team members must confirm they can continue before work resumes.</div>
            </div>
          </div>
          ${kpiRow(a, true)}
          ${leadProgressRow(a)}
          <div class="pw-daily-status">
            <span class="pw-daily-chip ${leadDone ? 'ok' : 'pending'}"><i class="bi ${leadDone ? 'bi-check-circle-fill' : 'bi-hourglass-split'}"></i> Lead: ${leadDone ? 'Confirmed' : 'Pending'}</span>
            ${(da.membersAccepted||[]).filter(m => m.accepted).map(m => `<span class="pw-daily-chip ok"><i class="bi bi-check-circle-fill"></i> ${esc(m.name)} confirmed</span>`).join('')}
            ${memberDeclined.map(m => `<span class="pw-daily-chip no"><i class="bi bi-x-circle-fill"></i> ${esc(m.name)} declined</span>`).join('')}
          </div>
          <div class="pw-daily-actions">
            ${!leadDone
              ? `<button class="pw-daily-btn continue" onclick="pwDailyAccept('${p._id}',this)"><i class="bi bi-check-lg"></i> Continue Tomorrow</button>
                 <button class="pw-daily-btn decline" onclick="pwDailyDecline('${p._id}')"><i class="bi bi-x-lg"></i> Decline Tomorrow</button>`
              : allMembersOk
                ? `<button class="pw-btn primary" onclick="pwLeadMobilize('${p._id}','en-route')"><i class="bi bi-truck"></i> All Confirmed — Mobilize</button>`
                : `<span style="font-size:.75rem;color:#92400e;font-weight:600;">Waiting for team members to confirm…</span>`}
            <button class="pw-link ms-auto" onclick="pwViewDetails('${p._id}')">View Details</button>
          </div>
        </div>
      ${pwCardClose()}`;
    }

    // Execution phase after quotation approved — ready to mobilize the team
    if (phase === 'execution') {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Quotation Approved — Ready', 'accepted', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, true)}
          ${leadProgressRow(a)}
          <div class="pw-wait mt-3">
            <div class="ic"><i class="bi bi-check-circle-fill" style="color:#059669;"></i></div>
            <div><div class="t">Quotation approved — execution phase</div><div class="d">Admin has approved the quotation. Mobilize the team to begin repair work.</div></div>
          </div>
          <div class="d-flex gap-2 mt-3">
            <button class="pw-btn primary" onclick="pwLeadMobilize('${p._id}','en-route')"><i class="bi bi-truck"></i> En Route</button>
            <button class="pw-link" onclick="pwViewDetails('${p._id}')">View Details</button>
          </div>
        </div>
      ${pwCardClose()}`;
    }

    return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Completed', 'completed', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, true)}
          ${leadProgressRow(a)}
          <div class="pw-wait mt-3"><div class="ic"><i class="bi bi-check2-circle"></i></div><div><div class="t">All units complete</div><div class="d">Ready for final inspection and payment collection.</div></div></div>
          <div class="d-flex gap-2 mt-3">
            <button class="pw-btn success" onclick="pwOpenPayment('${p._id}')"><i class="bi bi-cash-coin"></i> View / Collect Payment</button>
            <button class="pw-link" onclick="pwViewDetails('${p._id}')">View Details</button>
          </div>
        </div>
      ${pwCardClose()}`;
  }

  // ════════════════════ MEMBER CARD ════════════════════
  function renderMemberCard(a, acknowledged, myDeclined) {
    const p = a.project;
    const phase = a.phase || 'ready';

    // Every assigned member can confirm availability during planning. This is
    // independent of lead mobilization and does not release project work.
    if (!acknowledged && !myDeclined) {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Assigned to you', 'assigned', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, false)}
          <div class="pw-wait mt-3"><div class="ic"><i class="bi bi-person-check"></i></div><div><div class="t">You were assigned by the lead</div><div class="d">Accept to join the crew for this project.</div></div></div>
          <div class="d-flex gap-2 mt-3">
            <button class="pw-btn primary" onclick="pwMemberAccept('${p._id}')"><i class="bi bi-check-lg"></i> Accept</button>
            <button class="pw-btn danger" onclick="pwMemberDecline('${p._id}')"><i class="bi bi-x-circle"></i> Decline</button>
            <button class="pw-link ms-auto" onclick="pwViewDetails('${p._id}')">View Details</button>
          </div>
        </div>
      ${pwCardClose()}`;
    }

    if (myDeclined) {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Declined', 'cancelled', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, false)}
          <div class="pw-wait mt-3"><div class="ic"><i class="bi bi-slash-circle"></i></div><div><div class="t">You declined this assignment</div><div class="d">The lead has been notified to replace you.</div></div></div>
          <button class="pw-link mt-3" onclick="pwViewDetails('${p._id}')">View Details</button>
        </div>
      ${pwCardClose()}`;
    }

    if (!a.leadAccepted) {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Participation accepted', 'accepted', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, false)}
          <div class="pw-wait mt-3"><div class="ic"><i class="bi bi-check-circle"></i></div><div><div class="t">You are confirmed on the team</div><div class="d">Wait for operations to confirm Step 6 and for the lead to start the project.</div></div></div>
          <button class="pw-link mt-3" onclick="pwViewDetails('${p._id}')">View Planning Details</button>
        </div>
      ${pwCardClose()}`;
    }

    // Phase 1 / Quotation review — member waiting for lead
    if (phase === 'assessment' || phase === 'quotation_review') {
      const label = phase === 'assessment' ? 'Site Assessment' : 'Quotation Review';
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, label + ' — stand by', 'assessment', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, false)}
          <div class="pw-wait mt-3"><div class="ic"><i class="bi bi-clipboard-data"></i></div><div><div class="t">Lead is completing site assessment</div><div class="d">The team lead is inspecting the site and preparing a quotation for admin approval. Stand by for updates.</div></div></div>
          <button class="pw-link mt-3" onclick="pwViewDetails('${p._id}')">View Details</button>
        </div>
      ${pwCardClose()}`;
    }

    // Member accepted → wait for the lead to drive the day.
    if (phase === 'ready') {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Accepted — standby', 'accepted', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, false)}
          <div class="pw-wait mt-3"><div class="ic"><i class="bi bi-truck"></i></div><div><div class="t">Waiting for team lead to mobilize</div><div class="d">When the lead starts the day, your assignment will appear here.</div></div></div>
          <button class="pw-link mt-3" onclick="pwViewDetails('${p._id}')">View Details</button>
        </div>
      ${pwCardClose()}`;
    }

    if (phase === 'en_route') {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'En route with crew', 'en_route', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, false)}
          ${memberProgressRow(a)}
          ${trackerHtml(p, a)}
          <button class="pw-link mt-3" onclick="pwViewDetails('${p._id}')">View Details</button>
        </div>
      ${pwCardClose()}`;
    }

    if (phase === 'arrived') {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Arrived on site', 'arrived', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, false)}
          ${memberProgressRow(a)}
          <div class="pw-wait mt-3"><div class="ic"><i class="bi bi-tools"></i></div><div><div class="t">Waiting for team lead to start work</div></div></div>
          <button class="pw-link mt-3" onclick="pwViewDetails('${p._id}')">View Details</button>
        </div>
      ${pwCardClose()}`;
    }

    // ── Member: daily re-acceptance ──
    if (phase === 'daily_acceptance') {
      const da = a.dailyAcceptance || {};
      const myAccepted = (da.membersAccepted||[]).find(m => String(m._id || m.techId) === String(ME_ID) && m.accepted);
      const myDeclined = (da.declined||[]).find(m => String(m._id || m.techId) === String(ME_ID));
      const leadDone = da.leadAccepted;
      return `
      <div class="pw-project pw-daily-card" id="pwCard-${p._id}">
        ${cardHead(p, 'Daily Confirmation Required', 'daily_acceptance', phase)}
        <div class="pw-project-body">
          <div class="pw-daily-banner">
            <div class="ic"><i class="bi bi-calendar-check"></i></div>
            <div class="info">
              <div class="title">Can you continue tomorrow?</div>
              <div class="desc">The lead has confirmed the end of today's work. Please confirm your availability for tomorrow.</div>
            </div>
          </div>
          ${kpiRow(a, false)}
          ${memberProgressRow(a)}
          <div class="pw-daily-status">
            <span class="pw-daily-chip ${leadDone ? 'ok' : 'pending'}"><i class="bi ${leadDone ? 'bi-check-circle-fill' : 'bi-hourglass-split'}"></i> Lead: ${leadDone ? 'Confirmed' : 'Pending'}</span>
            <span class="pw-daily-chip ${myAccepted ? 'ok' : myDeclined ? 'no' : 'pending'}"><i class="bi ${myAccepted ? 'bi-check-circle-fill' : myDeclined ? 'bi-x-circle-fill' : 'bi-hourglass-split'}"></i> You: ${myAccepted ? 'Confirmed' : myDeclined ? 'Declined' : 'Pending'}</span>
          </div>
          ${!myAccepted && !myDeclined ? `
          <div class="pw-daily-actions">
            <button class="pw-daily-btn continue" onclick="pwDailyAccept('${p._id}',this)"><i class="bi bi-check-lg"></i> Confirm Tomorrow</button>
            <button class="pw-daily-btn decline" onclick="pwDailyDecline('${p._id}')"><i class="bi bi-x-lg"></i> Can't Continue</button>
          </div>` : `
          <div class="pw-wait mt-3"><div class="ic"><i class="bi bi-hourglass-split"></i></div><div><div class="t">Waiting for other team members</div><div class="d">Once everyone confirms, the lead can mobilize for tomorrow.</div></div></div>`}
          <button class="pw-link mt-3" onclick="pwViewDetails('${p._id}')">View Details</button>
        </div>
      ${pwCardClose()}`;
    }

    // Execution phase — approved, ready for lead to mobilize
    if (phase === 'execution') {
      return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Quotation Approved — Stand By', 'accepted', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, false)}
          <div class="pw-wait mt-3"><div class="ic"><i class="bi bi-check-circle-fill" style="color:#059669;"></i></div><div><div class="t">Quotation approved</div><div class="d">Admin approved the quotation. Wait for the team lead to mobilize the crew for repair work.</div></div></div>
          <button class="pw-link mt-3" onclick="pwViewDetails('${p._id}')">View Details</button>
        </div>
      ${pwCardClose()}`;
    }

    // in_progress → member quota + submit
    const done = a.projectUnits?.allDone;
    return `
      <div class="pw-project" id="pwCard-${p._id}">
        ${cardHead(p, 'Today\'s Work', 'in_progress', phase)}
        <div class="pw-project-body">
          ${kpiRow(a, false)}
          ${memberProgressRow(a)}
          ${quotaHtml(a, false)}
          <div id="pwEq-${p._id}" class="pw-eq-placeholder"></div>
          <div class="d-flex gap-2 flex-wrap mt-3">
            ${done ? `<span class="pw-status completed" style="align-self:center;">All units complete — lead review pending</span>`
                   : `<button class="pw-btn success" onclick="pwOpenSubmitUnits('${p._id}',this)"><i class="bi bi-check2-square"></i> Submit Done Units</button>`}
            <button class="pw-link" onclick="pwViewDetails('${p._id}')">View Details</button>
          </div>
        </div>
      ${pwCardClose()}`;
  }

  // ── Shared sub-blocks ──
  const PHASE_ORDER = ['assessment','quotation_review','execution','ready','en_route','arrived','in_progress','completed'];
  const PHASE_ICON = { assessment:'bi-clipboard-data', quotation_review:'bi-file-check', execution:'bi-play-circle', ready:'bi-flag', en_route:'bi-truck', arrived:'bi-geo-alt', in_progress:'bi-play-fill', completed:'bi-check2-circle' };

  // Left vertical stepper rail (command-center look).
  function phaseStepper(phase) {
    const cur = PHASE_ORDER.indexOf(phase || 'ready');
    return `<div class="pw-rail">
      ${PHASE_ORDER.map((ph, i) => {
        const cls = i < cur ? 'done' : (i === cur ? 'active' : '');
        const label = { assessment:'Assess', quotation_review:'Quote', execution:'Execute', ready:'Ready', en_route:'En Route', arrived:'Arrived', in_progress:'Working', completed:'Done' }[ph];
        return `<div class="node ${cls}" title="${label}"><i class="bi ${PHASE_ICON[ph]}"></i>${i < PHASE_ORDER.length-1 ? '<span class="ln"></span>' : ''}</div>`;
      }).join('')}
    </div>`;
  }

  // Horizontal stepper for the detail drawer (matches standard bookings panel).
  function pwDrawerStepper(phase) {
    const labels = { assessment:'Assess', quotation_review:'Quote', execution:'Execute', ready:'Ready', en_route:'En Route', arrived:'Arrived', in_progress:'Working', completed:'Done' };
    const cur = PHASE_ORDER.indexOf(phase || 'ready');
    let html = '';
    for (let i = 0; i < PHASE_ORDER.length; i++) {
      const ph = PHASE_ORDER[i];
      const cls = i < cur ? 'done' : (i === cur ? 'active' : '');
      html += `<div class="pw-d-step ${cls}"><div class="dot"><i class="bi ${PHASE_ICON[ph]}"></i></div><span>${esc(labels[ph])}</span></div>`;
      if (i < PHASE_ORDER.length - 1) {
        html += `<div class="pw-d-connector ${i < cur ? 'done' : ''}"></div>`;
      }
    }
    return html;
  }

  function cardHead(p, statusText, statusClass, phase) {
    const name = p?.customer?.name || p?.service?.name || 'Commercial Project';
    const isRepair = p?.repair?.serviceType === 'repair' || p?.laborType === 'repair';
    return `
      ${phaseStepper(phase)}
      <div class="pw-content">
        <div class="pw-project-head">
          <div class="title-wrap">
            <h3>${esc(name)}</h3>
            <div class="meta"><span><i class="bi bi-briefcase me-1"></i>${esc(p?.service?.name || 'Commercial Project')}</span><span class="dot"></span><span>Large-Scale Project</span>${isRepair ? '<span class="dot"></span><span style="background:#fef2f2;color:#991b1b;padding:.15rem .5rem;border-radius:999px;font-size:.65rem;font-weight:700;border:1px solid #fecaca;"><i class="bi bi-tools me-1"></i>Repair</span>' : ''}</div>
          </div>
          <span class="pw-status ${statusClass}">${esc(statusText)}</span>
        </div>`;
  }

  // Closes the .pw-content and .pw-project wrappers opened by cardHead.
  function pwCardClose() { return `</div></div>`; }

  // KPI tiles show shared batch progress for every crew member.
  function kpiRow(a, isLead) {
    const pu = a.projectUnits || { total:0, done:0 };
    const pct = pu.total > 0 ? Math.round((pu.done/pu.total)*100) : 0;
    const remaining = Math.max(0, pu.total - pu.done);
    const crew = (a.project?.assignedTechnicians || []).length;
    const tiles = isLead
      ? [
          { k:'Total Units', v:`${pu.total}`, ic:'bi-grid-3x3-gap' },
          { k:'Completed', v:`${pu.done}`, ic:'bi-check2-circle' },
          { k:'Remaining', v:`${remaining}`, ic:'bi-hourglass-split' },
          { k:'Crew', v:`${crew}`, ic:'bi-people' },
        ]
      : [
          { k:'Total Units', v:`${pu.total}`, ic:'bi-grid-3x3-gap' },
          { k:'Team Completed', v:`${pu.done}`, ic:'bi-check2-circle' },
          { k:'Remaining', v:`${remaining}`, ic:'bi-hourglass-split' },
          { k:'Project', v:`${pct}<small>%</small>`, ic:'bi-activity' },
        ];
    return `<div class="pw-kpis">${tiles.map(t => `
      <div class="pw-kpi"><i class="bi ${t.ic} ic"></i><div class="k">${t.k}</div><div class="v">${t.v}</div></div>`).join('')}</div>`;
  }

  function teamLine(a) {
