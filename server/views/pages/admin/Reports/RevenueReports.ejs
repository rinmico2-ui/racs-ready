<% const reportRole = typeof user !== "undefined" && user && user.role === "secretary" ? "secretary" : "admin"; %>
<% const reportLinks = { pos: reportRole === "secretary" ? "/secretary/pointofsale" : "/admin/inventory/pos", remittance: reportRole === "secretary" ? "/secretary/payments" : "/admin/payments/remittance", costs: reportRole === "secretary" ? "/secretary/appointments/expenses" : "/admin/payroll" }; %>
<div class="revenue-report container-fluid px-0 py-4">
  <%- include('../../../partials/dashboard-styles') %>
  <link rel="stylesheet" href="/css/analytics.css">
  <style>
    .rr-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.rr-card{background:#fff;border:1px solid #e5ebf3;border-radius:16px;box-shadow:0 3px 18px rgba(15,23,42,.045)}.rr-kpi{padding:18px;position:relative;overflow:hidden}.rr-kpi:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--a,#2563eb)}.rr-kpi-top{display:flex;justify-content:space-between;align-items:center}.rr-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:11px;color:var(--a);background:color-mix(in srgb,var(--a) 12%,white)}.rr-delta{font-size:.66rem;font-weight:700;padding:3px 8px;border-radius:999px;background:#ecfdf5;color:#047857}.rr-delta.down{background:#fef2f2;color:#b91c1c}.rr-label{font-size:.67rem;font-weight:700;text-transform:uppercase;letter-spacing:.055em;color:#64748b;margin-top:13px}.rr-value{font:700 1.38rem/1.2 Outfit,Inter,sans-serif;color:#0f172a;margin-top:4px}.rr-meta{font-size:.68rem;color:#94a3b8;margin-top:5px;line-height:1.4}.rr-section{display:flex;align-items:center;justify-content:space-between;margin:28px 0 12px}.rr-section h2{font:700 .9rem Outfit,Inter,sans-serif;text-transform:uppercase;letter-spacing:.06em;color:#334155;border-left:4px solid #2563eb;padding-left:10px;margin:0}.rr-two{display:grid;grid-template-columns:2fr 1fr;gap:16px}.rr-equal{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.rr-three{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.rr-head{padding:15px 18px;border-bottom:1px solid #edf1f6;display:flex;justify-content:space-between;align-items:center}.rr-head h3{font-size:.82rem;font-weight:700;color:#1e293b;margin:0}.rr-body{padding:16px 18px}.rr-chart{height:280px;padding:16px}.rr-badge{font-size:.63rem;font-weight:700;padding:4px 8px;border-radius:999px;background:#f1f5f9;color:#475569}.rr-source{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.rr-source-card{padding:18px;border-radius:14px;background:#f8fafc;border:1px solid #edf2f7}.rr-source-card.service{border-top:4px solid #2563eb}.rr-source-card.orders{border-top:4px solid #10b981}.rr-source-card.pos{border-top:4px solid #f59e0b}.rr-source-title{font-size:.75rem;font-weight:700;color:#334155}.rr-source-value{font:700 1.5rem Outfit,Inter,sans-serif;margin:8px 0 4px;color:#0f172a}.rr-progress{height:7px;background:#e9eef5;border-radius:99px;overflow:hidden;margin-top:12px}.rr-progress>span{display:block;height:100%;border-radius:99px}.rr-insight{padding:16px;display:flex;gap:11px}.rr-insight-icon{width:36px;height:36px;flex:none;border-radius:10px;display:grid;place-items:center;background:#eff6ff;color:#2563eb}.rr-insight.warning .rr-insight-icon{background:#fffbeb;color:#d97706}.rr-insight.danger .rr-insight-icon{background:#fef2f2;color:#dc2626}.rr-insight.success .rr-insight-icon{background:#ecfdf5;color:#059669}.rr-insight h4{font-size:.78rem;font-weight:700;margin:1px 0 4px;color:#1e293b}.rr-insight p{font-size:.7rem;line-height:1.45;color:#64748b;margin:0}.rr-table{width:100%;border-collapse:collapse;font-size:.78rem}.rr-table th{padding:9px 8px;border-bottom:1px solid #e2e8f0;color:#94a3b8;font-size:.63rem;text-transform:uppercase;letter-spacing:.05em}.rr-table td{padding:11px 8px;border-bottom:1px solid #f1f5f9;color:#475569}.rr-table tr:last-child td{border:0}.rr-type{font-size:.62rem;font-weight:700;border-radius:99px;padding:4px 8px;background:#eff6ff;color:#2563eb}.rr-type.order{background:#ecfdf5;color:#047857}.rr-type.pos{background:#fffbeb;color:#b45309}.rr-status{font-size:.62rem;font-weight:700;border-radius:99px;padding:4px 8px;background:#fffbeb;color:#b45309}.rr-status.paid,.rr-status.verified,.rr-status.remitted,.rr-status.completed{background:#ecfdf5;color:#047857}.rr-note{padding:13px 16px;border-radius:12px;background:#fffbeb;border:1px solid #fde68a;font-size:.7rem;color:#92400e;line-height:1.5}.rr-actions{display:flex;gap:8px}.rr-btn{padding:8px 12px;border-radius:9px;border:1px solid rgba(255,255,255,.3);font-size:.72rem;font-weight:700;text-decoration:none;color:#fff}.rr-btn.light{background:#fff;color:#1d4ed8}.rr-empty{text-align:center;color:#94a3b8;padding:24px}
    .rr-cost-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}.rr-cost-metric{padding:15px;background:#f8fafc;border-radius:12px;border:1px solid #edf2f7}.rr-cost-metric .rr-value{font-size:1.08rem}.rr-service-detail summary{cursor:pointer;list-style:none}.rr-service-detail summary::-webkit-details-marker{display:none}.rr-resource-list{font-size:.68rem;color:#64748b;margin:6px 0 0;padding-left:16px}
    .rr-collection-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:16px}
    /* --- Enterprise KPI Cards (matching Service Report) --- */
    .kpi-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-bottom:1.5rem}
    @media(max-width:1199px){.kpi-grid{grid-template-columns:repeat(3,1fr)}}
    @media(max-width:767px){.kpi-grid{grid-template-columns:repeat(2,1fr);gap:12px}}
    @media(max-width:480px){.kpi-grid{grid-template-columns:1fr}}
    .kpi-enterprise{position:relative;background:#fff;border-radius:16px;padding:18px 18px 14px;box-shadow:0 1px 3px rgba(15,23,42,0.04),0 4px 16px rgba(15,23,42,0.04);border:1px solid rgba(226,232,240,0.6);transition:transform 0.25s cubic-bezier(0.4,0,0.2,1),box-shadow 0.25s cubic-bezier(0.4,0,0.2,1);overflow:hidden;display:flex;flex-direction:column;cursor:default}
    .kpi-enterprise:hover{transform:translateY(-4px);box-shadow:0 8px 32px rgba(15,23,42,0.08),0 2px 8px rgba(15,23,42,0.04)}
    .kpi-enterprise::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;opacity:0;transition:opacity 0.3s ease}
    .kpi-enterprise:hover::before{opacity:1}
    .kpi-enterprise[data-accent="blue"]::before{background:linear-gradient(90deg,#1d4ed8,#3b82f6)}
    .kpi-enterprise[data-accent="amber"]::before{background:linear-gradient(90deg,#d97706,#fbbf24)}
    .kpi-enterprise[data-accent="purple"]::before{background:linear-gradient(90deg,#7c3aed,#a855f7)}
    .kpi-enterprise[data-accent="green"]::before{background:linear-gradient(90deg,#059669,#10b981)}
    .kpi-enterprise[data-accent="cyan"]::before{background:linear-gradient(90deg,#06b6d4,#0891b2)}
    .kpi-enterprise[data-accent="red"]::before{background:linear-gradient(90deg,#ef4444,#dc2626)}
    .kpi-enterprise-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:8px}
    .kpi-enterprise-icon{width:38px;height:38px;min-width:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem;box-shadow:0 4px 10px rgba(0,0,0,0.08);flex-shrink:0}
    .kpi-enterprise-icon.blue{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff}
    .kpi-enterprise-icon.amber{background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff}
    .kpi-enterprise-icon.purple{background:linear-gradient(135deg,#8b5cf6,#6d28d9);color:#fff}
    .kpi-enterprise-icon.green{background:linear-gradient(135deg,#10b981,#059669);color:#fff}
    .kpi-enterprise-icon.cyan{background:linear-gradient(135deg,#06b6d4,#0891b2);color:#fff}
    .kpi-enterprise-icon.red{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}
    .kpi-enterprise-icon.orange{background:linear-gradient(135deg,#f97316,#ea580c);color:#fff}
    .kpi-enterprise-badge{display:inline-flex;align-items:center;gap:4px;font-size:0.6rem;font-weight:600;letter-spacing:0.04em;padding:2px 8px;border-radius:999px;white-space:nowrap}
    .kpi-enterprise-badge.blue{background:rgba(59,130,246,0.10);color:#2563eb}
    .kpi-enterprise-badge.amber{background:rgba(245,158,11,0.10);color:#d97706}
    .kpi-enterprise-badge.purple{background:rgba(168,85,247,0.10);color:#7c3aed}
    .kpi-enterprise-badge.green{background:rgba(16,185,129,0.10);color:#059669}
    .kpi-enterprise-badge.cyan{background:rgba(6,182,212,0.10);color:#0891b2}
    .kpi-enterprise-badge.red{background:rgba(239,68,68,0.10);color:#dc2626}
    .kpi-enterprise-body{flex:1;display:flex;flex-direction:column;justify-content:space-between}
    .kpi-enterprise-label{font-size:0.72rem;font-weight:500;color:#64748b;margin:0 0 2px;line-height:1.3}
    .kpi-enterprise-value{font-size:1.4rem;font-weight:700;color:#0f172a;line-height:1.2;letter-spacing:-0.02em;margin-bottom:6px}
    .kpi-enterprise-sparkline{margin-top:4px;height:28px;position:relative}
    .kpi-enterprise-sparkline canvas{width:100%!important;height:100%!important}
    @media(max-width:767px){.kpi-grid{grid-template-columns:repeat(2,1fr);gap:10px}.kpi-enterprise-value{font-size:1.15rem}}
    @media(max-width:1199px){.rr-grid,.rr-cost-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:900px){.rr-two,.rr-equal{grid-template-columns:1fr}.rr-three{grid-template-columns:1fr 1fr}}@media(max-width:600px){.rr-grid,.rr-cost-grid,.rr-collection-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.rr-three,.rr-source{grid-template-columns:1fr}.rr-value{font-size:1.15rem}.rr-actions{width:100%}.rr-btn{flex:1;text-align:center}}
    /* --- Report Section Navigation --- */
    .report-nav{position:fixed;right:1.5rem;top:9rem;transform:translateX(calc(100% + 1.5rem));opacity:0;pointer-events:none;z-index:110;display:flex;flex-direction:column;gap:8px;padding:10px;background:rgba(255,255,255,0.96);border:1px solid rgba(226,232,240,0.8);border-radius:14px;box-shadow:0 4px 20px rgba(15,23,42,0.06);overflow-y:auto;max-height:calc(100vh - 11rem);scrollbar-width:none;-webkit-overflow-scrolling:touch;backdrop-filter:blur(8px);transition:all 0.25s ease;width:fit-content}
    .report-nav.open{transform:translateX(0);opacity:1;pointer-events:auto}
    .report-nav::-webkit-scrollbar{display:none}
    .report-nav .report-nav-btn{display:none}
    .report-nav.open .report-nav-btn{display:flex}
    .report-nav-btn{align-items:center;gap:8px;padding:8px 14px;border:1px solid #e2e8f0;background:#fff;border-radius:10px;font-size:0.76rem;font-weight:600;color:#475569;white-space:nowrap;cursor:pointer;transition:all 0.2s ease;text-align:left}
    .report-nav-btn:hover{background:#f8fafc;border-color:#cbd5e1;color:#0f172a}
    .report-nav-btn.active{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;border-color:transparent;box-shadow:0 4px 12px rgba(37,99,235,0.25)}
    .report-nav-btn i{font-size:0.85rem}
    .report-nav-trigger{position:fixed;top:5.5rem;right:1.5rem;z-index:1200;display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border:2px solid rgba(255,255,255,0.9);background:linear-gradient(135deg,#2563eb,#1d4ed8);border-radius:999px;color:#fff;font-size:0.88rem;font-weight:700;cursor:pointer;transition:all 0.2s ease;box-shadow:0 0 0 2px rgba(37,99,235,0.15),0 6px 20px rgba(37,99,235,0.4);white-space:nowrap}
    .report-nav-trigger:hover{filter:brightness(1.1);box-shadow:0 0 0 4px rgba(37,99,235,0.2),0 8px 24px rgba(37,99,235,0.5)}
    @media(max-width:767px){.report-nav{right:0.75rem;top:8.5rem;padding:6px;gap:4px;max-height:calc(100vh - 10rem)}.report-nav-btn{padding:5px 8px;font-size:0.68rem;gap:4px}.report-nav-trigger{top:4.75rem;right:0.75rem;padding:8px 12px;font-size:0.78rem}}
    /* --- Chart Detail Modal --- */
    .cdm-body{display:grid;grid-template-columns:1.1fr 1fr;gap:0;height:70vh;min-height:480px}
    .cdm-left{padding:24px;border-right:1px solid #edf1f6;display:flex;flex-direction:column;overflow:hidden}
    .cdm-right{padding:24px;overflow-y:auto;display:flex;flex-direction:column}
    .cdm-chart-wrap{flex:1;position:relative;min-height:300px}
    .cdm-title{font:700 .92rem Outfit,Inter,sans-serif;color:#0f172a;margin-bottom:4px}
    .cdm-subtitle{font-size:.74rem;color:#64748b;margin-bottom:16px}
    .cdm-summary{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:16px}
    .cdm-stat{padding:12px 14px;border-radius:10px;background:#f8fafc;border:1px solid #edf2f7}
    .cdm-stat-label{font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#64748b;margin-bottom:3px}
    .cdm-stat-value{font:700 1.05rem Outfit,Inter,sans-serif;color:#0f172a}
    .cdm-table{width:100%;font-size:.76rem;border-collapse:collapse}
    .cdm-table th{font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#64748b;padding:8px 10px;border-bottom:2px solid #edf1f6;text-align:left;position:sticky;top:0;background:#fff;z-index:1}
    .cdm-table td{padding:8px 10px;border-bottom:1px solid #f1f5f9;color:#334155}
    .cdm-table tr:hover td{background:#f8fafc}
    .cdm-empty{text-align:center;padding:40px 20px;color:#94a3b8;font-size:.82rem}
    .cdm-badge{display:inline-flex;align-items:center;gap:4px;font-size:.6rem;font-weight:700;padding:3px 8px;border-radius:999px;white-space:nowrap}
    @media(max-width:767px){.cdm-body{grid-template-columns:1fr;height:auto}.cdm-left{border-right:none;border-bottom:1px solid #edf1f6;min-height:250px}.cdm-right{max-height:40vh}}
    .rr-chart canvas{cursor:pointer}
    .rr-chart{position:relative}
    .rr-chart::after{content:'Click chart for details';position:absolute;bottom:6px;right:8px;font-size:.6rem;color:#94a3b8;pointer-events:none;opacity:0;transition:opacity .2s}
    .rr-chart:hover::after{opacity:1}
    .rr-data-state{display:flex;align-items:center;gap:12px;padding:13px 16px;margin:-8px 0 18px;border:1px solid #bfdbfe;border-radius:12px;background:#eff6ff;color:#1e40af;font-size:.78rem;font-weight:600}.rr-data-state[hidden]{display:none}.rr-data-state.error{border-color:#fecaca;background:#fef2f2;color:#b91c1c}.rr-data-state .spinner-border{width:1rem;height:1rem;border-width:2px}
  </style>
  <link rel="stylesheet" href="/css/report-kpis.css?v=20260928-unified-report-kpis">
  <link rel="stylesheet" href="/css/revenue-report-focused.css?v=20260928-pos-categories">
  <% const A=analytics||{}; const isDeferred=typeof deferredAnalytics !== 'undefined' && deferredAnalytics; const peso=n=>'₱'+Math.round(Number(n||0)).toLocaleString('en-PH'); const pct=n=>Number(n||0).toFixed(1)+'%'; const months=Object.values(A.monthlyRevenue||{}).reverse(); const insightPriority={danger:0,warning:1,info:2,success:3}; const topInsights=[...(A.executiveInsights||[])].sort((a,b)=>(insightPriority[a.tone]??2)-(insightPriority[b.tone]??2)).slice(0,3); %>

  <div class="au-hero mb-4"><div class="au-hero-inner"><div class="au-hero-left"><div class="au-hero-icon"><i class="bi bi-graph-up-arrow"></i></div><div><h1>Sales and Payments</h1><p>Services, online and walk-in orders, and counter sales performance</p></div></div><div class="rr-actions"><a class="rr-btn" href="/<%= reportRole %>/reports/service"><i class="bi bi-wrench-adjustable me-1"></i> Services</a><a class="rr-btn" href="/<%= reportRole %>/reports/orders"><i class="bi bi-bag-check me-1"></i> Orders</a><a class="rr-btn" href="<%= reportLinks.pos %>"><i class="bi bi-shop me-1"></i> Walk-in sales</a><button class="rr-btn light" id="exportRevenue"><i class="bi bi-download me-1"></i> Download</button></div></div></div>
  <div class="rr-data-state" id="revenueDataState" role="status" aria-live="polite" <%= isDeferred ? '' : 'hidden' %>><span class="spinner-border" aria-hidden="true"></span><span>Loading live revenue, including completed walk-in and Walk-in sales sales&hellip;</span></div>

  <!-- --- SECTION NAV --- -->
  <div class="report-nav" id="reportNav" role="tablist" aria-label="Revenue analysis sections">
    <button class="report-nav-btn active" type="button" role="tab" aria-selected="true" data-target="section-executive"><i class="bi bi-speedometer2"></i>Overview</button>
    <button class="report-nav-btn" type="button" role="tab" aria-selected="false" data-target="section-performance"><i class="bi bi-bar-chart-line"></i>Sales</button>
    <button class="report-nav-btn" type="button" role="tab" aria-selected="false" data-target="section-collection"><i class="bi bi-bank"></i>Collections</button>
    <button class="report-nav-btn" type="button" role="tab" aria-selected="false" data-target="section-cost"><i class="bi bi-calculator"></i>Profit &amp; cost</button>
    <button class="report-nav-btn" type="button" role="tab" aria-selected="false" data-target="section-service-profit"><i class="bi bi-clipboard-check"></i>Services</button>
    <button class="report-nav-btn" type="button" role="tab" aria-selected="false" data-target="section-pos"><i class="bi bi-shop"></i>Products</button>
    <button class="report-nav-btn" type="button" role="tab" aria-selected="false" data-target="section-activity"><i class="bi bi-journal-text"></i>Activity</button>
  </div>

  <!-- ═══ FILTER BAR ═══ -->
  <div id="revenueFilterBar" class="rr-card" style="margin-bottom:20px;border:1px solid #e2e8f0;border-radius:14px;">
    <div style="padding:16px 20px;display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;">
      <!-- Period Preset -->
      <div style="display:flex;flex-direction:column;gap:4px;">
        <label style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">Period</label>
        <select id="filterPeriod" class="form-select form-select-sm" style="border-radius:8px;border-color:#e2e8f0;font-size:0.8rem;min-width:140px;">
          <option value="last_12_months" selected>Last 12 months</option>
          <option value="this_month">This Month</option>
          <option value="last_month">Last Month</option>
          <option value="last_3_months">Last 3 Months</option>
          <option value="last_6_months">Last 6 Months</option>
          <option value="ytd">This year so far</option>
          <option value="custom">Custom Range</option>
        </select>
      </div>
      <!-- Custom Date Range (hidden by default) -->
      <div id="customDateRange" style="display:none;gap:8px;align-items:flex-end;">
        <div style="display:flex;flex-direction:column;gap:4px;">
          <label style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">From</label>
          <input type="date" id="filterFrom" class="form-control form-control-sm" style="border-radius:8px;border-color:#e2e8f0;font-size:0.8rem;" />
        </div>
        <div style="display:flex;flex-direction:column;gap:4px;">
          <label style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">To</label>
          <input type="date" id="filterTo" class="form-control form-control-sm" style="border-radius:8px;border-color:#e2e8f0;font-size:0.8rem;" />
        </div>
      </div>
      <!-- Revenue Source -->
      <div style="display:flex;flex-direction:column;gap:4px;">
        <label style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">Source</label>
        <select id="filterSource" class="form-select form-select-sm" style="border-radius:8px;border-color:#e2e8f0;font-size:0.8rem;min-width:130px;">
          <option value="all" selected>All Sources</option>
          <option value="service">Services / Projects</option>
          <option value="order">Product Orders (Online + Walk-in)</option>
          <option value="pos">Walk-in sales</option>
        </select>
      </div>
      <!-- Service Type -->
      <div style="display:flex;flex-direction:column;gap:4px;">
        <label style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">Service Type</label>
        <select id="filterServiceType" class="form-select form-select-sm" style="border-radius:8px;border-color:#e2e8f0;font-size:0.8rem;min-width:120px;">
          <option value="all" selected>All Types</option>
          <option value="core">Standard</option>
          <option value="repair">Repair</option>
        </select>
      </div>
      <!-- Payment Method -->
      <div style="display:flex;flex-direction:column;gap:4px;">
        <label style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">Payment</label>
        <select id="filterPayment" class="form-select form-select-sm" style="border-radius:8px;border-color:#e2e8f0;font-size:0.8rem;min-width:120px;">
          <option value="all" selected>All Methods</option>
          <option value="gcash">GCash</option>
          <option value="cod">Cash / COD</option>
          <option value="bank">Bank Transfer</option>
          <option value="other">Other</option>
        </select>
      </div>
      <!-- Payment Status -->
      <div style="display:flex;flex-direction:column;gap:4px;">
        <label style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">Status</label>
        <select id="filterStatus" class="form-select form-select-sm" style="border-radius:8px;border-color:#e2e8f0;font-size:0.8rem;min-width:120px;">
          <option value="all" selected>All Status</option>
          <option value="paid">Paid</option>
          <option value="pending">Pending</option>
          <option value="partial">Partial</option>
        </select>
      </div>
      <!-- Technician -->
      <div style="display:flex;flex-direction:column;gap:4px;">
        <label style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">Technician</label>
        <select id="filterTechnician" class="form-select form-select-sm" style="border-radius:8px;border-color:#e2e8f0;font-size:0.8rem;min-width:140px;">
          <option value="all" selected>All Technicians</option>
        </select>
      </div>
      <!-- Apply / Reset -->
      <div style="display:flex;gap:6px;align-items:flex-end;">
        <button id="applyFilters" class="btn btn-primary btn-sm" style="border-radius:8px;font-size:0.78rem;font-weight:600;padding:6px 16px;"><i class="bi bi-funnel me-1"></i> Apply</button>
        <button id="resetFilters" class="btn btn-outline-secondary btn-sm" style="border-radius:8px;font-size:0.78rem;padding:6px 12px;"><i class="bi bi-arrow-counterclockwise me-1"></i> Reset</button>
      </div>
      <div id="filterStatusBadge" style="margin-left:auto;font-size:0.72rem;color:#64748b;display:none;">
        <i class="bi bi-info-circle me-1"></i><span id="filterStatusText"></span>
      </div>
    </div>
  </div>

  <!-- --- KPI GRID (Enterprise style matching Service Report) --- -->
  <div class="kpi-grid report-kpi-grid" id="kpiGrid">
    <div class="kpi-enterprise" data-accent="blue" data-aos="fade-up" data-aos-delay="0">
      <div class="kpi-enterprise-top">
        <div class="kpi-enterprise-icon blue"><i class="bi bi-cash-stack"></i></div>
        <span class="kpi-enterprise-badge blue"><%= A.totalTransactions||0 %> txns</span>
      </div>
      <div class="kpi-enterprise-body">
        <p class="kpi-enterprise-label">Approved work value</p>
        <div class="kpi-enterprise-value"><span id="kpiTotalRevenue"><%= peso(A.totalRevenue) %></span></div>
        <small style="color:#64748b;">Approved services/projects + active orders + completed Walk-in sales</small>
      </div>
      <div class="kpi-enterprise-sparkline"><canvas id="kpiSparkRevenue"></canvas></div>
    </div>
    <div class="kpi-enterprise" data-accent="cyan" data-aos="fade-up" data-aos-delay="50">
      <div class="kpi-enterprise-top">
        <div class="kpi-enterprise-icon cyan"><i class="bi bi-graph-up-arrow"></i></div>
        <span class="kpi-enterprise-badge cyan">Completed work</span>
      </div>
      <div class="kpi-enterprise-body">
        <p class="kpi-enterprise-label">Completed sales</p>
        <div class="kpi-enterprise-value"><span id="kpiCashRecorded"><%= peso(A.recognizedRevenue) %></span></div>
        <small style="color:#64748b;">Completed work and sales, net of refunds</small>
      </div>
      <div class="kpi-enterprise-sparkline"><canvas id="kpiSparkCash"></canvas></div>
    </div>
    <div class="kpi-enterprise" data-accent="amber" data-aos="fade-up" data-aos-delay="100">
      <div class="kpi-enterprise-top">
        <div class="kpi-enterprise-icon amber"><i class="bi bi-bank"></i></div>
        <span class="kpi-enterprise-badge amber"><%= peso(A.refunds) %> refunded</span>
      </div>
      <div class="kpi-enterprise-body">
        <p class="kpi-enterprise-label">Payments after refunds</p>
        <div class="kpi-enterprise-value"><span style="color:#d97706"><%= peso(A.netCollections) %></span></div>
        <small style="color:#64748b;">Payments received less period refunds</small>
      </div>
    </div>
    <div class="kpi-enterprise" data-accent="red" data-aos="fade-up" data-aos-delay="120">
      <div class="kpi-enterprise-top">
        <div class="kpi-enterprise-icon red"><i class="bi bi-hourglass-split"></i></div>
        <span class="kpi-enterprise-badge red"><%= pct(A.collectionRate) %> collected</span>
      </div>
      <div class="kpi-enterprise-body">
        <p class="kpi-enterprise-label">Unpaid balance</p>
        <div class="kpi-enterprise-value"><span><%= peso(A.outstandingValue) %></span></div>
        <small style="color:#64748b;">Approved work value less payments after refunds</small>
      </div>
    </div>
    <div class="kpi-enterprise" data-accent="green" data-aos="fade-up" data-aos-delay="130">
      <div class="kpi-enterprise-top">
        <div class="kpi-enterprise-icon green"><i class="bi bi-boxes"></i></div>
        <span class="kpi-enterprise-badge green"><%= pct(A.costDataCoverage) %> covered</span>
      </div>
      <div class="kpi-enterprise-body">
        <p class="kpi-enterprise-label">Saved job and product costs</p>
        <div class="kpi-enterprise-value"><span><%= peso(A.totalPartsCost) %></span></div>
        <small style="color:#64748b;">Service, Walk-in sales, order Product cost and project materials</small>
      </div>
    </div>
    <div class="kpi-enterprise" data-accent="purple" data-aos="fade-up" data-aos-delay="140">
      <div class="kpi-enterprise-top">
        <div class="kpi-enterprise-icon purple"><i class="bi bi-calculator"></i></div>
        <span class="kpi-enterprise-badge <%= Number(A.operatingProfit||0) >= 0 ? 'green' : 'red' %>"><%= pct(A.operatingProfitMargin) %> profit %</span>
      </div>
      <div class="kpi-enterprise-body">
        <p class="kpi-enterprise-label">Profit after expenses</p>
        <div class="kpi-enterprise-value"><span style="color:<%= Number(A.operatingProfit||0) >= 0 ? '#059669' : '#dc2626' %>"><%= peso(A.operatingProfit) %></span></div>
        <small style="color:#64748b;">After saved job and product costs, approved expenses and payroll</small>
      </div>
    </div>
  </div>

  <!-- ═══ SECTION 1: EXECUTIVE SUMMARY & STRATEGIC INSIGHTS ═══ -->
  <div id="section-executive" class="rr-section"><h2><i class="bi bi-lightbulb me-2" style="color:#d97706;"></i>Business summary</h2><span class="text-muted small">The three most important money updates, followed by bookings and sales</span></div>
  <div class="rr-three" id="executiveInsightsGrid"><% topInsights.forEach(function(x){ %><article class="rr-card rr-insight <%= x.tone %>"><div class="rr-insight-icon"><i class="bi <%= x.tone==='danger'?'bi-exclamation-triangle':x.tone==='warning'?'bi-wallet2':x.tone==='success'?'bi-graph-up-arrow':'bi-pie-chart' %>"></i></div><div><h4><%= x.title %></h4><p><%= x.text %></p></div></article><% }); %></div>
  <section class="rr-card rr-activity-snapshot" aria-labelledby="revenueActivityTitle">
    <div class="rr-head"><div><span class="rr-eyebrow">Bookings and sales</span><h3 id="revenueActivityTitle"><i class="bi bi-diagram-3 me-2 text-primary"></i>Work behind the sales totals</h3><p>Records created during these dates. Finished work is shown separately.</p></div><span class="rr-badge">Number of records</span></div>
    <div class="rr-activity-grid" id="revenueActivitySnapshot">
      <article><span class="rr-activity-icon service"><i class="bi bi-calendar2-check"></i></span><div><small>Service bookings</small><strong><%= Number(A.serviceTransactions||0).toLocaleString('en-PH') %></strong><p><%= peso(A.avgServiceTicket) %> average booking value</p></div></article>
      <article><span class="rr-activity-icon orders"><i class="bi bi-bag-check"></i></span><div><small>Product orders</small><strong><%= Number(A.orderTransactions||0).toLocaleString('en-PH') %></strong><p><%= Number(A.walkInOrderTransactions||0).toLocaleString('en-PH') %> walk-in · <%= peso(A.avgOrderValue) %> average</p></div></article>
      <article><span class="rr-activity-icon pos"><i class="bi bi-shop"></i></span><div><small>Walk-in sales</small><strong><%= Number(A.posTransactions||0).toLocaleString('en-PH') %></strong><p><%= peso(A.avgPosSale) %> average sale</p></div></article>
      <article><span class="rr-activity-icon completed"><i class="bi bi-check2-circle"></i></span><div><small>Completed activity</small><strong><%= Number(A.recognizedTransactions||0).toLocaleString('en-PH') %></strong><p>Completed sales records</p></div></article>
    </div>
  </section>
  <section class="rr-card rr-control-center" aria-labelledby="revenueControlTitle">
    <div class="rr-head"><div><span class="rr-eyebrow">Management controls</span><h3 id="revenueControlTitle"><i class="bi bi-shield-check me-2"></i>Missing records and items to check</h3><p>Missing or unusual records that can affect sales, payments, costs, and profit.</p></div><span class="rr-badge"><%= pct(A.completionEvidenceCoverage === undefined ? 100 : A.completionEvidenceCoverage) %> sales with a saved completion date</span></div>
    <div class="rr-control-grid" id="revenueControlGrid">
      <article class="<%= Number(A.atRiskServiceBookings||0) ? 'danger' : 'success' %>"><i class="bi bi-calendar2-x"></i><div><small>Schedule needs a change</small><strong><%= Number(A.atRiskServiceBookings||0).toLocaleString('en-PH') %></strong><p>of <%= Number(A.openServiceBookings||0).toLocaleString('en-PH') %> open service bookings need reassignment or rescheduling</p><a href="/<%= reportRole %>/operations/resolution-center">Open resolution center <i class="bi bi-arrow-right"></i></a></div></article>
      <article class="<%= Number(A.paymentExceptionCount||0) ? 'danger' : 'success' %>"><i class="bi bi-receipt-cutoff"></i><div><small>Payments to check</small><strong><%= Number(A.paymentExceptionCount||0).toLocaleString('en-PH') %></strong><p><%= peso(A.paymentExceptionValue) %> amount needing a check · <%= Number(A.pendingLedgerCount||0).toLocaleString('en-PH') %> pending records</p><a href="<%= reportLinks.remittance %>"><%= reportRole === "secretary" ? "Review payments" : "Review payment custody" %> <i class="bi bi-arrow-right"></i></a></div></article>
      <article class="<%= Number(A.costDataCoverage||0) < 95 ? 'warning' : 'success' %>"><i class="bi bi-database-check"></i><div><small>Saved cost details</small><strong><%= pct(A.costDataCoverage) %></strong><p>Overall coverage · <%= pct(A.orderCostCoverage) %> completed-order sales with saved costs</p><a href="/<%= reportRole %>/reports/inventory">Check product costs <i class="bi bi-arrow-right"></i></a></div></article>
      <article class="<%= Number(A.pendingExpenseCount||0) + Number(A.draftPayrollCount||0) ? 'warning' : 'success' %>"><i class="bi bi-journal-check"></i><div><small>Costs waiting for approval</small><strong><%= Number(A.pendingExpenseCount||0) + Number(A.draftPayrollCount||0) %></strong><p><%= Number(A.pendingExpenseCount||0) %> pending expenses · <%= Number(A.draftPayrollCount||0) %> draft payrolls excluded from profit</p><a href="<%= reportLinks.costs %>"><%= reportRole === "secretary" ? "Review expenses" : "Review unposted costs" %> <i class="bi bi-arrow-right"></i></a></div></article>
    </div>
  </section>

  <!-- ═══ SECTION 2: REVENUE PERFORMANCE — THE REVENUE STORY ═══ -->
  <div id="section-performance" class="rr-section"><h2><i class="bi bi-bar-chart-line me-2" style="color:#2563eb;"></i>Approved work value Performance</h2><span class="text-muted small">Approved work by the month it was requested. Payments are shown separately.</span></div>
  <div class="rr-two">
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-graph-up me-2 text-primary"></i>Monthly approved work by type</h3><span class="rr-badge">Month requested · last 12 months</span></div>
      <div class="rr-chart"><canvas id="revenueTrend"></canvas></div>
    </article>
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-pie-chart me-2 text-primary"></i>Business Mix</h3><span class="rr-badge">Share of sales</span></div>
      <div class="rr-chart"><canvas id="sourceMix"></canvas></div>
    </article>
  </div>
  <div class="rr-source mt-3">
    <article class="rr-source-card service">
      <div class="rr-source-title"><i class="bi bi-wrench-adjustable me-2 text-primary"></i>Services</div>
      <div class="rr-source-value"><%= peso(A.serviceRevenue) %></div>
      <div class="rr-meta"><%= A.serviceTransactions||0 %> bookings · <%= peso(A.avgServiceTicket) %> avg ticket</div>
      <div class="rr-progress"><span style="width:<%= Math.min(100,A.serviceShare||0) %>%;background:#2563eb"></span></div>
      <div class="rr-meta"><%= pct(A.serviceShare) %> of total · Standard <%= peso(A.coreRevenue) %> · Repair <%= peso(A.repairRevenue) %></div>
    </article>
    <article class="rr-source-card orders">
      <div class="rr-source-title"><i class="bi bi-bag-check me-2 text-success"></i>Product Orders</div>
      <div class="rr-source-value"><%= peso(A.orderRevenue) %></div>
      <div class="rr-meta"><%= A.onlineOrderTransactions||0 %> online · <%= A.walkInOrderTransactions||0 %> walk-in orders</div>
      <div class="rr-progress"><span style="width:<%= Math.min(100,A.orderShare||0) %>%;background:#10b981"></span></div>
      <div class="rr-meta"><%= pct(A.orderShare) %> of total · Online <%= peso(A.onlineOrderRevenue) %> · Walk-in <%= peso(A.walkInOrderRevenue) %></div>
    </article>
    <article class="rr-source-card pos">
      <div class="rr-source-title"><i class="bi bi-shop me-2 text-warning"></i>Walk-in sales</div>
      <div class="rr-source-value"><%= peso(A.posRevenue) %></div>
      <div class="rr-meta"><%= A.posTransactions||0 %> sales · <%= peso(A.avgPosSale) %> avg sale</div>
      <div class="rr-progress"><span style="width:<%= Math.min(100,A.posShare||0) %>%;background:#f59e0b"></span></div>
      <div class="rr-meta"><%= pct(A.posShare) %> of total · Product cost <%= peso(A.posCost) %> · Profit <%= peso(A.posProfit) %> (<%= pct(A.posMargin) %> profit %)</div>
    </article>
  </div>

  <% const F=A.salesForecast||{}; %>
  <div class="rr-subsection" style="margin:20px 0 12px;"><h2><i class="bi bi-graph-up-arrow me-2"></i>30-Day Sales Outlook</h2><span class="text-muted small">Approved work value estimate · planning estimate</span></div>
  <div class="rr-forecast-layout">
    <article class="rr-card">
      <div class="rr-head"><div><span class="rr-eyebrow">Forward view</span><h3><i class="bi bi-stars me-2 text-primary"></i>Estimated future work value</h3><p id="forecastMethod"><%= F.method||'Forecast becomes available after revenue data loads.' %></p></div><span class="rr-badge" id="forecastConfidence"><%= F.confidence ? F.confidence+' confidence' : 'Awaiting data' %></span></div>
      <div class="rr-chart rr-forecast-chart"><canvas id="revenueForecast"></canvas></div>
      <div class="rr-forecast-caveat" id="forecastCaveat"><i class="bi bi-info-circle"></i><span><%= F.caveat||'This forecast is a planning aid and does not replace recognized-revenue reporting.' %></span></div>
    </article>
    <div class="rr-forecast-kpis" id="forecastKpis">
      <article class="rr-card"><small>Projected booking value</small><strong><%= peso(F.total) %></strong><p>Next <%= F.horizonDays||30 %> days</p></article>
      <article class="rr-card"><small>Expected range</small><strong><%= peso(F.lower) %>–<%= peso(F.upper) %></strong><p>Estimated low and high amounts</p></article>
      <article class="rr-card"><small>Compared with the last 30 days</small><strong class="<%= Number(F.projectedGrowthPercent||0)>=0?'positive':'negative' %>"><%= F.projectedGrowthPercent==null?'—':(Number(F.projectedGrowthPercent)>=0?'+':'')+pct(F.projectedGrowthPercent) %></strong><p><%= peso(F.comparisonTotal) %> recent actual</p></article>
      <article class="rr-card"><small>Past dates used</small><strong><%= F.basisDays||0 %> days</strong><p><%= F.activeDays||0 %> days with sales</p></article>
    </div>
  </div>

  <!-- ═══ SECTION 3: CASH COLLECTION & PAYMENT INTELLIGENCE ═══ -->
  <div id="section-collection" class="rr-section"><h2><i class="bi bi-bank me-2" style="color:#0891b2;"></i>Payments and refunds</h2><span class="text-muted small">See the payments received, refunds, and payment methods used</span></div>
  <div class="rr-equal">
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-credit-card me-2 text-info"></i>Payments received by Method</h3><span class="rr-badge"><%= peso(A.grossCollections) %> gross · refunds shown separately</span></div>
      <div class="rr-chart"><canvas id="paymentMix"></canvas></div>
    </article>
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-hourglass-split me-2 text-warning"></i>Payment summary</h3></div>
      <div class="rr-body" id="collectionHealthBody" style="padding:20px;">
        <div class="rr-collection-grid">
          <div style="text-align:center;padding:12px;background:#f0fdf4;border-radius:8px;">
            <div style="font-size:.65rem;font-weight:700;text-transform:uppercase;color:#059669;margin-bottom:4px;">Payments received</div>
            <div style="font-size:1.15rem;font-weight:700;color:#059669;"><%= peso(A.grossCollections) %></div>
          </div>
          <div style="text-align:center;padding:12px;background:#fef2f2;border-radius:8px;">
            <div style="font-size:.65rem;font-weight:700;text-transform:uppercase;color:#b91c1c;margin-bottom:4px;">Refunds</div>
            <div style="font-size:1.15rem;font-weight:700;color:#dc2626;"><%= peso(A.refunds) %></div>
          </div>
          <div style="text-align:center;padding:12px;background:#fefce8;border-radius:8px;">
            <div style="font-size:.65rem;font-weight:700;text-transform:uppercase;color:#92400e;margin-bottom:4px;">Outstanding</div>
            <div style="font-size:1.15rem;font-weight:700;color:#d97706;"><%= peso(A.outstandingValue) %></div>
          </div>
          <div style="text-align:center;padding:12px;background:#eff6ff;border-radius:8px;">
            <div style="font-size:.65rem;font-weight:700;text-transform:uppercase;color:#1d4ed8;margin-bottom:4px;">Payments after refunds</div>
            <div style="font-size:1.15rem;font-weight:700;color:#2563eb;"><%= peso(A.netCollections) %></div>
          </div>
        </div>
        <div style="font-size:.78rem;color:#475569;line-height:1.6;">
          <div style="margin-bottom:6px;"><strong>Share paid:</strong> <%= pct(A.collectionRate) %> of the approved work has been paid after refunds, up to the last report date.</div>
          <div style="margin-bottom:6px;"><strong>GCash:</strong> <%= peso(A.gcashRevenue) %> · <strong>Cash/COD:</strong> <%= peso(A.codRevenue) %> · <strong>Bank:</strong> <%= peso(A.bankRevenue) %></div>
          <div><strong>Unpaid balance:</strong> <%= peso(A.outstandingValue) %> remains between approved value and accepted collections.</div>
        </div>
      </div>
    </article>
  </div>

  <!-- ═══ SECTION 4: COST INTELLIGENCE & MARGIN ANALYSIS ═══ -->
  <div id="section-cost" class="rr-section"><h2><i class="bi bi-calculator me-2" style="color:#7c3aed;"></i>Costs and profit</h2><span class="text-muted small">Saved costs and profit estimates over time</span></div>
  <div class="rr-equal">
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-graph-up-arrow me-2" style="color:#059669;"></i>Completed sales vs Saved job and product cost</h3><span class="rr-badge">Completion-date basis</span></div>
      <div class="rr-chart"><canvas id="marginTrend"></canvas></div>
    </article>
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-boxes me-2 text-danger"></i>Saved cost summary</h3><span class="rr-badge"><%= pct(A.costDataCoverage) %> sales with saved job costs</span></div>
      <div class="rr-note" style="margin:0 0 12px;"><i class="bi bi-info-circle-fill me-2"></i>Costs are shown for finished work. Product costs use current stock prices. Job supplies use the cost saved when they were used. Missing labor or delivery costs can make profit look too high.</div>
      <div class="rr-body">
        <% const C=A.serviceCosts||{}; %>
        <div class="rr-cost-grid" id="costBreakdownGrid" style="grid-template-columns:repeat(3,1fr);">
          <div class="rr-cost-metric" style="border-top:3px solid #2563eb;"><div class="rr-label">Completed sales after refunds</div><div class="rr-value"><%= peso(A.recognizedRevenue) %></div></div>
          <div class="rr-cost-metric" style="border-top:3px solid #ef4444;"><div class="rr-label">Saved service costs</div><div class="rr-value"><%= peso(A.serviceDirectCost) %></div></div>
          <div class="rr-cost-metric" style="border-top:3px solid #f59e0b;"><div class="rr-label">Saved order costs</div><div class="rr-value"><%= peso(A.orderCost) %></div><div class="rr-meta">Products <%= peso(A.orderProductCost) %> · consumables <%= peso(A.orderConsumablesCost) %> · other installation <%= peso(A.orderLinkedServiceCost) %></div></div>
          <div class="rr-cost-metric" style="border-top:3px solid #c2410c;"><div class="rr-label">Walk-in product costs</div><div class="rr-value"><%= peso(A.posCost) %></div></div>
          <div class="rr-cost-metric" style="border-top:3px solid #7c3aed;"><div class="rr-label">Project Materials</div><div class="rr-value"><%= peso(A.projectMaterialCost) %></div></div>
          <div class="rr-cost-metric" style="border-top:3px solid #64748b;"><div class="rr-label">Approved expenses</div><div class="rr-value"><%= peso(A.operatingExpenses) %></div><div class="rr-meta">Approved expenses + payroll</div></div>
          <div class="rr-cost-metric" style="border-top:3px solid #10b981;"><div class="rr-label">Profit before expenses</div><div class="rr-value" style="color:<%= A.grossProfit>=0?'#059669':'#dc2626' %>;"><%= peso(A.grossProfit) %></div></div>
          <div class="rr-cost-metric" style="border-top:3px solid #0891b2;"><div class="rr-label">Profit after expenses</div><div class="rr-value" style="color:<%= A.operatingProfit>=0?'#059669':'#dc2626' %>;"><%= peso(A.operatingProfit) %></div></div>
          <div class="rr-cost-metric" style="border-top:3px solid #0f766e;"><div class="rr-label">Profit after expenses (%)</div><div class="rr-value"><%= pct(A.operatingProfitMargin) %></div></div>
        </div>
      </div>
    </article>
  </div>
  <div class="rr-note mt-3"><i class="bi bi-info-circle-fill me-2"></i><strong>Management note:</strong> These are estimates based on saved records. Sales count when work is finished, and refunds are deducted on the date money is returned. Only approved expenses and payroll are included. New orders save the bought price at checkout. Older orders use the current stock cost. Saved installation supplies and linked booking costs are counted under orders. Missing costs can make profit look too high.</div>

  <!-- ═══ SECTION 5: SERVICE PROFITABILITY DEEP DIVE ═══ -->
  <div id="section-service-profit" class="rr-section"><h2><i class="bi bi-clipboard-check me-2" style="color:#2563eb;"></i>Service sales, costs, and profit</h2><span class="text-muted small">See sales and saved costs for each standard or repair service</span></div>
  <div class="rr-note mb-3"><i class="bi bi-graph-down-arrow me-2"></i>Looking for services with the fewest bookings? <a href="/<%= reportRole %>/reports/service">Open Least Booked Services</a> in Service Reports. This section ranks completed service profit estimate.</div>
  <% const SP=A.serviceProfitability||{}; const SPR=SP.rows||[]; %>
  <div class="rr-profit-kpis" id="servicePortfolioKpis">
    <article class="rr-card"><span class="rr-profit-kpi-icon leader"><i class="bi bi-trophy"></i></span><div><small>Highest known profit</small><strong><%= SP.mostProfitable?.serviceName||'No completed data' %></strong><p><%= SP.mostProfitable?peso(SP.mostProfitable.grossProfit)+' · '+pct(SP.mostProfitable.grossProfitMargin)+' profit':'—' %></p></div></article>
    <article class="rr-card"><span class="rr-profit-kpi-icon review"><i class="bi bi-graph-down-arrow"></i></span><div><small>Lowest recorded profit</small><strong><%= SP.leastProfitable?.serviceName||'No completed data' %></strong><p><%= SP.leastProfitable?peso(SP.leastProfitable.grossProfit)+' · '+pct(SP.leastProfitable.grossProfitMargin)+' profit':'—' %></p></div></article>
    <article class="rr-card"><span class="rr-profit-kpi-icon margin"><i class="bi bi-percent"></i></span><div><small>Highest recorded profit %</small><strong><%= SP.highestMargin?.serviceName||'No completed data' %></strong><p><%= SP.highestMargin?pct(SP.highestMargin.grossProfitMargin)+' · '+SP.highestMargin.jobs+' jobs':'—' %></p></div></article>
    <article class="rr-card"><span class="rr-profit-kpi-icon risk"><i class="bi bi-exclamation-triangle"></i></span><div><small>Services requiring action</small><strong><%= SP.atRiskCount||0 %></strong><p>Recorded profit below zero or below 15% of sales</p></div></article>
  </div>
  <div class="rr-equal mt-3">
    <article class="rr-card">
      <div class="rr-head"><div><span class="rr-eyebrow">Compare services</span><h3><i class="bi bi-bar-chart-steps me-2 text-primary"></i>Profit by Service</h3><p>Ranked using completed jobs and saved job and product cost</p></div><span class="rr-badge" id="servicePortfolioBadge"><%= SPR.length %> service lines</span></div>
      <div class="rr-chart"><canvas id="serviceProfitRanking"></canvas></div>
    </article>
    <article class="rr-card">
      <div class="rr-head"><div><span class="rr-eyebrow">Next steps</span><h3><i class="bi bi-lightbulb me-2 text-warning"></i>Service next steps</h3><p>What to check next</p></div></div>
      <div class="rr-decision-list" id="serviceDecisionInsights"><% if(!(SP.insights||[]).length){ %><div class="rr-empty">Insights appear when completed service cost data is available.</div><% } (SP.insights||[]).forEach(function(insight){ %><article class="<%= insight.tone %>"><i class="bi <%= insight.tone==='danger'?'bi-exclamation-octagon':insight.tone==='success'?'bi-arrow-up-right-circle':'bi-info-circle' %>"></i><div><strong><%= insight.title %></strong><p><%= insight.text %></p><span>Recommended: <%= insight.action %></span></div></article><% }); %></div>
    </article>
  </div>
  <article class="rr-card mt-3">
    <div class="rr-head"><div><span class="rr-eyebrow">Service list</span><h3><i class="bi bi-sort-down me-2 text-primary"></i>Service profit estimates and next steps</h3><p>Sales and shared booking costs add up to the completed service totals</p></div><span class="rr-badge">Click Details to see the jobs</span></div>
    <div class="rr-body table-responsive">
      <table class="rr-table rr-portfolio-table"><thead><tr><th>Rank</th><th>Service</th><th class="text-center">Jobs / Units</th><th class="text-end">Sales</th><th class="text-end">Saved job and product cost</th><th class="text-end">Profit before expenses</th><th>Decision</th><th></th></tr></thead><tbody id="servicePortfolioBody"><% if(!SPR.length){ %><tr><td colspan="8" class="rr-empty">No finished jobs with profit details during these dates.</td></tr><% } SPR.forEach(function(row,index){ %><tr><td><span class="rr-rank <%= index<3?'top':'' %>"><%= row.rank %></span></td><td><strong><%= row.serviceName %></strong><div class="rr-meta"><%= row.serviceCategory %> · <%= pct(row.costEvidenceCoverage) %> saved cost details</div></td><td class="text-center"><%= row.jobs %> / <%= row.units %></td><td class="text-end"><%= peso(row.revenue) %></td><td class="text-end"><%= peso(row.directCost) %></td><td class="text-end fw-bold <%= row.grossProfit>=0?'text-success':'text-danger' %>"><%= peso(row.grossProfit) %><div class="rr-meta"><%= pct(row.grossProfitMargin) %> profit</div></td><td><span class="rr-action <%= row.action?.tone||'info' %>"><%= row.action?.label||'Monitor' %></span><div class="rr-meta rr-action-detail"><%= row.action?.detail||'' %></div></td><td><button type="button" class="btn btn-sm btn-outline-primary service-drilldown-btn" data-service-index="<%= index %>">Details</button></td></tr><% }); %></tbody></table>
    </div>
    <div class="rr-allocation-note"><i class="bi bi-calculator"></i><span><strong>How shared costs are split:</strong> Saved service prices split the booking total. Any remaining amount is split by unit count. Costs saved for one service go to that service. Shared booking costs are split by each service’s share of the booking price. Use these estimates when reviewing services. Missing costs can change the result.</span></div>
  </article>
  <article class="rr-card mt-3">
    <div class="rr-head"><div><span class="rr-eyebrow">Saved job costs</span><h3><i class="bi bi-list-check me-2 text-primary"></i>Completed Booking Detail</h3><p>The saved booking costs used to estimate profit for each service</p></div><div class="d-flex align-items-center gap-2"><span class="rr-badge" id="serviceProfitabilityBadge">Latest 5 of <%= (A.completedServiceCosts||[]).length %></span><button class="btn btn-primary btn-sm" id="serviceProfitabilityViewAllBtn" data-bs-toggle="modal" data-bs-target="#serviceProfitabilityModal" style="display:<%= (A.completedServiceCosts||[]).length>5?'inline-flex':'none' %>;"><i class="bi bi-arrows-angle-expand me-1"></i>View All</button></div></div>
    <div class="rr-body table-responsive">
      <table class="rr-table"><thead><tr><th>Service</th><th class="text-end">Sales</th><th class="text-end">Repair Parts</th><th class="text-end">Job supplies</th><th class="text-end">Labor</th><th class="text-end">Profit before expenses</th></tr></thead><tbody id="serviceProfitabilityBody"><% if(!(A.completedServiceCosts||[]).length){ %><tr><td colspan="6" class="rr-empty">No completed services in this reporting period.</td></tr><% } (A.completedServiceCosts||[]).slice(0,5).forEach(function(s){ %><tr><td><details class="rr-service-detail"><summary><strong><%= s.serviceName %></strong> <i class="bi bi-chevron-down ms-1"></i><div class="rr-meta"><%= s.reference %> · <%= s.customer %></div></summary><div class="rr-resource-list"><div>Technician: <%= s.technician %> · Duration: <%= s.laborHours.toFixed(1) %>h</div><div>Job supplies: <%= s.consumables.length ? s.consumables.map(i=>i.name+' ('+i.quantity+' '+i.unit+')').join(', ') : 'None' %></div><div>Repair parts: <%= s.repairParts.length ? s.repairParts.map(i=>i.name+' ('+i.quantity+' '+i.unit+')').join(', ') : 'None' %></div></div></details></td><td class="text-end"><%= peso(s.revenue) %></td><td class="text-end"><%= peso(s.partsCost) %></td><td class="text-end"><%= peso(s.consumablesCost) %></td><td class="text-end"><%= peso(s.laborCost) %></td><td class="text-end fw-bold <%= s.grossProfit>=0?'text-success':'text-danger' %>"><%= peso(s.grossProfit) %><div class="rr-meta"><%= pct(s.grossProfitMargin) %></div></td></tr><% }); %></tbody></table>
    </div>
  </article>
  <div class="rr-equal mt-3">
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-diagram-3 me-2 text-primary"></i>Standard and repair service profit estimates</h3><span class="rr-badge">Sales mix</span></div>
      <div class="rr-chart"><canvas id="serviceEconomics"></canvas></div>
    </article>
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-people me-2 text-primary"></i>Technicians with the highest sales</h3><span class="rr-badge">Ranked by recorded profit</span></div>
      <div class="rr-body table-responsive">
        <table class="rr-table"><thead><tr><th>Technician</th><th class="text-center">Jobs</th><th class="text-end">Approved work value</th><th class="text-end">Known Cost</th><th class="text-end">Profit estimate</th></tr></thead><tbody id="topTechniciansBody"><% if(!(A.topTechnicians||[]).length){ %><tr><td colspan="5" class="rr-empty">No technician value in this period.</td></tr><% } (A.topTechnicians||[]).forEach(function(t){ %><tr><td class="fw-bold"><%= t.name %></td><td class="text-center"><%= t.bookings %></td><td class="text-end"><%= peso(t.revenue) %></td><td class="text-end"><%= peso(t.partsCost) %></td><td class="text-end fw-bold <%= t.profit>=0?'text-success':'text-danger' %>"><%= peso(t.profit) %></td></tr><% }); %></tbody></table>
      </div>
    </article>
  </div>

  <!-- ═══ SECTION 6: POS & PRODUCT PERFORMANCE ═══ -->
  <div id="section-pos" class="rr-section"><h2><i class="bi bi-shop me-2" style="color:#f59e0b;"></i>Walk-in and product sales</h2><span class="text-muted small">Repair parts, consumables, and aircon products — completed sales only</span></div>
  <div class="rr-pos-category-grid" id="posCategoryBreakdown">
    <% (A.posCategoryBreakdown||[
      {key:'repair_parts',label:'Repair Parts',transactionCount:0,units:0,revenue:0,cost:0,profit:0,margin:0},
      {key:'consumables',label:'Consumables',transactionCount:0,units:0,revenue:0,cost:0,profit:0,margin:0},
      {key:'aircon_products',label:'Aircon Products',transactionCount:0,units:0,revenue:0,cost:0,profit:0,margin:0}
    ]).forEach(function(category){ %>
      <article class="rr-card rr-pos-category-card <%= category.key %>">
        <div class="rr-pos-category-icon"><i class="bi <%= category.key==='aircon_products'?'bi-snow':category.key==='consumables'?'bi-droplet-half':'bi-wrench-adjustable' %>"></i></div>
        <div class="rr-pos-category-copy">
          <small><%= category.label %></small>
          <strong><%= peso(category.revenue) %></strong>
          <p><%= Number(category.units||0).toLocaleString('en-PH') %> units · <%= Number(category.transactionCount||0).toLocaleString('en-PH') %> completed sales</p>
        </div>
        <div class="rr-pos-category-finance"><span>Product cost <b><%= peso(category.cost) %></b></span><span>Profit before expenses <b class="<%= Number(category.profit||0)>=0?'positive':'negative' %>"><%= category.costComplete === false ? "Incomplete costs" : peso(category.profit) %></b></span><span>Profit % <b><%= category.costComplete === false ? "—" : pct(category.margin) %></b></span></div>
      </article>
    <% }); %>
  </div>
  <div class="rr-note rr-pos-method-note"><i class="bi bi-info-circle-fill me-2"></i><strong>What is included:</strong> Includes repair parts and job supplies sold to customers. Company equipment is not included. Aircon totals use completed walk-in orders and do not include delivery or installation fees.</div>
  <div class="rr-equal">
    <article class="rr-card">
      <div class="rr-head rr-pos-products-head"><div><h3><i class="bi bi-trophy me-2 text-warning"></i>Top walk-in products by category</h3><p>Completed merchandise sales ranked by revenue</p></div><span class="rr-badge" id="posSummaryBadge"><%= (A.posCategoryProducts||[]).length %> products</span></div>
      <div class="rr-pos-tabs" id="posCategoryTabs" role="tablist" aria-label="Filter POS product categories">
        <button type="button" class="active" role="tab" aria-selected="true" data-pos-category="all">All</button>
        <button type="button" role="tab" aria-selected="false" data-pos-category="repair_parts"><i class="bi bi-wrench-adjustable"></i> Repair Parts</button>
        <button type="button" role="tab" aria-selected="false" data-pos-category="consumables"><i class="bi bi-droplet-half"></i> Job supplies</button>
        <button type="button" role="tab" aria-selected="false" data-pos-category="aircon_products"><i class="bi bi-snow"></i> Aircon Products</button>
      </div>
      <div class="rr-body table-responsive">
        <table class="rr-table"><thead><tr><th>Product</th><th>Category</th><th class="text-center">Qty</th><th class="text-end">Sales</th><th class="text-end">Product cost</th><th class="text-end">Profit</th></tr></thead><tbody id="topPosProductsBody"><% if(!(A.posCategoryProducts||[]).length){ %><tr><td colspan="6" class="rr-empty">No completed Walk-in sales product sales in this period.</td></tr><% } (A.posCategoryProducts||[]).slice(0,8).forEach(function(p){ %><tr><td class="fw-bold"><%= p.name %><div class="rr-meta"><%= p.category %></div></td><td><span class="rr-pos-category-tag <%= p.businessCategory %>"><%= p.businessCategoryLabel %></span></td><td class="text-center"><%= p.quantity %></td><td class="text-end"><%= peso(p.revenue) %></td><td class="text-end"><%= peso(p.cost) %></td><td class="text-end fw-bold <%= p.profit>=0?'text-success':'text-danger' %>"><%= p.costComplete === false ? "Incomplete costs" : peso(p.profit) %></td></tr><% }); %></tbody></table>
      </div>
    </article>
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-credit-card me-2 text-warning"></i>Walk-in payment methods</h3><span class="rr-badge"><%= pct(A.posMargin) %> profit %</span></div>
      <div class="rr-chart"><canvas id="posPaymentMix"></canvas></div>
    </article>
  </div>

  <article class="rr-card mt-3" aria-labelledby="lowestPosProductsTitle">
    <div class="rr-head"><div><h3 id="lowestPosProductsTitle"><i class="bi bi-graph-down-arrow me-2 text-warning"></i>Walk-in products with the fewest sales</h3><p>Fewest units sold among products with completed sales in the selected dates. The category tabs above also filter this list.</p></div><span class="rr-badge" id="lowestPosSummaryBadge"><%= (A.lowestSellingPosProducts||[]).length %> sold products</span></div>
    <div class="rr-body table-responsive"><table class="rr-table"><thead><tr><th>Product</th><th>Category</th><th class="text-center">Units sold</th><th class="text-end">Sales value</th><th>Review</th></tr></thead><tbody id="lowestPosProductsBody"><% if(!(A.lowestSellingPosProducts||[]).length){ %><tr><td colspan="5" class="rr-empty">No completed Walk-in sales product sales in this period.</td></tr><% } (A.lowestSellingPosProducts||[]).slice(0,8).forEach(function(p){ %><tr><td class="fw-bold"><%= p.name %><div class="rr-meta"><%= p.category %></div></td><td><span class="rr-pos-category-tag <%= p.businessCategory %>"><%= p.businessCategoryLabel %></span></td><td class="text-center"><%= Number(p.quantity||0).toLocaleString('en-PH') %></td><td class="text-end"><%= peso(p.revenue) %></td><td>Check demand before replenishing</td></tr><% }); %></tbody></table></div>
    <div class="rr-note m-3"><i class="bi bi-info-circle-fill me-2"></i>Products with zero sales are outside this transaction ranking. <a href="/<%= reportRole %>/reports?tab=decisions">Review Suggested Actions</a> for catalog items with no recorded movement and current stock.</div>
  </article>

  <!-- Product Intelligence (merged under Walk-in and product sales) -->
  <div class="rr-note mt-3">Aircon product profit uses completed sales after discounts, minus the bought price of each unit. Refunds, delivery, labor, and other costs are handled in the order totals above. Add missing bought prices under Aircons; new orders keep the price saved at checkout.</div>
  <div class="rr-subsection" style="margin:20px 0 12px;"><h2 style="font-size:.78rem;border-left-color:#0891b2;"><i class="bi bi-box-seam me-2" style="color:#0891b2;"></i>Online and walk-in product sales</h2><span class="text-muted small">Online and walk-in sales shown together</span></div>
  <!-- Product KPIs (enterprise style) -->
  <div class="kpi-grid report-kpi-grid" id="productKpiGrid" style="grid-template-columns:repeat(3,1fr);margin-bottom:16px;">
    <div class="kpi-enterprise" data-accent="cyan" data-aos="fade-up" data-aos-delay="0">
      <div class="kpi-enterprise-top">
        <div class="kpi-enterprise-icon cyan"><i class="bi bi-box-seam"></i></div>
        <span class="kpi-enterprise-badge cyan"><%= (A.totalProductUnits||0).toLocaleString() %> units</span>
      </div>
      <div class="kpi-enterprise-body">
        <p class="kpi-enterprise-label">Total Units Sold</p>
        <div class="kpi-enterprise-value"><%= (A.totalProductUnits||0).toLocaleString() %></div>
        <small style="color:#64748b;">Across online orders + Walk-in sales</small>
      </div>
    </div>
    <div class="kpi-enterprise" data-accent="blue" data-aos="fade-up" data-aos-delay="50">
      <div class="kpi-enterprise-top">
        <div class="kpi-enterprise-icon blue"><i class="bi bi-cash-stack"></i></div>
      </div>
      <div class="kpi-enterprise-body">
        <p class="kpi-enterprise-label">Product sales</p>
        <div class="kpi-enterprise-value"><%= peso(A.totalProductRevenue) %></div>
        <small style="color:#64748b;">Combined order + Walk-in sales product sales</small>
      </div>
    </div>
    <div class="kpi-enterprise" data-accent="green" data-aos="fade-up" data-aos-delay="100">
      <div class="kpi-enterprise-top">
        <div class="kpi-enterprise-icon green"><i class="bi bi-bag-check"></i></div>
        <span class="kpi-enterprise-badge green"><%= A.orderTransactions||0 %> orders</span>
      </div>
      <div class="kpi-enterprise-body">
        <p class="kpi-enterprise-label">Online Order Units</p>
        <div class="kpi-enterprise-value"><%= Number(A.onlineOrderProductUnits||0).toLocaleString('en-PH') %></div>
        <small style="color:#64748b;"><%= peso(A.onlineOrderProductRevenue) %> merchandise revenue</small>
      </div>
    </div>
  </div>

  <div class="rr-equal">
    <!-- Top Selling Products (Combined) -->
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-trophy me-2" style="color:#0891b2;"></i>Top Selling Products — All Channels</h3><span class="rr-badge"><%= (A.combinedTopProducts||[]).length %> products</span></div>
      <div class="rr-body table-responsive">
        <table class="rr-table"><thead><tr><th>#</th><th>Product</th><th>Channel</th><th class="text-center">Qty</th><th class="text-end">Sales</th><th class="text-end">Bought cost</th><th class="text-end">Product profit</th><th class="text-end">Share</th></tr></thead><tbody>
        <% if(!(A.combinedTopProducts||[]).length){ %><tr><td colspan="8" class="rr-empty">No product sales in this period.</td></tr><% } %>
        <% var totalProdRev = A.totalProductRevenue || 1; %>
        <% (A.combinedTopProducts||[]).slice(0,10).forEach(function(p,i){ %>
        <tr>
          <td><span class="rr-badge" style="background:<%= i<3?'rgba(8,145,178,0.1);color:#0891b2':'#f1f5f9;color:#475569' %>;"><%= i+1 %></span></td>
          <td class="fw-bold"><%= p.name %><div class="rr-meta"><%= p.category %></div></td>
          <td><span class="rr-badge" style="background:<%= p.channel==='POS'?'rgba(245,158,11,0.1);color:#d97706':'rgba(16,185,129,0.1);color:#059669' %>;"><%= p.channel %></span></td>
          <td class="text-center"><%= p.quantity %></td>
          <td class="text-end fw-bold"><%= peso(p.revenue) %></td>
          <td class="text-end"><%= peso(p.cost) %><% if (p.costComplete === false) { %><div class="rr-meta text-warning">Some bought prices are missing</div><% } %></td>
          <td class="text-end"><%= p.costComplete === false ? "Incomplete costs" : peso(p.profit) %></td>
          <td class="text-end"><%= pct(p.revenue/totalProdRev*100) %></td>
        </tr>
        <% }); %>
        </tbody></table>
      </div>
    </article>

    <!-- Product Channel Split Chart -->
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-pie-chart me-2" style="color:#0891b2;"></i>Product sales by Channel</h3><span class="rr-badge">Order vs Walk-in sales</span></div>
      <div class="rr-chart"><canvas id="productChannelMix"></canvas></div>
    </article>
  </div>

  <!-- Online Order Product Deep Dive -->
  <% if((A.topOrderProducts||[]).length){ %>
  <div class="rr-equal mt-3">
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-bag-check me-2 text-success"></i>Online Order Products</h3><span class="rr-badge" id="onlineProductSummary"><%= Number(A.onlineOrderProductUnits||0).toLocaleString('en-PH') %> units · <%= peso(A.onlineOrderProductRevenue) %> merchandise</span></div>
      <div class="rr-body table-responsive">
        <table class="rr-table"><thead><tr><th>Model</th><th>Brand</th><th class="text-center">Capacity</th><th class="text-center">Units</th><th class="text-end">Sales</th><th class="text-end">Average price</th></tr></thead><tbody>
        <% (A.topOrderProducts||[]).slice(0,8).forEach(function(p){ %>
        <tr>
          <td class="fw-bold"><%= p.name %></td>
          <td><span class="rr-badge"><%= p.brand %></span></td>
          <td class="text-center"><%= p.capacity %></td>
          <td class="text-center"><%= p.quantity %></td>
          <td class="text-end fw-bold"><%= peso(p.revenue) %></td>
          <td class="text-end"><%= peso(p.avgUnitPrice) %></td>
        </tr>
        <% }); %>
        </tbody></table>
      </div>
    </article>
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-building me-2 text-success"></i>Sales by brand</h3><span class="rr-badge"><%= (A.orderBrandAnalysis||[]).length %> brands</span></div>
      <div class="rr-chart"><canvas id="brandRevenue"></canvas></div>
    </article>
  </div>

  <div class="rr-equal mt-3">
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-speedometer me-2 text-success"></i>Capacity Breakdown</h3><span class="rr-badge">Sales by tonnage</span></div>
      <div class="rr-body table-responsive">
        <table class="rr-table"><thead><tr><th>Capacity</th><th class="text-center">Units</th><th class="text-center">Orders</th><th class="text-end">Sales</th><th class="text-end">Share</th></tr></thead><tbody>
        <% var capTotal = (A.orderCapacityAnalysis||[]).reduce(function(s,c){return s+c.revenue},0) || 1; %>
        <% (A.orderCapacityAnalysis||[]).forEach(function(c){ %>
        <tr>
          <td class="fw-bold"><%= c.capacity %></td>
          <td class="text-center"><%= c.quantity %></td>
          <td class="text-center"><%= c.orders %></td>
          <td class="text-end fw-bold"><%= peso(c.revenue) %></td>
          <td class="text-end"><%= pct(c.revenue/capTotal*100) %></td>
        </tr>
        <% }); %>
        </tbody></table>
      </div>
    </article>
    <article class="rr-card">
      <div class="rr-head"><h3><i class="bi bi-truck me-2 text-success"></i>Delivery and pickup</h3><span class="rr-badge">Delivery vs Pickup</span></div>
      <div class="rr-chart"><canvas id="fulfillmentMix"></canvas></div>
    </article>
  </div>
  <% } %>


  <!-- ═══ SECTION 7: RECENT COMMERCIAL ACTIVITY ═══ -->
  <div id="section-activity" class="rr-section"><h2><i class="bi bi-journal-text me-2" style="color:#334155;"></i>Recent bookings and sales</h2><span class="text-muted small">Service bookings, online orders, and walk-in sales, listed by date</span></div>
  <article class="rr-card">
    <div class="rr-body table-responsive">
