    || sidebarPathMatches('/admin/projects')
    || sidebarPathMatches('/admin/operations/resolution-center')
    || sidebarPathMatches('/admin/warranty')
    || sidebarPathMatches('/admin/product-returns')
    || sidebarPathMatches('/admin/maintenance');
  const servicesGroupOpen = sidebarPathMatches('/admin/services');
  const inventoryGroupOpen = sidebarPathMatches('/admin/inventory');
  const peopleGroupOpen = sidebarPathMatches('/admin/customers')
    || sidebarPathMatches('/admin/technicians')
    || sidebarPathMatches('/admin/staff');
  const financeGroupOpen = sidebarPathMatches('/admin/payments')
    || sidebarPathMatches('/admin/payroll')
    || sidebarPathMatches('/admin/refunds')
    || sidebarPathMatches('/admin/invoices');
  const analyticsGroupOpen = sidebarPathMatches('/admin/reports')
    || sidebarPathMatches('/admin/ratings');
  const systemGroupOpen = sidebarPathMatches('/admin/settings')
    || sidebarPathMatches('/admin/roles')
    || sidebarPathMatches('/admin/archive')
    || sidebarPathMatches('/admin/audit-trail');
  const sidebarUser = typeof user !== 'undefined' && user ? user : {};
  const sidebarName = sidebarUser.name || sidebarUser.fullName
    || [sidebarUser.firstName, sidebarUser.lastName].filter(Boolean).join(' ')
    || sidebarUser.email || 'Administrator';
  const sidebarRole = sidebarUser.role === 'secretary' ? 'Secretary' : 'System administrator';
  const sidebarInitial = String(sidebarName || 'A').trim().charAt(0).toUpperCase() || 'A';
