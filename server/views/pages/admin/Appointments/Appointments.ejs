  <script id="apptsInitialBookingsJson" type="application/json">
    <%- JSON.stringify(initialBookings || []) %>
  </script>

  <!-- Chart.js for KPI sparklines -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    (function () {
      const qs = (s) => document.querySelector(s);
      const qsa = (s) => Array.from(document.querySelectorAll(s));

      // normalize proof image string into a usable src/href
      function normalizeProofSrc(raw) {
        if (!raw) return null;
        let imgSrc = String(raw);
        // common case: raw base64 payload without data: prefix
        if (/^[A-Za-z0-9+/]+={0,2}$/.test(imgSrc)) {
          imgSrc = "data:image/jpeg;base64," + imgSrc; // fallback to jpeg
        }
        // if still not a data URL or absolute/http(s) path, decide what to do
        if (!/^data:|^https?:\/\//i.test(imgSrc)) {
          if (imgSrc.startsWith("/")) {
            // treat as server-relative URL; leave it alone
          } else {
            imgSrc = "/api/appointments/proof/" + encodeURIComponent(imgSrc);
          }
        }
        return imgSrc;
      }

      // track which status the main listing is showing (defaults to scheduled)
      let currentListStatus = "scheduled";

      // Tab switching handles both dedicated status buttons (data-status)
      // and traditional content tabs (data-tab).
      qsa("#apptsTabs button").forEach((btn) =>
        btn.addEventListener("click", function () {
          qsa("#apptsTabs .nav-link").forEach((n) =>
            n.classList.remove("active"),
          );
          this.classList.add("active");
          const statusKey = this.getAttribute("data-status");
          const tabKey = this.getAttribute("data-tab");
          const pageTitle = document.querySelector(
            ".dashboard-hero .page-title",
          );

          // hide all panels first
          qsa(".tab-pane").forEach((t) => t.classList.add("d-none"));

          if (statusKey) {
            // always show appointments list
            document.getElementById("tab-list").classList.remove("d-none");
            if (pageTitle) {
              if (statusKey === "completed") {
                pageTitle.innerHTML = '<i class="bi bi-calendar3-fill me-2"></i>Completed Appointments';
              } else if (statusKey === "scheduled") {
                pageTitle.innerHTML = '<i class="bi bi-calendar3-fill me-2"></i>Scheduled Appointments';
              } else {
                pageTitle.innerHTML = '<i class="bi bi-calendar3-fill me-2"></i>Appointments';
              }
            }
            loadCombinedOverview(statusKey);
          } else if (tabKey) {
            document.getElementById(tabKey).classList.remove("d-none");
            if (pageTitle) {
              if (tabKey === "tab-requests")
                pageTitle.innerHTML = '<i class="bi bi-calendar3-fill me-2"></i>Booking Requests';
              else if (tabKey === "tab-reschedule")
                pageTitle.innerHTML = '<i class="bi bi-calendar3-fill me-2"></i>Reschedule Requests';
              else if (tabKey === "tab-cancel")
                pageTitle.innerHTML = '<i class="bi bi-calendar3-fill me-2"></i>Cancelled Appointments';
              else if (tabKey === "tab-waiting-accept")
                pageTitle.innerHTML = '<i class="bi bi-calendar3-fill me-2"></i>Waiting for Acceptance';
              else pageTitle.innerHTML = '<i class="bi bi-calendar3-fill me-2"></i>Appointments';
            }
            if (tabKey === "tab-list") {
              loadCombinedOverview(currentListStatus);
            } else if (tabKey === "tab-requests") {
              loadBookingRequests();
            } else if (tabKey === "tab-cancel") {
              loadCancelPage();
            } else if (tabKey === "tab-reschedule") {
              // Load reschedule requests
              loadRescheduleRequests();
            } else if (tabKey === "tab-waiting-accept") {
              loadWaitingAcceptTab();
            }
          }
        }),
      );

      // relocate modal element to body
      document.addEventListener("DOMContentLoaded", () => {
        const m = document.getElementById("apptsSharedModal");
        if (m && m.parentElement !== document.body) {
          document.body.appendChild(m);
        }
      });

      // Shared data stores
      // Combined appointments list will initially track whichever status is
      // currently selected by the nav buttons (defaults to "scheduled").
      // the server API does not natively support a completed-only endpoint.

      // Global state variables
      let combinedAppointments = [];
      let combinedStaff = [];
      let bookingRequests = [];

      // if the server sent us some bookings, use them as initial state
      combinedAppointments =
        JSON.parse(
          document.getElementById("apptsInitialBookingsJson")?.textContent ||
            "[]",
        ) || [];
      // move shared modal into <body> to avoid stacking context/z-index issues
      document.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById("apptsSharedModal");
        if (modal && modal.parentElement !== document.body) {
          document.body.appendChild(modal);
        }
        // inject high-z styles for modal/backdrop
        const css = document.createElement("style");
        css.textContent =
          "#apptsSharedModal { z-index: 2000 !important; } .modal-backdrop { z-index: 1500 !important; backdrop-filter: none !important; } #apptsImageModal { z-index: 9999 !important; } #apptsImageModal ~ .modal-backdrop { z-index: 9990 !important; }";
        document.head.appendChild(css);

        // Image viewer overlay for viewing images on top of the details modal (custom overlay, not Bootstrap modal)
        if (!document.getElementById('apptsImageOverlay')) {
          const overlay = document.createElement('div');
          overlay.id = 'apptsImageOverlay';
          overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:99999;display:none;align-items:center;justify-content:center;cursor:pointer;';
          overlay.innerHTML = `
            <button type="button" style="position:absolute;top:20px;right:20px;background:#1e293b;border:none;border-radius:50%;width:48px;height:48px;color:#fff;font-size:24px;cursor:pointer;z-index:100000;">&times;</button>
            <img id="apptsImageOverlayImg" src="" style="max-width:90vw;max-height:85vh;border-radius:8px;box-shadow:0 8px 32px rgba(0,0,0,0.4);pointer-events:none;" />
          `;
          document.body.appendChild(overlay);
          
          // Close on click
          overlay.addEventListener('click', function(e) {
            if (e.target === overlay || e.target.tagName === 'BUTTON') {
              overlay.style.display = 'none';
            }
          });
        }

        // helper: open image in custom overlay on top of all modals
        window.openApptsImage = function(src) {
          const img = document.getElementById('apptsImageOverlayImg');
          const overlay = document.getElementById('apptsImageOverlay');
          if (img && overlay) {
            img.src = src;
            overlay.style.display = 'flex';
          }
        };
      });

      // draw what we already have so the page isn't blank while the API loads
      if (combinedAppointments && combinedAppointments.length) {
        renderAppointmentsTable(combinedAppointments);
        // also seed the reschedule selector and map
        const sel = document.getElementById("rescheduleSelect");
        if (sel) {
          sel.innerHTML = "";
          combinedAppointments.slice(0, 200).forEach((a) => {
            const key = a._id || a.id || a.bookingId || a.start || JSON.stringify(a);
            const opt = document.createElement("option");
            opt.value = key;
            opt.textContent = `${a.bookingDate || a.date || ""} — ${
              a.customerName ||
              (a.customer && a.customer.name) ||
              a.customer ||
              a.title ||
              "Booking"
            }`;
            sel.appendChild(opt);
            reschedAppointmentsMap.set(key, a);
          });
        }
      }

      // helper: display a loading spinner row inside a table body element
      function showLoadingRow(tbody) {
        if (!tbody) return;
        tbody.innerHTML =
          '<tr><td colspan="10" class="text-center py-5">' +
            '<div class="spinner-border spinner-border-sm" role="status" ' +
            'style="vertical-align:middle;margin-right:6px;"><span class="visually-hidden">Loading...</span></div>' +
            'Loading…</td></tr>';
      }

      // Load initial overview (list KPIs + table + trend)
      // load overview: metrics + appointment list filtered by provided status.
      async function loadCombinedOverview(statusOverride) {
        if (statusOverride) {
          currentListStatus = statusOverride;
        }
        // show spinner while we fetch
        showLoadingRow(document.getElementById("appointmentsBodyCombined"));
        try {
          const sRes = await fetch("/api/admin/analytics/summary");
          const s = sRes.ok ? await sRes.json() : {};
          // KPI metrics should reflect real status buckets.
          let metricAppointments = [];
          try {
            const mRes = await fetch("/api/appointments?upcoming=1");
            if (mRes.ok) {
              const mj = await mRes.json();
              metricAppointments = mj.items || mj.appointments || [];
            }
          } catch (_) {}

          const pendingCount = metricAppointments.filter(
            (a) => statusLabel(a.status) === "pending",
          ).length;
          const scheduledCount = metricAppointments.filter(
            (a) => statusLabel(a.status) === "scheduled",
          ).length;
          const onTheWayCount = metricAppointments.filter(
            (a) => statusLabel(a.status) === "on-the-way",
          ).length;
          const completedCount = metricAppointments.filter(
            (a) => statusLabel(a.status) === "completed",
          ).length;
          const cancelledCount = metricAppointments.filter(
            (a) => statusLabel(a.status) === "cancelled",
          ).length;

          const hasMetricList =
            Array.isArray(metricAppointments) && metricAppointments.length > 0;

          document.getElementById("kpi-today-combined").innerText =
            hasMetricList ? scheduledCount : (s.activeJobsInProgress ?? "—");
          document.getElementById("kpi-on-the-way-combined").innerText =
            hasMetricList ? onTheWayCount : (s.onTheWayCount ?? "—");
          document.getElementById("kpi-pending-combined").innerText =
            hasMetricList ? pendingCount : (s.pendingBookingRequests ?? "—");
          document.getElementById("kpi-completed-combined").innerText =
            hasMetricList ? completedCount : (s.activeJobsInProgress ?? "—");
          document.getElementById("kpi-cancelled-combined").innerText =
            hasMetricList ? cancelledCount : "0";

          // badges - mimic dashboard behaviour using summary payload or defaults
          var badgeData = s.kpiBadges || {
            appointments: '+0%',
            pending: '+0%',
            activeJobs: '+0%',
            completedJobs: '+0%',
            lowStock: '+0%'
          };
          function applyBadge(id, text) {
            var el = document.getElementById(id);
            if (!el) return;
            el.innerHTML = text;
            // Remove any existing trend classes
            el.classList.remove('positive','negative','neutral');
            // Add trend class based on text
            if (/^[+]/.test(text)) {
              el.classList.add('positive');
            } else if (/^[-]/.test(text)) {
              el.classList.add('negative');
            } else {
              el.classList.add('neutral');
            }
          }
          applyBadge('badge-today-combined', badgeData.appointments);
          applyBadge('badge-on-the-way-combined', badgeData.activeJobs);
          applyBadge('badge-pending-combined', badgeData.pending);
          applyBadge('badge-completed-combined', badgeData.completedJobs);
          applyBadge('badge-cancelled-combined', badgeData.lowStock);

          // load appointments from server using status filter
          let appts = [];
          let fetchSucceeded = false;
          try {
            const params = new URLSearchParams();
            params.set("upcoming", "1");
            params.set("sort", "newest");
            const searchVal = document
              .getElementById("filterSearchCombined")
              ?.value.trim();
            if (searchVal) params.set("search", searchVal);
            const startVal = document.getElementById(
              "filterStartCombined",
            )?.value;
            if (startVal) params.set("start", startVal);
            const endVal = document.getElementById("filterEndCombined")?.value;
            if (endVal) params.set("end", endVal);
            if (currentListStatus && currentListStatus !== "all") {
              params.set("status", currentListStatus);
            }
            const techVal =
              document.getElementById("filterTechCombined")?.value;
            if (techVal && techVal !== "all")
              params.set("technicianId", techVal);
            const serviceTypeVal = document.getElementById("filterServiceType")?.value;
            if (serviceTypeVal && serviceTypeVal !== "all")
              params.set("serviceType", serviceTypeVal);
            const url = "/api/appointments?" + params.toString();
            console.debug("appointments fetch URL", url, "statusOverride", currentListStatus);
            const r = await fetch(url);
            if (r.ok) {
              const j = await r.json();
              appts = j.items || j.appointments || [];
              fetchSucceeded = true;
            }
          } catch (e) {
            console.warn("appointment fetch failed, will fallback to previous data", e);
          }
          // only fall back if the network call itself failed; an empty array from
          // a successful query should render as "no appointments" rather than
          // reusing the previous status list.
          if (!fetchSucceeded && !appts.length) {
            appts = combinedAppointments || [];
          }
          combinedAppointments = appts;
          renderAppointmentsTable(appts);

          // staff list
          try {
            const selectedTech =
              document.getElementById("filterTechCombined")?.value || "all";
            const r = await fetch("/api/admin/staff", {
              credentials: "same-origin",
            });
            if (r.ok) {
              const j = await r.json();
              combinedStaff = j.staff || [];
              const techSelect = document.getElementById("filterTechCombined");
              techSelect.innerHTML =
                '<option value="all">All technicians</option>';
              combinedStaff.forEach((s) => {
                const o = document.createElement("option");
                o.value = s._id;
                o.textContent =
                  (s.firstName || "") + " " + (s.lastName || s.email || "");
                techSelect.appendChild(o);
              });
              if (
                selectedTech &&
                selectedTech !== "all" &&
                Array.from(techSelect.options).some(
                  (o) => o.value === selectedTech,
                )
              ) {
                techSelect.value = selectedTech;
              }
            } else {
              console.warn("Failed to load staff", r.status);
            }
          } catch (e) {
            console.warn("load staff error", e);
          }

          loadBookingRequests();
        } catch (err) {
          console.error("loadCombinedOverview failed", err);
        }
      }
      function renderAppointmentsTable(list) {
        const tbody = document.getElementById("appointmentsBodyCombined");
        tbody.innerHTML = "";
        // ensure the incoming array respects the currently selected status;
        // this guards against server queries that accidentally return extra
        // items (see support ticket). change message accordingly.
        if (currentListStatus && currentListStatus !== "all") {
          list = (list || []).filter(
            (a) => statusLabel(a.status) === currentListStatus,
          );
        }
        const statusLabelText =
          currentListStatus === "scheduled"
            ? "scheduled"
            : currentListStatus === "on-the-way"
            ? "on the way"
            : currentListStatus === "completed"
            ? "completed"
            : currentListStatus === "cancelled"
            ? "cancelled"
            : "appointments";

        if (!list || !list.length) {
          tbody.innerHTML =
            `<tr><td colspan="7" class="text-center text-muted py-4">No ${statusLabelText} found.</td></tr>`;
          document.getElementById("appointmentsCountCombined").innerText =
            `0 ${statusLabelText}`;
          return;
        }
        list.slice(0, 200).forEach((a) => {
          const tr = document.createElement("tr");
          const bookingDate = a.bookingDate || a.date || a.start || new Date();
          // compute time range similar to details panel
          const startTimeStr = a.startTime || a.time || "";
          const startMinNum = Number(a.startTime || a.time);
          const endMinRaw = Number(a.endTime);
          const fallbackDur = (Number(a.serviceDurationMinutes) || 0) + Math.max(0, Number(a.travelTime) || 0);
          const endMinNum =
            Number.isFinite(endMinRaw) && endMinRaw > startMinNum
              ? endMinRaw
              : Number.isFinite(startMinNum) && fallbackDur > 0
              ? startMinNum + fallbackDur
              : NaN;
          const timeRange =
            Number.isFinite(startMinNum) && Number.isFinite(endMinNum)
              ? `${formatTime(startMinNum)} – ${formatTime(endMinNum)}`
              : formatTime(startMinNum) || startTimeStr;
          const badge = `<span class='badge bg-${statusBadgeClass(a.status)}'>${statusLabel(a.status)}</span>`;
