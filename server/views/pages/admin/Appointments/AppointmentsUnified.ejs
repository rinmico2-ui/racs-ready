  AU.Active.viewDetail=function(id){
    var body=document.getElementById('detailBody');
    var subtitle=document.getElementById('detailModalSubtitle');
    body.innerHTML='<div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Loading job details...</p></div>';
    subtitle.textContent='Loading...';
    new bootstrap.Modal(document.getElementById('detailModal')).show();
    fetch('/api/admin/appointments/'+id).then(function(r){return r.json();}).then(function(data){
      var b=data.booking;
      if(!b){body.innerHTML='<div class="alert alert-danger">Job not found</div>';return;}
      var refText=b.bookingReference||b.workOrderNumber||'#'+b._id.toString().slice(-8).toUpperCase();
      document.getElementById('detailTitle').textContent='Job '+refText;
      subtitle.textContent=refText;
      body.innerHTML=buildDetailHTML(b,data);
      var trackerSteps=[
        {key:'confirmed',label:'Confirmed',icon:'bi-check-circle'},
        {key:'on-the-way',label:'En Route',icon:'bi-sign-turn-right'},
        {key:'arrived',label:'Arrived',icon:'bi-geo-alt'},
        {key:'in-progress',label:'In Progress',icon:'bi-tools'},
        {key:'completed',label:'Completed',icon:'bi-check-circle-fill'}
      ];
      var statusOrder=['confirmed','scheduled','assigned','on-the-way','arrived','in-progress','completed'];
      var currentIdx=statusOrder.indexOf(b.status);
      var trackerHTML='<div class="track-progress">'+trackerSteps.map(function(step,i){
        var stepIdx=statusOrder.indexOf(step.key);
        var isDone=currentIdx>stepIdx;
        var isCurrent=step.key===b.status||(step.key==='confirmed'&&['confirmed','scheduled','assigned'].indexOf(b.status)!==-1);
        return '<div class="track-step '+(isDone?'done':'')+' '+(isCurrent?'current':'')+'"><div class="track-step-dot"><i class="bi '+step.icon+'"></i></div><span class="track-step-label">'+step.label+'</span></div>'+(i<trackerSteps.length-1?'<div class="track-step-line '+(isDone?'done':'')+'"></div>':'');
      }).join('')+'</div>';
      body.innerHTML=trackerHTML+body.innerHTML;
      var footer=document.createElement('div');footer.className='pm-footer';
      var enrouteHTML=(['confirmed','scheduled','assigned'].indexOf(b.status)!==-1?'<button class="btn btn-primary btn-sm fw-semibold" onclick="bootstrap.Modal.getInstance(document.getElementById(\'detailModal\')).hide();setTimeout(function(){window.trackingBookingId=\''+b._id+'\';if(window.markEnRoute)markEnRoute();},300);"><i class="bi bi-truck me-1"></i>Mark En Route</button>':'');
      var trackHTML=(['in-progress','on-the-way','arrived','confirmed','scheduled'].indexOf(b.status)!==-1?'<button class="au-btn au-btn-primary" style="font-size:0.82rem;padding:8px 14px;" onclick="bootstrap.Modal.getInstance(document.getElementById(\'detailModal\')).hide();setTimeout(function(){AU.Active.trackOnMap(\''+b._id+'\');setTimeout(function(){if(window.startTrackingRefresh)startTrackingRefresh();},500);},300);"><i class="bi bi-geo-alt-fill me-1"></i>Track on Map</button>':'');
      footer.innerHTML=enrouteHTML+trackHTML+'<button class="btn btn-light btn-sm" data-bs-dismiss="modal">Close</button>';
      body.appendChild(footer);
    }).catch(function(e){body.innerHTML='<div class="alert alert-danger">Failed to load job details: '+e.message+'</div>';});
  };

  // ═══ Tracking Drawer helpers ═══

  var _trackMap=null,_trackMarkers={},_trackPolyline=null;

  function _trackInitMap(custLoc,techLoc,custName,techName,serviceAddr){
    var mapEl=document.getElementById('trackDrawerMap');
    if(_trackMap){_trackMap.remove();_trackMap=null;}
    var def=custLoc||techLoc||{lat:14.5995,lng:120.9842};
    _trackMap=L.map(mapEl,{zoomControl:true,attributionControl:false}).setView([def.lat,def.lng],13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; <a href="https://openstreetmap.org/copyright">OSM</a>'}).addTo(_trackMap);
    window.trackMap=_trackMap;
    _trackMarkers={};
    if(custLoc){
      var ci=L.divIcon({className:'',html:'<div style="width:34px;height:34px;background:#2563eb;border-radius:50%;border:3px solid #fff;box-shadow:0 3px 12px rgba(37,99,235,0.35);display:flex;align-items:center;justify-content:center;"><i class="bi bi-house-fill" style="color:#fff;font-size:15px;"></i></div>',iconSize:[34,34],iconAnchor:[17,17]});
      _trackMarkers.customer=L.marker([custLoc.lat,custLoc.lng],{icon:ci}).addTo(_trackMap).bindPopup('<b>'+custName+'</b><br><span style="font-size:0.8rem;color:#666;">'+serviceAddr+'</span>');
    }
    if(techLoc){
      var ti=L.divIcon({className:'',html:'<div style="width:34px;height:34px;background:#16a34a;border-radius:50%;border:3px solid #fff;box-shadow:0 3px 12px rgba(22,163,74,0.35);display:flex;align-items:center;justify-content:center;"><i class="bi bi-tools" style="color:#fff;font-size:15px;"></i></div>',iconSize:[34,34],iconAnchor:[17,17]});
      _trackMarkers.technician=L.marker([techLoc.lat,techLoc.lng],{icon:ti}).addTo(_trackMap).bindPopup('<b>'+techName+'</b><br><span style="font-size:0.8rem;color:#666;">Current location</span>');
    }
    if(custLoc&&techLoc){
      _trackPolyline=L.polyline([[custLoc.lat,custLoc.lng],[techLoc.lat,techLoc.lng]],{color:'#2563eb',weight:3,dashArray:'8, 8',opacity:0.7}).addTo(_trackMap);
      _trackMap.fitBounds(L.latLngBounds([custLoc,techLoc]).pad(0.2));
    }else _trackMap.setView([def.lat,def.lng],14);
    if(document.getElementById('trackDrawer').classList.contains('open')){
      setTimeout(function(){_trackMap.invalidateSize();},200);
    }
  }

  function _updateProgressBar(status){
    var steps=['confirmed','on-the-way','arrived','in-progress','completed'];
    var order=['confirmed','scheduled','assigned','on-the-way','arrived','in-progress','completed'];
    var currentIdx=order.indexOf(status);
    steps.forEach(function(step,i){
      var si=order.indexOf(step);
      var el=document.getElementById('tdStep'+i);
      var line=document.getElementById('tdLine'+i);
      var isDone=currentIdx>si;
      var isCurrent=step===status||(step==='confirmed'&&['confirmed','scheduled','assigned'].indexOf(status)!==-1);
      el.className='td-progress-step';
      if(isDone)el.classList.add('done');
      if(isCurrent)el.classList.add('active');
      if(line)line.className='td-progress-line'+(isDone?' done':'');
    });
  }

  AU.Active._ensureLeaflet=function(cb){
    if(window.L&&document.getElementById('leaflet-css')){if(cb)cb();return Promise.resolve();}
    if(!document.getElementById('leaflet-css')){var css=document.createElement('link');css.id='leaflet-css';css.rel='stylesheet';css.href='https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css';document.head.appendChild(css);}
    if(window.L){if(cb)cb();return Promise.resolve();}
    return new Promise(function(resolve){
      var s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js';
      s.onload=function(){if(cb)cb();resolve();};
      document.head.appendChild(s);
    });
  };

  AU.Active._parseCoords=function(coords){
    if(!coords)return null;
    if(Array.isArray(coords)&&coords.length>=2){var lng=Number(coords[0]),lat=Number(coords[1]);if(!isFinite(lng)||!isFinite(lat))return null;return{lat:lat,lng:lng};}
    if(typeof coords==='object'&&coords.coordinates)return AU.Active._parseCoords(coords.coordinates);
    if(typeof coords==='object'&&coords.lat!=null&&coords.lng!=null){var la=Number(coords.lat),lo=Number(coords.lng);if(!isFinite(la)||!isFinite(lo))return null;return{lat:la,lng:lo};}
    return null;
  };

  AU.Active.trackOnMap=function(id){
    window.trackingBookingId=id;
    window.trackDrawerPinned=false;
    document.getElementById('trackDrawerPinBtn').classList.remove('pinned');
    document.getElementById('trackDrawerPinBtn').title='Keep open';
    fetch('/api/admin/appointments/'+id).then(function(r){return r.json();}).then(function(data){
      window.trackingData=data;
      var b=data.booking;
      var techLoc=data.technicianLocation;
      var custLoc=null;
      if(b.location){
        if(b.location.coordinates&&b.location.coordinates.coordinates)custLoc=AU.Active._parseCoords(b.location.coordinates.coordinates);
        else if(b.location.lat&&b.location.lng)custLoc={lat:Number(b.location.lat),lng:Number(b.location.lng)};
      }
      if(!custLoc&&b.coordinates)custLoc=AU.Active._parseCoords(b.coordinates);
      if(!custLoc&&data.assignment&&data.assignment.coordinates)custLoc=AU.Active._parseCoords(data.assignment.coordinates);
      var techName=b.technician?b.technician.name:'Technician';
      var custName=b.customer?b.customer.name:'Customer';
      var serviceAddr=b.location?b.location.address:(data.assignment?data.assignment.address:'Service location');
      var ref=b.bookingReference||b.workOrderNumber||'#'+b._id.toString().slice(-8).toUpperCase();

      document.getElementById('trackDrawerTitle').textContent=ref;
      document.getElementById('trackDrawerSubtitle').textContent=custName+(b.customer&&b.customer.phone?' \u00B7 '+b.customer.phone:'');
      document.getElementById('tdInfoCustomer').textContent=custName;
      document.getElementById('tdInfoCustomerAddr').textContent=serviceAddr.length>50?serviceAddr.substring(0,47)+'...':serviceAddr;
      document.getElementById('tdInfoTechnician').textContent=techName;
      document.getElementById('tdInfoTechStatus').innerHTML=techLoc?'<i class="bi bi-broadcast-pin text-success me-1"></i> Live':(b.status==='on-the-way'?'<i class="bi bi-truck text-primary me-1"></i> En route':'<i class="bi bi-geo-alt text-warning me-1"></i> Awaiting');
      document.getElementById('tdInfoStatus').textContent=statusLabel(b.status);
      document.getElementById('tdInfoRef').textContent=ref;
      _updateProgressBar(b.status);

      var enrouteBtn=document.getElementById('tdBtnEnroute');
      if(['confirmed','scheduled','assigned'].indexOf(b.status)!==-1){enrouteBtn.style.display='inline-flex';enrouteBtn.dataset.id=b._id;}
      else enrouteBtn.style.display='none';

      AU.Active._ensureLeaflet().then(function(){
        _trackInitMap(custLoc,techLoc,custName,techName,serviceAddr);
        document.getElementById('trackDrawer').classList.add('open');
        document.body.style.overflow='hidden';
      });
    }).catch(function(e){console.error(e);showNotification({type:'error',title:'Tracking Error',message:'Failed to load tracking data.',duration:4000});});
  };

  // ── In Progress load ──

  // ═══ COMPLETED ═══
  AU.Completed={};
  var _cjPage=1,_cjLimit=12;

  AU.Completed.load=function(){
    var search=(document.getElementById('cjSearchInput')||{}).value||'';
    var date=(document.getElementById('cjDateFilter')||{}).value||'';
    var url='/api/admin/appointments/list?stage=completed&page='+_cjPage+'&limit='+_cjLimit;
    if(search)url+='&search='+encodeURIComponent(search);
    if(date)url+='&date='+date;
    Promise.all([
      fetch(url).then(function(r){return r.json();}),
      fetch('/api/admin/appointments/flow-stats').then(function(r){return r.json();}).catch(function(){return{stages:{},summary:{}};})
    ]).then(function(res){
      AU.Completed._renderStats(res[1]);
      AU.Completed._renderJobs(res[0].bookings||[]);
      AU.Completed._renderPagination(res[0].pagination);
    }).catch(function(e){console.error(e);});
  };

  AU.Completed._renderStats=function(stats){
    var stages=stats.stages||{};
    var completedCount=stages.COMPLETED?stages.COMPLETED.count||0:0;
    var todayCount=stats.summary?stats.summary.todayBookings||0:0;
    var revenue=stats.summary?stats.summary.totalRevenue||0:0;
    document.getElementById('cjStatTotal').textContent=completedCount;
    document.getElementById('cjStatToday').textContent=todayCount;
    document.getElementById('cjStatRevenue').textContent='₱'+Number(revenue).toLocaleString();
    document.getElementById('cjStatAvg').textContent='—';
    var tb=document.getElementById('tabCompletedBadge');if(tb)tb.textContent=completedCount>0?completedCount:'';
  };

  AU.Completed._renderJobs=function(bookings){
    var container=document.getElementById('cjJobsContainer');
    if(!container)return;
    if(!bookings||!bookings.length){
      container.innerHTML='<div class="col-12"><div class="au-empty-state"><div class="au-empty-state-icon"><i class="bi bi-inbox"></i></div><h6>No Completed Jobs</h6><p>Completed jobs will appear here</p></div></div>';
      return;
    }
    container.innerHTML=bookings.map(function(b){
      var dt=new Date(b.bookingDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
      var cd=b.updatedAt?new Date(b.updatedAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}):'';
      var svc=b.service?b.service.name:(b.services&&b.services[0]?b.services[0].name:(b.serviceModel==='RepairService'||b.serviceType==='repair'?'Repair Service':'N/A'));
      return '<div class="col-md-6 col-xl-4"><div class="job-card" style="border-top:3px solid #10b981;"><div class="job-card-header bg-white"><code class="small" style="color:#10b981;font-weight:600;">'+(b.bookingReference||b.workOrderNumber||'N/A')+'</code><span class="job-status job-confirmed" style="background:#d1fae5;color:#065f46;text-transform:uppercase;">Completed</span></div><div class="job-card-body"><div class="d-flex justify-content-between align-items-start mb-2"><div><div class="fw-semibold small">'+(b.customer?b.customer.name:'N/A')+'</div><div class="text-muted" style="font-size:0.7rem;">'+(b.customer?b.customer.phone:'')+'</div></div><div class="text-end"><div class="fw-bold text-success">₱'+(b.totalPrice||b.estimatedFee||0).toLocaleString()+'</div><div class="text-muted" style="font-size:0.65rem;">'+(b.paymentMethod||'cod').toUpperCase()+'</div></div></div><div class="d-flex justify-content-between align-items-center"><div class="small text-muted"><i class="bi bi-tools me-1"></i>'+svc+'</div><div class="small text-muted"><i class="bi bi-calendar me-1"></i>'+dt+'</div></div>'+
        (b.technician&&b.technician.name?'<div class="mt-2 small"><i class="bi bi-person me-1 text-success"></i><span class="fw-semibold">'+b.technician.name+'</span></div>':'')+
        (cd?'<div class="mt-1 small text-muted"><i class="bi bi-check2 me-1"></i>Completed '+cd+'</div>':'')+
        '<div class="mt-3"><button class="au-btn au-btn-ghost w-100" onclick="AU.Completed.viewDetail(\''+b._id+'\')" style="font-size:0.75rem;"><i class="bi bi-eye me-1"></i>View Details</button></div></div></div></div>';
    }).join('');
  };

  AU.Completed._renderPagination=function(pag){
    var el=document.getElementById('cjPagination');
    if(!el)return;
    if(!pag||pag.pages<=1){el.innerHTML='';return;}
    var h='<ul class="pagination pagination-sm">';
    for(var i=1;i<=pag.pages;i++)h+='<li class="page-item '+(i===pag.page?'active':'')+'"><button class="page-link" onclick="AU.Completed.goPage('+i+')">'+i+'</button></li>';
    el.innerHTML=h+'</ul>';
  };

  AU.Completed.goPage=function(p){_cjPage=p;AU.Completed.load();};

