<script>
  // Receipt image lightbox - always appears on top of modals
  window.openAoImage = function(src) {
    const existing = document.getElementById('aoImageOverlay');
    if (existing) existing.remove();

    const overlay = document.createElement('div');
    overlay.id = 'aoImageOverlay';
    overlay.className = 'ao-lightbox-overlay';
    overlay.innerHTML = '<div class="ao-lightbox-content"><button class="ao-lightbox-close" aria-label="Close">&times;</button><img src="' + src + '" alt="Receipt" onerror="this.parentElement.innerHTML=\'<div style=padding:40px;color:#fff;text-align:center;>Image unavailable</div>\'"></div>';

    const closeOverlay = function() { overlay.remove(); };
    overlay.addEventListener('click', function(e) { if (e.target === overlay) closeOverlay(); });
    overlay.querySelector('.ao-lightbox-close').addEventListener('click', closeOverlay);
    document.addEventListener('keydown', function onEsc(e) {
      if (e.key === 'Escape') { closeOverlay(); document.removeEventListener('keydown', onEsc); }
    });

    document.body.appendChild(overlay);
  };
</script>
