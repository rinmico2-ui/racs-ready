<%#
  Partial for rendering KPI cards. Expects `kpiItems` to be an array of objects:
    { id, icon, label, variant }
  ``variant`` corresponds to one of the colour helpers defined in
  dashboard-styles (primary, warning, success, danger, info, purple, etc.).
%>
<div class="row mb-4 g-3">
  <%
    const colClass = typeof colClassCustom !== 'undefined' ? colClassCustom : 'col-12 col-sm-6 col-xl-3';
    const variantMap = {
      primary: 'blue',
      success: 'green',
      warning: 'amber',
      info:    'cyan',
      danger:  'rose',
      purple:  'violet'
    };
    const gradientMap = {
      primary: 'linear-gradient(135deg, #1e3a5f 0%, #3b82f6 100%)',
      success: 'linear-gradient(135deg, #059669 0%, #10b981 100%)',
      warning: 'linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%)',
      info:    'linear-gradient(135deg, #0891b2 0%, #22d3ee 100%)',
      danger:  'linear-gradient(135deg, #dc2626 0%, #ef4444 100%)',
      purple:  'linear-gradient(135deg, #7c3aed 0%, #a855f7 100%)'
    };
    const badgeMap = {
      primary: 'bg-primary-subtle text-primary',
      success: 'bg-success-subtle text-success',
      warning: 'bg-warning-subtle text-warning',
      info:    'bg-info-subtle text-info',
      danger:  'bg-danger-subtle text-danger',
      purple:  'bg-secondary-subtle text-secondary'
    };
    (kpiItems || []).forEach(item => {
      const accent = variantMap[item.variant] || 'blue';
      const gradient = gradientMap[item.variant] || gradientMap.primary;
      const badgeClass = badgeMap[item.variant] || badgeMap.primary;
  %>
    <div class="<%= colClass %>">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="0">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <h6 class="text-muted mb-1" style="font-size: 0.85rem; font-weight: 500;"><%= item.label %></h6>
            <div class="d-flex align-items-baseline gap-2">
              <span class="h3 mb-0 fw-bold text-dark" id="<%= item.id %>">—</span>
            </div>
            <div class="badge <%= badgeClass %> fs-7" id="badge_<%= item.id %>">+0%</div>
          </div>
          <div class="kpi-icon" style="background: <%= gradient %>;">
            <i class="<%= item.icon %> text-white fs-5"></i>
          </div>
        </div>
        <div class="kpi-sparkline-container">
          <canvas id="spark_<%= item.id %>" height="40"></canvas>
        </div>
      </div>
    </div>
  <% }); %>
</div>
