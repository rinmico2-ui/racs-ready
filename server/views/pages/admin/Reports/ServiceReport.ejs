                <tr>
                  <td style="font-weight:700;"><%= svc.name %></td>
                  <td><span class="badge-status <%= svc.type === 'repair' ? 'warning' : 'success' %>"><%= svc.type === 'repair' ? 'Repair' : 'Core' %></span></td>
                  <td style="text-align:center;"><%= svc.bookings %> / <%= svc.units || svc.bookings %></td>
                  <td style="text-align:center;">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                      <div class="pipeline-bar" style="width:60px;">
                        <div class="pipeline-bar-fill" style="background:<%= svc.completionRate >= 90 ? '#10b981' : (svc.completionRate >= 75 ? '#f59e0b' : '#ef4444') %>;"></div>
                      </div>
                      <span class="badge-status <%= svc.completionRate >= 90 ? 'success' : (svc.completionRate >= 75 ? 'warning' : 'danger') %>"><%= Math.round(svc.completionRate) %>%</span>
                    </div>
                  </td>
                  <td style="text-align:right;font-weight:600;">₱<%= Math.round(svc.avgRevenue).toLocaleString() %></td>
