<link rel="stylesheet" id="ent-calendar-styles" href="/css/enterprise-calendar.css?v=20260814-walkin">
<script src="/js/enterprise-calendar.js?v=20260826-shared-slot-logic"></script>
<script>
  (function () {
    const state = {
      coreServices: [],
      repairServices: [],
      serviceCategories: [],
      technicians: [],
      currentStep: 0, // start at customer type step
      maxReachedStep: 0,
      isNewCustomer: null,
      customerLookupEmail: "",
      customerAccountFound: false,
      customerAccountState: "unchecked",
      enterpriseCalendarSignature: "",
      projectScheduling: null,
      selectedServiceId: "",
      selectedServices: [],
      selectedDate: null,
      selectedStartMinutes: null,
      paymentMethod: "cod",
      cashPaymentMode: "downpayment",
      travelFare: 0,
      travelTime: 0,
      farePerKm: 40,
      largeProjectThresholdHours: 8,
      customerCoords: null,
      techCoords: { lat: 14.676049, lng: 121.043731 },
      companyAddress: "CALIDRO RACS company location",
      calendar: {
        activeMonth: new Date(
          new Date().getFullYear(),
          new Date().getMonth(),
          1,
        ),
        bookedDates: new Set(),
        blockedDates: new Set(),
        publicHolidays: new Map(),
        nonWorkingWeekdays: [],
        restDates: new Set(),
      },
      map: null,
      markers: { tech: null, customer: null },
      route: null,
    };

    const form = document.getElementById("walkinForm");
    const alertEl = document.getElementById("walkinAlert");
    let alertModal = null;
    const serviceTypeEl = document.getElementById("serviceType");
    const serviceIdEl = document.getElementById("serviceId");
    const serviceCardsEl = document.getElementById("serviceCards");
    const techEl = document.getElementById("technicianId");
    const locationInputEl = document.getElementById("locationInput");
    const locationSuggestEl = document.getElementById("locationSuggest");
    const locationStatusEl = document.getElementById("locationStatus");
    const summaryEl = document.getElementById("walkinSummary");
    const saveBtn = document.getElementById("saveWalkinBtn");
    const mapDistanceInfoEl = document.getElementById("mapDistanceInfo");
    const mapInfoDistanceEl = document.getElementById("mapInfoDistance");
    const mapInfoDurationEl = document.getElementById("mapInfoDuration");
    const mapInfoFareEl = document.getElementById("mapInfoFare");
    const serviceRouteMethodEl = document.getElementById("serviceRouteMethod");
    const serviceMapSelectionEl = document.getElementById("serviceMapSelection");
    const calendarGridEl = document.getElementById("calendarGrid");
    const calendarLabelEl = document.querySelector("[data-calendar-label]");
    const timeSelectionEl = document.getElementById("timeSelection");
    const timeSlotsEl = document.getElementById("timeSlots");
    const timeRangeInfoEl = document.getElementById("timeRangeInfo");
    const timeNoticeEl = document.getElementById("timeNotice");

    function showAlert(type, message) {
      const titles = { warning: "Attention", danger: "Error", success: "Success", info: "Notice" };
      const icons = { warning: "exclamation-triangle-fill", danger: "x-circle-fill", success: "check-circle-fill", info: "info-circle-fill" };
      const colors = { warning: "#f59e0b", danger: "#dc2626", success: "#16a34a", info: "#2563eb" };
      const color = colors[type] || colors.info;
      const icon = (type === "success")
        ? (state.isNewCustomer ? "person-plus-fill" : "person-check-fill")
        : (icons[type] || icons.info);
      document.getElementById("walkinAlertLabel").textContent = titles[type] || "Notice";
      document.getElementById("walkinAlertHeader").style.background = color;
      document.getElementById("walkinAlertBody").innerHTML =
        '<div class="text-center"><i class="bi bi-' + icon + '" style="font-size:3.5rem;color:' + color + ';"></i></div>' +
        '<p class="text-center mb-0 mt-3" style="font-size:1rem;color:#334155;line-height:1.5;">' + message + '</p>';
      if (!alertModal) alertModal = new bootstrap.Modal(alertEl, { backdrop: true, keyboard: true });
      alertModal.show();
    }
    function hideAlert() {
      if (alertModal) alertModal.hide();
    }
    function pad2(n) {
      return String(n).padStart(2, "0");
    }
    function startOfDay(date) {
      return new Date(date.getFullYear(), date.getMonth(), date.getDate());
    }
    function startOfMonth(date) {
      return new Date(date.getFullYear(), date.getMonth(), 1);
    }
    function addMonths(date, amount) {
      const c = new Date(date);
      c.setMonth(c.getMonth() + amount);
      return startOfMonth(c);
    }
    function addDays(date, amount) {
      const c = new Date(date);
      c.setDate(c.getDate() + amount);
      return c;
    }
    function formatDateKey(date) {
      return `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())}`;
    }
    function isSameDate(a, b) {
      return (
        a &&
        b &&
        a.getFullYear() === b.getFullYear() &&
        a.getMonth() === b.getMonth() &&
        a.getDate() === b.getDate()
      );
    }
    function minutesToLabel(m) {
      const h = Math.floor(m / 60);
      const mm = m % 60;
      const ap = h >= 12 ? "PM" : "AM";
      const h12 = ((h + 11) % 12) + 1;
      return `${pad2(h12)}:${pad2(mm)} ${ap}`;
    }
    function minutesToHHMM(m) {
      return `${pad2(Math.floor(m / 60))}:${pad2(m % 60)}`;
    }

    function escapeMarkup(value) {
      return String(value == null ? "" : value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function safeCssClasses(value, fallback = "") {
      const classes = String(value || "").split(/\s+/).filter(part => /^[a-zA-Z0-9_-]+$/.test(part));
      return classes.join(" ") || fallback;
    }

    function setSelectByText(selectEl, text) {
      if (!selectEl || !text) return false;
      const opt = Array.from(selectEl.options).find(
        (o) => o.textContent.trim().toLowerCase() === String(text).trim().toLowerCase()
      );
      if (opt) {
        selectEl.value = opt.value;
        selectEl.dispatchEvent(new Event("change"));
        return true;
      }
      return false;
    }

    function currentServiceList() {
      return serviceTypeEl.value === "repair"
        ? state.repairServices
        : state.coreServices;
    }
    function currentService() {
      return state.selectedServices[0] || currentServiceList().find(
        (s) => String(s._id) === String(state.selectedServiceId),
      );
    }

    function totalBookedUnits() { return state.selectedServices.reduce((sum, item) => sum + Number(item.quantity || 1), 0); }
    function servicesSubtotal() { return state.selectedServices.reduce((sum, item) => sum + Number(item.totalPrice || 0), 0); }
    function bookingDuration() { return Math.max(60, state.selectedServices.reduce((sum, item) => sum + Number(item.duration || 60), 0)); }
    function isLargeScaleSelection() {
      if (!state.selectedServices.length) return false;
      return totalBookedUnits() >= 8 || bookingDuration() > state.largeProjectThresholdHours * 60;
    }

    function updateTechnicianSelectionMode() {
      const isProject = isLargeScaleSelection();
      const card = document.getElementById("walkinTechnicianCard");
      const notice = document.getElementById("walkinProjectLocationNotice");
      const hint = document.getElementById("technicianSelectionHint");
      if (notice) notice.classList.toggle("d-none", !isProject);
      if (card) card.classList.toggle("d-none", isProject);
      if (hint) hint.textContent = isProject ? "A technician team will be assigned during project planning." : "Required for standard appointments.";
      if (isProject && techEl) techEl.value = "";
    }

    function renderSelectedServices() {
      const host = document.getElementById("selectedServicesList");
      const count = document.getElementById("selectedServiceCount");
      const pricing = document.getElementById("totalPricingSection");
      const total = document.getElementById("totalEstimatedPrice");
      if (count) count.textContent = totalBookedUnits();
      if (!host) return;
      if (!state.selectedServices.length) {
        host.innerHTML = '<p class="text-muted mb-0">No services selected yet</p>';
        if (pricing) pricing.classList.add("d-none");
        updateTechnicianSelectionMode();
        return;
      }
      host.innerHTML = state.selectedServices.map((item, index) => `<div class="d-flex justify-content-between align-items-start gap-3 py-3 ${index ? 'border-top' : ''}"><div><div class="fw-semibold">${item.name}</div><div class="small text-muted">${item.type === 'repair' ? 'Repair inspection' : 'Core service'} · ${item.quantity} unit${item.quantity > 1 ? 's' : ''}${item.airconTypeName ? ' · ' + item.airconTypeName : ''}${item.hpDescription ? ' · ' + item.hpDescription : ''}${item.brand ? ' · ' + item.brand : ''}${item.model ? ' ' + item.model : ''}</div>${item.problemDescription ? `<div class="small mt-1">${String(item.problemDescription).replace(/</g,'&lt;')}</div>` : ''}</div><div class="text-end flex-shrink-0"><div class="fw-bold text-primary">₱${Number(item.totalPrice).toLocaleString()}</div><button type="button" class="btn btn-link btn-sm text-danger p-0 remove-service" data-index="${index}"><i class="bi bi-x-circle me-1"></i>Remove</button></div></div>`).join('');
      if (pricing) pricing.classList.remove("d-none");
      if (total) total.textContent = '₱' + servicesSubtotal().toLocaleString();
      state.selectedServiceId = state.selectedServices[0].serviceId;
      serviceIdEl.value = state.selectedServiceId;
      updateTechnicianSelectionMode();
    }

    function goToStep(step) {
      state.currentStep = Number(step);
      state.maxReachedStep = Math.max(state.maxReachedStep, state.currentStep);
      document.querySelectorAll(".booking-step[data-step]").forEach((el) => {
        const isActive =
          Number(el.getAttribute("data-step")) === state.currentStep;
        el.classList.toggle("d-none", !isActive);
      });
      document.querySelectorAll(".ent-n[data-step]").forEach((el) => {
        const stepNum = Number(el.getAttribute("data-step"));
        const isActive = stepNum === state.currentStep;
        const isCompleted = stepNum < state.currentStep;
        el.classList.toggle("active", isActive);
        el.classList.toggle("completed", isCompleted);
      });
      const stepCounter = document.getElementById("entStepCurrent");
      if (stepCounter) stepCounter.textContent = String(state.currentStep + 1);
      if (state.currentStep === 0) {
        // coming back to customer details, ensure inputs editable
        ["firstName", "lastName", "customerPhone", "customerEmail"].forEach((id) => {
          const el = document.getElementById(id);
          if (el) el.disabled = false;
        });
        // For address selects: enable province, keep city/barangay as-is (PSGC manages them)
        const provEl = document.getElementById("addrProvince");
        if (provEl) provEl.disabled = false;
        adjustCustomerDetailsStep();
      }
      if (state.currentStep === 2) initMap();
      if (state.currentStep === 3) {
        renderCalendar();
        if (state.selectedDate) renderTimeSlotsForDate(state.selectedDate);
      }
      updateSummary();
    }

    function setCustomerLookupStatus(message, type = "info", spinning = false) {
      const status = document.getElementById("customerLookupStatus");
      if (!status) return;
      status.className = `customer-lookup-status mt-2${type === "success" ? " is-success" : type === "warning" ? " is-warning" : spinning ? " is-loading" : ""}`;
      status.innerHTML = `<i class="bi bi-${spinning ? "arrow-repeat spin" : type === "success" ? "check-circle-fill" : type === "warning" ? "exclamation-triangle-fill" : "info-circle"}"></i><span>${message}</span>`;
    }

    function setCustomerDetailsLocked(locked) {
      ["firstName", "lastName", "customerPhone", "addrProvince", "addrPostalCode"].forEach((id) => {
        const field = document.getElementById(id);
        if (field) field.disabled = Boolean(locked);
      });
      const province = document.getElementById("addrProvince");
      const city = document.getElementById("addrCity");
      const barangay = document.getElementById("addrBarangay");
      if (city) city.disabled = Boolean(locked) || !province?.value;
      if (barangay) barangay.disabled = Boolean(locked) || !city?.value;
      document.querySelectorAll(".customer-detail-field").forEach((el) => el.classList.toggle("is-locked", Boolean(locked)));
    }

    function clearCustomerDetails() {
      ["firstName", "lastName", "customerPhone", "addrProvince", "addrCity", "addrBarangay", "addrPostalCode"].forEach((id) => {
        const field = document.getElementById(id);
        if (field) field.value = "";
      });
    }

    function waitForSelectText(selectEl, text, timeout = 2500) {
      return new Promise((resolve) => {
        if (!selectEl || !text) return resolve(false);
        const started = Date.now();
        const trySelect = () => {
          if (setSelectByText(selectEl, text)) return resolve(true);
          if (Date.now() - started >= timeout) return resolve(false);
          setTimeout(trySelect, 100);
        };
        trySelect();
      });
    }

    async function populateCustomerAddress(address) {
      if (!address) return;
      setCustomerDetailsLocked(false);
      await waitForSelectText(document.getElementById("addrProvince"), address.province);
      await waitForSelectText(document.getElementById("addrCity"), address.city);
      await waitForSelectText(document.getElementById("addrBarangay"), address.barangay);
      document.getElementById("addrPostalCode").value = address.postalCode || "";
    }

    // Email lookup is authoritative. Details are progressively disclosed only
    // when the database confirms that a new customer invitation is needed.
    function adjustCustomerDetailsStep() {
      const lookupResolved = Boolean(state.customerLookupEmail) && state.isNewCustomer !== null;
      const existingCard = document.getElementById("existingCustomerCard");
      const newHeading = document.getElementById("newCustomerHeading");
      const consentPanel = document.getElementById("accountConsentPanel");
      if (existingCard) existingCard.classList.toggle("d-none", !state.customerAccountFound);
      if (newHeading) newHeading.classList.toggle("d-none", !lookupResolved || state.isNewCustomer !== true);
      if (consentPanel) consentPanel.classList.toggle("d-none", !lookupResolved);
      document.querySelectorAll(".customer-detail-field").forEach((el) => {
        el.classList.toggle("d-none", !lookupResolved || state.isNewCustomer !== true);
      });
      setCustomerDetailsLocked(state.customerAccountFound || state.isNewCustomer !== true);

      const consentTitle = document.getElementById("accountConsentTitle");
      const consentText = document.getElementById("accountConsentText");
      if (consentTitle) {
        consentTitle.textContent = state.isNewCustomer
          ? "Customer consent to create online account access"
          : "Customer consent to link this appointment";
      }
      if (consentText) {
        consentText.textContent = state.isNewCustomer
          ? "I confirm the customer authorized CALIDRO RACS to create an invited account for this email and send a secure activation link. The customer will choose their own password."
          : "I confirm the customer requested this appointment and authorized CALIDRO RACS to link it to the existing account and send appointment messages.";
      }
    }

    // Reusable async email check: validates email, looks up DB, populates or enables fields.
    // Returns true if navigation should proceed, false to abort.
    async function checkCustomerEmail() {
      const email = document.getElementById("customerEmail").value.trim();
      if (!email) { showWarn("Email is required."); return false; }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showWarn("Please enter a valid email address.");
        return false;
      }
      if (state.customerLookupEmail === email.toLowerCase()) return true;
      document.getElementById("accountConsent").checked = false;

      try {
        const checkButton = document.getElementById("checkCustomerBtn");
        if (checkButton) checkButton.disabled = true;
        setCustomerLookupStatus("Checking the customer database…", "info", true);
        const resp = await fetch(
          `/api/users?email=${encodeURIComponent(email)}`,
          { credentials: "same-origin", cache: "no-store", headers: { Accept: "application/json" } },
        );
        if (resp.ok) {
          const json = await resp.json();
          document.getElementById("customerEmail").value = email;

          if (!json.user && json.emailAvailable === false) {
            state.customerLookupEmail = "";
            state.customerAccountFound = false;
            state.isNewCustomer = null;
            state.customerAccountState = "unavailable";
            adjustCustomerDetailsStep();
            setCustomerLookupStatus("This email belongs to a staff account and cannot be used for a customer booking.", "warning");
            return false;
          }

          if (json.user) {
            if (json.accountState === "unavailable") {
              state.customerLookupEmail = "";
              state.customerAccountFound = false;
              state.isNewCustomer = null;
              state.customerAccountState = "unavailable";
              adjustCustomerDetailsStep();
              setCustomerLookupStatus("This customer account is disabled or blocked. Resolve the account status before booking.", "warning");
              return false;
            }

            const u = json.user;
            document.getElementById("firstName").value = u.firstName || "";
            document.getElementById("lastName").value = u.lastName || "";
            document.getElementById("customerPhone").value = u.phone || "";
            await populateCustomerAddress(u.address);
            state.customerAccountFound = true;
            state.isNewCustomer = false;
            state.customerAccountState = json.accountState || "active";
            state.customerLookupEmail = email.toLowerCase();
            document.getElementById("existingCustomerName").textContent =
              `${u.firstName || ""} ${u.lastName || ""}`.trim() || u.email;
            document.getElementById("existingCustomerMeta").textContent =
              `${u.phone || "No phone on file"} · ${state.customerAccountState === "active" ? "Verified account" : state.customerAccountState === "invited" ? "Activation still required" : "Email verification pending"}`;
            adjustCustomerDetailsStep();
            setCustomerLookupStatus("Existing customer found. The appointment will be linked to this account after consent is confirmed.", "success");
          } else {
            clearCustomerDetails();
            state.customerAccountFound = false;
            state.isNewCustomer = true;
            state.customerAccountState = "invited";
            state.customerLookupEmail = email.toLowerCase();
            setCustomerDetailsLocked(false);
            adjustCustomerDetailsStep();
            setCustomerLookupStatus("No customer account found. Complete the profile and capture consent to send a secure activation invitation.", "warning");
          }
          return true;
        } else {
          showWarn("Failed to verify email. Please try again.");
          return false;
        }
      } catch (e) {
        console.warn("check email failed", e);
        showWarn("Network error while verifying email. Please try again.");
        return false;
      } finally {
        const checkButton = document.getElementById("checkCustomerBtn");
        if (checkButton) checkButton.disabled = false;
      }
    }

    function validateStep(step) {
      if (step === 0) {
        // Validate customer details (combined type + details on this step)
        const email = document.getElementById("customerEmail").value.trim();
        const re = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
        if (!email || !re.test(email))
          return showWarn("Valid customer email is required.");
        if (state.customerLookupEmail !== email.toLowerCase())
          return showWarn("Find the customer account before continuing.");
        if (state.isNewCustomer === null)
          return showWarn("The customer account could not be resolved.");
        if (!document.getElementById("accountConsent").checked)
          return showWarn("Confirm the customer's account and appointment consent before continuing.");
        if (state.isNewCustomer) {
          const first = document.getElementById("firstName").value.trim();
          const last = document.getElementById("lastName").value.trim();
          const phone = document.getElementById("customerPhone").value.trim();
          const city = document.getElementById("addrCity").value.trim();
          if (!first || !last || !phone || !city)
            return showWarn("First/last name, phone and city are required.");
        }
      }
      if (step === 1 && !state.selectedServices.length)
        return showWarn("Please add at least one Core or Repair service.");
      if (step === 2) {
        if (!isLargeScaleSelection() && !techEl.value) return showWarn("Please select a technician.");
        if (!state.customerCoords)
          return showWarn(
            "Please set customer location on map (address, coordinates, or current location).",
          );
      }
      if (step === 3) {
        if (!state.selectedDate || (!state.projectScheduling && state.selectedStartMinutes == null))
          return showWarn("Please choose a date and available time slot.");
      }
      if (step === 5) {
        const amount = Number(
          document.getElementById("downpaymentAmount").value,
        );
        if (!Number.isFinite(amount) || amount <= 0)
          return showWarn("Please enter a valid amount collected now.");
        if (amount > getEstimatedTotal())
          return showWarn("The amount collected cannot exceed the estimated total.");
      }
      hideAlert();
      return true;
    }

    function showWarn(message) {
      showAlert("warning", message);
      return false;
    }

    function showSuccess(message) {
      showAlert("success", message);
      return true;
    }

    function renderServiceCards() {
      const coreCardsEl = document.getElementById("coreServiceCards");
      const repairCardsEl = document.getElementById("repairServiceCards");

      function renderListInto(container, services, serviceType) {
        if (!container) return;
        if (!services.length) {
          container.innerHTML =
            '<div class="col-12 text-center py-4"><i class="bi bi-inbox fs-3 text-muted d-block mb-2"></i><span class="text-muted small">No active services in this category.</span></div>';
          return;
        }
        container.innerHTML = services
          .map((s) => {
            const selected = state.selectedServices.some(item => String(item.serviceId) === String(s._id));
            const duration = Number(s.durationMinutes || s.estimatedDurationMinutes || s.duration || 60);
            const basePrice = Number(serviceType === "repair" ? (s.initialPrice ?? s.basePrice ?? s.price ?? 0) : (s.basePrice ?? s.price ?? 0));
            const priceRange = s.priceRange;
            const isAircon = s.isAirconService && s.hpPricing && s.hpPricing.length > 0;

            let priceDisplay = '';
            if (isAircon) {
              const minP = Math.min(...s.hpPricing.map(h => h.price));
              const maxP = Math.max(...s.hpPricing.map(h => h.price));
              priceDisplay = '\u20B1' + minP.toLocaleString() + ' - \u20B1' + maxP.toLocaleString();
            } else if (priceRange) {
              priceDisplay = '\u20B1' + Number(priceRange.min).toLocaleString() + ' - \u20B1' + Number(priceRange.max).toLocaleString();
            } else if (basePrice > 0) {
              priceDisplay = '\u20B1' + basePrice.toLocaleString();
            } else {
              priceDisplay = 'Price on quote';
            }

            const icon = s.icon || (serviceType === "repair" ? "bi bi-tools" : "bi bi-gear-fill");
            const typeBadge = isAircon
              ? '<span class="badge bg-info text-dark service-card-chip">HP-based</span>'
              : serviceType === "repair"
                ? '<span class="badge bg-secondary text-white service-card-chip">Repair</span>'
                : '<span class="badge bg-primary service-card-chip">Service</span>';
            const durationLabel = duration + ' min';
            return `
          <div class="col-md-6 col-lg-4">
            <article class="card service-card h-100 border-0 shadow-sm ${selected ? "active" : ""}" data-service-id="${s._id}" data-service-type="${serviceType}">
              <div class="card-body p-4 d-flex flex-column h-100">
                <div class="d-flex align-items-start gap-3 mb-4">
                  <div class="service-icon shadow-sm">
                    <i class="${icon} fs-4 text-primary"></i>
                  </div>
                  <div class="flex-grow-1">
                    <div class="service-card-header d-flex flex-column gap-2">
                      <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                        <div>
                          <h6 class="card-title fw-semibold mb-1 text-dark">${s.name || "Unnamed Service"}</h6>
                          <div class="small text-muted">Tap Add to Booking for details and pricing options.</div>
                        </div>
                        <div class="price-box rounded-pill px-3 py-2 fw-bold text-primary">
                          ${priceDisplay}
                        </div>
                      </div>
                      <div class="d-flex flex-wrap gap-2 align-items-center service-card-meta">
                        ${typeBadge}
                        <span class="badge bg-light text-muted service-card-chip">${durationLabel}</span>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="mt-auto pt-2">
                  <button class="btn btn-primary btn-sm w-100 add-service-btn"
                          data-service-id="${s._id}"
                          data-service-type="${serviceType}"
                          data-service-name="${s.name || ""}"
                          data-is-aircon="${isAircon}">
                    <i class="bi bi-plus-circle me-2"></i>Add to Booking
                  </button>
                </div>
              </div>
            </article>
          </div>`;
          })
          .join("");
      }

      renderListInto(coreCardsEl, state.coreServices || [], "core");
      renderListInto(repairCardsEl, state.repairServices || [], "repair");

      renderSelectedServices();
      updateSummary();
    }

    function renderTechnicians() {
      techEl.innerHTML =
        '<option value="">Select technician</option>' +
        state.technicians
          .map(
            (t) =>
              `<option value="${t._id}">${t.name || "Unnamed"}${t.phone ? " • " + t.phone : ""}</option>`,
          )
          .join("");
    }

    async function loadFarePerKm() {
      try {
        const r = await fetch("/api/services/fare-per-km", {
          cache: "no-store",
        });
        if (!r.ok) {
          console.warn("loadFarePerKm: server returned", r.status);
        }
        const j = await r.json();
        state.farePerKm = Number(j.farePerKm) || 40;
      } catch (e) {
        console.warn("loadFarePerKm failed", e && e.message);
        state.farePerKm = 40;
      }
      const rate = document.getElementById("fareRateDisplay");
      if (rate) rate.textContent = String(state.farePerKm);
    }

    async function loadBookingPolicy() {
      try {
        const response = await fetch("/api/schedule/booking-policy", { cache: "no-store", credentials: "same-origin" });
        const policy = await response.json();
        if (response.ok && Number(policy.largeProjectThresholdHours) > 0) {
          state.largeProjectThresholdHours = Number(policy.largeProjectThresholdHours);
        }
      } catch (error) {
        state.largeProjectThresholdHours = 8;
      }
    }

    async function loadCompanyLocation() {
      try {
        const response = await fetch("/api/public/company/location", { cache: "no-store", credentials: "same-origin" });
        const location = await response.json();
        if (response.ok && Number.isFinite(Number(location.lat)) && Number.isFinite(Number(location.lng))) {
          state.techCoords = { lat: Number(location.lat), lng: Number(location.lng) };
          state.companyAddress = String(location.address || state.companyAddress);
          if (state.markers.tech) {
            state.markers.tech.setLatLng([state.techCoords.lat, state.techCoords.lng]);
            state.markers.tech.setPopupContent(`<strong>CALIDRO RACS</strong><br><small>${escapeMarkup(state.companyAddress)}</small>`);
          }
        }
      } catch (error) {
        console.warn("Company location load failed", error && error.message);
      }
    }

    async function loadOptions() {
      const r = await fetch("/api/appointments/walk-in-options", {
        credentials: "same-origin",
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || "Failed to load walk-in options");

      state.coreServices = d.coreServices || [];
      state.repairServices = d.repairServices || [];
      state.serviceCategories = d.serviceCategories || [];
      state.technicians = d.technicians || [];

      if (!state.coreServices.length && !state.repairServices.length)
        throw new Error("No active services found.");
      if (!state.technicians.length)
        throw new Error("No active technicians found.");

      renderRepairCategories();
      renderServiceCards();
      mountInlineRepairConfigurator();
      renderTechnicians();
      updateSummary();
    }

    function paymentMethodFromUI() {
      return "cod";
    }

    function getEstimatedTotal() {
      return Number((servicesSubtotal() + Number(state.travelFare || 0)).toFixed(2));
    }

    function syncCashAmountInput() {
      const amountEl = document.getElementById("downpaymentAmount");
      const hintEl = document.getElementById("paymentAmountHint");
      if (!amountEl) return;
      const total = getEstimatedTotal();
      if (state.cashPaymentMode === "full") {
        amountEl.value = total.toFixed(2);
        amountEl.readOnly = true;
        if (hintEl)
          hintEl.textContent =
            "Full payment mode: amount equals estimated total.";
      } else {
        amountEl.readOnly = false;
        if (!amountEl.value) amountEl.value = "";
        if (hintEl)
          hintEl.textContent = "Enter the downpayment amount collected now.";
      }
    }

