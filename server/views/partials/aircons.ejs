              <div class="row g-3">
                <div id="directPaymentQrBlock" class="col-md-5 border-md-end mb-3 mb-md-0 customer-payment-qr" style="border-color: #e2e8f0 !important;">
                  <div data-gcash-qr-label class="d-none" style="font-size: 0.72rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.5rem;">Scan to Pay</div>
                  <img id="wizardGcashQr" data-gcash-qr-image alt="CALIDRO GCash payment QR" class="img-fluid d-none" style="max-width: 140px; background: white; border: 1px solid #e2e8f0; border-radius: 6px; padding: 6px;">
                  <div class="customer-payment-recipient">GCash number: <strong id="wizardGcashNumber">Not configured</strong></div>
                  <p data-gcash-qr-missing class="small text-muted mt-2 mb-0">Use the GCash number above to send your payment.</p>
                  <div class="gcash-qr-actions"><a data-gcash-qr-download class="btn btn-outline-primary btn-sm d-none" href="#"><i class="bi bi-download me-1"></i>Download QR</a><a class="btn btn-outline-secondary btn-sm" href="https://gcash.com/getting-started" target="_blank" rel="noopener noreferrer"><i class="bi bi-box-arrow-up-right me-1"></i>GCash website</a></div>
                  <p class="small text-muted mt-2 mb-0">On your phone, open GCash. If you saved the QR, tap QR and upload it. You can also send to the number above. Come back to upload your receipt.</p>
                  <p class="small text-muted mt-1 mb-0">Check the recipient and any transfer fee in GCash before you send.</p>
                </div>
                <div class="col-md-7 ps-md-4 customer-payment-fields">
                  <div class="mb-3">
                    <label id="directPaymentReferenceLabel" for="wizardGcashSenderNumber" class="form-label">Payment Reference <span class="text-danger">*</span></label>
                    <input class="form-control" id="wizardGcashSenderNumber" type="tel" inputmode="numeric" placeholder="Transaction or reference number" autocomplete="off" aria-describedby="directPaymentReferenceHelp directGcashSenderFeedback">
                    <div id="directPaymentReferenceHelp" class="form-text">Enter the reference shown on your payment receipt.</div>
                    <div id="directGcashSenderFeedback" class="gcash-sender-feedback" role="status" aria-live="polite" hidden></div>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Payment receipt photo <span class="text-danger">*</span></label>
                    <input class="form-control" type="file" id="wizardGcashProof" accept="image/jpeg,image/png,image/webp">
                  </div>
                  <!-- Image Preview -->
                  <div id="wizardGcashProofPreviewArea" class="mt-2 text-center" style="display: none;">
                    <div style="font-size: 0.72rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.25rem;">Receipt Preview</div>
                    <img id="wizardGcashProofPreview" src="" alt="Receipt Preview" class="customer-payment-proof-preview">
                  </div>
                </div>
              </div>
              <div class="customer-payment-summary">
                <div class="customer-payment-summary-row"><span>Order total</span><strong id="wizardGcashTotal">--</strong></div>
                <div class="customer-payment-summary-row due"><span id="wizardGcashLabel">Amount due now</span><strong id="wizardGcashAmount">--</strong></div>
                <div class="customer-payment-summary-row" id="wizardGcashBalanceRow"><span id="wizardGcashBalanceLabel">Amount to pay later</span><strong id="wizardGcashBalance">--</strong></div>
              </div>
              <div class="customer-payment-verification"><i class="bi bi-shield-check"></i><span><strong>We will check your receipt.</strong> Your order is not confirmed until our team checks your payment.</span></div>
            </div>

            <input type="hidden" id="wizardPaymentMethod" value="">
          </div>

          <!-- STEP 5 — Review & Confirm -->
          <div class="wizard-panel" id="wizardStep5">
            <div class="step-header">
              <h4>Check your order</h4>
              <p>Check the aircon, address or pickup date, and total. Use Back if you need to change something.</p>
            </div>

            <div class="px-md-2">
              <!-- Product Card -->
              <div class="review-product-card mb-3">
                <img id="reviewImg" src="" class="review-product-img">
                <div class="flex-grow-1">
                  <h5 class="fw-bold mb-0" id="reviewName" style="color: #0f172a; font-size: 0.95rem;"></h5>
                  <div style="color: #64748b; font-size: 0.78rem;" id="reviewVariant"></div>
                </div>
                <div class="text-end">
                  <div style="font-size: 0.62rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px;">Qty</div>
                  <div class="fw-bold" style="color: #0f172a; font-size: 1.4rem; line-height: 1;" id="reviewQtyLarge"></div>
                </div>
              </div>

              <div class="review-summary-card">
                <div id="reviewDetails" class="mb-2"></div>
                <div class="review-row">
                  <span class="review-label">Product Subtotal</span>
                  <span class="review-value" id="reviewSubtotal"></span>
                </div>
                <div class="review-row" id="reviewInstallRow" style="display: none;">
                  <span class="review-label">Installation</span>
                  <span class="review-value" id="reviewInstallFee"></span>
                </div>
                <div class="review-row" id="reviewTransportRow" style="display: none;">
                  <span class="review-label">Delivery fee <small style="color: #94a3b8;" id="reviewTransportMeta"></small></span>
                  <span class="review-value" id="reviewTransportFee"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2 pt-3 border-top" style="border-color: #e2e8f0 !important;">
                      <span style="color: #64748b; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px;">Total to pay</span>
                  <span class="fw-bold" style="color: #0f172a; font-size: 1.4rem; letter-spacing: -0.8px;"
                    id="reviewTotal"></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer d-flex justify-content-between">
          <button class="btn btn-sm" id="wizardBackBtn" onclick="wizardBack()"
            style="border-radius: 8px; padding: 0.5rem 1.25rem; color: #64748b; font-weight: 600; display: none; border: 1.5px solid #e2e8f0; background: #fff; font-size: 0.82rem; transition: all 0.2s;"
            onmouseover="this.style.borderColor='#cbd5e1';this.style.background='#f8fafc'" onmouseout="this.style.borderColor='#e2e8f0';this.style.background='#fff'">
            <i class="bi bi-arrow-left me-1"></i>Back
          </button>
          <div class="ms-auto d-flex gap-2">
            <button class="btn btn-sm" data-bs-dismiss="modal"
              style="border-radius: 8px; padding: 0.5rem 1.25rem; font-weight: 600; color: #64748b; background: #fff; border: 1.5px solid #e2e8f0; font-size: 0.82rem; transition: all 0.2s;"
              onmouseover="this.style.borderColor='#cbd5e1';this.style.background='#f8fafc'" onmouseout="this.style.borderColor='#e2e8f0';this.style.background='#fff'">Cancel</button>
            <button class="btn btn-sm px-4" id="wizardNextBtn"
              onclick="wizardNext()" style="border-radius: 8px; padding: 0.55rem 1.75rem; font-weight: 600; background: linear-gradient(135deg, #2563eb, #3b82f6); color: #fff; border: none; font-size: 0.85rem; transition: all 0.2s; box-shadow: 0 4px 12px rgba(37,99,235,0.25);"
              onmouseover="this.style.transform='translateY(-1px)';this.style.boxShadow='0 6px 20px rgba(37,99,235,0.35)'" onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 12px rgba(37,99,235,0.25)'">
              Choose delivery or pickup <i class="bi bi-arrow-right ms-1" style="font-size: 0.75rem;"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ Scripts ═══ -->
  <!-- Leaflet CSS & JS for map -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- Flatpickr for Premium Date Pickers -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

  <!-- SweetAlert2 for Premium Modals -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/checkout-calendar.js?v=20260925-future-date-v3"></script>
  <script src="/js/customer-store-hours.js?v=20260925-v1"></script>
  <script src="/js/order-checkout-errors.js?v=20260925-valid-date-v3"></script>
  <script src="/js/gcash-qr-actions.js?v=20260925-bundled-qr-v2"></script>
  <script src="/js/gcash-sender-input.js?v=20260925-v1"></script>

  <script>
    window.CustomerStoreHours.load()
      .then(function (hours) {
        var label = document.getElementById('directStoreHoursInfo');
        if (label) label.textContent = 'Store pickup hours: ' + window.CustomerStoreHours.format(hours);
      })
      .catch(function () {
        var label = document.getElementById('directStoreHoursInfo');
        if (label) label.textContent = 'Choose an open pickup date. Store hours could not be loaded.';
      });
  </script>

  <script>
    (function () {
      // ── Premium Alert Helper ────────────────────────────────────────────
      function showPremiumAlert(message, title = 'Attention', icon = 'warning') {
        return Swal.fire({
          title: title,
          text: message,
          icon: icon,
          confirmButtonText: 'OK',
          buttonsStyling: false,
          customClass: {
            popup: 'swal2-popup',
            title: 'swal2-title',
            confirmButton: 'swal2-confirm',
          }
        });
      }

      async function guideDirectCheckoutIssue(message, title, selector) {
        await showPremiumAlert(message, title, 'warning');
        const target = document.querySelector(selector);
        if (!target) return;
        if (!target.matches('button, a, input, select, textarea, [tabindex]')) target.setAttribute('tabindex', '-1');
        target.classList.add('checkout-focus-cue');
        if (target.matches('input, select, textarea')) {
          target.classList.add('is-invalid');
          target.setAttribute('aria-invalid', 'true');
        }
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => target.focus({ preventScroll: true }), 300);
        setTimeout(() => target.classList.remove('checkout-focus-cue'), 2200);
      }

      ['input', 'change'].forEach(eventName => {
        document.getElementById('productOrderModal')?.addEventListener(eventName, event => {
          const field = event.target;
          if (!field?.classList?.contains('is-invalid')) return;
          field.classList.remove('is-invalid');
          field.removeAttribute('aria-invalid');
        });
      });

      // ── Data from server ────────────────────────────────────────────────
      const GROUPS = <%- JSON.stringify(airconGroups) %>;
      const IS_LOGGED_IN = <%= !!locals.user %>;
      const DIRECT_CHECKOUT_CUSTOMER_ID = <%- JSON.stringify((locals.user && (user._id || user.id)) ? String(user._id || user.id) : '').replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026') %>;
      const USER_PHONE = '<%= (locals.user && locals.user.phone) ? locals.user.phone : "" %>';

      function escapeDirectCheckoutHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, character => ({
          '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
        })[character]);
      }

      // Fetch the delivery fare rate; installation is free with product delivery.
      window._farePerKm = 40;
      window.downpaymentPercentage = 10;
      fetch('/api/services/fare-per-km')
        .then(r => r.json())
        .then(data => {
          if (data.farePerKm !== undefined) window._farePerKm = data.farePerKm;
        })
        .catch(() => console.warn('Failed to fetch pricing config'));
      fetch('/api/services/payment-policy')
        .then(r => r.json())
        .then(data => {
          const percentage = Number(data.downpaymentPercentage);
          window.paymentMethodsConfig = data.methods || {};
          if (Object.prototype.hasOwnProperty.call(data, 'gcashNumber')) {
            window.adminGcashNumber = String(data.gcashNumber || '');
          }
          window.gcashQrImageUrl = data.gcashQrImageUrl || '';
          window.GcashQrActions?.apply(window.gcashQrImageUrl);
          if (Number.isFinite(percentage) && percentage >= 1 && percentage <= 100) {
            window.downpaymentPercentage = percentage;
            const selectedMethod = document.getElementById('wizardPaymentMethod')?.value;
            if (selectedMethod && typeof window.selectPaymentMethods === 'function') window.selectPaymentMethods(selectedMethod);
          }
          document.querySelectorAll('#directPaymentChannelSection .payment-channel-card').forEach(button => {
            const method = window.paymentMethodsConfig[button.dataset.channel];
            if (!method) return;
            button.disabled = method.available !== true;
            button.title = button.disabled ? `${method.label || 'This method'} is not currently available.` : '';
            if (button.dataset.channel === 'other' && method.label) button.textContent = method.label;
          });
          if (currentStep === 4) renderPaymentOptions();
        })
        .catch(() => console.warn('Using default downpayment policy'));

      // Company base location for distance calculation
      window._companyBaseLocation = { configured: false, lat: 14.676049, lng: 121.043731 };
      window._companyBaseLocationPromise = fetch('/api/public/company/location')
        .then(r => r.json())
        .then(d => { window._companyBaseLocation = d || window._companyBaseLocation; return window._companyBaseLocation; })
        .catch(() => window._companyBaseLocation);

      // ── Wizard state ────────────────────────────────────────────────────
      let currentStep = 1;
      let selectedGroupIdx = null;
      let selectedVariantIdx = null;
      let selectedQuantity = 1;
      let selectedFulfillment = null;
      let leafletMap = null;
      let leafletMarker = null;
      let fpDatePickup = null;
      let addressSearchTimeout = null;
      let checkoutCalendar = null;
      let _routeDistanceKm = 0;
      let _routeDurationMin = 0;
      let _transportFee = 0;
      let _checkoutRequestId = '';
      let _directCheckoutSubmitting = false;
      let _directDraftSaveTimer = null;
      let _restoringDirectDraft = false;
      let _directCheckoutSessionActive = Boolean(IS_LOGGED_IN && DIRECT_CHECKOUT_CUSTOMER_ID);

      const DIRECT_CHECKOUT_DRAFT_KEY = `racs_direct_order_draft_v2_${DIRECT_CHECKOUT_CUSTOMER_ID}`;
      const DIRECT_CHECKOUT_DRAFT_MAX_AGE_MS = 30 * 60 * 1000;

      async function hasActiveDirectCheckoutSession() {
        if (!IS_LOGGED_IN || !DIRECT_CHECKOUT_CUSTOMER_ID) return false;
        try {
          const response = await fetch('/api/auth/verify', {
            credentials: 'same-origin', cache: 'no-store', headers: { Accept: 'application/json' }
          });
          if (!response.ok) return false;
          const result = await response.json();
          const activeUserId = String(result?.user?._id || result?.user?.id || '');
          return result?.user?.role === 'customer' && activeUserId === String(DIRECT_CHECKOUT_CUSTOMER_ID);
        } catch (_) {
          return false;
        }
      }

      function closeDirectCheckoutAfterLogout() {
        _directCheckoutSessionActive = false;
        clearDirectCheckoutDraft();
        try { localStorage.removeItem('racs_direct_order_draft_v1'); } catch (_) {}
        const modalElement = document.getElementById('productOrderModal');
        if (modalElement && typeof bootstrap !== 'undefined') {
          bootstrap.Modal.getInstance(modalElement)?.hide();
        }
      }

      function directCheckoutFieldValue(id) {
        return document.getElementById(id)?.value || '';
      }

      function directCheckoutVariantId(groupIdx, variantIdx) {
        return GROUPS[groupIdx]?.variants?.[variantIdx]?._id || '';
      }

      function readDirectCheckoutDraft() {
        try {
          if (!_directCheckoutSessionActive || !DIRECT_CHECKOUT_CUSTOMER_ID) return null;
          localStorage.removeItem('racs_direct_order_draft_v1');
          const raw = localStorage.getItem(DIRECT_CHECKOUT_DRAFT_KEY);
          if (!raw) return null;
          const draft = JSON.parse(raw);
          const expired = !draft?.savedAt || Date.now() - Number(draft.savedAt) > DIRECT_CHECKOUT_DRAFT_MAX_AGE_MS;
          const currentVariant = GROUPS[Number(draft.groupIdx)]?.variants?.[Number(draft.variantIdx)];
          const variantExists = String(currentVariant?._id || '') === String(draft.variantId || '') && Number(currentVariant?.quantity) > 0;
          if (expired || !variantExists) {
            localStorage.removeItem(DIRECT_CHECKOUT_DRAFT_KEY);
            return null;
          }
          return draft;
        } catch (_) {
          try { localStorage.removeItem(DIRECT_CHECKOUT_DRAFT_KEY); } catch (_) {}
          return null;
        }
      }

      function saveDirectCheckoutDraft() {
        if (!_directCheckoutSessionActive || _directCheckoutSubmitting || _restoringDirectDraft || selectedGroupIdx === null || selectedVariantIdx === null) return false;
        try {
          const draft = {
            savedAt: Date.now(),
            groupIdx: selectedGroupIdx,
            variantIdx: selectedVariantIdx,
            variantId: directCheckoutVariantId(selectedGroupIdx, selectedVariantIdx),
            selectedQuantity,
            selectedFulfillment,
            currentStep,
            paymentMethod: directCheckoutFieldValue('wizardPaymentMethod'),
            paymentChannel: directCheckoutFieldValue('directWizardPaymentChannel'),
            contactNumber: directCheckoutFieldValue('wizardContact'),
            address: directCheckoutFieldValue('wizardAddress'),
            notes: directCheckoutFieldValue('wizardNotes'),
            latitude: directCheckoutFieldValue('wizardLat'),
            longitude: directCheckoutFieldValue('wizardLng'),
            preferredDate: directCheckoutFieldValue('wizardDate'),
            timeSlot: directCheckoutFieldValue('wizardTimeSlot'),
            pickupDate: directCheckoutFieldValue('wizardPickupDate'),
            routeDistanceKm: _routeDistanceKm,
            routeDurationMin: _routeDurationMin,
            transportationFee: _transportFee,
            checkoutRequestId: _checkoutRequestId
          };
          // Never persist payment references or uploaded receipt contents.
          localStorage.setItem(DIRECT_CHECKOUT_DRAFT_KEY, JSON.stringify(draft));
          return true;
        } catch (_) {
          return false;
        }
      }

      function scheduleDirectCheckoutDraftSave() {
        clearTimeout(_directDraftSaveTimer);
        _directDraftSaveTimer = setTimeout(saveDirectCheckoutDraft, 120);
      }

      function clearDirectCheckoutDraft() {
        clearTimeout(_directDraftSaveTimer);
        try { localStorage.removeItem(DIRECT_CHECKOUT_DRAFT_KEY); } catch (_) {}
      }

      function createCheckoutRequestId() {
        if (window.crypto?.randomUUID) return window.crypto.randomUUID();
        if (window.crypto?.getRandomValues) {
          const bytes = new Uint8Array(24);
          window.crypto.getRandomValues(bytes);
          return Array.from(bytes, value => value.toString(16).padStart(2, '0')).join('');
        }
        return `${Date.now().toString(36)}_${Math.random().toString(36).slice(2)}_${Math.random().toString(36).slice(2)}`;
      }

      const stepTitles = {
        1: 'Choose your aircon size',
        2: 'How will you get your order?',
        3: 'Where and when?',
        4: 'How will you pay?',
        5: 'Check your order'
      };
      const TOTAL_STEPS = 5;

      // ── Filter logic ────────────────────────────────────────────────────
      const filterBtns = document.querySelectorAll('.products-aircons-premium [data-filter]');
      const cards = document.querySelectorAll('.product-card-wrap');
      let activeFilter = 'all';
      let searchQuery = '';

      function applyFilters() {
        let visibleCount = 0;
        cards.forEach(c => {
          const type = c.dataset.type;
          const name = (c.dataset.name || '').toLowerCase();
          const brand = (c.dataset.brand || '').toLowerCase();
          const matchesFilter = activeFilter === 'all' || type === activeFilter;
          const matchesSearch = !searchQuery || name.includes(searchQuery) || brand.includes(searchQuery);
          const visible = matchesFilter && matchesSearch;
          c.classList.toggle('d-none', !visible);
          if (visible) visibleCount++;
        });
        const countEl = document.getElementById('visibleProductCount');
        if (countEl) countEl.textContent = visibleCount;
      }

      filterBtns.forEach(btn => btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeFilter = btn.dataset.filter;
        applyFilters();
      }));

      window.filterProductsBySearch = function() {
        const input = document.getElementById('productSearchInput');
        searchQuery = (input.value || '').toLowerCase().trim();
        const clearBtn = document.getElementById('searchClearBtn');
        if (clearBtn) clearBtn.style.display = searchQuery ? 'flex' : 'none';
        applyFilters();
      };

      document.getElementById('productSearchInput')?.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          this.value = '';
          filterProductsBySearch();
          this.blur();
        }
      });

      // ── Open wizard ─────────────────────────────────────────────────────
      function setDirectCheckoutFieldValue(id, value) {
        const input = document.getElementById(id);
        if (input && value !== undefined && value !== null) input.value = String(value);
      }

      function restoreDirectCheckoutDraft(draft) {
        if (!draft) return;
        _restoringDirectDraft = true;
        try {
          window.selectVariant(Number(draft.variantIdx));
          const variant = GROUPS[selectedGroupIdx]?.variants?.[selectedVariantIdx];
          selectedQuantity = Math.min(Math.max(1, Number(draft.selectedQuantity) || 1), Number(variant?.quantity) || 1);
          document.getElementById('wizardQuantity').textContent = String(selectedQuantity);
          document.getElementById('wizardSelectedPrice').textContent = `₱${((Number(variant?.sellingPrice) || 0) * selectedQuantity).toLocaleString()}`;
          if (checkoutCalendar) checkoutCalendar.setQuantity(selectedQuantity);

          if (draft.selectedFulfillment) window.selectFulfillment(draft.selectedFulfillment);
          setDirectCheckoutFieldValue('wizardContact', draft.contactNumber);
          setDirectCheckoutFieldValue('wizardAddress', draft.address);
          setDirectCheckoutFieldValue('wizardNotes', draft.notes);
          document.getElementById('wizardNotes')?.dispatchEvent(new Event('input', { bubbles:true }));
          setDirectCheckoutFieldValue('wizardLat', draft.latitude);
          setDirectCheckoutFieldValue('wizardLng', draft.longitude);
          setDirectCheckoutFieldValue('wizardDate', draft.preferredDate);
          setDirectCheckoutFieldValue('wizardTimeSlot', draft.timeSlot);
          if (draft.selectedFulfillment !== 'customer_pickup') checkoutCalendar?.restoreSelection(draft.preferredDate, draft.timeSlot);
          setDirectCheckoutFieldValue('wizardPickupDate', draft.pickupDate);
          if (fpDatePickup && draft.pickupDate) fpDatePickup.setDate(draft.pickupDate, false);

          _routeDistanceKm = Number(draft.routeDistanceKm) || 0;
          _routeDurationMin = Number(draft.routeDurationMin) || 0;
          _transportFee = Number(draft.transportationFee) || 0;
          _checkoutRequestId = draft.checkoutRequestId || createCheckoutRequestId();

          let targetStep = Math.min(TOTAL_STEPS, Math.max(1, Number(draft.currentStep) || 1));
          if (!draft.selectedFulfillment && targetStep > 2) targetStep = 2;
          const needsReceipt = ['gcash_full', 'cod'].includes(draft.paymentMethod);
          if (needsReceipt && targetStep > 4) targetStep = 4;

          if (targetStep >= 3) {
            const isDelivery = selectedFulfillment !== 'customer_pickup';
            document.getElementById('deliveryFields').style.display = isDelivery ? 'block' : 'none';
            document.getElementById('pickupFields').style.display = isDelivery ? 'none' : 'block';
            if (isDelivery) setTimeout(() => initMap(), 250);
          }
          if (targetStep >= 4) {
            renderPaymentOptions();
            if (draft.paymentMethod) window.selectPaymentMethods(draft.paymentMethod);
            if (draft.paymentChannel) window.selectDirectPaymentChannel(draft.paymentChannel);
            setDirectCheckoutFieldValue('wizardGcashSenderNumber', '');
            const notice = document.getElementById('directCheckoutRestoreNotice');
            if (notice) notice.classList.toggle('d-none', !needsReceipt);
          }
          currentStep = targetStep;
          if (targetStep === 5) populateReview();
          updateWizardUI();
        } finally {
          _restoringDirectDraft = false;
        }
      }

      window.openProductWizard = async function (gIdx) {
        _directCheckoutSessionActive = await hasActiveDirectCheckoutSession();
        if (!_directCheckoutSessionActive) {
          closeDirectCheckoutAfterLogout();
          window.location.href = '/login?returnTo=' + encodeURIComponent('/products');
          return;
        }
        let savedDraft = readDirectCheckoutDraft();
        if (savedDraft && Number(savedDraft.groupIdx) !== Number(gIdx)) {
          clearDirectCheckoutDraft();
          savedDraft = null;
        }
        selectedGroupIdx = gIdx;
        selectedVariantIdx = null;
        selectedQuantity = 1;
        selectedFulfillment = null;
        _routeDistanceKm = 0;
        _routeDurationMin = 0;
        _transportFee = 0;
        _checkoutRequestId = savedDraft?.checkoutRequestId || '';
        currentStep = 1;

        const g = GROUPS[gIdx];
        if (!g) return;
        document.getElementById('directCheckoutRestoreNotice')?.classList.add('d-none');
        setDirectCheckoutFieldValue('wizardPaymentMethod', '');
        setDirectCheckoutFieldValue('directWizardPaymentChannel', '');
        setDirectCheckoutFieldValue('wizardGcashSenderNumber', '');
        const receiptInput = document.getElementById('wizardGcashProof');
        if (receiptInput) receiptInput.value = '';
        const receiptPreviewArea = document.getElementById('wizardGcashProofPreviewArea');
        if (receiptPreviewArea) receiptPreviewArea.style.display = 'none';

        // Populate step 1
        document.getElementById('wizardProductImg').src = g.imageUrl || '/images/products/default.png';
        document.getElementById('wizardProductName').textContent = g.modelLine;
        document.getElementById('wizardProductMeta').textContent = [
          g.brand,
          g.type.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
        ].filter(Boolean).join(' · ');
        document.getElementById('wizardProductDesc').textContent = g.description || '';
        document.getElementById('wizardQuantityContainer').style.display = 'none';
        document.getElementById('wizardQuantity').textContent = '1';
        document.getElementById('wizardSelectedInfo').style.display = 'none';
        var badge = document.getElementById('wizardProductBadge');
        if (badge) {
          badge.style.display = g.inverter ? 'inline-block' : 'none';
          badge.textContent = g.inverter ? 'Inverter' : '';
        }

        // HP options
        const hpContainer = document.getElementById('wizardHpOptions');
        hpContainer.innerHTML = '';
        g.variants.forEach((v, vIdx) => {
          const isAvailable = v.quantity > 0;
          const card = document.createElement('div');
          card.className = 'hp-card' + (isAvailable ? '' : ' opacity-50');
          card.dataset.vidx = vIdx;
          const stockClass = isAvailable ? 'in-stock' : 'out-of-stock';
          const stockText = isAvailable ? `${v.quantity} in stock` : 'Out of stock';
          const stockIcon = isAvailable ? 'bi-check-circle-fill' : 'bi-x-circle-fill';
          card.innerHTML = `
            <div class="hp-check"><i class="bi bi-check-lg"></i></div>
            <div class="d-flex align-items-baseline gap-1 mb-1">
              <span class="hp-number">${v.capacity}</span>
              <span class="hp-unit">${v.capacityUnit}</span>
            </div>
            <div class="hp-detail">${v.btu ? v.btu.toLocaleString() + ' BTU' : ''}</div>
            <div class="hp-price">₱${v.sellingPrice.toLocaleString()}</div>
            <div class="hp-stock ${stockClass}"><i class="bi ${stockIcon}" style="font-size:0.6rem;"></i>${stockText}</div>
          `;
          if (isAvailable) {
            card.addEventListener('click', () => selectVariant(vIdx));
          }
          hpContainer.appendChild(card);
        });

        document.getElementById('wizardSelectedInfo').style.display = 'none';

        // Ensure Step 1 also has an "Add to Cart" option if needed
        const footerBtnContainer = document.querySelector('#productOrderModal .modal-footer .ms-auto');
        if (footerBtnContainer && !document.getElementById('wizardAddToCartBtn')) {
          const cartBtn = document.createElement('button');
          cartBtn.id = 'wizardAddToCartBtn';
          cartBtn.className = 'btn px-4 shadow-sm me-2';
          cartBtn.innerHTML = '<i class="bi bi-cart-plus me-2"></i>Add to Cart';
          cartBtn.style.borderRadius = '8px';
          cartBtn.style.padding = '0.5rem 1.5rem';
          cartBtn.style.fontWeight = '600';
          cartBtn.style.fontSize = '0.82rem';
          cartBtn.style.color = '#2563eb';
          cartBtn.style.background = '#eff6ff';
          cartBtn.style.border = '1px solid #bfdbfe';
          cartBtn.style.transition = 'all 0.2s';
          cartBtn.style.display = 'none';
          cartBtn.onclick = addToCart;
          cartBtn.onmouseover = function() { this.style.background = '#dbeafe'; this.style.borderColor = '#60a5fa'; };
          cartBtn.onmouseout = function() { this.style.background = '#eff6ff'; this.style.borderColor = '#bfdbfe'; };
          footerBtnContainer.insertBefore(cartBtn, document.getElementById('wizardNextBtn'));
        }

        // Show login overlay if not logged in
        document.getElementById('loginOverlay').style.display = IS_LOGGED_IN ? 'none' : 'flex';

        const footer = document.querySelector('#productOrderModal .modal-footer');
        if (footer) {
          footer.style.display = IS_LOGGED_IN ? 'flex' : 'none';

          // Modal footer override sets display to none or flex, we might need to add/remove d-flex class if it uses bootstrap classes
          if (IS_LOGGED_IN) {
            footer.classList.add('d-flex');
          } else {
            footer.classList.remove('d-flex');
          }
        }

        // Auto-populate contact number from user data
        const contactInput = document.getElementById('wizardContact');
        if (contactInput && USER_PHONE) {
          contactInput.value = USER_PHONE;
        }

        // Reset status badges
        updateWizardUI();

        // Initialize Checkout Calendar
        if (!checkoutCalendar) {
          checkoutCalendar = new CheckoutCalendar('checkoutCalendarContainer', {
            fulfillmentType: selectedFulfillment,
            duration: 60,
            quantity: selectedQuantity || 1,
            travelTime: 30,
            onDateSelect: (dateStr) => {
              document.getElementById('wizardDate').value = dateStr;
              document.getElementById('wizardDateError').style.display = 'none';
            },
            onTimeSelect: (timeStr) => {
              document.getElementById('wizardTimeSlot').value = timeStr;
              scheduleDirectCheckoutDraftSave();
            }
          });
        } else {
          checkoutCalendar.setDuration(60);
          checkoutCalendar.setQuantity(selectedQuantity || 1);
          checkoutCalendar.setTravelTime(30);
        }

        // Set min date for date pickers via Flatpickr for pickup
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);

        const fpConfig = {
          minDate: tomorrow,
          dateFormat: "Y-m-d",
          altInput: true,
          altFormat: "F j, Y",
          disableMobile: true,
          inline: true,
          monthSelectorType: "static",
          position: "auto left"
        };

        if (!fpDatePickup) {
          fpDatePickup = flatpickr("#wizardPickupDate", fpConfig);
        } else {
          fpDatePickup.clear();
        }

        // Update cart count icon if needed
        updateCartBadge();

        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('productOrderModal'));
        modal.show();
        if (savedDraft && Number(savedDraft.groupIdx) === Number(gIdx)) {
          setTimeout(() => restoreDirectCheckoutDraft(savedDraft), 80);
        }
      };

      // ── Select HP variant ───────────────────────────────────────────────
      window.selectVariant = function (vIdx) {
        selectedVariantIdx = vIdx;
        const g = GROUPS[selectedGroupIdx];
        const v = g.variants[vIdx];

        // Highlight selected
        document.querySelectorAll('#wizardHpOptions .hp-card').forEach((opt, i) => {
          opt.classList.toggle('selected', i === vIdx);
        });

        // Show info
        const info = document.getElementById('wizardSelectedInfo');
        info.style.display = 'block';
        document.getElementById('wizardSelectedHpLabel').textContent = `${v.capacity} ${v.capacityUnit}`;
        document.getElementById('wizardSelectedPrice').textContent = `₱${v.sellingPrice.toLocaleString()}`;
        document.getElementById('wizardSelectedBtu').textContent = v.btu ? `${v.btu.toLocaleString()} BTU` : '';

        // Setup quantity
        selectedQuantity = 1;
        if (checkoutCalendar) checkoutCalendar.setQuantity(1);
        document.getElementById('wizardQuantity').textContent = '1';
        document.getElementById('wizardMaxQuantity').textContent = v.quantity;
        document.getElementById('wizardQuantityContainer').style.display = 'block';
        scheduleDirectCheckoutDraftSave();
      };

      window.updateQuantity = function(change) {
        if (selectedVariantIdx === null) return;
        const g = GROUPS[selectedGroupIdx];
        const v = g.variants[selectedVariantIdx];
        const max = v.quantity || 1;
        let newQ = selectedQuantity + change;
        if (newQ < 1) newQ = 1;
        if (newQ > max) newQ = max;
        selectedQuantity = newQ;
        document.getElementById('wizardQuantity').textContent = String(newQ);
        if (checkoutCalendar) checkoutCalendar.setQuantity(newQ);
        
        // Update price display dynamically based on quantity
        document.getElementById('wizardSelectedPrice').textContent = `₱${(v.sellingPrice * newQ).toLocaleString()}`;
        scheduleDirectCheckoutDraftSave();
      };

      // ── Select fulfillment ──────────────────────────────────────────────
      window.selectFulfillment = function (type) {
        selectedFulfillment = type;
        document.querySelectorAll('.fulfill-card').forEach(c => {
          c.classList.toggle('selected', c.dataset.fulfill === type);
        });
        if (checkoutCalendar) {
          checkoutCalendar.setFulfillmentType(type);
        }
        scheduleDirectCheckoutDraftSave();
      };

      // ── Wizard navigation ───────────────────────────────────────────────
      window.wizardNext = async function () {
        _directCheckoutSessionActive = await hasActiveDirectCheckoutSession();
        if (!_directCheckoutSessionActive) {
          closeDirectCheckoutAfterLogout();
          window.location.href = '/login?returnTo=' + encodeURIComponent('/products');
          return;
        }

        // Validate current step
        if (currentStep === 1 && selectedVariantIdx === null) {
          await guideDirectCheckoutIssue('Choose the HP (aircon size) you want.', 'Choose an aircon size', '#wizardHpOptions');
          return;
        }
        if (currentStep === 2 && !selectedFulfillment) {
          await guideDirectCheckoutIssue('Choose delivery with installation or store pickup.', 'How will you get your order?', '#productOrderModal .fulfill-card');
          return;
        }
        if (currentStep === 3) {
          if (selectedFulfillment !== 'customer_pickup') {
            const addr = document.getElementById('wizardAddress').value.trim();
            const contact = document.getElementById('wizardContact').value.trim();
            const date = document.getElementById('wizardDate').value;
            const timeSlot = document.getElementById('wizardTimeSlot').value;

            if (addr.length < 8) { await guideDirectCheckoutIssue('Enter a complete address with at least 8 characters.', 'Check your address', '#wizardAddress'); return; }
            const contactDigits = contact.replace(/\D/g, '');
            if (!/^[+\d().\-\s]+$/.test(contact) || contactDigits.length < 7 || contactDigits.length > 15) {
              await guideDirectCheckoutIssue('Enter a phone number with 7 to 15 digits so we can call you.', 'Check your phone number', '#wizardContact');
              return;
            }
            if (!document.getElementById('wizardLat').value || !document.getElementById('wizardLng').value) {
              await guideDirectCheckoutIssue('Search for your address or put the pin on your house.', 'Check the map pin', '#wizardMap');
              return;
            }
            if (!window.OrderCheckoutErrors.isFutureDate(date) || !timeSlot) { await guideDirectCheckoutIssue('Choose an open date after today, then a start time.', 'Choose a date and time', '#checkoutCalendarContainer'); return; }
            if (checkoutCalendar && !(await checkoutCalendar.validateSelectedSlot(date, timeSlot))) {
              await guideDirectCheckoutIssue('That time is no longer available. Please choose another one.', 'Choose another time', '#checkoutCalendarContainer');
              return;
            }
          } else {
            const pickupDate = document.getElementById('wizardPickupDate').value;
            if (!window.OrderCheckoutErrors.isFutureDate(pickupDate)) { await guideDirectCheckoutIssue('Choose an available pickup date after today.', 'Choose a pickup date', '#wizardPickupDate'); return; }
          }
        }
        if (currentStep === 4) {
          const payMethod = document.getElementById('wizardPaymentMethod').value;
          if (!payMethod) { await guideDirectCheckoutIssue('Choose to pay all now or pay part now.', 'Choose how much to pay', '#paymentOptionsContainer .payment-method-card'); return; }

          if (payMethod === 'gcash_full' || payMethod === 'cod') {
            const paymentChannel = document.getElementById('directWizardPaymentChannel')?.value || '';
            if (!['gcash', 'maya', 'bank_transfer', 'other'].includes(paymentChannel)) {
              await guideDirectCheckoutIssue('Choose GCash, Maya, bank transfer, or another payment method.', 'Choose how to pay', '#directPaymentChannelSection .payment-channel-card:not(:disabled)');
              return;
            }
            if (window.paymentMethodsConfig?.[paymentChannel]?.available === false) {
              await guideDirectCheckoutIssue('This payment method is not available. Choose another one.', 'Choose another method', '#directPaymentChannelSection .payment-channel-card:not(:disabled)');
              return;
            }
            if (paymentChannel === 'gcash' && !String(window.adminGcashNumber || '').trim()) {
              await guideDirectCheckoutIssue('GCash is not available right now. Choose another way to pay.', 'Choose another method', '#directPaymentChannelSection .payment-channel-card:not(:disabled)');
              return;
            }
            const reference = String(document.getElementById('wizardGcashSenderNumber')?.value || '').trim();
            const senderFeedback = paymentChannel === 'gcash' ? updateDirectGcashSenderFeedback(true) : null;
            if ((paymentChannel === 'gcash' && !senderFeedback.valid) || (paymentChannel !== 'gcash' && reference.length < 3)) {
              await guideDirectCheckoutIssue(paymentChannel === 'gcash'
                ? senderFeedback.message
                : 'Enter the payment number shown on your receipt.',
              'Check the payment number', '#wizardGcashSenderNumber');
              return;
            }
            const gcashProof = document.getElementById('wizardGcashProof').files[0];
            if (!gcashProof) {
              await guideDirectCheckoutIssue('Upload a photo or screenshot of your payment receipt.', 'Add your receipt', '#wizardGcashProof');
              return;
            }
          }
        }
        if (currentStep === 5) {
          submitOrder();
          return;
        }

        currentStep++;

        // Setup step 3 based on fulfillment
        if (currentStep === 3) {
          const isDelivery = selectedFulfillment !== 'customer_pickup';
          document.getElementById('deliveryFields').style.display = isDelivery ? 'block' : 'none';
          document.getElementById('pickupFields').style.display = isDelivery ? 'none' : 'block';

          if (checkoutCalendar) {
            checkoutCalendar.setFulfillmentType(selectedFulfillment);
            checkoutCalendar.fetchData();
          }

          if (isDelivery) {
            setTimeout(() => initMap(), 500);
          }
        }

        // Render payment options on step 4
        if (currentStep === 4) {
          renderPaymentOptions();
        }

        // Populate review step
        if (currentStep === 5) {
          populateReview();
        }

        updateWizardUI();
        scheduleDirectCheckoutDraftSave();
      };

      window.wizardBack = function () {
        if (currentStep <= 1) return;
        currentStep--;
        updateWizardUI();
        scheduleDirectCheckoutDraftSave();
      };

      // ── Update wizard UI ────────────────────────────────────────────────
      function updateWizardUI() {
        // Show/hide panels
        for (let i = 1; i <= TOTAL_STEPS; i++) {
          const panel = document.getElementById(`wizardStep${i}`);
          if (panel) panel.classList.toggle('active', i === currentStep);
        }

        // Update title
        document.getElementById('wizardModalTitle').innerHTML = stepTitles[currentStep] || '';

        // Update progress dots
        document.querySelectorAll('#productOrderModal .wizard-step-dot').forEach(dot => {
          const step = parseInt(dot.dataset.step);
          dot.classList.remove('active', 'completed');
          if (step === currentStep) dot.classList.add('active');
          else if (step < currentStep) { dot.classList.add('completed'); dot.innerHTML = '<i class="bi bi-check"></i>'; }
          else dot.textContent = step;
        });
        document.querySelectorAll('#productOrderModal .wizard-step-label').forEach((lbl, i) => {
          lbl.classList.remove('active', 'completed');
          if (i + 1 === currentStep) lbl.classList.add('active');
          else if (i + 1 < currentStep) lbl.classList.add('completed');
        });
        for (let i = 1; i <= TOTAL_STEPS - 1; i++) {
          const line = document.getElementById(`line${i}`);
          if (line) line.classList.toggle('completed', i < currentStep);
        }

        // Back button
        document.getElementById('wizardBackBtn').style.display = currentStep > 1 ? 'inline-flex' : 'none';

        // Next button text
        const nextBtn = document.getElementById('wizardNextBtn');
        const cartBtn = document.getElementById('wizardAddToCartBtn');

        if (currentStep === 1) {
          if (cartBtn) cartBtn.style.display = 'inline-flex';
        } else {
          if (cartBtn) cartBtn.style.display = 'none';
        }

        if (currentStep === TOTAL_STEPS) {
          nextBtn.innerHTML = '<i class="bi bi-bag-check me-1"></i>Place my order';
          nextBtn.classList.add('btn-success');
          nextBtn.style.background = 'linear-gradient(135deg, #059669, #10b981)';
        } else {
          const nextLabels = {
            1: 'Choose delivery or pickup',
            2: 'Add address or pickup date',
            3: 'Choose payment',
            4: 'Check my order'
          };
          nextBtn.innerHTML = `${nextLabels[currentStep]} <i class="bi bi-arrow-right ms-1"></i>`;
          nextBtn.classList.remove('btn-success');
          nextBtn.style.background = 'linear-gradient(135deg, #2563eb, #3b82f6)';
        }
      }

      // ── Payment options ──────────────────────────────────────────────────
      function directPaymentChannelLabel(channel) {
        const configured = window.paymentMethodsConfig?.[channel]?.label;
        return configured || ({ gcash: 'GCash', maya: 'Maya', bank_transfer: 'Bank Transfer', other: 'Other Transfer' })[channel] || 'Payment';
      }

      function updateDirectGcashSenderFeedback(required = false) {
        return window.GcashSenderInput.update(
          document.getElementById('wizardGcashSenderNumber'),
          document.getElementById('directGcashSenderFeedback'),
          { enabled: document.getElementById('directWizardPaymentChannel')?.value === 'gcash', required }
        );
      }

      window.selectDirectPaymentChannel = function(channel) {
        if (!['gcash', 'maya', 'bank_transfer', 'other'].includes(channel)) return;
        const configuredMethod = window.paymentMethodsConfig?.[channel];
        if (configuredMethod && configuredMethod.available !== true) return;
        if (!configuredMethod && channel === 'gcash' && !String(window.adminGcashNumber || '').trim()) return;
        const label = directPaymentChannelLabel(channel);
        const isGcash = channel === 'gcash';
        document.getElementById('directWizardPaymentChannel').value = channel;
        document.querySelectorAll('#directPaymentChannelSection .payment-channel-card').forEach(button => {
          const selected = button.dataset.channel === channel;
          button.classList.toggle('selected', selected);
          button.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });
        const help = document.getElementById('directPaymentChannelHelp');
        if (help) help.textContent = isGcash
          ? 'Send to the displayed GCash number, then upload your receipt.'
          : `${configuredMethod?.accountName ? `${configuredMethod.accountName} - ` : ''}${configuredMethod?.accountNumber || `Use the ${label} receiving details`}. Enter the transaction reference and upload your receipt.`;
        document.getElementById('wizardGcashFieldsPanel').style.display = 'block';
        const qrBlock = document.getElementById('directPaymentQrBlock');
        if (qrBlock) qrBlock.style.display = isGcash ? '' : 'none';
        const referenceLabel = document.getElementById('directPaymentReferenceLabel');
        const referenceHelp = document.getElementById('directPaymentReferenceHelp');
        const referenceInput = document.getElementById('wizardGcashSenderNumber');
        if (referenceLabel) referenceLabel.innerHTML = `${isGcash ? 'GCash Sender Number' : `${label} Transaction Reference`} <span class="text-danger">*</span>`;
        if (referenceHelp) referenceHelp.textContent = isGcash ? 'Use the number on the GCash account that sent the payment, not the number shown above.' : 'Enter the transaction or reference number shown on your receipt.';
        if (referenceInput) {
          referenceInput.value = '';
          referenceInput.type = isGcash ? 'tel' : 'text';
          referenceInput.placeholder = isGcash ? '09XXXXXXXXX' : 'Transaction or reference number';
          referenceInput.inputMode = isGcash ? 'numeric' : 'text';
          referenceInput.autocomplete = isGcash ? 'tel' : 'off';
        }
        updateDirectGcashSenderFeedback();
        const method = document.getElementById('wizardPaymentMethod').value;
        document.getElementById('wizardGcashHeading').textContent = method === 'cod' ? `Pay part now with ${label}` : `Pay all now with ${label}`;
        document.getElementById('directPaymentInstructionTitle').textContent = `Send your payment via ${label}`;
        document.getElementById('directPaymentInstructionFirst').textContent = isGcash ? 'Use the QR, if shown, or send to the GCash number below.' : `Use the ${label} payment details confirmed by RACS.`;
        scheduleDirectCheckoutDraftSave();
      };

      document.querySelectorAll('#directPaymentChannelSection .payment-channel-card').forEach(button => {
        button.addEventListener('click', () => window.selectDirectPaymentChannel(button.dataset.channel));
      });

      document.getElementById('wizardGcashSenderNumber')?.addEventListener('input', function () {
        updateDirectGcashSenderFeedback();
      });
      document.getElementById('wizardGcashSenderNumber')?.addEventListener('blur', function () {
        if (document.getElementById('directWizardPaymentChannel')?.value === 'gcash') updateDirectGcashSenderFeedback(true);
      });

      window.selectPaymentMethods = function(method) {
        document.getElementById('wizardPaymentMethod').value = method;
        document.querySelectorAll('#productOrderModal .payment-method-card').forEach(c => {
          c.classList.toggle('selected', c.dataset.method === method);
          c.setAttribute('aria-pressed', c.dataset.method === method ? 'true' : 'false');
        });

        const gcashPanel = document.getElementById('wizardGcashFieldsPanel');
        const showGcash = method === 'gcash_full' || method === 'cod';
        const channelSection = document.getElementById('directPaymentChannelSection');
        if (channelSection) channelSection.style.display = showGcash ? 'block' : 'none';
        if (showGcash) {
          const currentChannel = document.getElementById('directWizardPaymentChannel').value;
          if (!currentChannel) {
            const preferred = ['gcash', 'maya', 'bank_transfer', 'other'].find(channel => window.paymentMethodsConfig?.[channel]?.available)
              || (String(window.adminGcashNumber || '').trim() ? 'gcash' : '');
            if (preferred) window.selectDirectPaymentChannel(preferred);
          }
          gcashPanel.style.display = 'block';
          const g = GROUPS[selectedGroupIdx];
          const v = g.variants[selectedVariantIdx];
          
          let subtotal = v.sellingPrice * selectedQuantity;
          let total = subtotal + (selectedFulfillment !== 'customer_pickup' ? _transportFee : 0);
          
          const isDownpayment = method === 'cod';
          const percentage = window.downpaymentPercentage || 10;
          let amountToPay = isDownpayment ? Math.round(total * percentage / 100) : total;
          const balance = Math.max(0, total - amountToPay);
          
          document.getElementById('wizardGcashAmount').textContent = `₱${amountToPay.toLocaleString()}`;
          document.getElementById('wizardGcashLabel').textContent = isDownpayment ? `Pay now (${percentage}%)` : 'Pay now';
          const channelLabel = directPaymentChannelLabel(document.getElementById('directWizardPaymentChannel').value);
          document.getElementById('wizardGcashHeading').textContent = isDownpayment ? `Pay part now with ${channelLabel}` : `Pay all now with ${channelLabel}`;
          document.getElementById('wizardGcashTotal').textContent = `₱${total.toLocaleString()}`;
          document.getElementById('wizardGcashBalance').textContent = `₱${balance.toLocaleString()}`;
          document.getElementById('wizardGcashBalanceRow').style.display = isDownpayment ? 'flex' : 'none';
          const balanceLabel = document.getElementById('wizardGcashBalanceLabel');
          if (balanceLabel) balanceLabel.textContent = selectedFulfillment === 'customer_pickup'
            ? 'Amount to pay at store pickup'
            : 'Amount to pay after installation';
          
          const gcashNum = window.adminGcashNumber || '';
          document.getElementById('wizardGcashNumber').textContent = gcashNum || 'Contact the store';
          window.GcashQrActions?.apply(window.gcashQrImageUrl);
        } else {
          gcashPanel.style.display = 'none';
        }
        scheduleDirectCheckoutDraftSave();
      };

      // GCash proof preview
      document.getElementById('wizardGcashProof')?.addEventListener('change', function(e) {
        const file = e.target.files[0];
        const previewArea = document.getElementById('wizardGcashProofPreviewArea');
        const previewImg = document.getElementById('wizardGcashProofPreview');
        if (file) {
          const reader = new FileReader();
          reader.onload = function(e) {
            previewImg.src = e.target.result;
            previewArea.style.display = 'block';
          }
          reader.readAsDataURL(file);
        } else {
          previewArea.style.display = 'none';
          previewImg.src = '';
        }
      });

      function renderPaymentOptions() {
        const container = document.getElementById('paymentOptionsContainer');
        document.getElementById('wizardPaymentMethod').value = '';
        document.getElementById('directWizardPaymentChannel').value = '';
        document.getElementById('directPaymentChannelSection').style.display = 'none';
        document.querySelectorAll('#directPaymentChannelSection .payment-channel-card').forEach(button => {
          const method = window.paymentMethodsConfig?.[button.dataset.channel];
          if (method) {
            button.disabled = method.available !== true;
            button.title = button.disabled ? `${method.label || 'This method'} is not currently available.` : '';
          } else if (button.dataset.channel === 'gcash') {
            button.disabled = !String(window.adminGcashNumber || '').trim();
            button.title = button.disabled ? 'GCash receiving details are not configured.' : '';
          }
        });

        let html = '';

        if (selectedFulfillment === 'customer_pickup') {
          html = `
            <div class="col-12 col-md-6">
              <button type="button" class="payment-method-card payment-card-green" data-method="cash_onsite" aria-pressed="false" onclick="selectPaymentMethods('cash_onsite')">
                <span class="checkout-choice-check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                <span class="payment-method-icon"><i class="bi bi-cash-stack fs-3"></i></span>
                <span class="payment-method-copy"><strong>Pay at Store Pickup</strong><span>Pay in cash when you pick up your aircon.</span></span>
              </button>
            </div>
            <div class="col-12 col-md-6">
              <button type="button" class="payment-method-card payment-card-blue" data-method="gcash_full" aria-pressed="false" onclick="selectPaymentMethods('gcash_full')">
                <span class="checkout-choice-check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                <span class="payment-method-icon"><i class="bi bi-phone fs-3"></i></span>
                <span class="payment-method-copy"><strong>Pay all now</strong><span>Send the full amount before pickup.</span></span>
              </button>
            </div>
          `;
        } else {
          html = `


            <div class="col-12 col-md-6">
              <button type="button" class="payment-method-card payment-card-blue" data-method="gcash_full" aria-pressed="false" onclick="selectPaymentMethods('gcash_full')">
