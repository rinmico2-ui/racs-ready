<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title><%= title %> | CALIDRO RACS</title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; font-family: Inter, Arial, sans-serif; color: #0f172a; background: radial-gradient(circle at top, #e0f2fe, #f8fafc 55%); }
    main { width: min(560px, 100%); padding: 38px; text-align: center; background: #fff; border: 1px solid #bae6fd; border-radius: 22px; box-shadow: 0 20px 50px rgba(14, 165, 233, .12); }
    .mark { width: 68px; height: 68px; margin: 0 auto 18px; display: grid; place-items: center; border-radius: 18px; background: #e0f2fe; color: #0284c7; font-size: 34px; }
    h1 { margin: 0 0 10px; font-size: clamp(1.45rem, 4vw, 2rem); }
    p { margin: 0; color: #64748b; line-height: 1.65; }
    small { display: block; margin-top: 22px; color: #94a3b8; }
  </style>
</head>
<body>
  <main role="main">
    <div class="mark" aria-hidden="true">❄</div>
    <h1>We’ll be back shortly</h1>
    <p><%= message %></p>
    <small>CALIDRO RACS · Service availability is monitored by our administrators.</small>
  </main>
</body>
</html>
