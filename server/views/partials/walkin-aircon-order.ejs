  .wa-account-policy{display:flex;align-items:flex-start;gap:.65rem;padding:.75rem;border:1px solid #bfdbfe;border-radius:11px;background:#f0f7ff;color:#334155;font-size:.7rem;line-height:1.45}.wa-account-policy i{color:#2563eb;font-size:1rem}.wa-account-policy strong{display:block;color:#1e3a8a;font-size:.74rem}.wa-account-email-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.45rem}.wa-account-find{min-width:112px;border:1px solid #2563eb;border-radius:9px;padding:.55rem .65rem;background:#2563eb;color:#fff;font-size:.7rem;font-weight:800}.wa-account-find:disabled{opacity:.6}.wa-account-status{display:flex;align-items:flex-start;gap:.4rem;margin-top:.45rem;padding:.55rem .65rem;border-radius:9px;background:#f1f5f9;color:#64748b;font-size:.66rem;line-height:1.4}.wa-account-status.success{background:#ecfdf5;color:#166534}.wa-account-status.warning{background:#fffbeb;color:#92400e}.wa-account-status.danger{background:#fef2f2;color:#b91c1c}.wa-existing-customer{display:flex;align-items:flex-start;gap:.6rem;margin-top:.5rem;padding:.65rem;border:1px solid #bbf7d0;border-radius:10px;background:#f0fdf4;color:#166534}.wa-existing-customer i{font-size:1.05rem}.wa-existing-customer strong,.wa-existing-customer span{display:block}.wa-existing-customer strong{font-size:.73rem}.wa-existing-customer span{margin-top:1px;color:#15803d;font-size:.63rem}.wa-new-customer-heading{display:flex;align-items:center;gap:.45rem;color:#1d4ed8;font-size:.69rem;font-weight:800}
  @media(max-width:520px){.wa-account-email-row{grid-template-columns:1fr}.wa-account-find{width:100%}}
  .wa-receipt-modal{width:min(650px,calc(100vw - 24px));max-height:calc(100vh - 32px);overflow:auto;border-radius:18px;background:#fff;box-shadow:0 24px 80px rgba(15,23,42,.28)}.wa-receipt-head{display:flex;justify-content:space-between;align-items:center;padding:1rem 1.2rem;border-bottom:1px solid #e2e8f0}.wa-receipt-head h3{margin:0;font-size:1rem;font-weight:800}.wa-receipt-body{padding:1.3rem}.wa-receipt-brand{text-align:center;padding-bottom:1rem;border-bottom:2px dashed #cbd5e1}.wa-receipt-brand h4{margin:0;color:#1e3a8a;font-weight:900}.wa-receipt-brand p{margin:.2rem 0 0;color:#64748b;font-size:.72rem}.wa-receipt-grid{display:grid;grid-template-columns:1fr 1fr;gap:.6rem 1rem;padding:1rem 0;font-size:.78rem}.wa-receipt-grid span{display:block;color:#94a3b8;font-size:.65rem;text-transform:uppercase}.wa-receipt-items{width:100%;font-size:.75rem}.wa-receipt-items th{padding:.55rem .35rem;border-bottom:1px solid #cbd5e1;color:#64748b;text-transform:uppercase;font-size:.62rem}.wa-receipt-items td{padding:.6rem .35rem;border-bottom:1px solid #f1f5f9}.wa-receipt-items th:last-child,.wa-receipt-items td:last-child{text-align:right}.wa-receipt-total{display:flex;justify-content:space-between;margin-top:1rem;padding-top:1rem;border-top:2px solid #0f172a;font-size:1rem;font-weight:900}.wa-account-result{margin-top:1rem;padding:.8rem;border-radius:11px;background:#eff6ff;color:#1e40af;font-size:.75rem;line-height:1.45}.wa-receipt-actions{display:flex;justify-content:flex-end;gap:.55rem;padding:1rem 1.2rem;border-top:1px solid #e2e8f0}.wa-receipt-actions button{padding:.65rem .9rem;border-radius:9px;border:1px solid #cbd5e1;background:#fff;font-size:.74rem;font-weight:800}.wa-receipt-actions .primary{border-color:#2563eb;background:#2563eb;color:#fff}
  @media print{body.wa-printing *{visibility:hidden!important}body.wa-printing #waReceiptContent,body.wa-printing #waReceiptContent *{visibility:visible!important}body.wa-printing #waReceiptContent{position:absolute;left:0;top:0;width:100%;padding:20px;background:#fff}}
</style>

<section class="wa-shell" aria-labelledby="waTitle">
  <header class="wa-hero">
    <div><h2 id="waTitle">Walk-in Aircon Order</h2><p>Select a unit, collect payment, and assign installation to an available technician in one checkout.</p><div class="wa-flow" aria-label="Aircon order steps"><span><b>1</b>Select unit</span><span><b>2</b>Customer</span><span><b>3</b>Schedule</span><span><b>4</b>Payment</span></div></div>
    <button type="button" class="wa-cart-launch" id="waOpenCart"><i class="bi bi-cart3"></i><span class="label">Review cart</span><span id="waHeroCartCount">0</span></button>
  </header>
  <div class="wa-layout">
    <section class="wa-panel">
      <div class="wa-toolbar">
        <div class="wa-search"><i class="bi bi-search"></i><input id="waSearch" type="search" placeholder="Search brand, model, capacity, or barcode" autocomplete="off"></div>
        <select id="waTypeFilter" aria-label="Filter aircon type"><option value="">All aircon types</option></select>
      </div>
      <div class="wa-products" id="waProducts"><div class="wa-empty"><span class="spinner-border spinner-border-sm"></span><p>Loading aircons…</p></div></div>
    </section>

    <aside class="wa-panel wa-checkout" id="waCartDrawer" role="dialog" aria-modal="true" aria-labelledby="waCartTitle" aria-hidden="true">
      <div class="wa-checkout-head"><div><h3 id="waCartTitle"><i class="bi bi-cart3 me-2 text-primary"></i>Order checkout</h3><span class="wa-checkout-sub">Complete the details below, then review the total.</span></div><div class="wa-checkout-actions"><span class="wa-count" id="waCartCount" aria-label="Cart unit count">0</span><button type="button" class="wa-drawer-close" id="waCloseCart" aria-label="Close cart"><i class="bi bi-x-lg"></i></button></div></div>
      <div class="wa-cart" id="waCart"><div class="wa-empty" style="padding:1.5rem .5rem"><i class="bi bi-cart"></i><p class="mb-0">Select an aircon to begin.</p></div></div>
      <form class="wa-form" id="waCheckoutForm" novalidate>
        <section class="wa-section">
          <h4 class="wa-section-title"><i class="bi bi-person"></i>Customer</h4>
          <div class="wa-fields">
            <div class="wa-wide wa-account-policy"><i class="bi bi-shield-check"></i><div><strong>Account matching is automatic</strong>Search the customer's email first. An existing customer account is reused; otherwise, the customer profile and consent are required for a secure activation invitation.</div></div>
            <div class="wa-wide">
              <label class="wa-label" for="waCustomerEmail">Customer email</label>
              <div class="wa-account-email-row"><input class="wa-field" id="waCustomerEmail" type="email" maxlength="254" autocomplete="email" placeholder="customer@example.com" required><button class="wa-account-find" id="waFindCustomer" type="button"><i class="bi bi-search me-1"></i>Find customer</button></div>
              <div class="wa-account-status" id="waCustomerLookupStatus" role="status" aria-live="polite"><i class="bi bi-info-circle"></i><span>No account selected. Search by email before checkout.</span></div>
              <div class="wa-existing-customer wa-hidden" id="waExistingCustomer" aria-live="polite"><i class="bi bi-person-check-fill"></i><div><strong id="waExistingCustomerName">Existing customer</strong><span id="waExistingCustomerMeta"></span></div></div>
            </div>
            <div class="wa-wide wa-new-customer-heading wa-hidden" id="waNewCustomerHeading"><i class="bi bi-person-plus-fill"></i><span>No account exists. Complete the customer profile below.</span></div>
            <div class="wa-wide wa-hidden" id="waCustomerNameWrap"><label class="wa-label" for="waCustomerName">Full name</label><input class="wa-field" id="waCustomerName" maxlength="160"></div>
            <div class="wa-wide wa-hidden" id="waCustomerPhoneWrap"><label class="wa-label" for="waCustomerPhone">Phone</label><input class="wa-field" id="waCustomerPhone" inputmode="tel" maxlength="20"></div>
            <div class="wa-wide wa-hidden" id="waAccountConsentWrap"><label class="wa-account-consent" for="waAccountConsent"><input id="waAccountConsent" type="checkbox"><span><strong id="waAccountConsentTitle">Customer consent for online account access</strong><span id="waAccountConsentText">I confirm the customer authorized this order to be linked to their account.</span><small id="waAccountConsentHelp">Account messages will be sent to the verified email.</small></span></label></div>
          </div>
        </section>
        <section class="wa-section">
          <h4 class="wa-section-title"><i class="bi bi-box-seam"></i>Fulfillment</h4>
          <div class="wa-choice" id="waFulfillmentChoices">
            <button type="button" data-value="delivery_installation" class="active" aria-pressed="true"><i class="bi bi-truck d-block"></i>Deliver + install<small>Assign technician</small></button>
            <button type="button" data-value="customer_pickup" aria-pressed="false"><i class="bi bi-calendar2-check d-block"></i>Pickup later<small>Choose pickup date</small></button>
            <button type="button" data-value="carry_out" aria-pressed="false"><i class="bi bi-bag-check d-block"></i>Carry out<small>Release today</small></button>
          </div>
        </section>
        <section class="wa-section" id="waDeliverySection">
          <h4 class="wa-section-title"><i class="bi bi-geo-alt"></i>Installation assignment</h4>
          <div class="wa-fields">
            <div class="wa-wide wa-address-wrap"><label class="wa-label" for="waAddress">Search and select installation address</label><input class="wa-field" id="waAddress" autocomplete="off" placeholder="Street, barangay, city"><div id="waAddressResults" class="wa-address-results wa-hidden"></div></div>
            <input type="hidden" id="waLat"><input type="hidden" id="waLng">
            <div class="wa-wide wa-map-card" id="waMapCard">
              <div class="wa-map-toolbar">
                <div><h5><i class="bi bi-map me-1 text-primary"></i>Delivery route map</h5><p>Search an address, click the map, or drag the red pin to the exact installation point.</p></div>
                <div class="wa-map-actions" aria-label="Delivery map controls">
                  <button type="button" class="wa-map-action" id="waLocateMe" title="Use current location"><i class="bi bi-crosshair"></i><span>My location</span></button>
                  <button type="button" class="wa-map-action" id="waFitRoute" title="Show full route" disabled><i class="bi bi-arrows-fullscreen"></i><span>Fit route</span></button>
                  <button type="button" class="wa-map-action" id="waExpandMap" title="Expand map"><i class="bi bi-fullscreen"></i><span>Expand</span></button>
                </div>
              </div>
              <div class="wa-map-stage">
                <div class="wa-map" id="waMap" role="application" aria-label="Interactive delivery route map"></div>
                <div class="wa-map-spinner" id="waMapSpinner"><span class="spinner-border spinner-border-sm"></span><span id="waMapSpinnerText">Calculating route…</span></div>
                <div class="wa-map-legend" aria-label="Map legend"><span><i class="wa-map-dot"></i>CALIDRO RACS</span><span><i class="wa-map-dot customer"></i>Installation point</span></div>
              </div>
              <div class="wa-map-selection" id="waMapSelection" aria-live="polite">
                <div class="wa-map-selection-main"><span class="wa-map-selection-icon"><i class="bi bi-geo-alt"></i></span><div><div class="wa-map-selection-status" id="waMapStatus">Location not pinned</div><div class="wa-map-address" id="waMapAddress">Choose a search result or select the exact point on the map.</div></div></div>
                <div class="wa-map-coordinate"><span>Coordinates</span><strong id="waMapCoordinates">Not selected</strong><small id="waMapSource">Waiting for location</small></div>
              </div>
            </div>
            <div class="wa-wide" id="waQuote"><div class="wa-quote"><span>Select an address for the route quote.</span><strong>—</strong></div></div>
            <div class="wa-wide"><label class="wa-label" for="waTechnician">Assign technician</label><select class="wa-field" id="waTechnician"><option value="">Loading technicians…</option></select><p class="wa-help"><i class="bi bi-info-circle me-1"></i>The calendar below is calculated specifically for the selected technician, cart quantity, and travel time.</p></div>
            <div class="wa-wide">
              <label class="wa-label">Installation date and time</label>
              <div class="wa-schedule-card">
                <div class="wa-calendar-head">
                  <button class="wa-cal-nav" id="waCalendarPrev" type="button" aria-label="Previous month"><i class="bi bi-chevron-left"></i></button>
                  <h5 id="waCalendarTitle">Available dates</h5>
                  <button class="wa-cal-nav" id="waCalendarNext" type="button" aria-label="Next month"><i class="bi bi-chevron-right"></i></button>
                </div>
                <div class="wa-weekdays" aria-hidden="true"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>
                <div class="wa-calendar" id="waCalendar" role="grid" aria-label="Technician availability calendar"></div>
                <div class="wa-calendar-state" id="waCalendarState" role="status"><i class="bi bi-person-check"></i>Select a technician and verified address first.</div>
              </div>
              <div class="wa-calendar-legend" aria-hidden="true"><span><i class="open"></i>Available</span><span><i class="closed"></i>Unavailable</span><span><i style="background:#2563eb"></i>Selected</span></div>
              <div class="wa-time-area">
                <div class="wa-time-heading"><strong>Available start times</strong><span id="waTimeDateLabel">Choose a date first</span></div>
                <input type="hidden" id="waTimeSlot" value="">
                <div class="wa-time-slots" id="waTimeSlots" role="group" aria-label="Available installation start times"><div class="wa-time-empty"><i class="bi bi-clock me-1"></i>Choose an available date from the calendar.</div></div>
                <div class="wa-schedule-summary wa-hidden" id="waScheduleSummary" aria-live="polite"></div>
              </div>
            </div>
          </div>
        </section>
        <section class="wa-section wa-hidden" id="waPickupSection"><label class="wa-label" for="waPickupDate">Pickup date</label><input class="wa-field" id="waPickupDate" type="date"></section>
        <section class="wa-section wa-hidden" id="waSerialSection"><label class="wa-label" for="waSerials">Serial numbers (one per unit)</label><textarea class="wa-field" id="waSerials" rows="3" placeholder="One serial number per line"></textarea><p class="wa-help">Required because the units are handed over immediately.</p></section>
        <section class="wa-section">
          <h4 class="wa-section-title"><i class="bi bi-credit-card"></i>Payment</h4>
          <div class="wa-fields">
            <div><label class="wa-label" for="waPayment">Method</label><select class="wa-field" id="waPayment"><option value="cash">Cash</option><option value="gcash">GCash</option><option value="maya">Maya</option><option value="card">Card</option></select></div>
            <div><label class="wa-label" for="waAmountPaid">Amount paid</label><input class="wa-field" id="waAmountPaid" type="number" min="0" step="0.01"></div>
            <div><label class="wa-label" for="waDiscount">Discount</label><input class="wa-field" id="waDiscount" type="number" min="0" step="0.01" value="0"></div>
            <div id="waReferenceWrap" class="wa-hidden"><label class="wa-label" for="waReference">Payment reference</label><input class="wa-field" id="waReference" maxlength="160"></div>
          </div>
        </section>
        <div class="wa-summary">
          <div class="wa-sum-row"><span>Products</span><strong id="waSubtotal">₱0.00</strong></div>
          <div class="wa-sum-row"><span>Installation</span><strong id="waInstallFee">₱0.00</strong></div>
          <div class="wa-sum-row"><span>Transportation</span><strong id="waTransportFee">₱0.00</strong></div>
          <div class="wa-sum-row"><span>Discount</span><strong id="waDiscountView">−₱0.00</strong></div>
          <div class="wa-sum-row wa-sum-total"><span>Total</span><strong id="waTotal">₱0.00</strong></div>
        </div>
        <button class="wa-submit mt-3" id="waSubmit" type="submit" disabled><i class="bi bi-check2-circle me-1"></i>Create paid order</button>
      </form>
    </aside>
  </div>
  <div class="wa-drawer-backdrop" id="waCartBackdrop" aria-hidden="true"></div>

  <div class="wa-modal-backdrop" id="waVariantBackdrop" aria-hidden="true">
    <section class="wa-variant-modal" role="dialog" aria-modal="true" aria-labelledby="waVariantTitle">
      <header class="wa-variant-head"><h3 id="waVariantTitle">Select capacity</h3><button type="button" class="wa-drawer-close" id="waCloseVariant" aria-label="Close capacity selector"><i class="bi bi-x-lg"></i></button></header>
      <div id="waVariantContent"></div>
    </section>
  </div>

  <div class="wa-modal-backdrop" id="waReceiptBackdrop" aria-hidden="true">
    <section class="wa-receipt-modal" role="dialog" aria-modal="true" aria-labelledby="waReceiptTitle">
      <header class="wa-receipt-head"><h3 id="waReceiptTitle"><i class="bi bi-receipt me-2 text-primary"></i>Walk-in order receipt</h3><button type="button" class="wa-drawer-close" id="waCloseReceipt" aria-label="Close receipt"><i class="bi bi-x-lg"></i></button></header>
      <div class="wa-receipt-body" id="waReceiptContent"></div>
      <footer class="wa-receipt-actions"><button type="button" id="waResendInvitation" class="d-none"><i class="bi bi-envelope-arrow-up me-1"></i>Resend activation</button><button type="button" class="primary" id="waPrintReceipt"><i class="bi bi-printer me-1"></i>Print receipt</button></footer>
    </section>
  </div>
</section>

<script>
(() => {
  const today = new Date();
  const state = {
    products: [], cart: [], fulfillment: "delivery_installation", quote: {},
    date: "", time: "", availableDates: new Map(), availableSlots: [],
    calendarMonth: new Date(today.getFullYear(), today.getMonth(), 1),
    scheduleRequest: 0, slotRequest: 0, loaded: false, checkoutId: "",
    map: null, deliveryMarker: null, companyMarker: null, routeLayer: null,
    company: null, companyPromise: null, quoteRequest: 0, reverseRequest: 0,
    lastReceipt: null, customerLookupEmail: "", customerAccountFound: false,
    customerIsNew: null, customerAccountState: "unchecked", customerProfileRequired: false,
    customerLookupRequest: 0,
  };
  const $ = (id) => document.getElementById(id);
  const money = (value) => `₱${Number(value || 0).toLocaleString("en-PH", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const esc = (value) => String(value ?? "").replace(/[&<>'"]/g, ch => ({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"})[ch]);
  const uuid = () => window.crypto?.randomUUID?.().replace(/-/g, "") || `${Date.now()}${Math.random().toString(36).slice(2)}`;
  const dateKey = (date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
  const localDate = (value) => { const [year, month, day] = String(value || "").slice(0, 10).split("-").map(Number); return new Date(year, month - 1, day); };
  const monthKey = (date) => date.getFullYear() * 12 + date.getMonth();
  const readableDate = (value) => localDate(value).toLocaleDateString("en-PH", { weekday: "short", month: "long", day: "numeric", year: "numeric" });
  state.checkoutId = uuid();

  function toast(message, type = "info") {
    if (window.Swal) return Swal.fire({ icon: type === "danger" ? "error" : type, title: type === "success" ? "Order created" : "Walk-in aircon order", text: message, confirmButtonColor: "#2563eb" });
    window.alert(message);
  }

  function openCart() {
    $("waCartDrawer").classList.add("show");
    $("waCartDrawer").setAttribute("aria-hidden", "false");
    $("waCartBackdrop").classList.add("show");
    document.body.style.overflow = "hidden";
    $("waCloseCart").focus();
    if (state.fulfillment === "delivery_installation") ensureDeliveryMap();
  }

  function closeCart() {
    $("waCartDrawer").classList.remove("show");
    $("waCartDrawer").setAttribute("aria-hidden", "true");
    $("waCartBackdrop").classList.remove("show");
    if (!$("waVariantBackdrop").classList.contains("show")) document.body.style.overflow = "";
    $("waOpenCart").focus();
  }

  document.querySelectorAll("[data-walkin-mode]").forEach(button => button.addEventListener("click", () => {
    const aircon = button.dataset.walkinMode === "aircon";
    document.querySelectorAll("[data-walkin-mode]").forEach(tab => { tab.classList.toggle("active", tab === button); tab.setAttribute("aria-selected", String(tab === button)); });
    $("walkinServicesPane").classList.toggle("d-none", aircon);
    $("walkinAirconPane").classList.toggle("d-none", !aircon);
    if (aircon && !state.loaded) initialize();
  }));

  async function jsonFetch(url, options) {
    const response = await fetch(url, options);
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || "Request failed");
    return data;
  }

  function setCustomerLookupStatus(message, type = "info", loading = false) {
    const status = $("waCustomerLookupStatus");
    status.className = `wa-account-status${type === "info" ? "" : ` ${type}`}`;
    status.innerHTML = `${loading ? '<span class="spinner-border spinner-border-sm"></span>' : `<i class="bi ${type === "success" ? "bi-check-circle-fill" : type === "danger" ? "bi-exclamation-octagon-fill" : type === "warning" ? "bi-exclamation-triangle-fill" : "bi-info-circle"}"></i>`}<span>${esc(message)}</span>`;
  }

  function applyCustomerAccountMode() {
    const resolved = Boolean(state.customerLookupEmail) && state.customerIsNew !== null;
    const showProfile = resolved && (state.customerIsNew || state.customerProfileRequired);
    $("waExistingCustomer").classList.toggle("wa-hidden", !state.customerAccountFound);
    $("waNewCustomerHeading").classList.toggle("wa-hidden", !resolved || !state.customerIsNew);
    $("waCustomerNameWrap").classList.toggle("wa-hidden", !showProfile);
    $("waCustomerPhoneWrap").classList.toggle("wa-hidden", !showProfile);
    $("waAccountConsentWrap").classList.toggle("wa-hidden", !resolved);
    $("waAccountConsentTitle").textContent = state.customerIsNew
      ? "Customer consent to create online account access"
      : "Customer consent to link this order";
    $("waAccountConsentText").textContent = state.customerIsNew
      ? "I confirm the customer authorized CALIDRO RACS to create an invited account for this email and link this order."
      : "I confirm the customer requested this order and authorized it to be linked to the existing account.";
    $("waAccountConsentHelp").textContent = state.customerIsNew
      ? "A single-use activation link will be sent. The customer chooses their own password."
      : "Order and account messages will be sent to the customer's registered email.";
  }

  function resetCustomerAccountMatch({ clearProfile = true } = {}) {
    state.customerLookupRequest += 1;
    state.customerLookupEmail = "";
    state.customerAccountFound = false;
    state.customerIsNew = null;
    state.customerAccountState = "unchecked";
    state.customerProfileRequired = false;
    $("waFindCustomer").disabled = false;
    $("waAccountConsent").checked = false;
    if (clearProfile) {
      $("waCustomerName").value = "";
      $("waCustomerPhone").value = "";
    }
    $("waExistingCustomerName").textContent = "Existing customer";
    $("waExistingCustomerMeta").textContent = "";
    applyCustomerAccountMode();
    setCustomerLookupStatus("No account selected. Search by email before checkout.");
  }

  async function findOrderCustomer() {
    const email = $("waCustomerEmail").value.trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setCustomerLookupStatus("Enter a valid customer email before searching.", "danger");
      return false;
    }
    if (state.customerLookupEmail === email && state.customerIsNew !== null) return true;

    resetCustomerAccountMatch();
    $("waCustomerEmail").value = email;
    const requestId = ++state.customerLookupRequest;
    const button = $("waFindCustomer");
    button.disabled = true;
    setCustomerLookupStatus("Checking the customer database…", "info", true);
    try {
      const response = await fetch(`/api/users?email=${encodeURIComponent(email)}`, {
        credentials: "same-origin",
        cache: "no-store",
        headers: { Accept: "application/json" },
      });
      const result = await response.json().catch(() => ({}));
      if (requestId !== state.customerLookupRequest) return false;
      if (!response.ok) throw new Error(result.error || "Customer lookup failed.");

      if (!result.user && result.emailAvailable === false) {
        setCustomerLookupStatus("This email belongs to a staff account and cannot be used for a customer order.", "danger");
        return false;
      }
      if (result.user && result.accountState === "unavailable") {
        setCustomerLookupStatus("This customer account is disabled or blocked. Resolve its status before checkout.", "danger");
        return false;
      }

      if (result.user) {
        const customer = result.user;
        const fullName = `${customer.firstName || ""} ${customer.lastName || ""}`.trim();
        $("waCustomerName").value = fullName;
        $("waCustomerPhone").value = customer.phone || "";
        state.customerLookupEmail = email;
        state.customerAccountFound = true;
        state.customerIsNew = false;
        state.customerAccountState = result.accountState || "active";
        state.customerProfileRequired = fullName.length < 2 || String(customer.phone || "").replace(/\D/g, "").length < 7;
        $("waExistingCustomerName").textContent = fullName || customer.email;
        $("waExistingCustomerMeta").textContent = `${customer.phone || "No phone on file"} · ${state.customerAccountState === "active" ? "Verified account" : state.customerAccountState === "invited" ? "Activation still required" : "Email verification pending"}`;
        applyCustomerAccountMode();
        setCustomerLookupStatus(
          state.customerProfileRequired
            ? "Existing customer found, but required contact details are incomplete. Complete them before checkout."
            : "Existing customer found. This order will be linked after consent is confirmed.",
          state.customerProfileRequired ? "warning" : "success",
        );
      } else {
        state.customerLookupEmail = email;
        state.customerAccountFound = false;
        state.customerIsNew = true;
        state.customerAccountState = "invited";
        state.customerProfileRequired = true;
        applyCustomerAccountMode();
        setCustomerLookupStatus("No customer account found. Complete the profile and capture consent to send a secure activation invitation.", "warning");
      }
      return true;
    } catch (error) {
      if (requestId === state.customerLookupRequest) {
        setCustomerLookupStatus(error.message || "Customer lookup failed. Please try again.", "danger");
      }
      return false;
    } finally {
      if (requestId === state.customerLookupRequest) button.disabled = false;
    }
  }

  function loadCompanyLocation() {
    if (!state.companyPromise) {
      state.companyPromise = jsonFetch("/api/public/company/location")
        .then(location => {
          const lat = Number(location?.lat), lng = Number(location?.lng);
          state.company = Number.isFinite(lat) && Number.isFinite(lng)
            ? { lat, lng, address: String(location.address || "CALIDRO RACS") }
            : { lat: 14.676049, lng: 121.043731, address: "CALIDRO RACS" };
          return state.company;
        })
        .catch(() => {
          state.company = { lat: 14.676049, lng: 121.043731, address: "CALIDRO RACS" };
          return state.company;
        });
    }
    return state.companyPromise;
  }

  function setMapLoading(loading, message = "Calculating route…") {
    $("waMapSpinnerText").textContent = message;
    $("waMapSpinner").classList.toggle("show", loading);
  }

  function updateMapSelection(lat, lng, address, source) {
    $("waMapSelection").classList.add("has-location");
    $("waMapStatus").textContent = "Installation pin confirmed";
    $("waMapAddress").textContent = address || "Resolving the selected street address…";
    $("waMapCoordinates").textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
    $("waMapSource").textContent = source || "Map selection";
    $("waFitRoute").disabled = false;
  }

  function clearRouteLayer() {
    if (state.map && state.routeLayer) state.map.removeLayer(state.routeLayer);
    state.routeLayer = null;
  }

  function resetDeliveryPoint() {
    state.quoteRequest += 1;
    state.reverseRequest += 1;
    state.quote = {};
    clearRouteLayer();
    state.deliveryMarker?.setOpacity(0);
    $("waMapSelection").classList.remove("has-location");
    $("waMapStatus").textContent = "Location not pinned";
    $("waMapAddress").textContent = "Choose a search result or select the exact point on the map.";
    $("waMapCoordinates").textContent = "Not selected";
    $("waMapSource").textContent = "Waiting for location";
    $("waFitRoute").disabled = true;
    setMapLoading(false);
  }

  function drawAuthoritativeRoute(geometry) {
    clearRouteLayer();
    if (!state.map || !geometry || !window.L) return;
    state.routeLayer = L.geoJSON(geometry, { style: { color: "#6366f1", weight: 5, opacity: .86 } }).addTo(state.map);
    const bounds = state.routeLayer.getBounds();
    if (bounds.isValid()) state.map.fitBounds(bounds, { padding: [34, 34] });
  }

  async function refreshDeliveryQuote(lat, lng) {
    const requestId = ++state.quoteRequest;
    state.quote = {};
    renderTotals();
    setMapLoading(true);
    $("waQuote").innerHTML = '<div class="wa-quote"><span>Calculating verified road route…</span><span class="spinner-border spinner-border-sm"></span></div>';
    try {
      const quote = await jsonFetch("/api/walk-in-aircon/quote", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ fulfillmentType: "delivery_installation", coordinates: { lat, lng } }),
      });
      if (requestId !== state.quoteRequest) return;
      state.quote = quote;
      $("waQuote").innerHTML = `<div class="wa-quote"><span>${Number(quote.distanceKm || 0).toFixed(1)} km · about ${Number(quote.durationMin || 0)} min · ${quote.source === "road" ? "road route" : "estimated route"}</span><strong>${money(quote.additionalTotal)}</strong></div>`;
      drawAuthoritativeRoute(quote.geometry);
      renderTotals();
      scheduleInputsChanged();
    } catch (error) {
      if (requestId !== state.quoteRequest) return;
      state.quote = {};
      clearRouteLayer();
      $("waQuote").innerHTML = `<div class="wa-quote text-danger"><span>${esc(error.message)}</span><strong>Route unavailable</strong></div>`;
      renderTotals();
    } finally {
      if (requestId === state.quoteRequest) setMapLoading(false);
    }
  }

  async function reverseDeliveryPoint(lat, lng, requestId) {
    try {
      const result = await jsonFetch(`/api/geocoding/reverse?lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lng)}`);
      if (requestId !== state.reverseRequest) return;
      const address = String(result.display_name || `${lat.toFixed(6)}, ${lng.toFixed(6)}`);
      $("waAddress").value = address;
      $("waMapAddress").textContent = address;
      state.deliveryMarker?.setPopupContent(`<strong>Installation point</strong><br>${esc(address)}`);
    } catch (_) {
      if (requestId !== state.reverseRequest) return;
      const fallback = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
      $("waAddress").value = fallback;
      $("waMapAddress").textContent = fallback;
    }
  }

  function setDeliveryPoint(rawLat, rawLng, options = {}) {
    const lat = Number(rawLat), lng = Number(rawLng);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
    const reverseRequestId = ++state.reverseRequest;
    const address = String(options.address || "");
    $("waLat").value = lat.toFixed(7);
    $("waLng").value = lng.toFixed(7);
    if (address) $("waAddress").value = address;
    updateMapSelection(lat, lng, address, options.source);
    clearRouteLayer();
    if (state.deliveryMarker) {
      state.deliveryMarker.setLatLng([lat, lng]).setOpacity(1);
      state.deliveryMarker.setPopupContent(`<strong>Installation point</strong><br>${esc(address || `${lat.toFixed(6)}, ${lng.toFixed(6)}`)}`);
    }
    if (state.map && options.focus !== false) state.map.flyTo([lat, lng], Number(options.zoom) || 16, { duration: .55 });

    // Availability is intentionally started before routing finishes. A routing-provider
    // delay must never leave the technician calendar in an inert state.
    state.quote = {};
    renderTotals();
    scheduleInputsChanged();
    refreshDeliveryQuote(lat, lng);
    if (options.reverse) reverseDeliveryPoint(lat, lng, reverseRequestId);
  }

  function ensureDeliveryMap() {
    if (!window.L) {
      $("waMapAddress").textContent = "The map library did not load. Address search and scheduling are still available.";
      return;
    }
    if (state.map) {
      setTimeout(() => state.map?.invalidateSize(), 120);
      return;
    }
    const fallback = { lat: 14.676049, lng: 121.043731 };
    state.map = L.map("waMap", { zoomControl: false, scrollWheelZoom: false, preferCanvas: true }).setView([fallback.lat, fallback.lng], 13);
    const streets = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { attribution: "&copy; OpenStreetMap contributors", maxZoom: 19 }).addTo(state.map);
    const satellite = L.layerGroup([
      L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", { attribution: "Tiles &copy; Esri", maxZoom: 19 }),
      L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}", { attribution: "Labels &copy; Esri", maxZoom: 19 }),
    ]);
    L.control.zoom({ position: "bottomright" }).addTo(state.map);
    L.control.scale({ position: "bottomleft", imperial: false, maxWidth: 100 }).addTo(state.map);
    L.control.layers({ "Detailed streets": streets, "Satellite + labels": satellite }, null, { position: "topright", collapsed: true }).addTo(state.map);

    const deliveryIcon = L.divIcon({ className: "wa-delivery-marker", iconSize: [40, 40], iconAnchor: [20, 40], popupAnchor: [0, -38], html: '<div style="width:34px;height:34px;border:3px solid #fff;border-radius:50% 50% 50% 0;background:#ef4444;transform:rotate(-45deg);box-shadow:0 3px 9px rgba(15,23,42,.35)"><span style="position:absolute;left:50%;top:50%;width:10px;height:10px;border-radius:50%;background:#fff;transform:translate(-50%,-50%)"></span></div>' });
    state.deliveryMarker = L.marker([fallback.lat, fallback.lng], { icon: deliveryIcon, draggable: true, keyboard: true, title: "Installation point" }).addTo(state.map).setOpacity(0);
    state.deliveryMarker.on("dragend", () => {
      const point = state.deliveryMarker.getLatLng();
      setDeliveryPoint(point.lat, point.lng, { reverse: true, focus: false, source: "Dragged installation pin" });
    });
    state.map.on("click", event => setDeliveryPoint(event.latlng.lat, event.latlng.lng, { reverse: true, focus: false, source: "Point selected on map" }));

    loadCompanyLocation().then(company => {
      if (!state.map) return;
      const companyIcon = L.divIcon({ className: "wa-company-marker", iconSize: [36, 36], iconAnchor: [18, 36], popupAnchor: [0, -34], html: '<div style="width:30px;height:30px;border:3px solid #fff;border-radius:50% 50% 50% 0;background:#2563eb;transform:rotate(-45deg);box-shadow:0 3px 9px rgba(15,23,42,.3)"><i class="bi bi-building text-white" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(45deg);font-size:.72rem"></i></div>' });
      state.companyMarker = L.marker([company.lat, company.lng], { icon: companyIcon, title: "CALIDRO RACS", zIndexOffset: -100 }).addTo(state.map).bindPopup(`<strong>CALIDRO RACS</strong><br>${esc(company.address)}`);
      if (!$("waLat").value) state.map.setView([company.lat, company.lng], 14);
    });

    const savedLat = Number($("waLat").value), savedLng = Number($("waLng").value);
    if (Number.isFinite(savedLat) && Number.isFinite(savedLng) && $("waLat").value) {
      state.deliveryMarker.setLatLng([savedLat, savedLng]).setOpacity(1);
      updateMapSelection(savedLat, savedLng, $("waAddress").value, "Saved checkout location");
    }
    setTimeout(() => state.map?.invalidateSize(), 180);
  }

  function fitDeliveryRoute() {
    if (!state.map) return;
    if (state.routeLayer?.getBounds?.().isValid()) return state.map.fitBounds(state.routeLayer.getBounds(), { padding: [34, 34] });
    const lat = Number($("waLat").value), lng = Number($("waLng").value);
    loadCompanyLocation().then(company => {
      if (Number.isFinite(lat) && Number.isFinite(lng) && $("waLat").value) state.map.fitBounds([[company.lat, company.lng], [lat, lng]], { padding: [34, 34] });
      else state.map.setView([company.lat, company.lng], 14);
    });
  }

  function locateDeliveryPoint() {
    ensureDeliveryMap();
    if (!navigator.geolocation) return toast("This browser does not support location detection.", "danger");
    setMapLoading(true, "Locating this device…");
    navigator.geolocation.getCurrentPosition(position => {
      setMapLoading(false);
      setDeliveryPoint(position.coords.latitude, position.coords.longitude, { reverse: true, zoom: 17, source: position.coords.accuracy ? `Device GPS · ±${Math.round(position.coords.accuracy)} m` : "Device GPS" });
    }, error => {
      setMapLoading(false);
      toast(error?.code === 1 ? "Location permission was denied. Search the address or click the map instead." : "The device location could not be detected. Search the address or click the map instead.", "danger");
    }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 30000 });
  }

  async function initialize() {
    state.loaded = true;
    try {
      const [products, options] = await Promise.all([
        jsonFetch("/api/walk-in-aircon/products"),
        jsonFetch("/api/appointments/walk-in-options"),
      ]);
      state.products = products.items || [];
      const types = [...new Set(state.products.map(item => item.type).filter(Boolean))].sort();
      $("waTypeFilter").innerHTML = '<option value="">All aircon types</option>' + types.map(type => `<option value="${esc(type)}">${esc(type)}</option>`).join("");
      $("waTechnician").innerHTML = '<option value="">Choose technician</option>' + (options.technicians || []).map(tech => `<option value="${esc(tech._id)}">${esc(tech.name)}${tech.email ? ` · ${esc(tech.email)}` : ""}</option>`).join("");
      renderProducts();
    } catch (error) {
      $("waProducts").innerHTML = `<div class="wa-empty"><i class="bi bi-exclamation-circle"></i><p>${esc(error.message)}</p><button type="button" class="btn btn-sm btn-outline-primary" id="waRetry">Retry</button></div>`;
      $("waRetry")?.addEventListener("click", () => { state.loaded = false; initialize(); });
    }
  }

  function productGroups() {
    const q = $("waSearch").value.trim().toLowerCase();
    const type = $("waTypeFilter").value;
    const filtered = state.products.filter(item => (!type || item.type === type) && (!q || [item.brand,item.modelLine,item.itemName,item.barcode,item.sku,item.capacity].join(" ").toLowerCase().includes(q)));
    return [...filtered.reduce((map, item) => { const key = item.parentHvacId; if (!map.has(key)) map.set(key, []); map.get(key).push(item); return map; }, new Map()).entries()];
  }

  function renderProducts() {
    const groups = productGroups();
    if (!groups.length) { $("waProducts").innerHTML = '<div class="wa-empty"><i class="bi bi-snow"></i><p>No available aircons match this search.</p></div>'; return; }
    $("waProducts").innerHTML = groups.map(([id, variants]) => {
      const first = variants[0];
      const startingPrice = Math.min(...variants.map(item => Number(item.sellingPrice || 0)));
      const totalStock = variants.reduce((sum, item) => sum + Number(item.available || 0), 0);
      const typeLabel = String(first.type || "Aircon").replace(/_/g, " ").replace(/\b\w/g, char => char.toUpperCase());
      const capacityLabel = variants.length === 1 ? `${first.capacity} ${first.capacityUnit}` : `${variants.length} capacity options`;
      return `<article class="wa-product" data-product="${esc(id)}"><div class="wa-product-image">${first.imageUrl ? `<img src="${esc(first.imageUrl)}" alt="${esc(first.brand)} ${esc(first.modelLine)}" loading="lazy" onerror="this.src='/images/products/default.png'">` : '<i class="bi bi-snow2"></i>'}${first.inverter ? '<span class="wa-product-tag inverter">Inverter</span>' : ""}<span class="wa-product-tag stock">${totalStock} in stock</span></div><div class="wa-product-body"><span class="wa-brand">${esc(first.brand || "Air conditioner")}</span><h3>${esc(first.modelLine)}</h3><div class="wa-product-meta"><span>${esc(typeLabel)}</span><span class="wa-product-dot">•</span><span>${esc(capacityLabel)}</span></div><div class="wa-price-row"><div class="wa-price">${variants.length > 1 ? "<small>From</small>" : ""}${money(startingPrice)}</div><button type="button" class="wa-add" data-select-product="${esc(id)}">Select unit <i class="bi bi-arrow-right"></i></button></div></div></article>`;
    }).join("");
    $("waProducts").querySelectorAll("[data-select-product]").forEach(button => button.addEventListener("click", () => openVariantPicker(button.dataset.selectProduct)));
  }

  function openVariantPicker(productId) {
    const variants = state.products.filter(item => String(item.parentHvacId) === String(productId));
    if (!variants.length) return;
    const first = variants[0];
    $("waVariantTitle").textContent = `Select ${first.modelLine} capacity`;
    $("waVariantContent").innerHTML = `<div class="wa-variant-product">${first.imageUrl ? `<img src="${esc(first.imageUrl)}" alt="${esc(first.modelLine)}" onerror="this.src='/images/products/default.png'">` : '<div class="placeholder"><i class="bi bi-snow2"></i></div>'}<div><span class="wa-brand">${esc(first.brand || "Air conditioner")}</span><strong>${esc(first.modelLine)}</strong><span>${esc(String(first.type || "Aircon").replace(/_/g, " "))}${first.inverter ? " · Inverter" : ""}</span></div></div><div class="wa-variant-list">${variants.map(item => `<button type="button" class="wa-variant-option" data-add-variant="${esc(item._id)}"><span class="wa-variant-capacity"><strong>${esc(item.capacity)} ${esc(item.capacityUnit)}</strong><span>${item.btu ? `${Number(item.btu).toLocaleString("en-PH")} BTU · ` : ""}${item.available} unit${item.available === 1 ? "" : "s"} available</span></span><span class="wa-variant-price">${money(item.sellingPrice)}</span><span class="wa-add"><i class="bi bi-cart-plus"></i>Add</span></button>`).join("")}</div>`;
    $("waVariantContent").querySelectorAll("[data-add-variant]").forEach(button => button.addEventListener("click", () => {
      addToCart(button.dataset.addVariant);
      closeVariantPicker();
      openCart();
    }));
    $("waVariantBackdrop").classList.add("show");
    $("waVariantBackdrop").setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    $("waCloseVariant").focus();
  }

  function closeVariantPicker() {
    $("waVariantBackdrop").classList.remove("show");
    $("waVariantBackdrop").setAttribute("aria-hidden", "true");
    if (!$("waCartDrawer").classList.contains("show")) document.body.style.overflow = "";
  }

  function addToCart(id) {
    const item = state.products.find(row => row._id === id); if (!item) return;
    const existing = state.cart.find(row => row._id === id);
    if (existing) { if (existing.quantity >= item.available) return toast("No more stock is available for this capacity.", "danger"); existing.quantity++; }
    else state.cart.push({ ...item, quantity: 1 });
    scheduleInputsChanged(); renderCart();
    $("waOpenCart").classList.remove("bump");
    requestAnimationFrame(() => $("waOpenCart").classList.add("bump"));
  }

  function changeQuantity(id, delta) {
    const row = state.cart.find(item => item._id === id); if (!row) return;
    row.quantity = Math.min(row.available, row.quantity + delta);
    if (row.quantity <= 0) state.cart = state.cart.filter(item => item._id !== id);
    scheduleInputsChanged(); renderCart();
  }

  function totals() {
    const subtotal = state.cart.reduce((sum, item) => sum + item.sellingPrice * item.quantity, 0);
    const discount = Math.max(0, Number($("waDiscount").value) || 0);
    const delivery = state.fulfillment === "delivery_installation";
    const installation = delivery ? Number(state.quote.installationFee || 0) : 0;
    const transport = delivery ? Number(state.quote.transportationFee || 0) : 0;
    return { subtotal, discount, installation, transport, total: Math.max(0, subtotal - discount + installation + transport) };
  }

  function renderCart() {
    const units = state.cart.reduce((sum, item) => sum + item.quantity, 0); $("waCartCount").textContent = units; $("waHeroCartCount").textContent = units;
    $("waCart").innerHTML = state.cart.length ? state.cart.map(item => `<div class="wa-cart-item"><div><div class="wa-cart-name">${esc(item.brand)} ${esc(item.modelLine)}</div><div class="wa-cart-meta">${esc(item.capacity)} ${esc(item.capacityUnit)} · ${money(item.sellingPrice)}</div><div class="wa-cart-controls mt-1"><button type="button" data-id="${esc(item._id)}" data-delta="-1">−</button><span>${item.quantity}</span><button type="button" data-id="${esc(item._id)}" data-delta="1">+</button></div></div><div class="wa-cart-total">${money(item.sellingPrice * item.quantity)}</div></div>`).join("") : '<div class="wa-empty" style="padding:1.5rem .5rem"><i class="bi bi-cart"></i><p class="mb-0">Select an aircon to begin.</p></div>';
    $("waCart").querySelectorAll("[data-delta]").forEach(button => button.addEventListener("click", () => changeQuantity(button.dataset.id, Number(button.dataset.delta))));
    renderTotals();
  }

  function renderTotals() {
    const t = totals(); $("waSubtotal").textContent = money(t.subtotal); $("waInstallFee").textContent = money(t.installation); $("waTransportFee").textContent = money(t.transport); $("waDiscountView").textContent = `−${money(t.discount)}`; $("waTotal").textContent = money(t.total); $("waSubmit").disabled = !state.cart.length;
    if ($("waPayment").value !== "cash") $("waAmountPaid").value = t.total.toFixed(2);
  }

  function syncPaymentMode() {
    const electronic = $("waPayment").value !== "cash";
    $("waReferenceWrap").classList.toggle("wa-hidden", !electronic);
    $("waAmountPaid").readOnly = electronic;
    if (electronic) $("waAmountPaid").value = totals().total.toFixed(2);
  }

  function setFulfillment(value) {
    state.fulfillment = value; state.date = "";
    document.querySelectorAll("#waFulfillmentChoices button").forEach(button => { const active = button.dataset.value === value; button.classList.toggle("active", active); button.setAttribute("aria-pressed", String(active)); });
    $("waDeliverySection").classList.toggle("wa-hidden", value !== "delivery_installation"); $("waPickupSection").classList.toggle("wa-hidden", value !== "customer_pickup"); $("waSerialSection").classList.toggle("wa-hidden", value !== "carry_out"); renderTotals(); scheduleInputsChanged();
    if (value === "delivery_installation") ensureDeliveryMap();
  }

  function setCalendarStatus(message, type = "info", loading = false) {
    const icon = loading ? '<span class="spinner-border spinner-border-sm"></span>' : `<i class="bi ${type === "error" ? "bi-exclamation-circle" : "bi-info-circle"}"></i>`;
    $("waCalendarState").className = `wa-calendar-state${type === "error" ? " error" : ""}`;
    $("waCalendarState").innerHTML = `${icon}<span>${esc(message)}</span>`;
  }

  function resetTimeSlots(message = "Choose an available date from the calendar.") {
    state.time = "";
    state.availableSlots = [];
    $("waTimeSlot").value = "";
    $("waTimeDateLabel").textContent = state.date ? readableDate(state.date) : "Choose a date first";
    $("waTimeSlots").innerHTML = `<div class="wa-time-empty"><i class="bi bi-clock me-1"></i>${esc(message)}</div>`;
    $("waScheduleSummary").classList.add("wa-hidden");
    $("waScheduleSummary").innerHTML = "";
  }

  function renderAvailabilityCalendar() {
    const month = state.calendarMonth;
    $("waCalendarTitle").textContent = month.toLocaleDateString("en-PH", { month: "long", year: "numeric" });
    const firstWeekday = new Date(month.getFullYear(), month.getMonth(), 1).getDay();
    const daysInMonth = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
    const todayValue = dateKey(new Date());
    const cells = Array.from({ length: firstWeekday }, () => '<span class="wa-cal-blank" aria-hidden="true"></span>');
    for (let day = 1; day <= daysInMonth; day++) {
      const value = dateKey(new Date(month.getFullYear(), month.getMonth(), day));
      const availability = state.availableDates.get(value);
      const open = Number(availability?.availableSlots || 0) > 0;
      const selected = state.date === value;
      const past = value <= todayValue;
      const slotText = open ? `${availability.availableSlots} ${Number(availability.availableSlots) === 1 ? "slot" : "slots"}` : "";
      const aria = `${readableDate(value)}. ${open ? slotText + " available" : "Unavailable"}${selected ? ". Selected" : ""}`;
      cells.push(`<button type="button" class="wa-date ${open ? "available" : "unavailable"}${selected ? " active" : ""}${value === todayValue ? " today" : ""}" data-date="${value}" aria-label="${esc(aria)}" aria-pressed="${selected}" ${!open || past ? "disabled" : ""}><strong>${day}</strong>${open ? `<small>${esc(slotText)}</small>` : ""}</button>`);
    }
    $("waCalendar").innerHTML = cells.join("");
    $("waCalendar").querySelectorAll(".wa-date.available").forEach(button => button.addEventListener("click", () => selectDate(button.dataset.date)));

    const keys = [...state.availableDates.keys()].sort();
    const minMonth = keys.length ? monthKey(localDate(keys[0])) : monthKey(new Date(today.getFullYear(), today.getMonth(), 1));
    const maxMonth = keys.length ? monthKey(localDate(keys[keys.length - 1])) : minMonth;
    $("waCalendarPrev").disabled = monthKey(month) <= minMonth;
    $("waCalendarNext").disabled = monthKey(month) >= maxMonth;
  }

  function moveCalendarMonth(delta) {
    const candidate = new Date(state.calendarMonth.getFullYear(), state.calendarMonth.getMonth() + delta, 1);
    state.calendarMonth = candidate;
    renderAvailabilityCalendar();
  }

  function scheduleInputsChanged() {
    state.scheduleRequest += 1;
    state.slotRequest += 1;
    state.date = "";
    state.availableDates.clear();
    resetTimeSlots();
    renderAvailabilityCalendar();
    if (state.fulfillment !== "delivery_installation") return;
    if (!state.cart.length) return setCalendarStatus("Add an aircon before checking installation availability.");
    if (!$("waLat").value) return setCalendarStatus("Search and select a verified installation address.");
    if (!$("waTechnician").value) return setCalendarStatus("Choose a technician to view their available schedule.");
    loadDates();
  }

  async function searchAddress() {
    const query = $("waAddress").value.trim();
    if (query.length < 5) return $("waAddressResults").classList.add("wa-hidden");
    try {
      const rows = await jsonFetch(`/api/geocoding/search?q=${encodeURIComponent(query)}&limit=5`);
      $("waAddressResults").innerHTML = rows.length ? rows.map((row, index) => `<button type="button" data-index="${index}">${esc(row.display_name)}</button>`).join("") : '<p class="wa-help p-2">No matching address found.</p>';
      $("waAddressResults").classList.remove("wa-hidden");
      $("waAddressResults").querySelectorAll("button").forEach(button => button.addEventListener("click", () => selectAddress(rows[Number(button.dataset.index)])));
    } catch (error) { $("waAddressResults").innerHTML = `<p class="wa-help p-2 text-danger">${esc(error.message)}</p>`; $("waAddressResults").classList.remove("wa-hidden"); }
  }

  async function selectAddress(row) {
    $("waAddressResults").classList.add("wa-hidden");
    ensureDeliveryMap();
    setDeliveryPoint(row.lat, row.lon, { address: row.display_name || "", source: "Verified address search", zoom: 16 });
  }

  async function loadDates() {
    const technicianId = $("waTechnician").value; if (!technicianId || !state.cart.length || !$("waLat").value) return;
    const requestId = ++state.scheduleRequest;
    setCalendarStatus("Checking the technician's latest schedule…", "info", true);
    try {
      const params = new URLSearchParams({ duration:"60", quantity:String(state.cart.reduce((sum,item)=>sum+item.quantity,0)), travelTime:String(Number(state.quote.durationMin || 0)), technicianId, mode:"all" });
      const data = await jsonFetch(`/api/schedule/available-dates?${params}`);
      if (requestId !== state.scheduleRequest) return;
      if (data.blocked) {
        state.availableDates.clear();
        renderAvailabilityCalendar();
        return setCalendarStatus(data.message || "This order cannot fit within one technician workday.", "error");
      }
      state.availableDates = new Map((data.availableDates || []).map(row => [String(row.date).slice(0, 10), row]));
      const openDates = [...state.availableDates.entries()].filter(([, row]) => Number(row.availableSlots || 0) > 0).map(([key]) => key).sort();
      if (openDates.length && !openDates.some(key => monthKey(localDate(key)) === monthKey(state.calendarMonth))) {
        const first = localDate(openDates[0]);
        state.calendarMonth = new Date(first.getFullYear(), first.getMonth(), 1);
      }
      renderAvailabilityCalendar();
      if (openDates.length) setCalendarStatus(`${openDates.length} available day${openDates.length === 1 ? "" : "s"} found. Select a green date.`);
      else setCalendarStatus("No installation dates are available for this technician. Choose another technician.", "error");
    } catch (error) {
      if (requestId !== state.scheduleRequest) return;
      state.availableDates.clear();
      renderAvailabilityCalendar();
      setCalendarStatus(error.message || "Could not load technician availability.", "error");
    }
  }

  function renderTimeSlots(slots) {
    state.availableSlots = slots;
    if (!slots.length) {
      $("waTimeSlots").innerHTML = '<div class="wa-time-empty text-danger"><i class="bi bi-calendar-x me-1"></i>No start times remain for this date. Choose another date.</div>';
      return;
    }
    let currentGroup = "";
    const html = [];
    slots.forEach(slot => {
      const timeValue = String(slot.startTime || "0");
      let hour = Number(timeValue.split(":")[0]);
      if (/PM$/i.test(timeValue) && hour < 12) hour += 12;
      if (/AM$/i.test(timeValue) && hour === 12) hour = 0;
      const group = hour < 12 ? "Morning" : (hour < 17 ? "Afternoon" : "Evening");
      if (group !== currentGroup) { html.push(`<div class="wa-time-group">${group}</div>`); currentGroup = group; }
      const label = slot.label || slot.startTime;
      html.push(`<button type="button" class="wa-time-slot" data-time="${esc(slot.startTime)}" data-label="${esc(label)}" aria-pressed="false">${esc(label)}</button>`);
    });
    $("waTimeSlots").innerHTML = html.join("");
    $("waTimeSlots").querySelectorAll(".wa-time-slot").forEach(button => button.addEventListener("click", () => {
      state.time = button.dataset.time;
      $("waTimeSlot").value = state.time;
      $("waTimeSlots").querySelectorAll(".wa-time-slot").forEach(row => { const active = row === button; row.classList.toggle("active", active); row.setAttribute("aria-pressed", String(active)); });
      const techName = $("waTechnician").selectedOptions[0]?.textContent?.split(" · ")[0] || "Selected technician";
      $("waScheduleSummary").innerHTML = `<i class="bi bi-check-circle-fill"></i><div><strong>Schedule selected</strong>${esc(readableDate(state.date))} at ${esc(button.dataset.label)} with ${esc(techName)}</div>`;
      $("waScheduleSummary").classList.remove("wa-hidden");
    }));
  }

  async function selectDate(date) {
    if (Number(state.availableDates.get(date)?.availableSlots || 0) <= 0) return;
    state.date = date;
    state.time = "";
    $("waTimeSlot").value = "";
    renderAvailabilityCalendar();
    resetTimeSlots("Loading the available start times…");
    $("waTimeDateLabel").textContent = readableDate(date);
    $("waTimeSlots").innerHTML = '<div class="wa-time-empty"><span class="spinner-border spinner-border-sm me-1"></span>Checking available start times…</div>';
    const requestId = ++state.slotRequest;
    try {
      const params = new URLSearchParams({ date, duration:"60", quantity:String(state.cart.reduce((sum,item)=>sum+item.quantity,0)), travelTime:String(Number(state.quote.durationMin || 0)), technicianId:$("waTechnician").value });
      const data = await jsonFetch(`/api/schedule/time-slots?${params}`); const slots = (data.timeSlots || []).filter(slot => slot.available === true);
      if (requestId !== state.slotRequest) return;
      if (!slots.length && data.message) {
        $("waTimeSlots").innerHTML = `<div class="wa-time-empty text-danger"><i class="bi bi-calendar-x me-1"></i>${esc(data.message)}</div>`;
        return;
      }
      renderTimeSlots(slots);
    } catch (error) {
      if (requestId !== state.slotRequest) return;
      $("waTimeSlots").innerHTML = `<div class="wa-time-empty text-danger"><i class="bi bi-exclamation-circle me-1"></i>${esc(error.message)}</div>`;
    }
  }

  function validate() {
    if (!state.cart.length) return "Add at least one aircon.";
    const customerEmail = $("waCustomerEmail").value.trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(customerEmail)) return "Enter a valid customer email.";
    if (state.customerLookupEmail !== customerEmail || state.customerIsNew === null) return "Find the customer account by email before checkout.";
    if ($("waCustomerName").value.trim().length < 2 || $("waCustomerPhone").value.replace(/\D/g,"").length < 7) return "Enter the customer's complete name and phone number.";
    if (!$("waAccountConsent").checked) return "Confirm the customer's consent to create or link their online account.";
    if (state.fulfillment === "delivery_installation" && (!$("waLat").value || !$("waTechnician").value || !state.date || !$("waTimeSlot").value)) return "Select a verified address, technician, available date, and time.";
    if (state.fulfillment === "customer_pickup" && !$("waPickupDate").value) return "Choose the customer pickup date.";
    const units = state.cart.reduce((sum,item)=>sum+item.quantity,0), serials = $("waSerials").value.split(/\r?\n|,/).map(v=>v.trim()).filter(Boolean);
    if (state.fulfillment === "carry_out" && serials.length !== units) return `Enter exactly ${units} serial number(s) for immediate handover.`;
    if (Number($("waDiscount").value || 0) > totals().subtotal) return "Discount cannot exceed the product subtotal.";
    if (Number($("waAmountPaid").value || 0) < totals().total) return `Collect the full total of ${money(totals().total)}.`;
    if ($("waPayment").value !== "cash" && $("waReference").value.trim().length < 4) return "Enter the electronic payment reference.";
    return "";
  }

  async function submit(event) {
    event.preventDefault(); const error = validate(); if (error) return toast(error, "danger");
    const button = $("waSubmit"); button.disabled = true; button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Validating stock and schedule…';
    const payload = { checkoutRequestId:state.checkoutId, accountConsent:$("waAccountConsent").checked, customer:{name:$("waCustomerName").value.trim(),email:$("waCustomerEmail").value.trim(),phone:$("waCustomerPhone").value.trim(),address:$("waAddress").value.trim()}, items:state.cart.map(item=>({toolId:item._id,quantity:item.quantity})), fulfillmentType:state.fulfillment, pickupDate:$("waPickupDate").value, technicianId:state.fulfillment === "delivery_installation" ? $("waTechnician").value : null, delivery:state.fulfillment === "delivery_installation" ? {address:$("waAddress").value.trim(),preferredDate:state.date,coordinates:{lat:$("waLat").value,lng:$("waLng").value}} : null, timeSlot:state.fulfillment === "delivery_installation" ? $("waTimeSlot").value : null, serialNumbers:$("waSerials").value.split(/\r?\n|,/).map(v=>v.trim()).filter(Boolean), paymentMethod:$("waPayment").value, paymentReference:$("waReference").value.trim(), amountPaid:Number($("waAmountPaid").value), discount:Number($("waDiscount").value || 0) };
    try {
      const result = await jsonFetch("/api/walk-in-aircon/checkout", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(payload) });
      showReceipt(result);
      state.cart = []; state.quote = {}; state.date = ""; state.checkoutId = uuid(); $("waCheckoutForm").reset(); resetCustomerAccountMatch({ clearProfile:false }); setFulfillment("delivery_installation"); renderCart(); await initializeAfterCheckout();
      closeCart();
    } catch (err) { toast(err.message || "Checkout failed.", "danger"); }
    finally { button.disabled = !state.cart.length; button.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Create paid order'; }
  }

  function accountResultText(account) {
    if (!account) return "The order was linked to the customer record.";
    if (account.state === "active") return account.invitationDelivery === "accepted" ? "Existing verified account reused. The order confirmation was accepted by the email provider." : "Existing verified account reused. The confirmation email could not be delivered; the order is still visible after sign-in.";
    if (account.state === "invited") return account.invitationDelivery === "accepted" ? "A secure activation email was accepted by the email provider. The customer must choose a password before tracking." : "The invited account and order were created, but the activation email failed. Use Resend activation below.";
    return "The order is linked to an existing registration that still requires email verification.";
  }

  function showReceipt(result) {
    const order = result.order || {};
    state.lastReceipt = result;
    const items = Array.isArray(order.items) ? order.items : [];
    const createdAt = order.createdAt ? new Date(order.createdAt) : new Date();
    $("waReceiptContent").innerHTML = `<div class="wa-receipt-brand"><h4>CALIDRO RACS</h4><p>Official walk-in aircon order receipt</p></div><div class="wa-receipt-grid"><div><span>Order reference</span><strong>${esc(order.orderReference || "Pending reference")}</strong></div><div><span>Date issued</span><strong>${esc(createdAt.toLocaleString("en-PH"))}</strong></div><div><span>Customer</span><strong>${esc(order.customer?.name || "Customer")}</strong></div><div><span>Payment</span><strong>${esc(String(order.paymentMethod || "paid").replace(/_/g," ").toUpperCase())} · PAID</strong></div><div><span>Fulfillment</span><strong>${esc(String(order.fulfillmentType || "").replace(/_/g," ").toUpperCase())}</strong></div><div><span>Schedule</span><strong>${esc(order.delivery?.preferredDate ? `${new Date(order.delivery.preferredDate).toLocaleDateString("en-PH")} ${order.timeSlot || ""}` : (order.pickupDate ? new Date(order.pickupDate).toLocaleDateString("en-PH") : "Released"))}</strong></div></div><table class="wa-receipt-items"><thead><tr><th>Item</th><th>Qty</th><th>Amount</th></tr></thead><tbody>${items.map(item=>`<tr><td>${esc(`${item.brand || ""} ${item.modelLine || "Aircon"} ${item.capacity || ""}${item.capacityUnit || ""}`.trim())}</td><td>${Number(item.quantity || 0)}</td><td>${money(item.totalPrice)}</td></tr>`).join("")}</tbody></table><div class="wa-receipt-total"><span>Total paid</span><span>${money(order.total)}</span></div>${Number(result.change || 0) > 0 ? `<div class="wa-sum-row mt-2"><span>Change</span><strong>${money(result.change)}</strong></div>` : ""}<div class="wa-account-result"><i class="bi bi-person-check me-1"></i>${esc(accountResultText(result.customerAccount))}</div>`;
    $("waResendInvitation").classList.toggle("d-none", result.customerAccount?.state !== "invited");
    $("waReceiptBackdrop").classList.add("show");
    $("waReceiptBackdrop").setAttribute("aria-hidden", "false");
  }

  function closeReceipt() {
    $("waReceiptBackdrop").classList.remove("show");
    $("waReceiptBackdrop").setAttribute("aria-hidden", "true");
    state.lastReceipt = null;
  }

  async function resendInvitation() {
    const orderId = state.lastReceipt?.order?._id;
    if (!orderId) return;
    const button = $("waResendInvitation");
    button.disabled = true;
    try {
      const result = await jsonFetch(`/api/walk-in-aircon/orders/${encodeURIComponent(orderId)}/resend-invitation`, { method:"POST" });
      button.classList.add("d-none");
      toast(result.message, "success");
    } catch (error) { toast(error.message, "danger"); }
    finally { button.disabled = false; }
  }

  async function initializeAfterCheckout() {
    state.loaded = false;
    state.availableDates.clear();
    state.availableSlots = [];
    state.time = "";
    state.calendarMonth = new Date(today.getFullYear(), today.getMonth(), 1);
    resetDeliveryPoint();
    await initialize();
    renderAvailabilityCalendar();
    resetTimeSlots();
    setCalendarStatus("Select a technician and verified address first.");
  }

  let productSearchTimer;
  let addressSearchTimer;
  $("waSearch").addEventListener("input", () => { clearTimeout(productSearchTimer); productSearchTimer = setTimeout(renderProducts, 180); });
  $("waTypeFilter").addEventListener("change", renderProducts);
  $("waFindCustomer").addEventListener("click", findOrderCustomer);
  $("waCustomerEmail").addEventListener("input", () => {
    const email = $("waCustomerEmail").value.trim().toLowerCase();
    if (email !== state.customerLookupEmail) resetCustomerAccountMatch();
  });
  $("waCustomerEmail").addEventListener("keydown", event => {
    if (event.key !== "Enter") return;
    event.preventDefault();
    findOrderCustomer();
  });
  document.querySelectorAll("#waFulfillmentChoices button").forEach(button => button.addEventListener("click", () => setFulfillment(button.dataset.value)));
  $("waTechnician").addEventListener("change", scheduleInputsChanged);
  $("waDiscount").addEventListener("input", renderTotals);
  $("waPayment").addEventListener("change", syncPaymentMode);
  $("waAddress").addEventListener("input", () => {
    $("waLat").value = "";
    $("waLng").value = "";
    resetDeliveryPoint();
    $("waAddressResults").classList.add("wa-hidden");
    $("waQuote").innerHTML = '<div class="wa-quote"><span>Select an address suggestion to verify the route.</span><strong>—</strong></div>';
    scheduleInputsChanged();
    renderTotals();
    clearTimeout(addressSearchTimer);
    addressSearchTimer = setTimeout(searchAddress, 400);
  });
  $("waCalendarPrev").addEventListener("click", () => moveCalendarMonth(-1));
  $("waCalendarNext").addEventListener("click", () => moveCalendarMonth(1));
  $("waLocateMe").addEventListener("click", locateDeliveryPoint);
  $("waFitRoute").addEventListener("click", fitDeliveryRoute);
  $("waExpandMap").addEventListener("click", () => {
    const expanded = $("waMapCard").classList.toggle("expanded");
    $("waExpandMap").innerHTML = expanded ? '<i class="bi bi-fullscreen-exit"></i><span>Collapse</span>' : '<i class="bi bi-fullscreen"></i><span>Expand</span>';
    setTimeout(() => state.map?.invalidateSize(), 280);
  });
  $("waOpenCart").addEventListener("click", openCart);
  $("waCloseCart").addEventListener("click", closeCart);
  $("waCartBackdrop").addEventListener("click", closeCart);
  $("waCloseVariant").addEventListener("click", closeVariantPicker);
  $("waVariantBackdrop").addEventListener("click", event => { if (event.target === $("waVariantBackdrop")) closeVariantPicker(); });
  $("waCloseReceipt").addEventListener("click", closeReceipt);
  $("waReceiptBackdrop").addEventListener("click", event => { if (event.target === $("waReceiptBackdrop")) closeReceipt(); });
  $("waPrintReceipt").addEventListener("click", () => { document.body.classList.add("wa-printing"); window.print(); window.setTimeout(() => document.body.classList.remove("wa-printing"), 250); });
  $("waResendInvitation").addEventListener("click", resendInvitation);
  document.addEventListener("keydown", event => {
    if (event.key !== "Escape") return;
    if ($("waReceiptBackdrop").classList.contains("show")) closeReceipt();
    else if ($("waVariantBackdrop").classList.contains("show")) closeVariantPicker();
    else if ($("waCartDrawer").classList.contains("show")) closeCart();
  });
  $("waCheckoutForm").addEventListener("submit", submit);
  const tomorrow = new Date(Date.now() + 86400000);
  $("waPickupDate").min = tomorrow.toISOString().slice(0,10);
  resetCustomerAccountMatch({ clearProfile:false });
  renderAvailabilityCalendar();
  resetTimeSlots();
  renderCart();
})();
</script>
