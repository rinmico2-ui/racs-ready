      <button class="nav-link" data-tab="tab-cancel">Cancelled</button>
    </li>
  </ul>

  <div class="appts-grid">
    <!-- Tabbed content panels -->
    <section>
      <!-- TAB: LIST -->
      <div id="tab-list" class="tab-pane">
        <div class="panel-card">
          <!-- Premium Filters -->
          <div class="workflow-overview-filter">
            <div class="workflow-overview-filter-group" style="flex:1;flex-wrap:wrap;">
              <span class="workflow-overview-filter-label"><i class="bi bi-search"></i> Search</span>
              <input
                id="filterSearchCombined"
                class="form-control form-control-sm"
                placeholder="Booking ref, customer, service, id..."
                style="min-width:200px;"
              />
              <span class="workflow-overview-filter-label"><i class="bi bi-calendar3"></i> From</span>
              <input
                id="filterStartCombined"
                type="date"
                class="form-control form-control-sm"
                aria-label="Start date"
                style="width:150px;"
              />
              <span class="workflow-overview-filter-label"><i class="bi bi-calendar3"></i> To</span>
              <input
                id="filterEndCombined"
                type="date"
                class="form-control form-control-sm"
                aria-label="End date"
                style="width:150px;"
              />
              <span class="workflow-overview-filter-label"><i class="bi bi-person-badge"></i> Technician</span>
              <select
                id="filterTechCombined"
                class="form-select form-select-sm"
                style="width:160px;"
              >
                <option value="all">All technicians</option>
              </select>
              <span class="workflow-overview-filter-label"><i class="bi bi-gear"></i> Service</span>
              <select
                id="filterServiceType"
                class="form-select form-select-sm"
                style="width:160px;"
              >
                <option value="all">All Services</option>
                <option value="core">Core Services</option>
                <option value="repair">Repair Services</option>
              </select>
              <button
                id="btn-filter-combined"
                type="button"
                class="btn btn-sm btn-primary fw-semibold"
              >
                <i class="bi bi-funnel me-1"></i>Apply
              </button>
            </div>
          </div>

          <div class="table-responsive workflow-record-table-shell">
            <table class="table align-middle workflow-record-table">
              <thead>
                <tr>
                  <th>Booking Ref</th>
                  <th>Appointment</th>
                  <th>Customer</th>
                  <th>Service</th>
                  <th>Payment</th>
                  <th>Status</th>
                  <th class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody id="appointmentsBodyCombined">
                <tr>
                  <td colspan="7" class="text-center py-5 text-muted">
                    <div class="spinner-border text-primary"></div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="workflow-overview-table-footer">
            <small class="text-muted" id="appointmentsCountCombined">—</small>
            <nav>
              <ul
                class="pagination pagination-sm mb-0"
                id="appointmentsPagerCombined"
              ></ul>
            </nav>
          </div>
        </div>
      </div>

      <!-- TAB: BOOKING REQUESTS -->
      <div id="tab-requests" class="tab-pane d-none">
        <div class="workflow-overview-filter">
          <div class="workflow-overview-filter-group" style="flex:1;">
            <span class="workflow-overview-filter-label"><i class="bi bi-search"></i> Search</span>
            <input
              id="requestSearchCombined"
              class="form-control form-control-sm"
              placeholder="Search by customer, email, service, id..."
              style="flex:1;min-width:280px;"
            />
          </div>
          <div class="workflow-overview-filter-group">
            <button
              id="requestRefreshCombined"
              class="btn btn-sm btn-outline-secondary"
            >
              <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
          </div>
        </div>

        <div class="panel-card">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <div class="fw-bold">Booking Request Validation Queue</div>
              <div class="muted-small">
                Review requests, validate details, then confirm (this will also
                mark payment paid) or cancel.
              </div>
            </div>
          </div>

          <div class="table-responsive workflow-record-table-shell">
            <table class="table align-middle workflow-record-table">
              <thead>
                <tr>
                  <th>Request ID</th>
                  <th>Customer</th>
                  <th>Service</th>
                  <th>Est. fee</th>
                  <th>Date / Time</th>
                  <th>Payment</th>
                  <th>Status</th>
                  <th class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody id="requestsTableBodyCombined">
                <tr>
                  <td colspan="8" class="text-center py-5 text-muted">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Loading request queue…</p>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="workflow-overview-table-footer">
