  // ── Render KPI sparklines ──
  function renderSparklines(A) {
    const months = Object.values(A.monthlyRevenue || {}).reverse();
    const sparkData = {
      kpiSparkRevenue: months.map(x => x.total || 0),
      kpiSparkCash: months.map(x => (x.service || 0) * 0.7 + (x.pos || 0) * 0.3),
      kpiSparkAvgTxn: months.map(x => (x.total || 0) / Math.max(1, (x.service || 0) + (x.orders || 0) + (x.pos || 0))),
    };
    const sparkColors = { kpiSparkRevenue: '#2563eb', kpiSparkCash: '#06b6d4', kpiSparkAvgTxn: '#8b5cf6' };
    Object.entries(sparkData).forEach(([id, data]) => {
      const el = document.getElementById(id);
      if (!el || !data.length) return;
      const existing = Chart.getChart(el);
      if (existing) existing.destroy();
      new Chart(el, {
        type: 'line',
        data: { labels: data.map((_, i) => i), datasets: [{ data, borderColor: sparkColors[id], borderWidth: 1.5, pointRadius: 0, tension: 0.4, fill: true, backgroundColor: sparkColors[id] + '15' }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { display: false }, y: { display: false } }, elements: { line: { borderCapStyle: 'round' } } }
      });
    });
