  // ── Approve ───────────────────────────────────────────────────
  function openApprove(id) {
    const r = allRecords.find(x => x._id === id);
    if (!r) return;
    document.getElementById('approveModal').dataset.id = id;
    const emp = r.employee || {};
    const warnings = (r.calculationWarnings || []).map(item => `<li>${esc(item)}</li>`).join('');
    document.getElementById('approveSummary').innerHTML = `
      <strong>${esc((emp.firstName||'') + ' ' + (emp.lastName||''))}</strong><br/>
      <span>Period: ${fmtDate(r.periodStart)} – ${fmtDate(r.periodEnd)}</span>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0;">
        <span><small>Gross</small><br/><strong>${fmt(r.grossPay)}</strong></span>
        <span><small>Deductions</small><br/><strong>${fmt(r.totalDeductions)}</strong></span>
        <span><small>Net pay</small><br/><strong>${fmt(r.netPay)}</strong></span>
      </div>
      <small><i class="bi bi-lock-fill me-1"></i>Approval recalculates the amounts, locks the run, and publishes the payslip. It does not record payment.</small>
      ${warnings ? `<ul class="mt-2 mb-0">${warnings}</ul>` : ''}`;
    new bootstrap.Modal(document.getElementById('approveModal')).show();
  }

  async function confirmApprove() {
    const id = document.getElementById('approveModal').dataset.id;
    try {
      const res = await fetch(API + '/' + id + '/approve', { method: 'POST', credentials: 'same-origin' });
      const data = await res.json();
      if (!res.ok) {
        const warningText = Array.isArray(data.warnings) && data.warnings.length ? ' ' + data.warnings.join(' ') : '';
        showCalcMsg((data.error || 'Approval failed.') + warningText, 'error');
        return;
      }
      bootstrap.Modal.getInstance(document.getElementById('approveModal')).hide();
      loadRecords();
      showCalcMsg('Payroll approved.', 'success');
    } catch(e) { showCalcMsg('Failed to approve.', 'error'); }
  }

  // ── Paid ──────────────────────────────────────────────────────
  function openPaid(id) {
    const r = allRecords.find(x => x._id === id);
    if (!r) return;
    document.getElementById('paidPayrollId').value = id;
    document.getElementById('paidMethod').value = '';
    document.getElementById('paidDate').value = localDateValue(new Date());
    document.getElementById('paidReference').value = '';
    document.getElementById('paidProof').value = '';
    syncPaymentEvidence();
    const emp = r.employee || {};
    document.getElementById('paidModalSub').textContent = `${(emp.firstName||'') + ' ' + (emp.lastName||'')} — ${fmt(r.netPay)}`;
    new bootstrap.Modal(document.getElementById('paidModal')).show();
  }

  async function confirmPaid() {
    const id = document.getElementById('paidPayrollId').value;
    const method = document.getElementById('paidMethod').value;
    if (!method) { showCalcMsg('Select a payment method.', 'error'); return; }
    const reference = document.getElementById('paidReference').value.trim();
    if (method !== 'cash' && !reference) { showCalcMsg('Enter the transaction reference for this non-cash payment.', 'error'); return; }
    const proof = document.getElementById('paidProof');
    if (proof.value && !proof.checkValidity()) { showCalcMsg('Enter a valid HTTP or HTTPS proof URL.', 'error'); return; }
    try {
      const res = await fetch(API + '/' + id + '/paid', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          paymentMethod: method,
          paymentDate: document.getElementById('paidDate').value,
          paymentReference: reference,
          paymentProof: proof.value,
        })
      });
      const data = await res.json();
      if (!res.ok) { showCalcMsg(data.error || 'Failed.', 'error'); return; }
      bootstrap.Modal.getInstance(document.getElementById('paidModal')).hide();
      loadRecords();
      showCalcMsg('Payment recorded.', 'success');
    } catch(e) { showCalcMsg('Failed to mark as paid.', 'error'); }
  }

  function syncPaymentEvidence() {
    const method = document.getElementById('paidMethod').value;
    const required = !!method && method !== 'cash';
    const reference = document.getElementById('paidReference');
    reference.required = required;
    document.getElementById('paidReferenceLabel').textContent = required ? 'Reference No. *' : 'Reference No.';
  }

  // ── Void ──────────────────────────────────────────────────────
  function openVoid(id) {
    document.getElementById('voidPayrollId').value = id;
    document.getElementById('voidReason').value = '';
    new bootstrap.Modal(document.getElementById('voidModal')).show();
  }

  async function confirmVoid() {
    const id = document.getElementById('voidPayrollId').value;
    const reason = document.getElementById('voidReason').value.trim();
    if (!reason) { showCalcMsg('A reason is required to void.', 'error'); return; }
    try {
      const res = await fetch(API + '/' + id + '/void', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ reason })
      });
      const data = await res.json();
      if (!res.ok) { showCalcMsg(data.error || 'Failed.', 'error'); return; }
      bootstrap.Modal.getInstance(document.getElementById('voidModal')).hide();
      loadRecords();
      showCalcMsg('Payroll voided.', 'success');
    } catch(e) { showCalcMsg('Failed to void.', 'error'); }
  }

  // ── Compensation ──────────────────────────────────────────────
  function syncPayTypeRadio(val) {
    document.querySelectorAll('input[name="compPayTypeRadio"]').forEach(r => {
      r.checked = r.value === val;
    });
    document.getElementById('compPayType').value = val || '';
    syncCompRateLabels();
  }

  function getPayTypeFromRadio() {
    const checked = document.querySelector('input[name="compPayTypeRadio"]:checked');
    return checked ? checked.value : '';
  }

  function syncCompRateLabels() {
    const payType = getPayTypeFromRadio();
    const label = document.getElementById('compBaseRateLabel');
    const hint = document.getElementById('compRateHint');
    const unit = payType ? payUnit(payType) : 'period';
    label.textContent = payType ? `Base Rate (per ${unit}) *` : 'Base Rate *';
    hint.textContent = payType === 'daily'
      ? 'Basic pay = completed payable attendance days × daily rate.'
      : payType === 'hourly'
        ? 'Basic pay = verified worked hours × hourly rate.'
        : payType === 'monthly'
          ? 'Monthly salary is prorated by calendar days covered by the payroll period.'
          : 'Choose a pay type to see how this rate is applied.';
  }

  function syncCompEmployeeContext() {
    const employeeId = document.getElementById('compEmployee').value;
    const staff = allStaff.find(item => String(item._id) === String(employeeId));
    const context = document.getElementById('compEmployeeContext');
    const isEditing = Boolean(document.getElementById('compId').value);
    document.querySelectorAll('input[name="compPayTypeRadio"]').forEach(radio => { radio.disabled = false; });
    if (!staff) {
      context.className = 'pw-context';
      context.innerHTML = '<i class="bi bi-info-circle me-1"></i>Select an employee to review their current pay policy.';
      syncCompRateLabels();
      return;
    }
    if (staff.role === 'secretary') {
      if (getPayTypeFromRadio() !== 'monthly') syncPayTypeRadio('monthly');
      document.querySelectorAll('input[name="compPayTypeRadio"]').forEach(radio => { radio.disabled = radio.value !== 'monthly'; });
    }
    const records = allComp.filter(record => String(record.employee?._id || record.employee) === String(employeeId)).sort((a,b) => dateOnlyTime(b.effectiveFrom)-dateOnlyTime(a.effectiveFrom));
    const current = records.find(record => compensationLifecycle(record) === 'current');
    const scheduled = records.find(record => compensationLifecycle(record) === 'scheduled');
    context.className = 'pw-context ' + (current ? 'success' : scheduled ? 'warning' : 'danger');
    context.innerHTML = current
      ? `<i class="bi bi-check-circle-fill me-1"></i>Current policy: <strong>${esc(current.payType)} ${fmt(current.baseRate)}/${payUnit(current.payType)}</strong>, effective ${fmtDate(current.effectiveFrom)}${current.effectiveTo?` to ${fmtDate(current.effectiveTo)}`:''}.`
      : scheduled
        ? `<i class="bi bi-calendar-event me-1"></i>A ${esc(scheduled.payType)} rate of ${fmt(scheduled.baseRate)}/${payUnit(scheduled.payType)} is scheduled for ${fmtDate(scheduled.effectiveFrom)}.`
        : '<i class="bi bi-exclamation-triangle-fill me-1"></i>No policy covers today. Create one before generating current payroll.';
    if (!isEditing && records.length) {
      document.getElementById('compModalTitle').textContent = 'Schedule Pay Rate Change';
      document.getElementById('compModalSub').textContent = 'The prior policy will end immediately before the new effective date';
    }
    syncCompRateLabels();
  }

  function openAddComp() {
    document.getElementById('compId').value = '';
    document.getElementById('compModalTitle').textContent = 'Set Pay Policy';
    document.getElementById('compModalSub').textContent = 'Configure an effective-dated employee pay policy';
    document.getElementById('compEmployee').value = '';
    document.getElementById('compEmployee').disabled = false;
    syncPayTypeRadio('');
    document.getElementById('compBaseRate').value = '';
    document.getElementById('compOTRate').value = '0';
    document.getElementById('compEffectiveFrom').disabled = false;
    document.getElementById('compEffectiveFrom').value = localDateValue(new Date());
    document.getElementById('compEffectiveHint').textContent = 'A new rate closes the prior rate on the previous calendar day. Historical payroll remains unchanged.';
    syncCompEmployeeContext();
    new bootstrap.Modal(document.getElementById('compModal')).show();
  }

  function scheduleRateChange(id) {
    const record = allComp.find(item => item._id === id);
    if (!record?.employee?._id) return;
    openAddComp();
    document.getElementById('compEmployee').value = record.employee._id;
    const today = new Date();
    const latestEffective = new Date(Math.max(...allComp.filter(item => String(item.employee?._id || item.employee) === String(record.employee._id)).map(item => dateOnlyTime(item.effectiveFrom))));
    const proposed = latestEffective >= new Date(today.getFullYear(),today.getMonth(),today.getDate()) ? new Date(latestEffective.getFullYear(),latestEffective.getMonth(),latestEffective.getDate()+1) : today;
    document.getElementById('compEffectiveFrom').value = localDateValue(proposed);
    syncPayTypeRadio(record.payType);
    syncCompEmployeeContext();
  }

  function editComp(id) {
    const r = allComp.find(x => x._id === id);
    if (!r) return;
    document.getElementById('compId').value = id;
    document.getElementById('compModalTitle').textContent = 'Edit Pay Rate';
    document.getElementById('compModalSub').textContent = 'Correct an unused active policy; use New Rate for a dated change';
    document.getElementById('compEmployee').value = r.employee._id;
    document.getElementById('compEmployee').disabled = true;
    syncPayTypeRadio(r.payType);
    document.getElementById('compBaseRate').value = r.baseRate;
    document.getElementById('compOTRate').value = r.overtimeRate || 0;
    document.getElementById('compEffectiveFrom').value = r.effectiveFrom ? localDateValue(r.effectiveFrom) : '';
    document.getElementById('compEffectiveFrom').disabled = true;
    document.getElementById('compEffectiveHint').textContent = 'The effective date is locked while editing. Use New Rate to preserve the existing policy and schedule a change.';
    syncCompEmployeeContext();
    new bootstrap.Modal(document.getElementById('compModal')).show();
  }

  async function saveCompensation() {
    const id = document.getElementById('compId').value;
    const emp = document.getElementById('compEmployee').value;
    const payType = getPayTypeFromRadio();
    const baseRate = document.getElementById('compBaseRate').value;
    const effectiveFrom = document.getElementById('compEffectiveFrom').value;
    if (!emp || !payType || !baseRate || !effectiveFrom) { showCalcMsg('Please fill in all required fields.', 'error'); return; }

    const body = {
      employee: emp,
      payType,
      baseRate: parseFloat(baseRate),
      overtimeRate: parseFloat(document.getElementById('compOTRate').value) || 0,
    };
    if (!id) body.effectiveFrom = effectiveFrom;

    if (!id && allComp.some(record => String(record.employee?._id || record.employee) === String(emp))) {
      const confirmation = await Swal.fire({title:'Schedule this pay rate?',text:`The existing rate will end immediately before ${fmtDate(effectiveFrom)}. Finalized payroll history will not change.`,icon:'question',showCancelButton:true,confirmButtonText:'Schedule rate',confirmButtonColor:'#2563eb'});
      if (!confirmation.isConfirmed) return;
    }

    try {
      const url = id ? API + '/compensation/' + id : API + '/compensation';
      const method = id ? 'PATCH' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body)
      });
      const data = await res.json();
      if (!res.ok) { showCalcMsg(data.error || 'Save failed.', 'error'); return; }
      bootstrap.Modal.getInstance(document.getElementById('compModal')).hide();
      document.getElementById('compEmployee').disabled = false;
      document.getElementById('compEffectiveFrom').disabled = false;
      loadCompensation();
      showCalcMsg(id ? 'Pay rate updated.' : 'Pay rate added.', 'success');
    } catch(e) { showCalcMsg('Failed to save compensation.', 'error'); }
  }

  async function endComp(id) {
    const record = allComp.find(item => item._id === id);
    if (!record) return;
    const decision = await Swal.fire({title:'End this pay policy?',text:'Choose the final date this rate remains valid. Payroll periods after that date will require another rate.',input:'date',inputValue:localDateValue(new Date()),inputAttributes:{min:localDateValue(record.effectiveFrom)},icon:'warning',showCancelButton:true,confirmButtonText:'End policy',confirmButtonColor:'#dc2626',inputValidator:value=>!value?'Select the final effective date.':dateOnlyTime(value)<dateOnlyTime(record.effectiveFrom)?'End date cannot be before the effective date.':undefined});
    if (!decision.isConfirmed) return;
    try {
      const res = await fetch(API + '/compensation/' + id + '/end', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ effectiveTo: decision.value }),
      });
      const data = await res.json();
      if (!res.ok) { showCalcMsg(data.error || 'Failed.', 'error'); return; }
      loadCompensation();
      showCalcMsg('Compensation ended.', 'success');
    } catch(e) { showCalcMsg('Failed to end compensation.', 'error'); }
  }

  // ── Helpers ───────────────────────────────────────────────────
  function esc(str) { const d = document.createElement('div'); d.textContent = str || ''; return d.innerHTML; }

  // Expose to onclick handlers
  window._pw = {
    viewRecord,
    editRecord: (id) => editRecord(id),
    openApprove,
    openPaid,
    openVoid,
    editComp,
    scheduleRateChange,
    endComp,
    updateSummary,
    checkEmpty,
    createDuePayroll,
    applyCyclePreset,
    loadDueToday,
  };
  window.pwGoStep = pwGoStep;
  window.pwContinueToBreakdown = pwContinueToBreakdown;
  window.pwContinueToReview = pwContinueToReview;
})();
</script>
