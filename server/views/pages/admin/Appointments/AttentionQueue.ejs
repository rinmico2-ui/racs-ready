  let resolutionDetailRequestId = 0;
  let resolutionPaymentSelection = null;
  let resolutionPaymentBusy = false;
  function resetResolutionPaymentReview() {
    resolutionPaymentSelection = null;
    document.getElementById('detailBody').classList.remove('rc-payment-detail');
    document.getElementById('detailPaymentReview').classList.add('d-none');
    document.getElementById('detailPaymentVerify').classList.add('d-none');
    document.getElementById('detailPaymentVerify').disabled = true;
    const checkbox = document.getElementById('detailPaymentChecked');
    checkbox.checked = false; checkbox.disabled = true;
    document.getElementById('detailPaymentError').hidden = true;
  }
  document.getElementById('detailPaymentChecked').addEventListener('change', event => {
    document.getElementById('detailPaymentVerify').disabled = !event.target.checked || !resolutionPaymentSelection || resolutionPaymentBusy;
  });
  document.getElementById('detailModal').addEventListener('hide.bs.modal', event => {
    if (resolutionPaymentBusy) event.preventDefault();
  });
  document.getElementById('detailModal').addEventListener('hidden.bs.modal', () => {
    resolutionDetailRequestId++;
    resetResolutionPaymentReview();
    window.ResolutionEvidence?.cancel();
  });

  async function openResolutionPaymentReview(source, id) {
    if (resolutionPaymentBusy) return;
    const item = findResolutionCase(source, id);
    if (!item || ![item, ...(item.issues || [])].some(issue => issue.allowedActions?.includes('verify_payment'))) {
      showToast('info', 'This payment no longer needs review. Refresh the list.'); return;
    }
    const record = await (source === 'order' ? viewOrderDetail(id) : viewDetail(id));
    if (!record) return;
    const requestId = resolutionDetailRequestId;
    const detailBody = document.getElementById('detailBody');
    detailBody.classList.add('rc-payment-detail');
    const evidence = detailBody.querySelector('.rc-evidence');
    if (evidence) detailBody.prepend(evidence);
    const panel = document.getElementById('detailPaymentReview'), button = document.getElementById('detailPaymentVerify');
    const summary = document.getElementById('detailPaymentSummary');
    panel.classList.remove('d-none'); button.classList.remove('d-none');
    summary.textContent = 'Loading the submitted payment...';
    document.querySelector('#detailModalTitle span').textContent = source === 'order' ? 'Review order payment' : 'Review booking payment';
    try {
      const endpoint = source === 'order' ? `/api/orders/${encodeURIComponent(id)}/payment-review`
        : `${RESOLUTION_API_BASE}/resolution-center/${encodeURIComponent(id)}/payment-summary`;
      const response = await fetch(endpoint, { credentials:'same-origin', cache:'no-store' });
      const data = await response.json();
      if (requestId !== resolutionDetailRequestId) return;
      if (!response.ok || data.success === false) throw new Error(data.error || 'Could not load the submitted payment.');
      const payment = data.pendingPayment;
      if (!payment || !(Number(payment.amount) > 0)) { summary.textContent = 'No payment is waiting for review. Ask the customer to submit their payment receipt if they have already paid.'; return; }
      summary.textContent = `Submitted payment: ₱${Number(payment.amount).toLocaleString('en-PH', { minimumFractionDigits:2, maximumFractionDigits:2 })}${payment.reference ? ` · Reference: ${payment.reference}` : ''}. Check the receipt above before verifying. A new schedule is still needed if the old date has passed.`;
      resolutionPaymentSelection = { source, id, requestId };
      document.getElementById('detailPaymentChecked').disabled = false;
    } catch (error) {
      if (requestId !== resolutionDetailRequestId) return;
      summary.textContent = error.message || 'Could not load the submitted payment. Close and try again.';
    }
  }

  async function confirmResolutionPaymentReview() {
    const selection = resolutionPaymentSelection;
    if (resolutionPaymentBusy || !selection || !document.getElementById('detailPaymentChecked').checked) return;
    resolutionPaymentBusy = true;
    const button = document.getElementById('detailPaymentVerify'), checkbox = document.getElementById('detailPaymentChecked');
    const errorElement = document.getElementById('detailPaymentError');
    button.disabled = true; button.textContent = 'Verifying...'; checkbox.disabled = true; errorElement.hidden = true;
    try {
      const endpoint = selection.source === 'order' ? `/api/orders/${encodeURIComponent(selection.id)}/payment`
        : `${RESOLUTION_API_BASE}/resolution-center/${encodeURIComponent(selection.id)}/verify-pending-payment`;
      const response = await fetch(endpoint, { method:selection.source === 'order' ? 'PATCH' : 'POST', credentials:'same-origin',
        headers:{ 'Content-Type':'application/json' }, body:JSON.stringify({ paymentStatus:'paid', note:'Payment verified from the Resolution Center' }) });
      const data = await response.json();
      if (!response.ok || data.success === false) throw new Error(data.error || 'Payment verification failed.');
      resolutionPaymentSelection = null;
      const modalElement = document.getElementById('detailModal');
      const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
      if (modal._isTransitioning) await new Promise(resolve => modalElement.addEventListener('shown.bs.modal', resolve, { once:true }));
      resolutionPaymentBusy = false;
      modal.hide();
      showToast('success', 'Payment verified. Review the schedule to continue with this case.');
      await loadQueue();
    } catch (error) {
      errorElement.textContent = error.message || 'Payment verification failed. Please try again.'; errorElement.hidden = false;
    } finally {
      resolutionPaymentBusy = false; button.textContent = 'Verify payment'; checkbox.disabled = !resolutionPaymentSelection;
      button.disabled = !resolutionPaymentSelection || !checkbox.checked;
    }
  }

  function mountResolutionEvidence(endpoint) {
    const host = document.createElement('section');
    host.className = 'rc-evidence';
    host.setAttribute('aria-label', 'Proof photos and receipts');
    document.getElementById('detailBody').append(host);
    if (window.ResolutionEvidence) void ResolutionEvidence.mount(host, endpoint);
    else host.textContent = 'Photo preview is unavailable. Reload the page and try again.';
  }

  function escapeResolutionRecord(value) {
    if (typeof value === 'string') return escapeHtml(value);
    if (Array.isArray(value)) return value.map(escapeResolutionRecord);
    if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, escapeResolutionRecord(item)]));
    return value;
  }

