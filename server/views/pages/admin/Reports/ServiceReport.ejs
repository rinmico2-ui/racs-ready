    var g11 = ctx11.getContext('2d').createLinearGradient(0, 0, 0, 200); g11.addColorStop(0, 'rgba(239,68,68,0.3)'); g11.addColorStop(1, 'rgba(239,68,68,0.02)');
    var canChartCfg = { type: "line", data: { labels: canLabels, datasets: [{ label: "Cancellation Rate %", data: canRates, borderColor: "#ef4444", backgroundColor: g11, borderWidth: 2.5, tension: 0.4, fill: true, pointBackgroundColor: "#fff", pointBorderColor: "#ef4444", pointBorderWidth: 2, pointRadius: 3, pointHoverRadius: 5, yAxisID: 'y' }, { label: "Cancelled Count", data: canCounts, borderColor: "#f59e0b", backgroundColor: 'transparent', borderWidth: 2, tension: 0.4, fill: false, pointBackgroundColor: "#fff", pointBorderColor: "#f59e0b", pointBorderWidth: 2, pointRadius: 3, pointHoverRadius: 5, yAxisID: 'y1' }] }, options: { responsive: true, maintainAspectRatio: false, animation: { duration: 1200 }, interaction: { mode: 'index', intersect: false }, plugins: { legend: { position: "top", align: "end", labels: { usePointStyle: true, boxWidth: 8, padding: 12 } }, tooltip: { backgroundColor: '#0f172a', padding: 10, cornerRadius: 8 } }, scales: { x: { grid: { display: false }, ticks: { color: '#94a3b8', font: { size: 9 } }, border: { display: false } }, y: { position: 'left', grid: { color: '#f1f5f9' }, ticks: { color: '#94a3b8', callback: function(v) { return v + '%'; } }, border: { display: false }, max: 100 }, y1: { position: 'right', grid: { display: false }, ticks: { color: '#94a3b8' }, border: { display: false } } } } };
    var canDetails = bookingDetails('date', function(row) { var age=Math.max(0,Math.floor((reportEndMs-new Date(row.date).getTime())/604800000)); return 'W'+(12-age); }, function(row) { return row.statusGroup === 'cancelled'; });
    renderInteractiveChart(ctx11, canChartCfg, function(event) { openSelected(event, ctx11, 'Cancellation Trend', 'Cancelled bookings from the selected reporting week', canChartCfg, canDetails, { cancelled:canDetails.length }); });
  }

  /* -- Customer Segments -- */
  var ctx12 = document.getElementById("customerSegmentChart");
  if (ctx12) {
    var csLabels = ["One-Time", "Returning", "Loyal"];
    var csData = [SA.customerSegments.oneTime || 0, SA.customerSegments.returning || 0, SA.customerSegments.loyal || 0];
    var csColors = ["#94a3b8", "#3b82f6", "#f59e0b"];
    var csChartCfg = { type: "doughnut", data: { labels: csLabels, datasets: [{ data: csData, backgroundColor: csColors, borderWidth: 3, borderColor: "#fff", hoverOffset: 6 }] }, options: { responsive: true, maintainAspectRatio: false, cutout: "65%", animation: { duration: 1200 }, plugins: { legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 8, padding: 12 } }, tooltip: { backgroundColor: '#0f172a', padding: 10, cornerRadius: 8 } } } };
    var customerFrequency = {}; SA.bookingDrilldown.forEach(function(row) { var key=row.customerId||row.contact||row.customer; customerFrequency[key]=true; });
    var csDetails = bookingDetails('customerSegment');
    renderInteractiveChart(ctx12, csChartCfg, function(event) { openSelected(event, ctx12, 'Customer Segments', 'Bookings belonging to the selected lifetime customer segment', csChartCfg, csDetails, { customers:Object.keys(customerFrequency).length }); });
  }

  /* -- Monthly Booked Value Trend -- */
  var ctx13 = document.getElementById("monthlyRevenueChart");
  if (ctx13) {
    var mrLabels = SA.monthlyRevenueTrend.length > 0 ? SA.monthlyRevenueTrend.map(function(m) { return m.month; }) : ["M1","M2","M3","M4","M5","M6"];
    var mrTotal = SA.monthlyRevenueTrend.length > 0 ? SA.monthlyRevenueTrend.map(function(m) { return m.total; }) : [0,0,0,0,0,0];
    var mrCore = SA.monthlyRevenueTrend.length > 0 ? SA.monthlyRevenueTrend.map(function(m) { return m.core; }) : [0,0,0,0,0,0];
    var mrRepair = SA.monthlyRevenueTrend.length > 0 ? SA.monthlyRevenueTrend.map(function(m) { return m.repair; }) : [0,0,0,0,0,0];
    var g13a = ctx13.getContext('2d').createLinearGradient(0, 0, 0, 200); g13a.addColorStop(0, 'rgba(6,182,212,0.3)'); g13a.addColorStop(1, 'rgba(6,182,212,0.02)');
    var g13b = ctx13.getContext('2d').createLinearGradient(0, 0, 0, 200); g13b.addColorStop(0, 'rgba(139,92,246,0.3)'); g13b.addColorStop(1, 'rgba(139,92,246,0.02)');
    var mrChartCfg = { type: "bar", data: { labels: mrLabels, datasets: [{ label: "Core", data: mrCore, backgroundColor: "#06b6d4", borderRadius: 4, barPercentage: 0.6 }, { label: "Repair", data: mrRepair, backgroundColor: "#8b5cf6", borderRadius: 4, barPercentage: 0.6 }, { label: "Total", data: mrTotal, type: "line", borderColor: "#10b981", backgroundColor: 'transparent', borderWidth: 2.5, tension: 0.4, pointBackgroundColor: "#fff", pointBorderColor: "#10b981", pointBorderWidth: 2, pointRadius: 4, pointHoverRadius: 6, fill: false }] }, options: { responsive: true, maintainAspectRatio: false, animation: { duration: 1200 }, interaction: { mode: 'index', intersect: false }, plugins: { legend: { position: "top", align: "end", labels: { usePointStyle: true, boxWidth: 8, padding: 12 } }, tooltip: { backgroundColor: '#0f172a', padding: 10, cornerRadius: 8, callbacks: { label: function(c) { return c.dataset.label + ': ₱' + c.parsed.y.toLocaleString(); } } } }, scales: { x: { grid: { display: false }, ticks: { color: '#94a3b8' }, border: { display: false } }, y: { grid: { color: '#f1f5f9' }, ticks: { color: '#94a3b8', callback: function(v) { return '₱' + (v >= 1000 ? (v/1000).toFixed(0) + 'k' : v); } }, border: { display: false } } } } };
    var mrDetails = bookingDetails('month', null, function(row) { return row.statusGroup !== 'cancelled'; });
    renderInteractiveChart(ctx13, mrChartCfg, function(event) { openSelected(event, ctx13, 'Monthly Booked Value Trend', 'Bookings contributing to the selected month and service segment', mrChartCfg, mrDetails, { bookedValue:mrDetails.reduce(function(sum,row){return sum+(Number(row.amount)||0);},0) }, function(row,label,dataset){return row.month===label && (dataset==='Total'||row.segment===(dataset==='Core'?'Core Service':'Repair'));}); });
  }

  /* -- Priority Distribution -- */
  var ctx14 = document.getElementById("priorityChart");
  if (ctx14) {
    var prLabels = ["Low", "Medium", "High", "Critical"];
    var prData = [SA.priorityBreakdown.low || 0, SA.priorityBreakdown.medium || 0, SA.priorityBreakdown.high || 0, SA.priorityBreakdown.critical || 0];
    var prColors = ["#94a3b8", "#3b82f6", "#f59e0b", "#ef4444"];
    var prChartCfg = { type: "doughnut", data: { labels: prLabels, datasets: [{ data: prData, backgroundColor: prColors, borderWidth: 3, borderColor: "#fff", hoverOffset: 6 }] }, options: { responsive: true, maintainAspectRatio: false, cutout: "60%", animation: { duration: 1200 }, plugins: { legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 8, padding: 12 } }, tooltip: { backgroundColor: '#0f172a', padding: 10, cornerRadius: 8 } } } };
    var prDetails = bookingDetails('priority', function(row) { var p=String(row.priority||'medium'); return p.charAt(0).toUpperCase()+p.slice(1); });
    renderInteractiveChart(ctx14, prChartCfg, function(event) { openSelected(event, ctx14, 'Priority Distribution', 'Bookings assigned the selected operational priority', prChartCfg, prDetails, { bookings:prDetails.length }); });
  }

  /* -- Appliance Type Breakdown -- */
  var ctx15 = document.getElementById("applianceChart");
  if (ctx15) {
    var apLabels = SA.applianceArray.length > 0 ? SA.applianceArray.map(function(a) { return a.type; }) : ["N/A"];
    var apData = SA.applianceArray.length > 0 ? SA.applianceArray.map(function(a) { return a.count; }) : [0];
    var apColors = ["#06b6d4", "#3b82f6", "#8b5cf6", "#f59e0b", "#10b981", "#ef4444"];
    var apChartCfg = { type: "bar", data: { labels: apLabels, datasets: [{ label: "Bookings", data: apData, backgroundColor: apColors.slice(0, apLabels.length), borderRadius: 6, barThickness: 24 }] }, options: { responsive: true, maintainAspectRatio: false, animation: { duration: 1200 }, plugins: { legend: { display: true, position: 'top', labels: { usePointStyle: true, boxWidth: 7 } }, tooltip: { backgroundColor: '#0f172a', padding: 10, cornerRadius: 8 } }, scales: { x: { grid: { display: false }, ticks: { color: '#94a3b8', font: { size: 10 } }, border: { display: false } }, y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { color: '#94a3b8', precision: 0 }, border: { display: false } } } } };
    var apDetails = bookingDetails('appliance');
    renderInteractiveChart(ctx15, apChartCfg, function(event) { openSelected(event, ctx15, 'Appliance Type Breakdown', 'Bookings for the selected appliance or unit type', apChartCfg, apDetails, { bookings:apDetails.length }); });
  }

  /* -- Sparklines -- */
  function createSparkline(id, data, color) {
    var c = document.getElementById(id); if (!c) return null;
    var ctx = c.getContext('2d');
    var h = c.height || 28;
    var grad = ctx.createLinearGradient(0, 0, 0, h);
    grad.addColorStop(0, color.replace(')', ',0.2)').replace('rgb', 'rgba'));
    grad.addColorStop(1, 'rgba(255,255,255,0)');
    return new Chart(c, { type: 'line', data: { labels: data.map(function(_,i){return i+1;}), datasets: [{ data: data, borderColor: color, backgroundColor: grad, fill: true, tension: 0.4, borderWidth: 1.5 }] }, options: { responsive: true, maintainAspectRatio: false, animation: { duration: 800 }, plugins: { legend: { display: false }, tooltip: { enabled: false } }, elements: { point: { radius: 0 } }, scales: { x: { display: false }, y: { display: false } } } });
  }

  var baseData = serviceAnalytics.dailyTrend.length > 0 ? serviceAnalytics.dailyTrend.map(function(d) { return d.bookings; }) : [0,0,0,0,0,0,0];
  var predicted = (serviceAnalytics.bookingForecast || []).map(function(row) { return row.bookings; });
  var revenuePerBooking = serviceAnalytics.avgBookingValue > 0 ? serviceAnalytics.avgBookingValue : 0;

  createSparkline('kpiSparkTotalBookings', baseData, '#3b82f6');
  createSparkline('kpiSparkCompletion', serviceAnalytics.dailyTrend.length > 0 ? serviceAnalytics.dailyTrend.map(function(d) { return d.completed; }) : [0,0,0,0,0,0,0], '#10b981');
  createSparkline('kpiSparkRevenue', baseData.map(function(v) { return v * revenuePerBooking; }), '#f59e0b');
  createSparkline('kpiSparkProjected', predicted, '#8b5cf6');
  createSparkline('kpiSparkTechs', [serviceAnalytics.activeTechnicianCount], '#06b6d4');
  createSparkline('kpiSparkRating', serviceAnalytics.weeklyCsat.length > 0 ? serviceAnalytics.weeklyCsat.map(function(w) { return w.avg; }) : [0,0,0,0,0,0], '#ef4444');

  /* -- Pipeline bars -- */
  document.querySelectorAll('[data-completion]').forEach(function(el) {
    el.style.width = el.getAttribute('data-completion') + '%';
  });

  /* -- Progress bars -- */
  document.querySelectorAll('[data-completion-rate],[data-resource-utilization],[data-csat-score],[data-revenue-target]').forEach(function(bar) {
    var val = bar.getAttribute('data-completion-rate') || bar.getAttribute('data-resource-utilization') || bar.getAttribute('data-csat-score') || bar.getAttribute('data-revenue-target') || 0;
    bar.style.width = val + '%';
  });

  /* -- CSV Export -- */
  document.getElementById('exportReportBtn').addEventListener('click', function() {
    var columns = ['reference','date','customer','contact','service','segment','status','technician','payment','scale','brand','appliance','rating','amount'];
    function csvCell(value) {
      var text = value == null ? '' : String(value);
      return '"' + text.replace(/"/g, '""') + '"';
    }
    var rows = [columns.map(csvCell).join(',')];
    serviceAnalytics.bookingDrilldown.forEach(function(row) {
      rows.push(columns.map(function(column) { return csvCell(row[column]); }).join(','));
    });
    var csv = '\uFEFF' + rows.join('\r\n');
    var blob = new Blob([csv], { type: 'text/csv' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a'); a.href = url; a.download = 'service-report-' + new Date().toISOString().slice(0,10) + '.csv'; a.click();
    URL.revokeObjectURL(url);
  });
}

function waitForCharts() {
  if (typeof Chart === 'undefined') { setTimeout(waitForCharts, 100); return; }
  requestAnimationFrame(function() { setTimeout(initCharts, 50); });
}
if (document.readyState === 'loading') { window.addEventListener('DOMContentLoaded', waitForCharts); } else { waitForCharts(); }

function setupReportNav() {
  var nav = document.getElementById('reportNav');
  if (!nav) return;
  var buttons = nav.querySelectorAll('.report-nav-btn');
  buttons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var target = btn.dataset.target;
      if (target === 'top') {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        var el = document.getElementById(target);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      buttons.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
    });
  });
  var trigger = document.getElementById('reportNavTrigger');
  var icon = document.getElementById('reportNavTriggerIcon');
  var label = document.getElementById('reportNavTriggerLabel');
  if (trigger) {
    trigger.addEventListener('click', function() {
      nav.classList.toggle('open');
      if (icon) {
        icon.classList.toggle('bi-list');
        icon.classList.toggle('bi-x-lg');
      }
      if (label) {
        label.textContent = nav.classList.contains('open') ? 'Close' : 'Sections';
      }
    });
  }
}
if (document.readyState === 'loading') { window.addEventListener('DOMContentLoaded', setupReportNav); } else { setupReportNav(); }
</script>

<!-- ═══ PAGINATION FOR COMPLETED SERVICES & EQUIPMENT TABLES ═══ -->
<script>
(() => {
  const PAGE_SIZE = 10;

  function paginateTable(rows, infoId, buttonsId) {
    const rowsArr = Array.from(rows);
    if (!rowsArr.length) return;
    let page = 1;
    const totalPages = Math.max(1, Math.ceil(rowsArr.length / PAGE_SIZE));
    const info = document.getElementById(infoId);
    const btns = document.getElementById(buttonsId);

    function render() {
      const start = (page - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      rowsArr.forEach((row, i) => {
        row.style.display = (i >= start && i < end) ? '' : 'none';
      });
      info.textContent = `Showing ${start + 1}–${Math.min(end, rowsArr.length)} of ${rowsArr.length}`;
      btns.innerHTML = '';
      const addBtn = (label, p, disabled, active) => {
        const btn = document.createElement('button');
        btn.className = 'btn btn-sm' + (active ? ' btn-primary' : ' btn-outline-secondary');
        btn.style.cssText = 'font-size:.7rem;padding:4px 10px;border-radius:6px;min-width:32px;';
        btn.innerHTML = label;
        btn.disabled = disabled;
        btn.addEventListener('click', () => { page = p; render(); });
        btns.appendChild(btn);
      };
      addBtn('<i class="bi bi-chevron-left"></i>', page - 1, page === 1, false);
      if (totalPages <= 7) {
        for (let i = 1; i <= totalPages; i++) addBtn(String(i), i, false, i === page);
      } else {
        addBtn('1', 1, false, page === 1);
        if (page > 3) addBtn('...', page, true, false);
        for (let i = Math.max(2, page - 1); i <= Math.min(totalPages - 1, page + 1); i++) {
          addBtn(String(i), i, false, i === page);
        }
        if (page < totalPages - 2) addBtn('...', page, true, false);
        addBtn(String(totalPages), totalPages, false, page === totalPages);
      }
      addBtn('<i class="bi bi-chevron-right"></i>', page + 1, page === totalPages, false);
    }
    render();
  }

  // Initialize pagination on both tables
  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  function init() {
    paginateTable(document.querySelectorAll('.cs-row'), 'csPageInfo', 'csPageButtons');
    paginateTable(document.querySelectorAll('.eu-row'), 'euPageInfo', 'euPageButtons');
    paginateTable(document.querySelectorAll('.lp-row'), 'lpPageInfo', 'lpPageButtons');
  }
})();
</script>
