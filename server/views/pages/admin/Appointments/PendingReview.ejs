  /* ── Repair Queue Status Badges ────────────────── */
  .rq-badge { padding: 3px 8px; border-radius: 20px; font-size: 0.68rem; font-weight: 600; }
  .rq-stat-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px 16px; display: flex; align-items: center; gap: 10px; transition: all 0.2s; }
  .rq-stat-card:hover { border-color: #cbd5e1; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
  .rq-stat-icon { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; flex-shrink: 0; }
  .rq-stat-value { font-size: 1.3rem; font-weight: 800; color: #1e293b; }
  .rq-stat-label { font-size: 0.72rem; color: #64748b; }
  .rq-badge-repair_requested { background: #fef3c7; color: #92400e; }
  .rq-badge-pending_inspection { background: #fef3c7; color: #92400e; }
  .rq-badge-inspection_scheduled { background: #dbeafe; color: #1e40af; }
  .rq-badge-inspection_in_progress { background: #e0e7ff; color: #3730a3; }
  .rq-badge-inspection_completed { background: #d1fae5; color: #065f46; }
  .rq-badge-awaiting_approval { background: #fce7f3; color: #9d174d; }
  .rq-badge-repair_approved { background: #d1fae5; color: #065f46; }
  .rq-badge-repair_declined { background: #fee2e2; color: #991b1b; }
  .rq-badge-waiting_parts { background: #fef3c7; color: #92400e; }
  .rq-badge-ready_for_repair { background: #d1fae5; color: #065f46; }
  .rq-badge-repair_in_progress { background: #e0e7ff; color: #3730a3; }
  .rq-badge-repair_completed { background: #d1fae5; color: #065f46; }
  .rq-priority-badge { font-size: 0.6rem; padding: 2px 6px; border-radius: 999px; font-weight: 700; }
</style>

<script>
  let currentPage = 1;
  let totalPages = 1;
  const LIMIT = 15;
  let allBookings = []; // stores all fetched bookings for client-side filtering

  async function loadPendingBookings(page = 1) {
    const search = document.getElementById('searchInput')?.value || '';
    try {
      const [listRes, statsRes] = await Promise.all([
        fetch(`/api/admin/appointments/list?stage=pending_review&page=1&limit=500&search=${encodeURIComponent(search)}`),
        fetch('/api/admin/appointments/flow-stats')
      ]);

      const listData = await listRes.json();
      const statsData = await statsRes.json();

      renderStats(statsData.stages);
      allBookings = listData.bookings || [];
      applyFilters(page);
    } catch (e) {
      console.error('Failed to load pending bookings:', e);
    }
  }

  function applyFilters(page = 1) {
    const paymentStatus = document.getElementById('filterPaymentStatus')?.value || '';
    const paymentMethod = document.getElementById('filterPaymentMethod')?.value || '';
    const dateRange = document.getElementById('filterDateRange')?.value || '';
    const sort = document.getElementById('filterSort')?.value || 'newest';

    // Check if any filters are active
    const hasFilters = paymentStatus || paymentMethod || dateRange;
    const clearBtn = document.getElementById('clearFiltersBtn');
    if (clearBtn) clearBtn.classList.toggle('d-none', !hasFilters);

    let filtered = [...allBookings];

    // Payment Status filter
    if (paymentStatus) {
      filtered = filtered.filter(b => b.paymentStatus === paymentStatus);
    }

    // Payment Method filter
    if (paymentMethod) {
      filtered = filtered.filter(b => (b.paymentMethod || '').toLowerCase() === paymentMethod);
    }

    // Date Range filter
    if (dateRange) {
      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      filtered = filtered.filter(b => {
        const bDate = new Date(b.preferredDate || b.bookingDate);
        const bDay = new Date(bDate.getFullYear(), bDate.getMonth(), bDate.getDate());
        switch (dateRange) {
          case 'today': return bDay.getTime() === today.getTime();
          case 'yesterday': {
            const yesterday = new Date(today); yesterday.setDate(yesterday.getDate() - 1);
            return bDay.getTime() === yesterday.getTime();
          }
          case 'this_week': {
            const weekStart = new Date(today); weekStart.setDate(weekStart.getDate() - weekStart.getDay());
            return bDay >= weekStart;
          }
          case 'this_month': return bDate.getMonth() === now.getMonth() && bDate.getFullYear() === now.getFullYear();
          case 'last_month': {
            const lm = new Date(now.getFullYear(), now.getMonth() - 1, 1);
            return bDate.getMonth() === lm.getMonth() && bDate.getFullYear() === lm.getFullYear();
          }
          default: return true;
        }
      });
    }

    // Sort
    switch (sort) {
      case 'oldest': filtered.sort((a, b) => new Date(a.preferredDate || a.bookingDate) - new Date(b.preferredDate || b.bookingDate)); break;
      case 'amount_high': filtered.sort((a, b) => (b.totalPrice || b.estimatedFee || 0) - (a.totalPrice || a.estimatedFee || 0)); break;
      case 'amount_low': filtered.sort((a, b) => (a.totalPrice || a.estimatedFee || 0) - (b.totalPrice || b.estimatedFee || 0)); break;
      default: filtered.sort((a, b) => new Date(b.preferredDate || b.bookingDate) - new Date(a.preferredDate || a.bookingDate)); break;
    }

    // Update filter count display
    const filterCountEl = document.getElementById('filterResultCount');
    if (filterCountEl) {
      filterCountEl.textContent = hasFilters ? `Showing ${filtered.length} of ${allBookings.length}` : '';
    }

    // Paginate
    const totalItems = filtered.length;
    totalPages = Math.max(1, Math.ceil(totalItems / LIMIT));
    currentPage = Math.min(page, totalPages);
    const start = (currentPage - 1) * LIMIT;
    const paged = filtered.slice(start, start + LIMIT);

    renderTable(paged);
    renderPagination({ page: currentPage, limit: LIMIT, total: totalItems, pages: totalPages });
  }

  function renderStats(stages) {
    document.getElementById('pendingCount').textContent = stages.PENDING_REVIEW?.count || 0;
    document.getElementById('awaitingCount').textContent = stages.ASSIGNMENT_QUEUE?.count || 0;
    document.getElementById('rejectedCount').textContent = stages.REJECTED?.count || 0;
    document.getElementById('queueCount').textContent = stages.ASSIGNMENT_QUEUE?.count || 0;
  }

  function renderTable(bookings) {
    const tbody = document.getElementById('bookingsTableBody');
    document.getElementById('resultCount').textContent = bookings.length;

    if (!bookings.length) {
      tbody.innerHTML = `<tr><td colspan="7" class="text-center py-5 text-muted">
        <i class="bi bi-inbox" style="font-size: 2.5rem;"></i>
        <div class="mt-2">No pending bookings</div></td></tr>`;
      return;
    }

    tbody.innerHTML = bookings.map(b => {
      const date = new Date(b.preferredDate || b.bookingDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      const isCOD = b.paymentMethod === 'cod';
      const total = b.totalPrice || b.estimatedFee || 0;
      const downpayment = b.downpaymentAmount || (isCOD ? 400 : 0);
      const balance = b.balanceAmount > 0 ? b.balanceAmount : (isCOD ? Math.max(0, total - downpayment) : 0);
      const paymentLabel = b.paymentStatus === 'paid' ? 'Paid in Full' : b.paymentStatus === 'partial' ? 'Downpayment Only' : 'Pending';
      const paymentClass = b.paymentStatus === 'paid' ? 'payment-paid' : b.paymentStatus === 'partial' ? 'payment-partial' : 'payment-pending';
      return `<tr>
        <td><code class="small">${b.bookingReference || b.workOrderNumber || 'N/A'}</code></td>
        <td>
          <div class="fw-semibold small">${b.customer?.name || 'N/A'}</div>
          <div class="text-muted" style="font-size:0.7rem;">${b.customer?.email || ''}</div>
        </td>
        <td><span class="small">${b.service?.name || (b.services?.[0]?.name) || (b.serviceModel === 'RepairService' || b.serviceType === 'repair' ? 'Repair Service' : 'N/A')}</span></td>
        <td><span class="small">${date}</span></td>
        <td>
          <div class="fw-semibold">₱${total.toLocaleString()}</div>
          ${isCOD ? `<div style="font-size:0.7rem;color:#64748b;">DP ₱${downpayment.toLocaleString()} + Bal ₱${balance.toLocaleString()}</div>` : ''}
        </td>
        <td>
          <span class="payment-badge ${paymentClass}">${paymentLabel}</span>
          ${isCOD && b.paymentStatus !== 'paid' ? `<div style="font-size:0.68rem;color:#d97706;margin-top:2px;">Balance due on completion</div>` : ''}
        </td>
        <td class="text-center">
          <div class="d-flex gap-1 justify-content-center">
            <button class="btn btn-sm btn-outline-info action-btn" onclick="viewDetail('${b._id}')" title="View Details">
              <i class="bi bi-eye"></i>
            </button>
            <button class="btn btn-sm btn-outline-success action-btn" onclick="verifyPayment('${b._id}')" title="Verify Payment">
              <i class="bi bi-check-lg"></i> Verify
            </button>
            <button class="btn btn-sm btn-outline-danger action-btn" onclick="openReject('${b._id}')" title="Reject">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        </td>
      </tr>`;
    }).join('');
  }

  function renderPagination(p) {
    document.getElementById('paginationInfo').textContent = `Showing ${((p.page - 1) * p.limit) + 1}-${Math.min(p.page * p.limit, p.total)} of ${p.total}`;
    const pag = document.getElementById('pagination');
    let html = '';
    if (p.pages > 1) {
      html += `<li class="page-item ${p.page === 1 ? 'disabled' : ''}"><a class="page-link" href="#" onclick="loadPendingBookings(${p.page - 1});return false;">&laquo;</a></li>`;
      for (let i = 1; i <= p.pages; i++) {
        html += `<li class="page-item ${i === p.page ? 'active' : ''}"><a class="page-link" href="#" onclick="loadPendingBookings(${i});return false;">${i}</a></li>`;
      }
      html += `<li class="page-item ${p.page === p.pages ? 'disabled' : ''}"><a class="page-link" href="#" onclick="loadPendingBookings(${p.page + 1});return false;">&raquo;</a></li>`;
    }
    pag.innerHTML = html;
  }

  async function verifyPayment(id) {
    if (!confirm('Verify payment for this booking?')) return;
    try {
      const res = await fetch(`/api/admin/appointments/${id}/verify-payment`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ notes: 'Payment verified by admin' }) });
      const data = await res.json();
      if (data.success) {
        await fetch(`/api/admin/appointments/${id}/move-to-queue`, { method: 'POST' });
        showNotification({ type: 'success', title: 'Payment Verified', message: 'Booking has been verified and moved to assignment queue.', duration: 4000 });
        loadPendingBookings(currentPage);
      } else {
        showNotification({ type: 'error', title: 'Verification Failed', message: data.error || 'Failed to verify payment.', duration: 5000 });
      }
    } catch (e) { showNotification({ type: 'error', title: 'Error', message: 'An error occurred while verifying payment.', duration: 5000 }); }
  }

  function openReject(id) {
    document.getElementById('rejectBookingId').value = id;
    document.getElementById('rejectReason').value = '';
    document.getElementById('rejectNote').value = '';
    new bootstrap.Modal(document.getElementById('rejectModal')).show();
  }

  async function confirmReject() {
    const id = document.getElementById('rejectBookingId').value;
    const reason = document.getElementById('rejectReason').value;
    const note = document.getElementById('rejectNote').value;
    if (!reason) { showNotification({ type: 'warning', title: 'Required', message: 'Please select a rejection reason.', duration: 3000 }); return; }
    try {
      const res = await fetch(`/api/admin/appointments/${id}/reject`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason, note }) });
      const data = await res.json();
      if (data.success) {
        bootstrap.Modal.getInstance(document.getElementById('rejectModal')).hide();
        showNotification({ type: 'success', title: 'Booking Rejected', message: 'The booking has been rejected and the customer will be notified.', duration: 4000 });
        loadPendingBookings(currentPage);
      } else {
        showNotification({ type: 'error', title: 'Rejection Failed', message: data.error || 'Failed to reject booking.', duration: 5000 });
      }
    } catch (e) { showNotification({ type: 'error', title: 'Error', message: 'An error occurred while rejecting the booking.', duration: 5000 }); }
  }

  async function viewDetail(id) {
    try {
      const res = await fetch(`/api/admin/appointments/${id}`);
      const data = await res.json();
      const b = data.booking;
      const date = new Date(b.preferredDate || b.bookingDate).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
      const stLabel = (b.status || '').replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());

      const isRepair = b.serviceType === 'repair' || b.serviceModel === 'RepairService';
      const serviceName = b.service?.name || (b.services?.map(s => s.name).join(', ')) || (isRepair ? 'Repair Service' : 'N/A');
      const referenceText = b.bookingReference || b.workOrderNumber || `#${String(b._id).slice(-6).toUpperCase()}`;

      document.getElementById('detailTitle').textContent = `Booking ${referenceText}`;
      document.getElementById('detailBody').innerHTML = `
        <div class="ent-detail-grid">
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon bg-primary-subtle"><i class="bi bi-person-fill text-primary"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Customer</span>
              <span class="ent-detail-value">${b.customer?.name || 'N/A'}</span>
              <span class="ent-detail-sub">${b.customer?.email || ''}</span>
              <span class="ent-detail-sub">${b.customer?.phone || ''}</span>
            </div>
          </div>
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon bg-success-subtle"><i class="bi bi-tools text-success"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Service</span>
              <span class="ent-detail-value">${serviceName}</span>
              <span class="ent-detail-sub">${date}</span>
              <span class="ent-detail-sub">${b.startTime && b.endTime ? b.startTime + ' – ' + b.endTime : b.preferredTime || b.startTime || ''}</span>
            </div>
          </div>
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon bg-warning-subtle"><i class="bi bi-cash-stack text-warning"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Payment</span>
              <span class="ent-detail-value fw-bold">₱${(b.totalPrice || b.estimatedFee || 0).toLocaleString()}</span>
              <span class="ent-detail-sub">${(b.paymentMethod || 'N/A').toUpperCase()} &middot; ${b.paymentStatus || 'pending'}</span>
              ${(() => {
                const total = b.totalPrice || b.estimatedFee || 0;
                const isCOD = b.paymentMethod === 'cod';
                const downpayment = b.downpaymentAmount || (isCOD ? 400 : 0);
                const balance = b.balanceAmount > 0 ? b.balanceAmount : (isCOD ? Math.max(0, total - downpayment) : 0);
                if (!isCOD) return '';
                return `
              <div style="margin-top:6px;padding:6px 8px;background:#fffbeb;border-radius:6px;border:1px solid #fde68a;">
                <div style="font-size:0.72rem;color:#92400e;">
                  <div class="d-flex justify-content-between"><span>Downpayment:</span><span class="fw-semibold">₱${downpayment.toLocaleString()}</span></div>
                  <div class="d-flex justify-content-between"><span>Balance (on-site):</span><span class="fw-semibold">₱${balance.toLocaleString()}</span></div>
                  ${b.amountPaid ? `<div class="d-flex justify-content-between mt-1 pt-1 border-top" style="border-color:#fde68a !important;"><span>Collected so far:</span><span class="fw-bold text-success">₱${b.amountPaid.toLocaleString()}</span></div>` : ''}
                </div>
              </div>`;
              })()}
            </div>
          </div>
          <div class="ent-detail-card">
            <div class="ent-detail-card-icon bg-dark-subtle"><i class="bi bi-flag-fill text-dark"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Status</span>
              <span class="ent-detail-value"><span class="badge bg-${b.paymentStatus === 'paid' ? 'success' : 'warning'}">${stLabel}</span></span>
            </div>
          </div>
          <div class="ent-detail-card ent-detail-card-wide">
            <div class="ent-detail-card-icon bg-secondary-subtle"><i class="bi bi-geo-alt-fill text-secondary"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Service Location</span>
              <span class="ent-detail-value">${b.location?.address || 'N/A'}</span>
            </div>
          </div>
          ${isRepair && b.unitInfo ? `<div class="ent-detail-card ent-detail-card-wide">
            <div class="ent-detail-card-icon bg-info-subtle"><i class="bi bi-wrench text-info"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Unit Information</span>
              <span class="ent-detail-value">${b.unitInfo.unitType || ''} ${b.unitInfo.brand || ''} ${b.unitInfo.model || ''}</span>
              ${b.unitInfo.problemDescription ? `<span class="ent-detail-sub">${b.unitInfo.problemDescription}</span>` : ''}
            </div>
          </div>` : ''}
          ${b.issueDescription ? `<div class="ent-detail-card ent-detail-card-wide">
            <div class="ent-detail-card-icon bg-danger-subtle"><i class="bi bi-exclamation-triangle text-danger"></i></div>
            <div class="ent-detail-card-content">
              <span class="ent-detail-label">Issue Description</span>
              <span class="ent-detail-value">${b.issueDescription}</span>
            </div>
          </div>` : ''}
          ${(() => {
            // Collect all available photos from any source on the booking
            const photos = [];
            if (b.paymentProof) photos.push(b.paymentProof);
            if (data.payment && data.payment.proofUrl) { if (!photos.includes(data.payment.proofUrl)) photos.push(data.payment.proofUrl); }
            if (b.imageUrl) { if (!photos.includes(b.imageUrl)) photos.push(b.imageUrl); }
            if (b.unitInfo && Array.isArray(b.unitInfo.photos)) b.unitInfo.photos.forEach(p => { if (p && !photos.includes(p)) photos.push(p); });
            if (!photos.length) return '';
            return `<div class="ent-detail-card ent-detail-card-wide">
            <div class="ent-detail-card-icon bg-success-subtle"><i class="bi bi-images text-success"></i></div>
            <div class="ent-detail-card-content" style="width: 100%;">
              <span class="ent-detail-label">Payment Receipt / Photos (${photos.length})</span>
              <div class="mt-3 d-flex flex-wrap gap-3 justify-content-start">
                ${photos.map((src, i) => `
                  <div style="background: #f8fafc; padding: 8px; border-radius: 8px; border: 1px solid #e2e8f0; flex: 0 0 auto;">
                    <img src="${src}" alt="Photo ${i + 1}" style="max-width: 260px; max-height: 220px; border-radius: 6px; cursor: pointer; object-fit: contain; display: block;" onclick="window.open('${src}', '_blank')" onerror="this.closest('div').innerHTML='<div class=\\'text-muted small p-2\\'>Image unavailable</div>'">
                    <div class="mt-1 text-muted text-center" style="font-size:0.7rem;">Photo ${i + 1} · Click to enlarge</div>
                  </div>`).join('')}
              </div>
            </div>
          </div>`;
          })()}
        </div>`;

      new bootstrap.Modal(document.getElementById('detailModal')).show();
    } catch (e) { showToast('Error loading details', 'error'); }
  }

  function refreshList() { loadPendingBookings(currentPage); }

  function showToast(msg, type = 'success') {
    const toast = document.createElement('div');
    toast.className = `toast align-items-center text-white bg-${type === 'error' ? 'danger' : type === 'warning' ? 'warning' : 'success'} border-0`;
    toast.setAttribute('role', 'alert');
    toast.innerHTML = `<div class="d-flex"><div class="toast-body">${msg}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>`;
    document.body.appendChild(toast);
    new bootstrap.Toast(toast).show();
    setTimeout(() => toast.remove(), 4000);
  }

  // Enterprise notification system
  function showNotification({ type = 'info', title = '', message = '', duration = 3000 }) {
    const colors = {
      success: { bg: '#f0fdf4', border: '#22c55e', icon: 'bi-check-circle-fill', iconColor: '#16a34a' },
      error: { bg: '#fef2f2', border: '#ef4444', icon: 'bi-x-circle-fill', iconColor: '#dc2626' },
      warning: { bg: '#fffbeb', border: '#f59e0b', icon: 'bi-exclamation-triangle-fill', iconColor: '#d97706' },
      info: { bg: '#eff6ff', border: '#3b82f6', icon: 'bi-info-circle-fill', iconColor: '#2563eb' }
    };
    const c = colors[type] || colors.info;
    const el = document.createElement('div');
    el.style.cssText = `position:fixed;top:20px;right:20px;z-index:99999;min-width:340px;max-width:420px;background:${c.bg};border:1px solid ${c.border};border-left:4px solid ${c.border};border-radius:12px;padding:16px 20px;box-shadow:0 10px 40px rgba(0,0,0,0.15);display:flex;align-items:flex-start;gap:12px;animation:slideInRight 0.3s ease;`;
    el.innerHTML = `<i class="bi ${c.icon}" style="font-size:1.3rem;color:${c.iconColor};margin-top:2px;"></i><div style="flex:1;"><div style="font-weight:700;font-size:0.9rem;color:#1e293b;margin-bottom:2px;">${title}</div><div style="font-size:0.82rem;color:#64748b;">${message}</div></div><button onclick="this.parentElement.remove()" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:1.1rem;padding:0;line-height:1;">&times;</button>`;
    document.body.appendChild(el);
    if (!document.getElementById('notif-styles')) {
      const style = document.createElement('style'); style.id = 'notif-styles';
      style.textContent = '@keyframes slideInRight{from{transform:translateX(100%);opacity:0;}to{transform:translateX(0);opacity:1;}}';
      document.head.appendChild(style);
    }
    setTimeout(() => { el.style.transition='all 0.3s ease'; el.style.opacity='0'; el.style.transform='translateX(100%)'; setTimeout(()=>el.remove(),300); }, duration);
  }

  function clearFilters() {
    document.getElementById('filterPaymentStatus').value = '';
    document.getElementById('filterPaymentMethod').value = '';
    document.getElementById('filterDateRange').value = '';
    document.getElementById('filterSort').value = 'newest';
    applyFilters(1);
  }

  // Init
  loadPendingBookings();

  // Search debounce
  let searchTimer;
  document.getElementById('searchInput')?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => loadPendingBookings(1), 400);
  });

  // Filter change handlers (instant apply)
  ['filterPaymentStatus', 'filterPaymentMethod', 'filterDateRange', 'filterSort'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', () => applyFilters(1));
  });
</script>
<script src="/js/repair-queue.js"></script>
