<link rel="stylesheet" href="/css/analytics.css">
<link rel="stylesheet" href="/css/service-report-focused.css?v=20260915-photo-evidence">
<link rel="stylesheet" href="/css/report-kpis.css?v=20260906-shared-kpis">

<%
  const report = analytics || {};
  const filters = report.filterContext || { range:'90', from:'', to:'', segment:'all', status:'all', scale:'all', payment:'all', technician:'all', brand:'all', service:'all', assignment:'all', priority:'all', appliance:'all', area:'all', valueBand:'all', sla:'all', warranty:'all', search:'' };
  const serviceCosts = report.serviceCosts || {};
  const controls = report.serviceControls || {};
  const totalBookings = Number(report.totalBookings || 0);
  const completedBookings = Number(report.completedBookings || 0);
  const completionRate = totalBookings ? (completedBookings / totalBookings) * 100 : 0;
  const completedValue = Number(serviceCosts.revenue || report.accurateCompletedRevenue || report.completedRevenue || 0);
  const contribution = Number(serviceCosts.grossProfit || 0);
  const contributionMargin = completedValue ? (contribution / completedValue) * 100 : 0;
  const laborCoverage = Number(controls.actualLaborCoverage || 0);
  const reportCoverage = Number(controls.reportCoverage || 0);
  const cancellationRate = Number(report.cancellationRate || 0);
  const topServices = Array.isArray(report.topServices) ? report.topServices.slice(0, 5) : [];
  const recentBookings = Array.isArray(report.recentBookings) ? report.recentBookings : [];
  const costRows = Array.isArray(report.completedServiceCosts) ? report.completedServiceCosts : [];
  const photoEvidenceReports = Array.isArray(report.photoEvidenceReports) ? report.photoEvidenceReports : [];
  const photoEvidenceCount = photoEvidenceReports.reduce((total, item) => total + (Array.isArray(item.photos) ? item.photos.length : 0), 0);
  const rangeLabels = { '7':'Last 7 days', '30':'Last 30 days', '90':'Last 90 days', '365':'Last 12 months', custom:'Custom period' };
  const rangeLabel = rangeLabels[filters.range] || 'Last 90 days';
  const formatMoney = value => Number(value || 0).toLocaleString('en-PH', { maximumFractionDigits: 0 });
  const formatNumber = value => Number(value || 0).toLocaleString('en-PH');
  const formatDate = value => value ? new Date(value).toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' }) : '—';
  const activeAdvancedFilters = [filters.status, filters.scale, filters.payment, filters.technician, filters.brand, filters.service, filters.assignment, filters.priority, filters.appliance, filters.area, filters.valueBand, filters.sla, filters.warranty].filter(value => value && value !== 'all').length + (filters.search ? 1 : 0);
  const attentionItems = [];
  if (Number(report.pendingBookings || 0) > 0) attentionItems.push({ tone:'warning', icon:'bi-hourglass-split', title: formatNumber(report.pendingBookings) + ' pending job' + (Number(report.pendingBookings) === 1 ? '' : 's'), text:'Review requests waiting for the next workflow action.', href:'/admin/appointments', action:'Open bookings' });
  if (cancellationRate >= 10) attentionItems.push({ tone:'danger', icon:'bi-x-octagon', title:cancellationRate.toFixed(1) + '% cancellation rate', text:'Review the recorded reasons before changing schedules or service offers.', href:'/admin/appointments/cancellation-log', action:'Review cancellations' });
  if (completedBookings > 0 && reportCoverage < 100) attentionItems.push({ tone:'info', icon:'bi-file-earmark-text', title:reportCoverage.toFixed(1) + '% report coverage', text:'Some completed jobs do not yet have a service report.', href:'/admin/appointments/repair-scheduling', action:'Review workflow' });
  if (completedBookings > 0 && laborCoverage < 100) attentionItems.push({ tone:'neutral', icon:'bi-calculator', title:laborCoverage.toFixed(1) + '% labor-cost coverage', text:'Contribution remains provisional until direct labor is fully recorded.', href:'/admin/appointments/expenses', action:'Review costs' });
  const visibleAttentionItems = attentionItems.slice(0, 3);
  const qualityControls = [
    { label:'Service report coverage', value:Number(controls.reportCoverage || 0).toFixed(1) + '%', context:(completedBookings || 0) + ' completed jobs in scope' },
    { label:'Report approval rate', value:Number(controls.approvedReportRate || 0).toFixed(1) + '%', context:'Non-draft service reports' },
    { label:'Feedback coverage', value:Number(controls.feedbackCoverage || 0).toFixed(1) + '%', context:'Completed jobs with a rating' },
    { label:'Follow-up required', value:Number(controls.followUpRate || 0).toFixed(1) + '%', context:Number(controls.followUpRequiredCount || 0) + ' reports flagged' },
    { label:'Completion cycle time', value:Number(controls.avgCompletionCycleHours || 0).toFixed(1) + 'h', context:Number(controls.cycleTimeSampleSize || 0) + ' assignment samples' },
    { label:'Parts fulfillment', value:Number(controls.partsFulfillmentRate || 0).toFixed(1) + '%', context:Number(controls.partsRequestCount || 0) + ' parts requests' },
    { label:'Reschedule rate', value:Number(controls.rescheduleRate || 0).toFixed(1) + '%', context:Number(controls.rescheduledBookings || 0) + ' rescheduled bookings' },
    { label:'Operational delay rate', value:Number(controls.delayRate || 0).toFixed(1) + '%', context:'Bookings with a delay event' }
  ];
%>

<div class="sr-shell" id="serviceReport">
  <header class="sr-hero">
    <div class="sr-hero-copy">
      <span class="sr-eyebrow"><i class="bi bi-bar-chart-line" aria-hidden="true"></i> Service intelligence</span>
      <h1>Service Performance</h1>
      <p>Completed work, operating efficiency, and direct service contribution.</p>
    </div>
    <div class="sr-period" aria-label="Active report period">
      <span>Reporting period</span>
      <strong><%= rangeLabel %></strong>
      <% if (filters.range === 'custom' && filters.from && filters.to) { %><small><%= formatDate(filters.from) %> – <%= formatDate(filters.to) %></small><% } %>
    </div>
  </header>

  <% if (typeof reportError !== 'undefined' && reportError) { %>
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
      <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span><%= reportError %></span>
    </div>
  <% } %>

  <form class="sr-filter-panel" method="get" action="/admin/reports/service" id="serviceReportFilters">
    <div class="sr-filter-primary">
      <label class="sr-field" for="reportRange"><span>Booking created</span><select name="range" id="reportRange">
        <option value="7" <%= filters.range === '7' ? 'selected' : '' %>>Last 7 days</option>
        <option value="30" <%= filters.range === '30' ? 'selected' : '' %>>Last 30 days</option>
        <option value="90" <%= filters.range === '90' ? 'selected' : '' %>>Last 90 days</option>
        <option value="365" <%= filters.range === '365' ? 'selected' : '' %>>Last 12 months</option>
        <option value="custom" <%= filters.range === 'custom' ? 'selected' : '' %>>Custom dates</option>
      </select></label>
      <label class="sr-field" for="reportSegment"><span>Service type</span><select name="segment" id="reportSegment">
        <option value="all">All services</option>
        <option value="core" <%= filters.segment === 'core' ? 'selected' : '' %>>Core services</option>
        <option value="repair" <%= filters.segment === 'repair' ? 'selected' : '' %>>Repair services</option>
      </select></label>
      <div class="sr-custom-dates <%= filters.range === 'custom' ? 'is-visible' : '' %>" id="customDateFilters">
        <label class="sr-field" for="reportFrom"><span>From</span><input id="reportFrom" type="date" name="from" value="<%= filters.from %>"></label>
        <label class="sr-field" for="reportTo"><span>To</span><input id="reportTo" type="date" name="to" value="<%= filters.to %>"></label>
      </div>
      <button type="submit" class="sr-button sr-button-primary" id="applyReportFilters"><i class="bi bi-funnel" aria-hidden="true"></i><span>Apply</span></button>
      <button type="button" class="sr-button" id="exportReportBtn"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
    </div>

    <details class="sr-more-filters" open>
      <summary>
        <span class="sr-more-title"><i class="bi bi-sliders" aria-hidden="true"></i><strong>Advanced filters</strong></span>
        <span class="sr-more-meta"><b>14 available</b><% if (activeAdvancedFilters) { %><em><%= activeAdvancedFilters %> active</em><% } %><i class="bi bi-chevron-down" aria-hidden="true"></i></span>
      </summary>
      <div class="sr-filter-secondary">
        <fieldset class="sr-filter-group"><legend><i class="bi bi-diagram-3" aria-hidden="true"></i> Workflow</legend><div class="sr-filter-grid">
          <label class="sr-field"><span>Status</span><select name="status"><option value="all">All statuses</option><% ['pending','payment_verified','awaiting_assignment','assigned','confirmed','scheduled','on-the-way','arrived','in-progress','inspection_scheduled','inspection_in_progress','inspection_completed','awaiting_approval','repair_approved','waiting_parts','parts_reserved','ready_for_repair','repair_scheduled','repair_in_progress','completed','repair_completed','closed','cancelled','rejected','repair_declined','no-show'].forEach(function(status) { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status.replace(/[-_]/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) %></option><% }); %></select></label>
          <label class="sr-field"><span>Technician</span><select name="technician"><option value="all">All technicians</option><% (report.technicians || []).forEach(function(technician) { %><option value="<%= technician._id %>" <%= filters.technician === String(technician._id) ? 'selected' : '' %>><%= technician.name %></option><% }); %></select></label>
          <label class="sr-field"><span>Assignment</span><select name="assignment"><option value="all">Any assignment state</option><option value="assigned" <%= filters.assignment === 'assigned' ? 'selected' : '' %>>Assigned</option><option value="unassigned" <%= filters.assignment === 'unassigned' ? 'selected' : '' %>>Unassigned</option></select></label>
          <label class="sr-field"><span>Priority</span><select name="priority"><option value="all">All priorities</option><option value="low" <%= filters.priority === 'low' ? 'selected' : '' %>>Low</option><option value="medium" <%= filters.priority === 'medium' ? 'selected' : '' %>>Medium</option><option value="high" <%= filters.priority === 'high' ? 'selected' : '' %>>High</option><option value="critical" <%= filters.priority === 'critical' ? 'selected' : '' %>>Critical</option></select></label>
          <label class="sr-field"><span>SLA</span><select name="sla"><option value="all">Any SLA state</option><option value="breached" <%= filters.sla === 'breached' ? 'selected' : '' %>>Breached</option><option value="compliant" <%= filters.sla === 'compliant' ? 'selected' : '' %>>Compliant</option><option value="not_tracked" <%= filters.sla === 'not_tracked' ? 'selected' : '' %>>Not tracked</option></select></label>
          <label class="sr-field"><span>Warranty</span><select name="warranty"><option value="all">Any warranty state</option><option value="active" <%= filters.warranty === 'active' ? 'selected' : '' %>>Active</option><option value="expired" <%= filters.warranty === 'expired' ? 'selected' : '' %>>Expired</option><option value="claimed" <%= filters.warranty === 'claimed' ? 'selected' : '' %>>Claimed</option><option value="none" <%= filters.warranty === 'none' ? 'selected' : '' %>>No warranty</option></select></label>
        </div></fieldset>
        <fieldset class="sr-filter-group"><legend><i class="bi bi-tools" aria-hidden="true"></i> Service &amp; location</legend><div class="sr-filter-grid">
          <label class="sr-field"><span>Service</span><select name="service"><option value="all">All service names</option><% (report.bookingServices || []).forEach(function(service) { %><option value="<%= service %>" <%= filters.service === service ? 'selected' : '' %>><%= service %></option><% }); %></select></label>
          <label class="sr-field"><span>Appliance / unit</span><select name="appliance"><option value="all">All appliance types</option><% (report.bookingApplianceTypes || []).forEach(function(appliance) { %><option value="<%= appliance %>" <%= filters.appliance === appliance ? 'selected' : '' %>><%= appliance %></option><% }); %></select></label>
          <label class="sr-field"><span>Brand</span><select name="brand"><option value="all">All brands</option><% (report.bookingBrands || []).forEach(function(brand) { %><option value="<%= brand %>" <%= filters.brand === brand ? 'selected' : '' %>><%= brand %></option><% }); %></select></label>
          <label class="sr-field"><span>Service area</span><select name="area"><option value="all">All service areas</option><% (report.bookingAreas || []).forEach(function(area) { %><option value="<%= area %>" <%= filters.area === area ? 'selected' : '' %>><%= area %></option><% }); %></select></label>
        </div></fieldset>
        <fieldset class="sr-filter-group"><legend><i class="bi bi-cash-coin" aria-hidden="true"></i> Commercial</legend><div class="sr-filter-grid">
          <label class="sr-field"><span>Scale</span><select name="scale"><option value="all">All scales</option><option value="standard" <%= filters.scale === 'standard' ? 'selected' : '' %>>Standard</option><option value="large" <%= filters.scale === 'large' ? 'selected' : '' %>>Large-scale projects</option></select></label>
          <label class="sr-field"><span>Payment</span><select name="payment"><option value="all">All methods</option><option value="gcash" <%= filters.payment === 'gcash' ? 'selected' : '' %>>GCash</option><option value="cod" <%= filters.payment === 'cod' ? 'selected' : '' %>>Cash / COD</option><option value="other" <%= filters.payment === 'other' ? 'selected' : '' %>>Other</option></select></label>
          <label class="sr-field"><span>Booked value</span><select name="valueBand"><option value="all">All booked values</option><option value="under_1000" <%= filters.valueBand === 'under_1000' ? 'selected' : '' %>>Below &#8369;1,000</option><option value="1000_5000" <%= filters.valueBand === '1000_5000' ? 'selected' : '' %>>&#8369;1,000–4,999</option><option value="5000_10000" <%= filters.valueBand === '5000_10000' ? 'selected' : '' %>>&#8369;5,000–9,999</option><option value="10000_plus" <%= filters.valueBand === '10000_plus' ? 'selected' : '' %>>&#8369;10,000 and above</option></select></label>
          <label class="sr-field sr-field-search"><span>Search records</span><input type="search" name="search" value="<%= filters.search %>" placeholder="Reference, customer, issue…"></label>
        </div></fieldset>
        <div class="sr-filter-footer"><span>Filters apply to every KPI, chart, table, and export.</span><a class="sr-reset" href="/admin/reports/service"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset all filters</a></div>
      </div>
    </details>
  </form>

  <section class="report-kpi-grid" aria-label="Service report summary">
    <article class="sr-kpi kpi-enterprise" data-accent="blue">
      <div class="sr-kpi-top"><span class="sr-kpi-icon blue"><i class="bi bi-check2-circle" aria-hidden="true"></i></span><span class="sr-kpi-context">of <%= formatNumber(totalBookings) %> bookings</span></div>
      <span class="sr-kpi-label">Completed services</span><strong><%= formatNumber(completedBookings) %></strong>
      <small>Recognized lifecycle completions</small>
    </article>
    <article class="sr-kpi kpi-enterprise" data-accent="green">
      <div class="sr-kpi-top"><span class="sr-kpi-icon green"><i class="bi bi-speedometer2" aria-hidden="true"></i></span><span class="sr-kpi-context"><%= formatNumber(report.cancelledBookings) %> cancelled</span></div>
      <span class="sr-kpi-label">Completion rate</span><strong><%= completionRate.toFixed(1) %>%</strong>
      <small>Completed ÷ bookings in scope</small>
    </article>
    <article class="sr-kpi kpi-enterprise" data-accent="purple">
      <div class="sr-kpi-top"><span class="sr-kpi-icon purple"><i class="bi bi-cash-stack" aria-hidden="true"></i></span><span class="sr-kpi-context">completed work only</span></div>
      <span class="sr-kpi-label">Completed-service value</span><strong>&#8369;<%= formatMoney(completedValue) %></strong>
      <small>Not pending or booked pipeline value</small>
    </article>
    <article class="sr-kpi kpi-enterprise <%= laborCoverage < 100 && completedBookings ? 'is-provisional' : '' %>" data-accent="amber">
      <div class="sr-kpi-top"><span class="sr-kpi-icon amber"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span><span class="sr-kpi-context"><%= contributionMargin.toFixed(1) %>% margin</span></div>
      <span class="sr-kpi-label">Service contribution</span><strong class="<%= contribution < 0 ? 'is-negative' : '' %>">&#8369;<%= formatMoney(contribution) %></strong>
      <small><%= laborCoverage < 100 && completedBookings ? 'Provisional — ' + laborCoverage.toFixed(1) + '% labor-cost coverage' : 'After recorded direct service costs' %></small>
    </article>
  </section>

  <nav class="sr-tabs" aria-label="Service analytics views">
    <div class="nav" role="tablist">
      <button class="sr-tab active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-pane" type="button" role="tab" aria-controls="overview-pane" aria-selected="true">Overview</button>
      <button class="sr-tab" id="performance-tab" data-bs-toggle="tab" data-bs-target="#performance-pane" type="button" role="tab" aria-controls="performance-pane" aria-selected="false">Performance</button>
      <button class="sr-tab" id="cost-tab" data-bs-toggle="tab" data-bs-target="#cost-pane" type="button" role="tab" aria-controls="cost-pane" aria-selected="false">Cost &amp; contribution</button>
      <button class="sr-tab" id="quality-tab" data-bs-toggle="tab" data-bs-target="#quality-pane" type="button" role="tab" aria-controls="quality-pane" aria-selected="false">Quality</button>
      <button class="sr-tab" id="photos-tab" data-bs-toggle="tab" data-bs-target="#photos-pane" type="button" role="tab" aria-controls="photos-pane" aria-selected="false">Report photos <span class="sr-tab-count"><%= formatNumber(photoEvidenceCount) %></span></button>
      <button class="sr-tab" id="records-tab" data-bs-toggle="tab" data-bs-target="#records-pane" type="button" role="tab" aria-controls="records-pane" aria-selected="false">Records</button>
    </div>
  </nav>

  <div class="tab-content sr-tab-content">
    <div class="tab-pane fade show active" id="overview-pane" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">
      <div class="sr-overview-grid">
        <section class="sr-card sr-trend-card" aria-labelledby="trend-title">
          <header class="sr-card-header">
            <div><span class="sr-card-kicker">Trend</span><h2 id="trend-title">Service activity over time</h2></div>
            <div class="sr-chart-toggle" role="group" aria-label="Trend metric"><button type="button" class="active" data-trend="volume">Volume</button><button type="button" data-trend="value">Booked value</button></div>
          </header>
          <p class="sr-card-note" id="trendDefinition">Bookings created and completed during each reporting week.</p>
          <div class="sr-chart"><canvas id="serviceTrendChart" aria-label="Service activity trend"></canvas></div>
        </section>

        <aside class="sr-card sr-attention" aria-labelledby="attention-title">
          <header class="sr-card-header"><div><span class="sr-card-kicker">Action queue</span><h2 id="attention-title">Needs attention</h2></div><span class="sr-count"><%= visibleAttentionItems.length %></span></header>
          <% if (visibleAttentionItems.length) { %>
            <div class="sr-attention-list"><% visibleAttentionItems.forEach(function(item) { %><article class="sr-attention-item <%= item.tone %>"><i class="bi <%= item.icon %>" aria-hidden="true"></i><div><h3><%= item.title %></h3><p><%= item.text %></p><a href="<%= item.href %>"><%= item.action %> <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div></article><% }); %></div>
          <% } else { %>
            <div class="sr-clear-state"><i class="bi bi-check2-circle" aria-hidden="true"></i><strong>No priority exceptions</strong><p>No threshold-based issues were detected for this period.</p></div>
          <% } %>
        </aside>
      </div>

      <section class="sr-card sr-table-card" aria-labelledby="top-services-title">
        <header class="sr-card-header"><div><span class="sr-card-kicker">Service portfolio</span><h2 id="top-services-title">Top services</h2><p>Highest booking volume for the selected period.</p></div><a href="#performance-pane" class="sr-inline-link" data-open-tab="performance-tab">View performance details <i class="bi bi-arrow-right" aria-hidden="true"></i></a></header>
        <div class="table-responsive"><table class="sr-table"><thead><tr><th>Service</th><th>Type</th><th class="text-end">Bookings</th><th class="text-end">Completion</th><th class="text-end">Avg booked value</th><th class="text-end">Rating</th></tr></thead><tbody>
          <% if (topServices.length) { topServices.forEach(function(service) { %><tr><td><strong><%= service.name %></strong></td><td><span class="sr-badge"><%= service.type === 'repair' ? 'Repair' : 'Core' %></span></td><td class="text-end"><%= formatNumber(service.bookings) %></td><td class="text-end"><span class="sr-rate <%= service.completionRate >= 80 ? 'good' : service.completionRate >= 60 ? 'watch' : 'risk' %>"><%= Number(service.completionRate || 0).toFixed(0) %>%</span></td><td class="text-end">&#8369;<%= formatMoney(service.avgRevenue) %></td><td class="text-end"><%= Number(service.avgRating || 0) > 0 ? Number(service.avgRating).toFixed(1) : '—' %></td></tr><% }); } else { %><tr><td colspan="6" class="sr-empty">No service activity matches the selected filters.</td></tr><% } %>
        </tbody></table></div>
      </section>
    </div>

    <div class="tab-pane fade" id="performance-pane" role="tabpanel" aria-labelledby="performance-tab" tabindex="0">
      <div class="sr-detail-grid">
        <section class="sr-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Lifecycle</span><h2>Booking status</h2><p>Operational distribution across four decision states.</p></div></header><div class="sr-chart sr-chart-medium"><canvas id="serviceStatusChart" aria-label="Booking status distribution"></canvas></div></section>
        <section class="sr-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Cancellation</span><h2>Cancellation review</h2><p><%= formatNumber(report.cancelledBookings) %> cancelled bookings · <%= cancellationRate.toFixed(1) %>% of the cohort</p></div></header>
          <div class="sr-reason-list"><% if (report.cancellationReasonsArray && report.cancellationReasonsArray.length) { report.cancellationReasonsArray.slice(0, 5).forEach(function(reason) { const share = Number(report.cancelledBookings) ? (Number(reason.count) / Number(report.cancelledBookings)) * 100 : 0; %><div><span><strong><%= reason.reason %></strong><small><%= reason.count %> booking<%= Number(reason.count) === 1 ? '' : 's' %></small></span><span class="sr-bar"><i style="width:<%= Math.min(share, 100) %>%"></i></span><b><%= share.toFixed(0) %>%</b></div><% }); } else { %><div class="sr-clear-inline"><i class="bi bi-check-circle" aria-hidden="true"></i> No cancellation reasons recorded.</div><% } %></div>
        </section>
      </div>
      <section class="sr-card sr-related"><header class="sr-card-header"><div><span class="sr-card-kicker">Focused workspaces</span><h2>Continue the investigation</h2></div></header><div class="sr-related-grid"><a href="/admin/appointments"><i class="bi bi-calendar-check"></i><span><strong>Bookings</strong><small>Review individual workflow status</small></span></a><a href="/admin/appointments/cancellation-log"><i class="bi bi-x-circle"></i><span><strong>Cancellation log</strong><small>Inspect reasons and customer history</small></span></a><a href="/admin/operations/resolution-center"><i class="bi bi-life-preserver"></i><span><strong>Resolution center</strong><small>Handle active service exceptions</small></span></a></div></section>
    </div>

    <div class="tab-pane fade" id="cost-pane" role="tabpanel" aria-labelledby="cost-tab" tabindex="0">
      <div class="sr-cost-summary">
        <% [
          {label:'Completed-service value', value:completedValue, icon:'bi-cash-stack'},
          {label:'Recorded direct labor', value:serviceCosts.laborCost, icon:'bi-person-workspace'},
          {label:'Consumables & parts', value:Number(serviceCosts.partsCost || 0) + Number(serviceCosts.consumablesCost || 0), icon:'bi-tools'},
          {label:'Local purchases', value:serviceCosts.localPurchaseCost, icon:'bi-shop'},
          {label:'Service contribution', value:contribution, icon:'bi-graph-up-arrow'}
        ].forEach(function(item) { %><article><i class="bi <%= item.icon %>" aria-hidden="true"></i><span><small><%= item.label %></small><strong>&#8369;<%= formatMoney(item.value) %></strong></span></article><% }); %>
      </div>
      <% if (completedBookings && (laborCoverage < 100 || reportCoverage < 100)) { %><div class="sr-data-warning"><i class="bi bi-info-circle" aria-hidden="true"></i><div><strong>Contribution is provisional</strong><p>Labor-cost coverage is <%= laborCoverage.toFixed(1) %>%, and service-report coverage is <%= reportCoverage.toFixed(1) %>%. Missing records can overstate contribution.</p></div></div><% } %>
      <section class="sr-card sr-table-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Completed work</span><h2>Direct cost by service</h2><p>Reusable equipment is intentionally excluded from service expense.</p></div><a class="sr-inline-link" href="/admin/appointments/expenses">Manage expenses <i class="bi bi-arrow-right"></i></a></header><div class="table-responsive"><table class="sr-table"><thead><tr><th>Service</th><th>Reference</th><th class="text-end">Completed value</th><th class="text-end">Direct cost</th><th class="text-end">Contribution</th><th class="text-end">Margin</th></tr></thead><tbody>
        <% if (costRows.length) { costRows.slice(0, 20).forEach(function(row) { const rowCost = Number(row.laborCost || 0) + Number(row.partsCost || 0) + Number(row.consumablesCost || 0) + Number(row.localPurchaseCost || 0); %><tr><td><strong><%= row.serviceName %></strong><small class="sr-cell-sub"><%= row.technician %></small></td><td><%= row.reference %></td><td class="text-end">&#8369;<%= formatMoney(row.revenue) %></td><td class="text-end">&#8369;<%= formatMoney(rowCost) %></td><td class="text-end"><strong class="<%= Number(row.grossProfit) < 0 ? 'sr-negative' : 'sr-positive' %>">&#8369;<%= formatMoney(row.grossProfit) %></strong></td><td class="text-end"><%= Number(row.grossProfitMargin || 0).toFixed(1) %>%</td></tr><% }); } else { %><tr><td colspan="6" class="sr-empty">No completed service cost records in this period.</td></tr><% } %>
      </tbody></table></div></section>
    </div>

    <div class="tab-pane fade" id="quality-pane" role="tabpanel" aria-labelledby="quality-tab" tabindex="0">
      <div class="sr-detail-grid">
        <section class="sr-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Customer signal</span><h2>Satisfaction trend</h2><p>Average rating from submitted customer feedback.</p></div><span class="sr-rating"><i class="bi bi-star-fill"></i> <%= report.avgRating || '0.0' %></span></header><div class="sr-chart sr-chart-medium"><canvas id="serviceQualityChart" aria-label="Customer satisfaction trend"></canvas></div></section>
        <section class="sr-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Data quality</span><h2>Control coverage</h2><p>Compact controls for interpreting the report responsibly.</p></div></header><div class="sr-control-list"><% qualityControls.forEach(function(control) { %><div><span><strong><%= control.label %></strong><small><%= control.context %></small></span><b><%= control.value %></b></div><% }); %></div></section>
      </div>
      <section class="sr-card sr-related"><header class="sr-card-header"><div><span class="sr-card-kicker">Focused workspaces</span><h2>Quality follow-up</h2></div></header><div class="sr-related-grid"><a href="/admin/ratings/service"><i class="bi bi-star"></i><span><strong>Customer ratings</strong><small>Read feedback and rating detail</small></span></a><a href="/admin/ratings/technicians"><i class="bi bi-person-check"></i><span><strong>Technician ratings</strong><small>Review individual service quality</small></span></a><a href="/admin/warranty"><i class="bi bi-shield-check"></i><span><strong>Warranty</strong><small>Track coverage and claims</small></span></a></div></section>
    </div>

    <div class="tab-pane fade" id="photos-pane" role="tabpanel" aria-labelledby="photos-tab" tabindex="0">
      <section class="sr-card sr-evidence-section" aria-labelledby="report-photos-title">
        <header class="sr-card-header">
          <div><span class="sr-card-kicker">Field evidence</span><h2 id="report-photos-title">Service report photos</h2><p>Report attachments, inspection images, customer issue photos, and completion proof for the selected filters.</p></div>
          <span class="sr-evidence-total"><i class="bi bi-images" aria-hidden="true"></i><strong><%= formatNumber(photoEvidenceCount) %></strong><small>photo<%= photoEvidenceCount === 1 ? '' : 's' %></small></span>
        </header>
        <% if (photoEvidenceReports.length) { %>
          <div class="sr-evidence-grid">
            <% photoEvidenceReports.forEach(function(item) { const statusLabel = String(item.reportStatus || 'evidence_only').replace(/_/g, ' '); %>
              <article class="sr-evidence-card">
                <header>
                  <div><span class="sr-evidence-reference"><%= item.reference %></span><h3><%= item.service %></h3></div>
                  <span class="sr-evidence-status <%= item.reportStatus %>"><%= statusLabel %></span>
                </header>
                <div class="sr-evidence-photos">
                  <% item.photos.forEach(function(photo, photoIndex) { %>
                    <button type="button" class="sr-evidence-photo" data-evidence-photo data-evidence-title="<%= item.reference %> · <%= photo.label %>" data-evidence-meta="<%= item.service %> · <%= item.technician %>" aria-label="View <%= photo.label %> for <%= item.reference %>">
                      <img src="<%= photo.url %>" alt="<%= photo.label %> for <%= item.reference %>" loading="lazy" decoding="async">
                      <span><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i><%= photo.label %></span>
                    </button>
                  <% }); %>
                </div>
                <div class="sr-evidence-details">
                  <div><i class="bi bi-person" aria-hidden="true"></i><span><strong><%= item.customer %></strong><small>Customer</small></span></div>
                  <div><i class="bi bi-person-gear" aria-hidden="true"></i><span><strong><%= item.technician %></strong><small>Technician</small></span></div>
                  <div><i class="bi bi-calendar3" aria-hidden="true"></i><span><strong><%= formatDate(item.date) %></strong><small>Recorded</small></span></div>
                </div>
                <% if (item.findings || item.actionsTaken) { %><div class="sr-evidence-notes"><% if (item.findings) { %><p><strong>Findings:</strong> <%= item.findings %></p><% } %><% if (item.actionsTaken) { %><p><strong>Work done:</strong> <%= item.actionsTaken %></p><% } %></div><% } %>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <div class="sr-evidence-empty"><i class="bi bi-camera" aria-hidden="true"></i><strong>No service photos in this report period</strong><p>Photos will appear here after a technician attaches report, inspection, or completion evidence. Current report filters also apply to this gallery.</p></div>
        <% } %>
      </section>
    </div>

    <div class="tab-pane fade" id="records-pane" role="tabpanel" aria-labelledby="records-tab" tabindex="0">
      <section class="sr-card sr-table-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Audit trail</span><h2>Recent booking records</h2><p>The latest matching service records. Use Bookings for full workflow management.</p></div><a class="sr-inline-link" href="/admin/appointments">Open all bookings <i class="bi bi-arrow-right"></i></a></header><div class="table-responsive"><table class="sr-table"><thead><tr><th>Reference</th><th>Customer</th><th>Service</th><th>Technician</th><th class="text-end">Booked value</th><th>Status</th></tr></thead><tbody>
        <% if (recentBookings.length) { recentBookings.forEach(function(booking) { %><tr><td><strong><%= booking.reference || '—' %></strong></td><td><%= booking.customer %></td><td><%= booking.service %></td><td><%= booking.technician %></td><td class="text-end">&#8369;<%= formatMoney(booking.amount) %></td><td><span class="sr-badge"><%= String(booking.status || 'pending').replace(/[-_]/g, ' ') %></span></td></tr><% }); } else { %><tr><td colspan="6" class="sr-empty">No recent booking records match the selected filters.</td></tr><% } %>
      </tbody></table></div></section>
      <section class="sr-card sr-definitions"><header class="sr-card-header"><div><span class="sr-card-kicker">Definitions</span><h2>How to read this report</h2></div></header><dl><div><dt>Booked value</dt><dd>Value attached to non-cancelled bookings, whether or not the service has been completed.</dd></div><div><dt>Completed-service value</dt><dd>Value from services whose lifecycle is recognized as completed.</dd></div><div><dt>Direct service cost</dt><dd>Recorded internal labor, consumables, repair parts, and local purchases used for completed work.</dd></div><div><dt>Service contribution</dt><dd>Completed-service value less recorded direct service costs. It is provisional when cost coverage is incomplete.</dd></div></dl></section>
    </div>
  </div>
</div>

<div class="modal fade sr-evidence-modal" id="serviceEvidenceModal" tabindex="-1" aria-labelledby="serviceEvidenceTitle" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><div><h2 class="modal-title" id="serviceEvidenceTitle">Service photo</h2><p id="serviceEvidenceMeta"></p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close photo preview"></button></div>
      <div class="modal-body"><img id="serviceEvidencePreview" src="" alt="Selected service report photo"></div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<%
  const chartPayload = {
    weekly: report.weeklyData ? Object.entries(report.weeklyData).map(([label, row]) => ({ label, bookings:Number(row.bookings || 0), completed:Number(row.completed || 0), bookedValue:Number(row.revenue || 0) })) : [],
    status: [Number(report.completedBookings || 0), Number(report.inProgressBookings || 0), Number(report.pendingBookings || 0), Number(report.cancelledBookings || 0)],
    quality: Array.isArray(report.weeklyCsat) ? report.weeklyCsat.map(row => ({ label:row.week, value:Number(row.avg || 0) })) : [],
    exportRows: Array.isArray(report.bookingDrilldown) ? report.bookingDrilldown.map(row => ({ reference:row.reference, customer:row.customer, service:row.service, technician:row.technician, status:row.status, bookedValue:Number(row.amount || 0), date:row.date })) : []
  };
  const chartPayloadJson = JSON.stringify(chartPayload).replace(/</g, '\\u003c');
%>
<script>
(function () {
  'use strict';
  var data = <%- chartPayloadJson %>;
  var charts = {};
  var peso = new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP', maximumFractionDigits: 0 });
  var baseOptions = {
    responsive: true,
    maintainAspectRatio: false,
    animation: { duration: 350 },
    plugins: { legend: { labels: { usePointStyle: true, boxWidth: 8, padding: 18, color: '#475569', font: { size: 11, weight: '600' } } }, tooltip: { backgroundColor: '#0f172a', padding: 11, cornerRadius: 8 } },
    scales: { x: { grid: { display: false }, ticks: { color: '#64748b' } }, y: { beginAtZero: true, border: { display: false }, grid: { color: '#edf1f6' }, ticks: { color: '#64748b', precision: 0 } } }
  };

  function renderTrend(mode) {
    var canvas = document.getElementById('serviceTrendChart');
    if (!canvas || typeof Chart === 'undefined') return;
    if (charts.trend) charts.trend.destroy();
    var valueMode = mode === 'value';
    document.getElementById('trendDefinition').textContent = valueMode
      ? 'Booked value from non-cancelled requests created during each reporting week; this is not completed revenue.'
      : 'Bookings created and completed during each reporting week.';
    charts.trend = new Chart(canvas, {
      type: valueMode ? 'bar' : 'line',
      data: { labels: data.weekly.map(function (row) { return row.label; }), datasets: valueMode
        ? [{ label:'Booked value', data:data.weekly.map(function (row) { return row.bookedValue; }), backgroundColor:'#2563eb', borderRadius:6 }]
        : [{ label:'Bookings', data:data.weekly.map(function (row) { return row.bookings; }), borderColor:'#2563eb', backgroundColor:'rgba(37,99,235,.1)', fill:true, tension:.35 }, { label:'Completed', data:data.weekly.map(function (row) { return row.completed; }), borderColor:'#10b981', backgroundColor:'transparent', tension:.35 }]
      },
      options: Object.assign({}, baseOptions, { plugins:Object.assign({}, baseOptions.plugins, { tooltip:Object.assign({}, baseOptions.plugins.tooltip, { callbacks:{ label:function (context) { return valueMode ? ' ' + peso.format(context.parsed.y || 0) : ' ' + context.dataset.label + ': ' + context.parsed.y; } } }) }) })
    });
  }

  function renderSecondaryCharts() {
    if (typeof Chart === 'undefined') return;
    var statusCanvas = document.getElementById('serviceStatusChart');
    if (statusCanvas) charts.status = new Chart(statusCanvas, { type:'doughnut', data:{ labels:['Completed','In progress','Pending','Cancelled'], datasets:[{ data:data.status, backgroundColor:['#10b981','#3b82f6','#f59e0b','#ef4444'], borderWidth:0, hoverOffset:4 }] }, options:{ responsive:true, maintainAspectRatio:false, cutout:'68%', plugins:baseOptions.plugins } });
    var qualityCanvas = document.getElementById('serviceQualityChart');
    if (qualityCanvas) charts.quality = new Chart(qualityCanvas, { type:'line', data:{ labels:data.quality.map(function (row) { return row.label; }), datasets:[{ label:'Average rating', data:data.quality.map(function (row) { return row.value; }), borderColor:'#f59e0b', backgroundColor:'rgba(245,158,11,.1)', fill:true, tension:.35 }] }, options:Object.assign({}, baseOptions, { scales:{ x:baseOptions.scales.x, y:Object.assign({}, baseOptions.scales.y, { min:0, max:5, ticks:{ stepSize:1, color:'#64748b' } }) } }) });
  }

  document.querySelectorAll('[data-trend]').forEach(function (button) { button.addEventListener('click', function () { document.querySelectorAll('[data-trend]').forEach(function (item) { item.classList.remove('active'); }); button.classList.add('active'); renderTrend(button.dataset.trend); }); });
  document.querySelectorAll('[data-open-tab]').forEach(function (link) { link.addEventListener('click', function (event) { event.preventDefault(); var trigger = document.getElementById(link.dataset.openTab); if (trigger && window.bootstrap) bootstrap.Tab.getOrCreateInstance(trigger).show(); }); });
  document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function (tab) { tab.addEventListener('shown.bs.tab', function () { Object.keys(charts).forEach(function (key) { charts[key].resize(); }); }); });
  var evidenceModalElement = document.getElementById('serviceEvidenceModal');
  var evidencePreview = document.getElementById('serviceEvidencePreview');
  document.querySelectorAll('[data-evidence-photo]').forEach(function (button) {
    var thumbnail = button.querySelector('img');
    if (thumbnail) thumbnail.addEventListener('error', function () { button.classList.add('is-broken'); button.disabled = true; });
    button.addEventListener('click', function () {
      if (!evidenceModalElement || !evidencePreview || !thumbnail || typeof bootstrap === 'undefined') return;
      evidencePreview.src = thumbnail.currentSrc || thumbnail.src;
      evidencePreview.alt = thumbnail.alt;
      document.getElementById('serviceEvidenceTitle').textContent = button.dataset.evidenceTitle || 'Service photo';
      document.getElementById('serviceEvidenceMeta').textContent = button.dataset.evidenceMeta || '';
      bootstrap.Modal.getOrCreateInstance(evidenceModalElement).show();
    });
  });
  if (evidenceModalElement) evidenceModalElement.addEventListener('hidden.bs.modal', function () { if (evidencePreview) evidencePreview.removeAttribute('src'); });
  var range = document.getElementById('reportRange');
  if (range) range.addEventListener('change', function () { document.getElementById('customDateFilters').classList.toggle('is-visible', range.value === 'custom'); });
  var filterForm = document.getElementById('serviceReportFilters');
  if (filterForm) filterForm.addEventListener('submit', function () {
    var applyButton = document.getElementById('applyReportFilters');
    filterForm.setAttribute('aria-busy', 'true');
    if (!applyButton) return;
    applyButton.disabled = true;
    applyButton.querySelector('i').className = 'bi bi-arrow-repeat sr-spin';
    applyButton.querySelector('span').textContent = 'Updating…';
  });
  var exportButton = document.getElementById('exportReportBtn');
  if (exportButton) exportButton.addEventListener('click', function () {
    var columns = ['Reference','Customer','Service','Technician','Status','Booked Value','Date'];
    var rows = data.exportRows.map(function (row) { return [row.reference,row.customer,row.service,row.technician,row.status,row.bookedValue,row.date ? new Date(row.date).toLocaleDateString('en-PH') : '']; });
    var csv = [columns].concat(rows).map(function (row) { return row.map(function (value) {
      var safeValue = String(value == null ? '' : value);
      if (/^[=+\-@\t\r]/.test(safeValue)) safeValue = "'" + safeValue;
      return '"' + safeValue.replace(/"/g, '""') + '"';
    }).join(','); }).join('\n');
    var link = document.createElement('a'); link.href = URL.createObjectURL(new Blob([csv], { type:'text/csv;charset=utf-8' })); link.download = 'service-performance-report.csv'; document.body.appendChild(link); link.click(); URL.revokeObjectURL(link.href); link.remove();
  });
  renderTrend('volume');
  renderSecondaryCharts();
})();
</script>
