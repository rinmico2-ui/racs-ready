<!-- ═══ Add/Edit Part Modal ═══ -->
<div class="modal fade rp-modal" id="partModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="d-flex align-items-center gap-3">
          <div style="width:42px;height:42px;border-radius:10px;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;">
            <i class="bi bi-box-seam" style="font-size:1.1rem;"></i>
          </div>
          <div>
            <h6 class="modal-title fw-bold mb-0" id="partModalTitle">Add New Item</h6>
            <small class="opacity-75" id="partModalSub">Fill in the item details below</small>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="partEditId">
        <div class="rp-form-card mb-3">
          <div class="rp-form-card-header"><div class="rp-form-card-icon"><i class="bi bi-building-gear"></i></div>Inventory Classification <span class="text-danger">*</span></div>
          <div class="rp-class-picker">
            <label class="rp-class-option"><input class="form-check-input mt-1" type="radio" name="partInventoryClass" value="merchandise" checked onchange="updateInventoryClassForm()"><span><strong>Merchandise</strong><small>Sellable through POS and reservable for repair quotations.</small></span></label>
            <label class="rp-class-option"><input class="form-check-input mt-1" type="radio" name="partInventoryClass" value="operational_asset" onchange="updateInventoryClassForm()"><span><strong>Operational Asset</strong><small>Company-owned; assignable to technicians and never sold.</small></span></label>
          </div>
        </div>
        <div class="rp-form-grid">
          <div class="rp-form-card">
            <div class="rp-form-card-header"><div class="rp-form-card-icon"><i class="bi bi-box-seam"></i></div>Basic Info</div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-tag"></i>Part Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="partName" placeholder="e.g. Capacitor 40uF 440V" required>
            </div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-diagram-3"></i>Type</label>
              <select class="form-select" id="partType">
                <option value="equipment">Equipment (Reusable)</option>
                <option value="part">Repair Part</option>
                <option value="consumable">Consumable</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-folder"></i>Category</label>
              <select class="form-select" id="partCategory">
                <option value="Capacitor">Capacitor</option>
                <option value="Compressor">Compressor</option>
                <option value="Fan Motor">Fan Motor</option>
                <option value="Refrigerant">Refrigerant</option>
                <option value="Copper Pipe">Copper Pipe</option>
                <option value="Electrical">Electrical</option>
                <option value="Filter">Filter</option>
                <option value="Coil">Coil</option>
                <option value="Board">Board / PCB</option>
                <option value="Bearing">Bearing</option>
                <option value="Sealant">Sealant / Adhesive</option>
                <option value="Wire">Wire / Cable</option>
                <option value="Valve">Valve</option>
                <option value="Equipment">Equipment</option>
                <option value="Consumable">Consumable</option>
                <option value="General">General</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-card-text"></i>Specification</label>
              <input type="text" class="form-control" id="partSpec" placeholder="e.g. 40uF 440V Round">
            </div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-upc-scan"></i>Serial Number</label>
              <input type="text" class="form-control" id="partSerialNumber" placeholder="e.g. SN-2024-001">
            </div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-truck"></i>Supplier</label>
              <input type="text" class="form-control" id="partSupplier" placeholder="e.g. HVAC Parts PH">
            </div>
            <div class="mb-0">
              <label class="rp-form-label"><i class="bi bi-file-text"></i>Description</label>
              <textarea class="form-control" id="partDesc" rows="3" placeholder="Additional details about this part..."></textarea>
            </div>
            <div id="assetFields" class="mt-3" hidden>
              <hr>
              <div class="mb-3"><label class="rp-form-label"><i class="bi bi-upc"></i>Asset Code</label><input class="form-control" id="partAssetCode" placeholder="Auto-generated when blank"></div>
              <div class="mb-3"><label class="rp-form-label"><i class="bi bi-shield-check"></i>Condition</label><select class="form-select" id="partAssetCondition"><option value="good">Good</option><option value="fair">Fair</option><option value="needs_repair">Needs Repair</option><option value="damaged">Damaged</option></select></div>
              <div class="mb-3"><label class="rp-form-label"><i class="bi bi-activity"></i>Maintenance Status</label><select class="form-select" id="partAssetStatus"><option value="available">Available</option><option value="reserved">Reserved</option><option value="checked_out">Checked Out</option><option value="under_maintenance">Under Maintenance</option><option value="damaged">Damaged</option><option value="retired">Retired</option></select></div>
              <div class="mb-3"><label class="rp-form-label"><i class="bi bi-calendar3"></i>Maintenance Interval (days)</label><input type="number" class="form-control" id="partMaintenanceInterval" min="0" value="180"></div>
              <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="partAssignable" checked><label class="form-check-label" for="partAssignable">Assignable to technicians</label></div>
            </div>
          </div>
          <div class="rp-form-card">
            <div class="rp-form-card-header"><div class="rp-form-card-icon"><i class="bi bi-cash-coin"></i></div>Pricing &amp; Stock</div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-box"></i>Unit</label>
              <select class="form-select" id="partUnit">
                <option value="pcs">Pieces</option>
                <option value="rolls">Rolls</option>
                <option value="meters">Meters</option>
                <option value="liters">Liters</option>
                <option value="kg">Kilograms</option>
                <option value="sets">Sets</option>
                <option value="bottles">Bottles</option>
                <option value="tubes">Tubes</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-cash-stack"></i>Purchase Price (₱)</label>
              <input type="number" class="form-control" id="partCostPrice" min="0" step="0.01" value="0">
            </div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-cash"></i>Selling Price (₱)</label>
              <input type="number" class="form-control" id="partSellingPrice" min="0" step="0.01" value="0">
            </div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-graph-up-arrow"></i>Margin</label>
              <div class="form-control" id="partMargin" style="background:#f1f5f9;font-weight:700;color:#16a34a;">₱0 (0%)</div>
            </div>
            <div class="mb-3">
              <label class="rp-form-label"><i class="bi bi-123"></i>Quantity <span class="text-danger">*</span></label>
              <input type="number" class="form-control" id="partQty" min="0" value="0">
            </div>
            <div class="mb-0">
              <label class="rp-form-label"><i class="bi bi-bell"></i>Min Stock Level</label>
              <input type="number" class="form-control" id="partMinStock" min="0" value="3">
              <small class="text-muted" style="font-size:0.7rem;">Alert when stock falls below this</small>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light btn-sm fw-semibold" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm fw-semibold" id="partSaveBtn" onclick="savePart()">
          <i class="bi bi-check-lg me-1"></i>Save Item
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ═══ Stock Adjustment Modal ═══ -->
<div class="modal fade rp-modal" id="stockModal" tabindex="-1">
  <div class="modal-dialog modal-md modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="d-flex align-items-center gap-3">
          <div style="width:42px;height:42px;border-radius:10px;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;">
            <i class="bi bi-arrow-left-right" style="font-size:1.1rem;"></i>
          </div>
          <div>
            <h6 class="modal-title fw-bold mb-0">Adjust Stock</h6>
            <small class="opacity-75" id="stockPartName">-</small>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="stockPartId">
        <div class="rp-form-card">
          <div class="rp-form-card-header"><div class="rp-form-card-icon"><i class="bi bi-arrow-left-right"></i></div>Stock Adjustment</div>
          <div class="rp-stock-summary">
            <div class="text-center flex-fill">
              <div class="rp-stock-summary-label"><i class="bi bi-box"></i>Current Stock</div>
              <div class="rp-stock-summary-value" id="stockCurrentQty">0</div>
            </div>
            <div class="rp-stock-summary-arrow"><i class="bi bi-arrow-right"></i></div>
            <div class="text-center flex-fill">
              <div class="rp-stock-summary-label"><i class="bi bi-box-arrow-in-right"></i>After Adjustment</div>
              <div class="rp-stock-summary-value after" id="stockAfterQty">0</div>
            </div>
          </div>
          <div class="mb-3">
            <label class="rp-form-label"><i class="bi bi-plus-slash-minus"></i>Adjustment Type</label>
            <div class="d-flex gap-2">
              <button class="btn flex-fill fw-semibold rp-stock-toggle" id="stockInBtn" onclick="setStockType('in')" style="border:2px solid #22c55e;background:#f0fdf4;color:#16a34a;">
                <i class="bi bi-plus-circle me-1"></i>Stock In
              </button>
              <button class="btn flex-fill fw-semibold rp-stock-toggle" id="stockOutBtn" onclick="setStockType('out')" style="border:2px solid #e2e8f0;background:#fff;color:#64748b;">
                <i class="bi bi-dash-circle me-1"></i>Stock Out
              </button>
            </div>
          </div>
          <div class="mb-3">
            <label class="rp-form-label"><i class="bi bi-123"></i>Quantity</label>
            <input type="number" class="form-control" id="stockAdjustQty" min="1" value="1" oninput="updateAfterQty()">
          </div>
          <div class="mb-3">
            <label class="rp-form-label"><i class="bi bi-funnel"></i>Reason</label>
            <select class="form-select" id="stockReason">
              <option value="purchase">New Purchase</option>
              <option value="return">Customer Return</option>
              <option value="repair_used">Used in Repair</option>
              <option value="damaged">Damaged / Defective</option>
              <option value="adjustment">Inventory Adjustment</option>
              <option value="transfer">Transfer</option>
            </select>
          </div>
          <div class="mb-0">
            <label class="rp-form-label"><i class="bi bi-journal-text"></i>Notes <small class="text-muted">(optional)</small></label>
            <input type="text" class="form-control" id="stockNotes" placeholder="e.g. PO #12345, Job #WO-001...">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light btn-sm fw-semibold" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success btn-sm fw-semibold" id="stockConfirmBtn" onclick="submitStockAdjustment()">
          <i class="bi bi-check-lg me-1"></i>Confirm Adjustment
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  let allParts = [];
  let categories = [];
  let selectedCategory = '';
  let stockType = 'in';
  let currentPage = 1;
  const partsPerPage = 10;
  let lastFiltered = [];

  const effectiveClass = (p) => p.inventoryClass || (['equipment', 'tool'].includes(p.type) ? 'operational_asset' : 'merchandise');

  // ── Load Parts ────────────────────────────────────────────────────────
  window.loadParts = async function() {
    const tbody = document.getElementById('rpTableBody');
    tbody.innerHTML = '<tr><td colspan="14"><div class="rp-loading"><div class="spinner-border" role="status"></div></div></td></tr>';
    try {
      const res = await fetch('/api/admin/tools', { credentials: 'same-origin' });
      const contentType = res.headers.get('content-type') || '';
      const data = contentType.includes('application/json') ? await res.json() : null;
      if (!res.ok) {
        throw new Error(data?.error || `Unable to load the parts catalog (HTTP ${res.status})`);
      }
      allParts = data.items || data.tools || data || [];
      if (Array.isArray(data)) allParts = data;
      if (!Array.isArray(allParts)) {
        throw new Error('The parts catalog returned an invalid response.');
      }
      console.log('[Parts] Loaded', allParts.length, 'items. Types:', allParts.reduce((acc, p) => { const t = p.type || 'undefined'; acc[t] = (acc[t] || 0) + 1; return acc; }, {}));
      extractCategories();
      renderStats();
      loadSnapshots();
      renderCatPills();
      populateSupplierFilter();
      currentPage = 1;
      renderTable();
    } catch (e) {
      console.error('[Parts] Load failed:', e);
      const message = String(e?.message || 'Failed to load parts')
        .replace(/[&<>'"]/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]);
      tbody.innerHTML = `<tr><td colspan="14"><div class="rp-empty"><i class="bi bi-exclamation-triangle"></i><p>${message}</p><button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="loadParts()"><i class="bi bi-arrow-clockwise me-1"></i>Retry</button></div></td></tr>`;
    }
  };

  // ── Generate Barcodes for all items missing them ─────────────────────
  window.generateBarcodes = async function() {
    if (!confirm('Generate barcodes for all parts/tools that are missing one?')) return;
    try {
      const res = await fetch('/api/pos/tools/generate-barcodes', { method: 'POST', credentials: 'same-origin' });
      const data = await res.json();
      if (res.ok) {
        alert(data.message || `Generated ${data.updated} barcodes`);
        loadParts();
      } else {
        alert(data.error || 'Failed to generate barcodes');
      }
    } catch (e) {
      alert('Failed to generate barcodes');
    }
  };

  // ── Generate Aircon Barcodes ─────────────────────────────────────────
  window.generateAirconBarcodes = async function() {
    if (!confirm('Generate barcodes for all aircon variants that are missing one?')) return;
    try {
      const res = await fetch('/api/pos/aircon-generate-barcodes', { method: 'POST', credentials: 'same-origin' });
      const data = await res.json();
      if (res.ok) {
        alert(data.message || `Generated ${data.updated} aircon barcodes`);
      } else {
        alert(data.error || 'Failed to generate aircon barcodes');
      }
    } catch (e) {
      alert('Failed to generate aircon barcodes');
    }
  };

  // ── Extract Categories ────────────────────────────────────────────────
  function extractCategories() {
    const catSet = new Set();
    allParts.forEach(p => { if (p.category) catSet.add(p.category); });
    categories = Array.from(catSet).sort();
  }

  // ── Render Stats ──────────────────────────────────────────────────────
  function renderStats() {
    const active = allParts.filter(p => p.active !== false);
    const merchandise = active.filter(p => effectiveClass(p) === 'merchandise');
    const total = active.length;
    const inStock = active.filter(p => p.status === 'in_stock').length;
    const lowStock = active.filter(p => p.status === 'low_stock').length;
    const outOf = active.filter(p => p.status === 'out_of_stock').length;
    const totalValue = merchandise.reduce((sum, p) => sum + ((p.sellingPrice || 0) * (p.quantity || 0)), 0);
    const totalCost = merchandise.reduce((sum, p) => sum + ((p.costPrice || 0) * (p.quantity || 0)), 0);
    const totalProfit = totalValue - totalCost;

    const pct = (n) => total ? Math.round((n / total) * 100) + '%' : '0%';
    const marginPct = totalValue > 0 ? Math.round((totalProfit / totalValue) * 100) : 0;

    document.getElementById('statTotal').textContent = total;
    document.getElementById('statInStock').textContent = inStock;
    document.getElementById('statLowStock').textContent = lowStock;
    document.getElementById('statOutOf').textContent = outOf;
    document.getElementById('statValue').textContent = '₱' + totalValue.toLocaleString();
    document.getElementById('statProfit').textContent = '₱' + totalProfit.toLocaleString();

    document.getElementById('statInStockPct').textContent = pct(inStock);
    document.getElementById('statLowStockPct').textContent = pct(lowStock);
    document.getElementById('statOutOfPct').textContent = pct(outOf);
    document.getElementById('statProfitPct').textContent = marginPct + '%';

    document.getElementById('statTotalSub').textContent = total + ' active parts';
    document.getElementById('statInStockSub').textContent = inStock + ' in stock';
    document.getElementById('statLowStockSub').textContent = lowStock + ' low stock';
    document.getElementById('statOutOfSub').textContent = outOf + ' out of stock';
    document.getElementById('statValueSub').textContent = merchandise.length + ' sellable SKUs only';
    document.getElementById('statProfitSub').textContent = marginPct + '% merchandise margin';
  }

  // ── Load & Draw KPI Snapshots ─────────────────────────────────────────
  function hexToRgba(hex, alpha) {
    hex = String(hex || '#3b82f6').replace('#', '');
    if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');
    const r = parseInt(hex.substring(0, 2), 16);
    const g = parseInt(hex.substring(2, 4), 16);
    const b = parseInt(hex.substring(4, 6), 16);
    return `rgba(${r},${g},${b},${alpha})`;
  }

  const _rpSparkCharts = {};

  function drawSpark(id, values, color) {
    if (typeof Chart === 'undefined') return;
    const c = document.getElementById(id);
    if (!c || !values || values.length < 2) { if (c) c.style.display = 'none'; return; }
    c.style.display = 'block';
    if (_rpSparkCharts[id]) { _rpSparkCharts[id].destroy(); delete _rpSparkCharts[id]; }
    c.width = (c.clientWidth || c.parentNode.clientWidth || 300);
    c.height = (c.clientHeight || 40);
    const ctx = c.getContext('2d');
    const grad = ctx.createLinearGradient(0, 0, 0, c.height);
    grad.addColorStop(0, hexToRgba(color, 0.2));
    grad.addColorStop(1, hexToRgba(color, 0));
    _rpSparkCharts[id] = new Chart(c, {
      type: 'line',
      data: { labels: values.map((_, i) => i + 1), datasets: [{ data: values, borderColor: color, backgroundColor: grad, fill: true, tension: 0.4, borderWidth: 1.5, pointRadius: 0, pointHoverRadius: 0 }] },
      options: { responsive: false, animation: { duration: 800 }, plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { display: false }, y: { display: false } } }
    });
  }

  async function waitForChart(timeout = 10000) {
    if (typeof Chart !== 'undefined') return;
    if (!document.querySelector('script[src*="chart.js"]')) {
      const s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/chart.js';
      s.async = true;
      document.head.appendChild(s);
    }
    const start = Date.now();
    while (typeof Chart === 'undefined' && Date.now() - start < timeout) {
      await new Promise(r => setTimeout(r, 100));
    }
  }

  async function loadSnapshots() {
    try {
      await waitForChart();
      const res = await fetch('/api/inventory/snapshots?days=7', { credentials: 'same-origin' });
      if (!res.ok) return;
      const data = await res.json();
      const snapshots = data.snapshots || [];
      if (!snapshots.length) return;

      drawSpark('statTotalSpark', snapshots.map(s => s.total), '#3b82f6');
      drawSpark('statInStockSpark', snapshots.map(s => s.inStock), '#22c55e');
      drawSpark('statLowStockSpark', snapshots.map(s => s.lowStock), '#f59e0b');
      drawSpark('statOutOfSpark', snapshots.map(s => s.outOfStock), '#ef4444');
      drawSpark('statValueSpark', snapshots.map(s => s.totalValue), '#7c3aed');
      drawSpark('statProfitSpark', snapshots.map(s => s.totalProfit), '#22c55e');
    } catch (e) { console.error('Snapshot load error:', e); }
  }

  // ── Render Category Pills ─────────────────────────────────────────────
  function renderCatPills() {
    const container = document.getElementById('rpCatPills');
    let html = `<span class="rp-cat-pill ${!selectedCategory ? 'active' : ''}" onclick="filterCategory('')">All</span>`;
    categories.forEach(cat => {
      html += `<span class="rp-cat-pill ${selectedCategory === cat ? 'active' : ''}" onclick="filterCategory('${cat}')">${cat}</span>`;
    });
    container.innerHTML = html;
  }

  window.filterCategory = function(cat) {
    selectedCategory = cat;
    currentPage = 1;
    renderCatPills();
    renderTable();
  };

  // ── Render Table ──────────────────────────────────────────────────────
  function renderTable() {
    const tbody = document.getElementById('rpTableBody');
    const search = document.getElementById('rpSearch').value.toLowerCase();
    const statusFilter = document.getElementById('rpStatusFilter').value;
    const typeFilter = document.getElementById('rpTypeFilter').value;
    const classFilter = document.getElementById('rpClassFilter').value;
    const assetStatusFilter = document.getElementById('rpAssetStatusFilter')?.value || '';
    const assetCondFilter = document.getElementById('rpAssetCondFilter')?.value || '';
    const supplierFilter = document.getElementById('rpSupplierFilter')?.value || '';
    const stockLevelFilter = document.getElementById('rpStockLevelFilter')?.value || '';
    const priceFilter = document.getElementById('rpPriceFilter')?.value || '';
    const assignableFilter = document.getElementById('rpAssignableFilter')?.value || '';
    const activeFilter = document.getElementById('rpActiveFilter')?.value || '';
    const sort = document.getElementById('rpSort').value;

    let filtered = allParts.filter(p => {
      // Active filter
      if (activeFilter === 'active' && p.active === false) return false;
      if (activeFilter === 'inactive' && p.active !== false) return false;
      if (!activeFilter && p.active === false) return false;

      if (selectedCategory && p.category !== selectedCategory) return false;
      if (statusFilter && p.status !== statusFilter) return false;
      if (typeFilter && (p.type || 'part') !== typeFilter) return false;
      if (classFilter && effectiveClass(p) !== classFilter) return false;

      // Asset status filter
      if (assetStatusFilter && p.assetStatus !== assetStatusFilter) return false;

      // Asset condition filter
      if (assetCondFilter && p.assetCondition !== assetCondFilter) return false;

      // Supplier filter
      if (supplierFilter && p.supplier !== supplierFilter) return false;

      // Stock level filter
      if (stockLevelFilter === 'in_stock' && (p.quantity || 0) <= 0) return false;
      if (stockLevelFilter === 'out_of_stock' && (p.quantity || 0) > 0) return false;
      if (stockLevelFilter === 'low_stock' && (p.quantity || 0) > (p.minStockLevel || 0)) return false;
      if (stockLevelFilter === 'has_reserved' && (p.reservedQuantity || 0) <= 0) return false;
      if (stockLevelFilter === 'no_reserved' && (p.reservedQuantity || 0) > 0) return false;

      // Price range filter (based on selling price for merchandise, cost price for assets)
      if (priceFilter) {
        const price = effectiveClass(p) === 'merchandise' ? (p.sellingPrice || 0) : (p.costPrice || 0);
        if (priceFilter === '0-100' && (price < 0 || price > 100)) return false;
        if (priceFilter === '100-500' && (price < 100 || price > 500)) return false;
        if (priceFilter === '500-1000' && (price < 500 || price > 1000)) return false;
        if (priceFilter === '1000-5000' && (price < 1000 || price > 5000)) return false;
        if (priceFilter === '5000+' && price < 5000) return false;
      }

      // Assignable filter
      if (assignableFilter === 'yes' && p.assignable !== true) return false;
      if (assignableFilter === 'no' && p.assignable === true) return false;

      if (search) {
        const typeLabels = { equipment: 'equipment', part: 'part', consumable: 'consumable', tool: 'equipment' };
        const typeLabel = typeLabels[p.type] || 'part';
        const haystack = [p.itemName, p.specification, p.supplier, p.barcode, p.category, p.description, p.serialNumber, p.assetCode, typeLabel].filter(Boolean).join(' ').toLowerCase();
        if (!haystack.includes(search)) return false;
      }
      return true;
    });

    // Sort
    const sortKey = sort.replace(/^-/, '');
    const sortDir = sort.startsWith('-') ? -1 : 1;
    filtered.sort((a, b) => {
      const aVal = a[sortKey] || '';
      const bVal = b[sortKey] || '';
      if (typeof aVal === 'number') return (aVal - bVal) * sortDir;
      return String(aVal).localeCompare(String(bVal)) * sortDir;
    });
    lastFiltered = filtered;

    // Update filter count badge
    const countEl = document.getElementById('rpFilterCount');
    if (countEl) {
      const activeCount = [statusFilter, typeFilter, classFilter, assetStatusFilter, assetCondFilter, supplierFilter, stockLevelFilter, priceFilter, assignableFilter, activeFilter, selectedCategory].filter(Boolean).length;
      if (activeCount > 0) {
        countEl.textContent = activeCount + ' filter' + (activeCount > 1 ? 's' : '');
        countEl.style.display = 'inline-block';
      } else {
        countEl.style.display = 'none';
      }
    }

    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="15"><div class="rp-empty"><i class="bi bi-inbox"></i><p>No inventory items found</p></div></td></tr>';
      renderPagination(0);
      return;
    }

    const start = (currentPage - 1) * partsPerPage;
    const paginated = filtered.slice(start, start + partsPerPage);

    tbody.innerHTML = paginated.map(p => {
      const catClass = (p.category || 'general').toLowerCase().replace(/\s+/g, '');
      const profit = (p.sellingPrice || 0) - (p.costPrice || 0);
      const margin = p.sellingPrice > 0 && p.costPrice > 0 ? Math.round(((p.sellingPrice - p.costPrice) / p.sellingPrice) * 100) : 0;
      const marginClass = margin >= 30 ? 'high' : margin >= 15 ? 'medium' : 'low';
      const typeLabels = { equipment: 'Equipment', part: 'Repair Part', consumable: 'Consumable', tool: 'Equipment' };
      const typeClasses = { equipment: 'rp-type-equipment', part: 'rp-type-part', consumable: 'rp-type-consumable', tool: 'rp-type-equipment' };
      const rawType = p.type || 'part';
      const typeLabel = typeLabels[rawType] || 'Part';
      const typeBadgeClass = typeClasses[rawType] || 'rp-type-part';
      const inventoryClass = effectiveClass(p);
      const classLabel = inventoryClass === 'operational_asset' ? 'Operational Asset' : 'Merchandise';

      return `<tr>
        <td>
          <div class="rp-name">${esc(p.itemName)}</div>
          ${p.specification ? `<div class="rp-spec">${esc(p.specification)}</div>` : ''}
        </td>
        <td><span class="rp-type-badge ${typeBadgeClass}">${typeLabel}</span></td>
        <td><span class="rp-class-badge ${inventoryClass}"><i class="bi ${inventoryClass === 'operational_asset' ? 'bi-tools' : 'bi-bag-check'}"></i>${classLabel}</span>${inventoryClass === 'operational_asset' ? `<div class="rp-min-stock mt-1" style="cursor:pointer;" onclick="editAssetStatus('${p._id}', '${esc(p.assetStatus || 'available')}')" title="Click to edit status"><i class="bi bi-pencil-square" style="font-size:0.7rem;margin-right:4px;"></i>${esc((p.assetStatus || 'available').replaceAll('_', ' '))}</div>` : ''}</td>
        <td><span class="rp-cat-badge ${catClass}">${esc(p.category || 'General')}</span></td>
        <td>
          <div class="rp-stock ${p.status}"><span class="rp-stock-dot"></span>${p.quantity || 0} ${p.unit || 'pcs'}</div>
          <div class="rp-min-stock">Min: ${p.minStockLevel || 0}</div>
        </td>
        <td><span class="rp-stock in_stock"><span class="rp-stock-dot"></span>${p.available != null ? p.available : Math.max(0, (p.quantity || 0) - (p.reservedQuantity || 0))} ${p.unit || 'pcs'}</span></td>
        <td style="cursor:pointer;" onclick="editReservedQty('${p._id}', ${p.reserved != null ? p.reserved : (p.reservedQuantity || 0)}, '${p.unit || 'pcs'}', '${esc(p.itemName)}')" title="Click to edit reserved quantity"><span class="rp-stock low_stock"><span class="rp-stock-dot"></span>${p.reserved != null ? p.reserved : (p.reservedQuantity || 0)} ${p.unit || 'pcs'} <i class="bi bi-pencil-square" style="font-size:0.7rem;margin-left:4px;opacity:0.6;"></i></span></td>
        <td><span class="rp-stock out_of_stock"><span class="rp-stock-dot"></span>${p.consumed != null ? p.consumed : 0} ${p.unit || 'pcs'}</span></td>
        <td><span class="rp-price-cost">₱${Number(p.costPrice || 0).toLocaleString()}</span></td>
        <td>${inventoryClass === 'merchandise' ? `<span class="rp-price">₱${Number(p.sellingPrice || 0).toLocaleString()}</span>` : '<span class="text-muted">Not sellable</span>'}</td>
        <td>
          ${inventoryClass === 'merchandise' ? `<span class="rp-profit">₱${profit.toLocaleString()}</span>${profit > 0 ? `<br><span class="rp-profit-margin ${marginClass}">${margin}%</span>` : ''}` : '<span class="text-muted">N/A</span>'}
        </td>
        <td>${esc(p.supplier || '-')}</td>
        <td><span class="rp-barcode">${esc(p.serialNumber || '-')}</span></td>
        <td><span class="rp-barcode">${esc(p.barcode || '-')}</span></td>
        <td>
          <div class="rp-actions">
            <button class="btn btn-outline-primary btn-sm" onclick="openStockModal('${p._id}')" title="Adjust Stock"><i class="bi bi-arrow-left-right"></i></button>
            <button class="btn btn-outline-secondary btn-sm" onclick="editPart('${p._id}')" title="Edit"><i class="bi bi-pencil"></i></button>
            <button class="btn btn-outline-danger btn-sm" onclick="deletePart('${p._id}')" title="Delete"><i class="bi bi-trash"></i></button>
          </div>
        </td>
      </tr>`;
    }).join('');
    renderPagination(filtered.length);
  }

  // ── Pagination ─────────────────────────────────────────────────────────
  function renderPagination(total) {
    const info = document.getElementById('rpPaginationInfo');
    const nav = document.getElementById('rpPagination');
    if (!info || !nav) return;

    if (total === 0) {
      info.textContent = 'Showing 0 of 0';
      nav.innerHTML = '';
      return;
    }

    const totalPages = Math.ceil(total / partsPerPage);
    const start = (currentPage - 1) * partsPerPage + 1;
    const end = Math.min(currentPage * partsPerPage, total);
    info.textContent = `Showing ${start}-${end} of ${total} parts`;

    if (totalPages <= 1) {
      nav.innerHTML = '';
      return;
    }

    let html = '<li class="page-item' + (currentPage === 1 ? ' disabled' : '') + '"><a class="page-link" href="#" onclick="goToPage(' + (currentPage - 1) + '); return false;">&laquo;</a></li>';
    for (let i = 1; i <= totalPages; i++) {
      html += '<li class="page-item' + (i === currentPage ? ' active' : '') + '"><a class="page-link" href="#" onclick="goToPage(' + i + '); return false;">' + i + '</a></li>';
    }
    html += '<li class="page-item' + (currentPage === totalPages ? ' disabled' : '') + '"><a class="page-link" href="#" onclick="goToPage(' + (currentPage + 1) + '); return false;">&raquo;</a></li>';
    nav.innerHTML = html;
  }

  function goToPage(page) {
    const totalPages = Math.max(1, Math.ceil(lastFiltered.length / partsPerPage));
    currentPage = Math.max(1, Math.min(page, totalPages));
    renderTable();
  }

  window.goToPage = goToPage;

  // Expose renderTable for inline filter button
  window.renderTable = renderTable;
  window.applyFilters = function() { currentPage = 1; renderTable(); };

  // ── Reset Filters ────────────────────────────────────────────────────
  window.resetFilters = function() {
    ['rpSearch','rpStatusFilter','rpTypeFilter','rpClassFilter','rpAssetStatusFilter','rpAssetCondFilter','rpSupplierFilter','rpStockLevelFilter','rpPriceFilter','rpAssignableFilter','rpActiveFilter','rpSort'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = id === 'rpSort' ? 'itemName' : '';
    });
    selectedCategory = '';
    renderCatPills();
    currentPage = 1;
    renderTable();
  };

  // ── Populate Supplier Filter ──────────────────────────────────────────
  function populateSupplierFilter() {
    const select = document.getElementById('rpSupplierFilter');
    if (!select) return;
    const suppliers = [...new Set(allParts.map(p => p.supplier).filter(Boolean))].sort();
    const current = select.value;
    select.innerHTML = '<option value="">All Suppliers</option>' +
      suppliers.map(s => `<option value="${esc(s)}">${esc(s)}</option>`).join('');
    select.value = current;
  }

  // ── Event Listeners ───────────────────────────────────────────────────
  const filterIds = ['rpSearch','rpStatusFilter','rpClassFilter','rpTypeFilter','rpAssetStatusFilter','rpAssetCondFilter','rpSupplierFilter','rpStockLevelFilter','rpPriceFilter','rpAssignableFilter','rpActiveFilter','rpSort'];
  filterIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('change', () => { currentPage = 1; renderTable(); });
  });
  document.getElementById('rpSearch').addEventListener('input', () => { currentPage = 1; renderTable(); });

  window.updateInventoryClassForm = function() {
    const inventoryClass = document.querySelector('input[name="partInventoryClass"]:checked')?.value || 'merchandise';
    const operational = inventoryClass === 'operational_asset';
    document.getElementById('assetFields').hidden = !operational;
    document.getElementById('partSellingPrice').closest('.mb-3').hidden = operational;
    document.getElementById('partMargin').closest('.mb-3').hidden = operational;
    if (operational) document.getElementById('partSellingPrice').value = '0';
  };

  // ── Margin Calculator ─────────────────────────────────────────────────
  ['partCostPrice', 'partSellingPrice'].forEach(id => {
    document.getElementById(id).addEventListener('input', () => {
      const cost = parseFloat(document.getElementById('partCostPrice').value) || 0;
      const sell = parseFloat(document.getElementById('partSellingPrice').value) || 0;
      const profit = sell - cost;
      const margin = sell > 0 ? Math.round(((sell - cost) / sell) * 100) : 0;
      const el = document.getElementById('partMargin');
      el.textContent = '₱' + profit.toLocaleString() + ' (' + margin + '%)';
      el.style.color = margin >= 30 ? '#16a34a' : margin >= 15 ? '#f59e0b' : '#ef4444';
    });
  });

  // ── Open Add Modal ────────────────────────────────────────────────────
  window.openPartModal = function() {
    document.getElementById('partEditId').value = '';
    document.getElementById('partModalTitle').textContent = 'Add New Item';
    document.getElementById('partModalSub').textContent = 'Fill in the item details below';
    document.getElementById('partSaveBtn').innerHTML = '<i class="bi bi-plus-lg me-1"></i>Add Item';
    
    // Clear all text inputs
    ['partName','partSpec','partSupplier','partDesc','partSerialNumber'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    
    // Set defaults
    document.getElementById('partType').value = 'part';
    document.getElementById('partUnit').value = 'pcs';
    document.getElementById('partCategory').value = 'General';
    document.getElementById('partCostPrice').value = '0';
    document.getElementById('partSellingPrice').value = '0';
    document.getElementById('partQty').value = '0';
    document.getElementById('partMinStock').value = '3';
    document.querySelector('input[name="partInventoryClass"][value="merchandise"]').checked = true;
    document.getElementById('partAssetCode').value = '';
    document.getElementById('partAssetCondition').value = 'good';
    document.getElementById('partAssetStatus').value = 'available';
    document.getElementById('partMaintenanceInterval').value = '180';
    document.getElementById('partAssignable').checked = true;
    
    updateInventoryClassForm();
