<link rel="stylesheet" href="/css/customer-orders.css?v=20261009-mobile-workspace">
<%
  const orderList = typeof orders !== 'undefined' && Array.isArray(orders) ? orders : [];
  const statusLabels = { pending_payment:'Pending payment', preparing_unit:'Preparing unit', ready_for_pickup:'Ready for pickup', technician_assigned:'Technician assigned', technician_accepted:'Technician confirmed', technician_declined:'Reassigning technician', out_for_delivery:'Out for delivery', arrived:'Arrived', installing:'Installing', completed:'Completed', cancelled:'Cancelled' };
  const fulfillLabels = { delivery_only:'Delivery', delivery_installation:'Delivery + installation', customer_pickup:'Store pickup' };
  const statusGuidance = { pending_payment:'We will prepare your unit once payment is confirmed.', preparing_unit:'Your unit is being checked and prepared.', ready_for_pickup:'Your unit is ready. Visit the store during posted opening hours.', technician_assigned:'Your technician is reviewing the assignment.', technician_accepted:'Your technician has confirmed. We will notify you when they are on the way.', technician_declined:'We are arranging a replacement technician.', out_for_delivery:'Your order is on the way. View details for live tracking.', arrived:'Your technician has arrived at the delivery address.', installing:'Installation is in progress.', completed:'Your order has been completed.', cancelled:'This order is cancelled.' };
  const money = value => Number(value || 0).toLocaleString('en-PH', { minimumFractionDigits:2, maximumFractionDigits:2 });
  const dateLabel = value => value && !Number.isNaN(new Date(value).getTime()) ? new Date(value).toLocaleDateString('en-PH', { timeZone:'Asia/Manila', year:'numeric', month:'short', day:'numeric' }) : 'To be confirmed';
  const timeLabel = value => { const match = String(value || '').match(/^(\d{1,2}):(\d{2})$/); return match ? `${Number(match[1]) % 12 || 12}:${match[2]} ${Number(match[1]) >= 12 ? 'PM' : 'AM'}` : value; };
  const activeCount = orderList.filter(order => !['completed','cancelled'].includes(order.status)).length;
  const completedCount = orderList.filter(order => order.status === 'completed').length;
  const cancelledCount = orderList.filter(order => order.status === 'cancelled').length;
%>
<section class="my-orders-page">
  <div class="orders-container">
    <header class="orders-header">
      <div><div class="orders-eyebrow">Your account / Orders</div><h1>My orders</h1><p>Manage your purchases, delivery schedules, and installations.</p></div>
      <div class="orders-header-actions"><a href="/aircon-cart" class="ord-secondary-btn"><i class="bi bi-cart3" aria-hidden="true"></i> View cart</a><a href="/products" class="ord-track-btn"><i class="bi bi-plus-lg" aria-hidden="true"></i> New order</a></div>
    </header>
    <div class="orders-summary" aria-label="Order summary">
      <div><span>Total orders</span><strong><%= orderList.length %></strong><i class="bi bi-receipt" aria-hidden="true"></i></div>
      <div><span>In progress</span><strong><%= activeCount %></strong><i class="bi bi-box-seam" aria-hidden="true"></i></div>
      <div><span>Completed</span><strong><%= completedCount %></strong><i class="bi bi-check2-circle" aria-hidden="true"></i></div>
    </div>
    <div class="orders-workspace">
      <div class="orders-section-heading"><div><h2>Order history</h2><p>Your latest purchases, all in one place.</p></div><a href="/maintenance"><i class="bi bi-calendar2-check" aria-hidden="true"></i> My maintenance</a></div>
      <% if (orderList.length) { %>
        <div class="ord-toolbar" aria-label="Order filters">
          <div class="ord-filter-list" role="group" aria-label="Filter orders by status">
            <% [['all','All orders',orderList.length],['active','In progress',activeCount],['completed','Completed',completedCount],['cancelled','Cancelled',cancelledCount]].forEach(([filter,label,count]) => { %>
              <button type="button" class="ord-filter-btn <%= filter === 'all' ? 'active' : '' %>" data-filter="<%= filter %>" aria-pressed="<%= filter === 'all' %>"><%= label %><span class="ord-filter-count"><%= count %></span></button>
            <% }) %>
          </div>
          <div class="orders-search-controls"><label class="ord-search-wrap"><span class="visually-hidden">Search by order reference or product</span><i class="bi bi-search" aria-hidden="true"></i><input class="ord-search" id="orderSearch" type="search" placeholder="Search orders" autocomplete="off"></label><label><span class="visually-hidden">Sort orders</span><select id="orderSort" class="orders-sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select></label></div>
        </div>
        <p class="orders-results" id="orderResults" role="status" aria-live="polite"></p>
      <% } else { %>
        <div class="ord-empty"><div class="ord-empty-icon"><i class="bi bi-bag" aria-hidden="true"></i></div><h2>No Orders Yet</h2><p>Your purchases will appear here with their latest status and schedule.</p><a href="/products" class="ord-track-btn">Browse aircon products <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
      <% } %>
      <div class="orders-list" id="ordersList">
        <% orderList.forEach(order => {
          const orderGroup = order.status === 'completed' ? 'completed' : order.status === 'cancelled' ? 'cancelled' : 'active';
          const items = order.items || [];
          const orderSearch = [order.orderReference || order._id].concat(items.map(item => [item.brand,item.modelLine,item.capacity].filter(Boolean).join(' '))).join(' ').toLowerCase();
          const canManage = ['pending_payment','preparing_unit','technician_assigned'].includes(order.status);
          const pendingReschedule = order.rescheduleRequest && order.rescheduleRequest.requested && order.rescheduleRequest.status === 'pending';
          const invitedSchedule = order.rescheduleInvitation?.status === 'allowed' && new Date(order.rescheduleInvitation.expiresAt) > new Date() && ['pending_payment','preparing_unit','technician_assigned','technician_accepted','technician_declined','ready_for_pickup'].includes(order.status);
          const orderScheduleDate = order.fulfillmentType === 'customer_pickup' ? order.pickupDate : order.delivery && order.delivery.preferredDate;
          const payableTotal = Math.max(0, Number(order.subtotal || 0) - Number(order.discount || 0)) + Number(order.transportationFee || 0);
          const orderGuidance = order.status === 'pending_payment' && order.paymentChannel === 'card' ? 'Pay by credit or debit card at the RACS store so we can begin preparing your order.' : order.fulfillmentType === 'customer_pickup' && order.status === 'preparing_unit' ? 'Your unit is being prepared for store pickup.' : statusGuidance[order.status];
        %>
          <article class="ord-card" data-order-id="<%= order._id %>" data-order-group="<%= orderGroup %>" data-order-search="<%= orderSearch %>" data-order-created="<%= new Date(order.createdAt).getTime() || 0 %>" aria-label="Order <%= order.orderReference || order._id %>">
            <div class="ord-card-header"><div class="orders-reference"><a class="ord-ref" href="/my-orders/<%= order._id %>"><%= order.orderReference || order._id %></a><span class="ord-date">Placed <%= dateLabel(order.createdAt) %></span></div><span class="ord-status <%= order.status %>"><span class="orders-status-dot" aria-hidden="true"></span><%= statusLabels[order.status] || order.status %></span></div>
            <div class="ord-card-body">
              <div class="orders-products">
                <% items.slice(0,2).forEach(item => { %><div class="ord-product"><img src="<%= item.imageUrl || '/images/order-product-placeholder.svg' %>" alt="" class="ord-product-img" loading="lazy" width="56" height="56"><div><div class="ord-product-name"><%= item.brand ? item.brand + ' ' : '' %><%= item.modelLine || 'Aircon unit' %></div><div class="ord-product-meta"><%= item.capacity || '' %><%= item.capacity ? ' ' + (item.capacityUnit || 'HP') + ' · ' : '' %>Qty <%= item.quantity || 1 %></div></div></div><% }) %>
                <% if (!items.length) { %><span class="ord-product-meta">See order details for product information.</span><% } %>
                <% if (items.length > 2) { %><a class="orders-more-products" href="/my-orders/<%= order._id %>">+<%= items.length - 2 %> more products</a><% } %>
              </div>
              <div class="orders-schedule"><span class="orders-field-label"><i class="bi <%= order.fulfillmentType === 'customer_pickup' ? 'bi-shop' : 'bi-truck' %>" aria-hidden="true"></i> <%= fulfillLabels[order.fulfillmentType] || 'Fulfillment' %></span><strong><%= dateLabel(orderScheduleDate) %></strong><span><%= order.fulfillmentType === 'customer_pickup' ? 'During store hours' : timeLabel(order.timeSlot) || 'Time to be confirmed' %></span><% if (order.technician && order.technician.name) { %><span class="orders-technician"><%= order.technician.name %></span><% } %></div>
              <div class="orders-payment"><span class="orders-field-label">Total payable</span><strong class="ord-total-value">&#8369;<%= money(payableTotal) %></strong><span class="orders-payment-state"><%= order.paymentStatus === 'paid' || order.paymentStatus === 'verified' ? 'Payment confirmed' : order.paymentStatus === 'refunded' ? 'Payment refunded' : 'Payment ' + (order.paymentStatus || 'pending').replace(/_/g,' ') %></span>
                <% if (Number(order.downpaymentAmount || 0) > 0) { %><div class="orders-payment-breakdown"><strong><%= order.paymentMethod === 'gcash_full' ? 'Full payment' : `${order.downpaymentPercentage || 10}% downpayment` %>:</strong> &#8369;<%= Number(order.downpaymentAmount).toLocaleString() %> &middot; <strong>Remaining:</strong> &#8369;<%= Number(order.balanceAmount || 0).toLocaleString() %></div><% } %>
              </div>
            </div>
            <div class="orders-update"><i class="bi bi-info-circle" aria-hidden="true"></i><span><%= orderGuidance || 'View details for the latest order updates.' %></span></div>
            <% if (invitedSchedule) { %><div class="ord-request-note"><i class="bi bi-calendar-event" aria-hidden="true"></i><span>Our team invited you to choose a new schedule. <a href="/my-orders/<%= order._id %>/reschedule">Choose a new <%= order.fulfillmentType === 'customer_pickup' ? 'pickup date' : 'schedule' %></a>.</span></div><% } %>
            <% if (pendingReschedule) { %><div class="ord-request-note"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span>Reschedule request under review &middot; <%= dateLabel(order.rescheduleRequest.requestedDate) %><%= order.rescheduleRequest.requestedTime ? ' at ' + timeLabel(order.rescheduleRequest.requestedTime) : '' %>. Your current schedule stays in place until approval.</span></div><% } %>
            <% if (order.refundStatus && order.refundStatus !== 'none') { %><div class="orders-notice"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Refund <%= order.refundStatus %>: &#8369;<%= money(order.refundAmount) %></div><% } else if (order.status === 'cancelled' && order.refundReviewRequestedAt) { %><div class="orders-notice">Payment review requested. Staff will verify your receipt before confirming a refund.</div><% } else if (order.status === 'cancelled' && order.paymentStatus !== 'refunded') { %><div class="orders-notice">Already paid? Request a refund for staff to review your payment.</div><% } %>
            <% if (order.status === 'completed' && order.maintenanceAssets && order.maintenanceAssets.length) { %><div class="orders-notice"><i class="bi bi-calendar2-check" aria-hidden="true"></i><a href="/maintenance">View maintenance for your installed units</a></div><% } %>
            <div class="ord-action-row"><div class="orders-secondary-actions">
              <% if (canManage && !pendingReschedule && !invitedSchedule) { %><button class="ord-secondary-btn ord-reschedule-btn" type="button" data-id="<%= order._id %>" data-ref="<%= order.orderReference || order._id %>" data-fulfillment="<%= order.fulfillmentType %>" data-quantity="<%= order.fulfillmentType === 'delivery_installation' ? Math.max(1, items.reduce((sum,item) => sum + (Number(item.quantity) || 1),0)) : 1 %>" data-travel-time="<%= Math.max(0,Number(order.routeDurationMin) || 30) %>" data-current-schedule="<%= dateLabel(orderScheduleDate) %><%= order.fulfillmentType !== 'customer_pickup' && order.timeSlot ? ' at ' + timeLabel(order.timeSlot) : '' %>"><i class="bi bi-calendar-event" aria-hidden="true"></i> Reschedule</button><% } %>
              <% if (canManage) { %><button class="ord-danger-btn ord-cancel-btn" type="button" data-id="<%= order._id %>" data-ref="<%= order.orderReference || order._id %>">Cancel order</button><% } %>
              <% if (order.status === 'completed') { %><a class="ord-secondary-btn" href="/my-orders/<%= order._id %>#orderProductReturns">Return a product</a><% if (!order.customerRating) { %><button class="ord-secondary-btn ord-rate-btn" type="button" data-id="<%= order._id %>" data-ref="<%= order.orderReference || order._id %>" data-tech="<%= order.technician && order.technician.name || 'RACS team' %>"><i class="bi bi-star" aria-hidden="true"></i> Rate order</button><% } else { %><span class="orders-rating"><i class="bi bi-star-fill" aria-hidden="true"></i> <%= order.customerRating %>/5</span><% } %><% } %>
              <% if (order.status === 'cancelled' && items.length) { %><button class="ord-secondary-btn" type="button" data-order-reorder="<%= order._id %>"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Reorder</button><% } %>
              <% if (order.status === 'cancelled' && (!order.refundStatus || order.refundStatus === 'none') && !order.refundReviewRequestedAt && order.paymentStatus !== 'refunded') { %><button class="ord-secondary-btn" type="button" data-order-refund="<%= order._id %>">Request refund</button><% } %>
            </div><a class="ord-track-btn" href="/my-orders/<%= order._id %>" aria-label="View details for order <%= order.orderReference || order._id %>">View details <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
          </article>
        <% }) %>
      </div>
      <div class="ord-no-results" id="orderNoResults" hidden><i class="bi bi-search" aria-hidden="true"></i><h3>No matching orders</h3><p>Try a different product, order reference, or status.</p><button type="button" id="resetOrderFilters" class="ord-secondary-btn">Clear filters</button></div>
      <% if (orderList.length) { %><nav class="orders-pagination" aria-label="Order list pages"><span id="orderPageSummary"></span><div><button type="button" id="orderPrev" class="ord-secondary-btn" disabled><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button><button type="button" id="orderNext" class="ord-secondary-btn">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button></div></nav><% } %>
    </div>
  </div>
  <!-- Compact reschedule flow -->
  <div class="modal fade" id="orderRescheduleModal" tabindex="-1" aria-hidden="true" aria-labelledby="rescheduleTitle">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
      <div class="modal-content" style="border:0;border-radius:18px;overflow:hidden;box-shadow:0 24px 60px rgba(15,23,42,.2);">
        <div class="modal-header" style="padding:20px 22px;border-bottom:1px solid #e2e8f0;">
          <div>
            <h5 id="rescheduleTitle" class="modal-title fw-bold mb-1" style="font-size:1rem;color:#0f172a;">Request a new schedule</h5>
            <div id="rescheduleOrderRef" style="font-size:.75rem;color:#64748b;"></div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" style="padding:22px;">
          <div id="rescheduleLoading" class="text-center py-4 text-muted">
            <span class="spinner-border spinner-border-sm me-2"></span>Loading available schedules...
          </div>
          <div id="rescheduleError" class="alert alert-danger d-none" role="alert" tabindex="-1"></div><button type="button" id="rescheduleRetry" class="btn btn-outline-secondary d-none mb-3">Retry loading schedules</button>
          <div id="rescheduleFields" class="d-none">
            <p class="orders-current-schedule">Current schedule: <strong id="rescheduleCurrentSchedule"></strong></p><div id="rescheduleCalendar" class="ord-rs-picker" aria-label="Choose an available reschedule date and time"></div>
            <input type="hidden" id="rescheduleDate">
            <input type="hidden" id="rescheduleTime">
            <label for="rescheduleReason" class="form-label fw-semibold mt-3" style="font-size:.8rem;">Reason for rescheduling <span class="text-muted">(required)</span></label>
            <textarea id="rescheduleReason" class="form-control" rows="3" maxlength="500" required aria-describedby="rescheduleHelp" placeholder="Tell us why you need a new schedule" style="font-size:.85rem;resize:none;"></textarea>
            <p id="rescheduleHelp" class="mb-0 mt-3" style="font-size:.72rem;color:#64748b;"><i class="bi bi-info-circle me-1"></i>Your request will be reviewed before the schedule changes.</p>
          </div>
        </div>
        <div class="modal-footer" style="padding:14px 22px;border-top:1px solid #e2e8f0;">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Keep current schedule</button>
          <button type="button" class="btn btn-primary" id="submitReschedule" disabled>Submit request</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Rating Modal -->
  <div class="modal fade" id="orderRatingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content" style="border:none;border-radius:20px;overflow:hidden;box-shadow:0 25px 60px rgba(0,0,0,0.25);">
        <!-- Header -->
        <div class="modal-header d-block" style="background:linear-gradient(135deg,#0f172a 0%,#1e3a5f 100%);padding:24px 28px;color:#fff;">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
              <div style="width:48px;height:48px;border-radius:14px;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;font-size:1.3rem;backdrop-filter:blur(10px);">
                <i class="bi bi-stars"></i>
              </div>
              <div>
                <h6 class="modal-title fw-bold mb-0" style="font-size:1.05rem;">Rate This Order</h6>
                <small style="opacity:0.7;font-size:0.78rem;" id="ratingModalSubtitle">How was your experience?</small>
              </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close rating"></button>
          </div>
        </div>
        <!-- Body -->
        <div class="modal-body" style="padding:28px;background:#f8fafc;">
          <!-- Technician Info -->
          <div class="text-center mb-4">
            <div style="width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#2563eb);display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:1.4rem;box-shadow:0 4px 12px rgba(59,130,246,0.3);margin-bottom:10px;">
              <i class="bi bi-person-badge"></i>
            </div>
            <div class="fw-bold" style="color:#0f172a;font-size:0.95rem;" id="ratingModalTechName">Technician Name</div>
            <div style="font-size:0.75rem;color:#94a3b8;">Service Technician</div>
          </div>
          <!-- Stars -->
          <div class="text-center mb-3">
            <div class="d-flex justify-content-center gap-2 mb-2" id="ratingModalStars">
              <button type="button" class="rating-star-btn" data-value="1"><i class="bi bi-star"></i></button>
              <button type="button" class="rating-star-btn" data-value="2"><i class="bi bi-star"></i></button>
              <button type="button" class="rating-star-btn" data-value="3"><i class="bi bi-star"></i></button>
              <button type="button" class="rating-star-btn" data-value="4"><i class="bi bi-star"></i></button>
              <button type="button" class="rating-star-btn" data-value="5"><i class="bi bi-star"></i></button>
            </div>
            <p class="fw-semibold mb-0" id="ratingModalLabel" style="color:#64748b;font-size:0.88rem;">Tap a star to rate</p>
          </div>
          <!-- Comment -->
          <div>
            <label class="form-label fw-bold" style="font-size:0.82rem;color:#334155;">Review (Optional)</label>
            <textarea class="form-control" id="ratingModalComment" rows="3" placeholder="Share your experience with the service..." style="border-radius:12px;font-size:0.88rem;resize:none;border:1px solid #e2e8f0;"></textarea>
          </div>
        </div>
        <!-- Footer -->
        <div class="modal-footer" style="border-top:1px solid #e2e8f0;padding:16px 28px;background:#fff;display:flex;justify-content:flex-end;gap:10px;">
          <button type="button" class="btn" data-bs-dismiss="modal" style="border-radius:10px;padding:8px 20px;background:#f1f5f9;color:#475569;font-weight:600;font-size:0.85rem;">Cancel</button>
          <button type="button" class="btn" id="submitOrderRating" style="border-radius:10px;padding:8px 24px;background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;font-weight:600;font-size:0.85rem;box-shadow:0 2px 8px rgba(59,130,246,0.3);">
            <i class="bi bi-check-circle me-1"></i>Submit
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      let currentOrderId = null, currentOrderRef = null, currentRating = 0;
      const ratingLabels = ['Poor','Fair','Good','Very Good','Excellent'];

      document.querySelectorAll('.ord-rate-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          currentOrderId = this.getAttribute('data-id');
          currentOrderRef = this.getAttribute('data-ref');
          const techName = this.getAttribute('data-tech');
          document.getElementById('ratingModalTechName').textContent = techName || 'Technician';
          document.getElementById('ratingModalComment').value = '';
          document.getElementById('ratingModalSubtitle').textContent = `Order ${currentOrderRef}`;
          currentRating = 0;
          updateStars(0);
          document.getElementById('ratingModalLabel').textContent = 'Tap a star to rate';
          new bootstrap.Modal(document.getElementById('orderRatingModal')).show();
        });
      });

      const starsContainer = document.getElementById('ratingModalStars');
      if (starsContainer) {
        const stars = starsContainer.querySelectorAll('.rating-star-btn');
        stars.forEach((star, index) => {
          star.addEventListener('mouseenter', () => { highlightStars(stars, index + 1); document.getElementById('ratingModalLabel').textContent = ratingLabels[index]; });
          star.addEventListener('click', () => { currentRating = index + 1; highlightStars(stars, currentRating); document.getElementById('ratingModalLabel').textContent = ratingLabels[index]; });
        });
        starsContainer.addEventListener('mouseleave', () => { highlightStars(stars, currentRating); document.getElementById('ratingModalLabel').textContent = currentRating > 0 ? ratingLabels[currentRating - 1] : 'Tap a star to rate'; });
      }

      function highlightStars(stars, value) {
        stars.forEach((star, i) => {
          if (i < value) { star.classList.add('active'); star.querySelector('i').classList.replace('bi-star','bi-star-fill'); }
          else { star.classList.remove('active'); star.querySelector('i').classList.replace('bi-star-fill','bi-star'); }
        });
      }
      function updateStars(value) { highlightStars(document.querySelectorAll('#ratingModalStars .rating-star-btn'), value); }

      document.getElementById('submitOrderRating').addEventListener('click', async function() {
        if (!currentRating) { alert('Please select a star rating.'); return; }
        const comment = document.getElementById('ratingModalComment').value.trim();
        const originalText = this.innerHTML;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';
        this.disabled = true;
        try {
          const res = await fetch(`/api/rating/order/${encodeURIComponent(currentOrderId)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ score: currentRating, comment })
          });
          const data = await res.json();
          if (res.ok) { bootstrap.Modal.getInstance(document.getElementById('orderRatingModal')).hide(); window.location.reload(); }
          else { alert(data.error || 'Failed to submit rating.'); this.innerHTML = originalText; this.disabled = false; }
        } catch(e) { console.error(e); alert('Network error.'); this.innerHTML = originalText; this.disabled = false; }
      });
    });
  </script>

<script src="/socket.io/socket.io.js" defer></script>
<script src="/js/customer-order-reorder.js?v=20260930-reorder-v1" defer></script>
<script src="/js/customer-order-refund.js?v=20260930-refund-review-v2" defer></script>
<script src="/js/order-reschedule-picker.js?v=20261009-submit" defer></script>
<script src="/js/customer-order-reschedule.js?v=20261009-submit" defer></script>
<script src="/js/customer-orders.js?v=20261009-orders" defer></script>
</section>
