        const result=await studioApi(`/api/projects/${projectId}/resources/${item._id}/receive`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({quantity:Number(quantity)})});reloadReview(result.message);
      }));
      overlay.querySelectorAll('.res-replace, .res-find-equipment').forEach(button => button.addEventListener('click', () => {
        const row=button.closest('[data-resource-id]'),item=items.find(resource=>String(resource._id)===String(row.dataset.resourceId));
        overlay.querySelector('#resourceSearch').value=item.itemName;overlay.querySelector('#manualResourceHeading').scrollIntoView({behavior:'smooth'});setTimeout(()=>overlay.querySelector('#resourceSearch').focus(),300);
        toast(button.classList.contains('res-find-equipment')?'Search inventory and choose an available compatible asset.':'Search inventory and add a replacement, then dismiss the shortage item.');
      }));
      let searchTimer;
      overlay.querySelector('#resourceSearch').addEventListener('input', event => {
        clearTimeout(searchTimer); searchTimer = setTimeout(async () => {
          const query = event.target.value.trim();
          if (query.length < 2) return;
          const result = await studioApi(`/api/inventory/tools/search?q=${encodeURIComponent(query)}`);
          overlay.querySelector('#resourceMatches').innerHTML = '<option value="">Custom / no catalog match</option>' + (result.tools||[]).map(tool => `<option value="${tool._id}" data-type="${safe(tool.type||tool.itemType||'equipment')}" data-unit="${safe(tool.unit||'pcs')}" data-name="${safe(tool.itemName)}">${safe(tool.itemName)} (${tool.availableQuantity||0} available)</option>`).join('');
        }, 250);
      });
      overlay.querySelector('#resourceMatches').addEventListener('change', event => {
        const option = event.target.selectedOptions[0];
        if (!option?.value) return;
        overlay.querySelector('#resourceSearch').value = option.dataset.name;
        overlay.querySelector('#resourceType').value = option.dataset.type === 'tool' ? 'equipment' : option.dataset.type;
      });
      overlay.querySelector('#resourceAdd').addEventListener('click', async () => {
        const option = overlay.querySelector('#resourceMatches').selectedOptions[0];
        const payload = { toolId:option?.value||null, itemName:overlay.querySelector('#resourceSearch').value.trim(), type:overlay.querySelector('#resourceType').value, quantity:Number(overlay.querySelector('#resourceQty').value)||1, requirementRule:overlay.querySelector('#resourceRule').value, reason:overlay.querySelector('#resourceReason').value.trim(), unit:option?.dataset.unit||'pcs' };
        if (!payload.itemName) return toast('Enter or select a resource', 'warning');
        const result = await studioApi(`/api/projects/${projectId}/resources`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) });
        reloadReview(result.message);
