  <style>
  /* shared dashboard page styles (from admin-dashboard.ejs) */
  /* Google Fonts (Inter + Outfit) loaded via admin.ejs layout */
  :root {
    --dash-primary: #2563eb;       /* Sleek Deep Blue */
    --dash-primary-light: #eff6ff;
    --dash-success: #10b981;       /* Emerald */
    --dash-warning: #f59e0b;       /* Amber */
    --dash-danger: #ef4444;        /* Rose */
    --dash-purple: #8b5cf6;        /* Violet */
    --dash-info: #3b82f6;          /* Blue */
    --dash-dark: #0f172a;          /* Slate 900 */
    --dash-muted: #64748b;         /* Slate 500 */
    --dash-border: #e2e8f0;        /* Slate 200 */
    --dash-card-radius: 16px;
    --dash-card-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05); /* Subtle Tailwind shadow */
    --dash-hover-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    --dash-section-title: 0.85rem;
    --dash-bg: #f8fafc;            /* Slate 50 (clean light grey) */
  }
  .admin-dashboard {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: var(--dash-dark);
    background: var(--dash-bg);
    overflow-x: hidden;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: 24px;
  }

  /* Hide main scrollbars globally for a sleek app-like feel but keep scroll functionality */
  body::-webkit-scrollbar, .main-content::-webkit-scrollbar, .admin-dashboard::-webkit-scrollbar, html::-webkit-scrollbar {
    display: none;
  }
  body, .main-content, .admin-dashboard, html {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
  h1, h2, h3, h4, h5, h6, .page-title, .kpi-value, .brand-text {
    font-family: 'Outfit', 'Inter', sans-serif;
  }

  /* ---- HERO HEADER ---- */
  /* ---- HERO HEADER (Global Admin Pages) ---- */
  .admin-dashboard .dashboard-hero {
    background: #ffffff;
    padding: 24px 32px;
    border-radius: var(--dash-card-radius);
    box-shadow: var(--dash-card-shadow);
    border: 1px solid var(--dash-border);
    margin-bottom: 2rem !important;
    position: relative;
    overflow: hidden;
    color: var(--dash-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  @media (max-width: 768px) {
    .admin-dashboard .dashboard-hero {
      padding: 20px;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
  .admin-dashboard .dashboard-hero::before {
    display: none;
  }
  .admin-dashboard .dashboard-hero::after {
    display: none;
  }
  .admin-dashboard .dashboard-hero .row {
    width: 100%;
    margin: 0;
  }
  .admin-dashboard .page-title {
    font-size: 1.7rem;
    font-weight: 700;
    margin: 0;
    color: var(--dash-dark);
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
  }
  .admin-dashboard .page-title i {
    color: var(--dash-primary);
    font-size: 1.5rem;
    margin-right: 12px !important;
  }
  .admin-dashboard .hero-sub {
    font-size: 0.95rem;
    color: var(--dash-muted);
    margin: 4px 0 0;
    font-weight: 400;
  }
  
  /* Modern Dashboard Topbar Card */
  .admin-dashboard .dashboard-topbar {
    background: #ffffff;
    padding: 24px 32px;
    border-radius: var(--dash-card-radius);
    box-shadow: var(--dash-card-shadow);
    border: 1px solid var(--dash-border);
    margin-bottom: 2rem !important;
  }
  @media (max-width: 768px) {
    .admin-dashboard .dashboard-topbar {
      flex-direction: column;
      align-items: flex-start !important;
      gap: 16px;
      padding: 20px;
    }
    .admin-dashboard .dashboard-topbar .search-bar {
      width: 100% !important;
    }
  }
  .admin-dashboard .hero-sub {
    font-size: 0.85rem;
    color: var(--dash-muted);
    margin: 6px 0 0;
  }
  .admin-dashboard .hero-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--dash-primary);
    border: 2px solid var(--dash-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
    color: #fff;
    flex-shrink: 0;
    box-shadow: 0 4px 10px rgba(40,114,161,0.2);
  }
  .admin-dashboard .hero-status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dash-success);
