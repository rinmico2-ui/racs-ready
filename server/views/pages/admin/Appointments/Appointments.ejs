      function statusLabel(status) {
        const s = String(status || "pending").toLowerCase();
        if (s === "scheduled") return "scheduled";
        if (s === "on-the-way" || s === "on the way") return "on-the-way";
        if (s === "in-progress" || s === "in progress") return "in-progress";
        if (s === "confirmed" || s === "approved") return "confirmed";
        if (s === "completed") return "completed";
        if (s === "cancelled" || s === "rejected") return "cancelled";
        if (s === "re-scheduled") return "re-scheduled";
        return "pending";
      }

      function statusBadgeClass(status) {
        const s = statusLabel(status);
        if (s === "scheduled") return "primary";
        if (s === "on-the-way") return "info";
        if (s === "arrived") return "info";
        if (s === "in-progress") return "warning";
        if (s === "confirmed") return "success";
        if (s === "completed") return "success"; // completed appointments are distinguished with blue badge
        if (s === "cancelled") return "danger";
        if (s === "re-scheduled") return "primary";
        return "warning";
      }

      function formatValue(value) {
        if (value === null || value === undefined || value === "") return "—";
        // attempt to format dates first
        if (typeof value === "string" || value instanceof Date) {
          const d = new Date(value);
          if (!Number.isNaN(d.getTime())) {
            // include time when the string contains a time component
            return formatDate(d, /T|:/i.test(String(value)));
          }
        }
        if (typeof value === "object") {
          if (Array.isArray(value)) {
            return value.length ? value.join(", ") : "—";
          }
          if (value._id) return String(value._id);
          // check for address-like object
          const addrKeys = [
            "street",
            "barangay",
            "city",
            "province",
            "postalCode",
            "zip",
            "country",
            "address",
          ];
          const parts = [];
          addrKeys.forEach((k) => {
            if (value[k]) parts.push(String(value[k]));
          });
          if (parts.length) return parts.join(", ");
          return JSON.stringify(value);
        }
        return String(value);
      }

      async function openBookingRequestDetails(rq) {
        if (!rq || !rq.raw) return;
        // ensure Leaflet assets (CSS/JS) loaded once
        if (!window.L) {
          const css = document.createElement("link");
          css.rel = "stylesheet";
          css.href = "https://cdn.jsdelivr.net/npm/leaflet/dist/leaflet.css";
          document.head.appendChild(css);
          const s = document.createElement("script");
          s.src = "https://cdn.jsdelivr.net/npm/leaflet/dist/leaflet.js";
          document.head.appendChild(s);
          await new Promise((r) => {
            s.onload = r;
          });
        }
        const modalTitle = document.getElementById("apptsModalHeaderTitle");
        if (modalTitle) modalTitle.textContent = "Booking Request Details";
        const raw = rq.raw;
        // attempt to populate missing user/technician names
        if (raw.customerId && !raw.customerName) {
          try {
            const r = await fetch(
              `/api/users/${encodeURIComponent(raw.customerId)}`,
              { credentials: "same-origin" },
            );
            if (r.ok) {
              const info = await r.json();
              const cname =
                info.name ||
                info.fullName ||
                ((info.firstName || "") + " " + (info.lastName || "")).trim();
              if (cname) raw.customerName = cname;
            }
          } catch (e) {
            console.warn("failed to fetch customer for request", e);
          }
        }
        // fallback from snapshot
        if (!raw.technicianName) {
          if (raw.technician && raw.technician.name) {
            raw.technicianName = raw.technician.name;
          }
        }
        if (raw.technicianId && !raw.technicianName) {
          try {
            const r = await fetch(
              `/api/users/${encodeURIComponent(raw.technicianId)}`,
              { credentials: "same-origin" },
            );
            if (r.ok) {
              const info = await r.json();
              const tname =
                info.name ||
                info.fullName ||
                ((info.firstName || "") + " " + (info.lastName || "")).trim();
              if (tname) raw.technicianName = tname;
            }
          } catch (e) {
            console.warn("failed to fetch technician user for request", e);
          }
        }
        // if technicianId refers to a Technician doc, try admin list as a last resort
        if (raw.technicianId && !raw.technicianName) {
          try {
            const r2 = await fetch("/api/admin/technicians", {
              credentials: "same-origin",
            });
            if (r2.ok) {
              const j = await r2.json();
              const techs = j.technicians || [];
              const found = techs.find(
                (t) => String(t._id) === String(raw.technicianId),
              );
              if (found && found.name) raw.technicianName = found.name;
            }
          } catch (e) {
            console.warn("failed to fetch technician list for request", e);
          }
        }
        let locationAddress = "";
        // prefer explicit address field when provided
        if (raw?.location) {
          if (typeof raw.location === "string") {
            // could be coordinates string or literal address
            locationAddress = raw.location;
          } else if (raw.location.address) {
            if (typeof raw.location.address === "object") {
              locationAddress = Object.values(raw.location.address)
                .filter((v) => v != null && v !== "")
                .map(String)
                .join(", ");
            } else {
              locationAddress = raw.location.address;
            }
          }
        }
        if (!locationAddress && raw.address) {
          if (typeof raw.address === "object") {
            locationAddress = Object.values(raw.address)
              .filter((v) => v != null && v !== "")
              .map(String)
              .join(", ");
          } else {
            locationAddress = raw.address;
          }
        }
        // if address looks like coordinates, leave blank; we'll handle later
        if (/^\s*-?\d+(\.\d+)?\s*,\s*-?\d+(\.\d+)?\s*$/.test(locationAddress)) {
          locationAddress = "";
        }
        // determine coordinates array (lon,lat) from whichever field present
        let coordsArray = null;
        if (
          raw?.location?.coordinates?.coordinates &&
          Array.isArray(raw.location.coordinates.coordinates)
        ) {
          coordsArray = raw.location.coordinates.coordinates.slice(0, 2);
        } else if (typeof raw.coordinates === "string") {
          const nums = raw.coordinates
            .split(/[^0-9\.\-]+/)
            .map(Number)
            .filter((n) => !isNaN(n));
          if (nums.length >= 2) coordsArray = nums.slice(0, 2);
        } else if (typeof raw.location === "string") {
          const nums = raw.location
            .split(/[^0-9\.\-]+/)
            .map(Number)
            .filter((n) => !isNaN(n));
          if (nums.length >= 2) {
            // assume location string is lat,lon
            coordsArray = [nums[1], nums[0]];
          }
        }
        const hasCoords = coordsArray && coordsArray.length >= 2;
        const coordinates = hasCoords ? coordsArray.join(", ") : "—";

        const feeVal = computeTotalEstimatedFee(raw);
        const serviceFeeVal = Number(
          raw.servicePrice ??
            raw.service?.basePrice ??
            raw.serviceId?.basePrice,
        );
        const distanceFareVal = Number(raw.travelFare);
        // travelTime may be stored as undefined when it was 0 at booking time
        // fallback: compute from coordinates using same 40 km/h assumption
        let travelMins = Number(raw.travelTime);
        if (!Number.isFinite(travelMins) || travelMins <= 0) {
          const custCoords = raw?.location?.coordinates?.coordinates;
          const techCoords = raw?.technicianLocation?.coordinates?.coordinates;
          if (
            Array.isArray(custCoords) &&
            custCoords.length >= 2 &&
            Array.isArray(techCoords) &&
            techCoords.length >= 2
          ) {
            const [clng, clat] = custCoords;
            const [tlng, tlat] = techCoords;
            if (
              Number.isFinite(clat) &&
              Number.isFinite(clng) &&
              Number.isFinite(tlat) &&
              Number.isFinite(tlng)
            ) {
              const toRad = (v) => (v * Math.PI) / 180;
              const R = 6371;
              const dLat = toRad(tlat - clat),
                dLon = toRad(tlng - clng);
              const a =
                Math.sin(dLat / 2) ** 2 +
                Math.cos(toRad(clat)) *
                  Math.cos(toRad(tlat)) *
                  Math.sin(dLon / 2) ** 2;
              const km = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
              const eta = Math.round((km / 40) * 60);
              if (eta > 0) travelMins = eta;
            }
          }
        }
        const serviceMins = Number(
          raw.serviceDurationMinutes || raw.durationMinutes || raw.duration,
        );
        const startRaw = raw.startTime ?? raw.timeStart ?? raw.time;
        const startMin = Number(startRaw);
        const endMinRaw = Number(raw.endTime);
        const serviceEndMin =
          Number.isFinite(endMinRaw) &&
          Number.isFinite(startMin) &&
          endMinRaw > startMin
            ? endMinRaw
            : Number.isFinite(startMin) &&
                Number.isFinite(serviceMins) &&
                serviceMins > 0
              ? startMin + serviceMins
              : NaN;
        const totalEndMin =
          Number.isFinite(startMin) &&
          Number.isFinite(serviceMins) &&
          serviceMins > 0
            ? startMin +
              serviceMins +
              (Number.isFinite(travelMins) ? Math.max(0, travelMins) : 0)
            : NaN;
        // technician name override (fallback to id or stored snapshot id)
        const techName =
          raw.technicianName ||
          (raw.technician && raw.technician.name) ||
          raw.technicianId ||
          (raw.technician && raw.technician._id) ||
          "";
        const bookingRef = raw.bookingReference || raw.workOrderNumber || raw.reference || "—";
        const detailsReferenceEl = document.getElementById(
          "apptsDetailsReference",
        );
        if (detailsReferenceEl) detailsReferenceEl.textContent = bookingRef;
        const detailsStatusEl = document.getElementById(
          "apptsDetailsBookingStatus",
        );
        if (detailsStatusEl)
          detailsStatusEl.textContent = statusLabel(raw.status);
        const requestId = raw._id || raw.id || rq.id || "—";
        const customerName =
          raw.customerName || (raw.customer && raw.customer.name) || "—";
        const customerEmail = (raw.customer && raw.customer.email) || "—";
        const customerPhone = (raw.customer && raw.customer.phone) || "—";
        const serviceName =
          (raw.serviceId &&
            typeof raw.serviceId === "object" &&
            (raw.serviceId.name || raw.serviceId.title)) ||
          (raw.serviceType === 'repair' || raw.serviceModel === 'RepairService'
            ? 'Repair Service'
            : raw.serviceType) ||
          "—";
        const serviceDesc =
          (raw.serviceId &&
            typeof raw.serviceId === "object" &&
            raw.serviceId.description) ||
          raw.issueDescription ||
          "";
        const feeText =
          feeVal != null && feeVal !== ""
            ? "₱" +
