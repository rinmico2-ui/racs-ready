  function _forceCleanModalState() {
    // Remove any lingering Bootstrap modal backdrops
    document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
    // Remove modal-open from body so scroll and interaction aren't blocked
    document.body.classList.remove('modal-open');
    document.body.classList.remove('work-guide-open');
    document.body.style.overflow = '';
    document.body.style.paddingRight = '';
  }

  async function openWorkGuideModal(bookingId, customerName, serviceName) {
    _workGuideBookingId = bookingId;
    _workGuideCheckedSteps = {};

    // Close detail panel first if open, then wait
    closeDetailPanel();

    // Force-clean any leftover backdrops regardless
    _forceCleanModalState();

    // Fetch assignment data to get AI assistant info
    try {
      const resp = await fetch(`/api/technician/appointments/${bookingId}`, { credentials: 'same-origin' });
      const detail = await resp.json();
      const booking = detail.booking || detail;
      const ta = booking.technicianAssistant;

      if (!ta || !ta.summary) {
        Swal.fire('No AI Data', 'AI diagnosis has not been generated yet for this job. Please generate it first from the AI Analysis tab.', 'info');
        return;
      }

      _workGuideAssignment = { booking, ta, customerName, serviceName };

      // Populate the modal
      _renderWorkGuideContent(ta, booking, customerName, serviceName);

      // Final cleanup before showing
      _forceCleanModalState();

      const workGuideEl = document.getElementById('workGuideModal');
      const modal = bootstrap.Modal.getOrCreateInstance(workGuideEl);
      // Tag body so backdrop gets elevated z-index via CSS
      document.body.classList.add('work-guide-open');
      workGuideEl.addEventListener('hidden.bs.modal', function onHide() {
        workGuideEl.removeEventListener('hidden.bs.modal', onHide);
        document.body.classList.remove('work-guide-open');
      }, { once: true });
      modal.show();
    } catch (e) {
      console.error('[WorkGuide] Error loading data:', e);
      Swal.fire('Error', 'Failed to load work guide data.', 'error');
    }
  }

