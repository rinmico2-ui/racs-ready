                        <i class="bi bi-shield-check mt-1" style="color:#d97706;"></i>
                        <div>
                          <strong>Manual Verification Required</strong><br>
                          <small>Your payment will be verified by our admin team within 1-2 hours. You'll receive a confirmation email once approved.</small>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div id="cashFields" class="payment-section d-none">
                    <div class="rounded-3 p-3 mb-3" style="background:linear-gradient(135deg,#fffbeb,#fef3c7);border:1px solid #fde68a;">
                      <div class="d-flex align-items-center gap-2 mb-1">
                        <div class="d-flex align-items-center justify-content-center rounded-2"
                          style="width:32px;height:32px;background:#d97706;flex-shrink:0;">
                          <i class="bi bi-cash-stack text-white" style="font-size:0.9rem;"></i>
                        </div>
                        <span class="fw-bold" style="color:#92400e;">GCash Downpayment + Cash Balance</span>
                      </div>
                      <p class="mb-0 small text-muted ps-4" id="cashPolicyText">Pay 10% via GCash now to secure your schedule, then pay the remaining balance after the service.</p>
                    </div>
                    <div class="mb-3">
                      <label class="form-label text-muted small fw-semibold">Your mobile number <span class="text-danger">*</span></label>
                      <input id="cashNumber" class="form-control" inputmode="tel" placeholder="+639XXXXXXXXX" autocomplete="tel"
                        style="border-radius:12px;border:1.5px solid #e5e7eb;padding:0.8rem 1rem;" />
                    </div>
                    <div class="mb-3">
                      <label class="form-label text-muted small fw-semibold">Downpayment Receipt <span class="text-danger">*</span></label>
                      <input id="cashProof" type="file" class="form-control" accept="image/*" required
