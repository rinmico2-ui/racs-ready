<section class="ent-page-body">
  <div class="container">

    <div class="ent-booking-container" id="bookingContainer">

      <% if (!user) { %>
        <div class="ent-alert ent-alert-warning" role="alert">
          <i class="bi bi-exclamation-triangle-fill"></i>
          Please <a href="/login" class="alert-link">log in</a> to request a repair.
        </div>
      <% } %>

      <script>
        window.adminGcashNumber = "<%= adminGcashNumber %>";
        window._farePerKm = Number("<%= typeof farePerKm !== 'undefined' ? farePerKm : 40 %>");
        window._companyBaseLocation = null;
      </script>

      <script id="user-booking-data" type="application/json"><%- user ? JSON.stringify({isLoggedIn:true,_id:user._id,name:((user.firstName||"")+" "+(user.lastName||"")).trim()||user.name||user.fullName||"",email:user.email||"",phone:user.phone||user.mobile||"",address:user.address||""}) : '{"isLoggedIn":false}' %></script>
      <script>try{const d=JSON.parse(document.getElementById('user-booking-data').textContent);window.LOGGED_IN=d.isLoggedIn;window.currentUser=d.isLoggedIn?d:null}catch(e){window.LOGGED_IN=false;window.currentUser=null}</script>



      <script>
        function updateEntStepper(step){
          var n=document.querySelectorAll('.ent-n'),f=document.getElementById('stepperFill'),l=document.getElementById('stepperCurrentStep');
          if(!n.length||!f)return;
          var i=step-1,t=n.length;
          n.forEach(function(e,j){
            e.classList.remove('active','completed','inactive');
            if(j<i)e.classList.add('completed');
            else if(j===i)e.classList.add('active');
            else e.classList.add('inactive');
          });
          f.style.height=(i/(t-1)*100)+'%';
          if(l)l.textContent=step;
        }
        function navigateToStep(step){
          var maxStep=1;
          if(typeof RepairState!=='undefined'&&RepairState.currentStep){
            maxStep=RepairState.currentStep;
          }else{
            var all=document.querySelectorAll('.booking-step');
            all.forEach(function(e){var n=parseInt(e.getAttribute('data-step'));if(n>maxStep)maxStep=n;});
          }
          if(step>maxStep)return;
          updateEntStepper(step);
          if(typeof showStep==='function')showStep(step);
        }
        document.addEventListener('DOMContentLoaded',function(){updateEntStepper(1);});
      </script>

      <!-- Booking Progress (same design as core services) -->
      <div class="ent-stepper" id="entStepper">
        <div class="ent-h">
          <span>Booking Progress</span>
          <span>Step <span id="stepperCurrentStep">1</span> of 7</span>
        </div>
        <div class="ent-tr">
          <div class="ent-fill" id="stepperFill" style="height:0%;"></div>
          <div class="ent-n active" data-step="1" onclick="navigateToStep(1)"><div class="ent-ni"><i class="bi bi-person-check"></i></div><span>Login</span></div>
          <div class="ent-n" data-step="2" onclick="navigateToStep(2)"><div class="ent-ni"><i class="bi bi-tools"></i></div><span>Unit Info</span></div>
          <div class="ent-n" data-step="3" onclick="navigateToStep(3)"><div class="ent-ni"><i class="bi bi-geo-alt"></i></div><span>Location</span></div>
          <div class="ent-n" data-step="4" onclick="navigateToStep(4)"><div class="ent-ni"><i class="bi bi-calendar3"></i></div><span>Schedule</span></div>
          <div class="ent-n" data-step="5" onclick="navigateToStep(5)"><div class="ent-ni"><i class="bi bi-receipt"></i></div><span>Review</span></div>
          <div class="ent-n" data-step="6" onclick="navigateToStep(6)"><div class="ent-ni"><i class="bi bi-credit-card"></i></div><span>Payment</span></div>
          <div class="ent-n" data-step="7" onclick="navigateToStep(7)"><div class="ent-ni"><i class="bi bi-check-circle"></i></div><span>Done</span></div>
        </div>
      </div>

          <!-- Step 1: Login Check -->
          <div class="ent-step-card booking-step" data-step="1">
            <div class="ent-step-header">
              <div class="ent-step-icon step-login"><i class="bi bi-person-check"></i></div>
              <div class="ent-step-info">
                <h5>Step 1</h5>
                <p>Please log in to continue</p>
              </div>
            </div>

            <% if (user) { %>
              <div class="ent-alert ent-alert-success">
                <i class="bi bi-check-circle-fill"></i>
                <div>
                  <strong>Welcome back!</strong><br>
                  You are logged in as <strong><%= user.name || user.email %></strong>. Click "Continue" to proceed.
                </div>
              </div>
              <button type="button" class="ent-btn-primary mt-3" onclick="showStep(2)">
                <i class="bi bi-arrow-right"></i>Continue to Repair Request
              </button>
            <% } else { %>
              <div class="ent-alert ent-alert-info">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                  <strong>Login Required</strong><br>
                  Please log in to submit a repair request. This allows us to track your work order and notify you of status updates.
                </div>
              </div>
              <div class="mt-3 d-flex gap-2">
                <a href="/login" class="ent-btn-primary">
                  <i class="bi bi-box-arrow-in-right"></i>Log In
                </a>
                <a href="/register" class="ent-btn-outline">
                  <i class="bi bi-person-plus"></i>Register
                </a>
              </div>
            <% } %>
          </div>
          <!-- Step 2: Unit Information -->
<div class='ent-step-card d-none booking-step' id='unitInfoStep' data-step='2'>
