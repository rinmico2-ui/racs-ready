<link rel="stylesheet" href="/css/analytics.css">
<link rel="stylesheet" href="/css/service-report-focused.css?v=20260906-filter-performance">
<link rel="stylesheet" href="/css/order-report-focused.css?v=20260906-motion-refine">
<link rel="stylesheet" href="/css/report-kpis.css?v=20260906-shared-kpis">

<%
  const A = analytics || {};
  const F = filters || { range:'90', from:'', to:'', activeCount:0 };
  const money = value => Number(value || 0).toLocaleString('en-PH', { maximumFractionDigits:0 });
  const number = value => Number(value || 0).toLocaleString('en-PH');
  const pct = value => Number(value || 0).toFixed(1) + '%';
  const nice = value => String(value || 'Unknown').replace(/_/g, ' ').replace(/\b\w/g, char => char.toUpperCase());
  const rangeLabels = { today:'Today', '7':'Last 7 days', '30':'Last 30 days', mtd:'Month to date', qtd:'Quarter to date', ytd:'Year to date', '90':'Last 90 days', '365':'Last 12 months', custom:'Custom range' };
  const rangeLabel = rangeLabels[F.range] || 'Last 90 days';
  const marginValue = Number(A.estimatedGrossMargin || 0);
  const fulfillmentRows = Object.entries(A.fulfillmentBreakdown || {}).sort((left, right) => right[1] - left[1]);
  const cancellationReasons = Array.isArray(A.cancellationReasons) ? A.cancellationReasons : [];
  const recentOrders = Array.isArray(A.recentOrders) ? A.recentOrders : [];
  const topProducts = Array.isArray(A.topProducts) ? A.topProducts : [];
  const advancedActive = [F.paymentStatus, F.paymentMethod, F.technician, F.q, F.brand]
    .filter(Boolean).length + ((F.minValue !== null && F.minValue !== undefined) || (F.maxValue !== null && F.maxValue !== undefined) ? 1 : 0);
  const attentionItems = [];
  if (Number(A.overdueOrders) > 0) attentionItems.push({ tone:'danger', icon:'bi-clock-history', title:number(A.overdueOrders) + ' overdue order' + (Number(A.overdueOrders) === 1 ? '' : 's'), text:'The requested fulfillment date has passed without the required next action.', href:'/admin/appointments/orders', action:'Review fulfillment' });
  if (Number(A.ledgerMismatchCount) > 0) attentionItems.push({ tone:'danger', icon:'bi-database-exclamation', title:number(A.ledgerMismatchCount) + ' ledger mismatch' + (Number(A.ledgerMismatchCount) === 1 ? '' : 'es'), text:'Orders marked settled are not fully supported by the payment ledger.', href:'/admin/payments/remittance', action:'Reconcile payments' });
  if (Number(A.unassignedOrders) > 0) attentionItems.push({ tone:'warning', icon:'bi-person-exclamation', title:number(A.unassignedOrders) + ' unassigned order' + (Number(A.unassignedOrders) === 1 ? '' : 's'), text:'Paid delivery work has no technician assignment.', href:'/admin/appointments/orders', action:'Assign work' });
  if (Number(A.costCoveragePercent) < 100 && Number(A.recognizedOrders) > 0) attentionItems.push({ tone:'info', icon:'bi-boxes', title:pct(A.costCoveragePercent) + ' cost coverage', text:'Contribution remains provisional until every completed unit has cost data.', href:'/admin/inventory', action:'Review inventory cost' });
  const visibleAttention = attentionItems.slice(0, 3);
  const backlog = A.backlogAging || { today:0, twoToThree:0, fourToSeven:0, overSeven:0 };
%>

<div class="sr-shell order-report" id="orderReport">
  <header class="sr-hero">
    <div class="sr-hero-copy"><span class="sr-eyebrow"><i class="bi bi-bag-check" aria-hidden="true"></i> Order intelligence</span><h1>Order Performance</h1><p>Demand, completed sales, cash collection, and fulfillment exceptions.</p></div>
    <div class="sr-period" aria-label="Active reporting period"><span>Reporting period</span><strong><%= rangeLabel %></strong><% if (F.range === 'custom' && F.from && F.to) { %><small><%= F.from %> – <%= F.to %></small><% } %></div>
  </header>

  <% if (typeof reportError !== 'undefined' && reportError) { %><div class="alert alert-danger d-flex align-items-center gap-2" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span><%= reportError %></span></div><% } %>

  <form class="sr-filter-panel" method="get" action="/admin/reports/orders" id="orderReportFilter">
    <div class="sr-filter-primary">
      <label class="sr-field" for="orderRange"><span>Orders placed</span><select name="range" id="orderRange"><% [['today','Today'],['7','Last 7 days'],['30','Last 30 days'],['mtd','Month to date'],['qtd','Quarter to date'],['ytd','Year to date'],['90','Last 90 days'],['365','Last 12 months'],['custom','Custom dates']].forEach(function(option) { %><option value="<%= option[0] %>" <%= F.range === option[0] ? 'selected' : '' %>><%= option[1] %></option><% }); %></select></label>
      <label class="sr-field" for="orderFulfillment"><span>Fulfillment</span><select id="orderFulfillment" name="fulfillment"><option value="">All fulfillment types</option><option value="delivery_only" <%= F.fulfillment === 'delivery_only' ? 'selected' : '' %>>Delivery only</option><option value="delivery_installation" <%= F.fulfillment === 'delivery_installation' ? 'selected' : '' %>>Delivery + installation</option><option value="customer_pickup" <%= F.fulfillment === 'customer_pickup' ? 'selected' : '' %>>Customer pickup</option></select></label>
      <label class="sr-field" for="orderStatus"><span>Order status</span><select id="orderStatus" name="status"><option value="">All order statuses</option><% [['pending_payment','Pending payment'],['preparing_unit','Preparing unit'],['ready_for_pickup','Ready for pickup'],['technician_assigned','Technician assigned'],['technician_accepted','Technician accepted'],['technician_declined','Technician declined'],['out_for_delivery','Out for delivery'],['arrived','Arrived'],['installing','Installing'],['completed','Completed'],['cancelled','Cancelled']].forEach(function(option) { %><option value="<%= option[0] %>" <%= F.status === option[0] ? 'selected' : '' %>><%= option[1] %></option><% }); %></select></label>
      <div class="sr-custom-dates <%= F.range === 'custom' ? 'is-visible' : '' %>" id="orderCustomDates"><label class="sr-field"><span>From</span><input id="orderFrom" type="date" name="from" value="<%= F.from %>"></label><label class="sr-field"><span>To</span><input id="orderTo" type="date" name="to" value="<%= F.to %>"></label></div>
      <div class="sr-filter-actions"><button class="sr-button sr-button-primary" type="submit" id="applyOrderFilters"><i class="bi bi-funnel" aria-hidden="true"></i><span>Apply</span></button><button class="sr-button" type="button" id="exportOrders"><i class="bi bi-download" aria-hidden="true"></i> Export</button></div>
    </div>
    <details class="sr-more-filters" open>
      <summary><span class="sr-more-title"><i class="bi bi-sliders" aria-hidden="true"></i><strong>Advanced filters</strong></span><span class="sr-more-meta"><b>6 available</b><% if (advancedActive) { %><em><%= advancedActive %> active</em><% } %><i class="bi bi-chevron-down" aria-hidden="true"></i></span></summary>
      <div class="sr-filter-secondary">
        <fieldset class="sr-filter-group"><legend><i class="bi bi-cash-coin"></i> Payment &amp; ownership</legend><div class="sr-filter-grid">
          <label class="sr-field"><span>Payment status</span><select name="paymentStatus"><option value="">All payment statuses</option><% [['pending','Pending'],['partial','Partial'],['payment_collected','Collected'],['waiting_for_remittance','Awaiting remittance'],['remitted','Remitted'],['verified','Verified'],['paid','Paid'],['refunded','Refunded'],['rejected','Rejected'],['failed','Failed']].forEach(function(option) { %><option value="<%= option[0] %>" <%= F.paymentStatus === option[0] ? 'selected' : '' %>><%= option[1] %></option><% }); %></select></label>
          <label class="sr-field"><span>Payment method</span><select name="paymentMethod"><option value="">All payment methods</option><% [['cod','Cash on delivery'],['cash','Cash'],['cash_onsite','Cash on-site'],['gcash','GCash'],['gcash_full','GCash full payment'],['gcash_downpayment','GCash downpayment'],['downpayment','Downpayment'],['paymongo','PayMongo'],['other','Other']].forEach(function(option) { %><option value="<%= option[0] %>" <%= F.paymentMethod === option[0] ? 'selected' : '' %>><%= option[1] %></option><% }); %></select></label>
          <label class="sr-field"><span>Technician</span><select name="technician"><option value="">All technicians</option><option value="unassigned" <%= F.technician === 'unassigned' ? 'selected' : '' %>>Unassigned</option><% (filterOptions.technicians || []).forEach(function(technician) { %><option value="<%= technician.id %>" <%= F.technician === technician.id ? 'selected' : '' %>><%= technician.name %><%= technician.active ? '' : ' (inactive)' %></option><% }); %></select></label>
        </div></fieldset>
        <fieldset class="sr-filter-group"><legend><i class="bi bi-box-seam"></i> Product &amp; value</legend><div class="sr-filter-grid">
          <label class="sr-field sr-field-search"><span>Search orders</span><input type="search" name="q" maxlength="80" value="<%= F.q %>" placeholder="Reference, customer, product…"></label>
          <label class="sr-field"><span>Product brand</span><select name="brand"><option value="">All brands</option><% (filterOptions.brands || []).forEach(function(brand) { %><option value="<%= brand %>" <%= F.brand === brand ? 'selected' : '' %>><%= brand %></option><% }); %></select></label>
          <label class="sr-field"><span>Minimum value</span><input name="minValue" type="number" min="0" max="1000000000" step="0.01" placeholder="₱0" value="<%= F.minValue === null ? '' : F.minValue %>"></label>
          <label class="sr-field"><span>Maximum value</span><input name="maxValue" type="number" min="0" max="1000000000" step="0.01" placeholder="No limit" value="<%= F.maxValue === null ? '' : F.maxValue %>"></label>
        </div></fieldset>
        <div class="sr-filter-footer"><span>Every KPI, chart, drilldown, record, and export uses the selected cohort.</span><a class="sr-reset" href="/admin/reports/orders"><i class="bi bi-arrow-counterclockwise"></i> Reset all filters</a></div>
      </div>
    </details>
  </form>

  <section class="report-kpi-grid" aria-label="Order report executive summary">
    <article class="sr-kpi kpi-enterprise" data-accent="blue"><div class="sr-kpi-top"><span class="sr-kpi-icon blue"><i class="bi bi-bag-check"></i></span><span class="sr-kpi-context"><%= pct(A.orderGrowth) %> vs prior period</span></div><span class="sr-kpi-label">Valid orders placed</span><strong><%= number(A.validOrders) %></strong><small>₱<%= money(A.grossOrderValue) %> booked value · cancelled orders excluded</small></article>
    <article class="sr-kpi kpi-enterprise" data-accent="green"><div class="sr-kpi-top"><span class="sr-kpi-icon green"><i class="bi bi-check2-circle"></i></span><span class="sr-kpi-context"><%= number(A.recognizedOrders) %> completed</span></div><span class="sr-kpi-label">Completed order value</span><strong>₱<%= money(A.recognizedRevenue) %></strong><small>Orders whose completion event falls within this period</small></article>
    <article class="sr-kpi kpi-enterprise" data-accent="purple"><div class="sr-kpi-top"><span class="sr-kpi-icon purple"><i class="bi bi-cash-stack"></i></span><span class="sr-kpi-context">₱<%= money(A.refunds) %> refunded</span></div><span class="sr-kpi-label">Net collections</span><strong>₱<%= money(A.netCollections) %></strong><small>Cash received less completed refunds during this period</small></article>
    <article class="sr-kpi kpi-enterprise <%= Number(A.actionRequiredOrders) ? 'is-provisional' : '' %>" data-accent="amber"><div class="sr-kpi-top"><span class="sr-kpi-icon amber"><i class="bi bi-exclamation-diamond"></i></span><span class="sr-kpi-context">₱<%= money(A.outstandingBalance) %> outstanding</span></div><span class="sr-kpi-label">Orders requiring attention</span><strong><%= number(A.actionRequiredOrders) %></strong><small>Overdue, unassigned, reschedule, decline, or ledger exceptions</small></article>
  </section>

  <nav class="sr-tabs" aria-label="Order analysis sections"><div class="nav" role="tablist"><button class="sr-tab active" id="order-overview-tab" data-bs-toggle="tab" data-bs-target="#order-overview" type="button" role="tab" aria-selected="true">Overview</button><button class="sr-tab" id="order-fulfillment-tab" data-bs-toggle="tab" data-bs-target="#order-fulfillment" type="button" role="tab" aria-selected="false">Fulfillment</button><button class="sr-tab" id="order-cash-tab" data-bs-toggle="tab" data-bs-target="#order-cash" type="button" role="tab" aria-selected="false">Cash &amp; margin</button><button class="sr-tab" id="order-products-tab" data-bs-toggle="tab" data-bs-target="#order-products" type="button" role="tab" aria-selected="false">Products</button><button class="sr-tab" id="order-records-tab" data-bs-toggle="tab" data-bs-target="#order-records" type="button" role="tab" aria-selected="false">Records</button></div></nav>

  <div class="tab-content sr-tab-content">
    <div class="tab-pane fade show active" id="order-overview" role="tabpanel" aria-labelledby="order-overview-tab">
      <div class="sr-overview-grid">
        <section class="sr-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Trend</span><h2>Order activity over time</h2></div><div class="sr-chart-toggle" role="group" aria-label="Trend measure"><button type="button" class="active" data-order-trend="volume">Volume</button><button type="button" data-order-trend="value">Value</button><button type="button" data-order-trend="cash">Cash</button></div></header><p class="sr-card-note" id="orderTrendDefinition">Orders placed in each reporting bucket, including later cancellations.</p><div class="sr-chart"><canvas id="orderTrend" aria-label="Order trend"></canvas></div></section>
        <aside class="sr-card sr-attention"><header class="sr-card-header"><div><span class="sr-card-kicker">Action queue</span><h2>Needs attention</h2></div><span class="sr-count"><%= visibleAttention.length %></span></header><% if (visibleAttention.length) { %><div class="sr-attention-list"><% visibleAttention.forEach(function(item) { %><article class="sr-attention-item <%= item.tone %>"><i class="bi <%= item.icon %>"></i><div><h3><%= item.title %></h3><p><%= item.text %></p><a href="<%= item.href %>"><%= item.action %> <i class="bi bi-arrow-right"></i></a></div></article><% }); %></div><% } else { %><div class="sr-clear-state"><i class="bi bi-check2-circle"></i><strong>No priority exceptions</strong><p>No overdue, ownership, or reconciliation issue was detected.</p></div><% } %></aside>
      </div>
      <div class="sr-detail-grid">
        <section class="sr-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Workflow</span><h2>Fulfillment pipeline</h2><p>Current status of orders placed in the selected cohort.</p></div><span class="sr-badge">Click a bar to inspect</span></header><div class="sr-chart sr-chart-medium"><canvas id="orderPipeline"></canvas></div></section>
        <section class="sr-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Channel mix</span><h2>Fulfillment choice</h2><p>How customers elected to receive their products.</p></div></header><div class="or-mix-list"><% if (fulfillmentRows.length) { fulfillmentRows.forEach(function(row) { const share = Number(A.totalOrders) ? Number(row[1]) / Number(A.totalOrders) * 100 : 0; %><div class="or-mix-row"><span><%= nice(row[0]) %><small><%= number(row[1]) %> orders</small></span><span class="sr-bar"><i style="width:<%= Math.min(share,100) %>%"></i></span><b><%= share.toFixed(0) %>%</b></div><% }); } else { %><div class="sr-empty">No fulfillment activity in this period.</div><% } %></div></section>
      </div>
    </div>

    <div class="tab-pane fade" id="order-fulfillment" role="tabpanel" aria-labelledby="order-fulfillment-tab">
      <div class="sr-mini-grid"><article class="sr-mini-stat"><span>Active backlog</span><strong><%= number(A.openOrders) %></strong><small>Valid orders not yet completed</small></article><article class="sr-mini-stat"><span>Overdue review</span><strong><%= number(A.overdueOrders) %></strong><small>Requested date has passed</small></article><article class="sr-mini-stat"><span>Unassigned work</span><strong><%= number(A.unassignedOrders) %></strong><small>Non-pickup work needing ownership</small></article><article class="sr-mini-stat"><span>Median cycle</span><strong><%= Number(A.medianCycleHours) < 48 ? Number(A.medianCycleHours || 0).toFixed(1) + 'h' : (Number(A.medianCycleHours || 0) / 24).toFixed(1) + 'd' %></strong><small>Typical completed order</small></article><article class="sr-mini-stat"><span>90th percentile</span><strong><%= Number(A.p90CycleHours) < 48 ? Number(A.p90CycleHours || 0).toFixed(1) + 'h' : (Number(A.p90CycleHours || 0) / 24).toFixed(1) + 'd' %></strong><small>Long-tail completion cycle</small></article><article class="sr-mini-stat"><span>On-time completion</span><strong><%= pct(A.onTimeRate) %></strong><small><%= number(A.onTimeSampleSize) %> scheduled completions</small></article></div>
      <div class="sr-detail-grid">
        <section class="sr-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Aging</span><h2>Active backlog aging</h2><p>Age since order creation, as of the reporting end date.</p></div></header><div class="or-aging"><article><span>0–1 days</span><strong><%= number(backlog.today) %></strong></article><article><span>2–3 days</span><strong><%= number(backlog.twoToThree) %></strong></article><article><span>4–7 days</span><strong><%= number(backlog.fourToSeven) %></strong></article><article><span>Over 7 days</span><strong><%= number(backlog.overSeven) %></strong></article></div><p class="or-definition-note">Aging is descriptive. “Overdue” is determined from the customer’s requested pickup or delivery schedule.</p></section>
        <section class="sr-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Leakage</span><h2>Cancellation reasons</h2><p><%= number(A.cancelledOrders) %> cancelled · <%= pct(A.cancellationRate) %> of orders placed</p></div></header><div class="sr-reason-list"><% if (cancellationReasons.length) { cancellationReasons.forEach(function(reason) { const share = Number(A.cancelledOrders) ? reason.count / Number(A.cancelledOrders) * 100 : 0; %><div><span><strong><%= reason.reason %></strong><small><%= number(reason.count) %> orders</small></span><span class="sr-bar"><i style="width:<%= Math.min(share,100) %>%"></i></span><b><%= share.toFixed(0) %>%</b></div><% }); } else { %><div class="sr-clear-inline"><i class="bi bi-check-circle"></i>No cancellation reasons recorded.</div><% } %></div></section>
      </div>
      <section class="sr-card sr-related"><header class="sr-card-header"><div><span class="sr-card-kicker">Operational workspaces</span><h2>Continue the investigation</h2></div></header><div class="sr-related-grid"><a href="/admin/appointments/orders"><i class="bi bi-receipt"></i><span><strong>Manage orders</strong><small>Assign and advance fulfillment</small></span></a><a href="/admin/operations/resolution-center"><i class="bi bi-life-preserver"></i><span><strong>Resolution center</strong><small>Handle overdue exceptions</small></span></a><a href="/admin/appointments/calendar"><i class="bi bi-calendar3"></i><span><strong>Calendar</strong><small>Review scheduled workload</small></span></a></div></section>
    </div>

    <div class="tab-pane fade" id="order-cash" role="tabpanel" aria-labelledby="order-cash-tab">
      <div class="or-finance-flow"><article><span>Booked order value</span><strong>₱<%= money(A.grossOrderValue) %></strong></article><article><span>Completed order value</span><strong>₱<%= money(A.recognizedRevenue) %></strong></article><article><span>Gross collections</span><strong>₱<%= money(A.grossCollections) %></strong></article><article><span>Completed refunds</span><strong>₱<%= money(A.refunds) %></strong></article><article><span>Net collections</span><strong>₱<%= money(A.netCollections) %></strong></article></div>
      <% if (!A.marginReliable && Number(A.recognizedOrders) > 0) { %><div class="sr-data-warning"><i class="bi bi-info-circle"></i><div><strong>Contribution is provisional</strong><p>Only <%= pct(A.costCoveragePercent) %> of completed units have inventory cost coverage. Missing costs can overstate contribution.</p></div></div><% } %>
      <div class="sr-detail-grid"><section class="sr-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Payment state</span><h2>Payment health</h2><p>Payment status of orders placed in the selected cohort.</p></div><span class="sr-badge">Click a bar to inspect</span></header><div class="sr-chart sr-chart-medium"><canvas id="orderPayments"></canvas></div></section><section class="sr-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Contribution</span><h2>Completed-order economics</h2><p>Uses inventory cost attached to completed units.</p></div></header><div class="sr-control-list"><div><span><strong>Completed order value</strong><small>Completion-event basis</small></span><b>₱<%= money(A.recognizedRevenue) %></b></div><div><span><strong>Estimated product cost</strong><small><%= pct(A.costCoveragePercent) %> coverage</small></span><b>₱<%= money(A.estimatedCost) %></b></div><div><span><strong>Gross contribution</strong><small><%= A.marginReliable ? 'Complete cost coverage' : 'Provisional' %></small></span><b class="<%= marginValue < 0 ? 'sr-negative' : '' %>"><%= A.marginReliable ? '₱' + money(marginValue) : 'Provisional' %></b></div><div><span><strong>Outstanding balance</strong><small>Valid orders placed in cohort</small></span><b>₱<%= money(A.outstandingBalance) %></b></div><div><span><strong>Ledger mismatches</strong><small>Settled status without full ledger</small></span><b><%= number(A.ledgerMismatchCount) %></b></div><div><span><strong>Pending payment orders</strong><small>Open payment workflow</small></span><b><%= number(A.pendingPaymentOrders) %></b></div></div></section></div>
      <section class="sr-card sr-definitions"><header class="sr-card-header"><div><span class="sr-card-kicker">Definitions</span><h2>Financial time bases</h2></div></header><dl><div><dt>Booked order value</dt><dd>Value of valid orders created during the selected period.</dd></div><div><dt>Completed order value</dt><dd>Value of orders whose authoritative completion event occurred during the period.</dd></div><div><dt>Net collections</dt><dd>Payment events in the period less refunds completed in the period.</dd></div><div><dt>Gross contribution</dt><dd>Completed order value less inventory product cost. It is provisional while cost coverage is incomplete.</dd></div></dl></section>
    </div>

    <div class="tab-pane fade" id="order-products" role="tabpanel" aria-labelledby="order-products-tab">
      <section class="sr-card sr-table-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Completed sales</span><h2>Top products</h2><p>Ranked by product-line value from orders completed in the reporting period.</p></div><a class="sr-inline-link" href="/admin/inventory">Open inventory <i class="bi bi-arrow-right"></i></a></header><div class="table-responsive"><table class="sr-table"><thead><tr><th>#</th><th>Product</th><th class="text-end">Completed units</th><th class="text-end">Completed value</th><th class="text-end">Average unit value</th><th class="text-end">Completed order lines</th></tr></thead><tbody><% if (topProducts.length) { topProducts.forEach(function(product, index) { %><tr><td><span class="sr-badge"><%= index + 1 %></span></td><td><strong><%= product.name %></strong></td><td class="text-end"><%= number(product.units) %></td><td class="text-end"><strong>₱<%= money(product.revenue) %></strong></td><td class="text-end">₱<%= money(Number(product.units) ? Number(product.revenue) / Number(product.units) : 0) %></td><td class="text-end"><%= number(product.orders) %></td></tr><% }); } else { %><tr><td colspan="6" class="sr-empty">No completed product sales match the selected filters.</td></tr><% } %></tbody></table></div></section>
      <div class="sr-data-warning"><i class="bi bi-lightbulb"></i><div><strong>Brand is retained as a filter, not a competing chart</strong><p>The product ranking already includes brand and model. This avoids presenting two highly overlapping portfolio views.</p></div></div>
    </div>

    <div class="tab-pane fade" id="order-records" role="tabpanel" aria-labelledby="order-records-tab">
      <section class="sr-card sr-table-card"><header class="sr-card-header"><div><span class="sr-card-kicker">Audit detail</span><h2>Recent matching orders</h2><p>Latest 12 records in the selected cohort. Use Manage Orders for the complete workflow.</p></div><a class="sr-inline-link" href="/admin/appointments/orders">Manage all orders <i class="bi bi-arrow-right"></i></a></header><div class="table-responsive"><table class="sr-table"><thead><tr><th>Date</th><th>Reference</th><th>Customer</th><th>Fulfillment</th><th>Payment</th><th>Status</th><th class="text-end">Units</th><th class="text-end">Order value</th></tr></thead><tbody><% if (recentOrders.length) { recentOrders.forEach(function(order) { %><tr><td><%= new Date(order.date).toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' }) %></td><td><strong><%= order.reference %></strong></td><td><%= order.customer %></td><td><%= nice(order.fulfillment) %></td><td><span class="sr-badge"><%= nice(order.payment) %></span></td><td><span class="sr-badge"><%= nice(order.status) %></span></td><td class="text-end"><%= number(order.items) %></td><td class="text-end"><strong>₱<%= money(order.total) %></strong></td></tr><% }); } else { %><tr><td colspan="8" class="sr-empty">No orders match the selected filters.</td></tr><% } %></tbody></table></div></section>
    </div>
  </div>
</div>

<%- include('../../../partials/chart-drilldown-modal') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script src="/js/chart-drilldown.js"></script>
<script>
(() => {
  'use strict';
  const A = <%- analyticsJson %>;
  const charts = {};
  const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nice = value => String(value || 'Unknown').replaceAll('_', ' ').replace(/\b\w/g, char => char.toUpperCase());
  const peso = new Intl.NumberFormat('en-PH', { style:'currency', currency:'PHP', maximumFractionDigits:0 });
  const palette = ['#2563eb','#10b981','#8b5cf6','#f59e0b','#06b6d4','#ef4444','#64748b','#f97316','#14b8a6','#ec4899'];
  const filterForm = document.getElementById('orderReportFilter');
  const range = document.getElementById('orderRange');
  const customDates = document.getElementById('orderCustomDates');
  const customInputs = [document.getElementById('orderFrom'), document.getElementById('orderTo')];
  const syncDates = () => { const custom = range.value === 'custom'; customDates.classList.toggle('is-visible', custom); customInputs.forEach(input => { input.disabled = !custom; input.required = custom; }); };
  range.addEventListener('change', syncDates); syncDates();
  filterForm.addEventListener('submit', () => { const button = document.getElementById('applyOrderFilters'); filterForm.setAttribute('aria-busy','true'); button.disabled = true; button.querySelector('i').className = 'bi bi-arrow-repeat sr-spin'; button.querySelector('span').textContent = 'Updating…'; });
  const exportButton = document.getElementById('exportOrders');
  if (!A.reportStart || !A.reportEnd) { exportButton.disabled = true; exportButton.title = 'Report data must load before export'; }
  else exportButton.addEventListener('click', () => { const params = new URLSearchParams(new FormData(filterForm)); params.delete('range'); params.set('from', A.reportStart); params.set('to', A.reportEnd); window.location.href = '/api/admin/reports/orders/export?' + params.toString(); });
  if (typeof Chart === 'undefined') return;
  Chart.defaults.font.family = 'Inter, sans-serif'; Chart.defaults.color = '#64748b';
  const baseOptions = { responsive:true, maintainAspectRatio:false, animation:{duration:reduceMotion?0:420,easing:'easeOutQuart'}, plugins:{legend:{position:'bottom',labels:{usePointStyle:true,boxWidth:7,padding:16,font:{size:10}}},tooltip:{backgroundColor:'#0f172a',padding:10,cornerRadius:8}}, scales:{x:{grid:{display:false},ticks:{font:{size:10}}},y:{beginAtZero:true,border:{display:false},grid:{color:'#edf1f6'},ticks:{font:{size:10}}}} };
  const orderColumns = [{key:'reference',label:'Reference'},{key:'customer',label:'Customer'},{key:'products',label:'Products'},{key:'status',label:'Status'},{key:'payment',label:'Payment'},{key:'fulfillment',label:'Fulfillment'},{key:'units',label:'Units',align:'right'},{key:'date',label:'Placed'},{key:'amount',label:'Order Value',align:'right'}];
  async function fetchDrilldown(spec) { const response = await fetch('/api/admin/reports/orders/drilldown', { method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json','Accept':'application/json'}, body:JSON.stringify({...A.appliedFilters,...spec,from:A.reportStart,to:A.reportEnd}) }); if (response.status === 401) throw new Error('Your admin session has expired. Sign in again and retry.'); const payload = await response.json().catch(() => ({})); if (!response.ok) throw new Error(payload.error || 'Unable to load the selected orders.'); const summary = payload.summary || {}; payload.summary = { records:{label:'Orders',value:Number(summary.records||0).toLocaleString()}, orderValue:{label:'Order value',value:peso.format(Number(summary.orderValue||0))}, collected:{label:'Collected',value:peso.format(Number(summary.collected||0))}, outstanding:{label:'Outstanding',value:peso.format(Number(summary.outstanding||0))} }; return payload; }
  function modalConfig(chart) { return { type:chart.config.type, data:JSON.parse(JSON.stringify(chart.data)), options:{indexAxis:chart.options.indexAxis || 'x',plugins:{legend:{display:true,position:'bottom'}}} }; }
  function openDrill(chart, elements, title, buildSpec) { if (!elements.length || typeof ChartDrilldown === 'undefined') return; const hit = elements[0]; const spec = buildSpec(hit.index, hit.datasetIndex); if (!spec) return; ChartDrilldown.open({ title, subtitle:'Live orders behind this selection', selectionLabel:String(chart.data.labels[hit.index] || 'Selection'), dataHeading:'Underlying order records', chartConfig:modalConfig(chart), selectedElement:{index:hit.index,datasetIndex:hit.datasetIndex}, details:[], loadDetails:() => fetchDrilldown(spec), onChartSelect:selection => fetchDrilldown(buildSpec(selection.index, selection.datasetIndex)), columns:orderColumns, filters:[], filterField:'status' }); }
  const pointer = (event, elements) => { if (event.native && event.native.target) event.native.target.style.cursor = elements.length ? 'pointer' : 'default'; };
  function renderTrend(mode) {
    if (charts.trend) charts.trend.destroy();
    const definition = document.getElementById('orderTrendDefinition'); let datasets;
    if (mode === 'value') { definition.textContent = 'Booked value follows order creation; completed value follows the authoritative completion event.'; datasets = [{label:'Booked order value',data:A.dailyTrend.map(row=>row.bookedValue),borderColor:'#7c3aed',backgroundColor:'rgba(124,58,237,.1)',fill:true,tension:.3,drill:'booked order value'},{label:'Completed order value',data:A.dailyTrend.map(row=>row.recognizedRevenue),borderColor:'#059669',backgroundColor:'transparent',tension:.3,drill:'recognized sales'}]; }
    else if (mode === 'cash') { definition.textContent = 'Payment events recorded in each period; click-through is disabled because cash follows a separate event clock.'; datasets = [{label:'Net collections',data:A.dailyTrend.map(row=>row.netCollections),borderColor:'#0891b2',backgroundColor:'rgba(8,145,178,.1)',fill:true,tension:.3},{label:'Refunds',data:A.dailyTrend.map(row=>row.refunds),borderColor:'#ef4444',backgroundColor:'transparent',tension:.3}]; }
    else { definition.textContent = 'Orders placed in each reporting bucket, including later cancellations.'; datasets = [{label:'Orders placed',data:A.dailyTrend.map(row=>row.orders),borderColor:'#2563eb',backgroundColor:'rgba(37,99,235,.12)',fill:true,tension:.3,drill:'orders placed'}]; }
    const cashHover = event => { if (event.native && event.native.target) event.native.target.style.cursor = 'default'; };
    charts.trend = new Chart(document.getElementById('orderTrend'), { type:'line', data:{labels:A.dailyTrend.map(row=>row.label),datasets}, options:{...baseOptions,onHover:mode==='cash'?cashHover:pointer,onClick:(event,elements,chart)=>openDrill(chart,elements,'Order activity',(index,datasetIndex)=>{const drill=chart.data.datasets[datasetIndex].drill;if(!drill)return null;return {dimension:'trend',dataset:drill,bucketStart:A.dailyTrend[index].start,bucketEnd:A.dailyTrend[index].end};}),scales:{...baseOptions.scales,y:{...baseOptions.scales.y,ticks:{...baseOptions.scales.y.ticks,callback:value=>mode==='volume'?value:peso.format(value)}}}} });
  }
  document.querySelectorAll('[data-order-trend]').forEach(button => button.addEventListener('click', () => { document.querySelectorAll('[data-order-trend]').forEach(item=>item.classList.remove('active')); button.classList.add('active'); renderTrend(button.dataset.orderTrend); }));
  function horizontalChart(id, source, dimension, title) { const keys=Object.keys(source||{}); let chart; chart=new Chart(document.getElementById(id),{type:'bar',data:{labels:keys.map(nice),datasets:[{label:'Orders',data:keys.map(key=>source[key]),backgroundColor:keys.map((key,index)=>palette[index%palette.length]),borderRadius:5}]},options:{...baseOptions,indexAxis:'y',onHover:pointer,onClick:(event,elements)=>openDrill(chart,elements,title,index=>({dimension,value:keys[index]})),plugins:{...baseOptions.plugins,legend:{display:false}}}}); return chart; }
  charts.pipeline = horizontalChart('orderPipeline', A.statusBreakdown, 'status', 'Fulfillment pipeline');
  charts.payments = horizontalChart('orderPayments', A.paymentBreakdown, 'payment', 'Payment health');
  document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => tab.addEventListener('shown.bs.tab', () => Object.values(charts).forEach(chart => chart && chart.resize())));
  renderTrend('volume');
})();
</script>
