<script>
  function initKpiSparks() {
    function createSparkline(canvasElement, data, color) {
      if (typeof Chart === 'undefined') return null;
      var ctx = canvasElement.getContext('2d');
      var height = canvasElement.height || canvasElement.offsetHeight || 50;
      var grad = ctx.createLinearGradient(0, 0, 0, height);
      grad.addColorStop(0, color);
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      return new Chart(canvasElement, {
        type: 'line',
        data: {
          labels: [1,2,3,4,5,6,7],
          datasets:[{data:data, borderColor:color, backgroundColor:grad, fill:true, tension:0.35}]
        },
        options: {
          responsive: true, 
          maintainAspectRatio: false, 
          animation: {duration: 800}, 
          plugins: {legend: {display: false}, tooltip: {enabled: false}}, 
          elements: {point: {radius: 0}}, 
          scales: {x: {display: false}, y: {display: false}} 
        }
      });
    }

    document.querySelectorAll('.kpi-card').forEach(function(card, index) {
      // 1. Ensure Badge exists
      var badge = card.querySelector('.kpi-badge');
      if (!badge) {
        badge = document.createElement('div');
        badge.className = 'kpi-badge neutral';
        badge.textContent = '+0%'; // default placeholder to match overview look
        
        // Insert right before kpi-micro if exists, else append
        var microElement = card.querySelector('.kpi-micro');
        if (microElement) {
          card.insertBefore(badge, microElement);
        } else {
          card.appendChild(badge);
        }
      }

      // 2. Ensure Sparkline exists
      var micro = card.querySelector('.kpi-micro');
      if (!micro) return;
      var canvas = micro.querySelector('canvas');
      if (!canvas) {
        canvas = document.createElement('canvas');
        canvas.id = 'kpiSparkAuto_' + index;
        micro.appendChild(canvas);

        var color = '#2563eb'; 
        if (card.classList.contains('kpi-warning')) color = '#f59e0b';
        else if (card.classList.contains('kpi-success')) color = '#10b981';
        else if (card.classList.contains('kpi-danger')) color = '#ef4444';
        else if (card.classList.contains('kpi-info')) color = '#0dcaf0';
        else if (card.classList.contains('kpi-purple')) color = '#6f42c1';
  
        // Provide gentle waves for the background filler
        var baseData = card.classList.contains('kpi-danger') ? [1,1,2,1,1,0,1] : 
                       card.classList.contains('kpi-warning') ? [2,3,4,3,5,4,3] : 
                       card.classList.contains('kpi-success') ? [3,5,4,6,5,7,6] : 
                       [4,6,5,7,6,8,7];
  
        createSparkline(canvas, baseData, color);
      }
    });
  }

  // Auto-load Chart.js if missing, then init sparks
  if (typeof Chart === 'undefined') {
    var script = document.createElement('script');
    script.src = "https://cdn.jsdelivr.net/npm/chart.js";
    script.onload = initKpiSparks;
    document.head.appendChild(script);
  } else {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initKpiSparks);
    } else {
      initKpiSparks();
    }
  }
</script>
