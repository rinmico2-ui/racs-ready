                <div class="pw-wo-stat"><span class="k">Left</span><span class="v">${Math.max(0,(wo.unitCount||0)-(wo.completedUnitCount||0))}</span></div>
              </div>
              <div class="pw-wo-progress">
                <div class="pw-wo-progress-bar"><div class="${isFull?'full':''}" style="width:${woPct}%;"></div></div>
                <div class="pw-wo-progress-label">
                  <span>${wo.completedUnitCount||0}/${wo.unitCount||0} units</span>
