<style>
  .forgot-page-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 2rem 1rem;
  }

  .forgot-panel-container {
    width: 100%;
    max-width: 440px;
  }

  .forgot-panel-inner {
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    padding: 2.5rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .forgot-panel-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #667eea, #764ba2);
  }

  .forgot-brand {
    text-align: center;
    margin-bottom: 2rem;
  }

  .forgot-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #1a202c;
    font-weight: 700;
    font-size: 1.25rem;
    font-family: 'Outfit', sans-serif;
  }

  .forgot-brand .brand i {
    font-size: 1.5rem;
    color: #667eea;
  }

  .forgot-heading {
    text-align: center;
    margin-bottom: 2rem;
  }

  .forgot-icon-ring {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
    border: 2px solid rgba(102, 126, 234, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }

  .forgot-icon-ring i {
    font-size: 1.75rem;
    color: #667eea;
  }

  .forgot-heading h1 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a202c;
    margin: 0 0 0.5rem;
    font-family: 'Outfit', sans-serif;
  }

  .forgot-subtitle {
    color: #718096;
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.5;
  }

  .forgot-field {
    margin-bottom: 1.5rem;
  }

  .forgot-label {
    display: block;
    font-weight: 600;
    color: #2d3748;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .forgot-field .input-group {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    transition: all 0.2s ease;
  }

  .forgot-field .input-group:focus-within {
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
  }

  .forgot-field .input-group-text {
    background: #f7fafc;
    border: none;
    color: #718096;
    padding: 0.75rem 1rem;
  }

  .forgot-field .form-control {
    border: none;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    background: #ffffff;
  }

  .forgot-field .form-control:focus {
    box-shadow: none;
  }

  .field-icon {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.1rem;
  }

  .field-icon.success-icon {
    color: #48bb78;
  }

  .field-icon.error-icon {
    color: #f56565;
  }

  .field-feedback {
    font-size: 0.8rem;
    margin-top: 0.4rem;
    min-height: 1.2rem;
  }

  .field-feedback.error {
    color: #f56565;
  }

  .field-feedback.success {
    color: #48bb78;
  }

  .math-captcha {
    background: #f7fafc;
    border-radius: 12px;
    padding: 1.25rem;
    border: 1px solid #e2e8f0;
  }

  .captcha-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .refresh-captcha {
    background: none;
    border: none;
    color: #667eea;
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .refresh-captcha:hover {
    background: rgba(102, 126, 234, 0.1);
  }

  .dice-row {
    margin-bottom: 0.75rem;
  }

  .captcha-equation {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a202c;
  }

  .button.primary {
    width: 100%;
    padding: 0.875rem 1.5rem;
    background: linear-gradient(135deg, #667eea, #764ba2);
    border: none;
    border-radius: 12px;
    color: #ffffff;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    box-shadow: 0 4px 14px rgba(102, 126, 234, 0.4);
  }

  .button.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
  }

  .button.primary:active {
    transform: translateY(0);
  }

  .button.primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .forgot-footer {
    text-align: center;
    margin-top: 1.5rem;
    color: #718096;
    font-size: 0.9rem;
  }

  .forgot-link {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .forgot-link:hover {
    color: #764ba2;
    text-decoration: underline;
  }

  .forgot-success {
    text-align: center;
    padding: 1rem 0;
  }

  .success-icon-ring {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(72, 187, 120, 0.1), rgba(72, 187, 120, 0.05));
    border: 2px solid rgba(72, 187, 120, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }

  .success-icon-ring i {
    font-size: 2rem;
    color: #48bb78;
  }

  .forgot-success h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a202c;
    margin: 0 0 0.75rem;
    font-family: 'Outfit', sans-serif;
  }

  .success-text {
    color: #718096;
    font-size: 0.95rem;
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }

  .success-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  @media (max-width: 480px) {
    .forgot-panel-inner {
      padding: 2rem 1.5rem;
    }

    .forgot-heading h1,
    .forgot-success h2 {
      font-size: 1.25rem;
    }

    .forgot-icon-ring {
      width: 56px;
      height: 56px;
    }

    .forgot-icon-ring i {
      font-size: 1.5rem;
    }
  }
</style>

<div class="forgot-page-wrapper">
  <div class="forgot-panel-container">
    <div class="forgot-panel-inner">

      <!-- Brand -->
      <div class="forgot-brand">
        <a href="/" class="brand">
          <i class="bi bi-shield-lock-fill"></i>
          <span>CALIDRO RACS</span>
        </a>
      </div>

      <!-- Heading -->
      <div class="forgot-heading">
        <div class="forgot-icon-ring">
          <i class="bi bi-key"></i>
        </div>
        <h1>Reset your password</h1>
        <p class="forgot-subtitle">
          Enter your registered email and we'll send you a secure reset link.
        </p>
      </div>

      <!-- Alert -->
      <div id="forgotAlert" class="alert d-none" role="alert"></div>

      <!-- Form -->
      <form
        id="forgotForm"
        action="/api/auth/forgot-password"
        method="POST"
        autocomplete="on"
        novalidate
      >
        <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />

        <!-- Email -->
        <div class="forgot-field">
          <label for="email" class="forgot-label">Email address</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            <input
              id="email"
              name="email"
              type="email"
              class="form-control"
              placeholder="you@company.com"
              required
              autocomplete="email"
              maxlength="50"
              autofocus
            />
            <span class="field-icon success-icon d-none"><i class="bi bi-check-circle-fill"></i></span>
            <span class="field-icon error-icon d-none"><i class="bi bi-exclamation-circle-fill"></i></span>
          </div>
          <div class="field-feedback" id="emailFeedback"></div>
        </div>

        <!-- Math CAPTCHA -->
        <div class="forgot-field math-captcha">
          <div class="captcha-header">
            <label class="forgot-label" style="margin-bottom:0;">
              Verify you're human
            </label>
            <button type="button" class="refresh-captcha" title="New captcha">
              <i class="bi bi-arrow-clockwise"></i>
            </button>
          </div>
          <div class="dice-row">
            <span class="captcha-equation" id="forgotEquation"><%= num1 %> + <%= num2 %> =</span>
          </div>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-calculator"></i></span>
            <input
              id="forgot-math"
              name="mathCaptcha"
              type="text"
              inputmode="numeric"
              pattern="[0-9]{1,3}"
              maxlength="3"
              title="Enter the sum"
              class="form-control"
              placeholder="Enter the sum"
              required
              oninput="this.value = this.value.replace(/[^0-9]/g, '')"
            />
            <span class="field-icon success-icon d-none"><i class="bi bi-check-circle-fill"></i></span>
            <span class="field-icon error-icon d-none"><i class="bi bi-exclamation-circle-fill"></i></span>
          </div>
          <div class="field-feedback" id="captchaFeedback"></div>
          <input type="hidden" name="mathAnswer" value="<%= mathAnswer %>" />
        </div>

        <!-- Submit -->
        <button
          id="forgotBtn"
          class="button primary"
          type="submit"
        >
          <i class="bi bi-send-fill"></i>
          <span class="btn-text">Send Reset Link</span>
        </button>

        <!-- Footer link -->
        <div class="forgot-footer">
          Remembered your password?
          <a href="/login" class="forgot-link">Back to login</a>
        </div>
      </form>

      <!-- Success state (hidden by default) -->
      <div id="forgotSuccess" class="forgot-success d-none">
        <div class="success-icon-ring">
          <i class="bi bi-check-lg"></i>
        </div>
        <h2>Check your inbox</h2>
        <p class="success-text">
          If an account with that email exists, we've sent a password reset link.
          It will expire in 5 minutes.
        </p>
        <div class="success-actions">
          <button id="resendBtn" class="button primary" disabled>
            <span class="btn-text">Send Reset Link</span>
          </button>
          <a href="/login" class="forgot-link">Back to login</a>
        </div>
      </div>

    </div>
  </div>
</div>
