<!-- Cancel Assignment Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" role="dialog" aria-modal="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:none;border-radius:16px;overflow:hidden;">
      <div class="modal-header"
        style="background:linear-gradient(135deg,#dc2626,#991b1b);color:#fff;padding:1.25rem 1.5rem;border-bottom:none;">
        <div class="d-flex align-items-center gap-3">
          <div
            style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-size:1.3rem;">
            <i class="bi bi-exclamation-triangle"></i>
          </div>
          <div>
            <h6 class="modal-title fw-bold mb-0">Cancel Assignment</h6>
            <small style="opacity:0.85;font-size:0.8rem;" id="cancelModalSubtitle">This action requires a reason</small>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" style="padding:1.5rem;background:#f8fafc;">
        <div id="cancelAlertBox" class="alert alert-warning d-none" style="font-size:0.85rem;">
          <i class="bi bi-info-circle me-1"></i>
          The booking will be returned to the reassignment queue and the customer will be notified.
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold" style="font-size:0.85rem;">Reason for Cancellation <span
              class="text-danger">*</span></label>
          <select class="form-select" id="cancelReasonSelect" style="border-radius:10px;font-size:0.9rem;">
            <option value="">Select a reason...</option>
            <option value="emergency">Emergency</option>
            <option value="vehicle_breakdown">Vehicle Breakdown</option>
            <option value="personal">Personal Reason</option>
            <option value="weather">Weather Conditions</option>
            <option value="overlapping_job">Overlapping Job Conflict</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="mb-3 d-none" id="customReasonGroup">
          <label class="form-label fw-bold" style="font-size:0.85rem;">Please specify</label>
          <textarea class="form-control" id="customReasonText" rows="3" placeholder="Provide additional details..."
            style="border-radius:10px;font-size:0.9rem;resize:none;" maxlength="500"></textarea>
          <small class="text-muted"><span id="customReasonCount">0</span>/500</small>
        </div>
      </div>
      <div class="modal-footer" style="border-top:1px solid #e2e8f0;padding:1rem 1.5rem;background:#fff;">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:8px;">Go Back</button>
        <button type="button" class="btn btn-danger" id="confirmCancelBtn" disabled
          style="border-radius:8px;padding:8px 24px;">
          <i class="bi bi-x-circle me-1"></i>Confirm Cancellation
        </button>
      </div>
    </div>
  </div>
</div>

