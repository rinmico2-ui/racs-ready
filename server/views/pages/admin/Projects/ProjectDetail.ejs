    const p = window.__projectData;
    const techs = (p.assignedTechnicians || []);
    const opts = techs.map(t => `<option value="${t._id}">${t.name || 'Technician'}</option>`).join('');
    const modal = document.createElement('div');
    modal.className = 'pd-modal-overlay';
    modal.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);z-index:9999;display:flex;align-items:center;justify-content:center;';
    modal.innerHTML = `<div style="background:#fff;border-radius:16px;padding:1.5rem;width:420px;max-width:92vw;">
      <h4 style="font-size:1rem;font-weight:700;margin-bottom:0.35rem;"><i class="bi bi-person-plus me-2" style="color:#4f46e5;"></i>Assign Equipment</h4>
      <p style="font-size:0.82rem;color:#64748b;margin-bottom:1rem;">This item is limited / exclusive-use. Assign it to the single technician who will use it on-site. (Most shared gear stays at the project level and needs no assignment.)</p>
      <label style="font-size:0.74rem;font-weight:600;color:#64748b;">Assign To</label>
      <select id="assignTech" class="form-select form-select-sm mt-1" style="font-size:0.85rem;">${opts || '<option value="">No technicians assigned</option>'}</select>
      <div class="d-flex gap-2 justify-content-end mt-3">
        <button class="pd-btn" onclick="closeModal(this)">Cancel</button>
        <button class="pd-btn primary" id="assignBtn">Assign</button>
      </div></div>`;
    document.body.appendChild(modal);
    modal.querySelector('#assignBtn').addEventListener('click', async () => {
      const techId = modal.querySelector('#assignTech').value;
      if (!techId) { toast('Select a technician', 'error'); return; }
      try {
        const r = await fetch(`/api/projects/${projectId}/materials/${materialId}/assign`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ technicianId: techId }),
        });
        if (r.ok) { toast('Equipment assigned'); modal.remove(); loadProject(); }
        else { const e = await r.json(); toast(e.error || 'Failed', 'error'); }
      } catch(e) { toast('Failed', 'error'); }
    });
    modal.addEventListener('click', function(e) { if (e.target === this) this.remove(); });
  };

  // Technician (or coordinator) confirms equipment pickup.
  window.confirmPickup = async function(materialId, btn) {
