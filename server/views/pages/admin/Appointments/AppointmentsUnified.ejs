  AU.Equipment._loadTools=function(){
    fetch('/api/admin/tools/available').then(function(r){return r.json();}).then(function(d){
      AU.Equipment._toolCache=(d.tools||[]);
    });
  };
  AU.Equipment.searchTools=function(){
    var q=document.getElementById('assignEquipmentToolSearch').value.toLowerCase();
    var list=document.getElementById('assignEquipmentToolList');
    var tools=AU.Equipment._toolCache.filter(function(t){return t.itemName.toLowerCase().includes(q);});
    if(!tools.length){list.innerHTML='<div class="text-center text-muted py-3">No tools found</div>';return;}
    list.innerHTML=tools.map(function(t){
      var stock=t.quantity||0;
      return '<div class="form-check" style="padding:0.35rem 1.5rem;">'+
        '<input class="form-check-input" type="radio" name="equipmentToolId" id="etool_'+t._id+'" value="'+t._id+'" data-name="'+t.itemName+'">'+
        '<label class="form-check-label d-block" for="etool_'+t._id+'"><strong>'+t.itemName+'</strong> <span class="text-muted">('+stock+' in stock)</span></label>'+
      '</div>';
    }).join('');
  };
  AU.Equipment.save=function(){
    var bookingId=document.getElementById('assignEquipmentBookingId').value;
    var qty=parseInt(document.getElementById('assignEquipmentQty').value)||1;
    var notes=document.getElementById('assignEquipmentNotes').value;
    var selected=document.querySelector('input[name="equipmentToolId"]:checked');
    if(!selected){showNotification({type:'warning',title:'Select Tool',message:'Please select a tool first.',duration:3000});return;}
    var btn=document.getElementById('btnSaveEquipmentAssignment');
    btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Saving...';
    fetch('/api/admin/appointments/'+bookingId+'/equipment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({equipmentId:selected.value,quantity:qty,notes:notes})}).then(function(r){return r.json();}).then(function(d){
      btn.disabled=false; btn.innerHTML='<i class="bi bi-check-lg me-1"></i>Assign Tool';
      if(d.success){
        showNotification({type:'success',title:'Assigned',message:d.assignment?.equipmentName+' assigned.',duration:3000});
        var modalEl=document.getElementById('assignEquipmentModal');
        var modal=bootstrap.Modal.getInstance(modalEl)||new bootstrap.Modal(modalEl);
        modal.hide();
        AU.Equipment.load();
      } else {
        showNotification({type:'error',title:'Failed',message:d.error||'Could not assign equipment.',duration:4000});
      }
    }).catch(function(){
      btn.disabled=false; btn.innerHTML='<i class="bi bi-check-lg me-1"></i>Assign Tool';
      showNotification({type:'error',title:'Error',message:'Network error',duration:4000});
    });
  };

  var tabBtns=document.querySelectorAll('.au-tab-btn[data-bs-target]');
  tabBtns.forEach(function(btn){
    btn.addEventListener('shown.bs.tab',function(){
      var target=btn.getAttribute('data-bs-target').replace('#tab-','');
      switchTab(target);
    });
  });

  function auInit(){
    var params=new URLSearchParams(window.location.search);
    var initialTab=params.get('tab')||'overview';
    if(initialTab==='equipment'||initialTab==='waiting-reassign'||initialTab==='waitingReassign') initialTab='queue';
    var tabEl=document.getElementById('tab-'+initialTab);
    if(tabEl&&typeof bootstrap!=='undefined'){
      var bsTab=new bootstrap.Tab(document.querySelector('.au-tab-btn[data-bs-target="#tab-'+initialTab+'"]'));
      bsTab.show();
    }
    loaded[initialTab]=true;
    loadTab(initialTab);
  }
  if(typeof bootstrap!=='undefined'){auInit();}
  else{window.addEventListener('load',auInit);}
})();

// ═══ Global tracking drawer helpers ═══
var _trackRefreshInterval=null;
function closeTrackDrawer(){
  if(window.trackDrawerPinned)return;
  document.getElementById('trackDrawer').classList.remove('open');
  document.body.style.overflow='';
  if(_trackRefreshInterval){clearInterval(_trackRefreshInterval);_trackRefreshInterval=null;}
}
function toggleTrackDrawerPin(){
  window.trackDrawerPinned=!window.trackDrawerPinned;
  var btn=document.getElementById('trackDrawerPinBtn');
  btn.classList.toggle('pinned',window.trackDrawerPinned);
  btn.title=window.trackDrawerPinned?'Unpin (allow close)':'Keep open';
}
function startTrackingRefresh(){
  if(_trackRefreshInterval){clearInterval(_trackRefreshInterval);}
  if(!window.trackingBookingId)return;
  _trackRefreshInterval=setInterval(function(){
    if(document.getElementById('trackDrawer').classList.contains('open')&&window.trackingBookingId){
      AU.Active.trackOnMap(window.trackingBookingId);
    }
  },15000);
}
function refreshTracking(){
  if(window.trackingBookingId){showNotification({type:'info',title:'Refreshing',message:'Updating tracking data...',duration:2000});AU.Active.trackOnMap(window.trackingBookingId);}
}
function markEnRoute(){
  var btn=document.getElementById('tdBtnEnroute');
  var id=btn?btn.dataset.id:(window.trackingBookingId||'');
  if(!id)return;
  btn.disabled=true;
  btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Setting...';
  fetch('/api/appointments/'+id+'/on-the-way',{method:'POST'}).then(function(r){if(!r.ok)throw new Error('Failed');return r.json();}).then(function(){
    showNotification({type:'success',title:'En Route',message:'Technician marked as en route',duration:4000});
    AU.Active.trackOnMap(id);
    if(window.startTrackingRefresh)startTrackingRefresh();
    if(typeof AU.Active.load==='function')AU.Active.load();
    else{if(document.querySelector('.aj-refresh-btn'))document.querySelector('.aj-refresh-btn').click();}
  }).catch(function(e){
    showNotification({type:'error',title:'Error',message:e.message,duration:4000});
  }).finally(function(){
    btn.disabled=false;
    btn.innerHTML='<i class="bi bi-truck me-1"></i>Mark En Route';
  });
}
function openInFullMap(){
  if(window.trackingData&&window.trackingData.booking){
    var b=window.trackingData.booking;
    var loc=b.location;
    var coords=loc&&loc.lat&&loc.lng?loc.lat+','+loc.lng:'';
    var addr=encodeURIComponent(loc&&loc.address?loc.address:'Service Location');
    if(coords)window.open('https://www.google.com/maps?q='+coords,'_blank');
    else window.open('https://www.google.com/maps/search/'+addr,'_blank');
  }
}
document.addEventListener('keydown',function(e){
  if(e.key==='Escape'&&document.getElementById('trackDrawer').classList.contains('open'))closeTrackDrawer();
});

// Stat card sparklines
window.AU = window.AU || {};
(function(){
  function spark(ctx, data, color){
    if(!ctx || !window.Chart) return null;
    var h = ctx.canvas.height || ctx.canvas.offsetHeight || 40;
    var g = ctx.createLinearGradient(0,0,0,h);
    g.addColorStop(0, color);
    g.addColorStop(1, 'rgba(255,255,255,0)');
    return new Chart(ctx, {
      type: 'line',
      data: {
        labels: data.map(function(_,i){ return i+1; }),
        datasets: [{ data: data, borderColor: color, backgroundColor: g, fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2 }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        animation: { duration: 600 },
        plugins: { legend: { display: false }, tooltip: { enabled: false } },
        scales: { x: { display: false }, y: { display: false } }
      }
    });
  }
  function randomData(n){
    var arr = [8 + Math.random()*12];
    for(var i=1; i<n; i++){ arr.push(Math.max(3, Math.min(30, arr[i-1] + (Math.random()-0.5)*12))); }
    return arr;
  }
  window.AU.drawStatSparklines = function(scope){
    scope = scope || document;
    if(!window.Chart) return;
    scope.querySelectorAll('.stat-sparkline canvas:not([data-spark-init])').forEach(function(c){
      c.setAttribute('data-spark-init','1');
      var card = c.closest('.stat-card');
      var color = card ? (card.dataset.sparkColor || '#2563eb') : '#2563eb';
      spark(c.getContext('2d'), randomData(10), color);
    });
  };
  window.AU.drawStatSparklines();
})();
</script>
