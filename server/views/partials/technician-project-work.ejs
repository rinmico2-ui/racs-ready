        <div class="pw-d-list" style="margin-top:.6rem;">
          <div class="row"><i class="bi bi-shield-check"></i><span class="muted">You are the lead — coordinate the crew and report blockers.</span></div>
          <div class="row"><i class="bi bi-bell"></i><span class="muted">Notify admin for escalations or extra resources.</span></div>
        </div>
      </div>`;
  }
