<div class="admin-dashboard container-fluid py-4 inventory-premium">
  <%- include('../../../partials/dashboard-styles') %>
  <style>
    .inventory-premium .dash-card {
      background: #fff;
      border-radius: 18px;
      padding: 1.5rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      border: 1px solid #f1f5f9;
    }
    .inventory-premium .dash-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    }
    .inventory-premium .kpi-title { font-size: 0.75rem; font-weight: 600; color: #64748b; margin-bottom: 6px; }
    .inventory-premium .kpi-icon {
      width: 48px; height: 48px; border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 14px rgba(0,0,0,0.12); flex-shrink: 0;
    }
    .inventory-premium .kpi-icon i { color: #fff !important; font-size: 1.3rem; }
    .inventory-premium .inv-kpi-value { font-size: 1.5rem; font-weight: 700; color: #0f172a; line-height: 1.1; margin-bottom: 8px; }
    .inventory-premium .inv-kpi-sub { display: block; font-size: 0.75rem; color: #94a3b8; margin-top: 4px; }
    .inventory-premium .inv-kpi-pill { font-size: 0.7rem; padding: 2px 8px; border-radius: 20px; font-weight: 700; }
    .inventory-premium .kpi-trend { display: inline-flex; align-items: center; gap: 2px; font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 20px; background: #f0fdf4; color: #16a34a; }
    .inventory-premium .kpi-trend i { font-size: 0.7rem; }
    .inventory-premium .dash-card { display: flex; flex-direction: column; }
    .inventory-premium .inv-kpi-spark-wrap { width: 100%; height: 40px; margin-top: auto; }
    .inventory-premium .inv-kpi-spark { width: 100% !important; height: 100% !important; display: block; }
    .inventory-premium .rp-toolbar { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 16px 20px; margin-bottom: 20px; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px; }
    .inventory-premium .rp-filter-group { display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 180px; }
    .inventory-premium .rp-filter-group.search { flex: 1.8; }
    .inventory-premium .rp-filter-label { font-size: 0.65rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.6px; }
    .inventory-premium .rp-filter-group .input-group-text { background: #fff; border-color: #e2e8f0; color: #64748b; border-radius: 10px 0 0 10px; height: 42px; }
    .inventory-premium .rp-filter-group .form-control { border-color: #e2e8f0; border-radius: 0 10px 10px 0; height: 42px; }
    .inventory-premium .rp-filter-input { border-radius: 10px; border-color: #e2e8f0; height: 42px; }
    .inventory-premium .rp-filter-btn { height: 42px; border-radius: 10px; padding: 0 20px; font-weight: 600; }
    .inventory-premium .bg-success-subtle { background-color: rgba(16, 185, 129, 0.15); }
    .inventory-premium .bg-info-subtle { background-color: rgba(8, 145, 178, 0.15); }
    .inventory-premium .bg-warning-subtle { background-color: rgba(245, 158, 11, 0.15); }
    .inventory-premium .bg-danger-subtle { background-color: rgba(220, 38, 38, 0.15); }
    .inventory-premium .bg-primary-subtle { background-color: rgba(59, 130, 246, 0.15); }
    .inventory-premium .bg-secondary-subtle { background-color: rgba(100, 116, 139, 0.15); }
    .inventory-premium .fs-7 { font-size: 0.75rem; }
    .inv-pagination { display: flex; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
    .inv-pagination .page-item .page-link { padding: 8px 14px; border-radius: 10px; border: 1.5px solid rgba(148,163,184,0.3); background: rgba(255,255,255,0.8); color: #475569; font-weight: 600; font-size: 0.85rem; transition: all 0.3s ease; cursor: pointer; }
    .inv-pagination .page-item:not(.disabled) .page-link:hover { background: #fff; border-color: #2563eb; color: #2563eb; }
    .inv-pagination .page-item.disabled .page-link { opacity: 0.5; cursor: default; }
    .inv-pagination .page-item.active .page-link { background: #2563eb; color: #fff; border-color: #2563eb; }
    .customer-avatar { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0; }
    .text-micro { font-size: 0.78rem; }
    .btn-micro { padding: 2px 8px; font-size: 0.75rem; }
    #customerTableBody tr { transition: background 0.15s; }
    #customerTableBody tr:hover { background: #f8fafc; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #94a3b8; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    .loading-spinner { display: flex; justify-content: center; align-items: center; padding: 3rem; }
    .loading-spinner .spinner-border { width: 2rem; height: 2rem; color: #2563eb; }

    .ent-modal { border: none; border-radius: 16px; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.25); }
    .ent-modal-header { background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 50%, #2563eb 100%); color: #fff; padding: 20px 24px; border: none; display: flex; align-items: center; justify-content: space-between; }
    .ent-modal-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
    .ent-modal-body { padding: 24px; font-family: 'Inter', sans-serif; font-size: 0.9rem; color: #334155; max-height: calc(100vh - 200px); overflow-y: auto; }
    .ent-detail-label { font-family: 'Outfit', sans-serif; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; color: #94a3b8; }
    .ent-detail-value { font-family: 'Inter', sans-serif; font-size: 0.95rem; font-weight: 600; color: #1e293b; }
    .ent-detail-card { background: #f8fafc; border: 1px solid #f1f5f9; border-radius: 12px; padding: 14px 16px; }
    .ent-detail-card:hover { background: #f1f5f9; }
    .cust-modal-avatar { width: 64px; height: 64px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.4rem; flex-shrink: 0; border: 3px solid rgba(255,255,255,0.2); }
    .cust-modal-section-title { font-family: 'Outfit', sans-serif; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #94a3b8; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid #f1f5f9; }
    .cust-violation-item { background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 10px 14px; margin-bottom: 8px; }
    .cust-violation-item:last-child { margin-bottom: 0; }
    .ent-modal-footer { padding: 16px 24px; border-top: 1px solid #f1f5f9; background: #fafbfc; display: flex; gap: 10px; flex-wrap: wrap; }
    .ent-modal-footer .btn { font-family: 'Inter', sans-serif; font-weight: 600; border-radius: 8px; font-size: 0.85rem; }
    #customerDetailModal .modal-lg { max-width: 600px; }
  </style>

  <div class="au-hero mb-4">
    <div class="au-hero-inner">
      <div class="au-hero-left">
        <div class="au-hero-icon"><i class="bi bi-people-fill"></i></div>
        <div>
          <h1>Customer Directory</h1>
          <p>Manage customer records, lifecycle status, and account health</p>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI cards -->
  <div class="row g-3 mb-4">
    <div class="col-lg col-md-6">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="0">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="kpi-title">Total Customers</div>
            <div class="d-flex align-items-center gap-2">
              <span class="inv-kpi-value mb-0" id="custTotal">--</span>
              <span class="badge inv-kpi-pill bg-primary-subtle text-primary">All</span>
            </div>
            <span class="inv-kpi-sub">Registered accounts</span>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #2563eb, #1d4ed8);">
            <i class="bi bi-people-fill"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg col-md-6">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="100">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="kpi-title">Active Accounts</div>
            <div class="d-flex align-items-center gap-2">
              <span class="inv-kpi-value mb-0" id="custActive">--</span>
              <span class="badge inv-kpi-pill bg-info-subtle text-info">Active</span>
            </div>
            <span class="inv-kpi-sub">In good standing</span>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #06b6d4, #0891b2);">
            <i class="bi bi-person-check-fill"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg col-md-6">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="200">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="kpi-title">VIP Customers</div>
            <div class="d-flex align-items-center gap-2">
              <span class="inv-kpi-value mb-0" id="custVIP">--</span>
              <span class="badge inv-kpi-pill bg-warning-subtle text-warning">VIP</span>
            </div>
            <span class="inv-kpi-sub">Priority accounts</span>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
            <i class="bi bi-star-fill"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg col-md-6">
      <div class="dash-card h-100" data-aos="fade-up" data-aos-delay="300">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="kpi-title">Blocked Accounts</div>
            <div class="d-flex align-items-center gap-2">
              <span class="inv-kpi-value mb-0" id="custBlocked">--</span>
              <span class="badge inv-kpi-pill bg-danger-subtle text-danger">Blocked</span>
            </div>
            <span class="inv-kpi-sub">Suspended access</span>
          </div>
          <div class="kpi-icon" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
            <i class="bi bi-slash-circle-fill"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="rp-toolbar">
    <div class="rp-filter-group search">
      <label class="rp-filter-label" for="customerSearchInput"><i class="bi bi-search me-1"></i>Search Customer</label>
      <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" id="customerSearchInput" placeholder="Name, email, or phone" />
      </div>
    </div>
    <div class="rp-filter-group">
      <label class="rp-filter-label" for="customerStatusFilter"><i class="bi bi-funnel me-1"></i>Status</label>
      <select class="form-select rp-filter-input" id="customerStatusFilter" style="height:42px;">
        <option value="all">All Status</option>
        <option value="active">Active</option>
        <option value="vip">VIP</option>
        <option value="blocked">Blocked</option>
      </select>
    </div>
    <button class="btn btn-primary rp-filter-btn" type="button" id="customerFilterBtn" title="Apply filters"><i class="bi bi-funnel-fill me-2"></i>Filter</button>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h6 class="mb-0 fw-bold">Customer Records</h6>
      <span class="text-muted small fw-normal" id="customerCountLabel">Loading...</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover table-dense align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th class="ps-4">Customer</th>
            <th>Contact</th>
            <th>Address</th>
            <th>Status</th>
            <th>Joined</th>
            <th class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody id="customerTableBody">
          <tr>
            <td colspan="6">
              <div class="loading-spinner">
                <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="card-footer bg-white py-3 border-top">
      <nav aria-label="Customer pagination">
        <ul class="inv-pagination justify-content-end mb-0" id="customerPagination"></ul>
      </nav>
    </div>
  </div>
</div>

<!-- Customer Detail Modal -->
<div class="modal fade" id="customerDetailModal" tabindex="-1" aria-labelledby="customerDetailModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content ent-modal">
      <div class="modal-header ent-modal-header">
        <div class="d-flex align-items-center gap-3">
          <div class="ent-modal-icon bg-info-subtle"><i class="bi bi-person-badge text-info"></i></div>
          <div>
            <h6 class="modal-title fw-bold mb-0" id="customerDetailModalLabel">Customer Details</h6>
            <small class="text-white-50">Account overview and management</small>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body ent-modal-body" id="customerModalBody">
        <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  var allCustomers = [];
  var filteredCustomers = [];
  var currentPage = 1;
  var perPage = 10;

  function getInitials(firstName, lastName) {
    return ((firstName || '')[0] || '') + ((lastName || '')[0] || '');
  }

  function getStatusInfo(c) {
    if (c.blocked) return { label: 'Blocked', cls: 'bg-danger-subtle text-danger border border-danger-subtle' };
    if (c.vip) return { label: 'VIP', cls: 'bg-warning-subtle text-warning border border-warning-subtle' };
    return { label: 'Active', cls: 'bg-success-subtle text-success border border-success-subtle' };
  }

  function getAvatarColor(c) {
    if (c.blocked) return 'bg-danger-subtle text-danger';
    if (c.vip) return 'bg-warning-subtle text-warning';
    return 'bg-primary-subtle text-primary';
  }

  function formatDate(d) {
    if (!d) return '--';
    var dt = new Date(d);
    return dt.toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function renderKPIs() {
    var total = allCustomers.length;
    var active = allCustomers.filter(function(c){ return !c.blocked; }).length;
    var vip = allCustomers.filter(function(c){ return c.vip; }).length;
    var blocked = allCustomers.filter(function(c){ return c.blocked; }).length;
    document.getElementById('custTotal').textContent = total.toLocaleString();
    document.getElementById('custActive').textContent = active.toLocaleString();
    document.getElementById('custVIP').textContent = vip.toLocaleString();
    document.getElementById('custBlocked').textContent = blocked.toLocaleString();
  }

  function applyFilter() {
    var q = document.getElementById('customerSearchInput').value.toLowerCase().trim();
    var status = document.getElementById('customerStatusFilter').value;
    filteredCustomers = allCustomers.filter(function(c) {
      var name = ((c.firstName || '') + ' ' + (c.lastName || '')).toLowerCase();
      var email = (c.email || '').toLowerCase();
      var phone = (c.phone || '').toLowerCase();
      var matchSearch = !q || name.indexOf(q) !== -1 || email.indexOf(q) !== -1 || phone.indexOf(q) !== -1;
      var matchStatus = true;
      if (status === 'active') matchStatus = !c.blocked;
      else if (status === 'blocked') matchStatus = c.blocked;
      else if (status === 'vip') matchStatus = c.vip;
      return matchSearch && matchStatus;
    });
    currentPage = 1;
    renderTable();
    renderPagination();
  }

  function renderTable() {
    var tbody = document.getElementById('customerTableBody');
    var start = (currentPage - 1) * perPage;
    var pageItems = filteredCustomers.slice(start, start + perPage);
    var total = filteredCustomers.length;
    document.getElementById('customerCountLabel').textContent = total + ' total records';

    if (pageItems.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><i class="bi bi-people"></i><p>No customers found</p></div></td></tr>';
      return;
    }

    var html = '';
    pageItems.forEach(function(c) {
      var initials = getInitials(c.firstName, c.lastName);
      var fullName = ((c.firstName || '') + ' ' + (c.lastName || '')).trim() || 'Unknown';
      var status = getStatusInfo(c);
      var avatarCls = getAvatarColor(c);
      var addr = [c.address && c.address.city, c.address && c.address.province].filter(Boolean).join(', ') || '--';

      html += '<tr>' +
        '<td class="ps-4">' +
          '<div class="d-flex align-items-center">' +
            '<div class="customer-avatar ' + avatarCls + ' me-2">' + initials + '</div>' +
            '<div>' +
              '<div class="fw-bold text-dark">' + fullName + '</div>' +
              '<div class="text-muted text-micro">ID: ' + c._id.slice(-6).toUpperCase() + '</div>' +
            '</div>' +
          '</div>' +
        '</td>' +
        '<td>' +
          '<div class="text-dark text-micro">' + (c.email || '--') + '</div>' +
          '<div class="text-muted text-micro">' + (c.phone || '--') + '</div>' +
        '</td>' +
        '<td class="text-muted text-micro">' + addr + '</td>' +
        '<td><span class="badge ' + status.cls + '">' + status.label + '</span></td>' +
        '<td class="text-muted text-micro">' + formatDate(c.createdAt) + '</td>' +
        '<td class="text-end pe-4">' +
          '<button class="btn btn-micro btn-light border view-customer-btn" data-id="' + c._id + '" title="View">' +
            '<i class="bi bi-eye text-primary"></i>' +
          '</button>' +
        '</td>' +
      '</tr>';
    });
    tbody.innerHTML = html;
  }

  function renderPagination() {
    var totalPages = Math.ceil(filteredCustomers.length / perPage) || 1;
    var pag = document.getElementById('customerPagination');
    var html = '';

    html += '<li class="page-item' + (currentPage <= 1 ? ' disabled' : '') + '">' +
      '<a class="page-link" data-page="' + (currentPage - 1) + '">Previous</a></li>';

    for (var i = 1; i <= totalPages; i++) {
      if (totalPages > 7) {
        if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
          html += '<li class="page-item' + (i === currentPage ? ' active' : '') + '">' +
            '<a class="page-link" data-page="' + i + '">' + i + '</a></li>';
        } else if (i === currentPage - 2 || i === currentPage + 2) {
          html += '<li class="page-item disabled"><a class="page-link">...</a></li>';
        }
      } else {
        html += '<li class="page-item' + (i === currentPage ? ' active' : '') + '">' +
          '<a class="page-link" data-page="' + i + '">' + i + '</a></li>';
      }
    }

    html += '<li class="page-item' + (currentPage >= totalPages ? ' disabled' : '') + '">' +
      '<a class="page-link" data-page="' + (currentPage + 1) + '">Next</a></li>';

    pag.innerHTML = html;
  }

  document.getElementById('customerPagination').addEventListener('click', function(e) {
    var link = e.target.closest('.page-link');
    if (!link) return;
    var page = parseInt(link.getAttribute('data-page'));
    if (isNaN(page) || page < 1) return;
    var totalPages = Math.ceil(filteredCustomers.length / perPage) || 1;
    if (page > totalPages) return;
    currentPage = page;
    renderTable();
    renderPagination();
  });

  document.getElementById('customerFilterBtn').addEventListener('click', applyFilter);
  document.getElementById('customerSearchInput').addEventListener('keyup', function(e) {
    if (e.key === 'Enter') applyFilter();
  });

  document.getElementById('customerTableBody').addEventListener('click', function(e) {
    var btn = e.target.closest('.view-customer-btn');
    if (!btn) return;
    var id = btn.getAttribute('data-id');
    openCustomerModal(id);
  });

  function openCustomerModal(id) {
    var modal = document.getElementById('customerDetailModal');
    var bsModal = new bootstrap.Modal(modal);
    var body = document.getElementById('customerModalBody');
    body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>';
    bsModal.show();

    fetch('/api/admin/customers/' + id, { credentials: 'same-origin' })
      .then(function(r) { if (!r.ok) throw new Error('Not found'); return r.json(); })
      .then(function(data) {
        var c = data.user;
        if (!c) { body.innerHTML = '<p class="text-danger">Customer not found.</p>'; return; }

        // Collect PSGC codes to resolve
        var codesToResolve = [];
        if (c.address && c.address.barangay) codesToResolve.push(c.address.barangay);
        if (c.address && c.address.city) codesToResolve.push(c.address.city);
        if (c.address && c.address.province) codesToResolve.push(c.address.province);

        var resolvePromise = codesToResolve.length > 0
          ? fetch('/api/psgc/resolve?codes=' + encodeURIComponent(codesToResolve.join(',')), { credentials: 'same-origin' })
              .then(function(r) { return r.json(); })
              .then(function(d) { return d.resolved || {}; })
              .catch(function() { return {}; })
          : Promise.resolve({});

        return resolvePromise.then(function(resolved) {
          var fullName = ((c.firstName || '') + ' ' + (c.lastName || '')).trim() || 'Unknown';
          var initials = ((c.firstName || '')[0] || '') + ((c.lastName || '')[0] || '');
          var statusLabel = c.blocked ? 'Blocked' : c.vip ? 'VIP' : 'Active';
          var statusCls = c.blocked ? 'bg-danger-subtle text-danger' : c.vip ? 'bg-warning-subtle text-warning' : 'bg-success-subtle text-success';
          var avatarBg = c.blocked ? 'bg-danger-subtle text-danger' : c.vip ? 'bg-warning-subtle text-warning' : 'bg-primary-subtle text-primary';
          var barangay = resolved[(c.address && c.address.barangay)] || (c.address && c.address.barangay) || '--';
          var city = resolved[(c.address && c.address.city)] || (c.address && c.address.city) || '--';
          var province = resolved[(c.address && c.address.province)] || (c.address && c.address.province) || '--';
          var postal = (c.address && c.address.postalCode) || '--';
          var joined = c.createdAt ? new Date(c.createdAt).toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' }) : '--';
          var lastLogin = c.lastLogin ? new Date(c.lastLogin).toLocaleString('en', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Never';
          var violations = c.violations || [];

          var html = '';

          // Profile header
          html += '<div class="d-flex align-items-center mb-4 p-3 rounded-3" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border: 1px solid #e2e8f0;">' +
            '<div class="cust-modal-avatar ' + avatarBg + ' me-3">' + initials + '</div>' +
            '<div class="flex-grow-1">' +
              '<h5 class="mb-1 fw-bold text-dark">' + fullName + '</h5>' +
              '<div class="d-flex align-items-center gap-2 flex-wrap">' +
                '<span class="badge ' + statusCls + '">' + statusLabel + '</span>' +
                (c.vip ? '<span class="badge bg-warning-subtle text-warning"><i class="bi bi-star-fill me-1"></i>VIP</span>' : '') +
                '<span class="text-muted" style="font-size:0.75rem;">ID: ' + c._id.slice(-8).toUpperCase() + '</span>' +
              '</div>' +
            '</div>' +
          '</div>';

          // Contact Information
          html += '<div class="mb-4">' +
            '<div class="cust-modal-section-title"><i class="bi bi-person-lines-fill me-1"></i>Contact Information</div>' +
            '<div class="row g-3">' +
              '<div class="col-sm-6"><div class="ent-detail-card h-100">' +
                '<div class="ent-detail-label mb-1"><i class="bi bi-envelope me-1"></i>Email</div>' +
                '<div class="ent-detail-value">' + (c.email || '--') + '</div>' +
              '</div></div>' +
              '<div class="col-sm-6"><div class="ent-detail-card h-100">' +
                '<div class="ent-detail-label mb-1"><i class="bi bi-phone me-1"></i>Phone</div>' +
                '<div class="ent-detail-value">' + (c.phone || '--') + '</div>' +
              '</div></div>' +
            '</div>' +
          '</div>';

          // Address
          html += '<div class="mb-4">' +
            '<div class="cust-modal-section-title"><i class="bi bi-geo-alt me-1"></i>Address</div>' +
            '<div class="row g-3">' +
              '<div class="col-sm-6"><div class="ent-detail-card h-100">' +
                '<div class="ent-detail-label mb-1">Barangay</div>' +
                '<div class="ent-detail-value">' + barangay + '</div>' +
              '</div></div>' +
              '<div class="col-sm-6"><div class="ent-detail-card h-100">' +
                '<div class="ent-detail-label mb-1">City</div>' +
                '<div class="ent-detail-value">' + city + '</div>' +
              '</div></div>' +
              '<div class="col-sm-6"><div class="ent-detail-card h-100">' +
                '<div class="ent-detail-label mb-1">Province</div>' +
                '<div class="ent-detail-value">' + province + '</div>' +
              '</div></div>' +
              '<div class="col-sm-6"><div class="ent-detail-card h-100">' +
                '<div class="ent-detail-label mb-1">Postal Code</div>' +
                '<div class="ent-detail-value">' + postal + '</div>' +
              '</div></div>' +
            '</div>' +
          '</div>';

          // Account Activity
          html += '<div class="mb-4">' +
            '<div class="cust-modal-section-title"><i class="bi bi-activity me-1"></i>Account Activity</div>' +
            '<div class="row g-3">' +
              '<div class="col-sm-6"><div class="ent-detail-card h-100">' +
                '<div class="ent-detail-label mb-1"><i class="bi bi-calendar-check me-1"></i>Date Joined</div>' +
                '<div class="ent-detail-value">' + joined + '</div>' +
              '</div></div>' +
              '<div class="col-sm-6"><div class="ent-detail-card h-100">' +
                '<div class="ent-detail-label mb-1"><i class="bi bi-clock-history me-1"></i>Last Login</div>' +
                '<div class="ent-detail-value">' + lastLogin + '</div>' +
              '</div></div>' +
              '<div class="col-sm-6"><div class="ent-detail-card h-100">' +
                '<div class="ent-detail-label mb-1"><i class="bi bi-exclamation-triangle me-1"></i>Violations</div>' +
                '<div class="ent-detail-value">' + violations.length + (violations.length === 1 ? ' record' : ' records') + '</div>' +
              '</div></div>' +
              '<div class="col-sm-6"><div class="ent-detail-card h-100">' +
                '<div class="ent-detail-label mb-1"><i class="bi bi-bookmark me-1"></i>Booking Limit</div>' +
                '<div class="ent-detail-value">' + (c.bookingLimit || 'Unlimited') + '</div>' +
              '</div></div>' +
            '</div>' +
          '</div>';

          // Violations list (if any)
          if (violations.length > 0) {
            html += '<div class="mb-3">' +
              '<div class="cust-modal-section-title"><i class="bi bi-shield-exclamation me-1"></i>Violation History</div>';
            violations.forEach(function(v) {
              var vDate = v.createdAt ? new Date(v.createdAt).toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
              html += '<div class="cust-violation-item">' +
                '<div class="d-flex justify-content-between align-items-start">' +
                  '<div><span class="fw-semibold text-danger">' + (v.type || 'Violation') + '</span>' +
                  (v.message ? '<div class="text-muted mt-1" style="font-size:0.82rem;">' + v.message + '</div>' : '') + '</div>' +
                  '<small class="text-muted">' + vDate + '</small>' +
                '</div>' +
              '</div>';
            });
            html += '</div>';
          }

          body.innerHTML = html;

          // Build footer with action buttons
          var existingFooter = modal.querySelector('.ent-modal-footer');
          if (existingFooter) existingFooter.remove();

          var footer = document.createElement('div');
          footer.className = 'ent-modal-footer';
          footer.innerHTML =
            '<button class="btn ' + (c.blocked ? 'btn-success' : 'btn-outline-danger') + ' action-btn" data-action="' + (c.blocked ? 'unblock' : 'block') + '" data-id="' + c._id + '">' +
              '<i class="bi ' + (c.blocked ? 'bi-unlock' : 'bi-lock') + ' me-1"></i>' + (c.blocked ? 'Unblock Account' : 'Block Account') +
            '</button>' +
            '<button class="btn ' + (c.vip ? 'btn-outline-warning' : 'btn-warning') + ' action-btn" data-action="' + (c.vip ? 'revoke_vip' : 'grant_vip') + '" data-id="' + c._id + '">' +
              '<i class="bi ' + (c.vip ? 'bi-star' : 'bi-star-fill') + ' me-1"></i>' + (c.vip ? 'Revoke VIP' : 'Grant VIP') +
            '</button>';
          modal.querySelector('.modal-content').appendChild(footer);

          footer.querySelectorAll('.action-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
              var action = btn.getAttribute('data-action');
              var custId = btn.getAttribute('data-id');
              btn.disabled = true;
              btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing...';
              fetch('/api/admin/customers/' + custId, {
                method: 'PATCH',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: action })
              })
              .then(function(r) { return r.json(); })
              .then(function() {
                bsModal.hide();
                return fetch('/api/admin/customers', { credentials: 'same-origin' });
              })
              .then(function(r) { return r.json(); })
              .then(function(data) {
                allCustomers = data.customers || [];
                filteredCustomers = allCustomers.slice();
                renderKPIs();
                renderTable();
                renderPagination();
                applyFilter();
              })
              .catch(function(err) { alert('Action failed: ' + err.message); btn.disabled = false; });
            });
          });
        });
      })
      .catch(function(err) {
        body.innerHTML = '<div class="text-center py-4"><i class="bi bi-exclamation-triangle text-warning" style="font-size:2rem;"></i><p class="text-danger mt-2 mb-0">Failed to load customer details.</p></div>';
      });
  }

  fetch('/api/admin/customers', { credentials: 'same-origin' })
    .then(function(r) {
      if (!r.ok) throw new Error('Failed to fetch customers');
      return r.json();
    })
    .then(function(data) {
      allCustomers = data.customers || [];
      filteredCustomers = allCustomers.slice();
      renderKPIs();
      renderTable();
      renderPagination();
    })
    .catch(function(err) {
      console.error('Error loading customers:', err);
      document.getElementById('customerTableBody').innerHTML =
        '<tr><td colspan="6"><div class="empty-state"><i class="bi bi-exclamation-triangle"></i><p>Failed to load customers. Please try again.</p></div></td></tr>';
    });
})();
</script>
