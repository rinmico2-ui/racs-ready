<%
  const sidebarCurrentPath = typeof currentPath === 'string' ? currentPath : '';
  const sidebarPathMatches = function(prefix) {
    return sidebarCurrentPath === prefix || sidebarCurrentPath.startsWith(prefix + '/');
  };
  const bookingsGroupOpen = sidebarPathMatches('/secretary/appointments')
    || sidebarPathMatches('/secretary/maintenance')
    || sidebarPathMatches('/secretary/projects')
    || sidebarPathMatches('/secretary/operations/resolution-center')
    || sidebarPathMatches('/secretary/inventory/ordered-products');
  const servicesGroupOpen = sidebarPathMatches('/secretary/services');
  const inventoryGroupOpen = sidebarPathMatches('/secretary/pointofsale')
    || sidebarPathMatches('/secretary/inventory/repair-parts')
    || sidebarCurrentPath === '/secretary/inventory'
    || sidebarPathMatches('/secretary/inventory/history');
  const peopleGroupOpen = sidebarPathMatches('/secretary/customers')
    || sidebarPathMatches('/secretary/technicians')
    || sidebarPathMatches('/secretary/staff')
    || sidebarPathMatches('/secretary/attendance');
  const financeGroupOpen = sidebarPathMatches('/secretary/payments')
    || sidebarPathMatches('/secretary/payroll');
  const analyticsGroupOpen = sidebarPathMatches('/secretary/reports');
  const sidebarUser = typeof user !== 'undefined' && user ? user : {};
  const sidebarName = sidebarUser.name || sidebarUser.fullName
    || [sidebarUser.firstName, sidebarUser.lastName].filter(Boolean).join(' ')
    || sidebarUser.email || 'Secretary';
  const sidebarInitial = String(sidebarName || 'S').trim().charAt(0).toUpperCase() || 'S';
%>

<div class="sidebar admin-modern-sidebar secretary-modern-sidebar" id="sidebar">
  <a class="sidebar-brand" href="/secretary" aria-label="RACS Secretary dashboard">
    <span class="brand-icon" aria-hidden="true"><img src="/images/LOGO/RACS.png" alt="" /></span>
    <span class="brand-text">
      <strong class="brand-name">RACS</strong>
      <span class="brand-sub">Secretary Console</span>
    </span>
    <span class="brand-status" title="Operations workspace online" aria-label="Operations workspace online"></span>
  </a>
  <button class="sidebar-mobile-close" type="button" data-admin-sidebar-close aria-label="Close navigation"><i class="bi bi-x-lg" aria-hidden="true"></i></button>

  <nav class="sidebar-navigation" aria-label="Secretary navigation">
    <ul class="sidebar-nav nav-list">
      <li class="nav-section" aria-hidden="true"><span class="section-label">Core</span><span class="section-line"></span></li>
      <li class="nav-item"><a href="/secretary" class="nav-link" data-permission="dashboard.view"><i class="bi bi-grid-1x2-fill nav-icon"></i><span class="nav-label">Dashboard</span></a></li>

      <li class="nav-section" aria-hidden="true"><span class="section-label">Operations</span><span class="section-line"></span></li>
      <li class="nav-item"><a href="/secretary/operations/calendar" class="nav-link" data-permission="appointments.view"><i class="bi bi-calendar4-week nav-icon"></i><span class="nav-label">Operations Calendar</span></a></li>

      <li class="nav-item nav-group<%= bookingsGroupOpen ? ' expanded' : '' %>">
        <button class="btn btn-toggle nav-link<%= bookingsGroupOpen ? ' active' : ' collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#appointment-mgmt-collapse" aria-controls="appointment-mgmt-collapse" aria-expanded="<%= bookingsGroupOpen ? 'true' : 'false' %>">
          <i class="bi bi-kanban nav-icon"></i><span class="nav-label">Work</span><span class="nav-badge badge bg-warning text-dark" id="pendingReviewCount" style="display:none;">0</span><i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        <div class="collapse<%= bookingsGroupOpen ? ' show' : '' %>" id="appointment-mgmt-collapse" data-default-open="<%= bookingsGroupOpen ? 'true' : 'false' %>">
          <ul class="btn-toggle-nav list-unstyled">
            <li class="nav-subsection">Bookings &amp; sales</li>
            <li><a href="/secretary/appointments" class="nav-link" data-permission="appointments.view"><i class="bi bi-calendar2-check nav-icon"></i><span class="nav-label">Bookings</span><span class="nav-badge badge bg-primary" id="appointmentsBadge" style="display:none;">0</span></a></li>
            <li><a href="/secretary/inventory/ordered-products" class="nav-link" data-permission="orders.view"><i class="bi bi-bag-check nav-icon"></i><span class="nav-label">Orders</span><span class="nav-badge badge bg-info" id="ordersBadge" style="display:none;" title="Orders requiring action">0</span></a></li>
            <li><a href="/secretary/appointments/walk-in" class="nav-link" data-permission="appointments.manage"><i class="bi bi-person-plus nav-icon"></i><span class="nav-label">Walk-in Transaction</span></a></li>
            <li class="nav-subsection">Field operations</li>
            <li><a href="/secretary/appointments/repair-scheduling" class="nav-link" data-permission="appointments.manage"><i class="bi bi-wrench-adjustable nav-icon"></i><span class="nav-label">Repair Workflow</span><span class="nav-badge badge badge-purple" id="repairSchedBadge" style="display:none;">0</span></a></li>
            <li><a href="/secretary/appointments/expenses" class="nav-link" data-permission="appointments.view"><i class="bi bi-receipt nav-icon"></i><span class="nav-label">Expenses</span><span class="nav-badge badge bg-warning text-dark" id="expensesBadge" style="display:none;">0</span></a></li>
            <li><a href="/secretary/projects" class="nav-link" data-permission="appointments.view"><i class="bi bi-building nav-icon"></i><span class="nav-label">Projects</span><span class="nav-badge badge badge-indigo" id="projectsBadge" style="display:none;">0</span></a></li>
            <li class="nav-subsection">Customer care</li>
            <li><a href="/secretary/maintenance" class="nav-link" data-permission="appointments.view"><i class="bi bi-calendar2-heart nav-icon"></i><span class="nav-label">Maintenance</span></a></li>
            <li><a href="/secretary/operations/resolution-center" class="nav-link" data-permission="appointments.view"><i class="bi bi-exclamation-diamond nav-icon"></i><span class="nav-label">Resolution Center</span><span class="nav-badge badge bg-warning text-dark" id="attentionBadge" style="display:none;">0</span></a></li>
            <li><a href="/secretary/appointments/cancellation-log" class="nav-link" data-permission="appointments.view"><i class="bi bi-clock-history nav-icon"></i><span class="nav-label">Cancellation Log</span><span class="nav-badge badge bg-danger" id="escalatedBadge" style="display:none;">0</span></a></li>
          </ul>
        </div>
      </li>

      <li class="nav-item nav-group<%= servicesGroupOpen ? ' expanded' : '' %>">
        <button class="btn btn-toggle nav-link<%= servicesGroupOpen ? ' active' : ' collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#services-collapse" aria-controls="services-collapse" aria-expanded="<%= servicesGroupOpen ? 'true' : 'false' %>">
          <i class="bi bi-tools nav-icon"></i><span class="nav-label">Service Catalog</span><i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        <div class="collapse<%= servicesGroupOpen ? ' show' : '' %>" id="services-collapse" data-default-open="<%= servicesGroupOpen ? 'true' : 'false' %>">
          <ul class="btn-toggle-nav list-unstyled">
            <li><a href="/secretary/services/core" class="nav-link" data-permission="services.view"><i class="bi bi-snow nav-icon"></i><span class="nav-label">Core Services</span></a></li>
            <li><a href="/secretary/services/repair" class="nav-link" data-permission="services.view"><i class="bi bi-wrench-adjustable nav-icon"></i><span class="nav-label">Repair Services</span></a></li>
          </ul>
        </div>
      </li>

      <li class="nav-item nav-group<%= inventoryGroupOpen ? ' expanded' : '' %>">
        <button class="btn btn-toggle nav-link<%= inventoryGroupOpen ? ' active' : ' collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#inventory-collapse" aria-controls="inventory-collapse" aria-expanded="<%= inventoryGroupOpen ? 'true' : 'false' %>">
          <i class="bi bi-box-seam nav-icon"></i><span class="nav-label">Inventory</span><i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        <div class="collapse<%= inventoryGroupOpen ? ' show' : '' %>" id="inventory-collapse" data-default-open="<%= inventoryGroupOpen ? 'true' : 'false' %>">
          <ul class="btn-toggle-nav list-unstyled">
            <li><a href="/secretary/pointofsale" class="nav-link nav-link-featured" data-permission="orders.manage"><i class="bi bi-shop nav-icon"></i><span class="nav-label">Point of Sale</span></a></li>
            <li><a href="/secretary/inventory/repair-parts" class="nav-link" data-permission="inventory.view"><i class="bi bi-boxes nav-icon"></i><span class="nav-label">Repair Parts</span></a></li>
            <li><a href="/secretary/inventory" class="nav-link" data-permission="inventory.view"><i class="bi bi-list-check nav-icon"></i><span class="nav-label">Aircons</span></a></li>
            <li><a href="/secretary/inventory/history" class="nav-link" data-permission="inventory.view"><i class="bi bi-clock-history nav-icon"></i><span class="nav-label">Stock History</span></a></li>
          </ul>
        </div>
      </li>

      <li class="nav-section" aria-hidden="true"><span class="section-label">People</span><span class="section-line"></span></li>
      <li class="nav-item nav-group<%= peopleGroupOpen ? ' expanded' : '' %>">
        <button class="btn btn-toggle nav-link<%= peopleGroupOpen ? ' active' : ' collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#secretary-people-collapse" aria-controls="secretary-people-collapse" aria-expanded="<%= peopleGroupOpen ? 'true' : 'false' %>">
          <i class="bi bi-people nav-icon"></i><span class="nav-label">Directory &amp; Attendance</span><i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        <div class="collapse<%= peopleGroupOpen ? ' show' : '' %>" id="secretary-people-collapse" data-default-open="<%= peopleGroupOpen ? 'true' : 'false' %>">
          <ul class="btn-toggle-nav list-unstyled">
            <li><a href="/secretary/customers" class="nav-link" data-permission="customers.view"><i class="bi bi-person-heart nav-icon"></i><span class="nav-label">Customers</span></a></li>
            <li><a href="/secretary/technicians" class="nav-link" data-permission="technicians.view"><i class="bi bi-person-workspace nav-icon"></i><span class="nav-label">Technicians</span></a></li>
            <li><a href="/secretary/staff" class="nav-link" data-permission="staff.view"><i class="bi bi-person-badge nav-icon"></i><span class="nav-label">Staff Directory</span></a></li>
            <li><a href="/secretary/attendance" class="nav-link" data-permission="attendance.self.manage"><i class="bi bi-qr-code-scan nav-icon"></i><span class="nav-label">My Attendance</span></a></li>
          </ul>
        </div>
      </li>

      <li class="nav-section" aria-hidden="true"><span class="section-label">Finance</span><span class="section-line"></span></li>
      <li class="nav-item nav-group<%= financeGroupOpen ? ' expanded' : '' %>">
        <button class="btn btn-toggle nav-link<%= financeGroupOpen ? ' active' : ' collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#secretary-finance-collapse" aria-controls="secretary-finance-collapse" aria-expanded="<%= financeGroupOpen ? 'true' : 'false' %>">
          <i class="bi bi-wallet2 nav-icon"></i><span class="nav-label">Payments &amp; Payroll</span><i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        <div class="collapse<%= financeGroupOpen ? ' show' : '' %>" id="secretary-finance-collapse" data-default-open="<%= financeGroupOpen ? 'true' : 'false' %>">
          <ul class="btn-toggle-nav list-unstyled">
            <li><a href="/secretary/payments" class="nav-link" data-permission="payments.view"><i class="bi bi-credit-card nav-icon"></i><span class="nav-label">Payments</span></a></li>
            <li><a href="/secretary/payroll" class="nav-link" data-permission="payroll.self.view"><i class="bi bi-person-vcard nav-icon"></i><span class="nav-label">My Payroll</span></a></li>
          </ul>
        </div>
      </li>

      <li class="nav-section" aria-hidden="true"><span class="section-label">Reports and Ratings</span><span class="section-line"></span></li>
      <li class="nav-item nav-group<%= analyticsGroupOpen ? ' expanded' : '' %>">
        <button class="btn btn-toggle nav-link<%= analyticsGroupOpen ? ' active' : ' collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#secretary-analytics-collapse" aria-controls="secretary-analytics-collapse" aria-expanded="<%= analyticsGroupOpen ? 'true' : 'false' %>">
          <i class="bi bi-bar-chart-line nav-icon"></i><span class="nav-label">Reports and Ratings</span><i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        <div class="collapse<%= analyticsGroupOpen ? ' show' : '' %>" id="secretary-analytics-collapse" data-default-open="<%= analyticsGroupOpen ? 'true' : 'false' %>">
          <ul class="btn-toggle-nav list-unstyled">
            <li><a href="/secretary/reports" class="nav-link" data-permission="reports.view"><i class="bi bi-grid-1x2 nav-icon"></i><span class="nav-label">Report Center</span></a></li>
            <li><a href="/secretary/reports/revenue" class="nav-link" data-permission="reports.view"><i class="bi bi-graph-up-arrow nav-icon"></i><span class="nav-label">Sales and Payments</span></a></li>
            <li><a href="/secretary/reports/service" class="nav-link" data-permission="reports.view"><i class="bi bi-wrench-adjustable nav-icon"></i><span class="nav-label">Service Reports</span></a></li>
            <li><a href="/secretary/reports/orders" class="nav-link" data-permission="reports.view"><i class="bi bi-bag-check nav-icon"></i><span class="nav-label">Order Reports</span></a></li>
            <li><a href="/secretary/reports/inventory" class="nav-link" data-permission="reports.view"><i class="bi bi-clipboard-data nav-icon"></i><span class="nav-label">Stock Reports</span></a></li>
          </ul>
        </div>
      </li>
    </ul>
  </nav>

  <div class="sidebar-footer">
    <span class="footer-avatar" aria-hidden="true"><%= sidebarInitial %></span>
    <span class="footer-meta"><strong class="footer-name"><%= sidebarName %></strong><span class="footer-role">Operations staff</span></span>
    <a class="footer-profile-link" href="/secretary/profile" aria-label="Open secretary profile" title="Profile"><i class="bi bi-chevron-right"></i></a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const allowedPermissions = new Set(<%- JSON.stringify(typeof effectivePermissions !== 'undefined' ? effectivePermissions : []).replace(/</g, '\\u003c') %>);
    const sidebar = document.getElementById('sidebar');
    if (!sidebar) return;

    sidebar.querySelectorAll('[data-permission]').forEach(function (link) {
      if (!allowedPermissions.has(link.dataset.permission)) {
        const item = link.closest('li');
        if (item) item.remove();
      }
    });

    sidebar.querySelectorAll('.collapse').forEach(function (panel) {
      if (!panel.querySelector('a.nav-link')) {
        const group = panel.closest('li.nav-item');
        if (group) group.remove();
      }
    });

    sidebar.querySelectorAll('.nav-subsection').forEach(function (heading) {
      let sibling = heading.nextElementSibling;
      let hasLink = false;
      while (sibling && !sibling.classList.contains('nav-subsection')) {
        if (sibling.querySelector && sibling.querySelector('a.nav-link')) hasLink = true;
        sibling = sibling.nextElementSibling;
      }
      if (!hasLink) heading.remove();
    });

    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    const links = Array.from(sidebar.querySelectorAll('a.nav-link[href]'));
    const matches = links.filter(function (link) {
      const href = link.getAttribute('href').replace(/\/$/, '') || '/';
      return currentPath === href || (href !== '/secretary' && currentPath.startsWith(href + '/'));
    }).sort(function (a, b) {
      return b.getAttribute('href').length - a.getAttribute('href').length;
    });

    if (matches[0]) {
      matches[0].classList.add('active');
      const panel = matches[0].closest('.collapse');
      if (panel) {
        panel.classList.add('show');
        const toggle = sidebar.querySelector('[data-bs-target="#' + panel.id + '"]');
        if (toggle) {
          toggle.classList.remove('collapsed');
          toggle.classList.add('active');
          toggle.setAttribute('aria-expanded', 'true');
          const group = toggle.closest('.nav-group');
          if (group) group.classList.add('expanded');
        }
      }
    }

    function setSecretaryBadge(id, value, title) {
      const element = document.getElementById(id);
      if (!element) return;
      const count = Math.max(0, Number(value) || 0);
      element.textContent = count > 99 ? '99+' : (count > 0 ? String(count) : '');
      element.style.display = count > 0 ? 'inline-flex' : 'none';
      if (title) element.title = title;
    }

    function setResolutionSidebarCount(summary) {
      if (!summary) return;
      const bookingCases = Math.max(0, Number(summary.bySource?.booking) || 0);
      const orderCases = Math.max(0, Number(summary.bySource?.order) || 0);
      const total = bookingCases + orderCases;
      setSecretaryBadge('attentionBadge', total, `${bookingCases} booking case${bookingCases === 1 ? '' : 's'} and ${orderCases} order case${orderCases === 1 ? '' : 's'}`);
    }

    let secretaryBadgesRefreshing = false;
    async function updateSecretarySidebarBadges() {
      if (document.hidden || secretaryBadgesRefreshing) return;
      secretaryBadgesRefreshing = true;
      try {
        const onResolutionCenter = window.location.pathname === '/secretary/operations/resolution-center';
        const results = await Promise.allSettled([
          fetch('/api/notifications/counts', { credentials: 'same-origin', cache: 'no-store' }).then(response => response.ok ? response.json() : Promise.reject(new Error('Counts unavailable'))),
          onResolutionCenter ? Promise.resolve(null) : fetch('/api/secretary/operations/resolution-center?page=1&perPage=1', { credentials: 'same-origin', cache: 'no-store' }).then(response => response.ok ? response.json() : Promise.reject(new Error('Resolution count unavailable'))),
          fetch('/api/orders/badge', { credentials: 'same-origin', cache: 'no-store' }).then(response => response.ok ? response.json() : Promise.reject(new Error('Order count unavailable'))),
          fetch('/api/projects/dashboard', { credentials: 'same-origin', cache: 'no-store' }).then(response => response.ok ? response.json() : Promise.reject(new Error('Project count unavailable'))),
          fetch('/api/secretary/operations/repair-scheduling-queue/stats', { credentials: 'same-origin', cache: 'no-store' }).then(response => response.ok ? response.json() : Promise.reject(new Error('Repair count unavailable'))),
        ]);
        const value = index => results[index].status === 'fulfilled' ? results[index].value : null;
        const counts = value(0);
        if (counts) {
          setSecretaryBadge('pendingReviewCount', counts.pendingBookings);
          setSecretaryBadge('appointmentsBadge', Number(counts.pendingBookings || 0) + Number(counts.assignmentQueue || 0) + Number(counts.activeJobs || 0));
          setSecretaryBadge('expensesBadge', counts.pendingExpenses);
          setSecretaryBadge('escalatedBadge', counts.escalatedBookings);
        }
        const resolution = value(1);
        if (resolution) setResolutionSidebarCount(resolution.summary);
        const orders = value(2);
        if (orders) setSecretaryBadge('ordersBadge', orders.actionable);
        const projects = value(3);
        if (projects) setSecretaryBadge('projectsBadge', projects.stats?.pendingScheduling);
        const repair = value(4);
        if (repair) setSecretaryBadge('repairSchedBadge', repair.pendingScheduling);
      } finally {
        secretaryBadgesRefreshing = false;
      }
    }

    window.addEventListener('resolution:counts', event => setResolutionSidebarCount(event.detail));
    window.addEventListener('notification:new', updateSecretarySidebarBadges);
    document.addEventListener('visibilitychange', function () { if (!document.hidden) updateSecretarySidebarBadges(); });
    updateSecretarySidebarBadges();
    window.setInterval(updateSecretarySidebarBadges, 60000);
  });
</script>
