<div class="ent-svc-page repair-services-page">
  <link rel="stylesheet" href="/css/enterprise-services.css" />
  <%- include('../../../partials/dashboard-styles') %>

  <!-- Hero -->
  <div class="ent-svc-hero d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div class="d-flex align-items-center gap-3">
      <div class="es-icon"><i class="bi bi-wrench-adjustable-circle-fill"></i></div>
      <div>
        <h1>Repair Services Matrix</h1>
        <p class="es-sub">Manage diagnostics, repair categories, parts policy, and SLA targets</p>
      </div>
    </div>
    <button class="btn-es-primary new-repair-service">
      <i class="bi bi-plus-lg me-2"></i>Add Repair Service
    </button>
  </div>

  <% const totalRepairs = repairServices ? repairServices.length : 0; %>
  <% const activeRepairs = repairServices ? repairServices.filter(r=>r.active).length : 0; %>
  <% const inactiveRepairs = totalRepairs - activeRepairs; %>

  <!-- KPI cards -->
  <div class="es-kpi-grid">
    <div class="es-kpi">
      <div class="es-kpi-icon" style="background:linear-gradient(135deg,#e63946,#b91c2a)"><i class="bi bi-exclamation-octagon-fill"></i></div>
      <div>
        <div class="es-kpi-label">Total Repair Services</div>
        <div class="es-kpi-value" id="statOpen"><%= totalRepairs %></div>
      </div>
      <div class="es-kpi-bar" style="background:linear-gradient(90deg,#e63946,#b91c2a)"></div>
    </div>
    <div class="es-kpi">
      <div class="es-kpi-icon" style="background:linear-gradient(135deg,#ff9f1c,#ff7422)"><i class="bi bi-tools"></i></div>
      <div>
        <div class="es-kpi-label">Active Services</div>
        <div class="es-kpi-value" id="statComplex"><%= activeRepairs %></div>
      </div>
      <div class="es-kpi-bar" style="background:linear-gradient(90deg,#ff9f1c,#ff7422)"></div>
    </div>
    <div class="es-kpi">
      <div class="es-kpi-icon" style="background:linear-gradient(135deg,#2ec4b6,#1a8f85)"><i class="bi bi-check-circle"></i></div>
      <div>
        <div class="es-kpi-label">Inactive / Review</div>
        <div class="es-kpi-value" id="statResolved"><%= inactiveRepairs %></div>
      </div>
      <div class="es-kpi-bar" style="background:linear-gradient(90deg,#2ec4b6,#1a8f85)"></div>
    </div>
    <div class="es-kpi">
      <div class="es-kpi-icon" style="background:linear-gradient(135deg,#4361ee,#3a0ca3)"><i class="bi bi-clock"></i></div>
      <div>
        <div class="es-kpi-label">Avg Est. Duration</div>
        <div class="es-kpi-value" id="statSLA">
          <% if (repairServices && repairServices.length) { %>
            <%= fmtDuration(Math.round(repairServices.reduce((sum,r)=>sum+(r.estimatedDurationMinutes||0),0)/repairServices.length)) %>
          <% } else { %>-<% } %>
        </div>
      </div>
      <div class="es-kpi-bar" style="background:linear-gradient(90deg,#4361ee,#3a0ca3)"></div>
    </div>
  </div>

  <!-- Toolbar / filters -->
  <div class="es-panel">
    <div class="es-panel-body">
      <div class="es-toolbar">
        <div class="es-field">
          <label>Search Repair Service</label>
          <div class="es-input-group">
            <span class="es-input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" class="es-input" placeholder="Issue type, code, or service name" />
          </div>
        </div>
        <div class="es-field">
          <label>Severity</label>
          <select class="es-select">
            <option>All Severities</option>
            <option>Minor</option>
            <option>Major</option>
            <option>Critical</option>
          </select>
        </div>
        <div class="es-field">
          <label>Skill Requirement</label>
          <select class="es-select">
            <option>All Levels</option>
            <option>Level 1 Technician</option>
            <option>Level 2 Technician</option>
            <option>Senior Specialist</option>
          </select>
        </div>
        <button class="es-btn"><i class="bi bi-funnel me-1"></i>Filter</button>
      </div>
    </div>
  </div>

<% /* helper functions for repair table */ %>
<% function fmtPrice(p) { if (p == null) return ''; return '₱ ' + Number(p).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); } %>
<% function fmtDuration(mins) { if (!mins && mins !== 0) return ''; const h=Math.floor(mins/60); const m=mins%60; let out=''; if(h) out+=h+'h'; if(m) out+=(out?' ':'')+m+'m'; return out||'0m'; } %>
<% function statusBadge(active) { if(active) return 'es-badge es-badge-active'; return 'es-badge es-badge-inactive'; } %>

  <!-- List -->
  <div class="es-panel">
    <div class="es-panel-head">
      <h6>Repair Service Definitions</h6>
      <span class="es-meta">Updated with diagnostic matrix</span>
    </div>
    <div style="overflow-x:auto">
      <table class="es-table">
        <thead>
          <tr>
            <th>Repair Service</th>
            <th>Code</th>
            <th>Appliance</th>
            <th>Baseline Fee</th>
            <th>Est. Duration</th>
            <th>Warranty</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (repairServices && repairServices.length) { %>
            <% repairServices.forEach(function(svc) { %>
              <tr data-svc="<%= encodeURIComponent(JSON.stringify(svc)) %>">
                <td>
                  <div class="es-svc-name"><%= svc.name %></div>
                  <div class="es-svc-sub"><%= svc.applianceType || '' %></div>
                </td>
                <td><span class="es-mono"><%= svc.slug || svc._id %></span></td>
                <td><%= svc.applianceType || '-' %></td>
                <td class="es-price"><%= fmtPrice(svc.basePrice) %></td>
                <td class="es-svc-sub"><%= fmtDuration(svc.estimatedDurationMinutes) %></td>
                <td class="es-svc-sub"><%= svc.warrantyDays != null ? svc.warrantyDays + 'd' : '-' %></td>
                <td>
                  <% if (svc.active) { %>
                    <span class="es-badge es-badge-active"><span class="es-dot"></span>Active</span>
                  <% } else { %>
                    <span class="es-badge es-badge-inactive">Inactive</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <button class="es-act edit-repair-service">Edit</button>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="8" class="es-empty">No repair services defined.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Policy notes -->
  <div class="es-panel">
    <div class="es-panel-head"><h6>Repair Policy Notes</h6></div>
    <div class="es-panel-body">
      <ul class="es-notes">
        <li>Critical repairs require pre-approval and parts availability confirmation.</li>
        <li>All final quotes should include service labor + parts + warranty scope.</li>
        <li>Draft services are hidden from booking until approved by an admin reviewer.</li>
      </ul>
    </div>
  </div>
</div>

<!-- modal for repair service create/edit -->
<div class="modal fade" id="repairServiceModal" tabindex="-1" aria-labelledby="repairServiceModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <form id="repairServiceForm" class="modal-content es-modal">
      <div class="modal-header">
        <h5 class="modal-title" id="repairServiceModalLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Name</label>
          <input type="text" name="name" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Slug</label>
          <input type="text" name="slug" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Appliance Type</label>
          <input type="text" name="applianceType" class="form-control" />
        </div>
        <div class="mb-3">
          <label class="form-label">Base Price</label>
          <input type="number" step="0.01" name="basePrice" class="form-control" />
        </div>
        <div class="mb-3">
          <label class="form-label">Estimated Duration Minutes</label>
          <input type="number" name="estimatedDurationMinutes" class="form-control" />
        </div>
        <div class="form-check mb-3">
          <input type="checkbox" name="active" class="form-check-input" id="repairActiveCheck" checked />
          <label class="form-check-label" for="repairActiveCheck">Active</label>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const modalEl = document.getElementById('repairServiceModal');
    if (!modalEl) return;
    const modal = window.bootstrap && bootstrap.Modal ? new bootstrap.Modal(modalEl) : null;
    const form = document.getElementById('repairServiceForm');
    let editingId = null;

    function openForm(data) {
      if (data) {
        editingId = data._id;
        modalEl.querySelector('.modal-title').innerText = 'Edit Repair Service';
        form.name.value = data.name || '';
        form.slug.value = data.slug || '';
        form.applianceType.value = data.applianceType || '';
        form.basePrice.value = data.basePrice || '';
        form.estimatedDurationMinutes.value = data.estimatedDurationMinutes || '';
        form.active.checked = !!data.active;
      } else {
        editingId = null;
        modalEl.querySelector('.modal-title').innerText = 'New Repair Service';
        form.reset();
        form.active.checked = true;
      }
      modal && modal.show();
    }

    document.querySelector('.new-repair-service').addEventListener('click', function() {
      openForm();
    });

    document.body.addEventListener('click', function(e) {
      if (e.target.matches('.edit-repair-service')) {
        const tr = e.target.closest('tr');
        if (!tr) return;
        const svc = JSON.parse(decodeURIComponent(tr.dataset.svc || '{}'));
        openForm(svc);
      }
    });

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const payload = {
        name: form.name.value.trim(),
        slug: form.slug.value.trim(),
        applianceType: form.applianceType.value.trim(),
        basePrice: form.basePrice.value ? parseFloat(form.basePrice.value) : undefined,
        estimatedDurationMinutes: form.estimatedDurationMinutes.value ? parseInt(form.estimatedDurationMinutes.value) : undefined,
        active: form.active.checked,
      };
      let url = '/api/secretary/repair-services';
      let method = 'POST';
      if (editingId) {
        url += '/' + editingId;
        method = 'PATCH';
      }
      try {
        const r = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (r.ok) {
          location.reload();
        } else {
          const j = await r.json();
          alert(j.error || 'Save failed');
        }
      } catch (err) {
        alert('Save failed');
      }
    });
  });
</script>
