                // Calculate and display distance (similar to services.js)
                const distance = L.latLng(custCoords.lat, custCoords.lng)
                  .distanceTo(L.latLng(techCoords.lat, techCoords.lng));
                const distanceKm = (distance / 1000).toFixed(2);
                
                // Add distance info as a control
                const distanceControl = L.control({position: 'topright'});
