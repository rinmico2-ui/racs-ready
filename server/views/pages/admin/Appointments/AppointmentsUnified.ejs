      container.innerHTML='<div class="au-table-card workflow-overview-table"><div class="table-responsive workflow-record-table-shell"><table class="table rq-table mb-0 align-middle workflow-record-table"><tbody><tr><td colspan="7" class="text-center py-5"><div class="au-empty-state"><div class="au-empty-state-icon"><i class="bi bi-inbox"></i></div><h6>No Completed Jobs</h6><p>Completed jobs will appear here</p></div></td></tr></tbody></table></div></div>';
